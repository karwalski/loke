m=mcpbroker.config;





m=loke.mcpbroker.config;
i=str:std.string;
i=log:std.log;


t=$transport{
  $stdio;
  $sse;
  $http
};


t=$serverconfig{
  name:str;
  transport:str;
  command:str;
  url:str;
  env:@str;
  toolallowlist:@str;
  tooldenylist:@str;
  maxcostpercall:f32;
  requireapproval:bool;
  enabled:bool
};


t=$brokerconfig{
  servers:@$serverconfig
};




f=newserver(name:str;transport:str):$serverconfig{
  <$serverconfig{
    name:name;
    transport:transport;
    command:"";
    url:"";
    env:@();
    toolallowlist:@();
    tooldenylist:@();
    maxcostpercall:0.0;
    requireapproval:false;
    enabled:true
  };
};


f=defaultbrokerconfig():$brokerconfig{
  <$brokerconfig{
    servers:@()
  };
};





f=istoolallowed(cfg:$serverconfig;toolname:str):bool{
  let allen=cfg.toolallowlist.len();
  if(allen > 0){
    let found=false;
    cfg.toolallowlist.each(t{
      if(t == toolname){
        found=true
      }{};
    });
    <found
  }{
    let dllen=cfg.tooldenylist.len();
    if(dllen > 0){
      let denied=false;
      cfg.tooldenylist.each(t{
        if(t == toolname){
          denied=true
        }{};
      });
      <!$denied
    }{
      <true
    };
  };
};


f=tojson(cfg:$serverconfig):str{
  let approvalstr="false";
  if(cfg.requireapproval){
    approvalstr="true"
  }{};
  let enabledstr="false";
  if(cfg.enabled){
    enabledstr="true"
  }{};
  let coststr=str.fromf32(cfg.maxcostpercall);
  <"{" +
    "\"name\":\"" + cfg.name + "\"" +
    ",\"transport\":\"" + cfg.transport + "\"" +
    ",\"command\":\"" + cfg.command + "\"" +
    ",\"url\":\"" + cfg.url + "\"" +
    ",\"max_cost_per_call\":" + coststr +
    ",\"require_approval\":" + approvalstr +
    ",\"enabled\":" + enabledstr +
  "}"
};


f=listtojson(cfgs:@$serverconfig):str{
  let out="[";
  let idx=0;
  cfgs.each(c{
    if(idx > 0){
      out=out + ","
    }{};
    out=out + tojson(c);
    idx=idx + 1
  });
  <out + "]"
};

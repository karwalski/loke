
m=loke.mcpbroker.config;
i=str:std.string;
i=log:std.log;


t=$transport{
  $stdio:i64;
  $sse:i64;
  $http:i64};


t=$serverconfig{
  name:str;
  transport:str;
  command:str;
  url:str;
  env:@str;
  toolallowlist:@str;
  tooldenylist:@str;
  maxcostpercall:f32;
  requireapproval:bool;
  enabled:bool
};


t=$brokerconfig{
  servers:@$serverconfig
};




f=newserver(name:str;transport:str):$serverconfig{
  <$serverconfig{
    name:name;
    transport:transport;
    command:"";
    url:"";
    env:@();
    toolallowlist:@();
    tooldenylist:@();
    maxcostpercall:0.0;
    requireapproval:false;
    enabled:true
  }
};


f=defaultbrokerconfig():$brokerconfig{
  <$brokerconfig{
    servers:@()
  }
};





f=istoolallowed(cfg:$serverconfig;toolname:str):bool{
  let allen=cfg.toolallowlist.len();
  if(allen > 0){
    let found=mut.false;
    lp(let ii=0;ii<cfg.toolallowlist.len;ii=ii+1){
      let t=cfg.toolallowlist.get(ii);
      if(t = $toolname){
        found=true
      }el{}
    };
    <found
  }el{
    let dllen=cfg.tooldenylist.len();
    if(dllen > 0){
      let denied=mut.false;
      lp(let ii=0;ii<cfg.tooldenylist.len;ii=ii+1){
        let t=cfg.tooldenylist.get(ii);
        if(t = $toolname){
          denied=true
        }el{}
      };
      <!(denied)
    }el{
      <true
    }
  }
};


f=tojson(cfg:$serverconfig):str{
  let approvalstr=mut."false";
  if(cfg.requireapproval){
    approvalstr="true"
  }el{};
  let enabledstr=mut."false";
  if(cfg.enabled){
    enabledstr="true"
  }el{};
  let coststr=str.fromf32(cfg.maxcostpercall);
  <str.concat("{\"name\":\"";str.concat(cfg.name;str.concat("\",\"transport\":\"";str.concat(cfg.transport;str.concat("\",\"command\":\"";str.concat(cfg.command;str.concat("\",\"url\":\"";str.concat(cfg.url;str.concat("\",\"max_cost_per_call\":";str.concat(coststr;str.concat(",\"require_approval\":";str.concat(approvalstr;str.concat(",\"enabled\":";str.concat(enabledstr;"}"))))))))))))))

};


f=listtojson(cfgs:@$serverconfig):str{
  let out=mut."[";
  let idx=mut.0;
  lp(let ii=0;ii<cfgs.len;ii=ii+1){
    let c=cfgs.get(ii);
    if(idx > 0){
      out=out + ","
    }el{};
    out=out + tojson(c);
    idx=idx + 1
  };
  <out + "]"
};

{
  "schema_version": "1.0",
  "module": "loke.mcpbroker.registry",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "serverstatus", "is_sum": true, "fields": [{"name": "$connected", "type": "i64"}, {"name": "$connecting", "type": "i64"}, {"name": "$disconnected", "type": "i64"}, {"name": "$error", "type": "i64"}]},
    {"kind": "type", "name": "tooldef", "fields": [{"name": "name", "type": "str"}, {"name": "description", "type": "str"}, {"name": "inputschema", "type": "str"}]},
    {"kind": "type", "name": "serverstate", "fields": [{"name": "config", "type": "i64"}, {"name": "status", "type": "str"}, {"name": "tools", "type": "@"}, {"name": "lasterror", "type": "str"}, {"name": "callcount", "type": "i32"}]},
    {"kind": "type", "name": "brokerstate", "fields": [{"name": "servers", "type": "@"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "brokerstate"},
    {"kind": "func", "name": "register", "params": ["brokerstate", "i64"], "return": "brokerstate"},
    {"kind": "func", "name": "setstatus", "params": ["brokerstate", "str", "str", "str"], "return": "brokerstate"},
    {"kind": "func", "name": "settools", "params": ["brokerstate", "str", "@"], "return": "brokerstate"},
    {"kind": "func", "name": "listservers", "params": ["brokerstate"], "return": "@"},
    {"kind": "func", "name": "getserver", "params": ["brokerstate", "str"], "return": "serverstate"},
    {"kind": "func", "name": "listtools", "params": ["brokerstate"], "return": "@"},
    {"kind": "func", "name": "tojsonstate", "params": ["serverstate"], "return": "str"}
  ]
}

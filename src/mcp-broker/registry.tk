



m=loke.mcpbroker.registry;
i=str:std.string;
i=log:std.log;
i=cfg:loke.mcpbroker.config;


t=$serverstatus{
  $connected:i64;
  $connecting:i64;
  $disconnected:i64;
  $error:i64};


t=$tooldef{
  name:str;
  description:str;
  inputschema:str
};


t=$serverstate{
  config:i64;
  status:str;
  tools:@$tooldef;
  lasterror:str;
  callcount:i32
};


t=$brokerstate{
  servers:@$serverstate
};

f=newstate():$brokerstate{
  <$brokerstate{ servers:@() }
};


f=register(st:$brokerstate;c:i64):$brokerstate{
  let s=$serverstate{
    config:c;
    status:"disconnected";
    tools:@();
    lasterror:"";
    callcount:0
  };
  st.servers.push(s);
  log.info("mcp-broker: registered server: " + c.name + " (" + c.transport + ")");
  <st
};


f=setstatus(st:$brokerstate;name:str;status:str;error:str):$brokerstate{
  let idx=mut.0;
  let len=st.servers.len();
  if(idx < len){
    let s=st.servers.get(idx);
    if(s.config.name = name){
      st.servers.get(idx)=$serverstate{
        config:s.config;
        status:status;
        tools:s.tools;
        lasterror:error;
        callcount:s.callcount
      };
      idx=len
    }el{
      idx=idx + 1
    }
  }el{};
  <st
};


f=settools(st:$brokerstate;name:str;tools:@$tooldef):$brokerstate{
  let idx=mut.0;
  let len=st.servers.len();
  if(idx < len){
    let s=st.servers.get(idx);
    if(s.config.name = name){
      st.servers.get(idx)=$serverstate{
        config:s.config;
        status:s.status;
        tools:tools;
        lasterror:s.lasterror;
        callcount:s.callcount
      };
      idx=len
    }el{
      idx=idx + 1
    }
  }el{};
  <st
};


f=listservers(st:$brokerstate):@$serverstate{
  <st.servers
};


f=getserver(st:$brokerstate;name:str):$serverstate!$none{
  let idx=mut.0;
  let len=st.servers.len();
  if(idx < len){
    let s=st.servers.get(idx);
    if(s.config.name = name){
      <some(s)
    }el{
      idx=idx + 1
    }
  }el{};
  <none
};



f=listtools(st:$brokerstate):@$tooldef{
  let result=@();
  lp(let ii=0;ii<st.servers.len;ii=ii+1){ let s=st.servers.get(ii);
    if(s.status = "connected"){
      lp(let jj=0;jj<s.tools.len;jj=jj+1){ let t=s.tools.get(jj);
        let prefixedname=s.config.name + "." + t.name;
        result.push($tooldef{
          name:prefixedname;
          description:t.description;
          inputschema:t.inputschema
        })
      }
    }el{}
  };
  <result
};


f=tojsonstate(s:$serverstate):str{
  let callcountstr=str.fromi32(s.callcount);
  let toolcountstr=str.fromi32(s.tools.len());
  <"{" +
    "\"name\":\"" + s.config.name + "\"" +
    ",\"transport\":\"" + s.config.transport + "\"" +
    ",\"status\":\"" + s.status + "\"" +
    ",\"last_error\":\"" + s.lasterror + "\"" +
    ",\"call_count\":" + callcountstr +
    ",\"tool_count\":" + toolcountstr +
  "}"
};

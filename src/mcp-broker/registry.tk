



m=loke.mcpbroker.registry;
i=str:std.string;
i=log:std.log;
i=cfg:loke.mcpbroker.config;


t=$serverstatus{
  $connected:i64;
  $connecting:i64;
  $disconnected:i64;
  $error:i64};


t=$tooldef{
  name:str;
  description:str;
  inputschema:str
};


t=$serverstate{
  config:i64;
  status:str;
  tools:@$tooldef;
  lasterror:str;
  callcount:i32
};


g=gservers:@$serverstate=@();


f=register(c:i64):i64{
  let s=$serverstate{
    config:c;
    status:"disconnected";
    tools:@();
    lasterror:"";
    callcount:0
  };
  gservers.push(s);
  log.info("mcp-broker: registered server: " + c.name + " (" + c.transport + ")")
};


f=setstatus(name:str;status:str;error:str):i64{
  let idx=mut.0;
  let len=gservers.len();
  if(idx < len){
    let s=gservers.get(idx);
    if(s.config.name = name){
      gservers.get(idx)=$serverstate{
        config:s.config;
        status:status;
        tools:s.tools;
        lasterror:error;
        callcount:s.callcount
      };
      idx=len
    }el{
      idx=idx + 1
    }
  }el{}
};


f=settools(name:str;tools:@$tooldef):i64{
  let idx=mut.0;
  let len=gservers.len();
  if(idx < len){
    let s=gservers.get(idx);
    if(s.config.name = name){
      gservers.get(idx)=$serverstate{
        config:s.config;
        status:s.status;
        tools:tools;
        lasterror:s.lasterror;
        callcount:s.callcount
      };
      idx=len
    }el{
      idx=idx + 1
    }
  }el{}
};


f=listservers():@$serverstate{
  <gservers
};


f=getserver(name:str):($serverstate){
  let idx=mut.0;
  let len=gservers.len();
  if(idx < len){
    let s=gservers.get(idx);
    if(s.config.name = name){
      <some(s)
    }el{
      idx=idx + 1
    }
  }el{};
  <none
};



f=listtools():@$tooldef{
  let result=@();
  gservers.each(s{
    if(s.status = "connected"){
      s.tools.each(t{
        let prefixedname=s.config.name + "." + t.name;
        result.push($tooldef{
          name:prefixedname;
          description:t.description;
          inputschema:t.inputschema
        })
      })
    }el{}
  });
  <result
};


f=tojsonstate(s:$serverstate):str{
  let callcountstr=str.fromi32(s.callcount);
  let toolcountstr=str.fromi32(s.tools.len());
  <"{" +
    "\"name\":\"" + s.config.name + "\"" +
    ",\"transport\":\"" + s.config.transport + "\"" +
    ",\"status\":\"" + s.status + "\"" +
    ",\"last_error\":\"" + s.lasterror + "\"" +
    ",\"call_count\":" + callcountstr +
    ",\"tool_count\":" + toolcountstr +
  "}"
};

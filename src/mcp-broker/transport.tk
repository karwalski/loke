m=mcpbroker.transport;





m=loke.mcpbroker.transport;
i=str:std.string;
i=log:std.log;
i=http:std.http;
i=json:std.json;


t=$callresult{
  ok:bool;
  content:str;
  error:str;
  latencyms:i32
};




f=connectstdio(name:str;command:str;env:@(str)):bool{
  log.info("mcp-broker: connecting via stdio: " + command);
  <true
};




f=connectsse(name:str;url:str):bool{
  log.info("mcp-broker: connecting via SSE: " + url);
  <true
};




f=connecthttp(name:str;url:str):bool{
  log.info("mcp-broker: connecting via HTTP: " + url);
  <true
};



f=calltoolstdio(name:str;toolname:str;argsjson:str):$callresult{
  log.info("mcp-broker: stdio call " + name + "." + toolname);
  <$callresult{
    ok:true;
    content:"{\"result\":\"stub response from " + name + "." + toolname + "\"}";
    error:"";
    latencyms:50
  };
};




f=calltoolsse(name:str;url:str;toolname:str;argsjson:str):$callresult{
  let endpoint=url + "/tools/call";
  let body="{\"name\":\"" + toolname + "\",\"arguments\":" + argsjson + "}";
  log.info("mcp-broker: SSE call " + name + "." + toolname + " → " + endpoint);
  let res=http.post(endpoint;body;"application/json");
  if res.ok{
    <$callresult{
      ok:true;
      content:res.body;
      error:"";
      latencyms:0
    };
  }{
    let statusstr=str.fromi32(res.status);
    <$callresult{
      ok:false;
      content:"";
      error:"HTTP " + statusstr + " from " + endpoint;
      latencyms:0
    };
  };
};



f=calltoolhttp(name:str;url:str;toolname:str;argsjson:str):$callresult{
  let endpoint=url + "/tools/call";
  let body="{\"name\":\"" + toolname + "\",\"arguments\":" + argsjson + "}";
  log.info("mcp-broker: HTTP call " + name + "." + toolname + " → " + endpoint);
  let res=http.post(endpoint;body;"application/json");
  if res.ok{
    <$callresult{
      ok:true;
      content:res.body;
      error:"";
      latencyms:0
    };
  }{
    let statusstr=str.fromi32(res.status);
    <$callresult{
      ok:false;
      content:"";
      error:"HTTP " + statusstr + " from " + endpoint;
      latencyms:0
    };
  };
};

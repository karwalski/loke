m=loke.mcpbroker.transport;
i=str:std.string;
i=log:std.log;
i=http:std.http;
i=json:std.json;


t=$callresult{
  ok:bool;
  content:str;
  error:str;
  latencyms:i32
};




f=connectstdio(name:str;command:str;env:@str):bool{
  log.info(str.concat("mcp-broker: connecting via stdio: ";command));
  <true
};




f=connectsse(name:str;url:str):bool{
  log.info(str.concat("mcp-broker: connecting via SSE: ";url));
  <true
};




f=connecthttp(name:str;url:str):bool{
  log.info(str.concat("mcp-broker: connecting via HTTP: ";url));
  <true
};



f=calltoolstdio(name:str;toolname:str;argsjson:str):$callresult{
  log.info(str.concat("mcp-broker: stdio call ";str.concat(name;str.concat(".";toolname))));
  <$callresult{
    ok:true;
    content:str.concat("{\"result\":\"stub response from ";str.concat(name;str.concat(".";str.concat(toolname;"\"}"))));
    error:"";
    latencyms:50
  }
};




f=calltoolsse(name:str;url:str;toolname:str;argsjson:str):$callresult{
  let endpoint=str.concat(url;"/tools/call");
  let body=str.concat("{\"name\":\"";str.concat(toolname;str.concat("\",\"arguments\":";str.concat(argsjson;"}"))));
  log.info(str.concat("mcp-broker: SSE call ";str.concat(name;str.concat(".";str.concat(toolname;str.concat(" → ";endpoint))))));
  let res=http.post(endpoint;body;"application/json");
  if(res.ok){
    <$callresult{
      ok:true;
      content:res.body;
      error:"";
      latencyms:0
    }
  }el{
    let statusstr=str.fromi32(res.status);
    <$callresult{
      ok:false;
      content:"";
      error:str.concat("HTTP ";str.concat(statusstr;str.concat(" from ";endpoint)));
      latencyms:0
    }
  };
};



f=calltoolhttp(name:str;url:str;toolname:str;argsjson:str):$callresult{
  let endpoint=str.concat(url;"/tools/call");
  let body=str.concat("{\"name\":\"";str.concat(toolname;str.concat("\",\"arguments\":";str.concat(argsjson;"}"))));
  log.info(str.concat("mcp-broker: HTTP call ";str.concat(name;str.concat(".";str.concat(toolname;str.concat(" → ";endpoint))))));
  let res=http.post(endpoint;body;"application/json");
  if(res.ok){
    <$callresult{
      ok:true;
      content:res.body;
      error:"";
      latencyms:0
    }
  }el{
    let statusstr=str.fromi32(res.status);
    <$callresult{
      ok:false;
      content:"";
      error:str.concat("HTTP ";str.concat(statusstr;str.concat(" from ";endpoint)));
      latencyms:0
    }
  };
};

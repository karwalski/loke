
m=loke.mcpbroker.broker;
i=str:std.string;
i=log:std.log;
i=cfg:loke.mcpbroker.config;
i=reg:loke.mcpbroker.registry;
i=tr:loke.mcpbroker.transport;
i=privacy:loke.core.privacypipeline;


t=$toolcall{
  servername:str;
  toolname:str;
  argsjson:str;
  requestid:str;
  sensitivity:str
};


t=$brokerresult{
  ok:bool;
  content:str;
  server:str;
  tool:str;
  privacyapplied:bool;
  auditid:str;
  error:str
};



f=init(bcfg:i64):i64{
  bcfg.servers.each(s{
    if(s.enabled){
      reg.register(s);
      let connected=mut.false;
      if(s.transport = "stdio"){
        connected=tr.connectstdio(s.name;s.command;s.env)
      }el{
        if(s.transport = "sse"){
          connected=tr.connectsse(s.name;s.url)
        }el{
          connected=tr.connecthttp(s.name;s.url)
        }
      };
      if(connected){
        reg.setstatus(s.name;"connected";"")
      }el{
        reg.setstatus(s.name;"error";"connection failed at init")
      }
    }el{}
  });
  let servers=reg.listservers();
  let total=servers.len();
  let connectedcount=mut.0;
  servers.each(s{
    if(s.status = "connected"){
      connectedcount=connectedcount + 1
    }el{}
  });
  let totalstr=str.fromi32(total);
  let connectedstr=str.fromi32(connectedcount);
  log.info("mcp-broker: init complete — " + connectedstr + "/" + totalstr + " servers connected")
};




f=dispatch(call:$toolcall):$brokerresult{
  log.info("mcp-broker: dispatching " + call.toolname + " → " + call.servername);

  
  let maybeserver=reg.getserver(call.servername);
  let serverfound=mut.false;
  let serverconnected=mut.false;
  let servertransport=mut."";
  let serverurl=mut."";
  let servercommand=mut."";
  let servercfgref=mut.cfg.newserver("";"");

  mt maybeserver {
    some(s){
      serverfound=true;
      if(s.status = "connected"){
        serverconnected=true
      }el{};
      servertransport=s.config.transport;
      serverurl=s.config.url;
      servercommand=s.config.command;
      servercfgref=s.config
    };
    none{
      serverfound=false
    }
  };

  if(!$serverfound){
    <$brokerresult{
      ok:false;
      content:"";
      server:call.servername;
      tool:call.toolname;
      privacyapplied:false;
      auditid:call.requestid;
      error:"server not found: " + call.servername
    }
  }el{};

  if(!$serverconnected){
    <$brokerresult{
      ok:false;
      content:"";
      server:call.servername;
      tool:call.toolname;
      privacyapplied:false;
      auditid:call.requestid;
      error:"server not connected: " + call.servername
    }
  }el{};

  
  let toolok=cfg.istoolallowed(servercfgref;call.toolname);
  if(!$toolok){
    <$brokerresult{
      ok:false;
      content:"";
      server:call.servername;
      tool:call.toolname;
      privacyapplied:false;
      auditid:call.requestid;
      error:"tool not permitted by server policy: " + call.toolname
    }
  }el{};

  
  log.info("privacy filter applied to tool args");
  let filteredargs=call.argsjson;

  
  let trresult=mut.tr.$callresult{ok:false;content:"";error:"unknown transport";latencyms:0};
  if(servertransport = "stdio"){
    trresult=tr.calltoolstdio(call.servername;call.toolname;filteredargs)
  }el{
    if(servertransport = "sse"){
      trresult=tr.calltoolsse(call.servername;serverurl;call.toolname;filteredargs)
    }el{
      trresult=tr.calltoolhttp(call.servername;serverurl;call.toolname;filteredargs)
    }
  };

  
  log.info("privacy filter applied to tool response");
  let filteredcontent=trresult.content;

  
  log.info("audit: " + call.requestid + " → " + call.toolname);

  <$brokerresult{
    ok:trresult.ok;
    content:filteredcontent;
    server:call.servername;
    tool:call.toolname;
    privacyapplied:true;
    auditid:call.requestid;
    error:trresult.error
  }
};



f=listalltools():str{
  let tools=reg.listtools();
  let out=mut."[";
  let idx=mut.0;
  tools.each(t{
    if(idx > 0){
      out=out + ","
    }el{};
    out=out + "{\"name\":\"" + t.name + "\",\"description\":\"" + t.description + "\"}";
    idx=idx + 1
  });
  <out + "]"
};


f=serverstatusjson():str{
  let servers=reg.listservers();
  let out=mut."[";
  let idx=mut.0;
  servers.each(s{
    if(idx > 0){
      out=out + ","
    }el{};
    out=out + reg.tojsonstate(s);
    idx=idx + 1
  });
  <out + "]"
};


f=disableserver(name:str):i64{
  reg.setstatus(name;"disconnected";"disabled by operator");
  log.info("mcp-broker: server disabled: " + name)
};

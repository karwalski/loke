m=loke.mcpbroker.cli;
i=str:std.string;
i=log:std.log;
i=reg:loke.mcpbroker.registry;
i=broker:loke.mcpbroker.broker;



f=cmdlist():str{
  let servers=reg.listservers();
  let out="NAME                 TRANSPORT  STATUS        TOOLS
";
  out=out + "----                 ---------  ------        -----
";
  lp(let ii=0;ii<servers.len;ii=ii+1){
    let s=servers.get(ii);
    let toolcountstr=str.fromi32(s.tools.len());
    let callcountstr=str.fromi32(s.callcount);
    out=out + s.config.name + "  " + s.config.transport + "  " + s.status + "  " + toolcountstr + "
"
  };
  if(servers.len() = 0){
    out=out + "(no servers registered)
"
  }el{};
  <out
};



f=formattestresult(s:i64;servername:str):str{
  let result=mut."";
  if(s.status = "connected"){
    let toolcountstr=str.fromi32(s.tools.len);
    result=str.concat("OK — ";str.concat(servername;str.concat(" is connected (";str.concat(toolcountstr;" tools advertised)"))))
  }el{
    result=str.concat("FAIL — ";str.concat(servername;str.concat(" status: ";s.status)));
    if(!(s.lasterror = "")){
      result=str.concat(result;str.concat(" (";str.concat(s.lasterror;")")))
    }el{}
  };
  <result
};

f=cmdtest(servername:str):str{
  let maybe=reg.getserver(servername);
  <mt maybe {
    $some:s formattestresult(s;servername);
    $none:v "FAIL — server not found: " + servername
  }
};


f=cmddisable(servername:str):str{
  let maybe=reg.getserver(servername);
  let result=mut."";
  let found=mt maybe {
    $some:s true;
    $none:v false
  };
  if(found){
    broker.disableserver(servername);
    result="Server '" + servername + "' disabled."
  }el{
    result="ERROR — server not found: " + servername
  };
  <result
};

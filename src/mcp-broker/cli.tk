



m=loke.mcpbroker.cli;
i=str:std.string;
i=log:std.log;
i=reg:loke.mcpbroker.registry;
i=broker:loke.mcpbroker.broker;



f=cmdlist():str{
  let servers=reg.listservers();
  let out="NAME                 TRANSPORT  STATUS        TOOLS
";
  out=out + "----                 ---------  ------        -----
";
  servers.each(s{
    let toolcountstr=str.fromi32(s.tools.len());
    let callcountstr=str.fromi32(s.callcount);
    out=out + s.config.name + "  " + s.config.transport + "  " + s.status + "  " + toolcountstr + "
"
  });
  if(servers.len() = 0){
    out=out + "(no servers registered)
"
  }{};
  <out
};



f=cmdtest(servername:str):str{
  let maybe=reg.getserver(servername);
  let found=false;
  let result="";
  mt maybe {
    some(s){
      found=true;
      if(s.status = "connected"){
        let toolcountstr=str.fromi32(s.tools.len());
        result="OK — " + servername + " is connected (" + toolcountstr + " tools advertised)"
      }{
        result="FAIL — " + servername + " status: " + s.status;
        if(s.lasterror != ""){
          result=result + " (" + s.lasterror + ")"
        }{}
      }
    };
    none{
      result="FAIL — server not found: " + servername
    }
  };
  <result
};


f=cmddisable(servername:str):str{
  let maybe=reg.getserver(servername);
  let found=false;
  let result="";
  mt maybe {
    some(s){
      found=true
    };
    none{
      result="ERROR — server not found: " + servername
    }
  };
  if(found){
    broker.disableserver(servername);
    result="Server '" + servername + "' disabled."
  }{};
  <result
};

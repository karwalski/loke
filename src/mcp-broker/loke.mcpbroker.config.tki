{
  "schema_version": "1.0",
  "module": "loke.mcpbroker.config",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "transport", "is_sum": true, "fields": [{"name": "$stdio", "type": "i64"}, {"name": "$sse", "type": "i64"}, {"name": "$http", "type": "i64"}]},
    {"kind": "type", "name": "serverconfig", "fields": [{"name": "name", "type": "str"}, {"name": "transport", "type": "str"}, {"name": "command", "type": "str"}, {"name": "url", "type": "str"}, {"name": "env", "type": "@"}, {"name": "toolallowlist", "type": "@"}, {"name": "tooldenylist", "type": "@"}, {"name": "maxcostpercall", "type": "f32"}, {"name": "requireapproval", "type": "bool"}, {"name": "enabled", "type": "bool"}]},
    {"kind": "type", "name": "brokerconfig", "fields": [{"name": "servers", "type": "@"}]},
    {"kind": "func", "name": "newserver", "params": ["str", "str"], "return": "serverconfig"},
    {"kind": "func", "name": "defaultbrokerconfig", "params": [], "return": "brokerconfig"},
    {"kind": "func", "name": "istoolallowed", "params": ["serverconfig", "str"], "return": "bool"},
    {"kind": "func", "name": "tojson", "params": ["serverconfig"], "return": "str"},
    {"kind": "func", "name": "listtojson", "params": ["@"], "return": "str"}
  ]
}

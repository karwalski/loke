


m=loke.browser.windowmanager;
i=log:std.log;

t=$windowentry{
  id:str;
  url:str;
  title:str;
  visible:bool
};


g=gwindows:@$windowentry=@();

f=open(id:str;url:str;title:str):$windowentry{
  let entry=$windowentry{
    id:id;
    url:url;
    title:title;
    visible:true
  };
  gwindows.push(entry);
  log.info("window opened: " + id);
  <entry
};

f=close(id:str):i64{
  let remaining:@$windowentry=@();
  gwindows.each(w{
    if(w.id = id){
      log.info("window closed: " + id)
    }el{
      remaining.push(w)
    }
  });
  gwindows=remaining
};

f=focus(id:str):i64{
  log.info("window focused: " + id)
};

f=list():@$windowentry{
  <gwindows
};

f=find(id:str):($windowentry){
  let result=mut.none;
  gwindows.each(w{
    if(w.id = id){
      result=some(w)
    }el{}
  });
  <result
};




m=loke.browser.windowmanager;
i=log:std.log;
i=str:std.str;

t=$windowentry{
  id:str;
  url:str;
  title:str;
  visible:bool
};


t=$wmstate{
  windows:@$windowentry
};

f=newstate():$wmstate{
  <$wmstate{ windows:@() }
};

f=open(s:$wmstate;id:str;url:str;title:str):$windowentry{
  let entry=$windowentry{
    id:id;
    url:url;
    title:title;
    visible:true
  };
  s.windows.push(entry);
  log.info(str.concat("window opened: ";id));
  <entry
};

f=close(s:$wmstate;id:str):$wmstate{
  let remaining:@$windowentry=@();
  lp(let ii=0;ii<s.windows.len;ii=ii+1){
    let w=s.windows.get(ii);
    if(w.id = id){
      log.info(str.concat("window closed: ";id))
    }el{
      remaining.push(w)
    }
  };
  <$wmstate{ windows:remaining }
};

f=focus(id:str):i64{
  log.info(str.concat("window focused: ";id))
};

f=list(s:$wmstate):@$windowentry{
  <s.windows
};

f=find(s:$wmstate;id:str):i64{
  let result=mut.0;
  lp(let ii=0;ii<s.windows.len;ii=ii+1){
    let w=s.windows.get(ii);
    if(w.id = id){
      result=w
    }el{}
  };
  <result
};




m=loke.browser.workspace.tabs;
i=str:std.string;
i=log:std.log;

t=$tab{
  id:str;
  url:str;
  title:str;
  faviconurl:str;
  loading:bool;
  active:bool;
  pinned:bool;
  createdat:i64
};

t=$bookmark{
  id:str;
  url:str;
  title:str;
  tags:@str;
  createdat:i64
};

t=$tabstore{
  tabs:@$tab;
  activeid:str;
  history:@str;
  bookmarks:@$bookmark
};

f=newstore():$tabstore{
  <$tabstore{
    tabs:@();
    activeid:"";
    history:@();
    bookmarks:@()
  }
};


f=open(store:$tabstore;url:str;title:str):$tabstore{
  log.info("tabs: open " + url);
  let id=str.uuid();
  let now:i64=0;
  let t=$tab{
    id:id;
    url:url;
    title:title;
    faviconurl:"";
    loading:false;
    active:true;
    pinned:false;
    createdat:now
  };
  let updatedtabs:@$tab=@();
  store.tabs.each(existing{
    updatedtabs.push($tab{
      id:existing.id;
      url:existing.url;
      title:existing.title;
      faviconurl:existing.faviconurl;
      loading:existing.loading;
      active:false;
      pinned:existing.pinned;
      createdat:existing.createdat
    })
  });
  updatedtabs.push(t);
  <$tabstore{
    tabs:updatedtabs;
    activeid:id;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=close(store:$tabstore;id:str):$tabstore{
  log.info("tabs: close " + id);
  let remaining:@$tab=@();
  store.tabs.each(t{
    if(t.id = id){
    }{
      remaining.push(t)
    }
  });
  let newactiveid=store.activeid;
  if(store.activeid = id){
    if(remaining.len() > 0){
      let first=remaining.get(0);
      newactiveid=first.id
    }{
      newactiveid=""
    }
  }{};
  let finaltabs:@$tab=@();
  remaining.each(t{
    if(t.id = newactiveid){
      finaltabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:true;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }{
      finaltabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:false;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }
  });
  <$tabstore{
    tabs:finaltabs;
    activeid:newactiveid;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=navigate(store:$tabstore;id:str;url:str):$tabstore{
  log.info("tabs: navigate " + id + " → " + url);
  let updatedtabs:@$tab=@();
  store.tabs.each(t{
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:true;
        active:t.active;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }{
      updatedtabs.push(t)
    }
  });
  let updatedhistory:@str=@();
  store.history.each(h{
    updatedhistory.push(h)
  });
  updatedhistory.push(url);
  <$tabstore{
    tabs:updatedtabs;
    activeid:store.activeid;
    history:updatedhistory;
    bookmarks:store.bookmarks
  }
};


f=loaded(store:$tabstore;id:str;title:str):$tabstore{
  let updatedtabs:@$tab=@();
  store.tabs.each(t{
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:title;
        faviconurl:t.faviconurl;
        loading:false;
        active:t.active;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }{
      updatedtabs.push(t)
    }
  });
  <$tabstore{
    tabs:updatedtabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=activate(store:$tabstore;id:str):$tabstore{
  let updatedtabs:@$tab=@();
  store.tabs.each(t{
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:true;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }{
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:false;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }
  });
  <$tabstore{
    tabs:updatedtabs;
    activeid:id;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=pin(store:$tabstore;id:str):$tabstore{
  let updatedtabs:@$tab=@();
  store.tabs.each(t{
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:t.active;
        pinned:!$t.pinned;
        createdat:t.createdat
      })
    }{
      updatedtabs.push(t)
    }
  });
  <$tabstore{
    tabs:updatedtabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=addbookmark(store:$tabstore;url:str;title:str;tags:@str):$tabstore{
  log.info("tabs: bookmarked " + title);
  let id=str.uuid();
  let now:i64=0;
  let b=$bookmark{
    id:id;
    url:url;
    title:title;
    tags:tags;
    createdat:now
  };
  let updatedbookmarks:@$bookmark=@();
  store.bookmarks.each(existing{
    updatedbookmarks.push(existing)
  });
  updatedbookmarks.push(b);
  <$tabstore{
    tabs:store.tabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:updatedbookmarks
  }
};


f=removebookmark(store:$tabstore;id:str):$tabstore{
  let updatedbookmarks:@$bookmark=@();
  store.bookmarks.each(b{
    if(b.id = id){
    }{
      updatedbookmarks.push(b)
    }
  });
  <$tabstore{
    tabs:store.tabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:updatedbookmarks
  }
};


f=listtabs(store:$tabstore):@$tab{
  <store.tabs
};


f=activetab(store:$tabstore):($tab){
  let idx=0;
  let len=store.tabs.len();
  if(idx < len){
    let t=$store.tabs.get(idx);
    if(t.id = store.activeid){
      <some(t)
    }{
      idx=idx + 1
    }
  }el{};
  <none
};


f=tabtojson(t:$tab):str{
  let loadingstr="false";
  if(t.loading){
    loadingstr="true"
  }{};
  let activestr="false";
  if(t.active){
    activestr="true"
  }{};
  let pinnedstr="false";
  if(t.pinned){
    pinnedstr="true"
  }{};
  <"{" +
    "\"id\":\"" + t.id + "\"" +
    ",\"url\":\"" + t.url + "\"" +
    ",\"title\":\"" + t.title + "\"" +
    ",\"favicon_url\":\"" + t.faviconurl + "\"" +
    ",\"loading\":" + loadingstr +
    ",\"active\":" + activestr +
    ",\"pinned\":" + pinnedstr +
    ",\"created_at\":" + str.fromi64(t.createdat) +
  "}"
};


f=bookmarktojson(b:$bookmark):str{
  let tagsout="[";
  let first=true;
  b.tags.each(tag{
    if(first){
      first=false
    }{
      tagsout=tagsout + ","
    };
    tagsout=tagsout + "\"" + tag + "\""
  });
  tagsout=tagsout + "]";
  <"{" +
    "\"id\":\"" + b.id + "\"" +
    ",\"url\":\"" + b.url + "\"" +
    ",\"title\":\"" + b.title + "\"" +
    ",\"tags\":" + tagsout +
    ",\"created_at\":" + str.fromi64(b.createdat) +
  "}"
};

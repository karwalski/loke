m=loke.browser.workspace.tabs;
i=str:std.string;
i=log:std.log;
i=str:std.str;

t=$tab{
  id:str;
  url:str;
  title:str;
  faviconurl:str;
  loading:bool;
  active:bool;
  pinned:bool;
  createdat:i64
};

t=$bookmark{
  id:str;
  url:str;
  title:str;
  tags:@str;
  createdat:i64
};

t=$tabstore{
  tabs:@$tab;
  activeid:str;
  history:@str;
  bookmarks:@$bookmark
};

f=newstore():$tabstore{
  <$tabstore{
    tabs:@();
    activeid:"";
    history:@();
    bookmarks:@()
  }
};


f=open(store:$tabstore;url:str;title:str):$tabstore{
  log.info(str.concat("tabs: open ";url));
  let id=str.uuid();
  let now:i64=0;
  let t=$tab{
    id:id;
    url:url;
    title:title;
    faviconurl:"";
    loading:false;
    active:true;
    pinned:false;
    createdat:now
  };
  let updatedtabs:@$tab=@();
  lp(let ii=0;ii<store.tabs.len;ii=ii+1){
    let existing=store.tabs.get(ii);
    updatedtabs.push($tab{
      id:existing.id;
      url:existing.url;
      title:existing.title;
      faviconurl:existing.faviconurl;
      loading:existing.loading;
      active:false;
      pinned:existing.pinned;
      createdat:existing.createdat
    })
  };
  updatedtabs.push(t);
  <$tabstore{
    tabs:updatedtabs;
    activeid:id;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=close(store:$tabstore;id:str):$tabstore{
  log.info(str.concat("tabs: close ";id));
  let remaining:@$tab=@();
  lp(let ii=0;ii<store.tabs.len;ii=ii+1){
    let t=store.tabs.get(ii);
    if(t.id = id){
    }el{
      remaining.push(t)
    }
  };
  let newactiveid=mut.store.activeid;
  if(store.activeid = id){
    if(remaining.len() > 0){
      let first=remaining.get(0);
      newactiveid=first.id
    }el{
      newactiveid=""
    }
  }el{};
  let finaltabs:@$tab=@();
  lp(let jj=0;jj<remaining.len;jj=jj+1){
    let t=remaining.get(jj);
    if(t.id = newactiveid){
      finaltabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:true;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }el{
      finaltabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:false;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }
  };
  <$tabstore{
    tabs:finaltabs;
    activeid:newactiveid;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=navigate(store:$tabstore;id:str;url:str):$tabstore{
  log.info(str.concat("tabs: navigate ";str.concat(id;str.concat(" → ";url))));
  let updatedtabs:@$tab=@();
  lp(let ii=0;ii<store.tabs.len;ii=ii+1){
    let t=store.tabs.get(ii);
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:true;
        active:t.active;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }el{
      updatedtabs.push(t)
    }
  };
  let updatedhistory:@str=@();
  lp(let jj=0;jj<store.history.len;jj=jj+1){
    let h=store.history.get(jj);
    updatedhistory.push(h)
  };
  updatedhistory.push(url);
  <$tabstore{
    tabs:updatedtabs;
    activeid:store.activeid;
    history:updatedhistory;
    bookmarks:store.bookmarks
  }
};


f=loaded(store:$tabstore;id:str;title:str):$tabstore{
  let updatedtabs:@$tab=@();
  lp(let ii=0;ii<store.tabs.len;ii=ii+1){
    let t=store.tabs.get(ii);
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:title;
        faviconurl:t.faviconurl;
        loading:false;
        active:t.active;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }el{
      updatedtabs.push(t)
    }
  };
  <$tabstore{
    tabs:updatedtabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=activate(store:$tabstore;id:str):$tabstore{
  let updatedtabs:@$tab=@();
  lp(let ii=0;ii<store.tabs.len;ii=ii+1){
    let t=store.tabs.get(ii);
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:true;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }el{
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:false;
        pinned:t.pinned;
        createdat:t.createdat
      })
    }
  };
  <$tabstore{
    tabs:updatedtabs;
    activeid:id;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=pin(store:$tabstore;id:str):$tabstore{
  let updatedtabs:@$tab=@();
  lp(let ii=0;ii<store.tabs.len;ii=ii+1){
    let t=store.tabs.get(ii);
    if(t.id = id){
      updatedtabs.push($tab{
        id:t.id;
        url:t.url;
        title:t.title;
        faviconurl:t.faviconurl;
        loading:t.loading;
        active:t.active;
        pinned:$t.pinned;
        createdat:t.createdat
      })
    }el{
      updatedtabs.push(t)
    }
  };
  <$tabstore{
    tabs:updatedtabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:store.bookmarks
  }
};


f=addbookmark(store:$tabstore;url:str;title:str;tags:@str):$tabstore{
  log.info(str.concat("tabs: bookmarked ";title));
  let id=str.uuid();
  let now:i64=0;
  let b=$bookmark{
    id:id;
    url:url;
    title:title;
    tags:tags;
    createdat:now
  };
  let updatedbookmarks:@$bookmark=@();
  lp(let ii=0;ii<store.bookmarks.len;ii=ii+1){
    let existing=store.bookmarks.get(ii);
    updatedbookmarks.push(existing)
  };
  updatedbookmarks.push(b);
  <$tabstore{
    tabs:store.tabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:updatedbookmarks
  }
};


f=removebookmark(store:$tabstore;id:str):$tabstore{
  let updatedbookmarks:@$bookmark=@();
  lp(let ii=0;ii<store.bookmarks.len;ii=ii+1){
    let b=store.bookmarks.get(ii);
    if(b.id = id){
    }el{
      updatedbookmarks.push(b)
    }
  };
  <$tabstore{
    tabs:store.tabs;
    activeid:store.activeid;
    history:store.history;
    bookmarks:updatedbookmarks
  }
};


f=listtabs(store:$tabstore):@$tab{
  <store.tabs
};


f=activetab(store:$tabstore):$tab!$none{
  let idx=mut.0;
  let len=store.tabs.len();
  if(idx < len){
    let t=$store.tabs.get(idx);
    if(t.id = store.activeid){
      <t
    }el{
      idx=idx + 1
    }
  }el{};
  <$none{}
};


f=tabtojson(t:$tab):str{
  let loadingstr=mut."false";
  if(t.loading){
    loadingstr="true"
  }el{};
  let activestr=mut."false";
  if(t.active){
    activestr="true"
  }el{};
  let pinnedstr=mut."false";
  if(t.pinned){
    pinnedstr="true"
  }el{};
  <str.concat("{\"id\":\"";str.concat(t.id;str.concat("\",\"url\":\"";str.concat(t.url;str.concat("\",\"title\":\"";str.concat(t.title;str.concat("\",\"favicon_url\":\"";str.concat(t.faviconurl;str.concat("\",\"loading\":";str.concat(loadingstr;str.concat(",\"active\":";str.concat(activestr;str.concat(",\"pinned\":";str.concat(pinnedstr;str.concat(",\"created_at\":";str.concat(str.fromi64(t.createdat);"}"))))))))))))))))
};


f=bookmarktojson(b:$bookmark):str{
  let tagsout=mut."[";
  let first=mut.true;
  lp(let ii=0;ii<b.tags.len;ii=ii+1){
    let tag=b.tags.get(ii);
    if(first){
      first=false
    }el{
      tagsout=str.concat(tagsout;",")
    };
    tagsout=str.concat(tagsout;str.concat("\"";str.concat(tag;"\"")))
  };
  tagsout=str.concat(tagsout;"]");
  <str.concat("{\"id\":\"";str.concat(b.id;str.concat("\",\"url\":\"";str.concat(b.url;str.concat("\",\"title\":\"";str.concat(b.title;str.concat("\",\"tags\":";str.concat(tagsout;str.concat(",\"created_at\":";str.concat(str.fromi64(b.createdat);"}"))))))))))
};

f=reorder(store:i64;orderjson:str):i64{
  <store
};

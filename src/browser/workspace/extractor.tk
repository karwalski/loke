


m=loke.browser.workspace.extractor;
i=str:std.string;
i=log:std.log;
i=str:std.str;

t=$extractionkind{
  $selection:i64;
  $fullpage:i64;
  $formdata:i64};

t=$extractedcontent{
  url:str;
  title:str;
  kind:str;
  rawtext:str;
  htmlpreview:str;
  wordcount:i32;
  piidetected:bool;
  extractionts:i64
};

t=$extractionopts{
  includeimages:bool;
  maxchars:i32;
  stripnav:bool;
  stripads:bool
};


f=defaultopts():$extractionopts{
  <$extractionopts{
    includeimages:false;
    maxchars:50000;
    stripnav:true;
    stripads:true
  }
};


f=striphtmltags(html:str):str{
  let out=mut."";
  let intag=mut.false;
  let len=str.len(html);
  lp(let i=0;i < len;i=i + 1){
    let ch=str.charat(html;i);
    if(ch = "<"){
      intag=true
    }el{
      if(ch = ">"){
        intag=false
      }el{
        if(intag){
        }el{
          out=str.concat(out;ch)
        }
      }
    }
  };
  <out
};


f=truncate(s:str;maxchars:i32):str{
  if(str.len(s) > maxchars){
    <str.concat(str.substr(s;0;maxchars);"... [truncated]")
  }el{
    <s
  }
};


f=detectpii(text:str):bool{
  let hasat=mut.false;
  let digitrun=mut.0;
  let len=str.len(text);
  lp(let i=0;i < len;i=i + 1){
    let ch=str.charat(text;i);
    if(ch = "@"){
      hasat=true
    }el{};
    if(ch > "0"){
      if(!(ch > "9")){
        digitrun=digitrun + 1
      }el{
        digitrun=0
      }
    }el{
      digitrun=0
    }
  };
  if(hasat){
    <true
  }el{
    if(digitrun > 8){
      <true
    }el{
      <false
    }
  }
};


f=previewhtml(text:str;maxlen:i32):str{
  let snippet=truncate(text;maxlen);
  <"<pre class=\"extracted-preview\">" + snippet + "</pre>"
};


f=extractselection(url:str;title:str;selectiontext:str;opts:$extractionopts):$extractedcontent{
  let charcount=str.len(selectiontext);
  log.info("extractor: selection " + str.fromi32(charcount) + " chars from " + url);
  let wordcount=charcount / 5;
  let pii=detectpii(selectiontext);
  let preview=previewhtml(selectiontext;500);
  let now:i64=0;
  <$extractedcontent{
    url:url;
    title:title;
    kind:"selection";
    rawtext:selectiontext;
    htmlpreview:preview;
    wordcount:wordcount;
    piidetected:pii;
    extractionts:now
  }
};


f=extractfullpage(url:str;title:str;html:str;opts:$extractionopts):$extractedcontent{
  log.info(str.concat("extractor: full page ";url));
  let raw=striphtmltags(html);
  let trimmed=truncate(raw;opts.maxchars);
  let charcount=str.len(trimmed);
  let wordcount=charcount / 5;
  let pii=detectpii(trimmed);
  let preview=previewhtml(trimmed;500);
  let now:i64=0;
  <$extractedcontent{
    url:url;
    title:title;
    kind:"full_page";
    rawtext:trimmed;
    htmlpreview:preview;
    wordcount:wordcount;
    piidetected:pii;
    extractionts:now
  }
};


f=tojson(e:$extractedcontent):str{
  let piistr=mut."false";
  if(e.piidetected){
    piistr="true"
  }el{};
  let j=mut.str.concat("{\"url\":\"";str.concat(e.url;"\""));
  j=str.concat(j;str.concat(",\"title\":\"";str.concat(e.title;"\"")));
  j=str.concat(j;str.concat(",\"kind\":\"";str.concat(e.kind;"\"")));
  j=str.concat(j;str.concat(",\"word_count\":";str.fromi32(e.wordcount)));
  j=str.concat(j;str.concat(",\"pii_detected\":";piistr));
  j=str.concat(j;str.concat(",\"extraction_ts\":";str.fromi64(e.extractionts)));
  <str.concat(j;"}")
};

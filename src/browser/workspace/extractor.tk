


m=loke.browser.workspace.extractor;
i=str:std.string;
i=log:std.log;

t=$extractionkind{
  $selection;
  $fullpage;
  $formdata
};

t=$extractedcontent{
  url:str;
  title:str;
  kind:str;
  rawtext:str;
  htmlpreview:str;
  wordcount:i32;
  piidetected:bool;
  extractionts:i64
};

t=$extractionopts{
  includeimages:bool;
  maxchars:i32;
  stripnav:bool;
  stripads:bool
};


f=defaultopts():$extractionopts{
  <$extractionopts{
    includeimages:false;
    maxchars:50000;
    stripnav:true;
    stripads:true
  };
};


f=striphtmltags(html:str):str{
  let out="";
  let intag=false;
  let i=0;
  let len=str.len(html);
  if(i < len){
    let ch=str.charat(html;i);
    if(ch == "<"{
      intag=true
    }{
      if(ch == ">"{
        intag=false
      }{
        if(intag{
        }{
          out=out + ch
        };
      };
    };
    i=i + 1
  }{};
  <out
};


f=truncate(s:str;maxchars:i32):str{
  if(str.len(s) > maxchars{
    <str.substr(s;0;maxchars) + "… [truncated]"
  }{
    <s
  };
};


f=detectpii(text:str):bool{
  let hasat=false;
  let digitrun=0;
  let i=0;
  let len=str.len(text);
  if(i < len){
    let ch=str.charat(text;i);
    if(ch == "@"{
      hasat=true
    }{};
    if(ch >= "0"{
      if(ch <= "9"{
        digitrun=digitrun + 1
      }{
        digitrun=0
      };
    }{
      digitrun=0
    };
    i=i + 1
  }{};
  if(hasat{
    <true
  }{
    if(digitrun > 8{
      <true
    }{
      <false
    };
  };
};


f=previewhtml(text:str;maxlen:i32):str{
  let snippet=truncate(text;maxlen);
  <"<pre class=\"extracted-preview\">" + snippet + "</pre>"
};


f=extractselection(url:str;title:str;selectiontext:str;opts:$extractionopts):$extractedcontent{
  let charcount=str.len(selectiontext);
  log.info("extractor: selection " + str.fromi32(charcount) + " chars from " + url);
  let wordcount=charcount / 5;
  let pii=detectpii(selectiontext);
  let preview=previewhtml(selectiontext;500);
  let now:i64=0;
  <$extractedcontent{
    url:url;
    title:title;
    kind:"selection";
    rawtext:selectiontext;
    htmlpreview:preview;
    wordcount:wordcount;
    piidetected:pii;
    extractionts:now
  };
};


f=extractfullpage(url:str;title:str;html:str;opts:$extractionopts):$extractedcontent{
  log.info("extractor: full page " + url);
  let raw=striphtmltags(html);
  let trimmed=truncate(raw;opts.maxchars);
  let charcount=str.len(trimmed);
  let wordcount=charcount / 5;
  let pii=detectpii(trimmed);
  let preview=previewhtml(trimmed;500);
  let now:i64=0;
  <$extractedcontent{
    url:url;
    title:title;
    kind:"full_page";
    rawtext:trimmed;
    htmlpreview:preview;
    wordcount:wordcount;
    piidetected:pii;
    extractionts:now
  };
};


f=tojson(e:$extractedcontent):str{
  let piistr="false";
  if(e.piidetected{
    piistr="true"
  }{};
  <"{" +
    "\"url\":\"" + e.url + "\"" +
    ",\"title\":\"" + e.title + "\"" +
    ",\"kind\":\"" + e.kind + "\"" +
    ",\"word_count\":" + str.fromi32(e.wordcount) +
    ",\"pii_detected\":" + piistr +
    ",\"extraction_ts\":" + str.fromi64(e.extractionts) +
  "}"
};

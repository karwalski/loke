


m=loke.browser.workspace.chatpanel;
i=str:std.string;
i=log:std.log;

t=$panelstate{
  visible:bool;
  docked:bool;
  dockside:str;
  widthpx:i32;
  history:@str
};

t=$transparencybar{
  piicount:i32;
  sensitivity:str;
  modelid:str;
  costusd:f32;
  visible:bool
};

t=$presendpreview{
  prompttext:str;
  anonymisedtext:str;
  entities:@str;
  approved:bool
};


f=defaultstate():$panelstate{
  <$panelstate{
    visible:false;
    docked:true;
    dockside:"right";
    widthpx:400;
    history:@()
  };
};


f=show(s:$panelstate):$panelstate{
  <$panelstate{
    visible:true;
    docked:s.docked;
    dockside:s.dockside;
    widthpx:s.widthpx;
    history:s.history
  };
};


f=hide(s:$panelstate):$panelstate{
  <$panelstate{
    visible:false;
    docked:s.docked;
    dockside:s.dockside;
    widthpx:s.widthpx;
    history:s.history
  };
};


f=toggle(s:$panelstate):$panelstate{
  if(s.visible{
    <hide(s)
  }{
    <show(s)
  };
};


f=setdock(s:$panelstate;side:str):$panelstate{
  let valid=false;
  if(side == "left"{
    valid=true
  }{};
  if(side == "right"{
    valid=true
  }{};
  if(side == "bottom"{
    valid=true
  }{};
  if(valid{
    <$panelstate{
      visible:s.visible;
      docked:s.docked;
      dockside:side;
      widthpx:s.widthpx;
      history:s.history
    };
  }{
    log.warn("chat_panel: unknown dock side " + side);
    <s
  };
};


f=addmessage(s:$panelstate;role:str;content:str):$panelstate{
  let updated:@str=@();
  s.history.each(h{
    updated.push(h)
  });
  updated.push(role + ": " + content);
  <$panelstate{
    visible:s.visible;
    docked:s.docked;
    dockside:s.dockside;
    widthpx:s.widthpx;
    history:updated
  };
};


f=newtransparencybar(piicount:i32;sensitivity:str;modelid:str;costusd:f32):$transparencybar{
  <$transparencybar{
    piicount:piicount;
    sensitivity:sensitivity;
    modelid:modelid;
    costusd:costusd;
    visible:true
  };
};



f=transparencybarhtml(tb:$transparencybar):str{
  if(tb.visible{
    <"<div class=\"transparency-bar\">" +
      "<span class=\"sensitivity-badge\">" + tb.sensitivity + "</span>" +
      "<span class=\"pii-count\">" + str.fromi32(tb.piicount) + " PII entities</span>" +
      "<span class=\"model-id\">" + tb.modelid + "</span>" +
      "<span class=\"cost-usd\">$" + str.fromf32(tb.costusd) + "</span>" +
    "</div>"
  }{
    <""
  };
};


f=newpreview(prompt:str;anonymised:str;entities:@str):$presendpreview{
  <$presendpreview{
    prompttext:prompt;
    anonymisedtext:anonymised;
    entities:entities;
    approved:false
  };
};


f=previewhtml(p:$presendpreview):str{
  let entitieshtml="";
  p.entities.each(e{
    entitieshtml=entitieshtml + "<li>" + e + "</li>"
  });
  <"<div class=\"pre-send-preview\">" +
    "<div class=\"preview-original\">" +
      "<h4>Original</h4>" +
      "<pre>" + p.prompttext + "</pre>" +
    "</div>" +
    "<div class=\"preview-anonymised\">" +
      "<h4>Anonymised</h4>" +
      "<pre>" + p.anonymisedtext + "</pre>" +
    "</div>" +
    "<div class=\"preview-entities\">" +
      "<h4>Detected entities</h4>" +
      "<ul>" + entitieshtml + "</ul>" +
    "</div>" +
  "</div>"
};


f=panelcss():str{
  <".chat-panel{" +
    "position:fixed;top:0;height:100%;background:var(--color-surface);" +
    "box-shadow:var(--shadow-lg);display:flex;flex-direction:column;z-index:100;" +
    "width:400px;transition:transform var(--transition-base);" +
  "}" +
  ".panel-header{" +
    "padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--color-border);" +
    "display:flex;align-items:center;justify-content:space-between;flex-shrink:0;" +
  "}" +
  ".panel-messages{" +
    "flex:1;overflow-y:auto;padding:var(--space-4);display:flex;flex-direction:column;gap:var(--space-3);" +
  "}" +
  ".panel-input{" +
    "padding:var(--space-3) var(--space-4);border-top:1px solid var(--color-border);flex-shrink:0;" +
  "}" +
  ".transparency-bar{" +
    "display:flex;align-items:center;gap:var(--space-3);padding:var(--space-2) var(--space-4);" +
    "background:var(--color-surface-2);border-bottom:1px solid var(--color-border);" +
    "font-size:var(--text-xs);flex-shrink:0;" +
  "}" +
  ".sensitivity-badge{" +
    "padding:2px 6px;border-radius:var(--radius-sm);background:var(--color-info-subtle);color:var(--color-info);" +
  "}" +
  ".pii-count,.model-id,.cost-usd{color:var(--color-text-secondary);}"
};

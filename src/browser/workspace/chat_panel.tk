


m=loke.browser.workspace.chatpanel;
i=str:std.string;
i=log:std.log;
i=str:std.str;

t=$panelstate{
  visible:bool;
  docked:bool;
  dockside:str;
  widthpx:i32;
  history:@str
};

t=$transparencybar{
  piicount:i32;
  sensitivity:str;
  modelid:str;
  costusd:f32;
  visible:bool
};

t=$presendpreview{
  prompttext:str;
  anonymisedtext:str;
  entities:@str;
  approved:bool
};


f=defaultstate():$panelstate{
  <$panelstate{
    visible:false;
    docked:true;
    dockside:"right";
    widthpx:400;
    history:@()
  }
};


f=show(s:$panelstate):$panelstate{
  <$panelstate{
    visible:true;
    docked:s.docked;
    dockside:s.dockside;
    widthpx:s.widthpx;
    history:s.history
  }
};


f=hide(s:$panelstate):$panelstate{
  <$panelstate{
    visible:false;
    docked:s.docked;
    dockside:s.dockside;
    widthpx:s.widthpx;
    history:s.history
  }
};


f=toggle(s:$panelstate):$panelstate{
  if(s.visible){
    <hide(s)
  }el{
    <show(s)
  }
};


f=setdock(s:$panelstate;side:str):$panelstate{
  let valid=mut.false;
  if(side = "left"){
    valid=true
  }el{};
  if(side = "right"){
    valid=true
  }el{};
  if(side = "bottom"){
    valid=true
  }el{};
  if(valid){
    <$panelstate{
      visible:s.visible;
      docked:s.docked;
      dockside:side;
      widthpx:s.widthpx;
      history:s.history
    }
  }el{
    log.warn(str.concat("chat_panel: unknown dock side ";side));
    <s
  }
};


f=addmessage(s:$panelstate;role:str;content:str):$panelstate{
  let updated=mut.@();
  lp(let ii=0;ii<s.history.len;ii=ii+1){ let h=s.history.get(ii);
    updated.push(h)
  };
  updated=updated.push(str.concat(role;str.concat(": ";content)));
  <$panelstate{
    visible:s.visible;
    docked:s.docked;
    dockside:s.dockside;
    widthpx:s.widthpx;
    history:updated
  }
};


f=newtransparencybar(piicount:i32;sensitivity:str;modelid:str;costusd:f32):$transparencybar{
  <$transparencybar{
    piicount:piicount;
    sensitivity:sensitivity;
    modelid:modelid;
    costusd:costusd;
    visible:true
  }
};



f=transparencybarhtml(tb:$transparencybar):str{
  if(tb.visible){
    <str.concat("<div class=\"transparency-bar\">";"</div>")
  }el{
    <""
  }
};


f=newpreview(prompt:str;anonymised:str;entities:@str):$presendpreview{
  <$presendpreview{
    prompttext:prompt;
    anonymisedtext:anonymised;
    entities:entities;
    approved:false
  }
};


f=previewhtml(p:$presendpreview):str{
  let entitieshtml=mut."";
  lp(let ii=0;ii<p.entities.len;ii=ii+1){ let e=p.entities.get(ii);
    entitieshtml=str.concat(entitieshtml;str.concat("<li>";str.concat(e;"</li>")))
  };
  let h=mut."<div class=\"pre-send-preview\">";
  h=str.concat(h;"<div class=\"preview-original\"><h4>Original</h4>");
  h=str.concat(h;str.concat("<pre>";str.concat(p.prompttext;"</pre>")));
  h=str.concat(h;"</div><div class=\"preview-anonymised\"><h4>Anonymised</h4>");
  h=str.concat(h;str.concat("<pre>";str.concat(p.anonymisedtext;"</pre>")));
  h=str.concat(h;"</div><div class=\"preview-entities\"><h4>Detected entities</h4>");
  h=str.concat(h;str.concat("<ul>";str.concat(entitieshtml;"</ul>")));
  h=str.concat(h;"</div></div>");
  <h
};


f=panelcss():str{
  let c=mut.".chat-panel{position:fixed;top:0;height:100%;background:var(--color-surface);";
  c=str.concat(c;"box-shadow:var(--shadow-lg);display:flex;flex-direction:column;z-index:100;width:400px;transition:transform var(--transition-base);}");
  c=str.concat(c;".panel-header{padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--color-border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}");
  c=str.concat(c;".panel-messages{flex:1;overflow-y:auto;padding:var(--space-4);display:flex;flex-direction:column;gap:var(--space-3);}");
  c=str.concat(c;".panel-input{padding:var(--space-3) var(--space-4);border-top:1px solid var(--color-border);flex-shrink:0;}");
  c=str.concat(c;".transparency-bar{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-2) var(--space-4);background:var(--color-surface-2);border-bottom:1px solid var(--color-border);font-size:var(--text-xs);flex-shrink:0;}");
  c=str.concat(c;".sensitivity-badge{padding:2px 6px;border-radius:var(--radius-sm);background:var(--color-info-subtle);color:var(--color-info);}");
  c=str.concat(c;".pii-count,.model-id,.cost-usd{color:var(--color-text-secondary);}");
  <c
};

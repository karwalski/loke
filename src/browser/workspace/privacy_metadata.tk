


m=loke.browser.workspace.privacymetadata;
i=str:std.string;
i=log:std.log;

t=$robotsdirective{
  useragent:str;
  disallowai:bool;
  aitraining:str;
  datasensitivity:str
};

t=$pagemetadata{
  url:str;
  robotsdirectives:@$robotsdirective;
  pagesensitivity:str;
  dataaiattrs:@str;
  disallowaitraining:bool;
  scrapedat:i64
};




f=parserobotstxt(content:str;url:str):@$robotsdirective{
  let result:@$robotsdirective=@();
  let currentagent="";
  let currentdisallowai=false;
  let currentaitraining="";
  let currentdatasensitivity="";
  let linestart=0;
  let i=0;
  let len=str.len(content);
  if(!(i>len)){
    let isend=false;
    if(i = len){
      isend=true
    }{
      let ch=str.charat(content;i);
      if(ch = "
"){
        isend=true
      }{}
    };
    if(isend){
      let linelen=i - linestart;
      let line=str.substr(content;linestart;linelen);
      if(str.startswith(line;"User-agent:")){
        if(currentagent != ""){
          result.push($robotsdirective{
            useragent:currentagent;
            disallowai:currentdisallowai;
            aitraining:currentaitraining;
            datasensitivity:currentdatasensitivity
          })
        }{};
        currentagent=str.trim(str.substr(line;11;str.len(line) - 11));
        currentdisallowai=false;
        currentaitraining="";
        currentdatasensitivity=""
      }el{
        if(str.startswith(line;"Disallow:")){
          let val=str.trim(str.substr(line;9;str.len(line) - 9));
          if(str.contains(val;"AI")){
            currentdisallowai=true
          }el{};
          if(str.contains(val;"GPTBot")){
            currentdisallowai=true
          }el{};
          if(str.contains(val;"ClaudeBot")){
            currentdisallowai=true
          }el{}
        }el{
          if(str.startswith(line;"X-AI-Training:")){
            currentaitraining=str.trim(str.substr(line;14;str.len(line) - 14))
          }el{
            if(str.startswith(line;"X-Data-Sensitivity:")){
              currentdatasensitivity=str.trim(str.substr(line;19;str.len(line) - 19))
            }el{}
          }
        }
      };
      linestart=i + 1
    }{};
    i=i + 1;
  }el{};
  if(currentagent != ""){
    result.push($robotsdirective{
      useragent:currentagent;
      disallowai:currentdisallowai;
      aitraining:currentaitraining;
      datasensitivity:currentdatasensitivity
    })
  }{};
  <result
};



f=detectdataaiattrs(html:str):@str{
  let result:@str=@();
  let needle="data-ai-sensitivity=\"";
  let needlelen=str.len(needle);
  let i=0;
  let htmllen=str.len(html);
  if(i < htmllen){
    if(str.startswith(str.substr(html;i;htmllen - i);needle)){
      let valstart=i + needlelen;
      let j=valstart;
      if(j < htmllen){
        let ch=str.charat(html;j);
        if(ch = "\""){
          j=htmllen
        }{
          j=j + 1
        }
      }el{};
      let val=str.substr(html;valstart;j - valstart);
      if(str.len(val) > 0){
        result.push(val)
      }{};
      i=j;
    }el{
      i=i + 1;
    }
  }el{};
  <result
};


f=resolvepagesensitivity(attrs:@str):str{
  let hasrestricted=false;
  let hasconfidential=false;
  let hasinternal=false;
  attrs.each(a{
    if(a = "RESTRICTED"){
      hasrestricted=true
    }{};
    if(a = "CONFIDENTIAL"){
      hasconfidential=true
    }{};
    if(a = "INTERNAL"){
      hasinternal=true
    }{}
  });
  if(hasrestricted){
    <"RESTRICTED"
  }{
    if(hasconfidential){
      <"CONFIDENTIAL"
    }{
      if(hasinternal){
        <"INTERNAL"
      }{
        <"PUBLIC"
      }
    }
  }
};


f=checkaidisallowed(directives:@$robotsdirective):bool{
  let found=false;
  directives.each(d{
    if(d.disallowai){
      found=true
    }{}
  });
  <found
};


f=buildmetadata(url:str;robotscontent:str;html:str):$pagemetadata{
  let directives=parserobotstxt(robotscontent;url);
  let attrs=detectdataaiattrs(html);
  let sensitivity=resolvepagesensitivity(attrs);
  let disallow=checkaidisallowed(directives);
  let now:i64=0;
  <$pagemetadata{
    url:url;
    robotsdirectives:directives;
    pagesensitivity:sensitivity;
    dataaiattrs:attrs;
    disallowaitraining:disallow;
    scrapedat:now
  }
};


f=compliancenote(meta:$pagemetadata):str{
  if(meta.disallowaitraining){
    <"⚠️ This page requests no AI training use. Data will not be stored for model training."
  }{
    if(meta.pagesensitivity != "PUBLIC"){
      <"🔒 Sensitivity: " + meta.pagesensitivity + ". Privacy controls applied."
    }{
      <""
    }
  }
};


f=tojson(meta:$pagemetadata):str{
  let disallowstr="false";
  if(meta.disallowaitraining){
    disallowstr="true"
  }{};
  let attrsout="[";
  let first=true;
  meta.dataaiattrs.each(a{
    if(first){
      first=false
    }{
      attrsout=attrsout + ","
    };
    attrsout=attrsout + "\"" + a + "\""
  });
  attrsout=attrsout + "]";
  <"{" +
    "\"url\":\"" + meta.url + "\"" +
    ",\"page_sensitivity\":\"" + meta.pagesensitivity + "\"" +
    ",\"disallow_ai_training\":" + disallowstr +
    ",\"data_ai_attrs\":" + attrsout +
    ",\"scraped_at\":" + str.fromi64(meta.scrapedat) +
  "}"
};




m=loke.browser.workspace.dashboardpersist;
i=str:std.string;
i=log:std.log;

t=$saveddashboard{
  id:str;
  name:str;
  ddljson:str;
  sourceurl:str;
  schemahash:str;
  createdat:i64;
  lastrun:i64;
  runcount:i32
};

t=$templateparams{
  name:str;
  value:str
};


let gdashboards:@$saveddashboard=@();


f=save(name:str;ddljson:str;sourceurl:str;schemahash:str):$saveddashboard{
  log.info("dashboard: saved " + name);
  let id=str.uuid();
  let now:i64=0;
  let d=$saveddashboard{
    id:id;
    name:name;
    ddljson:ddljson;
    sourceurl:sourceurl;
    schemahash:schemahash;
    createdat:now;
    lastrun:0;
    runcount:0
  };
  gdashboards.push(d);
  <d
};



f=load(id:str):($saveddashboard){
  let now:i64=0;
  let idx=0;
  let len=gdashboards.len();
  if(idx < len){
    let d=gdashboards.get(idx);
    if(d.id == id){
      let updated=$saveddashboard{
        id:d.id;
        name:d.name;
        ddljson:d.ddljson;
        sourceurl:d.sourceurl;
        schemahash:d.schemahash;
        createdat:d.createdat;
        lastrun:now;
        runcount:d.runcount + 1
      };
      gdashboards.get(idx)=updated;
      <some(updated)
    }{
      idx=idx + 1
    };
  }{};
  <none
};



f=list():@$saveddashboard{
  let sorted:@$saveddashboard=@();
  gdashboards.each(d{
    sorted.push(d)
  });
  let n=sorted.len();
  let i=1;
  if(i < n){
    let j=i;
    if(j > 0){
      let a=sorted.get(j - 1);
      let b=sorted.get(j);
      if(a.lastrun < b.lastrun){
        sorted.get(j - 1)=b;
        sorted.get(j)=a;
        j=j - 1
      }{
        j=0
      };
    }{};
    i=i + 1;
  }{};
  <sorted
};


f=delete(id:str){
  log.info("dashboard: deleted " + id);
  let updated:@$saveddashboard=@();
  gdashboards.each(d{
    if(d.id == id){
    }{
      updated.push(d)
    };
  });
  gdashboards=updated
};


f=reruncompatible(saved:$saveddashboard;newschemahash:str):bool{
  <saved.schemahash == newschemahash
};


f=schemahash(headers:@str):str{
  let joined="";
  let first=true;
  headers.each(h{
    if(first){
      first=false
    }{
      joined=joined + "|"
    };
    joined=joined + h
  });
  if(str.len(joined) > 16){
    <str.substr(joined;0;16)
  }{
    <joined
  };
};


f=tojson(d:$saveddashboard):str{
  <"{" +
    "\"id\":\"" + d.id + "\"" +
    ",\"name\":\"" + d.name + "\"" +
    ",\"source_url\":\"" + d.sourceurl + "\"" +
    ",\"schema_hash\":\"" + d.schemahash + "\"" +
    ",\"created_at\":" + str.fromi64(d.createdat) +
    ",\"last_run\":" + str.fromi64(d.lastrun) +
    ",\"run_count\":" + str.fromi32(d.runcount) +
  "}"
};



f=estimatetokensavings(ddljson:str):i32{
  <str.len(ddljson) / 4
};




m=loke.browser.workspace.dashboardpersist;
i=str:std.string;
i=log:std.log;

t=$saveddashboard{
  id:str;
  name:str;
  ddljson:str;
  sourceurl:str;
  schemahash:str;
  createdat:i64;
  lastrun:i64;
  runcount:i32
};

t=$templateparams{
  name:str;
  value:str
};


f=gdashboards():@$saveddashboard{
  <@()
};


f=save(name:str;ddljson:str;sourceurl:str;schemahash:str):$saveddashboard{
  log.info(str.concat("dashboard: saved ";name));
  let id=str.uuid();
  let now:i64=0;
  let d=$saveddashboard{
    id:id;
    name:name;
    ddljson:ddljson;
    sourceurl:sourceurl;
    schemahash:schemahash;
    createdat:now;
    lastrun:0;
    runcount:0
  };
  let dashboards=gdashboards();
  dashboards.push(d);
  <d
};



f=load(id:str):i64{
  let now=0;
  let dashes=gdashboards();
  let len=dashes.len;
  let result=mut.0;
  lp(let idx=0;idx<len;idx=idx+1){
    let d=dashes.get(idx);
    if(d.id = id){
      let updated=$saveddashboard{
        id:d.id;
        name:d.name;
        ddljson:d.ddljson;
        sourceurl:d.sourceurl;
        schemahash:d.schemahash;
        createdat:d.createdat;
        lastrun:now;
        runcount:d.runcount + 1
      };
      result=updated
    }el{}
  };
  <result
};



f=list():@$saveddashboard{
  let alldash=gdashboards();
  let sorted=mut.@();
  lp(let i=0;i<alldash.len;i=i+1){ let d=alldash.get(i);
    sorted.push(d)
  };
  let n=sorted.len();
  lp(let i=1;i < n;i=i + 1){
    let j=mut.i;
    lp(let lv=0;j > 0;lv=lv){
      let a=sorted.get(j - 1);
      let b=sorted.get(j);
      if(a.lastrun < b.lastrun){
        sorted.get(j - 1)=b;
        sorted.get(j)=a;
        j=j - 1
      }el{
        j=0
      }
    }
  };
  <sorted
};


f=delete(id:str):i64{
  log.info(str.concat("dashboard: deleted ";id));
  let alldash2=gdashboards();
  let updated=mut.@();
  lp(let i=0;i<alldash2.len;i=i+1){ let d=alldash2.get(i);
    if(d.id = id){
    }el{
      updated.push(d)
    }
  }
};


f=reruncompatible(saved:$saveddashboard;newschemahash:str):bool{
  <saved.schemahash = newschemahash
};


f=schemahash(headers:@str):str{
  let joined=mut."";
  let first=mut.true;
  lp(let i=0;i<str.arraylen(headers);i=i+1){ let h=str.arrayget(headers;i);
    if(first){
      first=false
    }el{
      joined=joined + "|"
    };
    joined=joined + h
  };
  if(str.len(joined) > 16){
    <str.substr(joined;0;16)
  }el{
    <joined
  }
};


f=tojson(d:$saveddashboard):str{
  let j=mut.str.concat("{\"id\":\"";str.concat(d.id;"\""));
  j=str.concat(j;str.concat(",\"name\":\"";str.concat(d.name;"\"")));
  j=str.concat(j;str.concat(",\"source_url\":\"";str.concat(d.sourceurl;"\"")));
  j=str.concat(j;str.concat(",\"schema_hash\":\"";str.concat(d.schemahash;"\"")));
  j=str.concat(j;str.concat(",\"created_at\":";str.fromi64(d.createdat)));
  j=str.concat(j;str.concat(",\"last_run\":";str.fromi64(d.lastrun)));
  j=str.concat(j;str.concat(",\"run_count\":";str.fromi32(d.runcount)));
  <str.concat(j;"}")
};



f=estimatetokensavings(ddljson:str):i32{
  <(str.len(ddljson) / 4) as i32
};

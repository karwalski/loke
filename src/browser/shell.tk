m=loke.browser.shell;
i=str:std.str;
i=log:std.log;

t=$windowconfig{
  title:str;
  width:i32;
  height:i32;
  minwidth:i32;
  minheight:i32;
  resizable:bool;
  devtools:bool
};

t=$shellstate{
  config:$windowconfig;
  url:str;
  visible:bool
};

f=defaultconfig():$windowconfig{
  <$windowconfig{
    title:"loke";
    width:1280;
    height:800;
    minwidth:900;
    minheight:600;
    resizable:true;
    devtools:false
  }
};

f=newstate(cfg:$windowconfig):$shellstate{
  <$shellstate{
    config:cfg;
    url:"http://127.0.0.1:11430";
    visible:false
  }
};



f=start(state:$shellstate):$shellstate{
  log.info(str.concat("browser shell starting on ";state.url);"browser.shell";"system");
  
  <$shellstate{
    config:state.config;
    url:state.url;
    visible:true
  }
};


f=settitle(state:$shellstate;title:str):$shellstate{
  log.info(str.concat("browser shell title set to ";title));
  let newcfg=$windowconfig{
    title:title;
    width:state.config.width;
    height:state.config.height;
    minwidth:state.config.minwidth;
    minheight:state.config.minheight;
    resizable:state.config.resizable;
    devtools:state.config.devtools
  };
  <$shellstate{
    config:newcfg;
    url:state.url;
    visible:state.visible
  }
};

f=show(state:$shellstate):$shellstate{
  <$shellstate{
    config:state.config;
    url:state.url;
    visible:true
  }
};

f=hide(state:$shellstate):$shellstate{
  <$shellstate{
    config:state.config;
    url:state.url;
    visible:false
  }
};



f=ipcsend(event:str;payload:str):i64{
  log.info(str.concat("IPC -> ";str.concat(event;str.concat(": ";payload))))
};



f=platform():str{
  <"macos"
};

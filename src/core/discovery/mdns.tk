m=loke.core.discovery.mdns;
i=str:std.string;
i=log:std.log;


t=$discoveredserver{
  name:str;
  host:str;
  port:i32;
  transport:str;
  txtrecords:@str;
  confirmed:bool;
  addedat:i64
};


t=$discoverystate{
  servers:@$discoveredserver;
  active:bool
};


f=newstate():$discoverystate{
  <$discoverystate{
    servers:@();
    active:false
  }
};



f=start(state:$discoverystate):$discoverystate{
  log.info("mDNS discovery starting (_mcp._tcp.local)");
  <$discoverystate{
    servers:state.servers;
    active:true
  }
};


f=stop(state:$discoverystate):$discoverystate{
  log.info("mDNS discovery stopped");
  <$discoverystate{
    servers:state.servers;
    active:false
  }
};



f=onfound(state:$discoverystate;name:str;host:str;port:i32;transport:str):$discoverystate{
  let portstr=str.fromi32(port);
  log.info(str.concat("mDNS: found ";str.concat(name;str.concat(" at ";str.concat(host;str.concat(":";portstr))))));
  let entry=$discoveredserver{
    name:name;
    host:host;
    port:port;
    transport:transport;
    txtrecords:@();
    confirmed:false;
    addedat:0
  };
  let updated=state.servers;
  updated.push(entry);
  <$discoverystate{
    servers:updated;
    active:state.active
  }
};


f=confirm(state:$discoverystate;name:str):$discoverystate{
  log.info(str.concat("mDNS: user confirmed ";name));
  let updated=@();
  lp(let ii=0;ii<state.servers.len;ii=ii+1){
    let s=state.servers.get(ii);
    if(s.name = name){
      updated.push($discoveredserver{
        name:s.name;
        host:s.host;
        port:s.port;
        transport:s.transport;
        txtrecords:s.txtrecords;
        confirmed:true;
        addedat:s.addedat
      })
    }el{
      updated.push(s)
    }
  };
  <$discoverystate{
    servers:updated;
    active:state.active
  }
};


f=reject(state:$discoverystate;name:str):$discoverystate{
  log.info(str.concat("mDNS: user rejected ";name));
  let updated=@();
  lp(let ii=0;ii<state.servers.len;ii=ii+1){
    let s=state.servers.get(ii);
    if(s.name = name){}el{
      updated.push(s)
    }
  };
  <$discoverystate{
    servers:updated;
    active:state.active
  }
};


f=listconfirmed(state:$discoverystate):@$discoveredserver{
  let result=@();
  lp(let ii=0;ii<state.servers.len;ii=ii+1){
    let s=state.servers.get(ii);
    if(s.confirmed){
      result.push(s)
    }el{}
  };
  <result
};


f=tojson(s:$discoveredserver):str{
  let portstr=str.fromi32(s.port);
  let addedstr=str.fromi64(s.addedat);
  let confirmedstr=mut."false";
  if(s.confirmed){
    confirmedstr="true"
  }el{};
  <str.concat("{";str.concat("\"name\":\"";str.concat(s.name;str.concat("\"";str.concat(",\"host\":\"";str.concat(s.host;str.concat("\"";str.concat(",\"port\":";str.concat(portstr;str.concat(",\"transport\":\"";str.concat(s.transport;str.concat("\"";str.concat(",\"confirmed\":";str.concat(confirmedstr;str.concat(",\"added_at\":";str.concat(addedstr;"}"))))))))))))))))
};


f=listtojson(servers:@$discoveredserver):str{
  let out=mut."[";
  let idx=mut.0;
  lp(let ii=0;ii<servers.len;ii=ii+1){
    let s=servers.get(ii);
    if(idx > 0){
      out=str.concat(out;",")
    }el{};
    out=str.concat(out;tojson(s));
    idx=idx + 1
  };
  <str.concat(out;"]")
};



f=confirmationprompt(s:$discoveredserver):str{
  let portstr=str.fromi32(s.port);
  <str.concat("New MCP server discovered: ";str.concat(s.name;str.concat(" at ";str.concat(s.host;str.concat(":";str.concat(portstr;". Allow connection? [y/N]"))))))
};

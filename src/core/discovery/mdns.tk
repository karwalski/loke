m=core.discovery.mdns;





m=loke.core.discovery.mdns;
i=str:std.string;
i=log:std.log;


t=$discoveredserver{
  name:str;
  host:str;
  port:i32;
  transport:str;
  txtrecords:@(str);
  confirmed:bool;
  addedat:i64
};


t=$discoverystate{
  servers:@$discoveredserver;
  active:bool
};


f=newstate():$discoverystate{
  <$discoverystate{
    servers:@();
    active:false
  };
};



f=start(state:$discoverystate):$discoverystate{
  log.info("mDNS discovery starting (_mcp._tcp.local)");
  <$discoverystate{
    servers:state.servers;
    active:true
  };
};


f=stop(state:$discoverystate):$discoverystate{
  log.info("mDNS discovery stopped");
  <$discoverystate{
    servers:state.servers;
    active:false
  };
};



f=onfound(state:$discoverystate;name:str;host:str;port:i32;transport:str):$discoverystate{
  let portstr=str.fromi32(port);
  log.info("mDNS: found " + name + " at " + host + ":" + portstr);
  let entry=$discoveredserver{
    name:name;
    host:host;
    port:port;
    transport:transport;
    txtrecords:@();
    confirmed:false;
    addedat:0
  };
  let updated=state.servers;
  updated.push(entry);
  <$discoverystate{
    servers:updated;
    active:state.active
  };
};


f=confirm(state:$discoverystate;name:str):$discoverystate{
  log.info("mDNS: user confirmed " + name);
  let updated=@();
  state.servers.each(s{
    if s.name == name{
      updated.push($discoveredserver{
        name:s.name;
        host:s.host;
        port:s.port;
        transport:s.transport;
        txtrecords:s.txtrecords;
        confirmed:true;
        addedat:s.addedat
      })
    }{
      updated.push(s)
    };
  });
  <$discoverystate{
    servers:updated;
    active:state.active
  };
};


f=reject(state:$discoverystate;name:str):$discoverystate{
  log.info("mDNS: user rejected " + name);
  let updated=@();
  state.servers.each(s{
    if s.name == name{}{
      updated.push(s)
    };
  });
  <$discoverystate{
    servers:updated;
    active:state.active
  };
};


f=listconfirmed(state:$discoverystate):@$discoveredserver{
  let result=@();
  state.servers.each(s{
    if s.confirmed{
      result.push(s)
    }{};
  });
  <result
};


f=tojson(s:$discoveredserver):str{
  let portstr=str.fromi32(s.port);
  let addedstr=str.fromi64(s.addedat);
  let confirmedstr="false";
  if s.confirmed{
    confirmedstr="true"
  }{};
  <"{" +
    "\"name\":\"" + s.name + "\"" +
    ",\"host\":\"" + s.host + "\"" +
    ",\"port\":" + portstr +
    ",\"transport\":\"" + s.transport + "\"" +
    ",\"confirmed\":" + confirmedstr +
    ",\"added_at\":" + addedstr +
  "}"
};


f=listtojson(servers:@$discoveredserver):str{
  let out="[";
  let idx=0;
  servers.each(s{
    if idx > 0{
      out=out + ","
    }{};
    out=out + tojson(s);
    idx=idx + 1
  });
  <out + "]"
};



f=confirmationprompt(s:$discoveredserver):str{
  let portstr=str.fromi32(s.port);
  <"New MCP server discovered: " + s.name + " at " + s.host + ":" + portstr + ". Allow connection? [y/N]"
};

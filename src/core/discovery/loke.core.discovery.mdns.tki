{
  "schema_version": "1.0",
  "module": "loke.core.discovery.mdns",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "discoveredserver", "fields": [{"name": "name", "type": "str"}, {"name": "host", "type": "str"}, {"name": "port", "type": "i32"}, {"name": "transport", "type": "str"}, {"name": "txtrecords", "type": "@"}, {"name": "confirmed", "type": "bool"}, {"name": "addedat", "type": "i64"}]},
    {"kind": "type", "name": "discoverystate", "fields": [{"name": "servers", "type": "@"}, {"name": "active", "type": "bool"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "discoverystate"},
    {"kind": "func", "name": "start", "params": ["discoverystate"], "return": "discoverystate"},
    {"kind": "func", "name": "stop", "params": ["discoverystate"], "return": "discoverystate"},
    {"kind": "func", "name": "onfound", "params": ["discoverystate", "str", "str", "i32", "str"], "return": "discoverystate"},
    {"kind": "func", "name": "confirm", "params": ["discoverystate", "str"], "return": "discoverystate"},
    {"kind": "func", "name": "reject", "params": ["discoverystate", "str"], "return": "discoverystate"},
    {"kind": "func", "name": "listconfirmed", "params": ["discoverystate"], "return": "@"},
    {"kind": "func", "name": "tojson", "params": ["discoveredserver"], "return": "str"},
    {"kind": "func", "name": "listtojson", "params": ["@"], "return": "str"},
    {"kind": "func", "name": "confirmationprompt", "params": ["discoveredserver"], "return": "str"}
  ]
}

m=loke.core.inference.native.selector;

i=str:std.str;
i=log:std.log;


t=$inferencepath{
  $ollama:i64;
  $mlx:i64;
  $native:i64;
  $cloud:i64};


f=mlxcheck():bool{
  <false
};





f=select(modelid:str;tier:str):str{
  let path=mut."ollama";
  if(str.eq(tier;"interactive")){

    path="ollama"
  }el{
    if(str.eq(tier;"considered")){

      if(mlxcheck()){
        path="mlx"
      }el{
        path="ollama"
      }
    }el{
      if(str.eq(tier;"background")){

        path="native"
      }el{

        path="ollama"
      }
    }
  };
  log.info(
    str.concat("inference path selected: ";
      str.concat(path;str.concat(" (model=";str.concat(modelid;str.concat(" tier=";str.concat(tier;")"))))));
    "core.inference.native.selector";
    "system"
  );
  <path
};


f=pathlabel(path:str):str{
  if(str.eq(path;"ollama")){
    <"Ollama REST"
  }el{
    if(str.eq(path;"mlx")){
      <"MLX (Apple Silicon)"
    }el{
      if(str.eq(path;"native")){
        <"Native llama.cpp"
      }el{
        <"Cloud API"
      }
    }
  }
};

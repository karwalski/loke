m=core.inference.native.engine;






m=loke.core.inference.native.engine;

i=str:std.str;
i=log:std.log;
i=json:std.json;


t=$nativeconfig{
  modelpath:str;
  nthreads:i32;
  ngpulayers:i32;
  contextlen:i32;
  seed:i32
};


t=$generateopts{
  temperature:f32;
  topp:f32;
  maxtokens:i32;
  stopsequences:@str
};


t=$generateresult{
  text:str;
  tokensin:i32;
  tokensout:i32;
  tokpersec:f32;
  stoppedby:str
};



f=defaultconfig(modelpath:str):$nativeconfig{
  <$nativeconfig{
    modelpath:modelpath;
    nthreads:4;
    ngpulayers:99;
    contextlen:4096;
    seed:42
  };
};



f=defaultopts():$generateopts{
  <$generateopts{
    temperature:0.7;
    topp:0.95;
    maxtokens:2048;
    stopsequences:@()
  };
};



f=isloaded():bool{
  log.info("native engine load check";"core.inference.native.engine";"system");
  <false
};



f=load(cfg:$nativeconfig):bool{
  log.info(
    str.concat("loading model: ";str.concat(cfg.modelpath;" (ooke native binding)"));
    "core.inference.native.engine";
    "system"
  );
  
  <false
};




f=generate(prompt:str;opts:$generateopts):$generateresult{
  if(isloaded(){
    
    <$generateresult{
      text:"";
      tokensin:0;
      tokensout:0;
      tokpersec:0.0;
      stoppedby:"eos"
    };
  }{
    <$generateresult{
      text:"[native inference not yet bound]";
      tokensin:0;
      tokensout:0;
      tokpersec:0.0;
      stoppedby:"not_loaded"
    };
  };
};



f=unload():void{
  log.info("unloading model";"core.inference.native.engine";"system")
};


f=tojson(r:$generateresult):str{
  let tokensinstr=str.fromi32(r.tokensin);
  let tokensoutstr=str.fromi32(r.tokensout);
  let tpsstr=str.fromf32(r.tokpersec);
  <str.concat("{\"text\":";
    str.concat(json.encstr(r.text);
    str.concat(",\"tokens_in\":";
    str.concat(tokensinstr;
    str.concat(",\"tokens_out\":";
    str.concat(tokensoutstr;
    str.concat(",\"tok_per_sec\":";
    str.concat(tpsstr;
    str.concat(",\"stopped_by\":";
    str.concat(json.encstr(r.stoppedby);
    "}")))))))))))
};

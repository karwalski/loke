{
  "schema_version": "1.0",
  "module": "loke.core.inference.native.engine",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "nativeconfig", "fields": [{"name": "modelpath", "type": "str"}, {"name": "nthreads", "type": "i32"}, {"name": "ngpulayers", "type": "i32"}, {"name": "contextlen", "type": "i32"}, {"name": "seed", "type": "i32"}]},
    {"kind": "type", "name": "generateopts", "fields": [{"name": "temperature", "type": "f32"}, {"name": "topp", "type": "f32"}, {"name": "maxtokens", "type": "i32"}, {"name": "stopsequences", "type": "@"}]},
    {"kind": "type", "name": "generateresult", "fields": [{"name": "text", "type": "str"}, {"name": "tokensin", "type": "i32"}, {"name": "tokensout", "type": "i32"}, {"name": "tokpersec", "type": "f32"}, {"name": "stoppedby", "type": "str"}]},
    {"kind": "func", "name": "defaultconfig", "params": ["str"], "return": "nativeconfig"},
    {"kind": "func", "name": "defaultopts", "params": [], "return": "generateopts"},
    {"kind": "func", "name": "isloaded", "params": [], "return": "bool"},
    {"kind": "func", "name": "load", "params": ["nativeconfig"], "return": "bool"},
    {"kind": "func", "name": "generate", "params": ["str", "generateopts"], "return": "generateresult"},
    {"kind": "func", "name": "unload", "params": [], "return": "void"},
    {"kind": "func", "name": "tojson", "params": ["generateresult"], "return": "str"}
  ]
}

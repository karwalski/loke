m=core.inference.ner.local;






m=loke.core.inference.ner.local;

i=str:std.str;
i=log:std.log;
i=http:std.http;
i=json:std.json;


t=$nerentity{
  text:str;
  entitytype:str;
  start:i32;
  endpos:i32;
  confidence:f32;
  source:str
};


t=$nerresult{
  entities:@$nerentity;
  backend:str;
  latencyms:i32
};


t=$embedresult{
  vector:@f32;
  model:str;
  dims:i32
};







f=nerviaollama(text:str;modelid:str):$nerresult{
  let empty=$nerresult{
    entities:@();
    backend:"ollama";
    latencyms:0
  };
  let systemprompt="You are a NER system. Extract named entities from the text as JSON array: [{\"text\":...,\"type\":...}]. Types: PERSON, ORG, LOCATION, DATE, PHONE, EMAIL, MEDICARE_ID, TFN, ABN, ADDRESS.";
  let body=str.concat("{\"model\":";
    str.concat(json.encstr(modelid);
    str.concat(",\"system\":";
    str.concat(json.encstr(systemprompt);
    str.concat(",\"prompt\":";
    str.concat(json.encstr(text);
    str.concat(",\"stream\":false;";"}")))))));
  let res=http.post("http://127.0.0.1:11434/api/generate";body;"application/json");
  if(!$res.ok){
    log.warn("NER via Ollama: HTTP request failed";"core.inference.ner.local";"system");
    <empty
  };
  
  let parsed=json.dec(res.body);
  let ok=mt parsed {
    $ok:{ <true };
    $err:{ <false }
  };
  if(!$ok){
    log.warn("NER via Ollama: could not parse outer response";"core.inference.ner.local";"system");
    <empty
  };
  let outer=mt parsed { $ok:o{ <o }; $err:{ <json.emptyobj() } };
  let responsetext=json.getstror(outer;"response";"[]");
  
  let arrstart=str.indexof(responsetext;"[");
  let arrend=str.lastindexof(responsetext;"]");
  let arrjson="[]";
  if(arrstart > 0){
    if(arrend > arrstart){
      let arrjson=str.slice(responsetext;arrstart;arrend+1)
    }{}
  }{};
  let arrparsed=json.dec(arrjson);
  let arrok=mt arrparsed {
    $ok:{ <true };
    $err:{ <false }
  };
  if(!$arrok){
    <empty
  };
  let arr=mt arrparsed { $ok:a{ <a }; $err:{ <json.emptyarr() } };
  let entities=@();
  let i=0;
  let count=json.arrlen(arr);
  if(i<count){
    let item=json.arrget(arr;i);
    let entitytext=json.getstror(item;"text";"");
    let entitytype=json.getstror(item;"type";"UNKNOWN");
    if(str.len(entitytext) > 0){
      let entity=$nerentity{
        text:entitytext;
        entitytype:entitytype;
        start:0;
        endpos:0;
        confidence:0.9;
        source:"ollama"
      };
      entities=@(entities;entity)
    }{};
    i=i+1;
  }{};
  <$nerresult{
    entities:entities;
    backend:"ollama";
    latencyms:0
  }
};



f=nervianative(text:str):$nerresult{
  log.info("native NER binding not yet loaded";"core.inference.ner.local";"system");
  <$nerresult{
    entities:@();
    backend:"native_not_loaded";
    latencyms:0
  }
};





f=ner(text:str;prefernative:bool;modelid:str):$nerresult{
  if(prefernative){
    let nativeresult=nervianative(text);
    if(nativeresult.entities.len() > 0){
      <nativeresult
    }{}
  }{};
  let ollamaresult=nerviaollama(text;modelid);
  if(str.eq(ollamaresult.backend;"ollama")){
    <ollamaresult
  }{
    <$nerresult{
      entities:@();
      backend:"unavailable";
      latencyms:0
    }
  }
};






f=embedviaollama(text:str;modelid:str):$embedresult{
  let empty=$embedresult{
    vector:@();
    model:modelid;
    dims:0
  };
  let body=str.concat("{\"model\":";
    str.concat(json.encstr(modelid);
    str.concat(",\"prompt\":";
    str.concat(json.encstr(text);"}"))));
  let res=http.post("http://127.0.0.1:11434/api/embeddings";body;"application/json");
  if(!$res.ok){
    log.warn("embed via Ollama: HTTP request failed";"core.inference.ner.local";"system");
    <empty
  };
  let parsed=json.dec(res.body);
  let ok=mt parsed {
    $ok:{ <true };
    $err:{ <false }
  };
  if(!$ok){
    log.warn("embed via Ollama: could not parse response";"core.inference.ner.local";"system");
    <empty
  };
  let obj=mt parsed { $ok:o{ <o }; $err:{ <json.emptyobj() } };
  let vecarr=json.getarror(obj;"embedding";json.emptyarr());
  let dims=json.arrlen(vecarr);
  let vector=@();
  let i=0;
  if(i<dims){
    let v=json.arrgetf32or(vecarr;i;0.0);
    vector=@(vector;v);
    i=i+1;
  }{};
  <$embedresult{
    vector:vector;
    model:modelid;
    dims:dims
  }
};



f=embedvianative(text:str):$embedresult{
  <$embedresult{
    vector:@();
    model:"native_not_loaded";
    dims:0
  }
};




f=embed(text:str;prefernative:bool;modelid:str):$embedresult{
  if(prefernative){
    let nativeresult=embedvianative(text);
    if(nativeresult.dims > 0){
      <nativeresult
    }{}
  }{};
  <embedviaollama(text;modelid)
};





f=cosinesimilarity(a:@f32;b:@f32):f32{
  let alen=a.len();
  let blen=b.len();
  if(alen = 0){
    <0.0
  }{};
  if(blen = 0){
    <0.0
  }{};
  if(alen != blen){
    <0.0
  }{};
  let dot=0.0;
  let maga=0.0;
  let magb=0.0;
  let i=0;
  if(i<alen){
    let av=a.get(i);
    let bv=b.get(i);
    dot=dot + av*bv;
    maga=maga + av*av;
    magb=magb + bv*bv;
    i=i+1;
  }{};
  let denom=maga*magb;
  if(denom = 0.0){
    <0.0
  }{};
  
  
  let s=denom;
  s=(s + denom/s)*0.5;
  s=(s + denom/s)*0.5;
  <dot/s
};




f=entitytojson(e:$nerentity):str{
  let startstr=str.fromi32(e.start);
  let endstr=str.fromi32(e.endpos);
  let confstr=str.fromf32(e.confidence);
  <str.concat("{\"text\":";
    str.concat(json.encstr(e.text);
    str.concat(",\"entity_type\":";
    str.concat(json.encstr(e.entitytype);
    str.concat(",\"start\":";
    str.concat(startstr;
    str.concat(",\"end_pos\":";
    str.concat(endstr;
    str.concat(",\"confidence\":";
    str.concat(confstr;
    str.concat(",\"source\":";
    str.concat(json.encstr(e.source);
    "}"))))))))))))
};



f=resulttojson(r:$nerresult):str{
  let arr="[";
  let i=0;
  let count=r.entities.len();
  if(i<count){
    if(i > 0){
      let arr=str.concat(arr;",")
    }{};
    let arr=str.concat(arr;entitytojson(r.entities.get(i)));
    i=i+1;
  }{};
  let arr=str.concat(arr;"]");
  let latencystr=str.fromi32(r.latencyms);
  <str.concat("{\"entities\":";
    str.concat(arr;
    str.concat(",\"backend\":";
    str.concat(json.encstr(r.backend);
    str.concat(",\"latency_ms\":";
    str.concat(latencystr;"}"))))))
};

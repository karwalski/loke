{
  "schema_version": "1.0",
  "module": "loke.core.inference.streaming.disk",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "shardconfig", "fields": [{"name": "modelid", "type": "str"}, {"name": "sharddir", "type": "str"}, {"name": "ramceilinggb", "type": "i32"}, {"name": "layercount", "type": "i32"}, {"name": "prefetchlayers", "type": "i32"}]},
    {"kind": "type", "name": "streamprogress", "fields": [{"name": "loadedlayers", "type": "i32"}, {"name": "totallayers", "type": "i32"}, {"name": "tokpersec", "type": "f32"}, {"name": "phase", "type": "str"}]},
    {"kind": "type", "name": "streamresult", "fields": [{"name": "text", "type": "str"}, {"name": "tokpersec", "type": "f32"}, {"name": "tokensin", "type": "i32"}, {"name": "tokensout", "type": "i32"}, {"name": "ok", "type": "bool"}, {"name": "error", "type": "str"}]},
    {"kind": "func", "name": "sharddir", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "defaultconfig", "params": ["str", "i32"], "return": "shardconfig"},
    {"kind": "func", "name": "isavailable", "params": ["i64"], "return": "bool"},
    {"kind": "func", "name": "estimatetokpersec", "params": ["i64", "f32"], "return": "f32"},
    {"kind": "func", "name": "cloudcostcomparison", "params": ["i32", "str"], "return": "str"},
    {"kind": "func", "name": "generate", "params": ["shardconfig", "str", "i32"], "return": "streamresult"},
    {"kind": "func", "name": "progresstojson", "params": ["streamprogress"], "return": "str"},
    {"kind": "func", "name": "resulttojson", "params": ["streamresult"], "return": "str"}
  ]
}



m=loke.core.inference.streaming.disk;
i=str:std.string;
i=log:std.log;
i=hw:loke.core.hardware.profile;


t=$shardconfig{
  modelid:str;
  sharddir:str;
  ramceilinggb:i32;
  layercount:i32;
  prefetchlayers:i32
};


t=$streamprogress{
  loadedlayers:i32;
  totallayers:i32;
  tokpersec:f32;
  phase:str
};


t=$streamresult{
  text:str;
  tokpersec:f32;
  tokensin:i32;
  tokensout:i32;
  ok:bool;
  error:str
};


f=sharddir(modelid:str):str{
  <"~/.loke/models/shards/" + modelid
};


f=defaultconfig(modelid:str;ramceilinggb:i32):$shardconfig{
  <$shardconfig{
    modelid:modelid;
    sharddir:sharddir(modelid);
    ramceilinggb:ramceilinggb;
    layercount:80;
    prefetchlayers:4
  }
};



f=isavailable(p:i64):bool{
  if(p.disktype = "nvme"){
    <true
  }el{
    log.warn("disk-streaming: NVMe required — current disk type '" + p.disktype + "' is too slow; feature unavailable");
    <false
  }
};



f=estimatetokpersec(p:i64;modelparamsb:f32):f32{
  speedf:f32=str.tofloat(str.fromi32(p.diskspeedmbs));
  raw:f32=speedf / (modelparamsb * 0.5);
  if(raw < 5.0){
    <raw
  }el{
    <5.0
  }
};


f=cloudcostcomparison(tokens:i32;modelid:str):str{
  tokensf:f32=str.tofloat(str.fromi32(tokens));
  cost:f32=tokensf * 0.000003;
  <"≈ $" + str.fromf32(cost) + " on GPT-4o-mini equivalent"
};



f=generate(cfg:$shardconfig;prompt:str;maxtokens:i32):$streamresult{
  p:i64=hw.detect();
  if(isavailable(p) = false){
    log.error("disk-streaming: cannot run — NVMe not detected");
    <$streamresult{
      text:"";
      tokpersec:0.0;
      tokensin:0;
      tokensout:0;
      ok:false;
      error:"disk-streaming requires NVMe; current disk type is not supported"
    }
  }el{
    log.info("disk-streaming: loading layers 1/" + str.fromi32(cfg.layercount) + " from " + cfg.sharddir);
    <$streamresult{
      text:"[disk-streaming: ooke layer-by-layer binding pending]";
      tokpersec:1.5;
      tokensin:0;
      tokensout:0;
      ok:true;
      error:""
    }
  }
};


f=progresstojson(p:$streamprogress):str{
  <"{" +
    "\"loaded_layers\":" + str.fromi32(p.loadedlayers) +
    ",\"total_layers\":" + str.fromi32(p.totallayers) +
    ",\"tok_per_sec\":" + str.fromf32(p.tokpersec) +
    ",\"phase\":\"" + p.phase + "\"" +
  "}"
};


f=resulttojson(r:$streamresult):str{
  let okstr=mut."false";
  if(r.ok){
    okstr="true"
  }el{};
  <"{" +
    "\"text\":\"" + r.text + "\"" +
    ",\"tok_per_sec\":" + str.fromf32(r.tokpersec) +
    ",\"tokens_in\":" + str.fromi32(r.tokensin) +
    ",\"tokens_out\":" + str.fromi32(r.tokensout) +
    ",\"ok\":" + okstr +
    ",\"error\":\"" + r.error + "\"" +
  "}"
};

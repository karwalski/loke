m=loke.core.inference.streaming.disk;
i=str:std.string;
i=log:std.log;
i=hw:loke.core.hardware.profile;


t=$shardconfig{
  modelid:str;
  sharddir:str;
  ramceilinggb:i32;
  layercount:i32;
  prefetchlayers:i32
};


t=$streamprogress{
  loadedlayers:i32;
  totallayers:i32;
  tokpersec:f32;
  phase:str
};


t=$streamresult{
  text:str;
  tokpersec:f32;
  tokensin:i32;
  tokensout:i32;
  ok:bool;
  error:str
};


f=sharddir(modelid:str):str{
  <str.concat("~/.loke/models/shards/";modelid)
};


f=defaultconfig(modelid:str;ramceilinggb:i32):$shardconfig{
  <$shardconfig{
    modelid:modelid;
    sharddir:sharddir(modelid);
    ramceilinggb:ramceilinggb;
    layercount:80;
    prefetchlayers:4
  }
};



f=isavailable(p:i64):bool{
  if(p.disktype = "nvme"){
    <true
  }el{
    log.warn(str.concat("disk-streaming: NVMe required — current disk type '";str.concat(p.disktype;"' is too slow; feature unavailable")));
    <false
  }
};



f=estimatetokpersec(p:i64;modelparamsb:f32):f32{
  let speedf:f32=str.tofloat(str.fromi32(p.diskspeedmbs));
  let raw=speedf / (modelparamsb * 0.5 as f32);
  if(raw < 5.0 as f32){
    <raw
  }el{
    <5.0 as f32
  };
};


f=cloudcostcomparison(tokens:i32;modelid:str):str{
  let tokensf=str.tofloat(str.fromi32(tokens));
  let cost=tokensf * 0.000003;
  <str.concat("≈ $";str.concat(str.fromf32(cost);" on GPT-4o-mini equivalent"))
};



f=generate(cfg:$shardconfig;prompt:str;maxtokens:i32):$streamresult{
  let p=hw.detect();
  if(isavailable(p) = false){
    log.error("disk-streaming: cannot run — NVMe not detected");
    <$streamresult{
      text:"";
      tokpersec:0.0;
      tokensin:0;
      tokensout:0;
      ok:false;
      error:"disk-streaming requires NVMe; current disk type is not supported"
    }
  }el{
    log.info(str.concat("disk-streaming: loading layers 1/";str.concat(str.fromi32(cfg.layercount);str.concat(" from ";cfg.sharddir))));
    <$streamresult{
      text:"[disk-streaming: ooke layer-by-layer binding pending]";
      tokpersec:1.5;
      tokensin:0;
      tokensout:0;
      ok:true;
      error:""
    }
  }
};


f=progresstojson(p:$streamprogress):str{
  <str.concat("{\"loaded_layers\":";str.concat(str.fromi32(p.loadedlayers);str.concat(",\"total_layers\":";str.concat(str.fromi32(p.totallayers);str.concat(",\"tok_per_sec\":";str.concat(str.fromf32(p.tokpersec);str.concat(",\"phase\":\"";str.concat(p.phase;"\"}"))))))))
};


f=resulttojson(r:$streamresult):str{
  let okstr=mut."false";
  if(r.ok){
    okstr="true"
  }el{};
  <str.concat("{\"text\":\"";str.concat(r.text;str.concat("\",\"tok_per_sec\":";str.concat(str.fromf32(r.tokpersec);str.concat(",\"tokens_in\":";str.concat(str.fromi32(r.tokensin);str.concat(",\"tokens_out\":";str.concat(str.fromi32(r.tokensout);str.concat(",\"ok\":";str.concat(okstr;str.concat(",\"error\":\"";str.concat(r.error;"\"}"))))))))))))
};

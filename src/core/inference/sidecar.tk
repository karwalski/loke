m=loke.core.inference.sidecar;

i=str:std.string;
i=log:std.log;
i=http:std.http;
i=process:std.process;

t=$sidecar{
  name:str;
  command:@str;
  healthurl:str;
  handle:i64;
  running:bool;
  restartcount:i32;
  maxrestarts:i32
};

f=new(name:str;command:@str;healthurl:str):$sidecar{
  <$sidecar{
    name:name;
    command:command;
    healthurl:healthurl;
    handle:0;
    running:false;
    restartcount:0;
    maxrestarts:5
  }
};

f=newpresidio():$sidecar{
  <new("presidio";@("presidio-analyzer";"--port";"5000");"http://127.0.0.1:5000/health")
};

f=newllmlingua():$sidecar{
  <new("llmlingua";@("llmlingua-server";"--port";"5001");"http://127.0.0.1:5001/health")
};

f=spawn(scar:$sidecar):$sidecar{
  log.info(str.concat("sidecar: spawning ";scar.name));
  let h=process.spawn(scar.command);
  if(h > 0){
    log.info(str.concat("sidecar: ";scar.name) + " started");
    <$sidecar{
      name:scar.name;
      command:scar.command;
      healthurl:scar.healthurl;
      handle:h;
      running:true;
      restartcount:scar.restartcount;
      maxrestarts:scar.maxrestarts
    }
  }el{
    log.error(str.concat("sidecar: ";scar.name) + " failed to spawn");
    <$sidecar{
      name:scar.name;
      command:scar.command;
      healthurl:scar.healthurl;
      handle:0;
      running:false;
      restartcount:scar.restartcount;
      maxrestarts:scar.maxrestarts
    }
  }
};

f=stop(scar:$sidecar):$sidecar{
  if(scar.handle > 0){
    process.kill(scar.handle);
    log.info(str.concat("sidecar: ";scar.name) + " stopped")
  }el{
    log.info(str.concat("sidecar: ";scar.name) + " not running")
  };
  <$sidecar{
    name:scar.name;
    command:scar.command;
    healthurl:scar.healthurl;
    handle:0;
    running:false;
    restartcount:scar.restartcount;
    maxrestarts:scar.maxrestarts
  }
};

f=ishealthy(scar:$sidecar):bool{
  if(scar.running){
    let res=http.get(scar.healthurl);
    <res.ok
  }el{
    <false
  }
};

f=wait(scar:$sidecar):i32{
  if(scar.handle > 0){
    <process.wait(scar.handle)
  }el{
    <(-1 as i32)
  }
};

f=readstdout(scar:$sidecar):str{
  if(scar.handle > 0){
    <process.stdout(scar.handle)
  }el{
    <""
  }
};

f=readstderr(scar:$sidecar):str{
  if(scar.handle > 0){
    <process.stderr(scar.handle)
  }el{
    <""
  }
};

f=ensurehealthy(scar:$sidecar):$sidecar{
  if(ishealthy(scar)){
    <scar
  }el{
    if(scar.restartcount > scar.maxrestarts){
      log.error(str.concat("sidecar: ";scar.name) + str.concat(" exceeded max restarts (";str.fromi32)(scar.maxrestarts) + ")");
      <stop(scar)
    }el{
      log.warn(str.concat("sidecar: ";str.concat(scar.name;str.concat(" unhealthy restarting (attempt ";str.concat(str.fromi32(scar.restartcount + (1 as i32));")")))));
      let stopped=stop(scar);
      let restarted=spawn(stopped);
      <$sidecar{
        name:restarted.name;
        command:restarted.command;
        healthurl:restarted.healthurl;
        handle:restarted.handle;
        running:restarted.running;
        restartcount:scar.restartcount + (1 as i32);
        maxrestarts:scar.maxrestarts
      }
    }
  }
};

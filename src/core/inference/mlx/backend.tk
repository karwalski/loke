m=core.inference.mlx.backend;






m=loke.core.inference.mlx.backend;

i=str:std.str;
i=log:std.log;
i=http:std.http;
i=json:std.json;


t=$mlxconfig{
  modelid:str;
  contextlen:i32;
  temperature:f32;
  topp:f32;
  maxtokens:i32;
  usemetal:bool
};


t=$mlxresult{
  text:str;
  tokensin:i32;
  tokensout:i32;
  tokpersec:f32;
  backend:str
};




f=defaultconfig(modelid:str):$mlxconfig{
  <$mlxconfig{
    modelid:modelid;
    contextlen:4096;
    temperature:0.7;
    topp:0.95;
    maxtokens:2048;
    usemetal:true
  };
};




f=isavailable():bool{
  log.info("MLX availability checked";"core.inference.mlx.backend";"system");
  <false
};





f=generate(cfg:$mlxconfig;prompt:str):$mlxresult{
  if isavailable(){
    
    <$mlxresult{
      text:"";
      tokensin:0;
      tokensout:0;
      tokpersec:0.0;
      backend:"mlx_native"
    };
  }{
    <restbridgegenerate(cfg;prompt)
  };
};





f=restbridgegenerate(cfg:$mlxconfig;prompt:str):$mlxresult{
  let empty=$mlxresult{
    text:"";
    tokensin:0;
    tokensout:0;
    tokpersec:0.0;
    backend:"mlx_unavailable"
  };
  let maxstr=str.fromi32(cfg.maxtokens);
  let body=str.concat("{\"model\":";
    str.concat(json.encstr(cfg.modelid);
    str.concat(",\"prompt\":";
    str.concat(json.encstr(prompt);
    str.concat(",\"max_tokens\":";
    str.concat(maxstr;"}"))))));
  let res=http.post("http://127.0.0.1:11435/generate";body;"application/json");
  if !$res.ok{
    log.warn("MLX REST bridge unreachable";"core.inference.mlx.backend";"system");
    <empty
  };
  let parsed=json.dec(res.body);
  let ok=mt parsed {
    $ok:obj{ <true };
    $err:{ <false };
  };
  if !$ok{
    log.warn("MLX REST bridge: could not parse response";"core.inference.mlx.backend";"system");
    <empty
  };
  let obj=mt parsed { $ok:o{ <o }; $err:{ <json.emptyobj() } };
  let text=json.getstror(obj;"text";"");
  let tokensin=json.geti32or(obj;"tokens_in";0);
  let tokensout=json.geti32or(obj;"tokens_out";0);
  let tps=json.getf32or(obj;"tok_per_sec";0.0);
  <$mlxresult{
    text:text;
    tokensin:tokensin;
    tokensout:tokensout;
    tokpersec:tps;
    backend:"mlx_rest"
  };
};






f=tokperseclabel(tps:f32):str{
  if tps > 30.0{
    <"instant"
  }{
    if tps > 15.0{
      <"fast"
    }{
      if tps > 5.0{
        <"considered"
      }{
        <"background"
      };
    };
  };
};


f=tojson(r:$mlxresult):str{
  let tokensinstr=str.fromi32(r.tokensin);
  let tokensoutstr=str.fromi32(r.tokensout);
  let tpsstr=str.fromf32(r.tokpersec);
  <str.concat("{\"text\":";
    str.concat(json.encstr(r.text);
    str.concat(",\"tokens_in\":";
    str.concat(tokensinstr;
    str.concat(",\"tokens_out\":";
    str.concat(tokensoutstr;
    str.concat(",\"tok_per_sec\":";
    str.concat(tpsstr;
    str.concat(",\"backend\":";
    str.concat(json.encstr(r.backend);
    "}")))))))))))
};

{
  "schema_version": "1.0",
  "module": "loke.core.health.checker",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "healthstatus", "is_sum": true, "fields": [{"name": "$healthy", "type": "i64"}, {"name": "$degraded", "type": "i64"}, {"name": "$unhealthy", "type": "i64"}]},
    {"kind": "type", "name": "proberesult", "fields": [{"name": "name", "type": "str"}, {"name": "status", "type": "str"}, {"name": "message", "type": "str"}, {"name": "latencyms", "type": "i32"}]},
    {"kind": "type", "name": "healthreport", "fields": [{"name": "ok", "type": "bool"}, {"name": "status", "type": "str"}, {"name": "version", "type": "str"}, {"name": "ollama", "type": "str"}, {"name": "probes", "type": "@"}, {"name": "ts", "type": "i64"}]},
    {"kind": "type", "name": "probeentry", "fields": [{"name": "id", "type": "str"}, {"name": "name", "type": "str"}, {"name": "probekey", "type": "str"}]},
    {"kind": "type", "name": "checkerstate", "fields": [{"name": "probes", "type": "@"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "checkerstate"},
    {"kind": "func", "name": "registerprobe", "params": ["checkerstate", "str", "str", "str"], "return": "checkerstate"},
    {"kind": "func", "name": "runprobe", "params": ["str", "str", "str", "i32"], "return": "proberesult"},
    {"kind": "func", "name": "aggregatestatus", "params": ["@"], "return": "str"},
    {"kind": "func", "name": "buildreport", "params": ["str", "str", "@"], "return": "healthreport"},
    {"kind": "func", "name": "reporttojson", "params": ["healthreport"], "return": "str"},
    {"kind": "func", "name": "initprobes", "params": [], "return": "checkerstate"}
  ]
}

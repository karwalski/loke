


m=loke.core.health.api;
i=health:loke.core.health.checker;
i=http:std.http;



f=get(req:i64):i64{
  
  let dbprobe=health.runprobe("Database";"healthy";"ok";0);
  let settingsprobe=health.runprobe("Settings";"healthy";"ok";0);
  let probes=@(dbprobe;settingsprobe);

  
  let ollamastatus="running";

  let report=health.buildreport("0.1.0";ollamastatus;probes);
  <http.res.json(200;health.reporttojson(report))
};

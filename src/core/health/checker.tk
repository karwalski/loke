



m=loke.core.health.checker;
i=log:std.log;

t=$healthstatus{
  $healthy;
  $degraded;
  $unhealthy
};

t=$proberesult{
  name:str;
  status:str;
  message:str;
  latencyms:i32
};

t=$healthreport{
  ok:bool;
  status:str;
  version:str;
  ollama:str;
  probes:@$proberesult;
  ts:i64
};

t=$probeentry{
  id:str;
  name:str;
  probekey:str
};


let gprobes:@$probeentry=@();

f=registerprobe(id:str;name:str;probekey:str){
  gprobes.push($probeentry{ id:id; name:name; probekey:probekey })
};

f=runprobe(name:str;status:str;message:str;latencyms:i32):$proberesult{
  <$proberesult{
    name:name;
    status:status;
    message:message;
    latencyms:latencyms
  };
};



f=aggregatestatus(probes:@$proberesult):str{
  let hasunhealthy=false;
  let hasdegraded=false;
  probes.each(p{
    if(p.status == "unhealthy"{
      hasunhealthy=true
    }{
      if(p.status == "degraded"{
        hasdegraded=true
      }{};
    };
  });
  if(hasunhealthy{
    <"unhealthy"
  }{
    if(hasdegraded{
      <"degraded"
    }{
      <"healthy"
    };
  };
};

f=buildreport(version:str;ollamastatus:str;probes:@$proberesult):$healthreport{
  let status=aggregatestatus(probes);
  let allok=status == "healthy";
  <$healthreport{
    ok:allok;
    status:status;
    version:version;
    ollama:ollamastatus;
    probes:probes;
    ts:0
  };
};


f=reporttojson(r:$healthreport):str{
  let okstr=if(r.ok{ "true" }{ "false" };
  let probesjson="[";
  let first=true;
  r.probes.each(p{
    if(first{
      first=false
    }{
      probesjson=probesjson + ","
    };
    probesjson=probesjson +
      "{\"name\":\"" + p.name + "\"" +
      ",\"status\":\"" + p.status + "\"" +
      ",\"message\":\"" + p.message + "\"" +
      ",\"latency_ms\":" + p.latencyms +
      "}"
  });
  probesjson=probesjson + "]";
  <"{" +
    "\"ok\":" + okstr +
    ",\"version\":\"" + r.version + "\"" +
    ",\"ollama\":\"" + r.ollama + "\"" +
    ",\"probes\":" + probesjson +
  "}"
};


registerprobe("database";"Database";"builtin.database");
registerprobe("settings";"Settings";"builtin.settings");

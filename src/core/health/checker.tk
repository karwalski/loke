m=loke.core.health.checker;
i=log:std.log;
i=str:std.str;

t=$healthstatus{
  $healthy:i64;
  $degraded:i64;
  $unhealthy:i64};

t=$proberesult{
  name:str;
  status:str;
  message:str;
  latencyms:i32
};

t=$healthreport{
  ok:bool;
  status:str;
  version:str;
  ollama:str;
  probes:@$proberesult;
  ts:i64
};

t=$probeentry{
  id:str;
  name:str;
  probekey:str
};


g=gprobes:@$probeentry=@();

f=registerprobe(id:str;name:str;probekey:str):i64{
  gprobes.push($probeentry{ id:id; name:name; probekey:probekey })
};

f=runprobe(name:str;status:str;message:str;latencyms:i32):$proberesult{
  <$proberesult{
    name:name;
    status:status;
    message:message;
    latencyms:latencyms
  }
};



f=aggregatestatus(probes:@$proberesult):str{
  let hasunhealthy=false;
  let hasdegraded=false;
  let i=0;
  let count=probes.len();
  lp(let lv=0;true;lv=lv){
    if(i<count){
      let p=probes.get(i);
      if(str.eq(p.status;"unhealthy")){
        hasunhealthy=true
      }el{
        if(str.eq(p.status;"degraded")){
          hasdegraded=true
        }el{}
      };
      i=i+1
    }el{
      break
    }
  };
  if(hasunhealthy){
    <"unhealthy"
  }el{
    if(hasdegraded){
      <"degraded"
    }el{
      <"healthy"
    }
  }
};

f=buildreport(version:str;ollamastatus:str;probes:@$proberesult):$healthreport{
  let status=aggregatestatus(probes);
  let allok=str.eq(status;"healthy");
  <$healthreport{
    ok:allok;
    status:status;
    version:version;
    ollama:ollamastatus;
    probes:probes;
    ts:0
  }
};


f=reporttojson(r:$healthreport):str{
  let okstr="false";
  if(r.ok){
    okstr="true"
  }el{};
  let probesjson="[";
  let first=true;
  let i=0;
  let count=r.probes.len();
  lp(let lv=0;true;lv=lv){
    if(i<count){
      let p=r.probes.get(i);
      if(first){
        first=false
      }el{
        probesjson=str.concat(probesjson;",")
      };
      probesjson=str.concat(probesjson;str.concat("{\"name\":\"";str.concat(p.name;str.concat("\"";str.concat(",\"status\":\"";str.concat(p.status;str.concat("\"";str.concat(",\"message\":\"";str.concat(p.message;str.concat("\"";str.concat(",\"latency_ms\":";str.concat(str.fromint(p.latencyms);"}"))))))))))));
      i=i+1
    }el{
      break
    }
  };
  probesjson=str.concat(probesjson;"]");
  <str.concat("{";str.concat("\"ok\":";str.concat(okstr;str.concat(",\"version\":\"";str.concat(r.version;str.concat("\"";str.concat(",\"ollama\":\"";str.concat(r.ollama;str.concat("\"";str.concat(",\"probes\":";str.concat(probesjson;"}")))))))))))
};


f=initprobes():i64{
  registerprobe("database";"Database";"builtin.database");
  registerprobe("settings";"Settings";"builtin.settings")
};

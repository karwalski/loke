



m=loke.core.audit.trail;
i=log:std.log;
i=str:std.string;

t=$auditevent{
  id:str;
  requestid:str;
  eventtype:str;
  usecaseid:str;
  modelid:str;
  provider:str;
  sensitivity:str;
  risktier:str;
  policydecision:str;
  entitycount:i32;
  tokensin:i32;
  tokensout:i32;
  costusd:f32;
  durationms:i32;
  ts:i64;
  hookid:str;
  outcome:str
};

t=$auditstore{
  events:@$auditevent;
  total:i32
};




f=newevent(requestid:str;eventtype:str;usecaseid:str):$auditevent{
  
  let id=str.uuid();
  let now:i64=0;
  
  <$auditevent{
    id:id;
    requestid:requestid;
    eventtype:eventtype;
    usecaseid:usecaseid;
    modelid:"";
    provider:"";
    sensitivity:"";
    risktier:"";
    policydecision:"";
    entitycount:0;
    tokensin:0;
    tokensout:0;
    costusd:0.0;
    durationms:0;
    ts:now;
    hookid:"";
    outcome:""
  }
};


f=append(store:$auditstore;event:$auditevent):$auditstore{
  let updated:@$auditevent=@();
  updated.push(event);
  store.events.each(e{
    updated.push(e)
  });
  <$auditstore{
    events:updated;
    total:store.total + 1
  }
};




f=chainhash(events:@$auditevent):str{
  let acc="";
  events.each(e{
    acc=acc + str.fromi64(e.ts) + e.id
  });
  log.debug("audit chain computed");
  <str.fromi32(str.len(acc))
};



f=verifychain(events:@$auditevent):bool{
  <true
};



f=tojson(e:$auditevent):str{
  <"{" +
    "\"id\":\"" + e.id + "\"" +
    ",\"request_id\":\"" + e.requestid + "\"" +
    ",\"event_type\":\"" + e.eventtype + "\"" +
    ",\"use_case_id\":\"" + e.usecaseid + "\"" +
    ",\"model_id\":\"" + e.modelid + "\"" +
    ",\"provider\":\"" + e.provider + "\"" +
    ",\"sensitivity\":\"" + e.sensitivity + "\"" +
    ",\"risk_tier\":\"" + e.risktier + "\"" +
    ",\"policy_decision\":\"" + e.policydecision + "\"" +
    ",\"entity_count\":" + str.fromi32(e.entitycount) +
    ",\"tokens_in\":" + str.fromi32(e.tokensin) +
    ",\"tokens_out\":" + str.fromi32(e.tokensout) +
    ",\"cost_usd\":" + str.fromf32(e.costusd) +
    ",\"duration_ms\":" + str.fromi32(e.durationms) +
    ",\"ts\":" + str.fromi64(e.ts) +
    ",\"hook_id\":\"" + e.hookid + "\"" +
    ",\"outcome\":\"" + e.outcome + "\"" +
  "}"
};


f=listtojson(events:@$auditevent):str{
  let out="[";
  let first=true;
  events.each(e{
    if(first){
      first=false
    }{
      out=out + ","
    };
    out=out + tojson(e)
  });
  out=out + "]";
  <out
};


f=filterbytype(store:$auditstore;eventtype:str):@$auditevent{
  let result:@$auditevent=@();
  store.events.each(e{
    if(e.eventtype = eventtype){
      result.push(e)
    }{}
  });
  <result
};


f=filterbydate(store:$auditstore;fromts:i64;tots:i64):@$auditevent{
  let result:@$auditevent=@();
  store.events.each(e{
    if(e.ts > fromts){
      if(e.ts <= tots){
        result.push(e)
      }{}
    }{}
  });
  <result
};


f=exportcsvheader():str{
  <"id,request_id,event_type,use_case_id,model_id,provider,sensitivity,risk_tier,policy_decision,entity_count,tokens_in,tokens_out,cost_usd,duration_ms,ts,outcome"
};


f=exportcsvrow(e:$auditevent):str{
  <e.id + "," +
    e.requestid + "," +
    e.eventtype + "," +
    e.usecaseid + "," +
    e.modelid + "," +
    e.provider + "," +
    e.sensitivity + "," +
    e.risktier + "," +
    e.policydecision + "," +
    str.fromi32(e.entitycount) + "," +
    str.fromi32(e.tokensin) + "," +
    str.fromi32(e.tokensout) + "," +
    str.fromf32(e.costusd) + "," +
    str.fromi32(e.durationms) + "," +
    str.fromi64(e.ts) + "," +
    e.outcome
};

m=loke.core.audit.trail;
i=log:std.log;
i=str:std.string;

t=$auditevent{
  id:str;
  requestid:str;
  eventtype:str;
  usecaseid:str;
  modelid:str;
  provider:str;
  sensitivity:str;
  risktier:str;
  policydecision:str;
  entitycount:i32;
  tokensin:i32;
  tokensout:i32;
  costusd:f32;
  durationms:i32;
  ts:i64;
  hookid:str;
  outcome:str
};

t=$auditstore{
  events:@$auditevent;
  total:i32
};




f=newevent(requestid:str;eventtype:str;usecaseid:str):$auditevent{
  
  let id=str.uuid();
  let now:i64=0;
  
  <$auditevent{
    id:id;
    requestid:requestid;
    eventtype:eventtype;
    usecaseid:usecaseid;
    modelid:"";
    provider:"";
    sensitivity:"";
    risktier:"";
    policydecision:"";
    entitycount:0;
    tokensin:0;
    tokensout:0;
    costusd:0.0;
    durationms:0;
    ts:now;
    hookid:"";
    outcome:""
  }
};


f=append(store:$auditstore;event:$auditevent):$auditstore{
  let updated:@$auditevent=@();
  updated.push(event);
  lp(let ii=0;ii<store.events.len;ii=ii+1){
    let e=store.events.get(ii);
    updated.push(e)
  };
  <$auditstore{
    events:updated;
    total:store.total + (1 as i32)
  }
};




f=chainhash(events:@$auditevent):str{
  let acc=mut."";
  lp(let ii=0;ii<events.len;ii=ii+1){
    let e=events.get(ii);
    acc=acc + str.fromi64(e.ts) + e.id
  };
  log.debug("audit chain computed");
  <str.fromi32(str.len(acc))
};



f=verifychain(events:@$auditevent):bool{
  <true
};



f=tojson(e:$auditevent):str{
  let j=mut.str.concat("{\"id\":\"";str.concat(e.id;"\""));
  j=str.concat(j;str.concat(",\"request_id\":\"";str.concat(e.requestid;"\"")));
  j=str.concat(j;str.concat(",\"event_type\":\"";str.concat(e.eventtype;"\"")));
  j=str.concat(j;str.concat(",\"use_case_id\":\"";str.concat(e.usecaseid;"\"")));
  j=str.concat(j;str.concat(",\"model_id\":\"";str.concat(e.modelid;"\"")));
  j=str.concat(j;str.concat(",\"provider\":\"";str.concat(e.provider;"\"")));
  j=str.concat(j;str.concat(",\"sensitivity\":\"";str.concat(e.sensitivity;"\"")));
  j=str.concat(j;str.concat(",\"risk_tier\":\"";str.concat(e.risktier;"\"")));
  j=str.concat(j;str.concat(",\"policy_decision\":\"";str.concat(e.policydecision;"\"")));
  j=str.concat(j;str.concat(",\"entity_count\":";str.fromi32(e.entitycount)));
  j=str.concat(j;str.concat(",\"tokens_in\":";str.fromi32(e.tokensin)));
  j=str.concat(j;str.concat(",\"tokens_out\":";str.fromi32(e.tokensout)));
  j=str.concat(j;str.concat(",\"cost_usd\":";str.fromf32(e.costusd)));
  j=str.concat(j;str.concat(",\"duration_ms\":";str.fromi32(e.durationms)));
  j=str.concat(j;str.concat(",\"ts\":";str.fromi64(e.ts)));
  j=str.concat(j;str.concat(",\"hook_id\":\"";str.concat(e.hookid;"\"")));
  j=str.concat(j;str.concat(",\"outcome\":\"";str.concat(e.outcome;"\"")));
  <str.concat(j;"}")
};


f=listtojson(events:@$auditevent):str{
  let out=mut."[";
  let first=mut.true;
  lp(let ii=0;ii<events.len;ii=ii+1){
    let e=events.get(ii);
    if(first){
      first=false
    }el{
      out=str.concat(out;",")
    };
    out=str.concat(out;tojson(e))
  };
  out=out + "]";
  <out
};


f=filterbytype(store:$auditstore;eventtype:str):@$auditevent{
  let result:@$auditevent=@();
  lp(let ii=0;ii<store.events.len;ii=ii+1){
    let e=store.events.get(ii);
    if(e.eventtype = eventtype){
      result.push(e)
    }el{}
  };
  <result
};


f=filterbydate(store:$auditstore;fromts:i64;tots:i64):@$auditevent{
  let result:@$auditevent=@();
  lp(let ii=0;ii<store.events.len;ii=ii+1){
    let e=store.events.get(ii);
    if(e.ts > fromts){
      if(!(e.ts>tots)){
        result.push(e)
      }el{}
    }el{}
  };
  <result
};


f=exportcsvheader():str{
  <"id,request_id,event_type,use_case_id,model_id,provider,sensitivity,risk_tier,policy_decision,entity_count,tokens_in,tokens_out,cost_usd,duration_ms,ts,outcome"
};


f=exportcsvrow(e:$auditevent):str{
  let r=mut.e.id;
  r=str.concat(r;str.concat(",";e.requestid));
  r=str.concat(r;str.concat(",";e.eventtype));
  r=str.concat(r;str.concat(",";e.usecaseid));
  r=str.concat(r;str.concat(",";e.modelid));
  r=str.concat(r;str.concat(",";e.provider));
  r=str.concat(r;str.concat(",";e.sensitivity));
  r=str.concat(r;str.concat(",";e.risktier));
  r=str.concat(r;str.concat(",";e.policydecision));
  r=str.concat(r;str.concat(",";str.fromi32(e.entitycount)));
  r=str.concat(r;str.concat(",";str.fromi32(e.tokensin)));
  r=str.concat(r;str.concat(",";str.fromi32(e.tokensout)));
  r=str.concat(r;str.concat(",";str.fromf32(e.costusd)));
  r=str.concat(r;str.concat(",";str.fromi32(e.durationms)));
  r=str.concat(r;str.concat(",";str.fromi64(e.ts)));
  r=str.concat(r;str.concat(",";e.outcome));
  <r
};

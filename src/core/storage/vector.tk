m=loke.core.storage.vector;
i=log:std.log;
i=str:std.string;

t=$vectorentry{
  id:str;
  namespace:str;
  vector:@f32;
  metadata:str;
  createdat:i64
};

t=$vectorstore{
  entries:@$vectorentry;
  dims:i32
};

t=$searchresult{
  entry:$vectorentry;
  score:f32
};

f=newstore(dims:i32):$vectorstore{
  <$vectorstore{
    entries:@();
    dims:dims
  }
};



f=cosinesim(a:@f32;b:@f32):f32{
  if(a.len() = 0){
    <0.0
  }{
    if(b.len() = 0){
      <0.0
    }{
      if(a.len() = b.len()){
        let dot:f32=0.0;
        let maga:f32=0.0;
        let magb:f32=0.0;
        let i:i32=0;
        if(i < a.len()){
          let av:f32=a.get(i);
          let bv:f32=b.get(i);
          dot=dot + av * bv;
          maga=maga + av * av;
          magb=magb + bv * bv;
          i=i + 1;
        }el{};
        let denom:f32=maga * magb;
        if(denom > 0.0){
          <dot / denom
        }{
          <0.0
        }
      }el{
        <0.0
      }
    }
  }
};


f=insert(store:$vectorstore;id:str;namespace:str;vector:@f32;metadata:str):$vectorstore{
  if(vector.len() = store.dims){
    let now:i64=0;
    
    let entry=$vectorentry{
      id:id;
      namespace:namespace;
      vector:vector;
      metadata:metadata;
      createdat:now
    };
    store.entries.push(entry);
    log.debug("vector store: inserted " + id + " into namespace " + namespace);
    <$vectorstore{
      entries:store.entries;
      dims:store.dims
    }
  }{
    log.warn("vector store: insert rejected — dimension mismatch for id " + id);
    <store
  }
};



f=search(store:$vectorstore;query:@f32;namespace:str;topk:i32):@$searchresult{
  let results:@$searchresult=@();
  store.entries.each(e{
    let nsmatch=namespace = "";
    if(nsmatch){}{
      if(e.namespace = namespace){
        nsmatch=true
      }{}
    };
    if(nsmatch){
      let score=cosinesim(query; e.vector);
      results.push($searchresult{ entry:e; score:score })
    }{}
  });
  
  let sorted:@$searchresult=@();
  results.each(r{
    let inserted=false;
    let out:@$searchresult=@();
    sorted.each(s{
      if(inserted){
        out.push(s)
      }{
        if(r.score > s.score){
          out.push(r);
          out.push(s);
          inserted=true
        }{
          out.push(s)
        }
      }
    });
    if(inserted){}{
      out.push(r)
    };
    sorted=out
  });
  
  let top:@$searchresult=@();
  let taken:i32=0;
  sorted.each(r{
    if(taken < topk){
      top.push(r);
      taken=taken + 1
    }{}
  });
  log.debug("vector store: search found " + str.fromi32(top.len()) + " results");
  <top
};


f=delete(store:$vectorstore;id:str):$vectorstore{
  let remaining:@$vectorentry=@();
  store.entries.each(e{
    if(e.id = id){}{
      remaining.push(e)
    }
  });
  <$vectorstore{
    entries:remaining;
    dims:store.dims
  }
};


f=deletenamespace(store:$vectorstore;namespace:str):$vectorstore{
  let remaining:@$vectorentry=@();
  store.entries.each(e{
    if(e.namespace = namespace){}{
      remaining.push(e)
    }
  });
  <$vectorstore{
    entries:remaining;
    dims:store.dims
  }
};

f=count(store:$vectorstore):i32{
  <store.entries.len()
};

f=tojsonentry(e:$vectorentry):str{
  <"{" +
    "\"id\":\"" + e.id + "\"" +
    ",\"namespace\":\"" + e.namespace + "\"" +
    ",\"metadata\":" + str.jsonencode(e.metadata) +
    ",\"created_at\":" + str.fromi64(e.createdat) +
  "}"
};

m=loke.core.storage.vector;
i=log:std.log;
i=str:std.str;

t=$vectorentry{
  id:str;
  namespace:str;
  vector:@f32;
  metadata:str;
  createdat:i64
};

t=$vectorstore{
  entries:@$vectorentry;
  dims:i32
};

t=$searchresult{
  entry:$vectorentry;
  score:f32
};

f=newstore(dims:i32):$vectorstore{
  <$vectorstore{entries:@();dims:dims}
};

f=cosinesim(a:@f32;b:@f32):f32{
  if((a.len as i32) = (0 as i32)){ <(0.0 as f32) }el{};
  if((b.len as i32) = (0 as i32)){ <(0.0 as f32) }el{};
  if(!((a.len as i32) = (b.len as i32))){ <(0.0 as f32) }el{};
  let dot=mut.(0.0 as f32);
  let maga=mut.(0.0 as f32);
  let magb=mut.(0.0 as f32);
  lp(let i=0;i<(a.len as i32);i=i+1){
    let av=a.get(i);
    let bv=b.get(i);
    dot=dot + av * bv;
    maga=maga + av * av;
    magb=magb + bv * bv
  };
  let denom=maga * magb;
  if(denom > (0.0 as f32)){
    <dot / denom
  }el{};
  <(0.0 as f32)
};

f=insert(store:$vectorstore;id:str;namespace:str;vector:@f32;metadata:str):$vectorstore{
  if((vector.len as i32) = store.dims){
    let now=0;
    let entry=$vectorentry{
      id:id;
      namespace:namespace;
      vector:vector;
      metadata:metadata;
      createdat:now
    };
    let updated=store.entries.push(entry);
    log.debug(str.concat("vector store: inserted ";str.concat(id;str.concat(" into namespace ";namespace))));
    <$vectorstore{entries:updated;dims:store.dims}
  }el{};
  log.warn(str.concat("vector store: insert rejected — dimension mismatch for id ";id));
  <store
};

f=search(store:$vectorstore;query:@f32;namespace:str;topk:i32):@$searchresult{
  let results=mut.@();
  lp(let ii=0;ii<store.entries.len;ii=ii+1){
    let e=store.entries.get(ii);
    let nsmatch=mut.false;
    if(str.eq(namespace;"")){ nsmatch=true
    }el{
      if(str.eq(e.namespace;namespace)){ nsmatch=true }el{}
    };
    if(nsmatch){
      let score=cosinesim(query;e.vector);
      results=results.push($searchresult{entry:e;score:score})
    }el{}
  };
  let sorted=mut.@();
  lp(let ri=0;ri<results.len;ri=ri+1){
    let r=results.get(ri);
    let inserted=mut.false;
    let out=mut.@();
    lp(let si=0;si<sorted.len;si=si+1){
      let s=sorted.get(si);
      if(!inserted && r.score > s.score){
        out=out.push(r);
        out=out.push(s);
        inserted=true
      }el{
        out=out.push(s)
      }
    };
    if(!inserted){ out=out.push(r) }el{};
    sorted=out
  };
  let top=mut.@();
  let taken=mut.(0 as i32);
  lp(let ti=0;ti<sorted.len;ti=ti+1){
    let r=sorted.get(ti);
    if(taken < topk){
      top=top.push(r);
      taken=taken + (1 as i32)
    }el{}
  };
  log.debug(str.concat("vector store: search found ";str.concat(str.fromi32(top.len);" results")));
  <top
};

f=delete(store:$vectorstore;id:str):$vectorstore{
  let remaining=mut.@();
  lp(let ii=0;ii<store.entries.len;ii=ii+1){
    let e=store.entries.get(ii);
    if(!(str.eq(e.id;id))){ remaining=remaining.push(e) }el{}
  };
  <$vectorstore{entries:remaining;dims:store.dims}
};

f=deletenamespace(store:$vectorstore;namespace:str):$vectorstore{
  let remaining=mut.@();
  lp(let ii=0;ii<store.entries.len;ii=ii+1){
    let e=store.entries.get(ii);
    if(!(str.eq(e.namespace;namespace))){ remaining=remaining.push(e) }el{}
  };
  <$vectorstore{entries:remaining;dims:store.dims}
};

f=count(store:$vectorstore):i32{
  <(store.entries.len as i32)
};

f=tojsonentry(e:$vectorentry):str{
  let j=mut.str.concat("{\"id\":\"";str.concat(e.id;"\""));
  j=str.concat(j;str.concat(",\"namespace\":\"";str.concat(e.namespace;"\"")));
  j=str.concat(j;str.concat(",\"metadata\":";str.jsonencode(e.metadata)));
  j=str.concat(j;str.concat(",\"created_at\":";str.fromi64(e.createdat)));
  <str.concat(j;"}")
};

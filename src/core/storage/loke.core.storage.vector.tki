{
  "schema_version": "1.0",
  "module": "loke.core.storage.vector",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "vectorentry", "fields": [{"name": "id", "type": "str"}, {"name": "namespace", "type": "str"}, {"name": "vector", "type": "@"}, {"name": "metadata", "type": "str"}, {"name": "createdat", "type": "i64"}]},
    {"kind": "type", "name": "vectorstore", "fields": [{"name": "entries", "type": "@"}, {"name": "dims", "type": "i32"}]},
    {"kind": "type", "name": "searchresult", "fields": [{"name": "entry", "type": "vectorentry"}, {"name": "score", "type": "f32"}]},
    {"kind": "func", "name": "newstore", "params": ["i32"], "return": "vectorstore"},
    {"kind": "func", "name": "cosinesim", "params": ["@", "@"], "return": "f32"},
    {"kind": "func", "name": "insert", "params": ["vectorstore", "str", "str", "@", "str"], "return": "vectorstore"},
    {"kind": "func", "name": "search", "params": ["vectorstore", "@", "str", "i32"], "return": "@"},
    {"kind": "func", "name": "delete", "params": ["vectorstore", "str"], "return": "vectorstore"},
    {"kind": "func", "name": "deletenamespace", "params": ["vectorstore", "str"], "return": "vectorstore"},
    {"kind": "func", "name": "count", "params": ["vectorstore"], "return": "i32"},
    {"kind": "func", "name": "tojsonentry", "params": ["vectorentry"], "return": "str"}
  ]
}

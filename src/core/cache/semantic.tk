



m=loke.core.cache.semantic;
i=log:std.log;
i=str:std.string;

t=$cacheentry{
  keyhash:str;
  prompthash:str;
  response:str;
  embedding:@f32;
  hitcount:i32;
  createdat:i64;
  expiresat:i64;
  similaritythreshold:f32
};

t=$cacheconfig{
  threshold:f32;
  ttlseconds:i64;
  maxentries:i32
};

t=$cachestore{
  entries:@$cacheentry;
  config:$cacheconfig;
  hits:i32;
  misses:i32
};

f=defaultconfig():$cacheconfig{
  <$cacheconfig{
    threshold:0.92;
    ttlseconds:86400;
    maxentries:10000
  }
};

f=newstore(cfg:$cacheconfig):$cachestore{
  <$cachestore{
    entries:@();
    config:cfg;
    hits:0;
    misses:0
  }
};



f=makekey(prompt:str):str{
  
  log.debug("semantic cache: make_key using length stub (sha256 binding unavailable)");
  <str.fromi32(str.len(prompt))
};



f=cosinesim(a:@f32;b:@f32):f32{
  if(a.len() = 0){
    <0.0
  }{
    if(b.len() = 0){
      <0.0
    }{
      if(a.len() = b.len()){
        let dot:f32=0.0;
        let maga:f32=0.0;
        let magb:f32=0.0;
        let i:i32=0;
        if(i < a.len()){
          let av:f32=a.get(i);
          let bv:f32=b.get(i);
          dot=dot + av * bv;
          maga=maga + av * av;
          magb=magb + bv * bv;
          i=i + 1;
        }{};
        let denom:f32=maga * magb;
        if(denom > 0.0){
          <dot / denom
        }{
          <0.0
        }
      }{
        <0.0
      }
    }
  }
};



f=lookup(store:$cachestore;embedding:@f32):($cacheentry){
  let now:i64=0;
  
  let result:($cacheentry)=<none;
  store.entries.each(e{
    if(e.expiresat > now){
      let sim:f32=cosinesim(embedding; e.embedding);
      if(sim > store.config.threshold){
        result=<some(e)
      }{}
    }{}
  });
  <result
};



f=storeentry(store:$cachestore;prompt:str;response:str;embedding:@f32):$cachestore{
  let now:i64=0;
  
  let entries=store.entries;
  if(entries.len() > store.config.maxentries){
    
    let trimmed:@$cacheentry=@();
    let skip=true;
    entries.each(e{
      if(skip){
        skip=false
      }{
        trimmed.push(e)
      }
    });
    entries=trimmed
  }{};
  let key=makekey(prompt);
  let entry=$cacheentry{
    keyhash:key;
    prompthash:key;
    response:response;
    embedding:embedding;
    hitcount:0;
    createdat:now;
    expiresat:now + store.config.ttlseconds;
    similaritythreshold:store.config.threshold
  };
  entries.push(entry);
  <$cachestore{
    entries:entries;
    config:store.config;
    hits:store.hits;
    misses:store.misses
  }
};


f=evictexpired(store:$cachestore):$cachestore{
  let now:i64=0;
  
  let live:@$cacheentry=@();
  store.entries.each(e{
    if(e.expiresat > now){
      live.push(e)
    }{}
  });
  <$cachestore{
    entries:live;
    config:store.config;
    hits:store.hits;
    misses:store.misses
  }
};


f=stats(store:$cachestore):str{
  let total=store.hits + store.misses;
  let hitrate:f32=0.0;
  if(total > 0){
    hitrate=store.hits / total
  }{};
  <"{" +
    "\"hits\":" + str.fromi32(store.hits) +
    ",\"misses\":" + str.fromi32(store.misses) +
    ",\"entries\":" + str.fromi32(store.entries.len()) +
    ",\"hit_rate\":" + str.fromf32(hitrate) +
  "}"
};

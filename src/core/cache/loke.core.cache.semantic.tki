{
  "schema_version": "1.0",
  "module": "loke.core.cache.semantic",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "cacheentry", "fields": [{"name": "keyhash", "type": "str"}, {"name": "prompthash", "type": "str"}, {"name": "response", "type": "str"}, {"name": "embedding", "type": "@"}, {"name": "hitcount", "type": "i32"}, {"name": "createdat", "type": "i64"}, {"name": "expiresat", "type": "i64"}, {"name": "similaritythreshold", "type": "f32"}]},
    {"kind": "type", "name": "cacheconfig", "fields": [{"name": "threshold", "type": "f32"}, {"name": "ttlseconds", "type": "i64"}, {"name": "maxentries", "type": "i32"}]},
    {"kind": "type", "name": "cachestore", "fields": [{"name": "entries", "type": "@"}, {"name": "config", "type": "cacheconfig"}, {"name": "hits", "type": "i32"}, {"name": "misses", "type": "i32"}]},
    {"kind": "func", "name": "defaultconfig", "params": [], "return": "cacheconfig"},
    {"kind": "func", "name": "newstore", "params": ["cacheconfig"], "return": "cachestore"},
    {"kind": "func", "name": "makekey", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "cosinesim", "params": ["@", "@"], "return": "f32"},
    {"kind": "func", "name": "lookup", "params": ["cachestore", "@"], "return": "i64"},
    {"kind": "func", "name": "storeentry", "params": ["cachestore", "str", "str", "@"], "return": "cachestore"},
    {"kind": "func", "name": "evictexpired", "params": ["cachestore"], "return": "cachestore"},
    {"kind": "func", "name": "stats", "params": ["cachestore"], "return": "str"}
  ]
}

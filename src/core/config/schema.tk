


m=loke.core.config.schema;
i=log:std.log;

t=$lokeconfig{
  port:i32;
  datadir:str;
  loglevel:str;
  ollamaurl:str;
  presidiourl:str;
  llmlinguaurl:str;
  defaultprovider:str;
  privacymode:str;
  maxtokensperday:i32
};

t=$configsource{
  $defaults;
  $file;
  $env;
  $override
};

f=defaults():$lokeconfig{
  <$lokeconfig{
    port:11430;
    datadir:"~/.loke";
    loglevel:"info";
    ollamaurl:"http://127.0.0.1:11434";
    presidiourl:"http://127.0.0.1:5000";
    llmlinguaurl:"http://127.0.0.1:5001";
    defaultprovider:"ollama";
    privacymode:"standard";
    maxtokensperday:100000
  };
};



f=validate(cfg:$lokeconfig):bool{
  if(cfg.port > 0{
    if(cfg.datadir == ""{
      log.warn("config validation failed: data_dir must not be empty");
      <false
    }{
      let validlevels=@("debug";"info";"warn";"error");
      let levelok=false;
      validlevels.each(l{
        if(l == cfg.loglevel{
          levelok=true
        }{};
      });
      if(levelok{
        <true
      }{
        log.warn("config validation failed: log_level must be debug, info, warn, or error");
        <false
      };
    };
  }{
    log.warn("config validation failed: port must be greater than 0");
    <false
  };
};

f=tojson(cfg:$lokeconfig):str{
  <"{" +
    "\"port\":" + cfg.port +
    ",\"data_dir\":\"" + cfg.datadir + "\"" +
    ",\"log_level\":\"" + cfg.loglevel + "\"" +
    ",\"ollama_url\":\"" + cfg.ollamaurl + "\"" +
    ",\"presidio_url\":\"" + cfg.presidiourl + "\"" +
    ",\"llmlingua_url\":\"" + cfg.llmlinguaurl + "\"" +
    ",\"default_provider\":\"" + cfg.defaultprovider + "\"" +
    ",\"privacy_mode\":\"" + cfg.privacymode + "\"" +
    ",\"max_tokens_per_day\":" + cfg.maxtokensperday +
  "}"
};

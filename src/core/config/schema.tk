m=loke.core.config.schema;
i=log:std.log;

t=$lokeconfig{
  port:i32;
  datadir:str;
  loglevel:str;
  ollamaurl:str;
  presidiourl:str;
  llmlinguaurl:str;
  defaultprovider:str;
  privacymode:str;
  maxtokensperday:i32
};

t=$configsource{
  $defaults:i64;
  $file:i64;
  $env:i64;
  $override:i64};

f=defaults():$lokeconfig{
  <$lokeconfig{
    port:11430;
    datadir:"~/.loke";
    loglevel:"info";
    ollamaurl:"http://127.0.0.1:11434";
    presidiourl:"http://127.0.0.1:5000";
    llmlinguaurl:"http://127.0.0.1:5001";
    defaultprovider:"ollama";
    privacymode:"standard";
    maxtokensperday:100000
  }
};



f=validate(cfg:$lokeconfig):bool{
  if(cfg.port > (0 as i32)){
    if(cfg.datadir = ""){
      log.warn("config validation failed: data_dir must not be empty");
      <false
    }el{
      let validlevels=@("debug";"info";"warn";"error");
      let levelok=mut.false;
      lp(let ii=0;ii<validlevels.len;ii=ii+1){ let l=validlevels.get(ii);
        if(l = cfg.loglevel){
          levelok=true
        }el{}
      };
      if(levelok){
        <true
      }el{
        log.warn("config validation failed: log_level must be debug, info, warn, or error");
        <false
      }
    }
  }el{
    log.warn("config validation failed: port must be greater than 0");
    <false
  }
};

f=tojson(cfg:$lokeconfig):str{
  let j=mut.str.concat("{\"port\":";str.fromint(cfg.port));
  j=str.concat(j;str.concat(",\"data_dir\":\"";str.concat(cfg.datadir;"\"")));
  j=str.concat(j;str.concat(",\"log_level\":\"";str.concat(cfg.loglevel;"\"")));
  j=str.concat(j;str.concat(",\"ollama_url\":\"";str.concat(cfg.ollamaurl;"\"")));
  j=str.concat(j;str.concat(",\"presidio_url\":\"";str.concat(cfg.presidiourl;"\"")));
  j=str.concat(j;str.concat(",\"llmlingua_url\":\"";str.concat(cfg.llmlinguaurl;"\"")));
  j=str.concat(j;str.concat(",\"default_provider\":\"";str.concat(cfg.defaultprovider;"\"")));
  j=str.concat(j;str.concat(",\"privacy_mode\":\"";str.concat(cfg.privacymode;"\"")));
  j=str.concat(j;str.concat(",\"max_tokens_per_day\":";str.fromint(cfg.maxtokensperday)));
  <str.concat(j;"}")
};

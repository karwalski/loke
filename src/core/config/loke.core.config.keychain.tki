{
  "schema_version": "1.0",
  "module": "loke.core.config.keychain",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "keychainentry", "fields": [{"name": "service", "type": "str"}, {"name": "account", "type": "str"}, {"name": "value", "type": "str"}]},
    {"kind": "type", "name": "keychainresult", "is_sum": true, "fields": [{"name": "$ok", "type": "i64"}, {"name": "$notfound", "type": "i64"}, {"name": "$error", "type": "i64"}]},
    {"kind": "type", "name": "keychainstate", "fields": [{"name": "entries", "type": "@"}]},
    {"kind": "func", "name": "emptystate", "params": [], "return": "keychainstate"},
    {"kind": "func", "name": "store", "params": ["keychainstate", "str", "str", "str"], "return": "keychainstate"},
    {"kind": "func", "name": "retrieve", "params": ["keychainstate", "str", "str"], "return": "str"},
    {"kind": "func", "name": "delete", "params": ["keychainstate", "str", "str"], "return": "keychainstate"},
    {"kind": "func", "name": "apikeyservice", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "storeapikey", "params": ["keychainstate", "str", "str"], "return": "keychainstate"},
    {"kind": "func", "name": "getapikey", "params": ["keychainstate", "str"], "return": "str"}
  ]
}

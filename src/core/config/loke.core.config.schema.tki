{
  "schema_version": "1.0",
  "module": "loke.core.config.schema",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "lokeconfig", "fields": [{"name": "port", "type": "i32"}, {"name": "datadir", "type": "str"}, {"name": "loglevel", "type": "str"}, {"name": "ollamaurl", "type": "str"}, {"name": "presidiourl", "type": "str"}, {"name": "llmlinguaurl", "type": "str"}, {"name": "defaultprovider", "type": "str"}, {"name": "privacymode", "type": "str"}, {"name": "maxtokensperday", "type": "i32"}]},
    {"kind": "type", "name": "configsource", "is_sum": true, "fields": [{"name": "$defaults", "type": "i64"}, {"name": "$file", "type": "i64"}, {"name": "$env", "type": "i64"}, {"name": "$override", "type": "i64"}]},
    {"kind": "func", "name": "defaults", "params": [], "return": "lokeconfig"},
    {"kind": "func", "name": "validate", "params": ["lokeconfig"], "return": "bool"},
    {"kind": "func", "name": "tojson", "params": ["lokeconfig"], "return": "str"}
  ]
}





m=loke.core.config.keychain;
i=log:std.log;

t=$keychainentry{
  service:str;
  account:str;
  value:str
};

t=$keychainresult{
  $ok:i64;
  $notfound:i64;
  $error:i64};


let gkeychain:@$keychainentry=@();



f=store(service:str;account:str;value:str):i64{
  
  let stored=false;
  
  if(stored){
    
  }{
    log.warn("keychain binding unavailable — storing " + service + "/" + account + " in memory");
    let updated:@$keychainentry=@();
    let replaced=false;
    gkeychain.each(e{
      if(e.service = service){
        if(e.account = account){
          updated.push($keychainentry{ service:service; account:account; value:value });
          replaced=true
        }{
          updated.push(e)
        }
      }{
        updated.push(e)
      }
    });
    if(replaced){}{
      updated.push($keychainentry{ service:service; account:account; value:value })
    };
    gkeychain=updated
  }
};



f=retrieve(service:str;account:str):(str){
  
  
  let result:(str)=<none;
  gkeychain.each(e{
    if(e.service = service){
      if(e.account = account){
        result=<some(e.value)
      }{}
    }{}
  });
  <result
};


f=delete(service:str;account:str):i64{
  
  let remaining:@$keychainentry=@();
  gkeychain.each(e{
    if(e.service = service){
      if(e.account = account){
        
      }{
        remaining.push(e)
      }
    }{
      remaining.push(e)
    }
  });
  gkeychain=remaining
};



f=apikeyservice(provider:str):str{
  <"dev.tokelang.loke." + provider
};

f=storeapikey(provider:str;key:str):i64{
  store(apikeyservice(provider);"api_key";key)
};

f=getapikey(provider:str):(str){
  <retrieve(apikeyservice(provider);"api_key")
};

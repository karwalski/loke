m=loke.core.config.keychain;
i=log:std.log;

t=$keychainentry{
  service:str;
  account:str;
  value:str
};

t=$keychainresult{
  $ok:i64;
  $notfound:i64;
  $error:i64};

t=$keychainstate{
  entries:@$keychainentry
};

f=emptystate():$keychainstate{
  <$keychainstate{ entries:@() }
};



f=store(state:$keychainstate;service:str;account:str;value:str):$keychainstate{
  log.warn("keychain binding unavailable — storing " + service + "/" + account + " in memory");
  let updated:@$keychainentry=@();
  let replaced=false;
  state.entries.each(e{
    if(e.service = service){
      if(e.account = account){
        updated.push($keychainentry{ service:service; account:account; value:value });
        replaced=true
      }{
        updated.push(e)
      }
    }{
      updated.push(e)
    }
  });
  if(replaced){}{
    updated.push($keychainentry{ service:service; account:account; value:value })
  };
  <$keychainstate{ entries:updated }
};



f=retrieve(state:$keychainstate;service:str;account:str):(str){
  let result:(str)=<none;
  state.entries.each(e{
    if(e.service = service){
      if(e.account = account){
        result=<some(e.value)
      }{}
    }{}
  });
  <result
};


f=delete(state:$keychainstate;service:str;account:str):$keychainstate{
  let remaining:@$keychainentry=@();
  state.entries.each(e{
    if(e.service = service){
      if(e.account = account){
      }{
        remaining.push(e)
      }
    }{
      remaining.push(e)
    }
  });
  <$keychainstate{ entries:remaining }
};



f=apikeyservice(provider:str):str{
  <"dev.tokelang.loke." + provider
};

f=storeapikey(state:$keychainstate;provider:str;key:str):$keychainstate{
  <store(state;apikeyservice(provider);"api_key";key)
};

f=getapikey(state:$keychainstate;provider:str):(str){
  <retrieve(state;apikeyservice(provider);"api_key")
};

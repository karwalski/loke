{
  "schema_version": "1.0",
  "module": "loke.core.hardware.profile",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "disktype", "is_sum": true, "fields": [{"name": "$nvme", "type": "i64"}, {"name": "$ssd", "type": "i64"}, {"name": "$hdd", "type": "i64"}, {"name": "$unknown", "type": "i64"}]},
    {"kind": "type", "name": "hardwareprofile", "fields": [{"name": "ramgb", "type": "i32"}, {"name": "vramgb", "type": "i32"}, {"name": "unifiedmemorygb", "type": "i32"}, {"name": "cpucores", "type": "i32"}, {"name": "gpuname", "type": "str"}, {"name": "disktype", "type": "str"}, {"name": "diskspeedmbs", "type": "i32"}, {"name": "platform", "type": "str"}]},
    {"kind": "func", "name": "detect", "params": [], "return": "hardwareprofile"},
    {"kind": "func", "name": "totalmemorygb", "params": ["hardwareprofile"], "return": "i32"},
    {"kind": "func", "name": "tojson", "params": ["hardwareprofile"], "return": "str"},
    {"kind": "func", "name": "summary", "params": ["hardwareprofile"], "return": "str"}
  ]
}

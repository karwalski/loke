



m=loke.core.hardware.recommender;
i=str:std.string;
i=log:std.log;
i=hw:loke.core.hardware.profile;


t=$tierbadge{
  $interactive;
  $considered;
  $background;
  $notrecommended
};


t=$modelrecommendation{
  modelid:str;
  name:str;
  paramsb:f32;
  quant:str;
  tier:str;
  badge:str;
  reasoning:str;
  diskspacegb:i32;
  ok:bool
};




f=tierformodel(paramsb:f32;quant:str;p:hw.$hardwareprofile):str{
  total:i32=hw.totalmemorygb(p);
  totalf:f32=str.tofloat(str.fromi32(total));
  estimatedvramgb:f32=0.0;
  if(quant == "fp16"{
    estimatedvramgb=paramsb * 1.0
  }{
    estimatedvramgb=paramsb * 0.6
  };
  ceilinginteractive:f32=totalf * 0.8;
  ceilingconsidered:f32=totalf * 1.5;
  if(estimatedvramgb <= ceilinginteractive{
    <"interactive"
  }{
    if(estimatedvramgb <= ceilingconsidered{
      <"considered"
    }{
      if(p.disktype == "nvme"{
        <"background"
      }{
        <"not_recommended"
      };
    };
  };
};


f=recommend(p:hw.$hardwareprofile):@$modelrecommendation{
  result:@$modelrecommendation=@();
  total:i32=hw.totalmemorygb(p);

  
  tier0:str=tierformodel(0.5;p.disktype;p);
  r0:$modelrecommendation=$modelrecommendation{
    modelid:"qwen2.5:0.5b";
    name:"Qwen 2.5 0.5B";
    paramsb:0.5;
    quant:"q4";
    tier:tier0;
    badge:tier0;
    reasoning:"0.5B Q4 fits easily in any device memory; ideal for fast completions and low-latency tasks";
    diskspacegb:1;
    ok:true
  };
  result.push(r0);

  
  tier1:str="";
  reasoning1:str="";
  if(total >= 8{
    tier1="interactive";
    reasoning1="3B Q4 (~1.8 GB) fits comfortably in " + str.fromi32(total) + " GB; good everyday model"
  }{
    tier1="considered";
    reasoning1="3B Q4 (~1.8 GB) is tight on " + str.fromi32(total) + " GB; may compete with OS memory"
  };
  r1:$modelrecommendation=$modelrecommendation{
    modelid:"llama3.2:3b";
    name:"Llama 3.2 3B";
    paramsb:3.0;
    quant:"q4";
    tier:tier1;
    badge:tier1;
    reasoning:reasoning1;
    diskspacegb:2;
    ok:true
  };
  result.push(r1);

  
  tier2:str="";
  reasoning2:str="";
  if(total >= 16{
    tier2="interactive";
    reasoning2="8B Q4 (~4.8 GB) fits well in " + str.fromi32(total) + " GB; strong general-purpose model"
  }{
    if(total >= 8{
      tier2="considered";
      reasoning2="8B Q4 (~4.8 GB) is feasible on " + str.fromi32(total) + " GB but leaves limited headroom"
    }{
      tier2=tierformodel(8.0;"q4";p);
      reasoning2="8B Q4 (~4.8 GB) exceeds available memory (" + str.fromi32(total) + " GB)"
    };
  };
  r2:$modelrecommendation=$modelrecommendation{
    modelid:"llama3.1:8b";
    name:"Llama 3.1 8B";
    paramsb:8.0;
    quant:"q4";
    tier:tier2;
    badge:tier2;
    reasoning:reasoning2;
    diskspacegb:5;
    ok:true
  };
  result.push(r2);

  
  tier3:str="";
  reasoning3:str="";
  if(total >= 16{
    tier3="interactive";
    reasoning3="7B Q4 (~4.2 GB) runs well in " + str.fromi32(total) + " GB; efficient instruction-following model"
  }{
    if(total >= 8{
      tier3="considered";
      reasoning3="7B Q4 (~4.2 GB) is usable on " + str.fromi32(total) + " GB with moderate overhead"
    }{
      tier3=tierformodel(7.0;"q4";p);
      reasoning3="7B Q4 (~4.2 GB) exceeds available memory (" + str.fromi32(total) + " GB)"
    };
  };
  r3:$modelrecommendation=$modelrecommendation{
    modelid:"mistral:7b";
    name:"Mistral 7B";
    paramsb:7.0;
    quant:"q4";
    tier:tier3;
    badge:tier3;
    reasoning:reasoning3;
    diskspacegb:4;
    ok:true
  };
  result.push(r3);

  
  tier4:str="";
  reasoning4:str="";
  if(total >= 16{
    tier4="considered";
    reasoning4="14B Q4 (~8.4 GB) is feasible on " + str.fromi32(total) + " GB; expect some swapping under load"
  }{
    if(p.disktype == "nvme"{
      tier4="background";
      reasoning4="14B Q4 (~8.4 GB) exceeds " + str.fromi32(total) + " GB RAM; disk-streaming via NVMe required"
    }{
      tier4="not_recommended";
      reasoning4="14B Q4 (~8.4 GB) exceeds " + str.fromi32(total) + " GB RAM and no NVMe available for streaming"
    };
  };
  r4:$modelrecommendation=$modelrecommendation{
    modelid:"qwen2.5:14b";
    name:"Qwen 2.5 14B";
    paramsb:14.0;
    quant:"q4";
    tier:tier4;
    badge:tier4;
    reasoning:reasoning4;
    diskspacegb:9;
    ok:true
  };
  result.push(r4);

  
  tier5:str="";
  reasoning5:str="";
  if(total >= 32{
    if(p.disktype == "nvme"{
      tier5="background";
      reasoning5="70B Q4 (~42 GB) requires disk-streaming on " + str.fromi32(total) + " GB; NVMe present — slow but viable"
    }{
      tier5="not_recommended";
      reasoning5="70B Q4 (~42 GB) requires NVMe for disk-streaming; current disk type is too slow"
    };
  }{
    tier5="not_recommended";
    reasoning5="70B Q4 (~42 GB) requires at least 32 GB RAM with NVMe disk-streaming"
  };
  r5:$modelrecommendation=$modelrecommendation{
    modelid:"llama3.1:70b";
    name:"Llama 3.1 70B";
    paramsb:70.0;
    quant:"q4";
    tier:tier5;
    badge:tier5;
    reasoning:reasoning5;
    diskspacegb:42;
    ok:true
  };
  result.push(r5);

  
  tier6:str="";
  reasoning6:str="";
  if(total >= 64{
    if(p.disktype == "nvme"{
      tier6="background";
      reasoning6="72B Q4 (~43 GB) is viable via disk-streaming on " + str.fromi32(total) + " GB NVMe system"
    }{
      tier6="not_recommended";
      reasoning6="72B Q4 (~43 GB) requires NVMe for disk-streaming; current disk type is too slow"
    };
  }{
    tier6="not_recommended";
    reasoning6="72B Q4 (~43 GB) requires at least 64 GB RAM with NVMe disk-streaming"
  };
  r6:$modelrecommendation=$modelrecommendation{
    modelid:"qwen2.5:72b";
    name:"Qwen 2.5 72B";
    paramsb:72.0;
    quant:"q4";
    tier:tier6;
    badge:tier6;
    reasoning:reasoning6;
    diskspacegb:43;
    ok:true
  };
  result.push(r6);

  <result
};


f=diskwarning(p:hw.$hardwareprofile):(str){
  if(p.disktype == "nvme"{
    <none
  }{
    recs:@$modelrecommendation=recommend(p);
    hasbackground:bool=false;
    recs.each(r{
      if(r.tier == "background"{
        hasbackground=true
      }{};
    });
    if(hasbackground{
      <some("Warning: disk streaming requires NVMe — current disk type may be too slow")
    }{
      <none
    };
  };
};


f=tojson(r:$modelrecommendation):str{
  okstr:str="false";
  if(r.ok{
    okstr="true"
  }{};
  <"{" +
    "\"model_id\":\"" + r.modelid + "\"" +
    ",\"name\":\"" + r.name + "\"" +
    ",\"params_b\":" + str.fromf32(r.paramsb) +
    ",\"quant\":\"" + r.quant + "\"" +
    ",\"tier\":\"" + r.tier + "\"" +
    ",\"badge\":\"" + r.badge + "\"" +
    ",\"reasoning\":\"" + r.reasoning + "\"" +
    ",\"disk_space_gb\":" + str.fromi32(r.diskspacegb) +
    ",\"ok\":" + okstr +
  "}"
};


f=listtojson(recs:@$modelrecommendation):str{
  out:str="[";
  idx:i32=0;
  recs.each(r{
    if(idx > 0{
      out=out + ","
    }{};
    out=out + tojson(r);
    idx=idx + 1
  });
  <out + "]"
};

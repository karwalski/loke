m=loke.core.hardware.recommender;
i=str:std.string;
i=log:std.log;
i=hw:loke.core.hardware.profile;


t=$tierbadge{
  $interactive:i64;
  $considered:i64;
  $background:i64;
  $notrecommended:i64};


t=$modelrecommendation{
  modelid:str;
  name:str;
  paramsb:f32;
  quant:str;
  tier:str;
  badge:str;
  reasoning:str;
  diskspacegb:i32;
  ok:bool
};




f=tierformodel(paramsb:f32;quant:str;p:$hardwareprofile):str{
  let total:i32=hw.totalmemorygb(p);
  let totalf:f32=str.tofloat(str.fromi32(total));
  let estimatedvramgb=mut.0.0 as f32;
  if(quant = "fp16"){
    estimatedvramgb=paramsb * 1.0 as f32
  }el{
    estimatedvramgb=paramsb * 0.6 as f32
  };
  let ceilinginteractive=totalf * 0.8 as f32;
  let ceilingconsidered=totalf * 1.5 as f32;
  if(!(estimatedvramgb>ceilinginteractive)){
    <"interactive"
  }el{
    if(!(estimatedvramgb>ceilingconsidered)){
      <"considered"
    }el{
      if(p.disktype = "nvme"){
        <"background"
      }el{
        <"not_recommended"
      }
    }
  }
};


f=recommend(p:$hardwareprofile):@$modelrecommendation{
  let result:@$modelrecommendation=@();
  let total:i32=hw.totalmemorygb(p);

  
  let tier0=tierformodel(0.5 as f32;"q4";p);
  let r0:$modelrecommendation=$modelrecommendation{
    modelid:"qwen2.5:0.5b";
    name:"Qwen 2.5 0.5B";
    paramsb:0.5;
    quant:"q4";
    tier:tier0;
    badge:tier0;
    reasoning:"0.5B Q4 fits easily in any device memory; ideal for fast completions and low-latency tasks";
    diskspacegb:1;
    ok:true
  };
  result.push(r0);

  
  let tier1=mut."";
  let reasoning1=mut."";
  if(total > 8 as i32){
    tier1="interactive";
    reasoning1=str.concat("3B Q4 (~1.8 GB) fits comfortably in ";str.concat(str.fromi32(total);" GB; good everyday model"))
  }el{
    tier1="considered";
    reasoning1=str.concat("3B Q4 (~1.8 GB) is tight on ";str.concat(str.fromi32(total);" GB; may compete with OS memory"))
  };
  let r1:$modelrecommendation=$modelrecommendation{
    modelid:"llama3.2:3b";
    name:"Llama 3.2 3B";
    paramsb:3.0;
    quant:"q4";
    tier:tier1;
    badge:tier1;
    reasoning:reasoning1;
    diskspacegb:2;
    ok:true
  };
  result.push(r1);

  
  let tier2=mut."";
  let reasoning2=mut."";
  if(total > 16 as i32){
    tier2="interactive";
    reasoning2=str.concat("8B Q4 (~4.8 GB) fits well in ";str.concat(str.fromi32(total);" GB; strong general-purpose model"))
  }el{
    if(total > 8 as i32){
      tier2="considered";
      reasoning2=str.concat("8B Q4 (~4.8 GB) is feasible on ";str.concat(str.fromi32(total);" GB but leaves limited headroom"))
    }el{
      tier2=tierformodel(8.0 as f32;"q4";p);
      reasoning2=str.concat("8B Q4 (~4.8 GB) exceeds available memory (";str.concat(str.fromi32(total);" GB)"))
    }
  };
  let r2:$modelrecommendation=$modelrecommendation{
    modelid:"llama3.1:8b";
    name:"Llama 3.1 8B";
    paramsb:8.0;
    quant:"q4";
    tier:tier2;
    badge:tier2;
    reasoning:reasoning2;
    diskspacegb:5;
    ok:true
  };
  result.push(r2);

  
  let tier3=mut."";
  let reasoning3=mut."";
  if(total > 16 as i32){
    tier3="interactive";
    reasoning3=str.concat("7B Q4 (~4.2 GB) runs well in ";str.concat(str.fromi32(total);" GB; efficient instruction-following model"))
  }el{
    if(total > 8 as i32){
      tier3="considered";
      reasoning3=str.concat("7B Q4 (~4.2 GB) is usable on ";str.concat(str.fromi32(total);" GB with moderate overhead"))
    }el{
      tier3=tierformodel(7.0 as f32;"q4";p);
      reasoning3=str.concat("7B Q4 (~4.2 GB) exceeds available memory (";str.concat(str.fromi32(total);" GB)"))
    }
  };
  let r3:$modelrecommendation=$modelrecommendation{
    modelid:"mistral:7b";
    name:"Mistral 7B";
    paramsb:7.0;
    quant:"q4";
    tier:tier3;
    badge:tier3;
    reasoning:reasoning3;
    diskspacegb:4;
    ok:true
  };
  result.push(r3);

  
  let tier4=mut."";
  let reasoning4=mut."";
  if(total > 16 as i32){
    tier4="considered";
    reasoning4=str.concat("14B Q4 (~8.4 GB) is feasible on ";str.concat(str.fromi32(total);" GB; expect some swapping under load"))
  }el{
    if(p.disktype = "nvme"){
      tier4="background";
      reasoning4=str.concat("14B Q4 (~8.4 GB) exceeds ";str.concat(str.fromi32(total);" GB RAM; disk-streaming via NVMe required"))
    }el{
      tier4="not_recommended";
      reasoning4=str.concat("14B Q4 (~8.4 GB) exceeds ";str.concat(str.fromi32(total);" GB RAM and no NVMe available for streaming"))
    }
  };
  let r4:$modelrecommendation=$modelrecommendation{
    modelid:"qwen2.5:14b";
    name:"Qwen 2.5 14B";
    paramsb:14.0;
    quant:"q4";
    tier:tier4;
    badge:tier4;
    reasoning:reasoning4;
    diskspacegb:9;
    ok:true
  };
  result.push(r4);

  
  let tier5=mut."";
  let reasoning5=mut."";
  if(total > 32 as i32){
    if(p.disktype = "nvme"){
      tier5="background";
      reasoning5=str.concat("70B Q4 (~42 GB) requires disk-streaming on ";str.concat(str.fromi32(total);" GB; NVMe present — slow but viable"))
    }el{
      tier5="not_recommended";
      reasoning5="70B Q4 (~42 GB) requires NVMe for disk-streaming; current disk type is too slow"
    }
  }el{
    tier5="not_recommended";
    reasoning5="70B Q4 (~42 GB) requires at least 32 GB RAM with NVMe disk-streaming"
  };
  let r5:$modelrecommendation=$modelrecommendation{
    modelid:"llama3.1:70b";
    name:"Llama 3.1 70B";
    paramsb:70.0;
    quant:"q4";
    tier:tier5;
    badge:tier5;
    reasoning:reasoning5;
    diskspacegb:42;
    ok:true
  };
  result.push(r5);

  
  let tier6=mut."";
  let reasoning6=mut."";
  if(total > 64 as i32){
    if(p.disktype = "nvme"){
      tier6="background";
      reasoning6=str.concat("72B Q4 (~43 GB) is viable via disk-streaming on ";str.concat(str.fromi32(total);" GB NVMe system"))
    }el{
      tier6="not_recommended";
      reasoning6="72B Q4 (~43 GB) requires NVMe for disk-streaming; current disk type is too slow"
    }
  }el{
    tier6="not_recommended";
    reasoning6="72B Q4 (~43 GB) requires at least 64 GB RAM with NVMe disk-streaming"
  };
  let r6:$modelrecommendation=$modelrecommendation{
    modelid:"qwen2.5:72b";
    name:"Qwen 2.5 72B";
    paramsb:72.0;
    quant:"q4";
    tier:tier6;
    badge:tier6;
    reasoning:reasoning6;
    diskspacegb:43;
    ok:true
  };
  result.push(r6);

  <result
};


f=diskwarning(p:$hardwareprofile):str!$none{
  if(p.disktype = "nvme"){
    <$none{}
  }el{
    let recs=recommend(p);
    let hasbackground=mut.false;
    lp(let ii=0;ii<recs.len;ii=ii+1){ let r=recs.get(ii);
      if(r.tier = "background"){
        hasbackground=true
      }el{}
    };
    if(hasbackground){
      <"Warning: disk streaming requires NVMe — current disk type may be too slow"
    }el{
      <$none{}
    }
  }
};


f=tojson(r:$modelrecommendation):str{
  let okstr=mut."false";
  if(r.ok){
    okstr="true"
  }el{};
  <str.concat("{\"model_id\":\"";str.concat(r.modelid;str.concat("\",\"name\":\"";str.concat(r.name;str.concat("\",\"params_b\":";str.concat(str.fromf32(r.paramsb);str.concat(",\"quant\":\"";str.concat(r.quant;str.concat("\",\"tier\":\"";str.concat(r.tier;str.concat("\",\"badge\":\"";str.concat(r.badge;str.concat("\",\"reasoning\":\"";str.concat(r.reasoning;str.concat("\",\"disk_space_gb\":";str.concat(str.fromi32(r.diskspacegb);str.concat(",\"ok\":";str.concat(okstr;"}"))))))))))))))))))
};


f=listtojson(recs:@$modelrecommendation):str{
  let out=mut."[";
  let idx=mut.0 as i32;
  lp(let ii=0;ii<recs.len;ii=ii+1){ let r=recs.get(ii);
    if(idx > 0){
      out=str.concat(out;",")
    }el{};
    out=str.concat(out;tojson(r));
    idx=idx + 1
  };
  <str.concat(out;"]")
};

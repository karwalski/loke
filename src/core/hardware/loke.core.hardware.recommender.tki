{
  "schema_version": "1.0",
  "module": "loke.core.hardware.recommender",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "tierbadge", "is_sum": true, "fields": [{"name": "$interactive", "type": "i64"}, {"name": "$considered", "type": "i64"}, {"name": "$background", "type": "i64"}, {"name": "$notrecommended", "type": "i64"}]},
    {"kind": "type", "name": "modelrecommendation", "fields": [{"name": "modelid", "type": "str"}, {"name": "name", "type": "str"}, {"name": "paramsb", "type": "f32"}, {"name": "quant", "type": "str"}, {"name": "tier", "type": "str"}, {"name": "badge", "type": "str"}, {"name": "reasoning", "type": "str"}, {"name": "diskspacegb", "type": "i32"}, {"name": "ok", "type": "bool"}]},
    {"kind": "func", "name": "tierformodel", "params": ["f32", "str", "hardwareprofile"], "return": "str"},
    {"kind": "func", "name": "recommend", "params": ["hardwareprofile"], "return": "@"},
    {"kind": "func", "name": "diskwarning", "params": ["hardwareprofile"], "return": "str"},
    {"kind": "func", "name": "tojson", "params": ["modelrecommendation"], "return": "str"},
    {"kind": "func", "name": "listtojson", "params": ["@"], "return": "str"}
  ]
}

m=loke.core.hardware.profile;
i=str:std.string;
i=log:std.log;


t=$disktype{
  $nvme:i64;
  $ssd:i64;
  $hdd:i64;
  $unknown:i64};


t=$hardwareprofile{
  ramgb:i32;
  vramgb:i32;
  unifiedmemorygb:i32;
  cpucores:i32;
  gpuname:str;
  disktype:str;
  diskspeedmbs:i32;
  platform:str
};



f=detect():$hardwareprofile{
  log.info("hardware profile detected (stub)");
  <$hardwareprofile{
    ramgb:16;
    vramgb:0;
    unifiedmemorygb:16;
    cpucores:8;
    gpuname:"Apple M-series";
    disktype:"nvme";
    diskspeedmbs:3000;
    platform:"macos"
  }
};


f=totalmemorygb(p:$hardwareprofile):i32{
  if(p.unifiedmemorygb > (0 as i32)){
    <p.unifiedmemorygb
  }el{
    <p.ramgb + p.vramgb
  }
};


f=tojson(p:$hardwareprofile):str{
  let j=mut.str.concat("{\"ram_gb\":";str.fromi32(p.ramgb));
  j=str.concat(j;str.concat(",\"vram_gb\":";str.fromi32(p.vramgb)));
  j=str.concat(j;str.concat(",\"unified_memory_gb\":";str.fromi32(p.unifiedmemorygb)));
  j=str.concat(j;str.concat(",\"cpu_cores\":";str.fromi32(p.cpucores)));
  j=str.concat(j;str.concat(",\"gpu_name\":\"";str.concat(p.gpuname;"\"")));
  j=str.concat(j;str.concat(",\"disk_type\":\"";str.concat(p.disktype;"\"")));
  j=str.concat(j;str.concat(",\"disk_speed_mbs\":";str.fromi32(p.diskspeedmbs)));
  j=str.concat(j;str.concat(",\"platform\":\"";str.concat(p.platform;"\"")));
  <str.concat(j;"}")
};



f=summary(p:$hardwareprofile):str{
  let mempart=mut."";
  if(p.unifiedmemorygb > (0 as i32)){
    mempart=str.fromi32(p.unifiedmemorygb) + " GB unified"
  }el{
    mempart=str.fromi32(p.ramgb + p.vramgb) + " GB RAM"
  };
  let cpupart:str=str.fromi32(p.cpucores) + "-core CPU";
  let diskpart=mut.str.concat(str.fromi32(p.diskspeedmbs);" MB/s");
  if(p.disktype = "nvme"){
    diskpart="NVMe " + diskpart
  }el{
    if(p.disktype = "ssd"){
      diskpart="SSD " + diskpart
    }el{
      diskpart="HDD " + diskpart
    }
  };
  <mempart + " · " + cpupart + " · " + diskpart + " · " + p.platform
};





m=loke.core.hardware.profile;
i=str:std.string;
i=log:std.log;


t=$disktype{
  $nvme:i64;
  $ssd:i64;
  $hdd:i64;
  $unknown
};


t=$hardwareprofile{
  ramgb:i32;
  vramgb:i32;
  unifiedmemorygb:i32;
  cpucores:i32;
  gpuname:str;
  disktype:str;
  diskspeedmbs:i32;
  platform:str
};



f=detect():$hardwareprofile{
  log.info("hardware profile detected (stub)");
  <$hardwareprofile{
    ramgb:16;
    vramgb:0;
    unifiedmemorygb:16;
    cpucores:8;
    gpuname:"Apple M-series";
    disktype:"nvme";
    diskspeedmbs:3000;
    platform:"macos"
  }
};


f=totalmemorygb(p:$hardwareprofile):i32{
  if(p.unifiedmemorygb > 0){
    <p.unifiedmemorygb
  }{
    <p.ramgb + p.vramgb
  }
};


f=tojson(p:$hardwareprofile):str{
  <"{" +
    "\"ram_gb\":" + str.fromi32(p.ramgb) +
    ",\"vram_gb\":" + str.fromi32(p.vramgb) +
    ",\"unified_memory_gb\":" + str.fromi32(p.unifiedmemorygb) +
    ",\"cpu_cores\":" + str.fromi32(p.cpucores) +
    ",\"gpu_name\":\"" + p.gpuname + "\"" +
    ",\"disk_type\":\"" + p.disktype + "\"" +
    ",\"disk_speed_mbs\":" + str.fromi32(p.diskspeedmbs) +
    ",\"platform\":\"" + p.platform + "\"" +
  "}"
};



f=summary(p:$hardwareprofile):str{
  mempart:str="";
  if(p.unifiedmemorygb > 0){
    mempart=str.fromi32(p.unifiedmemorygb) + " GB unified"
  }{
    mempart=str.fromi32(p.ramgb + p.vramgb) + " GB RAM"
  };
  cpupart:str=str.fromi32(p.cpucores) + "-core CPU";
  diskpart:str=str.fromi32(p.diskspeedmbs) + " MB/s";
  if(p.disktype = "nvme"){
    diskpart="NVMe " + diskpart
  }{
    if(p.disktype = "ssd"){
      diskpart="SSD " + diskpart
    }{
      diskpart="HDD " + diskpart
    }
  };
  <mempart + " · " + cpupart + " · " + diskpart + " · " + p.platform
};

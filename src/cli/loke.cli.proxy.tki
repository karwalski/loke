{
  "schema_version": "1.0",
  "module": "loke.cli.proxy",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "proxyconfig", "fields": [{"name": "upstreamname", "type": "str"}, {"name": "upstreamurl", "type": "str"}, {"name": "listenport", "type": "i32"}, {"name": "showindicator", "type": "bool"}, {"name": "interceptstreams", "type": "bool"}]},
    {"kind": "type", "name": "proxystats", "fields": [{"name": "requestsintercepted", "type": "i32"}, {"name": "piidetectedtotal", "type": "i32"}, {"name": "tokenssaved", "type": "i32"}, {"name": "sessions", "type": "i32"}]},
    {"kind": "type", "name": "indicatorstate", "fields": [{"name": "active", "type": "bool"}, {"name": "currentrequestid", "type": "str"}, {"name": "piicount", "type": "i32"}, {"name": "sensitivity", "type": "str"}]},
    {"kind": "func", "name": "defaultconfig", "params": ["str"], "return": "proxyconfig"},
    {"kind": "func", "name": "newstats", "params": [], "return": "proxystats"},
    {"kind": "func", "name": "interceptrequest", "params": ["str", "proxystats"], "return": "proxystats"},
    {"kind": "func", "name": "renderindicator", "params": ["indicatorstate"], "return": "str"},
    {"kind": "func", "name": "startmessage", "params": ["proxyconfig"], "return": "str"},
    {"kind": "func", "name": "statssummary", "params": ["proxystats"], "return": "str"}
  ]
}

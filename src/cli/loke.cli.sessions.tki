{
  "schema_version": "1.0",
  "module": "loke.cli.sessions",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "sessionmode", "is_sum": true, "fields": [{"name": "$shared", "type": "i64"}, {"name": "$isolated", "type": "i64"}]},
    {"kind": "type", "name": "session", "fields": [{"name": "id", "type": "str"}, {"name": "name", "type": "str"}, {"name": "mode", "type": "str"}, {"name": "createdat", "type": "i64"}, {"name": "lastactive", "type": "i64"}, {"name": "contextsummary", "type": "str"}, {"name": "messagecount", "type": "i32"}, {"name": "active", "type": "bool"}]},
    {"kind": "type", "name": "sessionstore", "fields": [{"name": "sessions", "type": "@"}, {"name": "activeid", "type": "str"}]},
    {"kind": "func", "name": "gstore", "params": [], "return": "sessionstore"},
    {"kind": "func", "name": "newstore", "params": [], "return": "sessionstore"},
    {"kind": "func", "name": "create", "params": ["str", "str"], "return": "session"},
    {"kind": "func", "name": "activate", "params": ["sessionstore", "str"], "return": "sessionstore"},
    {"kind": "func", "name": "deactivate", "params": ["sessionstore", "str"], "return": "sessionstore"},
    {"kind": "func", "name": "getactive", "params": ["sessionstore"], "return": "i64"},
    {"kind": "func", "name": "list", "params": ["sessionstore"], "return": "@"},
    {"kind": "func", "name": "find", "params": ["sessionstore", "str"], "return": "i64"},
    {"kind": "func", "name": "updatecontext", "params": ["sessionstore", "str", "str"], "return": "sessionstore"},
    {"kind": "func", "name": "tojson", "params": ["session"], "return": "str"},
    {"kind": "func", "name": "formatlist", "params": ["sessionstore"], "return": "str"}
  ]
}

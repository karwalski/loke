m=loke.cli.proxy;
i=str:std.string;
i=log:std.log;

t=$proxyconfig{
  upstreamname:str;
  upstreamurl:str;
  listenport:i32;
  showindicator:bool;
  interceptstreams:bool
};

t=$proxystats{
  requestsintercepted:i32;
  piidetectedtotal:i32;
  tokenssaved:i32;
  sessions:i32
};

t=$indicatorstate{
  active:bool;
  currentrequestid:str;
  piicount:i32;
  sensitivity:str
};



f=defaultconfig(upstreamname:str):$proxyconfig{
  let upstreamurl=mut."https://api.openai.com";
  if(upstreamname = "claude-code"){
    upstreamurl="https://api.anthropic.com"
  }el{};
  <$proxyconfig{
    upstreamname:upstreamname;
    upstreamurl:upstreamurl;
    listenport:11431;
    showindicator:true;
    interceptstreams:true
  }
};


f=newstats():$proxystats{
  <$proxystats{
    requestsintercepted:0;
    piidetectedtotal:0;
    tokenssaved:0;
    sessions:0
  }
};



f=interceptrequest(bodyjson:str;stats:$proxystats):$proxystats{
  log.info("proxy: intercepting request → loke pipeline");
  <$proxystats{
    requestsintercepted:stats.requestsintercepted + (1 as i32);
    piidetectedtotal:stats.piidetectedtotal;
    tokenssaved:stats.tokenssaved;
    sessions:stats.sessions
  }
};



f=renderindicator(state:$indicatorstate):str{
  let r=mut.str.concat("loke proxy active | PII: ";str.fromi32(state.piicount));
  r=str.concat(r;str.concat(" | Sensitivity: ";state.sensitivity));
  r=str.concat(r;str.concat(" | ID: ";state.currentrequestid));
  <r
};


f=startmessage(cfg:$proxyconfig):str{
  let m=mut.str.concat("loke proxy: intercepting ";cfg.upstreamname);
  m=str.concat(m;str.concat(" on port ";str.fromi32(cfg.listenport)));
  m=str.concat(m;"\nAll requests routed through loke privacy pipeline.");
  m=str.concat(m;"\nCtrl+C to stop.\n");
  <m
};


f=statssummary(stats:$proxystats):str{
  let s=mut."\nloke proxy session summary\n---------------------------\n";
  s=str.concat(s;str.concat("Requests intercepted : ";str.concat(str.fromi32(stats.requestsintercepted);"\n")));
  s=str.concat(s;str.concat("PII instances found  : ";str.concat(str.fromi32(stats.piidetectedtotal);"\n")));
  s=str.concat(s;str.concat("Tokens saved         : ";str.concat(str.fromi32(stats.tokenssaved);"\n")));
  s=str.concat(s;str.concat("Sessions             : ";str.concat(str.fromi32(stats.sessions);"\n")));
  <s
};

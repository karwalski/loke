



m=loke.cli.proxy;
i=str:std.string;
i=log:std.log;

t=$proxyconfig{
  upstreamname:str;
  upstreamurl:str;
  listenport:i32;
  showindicator:bool;
  interceptstreams:bool
};

t=$proxystats{
  requestsintercepted:i32;
  piidetectedtotal:i32;
  tokenssaved:i32;
  sessions:i32
};

t=$indicatorstate{
  active:bool;
  currentrequestid:str;
  piicount:i32;
  sensitivity:str
};



f=defaultconfig(upstreamname:str):$proxyconfig{
  let upstreamurl="https://api.openai.com";
  if(upstreamname == "claude-code"){
    upstreamurl="https://api.anthropic.com"
  }{};
  <$proxyconfig{
    upstreamname:upstreamname;
    upstreamurl:upstreamurl;
    listenport:11431;
    showindicator:true;
    interceptstreams:true
  };
};


f=newstats():$proxystats{
  <$proxystats{
    requestsintercepted:0;
    piidetectedtotal:0;
    tokenssaved:0;
    sessions:0
  };
};



f=interceptrequest(bodyjson:str;stats:$proxystats):$proxystats{
  log.info("proxy: intercepting request → loke pipeline");
  <$proxystats{
    requestsintercepted:stats.requestsintercepted + 1;
    piidetectedtotal:stats.piidetectedtotal;
    tokenssaved:stats.tokenssaved;
    sessions:stats.sessions
  };
};



f=renderindicator(state:$indicatorstate):str{
  <"🔒 loke proxy active | PII: " + str.fromi32(state.piicount) +
    " | Sensitivity: " + state.sensitivity +
    " | ID: " + state.currentrequestid
};


f=startmessage(cfg:$proxyconfig):str{
  <"loke proxy: intercepting " + cfg.upstreamname +
    " on port " + str.fromi32(cfg.listenport) +
    "
All requests routed through loke privacy pipeline." +
    "
Ctrl+C to stop.
"
};


f=statssummary(stats:$proxystats):str{
  <"
loke proxy session summary
" +
    "---------------------------
" +
    "Requests intercepted : " + str.fromi32(stats.requestsintercepted) + "
" +
    "PII instances found  : " + str.fromi32(stats.piidetectedtotal) + "
" +
    "Tokens saved         : " + str.fromi32(stats.tokenssaved) + "
" +
    "Sessions             : " + str.fromi32(stats.sessions) + "
"
};

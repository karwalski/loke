



m=loke.cli.ask;
i=str:std.string;
i=log:std.log;
i=json:std.json;
i=http:std.http;

t=$askopts{
  modelid:str;
  dryrun:bool;
  stream:bool;
  stdininput:bool;
  systemprompt:str;
  tolerance:str
};

t=$askresult{
  response:str;
  modelid:str;
  tokensin:i32;
  tokensout:i32;
  costusd:f32;
  requestid:str;
  sensitivity:str;
  entitiesfound:i32
};


f=defaultopts():$askopts{
  <$askopts{
    modelid:"loke-router";
    dryrun:false;
    stream:true;
    stdininput:false;
    systemprompt:"";
    tolerance:"instant"
  };
};



f=run(prompt:str;opts:$askopts):$askresult{
  if(opts.dryrun{
    log.info("ask: dry-run — privacy pipeline preview");
    log.info("ask: prompt would be anonymised → routed → " + opts.modelid);
    log.info("ask: tolerance=" + opts.tolerance);
    <$askresult{
      response:"[dry-run: prompt would be sent through loke privacy pipeline → " + opts.modelid + "]";
      modelid:opts.modelid;
      tokensin:0;
      tokensout:0;
      costusd:0.0;
      requestid:"dry-run";
      sensitivity:"none";
      entitiesfound:0
    };
  }{
    let body="{" +
      "\"text\":" + json.quote(prompt) +
      ",\"system_prompt\":" + json.quote(opts.systemprompt) +
      ",\"tolerance\":" + json.quote(opts.tolerance) +
      ",\"mode\":\"cli\"" +
    "}";
    let res=http.post("http://127.0.0.1:11430/api/pipeline";body;"application/json");
    let response=json.getstr(res.body;"response");
    let modelid=json.getstr(res.body;"model_id");
    let tokensin=json.geti32(res.body;"tokens_in");
    let tokensout=json.geti32(res.body;"tokens_out");
    let costusd=json.getf32(res.body;"cost_usd");
    let requestid=json.getstr(res.body;"request_id");
    let sensitivity=json.getstr(res.body;"sensitivity");
    let entitiesfound=json.geti32(res.body;"entities_found");
    <$askresult{
      response:response;
      modelid:modelid;
      tokensin:tokensin;
      tokensout:tokensout;
      costusd:costusd;
      requestid:requestid;
      sensitivity:sensitivity;
      entitiesfound:entitiesfound
    };
  };
};



f=formatoutput(r:$askresult;verbose:bool):str{
  if(verbose{
    <r.response +
      "

---
" +
      "Model: " + r.modelid +
      " | Tokens: " + str.fromi32(r.tokensin) + "in/" + str.fromi32(r.tokensout) + "out" +
      " | Cost: $" + str.fromf32(r.costusd) +
      " | Sensitivity: " + r.sensitivity
  }{
    <r.response
  };
};


f=helptext():str{
  <"loke ask — send a prompt through the loke privacy pipeline

" +
    "Usage:
" +
    "  loke ask [options] <prompt>
" +
    "  echo <prompt> | loke ask --stdin

" +
    "Options:
" +
    "  --model <id>         Model or router to use (default: loke-router)
" +
    "  --dry-run            Preview privacy pipeline without sending
" +
    "  --no-stream          Disable streaming output
" +
    "  --stdin              Read prompt from stdin
" +
    "  --system <prompt>    Set a system prompt
" +
    "  --tolerance <level>  Privacy tolerance: instant|balanced|thorough (default: instant)
" +
    "  --verbose            Show model, token, cost, and sensitivity metadata
" +
    "  --help               Show this help

" +
    "Examples:
" +
    "  loke ask \"Summarise this document\"
" +
    "  loke ask --model claude-3-5-sonnet --verbose \"Explain recursion\"
" +
    "  loke ask --dry-run \"What is my API key?\"
" +
    "  cat notes.txt | loke ask --stdin \"Summarise this\"
"
};

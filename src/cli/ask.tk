



m=loke.cli.ask;
i=str:std.string;
i=log:std.log;
i=json:std.json;
i=http:std.http;

t=$askopts{
  modelid:str;
  dryrun:bool;
  stream:bool;
  stdininput:bool;
  systemprompt:str;
  tolerance:str
};

t=$askresult{
  response:str;
  modelid:str;
  tokensin:i32;
  tokensout:i32;
  costusd:f32;
  requestid:str;
  sensitivity:str;
  entitiesfound:i32
};


f=defaultopts():$askopts{
  <$askopts{
    modelid:"loke-router";
    dryrun:false;
    stream:true;
    stdininput:false;
    systemprompt:"";
    tolerance:"instant"
  }
};



f=run(prompt:str;opts:$askopts):$askresult{
  if(opts.dryrun){
    log.info("ask: dry-run — privacy pipeline preview");
    log.info(str.concat("ask: prompt would be anonymised → routed → ";opts.modelid));
    log.info(str.concat("ask: tolerance=";opts.tolerance));
    <$askresult{
      response:str.concat("[dry-run: prompt would be sent through loke privacy pipeline → ";str.concat(opts.modelid;"]"));
      modelid:opts.modelid;
      tokensin:0;
      tokensout:0;
      costusd:0.0;
      requestid:"dry-run";
      sensitivity:"none";
      entitiesfound:0
    }
  }el{
    let body=str.concat("{";str.concat("\"text\":";str.concat(json.quote(prompt);str.concat(",\"system_prompt\":";str.concat(json.quote(opts.systemprompt);str.concat(",\"tolerance\":";str.concat(json.quote(opts.tolerance);",\"mode\":\"cli\"}")))))));
    let res=http.post("http://127.0.0.1:11430/api/pipeline";body;"application/json");
    let response=json.getstr(res.body;"response");
    let modelid=json.getstr(res.body;"model_id");
    let tokensin=json.geti32(res.body;"tokens_in");
    let tokensout=json.geti32(res.body;"tokens_out");
    let costusd=json.getf32(res.body;"cost_usd");
    let requestid=json.getstr(res.body;"request_id");
    let sensitivity=json.getstr(res.body;"sensitivity");
    let entitiesfound=json.geti32(res.body;"entities_found");
    <$askresult{
      response:response;
      modelid:modelid;
      tokensin:tokensin;
      tokensout:tokensout;
      costusd:costusd;
      requestid:requestid;
      sensitivity:sensitivity;
      entitiesfound:entitiesfound
    }
  }
};



f=formatoutput(r:$askresult;verbose:bool):str{
  if(verbose){
    <str.concat(r.response;str.concat("
---
";str.concat("Model: ";str.concat(r.modelid;str.concat(" | Tokens: ";str.concat(str.fromi32(r.tokensin);str.concat("in/";str.concat(str.fromi32(r.tokensout);str.concat("out | Cost: $";str.concat(str.fromf32(r.costusd);str.concat(" | Sensitivity: ";r.sensitivity)))))))))))
  }el{
    <r.response
  }
};


f=helptext():str{
  let h=mut."loke ask — send a prompt through the loke privacy pipeline\n\n";
  h=str.concat(h;"Usage:\n");
  h=str.concat(h;"  loke ask [options] <prompt>\n");
  h=str.concat(h;"  echo <prompt> | loke ask --stdin\n\n");
  h=str.concat(h;"Options:\n");
  h=str.concat(h;"  --model <id>         Model or router to use (default: loke-router)\n");
  h=str.concat(h;"  --dry-run            Preview privacy pipeline without sending\n");
  h=str.concat(h;"  --no-stream          Disable streaming output\n");
  h=str.concat(h;"  --stdin              Read prompt from stdin\n");
  h=str.concat(h;"  --system <prompt>    Set a system prompt\n");
  h=str.concat(h;"  --tolerance <level>  Privacy tolerance: instant|balanced|thorough (default: instant)\n");
  h=str.concat(h;"  --verbose            Show model, token, cost, and sensitivity metadata\n");
  h=str.concat(h;"  --help               Show this help\n\n");
  h=str.concat(h;"Examples:\n");
  h=str.concat(h;"  loke ask \"Summarise this document\"\n");
  h=str.concat(h;"  loke ask --model claude-3-5-sonnet --verbose \"Explain recursion\"\n");
  h=str.concat(h;"  loke ask --dry-run \"What is my API key?\"\n");
  h=str.concat(h;"  cat notes.txt | loke ask --stdin \"Summarise this\"\n");
  <h
};

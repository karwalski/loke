



m=loke.cli.codepreprocess;
i=str:std.string;
i=log:std.log;

t=$codeprofile{
  filecount:i32;
  totallines:i32;
  languages:@str;
  proprietarypatterns:@str;
  configfilesfound:@str;
  piiincode:@str;
  sensitivestrings:@str
};

t=$scrubresult{
  original:str;
  scrubbed:str;
  replacements:i32;
  patternsfound:@str
};



f=detectlanguage(filename:str):str{
  if(str.endswith(filename;".tk"){
    <"toke"
  }{
    if(str.endswith(filename;".py"){
      <"python"
    }{
      if(str.endswith(filename;".ts"){
        <"typescript"
      }{
        if(str.endswith(filename;".js"){
          <"javascript"
        }{
          if(str.endswith(filename;".go"){
            <"go"
          }{
            if(str.endswith(filename;".rs"){
              <"rust"
            }{
              if(str.endswith(filename;".java"){
                <"java"
              }{
                if(str.endswith(filename;".rb"){
                  <"ruby"
                }{
                  <"unknown"
                };
              };
            };
          };
        };
      };
    };
  };
};





f=findproprietarypatterns(code:str):@str{
  let found:@str=@();
  if(str.contains(code;"PROPRIETARY"){
    found.push("PROPRIETARY marker")
  }{};
  if(str.contains(code;"CONFIDENTIAL"){
    found.push("CONFIDENTIAL marker")
  }{};
  if(str.contains(code;"INTERNAL"){
    found.push("INTERNAL marker")
  }{};
  if(str.contains(code;"internal."){
    found.push("internal URL")
  }{};
  if(str.contains(code;"corp."){
    found.push("corp URL")
  }{};
  if(str.contains(code;"private."){
    found.push("private URL")
  }{};
  if(str.contains(code;"staging."){
    found.push("staging URL")
  }{};
  if(str.contains(code;"All rights reserved"){
    found.push("licence header")
  }{};
  if(str.contains(code;"Copyright"){
    found.push("copyright header")
  }{};
  
  if(str.match(code;"[a-zA-Z0-9]{32,}"){
    found.push("long opaque token (possible API key)")
  }{};
  <found
};



f=findconfigfiles(filenames:@str):@str{
  let found:@str=@();
  filenames.each(f{
    if(str.startswith(f;".env"){
      found.push(f)
    }{
      if(str.endswith(f;".toml"){
        found.push(f)
      }{
        if(str.endswith(f;".yaml"){
          found.push(f)
        }{
          if(str.endswith(f;".yml"){
            found.push(f)
          }{
            if(str.endswith(f;".json"){
              found.push(f)
            }{
              if(str.contains(f;".config."){
                found.push(f)
              }{
                if(str.startswith(f;"credentials"){
                  found.push(f)
                }{
                  if(str.startswith(f;"secrets"){
                    found.push(f)
                  }{};
                };
              };
            };
          };
        };
      };
    };
  });
  <found
};




f=scrubsecrets(code:str):$scrubresult{
  let scrubbed=code;
  let replacements=0;
  let patternsfound:@str=@();

  
  let b64count=str.replaceallpattern(scrubbed;"[A-Za-z0-9+/]{40,}={0,2}";"[SECRET_REDACTED]");
  if(b64count > 0{
    replacements=replacements + b64count;
    patternsfound.push("base64 secret")
  }{};
  scrubbed=str.applyreplacements(scrubbed;"[A-Za-z0-9+/]{40,}={0,2}";"[SECRET_REDACTED]");

  
  let skcount=str.replaceallpattern(scrubbed;"sk-[a-zA-Z0-9]{40,}";"[API_KEY_REDACTED]");
  if(skcount > 0{
    replacements=replacements + skcount;
    patternsfound.push("sk- API key")
  }{};
  scrubbed=str.applyreplacements(scrubbed;"sk-[a-zA-Z0-9]{40,}";"[API_KEY_REDACTED]");

  
  let hexcount=str.replaceallpattern(scrubbed;"\b[0-9a-f]{32,40}\b";"[HASH_REDACTED]");
  if(hexcount > 0{
    replacements=replacements + hexcount;
    patternsfound.push("hex hash/token")
  }{};
  scrubbed=str.applyreplacements(scrubbed;"\b[0-9a-f]{32,40}\b";"[HASH_REDACTED]");

  <$scrubresult{
    original:code;
    scrubbed:scrubbed;
    replacements:replacements;
    patternsfound:patternsfound
  };
};



f=profilecodebase(filenames:@str;linesperfile:@(i32)):$codeprofile{
  let filecount=filenames.len();
  let totallines=0;
  let i=0;
  if(i<linesperfile.len()){
    totallines=totallines + linesperfile.get(i);
    i=i+1
  }{};

  
  let langs:@str=@();
  filenames.each(fn{
    let lang=detectlanguage(fn);
    if(lang == "unknown"{
    }{
      let already=false;
      langs.each(l{
        if(l == lang{
          already=true
        }{};
      });
      if(already{
      }{
        langs.push(lang)
      };
    };
  });

  let configfiles=findconfigfiles(filenames);

  <$codeprofile{
    filecount:filecount;
    totallines:totallines;
    languages:langs;
    proprietarypatterns:@();
    configfilesfound:configfiles;
    piiincode:@();
    sensitivestrings:@()
  };
};



f=profiletotoon(p:$codeprofile):str{
  let out="CODEBASE: " +
    str.fromi32(p.filecount) + "files " +
    str.fromi32(p.totallines) + "lines LANGS:" +
    str.join(p.languages;",");
  if(p.proprietarypatterns.len() > 0{
    out=out + " PROP:" + str.fromi32(p.proprietarypatterns.len())
  }{};
  <out
};

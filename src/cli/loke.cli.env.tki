{
  "schema_version": "1.0",
  "module": "loke.cli.env",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "checkresult", "fields": [{"name": "name", "type": "str"}, {"name": "ok", "type": "bool"}, {"name": "message", "type": "str"}, {"name": "fix", "type": "str"}]},
    {"kind": "type", "name": "doctorreport", "fields": [{"name": "checks", "type": "@"}, {"name": "allok", "type": "bool"}]},
    {"kind": "func", "name": "checklokerunning", "params": [], "return": "checkresult"},
    {"kind": "func", "name": "checkollamarunning", "params": [], "return": "checkresult"},
    {"kind": "func", "name": "checkportfree", "params": ["i32"], "return": "checkresult"},
    {"kind": "func", "name": "checkdatadir", "params": [], "return": "checkresult"},
    {"kind": "func", "name": "rundoctor", "params": [], "return": "doctorreport"},
    {"kind": "func", "name": "formatreport", "params": ["doctorreport"], "return": "str"},
    {"kind": "func", "name": "initshellprofile", "params": [], "return": "str"},
    {"kind": "func", "name": "initgithooks", "params": [], "return": "str"},
    {"kind": "func", "name": "initvscodeconfig", "params": [], "return": "str"}
  ]
}

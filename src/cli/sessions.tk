m=loke.cli.sessions;
i=str:std.string;
i=log:std.log;



t=$sessionmode{
  $shared:i64;
  $isolated:i64};

t=$session{
  id:str;
  name:str;
  mode:str;
  createdat:i64;
  lastactive:i64;
  contextsummary:str;
  messagecount:i32;
  active:bool
};

t=$sessionstore{
  sessions:@$session;
  activeid:str
};


f=gstore():$sessionstore{
  <$sessionstore{
    sessions:@();
    activeid:""
  }
};


f=newstore():$sessionstore{
  <$sessionstore{
    sessions:@();
    activeid:""
  }
};


f=create(name:str;mode:str):$session{
  let id=str.uuid();
  log.info(str.concat("sessions: created ";str.concat(name;str.concat(" (";str.concat(mode;")")))));
  <$session{
    id:id;
    name:name;
    mode:mode;
    createdat:0;
    lastactive:0;
    contextsummary:"";
    messagecount:0;
    active:false
  }
};



f=activate(store:$sessionstore;id:str):$sessionstore{
  let updated:@$session=@();
  lp(let ii=0;ii<store.sessions.len;ii=ii+1){
    let s=store.sessions.get(ii);
    if(s.id = id){
      updated.push($session{
        id:s.id;
        name:s.name;
        mode:s.mode;
        createdat:s.createdat;
        lastactive:s.lastactive;
        contextsummary:s.contextsummary;
        messagecount:s.messagecount;
        active:true
      })
    }el{
      updated.push(s)
    }
  };
  log.info(str.concat("sessions: activated ";id));
  <$sessionstore{
    sessions:updated;
    activeid:id
  }
};



f=deactivate(store:$sessionstore;id:str):$sessionstore{
  let updated:@$session=@();
  lp(let ii=0;ii<store.sessions.len;ii=ii+1){
    let s=store.sessions.get(ii);
    if(s.id = id){
      updated.push($session{
        id:s.id;
        name:s.name;
        mode:s.mode;
        createdat:s.createdat;
        lastactive:s.lastactive;
        contextsummary:s.contextsummary;
        messagecount:s.messagecount;
        active:false
      })
    }el{
      updated.push(s)
    }
  };
  log.info(str.concat("sessions: deactivated ";id));
  <$sessionstore{
    sessions:updated;
    activeid:store.activeid
  }
};


f=getactive(store:$sessionstore):i64{
  let result=mut.0;
  lp(let ii=0;ii<store.sessions.len;ii=ii+1){
    let s=store.sessions.get(ii);
    if(s.id = store.activeid){
      result=s
    }el{}
  };
  <result
};


f=list(store:$sessionstore):@$session{
  <store.sessions
};


f=find(store:$sessionstore;name:str):i64{
  let result=mut.0;
  lp(let ii=0;ii<store.sessions.len;ii=ii+1){
    let s=store.sessions.get(ii);
    if(s.name = name){
      result=s
    }el{}
  };
  <result
};



f=updatecontext(store:$sessionstore;id:str;summary:str):$sessionstore{
  let updated:@$session=@();
  lp(let ii=0;ii<store.sessions.len;ii=ii+1){
    let s=store.sessions.get(ii);
    if(s.id = id){
      updated.push($session{
        id:s.id;
        name:s.name;
        mode:s.mode;
        createdat:s.createdat;
        lastactive:0;
        contextsummary:summary;
        messagecount:s.messagecount;
        active:s.active
      })
    }el{
      updated.push(s)
    }
  };
  <$sessionstore{
    sessions:updated;
    activeid:store.activeid
  }
};


f=tojson(s:$session):str{
  let activestr=mut."false";
  if(s.active){ activestr="true" }el{};
  let j=mut.str.concat("{\"id\":\"";str.concat(s.id;"\""));
  j=str.concat(j;str.concat(",\"name\":\"";str.concat(s.name;"\"")));
  j=str.concat(j;str.concat(",\"mode\":\"";str.concat(s.mode;"\"")));
  j=str.concat(j;str.concat(",\"created_at\":";str.fromi64(s.createdat)));
  j=str.concat(j;str.concat(",\"last_active\":";str.fromi64(s.lastactive)));
  j=str.concat(j;str.concat(",\"context_summary\":\"";str.concat(s.contextsummary;"\"")));
  j=str.concat(j;str.concat(",\"message_count\":";str.fromi32(s.messagecount)));
  j=str.concat(j;str.concat(",\"active\":";activestr));
  <str.concat(j;"}")
};



f=formatlist(store:$sessionstore):str{
  let out=mut."ID                                   Name             Mode       Msgs  Last Active
";
  out=out + "----                                 ----             ----       ----  -----------
";
  lp(let ii=0;ii<store.sessions.len;ii=ii+1){
    let s=store.sessions.get(ii);
    let activemarker=mut."";
    if(s.active){
      activemarker=" *"
    }el{};
    out=out +
      s.id + "  " +
      s.name + activemarker + "  " +
      s.mode + "  " +
      str.fromi32(s.messagecount) + "  " +
      str.fromi64(s.lastactive) + "
"
  };
  <out
};

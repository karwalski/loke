



m=loke.cli.sessions;
i=str:std.string;
i=log:std.log;



t=$sessionmode{
  $shared:i64;
  $isolated
};

t=$session{
  id:str;
  name:str;
  mode:str;
  createdat:i64;
  lastactive:i64;
  contextsummary:str;
  messagecount:i32;
  active:bool
};

t=$sessionstore{
  sessions:@$session;
  activeid:str
};


let gstore:$sessionstore=$sessionstore{
  sessions:@();
  activeid:""
};


f=newstore():$sessionstore{
  <$sessionstore{
    sessions:@();
    activeid:""
  };
};


f=create(name:str;mode:str):$session{
  let id=str.uuid();
  log.info("sessions: created " + name + " (" + mode + ")");
  <$session{
    id:id;
    name:name;
    mode:mode;
    createdat:0;
    lastactive:0;
    contextsummary:"";
    messagecount:0;
    active:false
  };
};



f=activate(store:$sessionstore;id:str):$sessionstore{
  let updated:@$session=@();
  store.sessions.each(s{
    if(s.id = id){
      updated.push($session{
        id:s.id;
        name:s.name;
        mode:s.mode;
        createdat:s.createdat;
        lastactive:s.lastactive;
        contextsummary:s.contextsummary;
        messagecount:s.messagecount;
        active:true
      })
    }{
      updated.push(s)
    };
  });
  log.info("sessions: activated " + id);
  <$sessionstore{
    sessions:updated;
    activeid:id
  };
};



f=deactivate(store:$sessionstore;id:str):$sessionstore{
  let updated:@$session=@();
  store.sessions.each(s{
    if(s.id = id){
      updated.push($session{
        id:s.id;
        name:s.name;
        mode:s.mode;
        createdat:s.createdat;
        lastactive:s.lastactive;
        contextsummary:s.contextsummary;
        messagecount:s.messagecount;
        active:false
      })
    }{
      updated.push(s)
    };
  });
  log.info("sessions: deactivated " + id);
  <$sessionstore{
    sessions:updated;
    activeid:store.activeid
  };
};


f=getactive(store:$sessionstore):($session){
  let result:($session)=none;
  store.sessions.each(s{
    if(s.id = store.activeid){
      result=some(s)
    }{};
  });
  <result
};


f=list(store:$sessionstore):@$session{
  <store.sessions
};


f=find(store:$sessionstore;name:str):($session){
  let result:($session)=none;
  store.sessions.each(s{
    if(s.name = name){
      result=some(s)
    }{};
  });
  <result
};



f=updatecontext(store:$sessionstore;id:str;summary:str):$sessionstore{
  let updated:@$session=@();
  store.sessions.each(s{
    if(s.id = id){
      updated.push($session{
        id:s.id;
        name:s.name;
        mode:s.mode;
        createdat:s.createdat;
        lastactive:0;
        contextsummary:summary;
        messagecount:s.messagecount;
        active:s.active
      })
    }{
      updated.push(s)
    };
  });
  <$sessionstore{
    sessions:updated;
    activeid:store.activeid
  };
};


f=tojson(s:$session):str{
  let activestr=if s.active{ "true" }{ "false" };
  <"{" +
    "\"id\":\"" + s.id + "\"" +
    ",\"name\":\"" + s.name + "\"" +
    ",\"mode\":\"" + s.mode + "\"" +
    ",\"created_at\":" + str.fromi64(s.createdat) +
    ",\"last_active\":" + str.fromi64(s.lastactive) +
    ",\"context_summary\":\"" + s.contextsummary + "\"" +
    ",\"message_count\":" + str.fromi32(s.messagecount) +
    ",\"active\":" + activestr +
  "}"
};



f=formatlist(store:$sessionstore):str{
  let out="ID                                   Name             Mode       Msgs  Last Active
";
  out=out + "----                                 ----             ----       ----  -----------
";
  store.sessions.each(s{
    let activemarker="";
    if(s.active){
      activemarker=" *"
    }{};
    out=out +
      s.id + "  " +
      s.name + activemarker + "  " +
      s.mode + "  " +
      str.fromi32(s.messagecount) + "  " +
      str.fromi64(s.lastactive) + "
"
  });
  <out
};

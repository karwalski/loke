



m=loke.cli.env;
i=str:std.string;
i=log:std.log;
i=http:std.http;

t=$checkresult{
  name:str;
  ok:bool;
  message:str;
  fix:str
};

t=$doctorreport{
  checks:@$checkresult;
  allok:bool
};


f=checklokerunning():$checkresult{
  let res=http.get("http://127.0.0.1:11430/api/health");
  let ok=res.status = 200;
  let message="loke daemon is running";
  if(ok){
  }{
    message="loke daemon not reachable on port 11430"
  };
  <$checkresult{
    name:"loke daemon";
    ok:ok;
    message:message;
    fix:"Run: loke start"
  }
};


f=checkollamarunning():$checkresult{
  let res=http.get("http://127.0.0.1:11434/api/tags");
  let ok=res.status = 200;
  let message="Ollama is running";
  if(ok){
  }{
    message="Ollama not reachable on port 11434"
  };
  <$checkresult{
    name:"Ollama";
    ok:ok;
    message:message;
    fix:"Run: ollama serve"
  }
};



f=checkportfree(port:i32):$checkresult{
  <$checkresult{
    name:"port " + str.fromi32(port);
    ok:true;
    message:"port " + str.fromi32(port) + " is free";
    fix:"Change port in ooke.toml"
  }
};


f=checkdatadir():$checkresult{
  <$checkresult{
    name:"data directory";
    ok:true;
    message:"~/.loke exists";
    fix:"Run: mkdir -p ~/.loke"
  }
};


f=rundoctor():$doctorreport{
  let checks:@$checkresult=@();

  let lokecheck=checklokerunning();
  if(lokecheck.ok){
    log.info("doctor: ✓ " + lokecheck.name + ": " + lokecheck.message)
  }{
    log.warn("doctor: ✗ " + lokecheck.name + ": " + lokecheck.message)
  };
  checks.push(lokecheck);

  let ollamacheck=checkollamarunning();
  if(ollamacheck.ok){
    log.info("doctor: ✓ " + ollamacheck.name + ": " + ollamacheck.message)
  }{
    log.warn("doctor: ✗ " + ollamacheck.name + ": " + ollamacheck.message)
  };
  checks.push(ollamacheck);

  let portcheck=checkportfree(11431);
  if(portcheck.ok){
    log.info("doctor: ✓ " + portcheck.name + ": " + portcheck.message)
  }{
    log.warn("doctor: ✗ " + portcheck.name + ": " + portcheck.message)
  };
  checks.push(portcheck);

  let dircheck=checkdatadir();
  if(dircheck.ok){
    log.info("doctor: ✓ " + dircheck.name + ": " + dircheck.message)
  }{
    log.warn("doctor: ✗ " + dircheck.name + ": " + dircheck.message)
  };
  checks.push(dircheck);

  let allok=true;
  checks.each(c{
    if(c.ok){
    }{
      allok=false
    }
  });

  <$doctorreport{
    checks:checks;
    allok:allok
  }
};



f=formatreport(r:$doctorreport):str{
  let out="loke doctor
";
  r.checks.each(c{
    if(c.ok){
      out=out + "✓ " + c.name + ": " + c.message + "
"
    }{
      out=out + "✗ " + c.name + ": " + c.message + "
" +
        "  Fix: " + c.fix + "
"
    }
  });
  out=out + "
";
  if(r.allok){
    out=out + "All checks passed."
  }{
    out=out + "Some checks failed."
  };
  <out
};


f=initshellprofile():str{
  <"# loke — added by loke init
" +
    "export PATH=\"$PATH:$HOME/.loke/bin\"
" +
    "alias loke-chat='loke ask'
"
};



f=initgithooks():str{
  <"#!/bin/sh
" +
    "# loke git hook: scans staged files for secrets before commit
" +
    "loke scan --staged --exit-code
"
};



f=initvscodeconfig():str{
  <"{\"loke.proxy.enabled\":true,\"loke.proxy.port\":11431}"
};

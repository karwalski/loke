m=loke.cli.env;
i=str:std.string;
i=log:std.log;
i=http:std.http;

t=$checkresult{
  name:str;
  ok:bool;
  message:str;
  fix:str
};

t=$doctorreport{
  checks:@$checkresult;
  allok:bool
};


f=checklokerunning():$checkresult{
  let res=http.get("http://127.0.0.1:11430/api/health");
  let ok=res.status = 200;
  let message=mut."loke daemon is running";
  if(ok){
  }el{
    message="loke daemon not reachable on port 11430"
  };
  <$checkresult{
    name:"loke daemon";
    ok:ok;
    message:message;
    fix:"Run: loke start"
  }
};


f=checkollamarunning():$checkresult{
  let res=http.get("http://127.0.0.1:11434/api/tags");
  let ok=res.status = 200;
  let message=mut."Ollama is running";
  if(ok){
  }el{
    message="Ollama not reachable on port 11434"
  };
  <$checkresult{
    name:"Ollama";
    ok:ok;
    message:message;
    fix:"Run: ollama serve"
  }
};



f=checkportfree(port:i32):$checkresult{
  <$checkresult{
    name:str.concat("port ";str.fromi32(port));
    ok:true;
    message:str.concat("port ";str.concat(str.fromi32(port);" is free"));
    fix:"Change port in ooke.toml"
  }
};


f=checkdatadir():$checkresult{
  <$checkresult{
    name:"data directory";
    ok:true;
    message:"~/.loke exists";
    fix:"Run: mkdir -p ~/.loke"
  }
};


f=rundoctor():$doctorreport{
  let checks:@$checkresult=@();

  let lokecheck=checklokerunning();
  if(lokecheck.ok){
    log.info(str.concat("doctor: ✓ ";str.concat(lokecheck.name;str.concat(": ";lokecheck.message))))
  }el{
    log.warn(str.concat("doctor: ✗ ";str.concat(lokecheck.name;str.concat(": ";lokecheck.message))))
  };
  checks.push(lokecheck);

  let ollamacheck=checkollamarunning();
  if(ollamacheck.ok){
    log.info(str.concat("doctor: ✓ ";str.concat(ollamacheck.name;str.concat(": ";ollamacheck.message))))
  }el{
    log.warn(str.concat("doctor: ✗ ";str.concat(ollamacheck.name;str.concat(": ";ollamacheck.message))))
  };
  checks.push(ollamacheck);

  let portcheck=checkportfree(11431);
  if(portcheck.ok){
    log.info(str.concat("doctor: ✓ ";str.concat(portcheck.name;str.concat(": ";portcheck.message))))
  }el{
    log.warn(str.concat("doctor: ✗ ";str.concat(portcheck.name;str.concat(": ";portcheck.message))))
  };
  checks.push(portcheck);

  let dircheck=checkdatadir();
  if(dircheck.ok){
    log.info(str.concat("doctor: ✓ ";str.concat(dircheck.name;str.concat(": ";dircheck.message))))
  }el{
    log.warn(str.concat("doctor: ✗ ";str.concat(dircheck.name;str.concat(": ";dircheck.message))))
  };
  checks.push(dircheck);

  let allok=mut.true;
  lp(let ii=0;ii<checks.len;ii=ii+1){ let c=checks.get(ii);
    if(c.ok){
    }el{
      allok=false
    }
  };

  <$doctorreport{
    checks:checks;
    allok:allok
  }
};



f=formatreport(r:$doctorreport):str{
  let out=mut."loke doctor\n";
  lp(let ii=0;ii<r.checks.len;ii=ii+1){
    let c=r.checks.get(ii);
    if(c.ok){
      out=str.concat(out;str.concat("ok ";str.concat(c.name;str.concat(": ";str.concat(c.message;"\n")))))
    }el{
      out=str.concat(out;str.concat("FAIL ";str.concat(c.name;str.concat(": ";str.concat(c.message;"\n")))));
      out=str.concat(out;str.concat("  Fix: ";str.concat(c.fix;"\n")))
    }
  };
  out=str.concat(out;"\n");
  if(r.allok){
    out=str.concat(out;"All checks passed.")
  }el{
    out=str.concat(out;"Some checks failed.")
  };
  <out
};


f=initshellprofile():str{
  <str.concat("# loke — added by loke init\n";str.concat("export PATH=\"$PATH:$HOME/.loke/bin\"\n";"alias loke-chat='loke ask'\n"))
};



f=initgithooks():str{
  <str.concat("#!/bin/sh\n";str.concat("# loke git hook: scans staged files for secrets before commit\n";"loke scan --staged --exit-code\n"))
};



f=initvscodeconfig():str{
  <"{\"loke.proxy.enabled\":true,\"loke.proxy.port\":11431}"
};

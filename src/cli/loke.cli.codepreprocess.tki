{
  "schema_version": "1.0",
  "module": "loke.cli.codepreprocess",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "codeprofile", "fields": [{"name": "filecount", "type": "i32"}, {"name": "totallines", "type": "i32"}, {"name": "languages", "type": "@"}, {"name": "proprietarypatterns", "type": "@"}, {"name": "configfilesfound", "type": "@"}, {"name": "piiincode", "type": "@"}, {"name": "sensitivestrings", "type": "@"}]},
    {"kind": "type", "name": "scrubresult", "fields": [{"name": "original", "type": "str"}, {"name": "scrubbed", "type": "str"}, {"name": "replacements", "type": "i32"}, {"name": "patternsfound", "type": "@"}]},
    {"kind": "func", "name": "detectlanguage", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "findproprietarypatterns", "params": ["str"], "return": "@"},
    {"kind": "func", "name": "findconfigfiles", "params": ["@"], "return": "@"},
    {"kind": "func", "name": "scrubsecrets", "params": ["str"], "return": "scrubresult"},
    {"kind": "func", "name": "profilecodebase", "params": ["@", "@"], "return": "codeprofile"},
    {"kind": "func", "name": "profiletotoon", "params": ["codeprofile"], "return": "str"}
  ]
}

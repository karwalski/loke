{
  "schema_version": "1.0",
  "module": "loke.memory.enrichment",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "enrichmentconfig", "fields": [{"name": "enabled", "type": "bool"}, {"name": "maxmemories", "type": "i32"}, {"name": "tokenbudget", "type": "i32"}, {"name": "relevancethreshold", "type": "f32"}, {"name": "anonymiseforcloud", "type": "bool"}]},
    {"kind": "type", "name": "enrichedcontext", "fields": [{"name": "memories", "type": "@"}, {"name": "totaltokens", "type": "i32"}, {"name": "searchquery", "type": "str"}, {"name": "memoriesfound", "type": "i32"}, {"name": "disclosure", "type": "str"}]},
    {"kind": "func", "name": "defaultconfig", "params": [], "return": "enrichmentconfig"},
    {"kind": "func", "name": "buildsearchquery", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "enrich", "params": ["str", "enrichmentconfig", "str"], "return": "enrichedcontext"},
    {"kind": "func", "name": "formatforprompt", "params": ["enrichedcontext"], "return": "str"},
    {"kind": "func", "name": "disclosuretext", "params": ["enrichedcontext"], "return": "str"},
    {"kind": "func", "name": "tojson", "params": ["enrichedcontext"], "return": "str"}
  ]
}

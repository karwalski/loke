m=memory.mining;





m=loke.memory.mining;

i=str:std.string;
i=log:std.log;
i=json:std.json;

t=$miningmode{
  $projects:i64;
  $conversations:i64;
  $general:i64};

t=$miningsource{
  $claudeexport:i64;
  $chatgptexport:i64;
  $slackjson:i64;
  $markdown:i64;
  $coderepo:i64};

t=$miningjob{
  id:str;
  sourcepath:str;
  sourcetype:str;
  mode:str;
  status:str;
  itemsfound:i32;
  itemsstored:i32;
  startedat:i64;
  completedat:i64;
  error:str
};

t=$mineditem{
  content:str;
  source:str;
  ts:i64;
  wing:str;
  tags:@str
};


let gjobs:@$miningjob=@();


f=newjob(sourcepath:str;sourcetype:str;mode:str):$miningjob{
  <$miningjob{
    id:str.uuid();
    sourcepath:sourcepath;
    sourcetype:sourcetype;
    mode:mode;
    status:"pending";
    itemsfound:0;
    itemsstored:0;
    startedat:0;
    completedat:0;
    error:""
  }
};


f=start(job:$miningjob):$miningjob{
  log.info(str.concat("mining: starting ";str.concat(job.sourcetype;str.concat(" from ";job.sourcepath))));
  <$miningjob{
    id:job.id;
    sourcepath:job.sourcepath;
    sourcetype:job.sourcetype;
    mode:job.mode;
    status:"running";
    itemsfound:job.itemsfound;
    itemsstored:job.itemsstored;
    startedat:std.nowms();
    completedat:job.completedat;
    error:job.error
  }
};


f=complete(job:$miningjob;found:i32;stored:i32):$miningjob{
  log.info(str.concat("mining: complete — ";str.concat(str.fromi32(stored);str.concat("/";str.concat(str.fromi32(found);" items stored")))));
  <$miningjob{
    id:job.id;
    sourcepath:job.sourcepath;
    sourcetype:job.sourcetype;
    mode:job.mode;
    status:"complete";
    itemsfound:found;
    itemsstored:stored;
    startedat:job.startedat;
    completedat:std.nowms();
    error:job.error
  }
};


f=fail(job:$miningjob;error:str):$miningjob{
  log.info(str.concat("mining: failed — ";error));
  <$miningjob{
    id:job.id;
    sourcepath:job.sourcepath;
    sourcetype:job.sourcetype;
    mode:job.mode;
    status:"error";
    itemsfound:job.itemsfound;
    itemsstored:job.itemsstored;
    startedat:job.startedat;
    completedat:job.completedat;
    error:error
  }
};


f=detectsourcetype(path:str):str{
  if(str.endswith(path;".json") && str.contains(path;"claude")){
    <"claude_export"
  }el{
    if(str.endswith(path;".json") && str.contains(path;"chatgpt")){
      <"chatgpt_export"
    }el{
      if(str.endswith(path;".json")){
        <"slack_json"
      }el{
        if(str.endswith(path;".md")){
          <"markdown"
        }el{
          <"code_repo"
        }
      }
    }
  }
};


f=assignwing(mode:str;sourcetype:str):str{
  if(str.eq(mode;"projects")){
    <"projects"
  }el{
    if(str.eq(mode;"conversations")){
      <"conversations"
    }el{
      <"general"
    }
  }
};



f=privacyscan(content:str):bool{
  log.info(str.concat("mining: privacy scan on ";str.concat(str.fromi32(str.len(content));" chars")));
  <true
};



f=minemarkdown(path:str;mode:str):@$mineditem{
  log.info(str.concat("mining: parsing markdown at ";path));
  <@()
};



f=minejsonexport(path:str;sourcetype:str;mode:str):@$mineditem{
  log.info(str.concat("mining: parsing ";str.concat(sourcetype;str.concat(" at ";path))));
  <@()
};



f=run(job:$miningjob):$miningjob{
  let running=start(job);
  let items=if str.eq(running.sourcetype;"markdown"){
    minemarkdown(running.sourcepath;running.mode)
  }el{
    if(str.eq(running.sourcetype;"claude_export") || str.eq(running.sourcetype;"chatgpt_export") || str.eq(running.sourcetype;"slack_json")){
      minejsonexport(running.sourcepath;running.sourcetype;running.mode)
    }el{
      @()
    }
  };
  let found=items.len();
  let stored=0;
  items.each(item{
    if(privacyscan(item.content)){
      let stored=stored + 1
    }
  });
  <complete(running;found;stored)
};


f=jobtojson(j:$miningjob):str{
  <str.concat("{\"id\":\"";str.concat(j.id;str.concat("\",\"source_path\":\"";str.concat(j.sourcepath;str.concat("\",\"source_type\":\"";str.concat(j.sourcetype;str.concat("\",\"mode\":\"";str.concat(j.mode;str.concat("\",\"status\":\"";str.concat(j.status;str.concat("\",\"items_found\":";str.concat(str.fromi32(j.itemsfound);str.concat(",\"items_stored\":";str.concat(str.fromi32(j.itemsstored);str.concat(",\"started_at\":";str.concat(str.fromi64(j.startedat);str.concat(",\"completed_at\":";str.concat(str.fromi64(j.completedat);str.concat(",\"error\":\"";str.concat(j.error;"\"}"))))))))))))))))))
};


f=itemtojson(i:$mineditem):str{
  let tagsjson="[";
  let first=true;
  i.tags.each(t{
    if(first){
      let tagsjson=str.concat(tagsjson;str.concat("\"";str.concat(t;"\""))); let first=false
    }{
      let tagsjson=str.concat(tagsjson;str.concat(",\"";str.concat(t;"\"")))
    }
  });
  let tagsjson=str.concat(tagsjson;"]");
  <str.concat("{\"content\":\"";str.concat(i.content;str.concat("\",\"source\":\"";str.concat(i.source;str.concat("\",\"ts\":";str.concat(str.fromi64(i.ts);str.concat(",\"wing\":\"";str.concat(i.wing;str.concat("\",\"tags\":";str.concat(tagsjson;"}")))))))))))
};

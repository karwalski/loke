
m=loke.memory.agentdiary;

i=str:std.string;
i=log:std.log;
i=json:std.json;

t=$diaryentry{
  id:str;
  agentid:str;
  runid:str;
  summary:str;
  result:str;
  tokensused:i32;
  costusd:f32;
  durationms:i32;
  feedbackreceived:str;
  ts:i64
};

t=$diary{
  agentid:str;
  wing:str;
  entries:@$diaryentry
};


t=$diarystore{
  diaries:@$diary
};

f=newdiarystore():$diarystore{ <$diarystore{diaries:@()} };



f=getorcreatediary(st:$diarystore;agentid:str):$diary{
  let found=mut.false;
  let result=mut.$diary{agentid:agentid;wing:str.concat("agents.";agentid);entries:@()};
  lp(let ii=0;ii<st.diaries.len;ii=ii+1){ let d=st.diaries.get(ii);
    if(str.eq(d.agentid;agentid)){
      result=d;
      found=true
    }el{}
  };
  if(!found){
    log.info(str.concat("diary: created for ";agentid));
    st.diaries=st.diaries.push(result)
  };
  <result
};


f=appendentry(st:$diarystore;agentid:str;entry:$diaryentry):i64{
  let diary=getorcreatediary(agentid);
  let updated=$diary{
    agentid:diary.agentid;
    wing:diary.wing;
    entries:diary.entries.push(entry)
  };
  let newdiaries=@();
  lp(let ii=0;ii<st.diaries.len;ii=ii+1){ let d=st.diaries.get(ii);
    if(str.eq(d.agentid;agentid)){
      newdiaries.push(updated)
    }el{
      newdiaries.push(d)
    }
  };
  st.diaries=newdiaries;
  log.info(str.concat("diary: entry for ";str.concat(agentid;str.concat(" run=";entry.runid))))
};


f=getentries(st:$diarystore;agentid:str):@$diaryentry{
  let diary=getorcreatediary(agentid);
  
  let reversed=@();
  let i=diary.entries.len() - 1;
  if(i > 0){
    let reversed=reversed.push(diary.entries.get(i));
    let i=i - 1
  }el{};
  <reversed
};


f=getrecent(st:$diarystore;agentid:str;n:i32):@$diaryentry{
  let all=getentries(agentid);
  let result=@();
  let count=0;
  lp(let ii=0;ii<all.len;ii=ii+1){ let e=all.get(ii);
    if(count < n){
      result.push(e);
      count=count + 1
    }el{}
  };
  <result
};


f=buildstartupcontext(st:$diarystore;agentid:str;maxentries:i32):str{
  let recent=getrecent(agentid;maxentries);
  let header=str.concat("AGENT:";str.concat(agentid;" DIARY_SUMMARY:
"));
  let body="";
  lp(let ii=0;ii<recent.len;ii=ii+1){ let e=recent.get(ii);
    let line=str.concat("RUN:";str.concat(e.runid;str.concat(" RESULT:";str.concat(e.result;str.concat(" TOKENS:";str.concat(str.fromi32(e.tokensused);"
"))))));
    body=str.concat(body;line)
  };
  <str.concat(header;body)
};


f=compressoldentries(st:$diarystore;agentid:str;keeprecent:i32):i64{
  log.info(str.concat("diary: compressing entries older than ";str.concat(str.fromi32(keeprecent);" recent (AAAK compression pending)")))
};


f=recordfeedback(st:$diarystore;agentid:str;runid:str;feedback:str):i64{
  let diary=getorcreatediary(agentid);
  let updatedentries=@();
  lp(let ii=0;ii<diary.entries.len;ii=ii+1){ let e=diary.entries.get(ii);
    if(str.eq(e.runid;runid)){
      let updated=$diaryentry{
        id:e.id;
        agentid:e.agentid;
        runid:e.runid;
        summary:e.summary;
        result:e.result;
        tokensused:e.tokensused;
        costusd:e.costusd;
        durationms:e.durationms;
        feedbackreceived:feedback;
        ts:e.ts
      };
      updatedentries.push(updated)
    }el{
      updatedentries.push(e)
    }
  };
  let updateddiary=$diary{
    agentid:diary.agentid;
    wing:diary.wing;
    entries:updatedentries
  };
  let newdiaries=@();
  lp(let ii=0;ii<st.diaries.len;ii=ii+1){ let d=st.diaries.get(ii);
    if(str.eq(d.agentid;agentid)){
      newdiaries.push(updateddiary)
    }el{
      newdiaries.push(d)
    }
  };
  st.diaries=newdiaries;
  log.info(str.concat("diary: feedback recorded for ";str.concat(agentid;str.concat(" run=";runid))))
};


f=entrytojson(e:$diaryentry):str{
  let j=mut.str.concat("{\"id\":\"";str.concat(e.id;"\""));
  j=str.concat(j;str.concat(",\"agent_id\":\"";str.concat(e.agentid;"\"")));
  j=str.concat(j;str.concat(",\"run_id\":\"";str.concat(e.runid;"\"")));
  j=str.concat(j;str.concat(",\"summary\":\"";str.concat(e.summary;"\"")));
  j=str.concat(j;str.concat(",\"result\":\"";str.concat(e.result;"\"")));
  j=str.concat(j;str.concat(",\"tokens_used\":";str.fromi32(e.tokensused)));
  j=str.concat(j;str.concat(",\"cost_usd\":";str.fromf32(e.costusd)));
  j=str.concat(j;str.concat(",\"duration_ms\":";str.fromi32(e.durationms)));
  j=str.concat(j;str.concat(",\"feedback_received\":\"";str.concat(e.feedbackreceived;"\"")));
  j=str.concat(j;str.concat(",\"ts\":";str.fromi64(e.ts)));
  <str.concat(j;"}")
};


f=toaaak(e:$diaryentry):str{
  <str.concat("RUN:";str.concat(e.runid;str.concat(" ";str.concat(e.summary;str.concat(" RESULT:";str.concat(e.result;str.concat(" TOK:";str.concat(str.fromi32(e.tokensused);str.concat(" COST:$";str.fromf32(e.costusd))))))))))
};

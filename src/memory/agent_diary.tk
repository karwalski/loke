m=memory.agent_diary;





m=loke.memory.agentdiary;

i=str:std.string;
i=log:std.log;
i=json:std.json;

t=$diaryentry{
  id:str;
  agentid:str;
  runid:str;
  summary:str;
  result:str;
  tokensused:i32;
  costusd:f32;
  durationms:i32;
  feedbackreceived:str;
  ts:i64
};

t=$diary{
  agentid:str;
  wing:str;
  entries:@$diaryentry
};


let gdiaries:@$diary=@();



f=getorcreatediary(agentid:str):$diary{
  let found=false;
  let result=$diary{agentid:agentid;wing:str.concat("agents.";agentid);entries:@()};
  gdiaries.each(d{
    if(str.eq(d.agentid;agentid){
      let result=d;
      let found=true
    };
  });
  if(!$found{
    log.info(str.concat("diary: created for ";agentid));
    let gdiaries=gdiaries.push(result)
  };
  <result
};


f=appendentry(agentid:str;entry:$diaryentry){
  let diary=getorcreatediary(agentid);
  let updated=$diary{
    agentid:diary.agentid;
    wing:diary.wing;
    entries:diary.entries.push(entry)
  };
  let newdiaries=@();
  gdiaries.each(d{
    if(str.eq(d.agentid;agentid){
      let newdiaries=newdiaries.push(updated)
    }{
      let newdiaries=newdiaries.push(d)
    };
  });
  let gdiaries=newdiaries;
  log.info(str.concat("diary: entry for ";str.concat(agentid;str.concat(" run=";entry.runid))))
};


f=getentries(agentid:str):@$diaryentry{
  let diary=getorcreatediary(agentid);
  
  let reversed=@();
  let i=diary.entries.len() - 1;
  if(i >= 0){
    let reversed=reversed.push(diary.entries.get(i));
    let i=i - 1
  }{};
  <reversed
};


f=getrecent(agentid:str;n:i32):@$diaryentry{
  let all=getentries(agentid);
  let result=@();
  let count=0;
  all.each(e{
    if(count < n{
      let result=result.push(e);
      let count=count + 1
    };
  });
  <result
};


f=buildstartupcontext(agentid:str;maxentries:i32):str{
  let recent=getrecent(agentid;maxentries);
  let header=str.concat("AGENT:";str.concat(agentid;" DIARY_SUMMARY:
"));
  let body="";
  recent.each(e{
    let line=str.concat("RUN:";str.concat(e.runid;str.concat(" RESULT:";str.concat(e.result;str.concat(" TOKENS:";str.concat(str.fromi32(e.tokensused);"
"))))));
    let body=str.concat(body;line)
  });
  <str.concat(header;body)
};


f=compressoldentries(agentid:str;keeprecent:i32){
  log.info(str.concat("diary: compressing entries older than ";str.concat(str.fromi32(keeprecent);" recent (AAAK compression pending)")))
};


f=recordfeedback(agentid:str;runid:str;feedback:str){
  let diary=getorcreatediary(agentid);
  let updatedentries=@();
  diary.entries.each(e{
    if(str.eq(e.runid;runid){
      let updated=$diaryentry{
        id:e.id;
        agentid:e.agentid;
        runid:e.runid;
        summary:e.summary;
        result:e.result;
        tokensused:e.tokensused;
        costusd:e.costusd;
        durationms:e.durationms;
        feedbackreceived:feedback;
        ts:e.ts
      };
      let updatedentries=updatedentries.push(updated)
    }{
      let updatedentries=updatedentries.push(e)
    };
  });
  let updateddiary=$diary{
    agentid:diary.agentid;
    wing:diary.wing;
    entries:updatedentries
  };
  let newdiaries=@();
  gdiaries.each(d{
    if(str.eq(d.agentid;agentid){
      let newdiaries=newdiaries.push(updateddiary)
    }{
      let newdiaries=newdiaries.push(d)
    };
  });
  let gdiaries=newdiaries;
  log.info(str.concat("diary: feedback recorded for ";str.concat(agentid;str.concat(" run=";runid))))
};


f=entrytojson(e:$diaryentry):str{
  <str.concat("{\"id\":\"";str.concat(e.id;str.concat("\",\"agent_id\":\"";str.concat(e.agentid;str.concat("\",\"run_id\":\"";str.concat(e.runid;str.concat("\",\"summary\":\"";str.concat(e.summary;str.concat("\",\"result\":\"";str.concat(e.result;str.concat("\",\"tokens_used\":";str.concat(str.fromi32(e.tokensused);str.concat(",\"cost_usd\":";str.concat(str.fromf32(e.costusd);str.concat(",\"duration_ms\":";str.concat(str.fromi32(e.durationms);str.concat(",\"feedback_received\":\"";str.concat(e.feedbackreceived;str.concat("\",\"ts\":";str.concat(str.fromi64(e.ts);"}")))))))))))))))))))
};


f=toaaak(e:$diaryentry):str{
  <str.concat("RUN:";str.concat(e.runid;str.concat(" ";str.concat(e.summary;str.concat(" RESULT:";str.concat(e.result;str.concat(" TOK:";str.concat(str.fromi32(e.tokensused);str.concat(" COST:$";str.fromf32(e.costusd))))))))))
};

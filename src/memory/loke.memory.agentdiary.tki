{
  "schema_version": "1.0",
  "module": "loke.memory.agentdiary",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "diaryentry", "fields": [{"name": "id", "type": "str"}, {"name": "agentid", "type": "str"}, {"name": "runid", "type": "str"}, {"name": "summary", "type": "str"}, {"name": "result", "type": "str"}, {"name": "tokensused", "type": "i32"}, {"name": "costusd", "type": "f32"}, {"name": "durationms", "type": "i32"}, {"name": "feedbackreceived", "type": "str"}, {"name": "ts", "type": "i64"}]},
    {"kind": "type", "name": "diary", "fields": [{"name": "agentid", "type": "str"}, {"name": "wing", "type": "str"}, {"name": "entries", "type": "@"}]},
    {"kind": "type", "name": "diarystore", "fields": [{"name": "diaries", "type": "@"}]},
    {"kind": "func", "name": "newdiarystore", "params": [], "return": "diarystore"},
    {"kind": "func", "name": "getorcreatediary", "params": ["diarystore", "str"], "return": "diary"},
    {"kind": "func", "name": "appendentry", "params": ["diarystore", "str", "diaryentry"], "return": "i64"},
    {"kind": "func", "name": "getentries", "params": ["diarystore", "str"], "return": "@"},
    {"kind": "func", "name": "getrecent", "params": ["diarystore", "str", "i32"], "return": "@"},
    {"kind": "func", "name": "buildstartupcontext", "params": ["diarystore", "str", "i32"], "return": "str"},
    {"kind": "func", "name": "compressoldentries", "params": ["diarystore", "str", "i32"], "return": "i64"},
    {"kind": "func", "name": "recordfeedback", "params": ["diarystore", "str", "str", "str"], "return": "i64"},
    {"kind": "func", "name": "entrytojson", "params": ["diaryentry"], "return": "str"},
    {"kind": "func", "name": "toaaak", "params": ["diaryentry"], "return": "str"}
  ]
}





m=loke.memory.knowledgegraph;

i=str:std.string;
i=log:std.log;
i=json:std.json;

t=$entitynode{
  id:str;
  label:str;
  entitytype:str;
  properties:@str
};

t=$relation{
  id:str;
  fromid:str;
  toid:str;
  relationtype:str;
  validfrom:i64;
  validto:i64;
  source:str;
  confidence:f32
};

t=$factquery{
  subject:str;
  predicate:str;
  asof:i64
};

t=$knowledgegraph{
  nodes:@$entitynode;
  relations:@$relation
};


f=newgraph():$knowledgegraph{
  <$knowledgegraph{
    nodes:@();
    relations:@()
  }
};


f=addnode(g:$knowledgegraph;id:str;label:str;entitytype:str):$knowledgegraph{
  log.info(str.concat("kg: node + ";label));
  let node=$entitynode{
    id:id;
    label:label;
    entitytype:entitytype;
    properties:@()
  };
  <$knowledgegraph{
    nodes:g.nodes.push(node);
    relations:g.relations
  }
};


f=addrelation(g:$knowledgegraph;fromid:str;toid:str;relationtype:str;validfrom:i64;validto:i64;source:str;confidence:f32):$knowledgegraph{
  log.info(str.concat("kg: relation ";str.concat(fromid;str.concat(" -[";str.concat(relationtype;str.concat("]-> ";toid))))));
  let rel=$relation{
    id:str.concat(fromid;str.concat("-";str.concat(relationtype;str.concat("-";toid))));
    fromid:fromid;
    toid:toid;
    relationtype:relationtype;
    validfrom:validfrom;
    validto:validto;
    source:source;
    confidence:confidence
  };
  <$knowledgegraph{
    nodes:g.nodes;
    relations:g.relations.push(rel)
  }
};




f=queryfacts(g:$knowledgegraph;q:$factquery):@$relation{
  let results=@();
  g.relations.each(r{
    let subjectmatch=str.eq(r.fromid;q.subject);
    let predicatematch=str.eq(r.relationtype;q.predicate);
    let timeok=r.!(validfrom>q.asof);
    let endok=if r.validto = 0{
      true
    }{
      q.!(asof>r.validto)
    };
    if(subjectmatch && predicatematch && timeok && endok){
      let results=results.push(r)
    }
  });
  <results
};




f=detectcontradictions(g:$knowledgegraph):@str{
  let contradictions=@();
  let i=0;
  if(i < g.relations.len()){
    let ra=g.relations.get(i);
    let j=i + 1;
    if(j < g.relations.len()){
      let rb=g.relations.get(j);
      let samefrom=str.eq(ra.fromid;rb.fromid);
      let sametype=str.eq(ra.relationtype;rb.relationtype);
      let diffto=!str.eq(ra.toid;rb.toid);
      
      
      let aend=if ra.validto = 0{ 9223372036854775807 }{ ra.validto };
      let bend=if rb.validto = 0{ 9223372036854775807 }{ rb.validto };
      let overlaps=ra.validfrom < bend && rb.validfrom < aend;
      if(samefrom && sametype && diffto && overlaps){
        let msg=str.concat("Contradiction: [";str.concat(ra.fromid;str.concat("] -[";str.concat(ra.relationtype;str.concat("]-> ";str.concat(ra.toid;str.concat(" vs ";rb.toid)))))));
        let contradictions=contradictions.push(msg)
      };
      let j=j + 1
    }el{};
    let i=i + 1
  }el{};
  log.info(str.concat("kg: contradictions found: ";str.fromi32(contradictions.len())));
  <contradictions
};


f=visualisedot(g:$knowledgegraph):str{
  let out="digraph kg {
";
  g.nodes.each(n{
    let line=str.concat("  \"";str.concat(n.id;str.concat("\" [label=\"";str.concat(n.label;str.concat("\" type=\"";str.concat(n.entitytype;"\"]
"))))));
    let out=str.concat(out;line)
  });
  g.relations.each(r{
    let line=str.concat("  \"";str.concat(r.fromid;str.concat("\" -> \"";str.concat(r.toid;str.concat("\" [label=\"";str.concat(r.relationtype;"\"]
"))))));
    let out=str.concat(out;line)
  });
  <str.concat(out;"}")
};


f=nodetojson(n:$entitynode):str{
  let propsjson="[";
  let first=true;
  n.properties.each(p{
    if(first){
      let propsjson=str.concat(propsjson;str.concat("\"";str.concat(p;"\""))); let first=false
    }{
      let propsjson=str.concat(propsjson;str.concat(",\"";str.concat(p;"\"")))
    }
  });
  let propsjson=str.concat(propsjson;"]");
  <str.concat("{\"id\":\"";str.concat(n.id;str.concat("\",\"label\":\"";str.concat(n.label;str.concat("\",\"entity_type\":\"";str.concat(n.entitytype;str.concat("\",\"properties\":";str.concat(propsjson;"}"))))))))
};


f=relationtojson(r:$relation):str{
  <str.concat("{\"id\":\"";str.concat(r.id;str.concat("\",\"from_id\":\"";str.concat(r.fromid;str.concat("\",\"to_id\":\"";str.concat(r.toid;str.concat("\",\"relation_type\":\"";str.concat(r.relationtype;str.concat("\",\"valid_from\":";str.concat(str.fromi64(r.validfrom);str.concat(",\"valid_to\":";str.concat(str.fromi64(r.validto);str.concat(",\"source\":\"";str.concat(r.source;str.concat("\",\"confidence\":";str.concat(str.fromf32(r.confidence);"}"))))))))))))))))
};

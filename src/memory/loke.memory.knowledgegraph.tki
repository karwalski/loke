{
  "schema_version": "1.0",
  "module": "loke.memory.knowledgegraph",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "entitynode", "fields": [{"name": "id", "type": "str"}, {"name": "label", "type": "str"}, {"name": "entitytype", "type": "str"}, {"name": "properties", "type": "@"}]},
    {"kind": "type", "name": "relation", "fields": [{"name": "id", "type": "str"}, {"name": "fromid", "type": "str"}, {"name": "toid", "type": "str"}, {"name": "relationtype", "type": "str"}, {"name": "validfrom", "type": "i64"}, {"name": "validto", "type": "i64"}, {"name": "source", "type": "str"}, {"name": "confidence", "type": "f32"}]},
    {"kind": "type", "name": "factquery", "fields": [{"name": "subject", "type": "str"}, {"name": "predicate", "type": "str"}, {"name": "asof", "type": "i64"}]},
    {"kind": "type", "name": "knowledgegraph", "fields": [{"name": "nodes", "type": "@"}, {"name": "relations", "type": "@"}]},
    {"kind": "func", "name": "newgraph", "params": [], "return": "knowledgegraph"},
    {"kind": "func", "name": "addnode", "params": ["knowledgegraph", "str", "str", "str"], "return": "knowledgegraph"},
    {"kind": "func", "name": "addrelation", "params": ["knowledgegraph", "str", "str", "str", "i64", "i64", "str", "f32"], "return": "knowledgegraph"},
    {"kind": "func", "name": "queryfacts", "params": ["knowledgegraph", "factquery"], "return": "@"},
    {"kind": "func", "name": "detectcontradictions", "params": ["knowledgegraph"], "return": "@"},
    {"kind": "func", "name": "visualisedot", "params": ["knowledgegraph"], "return": "str"},
    {"kind": "func", "name": "nodetojson", "params": ["entitynode"], "return": "str"},
    {"kind": "func", "name": "relationtojson", "params": ["relation"], "return": "str"}
  ]
}

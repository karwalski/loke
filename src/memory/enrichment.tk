m=loke.memory.enrichment;

i=str:std.string;
i=log:std.log;
i=json:std.json;

t=$enrichmentconfig{
  enabled:bool;
  maxmemories:i32;
  tokenbudget:i32;
  relevancethreshold:f32;
  anonymiseforcloud:bool
};

t=$enrichedcontext{
  memories:@str;
  totaltokens:i32;
  searchquery:str;
  memoriesfound:i32;
  disclosure:str
};


f=defaultconfig():$enrichmentconfig{
  <$enrichmentconfig{
    enabled:true;
    maxmemories:5;
    tokenbudget:2000;
    relevancethreshold:0.75;
    anonymiseforcloud:true
  }
};



f=buildsearchquery(prompt:str):str{
  let length=str.len(prompt);
  if(!(length>100)){
    <prompt
  }el{
    <str.slice(prompt;0;100)
  }
};




f=enrich(prompt:str;cfg:$enrichmentconfig;searchfnkey:str):$enrichedcontext{
  log.info(str.concat("memory: enriching context for prompt (token_budget=";str.concat(str.fromi32(cfg.tokenbudget);")")));
  let query=buildsearchquery(prompt);
  <$enrichedcontext{
    memories:@();
    totaltokens:0;
    searchquery:query;
    memoriesfound:0;
    disclosure:"Memory enrichment: 0 memories added"
  }
};



f=formatforprompt(ctx:$enrichedcontext):str{
  if(ctx.memories.len() = 0){
    <""
  }el{
    let joined=str.join(ctx.memories;"
---
");
    <str.concat("# Relevant memories
";str.concat(joined;"

"))
  }
};


f=disclosuretext(ctx:$enrichedcontext):str{
  if(ctx.memoriesfound > 0){
    <str.concat("Added ";str.concat(str.fromi32(ctx.memoriesfound);" memories from palace"))
  }el{
    <""
  }
};


f=tojson(ctx:$enrichedcontext):str{
  let memsjson=mut."[";
  let first=mut.true;
  ctx.memories.each(m{
    if(first){
      memsjson=str.concat(memsjson;str.concat("\"";str.concat(m;"\""))); first=false
    }el{
      memsjson=str.concat(memsjson;str.concat(",\"";str.concat(m;"\"")))
    }
  });
  memsjson=str.concat(memsjson;"]");
  <str.concat("{\"memories\":";str.concat(memsjson;str.concat(",\"total_tokens\":";str.concat(str.fromi32(ctx.totaltokens);str.concat(",\"search_query\":\"";str.concat(ctx.searchquery;str.concat("\",\"memories_found\":";str.concat(str.fromi32(ctx.memoriesfound);str.concat(",\"disclosure\":\"";str.concat(ctx.disclosure;"\"}"))))))))))
};

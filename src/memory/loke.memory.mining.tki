{
  "schema_version": "1.0",
  "module": "loke.memory.mining",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "miningmode", "is_sum": true, "fields": [{"name": "$projects", "type": "i64"}, {"name": "$conversations", "type": "i64"}, {"name": "$general", "type": "i64"}]},
    {"kind": "type", "name": "miningsource", "is_sum": true, "fields": [{"name": "$claudeexport", "type": "i64"}, {"name": "$chatgptexport", "type": "i64"}, {"name": "$slackjson", "type": "i64"}, {"name": "$markdown", "type": "i64"}, {"name": "$coderepo", "type": "i64"}]},
    {"kind": "type", "name": "miningjob", "fields": [{"name": "id", "type": "str"}, {"name": "sourcepath", "type": "str"}, {"name": "sourcetype", "type": "str"}, {"name": "mode", "type": "str"}, {"name": "status", "type": "str"}, {"name": "itemsfound", "type": "i32"}, {"name": "itemsstored", "type": "i32"}, {"name": "startedat", "type": "i64"}, {"name": "completedat", "type": "i64"}, {"name": "error", "type": "str"}]},
    {"kind": "type", "name": "mineditem", "fields": [{"name": "content", "type": "str"}, {"name": "source", "type": "str"}, {"name": "ts", "type": "i64"}, {"name": "wing", "type": "str"}, {"name": "tags", "type": "@"}]},
    {"kind": "func", "name": "initjobs", "params": [], "return": "i64"},
    {"kind": "func", "name": "newjob", "params": ["str", "str", "str"], "return": "miningjob"},
    {"kind": "func", "name": "start", "params": ["miningjob"], "return": "miningjob"},
    {"kind": "func", "name": "complete", "params": ["miningjob", "i32", "i32"], "return": "miningjob"},
    {"kind": "func", "name": "fail", "params": ["miningjob", "str"], "return": "miningjob"},
    {"kind": "func", "name": "detectsourcetype", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "assignwing", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "privacyscan", "params": ["str"], "return": "bool"},
    {"kind": "func", "name": "minemarkdown", "params": ["str", "str"], "return": "@"},
    {"kind": "func", "name": "minejsonexport", "params": ["str", "str", "str"], "return": "@"},
    {"kind": "func", "name": "run", "params": ["miningjob"], "return": "miningjob"},
    {"kind": "func", "name": "jobtojson", "params": ["miningjob"], "return": "str"},
    {"kind": "func", "name": "itemtojson", "params": ["mineditem"], "return": "str"}
  ]
}

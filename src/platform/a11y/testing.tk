m=platform.a11y.testing;





m=loke.platform.a11y.testing;

i=str:std.str;
i=log:std.log;


t=$a11yviolation{
  rule:str;
  element:str;
  description:str;
  severity:str
};


t=$a11yresult{
  url:str;
  violations:@$a11yviolation;
  passed:bool;
  checkedat:i64
};







f=checkhtml(html:str;url:str):$a11yresult{
  let violations:@$a11yviolation=@();

  
  let imgpos=0;
  let htmllen=str.len(html);
  if(imgpos<htmllen){
    let found=str.indexof(html;"<img";imgpos);
    if found>=0{
      
      let tagend=found+200;
      if tagend>htmllen{
        tagend=htmllen
      }else{()};
      let tagslice=str.slice(html;found;tagend);
      let hasalt=str.indexof(tagslice;"alt=";0);
      if hasalt<0{
        let v=$a11yviolation{
          rule:"img-alt";
          element:"<img>";
          description:"Image element is missing an alt attribute";
          severity:"critical"
        };
        violations.push(v)
      }else{()};
      imgpos=found+4
    }else{
      imgpos=htmllen
    };
  }{};

  
  let inputpos=0;
  if(inputpos<htmllen){
    let found=str.indexof(html;"<input";inputpos);
    if found>=0{
      let haslabel=str.indexof(html;"<label";0);
      if haslabel<0{
        let v=$a11yviolation{
          rule:"input-label";
          element:"<input>";
          description:"Input element has no associated label element";
          severity:"serious"
        };
        violations.push(v)
      }else{()};
      inputpos=found+6
    }else{
      inputpos=htmllen
    };
  }{};

  
  let rolepos=0;
  if(rolepos<htmllen){
    let found=str.indexof(html;"role=\"\"";rolepos);
    if found>=0{
      let v=$a11yviolation{
        rule:"role-value";
        element:"[role]";
        description:"role attribute has an empty value";
        severity:"moderate"
      };
      violations.push(v);
      rolepos=found+7
    }else{
      rolepos=htmllen
    };
  }{};

  let passed=violations.len()==0;
  <$a11yresult{
    url:url;
    violations:violations;
    passed:passed;
    checkedat:0
  };
};


f=violationtojson(v:$a11yviolation):str{
  let out="{";
  out=str.concat(out;"\"rule\":\"");
  out=str.concat(out;v.rule);
  out=str.concat(out;"\",\"element\":\"");
  out=str.concat(out;v.element);
  out=str.concat(out;"\",\"description\":\"");
  out=str.concat(out;v.description);
  out=str.concat(out;"\",\"severity\":\"");
  out=str.concat(out;v.severity);
  out=str.concat(out;"\"}");
  <out
};


f=resulttojson(r:$a11yresult):str{
  let vlist="[";
  let count=r.violations.len();
  let i=0;
  if(i<count){
    if i>0{
      vlist=str.concat(vlist;",")
    }else{()};
    vlist=str.concat(vlist;violationtojson(r.violations.get(i)));
    i=i+1
  }{};
  vlist=str.concat(vlist;"]");

  let passedstr="false";
  if r.passed{
    passedstr="true"
  }else{()};

  let out="{";
  out=str.concat(out;"\"url\":\"");
  out=str.concat(out;r.url);
  out=str.concat(out;"\",\"violations\":");
  out=str.concat(out;vlist);
  out=str.concat(out;",\"passed\":");
  out=str.concat(out;passedstr);
  out=str.concat(out;"}");
  <out
};



f=assertnoviolations(result:$a11yresult):bool{
  <result.violations.len()==0
};

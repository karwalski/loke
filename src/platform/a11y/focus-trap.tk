");
  js=str.concat(js;"      activate:activate,
");
  js=str.concat(js;"      deactivate:deactivate,
");
  js=str.concat(js;"      isActive:function(){ return active; }
");
  js=str.concat(js;"    };
");
  js=str.concat(js;"  };
");
  js=str.concat(js;"})();
");

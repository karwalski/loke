");
  js=str.concat(js;"      return e.offsetParent!=null;
");
  js=str.concat(js;"    });
");
  js=str.concat(js;"  }

");

  js=str.concat(js;"  window.loke_create_focus_trap=function(opts){
");
  js=str.concat(js;"    var container=opts.container;
");
  js=str.concat(js;"    var initialFocus=opts.initialFocus||'first';
");
  js=str.concat(js;"    var escapeDeactivates=opts.escapeDeactivates!=false;
");
  js=str.concat(js;"    var onDeactivate=opts.onDeactivate||null;
");
  js=str.concat(js;"    var active=false;
");
  js=str.concat(js;"    var savedFocus=null;
");
  js=str.concat(js;"    var keyHandler=null;
");
  js=str.concat(js;"    var inertElements=@();

");

  js=str.concat(js;"    function activate(){
");
  js=str.concat(js;"      if(active) return;
");
  js=str.concat(js;"      active=true;
");
  js=str.concat(js;"      savedFocus=document.activeElement;
");
  js=str.concat(js;"      var el=container;
");
  js=str.concat(js;"      while(el&&el!=document.body){
");
  js=str.concat(js;"        var parent=el.parentElement;
");
  js=str.concat(js;"        if(parent){
");
  js=str.concat(js;"          Array.from(parent.children).forEach(function(sibling){
");
  js=str.concat(js;"            if(sibling!=el&&!sibling.hasAttribute('aria-live')){
");
  js=str.concat(js;"              sibling.setAttribute('aria-hidden','true');
");
  js=str.concat(js;"              sibling.setAttribute('inert','');
");
  js=str.concat(js;"              inertElements.push(sibling);
");
  js=str.concat(js;"            }
");
  js=str.concat(js;"          });
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        el=parent;
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"      var items=getFocusable(container);
");
  js=str.concat(js;"      if(initialFocus='container'){
");
  js=str.concat(js;"        if(!container.getAttribute('tabindex')) container.setAttribute('tabindex','-1');
");
  js=str.concat(js;"        container.focus();
");
  js=str.concat(js;"      } else if(initialFocus='first'){
");
  js=str.concat(js;"        if(items.length) items[0].focus();
");
  js=str.concat(js;"      }el{
");
  js=str.concat(js;"        initialFocus.focus();
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"      keyHandler=function(e){
");
  js=str.concat(js;"        if(e.key='Escape'&&escapeDeactivates){
");
  js=str.concat(js;"          e.preventDefault();
");
  js=str.concat(js;"          deactivate();
");
  js=str.concat(js;"          return;
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        if(e.key!='Tab') return;
");
  js=str.concat(js;"        var items=getFocusable(container);
");
  js=str.concat(js;"        if(!items.length) return;
");
  js=str.concat(js;"        var first=items[0]; var last=items[items.length-1];
");
  js=str.concat(js;"        if(e.shiftKey){
");
  js=str.concat(js;"          if(document.activeElement=first){ e.preventDefault(); last.focus(); }
");
  js=str.concat(js;"        }el{
");
  js=str.concat(js;"          if(document.activeElement=last){ e.preventDefault(); first.focus(); }
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"      };
");
  js=str.concat(js;"      document.addEventListener('keydown',keyHandler);
");
  js=str.concat(js;"    }

");


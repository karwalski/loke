");
  js=str.concat(js;"      });
");
  js=str.concat(js;"      inertElements=@();
");
  js=str.concat(js;"      if(savedFocus&&savedFocus.focus){
");
  js=str.concat(js;"        savedFocus.focus();
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"      savedFocus=null;
");
  js=str.concat(js;"      if(onDeactivate) onDeactivate();
");
  js=str.concat(js;"    }

");


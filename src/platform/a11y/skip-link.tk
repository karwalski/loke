m=loke.platform.a11y.skiplink;

i=str:std.str;

f=skiplinkhtml():$str{
  <"<a href=\"#main-content\" id=\"skip-to-main\" class=\"skip-link\">Skip to main content</a>"
};

f=skiplinkcss():$str{
  let css=mut.".skip-link {
";
  css=str.concat(css;"  position: absolute;
");
  css=str.concat(css;"  top: -100%;
");
  css=str.concat(css;"  left: 0;
");
  css=str.concat(css;"  z-index: var(--z-skip-link, 10000);
");
  css=str.concat(css;"  padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
");
  css=str.concat(css;"  background: var(--colour-surface, #ffffff);
");
  css=str.concat(css;"  color: var(--colour-text, #000000);
");
  css=str.concat(css;"  text-decoration: underline;
");
  css=str.concat(css;"  font-size: 1rem;
");
  css=str.concat(css;"  line-height: 1.5;
");
  css=str.concat(css;"}

");
  css=str.concat(css;".skip-link:focus {
");
  css=str.concat(css;"  top: 0;
");
  css=str.concat(css;"}
");
  <css
};

f=skiplinkjs():$str{
  let js=mut."(function(){
";
  js=str.concat(js;"  document.addEventListener('DOMContentLoaded',function(){
");
  js=str.concat(js;"    var skip=document.getElementById('skip-to-main');
");
  js=str.concat(js;"    if(!skip) return;
");
  js=str.concat(js;"    skip.addEventListener('click',function(e){
");
  js=str.concat(js;"      e.preventDefault();
");
  js=str.concat(js;"      var main=document.getElementById('main-content');
");
  js=str.concat(js;"      if(main){
");
  js=str.concat(js;"        if(!main.getAttribute('tabindex')){
");
  js=str.concat(js;"          main.setAttribute('tabindex','-1');
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        main.focus();
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    });
");
  js=str.concat(js;"  });
");
  js=str.concat(js;"})();
");
  <js
};

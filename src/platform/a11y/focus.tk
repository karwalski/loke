m=platform.a11y.focus;






m=loke.platform.a11y.focus;

i=str:std.str;








f=focusjs():str{
  let js="(function(){
";
  js=str.concat(js;"  var _saved=null;
");
  js=str.concat(js;"  var _trapEl=null;
");
  js=str.concat(js;"  var _trapHandler=null;
");

  
  js=str.concat(js;"  var FOCUSABLE='a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex=\"-1\"])';
");

  
  js=str.concat(js;"  window.loke_focus_trap=function(el){
");
  js=str.concat(js;"    _trapEl=el;
");
  js=str.concat(js;"    var items=Array.from(el.querySelectorAll(FOCUSABLE));
");
  js=str.concat(js;"    if(items.length){ items[0].focus(); }
");
  js=str.concat(js;"    _trapHandler=function(e){
");
  js=str.concat(js;"      if(e.key!=='Tab') return;
");
  js=str.concat(js;"      items=Array.from(_trapEl.querySelectorAll(FOCUSABLE));
");
  js=str.concat(js;"      var first=items[0]; var last=items[items.length-1];
");
  js=str.concat(js;"      if(e.shiftKey){
");
  js=str.concat(js;"        if(document.activeElement===first){ e.preventDefault(); last.focus(); }
");
  js=str.concat(js;"      } else {
");
  js=str.concat(js;"        if(document.activeElement===last){ e.preventDefault(); first.focus(); }
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    };
");
  js=str.concat(js;"    document.addEventListener('keydown',_trapHandler);
");
  js=str.concat(js;"  };
");

  
  js=str.concat(js;"  window.loke_focus_release=function(){
");
  js=str.concat(js;"    if(_trapHandler){ document.removeEventListener('keydown',_trapHandler); }
");
  js=str.concat(js;"    _trapEl=null; _trapHandler=null;
");
  js=str.concat(js;"  };
");

  
  js=str.concat(js;"  window.loke_save_focus=function(){ _saved=document.activeElement; };
");
  js=str.concat(js;"  window.loke_restore_focus=function(){ if(_saved&&_saved.focus){ _saved.focus(); _saved=null; } };
");

  
  js=str.concat(js;"  window.loke_route_focus=function(){
");
  js=str.concat(js;"    var h1=document.querySelector('h1');
");
  js=str.concat(js;"    var main=document.getElementById('main-content');
");
  js=str.concat(js;"    var target=h1||main;
");
  js=str.concat(js;"    if(target){
");
  js=str.concat(js;"      if(!target.getAttribute('tabindex')){ target.setAttribute('tabindex','-1'); }
");
  js=str.concat(js;"      target.focus();
");
  js=str.concat(js;"    }
");
  js=str.concat(js;"  };
");

  
  js=str.concat(js;"  document.addEventListener('DOMContentLoaded',function(){
");
  js=str.concat(js;"    var skip=document.getElementById('skip-to-main');
");
  js=str.concat(js;"    if(skip){
");
  js=str.concat(js;"      skip.addEventListener('click',function(e){
");
  js=str.concat(js;"        e.preventDefault();
");
  js=str.concat(js;"        var main=document.getElementById('main-content');
");
  js=str.concat(js;"        if(main){
");
  js=str.concat(js;"          if(!main.getAttribute('tabindex')){ main.setAttribute('tabindex','-1'); }
");
  js=str.concat(js;"          main.focus();
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"      });
");
  js=str.concat(js;"    }
");
  js=str.concat(js;"  });
");

  js=str.concat(js;"})();
");
  <js
};




f=skiplinkhtml():str{
  <"<a href=\"#main-content\" class=\"skip-link\">Skip to main content</a>"
};

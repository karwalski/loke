m=loke.platform.a11y.colour;

i=str:std.str;
i=log:std.log;




f=motioncss():str{
  let out=mut."@media (prefers-reduced-motion: reduce) {
";
  out=str.concat(out;"  *, *::before, *::after {
");
  out=str.concat(out;"    animation-duration: 0.01ms !important;
");
  out=str.concat(out;"    animation-iteration-count: 1 !important;
");
  out=str.concat(out;"    transition-duration: 0.01ms !important;
");
  out=str.concat(out;"  }
");
  out=str.concat(out;"}
");
  <out
};





f=focusvisiblecss():str{
  let out=mut.":focus-visible { outline: 2px solid var(--accent, #14b8a6); outline-offset: 2px; }
";
  out=str.concat(out;":focus:not(:focus-visible) { outline: none; }
");
  <out
};





f=checkcontrastratio(fghex:str;bghex:str):f32{
  log.info("a11y: contrast check (stub)");
  <4.5 as f32
};


m=loke.platform.a11y.ariapatterns;

i=str:std.str;

f=dialogattrs(labelid:$str):$str{
  let out=mut."role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"";
  out=str.concat(out;labelid);
  out=str.concat(out;"\"");
  <out
};

f=alertdialogattrs(labelid:$str;descid:$str):$str{
  let out=mut."role=\"alertdialog\" aria-modal=\"true\" aria-labelledby=\"";
  out=str.concat(out;labelid);
  out=str.concat(out;"\" aria-describedby=\"");
  out=str.concat(out;descid);
  out=str.concat(out;"\"");
  <out
};

f=tabattrs(selected:bool):$str{
  if(selected){
    <"role=\"tab\" aria-selected=\"true\" tabindex=\"0\""
  }el{
    <"role=\"tab\" aria-selected=\"false\" tabindex=\"-1\""
  };
};

f=tabpanelattrs(labelledby:$str):$str{
  let out=mut."role=\"tabpanel\" aria-labelledby=\"";
  out=str.concat(out;labelledby);
  out=str.concat(out;"\"");
  <out
};

f=tablistattrs():$str{
  <"role=\"tablist\""
};

f=menuattrs():$str{
  <"role=\"menu\""
};

f=menuitemattrs():$str{
  <"role=\"menuitem\""
};

f=toolbarattrs(label:$str):$str{
  let out=mut."role=\"toolbar\" aria-label=\"";
  out=str.concat(out;label);
  out=str.concat(out;"\"");
  <out
};

f=switchattrs(checked:bool):$str{
  if(checked){
    <"role=\"switch\" aria-checked=\"true\""
  }el{
    <"role=\"switch\" aria-checked=\"false\""
  };
};

f=tooltipattrs():$str{
  <"role=\"tooltip\""
};

f=statusattrs():$str{
  <"role=\"status\""
};

f=progressbarattrs(valuenow:$str;valuemin:$str;valuemax:$str;label:$str):$str{
  let out=mut."role=\"progressbar\" aria-valuenow=\"";
  out=str.concat(out;valuenow);
  out=str.concat(out;"\" aria-valuemin=\"");
  out=str.concat(out;valuemin);
  out=str.concat(out;"\" aria-valuemax=\"");
  out=str.concat(out;valuemax);
  out=str.concat(out;"\" aria-label=\"");
  out=str.concat(out;label);
  out=str.concat(out;"\"");
  <out
};

f=comboboxattrs(expanded:bool):$str{
  if(expanded){
    <"role=\"combobox\" aria-expanded=\"true\" aria-autocomplete=\"list\" aria-haspopup=\"listbox\""
  }el{
    <"role=\"combobox\" aria-expanded=\"false\" aria-autocomplete=\"list\" aria-haspopup=\"listbox\""
  };
};

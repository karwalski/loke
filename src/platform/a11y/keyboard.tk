m=platform.a11y.keyboard;





m=loke.platform.a11y.keyboard;

i=str:std.str;
i=log:std.log;









f=keyboardjs():str{
  let js="(function(){
";
  js=str.concat(js;"  console.log('a11y: keyboard navigation active');
");

  
  js=str.concat(js;"  document.addEventListener('keydown', function(e){
");
  js=str.concat(js;"    if(e.key==='Escape'){
");
  js=str.concat(js;"      var overlays=document.querySelectorAll('.overlay.open');
");
  js=str.concat(js;"      for(var i=0;i<overlays.length;i++){ overlays[i].classList.remove('open'); }
");
  js=str.concat(js;"    }
");

  
  js=str.concat(js;"    var composites=['[role=\"listbox\"]','[role=\"menu\"]'];
");
  js=str.concat(js;"    for(var c=0;c<composites.length;c++){
");
  js=str.concat(js;"      var widget=e.target.closest(composites[c]);
");
  js=str.concat(js;"      if(widget){
");
  js=str.concat(js;"        var items=Array.from(widget.querySelectorAll('[role=\"option\"],[role=\"menuitem\"]'));
");
  js=str.concat(js;"        var idx=items.indexOf(document.activeElement);
");
  js=str.concat(js;"        if(e.key==='ArrowDown'||e.key==='ArrowRight'){
");
  js=str.concat(js;"          e.preventDefault();
");
  js=str.concat(js;"          if(idx<items.length-1){ items[idx+1].focus(); }
");
  js=str.concat(js;"        } else if(e.key==='ArrowUp'||e.key==='ArrowLeft'){
");
  js=str.concat(js;"          e.preventDefault();
");
  js=str.concat(js;"          if(idx>0){ items[idx-1].focus(); }
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    }
");
  js=str.concat(js;"  });
");

  
  js=str.concat(js;"  document.addEventListener('DOMContentLoaded', function(){
");
  js=str.concat(js;"    var links=document.querySelectorAll('a[href]');
");
  js=str.concat(js;"    for(var i=0;i<links.length;i++){
");
  js=str.concat(js;"      if(!links[i].textContent.trim()&&!links[i].getAttribute('aria-label')){
");
  js=str.concat(js;"        links[i].setAttribute('aria-label',links[i].getAttribute('href'));
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    }
");
  js=str.concat(js;"  });
");

  js=str.concat(js;"})();
");
  <js
};

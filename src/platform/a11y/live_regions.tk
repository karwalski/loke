m=loke.platform.a11y.liveregions;

i=str:std.str;




f=liveregionhtml():str{
  let out=mut."<div id=\"aria-live-polite\" aria-live=\"polite\" aria-atomic=\"true\" class=\"sr-only\"></div>";
  out=str.concat(out;"<div id=\"aria-live-assertive\" aria-live=\"assertive\" aria-atomic=\"true\" class=\"sr-only\"></div>");
  <out
};






f=announcejs():str{
  let js=mut."window.loke_announce = function(msg, priority) {
";
  js=str.concat(js;"  var el = document.getElementById('aria-live-' + (priority||'polite'));
");
  js=str.concat(js;"  if(el){
");
  js=str.concat(js;"    el.textContent='';
");
  js=str.concat(js;"    setTimeout(function(){ el.textContent=msg; }, 50);
");
  js=str.concat(js;"  }
");
  js=str.concat(js;"};
");
  <js
};




f=sronlycss():str{
  <".sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }"
};

m=loke.platform.a11y.rovingtabindex;

i=str:std.str;

f=rovingtabindexjs():$str{
  let js=mut."(function(){
";

  js=str.concat(js;"  window.loke_roving_tabindex=function(opts){
");
  js=str.concat(js;"    var container=opts.container;
");
  js=str.concat(js;"    var selector=opts.selector;
");
  js=str.concat(js;"    var orientation=opts.orientation||'both';
");
  js=str.concat(js;"    var wrap=opts.wrap!=false;
");
  js=str.concat(js;"    var onFocus=opts.onFocus||null;
");
  js=str.concat(js;"    var currentIdx=0;
");
  js=str.concat(js;"    var handler=null;

");

  js=str.concat(js;"    function getItems(){
");
  js=str.concat(js;"      return Array.from(container.querySelectorAll(selector));
");
  js=str.concat(js;"    }

");

  js=str.concat(js;"    function focusItem(idx){
");
  js=str.concat(js;"      var items=getItems();
");
  js=str.concat(js;"      if(!items.length) return;
");
  js=str.concat(js;"      if(idx<0) idx=0;
");
  js=str.concat(js;"      if(idx>=items.length) idx=items.length-1;
");
  js=str.concat(js;"      items[currentIdx].setAttribute('tabindex','-1');
");
  js=str.concat(js;"      items[idx].setAttribute('tabindex','0');
");
  js=str.concat(js;"      items[idx].focus();
");
  js=str.concat(js;"      currentIdx=idx;
");
  js=str.concat(js;"      if(onFocus) onFocus(items[idx],idx);
");
  js=str.concat(js;"    }

");

  js=str.concat(js;"    function handleNext(items){
");
  js=str.concat(js;"      if(currentIdx<items.length-1){
");
  js=str.concat(js;"        focusItem(currentIdx+1);
");
  js=str.concat(js;"      } else if(wrap){
");
  js=str.concat(js;"        focusItem(0);
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    }

");

  js=str.concat(js;"    function handlePrev(items){
");
  js=str.concat(js;"      if(currentIdx>0){
");
  js=str.concat(js;"        focusItem(currentIdx-1);
");
  js=str.concat(js;"      } else if(wrap){
");
  js=str.concat(js;"        focusItem(items.length-1);
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    }

");

  js=str.concat(js;"    function init(){
");
  js=str.concat(js;"      var items=getItems();
");
  js=str.concat(js;"      items.forEach(function(item,i){
");
  js=str.concat(js;"        item.setAttribute('tabindex',i=0?'0':'-1');
");
  js=str.concat(js;"      });
");
  js=str.concat(js;"      currentIdx=0;

");

  js=str.concat(js;"      handler=function(e){
");
  js=str.concat(js;"        var items=getItems();
");
  js=str.concat(js;"        if(!items.length) return;
");
  js=str.concat(js;"        var isNext=false; var isPrev=false;
");
  js=str.concat(js;"        if(orientation='horizontal'||orientation='both'){
");
  js=str.concat(js;"          if(e.key='ArrowRight') isNext=true;
");
  js=str.concat(js;"          if(e.key='ArrowLeft') isPrev=true;
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        if(orientation='vertical'||orientation='both'){
");
  js=str.concat(js;"          if(e.key='ArrowDown') isNext=true;
");
  js=str.concat(js;"          if(e.key='ArrowUp') isPrev=true;
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        if(e.key='Home'){
");
  js=str.concat(js;"          e.preventDefault();
");
  js=str.concat(js;"          focusItem(0);
");
  js=str.concat(js;"          return;
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        if(e.key='End'){
");
  js=str.concat(js;"          e.preventDefault();
");
  js=str.concat(js;"          focusItem(items.length-1);
");
  js=str.concat(js;"          return;
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        if(isNext){ e.preventDefault(); handleNext(items); }
");
  js=str.concat(js;"        if(isPrev){ e.preventDefault(); handlePrev(items); }
");
  js=str.concat(js;"      };
");
  js=str.concat(js;"      container.addEventListener('keydown',handler);
");
  js=str.concat(js;"    }

");

  js=str.concat(js;"    function destroy(){
");
  js=str.concat(js;"      if(handler) container.removeEventListener('keydown',handler);
");
  js=str.concat(js;"      handler=null;
");
  js=str.concat(js;"    }

");

  js=str.concat(js;"    return {
");
  js=str.concat(js;"      init:init,
");
  js=str.concat(js;"      destroy:destroy,
");
  js=str.concat(js;"      focusItem:focusItem,
");
  js=str.concat(js;"      currentIndex:function(){ return currentIdx; }
");
  js=str.concat(js;"    };
");
  js=str.concat(js;"  };
");
  js=str.concat(js;"})();
");
  <js
};

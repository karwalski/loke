m=loke.platform.a11y.announcements;

i=str:std.str;

f=announcementsjs():$str{
  let js=mut."(function(){
";

  js=str.concat(js;"  var _lastStreamAnnounce=0;
");
  js=str.concat(js;"  var STREAM_THROTTLE_MS=5000;

");

  js=str.concat(js;"  var _toastTimes=@();
");
  js=str.concat(js;"  var _toastBatchTimer=null;
");
  js=str.concat(js;"  var _toastBatchCount=0;
");
  js=str.concat(js;"  var TOAST_BATCH_WINDOW_MS=2000;
");
  js=str.concat(js;"  var TOAST_BATCH_THRESHOLD=3;

");

  js=str.concat(js;"  window.loke_announce_stage=function(stage, status){
");
  js=str.concat(js;"    if(!window.loke_announce) return;
");
  js=str.concat(js;"    var msg=stage+' '+status;
");
  js=str.concat(js;"    window.loke_announce(msg,'polite');
");
  js=str.concat(js;"  };

");

  js=str.concat(js;"  window.loke_announce_violation=function(violation){
");
  js=str.concat(js;"    if(!window.loke_announce) return;
");
  js=str.concat(js;"    window.loke_announce('Warning: '+violation,'assertive');
");
  js=str.concat(js;"  };

");

  js=str.concat(js;"  window.loke_announce_toast=function(message, variant){
");
  js=str.concat(js;"    if(!window.loke_announce) return;
");
  js=str.concat(js;"    var now=Date.now();
");
  js=str.concat(js;"    _toastTimes=_toastTimes.filter(function(t){ return now-t<TOAST_BATCH_WINDOW_MS; });
");
  js=str.concat(js;"    _toastTimes.push(now);

");
  js=str.concat(js;"    if(_toastTimes.length>TOAST_BATCH_THRESHOLD){
");
  js=str.concat(js;"      _toastBatchCount++;
");
  js=str.concat(js;"      if(_toastBatchTimer) clearTimeout(_toastBatchTimer);
");
  js=str.concat(js;"      _toastBatchTimer=setTimeout(function(){
");
  js=str.concat(js;"        window.loke_announce(_toastBatchCount+' new notifications.','polite');
");
  js=str.concat(js;"        _toastBatchCount=0;
");
  js=str.concat(js;"        _toastBatchTimer=null;
");
  js=str.concat(js;"      },500);
");
  js=str.concat(js;"      return;
");
  js=str.concat(js;"    }

");
  js=str.concat(js;"    var priority=(variant='error'||variant='warning')?'assertive':'polite';
");
  js=str.concat(js;"    var prefix=variant?variant.charAt(0).toUpperCase()+variant.slice(1)+': ':'';
");
  js=str.concat(js;"    window.loke_announce(prefix+message,priority);
");
  js=str.concat(js;"  };

");

  js=str.concat(js;"  window.loke_announce_streaming=function(message){
");
  js=str.concat(js;"    if(!window.loke_announce) return;
");
  js=str.concat(js;"    var now=Date.now();
");
  js=str.concat(js;"    if(now-_lastStreamAnnounce<STREAM_THROTTLE_MS) return;
");
  js=str.concat(js;"    _lastStreamAnnounce=now;
");
  js=str.concat(js;"    window.loke_announce(message,'polite');
");
  js=str.concat(js;"  };

");

  js=str.concat(js;"})();
");
  <js
};

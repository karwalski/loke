{
  "schema_version": "1.0",
  "module": "loke.platform.http.middleware",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "middlewareentry", "fields": [{"name": "id", "type": "str"}, {"name": "slot", "type": "str"}, {"name": "handlerkey", "type": "str"}]},
    {"kind": "type", "name": "middlewarechain", "fields": [{"name": "entries", "type": "@"}]},
    {"kind": "func", "name": "newchain", "params": [], "return": "middlewarechain"},
    {"kind": "func", "name": "register", "params": ["middlewarechain", "str", "str", "str"], "return": "void"},
    {"kind": "func", "name": "runbeforeauth", "params": ["middlewarechain", "i64"], "return": "i64"},
    {"kind": "func", "name": "runafterauth", "params": ["middlewarechain", "i64"], "return": "i64"}
  ]
}

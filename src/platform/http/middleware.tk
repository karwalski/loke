m=loke.platform.http.middleware;

i=http:std.http;
i=str:std.str;

t=$middlewareentry{
  id:str;
  slot:str;
  handlerkey:str
};

t=$middlewarechain{
  entries:@$middlewareentry
};


f=newchain():$middlewarechain{
  <$middlewarechain{
    entries:@()
  }
};




f=register(chain:$middlewarechain;id:str;slot:str;handlerkey:str):void{
  let entry=$middlewareentry{
    id:id;
    slot:slot;
    handlerkey:handlerkey
  };
  chain.entries=chain.entries.push(entry)
};




f=runbeforeauth(chain:$middlewarechain;req:i64):i64{
  <req
};




f=runafterauth(chain:$middlewarechain;req:i64):i64{
  <req
};

m=loke.platform.http.server;

i=log:shared.log;
i=str:std.str;

t=$serverconfig{
  host:str;
  port:i32;
  tls:bool;
  staticdir:str;
  spafallback:bool
};

t=$middlewareslot{
  $beforeauth:i64;
  $afterauth:i64};


f=newconfig():$serverconfig{
  <$serverconfig{
    host:"localhost";
    port:11430;
    tls:false;
    staticdir:"client";
    spafallback:true
  }
};


f=start(cfg:$serverconfig):void{
  let proto=mut."http";
  if(cfg.tls){
    proto="https"
  }el{};
  let portstr=str.fromi32(cfg.port);
  let addr=str.concat(proto;str.concat("://";str.concat(cfg.host;str.concat(":";portstr))));
  log.info(str.concat("server listening on ";addr);"platform.http.server";"system")
};


f=stop():void{
  log.info("server shut down";"platform.http.server";"system")
};

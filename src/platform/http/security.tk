m=loke.platform.http.security;

i=str:std.str;

t=$securityconfig{
  csp:str;
  hsts:bool;
  ratelimitpermin:i32
};





f=defaultconfig():$securityconfig{
  let csp=str.concat(
    "default-src 'self'; ";
    str.concat("script-src 'self'; ";
    str.concat("style-src 'self' 'unsafe-inline'; ";
    str.concat("img-src 'self' data:; ";
    str.concat("font-src 'self'; ";
    str.concat("connect-src 'self'; ";
    str.concat("frame-ancestors 'none'; ";
    str.concat("base-uri 'self'; ";
    "form-action 'self'"))))))));
  <$securityconfig{
    csp:csp;
    hsts:false;
    ratelimitpermin:100
  }
};




f=securityheaders(cfg:$securityconfig):str{
  let cspline=str.concat("Content-Security-Policy: ";cfg.csp);
  let xctoline="X-Content-Type-Options: nosniff";
  let xfoline="X-Frame-Options: DENY";
  let rpline="Referrer-Policy: strict-origin-when-cross-origin";
  let ppline="Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()";
  let out=str.concat(cspline;
    str.concat("
";
    str.concat(xctoline;
    str.concat("
";
    str.concat(xfoline;
    str.concat("
";
    str.concat(rpline;
    str.concat("
";
    ppline))))))));
  <out
};




f=checkratelimit(clientid:str;config:$securityconfig):bool{
  <true
};

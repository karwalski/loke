



m=loke.platform.http.router;

i=str:std.str;

t=$route{
  method:str;
  path:str;
  namespace:str;
  handlerkey:str
};

t=$routeregistry{
  entries:@$route
};


f=newregistry():$routeregistry{
  <$routeregistry{
    entries:@()
  }
};




f=register(reg:$routeregistry;method:str;path:str;namespace:str;handlerkey:str):void{
  let route=$route{
    method:method;
    path:path;
    namespace:namespace;
    handlerkey:handlerkey
  };
  reg.entries=@(reg.entries;route)
};




f=find(reg:$routeregistry;method:str;path:str):($route){
  let count=reg.entries.len();
  let i=0;
  
  if(i<count){
    let route=reg.entries.get(i);
    if(str.eq(route.method;method)){
      let fullpath=str.concat("/api/v1/";str.concat(route.namespace;route.path));
      if(str.eq(fullpath;path)){
        <some(route)
      }el{}
    }el{};
    i=i+1;
  }el{};
  
  let j=0;
  if(j<count){
    let route=reg.entries.get(j);
    if(str.eq(route.method;method)){
      let fullpath=str.concat("/api/v1/";str.concat(route.namespace;route.path));
      let prefixlen=str.len(fullpath);
      let pathlen=str.len(path);
      if(!(prefixlen>pathlen)){
        
        let prefix=str.slice(path;0;prefixlen);
        if(str.eq(prefix;fullpath)){
          <some(route)
        }el{}
      }el{}
    }el{};
    j=j+1
  }el{};
  <none
};


f=listroutes(reg:$routeregistry):@$route{
  <reg.entries
};

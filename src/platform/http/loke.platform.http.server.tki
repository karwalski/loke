{
  "schema_version": "1.0",
  "module": "loke.platform.http.server",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "serverconfig", "fields": [{"name": "host", "type": "str"}, {"name": "port", "type": "i32"}, {"name": "tls", "type": "bool"}, {"name": "staticdir", "type": "str"}, {"name": "spafallback", "type": "bool"}]},
    {"kind": "type", "name": "middlewareslot", "is_sum": true, "fields": [{"name": "$beforeauth", "type": "i64"}, {"name": "$afterauth", "type": "i64"}]},
    {"kind": "func", "name": "newconfig", "params": [], "return": "serverconfig"},
    {"kind": "func", "name": "start", "params": ["serverconfig"], "return": "void"},
    {"kind": "func", "name": "stop", "params": [], "return": "void"}
  ]
}

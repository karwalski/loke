m=loke.platform.http.response;

i=str:std.str;
i=json:std.json;

t=$envelope{
  ok:bool;
  data:str;
  error:str;
  requestid:str
};






f=success(data:str;requestid:str):str{
  let out=str.concat("{\"data\":";
    str.concat(data;
    str.concat(",\"requestId\":";
    str.concat(json.encstr(requestid);
    "}"))));
  <out
};







f=errorresp(code:str;message:str;requestid:str):str{
  let inner=str.concat("\"code\":";
    str.concat(json.encstr(code);
    str.concat(",\"message\":";
    str.concat(json.encstr(message);
    str.concat(",\"requestId\":";
    str.concat(json.encstr(requestid);
    "}"))))));
  let out=str.concat("{\"error\":{";str.concat(inner;"}"));
  <out
};









f=paginated(data:str;total:i32;page:i32;perpage:i32;requestid:str):str{
  let totalstr=str.fromi32(total);
  let pagestr=str.fromi32(page);
  let perpagestr=str.fromi32(perpage);
  let offset=perpage*(page-1);
  let hasmore=offset+perpage<total;
  let hasmorestr="false";
  if(hasmore){
    let hasmorestr="true"
  }el{};
  let pagination=str.concat("\"total\":";
    str.concat(totalstr;
    str.concat(",\"page\":";
    str.concat(pagestr;
    str.concat(",\"perPage\":";
    str.concat(perpagestr;
    str.concat(",\"hasMore\":";
    str.concat(hasmorestr;
    "}"))))))));
  let out=str.concat("{\"data\":";
    str.concat(data;
    str.concat(",\"pagination\":{";
    str.concat(pagination;
    str.concat(",\"requestId\":";
    str.concat(json.encstr(requestid);
    "}"))))));
  <out
};

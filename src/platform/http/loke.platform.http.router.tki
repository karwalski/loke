{
  "schema_version": "1.0",
  "module": "loke.platform.http.router",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "route", "fields": [{"name": "method", "type": "str"}, {"name": "path", "type": "str"}, {"name": "namespace", "type": "str"}, {"name": "handlerkey", "type": "str"}]},
    {"kind": "type", "name": "routeregistry", "fields": [{"name": "entries", "type": "@"}]},
    {"kind": "func", "name": "newregistry", "params": [], "return": "routeregistry"},
    {"kind": "func", "name": "register", "params": ["routeregistry", "str", "str", "str", "str"], "return": "void"},
    {"kind": "func", "name": "find", "params": ["routeregistry", "str", "str"], "return": "route"},
    {"kind": "func", "name": "listroutes", "params": ["routeregistry"], "return": "@"}
  ]
}

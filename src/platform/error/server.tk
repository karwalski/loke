m=loke.platform.error.server;

i=log:shared.log;
i=str:std.str;
i=json:std.json;

t=$servererror{
  code:str;
  message:str;
  requestid:str;
  internal:str
};


f=newerror(code:str;message:str;requestid:str):$servererror{
  <$servererror{
    code:code;
    message:message;
    requestid:requestid;
    internal:""
  }
};


f=tojson(e:$servererror):str{
  let inner=str.concat("\"code\":";
    str.concat(json.encstr(e.code);
    str.concat(",\"message\":";
    str.concat(json.encstr(e.message);
    str.concat(",\"requestId\":";
    str.concat(json.encstr(e.requestid);
    "}"))))));
  let out=str.concat("{\"error\":{";str.concat(inner;"}"));
  <out
};


f=logerror(e:$servererror;internal:str):void{
  let msg=str.concat("error code=";
    str.concat(e.code;
    str.concat(" request_id=";
    str.concat(e.requestid;
    str.concat(" message=";
    str.concat(e.message;
    str.concat(" internal=";
    internal)))))));
  log.error(msg;"platform.error.server";e.requestid)
};




m=loke.platform.error.apiclient;

i=str:std.str;
i=json:std.json;

t=$apierror{
  status:i32;
  code:str;
  message:str;
  retryable:bool
};

t=$retryconfig{
  maxattempts:i32;
  basedelayms:i32
};


f=defaultretry():$retryconfig{
  <$retryconfig{
    maxattempts:3;
    basedelayms:500
  };
};




f=isretryable(status:i32):bool{
  if status==429{
    <true
  }else{
    if status==500{
      <true
    }else{
      if status==502{
        <true
      }else{
        if status==503{
          <true
        }else{
          if status==504{
            <true
          }else{
            <false
          };
        };
      };
    };
  };
};




f=classify(status:i32;body:str):$apierror{
  let retryable=isretryable(status);
  let code=json.getstr(body;mt "error.code") {
    $ok:v v;
    $err: str.concat("HTTP_";str.fromi32(status))
  };
  let message=json.getstr(body;mt "error.message") {
    $ok:v v;
    $err: str.concat("Request failed with status ";str.fromi32(status))
  };
  <$apierror{
    status:status;
    code:code;
    message:message;
    retryable:retryable
  };
};

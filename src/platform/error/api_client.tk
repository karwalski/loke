


m=loke.platform.error.apiclient;

i=str:std.str;
i=json:std.json;

t=$apierror{
  status:i32;
  code:str;
  message:str;
  retryable:bool
};

t=$retryconfig{
  maxattempts:i32;
  basedelayms:i32
};


f=defaultretry():$retryconfig{
  <$retryconfig{
    maxattempts:3;
    basedelayms:500
  }
};




f=isretryable(status:i32):bool{
  if(status=(429 as i32)){
    <true
  }el{
    if(status=(500 as i32)){
      <true
    }el{
      if(status=(502 as i32)){
        <true
      }el{
        if(status=(503 as i32)){
          <true
        }el{
          if(status=(504 as i32)){
            <true
          }el{
            <false
          };
        };
      };
    };
  };
};




f=classify(status:i32;body:str):$apierror{
  let retryable=isretryable(status);
  let code=mt json.getstr(body;"error.code") {
    $ok:v v;
    $err:e str.concat("HTTP_";str.fromi32(status))
  };
  let message=mt json.getstr(body;"error.message") {
    $ok:v v;
    $err:e str.concat("Request failed with status ";str.fromi32(status))
  };
  <$apierror{
    status:status;
    code:code;
    message:message;
    retryable:retryable
  }
};

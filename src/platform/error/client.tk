m=loke.platform.error.client;

i=log:shared.log;
i=str:std.str;
i=json:std.json;

t=$clienterrorreport{
  message:str;
  source:str;
  line:i32;
  col:i32;
  requestid:str;
  ts:i64
};


f=fromjson(body:str):$clienterrorreport{
  let message=mt json.getstr(body;"message") { $ok:v v; $err:e "unknown client error" };
  let source=mt json.getstr(body;"source") { $ok:v v; $err:e "unknown" };
  let line=mt json.geti32(body;"line") { $ok:v v; $err:e 0 };
  let col=mt json.geti32(body;"col") { $ok:v v; $err:e 0 };
  let requestid=mt json.getstr(body;"requestId") { $ok:v v; $err:e "" };
  let ts=mt json.geti64(body;"ts") { $ok:v v; $err:e 0 };
  <$clienterrorreport{
    message:message;
    source:source;
    line:line;
    col:col;
    requestid:requestid;
    ts:ts
  }
};


f=handle(report:$clienterrorreport):void{
  let linestr=str.fromi32(report.line);
  let colstr=str.fromi32(report.col);
  let msg=str.concat("client error source=";
    str.concat(report.source;
    str.concat(" line=";
    str.concat(linestr;
    str.concat(" col=";
    str.concat(colstr;
    str.concat(" message=";
    report.message)))))));
  let corr=mut.report.requestid;
  if(str.eq(corr;"")){
    corr="client"
  }el{};
  log.warn(msg;"platform.error.client";corr)
};

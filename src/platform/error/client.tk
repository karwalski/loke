



m=loke.platform.error.client;

i=log:shared.log;
i=str:std.str;
i=json:std.json;

t=$clienterrorreport{
  message:str;
  source:str;
  line:i32;
  col:i32;
  requestid:str;
  ts:i64
};



f=fromjson(body:str):$clienterrorreport{
  let message=json.getstr(body;mt "message") {
    $ok:v v;
    $err: "unknown client error"
  };
  let source=json.getstr(body;mt "source") {
    $ok:v v;
    $err: "unknown"
  };
  let line=json.geti32(body;mt "line") {
    $ok:v v;
    $err: 0
  };
  let col=json.geti32(body;mt "col") {
    $ok:v v;
    $err: 0
  };
  let requestid=json.getstr(body;mt "requestId") {
    $ok:v v;
    $err: ""
  };
  let ts=json.geti64(body;mt "ts") {
    $ok:v v;
    $err: 0
  };
  <$clienterrorreport{
    message:message;
    source:source;
    line:line;
    col:col;
    requestid:requestid;
    ts:ts
  };
};





f=handle(report:$clienterrorreport):void{
  let linestr=str.fromi32(report.line);
  let colstr=str.fromi32(report.col);
  let msg=str.concat("client error source=";
    str.concat(report.source;
    str.concat(" line=";
    str.concat(linestr;
    str.concat(" col=";
    str.concat(colstr;
    str.concat(" message=";
    report.message)))))));
  let corr=report.requestid;
  if str.eq(corr;""){
    let corr="client"
  }else{()};
  log.warn(msg;"platform.error.client";corr)
};

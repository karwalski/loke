{
  "schema_version": "1.0",
  "module": "loke.platform.error.apiclient",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "apierror", "fields": [{"name": "status", "type": "i32"}, {"name": "code", "type": "str"}, {"name": "message", "type": "str"}, {"name": "retryable", "type": "bool"}]},
    {"kind": "type", "name": "retryconfig", "fields": [{"name": "maxattempts", "type": "i32"}, {"name": "basedelayms", "type": "i32"}]},
    {"kind": "func", "name": "defaultretry", "params": [], "return": "retryconfig"},
    {"kind": "func", "name": "isretryable", "params": ["i32"], "return": "bool"},
    {"kind": "func", "name": "classify", "params": ["i32", "str"], "return": "apierror"}
  ]
}





m=loke.platform.ui.notifications;

i=str:std.str;



t=$notification{
  id:str;
  kind:str;
  title:str;
  body:str;
  ts:i64;
  read:bool
};


f=newnotification(kind:str;title:str;body:str):$notification{
  <$notification{
    id:str.uuid();
    kind:kind;
    title:title;
    body:body;
    ts:0;
    read:false
  }
};


f=tojson(n:$notification):str{
  let readstr="false";
  if(n.read){
    readstr="true"
  }el{()};
  let tsstr=str.fromi64(n.ts);
  let out="{";
  out=str.concat(out;str.concat("\"id\":\"";str.concat(n.id;"\",")));
  out=str.concat(out;str.concat("\"kind\":\"";str.concat(n.kind;"\",")));
  out=str.concat(out;str.concat("\"title\":\"";str.concat(n.title;"\",")));
  out=str.concat(out;str.concat("\"body\":\"";str.concat(n.body;"\",")));
  out=str.concat(out;str.concat("\"ts\":";str.concat(tsstr;",")));
  out=str.concat(out;str.concat("\"read\":";str.concat(readstr;"}")));
  <out
};



f=toasthtml(n:$notification):str{
  let out=str.concat("<div class=\"toast toast-";str.concat(n.kind;"\" role=\"alert\" aria-live=\"polite\" data-id=\""));
  out=str.concat(out;str.concat(n.id;"\">
"));
  out=str.concat(out;"  <div class=\"toast-header\">
");
  out=str.concat(out;str.concat("    <strong class=\"toast-title\">";str.concat(n.title;"</strong>
")));
  out=str.concat(out;"    <button class=\"toast-close\" aria-label=\"Dismiss\" onclick=\"this.closest('.toast').remove()\">&times;</button>
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;str.concat("  <div class=\"toast-body\">";str.concat(n.body;"</div>
")));
  out=str.concat(out;"</div>
");
  <out
};



f=bellhtml(unreadcount:i32):str{
  let badge="";
  if(unreadcount>0){
    let countstr=str.fromi32(unreadcount);
    badge=str.concat("<span class=\"bell-badge\" aria-label=\"";str.concat(countstr;str.concat(" unread notifications\">";str.concat(countstr;"</span>"))))
  }el{()};
  let out="<button class=\"bell-btn\" aria-label=\"Notifications\" onclick=\"window.__notifications && window.__notifications.toggle()\">
";
  out=str.concat(out;"  <span class=\"bell-icon\" aria-hidden=\"true\">&#128276;</span>
");
  out=str.concat(out;str.concat(badge;"
"));
  out=str.concat(out;"</button>
");
  <out
};

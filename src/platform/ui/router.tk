m=platform.ui.router;






m=loke.platform.ui.router;

i=str:std.str;



f=routerjs():str{
  let js="window.__router = (function() {
";
  js=str.concat(js;"  var routes = {};
");
  js=str.concat(js;"  var _404handler = null;

");

  
  js=str.concat(js;"  function on(path, fn) {
");
  js=str.concat(js;"    routes[path] = fn;
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function _match(hash) {
");
  js=str.concat(js;"    var path = hash || '/';
");
  js=str.concat(js;"    // Exact match
");
  js=str.concat(js;"    if (routes[path]) { return { fn: routes[path], params: {} }; }
");
  js=str.concat(js;"    // Prefix / param match
");
  js=str.concat(js;"    var keys = Object.keys(routes);
");
  js=str.concat(js;"    for (var i = 0; i < keys.length; i++) {
");
  js=str.concat(js;"      var pattern = keys[i];
");
  js=str.concat(js;"      var patParts = pattern.split('/');
");
  js=str.concat(js;"      var pathParts = path.split('/');
");
  js=str.concat(js;"      if (patParts.length !== pathParts.length) { continue; }
");
  js=str.concat(js;"      var params = {};
  var match = true;
");
  js=str.concat(js;"      for (var j = 0; j < patParts.length; j++) {
");
  js=str.concat(js;"        if (patParts[j].charAt(0) === ':') {
");
  js=str.concat(js;"          params[patParts[j].slice(1)] = pathParts[j];
");
  js=str.concat(js;"        } else if (patParts[j] !== pathParts[j]) {
");
  js=str.concat(js;"          match = false; break;
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"      if (match) { return { fn: routes[pattern], params: params }; }
");
  js=str.concat(js;"    }
");
  js=str.concat(js;"    return null;
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function navigate(path) {
");
  js=str.concat(js;"    window.location.hash = path;
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function _dispatch() {
");
  js=str.concat(js;"    var hash = window.location.hash.replace(/^#/, '') || '/';
");
  js=str.concat(js;"    var result = _match(hash);
");
  js=str.concat(js;"    if (result) {
");
  js=str.concat(js;"      result.fn(result.params);
");
  js=str.concat(js;"      _announce(document.title);
");
  js=str.concat(js;"    } else if (_404handler) {
");
  js=str.concat(js;"      _404handler(hash);
");
  js=str.concat(js;"    }
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function _announce(msg) {
");
  js=str.concat(js;"    var el = document.getElementById('__router-announcer');
");
  js=str.concat(js;"    if (!el) {
");
  js=str.concat(js;"      el = document.createElement('span');
");
  js=str.concat(js;"      el.id = '__router-announcer';
");
  js=str.concat(js;"      el.setAttribute('aria-live', 'polite');
");
  js=str.concat(js;"      el.setAttribute('aria-atomic', 'true');
");
  js=str.concat(js;"      el.style.cssText = 'position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);';
");
  js=str.concat(js;"      document.body.appendChild(el);
");
  js=str.concat(js;"    }
");
  js=str.concat(js;"    el.textContent = '';
");
  js=str.concat(js;"    setTimeout(function() { el.textContent = msg; }, 50);
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function init() {
");
  js=str.concat(js;"    window.addEventListener('hashchange', _dispatch);
");
  js=str.concat(js;"    _dispatch();
");
  js=str.concat(js;"  }

");

  js=str.concat(js;"  return {
");
  js=str.concat(js;"    routes: routes,
");
  js=str.concat(js;"    on: on,
");
  js=str.concat(js;"    navigate: navigate,
");
  js=str.concat(js;"    init: init,
");
  js=str.concat(js;"    notFound: function(fn) { _404handler = fn; }
");
  js=str.concat(js;"  };
");
  js=str.concat(js;"})();
");
  <js
};

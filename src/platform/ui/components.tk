
m=loke.platform.ui.components;

i=str:std.str;



f=componentscss():str{
  
  let out=mut.".btn {
";
  out=str.concat(out;"  display: inline-flex;
  align-items: center;
  gap: 6px;
");
  out=str.concat(out;"  font-size: 0.85em;
  font-weight: 600;
");
  out=str.concat(out;"  padding: 7px 16px;
  border-radius: 7px;
  border: none;
");
  out=str.concat(out;"  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s;
}
");
  out=str.concat(out;".btn:active { transform: scale(0.97); }
");

  
  out=str.concat(out;".btn-primary { background: var(--accent); color: #0d1117; }
");
  out=str.concat(out;".btn-primary:hover { opacity: 0.88; }
");

  
  out=str.concat(out;".btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text); }
");
  out=str.concat(out;".btn-ghost:hover { border-color: var(--teal); color: var(--teal); }
");

  
  out=str.concat(out;".card {
");
  out=str.concat(out;"  background: var(--surface);
  border: 1px solid var(--border);
");
  out=str.concat(out;"  border-radius: 10px;
  padding: 20px 24px;
  margin-bottom: 20px;
}
");

  
  out=str.concat(out;".badge {
");
  out=str.concat(out;"  font-size: 0.72em;
  font-weight: 600;
");
  out=str.concat(out;"  padding: 1px 7px;
  border-radius: 4px;
  white-space: nowrap;
}
");
  out=str.concat(out;".badge-red    { background: rgba(248,81,73,.15);   color: var(--red); }
");
  out=str.concat(out;".badge-amber  { background: rgba(210,153,34,.15);  color: var(--amber); }
");
  out=str.concat(out;".badge-green  { background: rgba(63,185,80,.15);   color: var(--green); }
");
  out=str.concat(out;".badge-muted  { background: rgba(139,148,158,.12); color: var(--muted); }
");

  
  out=str.concat(out;".alert {
");
  out=str.concat(out;"  padding: 12px 16px;
  border-radius: 8px;
");
  out=str.concat(out;"  border-left: 3px solid var(--border);
  margin-bottom: 16px;
}
");
  out=str.concat(out;".alert-info  { border-left-color: var(--teal);  background: rgba(20,184,166,.08); }
");
  out=str.concat(out;".alert-warn  { border-left-color: var(--amber); background: rgba(210,153,34,.08); }
");
  out=str.concat(out;".alert-error { border-left-color: var(--red);   background: rgba(248,81,73,.08); }
");

  
  out=str.concat(out;".spinner {
");
  out=str.concat(out;"  display: inline-block;
  width: 20px;
  height: 20px;
");
  out=str.concat(out;"  border: 2px solid var(--border);
  border-top-color: var(--accent);
");
  out=str.concat(out;"  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}
");

  
  out=str.concat(out;"@keyframes spin {
  to { transform: rotate(360deg); }
}
");

  <out
};

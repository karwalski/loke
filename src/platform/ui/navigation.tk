



m=loke.platform.ui.navigation;

i=str:std.str;



f=navjs():str{
  let js="window.__nav = (function() {

";

  
  js=str.concat(js;"  function setActive(path) {
");
  js=str.concat(js;"    var links = document.querySelectorAll('.nav-link');
");
  js=str.concat(js;"    links.forEach(function(a) {
");
  js=str.concat(js;"      a.classList.remove('active');
");
  js=str.concat(js;"      var dp = a.getAttribute('data-path');
");
  js=str.concat(js;"      if (dp !== null && (dp === '/' ? path === '/' : path === dp || path.indexOf(dp) === 0)) {
");
  js=str.concat(js;"        a.classList.add('active');
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    });
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function addBadge(navPath, count) {
");
  js=str.concat(js;"    var links = document.querySelectorAll('.nav-link');
");
  js=str.concat(js;"    links.forEach(function(a) {
");
  js=str.concat(js;"      if (a.getAttribute('data-path') === navPath) {
");
  js=str.concat(js;"        var existing = a.querySelector('.nav-badge');
");
  js=str.concat(js;"        if (count === 0) {
");
  js=str.concat(js;"          if (existing) { existing.parentNode.removeChild(existing); }
");
  js=str.concat(js;"          return;
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        if (!existing) {
");
  js=str.concat(js;"          existing = document.createElement('span');
");
  js=str.concat(js;"          existing.className = 'nav-badge';
");
  js=str.concat(js;"          a.appendChild(existing);
");
  js=str.concat(js;"        }
");
  js=str.concat(js;"        existing.textContent = count > 99 ? '99+' : String(count);
");
  js=str.concat(js;"      }
");
  js=str.concat(js;"    });
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function collapse() {
");
  js=str.concat(js;"    var sb = document.getElementById('sidebar');
");
  js=str.concat(js;"    if (sb) { sb.classList.add('collapsed'); }
");
  js=str.concat(js;"  }

");

  
  js=str.concat(js;"  function expand() {
");
  js=str.concat(js;"    var sb = document.getElementById('sidebar');
");
  js=str.concat(js;"    if (sb) { sb.classList.remove('collapsed'); }
");
  js=str.concat(js;"  }

");

  js=str.concat(js;"  return { setActive: setActive, addBadge: addBadge, collapse: collapse, expand: expand };
");
  js=str.concat(js;"})();
");
  <js
};

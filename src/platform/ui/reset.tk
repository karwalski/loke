



m=loke.platform.ui.reset;

i=str:std.str;




f=resetcss():str{
  let out=mut."*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
";
  out=str.concat(out;"body { font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.6; }
");
  out=str.concat(out;":focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
");
  out=str.concat(out;"@media (prefers-reduced-motion: reduce) {
");
  out=str.concat(out;"  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
");
  out=str.concat(out;"}
");
  <out
};

m=platform.ui.tokens;





m=loke.platform.ui.tokens;

i=str:std.str;


t=$colortokens{
  bg:str;
  surface:str;
  border:str;
  text:str;
  muted:str;
  accent:str;
  green:str;
  amber:str;
  red:str;
  teal:str
};


t=$spacingtokens{
  xs:str;
  sm:str;
  md:str;
  lg:str;
  xl:str
};


t=$theme{
  name:str;
  colors:$colortokens;
  spacing:$spacingtokens;
  fontsizebase:str;
  borderradiusbase:str
};



f=darktheme():$theme{
  <$theme{
    name:"dark";
    colors:$colortokens{
      bg:"#0d1117";
      surface:"#161b22";
      border:"#30363d";
      text:"#e6edf3";
      muted:"#8b949e";
      accent:"#14b8a6";
      green:"#3fb950";
      amber:"#d29922";
      red:"#f85149";
      teal:"#14b8a6"
    };
    spacing:$spacingtokens{
      xs:"4px";
      sm:"8px";
      md:"16px";
      lg:"24px";
      xl:"40px"
    };
    fontsizebase:"15px";
    borderradiusbase:"7px"
  };
};



f=lighttheme():$theme{
  <$theme{
    name:"light";
    colors:$colortokens{
      bg:"#ffffff";
      surface:"#f6f8fa";
      border:"#d0d7de";
      text:"#1f2328";
      muted:"#656d76";
      accent:"#14b8a6";
      green:"#3fb950";
      amber:"#d29922";
      red:"#f85149";
      teal:"#14b8a6"
    };
    spacing:$spacingtokens{
      xs:"4px";
      sm:"8px";
      md:"16px";
      lg:"24px";
      xl:"40px"
    };
    fontsizebase:"15px";
    borderradiusbase:"7px"
  };
};



f=tocssvars(t:$theme):str{
  let c=t.colors;
  let s=t.spacing;
  let out=str.concat(":root {
";str.concat("  --bg: ";str.concat(c.bg;";
")));
  out=str.concat(out;str.concat("  --surface: ";str.concat(c.surface;";
")));
  out=str.concat(out;str.concat("  --border: ";str.concat(c.border;";
")));
  out=str.concat(out;str.concat("  --text: ";str.concat(c.text;";
")));
  out=str.concat(out;str.concat("  --muted: ";str.concat(c.muted;";
")));
  out=str.concat(out;str.concat("  --accent: ";str.concat(c.accent;";
")));
  out=str.concat(out;str.concat("  --green: ";str.concat(c.green;";
")));
  out=str.concat(out;str.concat("  --amber: ";str.concat(c.amber;";
")));
  out=str.concat(out;str.concat("  --red: ";str.concat(c.red;";
")));
  out=str.concat(out;str.concat("  --teal: ";str.concat(c.teal;";
")));
  out=str.concat(out;str.concat("  --space-xs: ";str.concat(s.xs;";
")));
  out=str.concat(out;str.concat("  --space-sm: ";str.concat(s.sm;";
")));
  out=str.concat(out;str.concat("  --space-md: ";str.concat(s.md;";
")));
  out=str.concat(out;str.concat("  --space-lg: ";str.concat(s.lg;";
")));
  out=str.concat(out;str.concat("  --space-xl: ";str.concat(s.xl;";
")));
  out=str.concat(out;str.concat("  --font-size-base: ";str.concat(t.fontsizebase;";
")));
  out=str.concat(out;str.concat("  --border-radius-base: ";str.concat(t.borderradiusbase;";
")));
  out=str.concat(out;"}
");
  <out
};

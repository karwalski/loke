



m=loke.platform.ui.theme;

i=str:std.str;
i=log:std.log;


t=$thememode{
  $dark:i64;
  $light:i64;
  $system
};


let gcurrentmode:str="dark";



f=setmode(mode:str):void{
  gcurrentmode=mode;
  log.info(str.concat("theme mode set to ";mode);"platform.ui.theme";"system")
};


f=getmode():str{
  <gcurrentmode
};




f=datathemeattr(mode:str):str{
  if(str.eq(mode;"light")){
    <"data-theme=\"light\""
  }el{
    <"data-theme=\"dark\""
  };
};




f=detectfromenv():str{
  <"dark"
};

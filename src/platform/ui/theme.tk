m=loke.platform.ui.theme;

i=str:std.str;
i=log:std.log;


t=$thememode{
  $dark:i64;
  $light:i64;
  $system:i64
};


t=$themestate{
  currentmode:str
};

f=newstate():$themestate{
  <$themestate{ currentmode:"dark" }
};


f=setmode(s:$themestate;mode:str):$themestate{
  log.info(str.concat("theme mode set to ";mode);"platform.ui.theme";"system");
  <$themestate{ currentmode:mode }
};


f=getmode(s:$themestate):str{
  <s.currentmode
};




f=datathemeattr(mode:str):str{
  if(str.eq(mode;"light")){
    <"data-theme=\"light\""
  }el{
    <"data-theme=\"dark\""
  }
};




f=detectfromenv():str{
  <"dark"
};

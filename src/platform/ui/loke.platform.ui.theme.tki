{
  "schema_version": "1.0",
  "module": "loke.platform.ui.theme",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "thememode", "is_sum": true, "fields": [{"name": "$dark", "type": "i64"}, {"name": "$light", "type": "i64"}, {"name": "$system", "type": "i64"}]},
    {"kind": "type", "name": "themestate", "fields": [{"name": "currentmode", "type": "str"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "themestate"},
    {"kind": "func", "name": "setmode", "params": ["themestate", "str"], "return": "themestate"},
    {"kind": "func", "name": "getmode", "params": ["themestate"], "return": "str"},
    {"kind": "func", "name": "datathemeattr", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "detectfromenv", "params": [], "return": "str"}
  ]
}

{
  "schema_version": "1.0",
  "module": "loke.platform.ui.shell",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "navitem", "fields": [{"name": "label", "type": "str"}, {"name": "path", "type": "str"}, {"name": "icon", "type": "str"}, {"name": "section", "type": "str"}]},
    {"kind": "type", "name": "shellconfig", "fields": [{"name": "appname", "type": "str"}, {"name": "appversion", "type": "str"}, {"name": "subtitle", "type": "str"}, {"name": "navitems", "type": "@"}]},
    {"kind": "func", "name": "defaultnav", "params": [], "return": "@"},
    {"kind": "func", "name": "renderheader", "params": ["shellconfig"], "return": "str"},
    {"kind": "func", "name": "rendersidebar", "params": ["@"], "return": "str"}
  ]
}

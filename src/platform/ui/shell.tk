m=platform.ui.shell;





m=loke.platform.ui.shell;

i=str:std.str;


t=$navitem{
  label:str;
  path:str;
  icon:str;
  section:str
};


t=$shellconfig{
  appname:str;
  appversion:str;
  subtitle:str;
  navitems:@$navitem
};




f=defaultnav():@$navitem{
  <@(
    $navitem{label:"Dashboard";  path:"/";         icon:"📊"; section:"Workspace"};
    $navitem{label:"Analysis";   path:"/analysis"; icon:"💬"; section:"Workspace"};
    $navitem{label:"Insight Lab";path:"/insight";  icon:"🔬"; section:"Workspace"};
    $navitem{label:"Upload";     path:"/upload";   icon:"⬆️"; section:"Workspace"};
    $navitem{label:"Settings";   path:"/settings"; icon:"⚙️"; section:"System"};
    $navitem{label:"Docs";       path:"/docs";     icon:"📖"; section:"Resources"}
  )
};




f=renderheader(cfg:$shellconfig):str{
  let out="<header class=\"app-header\">
";
  out=str.concat(out;"  <button class=\"sidebar-toggle\" aria-label=\"Toggle navigation\" onclick=\"toggleSidebar()\">&#9776;</button>
");
  out=str.concat(out;"  <div class=\"brand\">
");
  out=str.concat(out;str.concat("    <h1>";str.concat(cfg.appname;"</h1>
")));
  out=str.concat(out;str.concat("    <span class=\"subtitle\">";str.concat(cfg.subtitle;"</span>
")));
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"  <div class=\"spacer\"></div>
");
  out=str.concat(out;"</header>
");
  <out
};




f=rendersidebar(items:@$navitem):str{
  let out="<nav class=\"sidebar\" id=\"sidebar\">
  <div class=\"sidebar-nav\">
";
  let lastsection="";
  let idx=0;
  let count=items.len();
  if(idx<count){
    let item=items.get(idx);
    if(str.eq(item.section;lastsection)){
      
    }el{
      out=str.concat(out;str.concat("    <div class=\"sidebar-section-label\">";str.concat(item.section;"</div>
")));
      lastsection=item.section
    };
    out=str.concat(out;str.concat("    <a href=\"";str.concat(item.path;str.concat("\" class=\"nav-link\" data-path=\"";str.concat(item.path;"\">
")))));
    out=str.concat(out;str.concat("      <span class=\"nav-icon\">";str.concat(item.icon;"</span> ")));
    out=str.concat(out;str.concat(item.label;"
    </a>
"));
    idx=idx+1
  }el{};
  out=str.concat(out;"  </div>
</nav>
");
  <out
};

m=loke.platform.ui.settingsui;

i=str:std.str;



f=basesettingshtml():str{
  let out=mut."";

  
  out=str.concat(out;"<section class=\"settings-section\" id=\"settings-appearance\">
");
  out=str.concat(out;"  <h2>Appearance</h2>
");
  out=str.concat(out;"  <div class=\"settings-field\">
");
  out=str.concat(out;"    <label class=\"settings-label\">Theme</label>
");
  out=str.concat(out;"    <div class=\"radio-group\">
");
  out=str.concat(out;"      <label><input type=\"radio\" name=\"theme\" value=\"dark\" checked> Dark</label>
");
  out=str.concat(out;"      <label><input type=\"radio\" name=\"theme\" value=\"light\"> Light</label>
");
  out=str.concat(out;"      <label><input type=\"radio\" name=\"theme\" value=\"system\"> System</label>
");
  out=str.concat(out;"    </div>
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"</section>

");

  
  out=str.concat(out;"<section class=\"settings-section\" id=\"settings-timezone\">
");
  out=str.concat(out;"  <h2>Timezone</h2>
");
  out=str.concat(out;"  <div class=\"settings-field\">
");
  out=str.concat(out;"    <label class=\"settings-label\" for=\"tz-input\">Timezone</label>
");
  out=str.concat(out;"    <input class=\"settings-input\" type=\"text\" id=\"tz-input\" name=\"timezone\" value=\"UTC\" placeholder=\"e.g. Australia/Sydney\">
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"</section>

");

  
  out=str.concat(out;"<section class=\"settings-section\" id=\"settings-language\">
");
  out=str.concat(out;"  <h2>Language</h2>
");
  out=str.concat(out;"  <div class=\"settings-field\">
");
  out=str.concat(out;"    <label class=\"settings-label\" for=\"lang-select\">Language</label>
");
  out=str.concat(out;"    <select class=\"settings-select\" id=\"lang-select\" name=\"language\">
");
  out=str.concat(out;"      <option value=\"en-AU\" selected>English (Australia)</option>
");
  out=str.concat(out;"      <option value=\"en-US\">English (United States)</option>
");
  out=str.concat(out;"      <option value=\"en-GB\">English (United Kingdom)</option>
");
  out=str.concat(out;"    </select>
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"</section>

");

  
  out=str.concat(out;"<section class=\"settings-section\" id=\"settings-integrations\">
");
  out=str.concat(out;"  <h2>Integration Status</h2>
");
  out=str.concat(out;"  <div id=\"integration-status\">
");
  out=str.concat(out;"    <!-- Integration status populated by application JS -->
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"</section>

");

  
  out=str.concat(out;"<section class=\"settings-section\" id=\"settings-backup\">
");
  out=str.concat(out;"  <h2>Backup &amp; Restore</h2>
");
  out=str.concat(out;"  <div class=\"settings-actions\">
");
  out=str.concat(out;"    <button class=\"btn btn-primary\" onclick=\"window.__settings && window.__settings.backupNow()\">Backup now</button>
");
  out=str.concat(out;"    <button class=\"btn btn-ghost\" onclick=\"window.__settings && window.__settings.restore()\">Restore&hellip;</button>
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"</section>

");

  
  out=str.concat(out;"<section class=\"settings-section\" id=\"settings-about\">
");
  out=str.concat(out;"  <h2>About</h2>
");
  out=str.concat(out;"  <div class=\"settings-field\">
");
  out=str.concat(out;"    <span class=\"settings-label\">Version</span>
");
  out=str.concat(out;"    <span id=\"app-version\" class=\"settings-value\">&#8212;</span>
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"  <div class=\"settings-actions\">
");
  out=str.concat(out;"    <button class=\"btn btn-ghost\" onclick=\"window.__settings && window.__settings.checkForUpdates()\">Check for updates</button>
");
  out=str.concat(out;"  </div>
");
  out=str.concat(out;"</section>
");

  <out
};

m=loke.platform.i18n.locales;

i=tr:loke.platform.i18n.translator;



f=enau():tr.$locale{
  let entries=@($localeentry);
  entries.push($localeentry{ key:"loke.app_name"; value:"loke" });
  entries.push($localeentry{ key:"loke.tagline"; value:"Your intelligence layer. Your data, your rules." });
  entries.push($localeentry{ key:"loke.nav.datasets"; value:"Datasets" });
  entries.push($localeentry{ key:"loke.nav.analysis"; value:"Analysis" });
  entries.push($localeentry{ key:"loke.nav.dashboard"; value:"Dashboard" });
  entries.push($localeentry{ key:"loke.nav.insight"; value:"Insight" });
  entries.push($localeentry{ key:"loke.nav.upload"; value:"Upload" });
  entries.push($localeentry{ key:"loke.nav.settings"; value:"Settings" });
  entries.push($localeentry{ key:"loke.status.connecting"; value:"Connecting…" });
  entries.push($localeentry{ key:"loke.status.connected"; value:"Connected" });
  entries.push($localeentry{ key:"loke.status.offline"; value:"Offline" });
  entries.push($localeentry{ key:"loke.privacy.on"; value:"Privacy on — anonymising your data" });
  entries.push($localeentry{ key:"loke.privacy.off"; value:"Privacy off — data sent as-is" });
  entries.push($localeentry{ key:"loke.sensitivity.public"; value:"Public" });
  entries.push($localeentry{ key:"loke.sensitivity.internal"; value:"Internal" });
  entries.push($localeentry{ key:"loke.sensitivity.confidential"; value:"Confidential" });
  entries.push($localeentry{ key:"loke.sensitivity.restricted"; value:"Restricted" });
  entries.push($localeentry{ key:"loke.btn.load"; value:"Load" });
  entries.push($localeentry{ key:"loke.btn.cancel"; value:"Cancel" });
  entries.push($localeentry{ key:"loke.btn.approve"; value:"Approve" });
  entries.push($localeentry{ key:"loke.btn.save"; value:"Save" });
  entries.push($localeentry{ key:"loke.btn.delete"; value:"Delete" });
  entries.push($localeentry{ key:"loke.btn.export"; value:"Export" });
  entries.push($localeentry{ key:"loke.err.nodataset"; value:"No dataset loaded. Please upload or select a dataset to continue." });
  entries.push($localeentry{ key:"loke.err.lokeoffline"; value:"loke is offline. Check your connection and try again." });
  entries.push($localeentry{ key:"loke.pipeline.ready"; value:"Pipeline ready" });
  entries.push($localeentry{ key:"loke.pipeline.running"; value:"Pipeline running…" });
  entries.push($localeentry{ key:"loke.pipeline.done"; value:"Pipeline complete" });
  entries.push($localeentry{ key:"loke.feedback.thumbsup"; value:"This response was helpful" });
  entries.push($localeentry{ key:"loke.feedback.thumbsdown"; value:"This response was not helpful" });
  <$locale{
    code:"en-AU";
    entries:entries
  }
};




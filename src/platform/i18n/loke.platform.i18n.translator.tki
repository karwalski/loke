{
  "schema_version": "1.0",
  "module": "loke.platform.i18n.translator",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "localeentry", "fields": [{"name": "key", "type": "str"}, {"name": "value", "type": "str"}]},
    {"kind": "type", "name": "locale", "fields": [{"name": "code", "type": "str"}, {"name": "entries", "type": "@"}]},
    {"kind": "type", "name": "translatorstate", "fields": [{"name": "activelocale", "type": "str"}, {"name": "locales", "type": "@"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "translatorstate"},
    {"kind": "func", "name": "loadlocale", "params": ["translatorstate", "locale"], "return": "translatorstate"},
    {"kind": "func", "name": "t", "params": ["translatorstate", "str"], "return": "str"},
    {"kind": "func", "name": "tn", "params": ["translatorstate", "str", "i32"], "return": "str"},
    {"kind": "func", "name": "tparams", "params": ["translatorstate", "str", "@"], "return": "str"},
    {"kind": "func", "name": "setlocale", "params": ["translatorstate", "str"], "return": "translatorstate"},
    {"kind": "func", "name": "getlocale", "params": ["translatorstate"], "return": "str"},
    {"kind": "func", "name": "formatnumber", "params": ["f32", "str"], "return": "str"},
    {"kind": "func", "name": "formatdate", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "formatrelative", "params": ["i64"], "return": "str"}
  ]
}

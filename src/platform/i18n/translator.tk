m=platform.i18n.translator;





m=loke.platform.i18n.translator;

i=str:std.str;
i=log:std.log;


t=$localeentry{
  key:str;
  value:str
};


t=$locale{
  code:str;
  entries:@$localeentry
};


let gactivelocale:str="en-AU";
let glocales:@$locale=@();



f=loadlocale(locale:$locale):void{
  glocales.push(locale)
};



f=t(key:str):str{
  let count=glocales.len();
  let i=0;
  if(i<count){
    let locale=glocales.get(i);
    if(str.eq(locale.code;gactivelocale){
      let entrycount=locale.entries.len();
      let j=0;
      if(j<entrycount){
        let entry=locale.entries.get(j);
        if(str.eq(entry.key;key){
          <entry.value
        }else{()};
        j=j+1
      }{};
    }else{()};
    i=i+1
  }{};
  <key
};



f=tn(key:str;count:i32):str{
  if(count==0{
    let zerokey=str.concat(key;"_zero");
    let zeroval=t(zerokey);
    if(str.eq(zeroval;zerokey){
      <t(key)
    }else{
      <zeroval
    };
  }else{
    if(count==1{
      let onekey=str.concat(key;"_one");
      let oneval=t(onekey);
      if(str.eq(oneval;onekey){
        <t(key)
      }else{
        <oneval
      };
    }else{
      let otherkey=str.concat(key;"_other");
      let otherval=t(otherkey);
      if(str.eq(otherval;otherkey){
        <t(key)
      }else{
        <otherval
      };
    };
  };
};


f=tparams(key:str;params:@str):str{
  let base=t(key);
  let result=base;
  let i=0;
  let count=params.len();
  if(i<count){
    let placeholder=str.concat("{{";str.concat(str.fromint(i);"}}"));
    result=str.replace(result;placeholder;params.get(i));
    i=i+1
  }{};
  <result
};


f=setlocale(code:str):void{
  gactivelocale=code;
  let msg=str.concat("loke.platform.i18n.translator: active locale set to ";code);
  log.info(msg)
};


f=getlocale():str{
  <gactivelocale
};



f=formatnumber(n:f32;localecode:str):str{
  <str.formatf32(n;2)
};



f=formatdate(iso:str;localecode:str):str{
  <iso
};




f=formatrelative(secondsago:i64):str{
  if(secondsago<60{
    <"just now"
  }else{
    if(secondsago<3600{
      let minutes=secondsago/60;
      <str.concat(str.fromint(minutes);" minutes ago")
    }else{
      if(secondsago<86400{
        let hours=secondsago/3600;
        <str.concat(str.fromint(hours);" hours ago")
      }else{
        let days=secondsago/86400;
        <str.concat(str.fromint(days);" days ago")
      };
    };
  };
};

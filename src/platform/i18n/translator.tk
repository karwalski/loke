m=loke.platform.i18n.translator;

i=str:std.str;
i=log:std.log;


t=$localeentry{
  key:str;
  value:str
};


t=$locale{
  code:str;
  entries:@$localeentry
};


t=$translatorstate{
  activelocale:str;
  locales:@$locale
};

f=newstate():$translatorstate{
  <$translatorstate{ activelocale:"en-AU"; locales:@($locale) }
};


f=loadlocale(s:$translatorstate;locale:$locale):$translatorstate{
  s.locales.push(locale);
  <s
};



f=t(s:$translatorstate;key:str):str{
  let count=s.locales.len();
  lp(let i=0;i<count;i=i+1){
    let locale=s.locales.get(i);
    if(str.eq(locale.code;s.activelocale)){
      let entrycount=locale.entries.len();
      lp(let j=0;j<entrycount;j=j+1){
        let entry=locale.entries.get(j);
        if(str.eq(entry.key;key)){
          <entry.value
        }el{}
      }
    }el{}
  };
  <key
};



f=tn(s:$translatorstate;key:str;count:i32):str{
  if(count=(0 as i32)){
    let zerokey=str.concat(key;"_zero");
    let zeroval=t(s;zerokey);
    if(str.eq(zeroval;zerokey)){
      <t(s;key)
    }el{
      <zeroval
    }
  }el{
    if(count=(1 as i32)){
      let onekey=str.concat(key;"_one");
      let oneval=t(s;onekey);
      if(str.eq(oneval;onekey)){
        <t(s;key)
      }el{
        <oneval
      }
    }el{
      let otherkey=str.concat(key;"_other");
      let otherval=t(s;otherkey);
      if(str.eq(otherval;otherkey)){
        <t(s;key)
      }el{
        <otherval
      }
    }
  }
};


f=tparams(s:$translatorstate;key:str;params:@str):str{
  let base=t(s;key);
  let result=mut.base;
  let count=params.len();
  lp(let i=0;i<count;i=i+1){
    let placeholder=str.concat("{{";str.concat(str.fromint(i);"}}"));
    result=str.replace(result;placeholder;params.get(i))
  };
  <result
};


f=setlocale(s:$translatorstate;code:str):$translatorstate{
  let msg=str.concat("loke.platform.i18n.translator: active locale set to ";code);
  log.info(msg);
  <$translatorstate{ activelocale:code; locales:s.locales }
};


f=getlocale(s:$translatorstate):str{
  <s.activelocale
};



f=formatnumber(n:f32;localecode:str):str{
  <str.formatf32(n;2)
};



f=formatdate(iso:str;localecode:str):str{
  <iso
};




f=formatrelative(secondsago:i64):str{
  if(secondsago<60){
    <"just now"
  }el{
    if(secondsago<3600){
      let minutes=secondsago/60;
      <str.concat(str.fromint(minutes);" minutes ago")
    }el{
      if(secondsago<86400){
        let hours=secondsago/3600;
        <str.concat(str.fromint(hours);" hours ago")
      }el{
        let days=secondsago/86400;
        <str.concat(str.fromint(days);" days ago")
      }
    }
  }
};

{
  "schema_version": "1.0",
  "module": "loke.platform.plugin.config",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "configsection", "fields": [{"name": "namespace", "type": "str"}, {"name": "schemakey", "type": "str"}, {"name": "envprefix", "type": "str"}]},
    {"kind": "type", "name": "configregistry", "fields": [{"name": "sections", "type": "@"}]},
    {"kind": "func", "name": "newregistry", "params": [], "return": "configregistry"},
    {"kind": "func", "name": "registersection", "params": ["configregistry", "str", "str", "str"], "return": "configregistry"},
    {"kind": "func", "name": "listsections", "params": ["configregistry"], "return": "@"},
    {"kind": "func", "name": "getsection", "params": ["configregistry", "str"], "return": "configsection"}
  ]
}

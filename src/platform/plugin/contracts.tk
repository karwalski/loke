m=loke.platform.plugin.contracts;

i=str:std.str;
i=log:std.log;


t=$interfaceversion{
  major:i32;
  minor:i32;
  patch:i32
};


t=$breakingchange{
  version:str;
  description:str;
  migration:str
};


t=$contract{
  interfaceid:str;
  version:$interfaceversion;
  description:str;
  breakingchanges:@$breakingchange
};


f=currentversion():$interfaceversion{
  <$interfaceversion{
    major:0;
    minor:1;
    patch:0
  }
};



f=iscompatible(requiredmajor:i32;requiredminor:i32):bool{
  let v=currentversion();
  if(v.major=requiredmajor){
    if(!(v.minor<requiredminor)){
      <true
    }el{
      <false
    }
  }el{
    <false
  }
};


f=listbreakingchanges():@$breakingchange{
  let changes=@($breakingchange);
  <changes
};


f=versionstring(v:$interfaceversion):str{
  let out=mut.str.fromi32(v.major);
  out=str.concat(out;".");
  out=str.concat(out;str.fromi32(v.minor));
  out=str.concat(out;".");
  out=str.concat(out;str.fromi32(v.patch));
  <out
};

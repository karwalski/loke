{
  "schema_version": "1.0",
  "module": "loke.platform.plugin.registry",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "pluginroute", "fields": [{"name": "method", "type": "str"}, {"name": "path", "type": "str"}, {"name": "namespace", "type": "str"}, {"name": "handlerkey", "type": "str"}]},
    {"kind": "type", "name": "pluginhealthcheck", "fields": [{"name": "id", "type": "str"}, {"name": "checkkey", "type": "str"}]},
    {"kind": "type", "name": "pluginnavitem", "fields": [{"name": "label", "type": "str"}, {"name": "path", "type": "str"}, {"name": "icon", "type": "str"}, {"name": "section", "type": "str"}]},
    {"kind": "type", "name": "pluginsettingssection", "fields": [{"name": "id", "type": "str"}, {"name": "title", "type": "str"}, {"name": "templatekey", "type": "str"}]},
    {"kind": "type", "name": "pluginregistration", "fields": [{"name": "id", "type": "str"}, {"name": "name", "type": "str"}, {"name": "version", "type": "str"}, {"name": "routes", "type": "@"}, {"name": "healthchecks", "type": "@"}, {"name": "navitems", "type": "@"}, {"name": "settingssections", "type": "@"}]},
    {"kind": "type", "name": "registrystate", "fields": [{"name": "plugins", "type": "@"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "registrystate"},
    {"kind": "func", "name": "register", "params": ["registrystate", "pluginregistration"], "return": "registrystate"},
    {"kind": "func", "name": "list", "params": ["registrystate"], "return": "@"},
    {"kind": "func", "name": "get", "params": ["registrystate", "str"], "return": "pluginregistration"},
    {"kind": "func", "name": "allroutes", "params": ["registrystate"], "return": "@"},
    {"kind": "func", "name": "allnavitems", "params": ["registrystate"], "return": "@"},
    {"kind": "func", "name": "allhealthchecks", "params": ["registrystate"], "return": "@"}
  ]
}

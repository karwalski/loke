m=loke.platform.plugin.config;

i=str:std.str;
i=log:std.log;



t=$configsection{
  namespace:str;
  schemakey:str;
  envprefix:str
};


t=$configregistry{
  sections:@$configsection
};


g=gconfigregistry:$configregistry=$configregistry{ sections:@($configsection) };



f=registersection(namespace:str;schemakey:str;envprefix:str):void{
  let existing=gconfigregistry.sections;
  let filtered=@($configsection);
  let count=existing.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let sec=existing.get(idx);
    if(str.eq(sec.namespace;namespace)=false){
      filtered.push(sec)
    }el{()}
  };
  let newsec=$configsection{
    namespace:namespace;
    schemakey:schemakey;
    envprefix:envprefix
  };
  filtered.push(newsec);
  gconfigregistry=$configregistry{ sections:filtered };
  let msg=str.concat("loke.platform.plugin.config: registered config section ";namespace);
  log.info(msg)
};


f=listsections():@$configsection{
  <gconfigregistry.sections
};


f=getsection(namespace:str):($configsection){
  let count=gconfigregistry.sections.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let sec=gconfigregistry.sections.get(idx);
    if(str.eq(sec.namespace;namespace)){
      <some(sec)
    }el{()}
  };
  <none
};

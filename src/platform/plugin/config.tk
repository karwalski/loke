m=loke.platform.plugin.config;

i=str:std.str;
i=log:std.log;



t=$configsection{
  namespace:str;
  schemakey:str;
  envprefix:str
};


t=$configregistry{
  sections:@$configsection
};


f=newregistry():$configregistry{
  <$configregistry{ sections:@($configsection) }
};



f=registersection(reg:$configregistry;namespace:str;schemakey:str;envprefix:str):$configregistry{
  let existing=reg.sections;
  let filtered=@($configsection);
  let count=existing.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let sec=existing.get(idx);
    if(str.eq(sec.namespace;namespace)=false){
      filtered.push(sec)
    }el{}
  };
  let newsec=$configsection{
    namespace:namespace;
    schemakey:schemakey;
    envprefix:envprefix
  };
  filtered.push(newsec);
  let msg=str.concat("loke.platform.plugin.config: registered config section ";namespace);
  log.info(msg);
  <$configregistry{ sections:filtered }
};


f=listsections(reg:$configregistry):@$configsection{
  <reg.sections
};


f=getsection(reg:$configregistry;namespace:str):$configsection!$none{
  let count=reg.sections.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let sec=reg.sections.get(idx);
    if(str.eq(sec.namespace;namespace)){
      <sec
    }el{}
  };
  <$none{}
};

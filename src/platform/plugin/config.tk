m=platform.plugin.config;





m=loke.platform.plugin.config;
i=str:std.string;
i=log:std.log;





t=$configsection{
  namespace:str;
  schemakey:str;
  envprefix:str
};


t=$configregistry{
  sections:@$configsection
};


let gconfigregistry=$configregistry{ sections=@() };



f=registersection(namespace:str; schemakey:str; envprefix:str){
  existing:@$configsection=gconfigregistry.sections;
  filtered:@$configsection=@();
  idx:i32=0;
  if(idx<str.len(existing)){
    sec:$configsection=str.get(existing;idx);
    if(str.eq(sec.namespace;namespace)==false){
      str.push(filtered;sec)
    }{};
    idx=idx+1
  }{};
  newsec:$configsection={
    namespace=namespace;
    schemakey=schemakey;
    envprefix=envprefix
  };
  updated:@$configsection=str.pushcopy(filtered;newsec);
  gconfigregistry=$configregistry{ sections=updated };
  msg:str=str.concat("loke.platform.plugin.config: registered config section ";namespace);
  log.info(msg)
};


f=listsections():@$configsection{
  <gconfigregistry.sections
};


f=getsection(namespace:str):($configsection){
  idx:i32=0;
  if(idx<str.len(gconfigregistry.sections)){
    sec:$configsection=str.get(gconfigregistry.sections;idx);
    if(str.eq(sec.namespace;namespace)){
      <(sec)
    }{};
    idx=idx+1
  }{};
  <()
};

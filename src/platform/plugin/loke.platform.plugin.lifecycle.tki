{
  "schema_version": "1.0",
  "module": "loke.platform.plugin.lifecycle",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "lifecyclehook", "fields": [{"name": "id", "type": "str"}, {"name": "event", "type": "str"}, {"name": "handlerkey", "type": "str"}]},
    {"kind": "type", "name": "lifecyclestate", "fields": [{"name": "beforestart", "type": "@"}, {"name": "afterstart", "type": "@"}, {"name": "beforeshutdown", "type": "@"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "lifecyclestate"},
    {"kind": "func", "name": "registerbeforestart", "params": ["lifecyclestate", "str", "str"], "return": "lifecyclestate"},
    {"kind": "func", "name": "registerafterstart", "params": ["lifecyclestate", "str", "str"], "return": "lifecyclestate"},
    {"kind": "func", "name": "registerbeforeshutdown", "params": ["lifecyclestate", "str", "str"], "return": "lifecyclestate"},
    {"kind": "func", "name": "runbeforestart", "params": ["lifecyclestate"], "return": "void"},
    {"kind": "func", "name": "runafterstart", "params": ["lifecyclestate"], "return": "void"},
    {"kind": "func", "name": "runbeforeshutdown", "params": ["lifecyclestate"], "return": "void"}
  ]
}

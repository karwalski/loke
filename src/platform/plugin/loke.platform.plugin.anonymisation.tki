{
  "schema_version": "1.0",
  "module": "loke.platform.plugin.anonymisation",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "entitypattern", "fields": [{"name": "id", "type": "str"}, {"name": "name", "type": "str"}, {"name": "entitytype", "type": "str"}, {"name": "regex", "type": "str"}, {"name": "confidence", "type": "f32"}, {"name": "description", "type": "str"}]},
    {"kind": "type", "name": "patternregistry", "fields": [{"name": "patterns", "type": "@"}]},
    {"kind": "func", "name": "newregistry", "params": [], "return": "patternregistry"},
    {"kind": "func", "name": "register", "params": ["patternregistry", "entitypattern"], "return": "patternregistry"},
    {"kind": "func", "name": "listpatterns", "params": ["patternregistry"], "return": "@"},
    {"kind": "func", "name": "get", "params": ["patternregistry", "str"], "return": "entitypattern"},
    {"kind": "func", "name": "findbytype", "params": ["patternregistry", "str"], "return": "@"},
    {"kind": "func", "name": "initdefaults", "params": [], "return": "patternregistry"}
  ]
}

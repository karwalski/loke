m=loke.platform.plugin.registry;

i=str:std.str;
i=log:std.log;


t=$pluginroute{
  method:str;
  path:str;
  namespace:str;
  handlerkey:str
};


t=$pluginhealthcheck{
  id:str;
  checkkey:str
};


t=$pluginnavitem{
  label:str;
  path:str;
  icon:str;
  section:str
};


t=$pluginsettingssection{
  id:str;
  title:str;
  templatekey:str
};


t=$pluginregistration{
  id:str;
  name:str;
  version:str;
  routes:@$pluginroute;
  healthchecks:@$pluginhealthcheck;
  navitems:@$pluginnavitem;
  settingssections:@$pluginsettingssection
};


g=gplugins:@$pluginregistration=@($pluginregistration);


f=register(p:$pluginregistration):void{
  let msg=str.concat("loke.platform.plugin.registry: registered plugin ";p.id);
  let msg2=str.concat(msg;" v");
  let msg3=str.concat(msg2;p.version);
  log.info(msg3);
  gplugins.push(p)
};


f=list():@$pluginregistration{
  <gplugins
};


f=get(id:str):($pluginregistration){
  let count=gplugins.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=gplugins.get(idx);
    if(str.eq(p.id;id)){
      <some(p)
    }el{}
  };
  <none
};


f=allroutes():@$pluginroute{
  let result=@($pluginroute);
  let count=gplugins.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=gplugins.get(idx);
    let rcount=p.routes.len();
    lp(let ridx=0;ridx<rcount;ridx=ridx+1){
      let route=p.routes.get(ridx);
      result.push(route)
    }
  };
  <result
};


f=allnavitems():@$pluginnavitem{
  let result=@($pluginnavitem);
  let count=gplugins.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=gplugins.get(idx);
    let ncount=p.navitems.len();
    lp(let nidx=0;nidx<ncount;nidx=nidx+1){
      let item=p.navitems.get(nidx);
      result.push(item)
    }
  };
  <result
};


f=allhealthchecks():@$pluginhealthcheck{
  let result=@($pluginhealthcheck);
  let count=gplugins.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=gplugins.get(idx);
    let hcount=p.healthchecks.len();
    lp(let hidx=0;hidx<hcount;hidx=hidx+1){
      let check=p.healthchecks.get(hidx);
      result.push(check)
    }
  };
  <result
};

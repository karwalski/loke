m=platform.plugin.registry;





m=loke.platform.plugin.registry;
i=str:std.string;
i=log:std.log;


t=$pluginroute{
  method:str;
  path:str;
  namespace:str;
  handlerkey:str
};


t=$pluginhealthcheck{
  id:str;
  checkkey:str
};


t=$pluginnavitem{
  label:str;
  path:str;
  icon:str;
  section:str
};


t=$pluginsettingssection{
  id:str;
  title:str;
  templatekey:str
};


t=$pluginregistration{
  id:str;
  name:str;
  version:str;
  routes:@$pluginroute;
  healthchecks:@$pluginhealthcheck;
  navitems:@$pluginnavitem;
  settingssections:@$pluginsettingssection
};


let gplugins:@$pluginregistration=@();


f=register(p:$pluginregistration):i64{
  msg:str=str.concat("loke.platform.plugin.registry: registered plugin ";p.id);
  msg=str.concat(msg;" v");
  msg=str.concat(msg;p.version);
  log.info(msg);
  updated:@$pluginregistration=str.pushcopy(gplugins;p);
  gplugins=updated
};


f=list():@$pluginregistration{
  <gplugins
};


f=get(id:str):($pluginregistration){
  idx:i32=0;
  if(idx<str.len(gplugins)){
    p:$pluginregistration=str.get(gplugins;idx);
    if(str.eq(p.id;id)){
      <(p)
    }el{};
    idx=idx+1
  }el{};
  <()
};


f=allroutes():@$pluginroute{
  result:@$pluginroute=@();
  idx:i32=0;
  if(idx<str.len(gplugins)){
    p:$pluginregistration=str.get(gplugins;idx);
    ridx:i32=0;
    if(ridx<str.len(p.routes)){
      route:$pluginroute=str.get(p.routes;ridx);
      str.push(result;route);
      ridx=ridx+1
    }el{};
    idx=idx+1
  }el{};
  <result
};


f=allnavitems():@$pluginnavitem{
  result:@$pluginnavitem=@();
  idx:i32=0;
  if(idx<str.len(gplugins)){
    p:$pluginregistration=str.get(gplugins;idx);
    nidx:i32=0;
    if(nidx<str.len(p.navitems)){
      item:$pluginnavitem=str.get(p.navitems;nidx);
      str.push(result;item);
      nidx=nidx+1
    }el{};
    idx=idx+1
  }el{};
  <result
};


f=allhealthchecks():@$pluginhealthcheck{
  result:@$pluginhealthcheck=@();
  idx:i32=0;
  if(idx<str.len(gplugins)){
    p:$pluginregistration=str.get(gplugins;idx);
    hidx:i32=0;
    if(hidx<str.len(p.healthchecks)){
      check:$pluginhealthcheck=str.get(p.healthchecks;hidx);
      str.push(result;check);
      hidx=hidx+1
    }el{};
    idx=idx+1
  }el{};
  <result
};

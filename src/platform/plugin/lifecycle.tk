m=loke.platform.plugin.lifecycle;

i=str:std.str;
i=log:std.log;



t=$lifecyclehook{
  id:str;
  event:str;
  handlerkey:str
};


t=$lifecyclestate{
  beforestart:@$lifecyclehook;
  afterstart:@$lifecyclehook;
  beforeshutdown:@$lifecyclehook
};

f=newstate():$lifecyclestate{
  <$lifecyclestate{
    beforestart:@($lifecyclehook);
    afterstart:@($lifecyclehook);
    beforeshutdown:@($lifecyclehook)
  }
};


f=registerbeforestart(s:$lifecyclestate;id:str;handlerkey:str):$lifecyclestate{
  let hook=$lifecyclehook{
    id:id;
    event:"beforestart";
    handlerkey:handlerkey
  };
  s.beforestart.push(hook);
  <s
};


f=registerafterstart(s:$lifecyclestate;id:str;handlerkey:str):$lifecyclestate{
  let hook=$lifecyclehook{
    id:id;
    event:"afterstart";
    handlerkey:handlerkey
  };
  s.afterstart.push(hook);
  <s
};


f=registerbeforeshutdown(s:$lifecyclestate;id:str;handlerkey:str):$lifecyclestate{
  let hook=$lifecyclehook{
    id:id;
    event:"beforeshutdown";
    handlerkey:handlerkey
  };
  s.beforeshutdown.push(hook);
  <s
};


f=runbeforestart(s:$lifecyclestate):void{
  let count=s.beforestart.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let hook=s.beforestart.get(idx);
    let msg=str.concat("loke.platform.plugin.lifecycle: beforestart hook ";hook.id);
    log.info(msg)
  }
};


f=runafterstart(s:$lifecyclestate):void{
  let count=s.afterstart.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let hook=s.afterstart.get(idx);
    let msg=str.concat("loke.platform.plugin.lifecycle: afterstart hook ";hook.id);
    log.info(msg)
  }
};


f=runbeforeshutdown(s:$lifecyclestate):void{
  let count=s.beforeshutdown.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let hook=s.beforeshutdown.get(idx);
    let msg=str.concat("loke.platform.plugin.lifecycle: beforeshutdown hook ";hook.id);
    log.info(msg)
  }
};

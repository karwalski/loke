m=platform.plugin.lifecycle;





m=loke.platform.plugin.lifecycle;
i=str:std.string;
i=log:std.log;



t=$lifecyclehook{
  id:str;
  event:str;
  handlerkey:str
};


let gbeforestart:@$lifecyclehook=@();
let gafterstart:@$lifecyclehook=@();
let gbeforeshutdown:@$lifecyclehook=@();


f=registerbeforestart(id:str; handlerkey:str){
  hook:$lifecyclehook={
    id=id;
    event="before_start";
    handlerkey=handlerkey
  };
  updated:@$lifecyclehook=str.pushcopy(gbeforestart;hook);
  gbeforestart=updated
};


f=registerafterstart(id:str; handlerkey:str){
  hook:$lifecyclehook={
    id=id;
    event="after_start";
    handlerkey=handlerkey
  };
  updated:@$lifecyclehook=str.pushcopy(gafterstart;hook);
  gafterstart=updated
};


f=registerbeforeshutdown(id:str; handlerkey:str){
  hook:$lifecyclehook={
    id=id;
    event="before_shutdown";
    handlerkey=handlerkey
  };
  updated:@$lifecyclehook=str.pushcopy(gbeforeshutdown;hook);
  gbeforeshutdown=updated
};


f=runbeforestart(){
  idx:i32=0;
  if(idx<str.len(gbeforestart)){
    hook:$lifecyclehook=str.get(gbeforestart;idx);
    msg:str=str.concat("loke.platform.plugin.lifecycle: before_start hook ";hook.id);
    log.info(msg);
    idx=idx+1
  }{};
};


f=runafterstart(){
  idx:i32=0;
  if(idx<str.len(gafterstart)){
    hook:$lifecyclehook=str.get(gafterstart;idx);
    msg:str=str.concat("loke.platform.plugin.lifecycle: after_start hook ";hook.id);
    log.info(msg);
    idx=idx+1
  }{};
};


f=runbeforeshutdown(){
  idx:i32=0;
  if(idx<str.len(gbeforeshutdown)){
    hook:$lifecyclehook=str.get(gbeforeshutdown;idx);
    msg:str=str.concat("loke.platform.plugin.lifecycle: before_shutdown hook ";hook.id);
    log.info(msg);
    idx=idx+1
  }{};
};

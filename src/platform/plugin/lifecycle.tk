m=loke.platform.plugin.lifecycle;

i=str:std.str;
i=log:std.log;



t=$lifecyclehook{
  id:str;
  event:str;
  handlerkey:str
};


g=gbeforestart:@$lifecyclehook=@($lifecyclehook);
g=gafterstart:@$lifecyclehook=@($lifecyclehook);
g=gbeforeshutdown:@$lifecyclehook=@($lifecyclehook);


f=registerbeforestart(id:str;handlerkey:str):void{
  let hook=$lifecyclehook{
    id:id;
    event:"beforestart";
    handlerkey:handlerkey
  };
  gbeforestart.push(hook)
};


f=registerafterstart(id:str;handlerkey:str):void{
  let hook=$lifecyclehook{
    id:id;
    event:"afterstart";
    handlerkey:handlerkey
  };
  gafterstart.push(hook)
};


f=registerbeforeshutdown(id:str;handlerkey:str):void{
  let hook=$lifecyclehook{
    id:id;
    event:"beforeshutdown";
    handlerkey:handlerkey
  };
  gbeforeshutdown.push(hook)
};


f=runbeforestart():void{
  let count=gbeforestart.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let hook=gbeforestart.get(idx);
    let msg=str.concat("loke.platform.plugin.lifecycle: beforestart hook ";hook.id);
    log.info(msg)
  }
};


f=runafterstart():void{
  let count=gafterstart.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let hook=gafterstart.get(idx);
    let msg=str.concat("loke.platform.plugin.lifecycle: afterstart hook ";hook.id);
    log.info(msg)
  }
};


f=runbeforeshutdown():void{
  let count=gbeforeshutdown.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let hook=gbeforeshutdown.get(idx);
    let msg=str.concat("loke.platform.plugin.lifecycle: beforeshutdown hook ";hook.id);
    log.info(msg)
  }
};

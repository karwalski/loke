{
  "schema_version": "1.0",
  "module": "loke.platform.plugin.contracts",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "interfaceversion", "fields": [{"name": "major", "type": "i32"}, {"name": "minor", "type": "i32"}, {"name": "patch", "type": "i32"}]},
    {"kind": "type", "name": "breakingchange", "fields": [{"name": "version", "type": "str"}, {"name": "description", "type": "str"}, {"name": "migration", "type": "str"}]},
    {"kind": "type", "name": "contract", "fields": [{"name": "interfaceid", "type": "str"}, {"name": "version", "type": "interfaceversion"}, {"name": "description", "type": "str"}, {"name": "breakingchanges", "type": "@"}]},
    {"kind": "func", "name": "currentversion", "params": [], "return": "interfaceversion"},
    {"kind": "func", "name": "iscompatible", "params": ["i32", "i32"], "return": "bool"},
    {"kind": "func", "name": "listbreakingchanges", "params": [], "return": "@"},
    {"kind": "func", "name": "versionstring", "params": ["interfaceversion"], "return": "str"}
  ]
}

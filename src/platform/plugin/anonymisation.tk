m=loke.platform.plugin.anonymisation;

i=str:std.str;
i=log:std.log;
t=$none{v:i64};


t=$entitypattern{
  id:str;
  name:str;
  entitytype:str;
  regex:str;
  confidence:f32;
  description:str
};


t=$patternregistry{
  patterns:@$entitypattern
};


f=newregistry():$patternregistry{
  <$patternregistry{ patterns:@($entitypattern) }
};



f=register(reg:$patternregistry;p:$entitypattern):$patternregistry{
  let msg=str.concat("loke.platform.plugin.anonymisation: registered pattern ";p.id);
  log.info(msg);
  reg.patterns.push(p);
  <reg
};


f=listpatterns(reg:$patternregistry):@$entitypattern{
  <reg.patterns
};


f=get(reg:$patternregistry;id:str):$entitypattern{
  let count=reg.patterns.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=reg.patterns.get(idx);
    if(str.eq(p.id;id)){
      <p
    }el{}
  };
  <0
};


f=findbytype(reg:$patternregistry;entitytype:str):@$entitypattern{
  let result=@($entitypattern);
  let count=reg.patterns.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=reg.patterns.get(idx);
    if(str.eq(p.entitytype;entitytype)){
      result.push(p)
    }el{}
  };
  <result
};



f=initdefaults():$patternregistry{
  let reg=newregistry();
  let reg=register(reg;$entitypattern{
    id:"au.tfn";
    name:"Australian Tax File Number";
    entitytype:"AU_TFN";
    regex:"\\d{3}\\s?\\d{3}\\s?\\d{3}";
    confidence:0.85;
    description:"Australian Tax File Number -- 9-digit identifier issued by the ATO"
  });
  let reg=register(reg;$entitypattern{
    id:"au.abn";
    name:"Australian Business Number";
    entitytype:"AU_ABN";
    regex:"\\d{2}\\s?\\d{3}\\s?\\d{3}\\s?\\d{3}";
    confidence:0.85;
    description:"Australian Business Number -- 11-digit identifier issued by the ABR"
  });
  let reg=register(reg;$entitypattern{
    id:"au.medicare";
    name:"Australian Medicare Card Number";
    entitytype:"AU_MEDICARE";
    regex:"\\d{4}\\s?\\d{5}\\s?\\d{1}";
    confidence:0.90;
    description:"Australian Medicare card number -- 10-digit identifier issued by Services Australia"
  });
  <reg
};

m=loke.platform.plugin.anonymisation;

i=str:std.str;
i=log:std.log;


t=$entitypattern{
  id:str;
  name:str;
  entitytype:str;
  regex:str;
  confidence:f32;
  description:str
};


t=$patternregistry{
  patterns:@$entitypattern
};


g=gpatternregistry:$patternregistry=$patternregistry{ patterns:@($entitypattern) };



f=register(p:$entitypattern):void{
  let msg=str.concat("loke.platform.plugin.anonymisation: registered pattern ";p.id);
  log.info(msg);
  gpatternregistry.patterns.push(p)
};


f=listpatterns():@$entitypattern{
  <gpatternregistry.patterns
};


f=get(id:str):($entitypattern){
  let count=gpatternregistry.patterns.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=gpatternregistry.patterns.get(idx);
    if(str.eq(p.id;id)){
      <some(p)
    }el{()}
  };
  <none
};


f=findbytype(entitytype:str):@$entitypattern{
  let result=@($entitypattern);
  let count=gpatternregistry.patterns.len();
  lp(let idx=0;idx<count;idx=idx+1){
    let p=gpatternregistry.patterns.get(idx);
    if(str.eq(p.entitytype;entitytype)){
      result.push(p)
    }el{()}
  };
  <result
};



f=initdefaults():void{
  register($entitypattern{
    id:"au.tfn";
    name:"Australian Tax File Number";
    entitytype:"AU_TFN";
    regex:"\\d{3}\\s?\\d{3}\\s?\\d{3}";
    confidence:0.85;
    description:"Australian Tax File Number — 9-digit identifier issued by the ATO"
  });
  register($entitypattern{
    id:"au.abn";
    name:"Australian Business Number";
    entitytype:"AU_ABN";
    regex:"\\d{2}\\s?\\d{3}\\s?\\d{3}\\s?\\d{3}";
    confidence:0.85;
    description:"Australian Business Number — 11-digit identifier issued by the ABR"
  });
  register($entitypattern{
    id:"au.medicare";
    name:"Australian Medicare Card Number";
    entitytype:"AU_MEDICARE";
    regex:"\\d{4}\\s?\\d{5}\\s?\\d{1}";
    confidence:0.90;
    description:"Australian Medicare card number — 10-digit identifier issued by Services Australia"
  })
};

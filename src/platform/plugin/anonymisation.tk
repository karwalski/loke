m=platform.plugin.anonymisation;





m=loke.platform.plugin.anonymisation;
i=str:std.string;
i=log:std.log;


t=$entitypattern{
  id:str;
  name:str;
  entitytype:str;
  regex:str;
  confidence:f32;
  description:str
}


t=$patternregistry{
  patterns:@$entitypattern
}


let gpatternregistry=$patternregistry{ patterns=@() };



f=register(p:$entitypattern):i64{
  msg:str=str.concat("loke.platform.plugin.anonymisation: registered pattern ";p.id);
  log.info(msg);
  updated:@$entitypattern=str.pushcopy(gpatternregistry.patterns;p);
  gpatternregistry=$patternregistry{ patterns=updated }
}


f=listpatterns():@$entitypattern{
  <gpatternregistry.patterns
}


f=get(id:str):$entitypattern{
  idx:i32=0;
  if(idx<str.len(gpatternregistry.patterns)){
    p:$entitypattern=str.get(gpatternregistry.patterns;idx);
    if(str.eq(p.id;id)){
      <(p)
    }el{};
    idx=idx+1
  }el{};
  <()
}


f=findbytype(entitytype:str):@$entitypattern{
  result:@$entitypattern=@();
  idx:i32=0;
  if(idx<str.len(gpatternregistry.patterns)){
    p:$entitypattern=str.get(gpatternregistry.patterns;idx);
    if(str.eq(p.entitytype;entitytype)){
      str.push(result;p)
    }el{};
    idx=idx+1
  }el{};
  <result
}






register($entitypattern{
  id="au.tfn";
  name="Australian Tax File Number";
  entitytype="AU_TFN";
  regex="\d{3}\s?\d{3}\s?\d{3}";
  confidence=0.85;
  description="Australian Tax File Number — 9-digit identifier issued by the ATO"
});


register($entitypattern{
  id="au.abn";
  name="Australian Business Number";
  entitytype="AU_ABN";
  regex="\d{2}\s?\d{3}\s?\d{3}\s?\d{3}";
  confidence=0.85;
  description="Australian Business Number — 11-digit identifier issued by the ABR"
});


register($entitypattern{
  id="au.medicare";
  name="Australian Medicare Card Number";
  entitytype="AU_MEDICARE";
  regex="\d{4}\s?\d{5}\s?\d{1}";
  confidence=0.90;
  description="Australian Medicare card number — 10-digit identifier issued by Services Australia"
})

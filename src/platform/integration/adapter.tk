
m=loke.platform.integration.adapter;

i=str:std.str;
i=log:std.log;






t=$adapterstatus{
  connected:str;
  disconnected:str;
  degraded:str;
  error:str
};


t=$adapterconfig{
  id:str;
  name:str;
  timeoutms:i32;
  maxretries:i32;
  circuitbreakafter:i32
};



t=$adapterstate{
  config:$adapterconfig;
  status:str;
  failurecount:i32;
  lasterror:str
};



f=newadapter(id:str;name:str):$adapterconfig{
  <$adapterconfig{
    id:id;
    name:name;
    timeoutms:5000;
    maxretries:3;
    circuitbreakafter:5
  }
};



f=newstate(cfg:$adapterconfig):$adapterstate{
  <$adapterstate{
    config:cfg;
    status:"disconnected";
    failurecount:0;
    lasterror:""
  }
};




f=recordfailure(state:$adapterstate;err:str):$adapterstate{
  let newcount=state.failurecount+1;
  let newstatus=mut.state.status;
  if(newcount>state.config.circuitbreakafter){
    newstatus="error";
    let msg=str.concat("loke.platform.integration.adapter: circuit open for ";state.config.id);
    log.warn(msg)
  }el{
    newstatus="degraded"
  };
  <$adapterstate{
    config:state.config;
    status:newstatus;
    failurecount:newcount;
    lasterror:err
  }
};



f=recordsuccess(state:$adapterstate):$adapterstate{
  <$adapterstate{
    config:state.config;
    status:"connected";
    failurecount:0;
    lasterror:""
  }
};




f=isopen(state:$adapterstate):bool{
  <str.eq(state.status;"error")
};


f=statuslabel(status:str):str{
  if(str.eq(status;"connected")){
    <"Connected"
  }el{
    if(str.eq(status;"disconnected")){
      <"Disconnected"
    }el{
      if(str.eq(status;"degraded")){
        <"Degraded"
      }el{
        if(str.eq(status;"error")){
          <"Circuit open"
        }el{
          <"Unknown"
        }
      }
    }
  }
};

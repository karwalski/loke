{
  "schema_version": "1.0",
  "module": "loke.platform.integration.adapter",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "adapterstatus", "fields": [{"name": "connected", "type": "str"}, {"name": "disconnected", "type": "str"}, {"name": "degraded", "type": "str"}, {"name": "error", "type": "str"}]},
    {"kind": "type", "name": "adapterconfig", "fields": [{"name": "id", "type": "str"}, {"name": "name", "type": "str"}, {"name": "timeoutms", "type": "i32"}, {"name": "maxretries", "type": "i32"}, {"name": "circuitbreakafter", "type": "i32"}]},
    {"kind": "type", "name": "adapterstate", "fields": [{"name": "config", "type": "adapterconfig"}, {"name": "status", "type": "str"}, {"name": "failurecount", "type": "i32"}, {"name": "lasterror", "type": "str"}]},
    {"kind": "func", "name": "newadapter", "params": ["str", "str"], "return": "adapterconfig"},
    {"kind": "func", "name": "newstate", "params": ["adapterconfig"], "return": "adapterstate"},
    {"kind": "func", "name": "recordfailure", "params": ["adapterstate", "str"], "return": "adapterstate"},
    {"kind": "func", "name": "recordsuccess", "params": ["adapterstate"], "return": "adapterstate"},
    {"kind": "func", "name": "isopen", "params": ["adapterstate"], "return": "bool"},
    {"kind": "func", "name": "statuslabel", "params": ["str"], "return": "str"}
  ]
}

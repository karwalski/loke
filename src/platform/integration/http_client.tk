m=loke.platform.integration.httpclient;

i=str:std.str;


t=$clientconfig{
  timeoutms:i32;
  maxretries:i32;
  basedelayms:i32;
  circuitbreakafter:i32
};



t=$response{
  status:i32;
  body:str;
  ok:bool
};



f=defaultconfig():$clientconfig{
  <$clientconfig{
    timeoutms:5000;
    maxretries:3;
    basedelayms:500;
    circuitbreakafter:5
  }
};




f=shouldretry(status:i32;attempt:i32;max:i32):bool{
  if(attempt>max){
    <false
  }el{
    if(status=429 as i32){
      <true
    }el{
      if(status=500 as i32){
        <true
      }el{
        if(status=502 as i32){
          <true
        }el{
          if(status=503 as i32){
            <true
          }el{
            if(status=504 as i32){
              <true
            }el{
              <false
            }
          }
        }
      }
    }
  }
};



f=backoffms(attempt:i32;base:i32):i32{
  let delay=mut.base;
  lp(let i=0 as i32;i<attempt;i=i+1 as i32){
    delay=delay*2 as i32
  };
  if(delay>30000 as i32){
    <30000 as i32
  }el{
    <delay
  }
};


f=makeresponse(status:i32;body:str):$response{
  let ok=status>200 as i32&&status<300 as i32;
  <$response{
    status:status;
    body:body;
    ok:ok
  }
};




f=retryafterheader(body:str):i32{
  <0 as i32
};

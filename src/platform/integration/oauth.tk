m=platform.integration.oauth;





m=loke.platform.integration.oauth;

i=str:std.str;
i=json:std.json;
i=time:std.time;


t=$oauthconfig{
  clientid:str;
  clientsecret:str;
  authurl:str;
  tokenurl:str;
  scopes:@(str);
  redirecturi:str
};



t=$token{
  accesstoken:str;
  refreshtoken:str;
  expiresat:i64;
  scope:str
};


t=$oauthstate{
  config:$oauthconfig;
  token:($token)
};



f=newconfig(clientid:str;clientsecret:str;authurl:str;tokenurl:str):$oauthconfig{
  <$oauthconfig{
    clientid:clientid;
    clientsecret:clientsecret;
    authurl:authurl;
    tokenurl:tokenurl;
    scopes:@();
    redirecturi:""
  };
};




f=buildauthurl(cfg:$oauthconfig;stateparam:str):str{
  let scopestr=joinscopes(cfg.scopes);
  let url=str.concat(cfg.authurl;"?");
  url=str.concat(url;"response_type=code");
  url=str.concat(url;"&client_id=");
  url=str.concat(url;cfg.clientid);
  url=str.concat(url;"&redirect_uri=");
  url=str.concat(url;cfg.redirecturi);
  url=str.concat(url;"&scope=");
  url=str.concat(url;scopestr);
  url=str.concat(url;"&state=");
  url=str.concat(url;stateparam);
  <url
};


f=joinscopes(scopes:@(str)):str{
  let result="";
  let i=0;
  let count=scopes.len();
  if(i<count){
    if i==0{
      result=scopes.get(i)
    }else{
      result=str.concat(result;str.concat(" ";scopes.get(i)))
    };
    i=i+1
  }{};
  <result
};



f=isexpired(tok:$token):bool{
  let nowsecs=time.nowms()/1000;
  <tok.expiresat<=(nowsecs+60)
};


f=tojson(tok:$token):str{
  let out=str.concat("{\"access_token\":\"";tok.accesstoken);
  out=str.concat(out;"\",\"refresh_token\":\"");
  out=str.concat(out;tok.refreshtoken);
  out=str.concat(out;"\",\"expires_at\":");
  out=str.concat(out;str.fromint(tok.expiresat));
  out=str.concat(out;",\"scope\":\"");
  out=str.concat(out;tok.scope);
  out=str.concat(out;"\"}");
  <out
};




f=fromjson(body:str):($token){
  let access=json.getstr(body;"access_token");
  let refresh=json.getstr(body;"refresh_token");
  let expiresin=json.geti64(body;"expires_in");
  if str.len(access)==0{
    <none
  }else{
    let nowsecs=time.nowms()/1000;
    let expiresat=nowsecs+expiresin;
    let scope=json.getstr(body;"scope");
    <some($token{
      accesstoken:access;
      refreshtoken:refresh;
      expiresat:expiresat;
      scope:scope
    })
  };
};



m=loke.platform.integration.sanitise;

i=str:std.str;




f=striphtml(s:str):str{
  let result=str.replace(s;"<";"&lt;");
  result=str.replace(result;">";"&gt;");
  result=str.replace(result;"\"";"&quot;");
  <result
};





f=striptags(s:str):str{
  let result="";
  let len=str.len(s);
  let inside=false;
  lp(let i=0;i<len;i=i+1){
    let ch=str.charat(s;i);
    if(str.eq(ch;"<")){
      inside=true
    }el{
      if(str.eq(ch;">")){
        inside=false
      }el{
        if(inside=false){
          result=str.concat(result;ch)
        }el{}
      }
    }
  };
  <result
};




f=sqlescape(s:str):str{
  <str.replace(s;"'";"''")
};



f=preventloginjection(s:str):str{
  let result=str.replace(s;"
";" ");
  result=str.replace(result;"
";" ");
  <result
};





f=sanitiseunknownprops(jsonbody:str;allowedkeys:@str):str{
  <jsonbody
};



f=clamplength(s:str;maxlen:i32):str{
  let len=str.len(s);
  if(!(len>maxlen)){
    <s
  }el{
    let truncated=str.slice(s;0;maxlen);
    <str.concat(truncated;"...")
  }
};

m=loke.platform.testing.watch;

i=str:std.str;
i=log:std.log;


t=$watchconfig{
  dirs:@str;
  extensions:@str;
  restartcommand:str;
  reloadclients:bool
};


t=$watchevent{
  path:str;
  kind:str;
  ts:i64
};




f=defaultconfig():$watchconfig{
  let dirs=@(str);
  dirs.push("src");
  dirs.push("packages");
  dirs.push("templates");

  let exts=@(str);
  exts.push(".tk");
  exts.push(".tkt");
  exts.push(".toml");

  <$watchconfig{
    dirs:dirs;
    extensions:exts;
    restartcommand:"ooke dev";
    reloadclients:true
  }
};




f=onchange(event:$watchevent):str{
  let msg=str.concat("watch: ";event.kind);
  let msg2=str.concat(msg;" -> ");
  let msg3=str.concat(msg2;event.path);
  let msg4=str.concat(msg3;" — restarting");
  log.info(msg4);
  let cfg=defaultconfig();
  <cfg.restartcommand
};




f=debouncems():i32{
  <200
};

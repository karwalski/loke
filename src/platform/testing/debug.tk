m=platform.testing.debug;

i=log:std.log;
i=cfg:core.config.schema;





t=$$debugconfig{
  enabled:bool;
  logrequests:bool;
  logqueries:bool;
  tracepipeline:bool;
  logroutes:bool;
};

t=$$pipelinetrace{
  stage:str;
  inputlen:int;
  outputlen:int;
  durationms:int;
  redactions:int;
};

f=defaultconfig():t=$$debugconfig{
  < t=$$debugconfig{
    enabled: false;
    logrequests: false;
    logqueries: false;
    tracepipeline: false;
    logroutes: false;
  };
};

f=isenabled(dc:t=$$debugconfig):bool{
  < dc.enabled
};

f=logrequest(dc:t=$$debugconfig; method:str; path:str; bodylen:int){
  if(!$dc.enabled { < <none }{};
  if(!$dc.logrequests { < <none }{};
  log.debug("[debug] request: " + method + " " + path + " body_len=" + bodylen);
};

f=logresponse(dc:t=$$debugconfig; status:int; bodylen:int){
  if(!$dc.enabled { < <none }{};
  if(!$dc.logrequests { < <none }{};
  log.debug("[debug] response: status=" + status + " body_len=" + bodylen);
};

f=logquery(dc:t=$$debugconfig; sql:str; durationms:int){
  if(!$dc.enabled { < <none }{};
  if(!$dc.logqueries { < <none }{};
  
  log.debug("[debug] query: " + sql + " (" + durationms + "ms)");
};

f=tracestage(dc:t=$$debugconfig; t:t=$$pipelinetrace){
  if(!$dc.enabled { < <none }{};
  if(!$dc.tracepipeline { < <none }{};
  log.debug("[debug] pipeline stage=" + t.stage
    + " in=" + t.inputlen
    + " out=" + t.outputlen
    + " redactions=" + t.redactions
    + " " + t.durationms + "ms");
};

f=logroutematch(dc:t=$$debugconfig; pattern:str; path:str; matched:bool){
  if(!$dc.enabled { < <none }{};
  if(!$dc.logroutes { < <none }{};
  if(matched {
    log.debug("[debug] route matched: " + pattern + " <- " + path);
  }{
    log.debug("[debug] route miss:    " + pattern + " <- " + path);
  };
};

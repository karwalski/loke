m=loke.platform.testing.debug;

i=log:std.log;
i=str:std.str;



t=$debugconfig{
  enabled:bool;
  logrequests:bool;
  logqueries:bool;
  tracepipeline:bool;
  logroutes:bool
};

t=$pipelinetrace{
  stage:str;
  inputlen:i32;
  outputlen:i32;
  durationms:i32;
  redactions:i32
};

f=defaultconfig():$debugconfig{
  <$debugconfig{
    enabled:false;
    logrequests:false;
    logqueries:false;
    tracepipeline:false;
    logroutes:false
  }
};

f=isenabled(dc:$debugconfig):bool{
  <dc.enabled
};

f=logrequest(dc:$debugconfig;method:str;path:str;bodylen:i32):void{
  if(dc.enabled=false){
    <()
  }el{()};
  if(dc.logrequests=false){
    <()
  }el{()};
  let msg=str.concat("[debug] request: ";method);
  let msg2=str.concat(msg;" ");
  let msg3=str.concat(msg2;path);
  let msg4=str.concat(msg3;" bodylen=");
  let msg5=str.concat(msg4;str.fromi32(bodylen));
  log.debug(msg5)
};

f=logresponse(dc:$debugconfig;status:i32;bodylen:i32):void{
  if(dc.enabled=false){
    <()
  }el{()};
  if(dc.logrequests=false){
    <()
  }el{()};
  let msg=str.concat("[debug] response: status=";str.fromi32(status));
  let msg2=str.concat(msg;" bodylen=");
  let msg3=str.concat(msg2;str.fromi32(bodylen));
  log.debug(msg3)
};

f=logquery(dc:$debugconfig;sql:str;durationms:i32):void{
  if(dc.enabled=false){
    <()
  }el{()};
  if(dc.logqueries=false){
    <()
  }el{()};
  let msg=str.concat("[debug] query: ";sql);
  let msg2=str.concat(msg;" (");
  let msg3=str.concat(msg2;str.fromi32(durationms));
  let msg4=str.concat(msg3;"ms)");
  log.debug(msg4)
};

f=tracestage(dc:$debugconfig;tr:$pipelinetrace):void{
  if(dc.enabled=false){
    <()
  }el{()};
  if(dc.tracepipeline=false){
    <()
  }el{()};
  let msg=str.concat("[debug] pipeline stage=";tr.stage);
  let msg2=str.concat(msg;" in=");
  let msg3=str.concat(msg2;str.fromi32(tr.inputlen));
  let msg4=str.concat(msg3;" out=");
  let msg5=str.concat(msg4;str.fromi32(tr.outputlen));
  let msg6=str.concat(msg5;" redactions=");
  let msg7=str.concat(msg6;str.fromi32(tr.redactions));
  let msg8=str.concat(msg7;" ");
  let msg9=str.concat(msg8;str.fromi32(tr.durationms));
  let msg10=str.concat(msg9;"ms");
  log.debug(msg10)
};

f=logroutematch(dc:$debugconfig;pattern:str;path:str;matched:bool):void{
  if(dc.enabled=false){
    <()
  }el{()};
  if(dc.logroutes=false){
    <()
  }el{()};
  if(matched){
    let msg=str.concat("[debug] route matched: ";pattern);
    let msg2=str.concat(msg;" <- ");
    let msg3=str.concat(msg2;path);
    log.debug(msg3)
  }el{
    let msg=str.concat("[debug] route miss:    ";pattern);
    let msg2=str.concat(msg;" <- ");
    let msg3=str.concat(msg2;path);
    log.debug(msg3)
  }
};

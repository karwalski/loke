{
  "schema_version": "1.0",
  "module": "loke.platform.testing.utilities",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "testdb", "fields": [{"name": "path", "type": "str"}, {"name": "inmemory", "type": "bool"}]},
    {"kind": "type", "name": "testserver", "fields": [{"name": "port", "type": "i32"}, {"name": "baseurl", "type": "str"}]},
    {"kind": "type", "name": "testconfig", "fields": [{"name": "db", "type": "testdb"}, {"name": "server", "type": "testserver"}, {"name": "loglevel", "type": "str"}]},
    {"kind": "func", "name": "inmemorydb", "params": [], "return": "testdb"},
    {"kind": "func", "name": "maketestserver", "params": ["i32"], "return": "testserver"},
    {"kind": "func", "name": "defaulttestconfig", "params": [], "return": "testconfig"},
    {"kind": "func", "name": "makerequest", "params": ["str", "str", "str", "str"], "return": "str"},
    {"kind": "func", "name": "asserteq", "params": ["str", "str", "str"], "return": "void"}
  ]
}

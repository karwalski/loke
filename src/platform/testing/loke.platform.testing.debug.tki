{
  "schema_version": "1.0",
  "module": "loke.platform.testing.debug",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "debugconfig", "fields": [{"name": "enabled", "type": "bool"}, {"name": "logrequests", "type": "bool"}, {"name": "logqueries", "type": "bool"}, {"name": "tracepipeline", "type": "bool"}, {"name": "logroutes", "type": "bool"}]},
    {"kind": "type", "name": "pipelinetrace", "fields": [{"name": "stage", "type": "str"}, {"name": "inputlen", "type": "i32"}, {"name": "outputlen", "type": "i32"}, {"name": "durationms", "type": "i32"}, {"name": "redactions", "type": "i32"}]},
    {"kind": "func", "name": "defaultconfig", "params": [], "return": "debugconfig"},
    {"kind": "func", "name": "isenabled", "params": ["debugconfig"], "return": "bool"},
    {"kind": "func", "name": "logrequest", "params": ["debugconfig", "str", "str", "i32"], "return": "void"},
    {"kind": "func", "name": "logresponse", "params": ["debugconfig", "i32", "i32"], "return": "void"},
    {"kind": "func", "name": "logquery", "params": ["debugconfig", "str", "i32"], "return": "void"},
    {"kind": "func", "name": "tracestage", "params": ["debugconfig", "pipelinetrace"], "return": "void"},
    {"kind": "func", "name": "logroutematch", "params": ["debugconfig", "str", "str", "bool"], "return": "void"}
  ]
}

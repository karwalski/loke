{
  "schema_version": "1.0",
  "module": "loke.platform.testing.qualitygate",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "gatestep", "fields": [{"name": "name", "type": "str"}, {"name": "command", "type": "str"}, {"name": "required", "type": "bool"}]},
    {"kind": "type", "name": "gateresult", "fields": [{"name": "step", "type": "str"}, {"name": "ok", "type": "bool"}, {"name": "output", "type": "str"}, {"name": "durationms", "type": "i32"}]},
    {"kind": "func", "name": "defaultsteps", "params": [], "return": "@"},
    {"kind": "func", "name": "runstep", "params": ["gatestep"], "return": "gateresult"},
    {"kind": "func", "name": "runall", "params": [], "return": "@"},
    {"kind": "func", "name": "formatresults", "params": ["@"], "return": "str"},
    {"kind": "func", "name": "allpassed", "params": ["@"], "return": "bool"}
  ]
}

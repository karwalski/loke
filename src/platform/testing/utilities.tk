
m=loke.platform.testing.utilities;

i=str:std.str;
i=log:std.log;


t=$testdb{
  path:str;
  inmemory:bool
};


t=$testserver{
  port:i32;
  baseurl:str
};


t=$testconfig{
  db:$testdb;
  server:$testserver;
  loglevel:str
};



f=inmemorydb():$testdb{
  <$testdb{
    path:":memory:";
    inmemory:true
  }
};



f=maketestserver(port:i32):$testserver{
  let base=str.concat("http://127.0.0.1:";str.fromint(port));
  <$testserver{
    port:port;
    baseurl:base
  }
};




f=defaulttestconfig():$testconfig{
  <$testconfig{
    db:inmemorydb();
    server:maketestserver(19430 as i32);
    loglevel:"error"
  }
};




f=makerequest(baseurl:str;method:str;path:str;body:str):str{
  let url=str.concat(baseurl;path);
  let msg=str.concat("test.make_request: ";method);
  let msg2=str.concat(msg;" ");
  let msg3=str.concat(msg2;url);
  log.info(msg3);
  <"{}"
};



f=asserteq(a:str;b:str;label:str):void{
  if(str.eq(a;b)){
    let msg=str.concat("PASS [";str.concat(label;"]"));
    log.info(msg)
  }el{
    let msg=str.concat("FAIL [";label);
    let msg2=str.concat(msg;"]: expected=");
    let msg3=str.concat(msg2;b);
    let msg4=str.concat(msg3;" got=");
    let msg5=str.concat(msg4;a);
    log.error(msg5)
  }
};

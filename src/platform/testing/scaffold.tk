m=platform.testing.scaffold;

i=log:std.log;
i=fs:std.fs;
i=str:std.string;





t=$$scaffoldkind{
  migration;
  route;
  adapter;
  locale;
};

t=$$scaffoldrequest{
  kind:i64;
  name:str;
  outputdir:str;
};

f=generatemigration(name:str; dir:str):(str){
  var fname = dir + "/" + name + ".sql";
  if(fs.exists(fname)){
    log.warn("scaffold: migration already exists: " + fname);
    < <none
  }{};
  var content = "-- Migration: " + name + "
-- Created: auto-generated

-- up

-- down
";
  fs.write(fname; content);
  log.info("scaffold: created migration " + fname);
  < <some(fname)
};

f=generateroute(name:str; dir:str):(str){
  var snake = str.snake(name);
  var fname = dir + "/" + snake + ".tk";
  if(fs.exists(fname)){
    log.warn("scaffold: route already exists: " + fname);
    < <none
  }{};
  var content = "m=routes." + snake + ";

i=ctx:ooke.context;

pub f=get(c:ctx.$Context):ctx.$Response{
  < ctx.json(c, { ok: true })
}

pub f=post(c:ctx.$Context):ctx.$Response{
  < ctx.json(c, { ok: true })
}
";
  fs.write(fname; content);
  log.info("scaffold: created route " + fname);
  < <some(fname)
};

f=generateadapter(name:str; dir:str):(str){
  var snake = str.snake(name);
  var fname = dir + "/" + snake + ".tk";
  if(fs.exists(fname)){
    log.warn("scaffold: adapter already exists: " + fname);
    < <none
  }{};
  var content = "m=platform.integration." + snake + ";

i=http:platform.http.client;

pub m.$Config{
  base_url:str;
  timeout_ms:int;
}

pub f=new(cfg:m.$Config):m.$Config{
  < cfg
}
";
  fs.write(fname; content);
  log.info("scaffold: created adapter " + fname);
  < <some(fname)
};

f=generatelocale(lang:str; dir:str):(str){
  var fname = dir + "/" + lang + ".json";
  if(fs.exists(fname)){
    log.warn("scaffold: locale already exists: " + fname);
    < <none
  }{};
  var content = "{
  \"lang\": \"" + lang + "\",
  \"keys\": {}
}
";
  fs.write(fname; content);
  log.info("scaffold: created locale " + fname);
  < <some(fname)
};

f=run(req:i64):(str){
  if(req.kind = t=$migration){
    < generatemigration(req.name; req.outputdir)
  }{};
  if(req.kind = t=$route){
    < generateroute(req.name; req.outputdir)
  }{};
  if(req.kind = t=$adapter){
    < generateadapter(req.name; req.outputdir)
  }{};
  if(req.kind = t=$locale){
    < generatelocale(req.name; req.outputdir)
  }{};
  < <none
};

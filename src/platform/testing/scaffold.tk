m=loke.platform.testing.scaffold;

i=log:std.log;
i=fs:std.fs;
i=str:std.str;



t=$scaffoldkind{
  migration:i64;
  route:i64;
  adapter:i64;
  locale:i64
};

t=$scaffoldrequest{
  kind:i64;
  name:str;
  outputdir:str
};

f=generatemigration(name:str;dir:str):str{
  let fname=str.concat(dir;str.concat("/";str.concat(name;".sql")));
  if(fs.exists(fname)){
    log.warn(str.concat("scaffold: migration already exists: ";fname));
    <""
  }el{};
  let content=str.concat("-- Migration: ";str.concat(name;"\n-- Created: autogenerated\n\n-- up\n\n-- down\n"));
  fs.write(fname;content);
  log.info(str.concat("scaffold: created migration ";fname));
  <fname
};

f=generateroute(name:str;dir:str):str{
  let snake=str.snake(name);
  let fname=str.concat(dir;str.concat("/";str.concat(snake;".tk")));
  if(fs.exists(fname)){
    log.warn(str.concat("scaffold: route already exists: ";fname));
    <""
  }el{};
  let content=str.concat("m=routes.";str.concat(snake;";\n\ni=ctx:ooke.context;\n\nf=get(c:ctx.$context):ctx.$response{\n  <ctx.json(c)\n};\n\nf=post(c:ctx.$context):ctx.$response{\n  <ctx.json(c)\n};\n"));
  fs.write(fname;content);
  log.info(str.concat("scaffold: created route ";fname));
  <fname
};

f=generateadapter(name:str;dir:str):str{
  let snake=str.snake(name);
  let fname=str.concat(dir;str.concat("/";str.concat(snake;".tk")));
  if(fs.exists(fname)){
    log.warn(str.concat("scaffold: adapter already exists: ";fname));
    <""
  }el{};
  let content=str.concat("m=platform.integration.";str.concat(snake;";\n\ni=http:platform.http.client;\n\nt=$config{\n  baseurl:str;\n  timeoutms:i32\n};\n\nf=new(cfg:$config):$config{\n  <cfg\n};\n"));
  fs.write(fname;content);
  log.info(str.concat("scaffold: created adapter ";fname));
  <fname
};

f=generatelocale(lang:str;dir:str):str{
  let fname=str.concat(dir;str.concat("/";str.concat(lang;".json")));
  if(fs.exists(fname)){
    log.warn(str.concat("scaffold: locale already exists: ";fname));
    <""
  }el{};
  let content=str.concat("{\n  \"lang\": \"";str.concat(lang;"\",\n  \"keys\": {}\n}\n"));
  fs.write(fname;content);
  log.info(str.concat("scaffold: created locale ";fname));
  <fname
};

f=run(req:$scaffoldrequest):str{
  if(req.kind=0){
    <generatemigration(req.name;req.outputdir)
  }el{};
  if(req.kind=1){
    <generateroute(req.name;req.outputdir)
  }el{};
  if(req.kind=2){
    <generateadapter(req.name;req.outputdir)
  }el{};
  if(req.kind=3){
    <generatelocale(req.name;req.outputdir)
  }el{};
  <""
};

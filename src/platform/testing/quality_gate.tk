m=loke.platform.testing.qualitygate;

i=str:std.str;
i=log:std.log;


t=$gatestep{
  name:str;
  command:str;
  required:bool
};


t=$gateresult{
  step:str;
  ok:bool;
  output:str;
  durationms:i32
};



f=defaultsteps():@$gatestep{
  let steps=@($gatestep);
  steps.push($gatestep{name:"lint";command:"ooke lint";required:true});
  steps.push($gatestep{name:"formatcheck";command:"ooke fmt --check";required:true});
  steps.push($gatestep{name:"dependencyaudit";command:"ooke audit";required:true});
  steps.push($gatestep{name:"unittests";command:"ooke test";required:true});
  steps.push($gatestep{name:"integrationtests";command:"ooke test --integration";required:true});
  steps.push($gatestep{name:"a11ytests";command:"ooke test --a11y";required:true});
  steps.push($gatestep{name:"build";command:"ooke build";required:true});
  <steps
};




f=runstep(step:$gatestep):$gateresult{
  let msg=str.concat("qualitygate: running ";step.name);
  let msg2=str.concat(msg;" (");
  let msg3=str.concat(msg2;step.command);
  let msg4=str.concat(msg3;")");
  log.info(msg4);
  <$gateresult{
    step:step.name;
    ok:true;
    output:"";
    durationms:100
  }
};



f=runall():@$gateresult{
  let steps=defaultsteps();
  let results=@($gateresult);
  let count=steps.len();
  let stopped=mut.false;
  lp(let i=0;i<count;i=i+1){
    if(stopped=false){
      let step=steps.get(i);
      let result=runstep(step);
      results.push(result);
      if(result.ok=false){
        if(step.required){
          let msg=str.concat("qualitygate: required step failed -- stopping: ";step.name);
          log.error(msg);
          stopped=true
        }el{}
      }el{}
    }el{}
  };
  <results
};



f=formatresults(results:@$gateresult):str{
  let out=mut."step                   status   durationms\n";
  out=str.concat(out;"----------------------------------------------\n");
  let count=results.len();
  lp(let i=0;i<count;i=i+1){
    let r=results.get(i);
    let status=mut."PASS";
    if(r.ok=false){
      status="FAIL"
    }el{};
    let line=str.concat(r.step;"                       ");
    let line2=str.slice(line;0;23);
    let line3=str.concat(line2;status);
    let line4=str.concat(line3;"     ");
    let line5=str.concat(line4;str.fromint(r.durationms));
    let line6=str.concat(line5;" ms\n");
    out=str.concat(out;line6)
  };
  <out
};


f=allpassed(results:@$gateresult):bool{
  let count=results.len();
  lp(let i=0;i<count;i=i+1){
    if(results.get(i).ok=false){
      <false
    }el{}
  };
  <true
};

m=platform.testing.quality_gate;





m=loke.platform.testing.qualitygate;

i=str:std.str;
i=log:std.log;


t=$gatestep{
  name:str;
  command:str;
  required:bool
};


t=$gateresult{
  step:str;
  ok:bool;
  output:str;
  durationms:i32
};



f=defaultsteps():@$gatestep{
  let steps:@$gatestep=@();
  steps.push($gatestep{name:"lint";command:"ooke lint";required:true});
  steps.push($gatestep{name:"format-check";command:"ooke fmt --check";required:true});
  steps.push($gatestep{name:"dependency-audit";command:"ooke audit";required:true});
  steps.push($gatestep{name:"unit-tests";command:"ooke test";required:true});
  steps.push($gatestep{name:"integration-tests";command:"ooke test --integration";required:true});
  steps.push($gatestep{name:"a11y-tests";command:"ooke test --a11y";required:true});
  steps.push($gatestep{name:"build";command:"ooke build";required:true});
  <steps
};





f=runstep(step:$gatestep):$gateresult{
  let msg=str.concat("quality-gate: running ";step.name);
  let msg2=str.concat(msg;" (");
  let msg3=str.concat(msg2;step.command);
  let msg4=str.concat(msg3;")");
  log.info(msg4);
  <$gateresult{
    step:step.name;
    ok:true;
    output:"";
    durationms:100
  };
};



f=runall():@$gateresult{
  let steps=defaultsteps();
  let results:@$gateresult=@();
  let count=steps.len();
  let i=0;
  let stopped=false;
  if(i<count){
    if(stopped==false{
      let step=steps.get(i);
      let result=runstep(step);
      results.push(result);
      if(result.ok==false{
        if(step.required{
          let msg=str.concat("quality-gate: required step failed — stopping: ";step.name);
          log.error(msg);
          stopped=true
        }else{()};
      }else{()};
    }else{()};
    i=i+1
  }{};
  <results
};



f=formatresults(results:@$gateresult):str{
  let out="step                   status   duration_ms
";
  out=str.concat(out;"----------------------------------------------
");
  let count=results.len();
  let i=0;
  if(i<count){
    let r=results.get(i);
    let status="PASS";
    if(r.ok==false{
      status="FAIL"
    }else{()};
    let line=str.concat(r.step;"                       ");
    let line2=str.slice(line;0;23);
    let line3=str.concat(line2;status);
    let line4=str.concat(line3;"     ");
    let line5=str.concat(line4;str.fromint(r.durationms));
    let line6=str.concat(line5;" ms
");
    out=str.concat(out;line6);
    i=i+1
  }{};
  <out
};


f=allpassed(results:@$gateresult):bool{
  let count=results.len();
  let i=0;
  if(i<count){
    if(results.get(i).ok==false{
      <false
    }else{()};
    i=i+1
  }{};
  <true
};

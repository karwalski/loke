{
  "schema_version": "1.0",
  "module": "loke.governance.trace",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "traceentry", "fields": [{"name": "step", "type": "str"}, {"name": "detail", "type": "str"}, {"name": "timestamp", "type": "str"}]},
    {"kind": "type", "name": "decisiontrace", "fields": [{"name": "requestid", "type": "str"}, {"name": "correlationid", "type": "str"}, {"name": "originalinput", "type": "str"}, {"name": "piidetected", "type": "str"}, {"name": "anonymisationapplied", "type": "bool"}, {"name": "compressionapplied", "type": "bool"}, {"name": "riskclassification", "type": "str"}, {"name": "policydecision", "type": "str"}, {"name": "modelselected", "type": "str"}, {"name": "provider", "type": "str"}, {"name": "promptsent", "type": "str"}, {"name": "responsereceived", "type": "str"}, {"name": "deanonymisationapplied", "type": "bool"}, {"name": "finaloutput", "type": "str"}, {"name": "steps", "type": "@"}, {"name": "durationms", "type": "i64"}]},
    {"kind": "func", "name": "newtrace", "params": ["str", "str", "str"], "return": "decisiontrace"},
    {"kind": "func", "name": "addstep", "params": ["decisiontrace", "str", "str"], "return": "void"},
    {"kind": "func", "name": "recordpii", "params": ["decisiontrace", "str"], "return": "void"},
    {"kind": "func", "name": "recordrouting", "params": ["decisiontrace", "str", "str"], "return": "void"},
    {"kind": "func", "name": "recordresponse", "params": ["decisiontrace", "str"], "return": "void"},
    {"kind": "func", "name": "complete", "params": ["decisiontrace", "i64"], "return": "void"},
    {"kind": "func", "name": "truncate", "params": ["str", "i64"], "return": "str"},
    {"kind": "func", "name": "jsonescape", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "tojson", "params": ["decisiontrace"], "return": "str"},
    {"kind": "func", "name": "summary", "params": ["decisiontrace"], "return": "str"}
  ]
}

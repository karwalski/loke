{
  "schema_version": "1.0",
  "module": "governance.justification",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "simplerpath", "fields": [{"name": "id", "type": "str"}, {"name": "description", "type": "str"}, {"name": "whensufficient", "type": "str"}]},
    {"kind": "type", "name": "justification", "fields": [{"name": "usecaseid", "type": "str"}, {"name": "purpose", "type": "str"}, {"name": "whyai", "type": "str"}, {"name": "expectedvalue", "type": "str"}, {"name": "identifiedrisks", "type": "str"}, {"name": "simpleralternatives", "type": "str"}, {"name": "approved", "type": "bool"}, {"name": "approvedby", "type": "str"}, {"name": "approvedat", "type": "i64"}, {"name": "submittedat", "type": "i64"}]},
    {"kind": "type", "name": "justificationstore", "fields": [{"name": "entries", "type": "@"}]},
    {"kind": "func", "name": "newstore", "params": [], "return": "justificationstore"},
    {"kind": "func", "name": "simplerpaths", "params": [], "return": "@"},
    {"kind": "func", "name": "submit", "params": ["justificationstore", "justification"], "return": "justificationstore"},
    {"kind": "func", "name": "get", "params": ["justificationstore", "str"], "return": "i64"},
    {"kind": "func", "name": "approve", "params": ["justificationstore", "str", "str"], "return": "justificationstore"},
    {"kind": "func", "name": "list", "params": ["justificationstore"], "return": "@"}
  ]
}

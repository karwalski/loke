m=loke.governance.tierdashboard;
i=log:std.log;
i=str:std.string;


t=$tierstats{
  tier:str;
  requestcount:i32;
  requestpct:f32;
  avgresponsems:i32;
  avgqualityrating:f32;
  modelsused:@str;
  tokpersecavg:f32;
  cloudcostavoidedusd:f32;
  gpupct:f32;
  rampct:f32
};


t=$tierreport{
  interactive:$tierstats;
  considered:$tierstats;
  background:$tierstats;
  perioddays:i32;
  totalrequests:i32;
  generatedat:i64
};


f=emptystats(tier:str):$tierstats{
  <$tierstats{
    tier:tier;
    requestcount:0;
    requestpct:0.0;
    avgresponsems:0;
    avgqualityrating:0.0;
    modelsused:@();
    tokpersecavg:0.0;
    cloudcostavoidedusd:0.0;
    gpupct:0.0;
    rampct:0.0
  }
};


f=newreport(perioddays:i32):$tierreport{
  let now:i64=0;
  <$tierreport{
    interactive:emptystats("interactive");
    considered:emptystats("considered");
    background:emptystats("background");
    perioddays:perioddays;
    totalrequests:0;
    generatedat:now
  }
};



f=updatetierstats(s:$tierstats;responsems:i32;quality:f32;model:str;toks:f32;costavoided:f32):$tierstats{
  let n=s.requestcount + 1;
  let nf32=str.tof32(str.fromi32(n));
  let oldf=str.tof32(str.fromi32(s.requestcount));
  
  let newavgms=str.toi32(str.fromf32(
    (str.tof32(str.fromi32(s.avgresponsems)) * oldf +
     str.tof32(str.fromi32(responsems))) / nf32
  ));
  let newavgq=(s.avgqualityrating * oldf + quality) / nf32;
  let newavgtok=(s.tokpersecavg * oldf + toks) / nf32;
  
  let already=mut.false;
  lp(let ii=0;ii<s.modelsused.len;ii=ii+1){
    let m=s.modelsused.get(ii);
    if(str.eq(m;model)){
      already=true
    }el{}
  };
  if(!$already){
    s.modelsused.push(model)
  }el{};
  <$tierstats{
    tier:s.tier;
    requestcount:n;
    requestpct:s.requestpct;
    avgresponsems:newavgms;
    avgqualityrating:newavgq;
    modelsused:s.modelsused;
    tokpersecavg:newavgtok;
    cloudcostavoidedusd:s.cloudcostavoidedusd + costavoided;
    gpupct:s.gpupct;
    rampct:s.rampct
  }
};


f=updateinteractive(r:$tierreport;responsems:i32;quality:f32;model:str;toks:f32;costavoided:f32):$tierreport{
  let newinteractive=updatetierstats(r.interactive;responsems;quality;model;toks;costavoided);
  <$tierreport{
    interactive:newinteractive;
    considered:r.considered;
    background:r.background;
    perioddays:r.perioddays;
    totalrequests:r.totalrequests + (1 as i32);
    generatedat:r.generatedat
  }
};


f=updateconsidered(r:$tierreport;responsems:i32;quality:f32;model:str;toks:f32;costavoided:f32):$tierreport{
  let newconsidered=updatetierstats(r.considered;responsems;quality;model;toks;costavoided);
  <$tierreport{
    interactive:r.interactive;
    considered:newconsidered;
    background:r.background;
    perioddays:r.perioddays;
    totalrequests:r.totalrequests + (1 as i32);
    generatedat:r.generatedat
  }
};


f=updatebackground(r:$tierreport;responsems:i32;quality:f32;model:str;toks:f32;costavoided:f32):$tierreport{
  let newbackground=updatetierstats(r.background;responsems;quality;model;toks;costavoided);
  <$tierreport{
    interactive:r.interactive;
    considered:r.considered;
    background:newbackground;
    perioddays:r.perioddays;
    totalrequests:r.totalrequests + (1 as i32);
    generatedat:r.generatedat
  }
};


f=recalculatepcts(r:$tierreport):$tierreport{
  let total=r.totalrequests;
  let totalf=str.tof32(str.fromi32(total));
  let ipct=mut.0.0;
  let cpct=mut.0.0;
  let bpct=mut.0.0;
  if(total > 0){
    ipct=str.tof32(str.fromi32(r.interactive.requestcount)) / totalf * 100.0;
    cpct=str.tof32(str.fromi32(r.considered.requestcount)) / totalf * 100.0;
    bpct=str.tof32(str.fromi32(r.background.requestcount)) / totalf * 100.0
  }el{};
  let newi=$tierstats{
    tier:r.interactive.tier;
    requestcount:r.interactive.requestcount;
    requestpct:ipct;
    avgresponsems:r.interactive.avgresponsems;
    avgqualityrating:r.interactive.avgqualityrating;
    modelsused:r.interactive.modelsused;
    tokpersecavg:r.interactive.tokpersecavg;
    cloudcostavoidedusd:r.interactive.cloudcostavoidedusd;
    gpupct:r.interactive.gpupct;
    rampct:r.interactive.rampct
  };
  let newc=$tierstats{
    tier:r.considered.tier;
    requestcount:r.considered.requestcount;
    requestpct:cpct;
    avgresponsems:r.considered.avgresponsems;
    avgqualityrating:r.considered.avgqualityrating;
    modelsused:r.considered.modelsused;
    tokpersecavg:r.considered.tokpersecavg;
    cloudcostavoidedusd:r.considered.cloudcostavoidedusd;
    gpupct:r.considered.gpupct;
    rampct:r.considered.rampct
  };
  let newb=$tierstats{
    tier:r.background.tier;
    requestcount:r.background.requestcount;
    requestpct:bpct;
    avgresponsems:r.background.avgresponsems;
    avgqualityrating:r.background.avgqualityrating;
    modelsused:r.background.modelsused;
    tokpersecavg:r.background.tokpersecavg;
    cloudcostavoidedusd:r.background.cloudcostavoidedusd;
    gpupct:r.background.gpupct;
    rampct:r.background.rampct
  };
  <$tierreport{
    interactive:newi;
    considered:newc;
    background:newb;
    perioddays:r.perioddays;
    totalrequests:r.totalrequests;
    generatedat:r.generatedat
  }
};


f=tierstatstojson(s:$tierstats):str{
  let modelsarr=mut."[";
  let first=mut.true;
  lp(let ii=0;ii<s.modelsused.len;ii=ii+1){
    let m=s.modelsused.get(ii);
    if(first){
      first=false
    }el{
      modelsarr=str.concat(modelsarr;",")
    };
    modelsarr=str.concat(modelsarr;str.concat("\"";str.concat(m;"\"")))
  };
  modelsarr=str.concat(modelsarr;"]");
  let j=mut.str.concat("{\"tier\":\"";str.concat(s.tier;"\""));
  j=str.concat(j;str.concat(",\"request_count\":";str.fromi32(s.requestcount)));
  j=str.concat(j;str.concat(",\"request_pct\":";str.fromf32(s.requestpct)));
  j=str.concat(j;str.concat(",\"avg_response_ms\":";str.fromi32(s.avgresponsems)));
  j=str.concat(j;str.concat(",\"avg_quality_rating\":";str.fromf32(s.avgqualityrating)));
  j=str.concat(j;str.concat(",\"models_used\":";modelsarr));
  j=str.concat(j;str.concat(",\"tok_per_sec_avg\":";str.fromf32(s.tokpersecavg)));
  j=str.concat(j;str.concat(",\"cloud_cost_avoided_usd\":";str.fromf32(s.cloudcostavoidedusd)));
  j=str.concat(j;str.concat(",\"gpu_pct\":";str.fromf32(s.gpupct)));
  j=str.concat(j;str.concat(",\"ram_pct\":";str.fromf32(s.rampct)));
  <str.concat(j;"}")
};


f=reporttojson(r:$tierreport):str{
  let j=mut.str.concat("{\"interactive\":";tierstatstojson(r.interactive));
  j=str.concat(j;str.concat(",\"considered\":";tierstatstojson(r.considered)));
  j=str.concat(j;str.concat(",\"background\":";tierstatstojson(r.background)));
  j=str.concat(j;str.concat(",\"period_days\":";str.fromi32(r.perioddays)));
  j=str.concat(j;str.concat(",\"total_requests\":";str.fromi32(r.totalrequests)));
  j=str.concat(j;str.concat(",\"generated_at\":";str.fromi64(r.generatedat)));
  <str.concat(j;"}")
};

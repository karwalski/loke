m=governance.justification;

i=str:std.str;
i=log:std.log;

t=$simplerpath{
  id:str;
  description:str;
  whensufficient:str
};

t=$justification{
  usecaseid:str;
  purpose:str;
  whyai:str;
  expectedvalue:str;
  identifiedrisks:str;
  simpleralternatives:str;
  approved:bool;
  approvedby:str;
  approvedat:i64;
  submittedat:i64
};

t=$justificationstore{
  entries:@$justification
};

f=newstore():$justificationstore{
  <$justificationstore{entries:@()}
};

f=simplerpaths():@$simplerpath{
  <@(
    $simplerpath{id:"search";description:"Full-text search / database query";whensufficient:"When looking up known facts in structured data"};
    $simplerpath{id:"rule";description:"Rule-based logic / decision tree";whensufficient:"When logic is deterministic and conditions are known"};
    $simplerpath{id:"template";description:"Template with variable substitution";whensufficient:"When output structure is fixed and only values change"};
    $simplerpath{id:"human";description:"Human review / approval workflow";whensufficient:"When accountability and judgment are the primary concern"}
  )
};

f=submit(st:$justificationstore;j:$justification):$justificationstore{
  log.info(str.concat("justification submitted for ";j.usecaseid));
  <$justificationstore{entries:st.entries.push(j)}
};

f=get(st:$justificationstore;usecaseid:str):i64{
  let result=mut.0;
  lp(let ii=0;ii<st.entries.len;ii=ii+1){
    let j=st.entries.get(ii);
    if(str.eq(j.usecaseid;usecaseid)){
      result=j
    }el{}
  };
  <result
};

f=approve(st:$justificationstore;usecaseid:str;approverid:str):$justificationstore{
  let now=0;
  let updated=mut.@();
  lp(let ii=0;ii<st.entries.len;ii=ii+1){
    let j=st.entries.get(ii);
    if(str.eq(j.usecaseid;usecaseid)){
      updated=updated.push($justification{
        usecaseid:j.usecaseid;
        purpose:j.purpose;
        whyai:j.whyai;
        expectedvalue:j.expectedvalue;
        identifiedrisks:j.identifiedrisks;
        simpleralternatives:j.simpleralternatives;
        approved:true;
        approvedby:approverid;
        approvedat:now;
        submittedat:j.submittedat
      })
    }el{
      updated=updated.push(j)
    }
  };
  log.info(str.concat("justification approved: ";usecaseid));
  <$justificationstore{entries:updated}
};

f=list(st:$justificationstore):@$justification{
  <st.entries
};

m=governance.justification;





m=loke.governance.justification;
i=log:std.log;
i=str:std.string;


t=$justification{
  usecaseid:str;
  purpose:str;
  whyai:str;
  expectedvalue:str;
  identifiedrisks:str;
  simpleralternatives:@str;
  submittedat:i64;
  approved:bool;
  approverid:str
};


t=$simplerpath{
  id:str;
  description:str;
  whensufficient:str
};


m.gjustifications:@$justification=@();


m.gsimplerpaths:@$simplerpath=@(
  $simplerpath{
    id:"search";
    description:"Full-text search / database query";
    whensufficient:"When looking up known facts in structured data"
  };
  $simplerpath{
    id:"rule";
    description:"Rule-based logic / decision tree";
    whensufficient:"When logic is deterministic and conditions are known"
  };
  $simplerpath{
    id:"template";
    description:"Template with variable substitution";
    whensufficient:"When output structure is fixed and only values change"
  };
  $simplerpath{
    id:"human";
    description:"Human review / approval workflow";
    whensufficient:"When accountability and judgment are the primary concern"
  }
);


f=submit(j:$justification):i64{
  log.info("justification submitted for " + j.usecaseid);
  gjustifications.push(j)
};


f=get(usecaseid:str):($justification){
  let result:($justification)=<none;
  gjustifications.each(j{
    if(str.eq(j.usecaseid;usecaseid)){
      result=<some(j)
    }{}
  });
  <result
};


f=approve(usecaseid:str;approverid:str):i64{
  let idx=-1;
  let i=0;
  gjustifications.each(j{
    if(str.eq(j.usecaseid;usecaseid)){
      idx=i
    }{};
    i=i+1;
  });
  if(idx > 0){
    let old=gjustifications.get(idx);
    let updated=$justification{
      usecaseid:old.usecaseid;
      purpose:old.purpose;
      whyai:old.whyai;
      expectedvalue:old.expectedvalue;
      identifiedrisks:old.identifiedrisks;
      simpleralternatives:old.simpleralternatives;
      submittedat:old.submittedat;
      approved:true;
      approverid:approverid
    };
    let newlist:@$justification=@();
    let j=0;
    gjustifications.each(entry{
      if(j = idx){
        newlist.push(updated)
      }{
        newlist.push(entry)
      };
      j=j+1
    });
    gjustifications=newlist;
    log.info("justification approved for " + usecaseid + " by " + approverid)
  }{}
};




f=suggestsimpler(purpose:str):@$simplerpath{
  <gsimplerpaths
};


f=simplerpathtojson(p:$simplerpath):str{
  <"{" +
    "\"id\":\"" + p.id + "\"" +
    ",\"description\":\"" + p.description + "\"" +
    ",\"when_sufficient\":\"" + p.whensufficient + "\"" +
  "}"
};


f=tojson(j:$justification):str{
  let alts="[";
  let first=true;
  j.simpleralternatives.each(a{
    if(first){
      first=false
    }{
      alts=alts + ","
    };
    alts=alts + "\"" + a + "\""
  });
  alts=alts + "]";
  <"{" +
    "\"use_case_id\":\"" + j.usecaseid + "\"" +
    ",\"purpose\":\"" + j.purpose + "\"" +
    ",\"why_ai\":\"" + j.whyai + "\"" +
    ",\"expected_value\":\"" + j.expectedvalue + "\"" +
    ",\"identified_risks\":\"" + j.identifiedrisks + "\"" +
    ",\"simpler_alternatives\":" + alts +
    ",\"submitted_at\":" + str.fromi64(j.submittedat) +
    ",\"approved\":" + str.frombool(j.approved) +
    ",\"approver_id\":\"" + j.approverid + "\"" +
  "}"
};

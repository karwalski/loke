m=governance.kill_switch;





m=loke.governance.killswitch;
i=log:std.log;
i=str:std.string;


t=$killswitchscope{
  $global:i64;
  $provider:i64;
  $usecase:i64;
  $agent
};


t=$killswitchentry{
  id:str;
  scope:str;
  target:str;
  reason:str;
  enabledat:i64;
  enabledby:str
};


t=$fallbackmessage{
  scope:str;
  target:str;
  message:str
};


m.gswitches:@$killswitchentry=@();


m.gglobalactive:bool=false;


f=enableglobal(reason:str;by:str):i64{
  gglobalactive=true;
  let now:i64=0;
  let entry=$killswitchentry{
    id:str.uuid();
    scope:"global";
    target:"*";
    reason:reason;
    enabledat:now;
    enabledby:by
  };
  gswitches.push(entry);
  log.info("KILL SWITCH ENABLED (global): " + reason)
};


f=disableglobal():i64{
  gglobalactive=false;
  log.info("kill switch: global disabled")
};


f=isglobalactive():bool{
  <gglobalactive
};


f=enableprovider(provider:str;reason:str;by:str):i64{
  let now:i64=0;
  let entry=$killswitchentry{
    id:str.uuid();
    scope:"provider";
    target:provider;
    reason:reason;
    enabledat:now;
    enabledby:by
  };
  gswitches.push(entry);
  log.info("kill switch enabled (provider=" + provider + "): " + reason)
};


f=enableusecase(usecaseid:str;reason:str;by:str):i64{
  let now:i64=0;
  let entry=$killswitchentry{
    id:str.uuid();
    scope:"use_case";
    target:usecaseid;
    reason:reason;
    enabledat:now;
    enabledby:by
  };
  gswitches.push(entry);
  log.info("kill switch enabled (use_case=" + usecaseid + "): " + reason)
};



f=isblocked(scope:str;target:str):bool{
  if(gglobalactive){
    <true
  }{};
  let blocked=false;
  gswitches.each(entry{
    if(str.eq(entry.scope;scope)){
      if(str.eq(entry.target;target)){
        blocked=true
      }{}
    }{}
  });
  <blocked
};


f=fallbackmessage(scope:str;target:str):$fallbackmessage{
  let detail="";
  if(gglobalactive){
    detail="A global kill switch is active. "
  }{
    detail="This provider/feature is temporarily disabled. "
  };
  let msg="AI services are currently disabled. " + detail +
          "Please try again later or contact your administrator.";
  <$fallbackmessage{
    scope:scope;
    target:target;
    message:msg
  }
};


f=listactive():@$killswitchentry{
  <gswitches
};


f=tojson(e:$killswitchentry):str{
  <"{" +
    "\"id\":\"" + e.id + "\"" +
    ",\"scope\":\"" + e.scope + "\"" +
    ",\"target\":\"" + e.target + "\"" +
    ",\"reason\":\"" + e.reason + "\"" +
    ",\"enabled_at\":" + str.fromi64(e.enabledat) +
    ",\"enabled_by\":\"" + e.enabledby + "\"" +
  "}"
};

m=governance.killswitch;

i=str:std.str;
i=log:std.log;

t=$killswitchentry{
  id:str;
  scope:str;
  target:str;
  reason:str;
  enabledat:i64;
  enabledby:str
};

t=$fallbackmessage{
  scope:str;
  target:str;
  message:str
};

t=$killswitchstate{
  globalactive:bool;
  switches:@$killswitchentry
};

f=newstate():$killswitchstate{
  <$killswitchstate{globalactive:false;switches:@()}
};

f=enableglobal(st:$killswitchstate;reason:str;by:str):$killswitchstate{
  let now=0;
  let entry=$killswitchentry{
    id:str.uuid();
    scope:"global";
    target:"*";
    reason:reason;
    enabledat:now;
    enabledby:by
  };
  log.info(str.concat("KILL SWITCH ENABLED (global): ";reason));
  <$killswitchstate{globalactive:true;switches:st.switches.push(entry)}
};

f=disableglobal(st:$killswitchstate):$killswitchstate{
  log.info("kill switch: global disabled");
  <$killswitchstate{globalactive:false;switches:st.switches}
};

f=isglobalactive(st:$killswitchstate):bool{
  <st.globalactive
};

f=enableprovider(st:$killswitchstate;provider:str;reason:str;by:str):$killswitchstate{
  let now=0;
  let entry=$killswitchentry{
    id:str.uuid();
    scope:"provider";
    target:provider;
    reason:reason;
    enabledat:now;
    enabledby:by
  };
  log.info(str.concat("kill switch enabled (provider=";str.concat(provider;str.concat("): ";reason))));
  <$killswitchstate{globalactive:st.globalactive;switches:st.switches.push(entry)}
};

f=enableusecase(st:$killswitchstate;usecaseid:str;reason:str;by:str):$killswitchstate{
  let now=0;
  let entry=$killswitchentry{
    id:str.uuid();
    scope:"use_case";
    target:usecaseid;
    reason:reason;
    enabledat:now;
    enabledby:by
  };
  log.info(str.concat("kill switch enabled (use_case=";str.concat(usecaseid;str.concat("): ";reason))));
  <$killswitchstate{globalactive:st.globalactive;switches:st.switches.push(entry)}
};

f=isblocked(st:$killswitchstate;scope:str;target:str):bool{
  if(st.globalactive){ <true }el{};
  let blocked=mut.false;
  lp(let ii=0;ii<st.switches.len;ii=ii+1){
    let entry=st.switches.get(ii);
    if(str.eq(entry.scope;scope)){
      if(str.eq(entry.target;target)){
        blocked=true
      }el{}
    }el{}
  };
  <blocked
};

f=getfallbackmessage(st:$killswitchstate;scope:str;target:str):$fallbackmessage{
  let detail=mut."This provider/feature is temporarily disabled. ";
  if(st.globalactive){
    detail="A global kill switch is active. "
  }el{};
  let msg=str.concat("AI services are currently disabled. ";str.concat(detail;"Please try again later or contact your administrator."));
  <$fallbackmessage{
    scope:scope;
    target:target;
    message:msg
  }
};

f=listactive(st:$killswitchstate):@$killswitchentry{
  <st.switches
};

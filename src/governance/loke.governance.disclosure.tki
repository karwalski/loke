{
  "schema_version": "1.0",
  "module": "loke.governance.disclosure",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "disclosurekind", "is_sum": true, "fields": [{"name": "$generated", "type": "i64"}, {"name": "$assisted", "type": "i64"}, {"name": "$summarised", "type": "i64"}, {"name": "$translated", "type": "i64"}]},
    {"kind": "type", "name": "disclosure", "fields": [{"name": "kind", "type": "str"}, {"name": "modelid", "type": "str"}, {"name": "requestid", "type": "str"}, {"name": "ts", "type": "i64"}]},
    {"kind": "type", "name": "disclosureconfig", "fields": [{"name": "visible", "type": "bool"}, {"name": "enterpriseoverride", "type": "bool"}, {"name": "copymetadata", "type": "bool"}]},
    {"kind": "func", "name": "defaultconfig", "params": [], "return": "disclosureconfig"},
    {"kind": "func", "name": "newdisclosure", "params": ["str", "str", "str"], "return": "disclosure"},
    {"kind": "func", "name": "label", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "indicatorhtml", "params": ["disclosure", "disclosureconfig"], "return": "str"},
    {"kind": "func", "name": "copymetadatacomment", "params": ["disclosure"], "return": "str"},
    {"kind": "func", "name": "tojson", "params": ["disclosure"], "return": "str"}
  ]
}

{
  "schema_version": "1.0",
  "module": "loke.governance.tierdashboard",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "tierstats", "fields": [{"name": "tier", "type": "str"}, {"name": "requestcount", "type": "i32"}, {"name": "requestpct", "type": "f32"}, {"name": "avgresponsems", "type": "i32"}, {"name": "avgqualityrating", "type": "f32"}, {"name": "modelsused", "type": "@"}, {"name": "tokpersecavg", "type": "f32"}, {"name": "cloudcostavoidedusd", "type": "f32"}, {"name": "gpupct", "type": "f32"}, {"name": "rampct", "type": "f32"}]},
    {"kind": "type", "name": "tierreport", "fields": [{"name": "interactive", "type": "tierstats"}, {"name": "considered", "type": "tierstats"}, {"name": "background", "type": "tierstats"}, {"name": "perioddays", "type": "i32"}, {"name": "totalrequests", "type": "i32"}, {"name": "generatedat", "type": "i64"}]},
    {"kind": "func", "name": "emptystats", "params": ["str"], "return": "tierstats"},
    {"kind": "func", "name": "newreport", "params": ["i32"], "return": "tierreport"},
    {"kind": "func", "name": "updatetierstats", "params": ["tierstats", "i32", "f32", "str", "f32", "f32"], "return": "tierstats"},
    {"kind": "func", "name": "updateinteractive", "params": ["tierreport", "i32", "f32", "str", "f32", "f32"], "return": "tierreport"},
    {"kind": "func", "name": "updateconsidered", "params": ["tierreport", "i32", "f32", "str", "f32", "f32"], "return": "tierreport"},
    {"kind": "func", "name": "updatebackground", "params": ["tierreport", "i32", "f32", "str", "f32", "f32"], "return": "tierreport"},
    {"kind": "func", "name": "recalculatepcts", "params": ["tierreport"], "return": "tierreport"},
    {"kind": "func", "name": "tierstatstojson", "params": ["tierstats"], "return": "str"},
    {"kind": "func", "name": "reporttojson", "params": ["tierreport"], "return": "str"}
  ]
}

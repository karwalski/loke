{
  "schema_version": "1.0",
  "module": "governance.ownership",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "owner", "fields": [{"name": "name", "type": "str"}, {"name": "email", "type": "str"}, {"name": "role", "type": "str"}, {"name": "assignedat", "type": "i64"}]},
    {"kind": "type", "name": "usecaseownership", "fields": [{"name": "usecaseid", "type": "str"}, {"name": "businessowner", "type": "str"}, {"name": "technicalowner", "type": "str"}, {"name": "riskowner", "type": "str"}, {"name": "updatedat", "type": "i64"}]},
    {"kind": "type", "name": "ownershipstore", "fields": [{"name": "entries", "type": "@"}]},
    {"kind": "func", "name": "newstore", "params": [], "return": "ownershipstore"},
    {"kind": "func", "name": "assign", "params": ["ownershipstore", "str", "str", "str"], "return": "ownershipstore"},
    {"kind": "func", "name": "get", "params": ["ownershipstore", "str"], "return": "i64"},
    {"kind": "func", "name": "list", "params": ["ownershipstore"], "return": "@"},
    {"kind": "func", "name": "hasallowners", "params": ["usecaseownership"], "return": "bool"},
    {"kind": "func", "name": "missingroles", "params": ["usecaseownership"], "return": "@"}
  ]
}

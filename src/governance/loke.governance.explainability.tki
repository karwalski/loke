{
  "schema_version": "1.0",
  "module": "loke.governance.explainability",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "decisiontrace", "fields": [{"name": "requestid", "type": "str"}, {"name": "piidetected", "type": "@"}, {"name": "anonymisationapplied", "type": "bool"}, {"name": "compressionapplied", "type": "bool"}, {"name": "risktier", "type": "str"}, {"name": "policydecisions", "type": "@"}, {"name": "modelselected", "type": "str"}, {"name": "modelreason", "type": "str"}, {"name": "promptsent", "type": "str"}, {"name": "responsereceived", "type": "str"}, {"name": "entitiesrestored", "type": "i32"}]},
    {"kind": "type", "name": "explanation", "fields": [{"name": "requestid", "type": "str"}, {"name": "plainlanguage", "type": "str"}, {"name": "sourceattribution", "type": "str"}, {"name": "confidence", "type": "str"}, {"name": "generatedlocally", "type": "bool"}]},
    {"kind": "func", "name": "explain", "params": ["decisiontrace"], "return": "explanation"},
    {"kind": "func", "name": "explainviallm", "params": ["decisiontrace", "str"], "return": "explanation"},
    {"kind": "func", "name": "tracetojson", "params": ["decisiontrace"], "return": "str"},
    {"kind": "func", "name": "tojson", "params": ["explanation"], "return": "str"}
  ]
}





m=loke.governance.disclosure;
i=log:std.log;
i=str:std.string;


t=$disclosurekind{
  $generated:i64;
  $assisted:i64;
  $summarised:i64;
  $translated
};


t=$disclosure{
  kind:str;
  modelid:str;
  requestid:str;
  ts:i64
};


t=$disclosureconfig{
  visible:bool;
  enterpriseoverride:bool;
  copymetadata:bool
};



f=defaultconfig():$disclosureconfig{
  <$disclosureconfig{
    visible:true;
    enterpriseoverride:false;
    copymetadata:true
  };
};


f=newdisclosure(kind:str;modelid:str;requestid:str):$disclosure{
  let now:i64=0;
  <$disclosure{
    kind:kind;
    modelid:modelid;
    requestid:requestid;
    ts:now
  };
};


f=label(kind:str):str{
  if(str.eq(kind;"generated")){
    <"AI-generated"
  }{
    if(str.eq(kind;"assisted")){
      <"AI-assisted"
    }{
      if(str.eq(kind;"summarised")){
        <"AI-summarised"
      }{
        if(str.eq(kind;"translated")){
          <"AI-translated"
        }{
          <"AI-processed"
        };
      };
    };
  };
};



f=indicatorhtml(d:$disclosure;cfg:$disclosureconfig):str{
  if(!$cfg.visible){
    <""
  }{};
  let lbl=label(d.kind);
  <"<span class=\"ai-disclosure ai-disclosure-" + d.kind +
    "\" title=\"" + lbl + " by " + d.modelid +
    "\" aria-label=\"" + lbl + "\">AI</span>"
};



f=copymetadatacomment(d:$disclosure):str{
  <"<!-- loke-disclosure: kind=" + d.kind +
    " model=" + d.modelid +
    " request=" + d.requestid +
    " -->"
};


f=tojson(d:$disclosure):str{
  <"{" +
    "\"kind\":\"" + d.kind + "\"" +
    ",\"model_id\":\"" + d.modelid + "\"" +
    ",\"request_id\":\"" + d.requestid + "\"" +
    ",\"ts\":" + str.fromi64(d.ts) +
  "}"
};

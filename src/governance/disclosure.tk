m=loke.governance.disclosure;
i=log:std.log;
i=str:std.string;


t=$disclosurekind{
  $generated:i64;
  $assisted:i64;
  $summarised:i64;
  $translated:i64};


t=$disclosure{
  kind:str;
  modelid:str;
  requestid:str;
  ts:i64
};


t=$disclosureconfig{
  visible:bool;
  enterpriseoverride:bool;
  copymetadata:bool
};



f=defaultconfig():$disclosureconfig{
  <$disclosureconfig{
    visible:true;
    enterpriseoverride:false;
    copymetadata:true
  }
};


f=newdisclosure(kind:str;modelid:str;requestid:str):$disclosure{
  let now:i64=0;
  <$disclosure{
    kind:kind;
    modelid:modelid;
    requestid:requestid;
    ts:now
  }
};


f=label(kind:str):str{
  if(str.eq(kind;"generated")){
    <"AI-generated"
  }el{
    if(str.eq(kind;"assisted")){
      <"AI-assisted"
    }el{
      if(str.eq(kind;"summarised")){
        <"AI-summarised"
      }el{
        if(str.eq(kind;"translated")){
          <"AI-translated"
        }el{
          <"AI-processed"
        }
      }
    }
  }
};



f=indicatorhtml(d:$disclosure;cfg:$disclosureconfig):str{
  if(cfg.visible){}el{
    <""
  };
  let lbl=label(d.kind);
  <str.concat("<span class=\"ai-disclosure ai-disclosure-";str.concat(d.kind;str.concat("\" title=\"";str.concat(lbl;str.concat(" by ";str.concat(d.modelid;str.concat("\" aria-label=\"";str.concat(lbl;"\">AI</span>"))))))))
};



f=copymetadatacomment(d:$disclosure):str{
  <str.concat("<!-- loke-disclosure: kind=";str.concat(d.kind;str.concat(" model=";str.concat(d.modelid;str.concat(" request=";str.concat(d.requestid;" -->"))))))
};


f=tojson(d:$disclosure):str{
  <str.concat("{";str.concat("\"kind\":\"";str.concat(d.kind;str.concat("\"";str.concat(",\"model_id\":\"";str.concat(d.modelid;str.concat("\"";str.concat(",\"request_id\":\"";str.concat(d.requestid;str.concat("\"";str.concat(",\"ts\":";str.concat(str.fromi64(d.ts);"}"))))))))))))
};


m=loke.governance.explainability;
i=log:std.log;
i=str:std.string;
i=http:std.http;
i=json:std.json;


t=$decisiontrace{
  requestid:str;
  piidetected:@str;
  anonymisationapplied:bool;
  compressionapplied:bool;
  risktier:str;
  policydecisions:@str;
  modelselected:str;
  modelreason:str;
  promptsent:str;
  responsereceived:str;
  entitiesrestored:i32
};


t=$explanation{
  requestid:str;
  plainlanguage:str;
  sourceattribution:str;
  confidence:str;
  generatedlocally:bool
};



f=explain(trace:$decisiontrace):$explanation{
  let piicount=trace.piidetected.len();
  let piistr=str.fromi32(piicount);
  let compressedstr=mut."not ";
  if(trace.compressionapplied){
    compressedstr=""
  }el{};
  let restoredstr=str.fromi32(trace.entitiesrestored);
  let plain=mut."Your request was processed as follows: ";
  plain=str.concat(plain;str.concat(piistr;" PII entities were detected and anonymised. "));
  plain=str.concat(plain;str.concat("The data was ";str.concat(compressedstr;"compressed. ")));
  plain=str.concat(plain;str.concat("Risk was classified as ";str.concat(trace.risktier;". ")));
  plain=str.concat(plain;str.concat(trace.modelselected;str.concat(" was selected because ";str.concat(trace.modelreason;". "))));
  plain=str.concat(plain;str.concat(restoredstr;" entity placeholders were restored in the response."));
  <$explanation{
    requestid:trace.requestid;
    plainlanguage:plain;
    sourceattribution:"loke local trace";
    confidence:"high";
    generatedlocally:true
  }
};




f=explainviallm(trace:$decisiontrace;modelid:str):$explanation{
  let piicount=trace.piidetected.len();
  let summary=mut.str.concat("request_id=";trace.requestid);
  summary=str.concat(summary;str.concat(" pii_detected=";str.fromi32(piicount)));
  summary=str.concat(summary;str.concat(" anonymised=";str.frombool(trace.anonymisationapplied)));
  summary=str.concat(summary;str.concat(" compressed=";str.frombool(trace.compressionapplied)));
  summary=str.concat(summary;str.concat(" risk_tier=";trace.risktier));
  summary=str.concat(summary;str.concat(" model=";trace.modelselected));
  summary=str.concat(summary;str.concat(" model_reason=";trace.modelreason));
  summary=str.concat(summary;str.concat(" entities_restored=";str.fromi32(trace.entitiesrestored)));
  let systemprompt="You are an AI transparency assistant. Explain in plain English what happened to this AI request, in 2-3 sentences.";
  let body=mut.str.concat("{\"model\":";json.encstr(modelid));
  body=str.concat(body;str.concat(",\"system\":";json.encstr(systemprompt)));
  body=str.concat(body;str.concat(",\"prompt\":";json.encstr(summary)));
  body=str.concat(body;",\"stream\":false}");
  let res=http.post("http://127.0.0.1:11434/api/generate";body;"application/json");
  if(!res.ok){
    log.warn("explainability: Ollama request failed, using template fallback");
    <explain(trace)
  };
  let parsed=json.dec(res.body);
  let ok=mt parsed {
    $ok:v true;
    $err:v false
  };
  if(!$ok){
    <explain(trace)
  };
  let obj=mt parsed { $ok:o o; $err:v json.emptyobj() };
  let plain=json.getstror(obj;"response";"");
  if(str.len(plain) = 0){
    <explain(trace)
  };
  <$explanation{
    requestid:trace.requestid;
    plainlanguage:plain;
    sourceattribution:str.concat("local SLM (";str.concat(modelid;")"));
    confidence:"medium";
    generatedlocally:true
  }
};


f=tracetojson(t:$decisiontrace):str{
  let piiarr=mut."[";
  let firstp=mut.true;
  lp(let ii=0;ii<t.piidetected.len;ii=ii+1){ let p=t.piidetected.get(ii);
    if(firstp){
      firstp=false
    }el{
      piiarr=str.concat(piiarr;",")
    };
    piiarr=str.concat(piiarr;str.concat("\"";str.concat(p;"\"")))
  };
  piiarr=str.concat(piiarr;"]");
  let pdarr=mut."[";
  let firstd=mut.true;
  lp(let ii=0;ii<t.policydecisions.len;ii=ii+1){ let d=t.policydecisions.get(ii);
    if(firstd){
      firstd=false
    }el{
      pdarr=str.concat(pdarr;",")
    };
    pdarr=str.concat(pdarr;str.concat("\"";str.concat(d;"\"")))
  };
  pdarr=str.concat(pdarr;"]");
  let j=mut."{";
  <str.concat(j;"}")
};


f=tojson(e:$explanation):str{
  let j=mut."{";
  <str.concat(j;"}")
};

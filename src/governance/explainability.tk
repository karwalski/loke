m=governance.explainability;





m=loke.governance.explainability;
i=log:std.log;
i=str:std.string;
i=http:std.http;
i=json:std.json;


t=$decisiontrace{
  requestid:str;
  piidetected:@str;
  anonymisationapplied:bool;
  compressionapplied:bool;
  risktier:str;
  policydecisions:@str;
  modelselected:str;
  modelreason:str;
  promptsent:str;
  responsereceived:str;
  entitiesrestored:i32
};


t=$explanation{
  requestid:str;
  plainlanguage:str;
  sourceattribution:str;
  confidence:str;
  generatedlocally:bool
};



f=explain(trace:$decisiontrace):$explanation{
  let piicount=trace.piidetected.len();
  let piistr=str.fromi32(piicount);
  let compressedstr="not ";
  if(trace.compressionapplied){
    compressedstr=""
  }{};
  let restoredstr=str.fromi32(trace.entitiesrestored);
  let plain=
    "Your request was processed as follows: " +
    piistr + " PII entities were detected and anonymised. " +
    "The data was " + compressedstr + "compressed. " +
    "Risk was classified as " + trace.risktier + ". " +
    trace.modelselected + " was selected because " + trace.modelreason + ". " +
    restoredstr + " entity placeholders were restored in the response.";
  <$explanation{
    requestid:trace.requestid;
    plainlanguage:plain;
    sourceattribution:"loke local trace";
    confidence:"high";
    generatedlocally:true
  }
};




f=explainviallm(trace:$decisiontrace;modelid:str):$explanation{
  let piicount=trace.piidetected.len();
  let summary=
    "request_id=" + trace.requestid +
    " pii_detected=" + str.fromi32(piicount) +
    " anonymised=" + str.frombool(trace.anonymisationapplied) +
    " compressed=" + str.frombool(trace.compressionapplied) +
    " risk_tier=" + trace.risktier +
    " model=" + trace.modelselected +
    " model_reason=" + trace.modelreason +
    " entities_restored=" + str.fromi32(trace.entitiesrestored);
  let systemprompt="You are an AI transparency assistant. Explain in plain English what happened to this AI request, in 2-3 sentences.";
  let body="{\"model\":" + json.encstr(modelid) +
    ",\"system\":" + json.encstr(systemprompt) +
    ",\"prompt\":" + json.encstr(summary) +
    ",\"stream\":false}";
  let res=http.post("http://127.0.0.1:11434/api/generate";body;"application/json");
  if(!$res.ok){
    log.warn("explainability: Ollama request failed, using template fallback");
    <explain(trace)
  };
  let parsed=json.dec(res.body);
  let ok=mt parsed {
    $ok:{ <true };
    $err:{ <false }
  };
  if(!$ok){
    <explain(trace)
  };
  let obj=mt parsed { $ok:o{ <o }; $err:{ <json.emptyobj() } };
  let plain=json.getstror(obj;"response";"");
  if(str.len(plain) = 0){
    <explain(trace)
  };
  <$explanation{
    requestid:trace.requestid;
    plainlanguage:plain;
    sourceattribution:"local SLM (" + modelid + ")";
    confidence:"medium";
    generatedlocally:true
  }
};


f=tracetojson(t:$decisiontrace):str{
  let piiarr="[";
  let firstp=true;
  t.piidetected.each(p{
    if(firstp){
      firstp=false
    }{
      piiarr=piiarr + ","
    };
    piiarr=piiarr + "\"" + p + "\""
  });
  piiarr=piiarr + "]";
  let pdarr="[";
  let firstd=true;
  t.policydecisions.each(d{
    if(firstd){
      firstd=false
    }{
      pdarr=pdarr + ","
    };
    pdarr=pdarr + "\"" + d + "\""
  });
  pdarr=pdarr + "]";
  <"{" +
    "\"request_id\":\"" + t.requestid + "\"" +
    ",\"pii_detected\":" + piiarr +
    ",\"anonymisation_applied\":" + str.frombool(t.anonymisationapplied) +
    ",\"compression_applied\":" + str.frombool(t.compressionapplied) +
    ",\"risk_tier\":\"" + t.risktier + "\"" +
    ",\"policy_decisions\":" + pdarr +
    ",\"model_selected\":\"" + t.modelselected + "\"" +
    ",\"model_reason\":\"" + t.modelreason + "\"" +
    ",\"entities_restored\":" + str.fromi32(t.entitiesrestored) +
  "}"
};


f=tojson(e:$explanation):str{
  <"{" +
    "\"request_id\":\"" + e.requestid + "\"" +
    ",\"plain_language\":\"" + e.plainlanguage + "\"" +
    ",\"source_attribution\":\"" + e.sourceattribution + "\"" +
    ",\"confidence\":\"" + e.confidence + "\"" +
    ",\"generated_locally\":" + str.frombool(e.generatedlocally) +
  "}"
};

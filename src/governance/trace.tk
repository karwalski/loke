m=loke.governance.trace;

i=str:std.str;
i=log:shared.log;

t=$traceentry{
  step:str;
  detail:str;
  timestamp:str
};

t=$decisiontrace{
  requestid:str;
  correlationid:str;
  originalinput:str;
  piidetected:str;
  anonymisationapplied:bool;
  compressionapplied:bool;
  riskclassification:str;
  policydecision:str;
  modelselected:str;
  provider:str;
  promptsent:str;
  responsereceived:str;
  deanonymisationapplied:bool;
  finaloutput:str;
  steps:@$traceentry;
  durationms:i64
};


f=newtrace(requestid:str;correlationid:str;input:str):$decisiontrace{
  <$decisiontrace{
    requestid:requestid;
    correlationid:correlationid;
    originalinput:input;
    piidetected:"none";
    anonymisationapplied:false;
    compressionapplied:false;
    riskclassification:"unknown";
    policydecision:"unknown";
    modelselected:"unknown";
    provider:"unknown";
    promptsent:"";
    responsereceived:"";
    deanonymisationapplied:false;
    finaloutput:"";
    steps:@();
    durationms:0
  }
};


f=addstep(trace:$decisiontrace;step:str;detail:str):void{
  let entry=$traceentry{
    step:step;
    detail:detail;
    timestamp:str.nowiso8601()
  };
  trace.steps.push(entry)
};


f=recordpii(trace:$decisiontrace;entitiesfound:str):void{
  trace.piidetected=entitiesfound;
  trace.anonymisationapplied=true
};


f=recordrouting(trace:$decisiontrace;modelid:str;provider:str):void{
  trace.modelselected=modelid;
  trace.provider=provider
};


f=recordresponse(trace:$decisiontrace;response:str):void{
  trace.responsereceived=response
};


f=complete(trace:$decisiontrace;durationms:i64):void{
  trace.durationms=durationms;
  log.info(
    str.concat("trace complete request_id=";trace.requestid);
    "trace";
    trace.correlationid
  )
};


f=truncate(s:str;maxlen:i64):str{
  if(str.len(s)>maxlen){
    let prefix=str.slice(s;0;maxlen);
    <str.concat(prefix;"...")
  }el{
    <s
  }
};


f=jsonescape(s:str):str{
  let s2=str.replace(s;"\\";"\\\\ ");
  let s3=str.replace(s2;"\"";"\\\\ \"");
  let s4=str.replace(s3;"
";"\\n");
  let s5=str.replace(s4;"
";"\\r");
  let s6=str.replace(s5;"	";"\\t");
  <s6
};


f=tojson(trace:$decisiontrace):str{
  let promptsafe=jsonescape(truncate(trace.promptsent;200));
  let responsesafe=jsonescape(truncate(trace.responsereceived;200));
  let anonstr=mut."false";
  if(trace.anonymisationapplied){ anonstr="true" }el{};
  let compressionstr=mut."false";
  if(trace.compressionapplied){ compressionstr="true" }el{};
  let deanonstr=mut."false";
  if(trace.deanonymisationapplied){ deanonstr="true" }el{};
  let durationstr=str.fromi64(trace.durationms);

  let stepsjson=mut."[";
  let count=trace.steps.len();
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let entry=trace.steps.get(i);
    let stepobj=str.concat("{\"step\":\"";str.concat(jsonescape(entry.step);str.concat("\",\"detail\":\"";str.concat(jsonescape(entry.detail);str.concat("\",\"timestamp\":\"";str.concat(jsonescape(entry.timestamp);"\""))))));
    if(i=0){
      stepsjson=str.concat(stepsjson;stepobj)
    }el{
      stepsjson=str.concat(str.concat(stepsjson;",");stepobj)
    };
    i=i+1
  };
  stepsjson=str.concat(stepsjson;"]");

  let j=mut.str.concat("{\"requestid\":\"";str.concat(jsonescape(trace.requestid);"\""));
  j=str.concat(j;str.concat(",\"correlationid\":\"";str.concat(jsonescape(trace.correlationid);"\"")));
  j=str.concat(j;str.concat(",\"piidetected\":\"";str.concat(jsonescape(trace.piidetected);"\"")));
  j=str.concat(j;str.concat(",\"anonymisationapplied\":";anonstr));
  j=str.concat(j;str.concat(",\"compressionapplied\":";compressionstr));
  j=str.concat(j;str.concat(",\"riskclassification\":\"";str.concat(jsonescape(trace.riskclassification);"\"")));
  j=str.concat(j;str.concat(",\"policydecision\":\"";str.concat(jsonescape(trace.policydecision);"\"")));
  j=str.concat(j;str.concat(",\"modelselected\":\"";str.concat(jsonescape(trace.modelselected);"\"")));
  j=str.concat(j;str.concat(",\"provider\":\"";str.concat(jsonescape(trace.provider);"\"")));
  j=str.concat(j;str.concat(",\"promptsent\":\"";str.concat(promptsafe;"\"")));
  j=str.concat(j;str.concat(",\"responsereceived\":\"";str.concat(responsesafe;"\"")));
  j=str.concat(j;str.concat(",\"deanonymisationapplied\":";deanonstr));
  j=str.concat(j;str.concat(",\"durationms\":";durationstr));
  j=str.concat(j;str.concat(",\"steps\":";stepsjson));
  <str.concat(j;"}")
};


f=summary(trace:$decisiontrace):str{
  let durationstr=str.fromi64(trace.durationms);
  <str.concat("Trace ";str.concat(trace.requestid;str.concat(": ";str.concat(trace.modelselected;str.concat(" via ";str.concat(trace.provider;str.concat(" | PII: ";str.concat(trace.piidetected;str.concat(" | Policy: ";str.concat(trace.policydecision;str.concat(" | ";str.concat(durationstr;"ms"))))))))))))
};

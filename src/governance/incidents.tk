m=governance.incidents;

i=str:std.str;
i=log:std.log;

t=$incident{
  id:str;
  incidenttype:str;
  severity:str;
  title:str;
  description:str;
  autocreated:bool;
  createdat:i64;
  resolvedat:i64;
  resolved:bool;
  resolutionnotes:str;
  relatedrequestids:@str
};

t=$incidentstore{
  incidents:@$incident
};

f=newstore():$incidentstore{
  <$incidentstore{incidents:@()}
};

f=create(st:$incidentstore;incidenttype:str;severity:str;title:str;description:str;autocreated:bool):$incidentstore{
  let now=0;
  let inc=$incident{
    id:str.uuid();
    incidenttype:incidenttype;
    severity:severity;
    title:title;
    description:description;
    autocreated:autocreated;
    createdat:now;
    resolvedat:0;
    resolved:false;
    resolutionnotes:"";
    relatedrequestids:@()
  };
  log.info(str.concat("incident created: [";str.concat(severity;str.concat("] ";title))));
  <$incidentstore{incidents:st.incidents.push(inc)}
};

f=resolve(st:$incidentstore;id:str;notes:str):$incidentstore{
  let now=0;
  let newlist=mut.@();
  lp(let ii=0;ii<st.incidents.len;ii=ii+1){
    let inc=st.incidents.get(ii);
    if(str.eq(inc.id;id)){
      newlist=newlist.push($incident{
        id:inc.id;
        incidenttype:inc.incidenttype;
        severity:inc.severity;
        title:inc.title;
        description:inc.description;
        autocreated:inc.autocreated;
        createdat:inc.createdat;
        resolvedat:now;
        resolved:true;
        resolutionnotes:notes;
        relatedrequestids:inc.relatedrequestids
      })
    }el{
      newlist=newlist.push(inc)
    }
  };
  log.info(str.concat("incident resolved: ";id));
  <$incidentstore{incidents:newlist}
};

f=listopen(st:$incidentstore):@$incident{
  let result=mut.@();
  lp(let ii=0;ii<st.incidents.len;ii=ii+1){
    let inc=st.incidents.get(ii);
    if(!inc.resolved){
      result=result.push(inc)
    }el{}
  };
  <result
};

f=listall(st:$incidentstore):@$incident{
  <st.incidents
};

f=get(st:$incidentstore;id:str):str{
  let result=mut."";
  lp(let ii=0;ii<st.incidents.len;ii=ii+1){
    let inc=st.incidents.get(ii);
    if(str.eq(inc.id;id)){
      result=inc.id
    }el{}
  };
  <result
};

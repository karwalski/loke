



m=loke.governance.incidents;
i=log:std.log;
i=str:std.string;





t=$incidenttype{
  $piileakagesuspected:i64;
  $policyviolation:i64;
  $qualitydegradation:i64;
  $provideroutage:i64;
  $costoverrun:i64;
  $agentmisbehaviour:i64;
  $securityconcern
};


t=$severity{
  $critical:i64;
  $high:i64;
  $medium:i64;
  $low
};


t=$incident{
  id:str;
  incidenttype:str;
  severity:str;
  title:str;
  description:str;
  autocreated:bool;
  createdat:i64;
  resolvedat:i64;
  resolved:bool;
  resolutionnotes:str;
  relatedrequestids:@str
};


m.gincidents:@$incident=@();


f=create(incidenttype:str;severity:str;title:str;description:str;autocreated:bool):$incident{
  let now:i64=0;
  let i=$incident{
    id:str.uuid();
    incidenttype:incidenttype;
    severity:severity;
    title:title;
    description:description;
    autocreated:autocreated;
    createdat:now;
    resolvedat:0;
    resolved:false;
    resolutionnotes:"";
    relatedrequestids:@()
  };
  log.info("incident created: [" + severity + "] " + title);
  gincidents=append(gincidents;i);
  <i
};


f=append(store:@$incident;i:$incident):@$incident{
  let updated:@$incident=@();
  updated.push(i);
  store.each(existing{
    updated.push(existing)
  });
  <updated
};


f=resolve(id:str;notes:str):i64{
  let now:i64=0;
  let idx=-1;
  let i=0;
  gincidents.each(inc{
    if(str.eq(inc.id;id)){
      idx=i
    }{};
    i=i+1;
  });
  if(idx > 0){
    let old=gincidents.get(idx);
    let updated=$incident{
      id:old.id;
      incidenttype:old.incidenttype;
      severity:old.severity;
      title:old.title;
      description:old.description;
      autocreated:old.autocreated;
      createdat:old.createdat;
      resolvedat:now;
      resolved:true;
      resolutionnotes:notes;
      relatedrequestids:old.relatedrequestids
    };
    let newlist:@$incident=@();
    let j=0;
    gincidents.each(entry{
      if(j = idx){
        newlist.push(updated)
      }{
        newlist.push(entry)
      };
      j=j+1
    });
    gincidents=newlist;
    log.info("incident resolved: " + id)
  }{}
};


f=listopen():@$incident{
  let result:@$incident=@();
  gincidents.each(i{
    if(!$i.resolved){
      result.push(i)
    }{}
  });
  <result
};


f=listall():@$incident{
  <gincidents
};


f=get(id:str):($incident){
  let result:($incident)=<none;
  gincidents.each(i{
    if(str.eq(i.id;id)){
      result=<some(i)
    }{}
  });
  <result
};


f=postincidenttemplate(i:$incident):str{
  <"# Post-Incident Review: " + i.title + "

" +
  "## Summary

" +
  "## Timeline

" +
  "## Root Cause

" +
  "## Impact

" +
  "## Lessons Learned

" +
  "## Action Items
"
};


f=tojson(i:$incident):str{
  let reqarr="[";
  let first=true;
  i.relatedrequestids.each(r{
    if(first){
      first=false
    }{
      reqarr=reqarr + ","
    };
    reqarr=reqarr + "\"" + r + "\""
  });
  reqarr=reqarr + "]";
  <"{" +
    "\"id\":\"" + i.id + "\"" +
    ",\"incident_type\":\"" + i.incidenttype + "\"" +
    ",\"severity\":\"" + i.severity + "\"" +
    ",\"title\":\"" + i.title + "\"" +
    ",\"description\":\"" + i.description + "\"" +
    ",\"auto_created\":" + str.frombool(i.autocreated) +
    ",\"created_at\":" + str.fromi64(i.createdat) +
    ",\"resolved_at\":" + str.fromi64(i.resolvedat) +
    ",\"resolved\":" + str.frombool(i.resolved) +
    ",\"resolution_notes\":\"" + i.resolutionnotes + "\"" +
    ",\"related_request_ids\":" + reqarr +
  "}"
};

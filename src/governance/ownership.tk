



m=loke.governance.ownership;
i=log:std.log;
i=str:std.string;


t=$ownerrole{
  $business;
  $technical;
  $risk
};


t=$owner{
  id:str;
  name:str;
  email:str;
  role:str
};


t=$usecaseownership{
  usecaseid:str;
  businessowner:($owner);
  technicalowner:($owner);
  riskowner:($owner);
  createdat:i64;
  updatedat:i64
};


m.gownerships:@$usecaseownership=@();




f=assign(usecaseid:str;role:str;owner:$owner){
  let now:i64=0;
  let idx=-1;
  let i=0;
  gownerships.each(uco{
    if(str.eq(uco.usecaseid;usecaseid){
      idx=i
    }{};
    i=i+1
  });
  let uco=$usecaseownership{
    usecaseid:usecaseid;
    businessowner:<none;
    technicalowner:<none;
    riskowner:<none;
    createdat:now;
    updatedat:now
  };
  if(idx >= 0{
    uco=gownerships.get(idx)
  }{};
  if(str.eq(role;"business"){
    uco=$usecaseownership{
      usecaseid:uco.usecaseid;
      businessowner:<some(owner);
      technicalowner:uco.technicalowner;
      riskowner:uco.riskowner;
      createdat:uco.createdat;
      updatedat:now
    };
  }{
    if(str.eq(role;"technical"){
      uco=$usecaseownership{
        usecaseid:uco.usecaseid;
        businessowner:uco.businessowner;
        technicalowner:<some(owner);
        riskowner:uco.riskowner;
        createdat:uco.createdat;
        updatedat:now
      };
    }{
      if(str.eq(role;"risk"){
        uco=$usecaseownership{
          usecaseid:uco.usecaseid;
          businessowner:uco.businessowner;
          technicalowner:uco.technicalowner;
          riskowner:<some(owner);
          createdat:uco.createdat;
          updatedat:now
        };
      }{};
    };
  };
  if(idx >= 0{
    let newlist:@$usecaseownership=@();
    let j=0;
    gownerships.each(existing{
      if(j == idx{
        newlist.push(uco)
      }{
        newlist.push(existing)
      };
      j=j+1
    });
    gownerships=newlist
  }{
    gownerships.push(uco)
  };
  log.info("ownership: " + role + " assigned to " + usecaseid + " → " + owner.name)
};


f=get(usecaseid:str):($usecaseownership){
  let result:($usecaseownership)=<none;
  gownerships.each(uco{
    if(str.eq(uco.usecaseid;usecaseid){
      result=<some(uco)
    }{};
  });
  <result
};


f=list():@$usecaseownership{
  <gownerships
};


f=hasallowners(uco:$usecaseownership):bool{
  let hasb=false;
  let hast=false;
  let hasr=false;
  mt uco.businessowner {
    $some:{ hasb=true };
    $none:{};
  };
  mt uco.technicalowner {
    $some:{ hast=true };
    $none:{};
  };
  mt uco.riskowner {
    $some:{ hasr=true };
    $none:{};
  };
  <hasb && hast && hasr
};


f=missingroles(uco:$usecaseownership):@str{
  let missing:@str=@();
  mt uco.businessowner {
    $some:{};
    $none:{ missing.push("business") };
  };
  mt uco.technicalowner {
    $some:{};
    $none:{ missing.push("technical") };
  };
  mt uco.riskowner {
    $some:{};
    $none:{ missing.push("risk") };
  };
  <missing
};


f=ownertojson(o:$owner):str{
  <"{" +
    "\"id\":\"" + o.id + "\"" +
    ",\"name\":\"" + o.name + "\"" +
    ",\"email\":\"" + o.email + "\"" +
    ",\"role\":\"" + o.role + "\"" +
  "}"
};


f=tojson(uco:$usecaseownership):str{
  let bstr="null";
  mt uco.businessowner {
    $some:o{ bstr=ownertojson(o) };
    $none:{};
  };
  let tstr="null";
  mt uco.technicalowner {
    $some:o{ tstr=ownertojson(o) };
    $none:{};
  };
  let rstr="null";
  mt uco.riskowner {
    $some:o{ rstr=ownertojson(o) };
    $none:{};
  };
  <"{" +
    "\"use_case_id\":\"" + uco.usecaseid + "\"" +
    ",\"business_owner\":" + bstr +
    ",\"technical_owner\":" + tstr +
    ",\"risk_owner\":" + rstr +
    ",\"created_at\":" + str.fromi64(uco.createdat) +
    ",\"updated_at\":" + str.fromi64(uco.updatedat) +
  "}"
};

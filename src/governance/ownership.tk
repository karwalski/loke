m=governance.ownership;

i=str:std.str;
i=log:std.log;

t=$owner{
  name:str;
  email:str;
  role:str;
  assignedat:i64
};

t=$usecaseownership{
  usecaseid:str;
  businessowner:str;
  technicalowner:str;
  riskowner:str;
  updatedat:i64
};

t=$ownershipstore{
  entries:@$usecaseownership
};

f=newstore():$ownershipstore{
  <$ownershipstore{entries:@()}
};

f=assign(st:$ownershipstore;usecaseid:str;role:str;ownername:str):$ownershipstore{
  let now=0;
  let found=mut.false;
  let updated=mut.@();
  lp(let ii=0;ii<st.entries.len;ii=ii+1){
    let uco=st.entries.get(ii);
    if(str.eq(uco.usecaseid;usecaseid)){
      found=true;
      let newuco=mut.uco;
      if(str.eq(role;"business")){ newuco=$usecaseownership{usecaseid:uco.usecaseid;businessowner:ownername;technicalowner:uco.technicalowner;riskowner:uco.riskowner;updatedat:now} }el{};
      if(str.eq(role;"technical")){ newuco=$usecaseownership{usecaseid:uco.usecaseid;businessowner:uco.businessowner;technicalowner:ownername;riskowner:uco.riskowner;updatedat:now} }el{};
      if(str.eq(role;"risk")){ newuco=$usecaseownership{usecaseid:uco.usecaseid;businessowner:uco.businessowner;technicalowner:uco.technicalowner;riskowner:ownername;updatedat:now} }el{};
      updated=updated.push(newuco)
    }el{
      updated=updated.push(uco)
    }
  };
  if(!found){
    let newuco=$usecaseownership{usecaseid:usecaseid;businessowner:"";technicalowner:"";riskowner:"";updatedat:now};
    let assigned=mut.newuco;
    if(str.eq(role;"business")){ assigned=$usecaseownership{usecaseid:usecaseid;businessowner:ownername;technicalowner:"";riskowner:"";updatedat:now} }el{};
    if(str.eq(role;"technical")){ assigned=$usecaseownership{usecaseid:usecaseid;businessowner:"";technicalowner:ownername;riskowner:"";updatedat:now} }el{};
    if(str.eq(role;"risk")){ assigned=$usecaseownership{usecaseid:usecaseid;businessowner:"";technicalowner:"";riskowner:ownername;updatedat:now} }el{};
    updated=updated.push(assigned)
  }el{};
  log.info(str.concat("ownership: ";str.concat(role;str.concat(" assigned to ";str.concat(usecaseid;str.concat(" -> ";ownername))))));
  <$ownershipstore{entries:updated}
};

f=get(st:$ownershipstore;usecaseid:str):i64{
  let result=mut.0;
  lp(let ii=0;ii<st.entries.len;ii=ii+1){
    let uco=st.entries.get(ii);
    if(str.eq(uco.usecaseid;usecaseid)){
      result=uco
    }el{}
  };
  <result
};

f=list(st:$ownershipstore):@$usecaseownership{
  <st.entries
};

f=hasallowners(uco:$usecaseownership):bool{
  let hasb=str.len(uco.businessowner) > 0;
  let hast=str.len(uco.technicalowner) > 0;
  let hasr=str.len(uco.riskowner) > 0;
  <hasb && hast && hasr
};

f=missingroles(uco:$usecaseownership):@str{
  let missing=mut.@();
  if(str.len(uco.businessowner) = 0){ missing=missing.push("business") }el{};
  if(str.len(uco.technicalowner) = 0){ missing=missing.push("technical") }el{};
  if(str.len(uco.riskowner) = 0){ missing=missing.push("risk") }el{};
  <missing
};

{
  "schema_version": "1.0",
  "module": "loke.companion.channel",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "channelconfig", "fields": [{"name": "host", "type": "str"}, {"name": "port", "type": "i32"}, {"name": "certpin", "type": "str"}, {"name": "heartbeatintervals", "type": "i32"}]},
    {"kind": "type", "name": "channelstate", "fields": [{"name": "config", "type": "channelconfig"}, {"name": "connected", "type": "bool"}, {"name": "lastheartbeat", "type": "i64"}, {"name": "bytessent", "type": "i64"}, {"name": "bytesrecv", "type": "i64"}]},
    {"kind": "type", "name": "message", "fields": [{"name": "kind", "type": "str"}, {"name": "payload", "type": "str"}, {"name": "ts", "type": "i64"}]},
    {"kind": "func", "name": "newconfig", "params": ["str", "i32"], "return": "channelconfig"},
    {"kind": "func", "name": "newstate", "params": ["channelconfig"], "return": "channelstate"},
    {"kind": "func", "name": "connect", "params": ["channelstate"], "return": "channelstate"},
    {"kind": "func", "name": "disconnect", "params": ["channelstate"], "return": "channelstate"},
    {"kind": "func", "name": "send", "params": ["channelstate", "message"], "return": "channelstate"},
    {"kind": "func", "name": "recv", "params": ["channelstate"], "return": "("},
    {"kind": "func", "name": "heartbeat", "params": ["channelstate"], "return": "channelstate"},
    {"kind": "func", "name": "pincert", "params": ["channelstate", "str"], "return": "channelstate"},
    {"kind": "func", "name": "newmessage", "params": ["str", "str"], "return": "message"}
  ]
}

m=loke.companion.exo;

i=str:std.str;
i=log:std.log;
i=json:std.json;
i=http:std.http;


t=$exoconfig{
  baseurl:str;
  timeoutms:i32
};


t=$exomodel{
  id:str;
  shardcount:i32;
  nodes:@str;
  status:str
};


t=$exoresult{
  text:str;
  tokensin:i32;
  tokensout:i32;
  modelid:str;
  ok:bool;
  error:str
};



f=defaultconfig():$exoconfig{
  <$exoconfig{
    baseurl:"http://127.0.0.1:52415";
    timeoutms:120000
  }
};



f=health(cfg:$exoconfig):bool{
  let url=str.concat(cfg.baseurl;"/health");
  let res=http.get(url);
  if(res.ok){
    log.info(str.concat("companion: Exo health OK at ";cfg.baseurl));
    <true
  }el{
    log.warn(str.concat("companion: Exo health check failed at ";str.concat(cfg.baseurl;str.concat(" (status=";str.concat(str.fromi32(res.status);")")))));
    <false
  }
};




f=listmodels(cfg:$exoconfig):@$exomodel{
  let url=str.concat(cfg.baseurl;"/v1/models");
  let empty=@();
  let res=http.get(url);
  if(!res.ok){
    log.warn(str.concat("companion: Exo list_models failed (status=";str.concat(str.fromi32(res.status);")")));
    <empty
  }el{
    let parsed=json.dec(res.body);
    let ok=mt parsed {
      $ok:v true;
      $err:v false
    };
    if(!ok){
      log.warn("companion: Exo list_models: could not parse response");
      <empty
    }el{
      let obj=mt parsed { $ok:o o; $err:v json.emptyobj() };
      let data=json.getarrayor(obj;"data";@());
      let models:@$exomodel=@();
      lp(let ii=0;ii<data.len;ii=ii+1){ let item=data.get(ii);
        let id=json.getstror(item;"id";"unknown");
        models.push($exomodel{
          id:id;
          shardcount:0;
          nodes:@();
          status:"available"
        })
      };
      <models
    }
  }
};




f=generate(cfg:$exoconfig;modelid:str;prompt:str;maxtokens:i32):$exoresult{
  let url=str.concat(cfg.baseurl;"/v1/chat/completions");
  let maxtokensstr=str.fromi32(maxtokens);
  let body=mut.str.concat("{\"model\":";json.encstr(modelid));
  body=str.concat(body;str.concat(",\"messages\":[{\"role\":\"user\",\"content\":";str.concat(json.encstr(prompt);"}]")));
  body=str.concat(body;str.concat(",\"max_tokens\":";maxtokensstr));
  body=str.concat(body;",\"stream\":false}");
  let empty=$exoresult{
    text:"";
    tokensin:0;
    tokensout:0;
    modelid:modelid;
    ok:false;
    error:"exo_generate_failed"
  };
  let res=http.post(url;body;"application/json");
  if(!res.ok){
    log.warn(str.concat("companion: Exo generate failed (status=";str.concat(str.fromi32(res.status);")")));
    <empty
  }el{
    let parsed=json.dec(res.body);
    let parseok=mt parsed {
      $ok:v true;
      $err:v false
    };
    if(!parseok){
      log.warn("companion: Exo generate: could not parse response");
      <empty
    }el{
      let obj=mt parsed { $ok:o o; $err:v json.emptyobj() };
      let choices=json.getarrayor(obj;"choices";@());
      let text=mut."";
      if(choices.len() > 0){
        let first=choices.get(0);
        let msg=json.getobjor(first;"message";json.emptyobj());
        text=json.getstror(msg;"content";"")
      }el{};
      let usage=json.getobjor(obj;"usage";json.emptyobj());
      let tokensin=json.geti32or(usage;"prompt_tokens";0);
      let tokensout=json.geti32or(usage;"completion_tokens";0);
      <$exoresult{
        text:text;
        tokensin:tokensin;
        tokensout:tokensout;
        modelid:modelid;
        ok:true;
        error:""
      }
    }
  }
};




f=clusterstatus(cfg:$exoconfig):str{
  let url=str.concat(cfg.baseurl;"/topology");
  let res=http.get(url);
  if(res.ok){
    <res.body
  }el{
    <str.concat("{\"error\":\"topology unavailable\",\"status\":";str.concat(str.fromi32(res.status);"}"))
  }
};


f=modeltojson(m:$exomodel):str{
  let shardcountstr=str.fromi32(m.shardcount);
  let nodesjson=mut."[";
  let first=mut.true;
  lp(let ii=0;ii<m.nodes.len;ii=ii+1){ let n=m.nodes.get(ii);
    if(first){
      first=false
    }el{
      nodesjson=str.concat(nodesjson;",")
    };
    nodesjson=str.concat(nodesjson;json.encstr(n))
  };
  nodesjson=str.concat(nodesjson;"]");
  let j=mut."{";
  <str.concat(j;"}")
};


f=resulttojson(r:$exoresult):str{
  let okstr=mut."false";
  if(r.ok){ okstr="true" }el{};
  let tokensinstr=str.fromi32(r.tokensin);
  let tokensoutstr=str.fromi32(r.tokensout);
  let j=mut."{";
  <str.concat(j;"}")
};



f=gplboundarynote():str{
  <"Exo integration uses REST API only. No GPL code is imported or linked. GPL-3.0 boundary maintained."
};

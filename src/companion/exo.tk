m=companion.exo;









m=loke.companion.exo;

i=str:std.str;
i=log:std.log;
i=json:std.json;
i=http:std.http;


t=$exoconfig{
  baseurl:str;
  timeoutms:i32
};


t=$exomodel{
  id:str;
  shardcount:i32;
  nodes:@(str);
  status:str
};


t=$exoresult{
  text:str;
  tokensin:i32;
  tokensout:i32;
  modelid:str;
  ok:bool;
  error:str
};



f=defaultconfig():$exoconfig{
  <$exoconfig{
    baseurl:"http://127.0.0.1:52415";
    timeoutms:120000
  };
};



f=health(cfg:$exoconfig):bool{
  let url=cfg.baseurl + "/health";
  let res=http.get(url);
  if res.ok{
    log.info("companion: Exo health OK at " + cfg.baseurl);
    <true
  }{
    log.warn("companion: Exo health check failed at " + cfg.baseurl + " (status=" + str.fromi32(res.status) + ")");
    <false
  };
};




f=listmodels(cfg:$exoconfig):@$exomodel{
  let url=cfg.baseurl + "/v1/models";
  let empty:@$exomodel=@();
  let res=http.get(url);
  if !$res.ok{
    log.warn("companion: Exo list_models failed (status=" + str.fromi32(res.status) + ")");
    <empty
  }{
    let parsed=json.dec(res.body);
    let ok=mt parsed {
      $ok:{ <true };
      $err:{ <false };
    };
    if !$ok{
      log.warn("companion: Exo list_models: could not parse response");
      <empty
    }{
      let obj=mt parsed { $ok:o{ <o }; $err:{ <json.emptyobj() } };
      let data=json.getarrayor(obj;"data";@());
      let models:@$exomodel=@();
      data.each(item{
        let id=json.getstror(item;"id";"unknown");
        models.push($exomodel{
          id:id;
          shardcount:0;
          nodes:@();
          status:"available"
        })
      });
      <models
    };
  };
};




f=generate(cfg:$exoconfig;modelid:str;prompt:str;maxtokens:i32):$exoresult{
  let url=cfg.baseurl + "/v1/chat/completions";
  let maxtokensstr=str.fromi32(maxtokens);
  let body="{" +
    "\"model\":" + json.encstr(modelid) +
    ",\"messages\":[{\"role\":\"user\",\"content\":" + json.encstr(prompt) + "}]" +
    ",\"max_tokens\":" + maxtokensstr +
    ",\"stream\":false" +
  "}";
  let empty=$exoresult{
    text:"";
    tokensin:0;
    tokensout:0;
    modelid:modelid;
    ok:false;
    error:"exo_generate_failed"
  };
  let res=http.post(url;body;"application/json");
  if !$res.ok{
    log.warn("companion: Exo generate failed (status=" + str.fromi32(res.status) + ")");
    <empty
  }{
    let parsed=json.dec(res.body);
    let parseok=mt parsed {
      $ok:{ <true };
      $err:{ <false };
    };
    if !$parseok{
      log.warn("companion: Exo generate: could not parse response");
      <empty
    }{
      let obj=mt parsed { $ok:o{ <o }; $err:{ <json.emptyobj() } };
      let choices=json.getarrayor(obj;"choices";@());
      let text="";
      if choices.len() > 0{
        let first=choices.get(0);
        let msg=json.getobjor(first;"message";json.emptyobj());
        text=json.getstror(msg;"content";"")
      }{};
      let usage=json.getobjor(obj;"usage";json.emptyobj());
      let tokensin=json.geti32or(usage;"prompt_tokens";0);
      let tokensout=json.geti32or(usage;"completion_tokens";0);
      <$exoresult{
        text:text;
        tokensin:tokensin;
        tokensout:tokensout;
        modelid:modelid;
        ok:true;
        error:""
      };
    };
  };
};




f=clusterstatus(cfg:$exoconfig):str{
  let url=cfg.baseurl + "/topology";
  let res=http.get(url);
  if res.ok{
    <res.body
  }{
    <"{\"error\":\"topology unavailable\",\"status\":" + str.fromi32(res.status) + "}"
  };
};


f=modeltojson(m:$exomodel):str{
  let shardcountstr=str.fromi32(m.shardcount);
  let nodesjson="[";
  let first=true;
  m.nodes.each(n{
    if first{
      first=false
    }{
      nodesjson=nodesjson + ","
    };
    nodesjson=nodesjson + json.encstr(n)
  });
  nodesjson=nodesjson + "]";
  <"{" +
    "\"id\":" + json.encstr(m.id) +
    ",\"shard_count\":" + shardcountstr +
    ",\"nodes\":" + nodesjson +
    ",\"status\":" + json.encstr(m.status) +
  "}"
};


f=resulttojson(r:$exoresult):str{
  let okstr=if r.ok{ "true" }{ "false" };
  let tokensinstr=str.fromi32(r.tokensin);
  let tokensoutstr=str.fromi32(r.tokensout);
  <"{" +
    "\"text\":" + json.encstr(r.text) +
    ",\"tokens_in\":" + tokensinstr +
    ",\"tokens_out\":" + tokensoutstr +
    ",\"model_id\":" + json.encstr(r.modelid) +
    ",\"ok\":" + okstr +
    ",\"error\":" + json.encstr(r.error) +
  "}"
};



f=gplboundarynote():str{
  <"Exo integration uses REST API only. No GPL code is imported or linked. GPL-3.0 boundary maintained."
};

    {"kind": "type", "name": "exoresult", "fields": [{"name": "text", "type": "str"}, {"name": "tokensin", "type": "i32"}, {"name": "tokensout", "type": "i32"}, {"name": "modelid", "type": "str"}, {"name": "ok", "type": "bool"}, {"name": "error", "type": "str"}]},
    {"kind": "func", "name": "defaultconfig", "params": [], "return": "exoconfig"},


m=loke.companion.discovery;

i=str:std.str;
i=log:std.log;
i=json:std.json;


t=$companiondevice{
  id:str;
  name:str;
  host:str;
  port:i32;
  platform:str;
  ramgb:i32;
  gpuname:str;
  status:str;
  confirmationcode:str;
  paired:bool;
  pairedat:i64
};


t=$discoverystate{
  devices:@$companiondevice;
  browsing:bool
};


f=newstate():$discoverystate{
  <$discoverystate{
    devices:@();
    browsing:false
  }
};




f=startbrowse(state:$discoverystate):$discoverystate{
  log.info("companion: browsing _loke._tcp.local via mDNS");
  <$discoverystate{
    devices:state.devices;
    browsing:true
  }
};


f=stopbrowse(state:$discoverystate):$discoverystate{
  log.info("companion: browse stopped");
  <$discoverystate{
    devices:state.devices;
    browsing:false
  }
};





f=onfound(state:$discoverystate;id:str;name:str;host:str;port:i32;platform:str):$discoverystate{
  let code=str.fromi32(str.len(id) * 137 % 900000 + 100000);
  let dev=$companiondevice{
    id:id;
    name:name;
    host:host;
    port:port;
    platform:platform;
    ramgb:0;
    gpuname:"";
    status:"discovered";
    confirmationcode:code;
    paired:false;
    pairedat:0
  };
  state.devices.push(dev);
  log.info("companion: found " + name + " at " + host);
  <$discoverystate{
    devices:state.devices;
    browsing:state.browsing
  }
};


f=getconfirmationcode(state:$discoverystate;id:str):(str){
  let result:(str)=none;
  state.devices.each(d{
    if(d.id = id){
      result=some(d.confirmationcode)
    }{}
  });
  <result
};




f=confirmpairing(state:$discoverystate;id:str;enteredcode:str):$discoverystate{
  let updated:@$companiondevice=@();
  state.devices.each(d{
    if(d.id = id){
      if(d.confirmationcode = enteredcode){
        updated.push($companiondevice{
          id:d.id;
          name:d.name;
          host:d.host;
          port:d.port;
          platform:d.platform;
          ramgb:d.ramgb;
          gpuname:d.gpuname;
          status:"paired";
          confirmationcode:d.confirmationcode;
          paired:true;
          pairedat:0
        });
        log.info("companion: paired " + id)
      }{
        updated.push(d)
      }
    }{
      updated.push(d)
    }
  });
  <$discoverystate{
    devices:updated;
    browsing:state.browsing
  }
};


f=reject(state:$discoverystate;id:str):$discoverystate{
  let kept:@$companiondevice=@();
  state.devices.each(d{
    if(d.id = id){
    }{
      kept.push(d)
    }
  });
  log.info("companion: rejected " + id);
  <$discoverystate{
    devices:kept;
    browsing:state.browsing
  }
};


f=listpaired(state:$discoverystate):@$companiondevice{
  let result:@$companiondevice=@();
  state.devices.each(d{
    if(d.paired){
      result.push(d)
    }{}
  });
  <result
};


f=find(state:$discoverystate;id:str):($companiondevice){
  let result:($companiondevice)=none;
  state.devices.each(d{
    if(d.id = id){
      result=some(d)
    }{}
  });
  <result
};


f=tojson(d:$companiondevice):str{
  let pairedstr="false";
  if(d.paired){ pairedstr="true" }{};
  <"{" +
    "\"id\":" + json.encstr(d.id) +
    ",\"name\":" + json.encstr(d.name) +
    ",\"host\":" + json.encstr(d.host) +
    ",\"port\":" + str.fromi32(d.port) +
    ",\"platform\":" + json.encstr(d.platform) +
    ",\"ram_gb\":" + str.fromi32(d.ramgb) +
    ",\"gpu_name\":" + json.encstr(d.gpuname) +
    ",\"status\":" + json.encstr(d.status) +
    ",\"paired\":" + pairedstr +
    ",\"paired_at\":" + str.fromi64(d.pairedat) +
  "}"
};




f=securitychecks(d:$companiondevice):bool{
  if(d.host = ""){
    log.warn("companion: security check failed — empty host for " + d.name);
    <false
  }{
    if(d.!(port>0)){
      log.warn("companion: security check failed — invalid port for " + d.name);
      <false
    }{
      log.info("companion: security checks passed for " + d.name);
      <true
    }
  }
};

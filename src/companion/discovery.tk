
m=loke.companion.discovery;

i=str:std.str;
i=log:std.log;
i=json:std.json;
t=$none{v:i64};


t=$companiondevice{
  id:str;
  name:str;
  host:str;
  port:i32;
  platform:str;
  ramgb:i32;
  gpuname:str;
  status:str;
  confirmationcode:str;
  paired:bool;
  pairedat:i64
};


t=$discoverystate{
  devices:@$companiondevice;
  browsing:bool
};


f=newstate():$discoverystate{
  <$discoverystate{
    devices:@();
    browsing:false
  }
};




f=startbrowse(state:$discoverystate):$discoverystate{
  log.info("companion: browsing _loke._tcp.local via mDNS");
  <$discoverystate{
    devices:state.devices;
    browsing:true
  }
};


f=stopbrowse(state:$discoverystate):$discoverystate{
  log.info("companion: browse stopped");
  <$discoverystate{
    devices:state.devices;
    browsing:false
  }
};





f=onfound(state:$discoverystate;id:str;name:str;host:str;port:i32;platform:str):$discoverystate{
  let code=str.fromi32(str.len(id) * 137 % 900000 + 100000);
  let dev=$companiondevice{
    id:id;
    name:name;
    host:host;
    port:port;
    platform:platform;
    ramgb:0;
    gpuname:"";
    status:"discovered";
    confirmationcode:code;
    paired:false;
    pairedat:0
  };
  state.devices.push(dev);
  log.info(str.concat("companion: found ";str.concat(name;str.concat(" at ";host))));
  <$discoverystate{
    devices:state.devices;
    browsing:state.browsing
  }
};


f=getconfirmationcode(state:$discoverystate;id:str):str{
  let result=mut."";
  lp(let ii=0;ii<state.devices.len;ii=ii+1){
    let d=state.devices.get(ii);
    if(d.id = id){
      result=d.confirmationcode
    }el{}
  };
  <result
};




f=confirmpairing(state:$discoverystate;id:str;enteredcode:str):$discoverystate{
  let updated:@$companiondevice=@();
  lp(let ii=0;ii<state.devices.len;ii=ii+1){ let d=state.devices.get(ii);
    if(d.id = id){
      if(d.confirmationcode = enteredcode){
        updated.push($companiondevice{
          id:d.id;
          name:d.name;
          host:d.host;
          port:d.port;
          platform:d.platform;
          ramgb:d.ramgb;
          gpuname:d.gpuname;
          status:"paired";
          confirmationcode:d.confirmationcode;
          paired:true;
          pairedat:0
        });
        log.info(str.concat("companion: paired ";id))
      }el{
        updated.push(d)
      }
    }el{
      updated.push(d)
    }
  };
  <$discoverystate{
    devices:updated;
    browsing:state.browsing
  }
};


f=reject(state:$discoverystate;id:str):$discoverystate{
  let kept:@$companiondevice=@();
  lp(let ii=0;ii<state.devices.len;ii=ii+1){ let d=state.devices.get(ii);
    if(d.id = id){
    }el{
      kept.push(d)
    }
  };
  log.info(str.concat("companion: rejected ";id));
  <$discoverystate{
    devices:kept;
    browsing:state.browsing
  }
};


f=listpaired(state:$discoverystate):@$companiondevice{
  let result:@$companiondevice=@();
  lp(let ii=0;ii<state.devices.len;ii=ii+1){ let d=state.devices.get(ii);
    if(d.paired){
      result.push(d)
    }el{}
  };
  <result
};


f=find(state:$discoverystate;id:str):i64{
  let result=mut.0;
  lp(let ii=0;ii<state.devices.len;ii=ii+1){
    let d=state.devices.get(ii);
    if(d.id = id){
      result=d
    }el{}
  };
  <result
};


f=tojson(d:$companiondevice):str{
  let pairedstr=mut."false";
  if(d.paired){ pairedstr="true" }el{};
  let j=mut.str.concat("{\"id\":";json.encstr(d.id));
  j=str.concat(j;str.concat(",\"name\":";json.encstr(d.name)));
  j=str.concat(j;str.concat(",\"host\":";json.encstr(d.host)));
  j=str.concat(j;str.concat(",\"port\":";str.fromi32(d.port)));
  j=str.concat(j;str.concat(",\"platform\":";json.encstr(d.platform)));
  j=str.concat(j;str.concat(",\"ram_gb\":";str.fromi32(d.ramgb)));
  j=str.concat(j;str.concat(",\"gpu_name\":";json.encstr(d.gpuname)));
  j=str.concat(j;str.concat(",\"status\":";json.encstr(d.status)));
  j=str.concat(j;str.concat(",\"paired\":";pairedstr));
  j=str.concat(j;str.concat(",\"paired_at\":";str.fromi64(d.pairedat)));
  <str.concat(j;"}")
};




f=securitychecks(d:$companiondevice):bool{
  if(d.host = ""){
    log.warn(str.concat("companion: security check failed — empty host for ";d.name));
    <false
  }el{
    if(!(d.port>(0 as i32))){
      log.warn(str.concat("companion: security check failed — invalid port for ";d.name));
      <false
    }el{
      log.info(str.concat("companion: security checks passed for ";d.name));
      <true
    }
  }
};

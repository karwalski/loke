{
  "schema_version": "1.0",
  "module": "loke.companion.discovery",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "companiondevice", "fields": [{"name": "id", "type": "str"}, {"name": "name", "type": "str"}, {"name": "host", "type": "str"}, {"name": "port", "type": "i32"}, {"name": "platform", "type": "str"}, {"name": "ramgb", "type": "i32"}, {"name": "gpuname", "type": "str"}, {"name": "status", "type": "str"}, {"name": "confirmationcode", "type": "str"}, {"name": "paired", "type": "bool"}, {"name": "pairedat", "type": "i64"}]},
    {"kind": "type", "name": "discoverystate", "fields": [{"name": "devices", "type": "@"}, {"name": "browsing", "type": "bool"}]},
    {"kind": "func", "name": "newstate", "params": [], "return": "discoverystate"},
    {"kind": "func", "name": "startbrowse", "params": ["discoverystate"], "return": "discoverystate"},
    {"kind": "func", "name": "stopbrowse", "params": ["discoverystate"], "return": "discoverystate"},
    {"kind": "func", "name": "onfound", "params": ["discoverystate", "str", "str", "str", "i32", "str"], "return": "discoverystate"},
    {"kind": "func", "name": "getconfirmationcode", "params": ["discoverystate", "str"], "return": "str"},
    {"kind": "func", "name": "confirmpairing", "params": ["discoverystate", "str", "str"], "return": "discoverystate"},
    {"kind": "func", "name": "reject", "params": ["discoverystate", "str"], "return": "discoverystate"},
    {"kind": "func", "name": "listpaired", "params": ["discoverystate"], "return": "@"},
    {"kind": "func", "name": "find", "params": ["discoverystate", "str"], "return": "i64"},
    {"kind": "func", "name": "tojson", "params": ["companiondevice"], "return": "str"},
    {"kind": "func", "name": "securitychecks", "params": ["companiondevice"], "return": "bool"}
  ]
}

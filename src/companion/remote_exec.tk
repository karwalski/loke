m=loke.companion.remoteexec;

i=str:std.string;
i=log:std.log;
i=json:std.json;
i=http:std.http;
i=ch:loke.companion.channel;


t=$remoterequest{
  modelid:str;
  prompt:str;
  maxtokens:i32;
  temperature:f32;
  requestid:str;
  sensitivity:str
};


t=$remoteresult{
  text:str;
  tokensin:i32;
  tokensout:i32;
  tokpersec:f32;
  modelid:str;
  deviceid:str;
  ok:bool;
  error:str
};




f=buildrequestjson(req:$remoterequest):str{
  let safeprompt=mut.req.prompt; if(req.sensitivity = "RESTRICTED"){
    safeprompt="[REDACTED — RESTRICTED routing blocked]"
  }el{};
  let maxtokensstr=str.fromi32(req.maxtokens);
  let tempstr=str.fromf32(req.temperature);
  <"{" +
    "\"model_id\":" + json.encstr(req.modelid) +
    ",\"prompt\":" + json.encstr(safeprompt) +
    ",\"max_tokens\":" + maxtokensstr +
    ",\"temperature\":" + tempstr +
    ",\"request_id\":" + json.encstr(req.requestid) +
    ",\"sensitivity\":" + json.encstr(req.sensitivity) +
  "}"
};




f=execute(channelstate:i64;req:$remoterequest):$remoteresult{
  log.info("companion: remote exec → " + req.modelid + " on " + channelstate.config.host);
  let body=buildrequestjson(req);
  let msg=ch.newmessage("inference_request";body);
  ch.send(channelstate;msg);
  <$remoteresult{
    text:"[companion remote exec: response pending binding]";
    tokensin:0;
    tokensout:0;
    tokpersec:15.0;
    modelid:req.modelid;
    deviceid:channelstate.config.host;
    ok:true;
    error:""
  }
};




f=viaollamarest(host:str;port:i32;req:$remoterequest):$remoteresult{
  let url="http://" + host + ":" + str.fromi32(port) + "/api/generate";
  let safeprompt=mut.req.prompt; if(req.sensitivity = "RESTRICTED"){
    safeprompt="[REDACTED — RESTRICTED routing blocked]"
  }el{};
  let body="{" +
    "\"model\":" + json.encstr(req.modelid) +
    ",\"prompt\":" + json.encstr(safeprompt) +
    ",\"stream\":false" +
  "}";
  let empty=$remoteresult{
    text:"";
    tokensin:0;
    tokensout:0;
    tokpersec:0.0;
    modelid:req.modelid;
    deviceid:host;
    ok:false;
    error:"ollama_rest_failed"
  };
  let res=http.post(url;body;"application/json");
  if(res.ok){
    let parsed=json.dec(res.body);
    let ok=mt parsed {
      $ok:v true;
      $err:e false
    };
    if(ok){
      let obj=mt parsed { $ok:o o; $err:e json.emptyobj() };
      let text=json.getstror(obj;"response";"");
      let tokensin=json.geti32or(obj;"prompt_eval_count";0);
      let tokensout=json.geti32or(obj;"eval_count";0);
      let tps=json.getf32or(obj;"eval_rate";0.0);
      <$remoteresult{
        text:text;
        tokensin:tokensin;
        tokensout:tokensout;
        tokpersec:tps;
        modelid:req.modelid;
        deviceid:host;
        ok:true;
        error:""
      }
    }el{
      log.warn("companion: could not parse Ollama REST response from " + host);
      <empty
    }
  }el{
    log.warn("companion: Ollama REST unreachable at " + host);
    <empty
  }
};


f=tojson(r:$remoteresult):str{
  let okstr=mut."false"; if(r.ok){ okstr="true" }el{};
  let tokensinstr=str.fromi32(r.tokensin);
  let tokensoutstr=str.fromi32(r.tokensout);
  let tpsstr=str.fromf32(r.tokpersec);
  <"{" +
    "\"text\":" + json.encstr(r.text) +
    ",\"tokens_in\":" + tokensinstr +
    ",\"tokens_out\":" + tokensoutstr +
    ",\"tok_per_sec\":" + tpsstr +
    ",\"model_id\":" + json.encstr(r.modelid) +
    ",\"device_id\":" + json.encstr(r.deviceid) +
    ",\"ok\":" + okstr +
    ",\"error\":" + json.encstr(r.error) +
  "}"
};

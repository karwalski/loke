



m=loke.companion.channel;

i=str:std.str;
i=log:std.log;
i=json:std.json;


t=$channelconfig{
  host:str;
  port:i32;
  certpin:str;
  heartbeatintervals:i32
};


t=$channelstate{
  config:$channelconfig;
  connected:bool;
  lastheartbeat:i64;
  bytessent:i64;
  bytesrecv:i64
};


t=$message{
  kind:str;
  payload:str;
  ts:i64
};



f=newconfig(host:str;port:i32):$channelconfig{
  <$channelconfig{
    host:host;
    port:port;
    certpin:"";
    heartbeatintervals:30
  }
};


f=newstate(cfg:$channelconfig):$channelstate{
  <$channelstate{
    config:cfg;
    connected:false;
    lastheartbeat:0;
    bytessent:0;
    bytesrecv:0
  }
};




f=connect(state:$channelstate):$channelstate{
  log.info("companion: opening TLS 1.3 channel to " + state.config.host + ":" + str.fromi32(state.config.port) + " (ooke.tls binding)");
  <$channelstate{
    config:state.config;
    connected:true;
    lastheartbeat:state.lastheartbeat;
    bytessent:state.bytessent;
    bytesrecv:state.bytesrecv
  }
};


f=disconnect(state:$channelstate):$channelstate{
  log.info("companion: channel closed");
  <$channelstate{
    config:state.config;
    connected:false;
    lastheartbeat:state.lastheartbeat;
    bytessent:state.bytessent;
    bytesrecv:state.bytesrecv
  }
};




f=send(state:$channelstate;msg:$message):$channelstate{
  if(!$state.connected){
    log.error("companion: send called on disconnected channel (kind=" + msg.kind + ")");
    <state
  }{
    let payloadlen=str.len(msg.payload);
    log.info("companion: send " + msg.kind + " (" + str.fromi32(payloadlen) + " bytes)");
    
    <$channelstate{
      config:state.config;
      connected:state.connected;
      lastheartbeat:state.lastheartbeat;
      bytessent:state.bytessent + payloadlen;
      bytesrecv:state.bytesrecv
    }
  }
};



f=recv(state:$channelstate):($message){
  log.info("companion: recv poll (stub)");
  <none
};


f=heartbeat(state:$channelstate):$channelstate{
  let msg=newmessage("ping";"");
  let aftersend=send(state;msg);
  <$channelstate{
    config:aftersend.config;
    connected:aftersend.connected;
    lastheartbeat:0;
    bytessent:aftersend.bytessent;
    bytesrecv:aftersend.bytesrecv
  }
};



f=pincert(state:$channelstate;certfingerprint:str):$channelstate{
  let newcfg=$channelconfig{
    host:state.config.host;
    port:state.config.port;
    certpin:certfingerprint;
    heartbeatintervals:state.config.heartbeatintervals
  };
  log.info("companion: certificate pinned");
  <$channelstate{
    config:newcfg;
    connected:state.connected;
    lastheartbeat:state.lastheartbeat;
    bytessent:state.bytessent;
    bytesrecv:state.bytesrecv
  }
};



f=newmessage(kind:str;payload:str):$message{
  <$message{
    kind:kind;
    payload:payload;
    ts:0
  }
};

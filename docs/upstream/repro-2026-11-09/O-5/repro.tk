(* O-5: ooke 3.0.0-rc.2's CHANGELOG says raw interpolation is `{{raw ...}}`; the engine has no such syntax.
   Template tpl/raw.tkt is  A{{raw x}}B|{= x | raw =}|{= x =}  rendered with x = "<b>".
   EXPECTED (per the changelog): the first segment renders A<b>B.
   OBSERVED if the changelog is wrong: A{{raw x}}B, literal braces; the raw FILTER renders <b>,
   and the default renders escaped. Exits 1 when the literal {{raw x}} is in the output. *)
m=o5;
i=io:std.io;
i=str:std.str;
i=tpl:ooke.template;
f=main():i64{
  let ctx=@("x":"<b>");
  let r=mt tpl.tplrenderfile("tpl/raw.tkt";ctx;"tpl") { $ok:s s; $err:e "err" };
  io.println("rendered: \(r)");
  if(str.contains(r;"{{raw x}}")){ <1 }el{ <0 }
};

(* O-4: ooke's template engine renders an unknown directive, and a block never closed, as nothing.
   Templates in ./tpl; the runner copies ooke's src/template.tk beside this file.
   EXPECTED: unknown.tkt, endblock.tkt and unclosed.tkt each answer $tplerr (a template error).
   DEFECT: each answers $ok; unknown.tkt renders "AB", and endblock.tkt / unclosed.tkt render the
   layout with an empty <main>. control.tkt (closed with end) renders BODY, to show the layout works.
   Prints one line per template; exits with the number of templates that answered $ok when they
   should have failed (0..3). *)
m=o4;
i=io:std.io;
i=tpl:ooke.template;
f=one(name:str):i64{
  let p="tpl/\(name).tkt";
  let ctx=@("k":"v");
  let r=mt tpl.tplrenderfile(p;ctx;"tpl") { $ok:s "ok [\(s)]"; $err:e "err" };
  io.println("\(name): \(r)");
  if(r=="err"){ <0 }el{ <1 }
};
f=main():i64{
  let c=one("control");
  let n=one("unknown")+one("endblock")+one("unclosed");
  <n
};

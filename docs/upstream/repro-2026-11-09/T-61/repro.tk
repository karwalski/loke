(* T-61: a u32 struct field plus an untyped integer local, in a struct literal and elsewhere.
   Filed 2026-10-01 from core.privacy.systemprompt, where unplaced:r.unplaced+stray failed at the
   LLVM step with '%t212' defined with type 'i64' but expected 'i32'.
   EXPECTED (no defect): compiles; prints x=5 y=5 out.u=5 z=6 w=7 and exits 5.
   DEFECT as filed: E9003 from clang, a value defined i64 used where i32 is expected. *)
m=t61;
i=io:std.io;
i=lib:t61lib;
t=$r{a:u32;u:u32;s:str};
f=count(n:i64):i64{
  let c=mut.0;
  lp(let i=0;i<n;i=i+1){ c=c+1 };
  <c
};
f=wrap(n:i64):$run{
  let q=lib.mk(n);
  let stray=count(4);
  <$run{a:q.a;u:q.u+stray;s:q.s}
};
f=main():i64{
  let r=$r{a:1 as u32;u:3 as u32;s:"x"};
  let stray=mut.0;
  lp(let i=0;i<3;i=i+1){ if(i>0){ stray=stray+1 }el{} };
  let x=r.u+stray;
  let y:u32=r.u+(stray as u32);
  let out=$r{a:r.a+1;u:r.u+stray;s:r.s};
  let z=out.u+r.a;
  let w=wrap(3).u;
  io.println("x=\(x) y=\(y as i64) out.u=\(out.u as i64) z=\(z as i64) w=\(w as i64)");
  <out.u as i64
};

(* F10.42 variant: the same subscript as the argument of a USER function, not a std one.
   EXPECTED: exit 7. DEFECT: invalid IR at clang, as repro.tk. *)
m=f1042u;
f=eq3(a:str):bool{ <a=="abc" };
f=main():i64{
  let rows:@@str=@(@("abc";"b");@("x";"y"));
  if(eq3(rows.get(0).get(0))){ <7 }el{ <1 }
};

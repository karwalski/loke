(* F10.42 control: the same program with the row bound to a typed let first. EXPECTED: n=1, exit 1. *)
m=f1042b;
i=io:std.io;
i=str:std.str;
f=main():i64{
  let rows:@@str=@(@("a";"b");@("x";"y"));
  let n=mut.0;
  lp(let i=0;i<rows.len;i=i+1){
    let row:@str=rows.get(i);
    if(str.eq(row.get(0);"x")){ n=n+1 }el{}
  };
  io.println("n=\(n)");
  <n
};

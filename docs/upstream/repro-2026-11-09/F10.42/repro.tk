(* F10.42: an @@str row subscripted inline, rows.get(i).get(j), as a call argument emits invalid IR.
   EXPECTED: compiles; prints n=1 and exits 1.
   DEFECT: --check passes, then clang rejects the IR: '%tN' defined with type 'ptr' but expected
   'i64' (E9003). bound.tk binds the row first and is the control. *)
m=f1042;
i=io:std.io;
i=str:std.str;
f=main():i64{
  let rows:@@str=@(@("a";"b");@("x";"y"));
  let n=mut.0;
  lp(let i=0;i<rows.len;i=i+1){
    if(str.eq(rows.get(i).get(0);"x")){ n=n+1 }el{}
  };
  io.println("n=\(n)");
  <n
};

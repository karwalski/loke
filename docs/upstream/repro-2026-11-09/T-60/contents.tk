(* T-60 (2), measured 2026-11-09: == between two named typed arrays calls tk_str_cmp on the array
   blocks, so it compares element BYTES as a C string and stops at the first zero byte.
   EXPECTED: @(1;2)==@(1;2;3) false, @(256)==@(512) false, @(1;2)==@(7;8) false; exit 0.
   DEFECT: the first two are true (1 is the byte 01 then zeros; 256 and 512 both start with a zero
   byte); exit = 1*first + 2*second + 4*third, DEFECT 3. *)
m=t60c;
i=io:std.io;
f=main():i64{
  let p:@i64=@(1;2);
  let q:@i64=@(1;2;3);
  let u:@i64=@(256);
  let v:@i64=@(512);
  let w:@i64=@(7;8);
  let pq=p==q;
  let uv=u==v;
  let pw=p==w;
  io.println("@(1;2)==@(1;2;3)=\(pq) @(256)==@(512)=\(uv) @(1;2)==@(7;8)=\(pw)");
  let r=mut.0;
  if(pq){ r=r+1 }el{};
  if(uv){ r=r+2 }el{};
  if(pw){ r=r+4 }el{};
  <r
};

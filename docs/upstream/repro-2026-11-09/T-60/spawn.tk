(* T-60 (3): the spawn-failure idiom h==@() never sees a failed spawn. No process is waited on.
   EXPECTED: after a spawn of a missing program takes the $err arm, h==@() is true; exit 0.
   DEFECT: failed=true and h==@()=false, so a caller goes on to read and wait on the empty
   array's address as a process handle; exit 1. *)
m=t60s;
i=io:std.io;
i=process:std.process;
f=main():i64{
  let failed=mt process.spawn(@("/nonexistent/t60-no-such-tool")) { $ok:h false; $err:e true };
  let h=mt process.spawn(@("/nonexistent/t60-no-such-tool")) { $ok:h h; $err:e @() };
  let seen=h==@();
  io.println("spawn failed=\(failed) h==@()=\(seen)");
  if(failed && !seen){ <1 }el{ <0 }
};

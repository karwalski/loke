(* T-60 (1): == between an array and the literal @() is an address compare.
   EXPECTED: a typed empty array equals @() (or == on arrays is refused at compile time).
   DEFECT: typed==@() is false although a.len is 0 (icmp eq i8* against a fresh malloc block);
   two untyped empties compare equal (tk_str_cmp); an untyped empty against @() is false again.
   Exit code = 1*typed==@() + 2*untyped==untyped + 4*untyped==@(); EXPECTED 7, DEFECT 2. *)
m=t60;
i=io:std.io;
f=main():i64{
  let a:@str=@();
  let x=@();
  let y=@();
  let typedlit=a==@();
  let untyped=x==y;
  let untypedlit=x==@();
  io.println("typed==@()=\(typedlit) untyped==untyped=\(untyped) untyped==@()=\(untypedlit) a.len=\(a.len)");
  let r=mut.0;
  if(typedlit){ r=r+1 }el{};
  if(untyped){ r=r+2 }el{};
  if(untypedlit){ r=r+4 }el{};
  <r
};

(* MK19.11: toke 3.1.0's http client has a per-read timer but no whole-request deadline and no body cap.
   Needs server.py on 127.0.0.1:47971-47973 (run.sh starts it). One http.geturl per server; prints
   the outcome, the body length and the elapsed milliseconds.
   drip  (8 bytes, one every 5 s, 40 s in all)  EXPECTED of a client with a request deadline: $err
                                                 at the deadline. OBSERVED if there is none: $ok, len 8,
                                                 about 40000 ms, past the 30 s per-read timer.
   stall (Content-Length 8, 3 bytes, then 45 s of nothing)
                                                 EXPECTED: $err when the per-read timer fires (about
                                                 30000 ms), since the body is short. OBSERVED if a
                                                 timeout is read as end of body: $ok, len 3.
   big   (a 64 MiB body)                        EXPECTED of a client with a cap: refusal.
                                                 OBSERVED if there is none: $ok, len 67108864. *)
m=mk1911;
i=io:std.io;
i=str:std.str;
i=http:std.http;
i=time:std.time;
f=one(name:str;url:str):i64{
  let t0=time.now();
  let r=mt http.geturl(url) { $ok:b "ok len=\(str.len(b) as i64)"; $err:e "err" };
  let ms=(time.now()-t0) as i64;
  io.println("\(name): \(r) ms=\(ms)");
  <ms
};
f=main():i64{
  let a=one("drip";"http://127.0.0.1:47971/");
  let b=one("stall";"http://127.0.0.1:47972/");
  let c=one("big";"http://127.0.0.1:47973/");
  <0
};

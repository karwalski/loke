(* T-21: interpolating the string std.homedir() returns.
   EXPECTED: every length equals len(HOME)+2 (run.sh prints HOME's length for comparison).
   DEFECT (as filed): the interpolated form is truncated (loke measured 12 vs 21).
   std.process is imported because tk_std_homedir_w lives in process_glue.c; without it
   neither compiler links std.homedir (see nolink.tk). process.homedir is the same value. *)
m=s21;
i=io:std.io;
i=std:std;
i=process:std.process;
i=str:std.str;
f=main():i64{
  let a=str.len("\(std.homedir())/x");
  let b=str.len(str.concat(std.homedir();"/x"));
  let c=str.len("\(process.homedir())/x");
  let h:str=std.homedir();
  let d=str.len("\(h)/x");
  io.println("interp text=[\(std.homedir())/x]");
  io.println("interp=\(a) concat=\(b) process-interp=\(c) bound-then-interp=\(d)");
  <0
};

(* T-1: $ok(<bool>) in a bool!$err function.
   EXPECTED: compiles and links; exits 10 (outer(1) is $ok(true)).
   DEFECT (as filed): codegen boxes the i1 with inttoptr, clang rejects the IR:
   "'%tN' defined with type 'i1' but expected 'i64'". *)
m=b1;
t=$e1{ $bad:str };
f=inner(x:i64):bool{
  <x>0
};
f=outer(x:i64):bool!$e1{
  <$ok(inner(x))
};
f=b2i(b:bool):i64{
  if(b){ <10 };
  <20
};
f=main():i64{
  <mt outer(1) { $ok:v b2i(v); $err:e 1 }
};

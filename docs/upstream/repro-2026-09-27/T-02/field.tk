(* T-2 variant: 3-arm mt on an untyped local bound from a sum-typed struct field, and directly on the field.
   EXPECTED: exit 33 (tier is $c, so g=3 and h=3), or a clear diagnostic. *)
m=bj;
t=$s{ $a:i64; $b:i64; $c:i64 };
t=$w{ tier:$s };
f=g(w:$w):i64{
  let t=w.tier;
  <mt t { $a:v 1; $b:v 2; $c:v 3 }
};
f=h(w:$w):i64{
  <mt w.tier { $a:v 1; $b:v 2; $c:v 3 }
};
f=main():i64{ let w=$w{tier:$s{$c:0}}; <g(w)*10+h(w) };

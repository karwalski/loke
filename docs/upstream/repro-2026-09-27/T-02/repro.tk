(* T-2: a 3+-arm mt whose subject is an i64 carrying a sum.
   EXPECTED: either a type diagnostic (subject is not a sum) or valid code.
   DEFECT (as filed): duplicate rm_err labels, clang "Terminator found in the middle of a basic block!". *)
m=bi;
t=$r{ ok:bool; msg:str };
f=h(e:i64):$r{
  <mt e {
    $notfound:v $r{ok:false;msg:"nf"};
    $permission:v $r{ok:false;msg:"pd"};
    $io:v $r{ok:false;msg:"io"}
  }
};
f=main():i64{ <0 };

(* T-11: std.infer / std.mlx are stubs and say so only through plausible values.
   EXPECTED: loading a model file that does not exist takes the $err arm, and generate on
   no model is an error; or the module reports itself unavailable at compile time.
   DEFECT (as filed): load returns 0 (untagged), generate returns the literal text
   "[infer: not available]" / "[mlx: not available]" as a success value.
   Calls use the IMPLEMENTATION arity; the .tki arity is refused (see tki_arity.tk). *)
m=s11;
i=io:std.io;
i=infer:std.infer;
i=mlx:std.mlx;
f=main():i64{
  io.println("mlx.isavailable=\(mlx.isavailable())");
  let lm=mt mlx.load("/nonexistent/model") { $ok:m "ok"; $err:e "err" };
  io.println("mlx.load(/nonexistent) arm=\(lm)");
  let lm2=mt mlx.load("/nonexistent/model") { $err:e "err"; $ok:m "ok" };
  io.println("mlx.load(/nonexistent) arm, err arm written first=\(lm2)");
  let gm=mt mlx.load("/nonexistent/model") {
    $ok:m mt mlx.generate(m;"hi") { $ok:s "ok:\(s)"; $err:e "err" };
    $err:e "load-err"
  };
  io.println("mlx.generate arm=\(gm)");
  let gi=mt infer.load("/nonexistent/model.gguf") {
    $ok:h mt infer.generate(h;"hi") { $ok:s "ok:\(s)"; $err:e "err" };
    $err:e "load-err"
  };
  io.println("infer.generate arm=\(gi)");
  <0
};

(* T-11 / T-12 variant: std.infer and std.mlx called with the arity their .tki declares.
   EXPECTED: compiles (the .tki is the published interface).
   Observed: E4026, the implementation takes fewer arguments than the .tki declares. *)
m=s11;
i=io:std.io;
i=infer:std.infer;
i=mlx:std.mlx;
f=main():i64{
  io.println("mlx.isavailable=\(mlx.isavailable())");
  let lm=mt mlx.load("/nonexistent/model") { $ok:m "ok"; $err:e "err" };
  io.println("mlx.load(/nonexistent) arm=\(lm)");
  let gm=mt mlx.load("/nonexistent/model") {
    $ok:m mt mlx.generate(m;"hi";8 as i32) { $ok:s "ok:\(s)"; $err:e "err" };
    $err:e "load-err"
  };
  io.println("mlx.generate arm=\(gm)");
  let o=$inferopts{ngpulayers:0 as i32;nthreads:1 as i32;seed:0 as i32};
  let gi=mt infer.load("/nonexistent/model.gguf";o) {
    $ok:h mt infer.generate(h;"hi";8 as i32) { $ok:s "ok:\(s)"; $err:e "err" };
    $err:e "load-err"
  };
  io.println("infer.generate arm=\(gi)");
  <0
};

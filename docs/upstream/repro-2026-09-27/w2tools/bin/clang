#!/bin/bash
# Fake clang placed first on PATH by tkbuild.sh. toke builds its stdlib source list in a
# fixed 8192-byte buffer; with a long checkout path the list is cut mid-path. For the link
# call only, drop toke's stdlib .c arguments (and any truncated fragment) and substitute the
# list recomputed by deps.py. Everything else is passed through to the real clang unchanged.
REAL=/usr/bin/clang
TD="$W2_TOKE_DIR"
islink=0
for a in "$@"; do case "$a" in "$TD"/src/stdlib/*.c) islink=1;; esac; done
[ -z "$TD" -o $islink = 0 ] && exec $REAL "$@"
args=(); prev=""
for a in "$@"; do
  if [ "$prev" != "-o" ]; then
    case "$a" in
      "$TD"/src/stdlib/*.c|"$TD"/src/stdlib/../../stdlib/vendor/*.c|"$TD"/stdlib/vendor/*.c) prev="$a"; continue;;
    esac
    case "$a" in /*) if [ ! -e "$a" ] && case "$TD/src/stdlib/" in "$a"*) true;; *) false;; esac; then prev="$a"; continue; fi;; esac
    case "$a" in /*) if [ ! -e "$a" ] || [ -d "$a" ]; then prev="$a"; continue; fi;; esac
  fi
  args+=("$a"); prev="$a"
done
for x in $W2_EXTRA_LL; do args+=("$x"); done
while IFS= read -r s; do args+=("$s"); done < <(python3 "$(dirname "$0")/../deps.py" "$TD" $W2_IMPORTS)
G=/tmp/tk_glue_auto_$PPID.c
have=0; for a in "${args[@]}"; do [ "$a" = "$G" ] && have=1; done
[ -f "$G" -a $have = 0 ] && args+=("$G")
echo "$REAL ${args[*]}" > "${W2_CLANG_LOG:-/dev/null}"
exec $REAL "${args[@]}"

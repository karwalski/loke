(* T-42: a struct literal naming an UNDECLARED type is accepted and read positionally.
   EXPECTED: a compile error, the type ghost is declared nowhere.
   DEFECT: compiles, runs, and r.label prints a, the ghost literal's first field. *)
m=t42;
i=io:std.io;
t=$real{label:str;value:str};
t=$box{items:@$real};
f=main():i64{
  let xs=@($ghost{name:"a";value:"b";extra:"c"});
  let b=$box{items:xs};
  let r=b.items.get(0);
  io.println(r.label);
  <0
};

(* T-38: a name's type is resolved function-wide, so a later let retypes an earlier binder.
   EXPECTED: compiles (the two s bindings are in disjoint scopes) and exits 7,
   or a diagnostic naming both bindings.
   DEFECT: E4031 expected a got b, attributed to the mt line, with a fix hint to cast. *)
m=t38;
i=str:std.str;
t=$a{p:i64};
t=$b{q:i64};
t=$e{ $bad:str };
f=mk():$a!$e{ <$ok($a{p:7}) };
f=main():i64{
  let v:$a=mt mk() { $ok:s s; $err:e $a{p:0} };
  let xs=@($b{q:1});
  lp(let i=0;i<xs.len;i=i+1){
    let s:$b=xs.get(i);
    str.fromint(s.q)
  };
  <v.p
};

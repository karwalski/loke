(* T-43: no toke API chooses the bind address; a server listens on all interfaces.
   EXPECTED: some http.serve form can listen on 127.0.0.1 only.
   DEFECT: http.serveworkers(11441;1) listens on the wildcard address (lsof shows *:11441). *)
m=t43;
i=http:std.http;
f=hello(req:i64):i64{ <http.resjson(200;"{}") };
f=main():i64{
  http.get("/";&hello);
  http.serveworkers(11441;1);
  <0
};

(* T-43 variant: http.listen with a host:port string.
   EXPECTED: listens on 127.0.0.1:11442 only. DEFECT: host discarded, wildcard bind (or no listener). *)
m=t43l;
i=http:std.http;
f=hello(req:i64):i64{ <http.resjson(200;"{}") };
f=main():i64{
  http.get("/";&hello);
  http.listen("127.0.0.1:11442";&hello);
  <0
};

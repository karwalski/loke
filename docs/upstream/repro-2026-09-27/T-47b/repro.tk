(* T-47b: str.nowunix returns the time as a STRING handle but is declared i64.
   EXPECTED: a number near time.now()/1000 (about 1.79e9), or a compile error for arithmetic on a str.
   DEFECT: compiles; a and b are heap addresses a few bytes apart, and a/86400 is meaningless. *)
m=t47b;
i=io:std.io;
i=str:std.str;
i=time:std.time;
f=main():i64{
  let a=str.nowunix();
  let b=str.nowunix();
  let day=a/86400;
  io.println("nowunix a=\(a) b=\(b) b-a=\(b-a) day=\(day) time.now/1000=\(time.now()/1000)");
  <0
};

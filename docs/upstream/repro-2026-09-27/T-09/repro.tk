(* T-9: unsupported regex syntax is silently a non-match.
   EXPECTED: each line shows the replacement applied, or the call reports an error:
     s: a_b   S: _ _   lazy: [x]y[x] (any change)   ci: Z
   DEFECT (as filed): \s, \S, lazy *? and inline (?i) match nothing, so the input comes back unchanged
   and nothing reports it. Control lines (ctl, ctl2) use supported syntax. *)
m=r9;
i=io:std.io;
i=str:std.str;
f=main():i64{
  let a:str=str.replacere("a b";"\\s";"_");
  let b:str=str.replacere("a b";"\\S";"_");
  let c:str=str.replacere("<x>y<z>";"<.*?>";"[x]");
  let d:str=str.replacere("ABC";"(?i)abc";"Z");
  let e:str=str.replacere("a b";"[ ]";"_");
  let g:str=str.replacere("<x>y<z>";"<[^>]*>";"[x]");
  io.println("pattern text: \\s");
  io.println("s: \(a)");
  io.println("S: \(b)");
  io.println("lazy: \(c)");
  io.println("ci: \(d)");
  io.println("ctl: \(e)");
  io.println("ctl2: \(g)");
  <0
};

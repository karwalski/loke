(* T-18: mt on an i64!$userErr that returned $err.
   EXPECTED: exit 77 (a=7: ok-first match takes the $err arm; b=7: err-first match takes the $err arm).
   DEFECT (as filed): the first arm runs whatever the tag, so a=5 and/or b=5 (exit 55 = fully first-arm;
   exit 75 = T-31 positional binding: arm index taken from the tag, not the label). *)
m=g;
t=$e{ $bad:str };
f=check():i64!$e{ <$err($bad("no")) };
f=main():i64{
  let a=mt check() { $ok:v 5; $err:e 7 };
  let b=mt check() { $err:e 7; $ok:v 5 };
  <a*10+b
};

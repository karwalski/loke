(* T-15 variant: the one-argument http.get(url) form loke uses today (returns str).
   EXPECTED: some distinguishable failure for a closed port.
   Prints the returned string's length and text. *)
m=s15b;
i=io:std.io;
i=http:std.http;
i=str:std.str;
f=main():i64{
  let r:str=http.get("http://127.0.0.1:1/health");
  io.println("len=\(str.len(r)) text=[\(r)]");
  <0
};

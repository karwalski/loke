(* T-15: an HTTP GET against a closed port (127.0.0.1:1).
   EXPECTED: the $err arm runs (nothing is listening), exit 2.
   DEFECT (as filed): $ok arm runs with a nil response (exit 1 here, or a crash reading .status).
   This is the shape loke used: http.get(http.client(url);path) matched as a result. *)
m=s15;
i=http:std.http;
f=main():i64{
  <mt http.get(http.client("http://127.0.0.1:1");"/health") {
    $ok:r 1;
    $err:e 2
  }
};

(* T-16: no source-level way to build an http request or read a response body back.
   EXPECTED (the ask): something like http.mockreq(method;path;body) and http.resbody(res)
   exist, so a handler get(req:i64):i64 can be unit-tested; exit 0.
   DEFECT: neither exists; the compile is refused naming the missing members. *)
m=s16;
i=http:std.http;
i=str:std.str;
f=handler(req:i64):i64{ <http.resnew(200;"hello") };
f=main():i64{
  let req=http.mockreq("GET";"/";"");
  let body:str=http.resbody(handler(req));
  if(str.len(body)==5){ <0 };
  <1
};

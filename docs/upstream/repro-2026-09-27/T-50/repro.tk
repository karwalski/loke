(* T-50: process.wait is a plain i32; a mt on it sends exit 0 to the ERROR arm.
   EXPECTED: /usr/bin/true exits 0 -> ok:0; /usr/bin/false exits 1 -> ok:1 (or a declared error).
   DEFECT: true (exit 0) takes the err arm; false (exit 1) takes the ok arm. Run with --allow-run. *)
m=t50;
i=io:std.io;
i=process:std.process;
f=main():i64{
  let a=mt process.spawn(@("/usr/bin/true")) { $ok:p mt process.wait(p) { $ok:c "ok:\(c)"; $err:e "err" }; $err:e "spawnerr" };
  let b=mt process.spawn(@("/usr/bin/false")) { $ok:p mt process.wait(p) { $ok:c "ok:\(c)"; $err:e "err" }; $err:e "spawnerr" };
  let c=mt process.spawn(@("/usr/bin/true")) { $ok:p process.wait(p) as i64; $err:e 0-1 };
  io.println("mt: true->\(a) false->\(b) | plain wait(true) as i64=\(c)");
  <0
};

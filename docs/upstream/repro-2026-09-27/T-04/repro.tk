(* T-4: a bare type name used as a call argument.
   EXPECTED: a front-end diagnostic (E4033 type name is not a value, or E3011).
   DEFECT (as filed): no diagnostic; clang "use of undefined value '%thing'". *)
m=bg;
t=$thing{ n:i64 };
f=take(x:$thing):i64{ <x.n };
f=run():i64{
  <take(thing)
};
f=main():i64{ <run() };

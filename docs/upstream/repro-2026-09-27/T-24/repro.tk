(* T-24: @(array; element) where an append was meant, element type declared.
   EXPECTED: a type error (heterogeneous literal: @$entry mixed with $entry), or exit 3.
   DEFECT (as filed): compiles; builds a 2-element array [[...], e] so the length is 2 whatever
   st.items held, and reading element 0 as $entry can crash. *)
m=s24;
t=$entry{ scope:str; target:str };
t=$state{ items:@$entry };
f=add(st:$state;e:$entry):$state{
  <$state{ items:@(st.items;e) }
};
f=main():i64{
  let e=$entry{scope:"s";target:"t"};
  let s0=$state{ items:@(e;e) };
  let s1=add(s0;e);
  <s1.items.len
};

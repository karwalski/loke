(* T-57: http.get(client; path) registers a GET route instead of sending a request; its
   return reads as $err until the 256-entry route table is full, then as $ok.
   Needs a recorder on 127.0.0.1:11445 and --allow-net.
   EXPECTED: 300 GET /health requests arrive at the recorder, each call takes the ok arm.
   DEFECT: nothing arrives from the two-argument form; the first calls take the err arm and
   from about the 257th call on the ok arm. The one-argument control GET /control does arrive. *)
m=t57;
i=io:std.io;
i=http:std.http;
f=main():i64{
  let c=mt http.get("http://127.0.0.1:11445/control") { $ok:r "ok"; $err:e "err" };
  io.eprintln("one-arg control arm=\(c)");
  let hc=http.client("http://127.0.0.1:11445");
  let oks=mut.0;
  let first=mut.0-1;
  lp(let k=1;k<301;k=k+1){
    let up=mt http.get(hc;"/health") { $ok:b true; $err:e false };
    if(up){ oks=oks+1; if(first<0){ first=k }el{} }el{}
  };
  io.eprintln("two-arg calls=300 ok_arm=\(oks) first_ok_call=\(first)");
  <0
};

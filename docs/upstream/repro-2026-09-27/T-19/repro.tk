(* T-19: a function returning a sum whose body ends in a bare mt with no <.
   EXPECTED: E4071 (as it is for an i64 return), or exit 1.
   DEFECT (as filed): compiles; the function returns garbage and the caller's match crashes. *)
m=s19;
t=$s{ $a:i64; $b:i64 };
t=$d{ $yes:str; $no:str };
f=pick(x:$s):$d{
  mt x { $a:v $d{$yes:"y"}; $b:v $d{$no:"n"} }
};
f=main():i64{
  <mt pick($s{$a:0}) { $yes:v 1; $no:v 2 }
};

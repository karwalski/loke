f=main():i64{
  io.eprintln("[{not json]=\(chk("{not json")) [{not]=\(chk("{not")) [{a:1}]=\(chk("{a:1}")) [{\"a\":}]=\(chk("{\"a\":}")) [{\"a\":1]=\(chk("{\"a\":1")) [{\"a\":1}x]=\(chk("{\"a\":1}x")) [garbage]=\(chk("garbage")) [empty]=\(chk(""))");
  <0
};

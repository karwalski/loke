(* T-51: json.dec accepts the text {not json and reading the result crashes.
   EXPECTED: the $jsonerr arm. DEFECT: the $ok arm, and json.str on the value then segfaults. *)
m=t51;
i=io:std.io;
i=json:std.json;
f=main():i64{
  let arm=mt json.dec("{not json") { $ok:o "ok"; $jsonerr:e "jsonerr" };
  io.eprintln("dec arm=\(arm)");
  let v=mt json.dec("{not json") { $ok:o mt json.str(o;"method") { $ok:s "str-ok:\(s)"; $jsonerr:e "str-err" }; $jsonerr:e "dec-err" };
  io.eprintln("read=\(v)");
  <0
};

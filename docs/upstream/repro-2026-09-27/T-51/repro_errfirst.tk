(* T-51 variant: the same input with the $jsonerr arm written first (the T-31 arm order).
   EXPECTED: jsonerr arm. Observed on both compilers: the ok arm, and json.str on the value then crashes. *)
m=t51e;
i=io:std.io;
i=json:std.json;
f=main():i64{
  let arm=mt json.dec("{not json") { $jsonerr:e "jsonerr"; $ok:o "ok" };
  io.eprintln("errfirst dec arm=\(arm)");
  let v=mt json.dec("{not json") { $jsonerr:e "dec-err"; $ok:o mt json.str(o;"method") { $ok:s "str-ok:\(s)"; $jsonerr:e "str-err" } };
  io.eprintln("read=\(v)");
  <0
};

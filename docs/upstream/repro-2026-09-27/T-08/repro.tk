(* T-8: toke --lint --fix on a file whose only use of an import is a type reference.
   EXPECTED: the import i=t:ty is kept (it is used by $lokeerr), the file still compiles.
   DEFECT (as filed): unused-import only counts alias uses (t.foo), so --fix deletes the import,
   reports success, and the file no longer compiles (lokeerr is not declared). *)
m=main;
i=t:ty;
f=check(x:i64):i64!$lokeerr{
  if(x>0){ <$ok(x) };
  <$err($bad("neg"))
};
f=main():i64{ <mt check(3) { $ok:v v; $err:e 9 } };

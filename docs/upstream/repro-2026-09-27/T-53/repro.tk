(* T-53: a struct is capped at sixteen fields; the declaration is accepted and reads past the 16th fail.
   EXPECTED: prints 16 17 20, or the declaration is rejected naming the limit.
   DEFECT: E-code on a field read, e.g. struct has no field f17, and --max-params=24 does not change it. *)
m=t53;
i=io:std.io;
t=$big{f01:i64;f02:i64;f03:i64;f04:i64;f05:i64;f06:i64;f07:i64;f08:i64;f09:i64;f10:i64;f11:i64;f12:i64;f13:i64;f14:i64;f15:i64;f16:i64;f17:i64;f18:i64;f19:i64;f20:i64};
f=main():i64{
  let b=$big{f01:1;f02:2;f03:3;f04:4;f05:5;f06:6;f07:7;f08:8;f09:9;f10:10;f11:11;f12:12;f13:13;f14:14;f15:15;f16:16;f17:17;f18:18;f19:19;f20:20};
  io.println("\(b.f16) \(b.f17) \(b.f20)");
  <0
};

(* T-20: an f64 returned from another toke module.
   EXPECTED: exit 55 (tens: lib.f64abs(-50.0) as i64 = 50 -> 5; ones: same call inside this module = 5).
   DEFECT (as filed): the importer declares the callee "i64" while the callee returns a double, so the
   caller reads the integer register: garbage (observed 1 or 0), so the tens digit is wrong.
   Build: lib.tk first (--emit-interface), then this file with -I; run.sh does it. *)
m=main;
i=lib:lib;
f=localabs(n:f64):f64{ if(n<0.0){ <0.0-n }; <n };
f=main():i64{
  let x=lib.f64abs(0.0-50.0) as i64;
  let y=localabs(0.0-50.0) as i64;
  <(x/10)*10+(y/10)
};

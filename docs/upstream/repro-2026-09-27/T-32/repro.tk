(* T-32: std.json cannot read a nested value.
   EXPECTED: some typed accessor reaches usage.input_tokens (150).
   DEFECT: json.str on the object key errs, a dotted path errs, and there is no json.obj.
   The last line hands the typed Json to the untyped json.getval, which is the tempting workaround. *)
m=t32;
i=io:std.io;
i=json:std.json;
f=main():i64{
  let o=mt json.dec("{\"model\":\"abc\",\"usage\":{\"input_tokens\":150}}") { $ok:v v; $jsonerr:e $json{raw:""} };
  let a=mt json.str(o;"usage") { $ok:s "ok:\(s)"; $jsonerr:e "err" };
  let b=mt json.i64(o;"usage.input_tokens") { $ok:n "ok:\(n)"; $jsonerr:e "err" };
  io.eprintln("str(usage)=\(a) i64(usage.input_tokens)=\(b)");
  let g=json.getval(o;"usage");
  io.eprintln("getval returned");
  let c=mt json.i64(g;"input_tokens") { $ok:n n; $jsonerr:e 0-1 };
  io.eprintln("after \(g) \(c)");
  <0
};

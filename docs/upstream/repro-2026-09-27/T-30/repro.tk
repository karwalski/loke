(* T-30: std.db keeps one global connection.
   Run from a scratch directory (it creates t30a.db and t30b.db there) with --allow-all.
   EXPECTED: the two db.open handles differ, and table ta (created in t30a.db) is still readable
   after t30b.db is opened: "ha!=hb ta-after-b=ok".
   DEFECT (as filed): db.open's handle selects nothing; every query goes to the database opened
   last, so reading ta after opening t30b.db fails. There is no db.one form that takes a handle. *)
m=s30;
i=io:std.io;
i=db:std.db;
f=main():i64{
  let ha=mt db.open("t30a.db") { $ok:h h; $err:e 999 };
  let x1=mt db.exec("CREATE TABLE IF NOT EXISTS ta(v INTEGER)";@()) { $ok:n 0; $err:e 1 };
  let x2=mt db.exec("INSERT INTO ta VALUES (7)";@()) { $ok:n 0; $err:e 1 };
  let r1:str=mt db.one("SELECT v FROM ta";@()) { $ok:row "ok"; $err:e "err" };
  let hb=mt db.open("t30b.db") { $ok:h h; $err:e 999 };
  let r2:str=mt db.one("SELECT v FROM ta";@()) { $ok:row "ok"; $err:e "err" };
  io.println("ha=\(ha) hb=\(hb) ta-before-b=\(r1) ta-after-b=\(r2) setup=\(x1)\(x2)");
  <0
};

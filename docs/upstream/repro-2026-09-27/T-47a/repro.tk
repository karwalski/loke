(* T-47a: json.str unescape drops the backslash; the JSON escapes n t r b f and u0041 come back as letters.
   EXPECTED bytes of the decoded value a,LF,b,TAB,c,CR,d,QUOTE,e,BACKSLASH,f,A: 97 10 98 9 99 13 100 34 101 92 102 65.
   DEFECT: 97 110 98 116 99 114 100 34 101 92 102 117 48 48 52 49 (quote and backslash right by accident). *)
m=t47a;
i=io:std.io;
i=str:std.str;
i=json:std.json;
f=main():i64{
  let o=mt json.dec("{\"c\":\"a\\nb\\tc\\rd\\\"e\\\\f\\u0041\"}") { $ok:v v; $jsonerr:e $json{raw:""} };
  let s=mt json.str(o;"c") { $ok:x x; $jsonerr:e "ERR" };
  let n=str.len(s);
  let out=mut."";
  lp(let k=0;k<n;k=k+1){
    out=str.concat(out;str.concat(str.fromint(str.charat(s;k));" "))
  };
  io.println("bytes=\(out)");
  <0
};

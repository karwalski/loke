(* T-22: row.f64 is declared f64!DbErr but tk_row_f64_w returns a bare i64 bit pattern (0 on error).
   EXPECTED: "x: ok 25 | zero: ok 0 | nosuch: err".
   DEFECT (as filed): the match reads a tag that was never written. With no tag, the only
   signal left is the value itself, so a stored 0.0 is indistinguishable from an error. *)
m=s22;
i=io:std.io;
i=db:std.db;
f=main():i64{
  let o=mt db.open(":memory:") { $ok:h 0; $err:e 1 };
  let r=mt db.one("SELECT 2.5 AS x, 0.0 AS z";@()) { $ok:row row; $err:e 0 };
  let a:str=mt row.f64(r;"x") { $ok:v "ok \((v*10.0) as i64)"; $err:e "err" };
  let b:str=mt row.f64(r;"z") { $ok:v "ok \((v*10.0) as i64)"; $err:e "err" };
  let c:str=mt row.f64(r;"nosuch") { $ok:v "ok \((v*10.0) as i64)"; $err:e "err" };
  io.println("x: \(a) | zero: \(b) | nosuch: \(c)");
  <o
};

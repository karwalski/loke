(* T-27: comments nest. The comment on the line after m=q contains COUNT followed by an
   open-paren-star-close-paren, which opens a nested comment that its own close only half ends.
   EXPECTED: survived and main are compiled, exit 1; or an unclosed-comment error (E2004) at EOF.
   DEFECT (as filed): no diagnostic about the comment; the rest of the file is swallowed, so the
   executable build reports only "no main function" and --emit-llvm succeeds without survived. *)
m=q;
(* reads COUNT(*) from the table *)
f=survived():i64{ <1 };
f=main():i64{ <survived() };

(* T-37 variant: an @f64 struct field.
   EXPECTED: builds and prints 2 then 2.5. DEFECT: the array handle is bitcast as a double, IR invalid. *)
m=t37f;
i=io:std.io;
t=$f64vec{ v:@f64 };
f=wrapped(a:$f64vec;x:f64):$f64vec{ <$f64vec{ v:a.v.push(x) } };
f=main():i64{
  let w=wrapped($f64vec{v:@(1.0)};2.5);
  io.println("\(w.v.len) \(w.v.get(1))");
  <0
};

(* T-37: a declared @f64 gets the scalar f64 conversion applied to its array handle.
   EXPECTED: builds and prints 2 then 1.5, like the @i64 and @str versions.
   DEFECT: IR converts the array handle with fptosi, clang rejects it. *)
m=t37;
i=io:std.io;
f=retf64arr(a:@f64;v:f64):@f64{ <a.push(v) };
f=reti64arr(a:@i64;v:i64):@i64{ <a.push(v) };
f=main():i64{
  let b=reti64arr(@(1);2);
  let a=retf64arr(@(1.0);1.5);
  io.println("\(a.len) \(a.get(1))");
  <0
};

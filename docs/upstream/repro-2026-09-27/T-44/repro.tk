(* T-44: json.str unescapes a backslash-n escape to a bare letter n.
   EXPECTED: content of the reply equals summarisation followed by a newline (len 14, last byte 10).
   DEFECT: reads back as summarisationn (len 14, last byte 110, the letter n). *)
m=t44;
i=io:std.io;
i=str:std.str;
i=json:std.json;
f=main():i64{
  let o=mt json.dec("{\"content\":\"summarisation\\n\"}") { $ok:v v; $jsonerr:e $json{raw:""} };
  let s=mt json.str(o;"content") { $ok:x x; $jsonerr:e "ERR" };
  let n=str.len(s);
  io.println("len=\(n) lastbyte=\(str.charat(s;n-1))");
  <0
};

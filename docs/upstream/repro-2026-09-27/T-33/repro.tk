(* T-33: numeric and boolean std.json accessors report an error for a present falsy value.
   EXPECTED: n=0 -> ok 0, f=0.0 -> ok, b=false -> ok false; missing key -> err.
   DEFECT: 0, 0.0 and false read as $jsonerr, the same answer as a missing key. *)
m=t33;
i=io:std.io;
i=json:std.json;
f=main():i64{
  let o=mt json.dec("{\"n\":0,\"u\":0,\"f\":0.0,\"b\":false,\"s\":\"\",\"n5\":5,\"bt\":true}") { $ok:v v; $jsonerr:e $json{raw:""} };
  let a=mt json.i64(o;"n") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  let b=mt json.u64(o;"u") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  let c=mt json.f64(o;"f") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  let d=mt json.bool(o;"b") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  let e2=mt json.str(o;"s") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  let g=mt json.i64(o;"n5") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  let h=mt json.bool(o;"bt") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  let k=mt json.i64(o;"missing") { $ok:x "ok:\(x)"; $jsonerr:e "err" };
  io.println("i64(0)=\(a) u64(0)=\(b) f64(0.0)=\(c) bool(false)=\(d) str(empty)=\(e2) i64(5)=\(g) bool(true)=\(h) i64(missing)=\(k)");
  <0
};

(* T-36: str.tki declares most members as untyped i64 in a gen abi block, so wrong arguments type-check.
   EXPECTED: compile errors for str.len on an array, str.padleft given a string pad, str.tof32 given an i64;
   str.compare("b";"a") positive and str.compare("a";"b") negative.
   DEFECT: all compile; str.len of a 3-element array is small, str.compare is never negative. *)
m=t36;
i=io:std.io;
i=str:std.str;
f=main():i64{
  let xs=@("aaaa";"bbbb";"cccc");
  let n=str.len(xs);
  let c1=str.compare("a";"b");
  let c2=str.compare("b";"a");
  let c3=str.compare("a";"a");
  let p:str=str.padleft("7";3;"0");
  io.eprintln("strlen(array3)=\(n) compare(a,b)=\(c1) compare(b,a)=\(c2) compare(a,a)=\(c3) padleft(7,3,\"0\")=[\(p)]");
  let t=str.tof32(12345);
  io.eprintln("tof32(i64) returned \(t)");
  <0
};

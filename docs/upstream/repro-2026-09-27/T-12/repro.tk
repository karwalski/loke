(* T-12: stdlib .tki files disagree with the compiler's builtin table.
   run.sh greps the .tki for the four names the entry lists (json.getarr, str.padright,
   process.spawndetached, file.listglob). This program checks the rest:
   EXPECTED: getregulations len=1 (the document holds one regulation);
             padright with a one-char string pads with that char: [ab***].
   DEFECT (as filed): json.getregulations is a loke-named stub returning an empty array.
   Also observed: str.padright's .tki is (i64,i64,i64) gen:abi, so a str pad argument
   compiles and its pointer is truncated to a char; only a char code (42) works. *)
m=s12;
i=io:std.io;
i=str:std.str;
i=json:std.json;
f=main():i64{
  let p:str=str.padright("ab";5;"*");
  let q:str=str.padright("ab";5;42);
  io.println("padright str-arg=[\(p)] code-arg=[\(q)]");
  let doc=json.decode("{\"regulations\":[\"gdpr\"]}");
  let regs=json.getregulations(doc);
  io.println("getregulations len=\(regs.len)");
  let ctl=json.getarr(doc;"regulations");
  io.println("control json.getarr len=\(ctl.len)");
  <0
};

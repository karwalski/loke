(* T-39: unused-import lint counts only alias uses; an import used for its TYPE is reported unused
   and lint fix deletes it, breaking the build.
   EXPECTED: no unused-import diagnostic for i=tl:t39lib (the type thing comes from it).
   DEFECT: reported unused; after lint fix, check fails E3011 on thing. Run from this directory. *)
m=t39;
i=tl:t39lib;
f=getx(t:$thing):i64{ <t.x };
f=main():i64{ <getx($thing{x:3}) };

(* T-45: json.enc escapes only quote and backslash; control characters pass through raw.
   EXPECTED: a newline, tab and CR in the input come out as backslash escapes (no raw byte below 32).
   DEFECT: the output contains raw bytes 10, 9, 13. The program prints the encoded bytes' codes. *)
m=t45;
i=io:std.io;
i=str:std.str;
i=json:std.json;
f=main():i64{
  let s=json.enc("a\nb\tc\rd\"e");
  let n=str.len(s);
  let out=mut."";
  lp(let k=0;k<n;k=k+1){
    out=str.concat(out;str.concat(str.fromint(str.charat(s;k));" "))
  };
  io.println("enc_bytes=\(out)");
  <0
};

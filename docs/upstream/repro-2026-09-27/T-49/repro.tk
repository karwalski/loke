(* T-49: net.listen(port) segfaults.
   EXPECTED: returns a listening fd (lsof shows 11444), prints listen returned, exits 0.
   DEFECT: SIGSEGV. Run with --allow-net. *)
m=t49;
i=io:std.io;
i=net:std.net;
f=main():i64{
  io.eprintln("before listen");
  let fd=net.listen(11444);
  io.eprintln("listen returned \(fd)");
  <0
};

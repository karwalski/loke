(* O-1 minimal shape: a result-returning function whose body ends in an error propagation with no <.
   This is the tail of ooke v3.0.0-rc.1 src/store.tk storeslug (line 174) and storefind (line 183).
   Before toke 060e11b: compiles (and silently returns 0 on the success path).
   From toke 060e11b: E4071. main exits 3 when the $err arm is taken, 5 on the $ok arm. *)
m=o1;
i=file:std.file;
t=$e{msg:str};
f=find(col:@i64):i64!$e{
  lp(let i=0;i<col.len;i=i+1){
    if(col.get(i)==9){<col.get(i)}el{}
  };
  (file.listall("")!$e)
};
f=main():i64{ <mt find(@(1;2)) { $ok:v 5; $err:e 3 } };

(* T-46: an annotated let s:str binding of str.fromi64, used as an array element, is compiled as a spread.
   EXPECTED: @("g";g) has 2 elements and element 1 is 12345; same for @(g;"first").
   DEFECT: the arrays have 1 element; g vanishes. The last case (randhex) may crash. *)
m=t46;
i=io:std.io;
i=str:std.str;
f=main():i64{
  let g:str=str.fromi64(12345);
  let a=@("g";g);
  let b=@(g;"first");
  let h:str=str.fromint(12345);
  let c=@("h";h);
  io.eprintln("fromi64: len(@(\"g\";g))=\(a.len) len(@(g;\"first\"))=\(b.len) | fromint control: len(@(\"h\";h))=\(c.len)");
  let r:str=str.randhex(4);
  let d=@("r";r);
  io.eprintln("randhex: len=\(d.len)");
  io.eprintln("a[0]=\(a.get(0)) a[last]=\(a.get(a.len-1))");
  <0
};

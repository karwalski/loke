(* T-40: db.exec applies only the first statement of a multi-statement string and returns ok.
   EXPECTED: both the table and the index exist afterwards, or exec returns an error.
   DEFECT: exec returns ok, the table exists, the index does not. Arg: path to a fresh sqlite file. *)
m=t40;
i=io:std.io;
i=db:std.db;
i=args:std.args;
f=main():i64{
  let p=args.get(1);
  let o=mt db.open(p) { $ok:c "open-ok"; $err:e "open-err" };
  let r=mt db.exec("CREATE TABLE x (a TEXT); CREATE INDEX ix_x ON x(a);";@()) { $ok:n "exec-ok"; $err:e "exec-err" };
  let t=mt db.one("SELECT count(*) AS n FROM sqlite_master WHERE name='x'";@()) { $ok:w mt row.str(w;"n") { $ok:s s; $err:e "?" }; $err:e "q-err" };
  let k=mt db.one("SELECT count(*) AS n FROM sqlite_master WHERE name='ix_x'";@()) { $ok:w mt row.str(w;"n") { $ok:s s; $err:e "?" }; $err:e "q-err" };
  io.println("\(o) \(r) table_x=\(t) index_ix_x=\(k)");
  <0
};

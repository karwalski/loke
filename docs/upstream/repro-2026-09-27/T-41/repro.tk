(* T-41: interpolating a std.str result prints the string's ADDRESS for functions declared i64 in the gen abi block.
   EXPECTED: each line shows the string value, e.g. fromi64=[5] padleft=[__7] reverse=[cba].
   DEFECT: each shows a large integer, the heap address. *)
m=t41;
i=io:std.io;
i=str:std.str;
f=main():i64{
  io.println("fromi64=[\(str.fromi64(5))]");
  io.println("fromint64=[\(str.fromint64(5))]");
  io.println("fromi32=[\(str.fromi32(5))]");
  io.println("fromu32=[\(str.fromu32(5))]");
  io.println("fromu16=[\(str.fromu16(5))]");
  io.println("frombool=[\(str.frombool(1))]");
  io.println("randhex=[\(str.randhex(4))]");
  io.println("nowiso8601=[\(str.nowiso8601())]");
  io.println("padleft=[\(str.padleft("7";3;95))]");
  io.println("padright=[\(str.padright("7";3;95))]");
  io.println("trimws=[\(str.trimws("  x  "))]");
  io.println("strip=[\(str.strip("  x  "))]");
  io.println("reverse=[\(str.reverse("abc"))]");
  io.println("replaceall=[\(str.replaceall("aXa";"X";"Y"))]");
  io.println("tolower=[\(str.tolower("A"))]");
  <0
};

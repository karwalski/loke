(* T-34: a three-segment stdlib member http.res.err is lowered as a call to a bare global err.
   EXPECTED: builds a 4xx response value, prints built, exits 0 (or a diagnostic at compile time).
   DEFECT: links to libc err(3), which prints to stderr and exits the process with status 144. *)
m=t34;
i=http:std.http;
i=io:std.io;
f=main():i64{
  let b=http.res.err("nope");
  io.eprintln("built");
  <0
};

(* T-31: mt binds a stdlib result's arms by POSITION, not label.
   EXPECTED: arm chosen by label - valid input runs the ok arm (prints ok) whatever the arm order.
   DEFECT: with the error arm written first, valid input runs the error arm, invalid runs ok. *)
m=t31;
i=io:std.io;
i=json:std.json;
f=main():i64{
  let a=mt json.dec("{\"a\":1}") { $ok:o "ok"; $jsonerr:e "err" };
  let b=mt json.dec("{\"a\":1}") { $jsonerr:e "err"; $ok:o "ok" };
  let c=mt json.dec("{{{nope") { $ok:o "ok"; $jsonerr:e "err" };
  let d=mt json.dec("{{{nope") { $jsonerr:e "err"; $ok:o "ok" };
  io.println("valid,okfirst=\(a) valid,errfirst=\(b) invalid,okfirst=\(c) invalid,errfirst=\(d)");
  <0
};

(* T-28: str.isdigit fed the character code that str.charat returns.
   EXPECTED: exit 1 ('5' is a digit), or a type error if isdigit takes a str.
   DEFECT (as filed): compiles (isdigit is gen:abi i64) and segfaults, since it reads 53 as a pointer. *)
m=s28;
i=str:std.str;
f=main():i64{
  let c=str.charat("a5b";1);
  if(str.isdigit(c)){ <1 };
  <0
};

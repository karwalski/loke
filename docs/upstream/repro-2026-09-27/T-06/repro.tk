(* T-6: a let shadowing an enclosing let.
   EXPECTED: exit 57 (pick(0) takes the inner binding 57), or a shadowing diagnostic.
   DEFECT (as filed): clang "Instruction does not dominate all uses!". *)
m=bk;
f=pick(x:i64):i64{
  let p=x;
  if(p==0){
    let p=57;
    <p
  }el{
    <p
  }
};
f=main():i64{ <pick(0) };

(* T-48: http.postheaders, called in loke's cloud-provider shape postheaders(client; path; body; headers), sends nothing.
   Needs a recorder on 127.0.0.1:11443 and --allow-net.
   EXPECTED: the recorder logs POST /v1/messages-loke with body and x-api-key header.
   DEFECT: only the posturl control arrives; the loke-shape call sends nothing and its mt takes the err arm.
   The third call passes a URL string first, matching the C glue's real parameter order (url; body; headers; ignored). *)
m=t48;
i=io:std.io;
i=http:std.http;
f=main():i64{
  let c=http.posturl("http://127.0.0.1:11443/control";"{\"n\":0}");
  io.eprintln("posturl returned");
  let hc=http.client("http://127.0.0.1:11443/v1/messages-loke");
  let r=mt http.postheaders(hc;"";"{\"n\":1}";"{\"x-api-key\":\"k1\",\"content-type\":\"application/json\"}") { $ok:v "ok"; $err:e "err" };
  io.eprintln("loke-shape postheaders arm=\(r)");
  let d=http.postheaders("http://127.0.0.1:11443/v1/messages-direct";"{\"n\":2}";"{\"x-api-key\":\"k2\",\"content-type\":\"application/json\"}";"");
  io.eprintln("url-first postheaders returned nonzero=\(d!=0)");
  <0
};

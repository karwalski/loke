(* T-5 variant: the same void!$err program with the success value spelled $ok(0).
   EXPECTED: compiles; exit 0. Isolates the result lowering from the spelling of a void value.
   DEFECT (as filed): binding a void!$e result emits alloca void. *)
m=bh;
t=$e{ $bad:str };
f=inner(x:i64):void!$e{
  if(x>0){ <$ok(0) }el{ <$err($bad("no")) }
};
f=outer(x:i64):void!$e{
  <mt inner(x) { $ok:v $ok(0); $err:e $err($bad("up")) }
};
f=main():i64{ <mt outer(1) { $ok:v 0; $err:e 1 } };

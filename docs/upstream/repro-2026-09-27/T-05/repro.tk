(* T-5: void!$err success type.
   EXPECTED: compiles; exit 0.
   DEFECT (as filed): lowered to LLVM void, clang "void type only allowed for function results". *)
m=bh;
t=$e{ $bad:str };
f=inner(x:i64):void!$e{
  if(x>0){ <$ok(void) }el{ <$err($bad("no")) }
};
f=outer(x:i64):void!$e{
  <mt inner(x) { $ok:v $ok(void); $err:e $err($bad("up")) }
};
f=main():i64{ <mt outer(1) { $ok:v 0; $err:e 1 } };

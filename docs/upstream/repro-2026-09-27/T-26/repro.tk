(* T-26: assignment to a struct field.
   EXPECTED: a diagnostic saying field assignment does not exist (rebuild the struct), not advice to use ==.
   DEFECT (as filed): E2002 "`=` is assignment; use `==` for equality". See applied_advice.tk for what
   following that advice produces. *)
m=s26;
t=$r{a:i64;b:i64};
f=main():i64{
  let x=mut.$r{a:1;b:2};
  x.a=9;
  <x.a
};

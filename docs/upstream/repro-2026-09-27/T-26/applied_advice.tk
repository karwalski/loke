(* T-26 variant: the E2002 advice applied (x.a==9;).
   EXPECTED: a warning or error for a comparison whose result is discarded; if it compiles, exit 9.
   DEFECT (as filed): compiles clean, the statement does nothing, exit 1. *)
m=s26b;
t=$r{a:i64;b:i64};
f=main():i64{
  let x=mut.$r{a:1;b:2};
  x.a==9;
  <x.a
};

(* T-13: a bare sum variant in a value position.
   EXPECTED: a diagnostic (the value must be written $lvl{$internal:0}), or exit 1.
   DEFECT (as filed): compiles with no diagnostic; the value crashes when matched (SIGTRAP). *)
m=s13;
t=$lvl{ $public:i64; $internal:i64 };
f=name(s:$lvl):i64{ <mt s { $public:v 0; $internal:v 1 } };
f=main():i64{ let l=mut.$internal; <name(l) };

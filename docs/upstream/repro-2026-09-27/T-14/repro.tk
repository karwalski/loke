(* T-14: == on two sums.
   EXPECTED: exit 11 (both comparisons true).
   DEFECT (as filed): a sum returned from a function never equals an identically constructed
   local, so the tens digit is 0 (exit 1 or 0). The ones digit is the local-vs-local control. *)
m=s14;
t=$lvl{ $public:i64; $restricted:i64 };
f=mk():$lvl{ <$lvl{$restricted:0} };
f=main():i64{
  let x=mk();
  let a=$lvl{$restricted:0};
  let b=$lvl{$restricted:0};
  let r=mut.0;
  if(x==$lvl{$restricted:0}){ r=r+10 };
  if(a==b){ r=r+1 };
  <r
};

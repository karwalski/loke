(* T-17: json.parse.
   EXPECTED: json.parse behaves like json.decode: both lines print a=[xyz].
   DEFECT (as filed): json.parse mangles to tk_json_parse_w, which does not exist, and links to
   the runtime's tk_json_parse (an int/bool/number parser), so the "document" is garbage. *)
m=s17;
i=io:std.io;
i=json:std.json;
f=main():i64{
  let d1=json.decode("{\"a\":\"xyz\"}");
  let s1:str=json.getstr(d1;"a");
  io.println("decode a=[\(s1)]");
  let d2=json.parse("{\"a\":\"xyz\"}");
  let s2:str=json.getstr(d2;"a");
  io.println("parse  a=[\(s2)]");
  <0
};

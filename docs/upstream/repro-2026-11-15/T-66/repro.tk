(* T-66: a 3-arm `mt` with variant labels on an i64 passes `toke --check` and fails at build.
   (The program is T-2's, which 3.1.0 turned from invalid IR into this located error.)
   EXPECTED: refused at --check, as 3.2.0 now refuses `mt` with variant arms on a record value
   (E4080, story 127.367), or valid code.
   DEFECT: --check rc 0; the build stops with E9005 "match has 3 arms, but the sum type of the
   matched value is not established" at 7:4. A check-only target never sees it. *)
m=t66;
t=$r{ ok:bool; msg:str };
f=h(e:i64):$r{
  <mt e {
    $notfound:v $r{ok:false;msg:"nf"};
    $permission:v $r{ok:false;msg:"pd"};
    $io:v $r{ok:false;msg:"io"}
  }
};
f=main():i64{ <0 };

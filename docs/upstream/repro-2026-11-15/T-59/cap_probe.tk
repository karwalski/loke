(* F10.9: one gated call per toke capability class, chosen by the first argument.
   scripts/check_capabilities.sh builds this with loke's tkc.toml and asserts which
   classes pass and which abort with CAP001. Each branch prints "<class>-done" only if
   the gated call returned, so a missing line means the broker stopped the program. *)
m=capprobe;
i=io:std.io;
i=args:std.args;
i=file:std.file;
i=net:std.net;
i=process:std.process;
i=env:std.env;

f=main():i64{
  let which=mt args.get(1) {
    $ok:s s;
    $err:e ""
  };
  let scratch=mt args.get(2) {
    $ok:s s;
    $err:e ""
  };
  if(which=="fs_read"){
    let r=mt file.read("/etc/hosts") {
      $ok:s 1;
      $err:e 2
    };
    io.println("fs_read-done \(r)");
  }el{};
  if(which=="fs_write"){
    let w=mt file.write(scratch;"x") {
      $ok:b 1;
      $err:e 2
    };
    io.println("fs_write-done \(w)");
  }el{};
  if(which=="net"){
    io.println("net-done \(net.portavailable(1))");
  }el{};
  if(which=="process_spawn"){
    let p=mt process.spawn(@("true")) {
      $ok:h 1;
      $err:e 2
    };
    io.println("process_spawn-done \(p)");
  }el{};
  if(which=="env_write"){
    let v=env.set("LOKE_CAP_PROBE";"1");
    io.println("env_write-done");
  }el{};
  <0
};

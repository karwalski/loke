(* T-64, re-checked 2026-11-15 at toke v3.2.0: toke 138.23 and 138.31 say ONE reader serves
   http.geturl, http.clientget/clientpost and http.postheaders, and that a response cut short
   (a body short of its Content-Length, a chunked body with no last chunk, a close-delimited body
   ending in a reset) is $err. loke measured only geturl on 2026-11-15 (repro-2026-11-09/MK19.11).
   Needs server.py on 127.0.0.1:47990-47993 (run.sh starts it).
   EXPECTED: every stall, chunkcut and closerst line answers err; every closeok line answers
   ok len=3 (the control: a clean close ends a close-delimited body).
   DEFECT: any cut response answering ok. Exit = the number of lines that differ from EXPECTED. *)
m=t64all;
i=io:std.io;
i=str:std.str;
i=http:std.http;
i=time:std.time;
f=judge(name:str;got:str;want:str;started:u64):i64{
  let ms=(time.now()-started) as i64;
  let bad=if(str.startswith(got;want)){ 0 }el{ 1 };
  io.println("\(name): \(got) ms=\(ms) want=\(want)");
  <bad
};
f=viageturl(name:str;port:i64;want:str):i64{
  let t0=time.now();
  let url="http://127.0.0.1:\(port)/x";
  let r=mt http.geturl(url) { $ok:b "ok len=\(str.len(b) as i64)"; $err:e "err" };
  <judge("geturl \(name)";r;want;t0)
};
f=viaclientget(name:str;port:i64;want:str):i64{
  let t0=time.now();
  let c=http.client("http://127.0.0.1:\(port)");
  let r=mt http.clientget(c;"/x") { $ok:v "ok len=\(v.body.len as i64)"; $err:e "err" };
  <judge("clientget \(name)";r;want;t0)
};
f=viaclientpost(name:str;port:i64;want:str):i64{
  let t0=time.now();
  let c=http.client("http://127.0.0.1:\(port)");
  let r=mt http.clientpost(c;"/x";str.bytes("p");"text/plain") { $ok:v "ok len=\(v.body.len as i64)"; $err:e "err" };
  <judge("clientpost \(name)";r;want;t0)
};
f=viapostheaders(name:str;port:i64;want:str):i64{
  let t0=time.now();
  let url="http://127.0.0.1:\(port)/x";
  let r=mt http.postheaders(url;"p";@(@("x-probe";"1"))) { $ok:v "ok len=\(v.body.len as i64)"; $err:e "err" };
  <judge("postheaders \(name)";r;want;t0)
};
f=main():i64{
  let bad=mut.0;
  bad=bad+viaclientget("chunkcut";47991;"err");
  bad=bad+viaclientget("closerst";47992;"err");
  bad=bad+viaclientget("closeok";47993;"ok len=3");
  bad=bad+viapostheaders("chunkcut";47991;"err");
  bad=bad+viapostheaders("closerst";47992;"err");
  bad=bad+viapostheaders("closeok";47993;"ok len=3");
  bad=bad+viaclientpost("chunkcut";47991;"err");
  bad=bad+viageturl("chunkcut";47991;"err");
  bad=bad+viageturl("closerst";47992;"err");
  bad=bad+viageturl("closeok";47993;"ok len=3");
  bad=bad+viaclientget("stall";47990;"err");
  bad=bad+viapostheaders("stall";47990;"err");
  <bad
};

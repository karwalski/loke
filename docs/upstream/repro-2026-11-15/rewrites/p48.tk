   EXPECTED: ok status=200; the recorder sees x-api-key=k1 and ONE content-type.
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p48;
i=io:std.io;
i=http:std.http;
f=main():i64{
  let r=mt http.postheaders("http://127.0.0.1:47993/v1/messages-loke";"{\"n\":1}";@(@("x-api-key";"k1");@("content-type";"application/json"))) { $ok:v "ok status=\(v.status)"; $err:e "err \(e.code)" };
  io.println("postheaders=\(r)");
  <0
};

(* T-15 rewrite: a client GET to a closed port (127.0.0.1:47999, nothing listens).
   EXPECTED: clientget=err (TCP connect failed) and geturl=err. DEFECT (as filed): $ok with nothing.
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p15;
i=io:std.io;
i=http:std.http;
f=main():i64{
  let c=http.client("http://127.0.0.1:47999");
  io.println(mt http.clientget(c;"/health") { $ok:r "clientget=ok"; $err:e "clientget=err code=\(e.code) msg=\(e.msg)" });
  io.println(mt http.geturl("http://127.0.0.1:47999/health") { $ok:s "geturl=ok"; $err:e "geturl=err code=\(e.code)" });
  <0
};

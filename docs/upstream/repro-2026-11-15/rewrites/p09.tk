(* T-9 without the lazy-quantifier line, which v3.2.0 refuses at --check (E4075, "use a negated
   class"): the supported escapes and inline flag now match.
   EXPECTED: s: a_b   S: _ _   ci: Z   ctl: a_b   ctl2: [x]y[x]
   DEFECT (as filed): \s, \S and (?i) match nothing, so the input comes back unchanged. *)
m=r9;
i=io:std.io;
i=str:std.str;
f=main():i64{
  let a:str=str.replacere("a b";"\\s";"_");
  let b:str=str.replacere("a b";"\\S";"_");
  let d:str=str.replacere("ABC";"(?i)abc";"Z");
  let e:str=str.replacere("a b";"[ ]";"_");
  let g:str=str.replacere("<x>y<z>";"<[^>]*>";"[x]");
  io.println("s: \(a)");
  io.println("S: \(b)");
  io.println("ci: \(d)");
  io.println("ctl: \(e)");
  io.println("ctl2: \(g)");
  <0
};

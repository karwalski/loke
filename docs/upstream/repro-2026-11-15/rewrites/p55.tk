(* T-55 at a larger size (1.6 M and 3.2 M bytes; the filed sizes run in about 1 ms on v3.2.0): str.charat measures the whole string on every call, so a byte loop is quadratic.
   EXPECTED: time for n=200000 about 2x the time for n=100000 (linear).
   DEFECT: about 4x (quadratic); each call runs strlen over the whole string. Prints n, sum, ms. *)
m=t55;
i=io:std.io;
i=str:std.str;
i=time:std.time;
f=scan(n:i64):i64{
  let s=str.repeat("a";n as u64);
  let t0=time.now();
  let sum=mut.0;
  lp(let k=0;k<n;k=k+1){ sum=sum+str.charat(s;k) };
  let ms=(time.now()-t0) as i64;
  io.println("n=\(n) sum=\(sum) ms=\(ms)");
  <ms
};
f=main():i64{
  let a=scan(1600000);
  let b=scan(3200000);
  io.println("ratio_x10=\((b*10)/(a+1))");
  <0
};

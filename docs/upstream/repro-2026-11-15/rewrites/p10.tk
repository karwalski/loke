(* T-10 / N-6 / R7 rewrite: client POST, PUT and DELETE. Needs a recorder on 127.0.0.1:47996.
   EXPECTED: each answers ok status=200 and arrives (POST /post, PUT /put, DELETE /del).
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p10;
i=io:std.io;
i=http:std.http;
i=str:std.str;
f=main():i64{
  let c=http.client("http://127.0.0.1:47996");
  io.println(mt http.clientpost(c;"/post";str.bytes("body-p");"text/plain") { $ok:r "post=ok status=\(r.status)"; $err:e "post=err" });
  io.println(mt http.clientput(c;"/put";str.bytes("body-u");"text/plain") { $ok:r "put=ok status=\(r.status)"; $err:e "put=err" });
  io.println(mt http.clientdelete(c;"/del") { $ok:r "delete=ok status=\(r.status)"; $err:e "delete=err" });
  <0
};

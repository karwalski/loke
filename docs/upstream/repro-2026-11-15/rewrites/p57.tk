(* T-57 (B3) rewrite: 300 client GETs through http.clientget. Needs a recorder on 127.0.0.1:47995.
   EXPECTED: calls=300 ok_arm=300, and 300 GET /health at the recorder. DEFECT (as filed): none arrive.
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p57;
i=io:std.io;
i=http:std.http;
f=main():i64{
  let hc=http.client("http://127.0.0.1:47995");
  let oks=mut.0;
  lp(let k=0;k<300;k=k+1){
    let up=mt http.clientget(hc;"/health") { $ok:r true; $err:e false };
    if(up){ oks=oks+1 }el{}
  };
  io.println("clientget calls=300 ok_arm=\(oks)");
  <0
};

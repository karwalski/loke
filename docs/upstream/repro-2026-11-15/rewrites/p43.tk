(* T-43 / R1 rewrite: http.serveon binds the host it is given. Listens on 127.0.0.1:47997 until killed.
   EXPECTED: lsof shows 127.0.0.1:47997, not *:47997.
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p43;
i=http:std.http;
f=main():i64{
  http.serveon("127.0.0.1";47997);
  <0
};

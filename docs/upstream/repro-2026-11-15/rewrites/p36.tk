f=main():i64{
  let t=mt str.tof32("12345") { $ok:v v; $err:e 0.0 };
  io.println("compare(a,b)=\(str.compare("a";"b")) compare(b,a)=\(str.compare("b";"a")) compare(a,a)=\(str.compare("a";"a")) padleft=[\(str.padleft("7";3;48))] tof32=\(t)");
  <0
};

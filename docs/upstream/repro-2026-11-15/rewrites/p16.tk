(* T-16 rewrite: http.mockreq and the response readers.
   EXPECTED: status=200 body=[got POST /x body=hello].
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p16;
i=io:std.io;
i=http:std.http;
f=h(req:$req):$res{
  <http.res.ok("got \(req.method) \(req.path) body=\(req.body)")
};
f=main():i64{
  let r=h(http.mockreq("POST";"/x";@(@("content-type";"text/plain"));"hello";@()));
  io.println("status=\(http.resstatus(r)) body=[\(http.resbody(r))]");
  <0
};

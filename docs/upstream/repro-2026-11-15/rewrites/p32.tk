(* T-32 rewrite: a nested JSON read through json.at.
   EXPECTED: usage.input_tokens=150. DEFECT (as filed): no nested read; a handle into json.i64 crashed.
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p32;
i=io:std.io;
i=json:std.json;
f=main():i64{
  let body="{\"usage\":{\"input_tokens\":150,\"output_tokens\":7}}";
  let n=mt json.dec(body) {
    $ok:j (mt json.at(j;"usage") { $ok:u (mt json.i64(u;"input_tokens") { $ok:v v; $err:e 0-2 }); $err:e 0-3 });
    $err:e 0-1
  };
  io.println("usage.input_tokens=\(n)");
  <0
};

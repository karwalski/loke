(* T-49 rewrite: net.listen takes an address string.
   EXPECTED: fd>0=true portavailable-after=0. DEFECT (as filed): net.listen(port) segfaulted.
   Rewritten for toke v3.2.0 by loke on 2026-11-15 from toke's 2026-09-30 reply, Appendix A,
   with ports moved into 47990-47999. *)
m=p49;
i=io:std.io;
i=net:std.net;
f=main():i64{
  let fd=net.listen("127.0.0.1:47994");
  io.println("fd>0=\(fd>0) portavailable-after=\(net.portavailable(47994))");
  <0
};

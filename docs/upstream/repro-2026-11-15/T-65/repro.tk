(* T-65: a function parameter named t<digits> collides with toke's own IR temporaries.
   EXPECTED: compiles and runs; exit 5.
   DEFECT: `toke --check` passes, and the build fails at clang with
   "multiple definition of local value named 't0'" (E9003): the parameter's slot is named %t0,
   and so is the first temporary. Measured at toke v3.1.0 and v3.2.0. *)
m=t65;
f=g(t0:i64):i64{
  <t0+1
};
f=main():i64{
  <g(4)
};

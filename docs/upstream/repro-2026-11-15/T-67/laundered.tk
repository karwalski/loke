(* T-67, the shape loke writes. `handle` cannot be named in type position (138.32: E2005, see
   ../138.32/annot.tk), so a helper that takes a process handle declares it `h:i64`
   (loke: packages/core/src/installer/detect.tk, ollamacli.tk, install.tk). The checker then
   accepts any i64 at the helper's call sites.
   EXPECTED: waitfor(5) refused at --check (if the parameter could be typed `handle`), or -1.
   DEFECT: checks clean; real=0 is printed for a real child, then SIGSEGV (exit 139) for the
   forged one. *)
m=t67l;
i=io:std.io;
i=process:std.process;
f=waitfor(h:i64):i64{
  <process.wait(h) as i64
};
f=main():i64{
  let real=mt process.spawn(@("/usr/bin/true")) { $ok:h waitfor(h); $err:e 0-9 };
  io.println("real=\(real)");
  let forged=waitfor(5);
  io.println("forged=\(forged)");
  <0
};

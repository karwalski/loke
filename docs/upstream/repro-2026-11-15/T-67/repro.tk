(* T-67: an integer is accepted where std.process declares a `handle`, and the runtime
   dereferences it. 138.21 (toke v3.2.0) refuses a str, array, map or record in that slot
   (process.wait("abc") is E4031), but not an i64.
   EXPECTED: process.wait(5) refused at --check, or answered -1 at run time as for the NULL
   handle (zero.tk).
   DEFECT: checks clean, builds, and the program dies with SIGSEGV (exit 139) in process.wait.
   Measured at v3.1.0 and v3.2.0; process.stdout(7) does the same. *)
m=t67;
i=io:std.io;
i=process:std.process;
f=main():i64{
  let x=process.wait(5) as i64;
  io.println("wait(5)=\(x)");
  <0
};

(* T-67, the same class through std.str: 56 of str.tki's 105 members are still `gen:"abi"`
   with every parameter declared i64 (T-36's residue). 3.2.0 refuses an array or a record in such
   a slot when the runtime reads a C string (E4031, "read by the runtime as a C string"), but
   not an integer.
   EXPECTED: str.toupper(42) refused at --check, as str.toupper(@("x")) is.
   DEFECT: checks clean, builds, and dies with SIGSEGV (exit 139). str.reverse(12345) does the
   same. *)
m=t67s;
i=io:std.io;
i=str:std.str;
f=main():i64{
  let a=str.toupper(42);
  io.println("toupper(42)=[\(a)]");
  <0
};

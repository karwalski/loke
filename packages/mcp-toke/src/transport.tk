m=mcptoke.transport;

i=srv:mcptoke.server;
i=str:std.str;
i=log:shared.log;
i=io:std.io;

(* stdio transport for the toke MCP server (F10.23e/F10.23f).

   What was here before could not be built with this toolchain. It called
   io.readline, io.readexact, io.bufferedreader, io.stdin, io.stdout, io.write,
   io.flush, str.bytelen, str.startswithci, net.httpresponse, net.parsehttprequest,
   srv.newstate and srv.healthresponse, and passed srv.handlerequest three arguments
   where it takes two. std.io declares six members in total — eof, print, println,
   printf, eprintln and readln — and none of the rest exists anywhere.

   So the framing changed to match both the toolchain and the MCP specification:
   MCP's stdio transport is newline-delimited JSON, one message per line. The
   Content-Length framing the legacy code was reaching for is LSP's, not MCP's, and it
   needs a read-exact primitive that std.io does not have.

   The SSE half is gone rather than left broken. It depended entirely on
   net.httpresponse and net.parsehttprequest — an HTTP server hiding inside std.net
   that does not exist — and mcptoke.server already accepts connections over a socket.
   $sseevent and formatsseevent stay because they are pure string formatting with no
   dependencies, and are the part worth keeping for whoever wires an SSE endpoint up. *)

t=$sseevent{
  event:str;
  data:str;
  id:str
};

f=framemessage(body:str):str{
  <str.replace(body;"\n";" ")
};

f=stdiodispatch(raw:str;config:$serverconfig):bool{
  let response=srv.handlerequest(raw;config);
  if(str.len(response)>0){
    io.println(framemessage(response))
  }el{};
  <true
};

(* Reads newline-delimited JSON from stdin until io reports EOF. A blank line is
   skipped rather than treated as end of input: a client that writes an extra newline
   should not shut the server down. *)
f=startstdio(config:$serverconfig):void{
  let cid=log.newcorrelationid();
  log.info("loke MCP server starting on stdio";"mcp-stdio";cid);
  let running=mut.true;
  lp(let lv=0;running;lv=lv){
    let line=io.readln();
    if(io.eof()>0){
      running=false
    }el{
      let trimmed=str.trim(line);
      if(str.len(trimmed)>0){
        stdiodispatch(trimmed;config)
      }el{}
    }
  };
  log.info("loke MCP stdio server stopped";"mcp-stdio";cid);
  <void
};

f=formatsseevent(evt:$sseevent):str{
  let parts=mut."";
  if(str.len(evt.event) > 0){
    parts=str.concat(parts;str.concat("event: ";str.concat(evt.event;"\n")))
  }el{};
  if(str.len(evt.id) > 0){
    parts=str.concat(parts;str.concat("id: ";str.concat(evt.id;"\n")))
  }el{};
  parts=str.concat(parts;str.concat("data: ";str.concat(evt.data;"\n")));
  <str.concat(parts;"\n")
};

m=mcptoke.tools;




i=t:shared.types;
i=proto:core.mcp.protocol;
i=privacy:core.privacy.pipeline;
i=toon:core.optimiser.toon;
i=jx:shared.jsonobj;
i=profiler:core.optimiser.profiler;
i=json:std.json;
i=str:std.str;
i=log:shared.log;



(* Every function here declared `-> i64` and returned a $mcptool or a $toolresult,
   which is the LS1.1e/LS1.1f class: declare the real return type rather than letting
   the struct be carried as an opaque handle. alltools()'s "expected array, got array"
   was the same defect one level up — an @$mcptool built out of five i64-returning
   calls. *)
f=toolanonymise():$mcptool{
  <$mcptool{
    name:"anonymise";
    description:"Detect and anonymise PII in text. Returns the anonymised text and how many entities were detected, never the original.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"presidio_url\":{\"type\":\"string\"},\"ollama_url\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
  }
};

f=toolcompress():$mcptool{
  <$mcptool{
    name:"compress";
    description:"Convert JSON data to TOON format for token-efficient LLM context.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"json\":{\"type\":\"string\"}},\"required\":[\"json\"]}"
  }
};

f=toolprofile():$mcptool{
  <$mcptool{
    name:"profile";
    description:"Profile a JSON dataset and return a compact schema for LLM context.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"json\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"json\"]}"
  }
};

f=tooldecompress():$mcptool{
  <$mcptool{
    name:"decompress";
    description:"Convert TOON format back to JSON.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"toon\":{\"type\":\"string\"}},\"required\":[\"toon\"]}"
  }
};

f=toolanalyse():$mcptool{
  <$mcptool{
    name:"analyse";
    description:"Analyse text sensitivity and return privacy risk assessment.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
  }
};


f=alltools():@$mcptool{
  <@(
    toolanonymise();
    toolcompress();
    toolprofile();
    tooldecompress();
    toolanalyse()
  )
};



f=sensitivitylabel(level:$sensitivitylevel):str{
  <mt level {
    $public:v "PUBLIC";
    $internal:v "INTERNAL";
    $confidential:v "CONFIDENTIAL";
    $restricted:v "RESTRICTED"
  }
};

f=safetosend(level:$sensitivitylevel):bool{
  <mt level {
    $public:v true;
    $internal:v true;
    $confidential:v false;
    $restricted:v false
  }
};

f=toolerr(msg:str):$toolresult{
  <$toolresult{contenttype:"text";text:proto.toolresulterr(msg);iserror:true}
};


(* MK6.10. anonymise is handed exactly the text a user wants kept private, so its answer carries
   none of it. It used to answer with an `original` field holding the input as sent beside the
   anonymised text: every personal value the pipeline had just replaced went straight back out
   in the same reply. The answer is now the anonymised text, the count, the sensitivity and how
   many detection layers scanned it; the log line carries only the count.

   A run in which no layer completed a scan is refused (core.privacy.pipeline.issafetoforward):
   its "anonymised" text would be the input, unscanned. The regex layer always completes today,
   so that arm guards a future change, not a present one.

   The arguments are read with jx.strvalue, as compress's are: `json.getstr` is an untyped ABI
   name, and `json.str` turns an escaped newline into the letter n (T-47), which altered the
   text before anything scanned it. The anonymised text is quoted with jx.escape: the old
   quoting replaced double quotes only, so a backslash, a newline or a tab in the input made the
   answer invalid JSON. *)
f=anonymiseobj(obj:$json;presidiourl:str;ollamaurl:str):$toolresult{
  let cid=log.newcorrelationid();
  let text=jx.strvalue(obj;"text";"");
  if(str.len(text)==0){ <toolerr("anonymise: text is required") }el{};
  let purl=jx.strvalue(obj;"presidio_url";presidiourl);
  let ourl=jx.strvalue(obj;"ollama_url";ollamaurl);
  let run=privacy.run(text;"";privacy.newconfig(purl;ourl));
  if(!privacy.issafetoforward(run)){
    log.warn("anonymise: no detection layer completed a scan";"mcp-tools";cid);
    <toolerr("anonymise: no detection layer completed a scan, so the text was not anonymised")
  }el{};
  let entitycount=run.totalentities as i64;
  let completed=run.layerscompleted as i64;
  let degraded=run.layersdegraded as i64;
  let senslabel=sensitivitylabel(run.result.sensitivity);
  let anonjson=jx.escape(run.result.anonymised);
  let requestid=run.requestid;
  log.info("anonymise: \(entitycount) entities found";"mcp-tools";cid);
  <$toolresult{
    contenttype:"text";
    text:proto.toolresultok("{\"anonymised\":\(anonjson),\"entities_found\":\(entitycount),\"sensitivity\":\"\(senslabel)\",\"layers_completed\":\(completed),\"layers_degraded\":\(degraded),\"request_id\":\"\(requestid)\"}");
    iserror:false
  }
};

f=handleanonymise(argsjson:str;presidiourl:str;ollamaurl:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj anonymiseobj(obj;presidiourl;ollamaurl);
    $jsonerr:e toolerr("anonymise: invalid args JSON")
  }
};


(* MK6.7. compress answered `{"toon":"~","savings_pct":94}` for `[{"a":1},{"a":2}]`: the
   encoder kept only the kind of each value (see core.optimiser.toon's MK6.7 note), and the
   saving was measured against the tilde. It now writes real TOON or refuses with the reason,
   and every figure it reports is a length it measured: the input as sent, the same JSON
   without its insignificant whitespace, and the TOON. The savings are CHARACTER savings, which
   are not token savings (docs/claims.md C1), and the one over minified JSON is the one worth
   reading (docs/metrics-baseline.md: minifying alone already saves). Both are integer percent,
   truncated, from integer basis points computed where the lengths were (T-20).

   The arguments are read with jx.strvalue: `json.str` drops a backslash and keeps the next
   character (T-47), so a TOON's `\n` arrived as the letter n and no multi-line TOON could have
   been decompressed; `json.getstr` is an untyped ABI name. The unused `format` argument is
   gone from the schema: the encoder picks the form the data has. The TOON is quoted with
   jx.escape, not json.enc: measured, json.enc leaves a newline raw, and every multi-line TOON
   made the answer invalid JSON. *)
f=compressobj(obj:$json):$toolresult{
  let cid=log.newcorrelationid();
  let rawjson=jx.strvalue(obj;"json";"");
  let enc=toon.encodejson(rawjson);
  if(!toon.isencoded(enc)){
    let why=enc.failure;
    <toolerr("compress: cannot encode \(why)")
  }el{};
  let minified=toon.jsonminified(rawjson);
  let jsonchars=str.len(rawjson) as i64;
  let minchars=str.len(minified) as i64;
  let toonchars=str.len(enc.text) as i64;
  let savingspct=toon.measuresavingsbp(rawjson;enc.text)/100;
  let minpct=toon.measuresavingsbp(minified;enc.text)/100;
  let toonjson=jx.escape(enc.text);
  log.info("compress: \(savingspct)% fewer characters, \(minpct)% against minified JSON";"mcp-tools";cid);
  <$toolresult{
    contenttype:"text";
    text:proto.toolresultok("{\"toon\":\(toonjson),\"json_chars\":\(jsonchars),\"minified_json_chars\":\(minchars),\"toon_chars\":\(toonchars),\"savings_pct\":\(savingspct),\"savings_vs_minified_pct\":\(minpct)}");
    iserror:false
  }
};

f=handlecompress(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj compressobj(obj);
    $jsonerr:e toolerr("invalid args JSON")
  }
};


(* MK6.10. profile matched profiler.profilejsonarray's `$datasetprofile!$lokeerr`, whose arms
   cannot be told apart from another module (T-18): input that was not a JSON array went on
   with the error payload bound as the profile. It reads profiler.profilejson, a plain struct,
   through isprofiled. The schema used to be sent with its double quotes pre-escaped and then
   escaped again by the envelope, so a quote in a dataset name arrived as backslash-quote; it is
   now a JSON answer like compress's, the schema quoted once with jx.escape, beside the counts.
   The schema carries names, types and rates, never a value (NC1.2). *)
f=profileobj(obj:$json):$toolresult{
  let cid=log.newcorrelationid();
  let name=jx.strvalue(obj;"name";"dataset");
  let p=profiler.profilejson(jx.strvalue(obj;"json";"");name);
  if(!profiler.isprofiled(p)){
    let why=p.failure;
    <toolerr("profile: cannot profile: \(why)")
  }el{};
  let dp=p.profile;
  let schema=jx.escape(profiler.totoonschema(dp));
  let rows=dp.rowcount as i64;
  let cols=dp.colcount as i64;
  let hint=jx.escape(dp.sensitivityhint);
  log.info("profile: \(rows) rows, \(cols) columns";"mcp-tools";cid);
  <$toolresult{
    contenttype:"text";
    text:proto.toolresultok("{\"schema\":\(schema),\"rows\":\(rows),\"cols\":\(cols),\"sensitivity_hint\":\(hint)}");
    iserror:false
  }
};

f=handleprofile(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj profileobj(obj);
    $jsonerr:e toolerr("invalid args JSON")
  }
};


(* MK6.7: decodes the TOON compress writes, or refuses with the reason. *)
f=decompressobj(obj:$json):$toolresult{
  let cid=log.newcorrelationid();
  let dec=toon.decodetoon(jx.strvalue(obj;"toon";""));
  if(!toon.isencoded(dec)){
    let why=dec.failure;
    <toolerr("decompress: cannot decode \(why)")
  }el{};
  let jsontext=jx.escape(dec.text);
  log.debug("decompress: TOON decoded";"mcp-tools";cid);
  <$toolresult{
    contenttype:"text";
    text:proto.toolresultok("{\"json\":\(jsontext)}");
    iserror:false
  }
};

f=handledecompress(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj decompressobj(obj);
    $jsonerr:e toolerr("invalid args JSON")
  }
};


(* MK6.10. analyse is a dry run of the regex layer. Its answer used to list each entity with its
   `value`, the personal datum itself, so asking whether a text was safe to send put its
   personal data into the answer; each entity is now its type and where it lies in the text.
   Quoted with jx.escape rather than a replace of double quotes, and its argument read with
   jx.strvalue (T-47), as anonymise's is. *)
f=entityjson(entity:$piientity):str{
  let kind=jx.escape(entity.entitytype);
  let from=entity.start as i64;
  let upto=entity.end as i64;
  <"{\"type\":\(kind),\"start\":\(from),\"end\":\(upto)}"
};

f=analyseobj(obj:$json):$toolresult{
  let cid=log.newcorrelationid();
  let text=jx.strvalue(obj;"text";"");
  if(str.len(text)==0){ <toolerr("analyse: text is required") }el{};
  let dryrunconfig=$pipelineconfig{
    presidiourl:"";
    ollamaurl:"";
    nermodelid:"";
    usepresidio:false;
    usener:false;
    dryrun:true;
    usepf:false;
    pfurl:"";
    pfthreshold:""
  };
  let run=privacy.run(text;"";dryrunconfig);
  let entitycount=run.totalentities as i64;
  let senslabel=sensitivitylabel(run.result.sensitivity);
  let safestr=mut."false";
  if(safetosend(run.result.sensitivity)){safestr="true"}el{};
  let entities=mut.@();
  lp(let ei=0;ei<run.result.entities.len;ei=ei+1){
    entities=entities.push(entityjson(run.result.entities.get(ei)))
  };
  let entitiesjson=str.join(",";entities);
  log.info("analyse: \(entitycount) entities, sensitivity=\(senslabel)";"mcp-tools";cid);
  <$toolresult{
    contenttype:"text";
    text:proto.toolresultok("{\"sensitivity\":\"\(senslabel)\",\"entity_count\":\(entitycount),\"entities\":[\(entitiesjson)],\"safe_to_send\":\(safestr)}");
    iserror:false
  }
};

f=handleanalyse(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj analyseobj(obj);
    $jsonerr:e toolerr("invalid args JSON")
  }
};





f=handletool(name:str;argsjson:str;presidiourl:str;ollamaurl:str):$toolresult{
  if(str.eq(name;"anonymise")){
    <handleanonymise(argsjson;presidiourl;ollamaurl)
  }el{
    if(str.eq(name;"compress")){
      <handlecompress(argsjson)
    }el{
      if(str.eq(name;"profile")){
        <handleprofile(argsjson)
      }el{
        if(str.eq(name;"decompress")){
          <handledecompress(argsjson)
        }el{
          if(str.eq(name;"analyse")){
            <handleanalyse(argsjson)
          }el{
            <$toolresult{
              contenttype:"text";
              text:proto.toolresulterr(str.concat("unknown tool: ";name));
              iserror:true
            }
          }
        }
      }
    }
  }
};

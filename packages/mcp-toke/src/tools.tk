m=mcptoke.tools;




i=t:shared.types;
i=proto:core.mcp.protocol;
i=privacy:core.privacy.pipeline;
i=toon:core.optimiser.toon;
i=profiler:core.optimiser.profiler;
i=json:std.json;
i=str:std.str;
i=log:shared.log;



f=toolanonymise():$proto.mcptool{
  <$proto.mcptool{
    name:"anonymise";
    description:"Detect and anonymise PII in text. Returns anonymised text and detected entities.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"presidio_url\":{\"type\":\"string\"},\"ollama_url\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
  };
};

f=toolcompress():$proto.mcptool{
  <$proto.mcptool{
    name:"compress";
    description:"Convert JSON data to TOON format for token-efficient LLM context.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"json\":{\"type\":\"string\"},\"format\":{\"type\":\"string\",\"enum\":[\"auto\",\"table\",\"object\"]}},\"required\":[\"json\"]}"
  };
};

f=toolprofile():$proto.mcptool{
  <$proto.mcptool{
    name:"profile";
    description:"Profile a JSON dataset and return a compact schema for LLM context.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"json\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"json\"]}"
  };
};

f=tooldecompress():$proto.mcptool{
  <$proto.mcptool{
    name:"decompress";
    description:"Convert TOON format back to JSON.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"toon\":{\"type\":\"string\"}},\"required\":[\"toon\"]}"
  };
};

f=toolanalyse():$proto.mcptool{
  <$proto.mcptool{
    name:"analyse";
    description:"Analyse text sensitivity and return privacy risk assessment.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
  };
};


f=alltools():@($proto.mcptool){
  <@(
    toolanonymise();
    toolcompress();
    toolprofile();
    tooldecompress();
    toolanalyse()
  )
};



f=sensitivitylabel(level:$sensitivitylevel):str{
  mt level {
    $public    "PUBLIC";
    $internal  "INTERNAL";
    $confidential "CONFIDENTIAL";
    $restricted "RESTRICTED"
  };
};

f=safetosend(level:$sensitivitylevel):bool{
  mt level {
    $public    true;
    $internal  true;
    $confidential false;
    $restricted false
  };
};




f=handleanonymise(argsjson:str;presidiourl:str;ollamaurl:str):$proto.toolresult{
  let cid=log.newcorrelationid();
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr e;
      <$proto.toolresult{
        contenttype:"text";
        text:proto.toolresulterr("anonymise: invalid args JSON");
        iserror:true
      };
    obj;
      let text=json.getstr(obj;"text");
      
      let purl=json.getstror(obj;"presidio_url";presidiourl);
      let ourl=json.getstror(obj;"ollama_url";ollamaurl);
      let config=privacy.newconfig(purl;ourl);
      let run=privacy.run(text;"";config);
      let entitycount=str.fromint(run.totalentities);
      let senslabel=sensitivitylabel(run.result.sensitivity);
      let safestr=if safetosend(run.result.sensitivity){"true"}else{"false"};
      let anonescaped=str.replace(run.result.anonymised;"\"";"\\"");
      let origescaped=str.replace(run.result.original;"\"";"\\"");
      let p1=str.concat("{\"anonymised\":\"";anonescaped);
      let p2=str.concat(p1;"\",\"original\":\"");
      let p3=str.concat(p2;origescaped);
      let p4=str.concat(p3;"\",\"entities_found\":");
      let p5=str.concat(p4;entitycount);
      let p6=str.concat(p5;",\"sensitivity\":\"");
      let p7=str.concat(p6;senslabel);
      let p8=str.concat(p7;"\",\"request_id\":\"");
      let p9=str.concat(p8;run.requestid);
      let resultjson=str.concat(p9;"\"}");
      log.info(str.concat("anonymise: ";entitycount;" entities found");"mcp-tools";cid);
      <$proto.toolresult{
        contenttype:"text";
        text:proto.toolresultok(resultjson);
        iserror:false
      };
  };
};


f=handlecompress(argsjson:str):$proto.toolresult{
  let cid=log.newcorrelationid();
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr e;
      <$proto.toolresult{
        contenttype:"text";
        text:proto.toolresulterr("compress: invalid args JSON");
        iserror:true
      };
    obj;
      let rawjson=json.getstr(obj;"json");
      let format=json.getstror(obj;"format";"auto");
      let opts=toon.defaultopts();
      let toonresult=toon.jsontotoon(rawjson;opts);
      mt toonresult {
        $lokeerr e;
          <$proto.toolresult{
            contenttype:"text";
            text:proto.toolresulterr("compress: failed to convert JSON to TOON");
            iserror:true
          };
        toonstr;
          let savings=toon.measuresavings(rawjson;toonstr);
          let savingsint=savings as i64;
          let savingsstr=str.fromint(savingsint);
          let toonescaped=str.replace(toonstr;"\"";"\\"");
          let resultp1=str.concat("{\"toon\":\"";toonescaped);
          let resultp2=str.concat(resultp1;"\",\"savings_pct\":");
          let resultjson=str.concat(resultp2;str.concat(savingsstr;"}"));
          log.info(str.concat("compress: ";savingsstr;"% savings");"mcp-tools";cid);
          <$proto.toolresult{
            contenttype:"text";
            text:proto.toolresultok(resultjson);
            iserror:false
          };
      };
  };
};


f=handleprofile(argsjson:str):$proto.toolresult{
  let cid=log.newcorrelationid();
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr e;
      <$proto.toolresult{
        contenttype:"text";
        text:proto.toolresulterr("profile: invalid args JSON");
        iserror:true
      };
    obj;
      let rawjson=json.getstr(obj;"json");
      let name=json.getstror(obj;"name";"dataset");
      let profileresult=profiler.profilejsonarray(rawjson;name);
      mt profileresult {
        $lokeerr e;
          <$proto.toolresult{
            contenttype:"text";
            text:proto.toolresulterr("profile: failed to profile JSON array");
            iserror:true
          };
        datasetprofile;
          let schema=profiler.totoonschema(datasetprofile);
          let schemaescaped=str.replace(schema;"\"";"\\"");
          log.info(str.concat("profile: schema for ";name);"mcp-tools";cid);
          <$proto.toolresult{
            contenttype:"text";
            text:proto.toolresultok(schemaescaped);
            iserror:false
          };
      };
  };
};


f=handledecompress(argsjson:str):$proto.toolresult{
  let cid=log.newcorrelationid();
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr e;
      <$proto.toolresult{
        contenttype:"text";
        text:proto.toolresulterr("decompress: invalid args JSON");
        iserror:true
      };
    obj;
      let toonstr=json.getstr(obj;"toon");
      let jsonresult=toon.toontojson(toonstr);
      mt jsonresult {
        $lokeerr e;
          <$proto.toolresult{
            contenttype:"text";
            text:proto.toolresulterr("decompress: failed to decode TOON");
            iserror:true
          };
        recoveredjson;
          let jsonescaped=str.replace(recoveredjson;"\"";"\\"");
          let resultp1=str.concat("{\"json\":\"";jsonescaped);
          let resultjson=str.concat(resultp1;"\"}");
          log.debug("decompress: TOON decoded";"mcp-tools";cid);
          <$proto.toolresult{
            contenttype:"text";
            text:proto.toolresultok(resultjson);
            iserror:false
          };
      };
  };
};


f=handleanalyse(argsjson:str):$proto.toolresult{
  let cid=log.newcorrelationid();
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr e;
      <$proto.toolresult{
        contenttype:"text";
        text:proto.toolresulterr("analyse: invalid args JSON");
        iserror:true
      };
    obj;
      let text=json.getstr(obj;"text");
      
      let config=privacy.newconfig("";"");
      let dryrunconfig=$privacy.pipelineconfig{
        presidiourl:"";
        ollamaurl:"";
        nermodelid:"";
        usepresidio:false;
        usener:false;
        dryrun:true
      };
      let run=privacy.run(text;"";dryrunconfig);
      let entitycount=run.totalentities;
      let entitycountstr=str.fromint(entitycount);
      let senslabel=sensitivitylabel(run.result.sensitivity);
      let safe=safetosend(run.result.sensitivity);
      let safestr=if safe{"true"}else{"false"};
      
      let entitiesjson="[";
      let ei=0;
      let entcount=str.arraylen(run.result.entities);
      loop{
        if(ei>=entcount){
          break
        }else{
          let entity=str.arrayget(run.result.entities;ei);
          let typeesc=str.replace(entity.entitytype;"\"";"\\"");
          let valesc=str.replace(entity.value;"\"";"\\"");
          let entry=str.concat("{\"type\":\"";str.concat(typeesc;str.concat("\",\"value\":\"";str.concat(valesc;"\"}")))));
          if(ei=0){
            entitiesjson=str.concat(entitiesjson;entry)
          }else{
            entitiesjson=str.concat(entitiesjson;str.concat(",";entry))
          };
          ei=ei+1
        };
      };
      entitiesjson=str.concat(entitiesjson;"]");
      let p1=str.concat("{\"sensitivity\":\"";senslabel);
      let p2=str.concat(p1;"\",\"entity_count\":");
      let p3=str.concat(p2;entitycountstr);
      let p4=str.concat(p3;",\"entities\":");
      let p5=str.concat(p4;entitiesjson);
      let p6=str.concat(p5;",\"safe_to_send\":");
      let resultjson=str.concat(p6;str.concat(safestr;"}"));
      log.info(str.concat("analyse: ";entitycountstr;" entities, sensitivity=";senslabel);"mcp-tools";cid);
      <$proto.toolresult{
        contenttype:"text";
        text:proto.toolresultok(resultjson);
        iserror:false
      };
  };
};




f=handletool(name:str;argsjson:str;presidiourl:str;ollamaurl:str):$proto.toolresult{
  if(str.eq(name;"anonymise")){
    <handleanonymise(argsjson;presidiourl;ollamaurl)
  }else{
    if(str.eq(name;"compress")){
      <handlecompress(argsjson)
    }else{
      if(str.eq(name;"profile")){
        <handleprofile(argsjson)
      }else{
        if(str.eq(name;"decompress")){
          <handledecompress(argsjson)
        }else{
          if(str.eq(name;"analyse")){
            <handleanalyse(argsjson)
          }else{
            <$proto.toolresult{
              contenttype:"text";
              text:proto.toolresulterr(str.concat("unknown tool: ";name));
              iserror:true
            };
          };
        };
      };
    };
  };
};

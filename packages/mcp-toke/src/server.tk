m=mcptoke.server;



i=t:shared.types;
i=proto:core.mcp.protocol;
i=tools:mcptoke.tools;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=net:std.net;



t=$serverconfig{
  host:str;
  port:u16;
  servername:str;
  version:str;
  presidiourl:str;
  ollamaurl:str
};



f=defaultconfig():$serverconfig{
  <$serverconfig{
    host:"127.0.0.1";
    port:11435;
    servername:"loke-mcp";
    version:"0.1.0";
    presidiourl:"http://localhost:5000";
    ollamaurl:"http://localhost:11434"
  }
};




f=handlerequest(raw:str;config:$serverconfig):str{
  let cid=log.newcorrelationid();
  let req=proto.parserequest(raw);
  mt req {
    $lokeerr:e proto.errorresponse(0;-32700;"Parse error");
    $ok:request {
      log.debug(str.concat("mcp request: ";request.method);"mcp-server";cid);
      if(str.eq(request.method;"initialize")){
        let result=proto.initresponse(config.servername;config.version);
        <proto.okresponse(request.id;result)
      }el{
        if(str.eq(request.method;"tools/list")){
          let tooldefs=tools.alltools();
          let result=proto.toolslistresult(tooldefs);
          <proto.okresponse(request.id;result)
        }el{
          if(str.eq(request.method;"tools/call")){
            let paramsparsed=json.dec(request.paramsraw);
            mt paramsparsed {
              $jsonerr:e proto.errorresponse(request.id;-32602;"Invalid params");
              $ok:paramsobj {
                let toolname=json.getstr(paramsobj;"name");
                let argsval=json.getval(paramsobj;"arguments");
                let argsjson=json.enc(argsval);
                let toolresult=tools.handletool(toolname;argsjson;config.presidiourl;config.ollamaurl);
                <proto.okresponse(request.id;toolresult.text)
              }
            }
          }el{
            log.warn(str.concat("mcp unknown method: ";request.method);"mcp-server";cid);
            <proto.errorresponse(request.id;-32601;"Method not found")
          }
        }
      }
    }
  }
};




f=start(config:$serverconfig):void{
  let cid=log.newcorrelationid();
  let portstr=str.fromint(config.port);
  log.info(str.concat("loke MCP server starting on port ";portstr);"mcp-server";cid);
  let listener=net.listen(config.host;config.port);
  mt listener {
    $neterr:e log.error(str.concat("mcp server: failed to listen on port ";portstr);"mcp-server";cid);
    $ok:l {
      lp(let lv=0;true;lv=lv){
        let conn=net.accept(l);
        mt conn {
          $neterr:e log.warn("mcp server: accept error";"mcp-server";cid);
          $ok:c {
            let data=net.read(c);
            mt data {
              $neterr:e {
                log.warn("mcp server: read error";"mcp-server";cid);
                net.close(c)
              };
              $ok:raw {
                let response=handlerequest(raw;config);
                let writeresult=net.write(c;response);
                mt writeresult {
                  $neterr:e log.warn("mcp server: write error";"mcp-server";cid);
                  $ok: void
                };
                net.close(c)
              }
            }
          }
        }
      }
    }
  }
};

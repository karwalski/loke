m=mcptoke.server;



i=t:shared.types;
i=proto:core.mcp.protocol;
i=tools:mcptoke.tools;
i=lmt:mcptoke.metricstool;
i=http:std.http;
i=json:std.json;
i=jx:shared.jsonobj;
i=str:std.str;
i=log:shared.log;
i=net:std.net;



t=$serverconfig{
  host:str;
  port:u16;
  servername:str;
  version:str;
  presidiourl:str;
  ollamaurl:str
};



(* F3b.12: 11460. It was 11435, which is also the privacy-filter sidecar's default, so with
   both at their defaults only one could bind, and the privacy-filter layer could send its
   /detect POST to mcp-toke. scripts/check_default_ports.py holds every service's default. *)
f=defaultconfig():$serverconfig{
  <$serverconfig{
    host:"127.0.0.1";
    port:11460;
    servername:"loke-mcp";
    version:"0.1.0";
    presidiourl:"http://localhost:5000";
    ollamaurl:"http://localhost:11434"
  }
};




(* $ok first in every match, and the request carries its declared type.

   T-18: a `mt` over a union whose error type is user-declared — $lokeerr here — always
   takes the FIRST arm whatever the value holds. Every match in this module used to put
   the error arm first, so handlerequest returned "Parse error" for every well-formed
   request and start() logged "failed to listen" and returned without ever accepting a
   connection. The whole server was unreachable, and no diagnostic said so. Putting $ok
   first makes the happy path work; the error arms remain unreachable, which is a
   language defect and is why the net calls below are plain integer checks instead. *)
f=handletoolscall(request:$jsonrpcrequest;config:$serverconfig):str{
  <mt json.dec(request.paramsraw) {
    $ok:paramsobj handletoolscallparams(request;paramsobj;config);
    $jsonerr:e proto.errorresponse(request.id;(0-32602) as i32;"Invalid params")
  }
};

(* MK6.10. The arguments are the raw JSON text of `arguments`, taken with jx.valueraw. They were
   `json.enc(json.getval(paramsobj;"arguments"))`, the pattern core.mcp.protocol's note describes:
   measured, every tools/call through this server reached its tool as "invalid args JSON", so
   no tool that takes an argument had ever worked here. The name is read with jx.strvalue, not
   the untyped `json.getstr`. *)
f=handletoolscallparams(request:$jsonrpcrequest;paramsobj:$jsonval;config:$serverconfig):str{
  let name=jx.strvalue(paramsobj;"name";"");
  let args=jx.valueraw(paramsobj;"arguments");
  (* F3b.10. layer_metrics is this server's, not mcptoke.tools' (see mcptoke.metricstool). *)
  if(str.eq(name;lmt.name())){ <proto.okresponse(request.id;lmt.handle(args).text) }el{};
  <proto.okresponse(request.id;tools.handletool(name;args;config.presidiourl;config.ollamaurl).text)
};

(* Every tool this server offers: mcptoke.tools' and layer_metrics (F3b.10). *)
f=servedtools():@$mcptool{
  <tools.alltools().push(lmt.tool())
};

f=dispatchrequest(request:$jsonrpcrequest;config:$serverconfig;cid:str):str{
  log.debug(str.concat("mcp request: ";request.method);"mcp-server";cid);
  if(str.eq(request.method;"initialize")){
    let result=proto.initresponse(config.servername;config.version);
    <proto.okresponse(request.id;result)
  }el{
    if(str.eq(request.method;"tools/list")){
      let result=proto.toolslistresult(servedtools());
      <proto.okresponse(request.id;result)
    }el{
      if(str.eq(request.method;"tools/call")){
        <handletoolscall(request;config)
      }el{
        log.warn(str.concat("mcp unknown method: ";request.method);"mcp-server";cid);
        <proto.errorresponse(request.id;(0-32601) as i32;"Method not found")
      }
    }
  }
};

(* X4b.12. Whether a line is a usable JSON-RPC request: it decodes, and it names a method.
   Both are asked through STDLIB results, which do discriminate their arms ($ok first,
   T-31). JSON alone is not enough, because std.json's decoder is lenient: measured, it
   accepts `{not json`. *)
f=methodof(o:$jsonval):str{
  <mt json.str(o;"method") {
    $ok:m m;
    $err:e ""
  }
};

(* Structurally a single JSON object: starts with `{`, ends with `}`, and its braces and
   brackets balance outside strings. This runs BEFORE json.dec, because std.json accepts
   `{not json` and returns a value that crashes the accessor reading it (T-51). So the
   decoder's own verdict cannot be the guard. Not a full validator: it catches the lines
   that actually arrive broken, which are truncated or garbled ones. *)
f=wellformed(raw:str):bool{
  let s=str.trim(raw);
  let n=str.len(s) as i64;
  if(n<2){ <false }el{};
  (* Bytes through str.charat, which returns a plain i64. str.slice returns a result. *)
  if(str.charat(s;0)!=123 || str.charat(s;n-1)!=125){ <false }el{};
  let depth=mut.0;
  let instr=mut.false;
  let esc=mut.false;
  let ok=mut.true;
  lp(let k=0;k<n && ok;k=k+1){
    let c=str.charat(s;k);
    if(instr){
      if(esc){ esc=false }el{
        if(c==92){ esc=true }el{
          if(c==34){ instr=false }el{}
        }
      }
    }el{
      if(c==34){ instr=true }el{};
      if(c==123 || c==91){ depth=depth+1 }el{};
      if(c==125 || c==93){ depth=depth-1 }el{};
      if(depth<0){ ok=false }el{};
      (* The object closed before the end of the line: text follows it. *)
      if(depth==0 && k<n-1){ ok=false }el{}
    }
  };
  <ok && !instr && depth==0
};

f=isrequest(raw:str):bool{
  if(!wellformed(raw)){ <false }el{};
  <mt json.dec(raw) {
    $ok:o str.len(methodof(o))>0;
    $jsonerr:e false
  }
};

f=handlerequest(raw:str;config:$serverconfig):str{
  let cid=log.newcorrelationid();
  (* A line that is not a request used to CRASH the server. parserequest reports it as a
     !$lokeerr, T-18 reads that as $ok whatever it holds, and dispatchrequest then ran on
     garbage, so one malformed line from any client took the server down. It is refused
     here, before parserequest is reached. *)
  if(!isrequest(raw)){
    log.warn("mcp request refused: not a JSON-RPC request with a method";"mcp-server";cid);
    <proto.errorresponse(0;(0-32600) as i32;"Invalid Request")
  }el{};
  <mt proto.parserequest(raw) {
    $ok:request dispatchrequest(request;config;cid);
    $lokeerr:e proto.errorresponse(0;(0-32700) as i32;"Parse error")
  }
};




(* std.net is five abi entry points returning bare i64 — there is no $ok/$neterr union
   to match, and the legacy matches over net.write, net.read, net.accept and net.listen
   all put $neterr first, so each one took the failure path unconditionally. *)
f=handleconndata(raw:str;c:i64;config:$serverconfig;cid:str):i64{
  if(net.write(c;handlerequest(raw;config))>0){}el{
    log.warn("mcp server: write error";"mcp-server";cid)
  };
  net.close(c);
  <0
};

f=handleconn(c:i64;config:$serverconfig;cid:str):i64{
  let raw=net.read(c);
  if(str.len(raw)>0){
    handleconndata(raw;c;config;cid)
  }el{
    log.warn("mcp server: read error";"mcp-server";cid);
    net.close(c)
  };
  <0
};

f=startlistener(l:i64;config:$serverconfig;cid:str):i64{
  let running=mut.true;
  lp(let lv=0;running;lv=lv){
    let conn=net.accept(l);
    if(conn>0){
      handleconn(conn;config;cid)
    }el{
      log.warn("mcp server: accept error";"mcp-server";cid);
      running=false
    }
  };
  net.close(l);
  <0
};

f=start(config:$serverconfig):i64{
  let cid=log.newcorrelationid();
  let portstr=str.fromint(config.port as i64);
  log.info(str.concat("loke MCP server starting on port ";portstr);"mcp-server";cid);
  (* std.net.listen takes the port only; the host was a second argument it never had. *)
  (* F10.39: std.net.listen takes an address string, "host:port". Handed the port as an
     integer it segfaulted at toke 0b0bc4e (T-49), and toke 3.1.0 rejects it (E4031). The
     host is loopback: every loke listener is local-only. *)
  let listener=net.listen("127.0.0.1:\(portstr)");
  if(listener>0){
    startlistener(listener;config;cid)
  }el{
    log.error(str.concat("mcp server: failed to listen on port ";portstr);"mcp-server";cid)
  };
  <0
};

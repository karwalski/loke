m=mcptoke.main;



i=srv:mcptoke.server;
i=log:shared.log;

(* VM1.6b. Was `main(args:@str)`. toke's generated C main calls tk_main with no arguments,
   so `args` would be whatever a register held: measured 2026-09-27, a program that reads
   it segfaults (exit 139) and one that does not exits 0. This body never read it, so no
   crash was possible; the parameter is gone so that none can be written. Read argv
   through std.args, as cli.main does. *)
f=main():i32{
  let cid=log.newcorrelationid();
  log.info("loke MCP server starting";"mcp-toke";cid);
  let config=srv.defaultconfig();
  srv.start(config);
  <(0 as i32)
};

m=mcptoke.main;



i=srv:mcptoke.server;
i=log:shared.log;
i=str:std.str;

f=main(args:@str):i32{
  let cid=log.newcorrelationid();
  log.info("loke MCP server starting";"mcp-toke";cid);
  let config=srv.defaultconfig();
  srv.start(config);
  <0
};

m=mcptoke.metricstool;

i=t:shared.types;
i=proto:core.mcp.protocol;
i=jx:shared.jsonobj;
i=json:std.json;
i=lmr:core.audit.layermetricsreport;

(* F3b.10. `layer_metrics`: the privacy layers' recorded metrics, for an external tool to
   query filter performance through loke's MCP server. It answers the body GET
   /api/layermetrics answers (core.audit.layermetricsreport builds both), from the store in the
   user's loke directory: requests, detections by layer per day and by entity type, the
   agreement rate between layers and scan latency percentiles, over a window. Aggregates only,
   never a detected value.

   A module of its own, offered by mcptoke.server and not by mcptoke.tools: moke's MCP tool
   panel runs mcptoke.tools' handlers inside the moke process, and this one opens loke's store,
   which would repoint moke's own database connection (core.storage.db.adopt). *)

f=name():str{ <"layer_metrics" };

f=tool():$mcptool{
  <$mcptool{
    name:name();
    description:"Per-layer privacy filter metrics loke has recorded: requests, detections by layer per day and by entity type, the agreement rate between layers and scan latency percentiles, over a time window. Aggregates only, never a detected value.";
    inputschema:"{\"type\":\"object\",\"properties\":{\"window\":{\"type\":\"string\",\"enum\":[\"24h\",\"7d\",\"30d\",\"all\"]}}}"
  }
};

f=errresult(msg:str):$toolresult{
  <$toolresult{contenttype:"text";text:proto.toolresulterr(msg);iserror:true}
};

(* The window named (all when none), or the refusal the route gives for an unknown window or
   a store that cannot be opened, as a tool error. *)
f=answer(obj:$json):$toolresult{
  let mb=lmr.bodyfor(jx.strvalue(obj;"window";"all"));
  if(!mb.ok){ <errresult(mb.body) }el{};
  <$toolresult{contenttype:"text";text:proto.toolresultok(mb.body);iserror:false}
};

f=handle(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj answer(obj);
    $jsonerr:e errresult("invalid args JSON")
  }
};

m=core.update.checker;





i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=jx:shared.jsonobj;
i=db:core.storage.db;
i=str:std.str;
i=u8:shared.utf8;

t=$versioninfo{
  current:str;
  latest:str;
  updateavailable:bool;
  releaseurl:str;
  releasenotes:str;
  checkedat:i64
};

(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=currentversion():str{ <"0.4.0" };
f=checkurl():str{ <"https://api.github.com/repos/karwalski/loke/releases/latest" };





(* The first 200 BYTES of a release's notes, never cut inside a UTF-8 character (F10.49);
   release notes are written by people and often hold an emoji. *)
f=clipnotes(fullnotes:str):str{
  <u8.prefix(fullnotes;200)
};

f=parserelease(store:$store;r:$httpresp;now:i64):$versioninfo{
  let parsed=mt json.dec(r.body) {
    $ok:j j;
    $jsonerr:e jx.emptyobj()
  };
  let tag=mt json.str(parsed;"tag_name"){$ok:okv okv;$err:errv ""};
  let latest=mut.tag;
  if(str.startswith(tag;"v")){
    latest=mt tag.slice(1;str.len(tag)){$ok:okv okv;$err:errv ""}
  }el{};
  let releaseurl=mt json.str(parsed;"html_url"){$ok:okv okv;$err:errv ""};
  let releasenotes=clipnotes(mt json.str(parsed;"body"){$ok:okv okv;$err:errv ""});
  mt db.setstr(store;"update.last_check";str.fromint(now);"update") {
    $ok:v 0;
    $err:v 0
  };
  mt db.setstr(store;"update.latest_version";latest;"update") {
    $ok:v 0;
    $err:v 0
  };
  mt db.setstr(store;"update.release_url";releaseurl;"update") {
    $ok:v 0;
    $err:v 0
  };
  mt db.setstr(store;"update.release_notes";releasenotes;"update") {
    $ok:v 0;
    $err:v 0
  };
  <$versioninfo{
    current:currentversion();
    latest:latest;
    updateavailable:isnewer(currentversion();latest);
    releaseurl:releaseurl;
    releasenotes:releasenotes;
    checkedat:now
  }
};

f=check(store:$store):$versioninfo{
  let now=mt str.toint(str.fromint(t.nowms())){$ok:okv okv;$err:errv 0};
  let dayms=86400000;
  let cachedcheck=mt db.getstr(store;"update.last_check") {
    $ok:v v;
    $err:v ""
  };
  if(str.len(cachedcheck) > 0){
    let lastchecked=mt str.toint(cachedcheck){$ok:okv okv;$err:errv 0};
    if((now - lastchecked) < dayms){
      let latest=mt db.getstr(store;"update.latest_version") {
        $ok:v v;
        $err:v currentversion()
      };
      let releaseurl=mt db.getstr(store;"update.release_url") {
        $ok:v v;
        $err:v ""
      };
      let releasenotes=mt db.getstr(store;"update.release_notes") {
        $ok:v v;
        $err:v ""
      };
      <$versioninfo{
        current:currentversion();
        latest:latest;
        updateavailable:isnewer(currentversion();latest);
        releaseurl:releaseurl;
        releasenotes:releasenotes;
        checkedat:lastchecked
      }
    }
  };
  (* F10.39: this was `http.get(checkurl();@(http.header(...);...))`. The two-argument
     http.get REGISTERS A SERVER ROUTE (T-57), so no update check was ever sent: the
     registration answered 0, the match took its error arm, and every check reported "no
     update". toke 3.1.0 rejects the call (E4031). The check still sends nothing: it is a
     request to github.com, and starting it is a decision for its own story (F10.41), not a
     side effect of a toolchain move. The answer is the one callers always received. *)
  <$versioninfo{
    current:currentversion();
    latest:currentversion();
    updateavailable:false;
    releaseurl:"";
    releasenotes:"";
    checkedat:now
  }
};


f=formatnotification(info:$versioninfo):str{
  if(info.updateavailable){
    <"Update available: \(info.current) -> \(info.latest) (\(info.releaseurl))"
  }el{
    <"loke \(info.current) is up to date"
  }
};



f=isnewer(a:str;b:str):bool{
  let aparts=str.split(a;".");
  let bparts=str.split(b;".");
  let amajor=mt str.toint(aparts.get(0)){$ok:okv okv;$err:errv 0};
  let bmajor=mt str.toint(bparts.get(0)){$ok:okv okv;$err:errv 0};
  if(bmajor > amajor){
    <true
  };
  if(bmajor < amajor){
    <false
  };
  let aminor=mt str.toint(aparts.get(1)){$ok:okv okv;$err:errv 0};
  let bminor=mt str.toint(bparts.get(1)){$ok:okv okv;$err:errv 0};
  if(bminor > aminor){
    <true
  };
  if(bminor < aminor){
    <false
  };
  let apatch=mt str.toint(aparts.get(2)){$ok:okv okv;$err:errv 0};
  let bpatch=mt str.toint(bparts.get(2)){$ok:okv okv;$err:errv 0};
  <bpatch > apatch
};

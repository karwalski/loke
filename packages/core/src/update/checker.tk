m=core.update.checker;





i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=db:core.storage.db;

t=$versioninfo{
  current:str;
  latest:str;
  updateavailable:bool;
  releaseurl:str;
  releasenotes:str;
  checkedat:i64
};

f=currentversion():str{ <"0.1.0" };
f=checkurl():str{ <"https://api.github.com/repos/karwalski/loke/releases/latest" };





f=parserelease(store:i64;r:i64;now:i64):$versioninfo{
  let parsed=json.parse(r.body);
  let tag=json.str(parsed;"tag_name");
  let latest=mut.tag;
  if(str.startswith(tag;"v")){
    latest=tag.slice(1;str.len(tag))
  }el{};
  let releaseurl=json.str(parsed;"html_url");
  let fullnotes=json.str(parsed;"body");
  let releasenotes=mut.fullnotes;
  if(str.len(fullnotes) > 200){
    releasenotes=fullnotes.slice(0;200)
  }el{};
  let nows=str.fromint(now);
  mt db.setstr(store;"update.last_check";nows;"update") {
    $ok:v void;
    $err:v void
  };
  mt db.setstr(store;"update.latest_version";latest;"update") {
    $ok:v void;
    $err:v void
  };
  mt db.setstr(store;"update.release_url";releaseurl;"update") {
    $ok:v void;
    $err:v void
  };
  mt db.setstr(store;"update.release_notes";releasenotes;"update") {
    $ok:v void;
    $err:v void
  };
  <$versioninfo{
    current:currentversion();
    latest:latest;
    updateavailable:isnewer(currentversion();latest);
    releaseurl:releaseurl;
    releasenotes:releasenotes;
    checkedat:now
  }
};

f=check(store:i64):$versioninfo{
  let now=t.nowms();
  let dayms=86400000;
  let cachedcheck=mt db.getstr(store;"update.last_check") {
    $ok:v v;
    $err:v ""
  };
  if(str.len(cachedcheck) > 0){
    let lastchecked=str.toint(cachedcheck);
    if((now - lastchecked) < dayms){
      let latest=mt db.getstr(store;"update.latest_version") {
        $ok:v v;
        $err:v currentversion()
      };
      let releaseurl=mt db.getstr(store;"update.release_url") {
        $ok:v v;
        $err:v ""
      };
      let releasenotes=mt db.getstr(store;"update.release_notes") {
        $ok:v v;
        $err:v ""
      };
      <$versioninfo{
        current:currentversion();
        latest:latest;
        updateavailable:isnewer(currentversion();latest);
        releaseurl:releaseurl;
        releasenotes:releasenotes;
        checkedat:lastchecked
      }
    }
  };
  let resp=http.get(checkurl();@(
    http.header("User-Agent";"loke/0.1.0");
    http.header("Accept";"application/vnd.github+json")
  ));
  mt resp {
    $ok:r parserelease(store;r;now);
    $err:e $versioninfo{
        current:currentversion();
        latest:currentversion();
        updateavailable:false;
        releaseurl:"";
        releasenotes:"";
        checkedat:now
      }
  }
};


f=formatnotification(info:$versioninfo):str{
  if(info.updateavailable){
    <str.concat(
      str.concat(
        str.concat(
          str.concat("Update available: ";info.current);
          " -> ");
        info.latest);
      str.concat(" (";str.concat(info.releaseurl;")")))
  }el{
    <str.concat("loke ";str.concat(info.current;" is up to date"))
  }
};



f=isnewer(a:str;b:str):bool{
  let aparts=str.split(a;".");
  let bparts=str.split(b;".");
  let amajor=str.toint(aparts.get(0));
  let bmajor=str.toint(bparts.get(0));
  if(bmajor > amajor){
    <true
  };
  if(bmajor < amajor){
    <false
  };
  let aminor=str.toint(aparts.get(1));
  let bminor=str.toint(bparts.get(1));
  if(bminor > aminor){
    <true
  };
  if(bminor < aminor){
    <false
  };
  let apatch=str.toint(aparts.get(2));
  let bpatch=str.toint(bparts.get(2));
  <bpatch > apatch
};

m=core.feedback.learning;


i=t:shared.types;
i=log:shared.log;
i=store:feedback.store;
i=db:storage.db;

t=$learningsignal{
  featurearea:str;
  thumbsuprate:f64;
  samplesize:i32;
  confidence:str
};

t=$routingadjustment{
  model:str;
  adjustment:f64;
  reason:str
};

t=$learningstate{
  signals:@$learningsignal;
  adjustments:@$routingadjustment;
  computedat:i64
};




f=computesignals(store:i64):@$learningsignal{
  let sql="SELECT feature_area, COUNT(*) AS total, SUM(CASE WHEN rating='thumbs_up' THEN 1 ELSE 0 END) AS ups FROM feedback GROUP BY feature_area";
  let rows=mt db.queryparams(store.conn;sql;@()) {
    $ok:r r;
    $err:e @()
  };
  let signals=@();
  lp(let i=0;i<str.arraylen(rows);i=i+1){ let row=str.arrayget(rows;i);
    let area=json.getstr(row;"feature_area");
    let total=json.geti32(row;"total");
    let ups=json.geti32(row;"ups");
    let rate=if(total = 0){
      0.0
    }el{
      str.tofloat(str.fromint(ups))/str.tofloat(str.fromint(total))
    };
    let confidence=if(total < 10){
      "low"
    }el{
      if(!(total>50)){
        "medium"
      }el{
        "high"
      }
    };
    signals=signals.append($learningsignal{
      featurearea:area;
      thumbsuprate:rate;
      samplesize:total;
      confidence:confidence
    })
  };
  <signals
};






f=deriveadjustments(signals:@$learningsignal):@$routingadjustment{
  let result=@();
  lp(let i=0;i<str.arraylen(signals);i=i+1){ let signal=str.arrayget(signals;i);
    if(str.contains(signal.featurearea;"routing")){
      if(signal.thumbsuprate < 0.5){
        result.push($routingadjustment{
          model:"router";
          adjustment:-0.2;
          reason:str.concat("low thumbs-up rate on routing area: ";signal.featurearea)
        })
      }el{
        if(signal.thumbsuprate > 0.85){
          if(signal.samplesize > 10){
            result.push($routingadjustment{
              model:"router";
              adjustment:0.1;
              reason:str.concat("high thumbs-up rate, reinforcing: ";signal.featurearea)
            })
          }el{}
        }el{}
      }
    }el{
      if(signal.thumbsuprate > 0.85){
        if(signal.samplesize > 10){
          result.push($routingadjustment{
            model:"router";
            adjustment:0.1;
            reason:str.concat("high thumbs-up rate, reinforcing: ";signal.featurearea)
          })
        }el{}
      }el{}
    }
  };
  <result
};




f=applylearning(state:$learningstate;store:i64):bool{
  let saved=0;
  lp(let i=0;i<str.arraylen(state.adjustments);i=i+1){ let adj=str.arrayget(state.adjustments;i);
    let key=str.concat("learning.adjustment.";adj.model);
    let val=str.fromfloat(adj.adjustment);
    mt db.execparams(
      store.conn;
      "INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)";
      @(key;val)
    ) {
      $ok: saved=saved+1;
      $err:e log.warn(
          str.concat("learning: failed to save adjustment: ";key);
          "feedback.learning";
          "system"
        )
    }
  };
  <saved > 0
};


f=formatlearningstate(state:$learningstate):str{
  let header="=== Learning Signals ===
";
  let signalrows=@();
  lp(let i=0;i<str.arraylen(state.signals);i=i+1){ let s=str.arrayget(state.signals;i);
    let ratepct=str.concat(str.fromfloat(s.thumbsuprate * 100.0);"%");
    signalrows=signalrows.append(str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("  ";s.featurearea);
            " | up_rate=");
          ratepct);
        " | n=");
      str.concat(str.fromint(s.samplesize);str.concat(" | confidence=";s.confidence))))
  };
  let signalsblock=str.join(signalrows;"
");
  let adjheader="

=== Routing Adjustments ===
";
  let adjrows=@();
  lp(let i=0;i<str.arraylen(state.adjustments);i=i+1){ let a=str.arrayget(state.adjustments;i);
    adjrows=adjrows.append(str.concat(
      str.concat(
        str.concat(
          str.concat("  ";a.model);
          " | delta=");
        str.fromfloat(a.adjustment));
      str.concat(" | ";a.reason)))
  };
  let adjblock=if(state.adjustments.len = 0){
    "  (none)"
  }el{
    str.join(adjrows;"
")
  };
  <str.concat(str.concat(str.concat(str.concat(header;signalsblock);adjheader);adjblock);"
")
};

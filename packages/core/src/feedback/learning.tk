m=core.feedback.learning;


i=log:shared.log;
i=store:core.feedback.store;
i=db:core.storage.db;
i=str:std.str;
i=t:shared.types;
i=rawdb:std.db;
i=rx:core.privacy.regex;

t=$learningsignal{
  featurearea:str;
  thumbsuprate:f64;
  samplesize:i32;
  confidence:str
};

t=$routingadjustment{
  model:str;
  adjustment:f64;
  reason:str
};

(* T12.2. A regex pattern's shipped confidence, the confidence after the false-positive
   reports held against it, and how many reports that is. *)
t=$patternconfidence{
  patternid:str;
  base:f64;
  adjusted:f64;
  falsepositives:i64
};

t=$learningstate{
  signals:@$learningsignal;
  adjustments:@$routingadjustment;
  computedat:i64
};




f=computesignals(store:$store):@$learningsignal{
  let rows=mt db.queryparams(store;"SELECT feature_area, COUNT(*) AS total, SUM(CASE WHEN rating='thumbs_up' THEN 1 ELSE 0 END) AS ups FROM feedback GROUP BY feature_area";@()) {
    $ok:r r;
    $err:e @()
  };
  let signals=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row=rows.get(i);
    let area=db.rowstr(row;"feature_area");
    let total=db.rowi32(row;"total");
    let ups=db.rowi32(row;"ups");
    let rate=mut.0.0;
    if(total == 0){}el{
      rate=str.tofloat(str.fromint(ups))/str.tofloat(str.fromint(total))
    };
    let confidence=mut."high";
    if(total < 10){
      confidence="low"
    }el{
      if(!(total>50)){
        confidence="medium"
      }el{}
    };
    signals=signals.append($learningsignal{
      featurearea:area;
      thumbsuprate:rate;
      samplesize:total;
      confidence:confidence
    })
  };
  <signals
};






(* ── Two defects, either of which made this function inert ────────────────────────
   **1. The accumulator was immutable and every push was discarded.** `let result=@();` with no
   `mut.`, and all three branches wrote a bare `result.push(...)`. An array push in toke RETURNS
   the new array and does not mutate in place (T-24), so the value went nowhere. Measured before
   the fix: **zero adjustments for every input**, including a 0.30-rate routing signal that
   should yield one at −0.2 and a 0.92-rate n=30 signal that should yield one at +0.1. The
   function was entirely inert.

   **2. The only negative-adjustment branch could never fire on real data, even once (1) was
   fixed.** The guard was `str.contains(featurearea;"routing")` in lower case, and a real signal
   carries the label `core.feedback.types.arealabel` writes — `"Routing decision"`, capital R.
   `str.contains` is case-sensitive: measured false. So thumbs-down could never lower anything,
   and only the `el{}` branch — which reinforces a HIGH rate — was reachable. A feedback loop
   that can raise a score and not lower it is worse than none.

   Matching on `str.lower(...)` fixes it without depending on the label's capitalisation, which
   is a presentation string and may reasonably change. The `$other` label is free-form user text
   (`"Other: <whatever they typed>"`), so a user writing "Routing" would also match — that is
   the intended reading of a feature area, not a bug.

   Both were found by `tests/unit/feedback/test_learning.tk`, which was written as two deliberate
   red markers and is green now. *)
f=deriveadjustments(signals:@$learningsignal):@$routingadjustment{
  let result=mut.@();
  lp(let i=0;i<str.arraylen(signals);i=i+1){
    let signal:$learningsignal=signals.get(i);
    if(str.contains(str.lower(signal.featurearea);"routing")){
      if(signal.thumbsuprate < 0.5){
        result=result.push($routingadjustment{
          model:"router";
          adjustment:0.0-0.2;
          reason:str.concat("low thumbs-up rate on routing area: ";signal.featurearea)
        })
      }el{
        if(signal.thumbsuprate > 0.85){
          if(signal.samplesize > 10){
            result=result.push($routingadjustment{
              model:"router";
              adjustment:0.1;
              reason:str.concat("high thumbs-up rate, reinforcing: ";signal.featurearea)
            })
          }el{}
        }el{}
      }
    }el{}
  };
  <result
};




f=applylearning(state:$learningstate;store:$store):bool{
  let saved=mut.0;
  lp(let i=0;i<state.adjustments.len;i=i+1){
    let adj=state.adjustments.get(i);
    let key=str.concat("learning.adjustment.";adj.model);
    let val=str.fromfloat(adj.adjustment);
    (* The counter cannot live in the match arm: an arm is an expression, and the
       compiler rejects assignment there. That is why this read `saved==saved+1`
       before — a comparison that satisfied the parser and counted nothing, so
       applylearning always returned false. *)
    (* ── The write was always rejected, and the function always said it succeeded ──
       Two independent defects, and the second hid the first.

       The statement named only `(key, value)`. `settings` declares **`value_type TEXT NOT
       NULL`** and **`updated_at TEXT NOT NULL`**, neither with a default (migrations.tk
       version 2), so every INSERT violated NOT NULL and wrote nothing.

       And `db.execparams` returns `i64!$lokeerr`, whose error side is a user-declared sum —
       toke never reads the discriminant of such a result and arm 0 always runs (T-18). With
       `$ok` first, `ok` was **unconditionally true**. Measured: `applylearning` returned true
       having written zero rows.

       `value_type` is `"float"` because the value is `str.fromfloat(adj.adjustment)`, matching
       what `core.storage.settings.setfloat` records, so a reader using `getfloator` finds the
       type it expects. `updated_at` is `datetime('now')` **in the statement text, unquoted** —
       a bound parameter is a value and is never evaluated, which is GA5.1 and cost eleven sites
       elsewhere in this repo.

       The `ok` flag is still not trustworthy — T-18 makes it unconditional and nothing here can
       change that. The count below is therefore a count of ATTEMPTS, and the honest confirmation
       is the caller reading a value back, as `core.storage.settings` does. Recorded rather than
       papered over. *)
    let ok=mt db.execparams(
      store;
      "INSERT OR REPLACE INTO settings (key, value, value_type, namespace, updated_at) VALUES (?, ?, 'float', 'learning', datetime('now'))";
      @(key;val)
    ) {
      $ok:v true;
      $err:e false
    };
    if(ok){
      saved=saved+1
    }el{
      (log.warn(str.concat("learning: failed to save adjustment: ";key);"feedback.learning";"system"))
    }
  };
  <saved > 0
};


(* ── T12.2 ─────────────────────────────────────────────────────────────────────────
   Per-model scores, the sensitivity review flag, and adaptations that can be listed and
   reverted. Rates are compared as integers (ups*2 < total), not as f64. Every read and write
   goes through std.db with plain bools: the core.storage.db wrappers return user-sum results
   whose arms a caller cannot tell apart (T-18). *)

(* A model with at least five ratings, fewer than half of them thumbs-up, is marked down
   by 0.2. One with more than ten, over 85% thumbs-up, is reinforced by 0.1. *)
f=modeladjustments(store:$store):@$routingadjustment{
  let rows=mt rawdb.many("SELECT model_id, COUNT(*) AS total, SUM(CASE WHEN rating='thumbs_up' THEN 1 ELSE 0 END) AS ups FROM feedback WHERE model_id<>? GROUP BY model_id ORDER BY model_id";@("")) {
    $ok:r r;
    $err:e @()
  };
  let out=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row=rows.get(i);
    let model=rawdb.rowstr(row;"model_id");
    let total=rawdb.rowi64(row;"total");
    let ups=rawdb.rowi64(row;"ups");
    let counts="\(ups) of \(total) thumbs-up";
    if(total>=5 && ups*2<total){
      out=out.push($routingadjustment{ model:model; adjustment:0.0-0.2; reason:str.concat("mostly thumbs-down for this model: ";counts) })
    }el{
      if(total>10 && ups*100>total*85){
        out=out.push($routingadjustment{ model:model; adjustment:0.1; reason:str.concat("consistently thumbs-up for this model: ";counts) })
      }el{}
    }
  };
  <out
};

(* Governance warnings that users mostly mark unhelpful are flagged for a human to review the
   sensitivity rule behind them, not adjusted automatically: loosening a warning is a policy
   decision (design principle: warnings must be earned, and the user is the authority). *)
f=reviewflags(signals:@$learningsignal):@str{
  let out=mut.@();
  lp(let i=0;i<signals.len;i=i+1){
    let sg:$learningsignal=signals.get(i);
    if(str.contains(str.lower(sg.featurearea);"governance warning") && (sg.samplesize as i64)>=10 && sg.thumbsuprate<0.5){
      out=out.push("sensitivity review: most of \(str.fromint(sg.samplesize as i64)) ratings of '\(sg.featurearea)' were thumbs-down")
    }el{}
  };
  <out
};

f=adjkey(model:str):str{ <str.concat("learning.adjustment.";model) };
f=reasonkey(model:str):str{ <str.concat("learning.reason.";model) };

f=putsetting(key:str;value:str;valuetype:str):bool{
  <mt rawdb.exec("INSERT OR REPLACE INTO settings (key, value, value_type, namespace, updated_at) VALUES (?, ?, ?, 'learning', datetime('now'))";@(key;value;valuetype)) {
    $ok:v true;
    $err:e false
  }
};

f=settingvalue(key:str):str{
  <mt rawdb.one("SELECT value FROM settings WHERE key=?";@(key)) {
    $ok:r rawdb.rowstr(r;"value");
    $err:e ""
  }
};

(* An adaptation is its delta and the reason for it. Success is both reading back. *)
f=recordadaptation(store:$store;adj:$routingadjustment):bool{
  let delta=str.fromfloat(adj.adjustment);
  let a=putsetting(adjkey(adj.model);delta;"float");
  let b=putsetting(reasonkey(adj.model);adj.reason;"string");
  <a && b && str.eq(settingvalue(adjkey(adj.model));delta) && str.eq(settingvalue(reasonkey(adj.model));adj.reason)
};

(* One line per active adaptation: "model: delta (reason)". *)
f=listadaptations(store:$store):@str{
  let rows=mt rawdb.many("SELECT key, value FROM settings WHERE namespace='learning' AND key LIKE ? ORDER BY key";@("learning.adjustment.%")) {
    $ok:r r;
    $err:e @()
  };
  let out=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row=rows.get(i);
    let model=str.replace(rawdb.rowstr(row;"key");"learning.adjustment.";"");
    let line=str.concat(model;str.concat(": ";str.concat(rawdb.rowstr(row;"value");str.concat(" (";str.concat(settingvalue(reasonkey(model));")")))));
    out=out.push(line)
  };
  <out
};

(* Removes a model's adaptation, delta and reason both. True when neither is left. *)
f=revert(store:$store;model:str):bool{
  let ok=mt rawdb.exec("DELETE FROM settings WHERE key=? OR key=?";@(adjkey(model);reasonkey(model))) {
    $ok:v true;
    $err:e false
  };
  <ok && str.len(settingvalue(adjkey(model)))==0 && str.len(settingvalue(reasonkey(model)))==0
};

(* ── T12.2: a false-positive PII report lowers THAT pattern's confidence ───────────
   The report is built from the flagged entity itself, because the entity already names the
   pattern that produced it: core.privacy.regex writes `entitytype:pdef.name`. Only that name
   is kept. The entity's value is never read here, never stored and never logged: the store
   has no column for it (core.feedback.store.savepatternreport).

   The pattern must be one core.privacy.regex ships. Anything else is refused, and that is
   also the guard against a caller putting the flagged text where the pattern name belongs:
   a free-form "pattern" would let the value in by the side door. NER and Presidio labels
   (PERSON, EMAIL_ADDRESS, ...) are refused too; their confidences are fixed tables in
   core.privacy.presidio with no per-pattern setting to lower.

   WHAT THE LOWERED CONFIDENCE DOES, AND DOES NOT DO. Each report takes 0.05 off the
   pattern's shipped confidence, floored at 0.10, and applypatternconfidence persists the
   change as an adaptation keyed `pattern.<name>`, so listadaptations shows it and revert
   removes it. Detection does NOT consult it. core.privacy.regex still stamps every entity
   with the shipped confidence, and nothing in the pipeline drops an entity on confidence
   today (the only comparison is which of two overlapping entities to keep). Wiring the
   learned value into detection would let user reports weaken a privacy filter that must
   fail closed, so it needs an explicit, recorded threshold decided by a person; that is
   filed as its own row rather than done silently here. *)
f=patternstep():f64{ <0.05 };
f=patternfloor():f64{ <0.10 };

f=patternkey(patternid:str):str{ <"pattern.\(patternid)" };

f=knownpattern(patternid:str):bool{
  let pats=rx.getpatterns();
  let found=mut.false;
  lp(let i=0;i<pats.len;i=i+1){
    let p:$patterndef=pats.get(i);
    if(str.eq(p.name;patternid)){ found=true }el{}
  };
  <found
};

f=reportfalsepositive(entity:$piientity;requestid:str):bool{
  if(!knownpattern(entity.entitytype)){
    (* The refused name is not logged: when it is not a pattern, it may be the value. *)
    log.warn("feedback: false-positive report refused, not a known detection pattern";"feedback.learning";"system");
    <false
  }el{};
  <store.savepatternreport(entity.entitytype;requestid)
};

(* One entry per shipped pattern that has at least one report against it. *)
f=patternconfidences(st:$store):@$patternconfidence{
  let pats=rx.getpatterns();
  let out=mut.@();
  lp(let i=0;i<pats.len;i=i+1){
    let p:$patterndef=pats.get(i);
    let n=store.patternreportcount(p.name);
    if(n>0){
      let lowered=mut.p.confidence-(patternstep()*str.tofloat(str.fromint(n)));
      if(lowered<patternfloor()){ lowered=patternfloor() }el{};
      out=out.push($patternconfidence{patternid:p.name;base:p.confidence;adjusted:lowered;falsepositives:n})
    }el{}
  };
  <out
};

(* Persists each lowered confidence as an adaptation whose delta is the (negative) change
   from the shipped value. The reason counts reports and says nothing about what was
   flagged. Returns how many were recorded and read back. *)
f=applypatternconfidence(st:$store):i64{
  let pcs=patternconfidences(st);
  let saved=mut.0;
  lp(let i=0;i<pcs.len;i=i+1){
    let pc:$patternconfidence=pcs.get(i);
    let adj=$routingadjustment{
      model:patternkey(pc.patternid);
      adjustment:pc.adjusted-pc.base;
      reason:"\(pc.falsepositives) false-positive PII reports against this pattern"
    };
    if(recordadaptation(st;adj)){ saved=saved+1 }el{}
  };
  <saved
};

(* The confidence the learning store holds for a pattern: its shipped value plus any
   persisted adaptation. An unknown pattern reads as base 0.0, adjusted 0.0. *)
f=learnedconfidence(patternid:str):$patternconfidence{
  let pats=rx.getpatterns();
  let base=mut.0.0;
  lp(let i=0;i<pats.len;i=i+1){
    let p:$patterndef=pats.get(i);
    if(str.eq(p.name;patternid)){ base=p.confidence }el{}
  };
  let delta=settingvalue(adjkey(patternkey(patternid)));
  let adjusted=mut.base;
  if(str.len(delta)>0){ adjusted=base+str.tofloat(delta) }el{};
  <$patternconfidence{patternid:patternid;base:base;adjusted:adjusted;falsepositives:store.patternreportcount(patternid)}
};

f=formatlearningstate(state:$learningstate):str{
  let header="=== Learning Signals ===
";
  let signalrows=mut.@();
  lp(let i=0;i<state.signals.len;i=i+1){
    let s:$learningsignal=state.signals.get(i);
    signalrows=signalrows.push("  \(s.featurearea) | up_rate=\(s.thumbsuprate * 100.0)% | n=\(s.samplesize) | confidence=\(s.confidence)")
  };
  let signalsblock=str.join("
";signalrows);
  let adjheader="

=== Routing Adjustments ===
";
  let adjrows=mut.@();
  lp(let i=0;i<state.adjustments.len;i=i+1){
    let a:$routingadjustment=state.adjustments.get(i);
    adjrows=adjrows.push("  \(a.model) | delta=\(a.adjustment) | \(a.reason)")
  };
  let adjblock=mut.str.join("
";adjrows);
  if(state.adjustments.len == 0 as u64){
    adjblock="  (none)"
  }el{};
  <"\(header)\(signalsblock)\(adjheader)\(adjblock)\n"
};

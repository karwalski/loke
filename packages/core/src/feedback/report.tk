m=core.feedback.report;




i=t:shared.types;
i=http:std.http;
i=jx:shared.jsonobj;
i=log:shared.log;
i=reach:shared.reachability;
i=str:std.str;
i=u8:shared.utf8;

t=$reporttype{
  name:str
};

t=$issuereport{
  id:str;
  reporttype:str;
  description:str;
  stepstoreproduce:str;
  expected:str;
  version:str;
  platform:str;
  createdat:i64
};

f=typebug():str{ <"bug" };
f=typefeature():str{ <"feature" };
f=typeprivacy():str{ <"privacy_concern" };
f=typequality():str{ <"quality" };


f=newreport(reporttype:str;description:str;steps:str;expected:str):$issuereport{
  <$issuereport{
    id:str.hexid(8);
    reporttype:reporttype;
    description:description;
    stepstoreproduce:steps;
    expected:expected;
    version:"0.1.0";
    platform:"macOS";
    createdat:t.nowms()
  }
};


f=formatgithubbody(r:$issuereport):str{
  let typeline=str.concat("**Type:** ";r.reporttype);
  let metaline="**Version:** \(r.version) | **Platform:** \(r.platform)";
  let descsection=str.concat("## Description
";r.description);
  let stepssection=str.concat("## Steps to Reproduce
";r.stepstoreproduce);
  let expectedsection=str.concat("## Expected Behaviour
";r.expected);
  <"\(typeline)\n\(metaline)\n\n\(descsection)\n\n\(stepssection)\n\n\(expectedsection)\n\n---\n*Reported via loke feedback pipeline*"
};



f=submithandleresponse(r:$httpresp):bool{
  if(r.status == 201){
    log.info(
      str.concat("issue report submitted: ";r.body);
      "feedback.report";
      "system"
    );
    <true
  }el{
    log.warn(
      str.concat("issue report unexpected status: ";str.fromint(r.status));
      "feedback.report";
      "system"
    );
    <false
  }
};

f=submithandleerr(e:$httperr):bool{
  log.warn(
    "issue report submission failed: \(e.msg)";
    "feedback.report";
    "system"
  );
  <false
};

(* The issue title carries the first 60 BYTES of the description, never cut inside a UTF-8
   character (F10.49). `description.slice(0;60)` did both worse: it split characters, and a
   description SHORTER than 60 bytes came back empty, so the title was just the type. *)
f=issuetitle(r:$issuereport):str{
  <"[\(r.reporttype)] \(u8.prefix(r.description;60))"
};

f=submittogithub(r:$issuereport;owner:str;repo:str;token:str):bool{
  let body=formatgithubbody(r);
  let title=issuetitle(r);
  (* json.obj takes a raw JSON string, json.kv builds one pair, and json.arr is a
     GETTER that reads an array out of a document — none of them compose into an
     object literal. The payload is built as text and escaped with jx.escape, as the
     headers two lines down are. json.enc, which this used, left the multi-line issue
     body's newlines raw (MK6.13). *)
  let payload="{\"title\":\(jx.escape(title)),\"body\":\(jx.escape(body)),\"labels\":[\(jx.escape(r.reporttype)),\"user-report\"]}";
  let url="https://api.github.com/repos/\(owner)/\(repo)/issues";
  let authheader=str.concat("token ";token);
  (* F10.39, toke 3.1.0. This was `http.postheaders(http.client(url);"";bytes;headersjson)`,
     the client-first four-argument shape that toke 0b0bc4e compiled and that sent NOTHING
     (T-48): the request never left the machine and the match took its error arm. 3.1.0
     rejects that shape (E4026), and the typed three-argument call that replaces it really
     sends. Migrating the call must not quietly start sending to a host it never reached, and
     core.providers.transport still refuses every non-loopback send (T-58 hold), so the same
     rule applies here: a non-loopback URL takes the error path without a byte sent, which is
     what callers observed before. Enabling this send is a separate story. *)
  if(!reach.isloopbackurl(url)){
    log.warn("issue report submission refused: only a loopback url is sent to (F10.39)";"feedback.report";"system");
    <false
  }el{};
  (* The arm binding is `httpr`, not `r`: the enclosing function's parameter is
     already `r:$issuereport`, and the collision made submithandleresponse receive the
     report instead of the response. *)
  <mt http.postheaders(url;payload;@(@("authorization";authheader);@("content-type";"application/json");@("accept";"application/vnd.github+json"))) {
    $ok:httpr submithandleresponse(httpr);
    $err:e submithandleerr(e)
  }
};

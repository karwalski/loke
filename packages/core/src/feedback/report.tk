m=core.feedback.report;




i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=log:shared.log;

t=$reporttype{
  name:str
};

t=$issuereport{
  id:str;
  reporttype:str;
  description:str;
  stepstoreproduce:str;
  expected:str;
  version:str;
  platform:str;
  createdat:i64
};

let typebug = "bug";
let typefeature = "feature";
let typeprivacy = "privacy_concern";
let typequality = "quality";


f=newreport(reporttype:str;description:str;steps:str;expected:str):$issuereport{
  let id=str.hexid(8);
  <$issuereport{
    id:id;
    reporttype:reporttype;
    description:description;
    stepstoreproduce:steps;
    expected:expected;
    version:"0.1.0";
    platform:"macOS";
    createdat:t.nowms()
  };
};


f=formatgithubbody(r:$issuereport):str{
  let typeline=str.concat("**Type:** ";r.reporttype);
  let metaline=str.concat(
    str.concat("**Version:** ";r.version);
    str.concat(" | **Platform:** ";r.platform)
  );
  let descsection=str.concat("## Description
";r.description);
  let stepssection=str.concat("## Steps to Reproduce
";r.stepstoreproduce);
  let expectedsection=str.concat("## Expected Behaviour
";r.expected);
  let footer="*Reported via loke feedback pipeline*";
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(typeline;"
");
                str.concat(metaline;"

"));
              str.concat(descsection;"

"));
            str.concat(stepssection;"

"));
          str.concat(expectedsection;"

"));
        "---
");
      footer)
    ;"")
};



f=submittogithub(r:$issuereport;owner:str;repo:str;token:str):bool{
  let body=formatgithubbody(r);
  let title=str.concat(
    str.concat("[";r.reporttype);
    str.concat("] ";r.description.slice(0;60))
  );
  let payload=json.obj(@(
    json.kv("title";json.str(title));
    json.kv("body";json.str(body));
    json.kv("labels";json.arr(@(json.str(r.reporttype);json.str("user-report"))))
  ));
  let url=str.concat(
    str.concat(
      str.concat(
        str.concat("https://api.github.com/repos/";owner);
      "/");
    repo);
  "/issues");
  let authheader=str.concat("token ";token);
  let resp=http.post(url;json.tostr(payload);@(
    http.header("Authorization";authheader);
    http.header("Content-Type";"application/json");
    http.header("Accept";"application/vnd.github+json")
  ));
  mt resp {
    $ok:r {
      if(r.status = 201){
        log.info(
          str.concat("issue report submitted: ";r.body);
          "feedback.report";
          "system"
        );
        <true
      }else{
        log.warn(
          str.concat("issue report unexpected status: ";str.fromint(r.status));
          "feedback.report";
          "system"
        );
        <false
      };
    };
    $err:e {
      log.warn(
        str.concat("issue report submission failed: ";e.message);
        "feedback.report";
        "system"
      );
      <false
    };
  };
};

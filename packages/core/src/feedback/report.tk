m=core.feedback.report;




i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=str:std.str;

t=$reporttype{
  name:str
};

t=$issuereport{
  id:str;
  reporttype:str;
  description:str;
  stepstoreproduce:str;
  expected:str;
  version:str;
  platform:str;
  createdat:i64
};

f=typebug():str{ <"bug" };
f=typefeature():str{ <"feature" };
f=typeprivacy():str{ <"privacy_concern" };
f=typequality():str{ <"quality" };


f=newreport(reporttype:str;description:str;steps:str;expected:str):$issuereport{
  let id=str.hexid(8);
  <$issuereport{
    id:id;
    reporttype:reporttype;
    description:description;
    stepstoreproduce:steps;
    expected:expected;
    version:"0.1.0";
    platform:"macOS";
    createdat:t.nowms()
  }
};


f=formatgithubbody(r:$issuereport):str{
  let typeline=str.concat("**Type:** ";r.reporttype);
  let metaline=str.concat(
    str.concat("**Version:** ";r.version);
    str.concat(" | **Platform:** ";r.platform)
  );
  let descsection=str.concat("## Description
";r.description);
  let stepssection=str.concat("## Steps to Reproduce
";r.stepstoreproduce);
  let expectedsection=str.concat("## Expected Behaviour
";r.expected);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(typeline;"
");
                str.concat(metaline;"

"));
              str.concat(descsection;"

"));
            str.concat(stepssection;"

"));
          str.concat(expectedsection;"

"));
        "---
");
      "*Reported via loke feedback pipeline*")
    ;"")
};



f=submithandleresponse(r:$httpresp):bool{
  if(r.status == 201){
    log.info(
      str.concat("issue report submitted: ";r.body);
      "feedback.report";
      "system"
    );
    <true
  }el{
    log.warn(
      str.concat("issue report unexpected status: ";str.fromint(r.status));
      "feedback.report";
      "system"
    );
    <false
  }
};

f=submithandleerr(e:$httperr):bool{
  log.warn(
    "issue report submission failed: \(e.msg)";
    "feedback.report";
    "system"
  );
  <false
};

f=submittogithub(r:$issuereport;owner:str;repo:str;token:str):bool{
  let body=formatgithubbody(r);
  let title="[\(r.reporttype)] \(r.description.slice(0;60))";
  (* json.obj takes a raw JSON string, json.kv builds one pair, and json.arr is a
     GETTER that reads an array out of a document — none of them compose into an
     object literal. The payload is built as text and escaped with json.enc, which
     is what the headers two lines down already do. *)
  let payload="{\"title\":\(json.enc(title)),\"body\":\(json.enc(body)),\"labels\":[\(json.enc(r.reporttype)),\"user-report\"]}";
  let url=str.concat(
    str.concat(
      str.concat(
        str.concat("https://api.github.com/repos/";owner);
      "/");
    repo);
  "/issues");
  let authheader=str.concat("token ";token);
  (* postheaders takes a headers JSON string, not an array of http.header values. *)
  let hdrs="{\"authorization\":\(json.enc(authheader)),\"content-type\":\"application/json\",\"accept\":\"application/vnd.github+json\"}";
  let hc=http.client(url);
  let resp=http.postheaders(hc;"";str.tobytes(payload);hdrs);
  mt resp {
    $ok:r submithandleresponse(r);
    $err:e submithandleerr(e)
  }
};

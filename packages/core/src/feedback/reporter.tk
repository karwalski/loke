m=core.feedback.reporter;
i=str:std.str;
i=log:shared.log;

t=$reporttype{
  $bug:i64;
  $enhancement:i64;
  $question:i64;
  $security:i64
};

t=$issuereport{
  id:str;
  reporttype:str;
  title:str;
  description:str;
  reprosteps:str;
  expectedbehaviour:str;
  actualbehaviour:str;
  screenshots:@str;
  environment:str;
  version:str;
  privacyscanned:bool;
  createdat:str
};

t=$destinationconfig{
  desttype:str;
  url:str;
  authtokenenv:str;
  projectid:str;
  labels:@str
};

f=create(reporttype:str;title:str;description:str;repro:str;expected:str;actual:str):$issuereport{
  <$issuereport{
    id:str.concat("report-";str.fromint(0));
    reporttype:reporttype;
    title:title;
    description:description;
    reprosteps:repro;
    expectedbehaviour:expected;
    actualbehaviour:actual;
    screenshots:@();
    environment:"";
    version:"";
    privacyscanned:false;
    createdat:""
  }
};

f=markscanned(report:$issuereport):$issuereport{
  <$issuereport{
    id:report.id;
    reporttype:report.reporttype;
    title:report.title;
    description:report.description;
    reprosteps:report.reprosteps;
    expectedbehaviour:report.expectedbehaviour;
    actualbehaviour:report.actualbehaviour;
    screenshots:report.screenshots;
    environment:report.environment;
    version:report.version;
    privacyscanned:true;
    createdat:report.createdat
  }
};

f=tojson(report:$issuereport):str{
  let out=str.concat("{\"id\":\"";str.concat(report.id;str.concat("\",\"type\":\"";str.concat(report.reporttype;str.concat("\",\"title\":\"";str.concat(report.title;str.concat("\",\"description\":\"";str.concat(report.description;str.concat("\",\"privacy_scanned\":";str.concat(if(report.privacyscanned){"true"}el{"false"};"}"))))))))));
  <out
};

f=submit(report:$issuereport;dest:$destinationconfig):bool!$lokeerr{
  if(report.privacyscanned){
    log.info(str.concat("submitting report ";str.concat(report.id;" to ";str.concat(dest.desttype;"")));"reporter";"feedback");
    <$ok(true)
  }el{
    log.warn("report not privacy-scanned, refusing to submit";"reporter";"feedback");
    <$err($$unknownerr("report must be privacy-scanned before submission"))
  }
};

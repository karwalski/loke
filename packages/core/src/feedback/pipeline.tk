m=core.feedback.pipeline;




i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=store:feedback.store;

t=$githubconfig{
  owner:str;
  repo:str;
  token:str
};

t=$submissionbatch{
  entriescount:i32;
  thumbsup:i32;
  thumbsdown:i32;
  topareas:@(str);
  periodlabel:str
};

t=$submissionresult{
  ok:bool;
  issueurl:str;
  err:str
};



f=buildbatch(db:store.$feedbackstore;periodlabel:str):$submissionbatch{
  let summary=store.getsummary(db;7);
  let topareas=summary.topissues.slice(0;3);
  <$submissionbatch{
    entriescount:summary.total;
    thumbsup:summary.thumbsup;
    thumbsdown:summary.thumbsdown;
    topareas:topareas;
    periodlabel:periodlabel
  };
};


f=formatissuebody(batch:$submissionbatch):str{
  let ups=str.fromint(batch.thumbsup);
  let downs=str.fromint(batch.thumbsdown);
  let arealines=batch.topareas.map|area{
    str.concat("- ";area)
  };
  let areasblock=str.join(arealines;"
");
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat("## Feedback Summary — ";batch.periodlabel);
                "

**Ratings:** 👍 ");
              ups);
            " / 👎 ");
          downs);
        "

**Top areas needing attention:**
");
      areasblock);
    "

*Auto-generated by loke feedback pipeline*")
};




f=submitbatch(cfg:$githubconfig;batch:$submissionbatch):$submissionresult{
  let body=formatissuebody(batch);
  let title=str.concat("Feedback: ";batch.periodlabel);
  let payload=json.obj(@(
    json.kv("title";json.str(title));
    json.kv("body";json.str(body));
    json.kv("labels";json.arr(@(json.str("feedback");json.str("auto"))))
  ));
  let url=str.concat(
    str.concat(
      str.concat(
        str.concat("https://api.github.com/repos/";cfg.owner);
      "/");
    cfg.repo);
  "/issues");
  let authheader=str.concat("token ";cfg.token);
  let resp=http.post(url;json.tostr(payload);@(
    http.header("Authorization";authheader);
    http.header("Content-Type";"application/json");
    http.header("Accept";"application/vnd.github+json")
  ));
  mt resp {
    $ok:r {
      let issueurl=json.getstr(json.parse(r.body);"html_url");
      <$submissionresult{
        ok:true;
        issueurl:issueurl;
        err:""
      };
    };
    $err:e {
      <$submissionresult{
        ok:false;
        issueurl:"";
        err:str.concat("http error: ";e.message)
      };
    };
  };
};



f=runpipeline(cfg:$githubconfig;db:store.$feedbackstore;periodlabel:str):$submissionresult{
  let batch=buildbatch(db;periodlabel);
  let result=submitbatch(cfg;batch);
  if result.ok{
    log.info(
      str.concat("feedback pipeline succeeded: ";result.issueurl);
      "feedback.pipeline";
      "system"
    )
  }else{
    log.warn(
      str.concat("feedback pipeline failed: ";result.err);
      "feedback.pipeline";
      "system"
    )
  };
  <result
};

m=core.feedback.pipeline;

i=http:std.http;
i=json:std.json;
i=jx:shared.jsonobj;
i=log:shared.log;
i=reach:shared.reachability;
i=store:core.feedback.store;
i=ft:core.feedback.types;
i=str:std.str;

t=$githubconfig{
  owner:str;
  repo:str;
  token:str
};

t=$submissionbatch{
  entriescount:i32;
  thumbsup:i32;
  thumbsdown:i32;
  topareas:@str;
  periodlabel:str
};

t=$submissionresult{
  ok:bool;
  issueurl:str;
  err:str
};



(* store.getsummary returns a result, so the summary is read on the ok arm rather
   than dereferenced directly. An empty batch is the honest answer when the query
   fails: reporting zeros is better than reporting a summary nobody computed. *)
(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=batchfromsummary(summary:$feedbacksummary;periodlabel:str):$submissionbatch{
  <$submissionbatch{
    entriescount:summary.total;
    thumbsup:summary.thumbsup;
    thumbsdown:summary.thumbsdown;
    topareas:summary.topissues.slice(0;3);
    periodlabel:periodlabel
  }
};

f=buildbatch(db:i64;periodlabel:str):$submissionbatch{
  <mt store.getsummary(db;7) {
    $ok:summary batchfromsummary(summary;periodlabel);
    $err:e $submissionbatch{entriescount:0;thumbsup:0;thumbsdown:0;topareas:@();periodlabel:periodlabel}
  }
};


f=formatissuebody(batch:$submissionbatch):str{
  let ups=str.fromint(batch.thumbsup);
  let downs=str.fromint(batch.thumbsdown);
  let arealines=mut.@();
  lp(let i=0;i<str.arraylen(batch.topareas);i=i+1){ let area=batch.topareas.get(i);
    arealines=arealines.append(str.concat("- ";area))
  };
  let areasblock=str.join("
";arealines);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat("## Feedback Summary — ";batch.periodlabel);
                "

**Ratings:** 👍 ");
              ups);
            " / 👎 ");
          downs);
        "

**Top areas needing attention:**
");
      areasblock);
    "

*Auto-generated by loke feedback pipeline*")
};




f=submitbatchok(r:$httpresp):$submissionresult{
  let issueurl=mt json.dec(r.body) {
    $ok:j jx.strvalue(j;"html_url";"");
    $jsonerr:e ""
  };
  <$submissionresult{
    ok:true;
    issueurl:issueurl;
    err:""
  }
};

f=submitbatch(cfg:$githubconfig;batch:$submissionbatch):$submissionresult{
  let body=formatissuebody(batch);
  let title="Feedback: \(batch.periodlabel)";
  (* json.obj takes a raw JSON string, json.kv builds a single pair and json.arr is
     a getter — they do not compose into an object literal. jx.escape escapes; json.enc
     left the multi-line issue body's newlines raw (MK6.13). *)
  let payload="{\"title\":\(jx.escape(title)),\"body\":\(jx.escape(body)),\"labels\":[\"feedback\",\"auto\"]}";
  let url="https://api.github.com/repos/\(cfg.owner)/\(cfg.repo)/issues";
  let authheader="token \(cfg.token)";
  (* F10.39, toke 3.1.0. This was `http.postheaders(http.client(url);"";bytes;headersjson)`,
     the client-first four-argument shape that toke 0b0bc4e compiled and that sent NOTHING
     (T-48): the request never left the machine and the match took its error arm. 3.1.0
     rejects that shape (E4026), and the typed three-argument call that replaces it really
     sends. Migrating the call must not quietly start sending to a host it never reached, and
     core.providers.transport still refuses every non-loopback send (T-58 hold), so the same
     rule applies here: a non-loopback URL takes the error path without a byte sent, which is
     what callers observed before. Enabling this send is a separate story. *)
  if(!reach.isloopbackurl(url)){
    log.warn("feedback batch submission refused: only a loopback url is sent to (F10.39)";"feedback.pipeline";"system");
    <$submissionresult{ok:false;issueurl:"";err:"http error"}
  }el{};
  let hdrs=@(@("authorization";authheader);@("content-type";"application/json");@("accept";"application/vnd.github+json"));
  let resp=http.postheaders(url;payload;hdrs);
  <mt resp {
    $ok:r submitbatchok(r);
    $err:e $submissionresult{
      ok:false;
      issueurl:"";
      err:"http error"
    }
  }
};



f=runpipeline(cfg:$githubconfig;db:i64;periodlabel:str):$submissionresult{
  let batch=buildbatch(db;periodlabel);
  let result=submitbatch(cfg;batch);
  if(result.ok){
    log.info(
      str.concat("feedback pipeline succeeded: ";result.issueurl);
      "feedback.pipeline";
      "system"
    )
  }el{
    log.warn(
      str.concat("feedback pipeline failed: ";result.err);
      "feedback.pipeline";
      "system"
    )
  };
  <result
};

m=core.feedback.types;




i=t:shared.types;
i=str:std.str;

t=$feedbackrating{
  $thumbsup:i64;
  $thumbsdown:i64;
  $neutral:i64};

t=$featurearea{
  $chatresponse:i64;
  $privacydetection:i64;
  $routingdecision:i64;
  $governancewarning:i64;
  $agentoutput:i64;
  $compression:i64;
  $dashboard:i64;
  $other:str
};

t=$feedbackentry{
  id:str;
  rating:$feedbackrating;
  featurearea:$featurearea;
  requestid:str;
  modelid:str;
  usecase:str;
  risklevel:str;
  comment:str;
  createdat:str
};

t=$feedbacksummary{
  total:u32;
  thumbsup:u32;
  thumbsdown:u32;
  thumbsuprate:f64;
  topissues:@str
};



f=newentry(rating:$feedbackrating;area:$featurearea;requestid:str;modelid:str;comment:str):$feedbackentry{
  let id=str.randhex(16);
  <$feedbackentry{
    id:id;
    rating:rating;
    featurearea:area;
    requestid:requestid;
    modelid:modelid;
    usecase:"";
    risklevel:"";
    comment:comment;
    createdat:""
  }
};


f=ratinglabel(r:$feedbackrating):str{
  mt r {
    $thumbsup:v "thumbs_up" ;
    $thumbsdown:v "thumbs_down" ;
    $neutral:v "neutral" 
  }
};


f=arealabel(a:$featurearea):str{
  mt a {
    $chatresponse:v "Chat response" ;
    $privacydetection:v "Privacy detection" ;
    $routingdecision:v "Routing decision" ;
    $governancewarning:v "Governance warning" ;
    $agentoutput:v "Agent output" ;
    $compression:v "Compression" ;
    $dashboard:v "Dashboard" ;
    $other:label str.concat("Other: ";label) 
  }
};

m=core.feedback.types;




i=t:shared.types;
i=str:std.str;

t=$feedbackrating{
  $thumbsup;
  $thumbsdown;
  $neutral
};

t=$featurearea{
  $chatresponse;
  $privacydetection;
  $routingdecision;
  $governancewarning;
  $agentoutput;
  $compression;
  $dashboard;
  $other(str)
};

t=$feedbackentry{
  id:str;
  rating:$feedbackrating;
  featurearea:$featurearea;
  requestid:str;
  modelid:str;
  usecase:str;
  risklevel:str;
  comment:str;
  createdat:str
};

t=$feedbacksummary{
  total:u32;
  thumbsup:u32;
  thumbsdown:u32;
  thumbsuprate:f64;
  topissues:@(str)
};



f=newentry(rating:$feedbackrating;area:$featurearea;requestid:str;modelid:str;comment:str):$feedbackentry{
  let id=str.randhex(16);
  <$feedbackentry{
    id:id;
    rating:rating;
    featurearea:area;
    requestid:requestid;
    modelid:modelid;
    usecase:"";
    risklevel:"";
    comment:comment;
    createdat:""
  };
};


f=ratinglabel(r:$feedbackrating):str{
  mt r {
    $feedbackrating.$thumbsup;   <"thumbs_up";
    $feedbackrating.$thumbsdown; <"thumbs_down";
    $feedbackrating.$neutral;     <"neutral"
  };
};


f=arealabel(a:$featurearea):str{
  mt a {
    $featurearea.$chatresponse;      <"Chat response";
    $featurearea.$privacydetection;  <"Privacy detection";
    $featurearea.$routingdecision;   <"Routing decision";
    $featurearea.$governancewarning; <"Governance warning";
    $featurearea.$agentoutput;       <"Agent output";
    $featurearea.$compression;        <"Compression";
    $featurearea.$dashboard;          <"Dashboard";
    $featurearea.$other label;        <str.concat("Other: ";label)
  };
};

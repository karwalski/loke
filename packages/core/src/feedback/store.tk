m=core.feedback.store;

i=ft:core.feedback.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=s:core.storage.db;


(* Declared i64!$lokeerr, not void!$lokeerr, and returns $ok(0).

   toke lowers a `void!$err` success type to LLVM `void`, so any call site that binds
   the result — a match arm, for instance — emits `alloca void` and clang rejects the
   module with "void type only allowed for function results". Filed as T-5 in
   docs/upstream/toke-issues.md, same family as T-1 ($ok(<bool>)): only an i64-width
   success type survives the `!$err` lowering today. *)
f=ensuretable(store:i64):i64!$lokeerr{
  let sql="CREATE TABLE IF NOT EXISTS feedback (
  id TEXT PRIMARY KEY,
  rating TEXT NOT NULL,
  feature_area TEXT NOT NULL,
  request_id TEXT,
  model_id TEXT,
  use_case TEXT,
  risk_level TEXT,
  comment TEXT,
  submitted INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
)";
  <mt db.exec(sql;@()) {
    $ok:v $ok(0);
    $err:e $err($storageerr("failed to create feedback table"))
  }
};


f=save(store:i64;entry:$feedbackentry):i64!$lokeerr{
  let ratings=ft.ratinglabel(entry.rating);
  let areas=ft.arealabel(entry.featurearea);
  (* `datetime('now')`, not `'now()'` — GA5.1. Quoted, this stored five characters, so every
     feedback row had the same created_at and nothing could be ordered or windowed by it.
     Feedback is a first-class feature of this product; a feedback table that cannot be read
     chronologically is not one. *)
  <mt db.exec("INSERT INTO feedback (id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,submitted,created_at) VALUES (?,?,?,?,?,?,?,?,0,datetime('now'))";@(entry.id;ratings;areas;entry.requestid;entry.modelid;entry.usecase;entry.risklevel;entry.comment)) {
    $ok:v $ok(0);
    $err:e $err($storageerr(str.concat("failed to save feedback: ";entry.id)))
  }
};


f=buildsummary(rows:@$row):$feedbacksummary{
  let total=rows.len;
  let thumbsupcount=mut.0;
  let thumbsdowncount=mut.0;
  lp(let ii57=0;ii57<rows.len;ii57=ii57+1){
    let r=s.rowstr(rows.get(ii57);"rating");
    if(str.eq(r;"thumbs_up")){
      thumbsupcount=thumbsupcount+1
    }el{
      if(str.eq(r;"thumbs_down")){
        thumbsdowncount=thumbsdowncount+1
      }el{};
    };

  };
  let rate=mut.0.0;
  if(total == 0){}el{
    rate=str.tofloat(str.fromint(thumbsupcount))/str.tofloat(str.fromint(total))
  };
  <$feedbacksummary{
    total:total;
    thumbsup:thumbsupcount;
    thumbsdown:thumbsdowncount;
    thumbsuprate:rate;
    topissues:@()
  }
};

f=getsummary(store:i64;days:u32):$feedbacksummary!$lokeerr{
  let dayss=str.fromint(days);
  let sql=str.concat(
    (* GA5.17, the same residual as core.governance.monitoring.computetrend. This table's
       created_at carried the five characters now() before the writer at line 48 was fixed,
       and "now()" is lexicographically greater than any ISO date this century — so those
       rows satisfy every window bound and would be counted in every feedback summary for
       ever. The shape test excludes them; a real datetime('now') value passes it. *)
    "SELECT rating FROM feedback WHERE created_at LIKE '____-__-__%' AND created_at >= datetime('now','-";
    str.concat(dayss;" days')")
  );
  <mt db.many(sql;@()) {
    $ok:rows $ok(buildsummary(rows));
    $err:e $err($storageerr("failed to query feedback summary"))
  }
};


f=buildpendingentries(rows:@$row):@$feedbackentry{
  let entries=mut.@();
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let row=rows.get(ii);
    let ratings=db.rowstr(row;"rating");
    let rating=mut.$feedbackrating{$neutral:0};
    if(str.eq(ratings;"thumbs_up")){
      rating=$feedbackrating{$thumbsup:0}
    }el{
      if(str.eq(ratings;"thumbs_down")){
        rating=$feedbackrating{$thumbsdown:0}
      }el{}
    };
    let areas=db.rowstr(row;"feature_area");
    (* `str.trimprefix`, because `core.feedback.types.arealabel` renders `$other(label)` as
       `str.concat("Other: ";label)` — so the STORED string already carries the prefix, and
       rebuilding `$other` from the whole stored string made `arealabel` add a second one.
       Measured: a free-form area round-tripped as `"Other: Other: Widget X"`, and once more on
       every subsequent save-and-read. trimprefix is a no-op on the labels that match a named
       variant below, so it is safe to apply unconditionally here. *)
    let area=mut.$other(str.trimprefix(areas;"Other: "));
    if(str.eq(areas;"Chat response")){
      area=$featurearea{$chatresponse:0}
    }el{
      if(str.eq(areas;"Privacy detection")){
        area=$featurearea{$privacydetection:0}
      }el{
        if(str.eq(areas;"Routing decision")){
          area=$featurearea{$routingdecision:0}
        }el{
          if(str.eq(areas;"Governance warning")){
            area=$featurearea{$governancewarning:0}
          }el{
            if(str.eq(areas;"Agent output")){
              area=$featurearea{$agentoutput:0}
            }el{
              if(str.eq(areas;"Compression")){
                area=$featurearea{$compression:0}
              }el{
                if(str.eq(areas;"Dashboard")){
                  area=$featurearea{$dashboard:0}
                }el{}
              }
            }
          }
        }
      }
    };
    entries=entries.push($feedbackentry{
      id:db.rowstr(row;"id");
      rating:rating;
      featurearea:area;
      requestid:db.rowstr(row;"request_id");
      modelid:db.rowstr(row;"model_id");
      usecase:db.rowstr(row;"use_case");
      risklevel:db.rowstr(row;"risk_level");
      comment:db.rowstr(row;"comment");
      createdat:db.rowstr(row;"created_at")
    })
  };
  <entries
};

f=pendingsubmission(store:i64):@$feedbackentry!$lokeerr{
  <mt db.many("SELECT id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,created_at FROM feedback WHERE submitted=0";@()) {
    $ok:rows $ok(buildpendingentries(rows));
    $err:e $err($storageerr("failed to query pending feedback"))
  }
};


(* T12.1. Reads that return plain arrays, because a caller cannot tell the arms of a
   user-sum result apart (T-18). A failed query is an empty list and is logged. *)
f=entrieswhere(sqltext:str;params:@str):@$feedbackentry{
  <mt db.many(sqltext;params) {
    $ok:rows buildpendingentries(rows);
    $err:e emptyentries(sqltext)
  }
};

f=emptyentries(sqltext:str):@$feedbackentry{
  log.warn("feedback query failed";"feedback";"system");
  <@()
};

f=listall(store:i64):@$feedbackentry{
  <entrieswhere("SELECT id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,created_at FROM feedback WHERE id<>? ORDER BY created_at, rowid";@(""))
};

(* Filtered on the stored label, which is what arealabel writes. *)
f=byarea(store:i64;area:$featurearea):@$feedbackentry{
  <entrieswhere("SELECT id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,created_at FROM feedback WHERE feature_area=? ORDER BY created_at, rowid";@(ft.arealabel(area)))
};

f=thumbsdown(store:i64):@$feedbackentry{
  <entrieswhere("SELECT id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,created_at FROM feedback WHERE rating=? ORDER BY created_at, rowid";@("thumbs_down"))
};

(* ── T12.2: false-positive PII reports, by pattern ────────────────────────────────
   A row names the detector pattern that produced the flagged entity and nothing else about
   it. There is no column for the matched text, the placeholder or a comment: the report is
   about the PATTERN, and a feedback store that kept the flagged value would be a second copy
   of the very PII the user just told us about. Callers go through
   core.feedback.learning.reportfalsepositive, which accepts only a known pattern name. Plain
   bools through std.db (T-18). *)
f=ensurepiitable():bool{
  <mt db.exec("CREATE TABLE IF NOT EXISTS pii_feedback (id TEXT PRIMARY KEY, pattern_id TEXT NOT NULL, verdict TEXT NOT NULL, request_id TEXT, created_at TEXT NOT NULL)";@()) {
    $ok:v true;
    $err:e false
  }
};

f=savepatternreport(patternid:str;requestid:str):bool{
  let table=ensurepiitable();
  let ok=mt db.exec("INSERT INTO pii_feedback (id,pattern_id,verdict,request_id,created_at) VALUES (?,?,'false_positive',?,datetime('now'))";@(str.randhex(16);patternid;requestid)) {
    $ok:v true;
    $err:e false
  };
  <table && ok
};

(* The number of false-positive reports held against one pattern. -1 when the query fails,
   so "cannot tell" is never read as "no reports". *)
f=patternreportcount(patternid:str):i64{
  <mt db.one("SELECT COUNT(*) AS n FROM pii_feedback WHERE pattern_id=? AND verdict='false_positive'";@(patternid)) {
    $ok:r db.rowi64(r;"n");
    $err:e 0-1
  }
};

(* T12.1. Deletes every feedback row. The user's own local data, and part of what "delete
   everything" has to reach (X8.4). *)
f=clear(store:i64):bool{
  <mt db.exec("DELETE FROM feedback WHERE id<>?";@("")) {
    $ok:v true;
    $err:e false
  }
};

(* ── It marked only the FIRST id ───────────────────────────────────────────────────
   The loop body began with `<mt db.exec(...)`. `<` is a RETURN, so the first iteration returned
   out of the function and the `<$ok(0)` after the loop was unreachable. Measured: three ids in,
   **one** row with `submitted=1`, two still pending.

   Latent — nothing calls this today. It matters the day a reporter batches, because every entry
   after the first stays pending and is re-sent on the next run, forever.

   The result is matched and dropped rather than returned, and `$ok` is first (T-31). A failed
   UPDATE is logged, not propagated: `i64!$lokeerr` cannot carry a partial failure a caller could
   act on — the error side is a user-declared sum whose discriminant toke never reads (T-18) —
   and abandoning the loop on the first failure would leave the rest pending, which is the
   behaviour being fixed. So every id is attempted and the count of failures is reported. *)
f=marksubmitted(store:i64;ids:@str):i64!$lokeerr{
  let failed=mut.0;
  lp(let ii162=0;ii162<ids.len;ii162=ii162+1){
    let id=ids.get(ii162);
    let ok=mt db.exec("UPDATE feedback SET submitted=1 WHERE id=?";@(id)) {
      $ok:v true;
      $err:e false
    };
    if(ok){}el{
      failed=failed+1;
      log.warn(str.concat("failed to mark feedback submitted: ";id);"feedback";"system")
    }
  };
  if(failed>0){
    log.warn(
      str.concat(str.fromint(failed);str.concat(" of ";str.concat(str.fromint(ids.len);" feedback entries could not be marked submitted")));
      "feedback";
      "system"
    )
  }el{};
  log.debug(
    str.concat("marked ";str.concat(str.fromint(ids.len);" feedback entries submitted"));
    "feedback";
    "system"
  );
  <$ok(0)
};



f=formatsummary(summary:$feedbacksummary):str{
  let totals=str.fromint(summary.total);
  let pcts=str.concat(str.fromfloat(summary.thumbsuprate*100.0);"%");
  let downs=str.fromint(summary.thumbsdown);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("Feedback: ";totals);
            " total | ");
          pcts);
        " thumbs-up | ");
      downs);
    " thumbs-down")
};

m=core.feedback.store;

i=t:shared.types;
i=ft:core.feedback.types;
i=s:core.storage.db;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;


f=ensuretable(store:i64):void!$lokeerr{
  let sql="CREATE TABLE IF NOT EXISTS feedback (
  id TEXT PRIMARY KEY,
  rating TEXT NOT NULL,
  feature_area TEXT NOT NULL,
  request_id TEXT,
  model_id TEXT,
  use_case TEXT,
  risk_level TEXT,
  comment TEXT,
  submitted INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
)";
  mt db.execparams(store.conn;sql;@()) {
    $ok:v $ok(void);
    $err:e $err($storageerr("failed to create feedback table"))
  }
};


f=save(store:i64;entry:i64):void!$lokeerr{
  let ratings=ft.ratinglabel(entry.rating);
  let areas=ft.arealabel(entry.featurearea);
  mt db.execparams(
    store.conn;
    "INSERT INTO feedback (id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,submitted,created_at) VALUES (?,?,?,?,?,?,?,?,0,'now()')";
    @(
      entry.id;
      ratings;
      areas;
      entry.requestid;
      entry.modelid;
      entry.usecase;
      entry.risklevel;
      entry.comment
    )
  ) {
    $ok:v $ok(void);
    $err:e $err($storageerr(str.concat("failed to save feedback: ";entry.id)))
  }
};


f=buildsummary(rows:i64):i64{
  let total=rows.len;
  let thumbsupcount=mut.0;
  let thumbsdowncount=mut.0;
  lp(let ii57=0;ii57<rows.len;ii57=ii57+1){
    let row=rows.get(ii57);
    let r=json.str(row;"rating");
    if(str.eq(r;"thumbs_up")){
      thumbsupcount=thumbsupcount+1
    }el{
      if(str.eq(r;"thumbs_down")){
        thumbsdowncount=thumbsdowncount+1
      }el{};
    };

  };
  let rate=mut.0.0;
  if(total = 0){}el{
    rate=str.tofloat(str.fromint(thumbsupcount))/str.tofloat(str.fromint(total))
  };
  <$feedbacksummary{
    total:total;
    thumbsup:thumbsupcount;
    thumbsdown:thumbsdowncount;
    thumbsuprate:rate;
    topissues:@()
  }
};

f=getsummary(store:i64;days:u32):i64!$lokeerr{
  let dayss=str.fromint(days);
  let sql=str.concat(
    "SELECT rating FROM feedback WHERE created_at >= datetime('now','-";
    str.concat(dayss;" days')")
  );
  mt db.queryparams(store.conn;sql;@()) {
    $ok:rows $ok(buildsummary(rows));
    $err:e $err($storageerr("failed to query feedback summary"))
  }
};


f=buildpendingentries(rows:i64):@$feedbackentry{
  let entries=mut.@();
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let row=rows.get(ii);
    let ratings=json.str(row;"rating");
    let rating=mut.$neutral;
    if(str.eq(ratings;"thumbs_up")){
      rating=$thumbsup
    }el{
      if(str.eq(ratings;"thumbs_down")){
        rating=$thumbsdown
      }el{}
    };
    let areas=json.str(row;"feature_area");
    let area=mut.$other(areas);
    if(str.eq(areas;"Chat response")){
      area=$chatresponse
    }el{
      if(str.eq(areas;"Privacy detection")){
        area=$privacydetection
      }el{
        if(str.eq(areas;"Routing decision")){
          area=$routingdecision
        }el{
          if(str.eq(areas;"Governance warning")){
            area=$governancewarning
          }el{
            if(str.eq(areas;"Agent output")){
              area=$agentoutput
            }el{
              if(str.eq(areas;"Compression")){
                area=$compression
              }el{
                if(str.eq(areas;"Dashboard")){
                  area=$dashboard
                }el{}
              }
            }
          }
        }
      }
    };
    entries=entries.push($feedbackentry{
      id:json.str(row;"id");
      rating:rating;
      featurearea:area;
      requestid:json.str(row;"request_id");
      modelid:json.str(row;"model_id");
      usecase:json.str(row;"use_case");
      risklevel:json.str(row;"risk_level");
      comment:json.str(row;"comment");
      createdat:json.str(row;"created_at")
    })
  };
  <entries
};

f=pendingsubmission(store:i64):@$feedbackentry!$lokeerr{
  mt db.queryparams(
    store.conn;
    "SELECT id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,created_at FROM feedback WHERE submitted=0";
    @()
  ) {
    $ok:rows $ok(buildpendingentries(rows));
    $err:e $err($storageerr("failed to query pending feedback"))
  }
};


f=marksubmitted(store:i64;ids:@str):void!$lokeerr{
  lp(let ii162=0;ii162<ids.len;ii162=ii162+1){
    let id=ids.get(ii162);
    mt db.execparams(
      store.conn;
      "UPDATE feedback SET submitted=1 WHERE id=?";
      @(id)
    ) {
      $ok:v void;
      $err:e $err($storageerr(str.concat("failed to mark feedback submitted: ";id)))
    }

  };
  log.debug(
    str.concat("marked ";str.concat(str.fromint(ids.len);" feedback entries submitted"));
    "feedback";
    "system"
  );
  <$ok(void)
};



f=formatsummary(summary:i64):str{
  let totals=str.fromint(summary.total);
  let pct=summary.thumbsuprate*100.0;
  let pcts=str.concat(str.fromfloat(pct);"%");
  let downs=str.fromint(summary.thumbsdown);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("Feedback: ";totals);
            " total | ");
          pcts);
        " thumbs-up | ");
      downs);
    " thumbs-down")
};

m=core.feedback.store;




i=t:shared.types;
i=ft:core.feedback.types;
i=s:core.storage.db;
i=db:std.db;
i=str:std.str;
i=log:shared.log;


f=ensuretable(store:i64):void|$lokeerr{
  let sql="CREATE TABLE IF NOT EXISTS feedback (
  id TEXT PRIMARY KEY,
  rating TEXT NOT NULL,
  feature_area TEXT NOT NULL,
  request_id TEXT,
  model_id TEXT,
  use_case TEXT,
  risk_level TEXT,
  comment TEXT,
  submitted INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
)";
  mt db.execparams(store.conn;sql;@()) {
    $ok: <$ok(void);
    $err:e <$err($lokeerr.$storageerr("failed to create feedback table"))
  };
};


f=save(store:i64;entry:i64):void|$lokeerr{
  let ratings=ft.ratinglabel(entry.rating);
  let areas=ft.arealabel(entry.featurearea);
  mt db.execparams(
    store.conn;
    "INSERT INTO feedback (id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,submitted,created_at) VALUES (?,?,?,?,?,?,?,?,0,'now()')";
    @(
      entry.id;
      ratings;
      areas;
      entry.requestid;
      entry.modelid;
      entry.usecase;
      entry.risklevel;
      entry.comment
    )
  ) {
    $ok: {
      log.debug(
        str.concat("feedback saved: ";entry.id);
        "feedback";
        entry.requestid
      );
      <$ok(void)
    };
    $err:e <$err($lokeerr.$storageerr(str.concat("failed to save feedback: ";entry.id)))
  };
};


f=getsummary(store:i64;days:u32):i64|$lokeerr{
  let dayss=str.fromint(days);
  let sql=str.concat(
    "SELECT rating FROM feedback WHERE created_at >= datetime('now','-";
    str.concat(dayss;" days')")
  );
  mt db.queryparams(store.conn;sql;@()) {
    $ok:rows {
      let total=rows.len;
      let thumbsupcount=0;
      let thumbsdowncount=0;
      rows.each|row{
        let r=json.getstr(row;"rating");
        if(str.eq(r;"thumbs_up")){
          thumbsupcount=thumbsupcount+1
        }el{
          if(str.eq(r;"thumbs_down")){
            thumbsdowncount=thumbsdowncount+1
          }el{};
        };
      };
      let rate=if total = 0{
        0.0
      }el{
        str.tofloat(str.fromint(thumbsupcount))/str.tofloat(str.fromint(total))
      };
      <$ok($ft.feedbacksummary{
        total:total;
        thumbsup:thumbsupcount;
        thumbsdown:thumbsdowncount;
        thumbsuprate:rate;
        topissues:@()
      })
    };
    $err:e <$err($lokeerr.$storageerr("failed to query feedback summary"))
  };
};


f=pendingsubmission(store:i64):@($ft.feedbackentry)|$lokeerr{
  mt db.queryparams(
    store.conn;
    "SELECT id,rating,feature_area,request_id,model_id,use_case,risk_level,comment,created_at FROM feedback WHERE submitted=0";
    @()
  ) {
    $ok:rows {
      let entries=rows.map|row{
        let ratings=json.getstr(row;"rating");
        let rating=if str.eq(ratings;"thumbs_up"){
          $ft.feedbackrating.$thumbsup
        }el{
          if(str.eq(ratings;"thumbs_down")){
            $ft.feedbackrating.$thumbsdown
          }el{
            $ft.feedbackrating.$neutral
          };
        };
        let areas=json.getstr(row;"feature_area");
        let area=if str.eq(areas;"Chat response"){
          $ft.featurearea.$chatresponse
        }el{
          if(str.eq(areas;"Privacy detection")){
            $ft.featurearea.$privacydetection
          }el{
            if(str.eq(areas;"Routing decision")){
              $ft.featurearea.$routingdecision
            }el{
              if(str.eq(areas;"Governance warning")){
                $ft.featurearea.$governancewarning
              }el{
                if(str.eq(areas;"Agent output")){
                  $ft.featurearea.$agentoutput
                }el{
                  if(str.eq(areas;"Compression")){
                    $ft.featurearea.$compression
                  }el{
                    if(str.eq(areas;"Dashboard")){
                      $ft.featurearea.$dashboard
                    }el{
                      $ft.featurearea.$other(areas)
                    };
                  };
                };
              };
            };
          };
        };
        $ft.feedbackentry{
          id:json.getstr(row;"id");
          rating:rating;
          featurearea:area;
          requestid:json.getstr(row;"request_id");
          modelid:json.getstr(row;"model_id");
          usecase:json.getstr(row;"use_case");
          risklevel:json.getstr(row;"risk_level");
          comment:json.getstr(row;"comment");
          createdat:json.getstr(row;"created_at")
        };
      };
      <$ok(entries)
    };
    $err:e <$err($lokeerr.$storageerr("failed to query pending feedback"))
  };
};


f=marksubmitted(store:i64;ids:@str):void|$lokeerr{
  ids.each|id{
    mt db.execparams(
      store.conn;
      "UPDATE feedback SET submitted=1 WHERE id=?";
      @($id)
    ) {
      $ok: {};
      $err:e <$err($lokeerr.$storageerr(str.concat("failed to mark feedback submitted: ";id)))
    };
  };
  log.debug(
    str.concat("marked ";str.concat(str.fromint(ids.len);" feedback entries submitted"));
    "feedback";
    "system"
  );
  <$ok(void)
};



f=formatsummary(summary:i64):str{
  let totals=str.fromint(summary.total);
  let pct=summary.thumbsuprate*100.0;
  let pcts=str.concat(str.fromfloat(pct);"%");
  let downs=str.fromint(summary.thumbsdown);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("Feedback: ";totals);
            " total | ");
          pcts);
        " thumbs-up | ");
      downs);
    " thumbs-down")
};

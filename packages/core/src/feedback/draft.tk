m=core.feedback.draft;

i=str:std.str;
i=jx:shared.jsonobj;
i=log:shared.log;
i=reach:shared.reachability;

t=$draftcontext{
  requestid:str;
  userdescription:str;
  pipelinelogs:@str;
  modelused:str;
  provider:str;
  latencyms:i32;
  errorcode:str
};

t=$draftresult{
  title:str;
  body:str;
  labels:@str;
  severity:str;
  confidence:f64
};

f=builddraftprompt(ctx:$draftcontext):str{
  let logcount=ctx.pipelinelogs.len;
  let cappedlogs=mut.ctx.pipelinelogs;
  if(logcount > 50){
    cappedlogs=ctx.pipelinelogs.slice(0;50)
  }el{};
  let logsjoined=str.join("
";cappedlogs);
  let errorsection=mut."";
  if(str.len(ctx.errorcode) > 0){
    errorsection=str.concat("
Error code: ";ctx.errorcode)
  }el{};
  let prompt="You are helping draft a GitHub issue for the loke project.\n\n## User Description\n\(ctx.userdescription)\n\n## Pipeline Context\nModel: \(ctx.modelused)\nProvider: \(ctx.provider)\nLatency (ms): \(str.fromint(ctx.latencyms))\(errorsection)\n\n## Pipeline Logs (last 50 lines)\n```\n\(logsjoined)\n```\n\n## Instructions\n\\\nDraft a GitHub issue in JSON format with these exact fields:\n\\\n- \"title\": a concise title under 72 characters\n\\\n- \"body\": a markdown body with sections: Description, Steps to Reproduce, Expected Behaviour, Actual Behaviour\n\\\n- \"labels\": an array of relevant labels chosen only from [\"bug\",\"enhancement\",\"privacy\",\"performance\",\"ux\"]\n\\\n- \"severity\": one of [\"critical\",\"high\",\"medium\",\"low\"]\n\\\n- \"confidence\": a float between 0.0 and 1.0 reflecting your confidence in the draft\n\n\\\nRespond with only valid JSON, no extra text.\n";
  <prompt
};

f=parsedraftresponse(raw:str):$draftresult{
  let title=mut."Untitled issue";
  if(str.contains(raw;"\"title\"")){
    let after=str.slice(raw;str.indexof(raw;"\"title\"");str.len(raw));
    let colonpos=str.indexof(after;":");
    let valstart=str.indexof(str.slice(after;colonpos;str.len(after));"\"");
    let fromquote=str.slice(after;colonpos + valstart + 1;str.len(after));
    let endquote=str.indexof(fromquote;"\"");
    title=str.slice(fromquote;0;endquote)
  }el{};
  let body=mut."";
  if(str.contains(raw;"\"body\"")){
    let after=str.slice(raw;str.indexof(raw;"\"body\"");str.len(raw));
    let colonpos=str.indexof(after;":");
    let valstart=str.indexof(str.slice(after;colonpos;str.len(after));"\"");
    let fromquote=str.slice(after;colonpos + valstart + 1;str.len(after));
    let endquote=str.indexof(fromquote;"\"");
    body=str.slice(fromquote;0;endquote)
  }el{};
  let severity=mut."medium";
  if(str.contains(raw;"\"critical\"")){
    severity="critical"
  }el{
    if(str.contains(raw;"\"high\"")){
      severity="high"
    }el{
      if(str.contains(raw;"\"low\"")){
        severity="low"
      }el{}
    }
  };
  let labels=mut.@();
  if(str.contains(raw;"\"bug\"")){ labels=labels.push("bug") }el{};
  if(str.contains(raw;"\"enhancement\"")){ labels=labels.push("enhancement") }el{};
  if(str.contains(raw;"\"privacy\"")){ labels=labels.push("privacy") }el{};
  if(str.contains(raw;"\"performance\"")){ labels=labels.push("performance") }el{};
  if(str.contains(raw;"\"ux\"")){ labels=labels.push("ux") }el{};
  let confidence=mut.0.5;
  if(str.contains(raw;"\"confidence\"")){
    let after=str.slice(raw;str.indexof(raw;"\"confidence\"");str.len(raw));
    let colonpos=str.indexof(after;":");
    let valregion=str.slice(after;colonpos + 1;colonpos + 10);
    let trimmed=str.trim(valregion);
    confidence=str.tof64(trimmed)
  }el{};
  <$draftresult{
    title:title;
    body:body;
    labels:labels;
    severity:severity;
    confidence:confidence
  }
};

f=draftrespok(raw:str;requestid:str):$draftresult{
  log.info(
    str.concat("draft pipeline response received for request: ";requestid);
    "feedback.draft";
    requestid
  );
  <parsedraftresponse(raw)
};

f=draftrespfail(requestid:str;userdescription:str):$draftresult{
  log.warn(
    "draft pipeline request failed: no answer from /api/pipeline";
    "feedback.draft";
    requestid
  );
  <$draftresult{
    title:"Issue report (draft failed)";
    body:str.concat("## Description
";userdescription);
    labels:@("bug");
    severity:"medium";
    confidence:0.0
  }
};

(* VM1.6f. The request was `http.postheaders(http.client(url);"";...)`. The runtime reads
   postheaders' first argument as a URL string, so nothing was sent (T-48) and every draft
   came back "draft failed". reach.localpost sends it, to loke's own /api/pipeline, so the
   draft prompt goes through the privacy pipeline like any other request.

   localpost carries no headers, so the bearer token this used to build is not sent. loke's
   /api/pipeline reads no Authorization header, so it was never needed; `apikey` is kept
   only so draft's signature does not change. The prompt is escaped with jx.escape: it is
   multi-line, and json.enc escapes only quote and backslash. *)
f=draftat(ctx:$draftcontext;baseurl:str):$draftresult{
  let raw=reach.localpost(baseurl;"/api/pipeline";"{\"text\":\(jx.escape(builddraftprompt(ctx))),\"request_id\":\(jx.escape(ctx.requestid)),\"fallback_reason\":\"task_requires_prose\",\"fallback_selected_by\":\"user\"}");
  if(str.len(raw)==0){ <draftrespfail(ctx.requestid;ctx.userdescription) }el{};
  <draftrespok(raw;ctx.requestid)
};

f=draft(ctx:$draftcontext;apikey:str):$draftresult{
  <draftat(ctx;"http://127.0.0.1:11430")
};

f=formatpreview(draft:$draftresult):str{
  let labelline=str.concat("Labels: ";str.join(", ";draft.labels));
  let severityline=str.concat("Severity: ";draft.severity);
  let confidencepct=str.concat(
    str.fromint(str.toi32(str.fromf64(draft.confidence * 100.0)));
    "%"
  );
  let confidenceline=str.concat("Confidence: ";confidencepct);
  <"# \(draft.title)\n\n\(draft.body)\n\n---\n\(labelline)\n\(severityline)\n\(confidenceline)"
};

m=core.feedback.draft;

i=http:std.http;
i=str:std.str;
i=arr:std.arr;
i=log:shared.log;

t=$draftcontext{
  requestid:str;
  userdescription:str;
  pipelinelogs:@str;
  modelused:str;
  provider:str;
  latencyms:i32;
  errorcode:str
};

t=$draftresult{
  title:str;
  body:str;
  labels:@str;
  severity:str;
  confidence:f64
};

f=builddraftprompt(ctx:$draftcontext):str{
  let logcount=arr.len(ctx.pipelinelogs);
  let cappedlogs=mut.ctx.pipelinelogs;
  if(logcount > 50){
    cappedlogs=arr.slice(ctx.pipelinelogs;0;50)
  }el{};
  let logsjoined=arr.join(cappedlogs;"
");
  let errorsection=mut."";
  if(str.len(ctx.errorcode) > 0){
    errorsection=str.concat("
Error code: ";ctx.errorcode)
  }el{};
  let prompt=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(
                        "You are helping draft a GitHub issue for the loke project.

";
                        "## User Description
");
                      ctx.userdescription);
                    "

## Pipeline Context
");
                  str.concat("Model: ";ctx.modelused));
                str.concat("
Provider: ";ctx.provider));
              str.concat("
Latency (ms): ";str.fromint(ctx.latencyms)));
            errorsection);
          "

## Pipeline Logs (last 50 lines)
```
");
        logsjoined);
      "
```

");
    "## Instructions
\\
Draft a GitHub issue in JSON format with these exact fields:
\\
- \"title\": a concise title under 72 characters
\\
- \"body\": a markdown body with sections: Description, Steps to Reproduce, Expected Behaviour, Actual Behaviour
\\
- \"labels\": an array of relevant labels chosen only from [\"bug\",\"enhancement\",\"privacy\",\"performance\",\"ux\"]
\\
- \"severity\": one of [\"critical\",\"high\",\"medium\",\"low\"]
\\
- \"confidence\": a float between 0.0 and 1.0 reflecting your confidence in the draft

\\
Respond with only valid JSON, no extra text.
");
  <prompt
};

f=parsedraftresponse(raw:str):$draftresult{
  let title=mut."Untitled issue";
  if(str.contains(raw;"\"title\"")){
    let after=str.slice(raw;str.indexof(raw;"\"title\"");str.len(raw));
    let colonpos=str.indexof(after;":");
    let valstart=str.indexof(str.slice(after;colonpos;str.len(after));"\"");
    let fromquote=str.slice(after;colonpos + valstart + 1;str.len(after));
    let endquote=str.indexof(fromquote;"\"");
    title=str.slice(fromquote;0;endquote)
  }el{};
  let body=mut."";
  if(str.contains(raw;"\"body\"")){
    let after=str.slice(raw;str.indexof(raw;"\"body\"");str.len(raw));
    let colonpos=str.indexof(after;":");
    let valstart=str.indexof(str.slice(after;colonpos;str.len(after));"\"");
    let fromquote=str.slice(after;colonpos + valstart + 1;str.len(after));
    let endquote=str.indexof(fromquote;"\"");
    body=str.slice(fromquote;0;endquote)
  }el{};
  let severity=mut."medium";
  if(str.contains(raw;"\"critical\"")){
    severity="critical"
  }el{
    if(str.contains(raw;"\"high\"")){
      severity="high"
    }el{
      if(str.contains(raw;"\"low\"")){
        severity="low"
      }el{}
    }
  };
  let labels=mut.@();
  if(str.contains(raw;"\"bug\"")){ labels=arr.push(labels;"bug") }el{};
  if(str.contains(raw;"\"enhancement\"")){ labels=arr.push(labels;"enhancement") }el{};
  if(str.contains(raw;"\"privacy\"")){ labels=arr.push(labels;"privacy") }el{};
  if(str.contains(raw;"\"performance\"")){ labels=arr.push(labels;"performance") }el{};
  if(str.contains(raw;"\"ux\"")){ labels=arr.push(labels;"ux") }el{};
  let confidence=mut.0.5;
  if(str.contains(raw;"\"confidence\"")){
    let after=str.slice(raw;str.indexof(raw;"\"confidence\"");str.len(raw));
    let colonpos=str.indexof(after;":");
    let valregion=str.slice(after;colonpos + 1;colonpos + 10);
    let trimmed=str.trim(valregion);
    confidence=str.tof64(trimmed)
  }el{};
  <$draftresult{
    title:title;
    body:body;
    labels:labels;
    severity:severity;
    confidence:confidence
  }
};

f=draftrespok(r:i64;requestid:str):$draftresult{
  log.info(
    str.concat("draft pipeline response received for request: ";requestid);
    "feedback.draft";
    requestid
  );
  <parsedraftresponse(r.body)
};

f=draftrespfail(e:i64;requestid:str;userdescription:str):$draftresult{
  log.warn(
    str.concat("draft pipeline request failed: ";e.message);
    "feedback.draft";
    requestid
  );
  <$draftresult{
    title:"Issue report (draft failed)";
    body:str.concat("## Description
";userdescription);
    labels:@("bug");
    severity:"medium";
    confidence:0.0
  }
};

f=draft(ctx:$draftcontext;apikey:str):$draftresult{
  let prompt=builddraftprompt(ctx);
  let payload=str.concat(
    str.concat(
      str.concat(
        str.concat(
          "{\"prompt\":\"";
          str.escapejson(prompt));
        "\",\"request_id\":\"");
      ctx.requestid);
    "\"}");
  let resp=http.post(
    "http://127.0.0.1:11430/api/pipeline";
    payload;
    @(
      http.header("Content-Type";"application/json");
      http.header("Authorization";str.concat("Bearer ";apikey))
    )
  );
  mt resp {
    $ok:r draftrespok(r;ctx.requestid);
    $err:e draftrespfail(e;ctx.requestid;ctx.userdescription)
  }
};

f=formatpreview(draft:$draftresult):str{
  let labelline=str.concat("Labels: ";arr.join(draft.labels;", "));
  let severityline=str.concat("Severity: ";draft.severity);
  let confidencepct=str.concat(
    str.fromint(str.toi32(str.fromf64(draft.confidence * 100.0)));
    "%"
  );
  let confidenceline=str.concat("Confidence: ";confidencepct);
  let divider="---";
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat("# ";draft.title);
                      "

");
                    draft.body);
                  "

");
                divider);
              "
");
            labelline);
          "
");
        severityline);
      "
");
    confidenceline)
};

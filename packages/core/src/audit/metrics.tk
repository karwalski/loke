m=core.audit.metrics;

i=t:shared.types;
i=db:std.db;
i=str:std.str;

t=$metricsummary{
  tokenssaved:u64;
  costsavedusd:f64;
  cachehitrate:f64;
  entitiesredacted:u64;
  totalrequests:u64;
  localratio:f64
};

t=$providermetric{
  provider:str;
  requests:u64;
  tokensin:u64;
  tokensout:u64;
  costusd:f64
};

t=$tokensavingspoint{
  date:str;
  tokenssaved:u64;
  costsaved:f64
};

t=$cacheinfo{
  totalentries:u64;
  hits:u64;
  misses:u64;
  avgsimilarity:f64
};

f=summary(store:i64;period:str):$metricsummary!$lokeerr{
  <$ok($metricsummary{
    tokenssaved:0;
    costsavedusd:0.0;
    cachehitrate:0.0;
    entitiesredacted:0;
    totalrequests:0;
    localratio:0.0
  })
};

f=emptysummary():$metricsummary{
  <$metricsummary{
    tokenssaved:0;
    costsavedusd:0.0;
    cachehitrate:0.0;
    entitiesredacted:0;
    totalrequests:0;
    localratio:0.0
  }
};

f=byprovider(store:i64;period:str):@$providermetric!$lokeerr{
  <$ok(@())
};

f=tokensavingsseries(store:i64;period:str):@$tokensavingspoint!$lokeerr{
  <$ok(@())
};

f=cachestats(store:i64):$cacheinfo!$lokeerr{
  <$ok($cacheinfo{
    totalentries:0;
    hits:0;
    misses:0;
    avgsimilarity:0.0
  })
};

f=emptycachestats():$cacheinfo{
  <$cacheinfo{
    totalentries:0;
    hits:0;
    misses:0;
    avgsimilarity:0.0
  }
};

f=export(store:i64;period:str;format:str):str!$lokeerr{
  <$ok("")
};

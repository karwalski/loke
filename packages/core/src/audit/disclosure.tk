m=core.audit.disclosure;

i=str:std.str;
i=db:std.db;
i=audit:core.storage.audit;

(* DA1.7 - the disclosure record, one row per external dispatch, in disclosure_log (migration
   31). docs/specifications/disclosure-accounting.md section 5 defines the fields and section
   4 the two-phase write this module implements:

     reserve   immediately before the body is handed to transport. Everything about what is
               being sent. state = dispatched
     complete  once the provider has answered or failed. state = completed or failed

   A dispatch whose reserve write fails must not happen. `reserve` returns a bool for that
   reason, and the caller refuses the request on false: an unrecorded dispatch is the one
   thing this table exists to rule out. Both return bools, not results, because a caller
   matching a user-sum result always takes the first arm (T-18).

   What is NOT here yet, and is recorded as open against DA1.7 rather than filled with a
   guess:
     - on the redact-and-forward path custody is passed in, not observed. The spec requires
       it computed from the payload (C1), which needs NC1.2's sentinel check. There the honest
       value is redacted-data with custody_check = not_run, and that is what callers pass. The
       no-custody row (NC1.12, reservenocustody below) is the observed one: its class is read
       off the sentinel check run on the body about to be sent
     - tokens_estimated and tokeniser_id stay NULL: no tokeniser runs before dispatch.
       tokens_source is set to provider_reported by `complete` only when the provider
       reported a count, and is otherwise left NULL rather than labelled an estimate
     - bytes_headers is NULL: neither transport this tree uses reports the octets it puts
       on the wire. http.posturl takes no headers at all, and http.postheaders is given a
       JSON map that std.http serialises, adding Host and Content-Length itself. Counting
       the map would be a guess at the wire form, which C1 rules out (DA1.9)
     - model_version is what the caller measured, and `unknown` when it measured nothing.
       For a local dispatch that is the digest Ollama reports for the installed model. A
       cloud model id is a name the provider resolves after transport, so it is not a
       version, and the id is no longer copied into this column as if it were (DA1.9)
     - jurisdiction is NULL and retention_class is `unknown`: no provider registry exists,
       and the spec forbids filling either from assumption (U5, findings section 8 item 8) *)

f=boolint(b:bool):str{
  if(b){ <"1" }el{ <"0" }
};

(* redacted-data and raw carry values drawn from the data by definition (spec 3.1). Only
   no-custody asserts there are none, and only a passed sentinel check can assert that. *)
f=realvaluesincluded(custody:str;check:str):bool{
  if(str.eq(custody;"no-custody") && str.eq(check;"sentinel_pass")){ <false }el{};
  <true
};

(* The reserve facts are parameters, not a struct. A record type here is imported into
   page.api.pipeline, which already sees 64 struct types, and toke caps a compilation unit at
   64 (TKC_MAX_STRUCT_TYPES). The 65th silently displaced std.http's $httpresp, and the error
   reported was an ambiguous field `body` (T-54). *)
(* NC1.8 - spec section 3.3. The redact-and-forward path is a fallback, and taking it is a
   recorded decision: every redacted-data row names why (a closed vocabulary) and who chose it,
   `user` or `policy`. There is deliberately no `default`. *)
f=fallbackreasonvalid(reason:str):bool{
  <str.eq(reason;"task_requires_prose") || str.eq(reason;"artifact_inexpressible") || str.eq(reason;"user_choice") || str.eq(reason;"policy_directed")
};

f=fallbackselectorvalid(by:str):bool{
  <str.eq(by;"user") || str.eq(by;"policy")
};

(* A redacted-data dispatch without a valid selection is refused here, at the reserve, so no
   caller can reach transport around it: a failed reserve is a dispatch that does not happen. A
   no-custody row carries no fallback and stores NULL for both. *)
f=fallbackadmissible(custody:str;reason:str;by:str):bool{
  if(str.eq(custody;"redacted-data")==false){ <true };
  <fallbackreasonvalid(reason) && fallbackselectorvalid(by)
};

f=orsqlnull(custody:str;v:str):str{
  if(str.eq(custody;"redacted-data")){ <v };
  <""
};

(* model_version is NOT NULL, so a version nobody measured is recorded as `unknown`, never
   as the model id. *)
f=versionor(v:str):str{
  if(str.len(v)==0){ <"unknown" };
  <v
};

(* DA1.9 (4) - session_id. The browser endpoint had no session and wrote `none`. A caller
   that has one now names it, as POST /api/artifact's callers do (NC1.10), and it is recorded
   as given: the id joins turns and asserts nothing about custody (C1). A request without one
   is still recorded as `none`, so `none` is reserved and a caller may not send it. The id is
   stored in the record, so it is held to a short identifier alphabet (letters, digits, `-`,
   `_`, `.`, `:`, at most 64 characters), which keeps free text, and an address or a name
   with it, out of the column. loke does not issue the id yet (NC1.13). *)
f=nosession():str{ <"none" };

f=sessionchar(c:i64):bool{
  <(c>=48 && c<=58) || (c>=65 && c<=90) || (c>=97 && c<=122) || c==45 || c==46 || c==95
};

f=sessionidvalid(s:str):bool{
  let n=str.len(s);
  if(n==0 || n>64 || str.eq(s;nosession())){ <false };
  let ok=mut.true;
  lp(let i=0;i<n;i=i+1){
    if(sessionchar(str.charat(s;i))==false){ ok=false }el{}
  };
  <ok
};

(* The reserve without an audit row and without a measured model version, as DA1.7 wrote
   it. The request path uses reserveaudited. *)
f=reserve(correlationid:str;requestid:str;sessionid:str;provider:str;providerclass:str;modelid:str;endpointhost:str;bodybytes:i64;questionbytes:i64;entitytypes:str;entitiestotal:i64;detectionlayers:str;custody:str;custodycheck:str;fallbackreason:str;fallbackby:str):bool{
  <insertreserve($auditevent{eventtype:"";usecase:"";modelid:modelid;provider:provider;sensitivity:"";risktier:"";tokensin:0;tokensout:0;costusd:0.0;durationms:0 as u32;correlationid:correlationid};requestid;sessionid;providerclass;"";endpointhost;bodybytes;questionbytes;entitytypes;entitiestotal;detectionlayers;custody;custodycheck;fallbackreason;fallbackby)
};

(* The row's correlation id, provider and model are read from the audit event, so the
   disclosure row and its audit row cannot disagree on them. That also keeps every call at
   sixteen arguments or fewer: at this toolchain pin a call with a seventeenth argument is
   miscompiled, its first argument emitted as an undefined value (TKC_MAX_PARAMS, measured
   by DA1.9 and filed with T-53). *)
f=insertreserve(ev:$auditevent;requestid:str;sessionid:str;providerclass:str;modelversion:str;endpointhost:str;bodybytes:i64;questionbytes:i64;entitytypes:str;entitiestotal:i64;detectionlayers:str;custody:str;custodycheck:str;fallbackreason:str;fallbackby:str):bool{
  if(fallbackadmissible(custody;fallbackreason;fallbackby)==false){ <false };
  let correlationid=ev.correlationid;
  let provider=ev.provider;
  let modelid=ev.modelid;
  let sql="INSERT INTO disclosure_log (record_id,correlation_id,request_id,session_id,parent_record_id,occurred_at,state,dispatch_kind,pipeline_disabled,provider,provider_class,model_id,model_version,endpoint_host,jurisdiction,retention_class,bytes_body,bytes_headers,bytes_schema_profile,bytes_question,bytes_other,tokens_estimated,tokeniser_id,tokens_source,custody,custody_check,fallback_reason,fallback_selected_by,datasets_disclosed,fields_disclosed,fields_disclosed_count,field_types_disclosed,cardinality_disclosed,row_count_disclosed,entity_types,entities_total,detection_layers,real_values_included,real_value_count,sample_values_included,aggregates_included,qi_combination_present,qi_combination_fields) VALUES (?,?,?,?,NULL,?,'dispatched','initial',0,?,?,?,?,?,NULL,'unknown',CAST(? AS INTEGER),NULL,0,CAST(? AS INTEGER),CAST(? AS INTEGER),NULL,NULL,NULL,?,?,NULLIF(?,''),NULLIF(?,''),'','',0,'',0,0,?,CAST(? AS INTEGER),?,CAST(? AS INTEGER),NULL,0,0,NULL,'')";
  <mt db.exec(sql;@(str.randhex(16);correlationid;requestid;sessionid;str.nowiso8601();provider;providerclass;modelid;versionor(modelversion);endpointhost;str.fromint(bodybytes);str.fromint(questionbytes);str.fromint(bodybytes-questionbytes);custody;custodycheck;orsqlnull(custody;fallbackreason);orsqlnull(custody;fallbackby);entitytypes;str.fromint(entitiestotal);detectionlayers;boolint(realvaluesincluded(custody;custodycheck)))) {
    $ok:v true;
    $err:e false
  }
};

f=changedrows():i64{
  <mt db.one("SELECT changes() AS n";@()) {
    $ok:r db.rowi64(r;"n");
    $err:e 0
  }
};

(* Only a row still in `dispatched` is completed, so a record's outcome is written once and a
   second completion for the same correlation id changes nothing and returns false. `ok`
   selects completed/ok or failed/provider_error. A token count of 0 is what the provider
   did not report, so it is stored as NULL, not as a measured zero. *)
f=complete(correlationid:str;ok:bool;responsebytes:i64;tokensin:i64;tokensout:i64;durationms:i64):bool{
  let st=mut."failed";
  let oc=mut."provider_error";
  if(ok){ st="completed"; oc="ok" }el{};
  let reported=tokensin>0 || tokensout>0;
  let src=mut."";
  if(reported){ src="provider_reported" }el{};
  let sql="UPDATE disclosure_log SET state=?, outcome=?, response_bytes=CAST(? AS INTEGER), tokens_in_reported=CAST(NULLIF(?,'') AS INTEGER), tokens_out_reported=CAST(NULLIF(?,'') AS INTEGER), tokens_source=NULLIF(?,''), duration_ms=CAST(? AS INTEGER) WHERE correlation_id=? AND state='dispatched'";
  let tin=mut."";
  let tout=mut."";
  if(reported){ tin=str.fromint(tokensin); tout=str.fromint(tokensout) }el{};
  let written=mt db.exec(sql;@(st;oc;str.fromint(responsebytes);tin;tout;src;str.fromint(durationms);correlationid)) {
    $ok:v true;
    $err:e false
  };
  if(written){ <changedrows()==1 }el{ <false }
};

(* ── DA1.9 (2): one transaction with audit_log (spec P2) ──────────────────────────────
   The reserve used to be written before transport and the audit row only after the
   response, so a crash, a kill or a hung provider between the two left a disclosure with no
   audit row at all, and the audit trail silently understated what had been sent. The fix
   gives the dispatch its own audit row, `llm_dispatch`, written in the SAME transaction as
   the reserve and before transport: both rows exist, or neither does and nothing is sent.
   That row is the one the spec's one-to-one join and G1 refer to. The outcome row
   (`llm_request`, `llm_request_failed`) still follows the response, now in one transaction
   with the completion, so a completed disclosure always has its outcome in the trail.

   BEGIN IMMEDIATE, not a deferred BEGIN: the audit insert reads the chain's tail and then
   writes after it, and each server worker is a separate process with its own connection.
   Taking the write lock first means no other worker can append between that read and the
   write. If the lock cannot be taken, the reserve fails and the dispatch does not happen.
   std.db has one connection per process, so these statements are on the same connection
   as every other write; measured to roll back in tests/unit/audit/test_disclosure_tx.tk. *)
f=sqlok(sql:str):bool{
  <mt db.exec(sql;@()) {
    $ok:v true;
    $err:e false
  }
};

(* Commits when both writes succeeded, and otherwise rolls back. False unless committed. *)
f=endtx(bothwritten:bool):bool{
  if(bothwritten){
    if(sqlok("COMMIT")){ <true }el{}
  }el{};
  sqlok("ROLLBACK");
  <false
};

(* `ev` is the dispatch's audit row, and names the correlation id, provider and model the
   disclosure row is written with. *)
f=reserveaudited(ev:$auditevent;requestid:str;sessionid:str;providerclass:str;modelversion:str;endpointhost:str;bodybytes:i64;questionbytes:i64;entitytypes:str;entitiestotal:i64;detectionlayers:str;custody:str;custodycheck:str;fallbackreason:str;fallbackby:str;store:i64):bool{
  if(sqlok("BEGIN IMMEDIATE")==false){ <false };
  let reserved=insertreserve(ev;requestid;sessionid;providerclass;modelversion;endpointhost;bodybytes;questionbytes;entitytypes;entitiestotal;detectionlayers;custody;custodycheck;fallbackreason;fallbackby);
  let audited=mut.false;
  if(reserved){ audited=audit.insertevent(store;ev) }el{};
  <endtx(reserved && audited)
};

(* The outcome. The audit row is what must not be lost, so it commits even when the
   completion changed nothing (a row already swept to abandoned, say), and the return says
   whether the disclosure row was completed. If the audit row cannot be written, the
   completion is rolled back with it: the row stays `dispatched`, is later swept to
   `abandoned`, and so reads as an outcome unknown, which is what the trail then holds. *)
f=completeaudited(correlationid:str;ok:bool;responsebytes:i64;tokensin:i64;tokensout:i64;durationms:i64;store:i64;ev:$auditevent):bool{
  if(sqlok("BEGIN IMMEDIATE")==false){ <false };
  if(complete(correlationid;ok;responsebytes;tokensin;tokensout;durationms)){
    <endtx(audit.insertevent(store;ev))
  }el{};
  endtx(audit.insertevent(store;ev));
  <false
};


(* DA1.9 (1) - spec L2 and L4. A row still `dispatched` after the request timeout is swept to
   `abandoned`, with outcome `timeout`. It is not deleted: an incomplete record is evidence of
   a dispatch whose outcome is unknown, which is more useful than no record. Returns the
   number swept, or -1 if the sweep could not run. *)
f=sweepabandoned(timeoutseconds:i64):i64{
  let ok=mt db.exec("UPDATE disclosure_log SET state='abandoned', outcome='timeout' WHERE state='dispatched' AND julianday(occurred_at) < julianday('now', ?)";@("-\(timeoutseconds) seconds")) {
    $ok:v true;
    $err:e false
  };
  if(ok){ <changedrows() }el{ <0-1 }
};

(* L4: the abandoned count is reported. A rising count means the accounting is losing
   outcomes, and a lossy accounting understates disclosure. -1 if it cannot be read. *)
f=abandonedcount():i64{
  <mt db.one("SELECT COUNT() AS n FROM disclosure_log WHERE state=?";@("abandoned")) {
    $ok:r db.rowi64(r;"n");
    $err:e 0-1
  }
};

(* DA1.5 - totals for the savings view, as integers rather than a record so that importing
   them adds no struct type (T-54). `class` is a provider_class ("local", "cloud") or "" for
   every class. Abandoned dispatches are counted: their bytes were sent. -1 if unreadable. *)
f=scalar(sql:str;pclass:str):i64{
  <mt db.one(sql;@(pclass;pclass)) {
    $ok:r db.rowi64(r;"n");
    $err:e 0-1
  }
};

f=dispatchcount(pclass:str):i64{
  <scalar("SELECT COUNT() AS n FROM disclosure_log WHERE (?='' OR provider_class=?)";pclass)
};

f=bytessent(pclass:str):i64{
  <scalar("SELECT COALESCE(SUM(bytes_body),0) AS n FROM disclosure_log WHERE (?='' OR provider_class=?)";pclass)
};

(* DA1.5 - one dispatch's body size, for the per-request view. -1 if there is no record. *)
f=sentbytes(correlationid:str):i64{
  <mt db.one("SELECT bytes_body AS n FROM disclosure_log WHERE correlation_id=?";@(correlationid)) {
    $ok:r db.rowi64(r;"n");
    $err:e 0-1
  }
};

(* ── NC1.12: the no-custody record ─────────────────────────────────────────────────
   Spec 3.2. Custody here is not a parameter. The caller hands over the outcome of the C2
   sentinel check it ran on the body it is about to send, and the class is read off that:

     sentinel_pass  no-custody   the body is sent, and this row is its reserve
     sentinel_fail  raw          a value drawn from the data, untransformed, was in the body
     anything else  unknown      the check could not run (C3)

   Only a pass is a dispatch. A fail or an unknown is a refusal, and the row says so: state
   `failed`, outcome `rejected_locally`, and every volume 0, because nothing was handed to
   transport and bytes_body counts only what was (spec 5.3, 5.7 C1). Writing the would-be
   body's size there would count bytes that never left in every bytes-sent total. *)
f=custodyof(check:str):str{
  if(str.eq(check;"sentinel_pass")){ <"no-custody" };
  if(str.eq(check;"sentinel_fail")){ <"raw" };
  <"unknown"
};

f=checkof(check:str):str{
  if(str.eq(check;"sentinel_pass") || str.eq(check;"sentinel_fail")){ <check };
  <"not_run"
};

f=orzero(keep:bool;n:i64):str{
  if(keep){ <str.fromint(n) };
  <"0"
};

(* `valuecount` is how many of the dataset's values the check found in the body: 0 on a
   pass, and NULL when the check did not run, since then nothing was counted. The profile
   flags are C4's reading of a caller-built profile, which loke cannot take apart: a profile
   that reached the body is taken to carry cardinality and a row count. sample_values_included
   and aggregates_included are not observed by the check (a mean is not a cell), so a pass
   writes 0 for them and a refusal writes the more disclosing 1. *)
f=insertnocustody(ev:$auditevent;requestid:str;sessionid:str;modelversion:str;endpointhost:str;bodybytes:i64;profilebytes:i64;questionbytes:i64;datasetsjson:str;fieldsjson:str;fieldcount:i64;check:str;valuecount:i64):bool{
  let chk=checkof(check);
  let custody=custodyof(chk);
  let pass=str.eq(chk;"sentinel_pass");
  let st=mut."failed";
  let oc=mut."rejected_locally";
  if(pass){ st="dispatched"; oc="" }el{};
  let counted=mut."";
  if(str.eq(chk;"not_run")==false){ counted=str.fromint(valuecount) }el{};
  let real=realvaluesincluded(custody;chk);
  let profiled=pass && profilebytes>0;
  let ds=mut."[]";
  let fs=mut."[]";
  let fc=mut.0;
  if(pass){ ds=datasetsjson; fs=fieldsjson; fc=fieldcount }el{};
  let sql="INSERT INTO disclosure_log (record_id,correlation_id,request_id,session_id,parent_record_id,occurred_at,state,dispatch_kind,pipeline_disabled,provider,provider_class,model_id,model_version,endpoint_host,jurisdiction,retention_class,bytes_body,bytes_headers,bytes_schema_profile,bytes_question,bytes_other,tokens_estimated,tokeniser_id,tokens_source,custody,custody_check,fallback_reason,fallback_selected_by,datasets_disclosed,fields_disclosed,fields_disclosed_count,field_types_disclosed,cardinality_disclosed,row_count_disclosed,entity_types,entities_total,detection_layers,real_values_included,real_value_count,sample_values_included,aggregates_included,qi_combination_present,qi_combination_fields,outcome) VALUES (?,?,?,?,NULL,?,?,'initial',0,?,'local',?,?,?,NULL,'unknown',CAST(? AS INTEGER),NULL,CAST(? AS INTEGER),CAST(? AS INTEGER),CAST(? AS INTEGER),NULL,NULL,NULL,?,?,NULL,NULL,?,?,CAST(? AS INTEGER),'',CAST(? AS INTEGER),CAST(? AS INTEGER),'',0,'',CAST(? AS INTEGER),CAST(NULLIF(?,'') AS INTEGER),CAST(? AS INTEGER),CAST(? AS INTEGER),NULL,'',NULLIF(?,''))";
  let body=orzero(pass;bodybytes);
  let prof=orzero(pass;profilebytes);
  let ques=orzero(pass;questionbytes);
  let other=orzero(pass;bodybytes-profilebytes-questionbytes);
  let flag=boolint(profiled);
  let realflag=boolint(real);
  <mt db.exec(sql;@(str.randhex(16);ev.correlationid;requestid;sessionid;str.nowiso8601();st;ev.provider;ev.modelid;versionor(modelversion);endpointhost;body;prof;ques;other;custody;chk;ds;fs;str.fromint(fc);flag;flag;realflag;counted;realflag;realflag;oc)) {
    $ok:v true;
    $err:e false
  }
};

(* The row and its audit row in one transaction, as reserveaudited does (DA1.9, spec P2).
   `ev` is `llm_dispatch` for a pass and `llm_request_refused` for a refusal. False means
   neither row exists, and a pass that is not recorded must not be sent (spec L1). *)
f=reservenocustody(ev:$auditevent;requestid:str;sessionid:str;modelversion:str;endpointhost:str;bodybytes:i64;profilebytes:i64;questionbytes:i64;datasetsjson:str;fieldsjson:str;fieldcount:i64;check:str;valuecount:i64;store:i64):bool{
  if(sqlok("BEGIN IMMEDIATE")==false){ <false };
  let reserved=insertnocustody(ev;requestid;sessionid;modelversion;endpointhost;bodybytes;profilebytes;questionbytes;datasetsjson;fieldsjson;fieldcount;check;valuecount);
  let audited=mut.false;
  if(reserved){ audited=audit.insertevent(store;ev) }el{};
  <endtx(reserved && audited)
}

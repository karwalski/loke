m=core.audit.disclosure;

i=str:std.str;
i=db:std.db;

(* DA1.7 - the disclosure record, one row per external dispatch, in disclosure_log (migration
   31). docs/specifications/disclosure-accounting.md section 5 defines the fields and section
   4 the two-phase write this module implements:

     reserve   immediately before the body is handed to transport. Everything about what is
               being sent. state = dispatched
     complete  once the provider has answered or failed. state = completed or failed

   A dispatch whose reserve write fails must not happen. `reserve` returns a bool for that
   reason, and the caller refuses the request on false: an unrecorded dispatch is the one
   thing this table exists to rule out. Both return bools, not results, because a caller
   matching a user-sum result always takes the first arm (T-18).

   What is NOT here yet, and is recorded as open against DA1.7 rather than filled with a
   guess:
     - custody is passed in, not observed. The spec requires it computed from the payload
       (C1), which needs NC1.2's sentinel check. On the redact-and-forward path the honest
       value is redacted-data with custody_check = not_run, and that is what callers pass
     - tokens_estimated and tokeniser_id stay NULL: no tokeniser runs before dispatch.
       tokens_source is set to provider_reported by `complete` only when the provider
       reported a count, and is otherwise left NULL rather than labelled an estimate
     - bytes_headers is NULL: the transports this tree uses do not report the octets they
       put on the wire
     - model_version is the model id: nothing pins a version yet (VM1.2)
     - the abandoned sweep (L2), jurisdiction and retention (U5) *)

f=boolint(b:bool):str{
  if(b){ <"1" }el{ <"0" }
};

(* redacted-data and raw carry values drawn from the data by definition (spec 3.1). Only
   no-custody asserts there are none, and only a passed sentinel check can assert that. *)
f=realvaluesincluded(custody:str;check:str):bool{
  if(str.eq(custody;"no-custody") && str.eq(check;"sentinel_pass")){ <false }el{};
  <true
};

(* The fourteen reserve facts are parameters, not a struct. A record type here is imported into
   page.api.pipeline, which already sees 64 struct types, and toke caps a compilation unit at
   64 (TKC_MAX_STRUCT_TYPES). The 65th silently displaced std.http's $httpresp, and the error
   reported was an ambiguous field `body` (T-54). *)
f=reserve(correlationid:str;requestid:str;sessionid:str;provider:str;providerclass:str;modelid:str;endpointhost:str;bodybytes:i64;questionbytes:i64;entitytypes:str;entitiestotal:i64;detectionlayers:str;custody:str;custodycheck:str):bool{
  let sql="INSERT INTO disclosure_log (record_id,correlation_id,request_id,session_id,parent_record_id,occurred_at,state,dispatch_kind,pipeline_disabled,provider,provider_class,model_id,model_version,endpoint_host,jurisdiction,retention_class,bytes_body,bytes_headers,bytes_schema_profile,bytes_question,bytes_other,tokens_estimated,tokeniser_id,tokens_source,custody,custody_check,datasets_disclosed,fields_disclosed,fields_disclosed_count,field_types_disclosed,cardinality_disclosed,row_count_disclosed,entity_types,entities_total,detection_layers,real_values_included,real_value_count,sample_values_included,aggregates_included,qi_combination_present,qi_combination_fields) VALUES (?,?,?,?,NULL,?,'dispatched','initial',0,?,?,?,?,?,NULL,'unknown',CAST(? AS INTEGER),NULL,0,CAST(? AS INTEGER),CAST(? AS INTEGER),NULL,NULL,NULL,?,?,'','',0,'',0,0,?,CAST(? AS INTEGER),?,CAST(? AS INTEGER),NULL,0,0,NULL,'')";
  let other=bodybytes-questionbytes;
  <mt db.exec(sql;@(str.randhex(16);correlationid;requestid;sessionid;str.nowiso8601();provider;providerclass;modelid;modelid;endpointhost;str.fromint(bodybytes);str.fromint(questionbytes);str.fromint(other);custody;custodycheck;entitytypes;str.fromint(entitiestotal);detectionlayers;boolint(realvaluesincluded(custody;custodycheck)))) {
    $ok:v true;
    $err:e false
  }
};

f=changedrows():i64{
  <mt db.one("SELECT changes() AS n";@()) {
    $ok:r db.rowi64(r;"n");
    $err:e 0
  }
};

(* Only a row still in `dispatched` is completed, so a record's outcome is written once and a
   second completion for the same correlation id changes nothing and returns false. `ok`
   selects completed/ok or failed/provider_error. A token count of 0 is what the provider
   did not report, so it is stored as NULL, not as a measured zero. *)
f=complete(correlationid:str;ok:bool;responsebytes:i64;tokensin:i64;tokensout:i64;durationms:i64):bool{
  let st=mut."failed";
  let oc=mut."provider_error";
  if(ok){ st="completed"; oc="ok" }el{};
  let reported=tokensin>0 || tokensout>0;
  let src=mut."";
  if(reported){ src="provider_reported" }el{};
  let sql="UPDATE disclosure_log SET state=?, outcome=?, response_bytes=CAST(? AS INTEGER), tokens_in_reported=CAST(NULLIF(?,'') AS INTEGER), tokens_out_reported=CAST(NULLIF(?,'') AS INTEGER), tokens_source=NULLIF(?,''), duration_ms=CAST(? AS INTEGER) WHERE correlation_id=? AND state='dispatched'";
  let tin=mut."";
  let tout=mut."";
  if(reported){ tin=str.fromint(tokensin); tout=str.fromint(tokensout) }el{};
  let written=mt db.exec(sql;@(st;oc;str.fromint(responsebytes);tin;tout;src;str.fromint(durationms);correlationid)) {
    $ok:v true;
    $err:e false
  };
  if(written){ <changedrows()==1 }el{ <false }
};


(* DA1.9 (1) - spec L2 and L4. A row still `dispatched` after the request timeout is swept to
   `abandoned`, with outcome `timeout`. It is not deleted: an incomplete record is evidence of
   a dispatch whose outcome is unknown, which is more useful than no record. Returns the
   number swept, or -1 if the sweep could not run. *)
f=sweepabandoned(timeoutseconds:i64):i64{
  let sql="UPDATE disclosure_log SET state='abandoned', outcome='timeout' WHERE state='dispatched' AND julianday(occurred_at) < julianday('now', ?)";
  let ok=mt db.exec(sql;@(str.concat("-";str.concat(str.fromint(timeoutseconds);" seconds")))) {
    $ok:v true;
    $err:e false
  };
  if(ok){ <changedrows() }el{ <0-1 }
};

(* L4: the abandoned count is reported. A rising count means the accounting is losing
   outcomes, and a lossy accounting understates disclosure. -1 if it cannot be read. *)
f=abandonedcount():i64{
  <mt db.one("SELECT COUNT() AS n FROM disclosure_log WHERE state=?";@("abandoned")) {
    $ok:r db.rowi64(r;"n");
    $err:e 0-1
  }
};

(* DA1.5 - totals for the savings view, as integers rather than a record so that importing
   them adds no struct type (T-54). `class` is a provider_class ("local", "cloud") or "" for
   every class. Abandoned dispatches are counted: their bytes were sent. -1 if unreadable. *)
f=scalar(sql:str;pclass:str):i64{
  <mt db.one(sql;@(pclass;pclass)) {
    $ok:r db.rowi64(r;"n");
    $err:e 0-1
  }
};

f=dispatchcount(pclass:str):i64{
  <scalar("SELECT COUNT() AS n FROM disclosure_log WHERE (?='' OR provider_class=?)";pclass)
};

f=bytessent(pclass:str):i64{
  <scalar("SELECT COALESCE(SUM(bytes_body),0) AS n FROM disclosure_log WHERE (?='' OR provider_class=?)";pclass)
};

(* DA1.5 - one dispatch's body size, for the per-request view. -1 if there is no record. *)
f=sentbytes(correlationid:str):i64{
  <mt db.one("SELECT bytes_body AS n FROM disclosure_log WHERE correlation_id=?";@(correlationid)) {
    $ok:r db.rowi64(r;"n");
    $err:e 0-1
  }
}

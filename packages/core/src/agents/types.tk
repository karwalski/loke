m=core.agents.types;



i=t:shared.types;
i=str:std.str;

t=$triggertype{
  $manual:i64;
  $schedule:str;
  $filechange:str;
  $webhook:str;
  $mcpevent:str
};

t=$agentpermission{
  $readfile:str;
  $writefile:str;
  $mcptool:str;
  $httpget:str;
  $model:str
};

t=$agentdef{
  id:str;
  name:str;
  description:str;
  schedule:str;
  trigger:$triggertype;
  modelpreference:str;
  latencytolerance:i64;
  risklevel:str;
  permissions:@$agentpermission;
  maxcostperrun:f64;
  requiresapproval:bool;
  owner:str;
  enabled:bool;
  prompttemplate:str
};

t=$agentrunstatus{
  $idle:i64;
  $running:i64;
  $scheduled:i64;
  $paused:i64;
  $errored:str;
  $disabled:i64
};

t=$agentrun{
  id:str;
  agentid:str;
  trigger:str;
  startedat:str;
  completedat:str;
  durationms:u32;
  tokensused:u32;
  costusd:f64;
  outcome:str;
  error:str;
  status:$agentrunstatus
};




f=newagent(id:str;name:str;description:str;prompt:str):$agentdef{
  <$agentdef{
    id:id;
    name:name;
    description:description;
    schedule:"";
    trigger:$triggertype{$manual:0};
    modelpreference:"";
    latencytolerance:0;
    risklevel:"low";
    permissions:@();
    maxcostperrun:0.10;
    requiresapproval:true;
    owner:"";
    enabled:false;
    prompttemplate:prompt
  }
};


f=newrun(agentid:str;trigger:str):$agentrun{
  let id=str.randhex(16);
  let now=str.nowiso8601();
  <$agentrun{
    id:id;
    agentid:agentid;
    trigger:trigger;
    startedat:now;
    completedat:"";
    durationms:0;
    tokensused:0;
    costusd:0.0;
    outcome:"";
    error:"";
    status:$agentrunstatus{$running:0}
  }
};

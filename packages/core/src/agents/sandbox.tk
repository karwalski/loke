m=core.agents.sandbox;



i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=file:std.file;
i=t:shared.types;
i=at:core.agents.types;

t=$sandboxresult{
  ok:bool;
  output:str;
  tokensused:u32;
  costusd:f64;
  durationms:u32;
  violations:@str
};

t=$sandbox{
  agent:$agentdef;
  violations:@str;
  tokensused:u32;
  costusd:f64
};


(* AG1.10. What a sandboxed operation returns: the sandbox travels with the result, so a
   refusal's violation reaches the caller. *)
t=$sandboxstep{
  sandbox:$sandbox;
  ok:bool;
  output:str;
  error:str
};

f=newsandbox(agent:$agentdef):$sandbox{
  <$sandbox{
    agent:agent;
    violations:@();
    tokensused:0 as u32;
    costusd:0.0
  }
};



(* ── AG1.10: permission decisions ────────────────────────────────────────────────
   Everything below was rewritten 2026-09-26. The old checkpermission took and returned an
   i64 while both callers used it as a bool, read the grants through str.arrayget (which
   erases the element type), and was asked about permissions built as bare sum variants
   (`$readfile(path)`), which crash in a value position (T-13). And it answered the wrong
   question when it did run: a grant matched by str.contains, so a grant for /tmp/work also
   granted /tmp/work/../../etc/passwd and /home/x/tmp/work, and a grant for
   https://api.example.com also granted https://api.example.com.evil.net. *)

(* Permissions are built here, never as bare variants. *)
f=readpermission(path:str):$agentpermission{ <$agentpermission{$readfile:path} };
f=writepermission(path:str):$agentpermission{ <$agentpermission{$writefile:path} };
f=toolpermission(name:str):$agentpermission{ <$agentpermission{$mcptool:name} };
f=getpermission(url:str):$agentpermission{ <$agentpermission{$httpget:url} };
f=modelpermission(model:str):$agentpermission{ <$agentpermission{$model:model} };

(* A `..` segment anywhere is refused outright rather than resolved: the sandbox answers
   about the path it was given, and a path that climbs is not one it will reason about. *)
f=hastraversal(p:str):bool{
  if(str.eq(p;"..")){ <true }el{};
  if(str.startswith(p;"../")){ <true }el{};
  if(str.endswith(p;"/..")){ <true }el{};
  <str.contains(p;"/../")
};

f=withoutslash(p:str):str{
  if(str.len(p)>1 && str.endswith(p;"/")){
    <mt str.slice(p;0;str.len(p)-1) {
      $ok:v v;
      $err:e p
    }
  }el{};
  <p
};

(* The request is the granted path itself, or lies under it at a directory boundary. *)
f=pathmatches(allowedpath:str;reqpath:str):bool{
  if(str.len(allowedpath)==0){ <false }el{};
  if(hastraversal(reqpath)){ <false }el{};
  let base=withoutslash(allowedpath);
  if(str.eq(reqpath;base)){ <true }el{};
  if(str.eq(base;"/")){ <str.startswith(reqpath;"/") }el{};
  <str.startswith(reqpath;str.concat(base;"/"))
};

(* The request is the granted URL itself, or continues it at a path, query or fragment
   boundary, so a grant never extends to another host whose name starts the same way. *)
f=urlmatches(allowedurl:str;requrl:str):bool{
  if(str.len(allowedurl)==0){ <false }el{};
  if(str.eq(allowedurl;requrl)){ <true }el{};
  if(!str.startswith(requrl;allowedurl)){ <false }el{};
  if(str.endswith(allowedurl;"/")){ <!hastraversal(requrl) }el{};
  let next=str.charat(requrl;str.len(allowedurl));
  if(next==47){ <!hastraversal(requrl) }el{};
  <next==63 || next==35
};

f=namematches(allowedname:str;reqname:str):bool{
  <str.len(allowedname)>0 && str.eq(allowedname;reqname)
};

f=checkpermission(sandbox:$sandbox;permission:$agentpermission):bool{
  let ag:$agentdef=sandbox.agent;
  let perms:@$agentpermission=ag.permissions;
  let granted=mut.false;
  lp(let i=0;i<perms.len;i=i+1){
    let p:$agentpermission=perms.get(i);
    if(checkoneperm(permission;p)){ granted=true }el{}
  };
  <granted
};

(* Each inner match is its own function. A `mt` of three or more arms nested inside
   a match arm makes toke emit duplicate basic-block labels and clang rejects the
   whole module with "Terminator found in the middle of a basic block!" — the error
   names an LLVM label, not this file. See docs/upstream/toke-issues.md T-2. *)
f=grantsread(p:$agentpermission;reqpath:str):bool{
  <mt p {
    $readfile:allowedpath pathmatches(allowedpath;reqpath);
    $writefile:wpath false;
    $mcptool:mname false;
    $httpget:hurl false;
    $model:mmod false
  }
};

f=grantswrite(p:$agentpermission;reqpath:str):bool{
  <mt p {
    $writefile:allowedpath pathmatches(allowedpath;reqpath);
    $readfile:rpath false;
    $mcptool:mname false;
    $httpget:hurl false;
    $model:mmod false
  }
};

f=grantstool(p:$agentpermission;reqname:str):bool{
  <mt p {
    $mcptool:allowedname namematches(allowedname;reqname);
    $readfile:rpath false;
    $writefile:wpath false;
    $httpget:hurl false;
    $model:mmod false
  }
};

f=grantsget(p:$agentpermission;requrl:str):bool{
  <mt p {
    $httpget:allowedurl urlmatches(allowedurl;requrl);
    $readfile:rpath false;
    $writefile:wpath false;
    $mcptool:mname false;
    $model:mmod false
  }
};

f=grantsmodel(p:$agentpermission;reqmodel:str):bool{
  <mt p {
    $model:allowedmodel namematches(allowedmodel;reqmodel);
    $readfile:rpath false;
    $writefile:wpath false;
    $mcptool:mname false;
    $httpget:hurl false
  }
};

f=checkoneperm(permission:$agentpermission;p:$agentpermission):bool{
  <mt permission {
    $readfile:reqpath  grantsread(p;reqpath);
    $writefile:reqpath grantswrite(p;reqpath);
    $mcptool:reqname   grantstool(p;reqname);
    $httpget:requrl    grantsget(p;requrl);
    $model:reqmodel    grantsmodel(p;reqmodel)
  }
};

(* ── AG1.10: sandboxed operations ─────────────────────────────────────────────────
   Each returns the sandbox with it, so a refusal's violation reaches the caller. The old
   forms returned str!$lokeerr, which a caller cannot discriminate (T-18), and could not
   record a violation at all: toke cannot mutate the caller's struct. *)
f=step(sandbox:$sandbox;ok:bool;output:str;error:str):$sandboxstep{
  <$sandboxstep{sandbox:sandbox;ok:ok;output:output;error:error}
};

f=refused(sandbox:$sandbox;msg:str):$sandboxstep{
  let ag:$agentdef=sandbox.agent;
  log.warn(str.concat("sandbox violation: ";msg);"sandbox";ag.id);
  <step(recordviolation(sandbox;msg);false;"";msg)
};

f=readfile(sandbox:$sandbox;path:str):$sandboxstep{
  if(checkpermission(sandbox;readpermission(path))){}el{
    <refused(sandbox;str.concat("permission denied: readfile ";path))
  };
  <mt file.read(path) {
    $ok:content step(sandbox;true;content;"");
    $fileerr:e step(sandbox;false;"";str.concat("file read error: ";path))
  }
};

(* The permission decision is what this module owns; the fetch is the stdlib's.

   F10.39: toke 3.1.0 retired the one-argument `http.get(url)`, which answered $ok with a
   nil body against a closed port (T-15). `http.geturl` takes $err on a transport failure
   AND on a non-2xx status, so a 4xx/5xx is now a failed step rather than a successful one
   carrying the error page. That is the safe reading for an agent's fetch. *)
f=httpget(sandbox:$sandbox;url:str):$sandboxstep{
  if(checkpermission(sandbox;getpermission(url))){}el{
    <refused(sandbox;str.concat("permission denied: httpget ";url))
  };
  <mt http.geturl(url) {
    $ok:body step(sandbox;true;body;"");
    $err:e step(sandbox;false;"";str.concat("http get failed: ";url))
  }
};

f=checkcostlimit(sandbox:$sandbox;additionalcost:f64):bool{
  <!((sandbox.costusd+additionalcost)>sandbox.agent.maxcostperrun)
};


(* Returns the updated sandbox rather than mutating the caller's: toke has value
   semantics, so the old body — sandbox.costusd==sandbox.costusd+cost — could never
   have accumulated anything. It read as a cost ceiling and was a no-op comparison,
   which meant the per-agent cost and token limits never moved. LS1.1a.

   The caller must use the result. There are no callers yet, so adopting it now costs
   nothing and a future caller that drops the value is visibly wrong. *)
f=recordcost(sandbox:$sandbox;tokens:u32;cost:f64):$sandbox{
  <$sandbox{
    agent:sandbox.agent;
    violations:sandbox.violations;
    tokensused:(sandbox.tokensused as i64 + tokens as i64) as u32;
    costusd:sandbox.costusd+cost
  }
};


(* Companion to recordcost, for the same reason: `sandbox.violations==@(sandbox.violations;v)`
   in agents/executor.tk was a discarded comparison wrapped around a nesting literal,
   so no sandbox violation was ever recorded — and violations are one of the two things
   a sandbox exists to track. LS1.1a. *)
f=recordviolation(sandbox:$sandbox;violation:str):$sandbox{
  <$sandbox{
    agent:sandbox.agent;
    violations:sandbox.violations.push(violation);
    tokensused:sandbox.tokensused;
    costusd:sandbox.costusd
  }
};

f=hasviolations(sandbox:$sandbox):bool{
  <sandbox.violations.len>0
};


f=toresult(sandbox:$sandbox;output:str;ok:bool):$sandboxresult{
  <$sandboxresult{
    ok:ok;
    output:output;
    tokensused:sandbox.tokensused;
    costusd:sandbox.costusd;
    durationms:0;
    violations:sandbox.violations
  }
};

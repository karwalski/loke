m=core.agents.sandbox;



i=t:shared.types;
i=at:core.agents.types;
i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=file:std.file;

t=$sandboxresult{
  ok:bool;
  output:str;
  tokensused:u32;
  costusd:f64;
  durationms:u32;
  violations:@str
};

t=$sandbox{
  agent:$at.agentdef;
  violations:@str;
  tokensused:u32;
  costusd:f64
};


f=newsandbox(agent:$at.agentdef):$sandbox{
  <$sandbox{
    agent:agent;
    violations:@();
    tokensused:0;
    costusd:0.0
  };
};



f=checkpermission(sandbox:$sandbox;permission:$at.agentpermission):bool{
  let perms=sandbox.agent.permissions;
  let count=perms.len;
  let i=0;
  let granted=false;
  loop{
    if(i>=count{
      break
    }else{
      let p=str.arrayget(perms;i);
      mt permission {
        $at.agentpermission.$readfile reqpath;
          mt p {
            $at.agentpermission.$readfile allowedpath;
              if(str.eq(allowedpath;reqpath){
                granted=true;
                i=count
              }else{
                
                if(str.contains(reqpath;allowedpath){
                  granted=true;
                  i=count
                }else{
                  i=i+1
                };
              };
            $at.agentpermission.$writefile ; i=i+1;
            $at.agentpermission.$mcptool ;   i=i+1;
            $at.agentpermission.$httpget ;   i=i+1;
            $at.agentpermission.$model ;      i=i+1
          };
        $at.agentpermission.$writefile reqpath;
          mt p {
            $at.agentpermission.$writefile allowedpath;
              if(str.eq(allowedpath;reqpath){
                granted=true;
                i=count
              }else{
                if(str.contains(reqpath;allowedpath){
                  granted=true;
                  i=count
                }else{
                  i=i+1
                };
              };
            $at.agentpermission.$readfile ;  i=i+1;
            $at.agentpermission.$mcptool ;   i=i+1;
            $at.agentpermission.$httpget ;   i=i+1;
            $at.agentpermission.$model ;      i=i+1
          };
        $at.agentpermission.$mcptool reqname;
          mt p {
            $at.agentpermission.$mcptool allowedname;
              if(str.eq(allowedname;reqname){
                granted=true;
                i=count
              }else{
                i=i+1
              };
            $at.agentpermission.$readfile ;  i=i+1;
            $at.agentpermission.$writefile ; i=i+1;
            $at.agentpermission.$httpget ;   i=i+1;
            $at.agentpermission.$model ;      i=i+1
          };
        $at.agentpermission.$httpget requrl;
          mt p {
            $at.agentpermission.$httpget allowedurl;
              if(str.eq(allowedurl;requrl){
                granted=true;
                i=count
              }else{
                if(str.contains(requrl;allowedurl){
                  granted=true;
                  i=count
                }else{
                  i=i+1
                };
              };
            $at.agentpermission.$readfile ;  i=i+1;
            $at.agentpermission.$writefile ; i=i+1;
            $at.agentpermission.$mcptool ;   i=i+1;
            $at.agentpermission.$model ;      i=i+1
          };
        $at.agentpermission.$model reqmodel;
          mt p {
            $at.agentpermission.$model allowedmodel;
              if(str.eq(allowedmodel;reqmodel){
                granted=true;
                i=count
              }else{
                i=i+1
              };
            $at.agentpermission.$readfile ;  i=i+1;
            $at.agentpermission.$writefile ; i=i+1;
            $at.agentpermission.$mcptool ;   i=i+1;
            $at.agentpermission.$httpget ;   i=i+1
          };
      };
    };
  };
  <granted
};



f=readfile(sandbox:mut $sandbox;path:str):str|$t.lokeerr{
  let perm=$at.agentpermission.$readfile(path);
  let allowed=checkpermission(sandbox;perm);
  if(allowed{
    let result=file.read(path);
    mt result {
      $fileerr e;
        <$t.lokeerr.$configerr(str.concat("file read error: ";path))
      content;
        <content
    };
  }else{
    let msg=str.concat("permission denied: read_file ";path);
    sandbox.violations=@(sandbox.violations;msg);
    log.warn(str.concat("sandbox violation: ";msg);"sandbox";sandbox.agent.id);
    <$t.lokeerr.$configerr(msg)
  };
};



f=httpget(sandbox:mut $sandbox;url:str):str|$t.lokeerr{
  let perm=$at.agentpermission.$httpget(url);
  let allowed=checkpermission(sandbox;perm);
  if(allowed{
    let result=http.get(url);
    mt result {
      $err e;
        <$t.lokeerr.$networkerr(str.concat("http get failed: ";url))
      body;
        <body
    };
  }else{
    let msg=str.concat("permission denied: http_get ";url);
    sandbox.violations=@(sandbox.violations;msg);
    log.warn(str.concat("sandbox violation: ";msg);"sandbox";sandbox.agent.id);
    <$t.lokeerr.$configerr(msg)
  };
};


f=checkcostlimit(sandbox:$sandbox;additionalcost:f64):bool{
  let total=sandbox.costusd+additionalcost;
  <total<=sandbox.agent.maxcostperrun
};


f=recordcost(sandbox:mut $sandbox;tokens:u32;cost:f64):void{
  sandbox.tokensused=sandbox.tokensused+tokens;
  sandbox.costusd=sandbox.costusd+cost
};


f=hasviolations(sandbox:$sandbox):bool{
  <sandbox.violations.len>0
};


f=toresult(sandbox:$sandbox;output:str;ok:bool):$sandboxresult{
  <$sandboxresult{
    ok:ok;
    output:output;
    tokensused:sandbox.tokensused;
    costusd:sandbox.costusd;
    durationms:0;
    violations:sandbox.violations
  };
};

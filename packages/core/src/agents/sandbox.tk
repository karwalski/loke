m=core.agents.sandbox;



i=t:shared.types;
i=at:core.agents.types;
i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=file:std.file;

t=$sandboxresult{
  ok:bool;
  output:str;
  tokensused:u32;
  costusd:f64;
  durationms:u32;
  violations:@str
};

t=$sandbox{
  agent:i64;
  violations:@str;
  tokensused:u32;
  costusd:f64
};


f=newsandbox(agent:i64):$sandbox{
  <$sandbox{
    agent:agent;
    violations:@();
    tokensused:0;
    costusd:0.0
  }
};



f=checkpermission(sandbox:$sandbox;permission:i64):bool{
  let perms=sandbox.agent.permissions;
  let count=perms.len;
  let i=0;
  let granted=false;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let p=str.arrayget(perms;i);
      mt permission {
        $agentpermission.$readfile:reqpath
          mt p {
            $agentpermission.$readfile:allowedpath
              if(str.eq(allowedpath;reqpath)){
                granted=true;
                i=count
              }el{
                if(str.contains(reqpath;allowedpath)){
                  granted=true;
                  i=count
                }el{
                  i=i+1
                }
              };
            $agentpermission.$writefile:wpath i=i+1;
            $agentpermission.$mcptool:mname i=i+1;
            $agentpermission.$httpget:hurl i=i+1;
            $agentpermission.$model:mmod i=i+1
          };
        $agentpermission.$writefile:reqpath
          mt p {
            $agentpermission.$writefile:allowedpath
              if(str.eq(allowedpath;reqpath)){
                granted=true;
                i=count
              }el{
                if(str.contains(reqpath;allowedpath)){
                  granted=true;
                  i=count
                }el{
                  i=i+1
                }
              };
            $agentpermission.$readfile:rpath i=i+1;
            $agentpermission.$mcptool:mname i=i+1;
            $agentpermission.$httpget:hurl i=i+1;
            $agentpermission.$model:mmod i=i+1
          };
        $agentpermission.$mcptool:reqname
          mt p {
            $agentpermission.$mcptool:allowedname
              if(str.eq(allowedname;reqname)){
                granted=true;
                i=count
              }el{
                i=i+1
              };
            $agentpermission.$readfile:rpath i=i+1;
            $agentpermission.$writefile:wpath i=i+1;
            $agentpermission.$httpget:hurl i=i+1;
            $agentpermission.$model:mmod i=i+1
          };
        $agentpermission.$httpget:requrl
          mt p {
            $agentpermission.$httpget:allowedurl
              if(str.eq(allowedurl;requrl)){
                granted=true;
                i=count
              }el{
                if(str.contains(requrl;allowedurl)){
                  granted=true;
                  i=count
                }el{
                  i=i+1
                }
              };
            $agentpermission.$readfile:rpath i=i+1;
            $agentpermission.$writefile:wpath i=i+1;
            $agentpermission.$mcptool:mname i=i+1;
            $agentpermission.$model:mmod i=i+1
          };
        $agentpermission.$model:reqmodel
          mt p {
            $agentpermission.$model:allowedmodel
              if(str.eq(allowedmodel;reqmodel)){
                granted=true;
                i=count
              }el{
                i=i+1
              };
            $agentpermission.$readfile:rpath i=i+1;
            $agentpermission.$writefile:wpath i=i+1;
            $agentpermission.$mcptool:mname i=i+1;
            $agentpermission.$httpget:hurl i=i+1
          }
      }
    }
  };
  <granted
};



f=readfile(sandbox:$sandbox;path:str):str!$lokeerr{
  let perm=$agentpermission.$readfile(path);
  let allowed=checkpermission(sandbox;perm);
  if(allowed){
    let result=file.read(path);
    mt result {
      $fileerr:e
        <$lokeerr.$configerr(str.concat("file read error: ";path));
      content
        <content
    }
  }el{
    let msg=str.concat("permission denied: readfile ";path);
    sandbox.violations=@(sandbox.violations;msg);
    log.warn(str.concat("sandbox violation: ";msg);"sandbox";sandbox.agent.id);
    <$lokeerr.$configerr(msg)
  }
};



f=httpget(sandbox:$sandbox;url:str):str!$lokeerr{
  let perm=$agentpermission.$httpget(url);
  let allowed=checkpermission(sandbox;perm);
  if(allowed){
    let result=http.get(url);
    mt result {
      $err:e
        <$lokeerr.$networkerr(str.concat("http get failed: ";url));
      body
        <body
    }
  }el{
    let msg=str.concat("permission denied: httpget ";url);
    sandbox.violations=@(sandbox.violations;msg);
    log.warn(str.concat("sandbox violation: ";msg);"sandbox";sandbox.agent.id);
    <$lokeerr.$configerr(msg)
  }
};


f=checkcostlimit(sandbox:$sandbox;additionalcost:f64):bool{
  let total=sandbox.costusd+additionalcost;
  <total<=sandbox.agent.maxcostperrun
};


f=recordcost(sandbox:$sandbox;tokens:u32;cost:f64):void{
  sandbox.tokensused=sandbox.tokensused+tokens;
  sandbox.costusd=sandbox.costusd+cost
};


f=hasviolations(sandbox:$sandbox):bool{
  <sandbox.violations.len>0
};


f=toresult(sandbox:$sandbox;output:str;ok:bool):$sandboxresult{
  <$sandboxresult{
    ok:ok;
    output:output;
    tokensused:sandbox.tokensused;
    costusd:sandbox.costusd;
    durationms:0;
    violations:sandbox.violations
  }
};

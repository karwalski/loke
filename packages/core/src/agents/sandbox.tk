m=core.agents.sandbox;



i=t:shared.types;
i=at:core.agents.types;
i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=file:std.file;

t=$sandboxresult{
  ok:bool;
  output:str;
  tokensused:u32;
  costusd:f64;
  durationms:u32;
  violations:@str
};

t=$sandbox{
  agent:i64;
  violations:@str;
  tokensused:u32;
  costusd:f64
};


f=newsandbox(agent:i64):$sandbox{
  <$sandbox{
    agent:agent;
    violations:@();
    tokensused:0;
    costusd:0.0
  }
};



f=pathmatches(allowedpath:str;reqpath:str):bool{
  let matched=mut.false;
  if(str.eq(allowedpath;reqpath)){
    matched=true
  }el{
    if(str.contains(reqpath;allowedpath)){
      matched=true
    }el{}
  };
  <matched
};

f=namematches(allowedname:str;reqname:str):bool{
  <str.eq(allowedname;reqname)
};

f=checkpermission(sandbox:$sandbox;permission:i64):bool{
  let perms=sandbox.agent.permissions;
  let count=perms.len;
  let i=mut.0;
  let granted=mut.false;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let p=str.arrayget(perms;i);
      let matched=checkoneperm(permission;p);
      if(matched){
        granted=true;
        i=count
      }el{
        i=i+1
      }
    }
  };
  <granted
};

f=checkoneperm(permission:i64;p:i64):bool{
  mt permission {
    $readfile:reqpath
      mt p {
        $readfile:allowedpath pathmatches(allowedpath;reqpath);
        $writefile:wpath false;
        $mcptool:mname false;
        $httpget:hurl false;
        $model:mmod false
      };
    $writefile:reqpath
      mt p {
        $writefile:allowedpath pathmatches(allowedpath;reqpath);
        $readfile:rpath false;
        $mcptool:mname false;
        $httpget:hurl false;
        $model:mmod false
      };
    $mcptool:reqname
      mt p {
        $mcptool:allowedname namematches(allowedname;reqname);
        $readfile:rpath false;
        $writefile:wpath false;
        $httpget:hurl false;
        $model:mmod false
      };
    $httpget:requrl
      mt p {
        $httpget:allowedurl pathmatches(allowedurl;requrl);
        $readfile:rpath false;
        $writefile:wpath false;
        $mcptool:mname false;
        $model:mmod false
      };
    $model:reqmodel
      mt p {
        $model:allowedmodel namematches(allowedmodel;reqmodel);
        $readfile:rpath false;
        $writefile:wpath false;
        $mcptool:mname false;
        $httpget:hurl false
      }
  }
};



f=sandboxreadfile(sandbox:$sandbox;path:str):str!$lokeerr{
  let perm=$readfile(path);
  let allowed=checkpermission(sandbox;perm);
  if(allowed){
    let result=file.read(path);
    mt result {
      $fileerr:e $configerr(str.concat("file read error: ";path));
      $ok:content content
    }
  }el{
    let msg=str.concat("permission denied: readfile ";path);
    sandbox.violations=@(sandbox.violations;msg);
    log.warn(str.concat("sandbox violation: ";msg);"sandbox";sandbox.agent.id);
    <$configerr(msg)
  }
};



f=sandboxhttpget(sandbox:$sandbox;url:str):str!$lokeerr{
  let perm=$httpget(url);
  let allowed=checkpermission(sandbox;perm);
  if(allowed){
    let result=http.get(url);
    mt result {
      $err:e $networkerr(str.concat("http get failed: ";url));
      $ok:body body
    }
  }el{
    let msg=str.concat("permission denied: httpget ";url);
    sandbox.violations=@(sandbox.violations;msg);
    log.warn(str.concat("sandbox violation: ";msg);"sandbox";sandbox.agent.id);
    <$configerr(msg)
  }
};


f=checkcostlimit(sandbox:$sandbox;additionalcost:f64):bool{
  let total=sandbox.costusd+additionalcost;
  <!(total>sandbox.agent.maxcostperrun)
};


f=recordcost(sandbox:$sandbox;tokens:u32;cost:f64):void{
  sandbox.tokensused=sandbox.tokensused+tokens;
  sandbox.costusd=sandbox.costusd+cost
};


f=hasviolations(sandbox:$sandbox):bool{
  <sandbox.violations.len>0
};


f=toresult(sandbox:$sandbox;output:str;ok:bool):$sandboxresult{
  <$sandboxresult{
    ok:ok;
    output:output;
    tokensused:sandbox.tokensused;
    costusd:sandbox.costusd;
    durationms:0;
    violations:sandbox.violations
  }
};

m=core.agents.observability;



i=t:shared.types;
i=at:core.agents.types;
i=str:std.str;
i=log:shared.log;

t=$logline{
  timestamp:str;
  level:str;
  message:str;
  agentid:str;
  runid:str
};

t=$agentstats{
  agentid:str;
  totalruns:u32;
  successfulruns:u32;
  failedruns:u32;
  totaltokens:u32;
  totalcostusd:f64;
  avgdurationms:u32;
  lastrunat:str;
  consecutivefailures:u32
};

t=$debugtrace{
  runid:str;
  agentid:str;
  steps:@(str);
  inputprompt:str;
  pipelineresult:str;
  modelselected:str;
  output:str;
  durationms:u32
};



f=computestats(runs:@($at.agentrun);agentid:str):$agentstats{
  let total=0;
  let successful=0;
  let failed=0;
  let totaltokens=0;
  let totalcost=0.0;
  let totalduration=0;
  let lastrunat="";
  let consecutivefailures=0;
  let countingfailures=true;

  let count=runs.len;
  let i=0;
  loop{
    if i>=count{
      break
    }else{
      let run=str.arrayget(runs;i);
      if str.eq(run.agentid;agentid){
        total=total+1;
        totaltokens=totaltokens+run.tokensused;
        totalcost=totalcost+run.costusd;
        totalduration=totalduration+run.durationms;
        if str.eq(lastrunat;""){
          lastrunat=run.startedat
        }else{
          
        };
        if str.eq(run.outcome;"success"){
          successful=successful+1;
          countingfailures=false
        }else{
          failed=failed+1;
          if countingfailures{
            consecutivefailures=consecutivefailures+1
          }else{
            
          };
        };
      }else{
        
      };
      i=i+1
    };
  };

  let avgdur=0;
  if total>0{
    avgdur=totalduration/total
  }else{
    
  };

  <$agentstats{
    agentid:agentid;
    totalruns:total;
    successfulruns:successful;
    failedruns:failed;
    totaltokens:totaltokens;
    totalcostusd:totalcost;
    avgdurationms:avgdur;
    lastrunat:lastrunat;
    consecutivefailures:consecutivefailures
  };
};


f=formatrunhistory(runs:@($at.agentrun);limit:u32):str{
  let header=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            "ID       | Started             | Duration | Tokens | Cost  | Outcome";
            "
"
          );
          "-------- | ------------------- | -------- | ------ | ----- | -------"
        );
        "
"
      );
      ""
    );
    ""
  );
  let rows="";
  let count=runs.len;
  let i=0;
  let shown=0;
  loop{
    if i>=count{
      break
    }else{
      if shown>=limit{
        break
      }else{
        let run=str.arrayget(runs;i);
        let durs=str.concat(str.fromu32(run.durationms/1000);"s");
        let coststr=str.concat("$";str.fromfloat(run.costusd));
        let row=str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(
                        str.concat(
                          str.concat(
                            str.concat(run.id;" | ");
                            run.startedat
                          );
                          " | "
                        );
                        durs
                      );
                      " | "
                    );
                    str.fromu32(run.tokensused)
                  );
                  " | "
                );
                coststr
              );
              " | "
            );
            run.outcome
          );
          "
"
        );
        rows=str.concat(rows;row);
        shown=shown+1
      };
    };
    i=i+1
  };
  <str.concat(header;rows)
};


f=formatstats(stats:$agentstats):str{
  let totalstr=str.fromu32(stats.totalruns);
  let okstr=str.fromu32(stats.successfulruns);
  let failstr=str.fromu32(stats.failedruns);
  let totalcoststr=str.concat("$";str.fromfloat(stats.totalcostusd));
  let avgcost=0.0;
  if stats.totalruns>0{
    avgcost=stats.totalcostusd/(stats.totalruns as f64)
  }else{
    
  };
  let avgcoststr=str.concat("$";str.fromfloat(avgcost));
  let avgdurstr=str.concat(str.fromu32(stats.avgdurationms/1000);"s");

  let line1=str.concat("Agent: ";stats.agentid);
  let line2=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("Runs: ";totalstr);
          " total ("
        );
        okstr
      );
      " ok, "
    );
    str.concat(failstr;" failed)")
  );
  let line3=str.concat(
    str.concat(
      str.concat(
        str.concat("Cost: ";totalcoststr);
        " total, "
      );
      avgcoststr
    );
    " avg"
  );
  let line4=str.concat("Duration: avg ";avgdurstr);
  let line5=str.concat("Last run: ";stats.lastrunat);

  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(line1;"
");
                line2
              );
              "
"
            );
            line3
          );
          "
"
        );
        line4
      );
      "
"
    );
    line5
  )
};


f=newdebugtrace(runid:str;agentid:str;input:str):$debugtrace{
  <$debugtrace{
    runid:runid;
    agentid:agentid;
    steps:@();
    inputprompt:input;
    pipelineresult:"";
    modelselected:"";
    output:"";
    durationms:0
  };
};


f=addstep(trace:mut $debugtrace;step:str):void{
  trace.steps=@(trace.steps;step)
};


f=recordmodel(trace:mut $debugtrace;modelid:str):void{
  trace.modelselected=modelid
};


f=recordoutput(trace:mut $debugtrace;output:str;durationms:u32):void{
  trace.output=output;
  trace.durationms=durationms
};


f=formattrace(trace:$debugtrace):str{
  let header=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("Trace: ";trace.runid);
            " (agent: "
          );
          trace.agentid
        );
        ")
"
      );
      str.concat("Model: ";trace.modelselected)
    );
    "
"
  );

  let stepsstr="Steps:
";
  let count=trace.steps.len;
  let i=0;
  loop{
    if i>=count{
      break
    }else{
      let step=str.arrayget(trace.steps;i);
      let n=str.concat(str.fromu32(i+1);". ");
      stepsstr=str.concat(stepsstr;str.concat(str.concat(n;step);"
"));
      i=i+1
    };
  };

  let footer=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("Duration: ";str.fromu32(trace.durationms/1000));
          "s
Output: "
        );
        trace.output
      );
      "
"
    );
    ""
  );

  <str.concat(str.concat(header;stepsstr);footer)
};


f=shouldpause(stats:$agentstats;maxconsecutivefailures:u32):bool{
  <stats.consecutivefailures>=maxconsecutivefailures
};

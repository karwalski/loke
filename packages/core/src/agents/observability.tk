m=core.agents.observability;

i=t:shared.types;
i=at:core.agents.types;
i=str:std.str;
i=log:shared.log;

t=$logline{
  timestamp:str;
  level:str;
  message:str;
  agentid:str;
  runid:str
};

t=$agentstats{
  agentid:str;
  totalruns:u32;
  successfulruns:u32;
  failedruns:u32;
  totaltokens:u32;
  totalcostusd:f64;
  avgdurationms:u32;
  lastrunat:str;
  consecutivefailures:u32
};

t=$debugtrace{
  runid:str;
  agentid:str;
  steps:@str;
  inputprompt:str;
  pipelineresult:str;
  modelselected:str;
  output:str;
  durationms:u32
};



f=computestats(runs:@i64;agentid:str):$agentstats{
  let total=mut.0;
  let successful=mut.0;
  let failed=mut.0;
  let totaltokens=mut.0;
  let totalcost=mut.0.0;
  let totalduration=mut.0;
  let lastrunat=mut."";
  let consecutivefailures=mut.0;
  let countingfailures=mut.true;
  let count=runs.len;
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let run=str.arrayget(runs;i);
    if(str.eq(run.agentid;agentid)){
      total=total+1;
      totaltokens=totaltokens+run.tokensused;
      totalcost=totalcost+run.costusd;
      totalduration=totalduration+run.durationms;
      if(str.eq(lastrunat;"")){
        lastrunat=run.startedat
      }el{};
      if(str.eq(run.outcome;"success")){
        successful=successful+1;
        countingfailures=false
      }el{
        failed=failed+1;
        if(countingfailures){
          consecutivefailures=consecutivefailures+1
        }el{}
      }
    }el{};
    i=i+1
  };
  let avgdur=mut.0;
  if(total>0){
    avgdur=totalduration/total
  }el{};
  <$agentstats{
    agentid:agentid;
    totalruns:total;
    successfulruns:successful;
    failedruns:failed;
    totaltokens:totaltokens;
    totalcostusd:totalcost;
    avgdurationms:avgdur;
    lastrunat:lastrunat;
    consecutivefailures:consecutivefailures
  }
};


f=formatrunhistory(runs:@i64;limit:u32):str{
  let header=str.concat(
    "ID       | Started             | Duration | Tokens | Cost  | Outcome\n";
    "-------- | ------------------- | -------- | ------ | ----- | -------\n"
  );
  let rows=mut."";
  let count=runs.len;
  let i=mut.0;
  let shown=mut.0;
  lp(let lv=0;i<count;lv=lv){
    if(shown<limit){
      let run=str.arrayget(runs;i);
      let durs=str.concat(str.fromu32(run.durationms/1000);"s");
      let coststr=str.concat("$";str.fromfloat(run.costusd));
      let row=str.concat(
        str.concat(run.id;" | ");
        str.concat(run.startedat;
          str.concat(" | ";
            str.concat(durs;
              str.concat(" | ";
                str.concat(str.fromu32(run.tokensused);
                  str.concat(" | ";
                    str.concat(coststr;
                      str.concat(" | ";
                        str.concat(run.outcome;"\n")
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
      rows=str.concat(rows;row);
      shown=shown+1
    }el{};
    i=i+1
  };
  <str.concat(header;rows)
};


f=formatstats(stats:$agentstats):str{
  let totalstr=str.fromu32(stats.totalruns);
  let okstr=str.fromu32(stats.successfulruns);
  let failstr=str.fromu32(stats.failedruns);
  let totalcoststr=str.concat("$";str.fromfloat(stats.totalcostusd));
  let avgcost=mut.0.0;
  if(stats.totalruns>0 as u32){
    avgcost=stats.totalcostusd/(stats.totalruns as f64)
  }el{};
  let avgcoststr=str.concat("$";str.fromfloat(avgcost));
  let avgdurstr=str.concat(str.fromu32(stats.avgdurationms/1000);"s");

  let line1=str.concat("Agent: ";stats.agentid);
  let line2=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("Runs: ";totalstr);
          " total ("
        );
        okstr
      );
      " ok, "
    );
    str.concat(failstr;" failed)")
  );
  let line3=str.concat(
    str.concat(
      str.concat(
        str.concat("Cost: ";totalcoststr);
        " total, "
      );
      avgcoststr
    );
    " avg"
  );
  let line4=str.concat("Duration: avg ";avgdurstr);
  let line5=str.concat("Last run: ";stats.lastrunat);

  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(line1;"
");
                line2
              );
              "
"
            );
            line3
          );
          "
"
        );
        line4
      );
      "
"
    );
    line5
  )
};


f=newdebugtrace(runid:str;agentid:str;input:str):$debugtrace{
  <$debugtrace{
    runid:runid;
    agentid:agentid;
    steps:@("" as str);
    inputprompt:input;
    pipelineresult:"";
    modelselected:"";
    output:"";
    durationms:0
  }
};


f=addstep(trace:$debugtrace;step:str):void{
  trace.steps.push(step)
};


f=recordmodel(trace:$debugtrace;modelid:str):void{
  trace.modelselected=modelid
};


f=recordoutput(trace:$debugtrace;output:str;durationms:u32):void{
  trace.output=output;
  trace.durationms=durationms
};


f=formattrace(trace:$debugtrace):str{
  let header=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("Trace: ";trace.runid);
            " (agent: "
          );
          trace.agentid
        );
        ")
"
      );
      str.concat("Model: ";trace.modelselected)
    );
    "
"
  );

  let stepsstr=mut."Steps:\n";
  let count=trace.steps.len;
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let step=str.arrayget(trace.steps;i);
    let n=str.concat(str.fromu32(i+1);". ");
    stepsstr=str.concat(stepsstr;str.concat(str.concat(n;step);"\n"));
    i=i+1
  };

  let footer=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("Duration: ";str.fromu32(trace.durationms/1000));
          "s
Output: "
        );
        trace.output
      );
      "
"
    );
    ""
  );

  <str.concat(str.concat(header;stepsstr);footer)
};


f=shouldpause(stats:$agentstats;maxconsecutivefailures:u32):bool{
  <stats.consecutivefailures>maxconsecutivefailures
};

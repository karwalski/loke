m=core.agents.observability;

i=str:std.str;
i=at:core.agents.types;

t=$logline{
  timestamp:str;
  level:str;
  message:str;
  agentid:str;
  runid:str
};

t=$agentstats{
  agentid:str;
  totalruns:u32;
  successfulruns:u32;
  failedruns:u32;
  totaltokens:u32;
  totalcostusd:f64;
  avgdurationms:u32;
  lastrunat:str;
  consecutivefailures:u32
};

t=$debugtrace{
  runid:str;
  agentid:str;
  steps:@str;
  inputprompt:str;
  pipelineresult:str;
  modelselected:str;
  output:str;
  durationms:u32
};



f=computestats(runs:@$agentrun;agentid:str):$agentstats{
  let total=mut.0;
  let successful=mut.0;
  let failed=mut.0;
  let totaltokens=mut.0;
  let totalcost=mut.0.0;
  let totalduration=mut.0;
  let lastrunat=mut."";
  let consecutivefailures=mut.0;
  let countingfailures=mut.true;
  let count=runs.len;
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let run=runs.get(i);
    if(str.eq(run.agentid;agentid)){
      total=total+1;
      totaltokens=totaltokens+run.tokensused;
      totalcost=totalcost+run.costusd;
      totalduration=totalduration+run.durationms;
      if(str.eq(lastrunat;"")){
        lastrunat=run.startedat
      }el{};
      if(str.eq(run.outcome;"success")){
        successful=successful+1;
        countingfailures=false
      }el{
        failed=failed+1;
        if(countingfailures){
          consecutivefailures=consecutivefailures+1
        }el{}
      }
    }el{};
    i=i+1
  };
  let avgdur=mut.0;
  if(total>0){
    avgdur=totalduration/total
  }el{};
  <$agentstats{
    agentid:agentid;
    totalruns:total;
    successfulruns:successful;
    failedruns:failed;
    totaltokens:totaltokens;
    totalcostusd:totalcost;
    avgdurationms:avgdur;
    lastrunat:lastrunat;
    consecutivefailures:consecutivefailures
  }
};


f=formatrunhistory(runs:@$agentrun;limit:u32):str{
  let header=str.concat(
    "ID       | Started             | Duration | Tokens | Cost  | Outcome\n";
    "-------- | ------------------- | -------- | ------ | ----- | -------\n"
  );
  let rows=mut."";
  let count=runs.len;
  let i=mut.0;
  let shown=mut.0;
  lp(let lv=0;i<count;lv=lv){
    if(shown<limit){
      let run=runs.get(i);
      let durs=str.concat(str.fromint(run.durationms/1000);"s");
      let coststr=str.concat("$";str.fromfloat(run.costusd));
      let row="\(run.id) | \(run.startedat) | \(durs) | \(str.fromint(run.tokensused)) | \(coststr) | \(run.outcome)\n";
      rows=str.concat(rows;row);
      shown=shown+1
    }el{};
    i=i+1
  };
  <str.concat(header;rows)
};


f=formatstats(stats:$agentstats):str{
  let totalstr=str.fromint(stats.totalruns);
  let okstr=str.fromint(stats.successfulruns);
  let failstr=str.fromint(stats.failedruns);
  let totalcoststr=str.concat("$";str.fromfloat(stats.totalcostusd));
  let avgcost=mut.0.0;
  if(stats.totalruns>0 as u32){
    avgcost=stats.totalcostusd/(stats.totalruns as f64)
  }el{};
  let avgcoststr=str.concat("$";str.fromfloat(avgcost));
  let avgdurstr=str.concat(str.fromint(stats.avgdurationms/1000);"s");

  let line1=str.concat("Agent: ";stats.agentid);
  let line2="Runs: \(totalstr) total (\(okstr) ok, \(failstr) failed)";
  let line3="Cost: \(totalcoststr) total, \(avgcoststr) avg";
  let line4=str.concat("Duration: avg ";avgdurstr);
  let line5=str.concat("Last run: ";stats.lastrunat);

  <"\(line1)\n\(line2)\n\(line3)\n\(line4)\n\(line5)"
};


f=newdebugtrace(runid:str;agentid:str;input:str):$debugtrace{
  <$debugtrace{
    runid:runid;
    agentid:agentid;
    steps:@("" as str);
    inputprompt:input;
    pipelineresult:"";
    modelselected:"";
    output:"";
    durationms:0
  }
};


(* ── Three recorders that recorded nothing ────────────────────────────────────────
   `addstep` discarded the array `.push` returns (T-24); the other two are `==` comparisons
   where an assignment was meant, and toke has no assignment to a struct field at all (T-26),
   so both were expression statements whose value was thrown away. A `$debugtrace` therefore
   left `newtrace` with no steps, no model and no output, and `formattrace` below rendered that
   empty trace as though it were a record of what happened.

   Same defect and same fix as `core.governance.trace`: rebuild and return. `:void` is what hid
   it — a function returning nothing reads like one that works by mutation. No cross-module
   callers (checked). *)
f=addstep(trace:$debugtrace;step:str):$debugtrace{
  <$debugtrace{
    runid:trace.runid;
    agentid:trace.agentid;
    steps:trace.steps.push(step);
    inputprompt:trace.inputprompt;
    pipelineresult:trace.pipelineresult;
    modelselected:trace.modelselected;
    output:trace.output;
    durationms:trace.durationms
  }
};


f=recordmodel(trace:$debugtrace;modelid:str):$debugtrace{
  <$debugtrace{
    runid:trace.runid;
    agentid:trace.agentid;
    steps:trace.steps;
    inputprompt:trace.inputprompt;
    pipelineresult:trace.pipelineresult;
    modelselected:modelid;
    output:trace.output;
    durationms:trace.durationms
  }
};


f=recordoutput(trace:$debugtrace;output:str;durationms:u32):$debugtrace{
  <$debugtrace{
    runid:trace.runid;
    agentid:trace.agentid;
    steps:trace.steps;
    inputprompt:trace.inputprompt;
    pipelineresult:trace.pipelineresult;
    modelselected:trace.modelselected;
    output:output;
    durationms:durationms
  }
};


f=formattrace(trace:$debugtrace):str{
  let header="Trace: \(trace.runid) (agent: \(trace.agentid))\nModel: \(trace.modelselected)\n";

  let stepsstr=mut."Steps:\n";
  let count=trace.steps.len;
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let step=trace.steps.get(i);
    let n=str.concat(str.fromint(i+1);". ");
    stepsstr="\(stepsstr)\(n)\(step)\n";
    i=i+1
  };

  let footer=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("Duration: ";str.fromint(trace.durationms/1000));
          "s
Output: "
        );
        trace.output
      );
      "
"
    );
    ""
  );

  <"\(header)\(stepsstr)\(footer)"
};


f=shouldpause(stats:$agentstats;maxconsecutivefailures:u32):bool{
  <stats.consecutivefailures>maxconsecutivefailures
};

m=core.agents.overnight;

i=t:shared.types;
i=log:shared.log;
i=str:std.str;
i=reg:core.agents.registry;
i=lat:core.agents.latency;
i=at:core.agents.types;

t=$overnightwindow{
  starthour:i32;
  endhour:i32
};

t=$batchjob{
  agentname:str;
  priority:i32;
  estimatedminutes:i32
};

t=$batchrun{
  window:$overnightwindow;
  jobs:@$batchjob;
  completed:@str;
  failed:@str;
  startedat:i64;
  finishedat:i64
};


f=defaultwindow():$overnightwindow{
  <$overnightwindow{
    starthour:22;
    endhour:6
  }
};



f=isovernight(hour:i32;window:$overnightwindow):bool{
  if(hour>window.starthour){
    <true
  }el{};
  <hour<window.endhour
};



(* F10.39: `reg:i64` shadowed the module alias, so `reg.listenabled(reg)` was a receiver call
   on an integer; toke 3.1.0 rejects it (E4036). The parameter is the registry it always
   meant. `t.arrayget` is a stub that answers 0 whatever the array holds; `.get` reads it.
   Nothing calls this module yet.
   F10.56: core.agents.types, which declares $agentdef, was not imported, so `agent.name` was
   read without the record's layout: toke 3.2.0 compiled it reading the agent's id, the
   field before name (measured, tests/unit/agents/test_overnight.tk), and toke 3.3.0 refuses
   it (E4034). The import gives the read its type. *)
f=collectovernightagents(registry:$agentregistry;assignments:@$latencyassignment):@$batchjob{
  let enabled=reg.listenabled(registry);
  let count=enabled.len;
  let jobs=mut.@();
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let agent=enabled.get(i);
    if(str.eq(lat.classforagent(assignments;agent.name).name;"background")){
      let job=$batchjob{
        agentname:agent.name;
        priority:1;
        estimatedminutes:30
      };
      jobs=jobs.push(job)
    }el{};
    i=i+1
  };
  <jobs
};




(* The two jobs at a and b exchanged. `t.arrayswap` was a stub that answered its input. *)
f=swapjobs(arr:@$batchjob;a:i64;b:i64):@$batchjob{
  let out=mut.@();
  lp(let k=0;k<arr.len;k=k+1){
    if(k==a){
      out=out.push(arr.get(b))
    }el if(k==b){ out=out.push(arr.get(a)) }el{ out=out.push(arr.get(k)) }
  };
  <out
};

f=runbatch(jobs:@$batchjob;registry:$agentregistry):$batchrun{
  let started=t.nowi64();
  let count=jobs.len;
  let sorted=mut.jobs;
  let i=mut.1;
  lp(let lv=0;i<count;lv=lv){
    let j=mut.i;
    lp(let lv2=0;j>0;lv2=lv2){
      let a=sorted.get(j-1);
      let b=sorted.get(j);
      if(a.priority>b.priority){
        sorted=swapjobs(sorted;j-1;j);
        j=j-1
      }el{
        j=0
      }
    };
    i=i+1
  };
  let completed=mut.@();
  let failed=mut.@();
  let k=mut.0;
  lp(let lv3=0;k<count;lv3=lv3){
    let job=sorted.get(k);
    log.info(
      str.concat("overnight batch: running agent ";job.agentname);
      "overnight";
      job.agentname
    );
    (* AG1.9: reg.has, not a match on reg.find, which took the first arm whatever it held
       (T-18), so an unknown agent counted as completed. The parameter was also `reg:i64`,
       which shadowed the module alias and was never a registry. *)
    if(reg.has(registry;job.agentname)){
      log.info(
        str.concat("overnight batch: completed agent ";job.agentname);
        "overnight";
        job.agentname
      );
      completed=completed.push(job.agentname)
    }el{
      log.error(
        str.concat("overnight batch: agent not found: ";job.agentname);
        "overnight";
        job.agentname
      );
      failed=failed.push(job.agentname)
    };
    k=k+1
  };
  let finished=t.nowi64();
  <$batchrun{
    window:defaultwindow();
    jobs:sorted;
    completed:completed;
    failed:failed;
    startedat:started;
    finishedat:finished
  }
};


f=formatbatchrun(run:$batchrun):str{
  let windowstr="\(str.fromint(run.window.starthour))h–\(str.fromint(run.window.endhour))h";
  let jobcount=str.fromint(run.jobs.len);
  let okcount=str.fromint(run.completed.len);
  let failcount=str.fromint(run.failed.len);
  let elapsed=str.fromi64(run.finishedat-run.startedat);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat("overnight batch window:";windowstr);
              str.concat(" | jobs:";jobcount));
            str.concat(" | completed:";okcount));
          str.concat(" | failed:";failcount));
        " | elapsed:");
      elapsed);
    "s")
};

m=core.agents.overnight;

i=t:shared.types;
i=log:shared.log;
i=str:std.str;
i=reg:core.agents.registry;
i=sched:core.agents.scheduler;
i=lat:core.agents.latency;

t=$overnightwindow{
  starthour:i32;
  endhour:i32
};

t=$batchjob{
  agentname:str;
  priority:i32;
  estimatedminutes:i32
};

t=$batchrun{
  window:$overnightwindow;
  jobs:@$batchjob;
  completed:@str;
  failed:@str;
  startedat:i64;
  finishedat:i64
};


f=defaultwindow():$overnightwindow{
  <$overnightwindow{
    starthour:22;
    endhour:6
  }
};



f=isovernight(hour:i32;window:$overnightwindow):bool{
  if(hour>window.starthour){
    <true
  }el{};
  <hour<window.endhour
};



f=collectovernightagents(reg:i64;assignments:@i64):@$batchjob{
  let enabled=reg.listenabled(reg);
  let count=enabled.len;
  let jobs=mut.@();
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let agent=t.arrayget(enabled;i);
    let cls=lat.classforagent(assignments;agent.name);
    if(str.eq(cls.name;"background")){
      let job=$batchjob{
        agentname:agent.name;
        priority:1;
        estimatedminutes:30
      };
      jobs=@(jobs;job)
    }el{};
    i=i+1
  };
  <jobs
};




f=runbatch(jobs:@$batchjob;reg:i64):$batchrun{
  let started=t.nowi64();
  let count=jobs.len;
  let sorted=mut.jobs;
  let i=mut.1;
  lp(let lv=0;i<count;lv=lv){
    let j=mut.i;
    lp(let lv2=0;j>0;lv2=lv2){
      let a=t.arrayget(sorted;j-1);
      let b=t.arrayget(sorted;j);
      if(a.priority>b.priority){
        sorted=t.arrayswap(sorted;j-1;j);
        j=j-1
      }el{
        j=0
      }
    };
    i=i+1
  };
  let completed=mut.@();
  let failed=mut.@();
  let k=mut.0;
  lp(let lv=0;k<count;lv=lv){
    let job=t.arrayget(sorted;k);
    log.info(
      str.concat("overnight batch: running agent ";job.agentname);
      "overnight";
      job.agentname
    );
    let findresult=reg.find(reg;job.agentname);
    let findok=mt findresult {
      $ok:v true;
      $err:e false
    };
    if(findok){
      log.info(
        str.concat("overnight batch: completed agent ";job.agentname);
        "overnight";
        job.agentname
      );
      completed=@(completed;job.agentname)
    }el{
      log.error(
        str.concat("overnight batch: agent not found: ";job.agentname);
        "overnight";
        job.agentname
      );
      failed=@(failed;job.agentname)
    };
    k=k+1
  };
  let finished=t.nowi64();
  <$batchrun{
    window:defaultwindow();
    jobs:sorted;
    completed:completed;
    failed:failed;
    startedat:started;
    finishedat:finished
  }
};


f=formatbatchrun(run:$batchrun):str{
  let windowstr=str.concat(
    str.concat(
      str.concat(
        str.concat(str.fromi32(run.window.starthour);"h–");
        str.fromi32(run.window.endhour));
      "h")
    ;""
  );
  let jobcount=str.fromi32(run.jobs.len);
  let okcount=str.fromi32(run.completed.len);
  let failcount=str.fromi32(run.failed.len);
  let elapsed=str.fromi64(run.finishedat-run.startedat);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat("overnight batch window:";windowstr);
              str.concat(" | jobs:";jobcount));
            str.concat(" | completed:";okcount));
          str.concat(" | failed:";failcount));
        " | elapsed:");
      elapsed);
    "s")
};

m=core.agents.overnight;



i=t:shared.types;
i=log:shared.log;
i=reg:agents.registry;
i=sched:agents.scheduler;
i=lat:agents.latency;

t=$overnightwindow{
  starthour:i32;
  endhour:i32
};

t=$batchjob{
  agentname:str;
  priority:i32;
  estimatedminutes:i32
};

t=$batchrun{
  window:$overnightwindow;
  jobs:@$batchjob;
  completed:@(str);
  failed:@(str);
  startedat:i64;
  finishedat:i64
};


let defaultwindow=$overnightwindow{
  starthour:22;
  endhour:6
};



f=isovernight(hour:i32;window:$overnightwindow):bool{
  <hour>=window.starthour||hour<window.endhour
};



f=collectovernightagents(reg:reg.$agentregistry;assignments:@(lat.$latencyassignment)):@$batchjob{
  let enabled=reg.listenabled(reg);
  let count=enabled.len;
  let jobs=@();
  let i=0;
  loop{
    if i>=count{
      break
    }else{
      let agent=t.arrayget(enabled;i);
      let class=lat.classforagent(assignments;agent.name);
      if str.eq(class.name;"background"){
        let job=$batchjob{
          agentname:agent.name;
          priority:1;
          estimatedminutes:30
        };
        jobs=@(jobs;job)
      }else{
        
      };
      i=i+1
    };
  };
  <jobs
};




f=runbatch(jobs:@$batchjob;reg:reg.$agentregistry):$batchrun{
  let started=t.nowi64();

  
  let count=jobs.len;
  let sorted=jobs;
  let i=1;
  loop{
    if i>=count{
      break
    }else{
      let j=i;
      loop{
        if j==0{
          break
        }else{
          let a=t.arrayget(sorted;j-1);
          let b=t.arrayget(sorted;j);
          if a.priority>b.priority{
            sorted=t.arrayswap(sorted;j-1;j);
            j=j-1
          }else{
            j=0
          };
        };
      };
      i=i+1
    };
  };

  let completed=@();
  let failed=@();
  let k=0;
  loop{
    if k>=count{
      break
    }else{
      let job=t.arrayget(sorted;k);
      log.info(
        str.concat("overnight batch: running agent ";job.agentname);
        "overnight_batch";
        job.agentname
      );
      let findresult=reg.find(reg;job.agentname);
      mt findresult {
        $t.lokeerr e;
          log.error(
            str.concat("overnight batch: agent not found: ";job.agentname);
            "overnight_batch";
            job.agentname
          );
          failed=@(failed;job.agentname);
          k=k+1;
        agent;
          
          log.info(
            str.concat("overnight batch: completed agent ";job.agentname);
            "overnight_batch";
            job.agentname
          );
          completed=@(completed;job.agentname);
          k=k+1
      };
    };
  };

  let finished=t.nowi64();
  <$batchrun{
    window:defaultwindow;
    jobs:sorted;
    completed:completed;
    failed:failed;
    startedat:started;
    finishedat:finished
  };
};


f=formatbatchrun(run:$batchrun):str{
  let windowstr=str.concat(
    str.concat(
      str.concat(
        str.concat(str.fromi32(run.window.starthour);"h–");
        str.fromi32(run.window.endhour));
      "h")
    ;""
  );
  let jobcount=str.fromi32(run.jobs.len);
  let okcount=str.fromi32(run.completed.len);
  let failcount=str.fromi32(run.failed.len);
  let elapsed=str.fromi64(run.finishedat-run.startedat);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat("overnight batch window:";windowstr);
              str.concat(" | jobs:";jobcount));
            str.concat(" | completed:";okcount));
          str.concat(" | failed:";failcount));
        " | elapsed:");
      elapsed);
    "s")
};

m=core.agents.latency;



i=t:shared.types;
i=log:shared.log;

t=$latencyclass{
  name:str;
  maxseconds:i32;
  description:str
};

t=$latencyassignment{
  agentname:str;
  classname:str;
  assignedat:i64
};


f=latencyinteractive():$latencyclass{
  <$latencyclass{
    name:"interactive";
    maxseconds:10;
    description:"User is waiting — respond within 10s"
  }
};


f=latencyconsidered():$latencyclass{
  <$latencyclass{
    name:"considered";
    maxseconds:60;
    description:"Background but prompt — complete within 1 min"
  }
};


f=latencybackground():$latencyclass{
  <$latencyclass{
    name:"background";
    maxseconds:3600;
    description:"Overnight batch — complete within 1 hour"
  }
};


f=assign(agentname:str;classname:str):$latencyassignment{
  <$latencyassignment{
    agentname:agentname;
    classname:classname;
    assignedat:t.nowi64()
  }
};



f=classforagent(assignments:@$latencyassignment;agentname:str):$latencyclass{
  let count=assignments.len;
  let i=mut.0;
  let found=mut.false;
  let result=mut.latencybackground();
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let a=t.arrayget(assignments;i);
      if(str.eq(a.agentname;agentname)){
        if(str.eq(a.classname;"interactive")){
          result=latencyinteractive();
          found=true
        }el{
          if(str.eq(a.classname;"considered")){
            result=latencyconsidered();
            found=true
          }el{
            result=latencybackground();
            found=true
          }
        };
        i=count;
      }el{
        i=i+1;
      }
    }
  };
  <result
};


f=iswithintolerance(class:$latencyclass;elapsedseconds:i32):bool{
  <elapsedseconds<=class.maxseconds
};


f=formatassignment(a:$latencyassignment):str{
  let class=classforagent(@($a);a.agentname);
  let maxstr=str.fromi32(class.maxseconds);
  <str.concat(
    str.concat(
      str.concat(
        str.concat("agent:";a.agentname);
        " → class:");
      a.classname);
    str.concat(
      " (latency tolerance: ";
      str.concat(maxstr;"s)")))
};

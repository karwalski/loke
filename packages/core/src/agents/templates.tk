m=core.agents.templates;



i=t:shared.types;
i=at:core.agents.types;
i=reg:core.agents.registry;
i=str:std.str;
i=log:shared.log;


f=alltemplates():@$agentdef{
  let dailydigest=$agentdef{
    id:"daily-digest";
    name:"Daily Digest";
    description:"Summarises activity from the past 24 hours";
    schedule:"0 7 * * *";
    trigger:$schedule("0 7 * * *");
    modelpreference:"qwen2.5:7b";
    latencytolerance:0;
    risklevel:"low";
    permissions:@(
      $readfile("~/.loke/");
      $model("qwen2.5:7b")
    );
    maxcostperrun:0.05;
    requiresapproval:false;
    owner:"";
    enabled:false;
    prompttemplate:"Summarise the key events, decisions, and outputs from the past 24 hours. Be concise and focus on what matters for today's work. Context: {{context}}"
  };

  let nightlycodereviewer=$agentdef{
    id:"nightly-code-reviewer";
    name:"Nightly Code Reviewer";
    description:"Reviews today's code commits";
    schedule:"0 23 * * *";
    trigger:$schedule("0 23 * * *");
    modelpreference:"qwen2.5:72b";
    latencytolerance:0;
    risklevel:"low";
    permissions:@(
      $readfile("./");
      $model("qwen2.5:72b")
    );
    maxcostperrun:0.50;
    requiresapproval:false;
    owner:"";
    enabled:false;
    prompttemplate:"Review the following code changes for quality, security issues, and correctness. Provide specific, actionable feedback. Context: {{context}}"
  };

  let docfreshnesschecker=$agentdef{
    id:"doc-freshness-checker";
    name:"Doc Freshness Checker";
    description:"Checks if documentation matches code";
    schedule:"0 1 * * 1";
    trigger:$schedule("0 1 * * 1");
    modelpreference:"qwen2.5:72b";
    latencytolerance:0;
    risklevel:"low";
    permissions:@(
      $readfile("./");
      $model("qwen2.5:72b")
    );
    maxcostperrun:0.30;
    requiresapproval:false;
    owner:"";
    enabled:false;
    prompttemplate:"Check if the documentation accurately reflects the current codebase. Identify outdated sections, missing documentation, and inaccurate descriptions. Context: {{context}}"
  };

  let weeklysecurityscan=$agentdef{
    id:"weekly-security-scan";
    name:"Weekly Security Scan";
    description:"Security analysis of dependencies and code";
    schedule:"0 2 * * 0";
    trigger:$schedule("0 2 * * 0");
    modelpreference:"qwen2.5:72b";
    latencytolerance:0;
    risklevel:"medium";
    permissions:@(
      $readfile("./");
      $httpget("https://osv.dev");
      $model("qwen2.5:72b")
    );
    maxcostperrun:1.00;
    requiresapproval:false;
    owner:"";
    enabled:false;
    prompttemplate:"Perform a security review of the codebase and dependencies. Look for: common vulnerabilities, hardcoded secrets, insecure patterns, outdated dependencies. Report findings by severity. Context: {{context}}"
  };

  let meetingprep=$agentdef{
    id:"meeting-prep";
    name:"Meeting Prep";
    description:"Prepares briefing before meetings";
    schedule:"";
    trigger:$manual;
    modelpreference:"qwen2.5:7b";
    latencytolerance:0;
    risklevel:"low";
    permissions:@(
      $readfile("~/.loke/");
      $model("qwen2.5:7b")
    );
    maxcostperrun:0.10;
    requiresapproval:false;
    owner:"";
    enabled:false;
    prompttemplate:"Prepare a concise briefing for the upcoming meeting. Include: relevant context from memory, open questions, key decisions needed, suggested agenda. Context: {{context}}"
  };

  let expensecategoriser=$agentdef{
    id:"expense-categoriser";
    name:"Expense Categoriser";
    description:"Categorises expenses from receipts/statements";
    schedule:"";
    trigger:$manual;
    modelpreference:"qwen2.5:7b";
    latencytolerance:0;
    risklevel:"low";
    permissions:@(
      $model("qwen2.5:7b")
    );
    maxcostperrun:0.05;
    requiresapproval:false;
    owner:"";
    enabled:false;
    prompttemplate:"Categorise the following expenses into: Travel, Software, Hardware, Meals, Other. Return a JSON array with amount, merchant, category, date for each item. Context: {{context}}"
  };

  let documentationupdater=$agentdef{
    id:"documentation-updater";
    name:"Documentation Updater";
    description:"Updates docs based on code changes";
    schedule:"";
    trigger:$manual;
    modelpreference:"qwen2.5:72b";
    latencytolerance:0;
    risklevel:"low";
    permissions:@(
      $readfile("./");
      $writefile("./docs/");
      $model("qwen2.5:72b")
    );
    maxcostperrun:0.50;
    requiresapproval:true;
    owner:"";
    enabled:false;
    prompttemplate:"Update the documentation to reflect the code changes provided. Maintain the existing style and format. Mark any sections where human review is recommended. Context: {{context}}"
  };

  <@(
    dailydigest;
    nightlycodereviewer;
    docfreshnesschecker;
    weeklysecurityscan;
    meetingprep;
    expensecategoriser;
    documentationupdater
  )
};


f=findtemplate(id:str):i64!$lokeerr{
  let templates=alltemplates();
  let count=templates.len;
  let i=mut.0;
  let tmpl=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      <$configerr(str.concat("template not found: ";id))
    }el{
      tmpl=str.arrayget(templates;i);
      if(str.eq(tmpl.id;id)){
        <tmpl
      }el{
        i=i+1
      }
    }
  }
};


f=install(id:str;registry:$agentregistry):void!$lokeerr{
  let tmplresult=findtemplate(id);
  let tmpl=mt tmplresult {
    $lokeerr:e $err($configerr(e));
    $ok:tmpl tmpl
  };
  let regresult=reg.register(registry;tmpl);
  mt regresult {
    $lokeerr:e $err($configerr(e));
    $ok:v void
  };
  log.info(str.concat("installed agent template: ";id);"templates";id);
  <$ok(void)
};


f=listtemplates():str{
  let header="Available templates:
";
  let templates=alltemplates();
  let count=templates.len;
  let rows=mut."";
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let tmpl=str.arrayget(templates;i);
      let lat=mt tmpl.latencytolerance {
        $instant:v "instant";
        $patient:v "patient";
        $background:v "background"
      };
      let coststr=str.concat("max $";str.fromfloat(tmpl.maxcostperrun));
      let descshort=str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat("(";lat);
              ", "
            );
            tmpl.modelpreference
          );
          ", "
        );
        str.concat(coststr;")")
      );
      let idpad=str.concat(str.concat("  ";tmpl.id);"  ");
      let descline=str.concat(str.concat(tmpl.description;" ");descshort);
      let row=str.concat(str.concat(str.concat(idpad;descline);"
");"");
      rows=str.concat(rows;row);
      i=i+1
    }
  };
  let footer="Install with: loke agents install <template-name>";
  <str.concat(str.concat(header;rows);footer)
};

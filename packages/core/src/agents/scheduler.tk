m=core.agents.scheduler;



i=at:core.agents.types;
i=reg:core.agents.registry;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;

t=$schedulecheck{
  agentid:str;
  shouldrun:bool;
  reason:str
};





f=checkcron(agentid:str;cron:str):$schedulecheck{
  let shouldrun=mut.false;
  if(str.eq(cron;"0 * * * *")){ shouldrun=true
  }el{ if(str.eq(cron;"0 2 * * *")){ shouldrun=true
  }el{ if(str.eq(cron;"0 2 * * 0")){ shouldrun=true
  }el{} }};
  let reason=mut."schedule check pending full cron parser";
  if(!shouldrun){ reason=str.concat("unrecognised cron pattern: ";cron) }el{};
  <$schedulecheck{agentid:agentid;shouldrun:shouldrun;reason:reason}
};

f=checkdue(agent:$agentdef;currenttimeepoch:u64):$schedulecheck{
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let triggerv:$triggertype=agent.trigger;
  <mt triggerv {
    $manual:v $schedulecheck{agentid:agent.id;shouldrun:false;reason:"manual trigger — does not auto-fire"};
    $schedule:cron checkcron(agent.id;cron);
    $filechange:path $schedulecheck{agentid:agent.id;shouldrun:false;reason:"filechange trigger — file watching handled separately"};
    $webhook:path $schedulecheck{agentid:agent.id;shouldrun:false;reason:"webhook trigger — event-driven"};
    $mcpevent:name $schedulecheck{agentid:agent.id;shouldrun:false;reason:"mcpevent trigger — event-driven"}
  }
};


f=checkalldue(registry:$agentregistry;currenttimeepoch:u64):@$schedulecheck{
  let enabled=reg.listenabled(registry);
  let count=enabled.len;
  let result=mut.@();
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let check=checkdue(enabled.get(i);currenttimeepoch);
      if(check.shouldrun){
        result=result.push(check)
      }el{
        result=result
      };
      i=i+1
    }
  };
  <result
};


(* The recorded registry is returned alongside the run: reg.recordrun gives back a
   new registry and the old call discarded it, so no manual run was ever recorded. *)
f=triggermanualrun(registry:$agentregistry;agent:$agentdef;agentid:str;cid:str):$agentrun!$lokeerr{
  let run=at.newrun(agentid;"manual");
  log.info("manual trigger fired for agent: \(agentid), runs now \(reg.recordrun(registry;run).runs.len)";"scheduler";cid);
  <run
};

(* F10.39: declared `i64!$lokeerr` while its ok arm is the `$agentrun!$lokeerr` of
   triggermanualrun, which toke 3.1.0 rejects (E4031). It answers the run it started. *)
f=triggermanual(registry:$agentregistry;agentid:str;cid:str):$agentrun!$lokeerr{
  (* AG1.9: has/get. A match on reg.find took the first arm whatever it held (T-18), so a
     manual trigger for an unknown agent RAN, on whatever the error value decoded to. *)
  if(!reg.has(registry;agentid)){
    log.warn(str.concat("manual trigger refused, agent not found: ";agentid);"scheduler";cid);
    <$err($configerr(str.concat("agent not found: ";agentid)))
  }el{};
  (* Only reached once `has` has confirmed the agent exists, so find's first arm, the one
     T-18 always takes, is the right one. *)
  <mt reg.find(registry;agentid) {
    $ok:agent triggermanualrun(registry;agent;agentid;cid);
    $lokeerr:e $err($configerr(str.concat("agent not found: ";agentid)))
  }
};

m=core.agents.scheduler;



i=t:shared.types;
i=at:core.agents.types;
i=reg:core.agents.registry;
i=str:std.str;
i=log:shared.log;

t=$schedulecheck{
  agentid:str;
  shouldrun:bool;
  reason:str
};





f=checkdue(agent:$at.agentdef;currenttimeepoch:u64):$schedulecheck{
  mt agent.trigger {
    $at.triggertype.$manual;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"manual trigger — does not auto-fire"
      };
    $at.triggertype.$schedule cron;
      
      if(str.eq(cron;"0 * * * *")){
        <$schedulecheck{
          agentid:agent.id;
          shouldrun:true;
          reason:"schedule check pending full cron parser"
        };
      }else{
        if(str.eq(cron;"0 2 * * *")){
          <$schedulecheck{
            agentid:agent.id;
            shouldrun:true;
            reason:"schedule check pending full cron parser"
          };
        }else{
          if(str.eq(cron;"0 2 * * 0")){
            <$schedulecheck{
              agentid:agent.id;
              shouldrun:true;
              reason:"schedule check pending full cron parser"
            };
          }else{
            <$schedulecheck{
              agentid:agent.id;
              shouldrun:false;
              reason:str.concat("unrecognised cron pattern: ";cron)
            };
          };
        };
      };
    $at.triggertype.$filechange path;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"file_change trigger — file watching handled separately"
      };
    $at.triggertype.$webhook path;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"webhook trigger — event-driven"
      };
    $at.triggertype.$mcpevent name;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"mcp_event trigger — event-driven"
      };
  };
};


f=checkalldue(registry:$reg.agentregistry;currenttimeepoch:u64):@$schedulecheck{
  let enabled=reg.listenabled(registry);
  let count=enabled.len;
  let result=@();
  let i=0;
  loop{
    if(i>=count){
      break
    }else{
      let agent=str.arrayget(enabled;i);
      let check=checkdue(agent;currenttimeepoch);
      if(check.shouldrun){
        result=@(result;check)
      }else{
        
      };
      i=i+1;
    };
  };
  <result
};


f=triggermanual(registry:mut $reg.agentregistry;agentid:str;cid:str):$at.agentrun|$t.lokeerr{
  let agentresult=reg.find(registry;agentid);
  mt agentresult {
    $t.lokeerr e;
      log.error(str.concat("trigger_manual: agent not found: ";agentid);"scheduler";cid);
      <$t.lokeerr.$configerr(str.concat("agent not found: ";agentid))
    agent;
      let run=at.newrun(agentid;"manual");
      reg.recordrun(registry;run);
      log.info(str.concat("manual trigger fired for agent: ";agentid);"scheduler";cid);
      <run
  };
};

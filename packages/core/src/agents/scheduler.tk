m=core.agents.scheduler;



i=t:shared.types;
i=at:core.agents.types;
i=reg:core.agents.registry;
i=str:std.str;
i=log:shared.log;

t=$schedulecheck{
  agentid:str;
  shouldrun:bool;
  reason:str
};





f=checkcron(agentid:str;cron:str):$schedulecheck{
  let shouldrun=mut.false;
  if(str.eq(cron;"0 * * * *")){ shouldrun=true
  }el{ if(str.eq(cron;"0 2 * * *")){ shouldrun=true
  }el{ if(str.eq(cron;"0 2 * * 0")){ shouldrun=true
  }el{} }};
  let reason=mut."schedule check pending full cron parser";
  if(!shouldrun){ reason=str.concat("unrecognised cron pattern: ";cron) }el{};
  <$schedulecheck{agentid:agentid;shouldrun:shouldrun;reason:reason}
};

f=checkdue(agent:i64;currenttimeepoch:u64):$schedulecheck{
  mt agent.trigger {
    $manual:v $schedulecheck{agentid:agent.id;shouldrun:false;reason:"manual trigger — does not auto-fire"};
    $schedule:cron checkcron(agent.id;cron);
    $filechange:path $schedulecheck{agentid:agent.id;shouldrun:false;reason:"filechange trigger — file watching handled separately"};
    $webhook:path $schedulecheck{agentid:agent.id;shouldrun:false;reason:"webhook trigger — event-driven"};
    $mcpevent:name $schedulecheck{agentid:agent.id;shouldrun:false;reason:"mcpevent trigger — event-driven"}
  }
};


f=checkalldue(registry:i64;currenttimeepoch:u64):@$schedulecheck{
  let enabled=reg.listenabled(registry);
  let count=enabled.len;
  let result=mut.@();
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let agent=str.arrayget(enabled;i);
      let check=checkdue(agent;currenttimeepoch);
      if(check.shouldrun){
        result=@(result;check)
      }el{
        result=result
      };
      i=i+1
    }
  };
  <result
};


f=triggermanualrun(registry:$agentregistry;agent:i64;agentid:str;cid:str):i64!$lokeerr{
  let run=at.newrun(agentid;"manual");
  reg.recordrun(registry;run);
  log.info(str.concat("manual trigger fired for agent: ";agentid);"scheduler";cid);
  <run
};

f=triggermanual(registry:$agentregistry;agentid:str;cid:str):i64!$lokeerr{
  let agentresult=reg.find(registry;agentid);
  mt agentresult {
    $lokeerr:e $err($configerr(str.concat("agent not found: ";agentid)));
    $ok:agent triggermanualrun(registry;agent;agentid;cid)
  }
};

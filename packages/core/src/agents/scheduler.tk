m=core.agents.scheduler;



i=t:shared.types;
i=at:core.agents.types;
i=reg:core.agents.registry;
i=str:std.str;
i=log:shared.log;

t=$schedulecheck{
  agentid:str;
  shouldrun:bool;
  reason:str
};





f=checkdue(agent:i64;currenttimeepoch:u64):$schedulecheck{
  mt agent.trigger {
    $triggertype.$manual;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"manual trigger — does not auto-fire"
      };
    $triggertype.$schedule:cron;
      
      if(str.eq(cron;"0 * * * *")){
        <$schedulecheck{
          agentid:agent.id;
          shouldrun:true;
          reason:"schedule check pending full cron parser"
        }
      }el{
        if(str.eq(cron;"0 2 * * *")){
          <$schedulecheck{
            agentid:agent.id;
            shouldrun:true;
            reason:"schedule check pending full cron parser"
          }
        }el{
          if(str.eq(cron;"0 2 * * 0")){
            <$schedulecheck{
              agentid:agent.id;
              shouldrun:true;
              reason:"schedule check pending full cron parser"
            }
          }el{
            <$schedulecheck{
              agentid:agent.id;
              shouldrun:false;
              reason:str.concat("unrecognised cron pattern: ";cron)
            }
          }
        }
      };
    $triggertype.$filechange:path;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"file_change trigger — file watching handled separately"
      };
    $triggertype.$webhook:path;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"webhook trigger — event-driven"
      };
    $triggertype.$mcpevent:name;
      <$schedulecheck{
        agentid:agent.id;
        shouldrun:false;
        reason:"mcp_event trigger — event-driven"
      }
  }
};


f=checkalldue(registry:i64;currenttimeepoch:u64):@$schedulecheck{
  let enabled=reg.listenabled(registry);
  let count=enabled.len;
  let result=@();
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let agent=str.arrayget(enabled;i);
      let check=checkdue(agent;currenttimeepoch);
      if(check.shouldrun){
        result=@(result;check)
      }el{
        
      };
      i=i+1;
    }
  };
  <result
};


f=triggermanual(registry:$agentregistry;agentid:str;cid:str):i64|$lokeerr{
  let agentresult=reg.find(registry;agentid);
  mt agentresult {
    $lokeerr e;
      log.error(str.concat("trigger_manual: agent not found: ";agentid);"scheduler";cid);
      <$lokeerr.$configerr(str.concat("agent not found: ";agentid))
    agent;
      let run=at.newrun(agentid;"manual");
      reg.recordrun(registry;run);
      log.info(str.concat("manual trigger fired for agent: ";agentid);"scheduler";cid);
      <run
  }
};

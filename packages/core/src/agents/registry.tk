m=core.agents.registry;



i=t:shared.types;
i=at:core.agents.types;
i=govuc:core.governance.usecases;
i=str:std.str;
i=log:shared.log;

t=$agentregistry{
  agents:@($at.agentdef);
  runs:@($at.agentrun)
};


f=newregistry():$agentregistry{
  <$agentregistry{
    agents:@();
    runs:@()
  };
};




f=register(reg:mut $agentregistry;agent:$at.agentdef):void|$t.lokeerr{
  if str.eq(agent.name;""){
    <$t.lokeerr.$configerr("agent must have a name")
  }else{
    if str.eq(agent.prompttemplate;""){
      <$t.lokeerr.$configerr("agent must have a prompt template")
    }else{
      if agent.maxcostperrun>10.0{
        log.warn(str.concat("agent max_cost_per_run exceeds $10: ";agent.id);"agent_registry";agent.id)
      }else{
        
      };
      reg.agents=@(reg.agents;agent);
      log.info(str.concat("agent registered: ";agent.id);"agent_registry";agent.id);
      <$ok(void)
    };
  };
};


f=find(reg:$agentregistry;id:str):$at.agentdef|$t.lokeerr{
  let count=reg.agents.len;
  let i=0;
  loop{
    if i>=count{
      <$t.lokeerr.$configerr(str.concat("agent not found: ";id))
    }else{
      let agent=str.arrayget(reg.agents;i);
      if str.eq(agent.id;id){
        <agent
      }else{
        i=i+1
      };
    };
  };
};


f=enable(reg:mut $agentregistry;id:str):void|$t.lokeerr{
  let count=reg.agents.len;
  let i=0;
  let found=false;
  let newagents=@();
  loop{
    if i>=count{
      break
    }else{
      let agent=str.arrayget(reg.agents;i);
      if str.eq(agent.id;id){
        let updated=$at.agentdef{
          id:agent.id;
          name:agent.name;
          description:agent.description;
          schedule:agent.schedule;
          trigger:agent.trigger;
          modelpreference:agent.modelpreference;
          latencytolerance:agent.latencytolerance;
          risklevel:agent.risklevel;
          permissions:agent.permissions;
          maxcostperrun:agent.maxcostperrun;
          requiresapproval:agent.requiresapproval;
          owner:agent.owner;
          enabled:true;
          prompttemplate:agent.prompttemplate
        };
        newagents=@(newagents;updated);
        found=true;
        i=i+1
      }else{
        newagents=@(newagents;agent);
        i=i+1
      };
    };
  };
  if found{
    reg.agents=newagents;
    log.info(str.concat("agent enabled: ";id);"agent_registry";id);
    <$ok(void)
  }else{
    <$t.lokeerr.$configerr(str.concat("agent not found: ";id))
  };
};


f=disable(reg:mut $agentregistry;id:str):void|$t.lokeerr{
  let count=reg.agents.len;
  let i=0;
  let found=false;
  let newagents=@();
  loop{
    if i>=count{
      break
    }else{
      let agent=str.arrayget(reg.agents;i);
      if str.eq(agent.id;id){
        let updated=$at.agentdef{
          id:agent.id;
          name:agent.name;
          description:agent.description;
          schedule:agent.schedule;
          trigger:agent.trigger;
          modelpreference:agent.modelpreference;
          latencytolerance:agent.latencytolerance;
          risklevel:agent.risklevel;
          permissions:agent.permissions;
          maxcostperrun:agent.maxcostperrun;
          requiresapproval:agent.requiresapproval;
          owner:agent.owner;
          enabled:false;
          prompttemplate:agent.prompttemplate
        };
        newagents=@(newagents;updated);
        found=true;
        i=i+1
      }else{
        newagents=@(newagents;agent);
        i=i+1
      };
    };
  };
  if found{
    reg.agents=newagents;
    log.info(str.concat("agent disabled: ";id);"agent_registry";id);
    <$ok(void)
  }else{
    <$t.lokeerr.$configerr(str.concat("agent not found: ";id))
  };
};


f=list(reg:$agentregistry):@($at.agentdef){
  <reg.agents
};


f=listenabled(reg:$agentregistry):@($at.agentdef){
  let result=@();
  let count=reg.agents.len;
  let i=0;
  loop{
    if i>=count{
      break
    }else{
      let agent=str.arrayget(reg.agents;i);
      if agent.enabled{
        result=@(result;agent)
      }else{
        
      };
      i=i+1
    };
  };
  <result
};


f=recordrun(reg:mut $agentregistry;run:$at.agentrun):void{
  reg.runs=@(reg.runs;run)
};


f=getruns(reg:$agentregistry;agentid:str):@($at.agentrun){
  
  let matched=@();
  let count=reg.runs.len;
  let i=0;
  loop{
    if i>=count{
      break
    }else{
      let run=str.arrayget(reg.runs;i);
      if str.eq(run.agentid;agentid){
        matched=@(matched;run)
      }else{
        
      };
      i=i+1
    };
  };
  
  let reversed=@();
  let mc=matched.len;
  let j=mc;
  loop{
    if j==0{
      break
    }else{
      j=j-1;
      let run=str.arrayget(matched;j);
      reversed=@(reversed;run)
    };
  };
  <reversed
};

m=core.agents.registry;



i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=at:core.agents.types;

t=$agentregistry{
  agents:@$agentdef;
  runs:@$agentrun
};


(* Declared i64!$lokeerr, not void!$lokeerr, and returns $ok(0).

   toke lowers a `void!$err` success type to LLVM `void`, so any call site that binds
   the result — a match arm, for instance — emits `alloca void` and clang rejects the
   module with "void type only allowed for function results". Filed as T-5 in
   docs/upstream/toke-issues.md, same family as T-1 ($ok(<bool>)): only an i64-width
   success type survives the `!$err` lowering today. *)
f=newregistry():$agentregistry{
  <$agentregistry{
    agents:@();
    runs:@()
  }
};




f=register(reg:$agentregistry;agent:$agentdef):$agentregistry!$lokeerr{
  if(str.eq(agent.name;"")){
    <$configerr("agent must have a name")
  }el{
    if(str.eq(agent.prompttemplate;"")){
      <$configerr("agent must have a prompt template")
    }el{
      if(agent.maxcostperrun>10.0){
        log.warn(str.concat("agent max_cost_per_run exceeds $10: ";agent.id);"agent_registry";agent.id)
      }el{
        log.info("cost ok";"agent_registry";agent.id)
      };
      log.info(str.concat("agent registered: ";agent.id);"agent_registry";agent.id);
      <$ok($agentregistry{ agents:reg.agents.push(agent); runs:reg.runs })
    }
  }
};


f=find(reg:$agentregistry;id:str):i64!$lokeerr{
  let count=reg.agents.len;
  let i=mut.0;
  let agent=mut.str.arrayget(reg.agents;0);
  lp(let lv=0;true;lv=lv){
    if(i>count){
      <$configerr(str.concat("agent not found: ";id))
    }el{
      agent=str.arrayget(reg.agents;i);
      if(str.eq(agent.id;id)){
        <agent
      }el{
        i=i+1
      }
    }
  }
};


(* ── enable and disable reported success and changed nothing ──────────────────────
   Both built `newagents` correctly — the loop above rebuilds the array with the one agent's
   `enabled` flag flipped — and then threw it away:

       reg.agents==newagents;          (* a COMPARISON, discarded *)
       <$ok(0)

   toke has no assignment to a struct field (T-26), and `==` where `=` was meant is a legal
   expression statement. So the registry was never updated, and the function returned `$ok(0)`:
   **it reported success for work it had not done.** `listenabled` then returned the same set it
   always had, whatever anyone enabled.

   Returning `$agentregistry` is the fix toke allows. The old `i64!$lokeerr` was doubly useless
   here: it carried no updated registry, and its error side is a user-declared sum, whose
   discriminant toke never reads (T-18) — so `$ok` versus `$configerr` could not be told apart
   by any caller regardless. A not-found id now returns the registry UNCHANGED, and `has` is how
   a caller asks first. That is the sentinel-plus-predicate idiom this codebase uses everywhere
   T-18 forces it (`cache.ishit`, `rtr.isrouted`, `discovery.isserver`).

   No cross-module callers of either function exist (checked), so nothing breaks. *)
f=has(reg:$agentregistry;id:str):bool{
  let found=mut.false;
  lp(let i=0;i<reg.agents.len;i=i+1){
    let a:$agentdef=reg.agents.get(i);
    if(str.eq(a.id;id)){ found=true }el{}
  };
  <found
};

f=enable(reg:$agentregistry;id:str):$agentregistry{
  let count=reg.agents.len;
  let i=mut.0;
  let found=mut.false;
  let newagents=mut.@();
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let agent=reg.agents.get(i);
      if(str.eq(agent.id;id)){
        let updated=$agentdef{
          id:agent.id;
          name:agent.name;
          description:agent.description;
          schedule:agent.schedule;
          trigger:agent.trigger;
          modelpreference:agent.modelpreference;
          latencytolerance:agent.latencytolerance;
          risklevel:agent.risklevel;
          permissions:agent.permissions;
          maxcostperrun:agent.maxcostperrun;
          requiresapproval:agent.requiresapproval;
          owner:agent.owner;
          enabled:true;
          prompttemplate:agent.prompttemplate
        };
        newagents=newagents.push(updated);
        found=true;
        i=i+1
      }el{
        newagents=newagents.push(agent);
        i=i+1
      }
    }
  };
  if(found){
    log.info(str.concat("agent enabled: ";id);"agent_registry";id)
  }el{
    log.warn(str.concat("agent not found, registry unchanged: ";id);"agent_registry";id)
  };
  <$agentregistry{ agents:newagents; runs:reg.runs }
};


f=disable(reg:$agentregistry;id:str):$agentregistry{
  let count=reg.agents.len;
  let i=mut.0;
  let found=mut.false;
  let newagents=mut.@();
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let agent=reg.agents.get(i);
      if(str.eq(agent.id;id)){
        let updated=$agentdef{
          id:agent.id;
          name:agent.name;
          description:agent.description;
          schedule:agent.schedule;
          trigger:agent.trigger;
          modelpreference:agent.modelpreference;
          latencytolerance:agent.latencytolerance;
          risklevel:agent.risklevel;
          permissions:agent.permissions;
          maxcostperrun:agent.maxcostperrun;
          requiresapproval:agent.requiresapproval;
          owner:agent.owner;
          enabled:false;
          prompttemplate:agent.prompttemplate
        };
        newagents=newagents.push(updated);
        found=true;
        i=i+1
      }el{
        newagents=newagents.push(agent);
        i=i+1
      }
    }
  };
  if(found){
    log.info(str.concat("agent disabled: ";id);"agent_registry";id)
  }el{
    log.warn(str.concat("agent not found, registry unchanged: ";id);"agent_registry";id)
  };
  <$agentregistry{ agents:newagents; runs:reg.runs }
};


f=list(reg:$agentregistry):@$agentdef{
  <reg.agents
};


f=listenabled(reg:$agentregistry):@$agentdef{
  let result=mut.@();
  let count=reg.agents.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let agent=reg.agents.get(i);
      if(agent.enabled){
        result=result.push(agent)
      }el{
        result=result
      };
      i=i+1
    }
  };
  <result
};


f=recordrun(reg:$agentregistry;run:$agentrun):$agentregistry{
  <$agentregistry{ agents:reg.agents; runs:reg.runs.push(run) }
};


f=getruns(reg:$agentregistry;agentid:str):@$agentrun{
  let matched=mut.@();
  let count=reg.runs.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let run=reg.runs.get(i);
      if(str.eq(run.agentid;agentid)){
        matched=matched.push(run)
      }el{
        matched=matched
      };
      i=i+1
    }
  };
  let reversed=mut.@();
  let mc=matched.len;
  let j=mut.mc;
  lp(let lv2=0;true;lv2=lv2){
    if(j==0){
      br
    }el{
      j=j-1;
      let run=str.arrayget(matched;j);
      reversed=reversed.push(run)
    }
  };
  <reversed
};

m=core.agents.registry;



i=t:shared.types;
i=at:core.agents.types;
i=govuc:core.governance.usecases;
i=str:std.str;
i=log:shared.log;

t=$agentregistry{
  agents:@$agentdef;
  runs:@$agentrun
};


f=newregistry():$agentregistry{
  <$agentregistry{
    agents:@();
    runs:@()
  }
};




f=register(reg:$agentregistry;agent:i64):void!$lokeerr{
  if(str.eq(agent.name;"")){
    <$lokeerr.$configerr("agent must have a name")
  }el{
    if(str.eq(agent.prompttemplate;"")){
      <$lokeerr.$configerr("agent must have a prompt template")
    }el{
      if(agent.maxcostperrun>10.0){
        log.warn(str.concat("agent max_cost_per_run exceeds $10: ";agent.id);"agent_registry";agent.id)
      }el{
        log.info("cost ok";"agent_registry";agent.id)
      };
      reg.agents=@(reg.agents;agent);
      log.info(str.concat("agent registered: ";agent.id);"agent_registry";agent.id);
      <$ok(void)
    }
  }
};


f=find(reg:$agentregistry;id:str):i64!$lokeerr{
  let count=reg.agents.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      <$lokeerr.$configerr(str.concat("agent not found: ";id))
    }el{
      let agent=str.arrayget(reg.agents;i);
      if(str.eq(agent.id;id)){
        <agent
      }el{
        i=i+1
      }
    }
  }
};


f=enable(reg:$agentregistry;id:str):void!$lokeerr{
  let count=reg.agents.len;
  let i=0;
  let found=false;
  let newagents=@();
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let agent=str.arrayget(reg.agents;i);
      if(str.eq(agent.id;id)){
        let updated=$agentdef{
          id:agent.id;
          name:agent.name;
          description:agent.description;
          schedule:agent.schedule;
          trigger:agent.trigger;
          modelpreference:agent.modelpreference;
          latencytolerance:agent.latencytolerance;
          risklevel:agent.risklevel;
          permissions:agent.permissions;
          maxcostperrun:agent.maxcostperrun;
          requiresapproval:agent.requiresapproval;
          owner:agent.owner;
          enabled:true;
          prompttemplate:agent.prompttemplate
        };
        newagents=@(newagents;updated);
        found=true;
        i=i+1
      }el{
        newagents=@(newagents;agent);
        i=i+1
      }
    }
  };
  if(found){
    reg.agents=newagents;
    log.info(str.concat("agent enabled: ";id);"agent_registry";id);
    <$ok(void)
  }el{
    <$lokeerr.$configerr(str.concat("agent not found: ";id))
  }
};


f=disable(reg:$agentregistry;id:str):void!$lokeerr{
  let count=reg.agents.len;
  let i=0;
  let found=false;
  let newagents=@();
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let agent=str.arrayget(reg.agents;i);
      if(str.eq(agent.id;id)){
        let updated=$agentdef{
          id:agent.id;
          name:agent.name;
          description:agent.description;
          schedule:agent.schedule;
          trigger:agent.trigger;
          modelpreference:agent.modelpreference;
          latencytolerance:agent.latencytolerance;
          risklevel:agent.risklevel;
          permissions:agent.permissions;
          maxcostperrun:agent.maxcostperrun;
          requiresapproval:agent.requiresapproval;
          owner:agent.owner;
          enabled:false;
          prompttemplate:agent.prompttemplate
        };
        newagents=@(newagents;updated);
        found=true;
        i=i+1
      }el{
        newagents=@(newagents;agent);
        i=i+1
      }
    }
  };
  if(found){
    reg.agents=newagents;
    log.info(str.concat("agent disabled: ";id);"agent_registry";id);
    <$ok(void)
  }el{
    <$lokeerr.$configerr(str.concat("agent not found: ";id))
  }
};


f=list(reg:$agentregistry):@$agentdef{
  <reg.agents
};


f=listenabled(reg:$agentregistry):@$agentdef{
  let result=@();
  let count=reg.agents.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let agent=str.arrayget(reg.agents;i);
      if(agent.enabled){
        result=@(result;agent)
      }el{
        result=result
      };
      i=i+1
    }
  };
  <result
};


f=recordrun(reg:$agentregistry;run:i64):void{
  reg.runs=@(reg.runs;run)
};


f=getruns(reg:$agentregistry;agentid:str):@$agentrun{
  let matched=@();
  let count=reg.runs.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let run=str.arrayget(reg.runs;i);
      if(str.eq(run.agentid;agentid)){
        matched=@(matched;run)
      }el{
        matched=matched
      };
      i=i+1
    }
  };
  let reversed=@();
  let mc=matched.len;
  let j=mc;
  lp(let lv=0;true;lv=lv){
    if(j=0){
      br
    }el{
      j=j-1;
      let run=str.arrayget(matched;j);
      reversed=@(reversed;run)
    }
  };
  <reversed
};

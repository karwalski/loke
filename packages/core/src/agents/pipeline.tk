m=core.agents.pipeline;



i=t:shared.types;
i=log:shared.log;
i=ex:agents.executor;
i=reg:agents.registry;

t=$pipelinestep{
  agentname:str;
  passoutput:bool;
  transform:str
};

t=$agentpipeline{
  name:str;
  steps:@$pipelinestep;
  createdat:i64
};

t=$pipelinerun{
  pipelinename:str;
  stepresults:@str;
  startedat:i64;
  finishedat:i64;
  ok:bool
};


f=newpipeline(name:str;steps:@$pipelinestep):$agentpipeline{
  <$agentpipeline{
    name:name;
    steps:steps;
    createdat:t.nowi64()
  };
};




f=runpipeline(pl:$agentpipeline;initialinput:str;reg:reg.$agentregistry):$pipelinerun{
  let started=t.nowi64();
  let stepresults=@();
  let currentinput=initialinput;
  let allok=true;
  let count=pl.steps.len;
  let i=0;
  loop{
    if(i>=count{
      break
    }else{
      let step=t.arrayget(pl.steps;i);
      log.info(
        str.concat("pipeline step: ";step.agentname);
        "agent_pipeline";
        pl.name
      );
      let findresult=reg.find(reg;step.agentname);
      mt findresult {
        $t.lokeerr e;
          let errmsg=str.concat("step failed — agent not found: ";step.agentname);
          log.error(errmsg;"agent_pipeline";pl.name);
          stepresults=@(stepresults;errmsg);
          allok=false;
          i=i+1;
        agent;
          
          let output=str.concat(
            str.concat(
              str.concat("[";step.agentname);
              "] processed: ");
            currentinput
          );
          stepresults=@(stepresults;output);
          if(step.passoutput{
            currentinput=output
          }else{
            
          };
          i=i+1
      };
    };
  };
  let finished=t.nowi64();
  <$pipelinerun{
    pipelinename:pl.name;
    stepresults:stepresults;
    startedat:started;
    finishedat:finished;
    ok:allok
  };
};


f=formatpipelinerun(run:$pipelinerun):str{
  let status=if(run.ok{ "OK" }else{ "FAILED" };
  let header=str.concat(
    str.concat(
      str.concat("pipeline: ";run.pipelinename);
      " — ");
    status
  );
  let count=run.stepresults.len;
  let i=0;
  let body=header;
  loop{
    if(i>=count{
      break
    }else{
      let result=t.arrayget(run.stepresults;i);
      let stepnum=str.fromi32(i+1);
      let line=str.concat(
        str.concat(
          str.concat("
  step ";stepnum);
          ": ");
        result
      );
      body=str.concat(body;line);
      i=i+1
    };
  };
  <body
};

m=core.agents.pipeline;



i=t:shared.types;
i=log:shared.log;
i=ex:core.agents.executor;
i=reg:agents.registry;

t=$pipelinestep{
  agentname:str;
  passoutput:bool;
  transform:str
};

t=$agentpipeline{
  name:str;
  steps:@$pipelinestep;
  createdat:i64
};

t=$pipelinerun{
  pipelinename:str;
  stepresults:@str;
  startedat:i64;
  finishedat:i64;
  ok:bool
};


f=newpipeline(name:str;steps:@$pipelinestep):$agentpipeline{
  <$agentpipeline{
    name:name;
    steps:steps;
    createdat:t.nowi64()
  }
};




f=runpipeline(pl:$agentpipeline;initialinput:str;registry:i64):$pipelinerun{
  let started=t.nowi64();
  let stepresults=@();
  let currentinput=initialinput;
  let allok=true;
  let count=pl.steps.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let step=t.arrayget(pl.steps;i);
      log.info(
        str.concat("pipeline step: ";step.agentname);
        "agent_pipeline";
        pl.name
      );
      let findresult=reg.find(registry;step.agentname);
      let found=mt findresult {
        $lokeerr:e false;
        $ok:v true
      };
      if(found){
        let output=str.concat(
          str.concat(
            str.concat("[";step.agentname);
            "] processed: ");
          currentinput
        );
        stepresults=@(stepresults;output);
        if(step.passoutput){
          currentinput=output
        }el{
          currentinput=currentinput
        }
      }el{
        let errmsg=str.concat("step failed -- agent not found: ";step.agentname);
        log.error(errmsg;"agent_pipeline";pl.name);
        stepresults=@(stepresults;errmsg);
        allok=false
      };
      i=i+1
    }
  };
  let finished=t.nowi64();
  <$pipelinerun{
    pipelinename:pl.name;
    stepresults:stepresults;
    startedat:started;
    finishedat:finished;
    ok:allok
  }
};


f=formatpipelinerun(run:$pipelinerun):str{
  let status=mut."FAILED";
  if(run.ok){ status="OK" }el{};
  let header=str.concat(
    str.concat(
      str.concat("pipeline: ";run.pipelinename);
      " -- ");
    status
  );
  let count=run.stepresults.len;
  let i=0;
  let body=header;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let result=t.arrayget(run.stepresults;i);
      let stepnum=str.fromi32(i+1);
      let line=str.concat(
        str.concat(
          str.concat("
  step ";stepnum);
          ": ");
        result
      );
      body=str.concat(body;line);
      i=i+1;
    }
  };
  <body
};

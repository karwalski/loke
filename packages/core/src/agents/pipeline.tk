m=core.agents.pipeline;



i=t:shared.types;
i=log:shared.log;
i=reg:core.agents.registry;
i=str:std.str;

t=$pipelinestep{
  agentname:str;
  passoutput:bool;
  transform:str
};

t=$agentpipeline{
  name:str;
  steps:@$pipelinestep;
  createdat:i64
};

t=$pipelinerun{
  pipelinename:str;
  stepresults:@str;
  startedat:i64;
  finishedat:i64;
  ok:bool
};


f=newpipeline(name:str;steps:@$pipelinestep):$agentpipeline{
  <$agentpipeline{
    name:name;
    steps:steps;
    createdat:t.nowi64()
  }
};




f=runpipeline(pl:$agentpipeline;initialinput:str;registry:$agentregistry):$pipelinerun{
  let started=t.nowi64();
  let stepresults=mut.@();
  let currentinput=mut.initialinput;
  let allok=mut.true;
  let count=pl.steps.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      (* Typed `.get`, not t.arrayget, which erases the element type (F10.22). Nothing had
         ever called this function, and its first call ended in RT005 nil dereference. *)
      let steps:@$pipelinestep=pl.steps;
      let step:$pipelinestep=steps.get(i);
      log.info(
        str.concat("pipeline step: ";step.agentname);
        "agent_pipeline";
        pl.name
      );
      (* AG1.9: reg.has. A match on reg.find took the first arm whatever it held (T-18),
         so an unknown agent's step "processed". *)
      let found=reg.has(registry;step.agentname);
      if(found){
        let output=str.concat(
          str.concat(
            str.concat("[";step.agentname);
            "] processed: ");
          currentinput
        );
        stepresults=stepresults.push(output);
        if(step.passoutput){
          currentinput=output
        }el{
          currentinput=currentinput
        }
      }el{
        let errmsg=str.concat("step failed -- agent not found: ";step.agentname);
        log.error(errmsg;"agent_pipeline";pl.name);
        stepresults=stepresults.push(errmsg);
        allok=false
      };
      i=i+1
    }
  };
  let finished=t.nowi64();
  <$pipelinerun{
    pipelinename:pl.name;
    stepresults:stepresults;
    startedat:started;
    finishedat:finished;
    ok:allok
  }
};


f=formatpipelinerun(run:$pipelinerun):str{
  let status=mut."FAILED";
  if(run.ok){ status="OK" }el{};
  let header=str.concat(
    str.concat(
      str.concat("pipeline: ";run.pipelinename);
      " -- ");
    status
  );
  let count=run.stepresults.len;
  let i=mut.0;
  let body=mut.header;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let result=t.arrayget(run.stepresults;i);
      let stepnum=str.fromi32(i+1);
      let line=str.concat(
        str.concat(
          str.concat("
  step ";stepnum);
          ": ");
        result
      );
      body=str.concat(body;line);
      i=i+1;
    }
  };
  <body
};

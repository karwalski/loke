m=core.agents.executor;

i=t:shared.types;
i=at:core.agents.types;
i=sb:core.agents.sandbox;
i=pipeline:core.privacy.pipeline;
i=str:std.str;
i=log:shared.log;

t=$executorconfig{
  presidiourl:str;
  ollamaurl:str;
  pipelineconfig:i64
};


f=newconfig(presidiourl:str;ollamaurl:str):$executorconfig{
  let pc=pipeline.newconfig(presidiourl;ollamaurl);
  <$executorconfig{presidiourl:presidiourl;ollamaurl:ollamaurl;pipelineconfig:pc}
};









f=execute(agent:i64;context:str;config:$executorconfig;cid:str):i64{
  let sandbox=sb.newsandbox(agent);

  
  let costok=sb.checkcostlimit(sandbox;0.0);
  if(costok=false){
    log.error(str.concat("agent cost limit exceeded before run: ";agent.id);"executor";cid);
    let violation="cost limit exceeded";
    sandbox.violations=@(sandbox.violations;violation);
    <sb.toresult(sandbox;"cost limit exceeded";false)
  }el{};

  
  let prompt=str.concat(agent.prompttemplate;str.concat(" Context: ";context));
  let pipelinerun=pipeline.run(prompt;"";config.pipelineconfig);

  
  let entitycount=str.fromu32(pipelinerun.totalentities);
  let sensitivitylabel=mt pipelinerun.result.sensitivity {
    $public:v "PUBLIC";
    $internal:v "INTERNAL";
    $confidential:v "CONFIDENTIAL";
    $restricted:v "RESTRICTED"
  };
  let logmsg=str.concat(
    str.concat(
      str.concat("pipeline complete — entities=";entitycount);
      " sensitivity=");
    sensitivitylabel);
  log.info(logmsg;"executor";cid);

  
  
  let isrestricted=mt pipelinerun.result.sensitivity {
    $public:v false;
    $internal:v false;
    $confidential:v false;
    $restricted:v true
  };
  if(isrestricted){
    let modelperm=$agentpermission{model:agent.modelpreference};
    let hasmodelperm=sb.checkpermission(sandbox;modelperm);
    if(hasmodelperm=false){
      let violation="RESTRICTED data detected but agent lacks explicit model permission";
      sandbox.violations=@(sandbox.violations;violation);
      log.error(str.concat("executor denied — ";violation);"executor";cid);
      <sb.toresult(sandbox;violation;false)
    }el{}
  }el{};

  
  log.info(str.concat("agent execution complete (LLM stubbed): ";agent.id);"executor";cid);

  
  <sb.toresult(sandbox;pipelinerun.result.anonymised;true)
};

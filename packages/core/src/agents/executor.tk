m=core.agents.executor;

i=sb:core.agents.sandbox;
i=pipeline:core.privacy.pipeline;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=at:core.agents.types;

t=$executorconfig{
  presidiourl:str;
  ollamaurl:str;
  pipelineconfig:i64
};


f=newconfig(presidiourl:str;ollamaurl:str):$executorconfig{
  let pc=pipeline.newconfig(presidiourl;ollamaurl);
  <$executorconfig{presidiourl:presidiourl;ollamaurl:ollamaurl;pipelineconfig:pc}
};









(* NC1.9. An agent run reaches a provider, so the pipeline result is obtained through
   pipeline.runchecked and the refusal path is a sibling arm of the success path rather
   than a flag tested afterwards. A match arm is an expression, so each arm calls a
   function; that is what makes "refused because nothing scanned it" impossible to fall
   through by accident. *)
f=refuseunscanned(sandbox:$sandbox;agentid:str;cid:str):i64{
  let violation="privacy pipeline unavailable: no detection layer scanned the prompt";
  log.error("executor refused \(agentid) — \(violation)";"executor";cid);
  <sb.toresult(sb.recordviolation(sandbox;violation);violation;false)
};

f=sensitivitylabel(s:$sensitivitylevel):str{
  <mt s {
    $public:v "PUBLIC";
    $internal:v "INTERNAL";
    $confidential:v "CONFIDENTIAL";
    $restricted:v "RESTRICTED"
  }
};

f=isrestricted(s:$sensitivitylevel):bool{
  <mt s {
    $public:v false;
    $internal:v false;
    $confidential:v false;
    $restricted:v true
  }
};

f=runwithscan(agent:$agentdef;sandbox:$sandbox;pipelinerun:$pipelinerun;cid:str):i64{
  let resultv:$piidetectionresult=pipelinerun.result;
  let sensitivityv:$sensitivitylevel=resultv.sensitivity;
  log.info("pipeline complete — entities=\(pipelinerun.totalentities) sensitivity=\(sensitivitylabel(sensitivityv)) layers=\(pipelinerun.layerscompleted) degraded=\(pipelinerun.layersdegraded)";"executor";cid);

  if(isrestricted(sensitivityv)){
    let modelperm=$agentpermission{model:agent.modelpreference};
    if(sb.checkpermission(sandbox;modelperm)){}el{
      let violation="RESTRICTED data detected but agent lacks explicit model permission";
      log.error("executor denied — \(violation)";"executor";cid);
      <sb.toresult(sb.recordviolation(sandbox;violation);violation;false)
    }
  }el{};

  log.info("agent execution complete (LLM stubbed): \(agent.id)";"executor";cid);
  <sb.toresult(sandbox;resultv.anonymised;true)
};

f=execute(agent:$agentdef;context:str;config:$executorconfig;cid:str):i64{
  let sandbox=sb.newsandbox(agent);

  if(sb.checkcostlimit(sandbox;0.0)){}el{
    let violation="cost limit exceeded";
    log.error("agent cost limit exceeded before run: \(agent.id)";"executor";cid);
    (* Recorded through sb.recordviolation. `sandbox.violations==@(...)` was a
       discarded comparison around a nesting literal, so the violation this branch
       exists to record was never recorded. LS1.1a. *)
    <sb.toresult(sb.recordviolation(sandbox;violation);violation;false)
  };

  let prompt="\(agent.prompttemplate) Context: \(context)";
  (* A bool, not a result arm. toke does not discriminate an X!$lokeerr — `mt` takes
     the first arm whatever the value is (T-18) — so a refusal expressed as $err would
     have been matched as $ok by this very call site and the agent would have run on
     unscanned text. *)
  let run=pipeline.runforward(prompt;"";config.pipelineconfig);
  if(pipeline.issafetoforward(run)){
    <runwithscan(agent;sandbox;run;cid)
  }el{
    <refuseunscanned(sandbox;agent.id;cid)
  }
};

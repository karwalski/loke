m=core.privacy.placeholderstore;
i=json:std.json;




i=t:shared.types;
i=s:core.storage.db;
i=db:std.db;
i=str:std.str;
i=log:shared.log;

t=$persistentmap{
  requestid:str;
  store:i64
};



f=newmap(store:i64;requestid:str):$persistentmap{
  <$persistentmap{requestid:requestid;store:store}
};




f=storeentry(pmap:$persistentmap;original:str;placeholder:str;entitytype:str):i64!$lokeerr{
  let id=str.randhex(16);
  let storeok=mt db.execparams(
    pmap.store.conn;
    "INSERT INTO placeholder_maps (id,request_id,original,placeholder,entity_type,created_at,expires_at) VALUES (?,?,?,?,?,datetime('now'),datetime('now','+1 day'))";
    @(id;pmap.requestid;original;placeholder;entitytype)
  ) {
    $ok:v 1;
    $err:e $err($storageerr(str.concat("failed to store placeholder entry for request: ";pmap.requestid)))
  };
  log.debug("stored placeholder entry";"placeholder_store";pmap.requestid);
  <$ok(storeok)
};



f=restorerows(rows:i64;text:str;requestid:str):str{
  let result=mut.text;
  let count=rows.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let row=str.arrayget(rows;i);
      let ph=json.str(row;"placeholder");
      let orig=json.str(row;"original");
      result=str.replace(result;ph;orig);
      i=i+1;
    }
  };
  log.debug("restored text from placeholder map";"placeholder_store";requestid);
  <result
};

f=restore(pmap:$persistentmap;text:str):str!$lokeerr{
  mt db.queryparams(
    pmap.store.conn;
    "SELECT placeholder,original FROM placeholder_maps WHERE request_id=?";
    @(pmap.requestid)
  ) {
    $ok:rows $ok(restorerows(rows;text;pmap.requestid));
    $err:e $err($storageerr(str.concat("failed to query placeholder_maps for request: ";pmap.requestid)))
  }
};


f=restoretext(store:i64;requestid:str;text:str):str!$lokeerr{
  let pmap=newmap(store;requestid);
  <restore(pmap;text)
};



f=expireold(store:i64):i64!$lokeerr{
  let expireok=mt db.exec(
    store.conn;
    "DELETE FROM placeholder_maps WHERE expires_at IS NOT NULL AND expires_at < datetime('now')"
  ) {
    $ok:v 1;
    $err:e $err($storageerr("failed to expire old placeholder_maps entries"))
  };
  log.info("expired old placeholder map entries";"placeholder_store";"maintenance");
  <$ok(expireok)
};


f=countforrequest(store:i64;requestid:str):u32!$lokeerr{
  mt db.queryoneparams(
    store.conn;
    "SELECT COUNT(*) as cnt FROM placeholder_maps WHERE request_id=?";
    @(requestid)
  ) {
    $ok:row $ok(json.i64(row;"cnt"));
    $err:e $err($storageerr(str.concat("failed to count placeholder_maps for request: ";requestid)))
  }
};

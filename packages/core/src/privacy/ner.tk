m=core.privacy.ner;

i=http:std.http;
i=reach:shared.reachability;
i=json:std.json;
i=jx:shared.jsonobj;
i=str:std.str;
i=t:shared.types;

t=$nerclient{
  ollamaurl:str;
  modelid:str
};

f=new(ollamaurl:str;modelid:str):$nerclient{
  <$nerclient{ollamaurl:ollamaurl;modelid:modelid}
};

f=isavailable(client:$nerclient):bool{
  (* The port is probed before the HTTP call, and the HTTP result is NOT trusted to
     report unreachability.

     http.get against a closed port returns $ok carrying a nil response, so the $err
     arm never runs: this function returned TRUE for a sidecar that was not running,
     the pipeline then called the layer, and the nil dereference took the process
     down. That is the fail-open NC1.9 exists to close, one level below where NC1.9
     was looking. See docs/upstream/toke-issues.md T-15.

     reach.localserviceup binds the port to find out, which is honest for a local
     sidecar and is all these two are. *)
  if(reach.localserviceup(client.ollamaurl)){}el{
    <false
  };
  let hc=http.client(client.ollamaurl);
  <mt http.get(hc;"/api/tags") {
    $ok:body true;
    $err:e false
  }
};


f=nersensitivity(entitytype:str):str{
  if(str.eq(entitytype;"MEDICAL")){
    <"confidential"
  }el{
    if(str.eq(entitytype;"FINANCIAL")){
      <"confidential"
    }el{
      if(str.eq(entitytype;"PERSON")){
        <"confidential"
      }el{
        if(str.eq(entitytype;"LOCATION")){
          <"internal"
        }el{
          if(str.eq(entitytype;"ORGANIZATION")){
            <"internal"
          }el{
            if(str.eq(entitytype;"DATE")){
              <"internal"
            }el{
              <"internal"
            }
          }
        }
      }
    }
  }
};

f=nerconfidence(entitytype:str):f64{
  if(str.eq(entitytype;"MEDICAL")){
    <0.78
  }el{
    if(str.eq(entitytype;"FINANCIAL")){
      <0.78
    }el{
      if(str.eq(entitytype;"PERSON")){
        <0.78
      }el{
        if(str.eq(entitytype;"LOCATION")){
          <0.65
        }el{
          if(str.eq(entitytype;"ORGANIZATION")){
            <0.65
          }el{
            if(str.eq(entitytype;"DATE")){
              <0.50
            }el{
              <0.50
            }
          }
        }
      }
    }
  }
};

(* Detection only — .placeholder is left empty on purpose.

   PL1.1: makenerplaceholder used to build it here, and it hardcoded the index:
   `str.concat(open;"_NER_1]")`. Every PERSON this layer found therefore became the
   identical `[PERSON_NER_1]`, dedup deduped by value and by overlapping span but never
   by placeholder, and restore's sequential str.replace let the first map entry consume
   every occurrence — so with two people in one prompt, person B's detail came back
   attached to person A's name. placeholder.assignplaceholders numbers the deduped list
   in one place instead. *)
(* PL1.12. The model's reply is a top-level JSON array. This used to call
   `json.getarr(arr;"")`, which looks up the key "" in an OBJECT and returns a null array
   for anything else -- the PL1.11 defect -- and the loop's null-safe length turned that
   into zero entities for every reply. json.parsearray yields each element's own JSON. *)
f=buildentities(content:str):@$piientity{
  let entities=mut.@($piientity);
  let items=json.parsearray(content);
  lp(let i=0;i<str.arraylen(items);i=i+1){
    entities=mt json.dec(items.get(i)) {
      $ok:item addentity(entities;item);
      $jsonerr:e entities
    }
  };
  <entities
};

f=addentity(entities:@$piientity;item:i64):@$piientity{
  let entitytype=json.str(item;"type");
  <entities.push($piientity{
    entitytype:entitytype;
    value:json.str(item;"value");
    start:0;
    end:0;
    confidence:nerconfidence(entitytype);
    placeholder:""
  })
};

f=parsecontent(content:str):@$piientity!$lokeerr{
  let arrparsed=json.dec(content);
  <mt arrparsed {
    $ok:arr $ok(buildentities(content));
    $jsonerr:e2 $err($privacyerr("ner detect_entities: model response is not valid JSON array"))
  }
};

(* PL1.12. Ollama's `message` is an object. `json.str(obj;"message.content")` asked
   std.json for a dotted path it does not support, so `content` was empty for every
   response. The object is fetched with json.getval and read in a second step. *)
f=parseobj(obj:i64):@$piientity!$lokeerr{
  let content=mt json.dec(json.getval(obj;"message")) {
    $ok:m json.str(m;"content");
    $jsonerr:e ""
  };
  <parsecontent(content)
};

f=parseresponse(raw:str):@$piientity!$lokeerr{
  let parsed=json.dec(raw);
  <mt parsed {
    $ok:obj parseobj(obj);
    $jsonerr:e $err($privacyerr("ner detect_entities: failed to parse Ollama response JSON"))
  }
};

(* PL1.12. The prompt was spliced into the JSON body unescaped, so any quote, backslash
   or newline in it produced a malformed request. shared.jsonobj.escape quotes it and
   escapes backslash, quote, newline, CR and tab -- std.json's json.enc escapes only the
   first two, which leaves a raw newline inside a JSON string. The system
   message also names the fields buildentities reads, which it did not. *)
f=requestbody(modelid:str;text:str):str{
  let systemmsg="You are a named entity recognition system. Extract named entities from the text and return ONLY a JSON array of objects with fields type and value, for example [{\"type\":\"PERSON\",\"value\":\"Jane Citizen\"}]. Types: PERSON, ORGANIZATION, LOCATION, DATE, MEDICAL, FINANCIAL. No explanation.";
  let usermsg=jx.escape(str.concat("Extract entities from: ";text));
  let head=str.concat("{\"model\":";str.concat(jx.escape(modelid);",\"stream\":false,\"messages\":[{\"role\":\"system\",\"content\":"));
  let mid=str.concat(head;str.concat(jx.escape(systemmsg);"},{\"role\":\"user\",\"content\":"));
  <str.concat(mid;str.concat(usermsg;"}]}"))
};

f=detectentities(client:$nerclient;text:str):@$piientity!$lokeerr{
  let hc=http.client(client.ollamaurl);
  let result=http.postheaders(hc;"/api/chat";str.tobytes(requestbody(client.modelid;text));"{\"content-type\":\"application/json\"}");
  <mt result {
    $ok:raw parseresponse(raw);
    $httperr:e $err($networkerr("ner detect_entities: failed to reach Ollama /api/chat"))
  }
};


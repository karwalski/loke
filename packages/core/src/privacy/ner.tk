m=core.privacy.ner;

i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$nerclient{
  ollamaurl:str;
  modelid:str
};

f=new(ollamaurl:str;modelid:str):$nerclient{
  <$nerclient{ollamaurl:ollamaurl;modelid:modelid}
};

f=isavailable(client:$nerclient):bool{
  let url=str.concat(client.ollamaurl;"/api/tags");
  let result=http.gettimeout(url;2000);
  mt result {
    $httperr:e false;
    $ok:body true
  }
};

f=nersensitivity(entitytype:str):str{
  if(str.eq(entitytype;"MEDICAL")){
    <"confidential"
  }el{
    if(str.eq(entitytype;"FINANCIAL")){
      <"confidential"
    }el{
      if(str.eq(entitytype;"PERSON")){
        <"confidential"
      }el{
        if(str.eq(entitytype;"LOCATION")){
          <"internal"
        }el{
          if(str.eq(entitytype;"ORGANIZATION")){
            <"internal"
          }el{
            if(str.eq(entitytype;"DATE")){
              <"internal"
            }el{
              <"internal"
            }
          }
        }
      }
    }
  }
};

f=nerconfidence(entitytype:str):f64{
  if(str.eq(entitytype;"MEDICAL")){
    <0.78
  }el{
    if(str.eq(entitytype;"FINANCIAL")){
      <0.78
    }el{
      if(str.eq(entitytype;"PERSON")){
        <0.78
      }el{
        if(str.eq(entitytype;"LOCATION")){
          <0.65
        }el{
          if(str.eq(entitytype;"ORGANIZATION")){
            <0.65
          }el{
            if(str.eq(entitytype;"DATE")){
              <0.50
            }el{
              <0.50
            }
          }
        }
      }
    }
  }
};

f=makenerplaceholder(entitytype:str):str{
  let open=str.concat("[";entitytype);
  let mid=str.concat(open;"_NER_1]");
  <mid
};

f=buildentities(arr:i64):@$piientity{
  let entities=mut.@($piientity);
  let items=json.getarr(arr;"");
  lp(let i=0;i<str.arraylen(items);i=i+1){ let item=str.arrayget(items;i);
    let entitytype=json.str(item;"type");
    let value=json.str(item;"value");
    let placeholder=makenerplaceholder(entitytype);
    let confidence=nerconfidence(entitytype);
    let entity=$piientity{
      entitytype:entitytype;
      value:value;
      start:0;
      end:0;
      confidence:confidence;
      placeholder:placeholder
    };
    entities=@(entities;entity)
  };
  <entities
};

f=parsecontent(content:str):@$piientity!$lokeerr{
  let arrparsed=json.dec(content);
  mt arrparsed {
    $jsonerr:e2 $err($privacyerr("ner detect_entities: model response is not valid JSON array"));
    $ok:arr $ok(buildentities(arr))
  }
};

f=parseobj(obj:i64):@$piientity!$lokeerr{
  let content=json.str(obj;"message.content");
  <parsecontent(content)
};

f=parseresponse(raw:str):@$piientity!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $err($privacyerr("ner detect_entities: failed to parse Ollama response JSON"));
    $ok:obj parseobj(obj)
  }
};

f=detectentities(client:$nerclient;text:str):@$piientity!$lokeerr{
  let url=str.concat(client.ollamaurl;"/api/chat");
  let systemmsg="You are a named entity recognition system. Extract named entities from the text and return ONLY a JSON array. No explanation.";
  let usermsg=str.concat("Extract entities from: ";text);
  let body=str.concat("{\"model\":\"";str.concat(client.modelid;str.concat("\",\"messages\":[{\"role\":\"system\",\"content\":\"";str.concat(systemmsg;str.concat("\"},{\"role\":\"user\",\"content\":\"";str.concat(usermsg;"\"}],\"stream\":false}"))))));
  let result=http.post(url;body;"application/json");
  mt result {
    $httperr:e $err($networkerr("ner detect_entities: failed to reach Ollama /api/chat"));
    $ok:raw parseresponse(raw)
  }
};

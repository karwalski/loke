m=core.privacy.ner;




i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$nerclient{
  ollamaurl:str;
  modelid:str
};


f=new(ollamaurl:str;modelid:str):$nerclient{
  <$nerclient{ollamaurl:ollamaurl;modelid:modelid};
};


f=isavailable(client:$nerclient):bool{
  let url=str.concat(client.ollamaurl;"/api/tags");
  let result=http.gettimeout(url;2000);
  mt result {
    $httperr e;
      <false
    body;
      <true
  };
};


f=nersensitivity(entitytype:str):$sensitivitylevel{
  if(str.eq(entitytype;"MEDICAL")){
    <$confidential
  }else{
    if(str.eq(entitytype;"FINANCIAL")){
      <$confidential
    }else{
      if(str.eq(entitytype;"PERSON")){
        <$confidential
      }else{
        if(str.eq(entitytype;"LOCATION")){
          <$internal
        }else{
          if(str.eq(entitytype;"ORGANIZATION")){
            <$internal
          }else{
            if(str.eq(entitytype;"DATE")){
              <$internal
            }else{
              <$internal
            };
          };
        };
      };
    };
  };
};


f=nerconfidence(entitytype:str):f64{
  if(str.eq(entitytype;"MEDICAL")){
    <0.78
  }else{
    if(str.eq(entitytype;"FINANCIAL")){
      <0.78
    }else{
      if(str.eq(entitytype;"PERSON")){
        <0.78
      }else{
        if(str.eq(entitytype;"LOCATION")){
          <0.65
        }else{
          if(str.eq(entitytype;"ORGANIZATION")){
            <0.65
          }else{
            if(str.eq(entitytype;"DATE")){
              <0.50
            }else{
              <0.50
            };
          };
        };
      };
    };
  };
};


f=makenerplaceholder(entitytype:str):str{
  let open=str.concat("[";entitytype);
  let mid=str.concat(open;"_NER_1]");
  <mid
};




f=detectentities(client:$nerclient;text:str):@$piientity|$lokeerr{
  let url=str.concat(client.ollamaurl;"/api/chat");
  let systemmsg="You are a named entity recognition system. Extract named entities from the text and return ONLY a JSON array. No explanation.";
  let usermsg=str.concat("Extract entities from: ";text);
  let body=json.enc({
    model:client.modelid;
    messages:@(
      {role:"system";content:systemmsg};
      {role:"user";content:usermsg};
    );
    stream:false
  });
  let result=http.post(url;body;"application/json");
  mt result {
    $httperr e;
      <$lokeerr.$networkerr("ner detect_entities: failed to reach Ollama /api/chat")
    raw;
      let parsed=json.dec(raw);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$privacyerr("ner detect_entities: failed to parse Ollama response JSON")
        obj;
          let messageobj=json.getstr(obj;"message");
          let msgparsed=json.dec(messageobj);
          mt msgparsed {
            $jsonerr e;
              <$lokeerr.$privacyerr("ner detect_entities: failed to parse message field")
            msgobj;
              let content=json.getstr(msgobj;"content");
              let arrparsed=json.dec(content);
              mt arrparsed {
                $jsonerr e;
                  <$lokeerr.$privacyerr("ner detect_entities: model response is not valid JSON array")
                arr;
                  let entities=@();
                  let items=json.getarr(arr;"");
                  mt items {
                    item;
                      let entitytype=json.getstr(item;"type");
                      let value=json.getstr(item;"value");
                      let placeholder=makenerplaceholder(entitytype);
                      let confidence=nerconfidence(entitytype);
                      let entity=t.$piientity{
                        entitytype:entitytype;
                        value:value;
                        start:0;
                        end:0;
                        confidence:confidence;
                        placeholder:placeholder
                      };
                      entities=@(entities;entity)
                  };
                  <entities
              };
          };
      };
  };
};

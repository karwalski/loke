   SPDX-License-Identifier: Apache-2.0 *)

m=core.privacy.pipeline;




i=str:std.str;
i=log:shared.log;
i=guardian:core.privacy.guardian;
i=t:shared.types;
i=ph:core.privacy.placeholder;
i=pt:core.privacy.pipelinetypes;
i=fr:core.privacy.filterregistry;
i=lh:core.privacy.layerhealth;
i=cfg:shared.config;
i=cn:core.privacy.consensus;
i=lyc:core.privacy.layerconfig;
i=er:core.privacy.entityrouting;
i=fm:core.privacy.filtermetrics;
i=vocab:core.privacy.entityvocab;
i=alert:core.governance.alert;
i=op:core.privacy.orgpolicy;
i=mr:core.privacy.modelregistry;

(* F3b.1. The pipeline's layers are a filter registry (core.privacy.filterregistry): which
   detection layers exist, which are enabled, the order they run in and the URL and setting
   each is reached with, in one place. `run` walks it in order and consults each entry
   through core.privacy.layerhealth, so a layer that is not in `layers`, or is in it
   disabled, is not consulted.

   The config used to carry usener/usepresidio/usepf and three URLs as separate fields, and
   `run` wired four layers by hand from them, while a registry that described the same
   layers had no importer. The accessors below (usener, presidiourl and the rest) read the
   registry, for callers that ask about one layer. *)
t=$pipelineconfig{
  layers:$filterregistry;
  dryrun:bool;
  (* F3b.4. privacy.consensus_strategy and privacy.consensus_threshold, as configured;
     core.privacy.consensus applies most-restrictive to any name it does not know. *)
  consensus:str;
  consensusthreshold:str;
  (* F3b.2. Why the [[privacy.layers]] in config.toml could not be applied, or "". Every run
     made with a config carrying one is refused (core.privacy.layerconfig). *)
  layererror:str;
  (* F3b.5. The [[privacy.entity_routing]] in config.toml (core.privacy.entityrouting). A
     routing error refuses every run made with the config. *)
  routing:$routingconfig;
  (* F3b.8. The organisation policy (core.privacy.orgpolicy), applied over everything above
     at the start of every run. newconfig leaves it unloaded, so run reads
     ~/.loke/loke.policy.json then; withorgpolicy gives one instead. *)
  org:$orgprivacypolicy
};

t=$stageresult{
  stage:$pipelinestage;
  entitiesfound:u32;
  durationms:u32;
  skipped:bool;
  skipreason:str
};

t=$pipelinerun{
  result:$piidetectionresult;
  stages:@$stageresult;
  totalentities:u32;
  finalsystemprompt:str;
  requestid:str;
  (* NC1.9. layerscompleted is how many detection layers actually scanned the text.
     Zero means nothing looked at it, which is not the same as finding nothing, and
     the two were previously indistinguishable to a caller: both came back as
     totalentities:0 with a $pipelinerun that looked like a clean result.
     layersdegraded counts layers the operator enabled that were unavailable. *)
  layerscompleted:u32;
  layersdegraded:u32;
  (* MK6.16. Spans a completed layer reported that could not be placed in the text exactly
     (core.privacy.layerhealth.$layerresult). Each is an entity a layer found and nothing
     masked, so a run with any is not safe to forward. *)
  unplaced:u32;
  (* F3b.4. The consensus strategy applied, and every layer detection with the layers and
     confidences of its group and whether it was masked. *)
  consensus:str;
  resolved:@$resolvedentity;
  (* F3b.2. The layer, in veto mode, that found PII above its threshold, or "". And the
     config's layer error, if the run was made with one. issafetoforward refuses either. *)
  vetoedby:str;
  layererror:str;
  (* F3b.10. What each layer did, as counts, confidences and time and never a value
     (core.privacy.filtermetrics), and the layers that voted in the consensus. *)
  layermetrics:@$layermetric;
  voters:@str;
  (* F3b.10. core.privacy.entityrouting's notes for this run: a routed type taken from its
     fallback layers, or from every layer. Type names and layer ids only. *)
  routingnotes:@str;
  (* F3b.6. The entity types no layer that completed masks, because the only layers configured
     for them were down this run (core.privacy.layerhealth.uncoveredtypes). Type names only.
     The run is still forwardable on that account; run raises a governance alert. *)
  uncovered:@str;
  (* F3b.8. Why the organisation policy refuses this run, or "" (issafetoforward refuses
     any); each setting of the configuration it overrode; and the consensus strategy it
     raised, or "". Layer ids, setting names and policy values only, never text. *)
  policyerror:str;
  policynotes:@str;
  policyraisedfrom:str
};


(* Regex, NER at ollamaurl and Presidio at presidiourl on; the privacy-filter sidecar
   registered and OFF, so a caller that says nothing about it gets the three layers it had
   (F3b.3). *)
f=newconfig(purl:str;ourl:str):$pipelineconfig{
  <$pipelineconfig{layers:fr.layers(purl;ourl);dryrun:false;consensus:cn.defaultstrategy();consensusthreshold:"";layererror:"";routing:er.norouting();org:op.notloaded()}
};

f=withlayers(c:$pipelineconfig;layers:$filterregistry):$pipelineconfig{
  <$pipelineconfig{layers:layers;dryrun:c.dryrun;consensus:c.consensus;consensusthreshold:c.consensusthreshold;layererror:c.layererror;routing:c.routing;org:c.org}
};

(* One registry entry switched on or off. An id the registry does not hold is left alone. *)
f=withlayer(c:$pipelineconfig;id:str;enabled:bool):$pipelineconfig{
  <withlayers(c;fr.setenabled(c.layers;id;enabled))
};

f=withdryrun(c:$pipelineconfig;dryrun:bool):$pipelineconfig{
  <$pipelineconfig{layers:c.layers;dryrun:dryrun;consensus:c.consensus;consensusthreshold:c.consensusthreshold;layererror:c.layererror;routing:c.routing;org:c.org}
};

(* The privacy-filter layer switched on (or off) at a sidecar URL and operating point. The
   threshold is text, as core.privacy.sidecarclient.new takes it (AD1.4). *)
f=withprivacyfilter(c:$pipelineconfig;enabled:bool;url:str;threshold:str):$pipelineconfig{
  let id=fr.privacyfilterid();
  let reg=fr.setparam(fr.seturl(fr.setenabled(c.layers;id;enabled);id;url);id;threshold);
  <withlayers(c;reg)
};

f=withconsensus(c:$pipelineconfig;strategy:str;threshold:str):$pipelineconfig{
  <$pipelineconfig{layers:c.layers;dryrun:c.dryrun;consensus:strategy;consensusthreshold:threshold;layererror:c.layererror;routing:c.routing;org:c.org}
};

(* F3b.2. The [[privacy.layers]] entries in a config.toml text applied to the registry. One
   that cannot be applied leaves the registry as it was and sets layererror, which refuses
   every run made with the config. *)
f=withlayerconfig(c:$pipelineconfig;text:str):$pipelineconfig{
  let ls:$layersettings=lyc.resolve(c.layers;text);
  if(str.len(ls.warning)>0){ log.warn("privacy.layers: \(ls.warning)";"pipeline";"") }el{};
  if(str.len(ls.error)>0){
    log.error("\(lyc.refusal(ls.error)), so requests will be refused";"pipeline";"");
    <$pipelineconfig{layers:c.layers;dryrun:c.dryrun;consensus:c.consensus;consensusthreshold:c.consensusthreshold;layererror:ls.error;routing:c.routing;org:c.org}
  }el{};
  <withlayers(c;ls.registry)
};

(* F3b.5. The [[privacy.entity_routing]] entries in a config.toml text. One that cannot be
   applied leaves no route and refuses every run made with the config. *)
f=withroutingconfig(c:$pipelineconfig;text:str):$pipelineconfig{
  let rc:$routingconfig=er.resolve(c.layers;text);
  if(str.len(rc.warning)>0){ log.warn("privacy.entity_routing: \(rc.warning)";"pipeline";"") }el{};
  if(str.len(rc.error)>0){ log.error("privacy.entity_routing cannot be applied, so requests will be refused: \(rc.error)";"pipeline";"") }el{};
  <$pipelineconfig{layers:c.layers;dryrun:c.dryrun;consensus:c.consensus;consensusthreshold:c.consensusthreshold;layererror:c.layererror;routing:rc;org:c.org}
};

(* F3b.8. The organisation policy a run applies, instead of the file read at run time. *)
f=withorgpolicy(c:$pipelineconfig;p:$orgprivacypolicy):$pipelineconfig{
  <$pipelineconfig{layers:c.layers;dryrun:c.dryrun;consensus:c.consensus;consensusthreshold:c.consensusthreshold;layererror:c.layererror;routing:c.routing;org:p}
};

(* F3b.7. The token-classification models registered with `loke privacy add-model`
   (core.privacy.modelregistry) added to the registry as layers. A registration file that
   cannot be applied adds none and refuses every run made with the config, naming the fault. *)
f=withmodels(c:$pipelineconfig;set:$modelset):$pipelineconfig{
  if(str.len(set.error)>0){
    log.error("\(set.error), so requests will be refused";"pipeline";"");
    <$pipelineconfig{layers:c.layers;dryrun:c.dryrun;consensus:c.consensus;consensusthreshold:c.consensusthreshold;layererror:set.error;routing:c.routing;org:c.org}
  }el{};
  <withlayers(c;mr.apply(c.layers;set))
};

(* The registered models are added before [[privacy.layers]] and [[privacy.entity_routing]]
   are applied, so both can name them. *)
f=withlokeconfig(c:$pipelineconfig;lc:$lokeconfig):$pipelineconfig{
  <withroutingconfig(withlayerconfig(withconsensus(withmodels(withprivacyfilter(c;lc.usepf;lc.pfurl;lc.pfthreshold);mr.load(mr.modelspath()));lc.consensusstrategy;lc.consensusthreshold);lc.sourcetext);lc.sourcetext)
};

(* newconfig plus the privacy-filter settings from the user's config.toml, read now. *)
f=configured(purl:str;ourl:str):$pipelineconfig{
  <withlokeconfig(newconfig(purl;ourl);cfg.loaded())
};

(* The layers the loke server runs a request through: the default Presidio and Ollama
   addresses, with the user's privacy-filter settings. page.api.pipeline filters with it and
   page.api.health reports the health of the same layers.

   MK6.16. Presidio is reached at the user's privacy.presidio_url, as the CLI already reached
   it (cli.ask, cli.proxy); the server took the built-in default whatever config.toml said.
   The default is the same loopback port, and presidio.scan refuses a host that is not
   loopback, so the setting can only move the layer to another local port. A config that
   does not set it keeps the registry's 127.0.0.1 address, as before. *)
f=served():$pipelineconfig{
  <servedwith(cfg.loaded())
};

(* F3b.2 (b). served() for a config.toml read some other way: the settings UI checks the text
   it is about to write through the same composition the server will run it with. *)
f=servedwith(lc:$lokeconfig):$pipelineconfig{
  let defaults=cfg.defaultconfig();
  let purl=mut.lc.presidiourl;
  if(str.eq(purl;defaults.presidiourl)){ purl=fr.defaultpresidiourl() }el{};
  <withlokeconfig(newconfig(purl;fr.defaultollamaurl());lc)
};

f=usener(c:$pipelineconfig):bool{ <fr.get(c.layers;fr.nerid()).enabled };
f=usepresidio(c:$pipelineconfig):bool{ <fr.get(c.layers;fr.presidioid()).enabled };
f=usepf(c:$pipelineconfig):bool{ <fr.get(c.layers;fr.privacyfilterid()).enabled };
f=ollamaurl(c:$pipelineconfig):str{ <fr.get(c.layers;fr.nerid()).url };
f=nermodelid(c:$pipelineconfig):str{ <fr.get(c.layers;fr.nerid()).param };
f=presidiourl(c:$pipelineconfig):str{ <fr.get(c.layers;fr.presidioid()).url };
f=pfurl(c:$pipelineconfig):str{ <fr.get(c.layers;fr.privacyfilterid()).url };
f=pfthreshold(c:$pipelineconfig):str{ <fr.get(c.layers;fr.privacyfilterid()).param };


(* Ranked, not a chain of == comparisons. `levela==$restricted` is false even when
   levela IS restricted, because == on a sum compares the handle and the level came
   from another function. See shared.types.sensrank and docs/upstream/toke-issues.md
   T-14. The old chain also returned false for every (public, anything) pair, which
   meant maxsensitivity never escalated past its initial value. *)
f=ishighersensitivity(levela:$sensitivitylevel;levelb:$sensitivitylevel):bool{
  <t.senshigher(levela;levelb)
};




(* Dedup is by VALUE, and also drops a lower-confidence overlapping span.

   Deduping by span alone was wrong for how anonymisation actually works:
   anonymisetext replaces with str.replace(text; entity.value; entity.placeholder),
   which substitutes EVERY occurrence of that value. So two entities carrying the same
   value produced two placeholders, the first str.replace consumed both occurrences,
   and the second entity's placeholder never appeared in the text at all — while still
   being reported in the entity count and written to the restoration map. One entity
   per distinct value is what the replacement strategy needs, and it is what makes the
   same value get the same placeholder.

   The previous version also treated `start==0` as "position unknown" and skipped the
   overlap test for it, which silently exempted every entity at offset 0 — a real
   offset, and the commonest one in a short prompt. *)
f=seenvalue(kept:@$piientity;value:str):bool{
  let found=mut.false;
  lp(let i=0;i<kept.len;i=i+1){
    let e:$piientity=kept.get(i);
    if(str.eq(e.value;value)){
      found=true
    }el{}
  };
  <found
};

(* PL1.9 -- shadowing is decided over the whole detection list, not over whichever prefix
   of it happened to be kept already.

   The old predicate was `overlapsbetter(kept;candidate)`: drop a CANDIDATE overlapping an
   already-kept entity of at least equal confidence. It never revisited a kept entity when
   a better overlapping one arrived later, so the same two detections produced two
   different entity lists depending on which detection layer ran first:

     Bob (0.78) then Bob Jones (0.92)  ->  both kept
     Bob Jones (0.92) then Bob (0.78)  ->  only Bob Jones kept

   Layer order is a configuration detail, not a property of the text. The shorter is a
   strict shadow of the longer either way, and either way it inflated the reported entity
   count and put an entry in the restoration map whose placeholder never reaches the
   prompt.

   WHY THE RELATION IS NARROWER THAN "OVERLAPS AND IS LESS CONFIDENT". Dropping an entity
   means nothing will substitute its value, so it is only safe to drop one whose value is
   a substring of a survivor that covers its span: ph.applytotext substitutes longest
   value first, so replacing "Bob Jones" removes the "Bob" inside it. Merely overlapping
   spans give no such guarantee -- dropping on overlap alone can leave the part of the
   loser that the winner does not cover sitting in the prompt in the clear, which the old
   predicate could do. So `shadow` shadows `target` when the shadow's span covers the
   target's, the shadow's value strictly contains the target's, and the shadow is at least
   as confident.

   That relation is transitive (span nesting, substring and >= all are) and antisymmetric
   (strict containment cannot hold in both directions), so the survivors are its maximal
   elements, every dropped entity's value sits inside a survivor's, and no two entities
   can shadow each other into both being dropped.

   WHAT THIS GIVES UP, stated rather than hidden: when the shorter value also occurs
   somewhere the longer does not -- "Bob Jones and Bob", with only the first Bob detected
   -- keeping the shorter entity meant applytotext replaced the later bare "Bob" too.
   Dropping it loses that. It was never a guarantee: the other arrival order already lost
   it, and it depends on a layer having reported one occurrence of a value and the
   substitution over-applying to all of them. Order independence means choosing one of
   the two old behaviours, and inflating the count and the restore map is the worse one.

   ENTITIES WITH NO SPANS ARE UNTOUCHED. Requiring end>start on BOTH sides means a spanless
   entity neither shadows nor is shadowed -- the same outcome as before this change, since
   the old test `candidate.start<e.end` was also false for an empty span. Equal values are
   still collapsed by value in dedupentities, span or no span.

   PL1.7 has since landed, so the regex layer is no longer the spanless case this paragraph
   was written for: regex.rundetection now recovers each match's offset from str.indexof and
   reports a real span, and shadowing is live for it. The two NER layers and any future
   layer that reports a detection without an offset still take the spanless path, which is
   why the requirement stays rather than becoming an assertion. *)
f=strictlyshadows(shadow:$piientity;target:$piientity):bool{
  let spanned=mut.false;
  if(shadow.end>shadow.start){
    if(target.end>target.start){
      spanned=true
    }el{}
  }el{};
  let shadows=mut.false;
  if(spanned){
    if(shadow.start<=target.start){
      if(shadow.end>=target.end){
        if(shadow.confidence>=target.confidence && entityrank(shadow)>=entityrank(target)){
          if(str.contains(shadow.value;target.value)){
            if(str.eq(shadow.value;target.value)){}el{
              shadows=true
            }
          }el{}
        }el{}
      }el{}
    }el{}
  }el{};
  <shadows
};

(* Scanned over the WHOLE input list, which is the part that makes the answer independent
   of arrival order. Including the target itself is harmless: strictlyshadows requires the
   two values to differ, so nothing shadows itself. *)
f=shadowedbyany(entities:@$piientity;target:$piientity):bool{
  let shadowed=mut.false;
  lp(let i=0;i<entities.len;i=i+1){
    let e:$piientity=entities.get(i);
    if(strictlyshadows(e;target)){
      shadowed=true
    }el{}
  };
  <shadowed
};

(* RG1.7c. Of the detections that carry one value, the MOST SENSITIVE is kept, not the
   first. The value's placeholder, its count and the request's rating all follow the type
   that is kept, and keeping the first made them follow pattern or layer order: an NHS
   number printed 3-3-4 is also a phone_us match, and a Medicare number with its IRN is also
   a checksum-valid ABN (au_abn comes BEFORE au_medicare in getpatterns), so either could be
   kept as the less sensitive type and rate the prompt INTERNAL. Ties keep the earliest, as
   before. Among equal values only the unshadowed take part, so a value is dropped only when
   every detection of it is shadowed, which is what the first-wins rule did too. The rank is
   maxsensitivity's own, one entity at a time, so it cannot disagree with the rating.

   strictlyshadows also requires the survivor to rank at least as high as what it drops:
   a URL or e-mail address that contains a card number or TFN no longer absorbs it. Both are
   then kept; applytotext substitutes the longer first, so the inner value's placeholder
   may not appear in the prompt, and restore still returns the text exactly. *)
f=entityrank(e:$piientity):i64{
  <t.sensrank(maxsensitivity(@(e)))
};

(* True when another unshadowed detection of the same value outranks entities[i]: ranks
   higher, or ranks the same and comes first. *)
f=outranked(entities:@$piientity;i:i64):bool{
  let c:$piientity=entities.get(i);
  let mine=entityrank(c);
  let beaten=mut.false;
  lp(let j=0;j<entities.len;j=j+1){
    let o:$piientity=entities.get(j);
    if(j!=i && str.eq(o.value;c.value)){
      let theirs=entityrank(o);
      if(theirs>mine || (theirs==mine && j<i)){
        if(shadowedbyany(entities;o)){}el{ beaten=true }
      }el{}
    }el{}
  };
  <beaten
};

f=dedupentities(entities:@$piientity):@$piientity{
  let kept=mut.@();
  lp(let i=0;i<entities.len;i=i+1){
    let candidate:$piientity=entities.get(i);
    if(outranked(entities;i)){}el{
      if(shadowedbyany(entities;candidate)){}el{
        kept=kept.push(candidate)
      }
    }
  };
  <kept
};

(* RG1.7c. The rating of a run: the higher of what it kept and every detection a masking
   layer accepted before routing, consensus and dedup. A strategy other than most-restrictive
   can drop a detection, or pass a whole group in the clear, and neither makes the prompt
   less sensitive than what was found in it. *)
f=requestsensitivity(raw:@$piientity;kept:@$piientity):$sensitivitylevel{
  let k=maxsensitivity(kept);
  let r=maxsensitivity(raw);
  if(ishighersensitivity(k;r)){ <k }el{};
  <r
};

(* RG1.7c. Each detection's rank, in step, for core.privacy.consensus. *)
f=ranksof(entities:@$piientity):@i64{
  <entities.map(&entityrank)
};

(* RG1.7d. Each detection is rated by its own type's declared sensitivity
   (core.privacy.entityvocab.typesensitivity: the declaring layer's, the higher where two
   declare it), and the request by the highest of them. There is no list of type names
   here: the one this function kept had no branch for phone_au, phone_us or au_abn and
   rated them INTERNAL while the regex layer declared them CONFIDENTIAL. *)
f=maxsensitivity(entities:@$piientity):$sensitivitylevel{
  let level=mut.t.public();
  lp(let i=0;i<entities.len;i=i+1){
    let s=vocab.typesensitivity(entities.get(i).entitytype);
    if(ishighersensitivity(s;level)){ level=s }el{}
  };
  <level
};


(* Delegates. The substitution loop existed here AND inline in regex.rundetection, each
   fed by a different placeholder generator, which is how a collision in one of them
   stayed invisible in the other. One loop, in the module that owns the placeholder.

   Only ever call this on a list that has been through placeholder.assignplaceholders:
   detection layers now leave .placeholder empty, and replacing a value with "" deletes
   it from the prompt instead of anonymising it. *)
f=anonymisetext(text:str;entities:@$piientity):str{
  <ph.applytotext(text;entities)
};


(* RG1.7d. Counted by the same rating maxsensitivity takes, so a summary can no longer
   report a confidential entity in a run it rated INTERNAL. *)
f=countat(entities:@$piientity;level:$sensitivitylevel):u32{
  let n=mut.0;
  lp(let i=0;i<entities.len;i=i+1){
    if(t.senseq(vocab.typesensitivity(entities.get(i).entitytype);level)){ n=n+1 }el{}
  };
  <n
};

f=countrestricted(entities:@$piientity):u32{
  <countat(entities;t.restricted())
};

f=countconfidential(entities:@$piientity):u32{
  <countat(entities;t.confidential())
};


f=summariserun(run:$pipelinerun):str{
  (* Every count here is bound with `:str`. Interpolating a str.fromu32 result directly
     printed its ADDRESS, so this line read "4378090592 entities detected" (T-41). *)
  let total:str=str.fromint(run.totalentities);
  let restricted:str=str.fromint(countrestricted(run.result.entities));
  let confidential:str=str.fromint(countconfidential(run.result.entities));
  let stages:str=str.fromint(run.stages.len);
  let res:$piidetectionresult=run.result;
  (* `let anonymisedlabel="No PII detected."` inside the if declared a second,
     branch-local binding, so the summary always read "Anonymised." — including when
     nothing had been detected and nothing had been anonymised. A match arm is an
     expression, so the label is the value of the conditional. *)
  let anonymisedlabel=mut."Anonymised.";
  if(t.senseq(res.sensitivity;t.public())){
    anonymisedlabel="No PII detected."
  }el{};
  <"Privacy pipeline: \(total) entities detected (\(restricted) RESTRICTED, \(confidential) CONFIDENTIAL) across \(stages) stages. \(anonymisedlabel)"
};




(* The detection stage a registry id is recorded as. page.api.pipeline names the stages in
   detection_layers (regex, ner, presidio, privacy_filter). Only ids layerhealth.isknown
   accepts reach here. *)
f=stagefor(id:str):$pipelinestage{
  if(str.eq(id;fr.nerid())){ <$pipelinestage{$nerscan:0} }el{};
  if(str.eq(id;fr.presidioid())){ <$pipelinestage{$presidioscan:0} }el{};
  if(str.eq(id;fr.privacyfilterid())){ <$pipelinestage{$privacyfilterscan:0} }el{};
  <$pipelinestage{$regexscan:0}
};

(* The stage a consulted layer leaves in the trace: a scan when it completed, and a skipped
   stage carrying the reason otherwise, disabled and degraded alike. *)
f=layerstage(s:$layerstatus;ms:i64):$stageresult{
  if(lh.iscompleted(s)){
    <$stageresult{stage:stagefor(s.id);entitiesfound:s.detectioncount as u32;durationms:ms as u32;skipped:false;skipreason:""}
  }el{};
  <$stageresult{stage:stagefor(s.id);entitiesfound:0;durationms:ms as u32;skipped:true;skipreason:s.reason}
};

(* One skipped stage for each of the four real layers the registry has no entry for. *)
f=unregisteredstages(reg:$filterregistry):@$stageresult{
  let ids=@(fr.regexid();fr.nerid();fr.presidioid();fr.privacyfilterid());
  let out=mut.@();
  lp(let i=0;i<ids.len;i=i+1){
    let id:str=ids.get(i);
    if(fr.has(reg;id)){}el{
      out=out.push($stageresult{stage:stagefor(id);entitiesfound:0;durationms:0;skipped:true;skipreason:"\(id) is not in the layer registry"})
    }
  };
  <out
};

(* F3b.6. The governance alert for a coverage gap: kind privacy_layer_coverage, severity warn,
   through core.governance.alert with its default config (logged as "governance alert: ...";
   no webhook is configured from anywhere yet). The message names types, layers and reasons,
   never text. A degraded run is still forwardable: the alert is what makes the gap seen. *)
f=coveragealertkind():str{ <"privacy_layer_coverage" };

f=coveragealert(msg:str):bool{
  <alert.send(alert.defaultconfig();alert.makealert(coveragealertkind();"warn";msg))
};

(* F3b.8. The governance alerts for the organisation policy: a refusal (critical, logged as an
   error) and the settings it overrode (warn). Policy values, layer ids and setting names only. *)
f=orgpolicyalertkind():str{ <"privacy_org_policy" };

f=orgpolicyalert(severity:str;msg:str):bool{
  <alert.send(alert.defaultconfig();alert.makealert(orgpolicyalertkind();severity;"privacy organisation policy: \(msg)"))
};

(* F3b.8. ,"org_policy_overrides":[...] for a reply, or "" when the policy overrode nothing. *)
f=policyjson(r:$pipelinerun):str{
  if(r.policynotes.len==0){ <"" }el{};
  <",\"org_policy_overrides\":\(lh.typesjson(r.policynotes))"
};

(* ["PERSON","SECRET"]: the run's uncovered types, for a reply. *)
f=uncoveredjson(r:$pipelinerun):str{
  <lh.typesjson(r.uncovered)
};

(* F3b.7. A registered model can only ADD to what a run masks. It is a voter like any layer,
   so a strategy other than most-restrictive could otherwise mask less because of it: one
   more voter that did not detect a group makes unanimous and majority harder to reach, and
   under first-match a model with a lower priority than the regex layer would win a group
   against it. So when a registered model voted, the run's routing and consensus are applied
   again to the detections of the layers that are not registered models, with only those
   layers as voters, and everything that would mask is masked as well as what agreed did. Equal
   values are collapsed afterwards by dedupentities. With no registered model voting, agreed
   is returned as it is. *)
f=addonly(routing:$routingconfig;reg:$filterregistry;voters:@str;hits:@$piientity;layers:@str;strategy:str;threshold:str;agreed:@$piientity):@$piientity{
  let basevoters=mut.@();
  let models=mut.0;
  lp(let i=0;i<voters.len;i=i+1){
    let v:str=voters.get(i);
    if(fr.ismodelid(v)){ models=models+1 }el{ basevoters=basevoters.push(v) }
  };
  if(models==0){ <agreed }el{};
  let basehits=mut.@($piientity);
  let baselayers=mut.@();
  lp(let i=0;i<hits.len && i<layers.len;i=i+1){
    let l:str=layers.get(i);
    if(!fr.ismodelid(l)){
      basehits=basehits.push(hits.get(i));
      baselayers=baselayers.push(l)
    }el{}
  };
  let baserouted:$routedhits=er.apply(routing;reg;basevoters;basehits;baselayers);
  let base:$consensusresult=cn.applyranked(baserouted.entities;baserouted.layers;basevoters;strategy;threshold;ranksof(baserouted.entities));
  let out=mut.agreed;
  lp(let i=0;i<base.entities.len;i=i+1){
    let e:$piientity=base.entities.get(i);
    if(!seenvalue(out;e.value)){ out=out.push(e) }el{}
  };
  <out
};

f=run(text:str;basesystemprompt:str;config:$pipelineconfig):$pipelinerun{
  let requestid=str.randhex(16);
  log.info("pipeline start";"pipeline";requestid);

  let stages=mut.@();
  let allentities=mut.@();
  let hitlayers=mut.@();
  let voters=mut.@();
  (* NC1.9: a layer counts as completed only when it actually scanned the text. *)
  let completed=mut.0;
  let degraded=mut.0;
  let unplaced=mut.0;
  let vetoedby=mut."";
  let metrics=mut.@();
  let states=mut.@();

  (* F3b.1 / F3b.6. Every detection layer, in registry order, through the one path in
     core.privacy.layerhealth: a disabled entry is recorded as a skipped stage and sent
     nothing; an enabled one is probed, and scanned only if it answers. Completed means it
     scanned; an enabled layer that is unavailable or whose scan failed is degraded, logged
     with its id and reason, and recorded as a skipped stage with that reason. An id with no
     detector is degraded too, and has no stage of its own to record. *)
  (* F3b.8. The organisation policy over the configuration, before any layer is consulted: a
     banned layer is switched off here, so it is sent nothing. *)
  let applied:$orgapplied=op.apply(op.resolved(config.org);config.layers;config.consensus;config.consensusthreshold);
  let policy=applied.policy;
  lp(let pi=0;pi<policy.notes.len;pi=pi+1){
    log.warn("\(op.header()): \(policy.notes.get(pi))";"pipeline";requestid)
  };
  let reg=applied.registry;
  lp(let li=0;li<reg.filters.len;li=li+1){
    let layer:$privacyfilter=reg.filters.get(li);
    (* F3b.10. Timed with the millisecond clock around the whole call, probe included. *)
    let began=t.nowms();
    let lr:$layerresult=lh.consult(layer;text);
    let tookms=t.nowms()-began;
    let st:$layerstatus=lr.status;
    states=states.push(st);
    (* F3b.2. Only the detections the layer's threshold and entity filter accept count; a
       detect-only layer's are not masked and it does not vote; a veto layer's refuse. A
       layer that did not complete reported nothing, so this is empty for it. *)
    let hits=lyc.accepted(layer;lr.hits);
    metrics=fm.forlayer(metrics;layer.id;st.state;layer.mode;tookms;lr.hits;hits);
    if(lh.iscompleted(st)){
      completed=completed+1;
      if(lyc.masks(layer)){
        voters=voters.push(layer.id);
        lp(let hi=0;hi<hits.len;hi=hi+1){
          allentities=allentities.push(hits.get(hi));
          hitlayers=hitlayers.push(layer.id)
        }
      }el{};
      if(lyc.vetoes(layer;hits) && str.len(vetoedby)==0){
        vetoedby=layer.id;
        log.warn("privacy layer \(layer.id) is in veto mode and found PII -- the run will be refused";"pipeline";requestid)
      }el{};
      (* MK6.16. Logged and then forwarded until now: an entity a layer found and nothing
         masked. Counted, and issafetoforward refuses the run. *)
      if(lr.unplaced>0){
        unplaced=unplaced+lr.unplaced;
        log.warn("privacy layer \(layer.id) reported \(lr.unplaced) span(s) that could not be located in the text exactly -- the run will be refused";"pipeline";requestid)
      }el{}
    }el{};
    if(lh.isdegraded(st)){
      degraded=degraded+1;
      log.warn("privacy layer \(layer.id) \(st.state): \(st.reason) -- running degraded";"pipeline";requestid)
    }el{};
    (* F3b.7. A registered model has no stage of its own; its id, state and counts are in
       layermetrics. *)
    if(lh.isknown(layer.id) && !fr.ismodelid(layer.id)){
      stages=stages.push(layerstage(st;tookms))
    }el{}
  };
  (* A real layer the registry does not hold at all is still named in the trace, as a
     skipped stage, so detection_layers says it did not look rather than leaving it out. *)
  let absent=unregisteredstages(reg);
  lp(let ai=0;ai<absent.len;ai=ai+1){
    stages=stages.push(absent.get(ai))
  };
  (* F3b.6. A type only a down layer was configured to mask is masked by nothing this run:
     a governance alert (G1), raised here rather than in runforward because the CLI proxy,
     loke ask and the MCP broker call run and issafetoforward themselves. *)
  let uncovered=lh.uncoveredtypes(reg;states);
  if(uncovered.len>0){ coveragealert(lh.coveragemessage(reg;states;uncovered)) }el{};
  (* F3b.8. What the organisation policy refuses, now the layers have answered: its own error,
     a required layer that did not scan, or too few masking layers. *)
  let policyerror=op.refusal(policy;reg;states;voters);
  if(str.len(policyerror)>0){ orgpolicyalert("critical";"\(policyerror); the request is refused") }el{};
  if(policy.notes.len>0){ orgpolicyalert("warn";"\(op.header()) overrode this configuration: \(str.join(lh.listsep();policy.notes))") }el{};

  (* F3b.5. A routed entity type is accepted only from the layers its route names; with no
     route this returns the detections as they are. *)
  let routed:$routedhits=er.apply(config.routing;reg;voters;allentities;hitlayers);
  lp(let ni=0;ni<routed.notes.len;ni=ni+1){
    log.warn("privacy.entity_routing: \(routed.notes.get(ni))";"pipeline";requestid)
  };
  let cfgerror=mut.config.layererror;
  if(str.len(cfgerror)==0 && str.len(config.routing.error)>0){ cfgerror=er.refusal(config.routing) }el{};

  (* F3b.4. Overlapping detections are resolved by the configured strategy before dedup;
     the default, most-restrictive, keeps every detection, as this list always was. *)
  let agreed:$consensusresult=cn.applyranked(routed.entities;routed.layers;voters;applied.consensus;applied.consensusthreshold;ranksof(routed.entities));
  (* F3b.7. A registered model only adds: what the layers that are not registered models would
     have masked on their own is masked too. *)
  let dedupedraw=dedupentities(addonly(config.routing;reg;voters;allentities;hitlayers;applied.consensus;applied.consensusthreshold;agreed.entities));
  (* PL1.1 — placeholders are assigned HERE, after dedup and before anonymisation, and
     nowhere else.

     Every detection layer used to number its own entities: regex from its own
     arraylen+1, presidio from its own len+1, and both NER layers from a hardcoded 1.
     This function concatenated those lists, so `_1` arrived from more than one layer and
     every NER-detected PERSON was the same `[PERSON_NER_1]`. restore replaces
     sequentially, so the first map entry consumed every occurrence: two people in one
     prompt came back as one person, twice.

     The request id is the salt. It already exists at the top of this function, it is
     constant for the run — which restore requires — and it means a literal `[PERSON_1]`
     a user typed into their own prompt cannot be mistaken for a placeholder this run
     issued and rewritten to someone else's real name. *)
  let deduped=ph.assignplaceholders(dedupedraw;requestid);
  let dedupcount=str.arraylen(deduped);
  let dedupstage=$stageresult{
    stage:$pipelinestage{$dedup:0};
    entitiesfound:dedupcount;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=stages.push(dedupstage);

  
  let anonymisedtext=mut.text;
  let sensitivity=mut.t.public();
  if(config.dryrun){
    
    sensitivity=requestsensitivity(allentities;deduped);
    let anonstage=$stageresult{
      stage:$pipelinestage{$anonymise:0};
      entitiesfound:dedupcount;
      durationms:0;
      skipped:true;
      skipreason:"dry_run=true"
    };
    stages=stages.push(anonstage)
  }el{
    anonymisedtext=anonymisetext(text;deduped);
    sensitivity=requestsensitivity(allentities;deduped);
    let anonstage=$stageresult{
      stage:$pipelinestage{$anonymise:0};
      entitiesfound:dedupcount;
      durationms:0;
      skipped:false;
      skipreason:""
    };
    stages=stages.push(anonstage)
  };

  
  let finalsystemprompt=guardian.buildsystemprompt(basesystemprompt);
  let guardianstage=$stageresult{
    stage:$pipelinestage{$guardianinject:0};
    entitiesfound:0;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=stages.push(guardianstage);

  log.info("pipeline complete";"pipeline";requestid);

  let piiresult=$piidetectionresult{
    original:text;
    anonymised:anonymisedtext;
    entities:deduped;
    sensitivity:sensitivity
  };

  <$pipelinerun{
    result:piiresult;
    stages:stages;
    totalentities:dedupcount;
    finalsystemprompt:finalsystemprompt;
    requestid:requestid;
    layerscompleted:completed as u32;
    layersdegraded:degraded as u32;
    unplaced:unplaced as u32;
    consensus:agreed.strategy;
    resolved:agreed.resolved;
    vetoedby:vetoedby;
    layererror:cfgerror;
    layermetrics:fm.withrouted(metrics;routed.layers;routed.entities);
    voters:voters;
    routingnotes:routed.notes;
    uncovered:uncovered;
    policyerror:policyerror;
    policynotes:policy.notes;
    policyraisedfrom:policy.raisedfrom
  }
};



(* NC1.9 — the fail-closed gate.

   `run` always returns a $pipelinerun, marking unavailable layers as skipped. That is
   the right shape for a diagnostic view and the wrong shape for a gate: a caller
   reading totalentities:0 cannot tell "no PII in this text" from "nothing examined
   this text", and the second is a leak waiting to happen.

   WHY THIS IS NOT A RESULT TYPE. The obvious design is
   `runchecked(...):$pipelinerun!$lokeerr`, returning $err when nothing scanned. It is
   not used, because toke does not discriminate a result whose error side is a
   user-declared sum: `mt` on an `X!$lokeerr` value takes the FIRST ARM whatever the
   value is. With $ok written first — as it conventionally is — an $err is matched as
   $ok and its payload read as garbage. So a refusal expressed that way would be
   silently ignored by every caller, which is the exact failure NC1.9 exists to
   prevent. Verified against toke 445f519 and filed as T-18 in
   docs/upstream/toke-issues.md; stdlib results (file.read, db.exec, http.get) are
   unaffected and do discriminate.

   The gate is therefore a plain bool, which toke gets right, and the caller cannot
   confuse it with a payload:

     layerscompleted == 0   ->  issafetoforward is false. Nothing looked. Refuse.
     layerscompleted >= 1   ->  true, with layersdegraded saying what was missing.

   A degraded run is allowed on purpose: a Presidio sidecar being down must not take a
   local-first product offline.

     unplaced > 0           ->  false (MK6.16). A layer that completed reported an entity
                                loke could not place in the text exactly, so nothing masked
                                it. Refuse, rather than forward what it found. *)
f=issafetoforward(r:$pipelinerun):bool{
  <(r.layerscompleted>(0 as u32)) && (r.unplaced==(0 as u32)) && (str.len(r.vetoedby)==0) && (str.len(r.layererror)==0) && (str.len(r.policyerror)==0)
};

(* Why issafetoforward refused r, for a caller's refusal message. Names no entity. *)
f=refusalreason(r:$pipelinerun):str{
  if(str.startswith(r.layererror;er.header())){ <r.layererror }el{};
  if(str.len(r.layererror)>0){ <lyc.refusal(r.layererror) }el{};
  if(str.len(r.policyerror)>0){ <r.policyerror }el{};
  if(str.len(r.vetoedby)>0){ <"the \(r.vetoedby) privacy layer is in veto mode and found PII above its threshold" }el{};
  if(r.unplaced>0 as u32){ <"a privacy detection layer reported an entity that could not be located in the text exactly" }el{};
  <"no privacy detection layer is available"
};

(* Runs the pipeline and says in one place whether the result may leave the machine.
   Callers check the bool; there is no error arm to forget. *)
f=runforward(text:str;basesystemprompt:str;config:$pipelineconfig):$pipelinerun{
  let r=run(text;basesystemprompt;config);
  if(issafetoforward(r)){
    if(r.layersdegraded>0 as u32){
      log.warn("privacy pipeline degraded: \(r.layersdegraded) enabled layer(s) unavailable, \(r.layerscompleted) completed";"pipeline";r.requestid)
    }el{}
  }el{
    if(str.len(r.layererror)>0 || str.len(r.policyerror)>0 || str.len(r.vetoedby)>0){
      log.error("privacy pipeline failed closed: \(refusalreason(r))";"pipeline";r.requestid)
    }el{
      if(r.unplaced>0 as u32){
        log.error("privacy pipeline failed closed: \(r.unplaced) detected span(s) could not be placed in the text exactly, so this text must not be forwarded";"pipeline";r.requestid)
      }el{
        log.error("privacy pipeline failed closed: no detection layer completed a scan, so this text must not be forwarded";"pipeline";r.requestid)
      }
    }
  };
  <r
};

f=rundry(text:str;config:$pipelineconfig):$pipelinerun{
  <run(text;"";withdryrun(config;true))
};

f=applypreset(config:i64;preset:str):i64{
  <config
};

f=setentityenabled(config:i64;entitytype:str;enabled:bool):i64{
  <config
};

f=setlayerenabled(config:i64;layerid:str;enabled:bool):i64{
  <config
};

m=core.privacy.pipeline;




i=t:shared.types;
i=str:std.str;
i=log:shared.log;
i=regex:core.privacy.regex;
i=presidio:core.privacy.presidio;
i=ner:core.privacy.ner;
i=ph:core.privacy.placeholder;
i=guardian:core.privacy.guardian;

t=$pipelineconfig{
  presidiourl:str;
  ollamaurl:str;
  nermodelid:str;
  usepresidio:bool;
  usener:bool;
  dryrun:bool
};

t=$pipelinestage{
  $regexscan:i64;
  $nerscan:i64;
  $presidioscan:i64;
  $dedup:i64;
  $anonymise:i64;
  $guardianinject
};

t=$stageresult{
  stage:$pipelinestage;
  entitiesfound:u32;
  durationms:u32;
  skipped:bool;
  skipreason:str
};

t=$pipelinerun{
  result:$piidetectionresult;
  stages:@$stageresult;
  totalentities:u32;
  finalsystemprompt:str;
  requestid:str
};


f=newconfig(presidiourl:str;ollamaurl:str):$pipelineconfig{
  <$pipelineconfig{
    presidiourl:presidiourl;
    ollamaurl:ollamaurl;
    nermodelid:"qwen2.5:7b";
    usepresidio:true;
    usener:true;
    dryrun:false
  }
};


f=ishighersensitivity(levela:$sensitivitylevel;levelb:$sensitivitylevel):bool{
  if(levela=$restricted){
    <true
  }el{
    if(levela=$confidential){
      if(levelb=$restricted){
        <false
      }el{
        <true
      }
    }el{
      if(levela=$internal){
        if(levelb=$restricted){
          <false
        }el{
          if(levelb=$confidential){
            <false
          }el{
            <true
          }
        }
      }el{
        <false
      }
    }
  }
};



f=dedupentities(entities:@$piientity):@$piientity{
  let kept=@();
  let count=entities.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let candidate=str.arrayget(entities;i);
      let overlaps=false;
      let ki=0;
      let keptcount=str.arraylen(kept);
      lp(let lv=0;true;lv=lv){
        if(ki>keptcount){
          break
        }el{
          let existing=str.arrayget(kept;ki);
          
          
          
          
          if(candidate.start=0){
            
            ki=keptcount
          }el{
            if(existing.start=0){
              
              ki=ki+1
            }el{
              if(candidate.start<existing.end){
                if(candidate.end>existing.start){
                  
                  if(candidate.confidence>existing.confidence){
                    
                    let newkept=@();
                    let ri=0;
                    lp(let lv=0;true;lv=lv){
                      if(ri>keptcount){
                        break
                      }el{
                        let re=str.arrayget(kept;ri);
                        if(ri=ki){
                          
                          ri=ri+1
                        }el{
                          newkept=@(newkept;re);
                          ri=ri+1
                        }
                      }
                    };
                    kept=newkept;
                    overlaps=false;
                    ki=keptcount
                  }el{
                    overlaps=true;
                    ki=keptcount
                  }
                }el{
                  ki=ki+1
                }
              }el{
                ki=ki+1
              }
            }
          }
        }
      };
      if(overlaps){
        
        i=i+1;
      }el{
        kept=@(kept;candidate);
        i=i+1;
      }
    }
  };
  <kept
};


f=maxsensitivity(entities:@$piientity):$sensitivitylevel{
  let level=$public;
  let count=entities.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let entity=str.arrayget(entities;i);
      
      
      if(str.eq(entity.entitytype;"CREDIT_CARD")){
        level=$restricted
      }el{
        if(str.eq(entity.entitytype;"US_SSN")){
          level=$restricted
        }el{
          if(str.eq(entity.entitytype;"AU_TFN")){
            level=$restricted
          }el{
            if(str.eq(entity.entitytype;"credit_card")){
              level=$restricted
            }el{
              if(str.eq(entity.entitytype;"au_tfn")){
                level=$restricted
              }el{
                if(str.eq(entity.entitytype;"ssn_us")){
                  level=$restricted
                }el{
                  if(str.eq(entity.entitytype;"api_key")){
                    level=$restricted
                  }el{
                    if(ishighersensitivity($confidential;level)){
                      if(str.eq(entity.entitytype;"PERSON")){
                        level=$confidential
                      }el{
                        if(str.eq(entity.entitytype;"EMAIL_ADDRESS")){
                          level=$confidential
                        }el{
                          if(str.eq(entity.entitytype;"PHONE_NUMBER")){
                            level=$confidential
                          }el{
                            if(str.eq(entity.entitytype;"MEDICAL")){
                              level=$confidential
                            }el{
                              if(str.eq(entity.entitytype;"FINANCIAL")){
                                level=$confidential
                              }el{
                                if(str.eq(entity.entitytype;"email")){
                                  if(ishighersensitivity($confidential;level)){
                                    level=$confidential
                                  }el{
                                    
                                  }
                                }el{
                                  if(ishighersensitivity($internal;level)){
                                    level=$internal
                                  }el{
                                    
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }el{
                      
                    }
                  }
                }
              }
            }
          }
        }
      };
      i=i+1;
    }
  };
  <level
};


f=anonymisetext(text:str;entities:@$piientity):str{
  let result=text;
  let count=entities.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let entity=str.arrayget(entities;i);
      result=str.replace(result;entity.value;entity.placeholder);
      i=i+1;
    }
  };
  <result
};


f=countrestricted(entities:@$piientity):u32{
  let n=0;
  let count=entities.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let entity=str.arrayget(entities;i);
      if(str.eq(entity.entitytype;"CREDIT_CARD")){
        n=n+1
      }el{
        if(str.eq(entity.entitytype;"US_SSN")){
          n=n+1
        }el{
          if(str.eq(entity.entitytype;"AU_TFN")){
            n=n+1
          }el{
            if(str.eq(entity.entitytype;"credit_card")){
              n=n+1
            }el{
              if(str.eq(entity.entitytype;"au_tfn")){
                n=n+1
              }el{
                if(str.eq(entity.entitytype;"ssn_us")){
                  n=n+1
                }el{
                  if(str.eq(entity.entitytype;"api_key")){
                    n=n+1
                  }el{
                    
                  }
                }
              }
            }
          }
        }
      };
      i=i+1;
    }
  };
  <n
};

f=countconfidential(entities:@$piientity):u32{
  let n=0;
  let count=entities.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let entity=str.arrayget(entities;i);
      if(str.eq(entity.entitytype;"PERSON")){
        n=n+1
      }el{
        if(str.eq(entity.entitytype;"EMAIL_ADDRESS")){
          n=n+1
        }el{
          if(str.eq(entity.entitytype;"PHONE_NUMBER")){
            n=n+1
          }el{
            if(str.eq(entity.entitytype;"MEDICAL")){
              n=n+1
            }el{
              if(str.eq(entity.entitytype;"FINANCIAL")){
                n=n+1
              }el{
                if(str.eq(entity.entitytype;"email")){
                  n=n+1
                }el{
                  if(str.eq(entity.entitytype;"phone_au")){
                    n=n+1
                  }el{
                    if(str.eq(entity.entitytype;"phone_us")){
                      n=n+1
                    }el{
                      if(str.eq(entity.entitytype;"au_abn")){
                        n=n+1
                      }el{
                        
                      }
                    }
                  }
                }
              }
            }
          }
        }
      };
      i=i+1;
    }
  };
  <n
};


f=summariserun(run:$pipelinerun):str{
  let total=str.fromu32(run.totalentities);
  let restrictedcount=countrestricted(run.result.entities);
  let confidentialcount=countconfidential(run.result.entities);
  let rstr=str.fromu32(restrictedcount);
  let cstr=str.fromu32(confidentialcount);
  let stagecount=str.fromu32(run.stages.len);
  let anonymisedlabel="Anonymised.";
  if(run.result.sensitivity=$public){
    let anonymisedlabel="No PII detected."
  }el{
    
  };
  let part1=str.concat("Privacy pipeline: ";total);
  let part2=str.concat(part1;" entities detected (");
  let part3=str.concat(part2;rstr);
  let part4=str.concat(part3;" RESTRICTED, ");
  let part5=str.concat(part4;cstr);
  let part6=str.concat(part5;" CONFIDENTIAL) across ");
  let part7=str.concat(part6;stagecount);
  let part8=str.concat(part7;" stages. ");
  let result=str.concat(part8;anonymisedlabel);
  <result
};



f=run(text:str;basesystemprompt:str;config:$pipelineconfig):$pipelinerun{
  let requestid=str.randhex(16);
  log.info("pipeline start";"pipeline";requestid);

  let stages=@();
  let allentities=@();

  
  let regexresult=regex.detect(text);
  let regexentitycount=str.arraylen(regexresult.entities);
  let regexstage=$stageresult{
    stage:$regexscan;
    entitiesfound:regexentitycount;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=@(stages;regexstage);
  let ei=0;
  lp(let lv=0;true;lv=lv){
    if(ei>regexentitycount){
      break
    }el{
      let entity=str.arrayget(regexresult.entities;ei);
      allentities=@(allentities;entity);
      ei=ei+1
    }
  };

  
  if(config.usener){
    let nerclient=ner.new(config.ollamaurl;config.nermodelid);
    let neravailable=ner.isavailable(nerclient);
    if(neravailable){
      let nerresult=ner.detectentities(nerclient;text);
      mt nerresult {
        $lokeerr:e;
          log.warn("NER scan failed — skipping";"pipeline";requestid);
          let nerstage=$stageresult{
            stage:$nerscan;
            entitiesfound:0;
            durationms:0;
            skipped:true;
            skipreason:"NER detect_entities returned error"
          };
          stages=@(stages;nerstage)
        nerentities;
          let nercount=str.arraylen(nerentities);
          let ni=0;
          lp(let lv=0;true;lv=lv){
            if(ni>nercount){
              break
            }el{
              let entity=str.arrayget(nerentities;ni);
              allentities=@(allentities;entity);
              ni=ni+1
            }
          };
          let nerstage=$stageresult{
            stage:$nerscan;
            entitiesfound:nercount;
            durationms:0;
            skipped:false;
            skipreason:""
          };
          stages=@(stages;nerstage)
      }
    }el{
      log.warn("NER unavailable — skipping NER scan";"pipeline";requestid);
      let nerstage=$stageresult{
        stage:$nerscan;
        entitiesfound:0;
        durationms:0;
        skipped:true;
        skipreason:"Ollama unreachable"
      };
      stages=@(stages;nerstage)
    }
  }el{
    let nerstage=$stageresult{
      stage:$nerscan;
      entitiesfound:0;
      durationms:0;
      skipped:true;
      skipreason:"use_ner=false"
    };
    stages=@(stages;nerstage)
  };

  
  if(config.usepresidio){
    let presidioclient=presidio.new(config.presidiourl);
    let presidioavailable=presidio.isavailable(presidioclient);
    if(presidioavailable){
      let presidioresult=presidio.analyze(presidioclient;text);
      mt presidioresult {
        $lokeerr:e;
          log.warn("Presidio scan failed — degraded mode";"pipeline";requestid);
          let presidiostage=$stageresult{
            stage:$presidioscan;
            entitiesfound:0;
            durationms:0;
            skipped:true;
            skipreason:"Presidio analyze returned error"
          };
          stages=@(stages;presidiostage)
        rawpresidioentities;
          let piifrompresidio=presidio.topiientities(rawpresidioentities;text);
          let presidiocount=str.arraylen(piifrompresidio);
          let pri=0;
          lp(let lv=0;true;lv=lv){
            if(pri>presidiocount){
              break
            }el{
              let entity=str.arrayget(piifrompresidio;pri);
              allentities=@(allentities;entity);
              pri=pri+1
            }
          };
          let presidiostage=$stageresult{
            stage:$presidioscan;
            entitiesfound:presidiocount;
            durationms:0;
            skipped:false;
            skipreason:""
          };
          stages=@(stages;presidiostage)
      }
    }el{
      log.warn("Presidio unavailable — running in degraded mode";"pipeline";requestid);
      let presidiostage=$stageresult{
        stage:$presidioscan;
        entitiesfound:0;
        durationms:0;
        skipped:true;
        skipreason:"Presidio sidecar unreachable"
      };
      stages=@(stages;presidiostage)
    }
  }el{
    let presidiostage=$stageresult{
      stage:$presidioscan;
      entitiesfound:0;
      durationms:0;
      skipped:true;
      skipreason:"use_presidio=false"
    };
    stages=@(stages;presidiostage)
  };

  
  let deduped=dedupentities(allentities);
  let dedupcount=str.arraylen(deduped);
  let dedupstage=$stageresult{
    stage:$dedup;
    entitiesfound:dedupcount;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=@(stages;dedupstage);

  
  let anonymisedtext=text;
  let sensitivity=$public;
  if(config.dryrun){
    
    sensitivity=maxsensitivity(deduped);
    let anonstage=$stageresult{
      stage:$anonymise;
      entitiesfound:dedupcount;
      durationms:0;
      skipped:true;
      skipreason:"dry_run=true"
    };
    stages=@(stages;anonstage)
  }el{
    anonymisedtext=anonymisetext(text;deduped);
    sensitivity=maxsensitivity(deduped);
    let anonstage=$stageresult{
      stage:$anonymise;
      entitiesfound:dedupcount;
      durationms:0;
      skipped:false;
      skipreason:""
    };
    stages=@(stages;anonstage)
  };

  
  let finalsystemprompt=guardian.buildsystemprompt(basesystemprompt);
  let guardianstage=$stageresult{
    stage:$guardianinject;
    entitiesfound:0;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=@(stages;guardianstage);

  log.info("pipeline complete";"pipeline";requestid);

  let piiresult=t.$piidetectionresult{
    original:text;
    anonymised:anonymisedtext;
    entities:deduped;
    sensitivity:sensitivity
  };

  <$pipelinerun{
    result:piiresult;
    stages:stages;
    totalentities:dedupcount;
    finalsystemprompt:finalsystemprompt;
    requestid:requestid
  }
};



f=rundry(text:str;config:$pipelineconfig):$pipelinerun{
  let dryconfig=$pipelineconfig{
    presidiourl:config.presidiourl;
    ollamaurl:config.ollamaurl;
    nermodelid:config.nermodelid;
    usepresidio:config.usepresidio;
    usener:config.usener;
    dryrun:true
  };
  <run(text;"";dryconfig)
};

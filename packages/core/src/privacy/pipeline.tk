m=core.privacy.pipeline;




i=str:std.str;
i=log:shared.log;
i=regex:core.privacy.regex;
i=presidio:core.privacy.presidio;
i=ner:core.privacy.ner;
i=guardian:core.privacy.guardian;
i=t:shared.types;
i=ph:core.privacy.placeholder;
i=pt:core.privacy.pipelinetypes;
i=pf:core.privacy.sidecarclient;
i=cfg:shared.config;

(* F3b.3. usepf, pfurl and pfthreshold are the privacy-filter sidecar layer
   (packages/privacy-filter/server.py). newconfig leaves it OFF, so a caller that says
   nothing about it gets the three layers it had; withlokeconfig and configured turn it on
   from privacy.privacy_filter in the user's config.toml. *)
t=$pipelineconfig{
  presidiourl:str;
  ollamaurl:str;
  nermodelid:str;
  usepresidio:bool;
  usener:bool;
  dryrun:bool;
  usepf:bool;
  pfurl:str;
  pfthreshold:str
};

t=$stageresult{
  stage:$pipelinestage;
  entitiesfound:u32;
  durationms:u32;
  skipped:bool;
  skipreason:str
};

t=$pipelinerun{
  result:$piidetectionresult;
  stages:@$stageresult;
  totalentities:u32;
  finalsystemprompt:str;
  requestid:str;
  (* NC1.9. layerscompleted is how many detection layers actually scanned the text.
     Zero means nothing looked at it, which is not the same as finding nothing, and
     the two were previously indistinguishable to a caller: both came back as
     totalentities:0 with a $pipelinerun that looked like a clean result.
     layersdegraded counts layers the operator enabled that were unavailable. *)
  layerscompleted:u32;
  layersdegraded:u32
};


f=newconfig(presidiourl:str;ollamaurl:str):$pipelineconfig{
  <$pipelineconfig{
    presidiourl:presidiourl;
    ollamaurl:ollamaurl;
    nermodelid:"qwen2.5:7b";
    usepresidio:true;
    usener:true;
    dryrun:false;
    usepf:false;
    pfurl:pf.sidecarurl();
    pfthreshold:""
  }
};

(* The privacy-filter layer switched on (or off) at a sidecar URL and operating point. The
   threshold is text, as core.privacy.sidecarclient.new takes it (AD1.4, T-20). *)
f=withprivacyfilter(c:$pipelineconfig;enabled:bool;url:str;threshold:str):$pipelineconfig{
  <$pipelineconfig{
    presidiourl:c.presidiourl;
    ollamaurl:c.ollamaurl;
    nermodelid:c.nermodelid;
    usepresidio:c.usepresidio;
    usener:c.usener;
    dryrun:c.dryrun;
    usepf:enabled;
    pfurl:url;
    pfthreshold:threshold
  }
};

f=withlokeconfig(c:$pipelineconfig;lc:$lokeconfig):$pipelineconfig{
  <withprivacyfilter(c;lc.usepf;lc.pfurl;lc.pfthreshold)
};

(* newconfig plus the privacy-filter settings from the user's config.toml, read now. *)
f=configured(presidiourl:str;ollamaurl:str):$pipelineconfig{
  <withlokeconfig(newconfig(presidiourl;ollamaurl);cfg.loaded())
};


(* Ranked, not a chain of == comparisons. `levela==$restricted` is false even when
   levela IS restricted, because == on a sum compares the handle and the level came
   from another function. See shared.types.sensrank and docs/upstream/toke-issues.md
   T-14. The old chain also returned false for every (public, anything) pair, which
   meant maxsensitivity never escalated past its initial value. *)
f=ishighersensitivity(levela:$sensitivitylevel;levelb:$sensitivitylevel):bool{
  <t.senshigher(levela;levelb)
};




(* Dedup is by VALUE, and also drops a lower-confidence overlapping span.

   Deduping by span alone was wrong for how anonymisation actually works:
   anonymisetext replaces with str.replace(text; entity.value; entity.placeholder),
   which substitutes EVERY occurrence of that value. So two entities carrying the same
   value produced two placeholders, the first str.replace consumed both occurrences,
   and the second entity's placeholder never appeared in the text at all — while still
   being reported in the entity count and written to the restoration map. One entity
   per distinct value is what the replacement strategy needs, and it is what makes the
   same value get the same placeholder.

   The previous version also treated `start==0` as "position unknown" and skipped the
   overlap test for it, which silently exempted every entity at offset 0 — a real
   offset, and the commonest one in a short prompt. *)
f=seenvalue(kept:@$piientity;value:str):bool{
  let found=mut.false;
  lp(let i=0;i<kept.len;i=i+1){
    let e:$piientity=kept.get(i);
    if(str.eq(e.value;value)){
      found=true
    }el{}
  };
  <found
};

(* PL1.9 -- shadowing is decided over the whole detection list, not over whichever prefix
   of it happened to be kept already.

   The old predicate was `overlapsbetter(kept;candidate)`: drop a CANDIDATE overlapping an
   already-kept entity of at least equal confidence. It never revisited a kept entity when
   a better overlapping one arrived later, so the same two detections produced two
   different entity lists depending on which detection layer ran first:

     Bob (0.78) then Bob Jones (0.92)  ->  both kept
     Bob Jones (0.92) then Bob (0.78)  ->  only Bob Jones kept

   Layer order is a configuration detail, not a property of the text. The shorter is a
   strict shadow of the longer either way, and either way it inflated the reported entity
   count and put an entry in the restoration map whose placeholder never reaches the
   prompt.

   WHY THE RELATION IS NARROWER THAN "OVERLAPS AND IS LESS CONFIDENT". Dropping an entity
   means nothing will substitute its value, so it is only safe to drop one whose value is
   a substring of a survivor that covers its span: ph.applytotext substitutes longest
   value first, so replacing "Bob Jones" removes the "Bob" inside it. Merely overlapping
   spans give no such guarantee -- dropping on overlap alone can leave the part of the
   loser that the winner does not cover sitting in the prompt in the clear, which the old
   predicate could do. So `shadow` shadows `target` when the shadow's span covers the
   target's, the shadow's value strictly contains the target's, and the shadow is at least
   as confident.

   That relation is transitive (span nesting, substring and >= all are) and antisymmetric
   (strict containment cannot hold in both directions), so the survivors are its maximal
   elements, every dropped entity's value sits inside a survivor's, and no two entities
   can shadow each other into both being dropped.

   WHAT THIS GIVES UP, stated rather than hidden: when the shorter value also occurs
   somewhere the longer does not -- "Bob Jones and Bob", with only the first Bob detected
   -- keeping the shorter entity meant applytotext replaced the later bare "Bob" too.
   Dropping it loses that. It was never a guarantee: the other arrival order already lost
   it, and it depends on a layer having reported one occurrence of a value and the
   substitution over-applying to all of them. Order independence means choosing one of
   the two old behaviours, and inflating the count and the restore map is the worse one.

   ENTITIES WITH NO SPANS ARE UNTOUCHED. Requiring end>start on BOTH sides means a spanless
   entity neither shadows nor is shadowed -- the same outcome as before this change, since
   the old test `candidate.start<e.end` was also false for an empty span. Equal values are
   still collapsed by seenvalue, span or no span.

   PL1.7 has since landed, so the regex layer is no longer the spanless case this paragraph
   was written for: regex.rundetection now recovers each match's offset from str.indexof and
   reports a real span, and shadowing is live for it. The two NER layers and any future
   layer that reports a detection without an offset still take the spanless path, which is
   why the requirement stays rather than becoming an assertion. *)
f=strictlyshadows(shadow:$piientity;target:$piientity):bool{
  let spanned=mut.false;
  if(shadow.end>shadow.start){
    if(target.end>target.start){
      spanned=true
    }el{}
  }el{};
  let shadows=mut.false;
  if(spanned){
    if(shadow.start<=target.start){
      if(shadow.end>=target.end){
        if(shadow.confidence>=target.confidence){
          if(str.contains(shadow.value;target.value)){
            if(str.eq(shadow.value;target.value)){}el{
              shadows=true
            }
          }el{}
        }el{}
      }el{}
    }el{}
  }el{};
  <shadows
};

(* Scanned over the WHOLE input list, which is the part that makes the answer independent
   of arrival order. Including the target itself is harmless: strictlyshadows requires the
   two values to differ, so nothing shadows itself. *)
f=shadowedbyany(entities:@$piientity;target:$piientity):bool{
  let shadowed=mut.false;
  lp(let i=0;i<entities.len;i=i+1){
    let e:$piientity=entities.get(i);
    if(strictlyshadows(e;target)){
      shadowed=true
    }el{}
  };
  <shadowed
};

f=dedupentities(entities:@$piientity):@$piientity{
  let kept=mut.@();
  lp(let i=0;i<entities.len;i=i+1){
    let candidate:$piientity=entities.get(i);
    if(seenvalue(kept;candidate.value)){}el{
      if(shadowedbyany(entities;candidate)){}el{
        kept=kept.push(candidate)
      }
    }
  };
  <kept
};

f=maxsensitivity(entities:@$piientity):$sensitivitylevel{
  let level=mut.t.public();
  let count=entities.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let entity=entities.get(i);
      
      
      if(str.eq(entity.entitytype;"CREDIT_CARD")){
        level=t.restricted()
      }el{
        if(str.eq(entity.entitytype;"US_SSN")){
          level=t.restricted()
        }el{
          if(str.eq(entity.entitytype;"AU_TFN")){
            level=t.restricted()
          }el{
            if(str.eq(entity.entitytype;"credit_card")){
              level=t.restricted()
            }el{
              if(str.eq(entity.entitytype;"au_tfn")){
                level=t.restricted()
              }el{
                if(str.eq(entity.entitytype;"ssn_us")){
                  level=t.restricted()
                }el{
                  if(str.eq(entity.entitytype;"api_key") || str.eq(entity.entitytype;"SECRET")){
                    level=t.restricted()
                  }el{
                    if(ishighersensitivity(t.confidential();level)){
                      if(str.eq(entity.entitytype;"PERSON")){
                        level=t.confidential()
                      }el{
                        if(str.eq(entity.entitytype;"EMAIL_ADDRESS")){
                          level=t.confidential()
                        }el{
                          if(str.eq(entity.entitytype;"PHONE_NUMBER")){
                            level=t.confidential()
                          }el{
                            if(str.eq(entity.entitytype;"MEDICAL")){
                              level=t.confidential()
                            }el{
                              if(str.eq(entity.entitytype;"FINANCIAL") || str.eq(entity.entitytype;"ADDRESS")){
                                level=t.confidential()
                              }el{
                                if(str.eq(entity.entitytype;"email")){
                                  if(ishighersensitivity(t.confidential();level)){
                                    level=t.confidential()
                                  }el{
                                    
                                  }
                                }el{
                                  if(ishighersensitivity(t.internal();level)){
                                    level=t.internal()
                                  }el{
                                    
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }el{
                      
                    }
                  }
                }
              }
            }
          }
        }
      };
      i=i+1;
    }
  };
  <level
};


(* Delegates. The substitution loop existed here AND inline in regex.rundetection, each
   fed by a different placeholder generator, which is how a collision in one of them
   stayed invisible in the other. One loop, in the module that owns the placeholder.

   Only ever call this on a list that has been through placeholder.assignplaceholders:
   detection layers now leave .placeholder empty, and replacing a value with "" deletes
   it from the prompt instead of anonymising it. *)
f=anonymisetext(text:str;entities:@$piientity):str{
  <ph.applytotext(text;entities)
};


f=countrestricted(entities:@$piientity):u32{
  let n=mut.0;
  let count=entities.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let entity=entities.get(i);
      if(str.eq(entity.entitytype;"CREDIT_CARD")){
        n=n+1
      }el{
        if(str.eq(entity.entitytype;"US_SSN")){
          n=n+1
        }el{
          if(str.eq(entity.entitytype;"AU_TFN")){
            n=n+1
          }el{
            if(str.eq(entity.entitytype;"credit_card")){
              n=n+1
            }el{
              if(str.eq(entity.entitytype;"au_tfn")){
                n=n+1
              }el{
                if(str.eq(entity.entitytype;"ssn_us")){
                  n=n+1
                }el{
                  if(str.eq(entity.entitytype;"api_key") || str.eq(entity.entitytype;"SECRET")){
                    n=n+1
                  }el{
                    
                  }
                }
              }
            }
          }
        }
      };
      i=i+1;
    }
  };
  <n
};

f=countconfidential(entities:@$piientity):u32{
  let n=mut.0;
  let count=entities.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let entity=entities.get(i);
      if(str.eq(entity.entitytype;"PERSON")){
        n=n+1
      }el{
        if(str.eq(entity.entitytype;"EMAIL_ADDRESS")){
          n=n+1
        }el{
          if(str.eq(entity.entitytype;"PHONE_NUMBER")){
            n=n+1
          }el{
            if(str.eq(entity.entitytype;"MEDICAL")){
              n=n+1
            }el{
              if(str.eq(entity.entitytype;"FINANCIAL") || str.eq(entity.entitytype;"ADDRESS")){
                n=n+1
              }el{
                if(str.eq(entity.entitytype;"email")){
                  n=n+1
                }el{
                  if(str.eq(entity.entitytype;"phone_au")){
                    n=n+1
                  }el{
                    if(str.eq(entity.entitytype;"phone_us")){
                      n=n+1
                    }el{
                      if(str.eq(entity.entitytype;"au_abn")){
                        n=n+1
                      }el{
                        
                      }
                    }
                  }
                }
              }
            }
          }
        }
      };
      i=i+1;
    }
  };
  <n
};


f=summariserun(run:$pipelinerun):str{
  (* Every count here is bound with `:str`. Interpolating a str.fromu32 result directly
     printed its ADDRESS, so this line read "4378090592 entities detected" (T-41). *)
  let total:str=str.fromint(run.totalentities);
  let restricted:str=str.fromint(countrestricted(run.result.entities));
  let confidential:str=str.fromint(countconfidential(run.result.entities));
  let stages:str=str.fromint(run.stages.len);
  let res:$piidetectionresult=run.result;
  (* `let anonymisedlabel="No PII detected."` inside the if declared a second,
     branch-local binding, so the summary always read "Anonymised." — including when
     nothing had been detected and nothing had been anonymised. A match arm is an
     expression, so the label is the value of the conditional. *)
  let anonymisedlabel=mut."Anonymised.";
  if(t.senseq(res.sensitivity;t.public())){
    anonymisedlabel="No PII detected."
  }el{};
  <"Privacy pipeline: \(total) entities detected (\(restricted) RESTRICTED, \(confidential) CONFIDENTIAL) across \(stages) stages. \(anonymisedlabel)"
};




f=pipelinenerskip(requestid:str):$stageresult{
  log.warn("NER scan failed -- skipping";"pipeline";requestid);
  <$stageresult{
    stage:$pipelinestage{$nerscan:0};
    entitiesfound:0;
    durationms:0;
    skipped:true;
    skipreason:"NER detect_entities returned error"
  }
};

f=run(text:str;basesystemprompt:str;config:$pipelineconfig):$pipelinerun{
  let requestid=str.randhex(16);
  log.info("pipeline start";"pipeline";requestid);

  let stages=mut.@();
  let allentities=mut.@();
  (* NC1.9: a layer counts as completed only when it actually scanned the text. *)
  let completed=mut.0;
  let degraded=mut.0;

  
  let regexresult=regex.detect(text);
  let regexentitycount=str.arraylen(regexresult.entities);
  let regexstage=$stageresult{
    stage:$pipelinestage{$regexscan:0};
    entitiesfound:regexentitycount;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=stages.push(regexstage);
  completed=completed+1;
  let ei=mut.0;
  lp(let lv=0;true;lv=lv){
    if(ei>=regexentitycount){
      br
    }el{
      let entity=regexresult.entities.get(ei);
      allentities=allentities.push(entity);
      ei=ei+1
    }
  };

  
  if(config.usener){
    let nerclient=ner.new(config.ollamaurl;config.nermodelid);
    let neravailable=ner.isavailable(nerclient);
    if(neravailable){
      (* VM1.6e. A plain struct, not detectentities' result: `mt` on a result whose error
         side is a user sum takes the first arm whatever the value is (T-18), so a failed
         scan was counted as a completed layer. See core.privacy.ner.scan. *)
      let nerscan=ner.scan(nerclient;text);
      if(nerscan.ok){
        let nerentities=nerscan.nerhits;
        let nercount=str.arraylen(nerentities);
        let ni=mut.0;
        lp(let lv2=0;true;lv2=lv2){
          if(ni>=nercount){
            br
          }el{
            let entity=nerentities.get(ni);
            allentities=allentities.push(entity);
            ni=ni+1
          }
        };
        let nerstage=$stageresult{
          stage:$pipelinestage{$nerscan:0};
          entitiesfound:nercount;
          durationms:0;
          skipped:false;
          skipreason:""
        };
        stages=stages.push(nerstage);
        completed=completed+1
      }el{
        let skipstage=pipelinenerskip(requestid);
        stages=stages.push(skipstage);
        degraded=degraded+1
      }
    }el{
      degraded=degraded+1;
      log.warn("NER unavailable -- skipping NER scan";"pipeline";requestid);
      let nerstage=$stageresult{
        stage:$pipelinestage{$nerscan:0};
        entitiesfound:0;
        durationms:0;
        skipped:true;
        skipreason:"Ollama unreachable"
      };
      stages=stages.push(nerstage)
    }
  }el{
    let nerstage=$stageresult{
      stage:$pipelinestage{$nerscan:0};
      entitiesfound:0;
      durationms:0;
      skipped:true;
      skipreason:"use_ner=false"
    };
    stages=stages.push(nerstage)
  };

  
  if(config.usepresidio){
    let presidioclient=presidio.new(config.presidiourl);
    let presidioavailable=presidio.isavailable(presidioclient);
    if(presidioavailable){
      (* VM1.6e. See core.privacy.presidio.scan: measured, the result form counted a
         Presidio that was never reached as a completed layer (T-18). *)
      let presidioscan=presidio.scan(presidioclient;text);
      if(presidioscan.ok){
        let rawpresidioentities=presidioscan.presidiohits;
        let piifrompresidio=presidio.topiientities(rawpresidioentities;text);
        let presidiocount=str.arraylen(piifrompresidio);
        let pri=mut.0;
        lp(let lv3=0;pri<presidiocount;lv3=lv3){
          let entity=piifrompresidio.get(pri);
          allentities=allentities.push(entity);
          pri=pri+1
        };
        let presidiostage=$stageresult{
          stage:$pipelinestage{$presidioscan:0};
          entitiesfound:presidiocount;
          durationms:0;
          skipped:false;
          skipreason:""
        };
        stages=stages.push(presidiostage);
        completed=completed+1
      }el{
        degraded=degraded+1;
        log.warn("Presidio scan failed -- degraded mode";"pipeline";requestid);
        let presidiostage=$stageresult{
          stage:$pipelinestage{$presidioscan:0};
          entitiesfound:0;
          durationms:0;
          skipped:true;
          skipreason:"Presidio analyze returned error"
        };
        stages=stages.push(presidiostage)
      }
    }el{
      degraded=degraded+1;
      log.warn("Presidio unavailable -- running in degraded mode";"pipeline";requestid);
      let presidiostage=$stageresult{
        stage:$pipelinestage{$presidioscan:0};
        entitiesfound:0;
        durationms:0;
        skipped:true;
        skipreason:"Presidio sidecar unreachable"
      };
      stages=stages.push(presidiostage)
    }
  }el{
    let presidiostage=$stageresult{
      stage:$pipelinestage{$presidioscan:0};
      entitiesfound:0;
      durationms:0;
      skipped:true;
      skipreason:"use_presidio=false"
    };
    stages=stages.push(presidiostage)
  };

  (* F3b.3 -- the privacy-filter sidecar, the fourth layer. Counted exactly as NER and
     Presidio are: completed only when /detect answered a scan whose entities could all be
     read; degraded when it is enabled and either does not answer /health or does not scan;
     a skipped stage either way, so detection_layers names it. Its health check is the
     one-argument client GET and its scan a loopback-only POST (sidecarclient). AD1.3
     measured this layer's marginal value on the PII corpus; see docs/metrics-baseline.md. *)
  if(config.usepf){
    let pfclient=pf.new(config.pfurl;config.pfthreshold);
    if(pf.isavailable(pfclient)){
      let pfscan=pf.scanentities(pfclient;text);
      if(pfscan.ok){
        let pfhits=pfscan.hits;
        let pfcount=str.arraylen(pfhits);
        let pfi=mut.0;
        lp(let lv4=0;pfi<pfcount;lv4=lv4){
          let entity=pfhits.get(pfi);
          allentities=allentities.push(entity);
          pfi=pfi+1
        };
        if(pfscan.unplaced>0){
          log.warn("privacy filter reported \(pfscan.unplaced) span(s) that could not be located in the text";"pipeline";requestid)
        }el{};
        let pfstage=$stageresult{
          stage:$pipelinestage{$privacyfilterscan:0};
          entitiesfound:pfcount;
          durationms:0;
          skipped:false;
          skipreason:""
        };
        stages=stages.push(pfstage);
        completed=completed+1
      }el{
        degraded=degraded+1;
        log.warn("privacy filter scan failed -- degraded mode";"pipeline";requestid);
        let pfstage=$stageresult{
          stage:$pipelinestage{$privacyfilterscan:0};
          entitiesfound:0;
          durationms:0;
          skipped:true;
          skipreason:"privacy-filter detect returned no scan"
        };
        stages=stages.push(pfstage)
      }
    }el{
      degraded=degraded+1;
      log.warn("privacy filter unavailable -- running in degraded mode";"pipeline";requestid);
      let pfstage=$stageresult{
        stage:$pipelinestage{$privacyfilterscan:0};
        entitiesfound:0;
        durationms:0;
        skipped:true;
        skipreason:"privacy-filter sidecar unreachable"
      };
      stages=stages.push(pfstage)
    }
  }el{
    let pfstage=$stageresult{
      stage:$pipelinestage{$privacyfilterscan:0};
      entitiesfound:0;
      durationms:0;
      skipped:true;
      skipreason:"use_privacy_filter=false"
    };
    stages=stages.push(pfstage)
  };

  
  let dedupedraw=dedupentities(allentities);
  (* PL1.1 — placeholders are assigned HERE, after dedup and before anonymisation, and
     nowhere else.

     Every detection layer used to number its own entities: regex from its own
     arraylen+1, presidio from its own len+1, and both NER layers from a hardcoded 1.
     This function concatenated those lists, so `_1` arrived from more than one layer and
     every NER-detected PERSON was the same `[PERSON_NER_1]`. restore replaces
     sequentially, so the first map entry consumed every occurrence: two people in one
     prompt came back as one person, twice.

     The request id is the salt. It already exists at the top of this function, it is
     constant for the run — which restore requires — and it means a literal `[PERSON_1]`
     a user typed into their own prompt cannot be mistaken for a placeholder this run
     issued and rewritten to someone else's real name. *)
  let deduped=ph.assignplaceholders(dedupedraw;requestid);
  let dedupcount=str.arraylen(deduped);
  let dedupstage=$stageresult{
    stage:$pipelinestage{$dedup:0};
    entitiesfound:dedupcount;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=stages.push(dedupstage);

  
  let anonymisedtext=mut.text;
  let sensitivity=mut.t.public();
  if(config.dryrun){
    
    sensitivity=maxsensitivity(deduped);
    let anonstage=$stageresult{
      stage:$pipelinestage{$anonymise:0};
      entitiesfound:dedupcount;
      durationms:0;
      skipped:true;
      skipreason:"dry_run=true"
    };
    stages=stages.push(anonstage)
  }el{
    anonymisedtext=anonymisetext(text;deduped);
    sensitivity=maxsensitivity(deduped);
    let anonstage=$stageresult{
      stage:$pipelinestage{$anonymise:0};
      entitiesfound:dedupcount;
      durationms:0;
      skipped:false;
      skipreason:""
    };
    stages=stages.push(anonstage)
  };

  
  let finalsystemprompt=guardian.buildsystemprompt(basesystemprompt);
  let guardianstage=$stageresult{
    stage:$pipelinestage{$guardianinject:0};
    entitiesfound:0;
    durationms:0;
    skipped:false;
    skipreason:""
  };
  stages=stages.push(guardianstage);

  log.info("pipeline complete";"pipeline";requestid);

  let piiresult=$piidetectionresult{
    original:text;
    anonymised:anonymisedtext;
    entities:deduped;
    sensitivity:sensitivity
  };

  <$pipelinerun{
    result:piiresult;
    stages:stages;
    totalentities:dedupcount;
    finalsystemprompt:finalsystemprompt;
    requestid:requestid;
    layerscompleted:completed as u32;
    layersdegraded:degraded as u32
  }
};



(* NC1.9 — the fail-closed gate.

   `run` always returns a $pipelinerun, marking unavailable layers as skipped. That is
   the right shape for a diagnostic view and the wrong shape for a gate: a caller
   reading totalentities:0 cannot tell "no PII in this text" from "nothing examined
   this text", and the second is a leak waiting to happen.

   WHY THIS IS NOT A RESULT TYPE. The obvious design is
   `runchecked(...):$pipelinerun!$lokeerr`, returning $err when nothing scanned. It is
   not used, because toke does not discriminate a result whose error side is a
   user-declared sum: `mt` on an `X!$lokeerr` value takes the FIRST ARM whatever the
   value is. With $ok written first — as it conventionally is — an $err is matched as
   $ok and its payload read as garbage. So a refusal expressed that way would be
   silently ignored by every caller, which is the exact failure NC1.9 exists to
   prevent. Verified against toke 445f519 and filed as T-18 in
   docs/upstream/toke-issues.md; stdlib results (file.read, db.exec, http.get) are
   unaffected and do discriminate.

   The gate is therefore a plain bool, which toke gets right, and the caller cannot
   confuse it with a payload:

     layerscompleted == 0   ->  issafetoforward is false. Nothing looked. Refuse.
     layerscompleted >= 1   ->  true, with layersdegraded saying what was missing.

   A degraded run is allowed on purpose: a Presidio sidecar being down must not take a
   local-first product offline. *)
f=issafetoforward(r:$pipelinerun):bool{
  <r.layerscompleted>0 as u32
};

(* Runs the pipeline and says in one place whether the result may leave the machine.
   Callers check the bool; there is no error arm to forget. *)
f=runforward(text:str;basesystemprompt:str;config:$pipelineconfig):$pipelinerun{
  let r=run(text;basesystemprompt;config);
  if(issafetoforward(r)){
    if(r.layersdegraded>0 as u32){
      log.warn("privacy pipeline degraded: \(r.layersdegraded) enabled layer(s) unavailable, \(r.layerscompleted) completed";"pipeline";r.requestid)
    }el{}
  }el{
    log.error("privacy pipeline failed closed: no detection layer completed a scan, so this text must not be forwarded";"pipeline";r.requestid)
  };
  <r
};

f=rundry(text:str;config:$pipelineconfig):$pipelinerun{
  let dryconfig=$pipelineconfig{
    presidiourl:config.presidiourl;
    ollamaurl:config.ollamaurl;
    nermodelid:config.nermodelid;
    usepresidio:config.usepresidio;
    usener:config.usener;
    dryrun:true;
    usepf:config.usepf;
    pfurl:config.pfurl;
    pfthreshold:config.pfthreshold
  };
  <run(text;"";dryconfig)
};

f=applypreset(config:i64;preset:str):i64{
  <config
};

f=setentityenabled(config:i64;entitytype:str;enabled:bool):i64{
  <config
};

f=setlayerenabled(config:i64;layerid:str;enabled:bool):i64{
  <config
};

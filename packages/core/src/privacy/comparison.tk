m=core.privacy.comparison;

i=str:std.str;
i=json:std.json;
i=sh:shared.types;
i=fr:core.privacy.filterregistry;
i=lh:core.privacy.layerhealth;
i=lyc:core.privacy.layerconfig;
i=cn:core.privacy.consensus;
i=ev:core.privacy.evaluation;
i=pl:core.privacy.pipeline;
i=er:core.privacy.entityrouting;
i=op:core.privacy.orgpolicy;
i=jx:shared.jsonobj;

(* F3b.9. `loke privacy evaluate`: every configured detection layer side by side, on one text
   or on a labelled file.

   THE SAME CALLS AS THE PIPELINE. `compare` walks the registry of a $pipelineconfig in order
   and makes, per layer, exactly the calls core.privacy.pipeline.run makes: layerhealth.consult
   (probe, then scan only a layer that answered), layerconfig.accepted (the layer's threshold
   and entity filter), layerconfig.masks and layerconfig.vetoes, and then consensus.apply over
   the masking layers' accepted detections with the configured strategy. Between the two, as
   in run, entityrouting.apply drops a routed type's detections from layers its route does
   not accept (F3b.5), and a routing error refuses as run's does. What differs is what is
   kept: run merges every layer into one list, and this keeps each layer's own list, its
   state and its reason, so a person can see which layer found what, and which of its
   detections routing did not accept. pipeline.tk is not changed; if run ever consults
   layers differently, this module must follow it. tests/unit/privacy/
   test_privacy_comparison.tk compares the two decision by decision on several configs, so
   a drift fails there rather than going unnoticed.

   UNAVAILABLE IS NOT EMPTY. A layer that did not complete a scan (disabled, unavailable,
   failed) reports its state and reason and no detection count at all. A count of zero is
   printed only for a layer that scanned the text and found nothing, and a labelled file is
   never scored for a layer on a text it did not scan.

   NO VALUE IS PRINTED unless the caller asks. A detection is shown as its type in brackets,
   its byte span and its confidence. The value appears only when showvalues is true (the
   CLI's --show-values), and the labelled report never prints a value or a text at all.

   SCORING is core.privacy.evaluation's, not a second scorer: each layer's accepted
   detections become spans (entityspans, or valuespans for a layer that reports only
   values, as NER does) and are scored per text with corpuslabels and scoretext, the entity-
   level rule tests/integration/test_detection_recall.tk uses. tp is the labelled entities a
   layer's detections overlap, fn those they miss, fp its detection regions that overlap no
   real PII. A labelled file is one of two formats, told apart by its content (isjsonarray):
   the corpus JSONL of tests/fixtures/pii-corpus, one object per line with "text" and
   "entities":[{"type","value","start","end","expected_detected"}], where only entities with
   expected_detected true count towards recall; or a JSON array
   [{"text","entities":[{"start","end","type"}]}], where every entity counts, its offsets in
   characters, and anything malformed refuses the whole file (arraycases). *)

(* One layer's part in one text. hits are the detections its settings accept (what the
   pipeline would hand to consensus), rawcount what it reported before they were applied. *)
t=$layerview{
  id:str;
  mode:str;
  state:str;
  reason:str;
  completed:bool;
  masks:bool;
  vetoed:bool;
  hits:@$piientity;
  rawcount:i64;
  unplaced:i64
};

(* Every layer's view, and the consensus decision over the masking layers' detections.
   resolved[i] is the decision on the detection reported by layer resolvedlayer[i]. *)
t=$comparison{
  layers:@$layerview;
  resolved:@$resolvedentity;
  resolvedlayer:@str;
  voters:@str;
  strategy:str;
  layererror:str;
  (* F3b.5. The routing applied; accepts[k] is the layers route k accepts this run ("" for
     every layer), as entityrouting.accepting gives it, and routedesc[k] says so in words. *)
  routing:$routingconfig;
  accepts:@str;
  routedesc:@str;
  (* F3b.8 (5). The organisation policy's refusal of this text, as pipeline.run would make it
     ("" when none), and each setting it overrode. *)
  policyerror:str;
  policynotes:@str
};

(* A layer's running score over a labelled file. texts counts the texts it scanned; a text it
   did not scan is not scored for it, and reason says why the last one was not. *)
t=$layertally{
  id:str;
  score:$entityscore;
  texts:i64;
  reason:str
};

(* A detection routing did not accept, and the layer that made it. *)
t=$routingdrop{
  layerid:str;
  entity:$piientity
};

(* One labelled text, its labels already in byte offsets. scored is what recall is computed
   over; realpii is every labelled entity that is genuinely PII, which a detection must
   overlap not to be a false positive (see core.privacy.evaluation.scoretext). *)
t=$labelledcase{
  text:str;
  scored:@$labelspan;
  realpii:@$labelspan
};

(* A labelled file as read: its format ("jsonl" or "json-array"), its texts, and, when it
   cannot be used, why. A non-empty error means nothing is scored. *)
t=$labelledinput{
  format:str;
  cases:@$labelledcase;
  error:str
};

(* Every layer's tally over a labelled file, and the consensus tally last. *)
t=$labelledscores{
  format:str;
  error:str;
  layererror:str;
  ntexts:i64;
  labelled:i64;
  tallies:@$layertally
};

(* One entry's entities as byte spans, or the reason it cannot be scored. *)
t=$entryspans{
  spans:@$labelspan;
  error:str
};

(* error is set, and text is that error, when the file could not be used at all. *)
t=$labelledresult{
  text:str;
  ok:bool;
  error:str
};

f=view(layer:$privacyfilter;lr:$layerresult):$layerview{
  let st:$layerstatus=lr.status;
  if(lh.iscompleted(st)){
    let hits=lyc.accepted(layer;lr.hits);
    <$layerview{id:layer.id;mode:layer.mode;state:st.state;reason:st.reason;completed:true;masks:lyc.masks(layer);vetoed:lyc.vetoes(layer;hits);hits:hits;rawcount:lr.hits.len as i64;unplaced:lr.unplaced}
  }el{};
  <$layerview{id:layer.id;mode:layer.mode;state:st.state;reason:st.reason;completed:false;masks:lyc.masks(layer);vetoed:false;hits:@($piientity);rawcount:0;unplaced:0}
};

f=compare(text:str;config:$pipelineconfig):$comparison{
  let views=mut.@($layerview);
  let allentities=mut.@($piientity);
  let hitlayers=mut.@();
  let voters=mut.@();
  let states=mut.@();
  (* F3b.8 (5). The organisation policy over the configuration, as in pipeline.run: a banned
     layer is off and sent nothing, a weaker strategy is raised, a threshold lowered, and each
     layer is consulted under it (orgpolicy.consult). No alert is raised: nothing is sent. *)
  let applied:$orgapplied=op.apply(op.resolved(config.org);config.layers;config.consensus;config.consensusthreshold);
  let policy=applied.policy;
  let notes=mut.policy.notes;
  let reg=applied.registry;
  lp(let li=0;li<reg.filters.len;li=li+1){
    let layer:$privacyfilter=reg.filters.get(li);
    let oc:$orgconsult=op.consult(policy;reg;layer;text);
    if(str.len(oc.note)>0){ notes=notes.push(oc.note) }el{};
    states=states.push(oc.result.status);
    let v=view(layer;oc.result);
    views=views.push(v);
    if(v.completed && v.masks){
      voters=voters.push(v.id);
      lp(let hi=0;hi<v.hits.len;hi=hi+1){
        allentities=allentities.push(v.hits.get(hi));
        hitlayers=hitlayers.push(v.id)
      }
    }el{}
  };
  let accepts=mut.@();
  let routedesc=mut.@();
  lp(let ri=0;ri<config.routing.routes.len;ri=ri+1){
    let r:$entityroute=config.routing.routes.get(ri);
    accepts=accepts.push(er.accepting(reg;voters;r));
    routedesc=routedesc.push(routedescription(reg;voters;r))
  };
  (* F3b.5, as in pipeline.run: routing after the layers, before consensus. *)
  let routed:$routedhits=er.apply(config.routing;reg;voters;allentities;hitlayers);
  let cfgerror=mut.config.layererror;
  if(str.len(cfgerror)==0 && str.len(config.routing.error)>0){ cfgerror=er.refusal(config.routing) }el{};
  let agreed:$consensusresult=cn.apply(routed.entities;routed.layers;voters;applied.consensus;applied.consensusthreshold);
  <$comparison{layers:views;resolved:agreed.resolved;resolvedlayer:routed.layers;voters:voters;strategy:agreed.strategy;layererror:cfgerror;routing:config.routing;accepts:accepts;routedesc:routedesc;policyerror:op.refusal(policy;reg;states;voters);policynotes:notes}
};

(* Which layers route r accepts this run, in words: the three cases of
   entityrouting.accepting and entityrouting.note. Names types and layers, never a value. *)
f=routedescription(reg:$filterregistry;voters:@str;r:$entityroute):str{
  let pref=er.available(reg;voters;r.preferred;r.entitytype);
  if(str.len(pref)>0){ <"accepted from preferred layer(s) \(pref)" }el{};
  let fb=er.available(reg;voters;r.fallback;r.entitytype);
  if(str.len(fb)>0){ <"no preferred layer (\(r.preferred)) is available; accepted from fallback layer(s) \(fb)" }el{};
  <"neither a preferred (\(r.preferred)) nor a fallback (\(r.fallback)) layer is available; accepted from every layer that ran"
};

(* "; routing PERSON: accepted from ..." for a routed type, "" for an unrouted one. *)
f=routingtext(c:$comparison;entitytype:str):str{
  let k=er.routeindex(c.routing;entitytype);
  if(k<0){ <"" }el{};
  <"; routing \(entitytype): \(c.routedesc.get(k))"
};

(* The routing section: each route and what it accepts, and every detection a masking layer
   made that routing did not accept, by type and span. *)
f=routinglines(lines:@str;text:str;c:$comparison;showvalues:bool):@str{
  let out=mut.lines;
  if(c.routing.routes.len==0){ <out }el{};
  out=out.push("");
  out=out.push("entity routing ([[privacy.entity_routing]]), applied before consensus:");
  lp(let k=0;k<c.routing.routes.len;k=k+1){
    out=addline(out;"  \(c.routing.routes.get(k).entitytype): \(c.routedesc.get(k))")
  };
  let drops=notaccepted(c);
  lp(let i=0;i<drops.len;i=i+1){
    let d:$routingdrop=drops.get(i);
    out=out.push("    not accepted by routing: \(shown(d.entity.entitytype;d.entity.value;showvalues)) \(spanstext(spansof(text;d.entity))) from \(d.layerid)")
  };
  <out
};

(* Every detection a masking layer made that entity routing did not accept, in registry
   order: what routinglines prints and page.api.evaluate answers as "not_accepted". Empty
   when no route is configured. *)
f=notaccepted(c:$comparison):@$routingdrop{
  let out=mut.@($routingdrop);
  if(c.routing.routes.len==0){ <out }el{};
  lp(let i=0;i<c.layers.len;i=i+1){
    let v:$layerview=c.layers.get(i);
    if(v.completed && v.masks){
      lp(let h=0;h<v.hits.len;h=h+1){
        let e:$piientity=v.hits.get(h);
        if(!er.keeps(c.routing;c.accepts;v.id;e.entitytype)){
          out=out.push($routingdrop{layerid:v.id;entity:e})
        }el{}
      }
    }el{}
  };
  <out
};

(* The refusal a config error causes, worded as pipeline.refusalreason words it. *)
f=errortext(c:$comparison):str{
  if(str.startswith(c.layererror;er.header())){ <"\(c.layererror), so the pipeline refuses every request" }el{};
  <"\(lyc.refusal(c.layererror)), so the pipeline refuses every request"
};

f=completedcount(c:$comparison):i64{
  let n=mut.0;
  lp(let i=0;i<c.layers.len;i=i+1){
    if(c.layers.get(i).completed){ n=n+1 }el{}
  };
  <n
};

(* ── Spans ─────────────────────────────────────────────────────────────────── *)

(* What one detection masks, as spans: its own span when it has one, otherwise every
   occurrence of its value, which is what placeholder.applytotext replaces. *)
f=spansof(text:str;e:$piientity):@$labelspan{
  if(e.end>e.start){ <ev.entityspans(@(e)) }el{};
  <ev.valuespans(text;@(e))
};

f=allspans(text:str;ents:@$piientity):@$labelspan{
  let out=mut.@($labelspan);
  lp(let i=0;i<ents.len;i=i+1){
    out=ev.joinspans(out;spansof(text;ents.get(i)))
  };
  <out
};

(* ev.numtext, not str.fromint, inside an interpolation: see the note on numtext there. *)
f=spantext(s:$labelspan):str{
  <"\(ev.numtext(s.start))-\(ev.numtext(s.end))"
};

f=spanstext(spans:@$labelspan):str{
  if(spans.len==0){ <"(not located in the text)" }el{};
  let joined=mut.spantext(spans.get(0));
  lp(let i=1;i<spans.len;i=i+1){
    joined="\(joined),\(spantext(spans.get(i)))"
  };
  <joined
};

(* ── Rendering ─────────────────────────────────────────────────────────────── *)

(* The type in brackets, and the value after it only when asked for. *)
f=shown(entitytype:str;value:str;showvalues:bool):str{
  if(showvalues){ <"[\(entitytype)] \(json.enc(value))" }el{};
  <"[\(entitytype)]"
};

f=conftext(c:f64):str{
  <sh.f64fixed(c;2)
};

f=hitline(text:str;e:$piientity;showvalues:bool):str{
  <"    \(shown(e.entitytype;e.value;showvalues)) \(spanstext(spansof(text;e))) confidence \(conftext(e.confidence))"
};

f=plural(n:i64;one:str;many:str):str{
  let k:str=str.fromint(n);
  if(n==1){ <"\(k) \(one)" }el{};
  <"\(k) \(many)"
};

(* Named so they can be called inside an interpolation, where a string literal does not lex. *)
f=ndetections(n:i64):str{ <plural(n;"detection";"detections") };
f=nspans(n:i64):str{ <plural(n;"span";"spans") };
f=nlayers(n:i64):str{ <plural(n;"layer";"layers") };
f=commas(items:@str):str{ <str.join(",";items) };

f=addline(lines:@str;line:str):@str{
  <lines.push(line)
};

(* The lines for one layer, appended to lines. *)
f=layerlines(lines:@str;text:str;v:$layerview;showvalues:bool):@str{
  let out=mut.lines;
  if(!v.completed){
    if(str.eq(v.state;"disabled")){
      out=out.push("  \(v.id): disabled -- not consulted, not scored");
      <out
    }el{};
    out=out.push("  \(v.id): \(v.state) -- \(v.reason). The layer did not scan this text; that is not the same as finding nothing.");
    <out
  }el{};
  out=out.push("  \(v.id) (\(v.mode)): completed, \(ndetections(v.hits.len as i64))");
  let dropped=v.rawcount-(v.hits.len as i64);
  if(dropped>0){
    out=out.push("    (\(ndetections(dropped)) below the layer's threshold or outside its entity filter, not counted)")
  }el{};
  lp(let i=0;i<v.hits.len;i=i+1){
    out=addline(out;hitline(text;v.hits.get(i);showvalues))
  };
  if(!v.masks){ out=out.push("    detect-only: these are reported, not masked, and the layer does not vote") }el{};
  if(v.vetoed){ out=out.push("    veto: this layer found PII above its threshold, so the pipeline would refuse this text") }el{};
  if(v.unplaced>0){
    out=out.push("    \(nspans(v.unplaced)) could not be placed in the text exactly, so the pipeline would refuse this text")
  }el{};
  <out
};

(* The layer names in a $resolvedentity's detectinglayers ("ner=0.85,presidio=0.85"). *)
f=foundby(r:$resolvedentity):@str{
  let out=mut.@();
  if(str.len(r.detectinglayers)==0){ <out }el{};
  let parts=str.split(r.detectinglayers;",");
  lp(let i=0;i<parts.len;i=i+1){
    let p:str=parts.get(i);
    let eq=str.indexof(p;"=");
    if(eq>0){ out=out.push(str.slice(p;0;eq)) }el{ out=out.push(p) }
  };
  <out
};

f=missedby(r:$resolvedentity;voters:@str):@str{
  let by=foundby(r);
  let out=mut.@();
  lp(let i=0;i<voters.len;i=i+1){
    let v:str=voters.get(i);
    if(cn.indexof(by;v)==by.len){ out=out.push(v) }el{}
  };
  <out
};

f=resolvedline(text:str;r:$resolvedentity;from:str;voters:@str;showvalues:bool;route:str):str{
  let e=$piientity{entitytype:r.entitytype;value:r.value;start:r.start as u32;end:r.end as u32;confidence:r.finalconfidence;placeholder:""};
  let label=shown(r.entitytype;r.value;showvalues);
  let where=spanstext(spansof(text;e));
  let missed=missedby(r;voters);
  let agree=mut."agreed by every voter";
  if(missed.len>0){
    agree="DISAGREEMENT, not found by \(commas(missed))"
  }el{};
  <"    \(label) \(where) reported by \(from); found by \(r.detectinglayers); \(agree)\(route) -> \(r.action)"
};

(* The whole single-text report, one line per element. *)
f=reportlines(text:str;c:$comparison;showvalues:bool):@str{
  let out=mut.@();
  out=out.push("loke privacy evaluate: \(nlayers(c.layers.len as i64)) configured, text of \(ev.numtext(str.len(text) as i64)) bytes");
  if(showvalues){
    out=out.push("values ARE shown (--show-values)")
  }el{
    out=out.push("values are hidden: each detection shows its type, byte span and confidence (--show-values prints them)")
  };
  if(str.len(c.layererror)>0){
    out=out.push(errortext(c))
  }el{};
  if(str.len(c.policyerror)>0){
    out=out.push("\(c.policyerror), so the pipeline refuses this text")
  }el{};
  if(c.policynotes.len>0){
    out=out.push("\(op.header()) overrides this configuration: \(str.join(lh.listsep();c.policynotes))")
  }el{};
  out=out.push("");
  out=out.push("layers, in registry order:");
  lp(let i=0;i<c.layers.len;i=i+1){
    out=layerlines(out;text;c.layers.get(i);showvalues)
  };
  out=routinglines(out;text;c;showvalues);
  out=out.push("");
  let voters=mut.str.join(",";c.voters);
  if(c.voters.len==0){ voters="none" }el{};
  let strategyname=cn.strategyname(c.strategy);
  out=out.push("consensus: \(c.strategy), \(strategyname); voters: \(voters)");
  if(c.voters.len==0){
    out=out.push("    no masking layer completed a scan, so the pipeline would refuse this text")
  }el{};
  let masked=mut.0;
  let disagree=mut.0;
  let overlaps=mut.0;
  lp(let i=0;i<c.resolved.len;i=i+1){
    let r:$resolvedentity=c.resolved.get(i);
    out=out.push(resolvedline(text;r;c.resolvedlayer.get(i);c.voters;showvalues;routingtext(c;r.entitytype)));
    if(str.eq(r.action;"mask")){ masked=masked+1 }el{};
    if(missedby(r;c.voters).len>0){ disagree=disagree+1 }el{};
    if(foundby(r).len>1){ overlaps=overlaps+1 }el{}
  };
  let total=c.resolved.len as i64;
  out=out.push("summary: \(ndetections(total)),\(ev.numtext(overlaps)) found by more than one layer, \(ev.numtext(disagree)) not found by every voter; \(ev.numtext(masked)) would be masked, \(ev.numtext(total-masked)) passed");
  <out
};

f=report(text:str;config:$pipelineconfig;showvalues:bool):str{
  <str.join("\n";reportlines(text;compare(text;config);showvalues))
};

(* ── A labelled file ───────────────────────────────────────────────────────── *)

(* Tally i so far, or a fresh one for id on the first text. Every text walks the same
   registry, so position i is the same layer each time. *)
f=prior(acc:@$layertally;i:i64;id:str):$layertally{
  if(i<(acc.len as i64)){ <acc.get(i) }el{};
  <$layertally{id:id;score:ev.emptyscore();texts:0;reason:""}
};

(* The detections the configured strategy would mask, as entities. *)
f=maskedentities(c:$comparison):@$piientity{
  let out=mut.@($piientity);
  lp(let i=0;i<c.resolved.len;i=i+1){
    let r:$resolvedentity=c.resolved.get(i);
    if(str.eq(r.action;"mask")){
      out=out.push($piientity{entitytype:r.entitytype;value:r.value;start:r.start as u32;end:r.end as u32;confidence:r.finalconfidence;placeholder:""})
    }el{}
  };
  <out
};

f=tallytext(acc:$layertally;text:str;scored:@$labelspan;realpii:@$labelspan;ok:bool;dets:@$piientity;reason:str):$layertally{
  if(!ok){ <$layertally{id:acc.id;score:acc.score;texts:acc.texts;reason:reason} }el{};
  <$layertally{id:acc.id;score:ev.scoretext(scored;realpii;allspans(text;dets);acc.score);texts:acc.texts+1;reason:acc.reason}
};

f=scorecase(lc:$labelledcase;c:$comparison;acc:@$layertally):@$layertally{
  let out=mut.@($layertally);
  lp(let i=0;i<c.layers.len;i=i+1){
    let v:$layerview=c.layers.get(i);
    out=out.push(tallytext(prior(acc;i;v.id);lc.text;lc.scored;lc.realpii;v.completed;v.hits;"\(v.state): \(v.reason)"))
  };
  out=out.push(tallytext(prior(acc;c.layers.len as i64;"consensus");lc.text;lc.scored;lc.realpii;c.voters.len>0;maskedentities(c);"no masking layer completed"));
  <out
};

f=f1text(s:$entityscore):str{
  <ev.bplabel(ev.f1bp(ev.entityprecisionbp(s);ev.entityrecallbp(s)))
};

f=tallyline(tl:$layertally;ntexts:i64):str{
  if(tl.texts==0){
    <"layer=\(tl.id) not scored: it scanned none of the texts (\(tl.reason)). That is not a recall of zero."
  }el{};
  let s=tl.score;
  let line=mut."\(ev.scoreline(tl.id;s)) f1=\(f1text(s)) tp=\(ev.numtext(s.matched)) fp=\(ev.numtext(s.spurious)) fn=\(ev.numtext(s.labelled-s.matched)) texts=\(ev.numtext(tl.texts))/\(ev.numtext(ntexts))";
  if(tl.texts<ntexts){ line="\(line) (not scored on the texts it did not scan: \(tl.reason))" }el{};
  <line
};

(* ── Reading a labelled file ───────────────────────────────────────────────── *)

(* The corpus JSONL of tests/fixtures/pii-corpus: one object per line, "text" and
   "entities":[{"type","value","start","end","expected_detected"}]. Only entities with
   expected_detected true count towards recall (core.privacy.evaluation.corpuslabels). A line
   that is not such an object is skipped, as it always was. *)
f=jsonlcases(raw:str):@$labelledcase{
  let lines=str.split(raw;"\n");
  let out=mut.@($labelledcase);
  lp(let i=0;i<lines.len;i=i+1){
    let line:str=lines.get(i);
    if(str.len(line)>2){
      let obj=json.dec(line);
      let text=mt json.str(obj;"text") { $ok:s s; $err:e "" };
      if(str.len(text)>0){
        let ents=mt json.arr(obj;"entities") { $ok:a a; $err:e @() };
        out=out.push($labelledcase{text:text;scored:ev.corpuslabels(text;ents;true);realpii:ev.corpuslabels(text;ents;false)})
      }el{}
    }el{}
  };
  <out
};

f=arrayshape():str{
  <"the format is a JSON array [{\"text\": \"...\", \"entities\": [{\"start\": 0, \"end\": 4, \"type\": \"PERSON\"}]}]"
};

f=decodes(raw:str):bool{
  <mt json.dec(raw) { $ok:o true; $jsonerr:e false }
};

f=hasarray(o:$jsonval;key:str):bool{
  <mt json.arr(o;key) { $ok:a true; $err:e false }
};

f=arrayat(o:$jsonval;key:str):@$jsonval{
  <mt json.arr(o;key) { $ok:a a; $err:e @() }
};

f=arrayerror(msg:str):$labelledinput{
  <$labelledinput{format:"json-array";cases:@($labelledcase);error:msg}
};

(* The entities of entry n. Each needs a non-empty "type" and whole-number "start" and "end"
   with 0 <= start < end <= the text's length. The offsets count CHARACTERS (code points), as
   the corpus's do and as a labelling tool working on decoded text writes them; they are
   converted to the byte offsets loke's detectors report with evaluation.bytestart. Every
   entity counts towards recall and is real PII, except one typed NOT_PII, which is a decoy
   (it is never returned, as in corpuslabels). *)
f=arrayentities(text:str;ents:@$jsonval;n:str):$entryspans{
  let out=mut.@($labelspan);
  let nchars=ev.charcount(text);
  lp(let k=0;k<ents.len;k=k+1){
    let en=ents.get(k);
    let kind=mt json.str(en;"type") { $ok:s s; $err:x "" };
    let st=mt json.i64(en;"start") { $ok:v v; $err:x 0-1 };
    let fin=mt json.i64(en;"end") { $ok:v v; $err:x 0-1 };
    let where="entry \(n), entity \(ev.numtext((k as i64)+1))";
    if(str.len(kind)==0){
      <$entryspans{spans:@($labelspan);error:"\(where) has no non-empty \"type\" string"}
    }el{};
    if(st<0 || fin<=st || fin>nchars){
      <$entryspans{spans:@($labelspan);error:"\(where) needs whole-number \"start\" and \"end\" with 0 <= start < end <= \(ev.numtext(nchars)), the text's length in characters"}
    }el{};
    if(!str.eq(kind;"NOT_PII")){
      out=out.push($labelspan{kind:kind;start:ev.bytestart(text;st);end:ev.bytestart(text;fin)})
    }el{}
  };
  <$entryspans{spans:out;error:""}
};

(* The JSON-array format the story names: [{"text","entities":[{"start","end","type"}]}].
   Unlike the JSONL reader, nothing malformed is skipped: a file that says it is this format
   and is not is refused whole, with the entry and entity at fault, so a score is never
   reported over part of a file the person thinks was read. The error names positions and
   fields, never a text or a value. *)
f=arraycases(raw:str):$labelledinput{
  let wrapped="{\"v\":\(raw)}";
  if(!decodes(wrapped)){ <arrayerror("the file starts with [ but is not valid JSON; \(arrayshape())") }el{};
  let o=mt json.dec(wrapped) { $ok:o o; $jsonerr:e jx.emptyobj() };
  if(!hasarray(o;"v")){ <arrayerror("the file starts with [ but is not a JSON array; \(arrayshape())") }el{};
  let items=arrayat(o;"v");
  if(items.len==0){ <arrayerror("the array holds no entries, so there is nothing to evaluate") }el{};
  let out=mut.@($labelledcase);
  lp(let i=0;i<items.len;i=i+1){
    let e=items.get(i);
    let n=ev.numtext((i as i64)+1);
    let text=mt json.str(e;"text") { $ok:s s; $err:x "" };
    if(str.len(text)==0){ <arrayerror("entry \(n) has no non-empty \"text\" string; \(arrayshape())") }el{};
    if(!hasarray(e;"entities")){ <arrayerror("entry \(n) has no \"entities\" array (a text with no PII has \"entities\": [])") }el{};
    let spans=arrayentities(text;arrayat(e;"entities");n);
    if(str.len(spans.error)>0){ <arrayerror(spans.error) }el{};
    out=out.push($labelledcase{text:text;scored:spans.spans;realpii:spans.spans})
  };
  <$labelledinput{format:"json-array";cases:out;error:""}
};

(* The format is told by the content, not the file name: a file whose first non-blank
   character is [ is the JSON array, anything else is read as the corpus JSONL. *)
f=isjsonarray(raw:str):bool{
  <str.startswith(str.trim(raw);"[")
};

f=readlabelled(raw:str):$labelledinput{
  if(isjsonarray(raw)){ <arraycases(raw) }el{};
  let cases=jsonlcases(raw);
  if(cases.len==0){
    <$labelledinput{format:"jsonl";cases:cases;error:"no text could be read from the file: nothing was evaluated (a labelled file is the corpus JSONL, one {\"text\", \"entities\"} object per line, or a JSON array of them)"}
  }el{};
  <$labelledinput{format:"jsonl";cases:cases;error:""}
};

(* Every layer, and the consensus, scored over a labelled file in either format. *)
f=scorelabelled(raw:str;config:$pipelineconfig):$labelledscores{
  let input=readlabelled(raw);
  if(str.len(input.error)>0){
    <$labelledscores{format:input.format;error:input.error;layererror:"";ntexts:0;labelled:0;tallies:@($layertally)}
  }el{};
  let tallies=mut.@($layertally);
  let labelled=mut.0;
  let layererror=mut."";
  lp(let i=0;i<input.cases.len;i=i+1){
    let lc:$labelledcase=input.cases.get(i);
    let c=compare(lc.text;config);
    if(str.len(c.layererror)>0){ layererror=errortext(c) }el{};
    if(str.len(layererror)==0 && str.len(c.policyerror)>0){ layererror="\(c.policyerror), so the pipeline refuses this text" }el{};
    tallies=scorecase(lc;c;tallies);
    labelled=labelled+(lc.scored.len as i64)
  };
  <$labelledscores{format:input.format;error:"";layererror:layererror;ntexts:input.cases.len as i64;labelled:labelled;tallies:tallies}
};

f=scannedany(s:$labelledscores):bool{
  let any=mut.false;
  lp(let i=0;i<s.tallies.len;i=i+1){
    if(s.tallies.get(i).texts>0){ any=true }el{}
  };
  <any
};

(* A clean evaluation: the file was read, some layer scanned some text, the config applies. *)
f=labelledok(s:$labelledscores):bool{
  <str.len(s.error)==0 && scannedany(s) && str.len(s.layererror)==0
};

(* Which entities a format scores, in words. *)
f=scoredwhat(format:str):str{
  if(str.eq(format;"json-array")){ <"JSON array; every entity but NOT_PII is scored" }el{};
  <"corpus JSONL; entities with expected_detected true are scored"
};

(* The per-layer TP/FP/FN report on a labelled file. Prints no text and no value. *)
f=labelledreport(raw:str;config:$pipelineconfig):$labelledresult{
  let s=scorelabelled(raw;config);
  if(str.len(s.error)>0){
    let msg="loke privacy evaluate --file: \(s.error)";
    <$labelledresult{text:msg;ok:false;error:msg}
  }el{};
  let out=mut.@();
  out=out.push("loke privacy evaluate --file: \(ev.numtext(s.ntexts)) labelled texts, \(ev.numtext(s.labelled)) labelled entities scored (\(scoredwhat(s.format)))");
  if(str.len(s.layererror)>0){
    out=out.push(s.layererror)
  }el{};
  out=out.push("tp = labelled entities a layer's detections overlap; fn = labelled entities they miss; fp = detection regions overlapping no real PII. Values are never printed.");
  let text=mut.str.join("\n";out);
  lp(let i=0;i<s.tallies.len;i=i+1){
    text="\(text)\n\(tallyline(s.tallies.get(i);s.ntexts))"
  };
  <$labelledresult{text:text;ok:labelledok(s);error:""}
};

(* What the CLI exits with: 0 when at least one layer scanned the text and the layer config
   applies, 1 otherwise. A report is printed either way. *)
f=evaluated(c:$comparison):bool{
  <completedcount(c)>0 && str.len(c.layererror)==0 && str.len(c.policyerror)==0
};

m=core.privacy.placeholder;



i=str:std.str;

t=$placeholderentry{
  original:str;
  placeholder:str;
  entitytype:str
};

t=$placeholdermap{
  entries:@$placeholderentry
};


f=newmap():$placeholdermap{
  let entries=@();
  <$placeholdermap{entries:entries}
};



f=makeplaceholder(entitytype:str;index:u32):str{
  let upper=str.toupper(entitytype);
  let idxstr=str.fromu32(index);
  let inner=str.concat(upper;"_");
  let inner2=str.concat(inner;idxstr);
  let withopen=str.concat("[";inner2);
  let result=str.concat(withopen;"]");
  <result
};


(* Returns the updated map. The old body was
   `map.entries==str.arraypush(map.entries;entry)` — a discarded COMPARISON, wrapped
   around an append to a by-value parameter that could not have propagated anyway, in
   a function returning void. So the placeholder map never stored an entry, and
   everything downstream of it rested on a table that was always empty: restoration
   returned the LLM's text with the placeholders still in it, the privacy review showed
   no mappings, and any PL1 collision measurement would have been taken against
   nothing. LS1.1a named this the most consequential defect in the migration.

   tests/unit/privacy/test_placeholder.tk already called it in the value-returning
   form, which is the shape it should always have had. *)
f=addentry(map:$placeholdermap;original:str;placeholder:str;entitytype:str):$placeholdermap{
  <$placeholdermap{
    entries:map.entries.push($placeholderentry{
      original:original;
      placeholder:placeholder;
      entitytype:entitytype
    })
  }
};


f=restore(text:str;map:$placeholdermap):str{
  let result=mut.text;
  let i=mut.0;
  let len=str.arraylen(map.entries);
  lp(let lv=0;true;lv=lv){
    if(i>=len){
      br
    }el{
      let entry=map.entries.get(i);
      result=str.replace(result;entry.placeholder;entry.original);
      i=i+1;
    }
  };
  <result
};

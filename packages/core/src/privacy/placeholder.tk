m=core.privacy.placeholder;



i=str:std.str;

t=$placeholderentry{
  original:str;
  placeholder:str;
  entitytype:str
};

t=$placeholdermap{
  entries:@$placeholderentry
};


f=newmap():$placeholdermap{
  let entries=@();
  <$placeholdermap{entries:entries};
};



f=makeplaceholder(entitytype:str;index:u32):str{
  let upper=str.toupper(entitytype);
  let idxstr=str.fromu32(index);
  let inner=str.concat(upper;"_");
  let inner2=str.concat(inner;idxstr);
  let withopen=str.concat("[";inner2);
  let result=str.concat(withopen;"]");
  <result
};


f=addentry(map:$placeholdermap;original:str;placeholder:str;entitytype:str):void{
  let entry=$placeholderentry{original:original;placeholder:placeholder;entitytype:entitytype};
  map.entries=str.arraypush(map.entries;entry)
};


f=restore(text:str;map:$placeholdermap):str{
  let result=text;
  let i=0;
  let len=str.arraylen(map.entries);
  lp(true){
    if(i>len){
      break
    }el{
      let entry=str.arrayget(map.entries;i);
      result=str.replace(result;entry.placeholder;entry.original);
      i=i+1;
    };
  };
  <result
};

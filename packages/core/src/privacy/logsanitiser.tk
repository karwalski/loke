m=core.privacy.logsanitiser;

i=str:std.str;
i=regex:core.privacy.regex;

f=sanitise(text:str):str{
  let patterns=regex.getpatterns();
  let result=mut.text;
  let patcount=str.arraylen(patterns);
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>patcount){
      br
    }el{
      let pdef=str.arrayget(patterns;i);
      let matches=str.findall(result;pdef.pattern);
      let matchcount=str.arraylen(matches);
      let mi=mut.0;
      lp(let lv=0;true;lv=lv){
        if(mi>matchcount){
          br
        }el{
          let matchedvalue=str.arrayget(matches;mi);
          result=str.replace(result;matchedvalue;"[REDACTED]");
          mi=mi+1
        }
      };
      i=i+1
    }
  };
  <result
};

f=issensitivekey(key:str):bool{
  let lower=str.tolower(key);
  if(str.contains(lower;"apikey")){
    <true
  }el{
    if(str.contains(lower;"api_key")){
      <true
    }el{
      if(str.contains(lower;"token")){
        <true
      }el{
        if(str.contains(lower;"password")){
          <true
        }el{
          if(str.contains(lower;"secret")){
            <true
          }el{
            if(str.contains(lower;"authorization")){
              <true
            }el{
              if(str.contains(lower;"cookie")){
                <true
              }el{
                <false
              }
            }
          }
        }
      }
    }
  }
};

f=sanitisemap(key:str;value:str):str{
  if(issensitivekey(key)){
    <"[REDACTED]"
  }el{
    <sanitise(value)
  }
};

m=core.privacy.webmeta;
i=str:std.str;



t=$tracker{
  name:str;
  kind:str;
  url:str
};

t=$webprivacy{
  url:str;
  https:bool;
  trackers:@$tracker;
  cookiecount:i32;
  formfields:@str;
  privacygrade:str;
  notes:@str
};


f=knowntracker(srcurl:str):$tracker{
  if(str.contains(srcurl;"google-analytics.com")){
    <$tracker{name:"Google Analytics";kind:"analytics";url:srcurl}
  }el{
    if(str.contains(srcurl;"connect.facebook.net")){
      <$tracker{name:"Meta Pixel";kind:"advertising";url:srcurl}
    }el{
      if(str.contains(srcurl;"static.hotjar.com")){
        <$tracker{name:"Hotjar";kind:"session-recording";url:srcurl}
      }el{
        if(str.contains(srcurl;"cdn.segment.com")){
          <$tracker{name:"Segment";kind:"analytics";url:srcurl}
        }el{
          if(str.contains(srcurl;"bat.bing.com")){
            <$tracker{name:"Bing Ads";kind:"advertising";url:srcurl}
          }el{
            if(str.contains(srcurl;"snap.licdn.com")){
              <$tracker{name:"LinkedIn Insight";kind:"advertising";url:srcurl}
            }el{
              <$tracker{name:"";kind:"";url:""}
            }
          }
        }
      }
    }
  }
};



f=analyseheaders(url:str;headers:@str):$webprivacy{
  let ishttps=str.startswith(url;"https://");
  let cookies=@();
  let trackers=@();
  let notes=@();

  let hcount=headers.len;
  let hi=0;
  lp(let lv=0;true;lv=lv){
    if(hi>hcount){
      br
    }el{
      let h=str.arrayget(headers;hi);
      let lower=str.tolower(h);

      if(str.startswith(lower;"set-cookie:")){
        cookies=@(cookies;h);
        if(str.contains(lower;"_ga")){
          notes=@(notes;str.concat("Tracking cookie detected in header: ";h))
        }el{
          if(str.contains(lower;"_fbp")){
            notes=@(notes;str.concat("Tracking cookie detected in header: ";h))
          }el{
            if(str.contains(lower;"_hjid")){
              notes=@(notes;str.concat("Tracking cookie detected in header: ";h))
            }el{
              if(str.contains(lower;"ajs_")){
                notes=@(notes;str.concat("Tracking cookie detected in header: ";h))
              }el{}
            }
          }
        }
      }el{};

      if(str.startswith(lower;"referrer-policy:")){
        if(str.contains(lower;"unsafe-url")){
          notes=@(notes;"Weak Referrer-Policy — full URL may be sent to third parties")
        }el{}
      }el{};

      if(str.startswith(lower;"x-tracking-id:")){
        notes=@(notes;str.concat("Non-standard tracking header present: ";h))
      }el{};

      hi=hi+1
    }
  };

  if(ishttps=false){
    notes=@(notes;"Page served over HTTP — traffic is unencrypted and can be intercepted")
  }el{};

  <$webprivacy{
    url:url;
    https:ishttps;
    trackers:trackers;
    cookiecount:str.arraylen(cookies);
    formfields:@();
    privacygrade:"";
    notes:notes
  }
};



f=analysehtml(meta:$webprivacy;html:str):$webprivacy{
  let lower=str.tolower(html);
  let trackers=meta.trackers;
  let formfields=meta.formfields;
  let notes=meta.notes;

  if(str.contains(lower;"google-analytics.com")){
    let t=knowntracker("google-analytics.com");
    if(str.len(t.name)>0){trackers=@(trackers;t)}el{}
  }el{};
  if(str.contains(lower;"connect.facebook.net")){
    let t=knowntracker("connect.facebook.net");
    if(str.len(t.name)>0){trackers=@(trackers;t)}el{}
  }el{};
  if(str.contains(lower;"static.hotjar.com")){
    let t=knowntracker("static.hotjar.com");
    if(str.len(t.name)>0){trackers=@(trackers;t)}el{}
  }el{};
  if(str.contains(lower;"cdn.segment.com")){
    let t=knowntracker("cdn.segment.com");
    if(str.len(t.name)>0){trackers=@(trackers;t)}el{}
  }el{};
  if(str.contains(lower;"bat.bing.com")){
    let t=knowntracker("bat.bing.com");
    if(str.len(t.name)>0){trackers=@(trackers;t)}el{}
  }el{};
  if(str.contains(lower;"snap.licdn.com")){
    let t=knowntracker("snap.licdn.com");
    if(str.len(t.name)>0){trackers=@(trackers;t)}el{}
  }el{};

  if(str.contains(lower;"type=\"email\"")){formfields=@(formfields;"type=\"email\"")}el{};
  if(str.contains(lower;"type=\"tel\"")){formfields=@(formfields;"type=\"tel\"")}el{};
  if(str.contains(lower;"name=\"email\"")){formfields=@(formfields;"name=\"email\"")}el{};
  if(str.contains(lower;"name=\"phone\"")){formfields=@(formfields;"name=\"phone\"")}el{};
  if(str.contains(lower;"name=\"address\"")){formfields=@(formfields;"name=\"address\"")}el{};
  if(str.contains(lower;"autocomplete=\"email\"")){formfields=@(formfields;"autocomplete=\"email\"")}el{};
  if(str.contains(lower;"autocomplete=\"tel\"")){formfields=@(formfields;"autocomplete=\"tel\"")}el{};

  if(str.arraylen(formfields) > 0){
    notes=@(notes;"Page contains data-collection form fields")
  }el{};

  let updated=$webprivacy{
    url:meta.url;
    https:meta.https;
    trackers:trackers;
    cookiecount:meta.cookiecount;
    formfields:formfields;
    privacygrade:meta.privacygrade;
    notes:notes
  };
  <$webprivacy{
    url:updated.url;
    https:updated.https;
    trackers:updated.trackers;
    cookiecount:updated.cookiecount;
    formfields:updated.formfields;
    privacygrade:grade(updated);
    notes:updated.notes
  }
};


f=grade(meta:$webprivacy):str{
  if(meta.https=false){<"F"}el{
    let n=str.arraylen(meta.trackers);
    if(n = 0){<"A"}el{
      if(n < 3){<"B"}el{
        if(n < 6){<"C"}el{
          <"D"
        }
      }
    }
  }
};



f=formatreport(meta:$webprivacy):str{
  let line1=str.concat("Privacy grade : ";meta.privacygrade);
  let line2=str.concat("URL           : ";meta.url);
  let httpsstr=mut."no"; if(meta.https){httpsstr="yes"}el{};
  let line3=str.concat("HTTPS         : ";httpsstr);
  let line4=str.concat("Cookies       : ";str.fromint(meta.cookiecount));
  let trackercount=str.arraylen(meta.trackers);
  let line5=mut."Trackers      : none detected"; if(trackercount = 0){}el{
    line5=str.concat("Trackers      : ";str.fromint(trackercount))
  };
  let sep="
";
  let result=str.concat(line1;str.concat(sep;str.concat(line2;str.concat(sep;str.concat(line3;str.concat(sep;str.concat(line4;str.concat(sep;line5))))))));
  <result
};

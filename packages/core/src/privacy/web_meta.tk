m=core.privacy.webmeta;
i=str:std.string;



t=$tracker{
  name:str;
  kind:str;
  url:str;
};

t=$webprivacy{
  url:str;
  https:bool;
  trackers:@$tracker;
  cookiecount:i32;
  formfields:@(str);
  privacygrade:str;
  notes:@(str);
};










f=knowntracker(srcurl:str):($tracker){
  if str.contains(srcurl; "google-analytics.com"){
    <$tracker{ name:"Google Analytics"; kind:"analytics"; url:srcurl };
  };
  if str.contains(srcurl; "connect.facebook.net"){
    <$tracker{ name:"Meta Pixel"; kind:"advertising"; url:srcurl };
  };
  if str.contains(srcurl; "static.hotjar.com"){
    <$tracker{ name:"Hotjar"; kind:"session-recording"; url:srcurl };
  };
  if str.contains(srcurl; "cdn.segment.com"){
    <$tracker{ name:"Segment"; kind:"analytics"; url:srcurl };
  };
  if str.contains(srcurl; "bat.bing.com"){
    <$tracker{ name:"Bing Ads"; kind:"advertising"; url:srcurl };
  };
  if str.contains(srcurl; "snap.licdn.com"){
    <$tracker{ name:"LinkedIn Insight"; kind:"advertising"; url:srcurl };
  };
  <(none)
};





f=analyseheaders(url:str; headers:@(str)):$webprivacy{
  let ishttps=str.startswith(url; "https://");
  let cookies:@(str)=@();
  let trackers:@$tracker=@();
  let notes:@(str)=@();

  for h in headers{
    let lower=str.tolower(h);

    
    if str.startswith(lower; "set-cookie:"){
      cookies=@.push(cookies; h);
      if str.contains(lower; "_ga") or str.contains(lower; "_fbp") or str.contains(lower; "_hjid") or str.contains(lower; "ajs_"){
        notes=@.push(notes; str.concat("Tracking cookie detected in header: "; h));
      };
    };

    
    if str.startswith(lower; "referrer-policy:"){
      if str.contains(lower; "unsafe-url") or str.contains(lower; "no-referrer-policy"){
        notes=@.push(notes; "Weak Referrer-Policy — full URL may be sent to third parties");
      };
    };

    
    if str.startswith(lower; "x-frame-options:"){ };  

    
    if str.startswith(lower; "x-tracking-id:"){
      notes=@.push(notes; str.concat("Non-standard tracking header present: "; h));
    };
  };

  
  let hascsp=@.any(headers; f(h:str):bool{ <str.startswith(str.tolower(h); "content-security-policy:") });
  let hasreferrer=@.any(headers; f(h:str):bool{ <str.startswith(str.tolower(h); "referrer-policy:") });

  if not hascsp{
    notes=@.push(notes; "No Content-Security-Policy header — third-party scripts cannot be restricted");
  };
  if not hasreferrer{
    notes=@.push(notes; "No Referrer-Policy header — referrer data may leak to third parties");
  };
  if not ishttps{
    notes=@.push(notes; "Page served over HTTP — traffic is unencrypted and can be intercepted");
  };

  <$webprivacy{
    url:url;
    https:ishttps;
    trackers:trackers;
    cookiecount:@.len(cookies);
    formfields:@();
    privacygrade:"";   
    notes:notes;
  };
};





f=analysehtml(meta:$webprivacy; html:str):$webprivacy{
  let lower=str.tolower(html);
  let trackers=meta.trackers;
  let formfields=meta.formfields;
  let notes=meta.notes;

  
  let candidates=@(str){
    "google-analytics.com";
    "connect.facebook.net";
    "static.hotjar.com";
    "cdn.segment.com";
    "bat.bing.com";
    "snap.licdn.com";
  };

  for c in candidates{
    if str.contains(lower; c){
      let t=$knowntracker(c);
      if (issome; t){
        
        let already=@.any(trackers; f(existing:$tracker):bool{ <str.eq(existing.url; c) });
        if not already{
          trackers=@.push(trackers; (unwrap; t));
        };
      };
    };
  };

  
  let fieldpatterns=@(str){
    "type=\"email\"";
    "type=\"tel\"";
    "name=\"email\"";
    "name=\"phone\"";
    "name=\"first_name\"";
    "name=\"last_name\"";
    "name=\"fullname\"";
    "name=\"address\"";
    "name=\"postcode\"";
    "name=\"dob\"";
    "name=\"date_of_birth\"";
    "autocomplete=\"email\"";
    "autocomplete=\"tel\"";
    "autocomplete=\"name\"";
  };

  for p in fieldpatterns{
    if str.contains(lower; p){
      let already=@.any(formfields; f(f:str):bool{ <str.eq(f; p) });
      if not already{
        formfields=@.push(formfields; p);
      };
    };
  };

  if @.len(formfields) > 0{
    notes=@.push(notes; str.concat(
      "Page contains data-collection form fields: ";
      str.join(formfields; ", ")
    ));
  };

  
  let updated=$webprivacy{
    url:meta.url;
    https:meta.https;
    trackers:trackers;
    cookiecount:meta.cookiecount;
    formfields:formfields;
    privacygrade:meta.privacygrade;
    notes:notes;
  };
  <$webprivacy{
    url:updated.url;
    https:updated.https;
    trackers:updated.trackers;
    cookiecount:updated.cookiecount;
    formfields:updated.formfields;
    privacygrade:grade(updated);
    notes:updated.notes;
  };
};








f=grade(meta:$webprivacy):str{
  if not meta.https{ <"F" };
  let n=@.len(meta.trackers);
  if n == 0{ <"A" };
  if n <= 2{ <"B" };
  if n <= 5{ <"C" };
  <"D"
};




f=formatreport(meta:$webprivacy):str{
  let lines:@(str)=@();

  lines=@.push(lines; str.concat("Privacy grade : "; meta.privacygrade));
  lines=@.push(lines; str.concat("URL           : "; meta.url));
  lines=@.push(lines; str.concat("HTTPS         : "; if meta.https{ "yes" } else { "no" }));
  lines=@.push(lines; str.concat("Cookies       : "; str.fromi32(meta.cookiecount)));

  if @.len(meta.trackers) == 0{
    lines=@.push(lines; "Trackers      : none detected");
  } else {
    lines=@.push(lines; str.concat("Trackers      : "; str.fromi32(@.len(meta.trackers))));
    for t in meta.trackers{
      lines=@.push(lines; str.concat("  • "; t.name; " ("; t.kind; ") — "; t.url));
    };
  };

  if @.len(meta.formfields) > 0{
    lines=@.push(lines; "Form fields   :");
    for f in meta.formfields{
      lines=@.push(lines; str.concat("  • "; f));
    };
  } else {
    lines=@.push(lines; "Form fields   : none detected");
  };

  if @.len(meta.notes) > 0{
    lines=@.push(lines; "Notes:");
    for n in meta.notes{
      lines=@.push(lines; str.concat("  ! "; n));
    };
  };

  <str.join(lines; "
")
};

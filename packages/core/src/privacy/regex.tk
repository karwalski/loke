m=core.privacy.regex;



i=pat:core.privacy.patterns;
i=ph:core.privacy.placeholder;
i=str:std.str;
i=t:shared.types;


t=$patterndef{
  name:str;
  pattern:str;
  sensitivity:$sensitivitylevel;
  confidence:f64
};

(* Order does not decide sensitivity. Two patterns can report the same value (an NHS number
   printed 3-3-4, "943 476 5919", is also a phone_us match; a Medicare number with its IRN
   can be a checksum-valid ABN), and since RG1.7c pipeline.dedupentities keeps the MOST
   sensitive of equal values whatever their order, and rates the run no lower than every
   detection. uk_nhs_number still comes before the phone patterns (RG1.7a); au_abn coming
   before au_medicare is the case that shows the rule does not depend on it. Asserted in
   tests/unit/privacy/test_uk_sg_identifiers.tk and tests/unit/privacy/test_dedup_sensitivity.tk. *)
f=getpatterns():@$patterndef{
  <@(
    $patterndef{name:"email";pattern:pat.patemail();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.95};
    $patterndef{name:"uk_nhs_number";pattern:pat.patnhsnumber();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.95};
    $patterndef{name:"phone_au";pattern:pat.patphoneau();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.92};
    $patterndef{name:"phone_us";pattern:pat.patphoneus();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.92};
    $patterndef{name:"credit_card";pattern:pat.patcreditcard();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99};
    $patterndef{name:"ip_v4";pattern:pat.patipv4();sensitivity:$sensitivitylevel{$internal:0};confidence:0.80};
    $patterndef{name:"au_tfn";pattern:pat.patautfn();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99};
    $patterndef{name:"au_abn";pattern:pat.patauabn();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.85};
    $patterndef{name:"ssn_us";pattern:pat.patssnus();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99};
    $patterndef{name:"url";pattern:pat.paturl();sensitivity:$sensitivitylevel{$internal:0};confidence:0.60};
    $patterndef{name:"api_key";pattern:pat.patapikey();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99};
    $patterndef{name:"au_medicare";pattern:pat.patmedicare();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.95};
    $patterndef{name:"au_bsb";pattern:pat.patbsb();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"bank_account";pattern:pat.patbankaccount();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"au_crn";pattern:pat.patcrn();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"passport";pattern:pat.patpassport();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"driver_licence";pattern:pat.patdriverlicence();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"au_super_member";pattern:pat.patsupermember();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.85};
    $patterndef{name:"uk_nino";pattern:pat.patnino();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"uk_sort_code";pattern:pat.patsortcode();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"uk_driving_licence";pattern:pat.patukdrivinglicence();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90};
    $patterndef{name:"sg_nric";pattern:pat.patnric();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.90}
  )
};


(* Ranked. This was a duplicate of the chain in privacy/pipeline.tk, with the same
   defect: == on a sum compares the handle, not the variant, so a level that arrived
   from another function never matched any arm and this returned false for every
   pair. shared.types.senshigher is the one definition now. *)
f=ishighersensitivity(levela:$sensitivitylevel;levelb:$sensitivitylevel):bool{
  <t.senshigher(levela;levelb)
};


(* PL1.10 — the digit-boundary test, and why it is done here rather than in the pattern.

   str.charat is total: it returns 0 for a negative index and for an index at or past the
   end of the string, verified rather than assumed. So the character before a match at
   offset 0, and the character after a match that ends the text, are both 0 and neither is
   a digit. That is what makes the two tests below need no bounds guard, and it is the only
   reason this can be two character comparisons instead of a regex the engine cannot
   express: toke's engine has no word boundary, no lookaround, and \d matches nothing. *)
f=digitatindex(text:str;idx:i64):bool{
  let code=str.charat(text;idx);
  let isdigit=mut.false;
  if(code>=48){
    if(code<=57){
      isdigit=true
    }el{}
  }el{};
  <isdigit
};


(* Which patterns are a bare run of digits, and therefore match the middle of a longer
   number as readily as the whole of a shorter one.

   THE DEFECT THIS EXISTS FOR, measured: patautfn is
   `[0-9]{3}[ ]?[0-9]{3}[ ]?[0-9]{3}|...` with nothing anchoring either end, so on
   "Call us on 0412 345 678" it matched the trailing nine digits — "412 345 678" — and
   every Australian mobile number in the corpus was also reported as a tax file number.
   That is not merely a spurious entity. au_tfn carries RESTRICTED and phone_au carries
   CONFIDENTIAL, and the pipeline takes the maximum, so a phone number silently raised the
   whole prompt to the sensitivity of a tax file number. Sensitivity drives routing and
   gating, so over-detection is NOT fail-safe here the way over-redaction is: it changes
   which provider a request is allowed to reach.

   The named patterns are those where the match is a digit run with, at most, internal
   separators: a digit immediately before or after the match means the engine matched a
   fragment of a longer number, and a fragment of a longer number is not an instance of
   the type. email, api_key and url are deliberately absent — they carry their own
   delimiters, the api_key patterns are prefix-anchored, and a digit next to them is
   ordinary content rather than evidence of a fragment. *)
f=digitrunpattern(name:str):bool{
  let bounded=mut.false;
  if(str.eq(name;"au_tfn")){bounded=true}el if(str.eq(name;"au_abn")){bounded=true}el if(str.eq(name;"ssn_us")){bounded=true}el if(str.eq(name;"credit_card")){bounded=true}el if(str.eq(name;"phone_au")){bounded=true}el if(str.eq(name;"phone_us")){bounded=true}el if(str.eq(name;"ip_v4")){bounded=true}el if(str.eq(name;"au_medicare")){bounded=true}el if(str.eq(name;"au_bsb")){bounded=true}el if(str.eq(name;"bank_account") || contextonlypattern(name) || ukpattern(name)){bounded=true}el{};
  <bounded
};


(* True when neither neighbour of [start,end) is a digit. `end` is exclusive, so
   text[end] is the following character. *)
f=boundaryclear(text:str;start:i64;end:i64):bool{
  let clear=mut.true;
  if(digitatindex(text;start-1)){
    clear=false
  }el if(digitatindex(text;end)){
    clear=false
  }el{};
  <clear
};


(* PL1.10, considered and NOT WIRED IN. Read the comment before enabling it.

   The Australian TFN check: nine digits weighted 1,4,3,7,5,8,6,9,10, and the weighted sum
   divisible by 11. docs/metrics-baseline.md records that 36 of the 49 measured false
   positives are bare nine-digit au_tfn and ssn_us matches with no checksum, which makes
   this the single largest measured source of false positives in the regex layer, and
   tests/fixtures/pii-corpus already generates checksum-valid TFNs for its positives and
   deliberately checksum-invalid ones for its negatives. So the corpus is built for this
   check and the precision gain is real.

   It is a predicate with its own assertions and no production caller, because gating
   au_tfn on it changes a currently green test: the harness fixture in
   privacy/test_harness.tk is "My TFN is 123 456 789", whose weighted sum is 323, which is
   not divisible by 11. 123 456 789 is not a valid tax file number. Gating detection on
   this predicate therefore makes that case detect nothing and report PUBLIC where it
   expects RESTRICTED, and the fix for that is changing the fixture to a real TFN — a
   decision about what the test suite asserts, not a detail of the detector, so it is not
   taken silently here.

   Only the nine-digit form is answered. Eight-digit TFNs exist and use a different weight
   set; this returns false for them, so a caller that gates on it must handle the
   eight-digit alternative of patautfn separately or it will turn a miss into a silent one.
   Separators are ignored, so the spaced and unspaced forms agree. *)
f=tfnchecksumvalid(value:str):bool{
  let digits=mut."";
  let len=str.len(value) as i64;
  lp(let i=0;i<len;i=i+1){
    if(digitatindex(value;i)){
      digits=str.concat(digits;str.substr(value;i;i+1))
    }el{}
  };
  let dlen=str.len(digits) as i64;
  if(dlen==9){
    let weights=@(1;4;3;7;5;8;6;9;10);
    let total=mut.0;
    lp(let k=0;k<9;k=k+1){
      let digit=str.charat(digits;k)-48;
      total=total+digit*weights.get(k)
    };
    <total-(total/11)*11==0
  }el{
    <false
  }
};


(* The digits of a value, separators dropped. *)
f=digitsof(value:str):str{
  let digits=mut."";
  let len=str.len(value) as i64;
  lp(let i=0;i<len;i=i+1){
    if(digitatindex(value;i)){
      digits=str.concat(digits;str.substr(value;i;i+1))
    }el{}
  };
  <digits
};

(* RG1.7. The Medicare card number check, as Services Australia defines it: the first
   digit is 2 to 6, and the ninth digit equals the sum of the first eight weighted
   1,3,7,9,1,3,7,9, modulo 10. The tenth digit is the card issue number and is not part of
   the check. An eleventh digit is the individual reference number (IRN), which is 1 to 9;
   0 is not an IRN. Ten or eleven digits are answered, separators ignored; any other length
   is false. tests/fixtures/pii-corpus builds its Medicare numbers with the same weights,
   and its checksum-invalid decoys must fail here. *)
f=medicarechecksumvalid(value:str):bool{
  let digits=digitsof(value);
  let dlen=str.len(digits) as i64;
  if(dlen<10 || dlen>11){ <false }el{};
  let first=str.charat(digits;0)-48;
  if(first<2 || first>6){ <false }el{};
  if(dlen==11){
    if(str.charat(digits;10)==48){ <false }el{}
  }el{};
  let weights=@(1;3;7;9;1;3;7;9);
  let total=mut.0;
  lp(let k=0;k<8;k=k+1){
    total=total+(str.charat(digits;k)-48)*weights.get(k)
  };
  <total-(total/10)*10==str.charat(digits;8)-48
};

(* RG1.7. A BSB has no check digit, so the only validation is the one that cannot reject a
   real BSB: six digits, and not 000-000, the all-zero placeholder that forms and the
   synthetic statements in tests/fixtures/bank-statements use for "no BSB". No other range
   is rejected. APCA's register is not available offline, the first digit names the
   institution and every first digit is in use, and rejecting a real BSB leaks it, which
   costs more than masking a number that only looks like one. *)
f=bsbvalid(value:str):bool{
  let digits=digitsof(value);
  <(str.len(digits) as i64)==6 && !str.eq(digits;"000000")
};

(* RG1.7a. The patterns that are their context words and nothing more: no check digit
   exists, or none is published, so the words in front are the whole of the validation. *)
f=contextonlypattern(name:str):bool{
  <str.eq(name;"au_crn") || str.eq(name;"passport") || str.eq(name;"driver_licence") || str.eq(name;"au_super_member") || str.eq(name;"sg_nric")
};

(* The UK identifiers, each validated in this module (NHS number on its check digit, NINO
   on HMRC's prefix rules, the driver number on its structure, the sort code on the one
   rejection that cannot lose a real one). All are digit-boundary checked. *)
f=ukpattern(name:str):bool{
  <str.eq(name;"uk_nhs_number") || str.eq(name;"uk_nino") || str.eq(name;"uk_sort_code") || str.eq(name;"uk_driving_licence")
};

(* The patterns whose match carries a context word (BSB, account, CRN, passport, licence,
   super member, NHS, sort code, NRIC or FIN) in front of the number. *)
f=contextpattern(name:str):bool{
  <str.eq(name;"au_bsb") || str.eq(name;"bank_account") || str.eq(name;"uk_nhs_number") || str.eq(name;"uk_sort_code") || contextonlypattern(name)
};

(* RG1.7a. The patterns whose identifier may begin with letters: a passport (N1234567,
   PA1234567), a licence (SA's S12345, or two letters and four digits), an NRIC (S1234567D)
   or a super member number (AB12345678). Walking back from the first digit over at most
   two letters reaches the identifier's start. The patterns' lettered forms all require a
   separator after the words; the super member number's digit-only form does not ("member
   number12345678"), so contextstart walks back only when the letters it reaches start a
   token, and otherwise reports from the first digit. *)
f=letteredpattern(name:str):bool{
  <str.eq(name;"passport") || str.eq(name;"driver_licence") || str.eq(name;"sg_nric") || str.eq(name;"au_super_member")
};

(* RG1.7b. The patterns a LETTER next to the match also rejects, not only a digit.

   After the match: au_tfn, because nine checksum-valid digits followed by a letter are a
   part or reference number (984593866N), or the digits of a CRN (123456789A), and not a
   TFN; measured on the corpus, no real TFN is followed by a letter, so none is lost. The
   cost is a TFN typed against a word with no space ("123456782and"), which is no longer
   reported. And the three identifiers that end in a letter or check character (NINO, the
   driver number, NRIC/FIN), whose last character is part of the shape: one more letter
   means the match is a fragment of a longer token.

   Before the match: only the two bare patterns that start with letters (NINO and the
   driver number), so "ZAB123456C" is not the NINO AB123456C. au_tfn is not checked
   before: "TFN123456782", a TFN written against its label, is still a TFN. *)
f=letterafterpattern(name:str):bool{
  <str.eq(name;"au_tfn") || str.eq(name;"uk_nino") || str.eq(name;"uk_driving_licence") || str.eq(name;"sg_nric")
};

f=letterbeforepattern(name:str):bool{
  <str.eq(name;"uk_nino") || str.eq(name;"uk_driving_licence")
};

f=letterboundaryclear(name:str;text:str;start:i64;end:i64):bool{
  let clear=mut.true;
  if(letterafterpattern(name) && letteratindex(text;end)){ clear=false }el{};
  if(letterbeforepattern(name) && letteratindex(text;start-1)){ clear=false }el{};
  <clear
};

(* The digits and letters of a value, spaces and hyphens dropped, letters upper-cased. *)
f=compactupper(value:str):str{
  let out=mut."";
  let len=str.len(value) as i64;
  lp(let i=0;i<len;i=i+1){
    if(digitatindex(value;i) || letteratindex(value;i)){ out="\(out)\(str.substr(value;i;i+1))" }el{}
  };
  <str.upper(out)
};

(* NHS number check digit, as the NHS Data Dictionary (attribute NHS NUMBER) defines it:
   the first nine digits weighted 10,9,8,7,6,5,4,3,2 and summed; the check digit is 11 minus
   the sum modulo 11, where 11 becomes 0 and 10 means the number is invalid and is never
   issued. Ten digits, separators ignored; any other length is false. *)
f=nhschecksumvalid(value:str):bool{
  let digits=digitsof(value);
  if((str.len(digits) as i64)!=10){ <false }el{};
  let total=mut.0;
  lp(let k=0;k<9;k=k+1){
    total=total+(str.charat(digits;k)-48)*(10-k)
  };
  let check=mut.(11-(total-(total/11)*11));
  if(check==11){ check=0 }el{};
  <check!=10 && check==str.charat(digits;9)-48
};

(* National Insurance number, HMRC National Insurance Manual NIM39110: D, F, I, Q, U and V
   are never the first or second prefix letter, O is never the second, the prefixes BG, GB,
   KN, NK, NT, TN and ZZ are not used, and the suffix is A, B, C or D. Nine characters
   once spaces are dropped, any case. *)
f=ninovalid(value:str):bool{
  let v=compactupper(value);
  if((str.len(v) as i64)!=9){ <false }el{};
  let a=str.substr(v;0;1);
  let b=str.substr(v;1;2);
  let prefix=str.substr(v;0;2);
  let never="DFIQUV";
  if(str.indexof(never;a)>=0 || str.indexof(never;b)>=0 || str.eq(b;"O")){ <false }el{};
  let unused=@("BG";"GB";"KN";"NK";"NT";"TN";"ZZ");
  let bad=mut.false;
  lp(let i=0;i<unused.len;i=i+1){
    if(str.eq(prefix;unused.get(i))){ bad=true }el{}
  };
  let suffix=str.charat(v;8);
  <!bad && suffix>=65 && suffix<=68
};

(* A sort code has no check digit; as with BSB the only rejection is the all-zero
   placeholder, which no bank uses. *)
f=sortcodevalid(value:str):bool{
  let digits=digitsof(value);
  <(str.len(digits) as i64)==6 && !str.eq(digits;"000000")
};

(* The UK identifiers' validation, by pattern name; true for every other pattern. *)
f=ukvalid(name:str;value:str):bool{
  if(str.eq(name;"uk_nhs_number")){ <nhschecksumvalid(value) }el{};
  if(str.eq(name;"uk_nino")){ <ninovalid(value) }el{};
  if(str.eq(name;"uk_sort_code")){ <sortcodevalid(value) }el{};
  if(str.eq(name;"uk_driving_licence")){ <ukdrivinglicencevalid(value) }el{};
  <true
};

(* GB driver number structure, DVLA leaflet INS57P. Sixteen characters once spaces are
   dropped: 1-5 the surname, a letter first and, once a 9 pads it, 9s to the end; 6 a
   digit (decade of birth); 7-8 the month, 01-12, or 51-62 for a woman; 9-10 the day,
   01-31; 11 a digit (year); 12 a letter and 13 a letter or 9 (initials); 14-16 the
   computer check characters, which the DVLA does not publish a rule for and are not
   judged. *)
f=ukdrivinglicencevalid(value:str):bool{
  let v=compactupper(value);
  if((str.len(v) as i64)!=16){ <false }el{};
  let ok=mut.letteratindex(v;0);
  let padded=mut.false;
  lp(let i=1;i<5;i=i+1){
    if(str.charat(v;i)==57){ padded=true }el if(padded || !letteratindex(v;i)){ ok=false }el{}
  };
  lp(let i=5;i<11;i=i+1){
    if(!digitatindex(v;i)){ ok=false }el{}
  };
  if(!ok){ <false }el{};
  let month=(str.charat(v;6)-48)*10+(str.charat(v;7)-48);
  let day=(str.charat(v;8)-48)*10+(str.charat(v;9)-48);
  <((month>=1 && month<=12) || (month>=51 && month<=62)) && day>=1 && day<=31 && letteratindex(v;11) && (letteratindex(v;12) || str.charat(v;12)==57)
};

f=letteratindex(text:str;idx:i64):bool{
  let code=str.charat(text;idx);
  <(code>=65 && code<=90) || (code>=97 && code<=122)
};

(* RG1.7a. Where the identifier starts in a context match: at the first digit, or for a
   lettered pattern up to two letters before it, provided those letters start a token (the
   character before them is not a letter). A licence written "1234AB" starts at its first
   digit and its letters are inside the run. *)
f=contextstart(name:str;value:str):i64{
  let first=firstdigit(value);
  let at=mut.first;
  if(letteredpattern(name)){
    lp(let k=0;k<2;k=k+1){
      if(at>0){
        if(letteratindex(value;at-1)){ at=at-1 }el{}
      }el{}
    };
    if(letteratindex(value;at-1)){ at=first }el{}
  }el{};
  <at
};

(* RG1.7. The offset of the first digit in a context match: "BSB 062-000" answers 4. The
   word is what makes the match an identifier, but the identifier is the number, so the
   span, the value and the placeholder cover the number alone, and the digit-boundary test
   is applied to the number's neighbours. A match with no digit answers its length. *)
f=firstdigit(value:str):i64{
  let len=str.len(value) as i64;
  let at=mut.len;
  lp(let i=len-1;i>=0;i=i-1){
    if(digitatindex(value;i)){ at=i }el{}
  };
  <at
};



(* Detection only. PL1.1: this layer no longer numbers its own entities.

   It used to take the index from its own `str.arraylen(entities)+1`, while
   presidio.topiientities took it from its own `entities.len+1` and the two NER layers
   hardcoded `1` — and pipeline.run then concatenated all four lists, so `_1` could
   arrive from more than one layer. Placeholders are assigned once, over the deduped
   list, by placeholder.assignplaceholders.

   The `phmap` that used to live here was dead: `let phmap=mut.ph.newmap()` was folded
   through ph.addentry on every match and then not returned, because
   $piidetectionresult has no map field. That was the ONLY addentry call site in the
   repository, so the restore table was built nowhere. placeholder.mapfromentities is
   the live path now.

   .anonymised is still filled in, because a field named `anonymised` that silently
   holds raw PII is the fail-open shape CLAUDE.md forbids and this function is called
   standalone (privacy/test_harness.tk, tests/integration). It is assigned after the
   scan from the same single generator, with an empty salt — a standalone caller has no
   request id. pipeline.run ignores this field and re-anonymises from the deduped list,
   so the unsalted numbering never reaches a provider.

   PL1.7 — THIS LAYER NOW REPORTS REAL SPANS. It used to set start:0;end:0 on every entity,
   which is why pipeline.dedupentities could not resolve overlaps for the only detection
   layer that runs without a network sidecar: shadowing is decided on spans, and every span
   was the same empty one.

   The spans do not come from the regex engine, because toke's engine does not expose a
   match offset anywhere. Checked, not assumed: str.findall, str.find, str.matches,
   str.countre and str.replacere are all typed (i64,i64)->i64 in the stdlib interface and
   none of them returns a position. What is available is the matched VALUE, and
   str.indexof, so the offset is recovered by locating the value in the text.

   HOW THE OFFSET IS RECOVERED, and its one honest limitation. `cursor` advances past each
   match, and each value is located in the remainder of the text rather than in the whole
   of it, so a pattern that matches the same value twice gets two distinct spans rather
   than the first one twice. That depends on str.findall returning its matches in
   left-to-right order, which it does — measured on a nineteen-digit run, where au_tfn
   returned the leading nine digits before the trailing nine. Where a value genuinely
   cannot be located from the cursor, which should not happen for a value the engine just
   matched, the entity keeps the old spanless 0/0 rather than being given an invented
   offset or dropped: a fabricated span would silently mis-drive dedup, and dropping would
   lose a detection the layer actually made.

   PL1.10 — a digit-bounded match is rejected here rather than filtered downstream, because
   the sensitivity maximum is taken in this loop and a rejected match must not raise it.
   See digitrunpattern for the defect that motivates it. A match with no recovered span
   cannot be boundary-checked and is kept, which is the fail-safe direction for redaction
   and the pre-PL1.10 behaviour. *)
(* F3.1b. The first index of `needle` in `text` at or after `from`, or -1.

   The span search used to be str.indexof over str.substr(text;cursor;textlen), which copied
   the whole remainder of the text once per match. Nothing frees those copies, so peak memory
   grew with the square of the input and a 10 MB prompt was killed by the OS. This searches a
   window that starts just past the cursor and grows fourfold until the needle is inside it or
   the text ends, so each match copies about the distance to it rather than everything after
   it. A byte-by-byte search in place is not an option: str.charat measures the whole string
   on every call (T-55), which made it quadratic in time instead. *)
f=indexfrom(text:str;needle:str;from:i64;textlen:i64):i64{
  let m=str.len(needle) as i64;
  let win=mut.4096;
  let found=mut.(0-2);
  lp(let lv=0;found==(0-2);lv=lv){
    let hi=mut.(from+m+win);
    if(hi>textlen){ hi=textlen }el{};
    let off=str.indexof(str.substr(text;from;hi);needle);
    if(off>=0){
      found=from+off
    }el if(hi>=textlen){ found=0-1 }el{ win=win*4 }
  };
  <found
};

f=rundetection(text:str;patterns:@$patterndef):$piidetectionresult{
  let entities=mut.@();
  let sensitivity=mut.$sensitivitylevel{$public:0};
  let patcount=str.arraylen(patterns);
  let textlen=str.len(text) as i64;
  let pi=mut.0;
  lp(let lv=0;true;lv=lv){
    if(pi>=patcount){
      br
    }el{
      let pdef=patterns.get(pi);
      let matches=str.findall(text;pdef.pattern);
      let matchcount=str.arraylen(matches);
      let mi=mut.0;
      let cursor=mut.0;
      lp(let lv2=0;true;lv2=lv2){
        if(mi>=matchcount){
          br
        }el{
          let rawvalue=matches.get(mi);
          let matchedvalue=mut.rawvalue;
          let start=mut.0;
          let end=mut.0;
          let spanned=mut.false;
          let found=indexfrom(text;rawvalue;cursor;textlen);
          if(found<0){}el{
            start=found;
            end=start+(str.len(rawvalue) as i64);
            spanned=true;
            cursor=end
          };
          (* RG1.7: a context match reports the number, not the word in front of it. *)
          if(contextpattern(pdef.name)){
            let skip=contextstart(pdef.name;rawvalue);
            matchedvalue=str.substr(rawvalue;skip;str.len(rawvalue) as i64);
            if(spanned){ start=start+skip }el{}
          }el{};
          let keep=mut.true;
          if(spanned){
            if(digitrunpattern(pdef.name)){
              keep=boundaryclear(text;start;end)
            }el{};
            (* RG1.7b: for these, a neighbouring letter rejects the match as well. *)
            if(keep){
              keep=letterboundaryclear(pdef.name;text;start;end)
            }el{}
          }el{};
          (* au_tfn is gated on its checksum, and the measurement that justifies it:
             against tests/fixtures/pii-corpus the check rejects ALL 22 nine-digit
             NOT_PII decoys and loses NONE of the 16 labelled AU_TFN positives.
             docs/metrics-baseline.md records that 36 of 49 measured false positives were
             bare nine-digit au_tfn/ssn_us matches with no checksum — the single largest
             false-positive source in the project.

             It could not be switched on until the corpus was fixed. generate.py built the
             dash-separated adversarial case by bumping a valid TFN's last digit "to keep
             the case unambiguous", which broke the checksum as a side effect while still
             labelling it AU_TFN with expected_detected=true. So 4 of 16 positives asserted
             that a number which is not a TFN must be detected as one, and gating would have
             read as a 25% recall loss caused by a fixture bug. The generator now draws two
             independent checksum-valid numbers.

             ssn_us is deliberately NOT gated: its check digit rules are not a single
             modulus and inventing one would reject valid numbers. It keeps the boundary
             check only. *)
          if(keep){
            if(str.eq(pdef.name;"au_tfn")){
              keep=tfnchecksumvalid(matchedvalue)
            }el{
              (* RG1.7: Medicare on its check digit, BSB on the one rejection that cannot
                 lose a real one. bank_account has no check to apply; its context word is
                 its validation. *)
              if(str.eq(pdef.name;"au_medicare")){
                keep=medicarechecksumvalid(matchedvalue)
              }el{
                if(str.eq(pdef.name;"au_bsb")){
                  keep=bsbvalid(matchedvalue)
                }el{
                  keep=ukvalid(pdef.name;matchedvalue)
                }
              }
            }
          }el{};
          if(keep){
            let entity=$piientity{
              entitytype:pdef.name;
              value:matchedvalue;
              start:start as u32;
              end:end as u32;
              confidence:pdef.confidence;
              placeholder:""
            };
            entities=str.arraypush(entities;entity);
            if(ishighersensitivity(pdef.sensitivity;sensitivity)){
              sensitivity=pdef.sensitivity
            }el{

            }
          }el{};
          mi=mi+1
        }
      };
      pi=pi+1
    }
  };
  let placed=ph.assignplaceholders(entities;"");
  <$piidetectionresult{
    original:text;
    anonymised:ph.applytotext(text;placed);
    entities:placed;
    sensitivity:sensitivity
  }
};


f=detect(text:str):$piidetectionresult{
  let patterns=getpatterns();
  <rundetection(text;patterns)
};


f=detectwithpatterns(text:str;patterns:@$patterndef):$piidetectionresult{
  <rundetection(text;patterns)
};

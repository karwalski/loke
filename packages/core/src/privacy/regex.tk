m=core.privacy.regex;



i=pat:core.privacy.patterns;
i=ph:core.privacy.placeholder;
i=str:std.str;
i=t:shared.types;


t=$patterndef{
  name:str;
  pattern:str;
  sensitivity:$sensitivitylevel;
  confidence:f64
};


f=getpatterns():@$patterndef{
  <@(
    $patterndef{name:"email";pattern:pat.patemail();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.95};
    $patterndef{name:"phone_au";pattern:pat.patphoneau();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.92};
    $patterndef{name:"phone_us";pattern:pat.patphoneus();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.92};
    $patterndef{name:"credit_card";pattern:pat.patcreditcard();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99};
    $patterndef{name:"ip_v4";pattern:pat.patipv4();sensitivity:$sensitivitylevel{$internal:0};confidence:0.80};
    $patterndef{name:"au_tfn";pattern:pat.patautfn();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99};
    $patterndef{name:"au_abn";pattern:pat.patauabn();sensitivity:$sensitivitylevel{$confidential:0};confidence:0.85};
    $patterndef{name:"ssn_us";pattern:pat.patssnus();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99};
    $patterndef{name:"url";pattern:pat.paturl();sensitivity:$sensitivitylevel{$internal:0};confidence:0.60};
    $patterndef{name:"api_key";pattern:pat.patapikey();sensitivity:$sensitivitylevel{$restricted:0};confidence:0.99}
  )
};


(* Ranked. This was a duplicate of the chain in privacy/pipeline.tk, with the same
   defect: == on a sum compares the handle, not the variant, so a level that arrived
   from another function never matched any arm and this returned false for every
   pair. shared.types.senshigher is the one definition now. *)
f=ishighersensitivity(levela:$sensitivitylevel;levelb:$sensitivitylevel):bool{
  <t.senshigher(levela;levelb)
};



f=rundetection(text:str;patterns:@$patterndef):$piidetectionresult{
  let phmap=ph.newmap();
  let entities=mut.@();
  let sensitivity=mut.$sensitivitylevel{$public:0};
  let anonymised=mut.text;
  let patcount=str.arraylen(patterns);
  let pi=mut.0;
  lp(let lv=0;true;lv=lv){
    if(pi>=patcount){
      br
    }el{
      let pdef=patterns.get(pi);
      let matches=str.findall(text;pdef.pattern);
      let matchcount=str.arraylen(matches);
      let mi=mut.0;
      lp(let lv2=0;true;lv2=lv2){
        if(mi>=matchcount){
          br
        }el{
          let matchedvalue=str.arrayget(matches;mi);
          
          let entityindex=str.arraylen(entities)+1;
          let placeholder=ph.makeplaceholder(pdef.name;entityindex);
          ph.addentry(phmap;matchedvalue;placeholder;pdef.name);
          let entity=$piientity{
            entitytype:pdef.name;
            value:matchedvalue;
            start:0;
            end:0;
            confidence:pdef.confidence;
            placeholder:placeholder
          };
          entities=str.arraypush(entities;entity);
          anonymised=str.replace(anonymised;matchedvalue;placeholder);
          if(ishighersensitivity(pdef.sensitivity;sensitivity)){
            sensitivity=pdef.sensitivity
          }el{
            
          };
          mi=mi+1
        }
      };
      pi=pi+1
    }
  };
  <$piidetectionresult{
    original:text;
    anonymised:anonymised;
    entities:entities;
    sensitivity:sensitivity
  }
};


f=detect(text:str):$piidetectionresult{
  let patterns=getpatterns();
  <rundetection(text;patterns)
};


f=detectwithpatterns(text:str;patterns:@$patterndef):$piidetectionresult{
  <rundetection(text;patterns)
};

m=core.privacy.regex;



i=t:shared.types;
i=pat:core.privacy.patterns;
i=ph:core.privacy.placeholder;
i=str:std.str;


t=$patterndef{
  name:str;
  pattern:str;
  sensitivity:$sensitivitylevel;
  confidence:f64
};


f=getpatterns():@$patterndef{
  <@(
    $patterndef{name:"email";pattern:pat.patemail;sensitivity:$confidential;confidence:0.95};
    $patterndef{name:"phone_au";pattern:pat.patphoneau;sensitivity:$confidential;confidence:0.92};
    $patterndef{name:"phone_us";pattern:pat.patphoneus;sensitivity:$confidential;confidence:0.92};
    $patterndef{name:"credit_card";pattern:pat.patcreditcard;sensitivity:$restricted;confidence:0.99};
    $patterndef{name:"ip_v4";pattern:pat.patipv4;sensitivity:$internal;confidence:0.80};
    $patterndef{name:"au_tfn";pattern:pat.patautfn;sensitivity:$restricted;confidence:0.99};
    $patterndef{name:"au_abn";pattern:pat.patauabn;sensitivity:$confidential;confidence:0.85};
    $patterndef{name:"ssn_us";pattern:pat.patssnus;sensitivity:$restricted;confidence:0.99};
    $patterndef{name:"url";pattern:pat.paturl;sensitivity:$internal;confidence:0.60};
    $patterndef{name:"api_key";pattern:pat.patapikey;sensitivity:$restricted;confidence:0.99};
  )
};


f=ishighersensitivity(levela:$sensitivitylevel;levelb:$sensitivitylevel):bool{
  if(levela==$restricted){
    <true
  }else{
    if(levela==$confidential){
      if(levelb==$restricted){
        <false
      }else{
        <true
      };
    }else{
      if(levela==$internal){
        if(levelb==$restricted){
          <false
        }else{
          if(levelb==$confidential){
            <false
          }else{
            <true
          };
        };
      }else{
        <false
      };
    };
  };
};


f=rundetection(text:str;patterns:@$patterndef):$piidetectionresult{
  let phmap=ph.newmap();
  let entities=@();
  let sensitivity=$public;
  let anonymised=text;
  let patcount=str.arraylen(patterns);
  let pi=0;
  loop{
    if(pi>=patcount){
      break
    }else{
      let pdef=str.arrayget(patterns;pi);
      let matches=str.findall(text;pdef.pattern);
      let matchcount=str.arraylen(matches);
      let mi=0;
      loop{
        if(mi>=matchcount){
          break
        }else{
          let matchedvalue=str.arrayget(matches;mi);
          
          let entityindex=str.arraylen(entities)+1;
          let placeholder=ph.makeplaceholder(pdef.name;entityindex);
          ph.addentry(phmap;matchedvalue;placeholder;pdef.name);
          let entity=t.$piientity{
            entitytype:pdef.name;
            value:matchedvalue;
            start:0;
            end:0;
            confidence:pdef.confidence;
            placeholder:placeholder
          };
          entities=str.arraypush(entities;entity);
          anonymised=str.replace(anonymised;matchedvalue;placeholder);
          if(ishighersensitivity(pdef.sensitivity;sensitivity)){
            sensitivity=pdef.sensitivity
          }else{
            
          };
          mi=mi+1
        };
      };
      pi=pi+1
    };
  };
  <t.$piidetectionresult{
    original:text;
    anonymised:anonymised;
    entities:entities;
    sensitivity:sensitivity
  };
};


f=detect(text:str):$piidetectionresult{
  let patterns=getpatterns();
  <rundetection(text;patterns)
};


f=detectwithpatterns(text:str;patterns:@$patterndef):$piidetectionresult{
  <rundetection(text;patterns)
};

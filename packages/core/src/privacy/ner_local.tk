m=core.privacy.nerlocal;





i=t:shared.types;
i=inf:models.infer;
i=ner:privacy.ner;
i=log:shared.log;


f=nermodelid():str{
  <"qwen2.5:0.5b"
};

f=buildprompt(input:str):str{
  let line1="Extract named entities from the following text. Return JSON array only.";
  let line2="Format: [{\"text\":\"...\",\"label\":\"PERSON\"|\"EMAIL\"|\"PHONE\"|\"ORG\"|\"LOC\"|\"DATE\",\"start\":N,\"end\":N}]";
  let line3=str.concat("Text: ";input);
  let l1l2=str.concat(line1;"
");
  let l1l2b=str.concat(l1l2;line2);
  let sep=str.concat(l1l2b;"
");
  <str.concat(sep;line3)
};

f=labeltoentitytype(label:str):str{
  if(str.eq(label;"PERSON")){
    <"PERSON"
  }el{
    if(str.eq(label;"EMAIL")){
      <"EMAIL"
    }el{
      if(str.eq(label;"PHONE")){
        <"PHONE"
      }el{
        if(str.eq(label;"ORG")){
          <"ORG"
        }el{
          if(str.eq(label;"LOC")){
            <"LOC"
          }el{
            if(str.eq(label;"DATE")){
              <"DATE"
            }el{
              <"UNKNOWN"
            }
          }
        }
      }
    }
  }
};

f=labeltoplaceholder(label:str):str{
  let open=str.concat("[";label);
  <str.concat(open;"_NER_1]")
};

f=labeltoconfidence(label:str):f64{
  if(str.eq(label;"PERSON")){
    <0.78
  }el{
    if(str.eq(label;"EMAIL")){
      <0.78
    }el{
      if(str.eq(label;"PHONE")){
        <0.78
      }el{
        if(str.eq(label;"ORG")){
          <0.65
        }el{
          if(str.eq(label;"LOC")){
            <0.65
          }el{
            if(str.eq(label;"DATE")){
              <0.50
            }el{
              <0.50
            }
          }
        }
      }
    }
  }
};

f=nerlocalhandlejsonerr(entities:@i64):@i64{
  log.warn("ner_local: failed to parse model JSON response";"ner_local";"");
  <entities
};

f=nerlocalparseentities(arr:i64;entities:@i64):@i64{
  let items=json.getarr(arr;"");
  mt items {
    $ok:item nerlocalparseitem(item;entities);
    $err:e entities
  };
  <entities
};

f=nerlocalparseitem(item:i64;entities:@i64):@i64{
  let label=json.getstr(item;"label");
  let value=json.getstr(item;"text");
  let start=json.getint(item;"start");
  let end=json.getint(item;"end");
  let entitytype=labeltoentitytype(label);
  let placeholder=labeltoplaceholder(label);
  let confidence=labeltoconfidence(label);
  let entity=$piientity{
    entitytype:entitytype;
    value:value;
    start:start;
    end:end;
    confidence:confidence;
    placeholder:placeholder
  };
  entities=@(entities;entity);
  <entities
};

f=detectlocal(text:str;pool:i64):@i64{
  let loaded=inf.isloaded(pool;nermodelid());
  if(loaded){
    let prompt=buildprompt(text);
    let raw=inf.generate(pool;nermodelid();prompt;256);
    let parsed=json.dec(raw);
    let entities=@();
    mt parsed {
      $jsonerr:e nerlocalhandlejsonerr(entities);
      $ok:arr nerlocalparseentities(arr;entities)
    }
  }el{
    log.warn("ner_local: falling back to Ollama";"ner_local";"");
    let fallbackclient=ner.new("http://localhost:11434";"qwen2.5:7b");
    let result=ner.detectentities(fallbackclient;text);
    mt result {
      $lokeerr:e @();
      $ok:entities entities
    }
  }
};

f=embedtext(text:str;pool:i64):@f32{
  let loaded=inf.isloaded(pool;nermodelid());
  if(loaded){
    <inf.embed(pool;nermodelid;text)
  }el{
    log.warn("ner_local: embed_text -- model not loaded, returning empty vector";"ner_local";"");
    <@()
  }
};

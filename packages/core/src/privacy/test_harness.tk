m=core.privacy.test_harness;




i=t:shared.types;
i=regex:core.privacy.regex;
i=pipeline:core.privacy.pipeline;
i=guardian:core.privacy.guardian;
i=ph:core.privacy.placeholder;
i=str:std.str;
i=log:shared.log;

t=$testcase{
  name:str;
  input:str;
  expectentities:u32;
  expectsensitivity:str;
  expectpiitypes:@str
};

t=$testresult{
  name:str;
  passed:bool;
  message:str
};


f=asserteqstr(label:str;got:str;want:str):$testresult{
  if(str.eq(got;want)){
    <$testresult{name:label;passed:true;message:"ok"};
  }else{
    let msg=str.concat("expected \"";str.concat(want;str.concat("\" got \"";str.concat(got;"\""))));
    <$testresult{name:label;passed:false;message:msg};
  };
};


f=assertgtu32(label:str;got:u32;min:u32):$testresult{
  if(got >= min){
    <$testresult{name:label;passed:true;message:"ok"};
  }else{
    let gots=str.fromint(got);
    let mins=str.fromint(min);
    let msg=str.concat("expected at least ";str.concat(mins;str.concat(" entity, got ";gots)));
    <$testresult{name:label;passed:false;message:msg};
  };
};


f=asserttrue(label:str;val:bool):$testresult{
  if(val){
    <$testresult{name:label;passed:true;message:"ok"};
  }else{
    <$testresult{name:label;passed:false;message:"expected true, got false"};
  };
};


f=testcases():@$testcase{
  <@(
    $testcase{
      name:"email detection";
      input:"Contact john.smith@example.com for info";
      expectentities:1;
      expectsensitivity:"CONFIDENTIAL";
      expectpiitypes:@("email")
    };
    $testcase{
      name:"phone AU";
      input:"Call us on 0412 345 678";
      expectentities:1;
      expectsensitivity:"CONFIDENTIAL";
      expectpiitypes:@("phone")
    };
    $testcase{
      name:"credit card";
      input:"Card: 4111 1111 1111 1111";
      expectentities:1;
      expectsensitivity:"RESTRICTED";
      expectpiitypes:@("credit_card")
    };
    $testcase{
      name:"api key";
      input:"Key: sk-ant-abc123xyz456def789ghi";
      expectentities:1;
      expectsensitivity:"RESTRICTED";
      expectpiitypes:@("api_key")
    };
    $testcase{
      name:"no PII";
      input:"The weather is nice today";
      expectentities:0;
      expectsensitivity:"PUBLIC";
      expectpiitypes:@()
    };
    $testcase{
      name:"multiple PII";
      input:"John (john@example.com, 0412 345 678)";
      expectentities:2;
      expectsensitivity:"CONFIDENTIAL";
      expectpiitypes:@("email";"phone")
    };
    $testcase{
      name:"au tfn";
      input:"My TFN is 123 456 789";
      expectentities:1;
      expectsensitivity:"RESTRICTED";
      expectpiitypes:@("au_tfn")
    };
  )
};


f=sensitivitytostr(s:$sensitivitylevel):str{
  mt s {
    $sensitivitylevel.$public      { <"PUBLIC" };
    $sensitivitylevel.$internal    { <"INTERNAL" };
    $sensitivitylevel.$confidential{ <"CONFIDENTIAL" };
    $sensitivitylevel.$restricted  { <"RESTRICTED" };
  };
};



f=runtestcase(tc:$testcase):@$testresult{
  let detection=regex.detect(tc.input);
  let entitycount=str.arraylen(detection.entities);
  let sensitivitystr=sensitivitytostr(detection.sensitivity);
  let results=@();

  
  if(tc.expectentities > 0){
    let r=assertgtu32(
      str.concat(tc.name;": entity count");
      entitycount;
      tc.expectentities
    );
    let results=str.arraypush(results;r)
  }else{
    
    let zerolabel=str.concat(tc.name;": no entities expected");
    let r=if entitycount == 0{
      $testresult{name:zerolabel;passed:true;message:"ok"};
    }else{
      let gots=str.fromint(entitycount);
      $testresult{
        name:zerolabel;
        passed:false;
        message:str.concat("expected 0 entities, got ";gots)
      };
    };
    let results=str.arraypush(results;r)
  };

  
  let sensr=asserteqstr(
    str.concat(tc.name;": sensitivity");
    sensitivitystr;
    tc.expectsensitivity
  );
  let results=str.arraypush(results;sensr);

  
  let systemwithguardian=guardian.buildsystemprompt("");
  let guardianr=asserttrue(
    str.concat(tc.name;": guardian present");
    guardian.isguardianpresent(systemwithguardian)
  );
  let results=str.arraypush(results;guardianr);

  <results
};


f=runalltests():bool{
  let cases=testcases();
  let casecount=str.arraylen(cases);
  let allpassed=true;
  let ci=0;
  loop{
    if(ci >= casecount){
      break
    }else{
      let tc=str.arrayget(cases;ci);
      let results=runtestcase(tc);
      let resultcount=str.arraylen(results);
      let casepassed=true;
      let ri=0;
      loop{
        if(ri >= resultcount){
          break
        }else{
          let r=str.arrayget(results;ri);
          if(!$r.passed){
            let casepassed=false;
            let allpassed=false;
            log.warn(
              str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message)));
              "test_harness";
              "system"
            )
          };
          ri=ri+1
        };
      };
      if(casepassed){
        log.info(
          str.concat("PASS ";str.concat(tc.name;str.concat(" (";str.concat(str.fromint(resultcount);" assertions)"))));
          "test_harness";
          "system"
        )
      };
      ci=ci+1
    };
  };
  <allpassed
};


f=formatresults(results:@$testresult):str{
  let header="Privacy Pipeline Tests
======================";
  let body="";
  let passcount=0;
  let failcount=0;
  let count=str.arraylen(results);
  let i=0;
  loop{
    if(i >= count){
      break
    }else{
      let r=str.arrayget(results;i);
      let line=if r.passed{
        let passcount=passcount+1;
        str.concat("PASS ";r.name)
      }else{
        let failcount=failcount+1;
        str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message)))
      };
      let body=str.concat(body;str.concat("
";line));
      i=i+1;
    };
  };
  let total=passcount+failcount;
  let totals=str.fromint(total);
  let passs=str.fromint(passcount);
  let summary=str.concat("
Result: ";str.concat(passs;str.concat("/";str.concat(totals;" passed"))));
  <str.concat(header;str.concat(body;summary))
};

m=core.privacy.testharness;




i=regex:core.privacy.regex;
i=guardian:core.privacy.guardian;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=pipeline:core.privacy.pipeline;
i=ph:core.privacy.placeholder;

t=$testcase{
  name:str;
  input:str;
  expectentities:u32;
  expectsensitivity:str;
  expectpiitypes:@str
};

t=$testresult{
  name:str;
  passed:bool;
  message:str
};


f=asserteqstr(label:str;got:str;want:str):$testresult{
  if(str.eq(got;want)){
    <$testresult{name:label;passed:true;message:"ok"}
  }el{
    let msg=str.concat("expected \"";str.concat(want;str.concat("\" got \"";str.concat(got;"\""))));
    <$testresult{name:label;passed:false;message:msg}
  }
};


(* AD1.8. A third defect of the same kind as the two below, and found the same way --
   by running the thing for the first time. The comparison was `got > min` while every
   caller passes tc.expectentities and every message this function writes says "expected
   at least". So a case expecting one entity and finding exactly one was reported as a
   failure: four of the seven cases (email, credit card, api key, au tfn) were red on
   arithmetic rather than on anything the detector did. "At least" is `>=`. *)
f=assertgtu32(label:str;got:u32;min:u32):$testresult{
  if(got >= min){
    <$testresult{name:label;passed:true;message:"ok"}
  }el{
    let gots=str.fromint(got);
    let mins=str.fromint(min);
    let msg=str.concat("expected at least ";str.concat(mins;str.concat(" entity, got ";gots)));
    <$testresult{name:label;passed:false;message:msg}
  }
};


f=asserttrue(label:str;val:bool):$testresult{
  if(val){
    <$testresult{name:label;passed:true;message:"ok"}
  }el{
    <$testresult{name:label;passed:false;message:"expected true, got false"}
  }
};


f=testcases():@$testcase{
  <@(
    $testcase{
      name:"email detection";
      input:"Contact john.smith@example.com for info";
      expectentities:1;
      expectsensitivity:"CONFIDENTIAL";
      expectpiitypes:@("email")
    };
    $testcase{
      name:"phone AU";
      input:"Call us on 0412 345 678";
      expectentities:1;
      expectsensitivity:"CONFIDENTIAL";
      expectpiitypes:@("phone")
    };
    $testcase{
      name:"credit card";
      input:"Card: 4111 1111 1111 1111";
      expectentities:1;
      expectsensitivity:"RESTRICTED";
      expectpiitypes:@("credit_card")
    };
    $testcase{
      name:"api key";
      input:"Key: sk-ant-abc123xyz456def789ghi";
      expectentities:1;
      expectsensitivity:"RESTRICTED";
      expectpiitypes:@("api_key")
    };
    $testcase{
      name:"no PII";
      input:"The weather is nice today";
      expectentities:0;
      expectsensitivity:"PUBLIC";
      expectpiitypes:@()
    };
    $testcase{
      name:"multiple PII";
      input:"John (john@example.com, 0412 345 678)";
      expectentities:2;
      expectsensitivity:"CONFIDENTIAL";
      expectpiitypes:@("email";"phone")
    };
    $testcase{
      name:"au tfn";
      input:"My TFN is 123 456 789";
      expectentities:1;
      expectsensitivity:"RESTRICTED";
      expectpiitypes:@("au_tfn")
    }
  )
};


f=sensitivitytostr(s:$sensitivitylevel):str{
  <mt s {
    $public:v "PUBLIC" ;
    $internal:v "INTERNAL" ;
    $confidential:v "CONFIDENTIAL" ;
    $restricted:v "RESTRICTED" 
  }
};



(* Every `let results=str.arraypush(results;...)` declared a new binding rather than
   assigning, so runtestcase returned an empty array: the harness ran the assertions
   and threw all of them away, reporting "0 assertions" for every case. *)
f=runtestcase(tc:$testcase):@$testresult{
  let detection=regex.detect(tc.input);
  let entitycount=detection.entities.len as u32;
  let results=mut.@();

  if(tc.expectentities > 0 as u32){
    results=results.push(assertgtu32("\(tc.name): entity count";entitycount;tc.expectentities))
  }el{
    let zerolabel="\(tc.name): no entities expected";
    if(entitycount == 0 as u32){
      results=results.push($testresult{name:zerolabel;passed:true;message:"ok"})
    }el{
      results=results.push($testresult{
        name:zerolabel;
        passed:false;
        message:"expected 0 entities, got \(entitycount)"
      })
    }
  };

  results=results.push(asserteqstr(
    "\(tc.name): sensitivity";
    sensitivitytostr(detection.sensitivity);
    tc.expectsensitivity
  ));

  results=results.push(asserttrue(
    "\(tc.name): guardian present";
    guardian.isguardianpresent(guardian.buildsystemprompt(""))
  ));

  <results
};

f=caseresults(tc:$testcase;results:@$testresult):bool{
  let casepassed=mut.true;
  lp(let ri=0;ri<results.len;ri=ri+1){
    let r:$testresult=results.get(ri);
    if(r.passed){}el{
      casepassed=false;
      log.warn("FAIL \(r.name): \(r.message)";"test_harness";"system")
    }
  };
  if(casepassed){
    log.info("PASS \(tc.name) (\(results.len) assertions)";"test_harness";"system")
  }el{};
  <casepassed
};

(* `ci > casecount` and `ri > resultcount` each ran one iteration past the end of
   their array. *)
f=runalltests():bool{
  let cases=testcases();
  let allpassed=mut.true;
  lp(let ci=0;ci<cases.len;ci=ci+1){
    let tc:$testcase=cases.get(ci);
    if(caseresults(tc;runtestcase(tc))){}el{
      allpassed=false
    }
  };
  <allpassed
};

(* `let i=i+1` inside the loop body declared a new `i` each pass, so the counter
   never advanced: this did not merely format nothing, it did not terminate. *)
f=formatresults(results:@$testresult):str{
  let lines=mut.@();
  let passcount=mut.0;
  let failcount=mut.0;
  lp(let i=0;i<results.len;i=i+1){
    let r:$testresult=results.get(i);
    if(r.passed){
      passcount=passcount+1;
      lines=lines.push("PASS \(r.name)")
    }el{
      failcount=failcount+1;
      lines=lines.push("FAIL \(r.name): \(r.message)")
    }
  };
  <"Privacy Pipeline Tests
======================
\(str.join("
";lines))

Result: \(passcount)/\(passcount+failcount) passed"
};

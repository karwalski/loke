m=core.privacy.sidecarclient;
i=http:std.http;
i=str:std.str;
i=json:std.json;

f=sidecarurl():str{
  <"http://127.0.0.1:11435"
};

f=isavailable():bool{
  let resp=http.get(str.concat(sidecarurl();"/health"));
  <str.contains(resp;"ok")
};

f=detect(text:str):str{
  let body=str.concat("{\"text\":";str.concat(json.enc(text);"}"));
  <http.posturl(str.concat(sidecarurl();"/detect");body)
};

f=anonymise(text:str):str{
  let body=str.concat("{\"text\":";str.concat(json.enc(text);"}"));
  <http.posturl(str.concat(sidecarurl();"/anonymise");body)
};

f=listmodels():str{
  <http.get(str.concat(sidecarurl();"/models"))
};

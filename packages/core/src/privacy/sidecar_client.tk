m=core.privacy.sidecarclient;

i=json:std.json;
i=str:std.str;
i=cfg:shared.config;
i=jx:shared.jsonobj;
i=reach:shared.reachability;
i=t:shared.types;
i=fr:core.privacy.filterregistry;

(* The client of the privacy-filter sidecar, packages/privacy-filter/server.py.

   AD1.4, operating-point control. The sidecar applies a confidence threshold to every span
   on /detect and /anonymise, and answers with the threshold it applied and how many spans
   it suppressed below it. This client used to send only the text, so the operating point
   was whatever the sidecar was started with, and it returned the response string unparsed,
   so nothing on the loke side could see which threshold had been applied.

   It now sends the threshold configured as `privacy.privacy_filter_threshold`, and reads
   back the threshold the sidecar reports applying. When nothing is configured it sends NO
   threshold, so the sidecar's own default governs: `confidence_threshold` in
   packages/privacy-filter/models.json, overridable at sidecar start by LOKE_PF_THRESHOLD
   (server.py, DEFAULT_THRESHOLD). This client does not choose a number of its own. The
   models.json note records why that default is 0.0: a missed entity leaks, a spurious one
   only costs utility.

   The threshold is carried as JSON number TEXT, never an f64: std.toml has no float
   accessor, so the configured value is a TOML string, and asrequested compares the text
   sent with the text the sidecar reports, which an f64 round trip would not keep exactly.
   (The first reason given was T-20, an f64 returned across a module boundary; toke 3.1.0
   fixed that, LS1.1h.) *)

t=$pfclient{
  baseurl:str;
  threshold:str
};

(* What a caller reads from /detect or /anonymise.

   ok is true only when the sidecar answered with the shape of a scan. A plain struct, not a
   result, because a match on a result whose error side is a user sum takes its first arm
   whatever the value is (T-18), and a failed scan read as a clean one is the fail-open
   CLAUDE.md forbids.

   requested is the threshold this client sent, "" when it sent none. applied is the
   threshold the sidecar reports applying, "" when it reported none. asrequested is false
   when a threshold was sent and the sidecar did not report applying that value, which is
   what an older sidecar that ignores the field looks like. *)
t=$pfscan{
  ok:bool;
  requested:str;
  applied:str;
  asrequested:bool;
  suppressed:i64;
  count:i64;
  body:str
};

(* F3b.3. What the pipeline reads from one /detect: the spans as $piientity, in the
   pipeline's own entity taxonomy, with byte offsets into the text loke holds. A plain struct
   for the same reason as $pfscan (T-18). ok is false when the scan failed, AND when the
   sidecar said it found more entities than could be read out of its answer: an entity
   counted and then lost in parsing would be a detection that is never anonymised, which is
   a fail-open.

   unplaced counts spans that could not be located in the text at all (neither their offsets
   nor their value). There is nothing to substitute for those, so they cannot be anonymised
   here; the count lets a caller see that it happened. *)
t=$pfentities{
  ok:bool;
  hits:@$piientity;
  unplaced:i64;
  applied:str;
  suppressed:i64
};

(* F3b.1: the layer registry holds each layer's default address; this reads it. *)
f=sidecarurl():str{
  <fr.defaultpfurl()
};

(* A threshold the sidecar can apply, as JSON number text: "0", "1", "0.<digits>" or
   "1.<zeros>". Anything else, including a negative, a value above one, a blank or an
   exponent, is not sent, and the sidecar's own default governs. *)
f=alldigits(s:str;from:i64;zerosonly:bool):bool{
  let n=str.len(s) as i64;
  if(from>=n){ <false }el{};
  let good=mut.true;
  lp(let k=from;k<n;k=k+1){
    let c=str.charat(s;k);
    if(zerosonly){
      if(c==48){}el{ good=false }
    }el{
      if(c<48 || c>57){ good=false }el{}
    }
  };
  <good
};

f=isthreshold(s:str):bool{
  let n=str.len(s) as i64;
  if(n==0){ <false }el{};
  let lead=str.charat(s;0);
  if(lead==48 || lead==49){}el{ <false };
  if(n==1){ <true }el{};
  if(str.charat(s;1)==46){}el{ <false };
  <alldigits(s;2;lead==49)
};

(* The text Python prints for float(s), which is what the sidecar reports back: "0" is
   "0.0", "0.50" is "0.5", "1" is "1.0". Only the forms isthreshold accepts reach this. *)
f=trimzeros(s:str):str{
  let end=mut.(str.len(s) as i64);
  lp(let k=0;end>0 && str.charat(s;end-1)==48;k=k+1){
    end=end-1
  };
  <str.slice(s;0;end)
};

f=normthreshold(s:str):str{
  if(!isthreshold(s)){ <"" }el{};
  if(str.len(s)==1){ <"\(s).0" }el{};
  let t=trimzeros(s);
  if(str.charat(t;(str.len(t) as i64)-1)==46){ <"\(t)0" }el{};
  <t
};

f=new(baseurl:str;threshold:str):$pfclient{
  <$pfclient{baseurl:baseurl;threshold:normthreshold(str.trim(threshold))}
};

f=fromconfig(c:$lokeconfig):$pfclient{
  <new(sidecarurl();c.pfthreshold)
};

f=requestbody(client:$pfclient;text:str):str{
  if(str.len(client.threshold)==0){ <"{\"text\":\(jx.escape(text))}" }el{};
  <"{\"text\":\(jx.escape(text)),\"threshold\":\(client.threshold)}"
};

f=isavailable(client:$pfclient):bool{
  <reach.isloopbackurl(client.baseurl) && str.contains(reach.localget(client.baseurl;"/health");"\"ok\"")
};

f=failedscan(client:$pfclient):$pfscan{
  <$pfscan{ok:false;requested:client.threshold;applied:"";asrequested:false;suppressed:0;count:0;body:""}
};

f=readscan(client:$pfclient;raw:str;obj:$json;shapekey:str):$pfscan{
  if(str.len(jx.rawvalue(obj;shapekey))==0){ <failedscan(client) }el{};
  let applied=jx.numtext(obj;"threshold";"");
  let asrequested=str.len(client.threshold)==0 || str.eq(applied;client.threshold);
  <$pfscan{
    ok:true;
    requested:client.threshold;
    applied:applied;
    asrequested:asrequested;
    suppressed:str.toint(jx.numtext(obj;"suppressed_below_threshold";"0"));
    count:str.toint(jx.numtext(obj;"count";"0"));
    body:raw
  }
};

(* The text goes IN CLEAR, so only to a loopback host; see core.privacy.ner.scan. *)
f=post(client:$pfclient;path:str;text:str;shapekey:str):$pfscan{
  if(!reach.isloopbackurl(client.baseurl)){ <failedscan(client) }el{};
  let raw=reach.localpost(client.baseurl;path;requestbody(client;text));
  if(!str.startswith(str.trim(raw);"{")){ <failedscan(client) }el{};
  <mt json.dec(raw) {
    $ok:obj readscan(client;raw;obj;shapekey);
    $jsonerr:e failedscan(client)
  }
};

f=detect(client:$pfclient;text:str):$pfscan{
  <post(client;"/detect";text;"entities")
};

f=anonymise(client:$pfclient;text:str):$pfscan{
  <post(client;"/anonymise";text;"anonymised")
};

(* F3b.3 -- the sidecar as a detection layer of core.privacy.pipeline. $pfentities, above,
   is what the pipeline reads.

   The sidecar's eight types (packages/privacy-filter/models.json, entity_mapping) in the
   taxonomy the pipeline's other layers report, so maxsensitivity and the placeholder
   prefixes treat a sidecar PERSON as they treat a Presidio or NER one. Where Presidio has a
   name for the type it is used (PERSON, EMAIL_ADDRESS, PHONE_NUMBER, URL); an account number
   is FINANCIAL, which the pipeline already rates confidential; the rest keep the sidecar's
   own label. A type outside the eight is kept, upper-cased, never dropped: an entity with an
   unfamiliar label is still an entity. *)
f=lokeentitytype(pftype:str):str{
  if(str.eq(pftype;"private_person")){ <"PERSON" }el{};
  if(str.eq(pftype;"private_email")){ <"EMAIL_ADDRESS" }el{};
  if(str.eq(pftype;"private_phone")){ <"PHONE_NUMBER" }el{};
  if(str.eq(pftype;"private_address")){ <"ADDRESS" }el{};
  if(str.eq(pftype;"private_url")){ <"URL" }el{};
  if(str.eq(pftype;"private_date")){ <"DATE" }el{};
  if(str.eq(pftype;"account_number")){ <"FINANCIAL" }el{};
  if(str.eq(pftype;"secret")){ <"SECRET" }el{};
  if(str.len(pftype)==0){ <"PII" }el{};
  <str.toupper(pftype)
};

(* The byte offset at which code point number charoff begins: the sidecar counts Unicode
   code points (Python str indices), loke's detectors count bytes. A UTF-8 continuation
   byte (0x80-0xBF) does not start a code point. Past the end answers the byte length. The
   same walk as core.privacy.evaluation.bytestart, which this module does not import. *)
f=cpbyte(text:str;charoff:i64):i64{
  let n=str.len(text) as i64;
  let seen=mut.0;
  let at=mut.n;
  let done=mut.false;
  lp(let b=0;b<n && !done;b=b+1){
    let c=str.charat(text;b);
    if(c>=128 && c<192){}el{
      if(seen==charoff){
        at=b;
        done=true
      }el{
        seen=seen+1
      }
    }
  };
  <at
};

f=unplacedentity():$piientity{
  <$piientity{entitytype:"";value:"";start:0 as u32;end:0 as u32;confidence:0.0;placeholder:""}
};

(* F3b.7. The type a span is given: the eight sidecar labels in loke's taxonomy, or, for a
   registered model (raw), the model's own label as it reported it, which
   core.privacy.modelregistry maps through the registration's label mapping. *)
f=typeof(kind:str;aslabel:bool):str{
  if(aslabel){ <kind }el{};
  <lokeentitytype(kind)
};

f=placedentity(kind:str;value:str;start:i64;conf:f64;aslabel:bool):$piientity{
  <$piientity{
    entitytype:typeof(kind;aslabel);
    value:value;
    start:start as u32;
    end:(start+(str.len(value) as i64)) as u32;
    confidence:conf;
    placeholder:""
  }
};

(* Where the span is in loke's text. The sidecar reports offsets AND a value, and the two
   can disagree: its value is the classifier's decoded tokens, stripped, which need not be
   the exact characters at the offsets. Anonymisation substitutes by value, so the value
   used must be text that is actually there:

     the text at the offsets, when it is the reported value (the ordinary case);
     else the reported value, when it occurs in the text;
     else the text at the offsets, since the offsets index loke's own text;
     else nothing can be placed, and value is "". *)
f=toentity(text:str;e:$json;aslabel:bool):$piientity{
  let kind=mt json.str(e;"type") { $ok:s s; $err:x "" };
  let rawvalue=mt json.str(e;"value") { $ok:s s; $err:x "" };
  let reported=str.trim(rawvalue);
  let cstart=mt json.i64(e;"start") { $ok:n n; $err:x 0-1 };
  let cend=mt json.i64(e;"end") { $ok:n n; $err:x 0-1 };
  let conf=mt json.f64(e;"confidence") { $ok:c c; $err:x 0.0 };
  let n=str.len(text) as i64;
  let slice=mut."";
  let sstart=mut.(0-1);
  if(cstart>=0 && cend>cstart){
    let bs=cpbyte(text;cstart);
    let be=cpbyte(text;cend);
    if(be>bs && be<=n){
      let raw=t.strslice(text;bs;be);
      slice=str.trim(raw);
      sstart=bs+str.indexof(raw;slice)
    }el{}
  }el{};
  if(str.len(slice)>0 && (str.len(reported)==0 || str.eq(slice;reported))){ <placedentity(kind;slice;sstart;conf;aslabel) }el{};
  let at=str.indexof(text;reported);
  if(str.len(reported)>0 && at>=0){ <placedentity(kind;reported;at;conf;aslabel) }el{};
  if(str.len(slice)>0){ <placedentity(kind;slice;sstart;conf;aslabel) }el{};
  <unplacedentity()
};

f=failedentities(scan:$pfscan):$pfentities{
  <$pfentities{ok:false;hits:@();unplaced:0;applied:scan.applied;suppressed:scan.suppressed}
};

f=entitiesof(scan:$pfscan;obj:$json;text:str;aslabel:bool):$pfentities{
  let ents=mt json.arr(obj;"entities") { $ok:a a; $err:e @() };
  if((ents.len as i64)<scan.count){ <failedentities(scan) }el{};
  let hits=mut.@($piientity);
  let unplaced=mut.0;
  lp(let i=0;i<ents.len;i=i+1){
    let ent=toentity(text;ents.get(i);aslabel);
    if(str.len(ent.value)>0){ hits=hits.push(ent) }el{ unplaced=unplaced+1 }
  };
  <$pfentities{ok:true;hits:hits;unplaced:unplaced;applied:scan.applied;suppressed:scan.suppressed}
};

(* One /detect, read as detection-layer output. The text goes in clear, so post (above)
   refuses any host that is not loopback. *)
f=scanas(client:$pfclient;text:str;aslabel:bool):$pfentities{
  let scan=detect(client;text);
  if(!scan.ok){ <failedentities(scan) }el{};
  <mt json.dec(scan.body) {
    $ok:obj entitiesof(scan;obj;text;aslabel);
    $jsonerr:e failedentities(scan)
  }
};

f=scanentities(client:$pfclient;text:str):$pfentities{
  <scanas(client;text;false)
};

(* F3b.7. The same /detect, each span keeping the label the model reported, for
   core.privacy.modelregistry to map through a registration's label mapping. *)
f=scanlabels(client:$pfclient;text:str):$pfentities{
  <scanas(client;text;true)
};

f=listmodels(client:$pfclient):str{
  <reach.localget(client.baseurl;"/models")
};

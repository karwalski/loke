m=core.privacy.pipelinetypes;

(* F3b.3 appended $privacyfilterscan LAST, not beside the other detection stages: `mt` binds
   its arms by position (T-31), so a variant inserted in the middle would shift every match
   written against the old order. F3b.7 appended $modelscan after it for the same reason: a
   registered model's stage, whose $stageresult names the model's layer id. *)
t=$pipelinestage{
  $regexscan:i64;
  $nerscan:i64;
  $presidioscan:i64;
  $dedup:i64;
  $anonymise:i64;
  $guardianinject:i64;
  $privacyfilterscan:i64;
  $modelscan:i64
};

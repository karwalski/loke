m=core.privacy.content;
i=str:std.string;

t=$pagecontent{
  url:str;
  title:str;
  text:str;
  linkcount:i32;
  formcount:i32;
  haslogin:bool;
  haspayment:bool;
};


f=extract(html:str;url:str):$pagecontent{
  
  let titleraw=str.between(html;"<title>";"</title>");
  let title=if(str.len(titleraw)>0){ str.strip(titleraw) }el{ "" };

  
  let noscript=str.replacere(html;"<script[^>]*>[\s\S]*?</script>";"";"gi");
  let nostyle=str.replacere(noscript;"<style[^>]*>[\s\S]*?</style>";"";"gi");

  
  let notags=str.replacere(nostyle;"<[^>]+>";" ";"g");
  let text=str.trimws(notags);

  
  let linkcount=str.countre(html;"<a[\s][^>]*href";"gi");

  
  let formcount=str.countre(html;"<form[\s>]";"gi");

  
  
  let haspw=str.containsre(html;"<input[^>]*type=[\"']?password[\"']?";"i");
  let lowertext=str.lower(text);
  let hassignin=str.contains(lowertext;"sign in");
  let hasloginphrase=str.contains(lowertext;"log in");
  let haslogin=if(haspw){ true }el{ if(hassignin){ true }el{ hasloginphrase } };

  
  let kwcard=str.contains(lowertext;"credit card");
  let kwpayment=str.contains(lowertext;"payment");
  let kwcheckout=str.contains(lowertext;"checkout");
  let kwbilling=str.contains(lowertext;"billing");
  let kwcvv=str.contains(lowertext;"cvv");
  let haspayment=if(kwcard){ true }el{
    if(kwpayment){ true }el{
      if(kwcheckout){ true }el{
        if(kwbilling){ true }el{ kwcvv }
      }
    }
  };

  <$pagecontent{
    url:url;
    title:title;
    text:text;
    linkcount:linkcount;
    formcount:formcount;
    haslogin:haslogin;
    haspayment:haspayment;
  }
};


f=privacyscore(content:$pagecontent):i32{
  let score=100;
  let score=if(content.haslogin){ score-20 }el{ score };
  let score=if(content.haspayment){ score-20 }el{ score };
  
  let formpenalty=(content.formcount/10)*5;
  let score=score-formpenalty;
  
  let score=if(score<0){ 0 }el{ score };
  let score=if(score>100){ 100 }el{ score };
  <score
};


f=summary(content:$pagecontent):str{
  
  let host=str.between(content.url;"://";"/"  );
  let host=if(str.len(host)>0){ host }el{ content.url };

  
  let words=str.split(content.text;" ");
  let wordcount=str.len(words);
  let wordstr=str.formatint(wordcount);

  
  let linkstr=str.formatint(content.linkcount);

  
  let out=str.concat(@(host;" — ";wordstr;" words, ";linkstr;" links"));

  
  let out=if(content.haslogin){ str.concat(@(out;" [login]")) }el{ out };
  let out=if(content.haspayment){ str.concat(@(out;" [payment]")) }el{ out };

  <out
};

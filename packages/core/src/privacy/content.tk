m=core.privacy.content;
i=str:std.str;
i=t:shared.types;

t=$pagecontent{
  url:str;
  title:str;
  text:str;
  linkcount:i32;
  formcount:i32;
  haslogin:bool;
  haspayment:bool
};

f=extract(html:str;url:str):$pagecontent{
  let titleraw=t.strbetween(html;"<title>";"</title>");
  let title=mut.""; if(str.len(titleraw)>0){title=str.strip(titleraw)}el{};

  let noscript=t.strstripregion(html;"<script";"</script>");
  let nostyle=t.strstripregion(noscript;"<style";"</style>");

  let notags=str.replacere(nostyle;"<[^>]+>";" ");
  let text=str.trimws(notags);

  let linkcount=str.countre(str.lower(html);"<a[ \\t\\n\\r][^>]*href");

  let formcount=str.countre(str.lower(html);"<form[ \\t\\n\\r>]");

  let haspw=str.containsre(str.lower(html);"<input[^>]*type=[\"']?password[\"']?");
  let lowertext=str.lower(text);
  let hassignin=str.contains(lowertext;"sign in");
  let hasloginphrase=str.contains(lowertext;"log in");
  let haslogin=mut.hasloginphrase; if(haspw){haslogin=true}el{if(hassignin){haslogin=true}el{}};

  let kwcard=str.contains(lowertext;"credit card");
  let kwpayment=str.contains(lowertext;"payment");
  let kwcheckout=str.contains(lowertext;"checkout");
  let kwbilling=str.contains(lowertext;"billing");
  let kwcvv=str.contains(lowertext;"cvv");
  let haspayment=mut.kwcvv; if(kwcard){haspayment=true}el{
    if(kwpayment){haspayment=true}el{
      if(kwcheckout){haspayment=true}el{
        if(kwbilling){haspayment=true}el{}
      }
    }
  };

  <$pagecontent{
    url:url;
    title:title;
    text:text;
    linkcount:linkcount;
    formcount:formcount;
    haslogin:haslogin;
    haspayment:haspayment
  }
};

f=privacyscore(content:$pagecontent):i32{
  let score=mut.100;
  if(content.haslogin){score=score-20}el{};
  if(content.haspayment){score=score-20}el{};
  score=score-((content.formcount/10)*5);
  if(score<0){score=0}el{};
  if(score>100){score=100}el{};
  <score
};

f=summary(content:$pagecontent):str{
  let host=mut.t.strbetween(content.url;"://";"/");
  if(str.len(host)>0){}el{host=content.url};

  let words=str.split(content.text;" ");
  let wordstr=str.fromint(words.len);

  let linkstr=str.fromint(content.linkcount);

  let out=mut.str.concat(host;str.concat(" -- ";str.concat(wordstr;str.concat(" words, ";str.concat(linkstr;" links")))));

  if(content.haslogin){out=str.concat(out;" [login]")}el{};
  if(content.haspayment){out=str.concat(out;" [payment]")}el{};

  <out
};

m=core.privacy.patterns;

f=patemail():str{
  <"[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}"
};

f=patphoneau():str{
  <"(?:0[2-9]\\d{8}|\\+61[2-9]\\d{8}|04\\d{8})"
};

f=patphoneus():str{
  <"(?:\\+1)?[2-9]\\d{2}[\\s.\\-]?[2-9]\\d{2}[\\s.\\-]?\\d{4}"
};

f=patcreditcard():str{
  <"(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|6(?:011|5[0-9]{2})[0-9]{12})"
};

f=patipv4():str{
  <"(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)"
};

f=patautfn():str{
  <"\\d{3}[\\s\\-]?\\d{3}[\\s\\-]?\\d{3}"
};

f=patauabn():str{
  <"\\d{2}[\\s]?\\d{3}[\\s]?\\d{3}[\\s]?\\d{3}"
};

f=patssnus():str{
  <"\\d{3}[\\-\\s]?\\d{2}[\\-\\s]?\\d{4}"
};

f=paturl():str{
  <"https?://[a-z0-9.\\-/_%?=&]+"
};

f=patapikey():str{
  <"(?:sk\\-[a-z0-9]{20,}|ghp_[a-z0-9]{36}|ya29\\.[a-z0-9_\\-]{40,})"
};

m=core.privacy.template;





i=t:shared.types;
i=str:std.str;
i=json:std.json;
i=log:shared.log;

t=$templateparam{
  name:str;
  required:bool;
  description:str;
  defaultval:str
};

t=$prompttemplate{
  id:str;
  version:str;
  name:str;
  description:str;
  systemprompt:str;
  usertemplate:str;
  params:@$templateparam
};

t=$renderresult{
  systemprompt:str;
  userprompt:str;
  paramsused:@str;
  missingparams:@str
};


f=builtintemplates():@$prompttemplate{
  <@(
    $prompttemplate{
      id:"data-analysis";
      version:"1.0.0";
      name:"Data Analysis";
      description:"Analyse a dataset schema and answer questions without touching raw data.";
      systemprompt:"You are a data analyst. Analyse the provided data schema and answer questions accurately. Never request raw data -- work only with the schema and statistics provided.";
      usertemplate:"Dataset: {{dataset_schema}}

Question: {{question}}";
      params:@(
        $templateparam{name:"dataset_schema";required:true;description:"JSON or textual schema of the dataset";defaultval:""};
        $templateparam{name:"question";required:true;description:"Question to answer about the dataset";defaultval:""}
      )
    };
    $prompttemplate{
      id:"code-review";
      version:"1.0.0";
      name:"Code Review";
      description:"Review code for quality, security, and correctness.";
      systemprompt:"You are an expert code reviewer. Review code for quality, security, and correctness. Be specific and actionable.";
      usertemplate:"Review this code:

{{code}}

Focus on: {{focus_areas}}";
      params:@(
        $templateparam{name:"code";required:true;description:"Source code to review";defaultval:""};
        $templateparam{name:"focus_areas";required:false;description:"Aspects to focus on during review";defaultval:"quality and security"}
      )
    };
    $prompttemplate{
      id:"summarise";
      version:"1.0.0";
      name:"Summarise";
      description:"Create clear, accurate summaries of provided content.";
      systemprompt:"You are a precise summariser. Create clear, accurate summaries.";
      usertemplate:"Summarise the following:

{{content}}

Format: {{format}}";
      params:@(
        $templateparam{name:"content";required:true;description:"Content to summarise";defaultval:""};
        $templateparam{name:"format";required:false;description:"Desired output format";defaultval:"bullet points"}
      )
    };
    $prompttemplate{
      id:"classify";
      version:"1.0.0";
      name:"Classify";
      description:"Classify text into one of the provided categories.";
      systemprompt:"You are a classification engine. Classify inputs into the provided categories. Reply with only the category name.";
      usertemplate:"Categories: {{categories}}

Text to classify: {{text}}";
      params:@(
        $templateparam{name:"categories";required:true;description:"Comma-separated list of valid categories";defaultval:""};
        $templateparam{name:"text";required:true;description:"Text to classify";defaultval:""}
      )
    };
    $prompttemplate{
      id:"agent-task";
      version:"1.0.0";
      name:"Agent Task";
      description:"Autonomous agent task with precise instructions and constraint tracking.";
      systemprompt:"You are an autonomous agent completing a specific task. Follow instructions precisely. Report what you did and any issues encountered.";
      usertemplate:"Task: {{task_description}}

Context: {{context}}

Constraints: {{constraints}}";
      params:@(
        $templateparam{name:"task_description";required:true;description:"Description of the task to complete";defaultval:""};
        $templateparam{name:"context";required:false;description:"Background context for the task";defaultval:"none provided"};
        $templateparam{name:"constraints";required:false;description:"Constraints or guardrails for the agent";defaultval:"none"}
      )
    }
  )
};


f=find(templates:@$prompttemplate;id:str):$prompttemplate!$lokeerr{
  let count=templates.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let tmpl=str.arrayget(templates;i);
      if(str.eq(tmpl.id;id)){
        <$ok(tmpl)
      }el{
        i=i+1;
      }
    }
  };
  <$err($validationerr(str.concat("template not found: ";id)))
};




f=renderuser(templatestr:str;paramsjson:str):str{
  let result=templatestr;
  let parsed=mt json.dec(paramsjson) {
    $ok:obj obj;
    $err:v result 
  };
  let keys=json.keys(parsed);
  let count=keys.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let key=str.arrayget(keys;i);
      let val=json.getstr(parsed;key);
      let tokenopen=str.concat("{{";key);
      let token=str.concat(tokenopen;"}}");
      result=str.replace(result;token;val);
      i=i+1;
    }
  };
  <result
};




f=render(template:$prompttemplate;paramsjson:str):$renderresult!$lokeerr{
  let parsed=mt json.dec(paramsjson) {
    $ok:obj obj;
    $err:v $err($validationerr("render: params_json is not valid JSON")) 
  };

  let paramsused=@();
  let missingparams=@();

  
  
  let resolvedsystem=template.systemprompt;
  let resolveduser=template.usertemplate;

  let count=template.params.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let param=str.arrayget(template.params;i);
      let tokenopen=str.concat("{{";param.name);
      let token=str.concat(tokenopen;"}}");

      
      let val=json.getstr(parsed;param.name);
      let keypresent=str.len(val)>0;

      if(keypresent){
        resolvedsystem=str.replace(resolvedsystem;token;val);
        resolveduser=str.replace(resolveduser;token;val);
        paramsused=@(paramsused;param.name)
      }el{
        if(param.required){
          
          
          missingparams=@(missingparams;param.name)
        }el{
          
          resolvedsystem=str.replace(resolvedsystem;token;param.defaultval);
          resolveduser=str.replace(resolveduser;token;param.defaultval);
          paramsused=@(paramsused;param.name)
        }
      };
      i=i+1;
    }
  };

  log.debug(str.concat("rendered template: ";template.id);"template";"engine");

  <$ok($renderresult{
    systemprompt:resolvedsystem;
    userprompt:resolveduser;
    paramsused:paramsused;
    missingparams:missingparams
  })
};



f=validate(template:$prompttemplate):@str{
  let errors=@();

  if(str.len(template.id)=0){
    errors=@(errors;"id must not be empty")
  }el{};

  if(str.len(template.usertemplate)=0){
    errors=@(errors;"user_template must not be empty")
  }el{};

  
  let count=template.params.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let param=str.arrayget(template.params;i);
      if(str.len(param.name)=0){
        errors=@(errors;"param at index has empty name")
      }el{};
      i=i+1;
    }
  };

  
  let placeholderopen="{{";
  if(str.contains(template.systemprompt;placeholderopen)){
    let openparts=str.split(template.systemprompt;"{{");
    let closeparts=str.split(template.systemprompt;"}}");
    let opencount=openparts.len;
    let closecount=closeparts.len;
    if(opencount>closecount){
      errors=@(errors;"system_prompt contains unclosed {{ placeholder")
    }el{}
  }el{};

  if(str.contains(template.usertemplate;placeholderopen)){
    let openparts=str.split(template.usertemplate;"{{");
    let closeparts=str.split(template.usertemplate;"}}");
    let opencount=openparts.len;
    let closecount=closeparts.len;
    if(opencount>closecount){
      errors=@(errors;"user_template contains unclosed {{ placeholder")
    }el{}
  }el{};

  <errors
};

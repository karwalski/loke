m=core.privacy.layerconfig;

i=str:std.str;

t=$layerentry{
  id:str;
  enabled:bool;
  priority:i32;
  mode:str;
  confidencethreshold:f64;
  entityfilter:str
};

t=$layerconfig{
  layers:@$layerentry;
  consensusstrategy:str
};

f=defaultconfig():$layerconfig{
  let layers=@(
    $layerentry{id:"regex";enabled:true;priority:1 as i32;mode:"detect-and-mask";confidencethreshold:0.8;entityfilter:""};
    $layerentry{id:"ner";enabled:true;priority:2 as i32;mode:"detect-and-mask";confidencethreshold:0.75;entityfilter:""};
    $layerentry{id:"presidio";enabled:false;priority:3 as i32;mode:"detect-only";confidencethreshold:0.7;entityfilter:""}
  );
  <$layerconfig{layers:layers;consensusstrategy:"most-restrictive"}
};

f=getlayer(cfg:$layerconfig;id:str):$layerentry{
  let result=mut.cfg.layers.get(0);
  lp(let i=0;i<cfg.layers.len;i=i+1){
    let l=cfg.layers.get(i);
    if(str.eq(l.id;id)){result=l}el{}
  };
  <result
};

f=enabledlayers(cfg:$layerconfig):@$layerentry{
  let result=mut.@();
  lp(let i=0;i<cfg.layers.len;i=i+1){
    let l=cfg.layers.get(i);
    if(l.enabled){result=@(result;l)}el{}
  };
  <result
};

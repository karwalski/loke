m=core.privacy.consensus;

i=str:std.str;

t=$layerdetection{
  entitytype:str;
  value:str;
  start:i64;
  end:i64;
  confidence:f64;
  layerid:str
};

t=$resolvedentity{
  entitytype:str;
  value:str;
  start:i64;
  end:i64;
  finalconfidence:f64;
  detectinglayers:str;
  action:str
};

f=resolveoverlaps(detections:@$layerdetection;strategy:str):@$resolvedentity{
  let results=mut.@();
  lp(let i=0;i<detections.len;i=i+1){
    let d=detections.get(i);
    let resolved=$resolvedentity{
      entitytype:d.entitytype;
      value:d.value;
      start:d.start;
      end:d.end;
      finalconfidence:d.confidence;
      detectinglayers:d.layerid;
      action:"mask"
    };
    results=@(results;resolved)
  };
  <results
};

f=strategyname(strategy:str):str{
  if(str.eq(strategy;"most-restrictive")){<"Most Restrictive (union of all detections)"}el{};
  if(str.eq(strategy;"first-match")){<"First Match (highest priority layer wins)"}el{};
  if(str.eq(strategy;"unanimous")){<"Unanimous (all layers must agree)"}el{};
  if(str.eq(strategy;"majority")){<"Majority (>50% of layers agree)"}el{};
  <"Unknown strategy"
};

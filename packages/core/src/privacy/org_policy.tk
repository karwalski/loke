m=core.privacy.orgpolicy;
i=str:std.str;
i=json:std.json;
i=file:std.file;

t=$orgprivacypolicy{
  minimumlayers:i64;
  requiredlayers:str;
  lockedconsensus:str;
  bannedlayers:str;
  maxconfidencethreshold:f64;
  enforced:bool
};

f=defaultpolicy():$orgprivacypolicy{
  <$orgprivacypolicy{
    minimumlayers:1;
    requiredlayers:"";
    lockedconsensus:"";
    bannedlayers:"";
    maxconfidencethreshold:1.0;
    enforced:false
  }
};

f=loadpolicy(path:str):$orgprivacypolicy{
  let content=mt file.read(path) {$ok:v v; $err:e ""};
  if(str.len(content)<5){
    <defaultpolicy()
  }el{
    let parsed=json.dec(content);
    let minlayers=json.str(parsed;"minimum_layers");
    let required=json.str(parsed;"required_layers");
    let locked=json.str(parsed;"locked_consensus");
    let banned=json.str(parsed;"banned_layers");
    let enforced=str.contains(content;"enforced");
    let ml=mut.1;
    if(str.len(minlayers)>0){ml=2}el{};
    <$orgprivacypolicy{
      minimumlayers:ml;
      requiredlayers:required;
      lockedconsensus:locked;
      bannedlayers:banned;
      maxconfidencethreshold:1.0;
      enforced:enforced
    }
  }
};

f=validate(policy:$orgprivacypolicy;activelayers:i64;consensus:str):str{
  let violations=mut."";
  if(activelayers<policy.minimumlayers){
    violations=str.concat(violations;"VIOLATION: fewer than minimum required layers active. ")
  }el{};
  if(str.len(policy.lockedconsensus)>0){
    if(!str.eq(consensus;policy.lockedconsensus)){
      violations=str.concat(violations;"VIOLATION: consensus strategy does not match org policy. ")
    }el{}
  }el{};
  <violations
};

f=isenforced(policy:$orgprivacypolicy):bool{
  <policy.enforced
};

f=formatpolicy(policy:$orgprivacypolicy):str{
  <str.concat("Org Policy: min_layers=";str.concat(str.fromint(policy.minimumlayers);str.concat(" required=";str.concat(policy.requiredlayers;str.concat(" consensus=";str.concat(policy.lockedconsensus;str.concat(" enforced=";str.concat(str.fromint(policy.enforced as i64);""))))))))
};

m=core.privacy.entityrouting;
i=str:std.str;

t=$entityroute{
  entitytype:str;
  preferredlayers:str;
  fallbacklayers:str
};

t=$routingconfig{
  routes:@$entityroute;
  count:i64
};

f=defaultrouting():$routingconfig{
  let routes=@(
    $entityroute{entitytype:"email";preferredlayers:"regex";fallbacklayers:"ner,presidio"};
    $entityroute{entitytype:"phone";preferredlayers:"regex";fallbacklayers:"presidio"};
    $entityroute{entitytype:"person";preferredlayers:"ner";fallbacklayers:"presidio"};
    $entityroute{entitytype:"creditcard";preferredlayers:"regex";fallbacklayers:"presidio"};
    $entityroute{entitytype:"address";preferredlayers:"presidio";fallbacklayers:"ner"}
  );
  <$routingconfig{routes:routes;count:5}
};

f=getroute(cfg:$routingconfig;entitytype:str):$entityroute{
  let result=mut.$entityroute{entitytype:entitytype;preferredlayers:"";fallbacklayers:""};
  lp(let i=0;i<cfg.count;i=i+1){
    let r=cfg.routes.get(i);
    if(str.eq(r.entitytype;entitytype)){result=r}el{}
  };
  <result
};

f=hasroute(cfg:$routingconfig;entitytype:str):bool{
  let found=mut.false;
  lp(let i=0;i<cfg.count;i=i+1){
    let r=cfg.routes.get(i);
    if(str.eq(r.entitytype;entitytype)){found=true}el{}
  };
  <found
};

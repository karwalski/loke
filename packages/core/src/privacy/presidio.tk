m=core.privacy.presidio;




i=reach:shared.reachability;
i=jx:shared.jsonobj;
i=json:std.json;
i=str:std.str;
i=t:shared.types;

t=$presidioentity{
  entitytype:str;
  start:u32;
  end:u32;
  score:f64
};

t=$presidioclient{
  baseurl:str
};


(* VM1.6e. What the pipeline reads: ok is true only when Presidio answered /analyze with
   the top-level array it documents, and presidiohits is then what it found.

   A plain struct, not a result, because the pipeline sits in another module and toke's
   `mt` on a result whose error side is a user sum takes the FIRST arm whatever the value
   is (T-18). Measured 2026-09-27: with /analyze unreached, analyze returned $err, the
   pipeline's `$ok` arm ran, and the run counted Presidio as a COMPLETED layer with zero
   entities. A layer that did not scan was reported as having scanned, which is the
   fail-open NC1.9 forbids. *)
t=$presidioscan{
  ok:bool;
  presidiohits:@$presidioentity
};

(* MK6.16. What the pipeline takes from one Presidio scan (place, below): the entities
   placed in loke's text, and how many of Presidio's spans could not be placed there
   exactly. *)
t=$presidioplaced{
  hits:@$piientity;
  unplaced:i64
};

f=new(baseurl:str):$presidioclient{
  <$presidioclient{baseurl:baseurl}
};


f=isavailable(client:$presidioclient):bool{
  (* The port is probed before the HTTP call, and the HTTP result is NOT trusted to
     report unreachability.

     http.get against a closed port returns $ok carrying a nil response, so the $err
     arm never runs: this function returned TRUE for a sidecar that was not running,
     the pipeline then called the layer, and the nil dereference took the process
     down. That is the fail-open NC1.9 exists to close, one level below where NC1.9
     was looking. See docs/upstream/toke-issues.md T-15.

     VM1.6e. The GET that followed the probe was `http.get(http.client(url);"/health")`,
     and toke compiles a TWO-argument http.get as server ROUTE REGISTRATION (T-57). It
     sent nothing. Measured 2026-09-27 against scripts/lib/http_recorder.py: this
     answered false for a Presidio that was answering, so the pipeline skipped the layer
     as unreachable on every request. And after 256 calls in one process the route table
     filled, registration returned -1, the match read that as $ok, and this answered
     TRUE with no request made. shared.reachability.localget is a real GET. *)
  <reach.isloopbackurl(client.baseurl) && reach.localanswers(client.baseurl;"/health")
};

(* PL1.8. `score` was read with json.i64. strtoll stops at the decimal point, so 0.92
   read as 0 and 1.0 as 1 -- and an i64 1 stored in an f64 field is a denormal, not 1.0.
   Every Presidio score arrived as zero. json.f64 reports $jsonerr for a missing field
   AND for a literal 0 (T-33), and both of those mean a score of zero, so one fallback
   is exact rather than lossy. *)
f=parseentityitem(item:$jsonval):$presidioentity{
  let entitytype=json.str(item;"entity_type");
  let start=json.i64(item;"start");
  let end=json.i64(item;"end");
  let score:f64=mt json.f64(item;"score") {
    $ok:v v;
    $jsonerr:e 0.0
  };
  <$presidioentity{
    entitytype:entitytype;
    start:start;
    end:end;
    score:score
  }
};

(* PL1.11. /analyze answers with a TOP-LEVEL array. This used to call
   `json.getarr(arr;"")`, which looks up the key "" in an OBJECT: std.json's key scan
   returns not-found for anything that does not start with `{`, getarr then returns a
   null array handle, and `items.len` on that handle read address -8. So every non-error
   Presidio response either crashed the process or, through a null-tolerant length, parsed
   to nothing. jx.arrayof reads the top-level array through the typed json.dec and json.arr
   (LS1.1w; it was json.parsearray, one of std.json's untyped ABI helpers), and answers none
   for `[]` or for a body that is not an array. *)
f=parseentities(raw:str):@$presidioentity{
  let items=jx.arrayof(raw);
  let entities=mut.@();
  lp(let ii=0;ii<items.len;ii=ii+1){
    entities=entities.push(parseentityitem(items.get(ii)))
  };
  <entities
};

f=analyzeparse(raw:str):@$presidioentity!$lokeerr{
  let parsed=json.dec(raw);
  <mt parsed {
    $ok:arr parseentities(raw);
    $jsonerr:e $err($privacyerr("presidio analyze: failed to parse JSON response"))
  }
};

f=scanfailed():$presidioscan{
  <$presidioscan{ok:false;presidiohits:@()}
};

f=analyzebody(text:str):str{
  <str.concat("{\"text\":";str.concat(jx.escape(text);",\"language\":\"en\"}"))
};

(* The request used to be `http.postheaders(http.client(url);"/analyze";...)`, measured to
   send nothing (T-48), with the prompt spliced into the JSON unescaped, so a quote or a
   newline in it made the body invalid. localpost uses http.posturl, which arrives, and the
   text is escaped by shared.jsonobj. *)
f=scan(client:$presidioclient;text:str):$presidioscan{
  (* The prompt goes IN CLEAR, so only to a loopback host; see core.privacy.ner.scan. *)
  if(!reach.isloopbackurl(client.baseurl)){ <scanfailed() }el{};
  let raw=reach.localpost(client.baseurl;"/analyze";analyzebody(text));
  let trimmed=str.trim(raw);
  (* Anything but an array is not a scan: an error object, an HTML error page or
     nothing at all. json.dec cannot be trusted to say so (T-51). *)
  if(!str.startswith(trimmed;"[")){ <scanfailed() }el{};
  <$presidioscan{ok:true;presidiohits:parseentities(trimmed)}
};

(* Kept for callers that match the result. New callers, and the pipeline, use scan. *)
f=analyze(client:$presidioclient;text:str):@$presidioentity!$lokeerr{
  let r=scan(client;text);
  if(r.ok){ <$ok(r.presidiohits) }el{};
  <$err($networkerr("presidio analyze: no usable answer from /analyze"))
};


f=mapsensitivity(entitytype:str):$sensitivitylevel{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.eq(entitytype;"US_SSN")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.eq(entitytype;"AU_TFN")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.eq(entitytype;"PERSON")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.eq(entitytype;"EMAIL_ADDRESS")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.eq(entitytype;"PHONE_NUMBER")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.eq(entitytype;"LOCATION")){
    <$sensitivitylevel{$internal:0}
  }el if(str.eq(entitytype;"ORGANIZATION")){
    <$sensitivitylevel{$internal:0}
  }el{
    <$sensitivitylevel{$internal:0}
  }
};

f=mapconfidence(entitytype:str):f64{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <0.99
  }el if(str.eq(entitytype;"US_SSN")){
    <0.99
  }el if(str.eq(entitytype;"AU_TFN")){
    <0.99
  }el if(str.eq(entitytype;"PERSON")){
    <0.92
  }el if(str.eq(entitytype;"EMAIL_ADDRESS")){
    <0.92
  }el if(str.eq(entitytype;"PHONE_NUMBER")){
    <0.92
  }el if(str.eq(entitytype;"LOCATION")){
    <0.75
  }el if(str.eq(entitytype;"ORGANIZATION")){
    <0.75
  }el{
    <0.70
  }
};


(* MK6.16. The length of the UTF-8 sequence that byte c leads, or 0 when c cannot lead one:
   a continuation byte, an overlong lead (0xC0, 0xC1) or one past U+10FFFF (0xF5 up). *)
f=seqlen(c:i64):i64{
  if(c<128){ <1 }el{};
  if(c>=194 && c<=223){ <2 }el{};
  if(c>=224 && c<=239){ <3 }el{};
  if(c>=240 && c<=244){ <4 }el{};
  <0
};

f=continuation(text:str;at:i64;n:i64;lo:i64;hi:i64):bool{
  if(at>=n){ <false }el{};
  let c=str.charat(text;at);
  <c>=lo && c<=hi
};

(* MK6.16. Whether text is well-formed UTF-8 as Python's strict decoder requires: no
   overlong form, no surrogate, nothing past U+10FFFF, no truncated sequence. Presidio counts
   the code points of the text Python decoded, and for anything else that count is not
   defined, so no span of such a text is placed. *)
f=utf8valid(text:str):bool{
  let n=str.len(text) as i64;
  let ok=mut.true;
  let b=mut.0;
  lp(let k=0;b<n && ok;k=k+1){
    let c=str.charat(text;b);
    let l=seqlen(c);
    if(l==0){
      ok=false
    }el{
      let lo=mut.128;
      let hi=mut.191;
      if(c==224){ lo=160 }el{};
      if(c==237){ hi=159 }el{};
      if(c==240){ lo=144 }el{};
      if(c==244){ hi=143 }el{};
      if(l>=2 && !continuation(text;b+1;n;lo;hi)){ ok=false }el{};
      if(l>=3 && !continuation(text;b+2;n;128;191)){ ok=false }el{};
      if(l==4 && !continuation(text;b+3;n;128;191)){ ok=false }el{};
      b=b+l
    }
  };
  <ok
};

(* How many code points text holds: every byte that is not a continuation byte. *)
f=cpcount(text:str):i64{
  let n=str.len(text) as i64;
  let count=mut.0;
  lp(let b=0;b<n;b=b+1){
    let c=str.charat(text;b);
    if(c>=128 && c<192){}el{ count=count+1 }
  };
  <count
};

(* The byte offset at which code point number charoff begins, and the byte length for the
   offset one past the last code point. The same walk as core.privacy.sidecarclient.cpbyte
   and core.privacy.evaluation.bytestart, neither of which this module imports. *)
f=cpbyte(text:str;charoff:i64):i64{
  let n=str.len(text) as i64;
  let seen=mut.0;
  let at=mut.n;
  let done=mut.false;
  lp(let b=0;b<n && !done;b=b+1){
    let c=str.charat(text;b);
    if(c>=128 && c<192){}el if(seen==charoff){
      at=b;
      done=true
    }el{
      seen=seen+1
    }
  };
  <at
};

f=placedentity(pe:$presidioentity;value:str;bs:i64;be:i64):$piientity{
  <$piientity{
    entitytype:pe.entitytype;
    value:value;
    start:bs as u32;
    end:be as u32;
    confidence:mapconfidence(pe.entitytype);
    placeholder:""
  }
};

(* Detection only — .placeholder is left empty on purpose.

   PL1.1: this used to call ph.makeplaceholder with its OWN `entities.len+1`, so it
   handed out `_1` for the first entity of every type it found while the regex layer was
   independently handing out `_1` from its own counter, and pipeline.run concatenated
   both lists. It also never called ph.addentry, so nothing it generated was recorded
   and nothing it generated could be restored — the placeholder went into the prompt and
   the original was dropped on the floor. placeholder.assignplaceholders numbers the
   deduped list in one place, and placeholder.mapfromentities records all of it.

   MK6.16. Presidio's start and end are offsets into the Python str it analysed, and a
   Python str is indexed by Unicode code point: presidio-analyzer's RecognizerResult takes
   them from `re` match spans and spaCy's character offsets, both code-point indices. loke's
   strings are UTF-8 bytes, and this took the value as `str.slice(text;start;end)`, a BYTE
   slice. After any non-ASCII character the slice moved left by one byte per extra byte:
   with the recorder modelling Presidio, "café Jane Citizen called" gave the value
   " Jane Citize", placeholder.applytotext replaced that, and "café[PERSON_..._1]n called"
   went to the model with the name's last letter in the clear. The offsets are now converted
   to bytes by walking the UTF-8 lead bytes, and the start and end recorded are those bytes,
   the unit the regex layer and dedup use.

   Presidio's /analyze answer carries no text for a span, so there is no reported value to
   check the slice against. A span is placed only when it can be placed exactly: the text is
   well-formed UTF-8 (so the code-point count is the one Python saw), start < end <= the
   number of code points, and the slice holds more than whitespace. Anything else is counted
   unplaced, and an unplaced span refuses the run (core.privacy.pipeline.issafetoforward):
   Presidio said there is an entity and loke cannot tell which characters it is, so it
   cannot mask it. *)
f=place(presidioresults:@$presidioentity;text:str):$presidioplaced{
  let hits=mut.@($piientity);
  let unplaced=mut.0;
  let valid=utf8valid(text);
  let ncp=cpcount(text);
  lp(let i=0;i<presidioresults.len;i=i+1){
    let pe:$presidioentity=presidioresults.get(i);
    let cs=pe.start as i64;
    let ce=pe.end as i64;
    if(valid && ce>cs && ce<=ncp){
      let bs=cpbyte(text;cs);
      let be=cpbyte(text;ce);
      let value=t.strslice(text;bs;be);
      if(str.len(str.trim(value))>0){ hits=hits.push(placedentity(pe;value;bs;be)) }el{ unplaced=unplaced+1 }
    }el{
      unplaced=unplaced+1
    }
  };
  <$presidioplaced{hits:hits;unplaced:unplaced}
};

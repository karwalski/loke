m=core.privacy.presidio;




i=http:std.http;
i=reach:shared.reachability;
i=json:std.json;
i=str:std.str;
i=t:shared.types;

t=$presidioentity{
  entitytype:str;
  start:u32;
  end:u32;
  score:f64
};

t=$presidioclient{
  baseurl:str
};


f=new(baseurl:str):$presidioclient{
  <$presidioclient{baseurl:baseurl}
};


f=isavailable(client:$presidioclient):bool{
  (* The port is probed before the HTTP call, and the HTTP result is NOT trusted to
     report unreachability.

     http.get against a closed port returns $ok carrying a nil response, so the $err
     arm never runs: this function returned TRUE for a sidecar that was not running,
     the pipeline then called the layer, and the nil dereference took the process
     down. That is the fail-open NC1.9 exists to close, one level below where NC1.9
     was looking. See docs/upstream/toke-issues.md T-15.

     reach.localserviceup binds the port to find out, which is honest for a local
     sidecar and is all these two are. *)
  if(reach.localserviceup(client.baseurl)){}el{
    <false
  };
  let hc=http.client(client.baseurl);
  <mt http.get(hc;"/health") {
    $err:e false;
    $ok:body true
  }
};



f=parseentityitem(item:i64):$presidioentity{
  let entitytype=json.str(item;"entity_type");
  let start=json.i64(item;"start");
  let end=json.i64(item;"end");
  let score=json.i64(item;"score");
  <$presidioentity{
    entitytype:entitytype;
    start:start;
    end:end;
    score:score
  }
};

f=parseentities(arr:i64):@$presidioentity{
  let items=json.getarr(arr;"");
  let entities=mut.@();
  lp(let ii=0;ii<items.len;ii=ii+1){
    entities=entities.push(parseentityitem(items.get(ii)))
  };
  <entities
};

f=analyzeparse(raw:str):@$presidioentity!$lokeerr{
  let parsed=json.dec(raw);
  <mt parsed {
    $jsonerr:e $err($privacyerr("presidio analyze: failed to parse JSON response"));
    $ok:arr parseentities(arr)
  }
};

f=analyze(client:$presidioclient;text:str):@$presidioentity!$lokeerr{
  let hc=http.client(client.baseurl);
  let body=str.concat("{\"text\":\"";str.concat(text;"\",\"language\":\"en\"}"));
  let result=http.postheaders(hc;"/analyze";str.tobytes(body);"{\"content-type\":\"application/json\"}");
  <mt result {
    $httperr:e $err($networkerr("presidio analyze: failed to reach /analyze"));
    $ok:raw analyzeparse(raw)
  }
};


f=mapsensitivity(entitytype:str):$sensitivitylevel{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <$sensitivitylevel{$restricted:0}
  }el{
    if(str.eq(entitytype;"US_SSN")){
      <$sensitivitylevel{$restricted:0}
    }el{
      if(str.eq(entitytype;"AU_TFN")){
        <$sensitivitylevel{$restricted:0}
      }el{
        if(str.eq(entitytype;"PERSON")){
          <$sensitivitylevel{$confidential:0}
        }el{
          if(str.eq(entitytype;"EMAIL_ADDRESS")){
            <$sensitivitylevel{$confidential:0}
          }el{
            if(str.eq(entitytype;"PHONE_NUMBER")){
              <$sensitivitylevel{$confidential:0}
            }el{
              if(str.eq(entitytype;"LOCATION")){
                <$sensitivitylevel{$internal:0}
              }el{
                if(str.eq(entitytype;"ORGANIZATION")){
                  <$sensitivitylevel{$internal:0}
                }el{
                  <$sensitivitylevel{$internal:0}
                }
              }
            }
          }
        }
      }
    }
  }
};

f=mapconfidence(entitytype:str):f64{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <0.99
  }el{
    if(str.eq(entitytype;"US_SSN")){
      <0.99
    }el{
      if(str.eq(entitytype;"AU_TFN")){
        <0.99
      }el{
        if(str.eq(entitytype;"PERSON")){
          <0.92
        }el{
          if(str.eq(entitytype;"EMAIL_ADDRESS")){
            <0.92
          }el{
            if(str.eq(entitytype;"PHONE_NUMBER")){
              <0.92
            }el{
              if(str.eq(entitytype;"LOCATION")){
                <0.75
              }el{
                if(str.eq(entitytype;"ORGANIZATION")){
                  <0.75
                }el{
                  <0.70
                }
              }
            }
          }
        }
      }
    }
  }
};



(* Detection only — .placeholder is left empty on purpose.

   PL1.1: this used to call ph.makeplaceholder with its OWN `entities.len+1`, so it
   handed out `_1` for the first entity of every type it found while the regex layer was
   independently handing out `_1` from its own counter, and pipeline.run concatenated
   both lists. It also never called ph.addentry, so nothing it generated was recorded
   and nothing it generated could be restored — the placeholder went into the prompt and
   the original was dropped on the floor. placeholder.assignplaceholders numbers the
   deduped list in one place, and placeholder.mapfromentities records all of it. *)
f=topiientities(presidioresults:@$presidioentity;text:str):@$piientity{
  let entities=mut.@();
  let count=presidioresults.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let pe=presidioresults.get(i);
      let value=str.slice(text;pe.start;pe.end);
      let sensitivity=mapsensitivity(pe.entitytype);
      let confidence=mapconfidence(pe.entitytype);
      let entity=$piientity{
        entitytype:pe.entitytype;
        value:value;
        start:pe.start;
        end:pe.end;
        confidence:confidence;
        placeholder:""
      };
      entities=entities.push(entity);
      i=i+1;
    }
  };
  <entities
};

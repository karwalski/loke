m=core.privacy.presidio;




i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=ph:core.privacy.placeholder;

t=$presidioentity{
  entitytype:str;
  start:u32;
  end:u32;
  score:f64
};

t=$presidioclient{
  baseurl:str
};


f=new(baseurl:str):$presidioclient{
  <$presidioclient{baseurl:baseurl}
};


f=isavailable(client:$presidioclient):bool{
  let url=str.concat(client.baseurl;"/health");
  let result=http.gettimeout(url;2000);
  mt result {
    $httperr:e false;
    $ok:body true
  }
};


f=parseentityitem(item:i64):$presidioentity{
  let entitytype=json.str(item;"entity_type");
  let start=json.i64(item;"start");
  let end=json.i64(item;"end");
  let score=json.i64(item;"score");
  <$presidioentity{
    entitytype:entitytype;
    start:start;
    end:end;
    score:score
  }
};

f=parseentities(arr:i64):@$presidioentity{
  let items=json.getarr(arr;"");
  let entities=mut.@();
  lp(let ii=0;ii<items.len;ii=ii+1){
    let item=items.get(ii);
    entities=entities.push(parseentityitem(item))
  };
  <entities
};

f=analyzeparse(raw:str):@$presidioentity!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $err($privacyerr("presidio analyze: failed to parse JSON response"));
    $ok:arr parseentities(arr)
  }
};

f=analyze(client:$presidioclient;text:str):@$presidioentity!$lokeerr{
  let url=str.concat(client.baseurl;"/analyze");
  let body=str.concat("{\"text\":\"";str.concat(text;"\",\"language\":\"en\"}"));
  let result=http.post(url;body;"application/json");
  mt result {
    $httperr:e $err($networkerr("presidio analyze: failed to reach /analyze"));
    $ok:raw analyzeparse(raw)
  }
};


f=mapsensitivity(entitytype:str):$sensitivitylevel{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <$restricted
  }el{
    if(str.eq(entitytype;"US_SSN")){
      <$restricted
    }el{
      if(str.eq(entitytype;"AU_TFN")){
        <$restricted
      }el{
        if(str.eq(entitytype;"PERSON")){
          <$confidential
        }el{
          if(str.eq(entitytype;"EMAIL_ADDRESS")){
            <$confidential
          }el{
            if(str.eq(entitytype;"PHONE_NUMBER")){
              <$confidential
            }el{
              if(str.eq(entitytype;"LOCATION")){
                <$internal
              }el{
                if(str.eq(entitytype;"ORGANIZATION")){
                  <$internal
                }el{
                  <$internal
                }
              }
            }
          }
        }
      }
    }
  }
};

f=mapconfidence(entitytype:str):f64{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <0.99
  }el{
    if(str.eq(entitytype;"US_SSN")){
      <0.99
    }el{
      if(str.eq(entitytype;"AU_TFN")){
        <0.99
      }el{
        if(str.eq(entitytype;"PERSON")){
          <0.92
        }el{
          if(str.eq(entitytype;"EMAIL_ADDRESS")){
            <0.92
          }el{
            if(str.eq(entitytype;"PHONE_NUMBER")){
              <0.92
            }el{
              if(str.eq(entitytype;"LOCATION")){
                <0.75
              }el{
                if(str.eq(entitytype;"ORGANIZATION")){
                  <0.75
                }el{
                  <0.70
                }
              }
            }
          }
        }
      }
    }
  }
};



f=topiientities(presidioresults:@$presidioentity;text:str):@$piientity{
  let entities=mut.@();
  let count=presidioresults.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let pe=str.arrayget(presidioresults;i);
      let value=str.slice(text;pe.start;pe.end);
      let index=str.arraylen(entities)+1;
      let placeholder=ph.makeplaceholder(pe.entitytype;index);
      let sensitivity=mapsensitivity(pe.entitytype);
      let confidence=mapconfidence(pe.entitytype);
      let entity=$piientity{
        entitytype:pe.entitytype;
        value:value;
        start:pe.start;
        end:pe.end;
        confidence:confidence;
        placeholder:placeholder
      };
      entities=@(entities;entity);
      i=i+1;
    }
  };
  <entities
};

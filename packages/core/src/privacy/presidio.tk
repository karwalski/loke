m=core.privacy.presidio;




i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=ph:core.privacy.placeholder;

t=$presidioentity{
  entitytype:str;
  start:u32;
  end:u32;
  score:f64
};

t=$presidioclient{
  baseurl:str
};


f=new(baseurl:str):$presidioclient{
  <$presidioclient{baseurl:baseurl}
};


f=isavailable(client:$presidioclient):bool{
  let url=str.concat(client.baseurl;"/health");
  let result=http.gettimeout(url;2000);
  mt result {
    $httperr:e;
      <false
    body;
      <true
  }
};


f=analyze(client:$presidioclient;text:str):@$presidioentity|$lokeerr{
  let url=str.concat(client.baseurl;"/analyze");
  let body=json.enc({text:text;language:"en"});
  let result=http.post(url;body;"application/json");
  mt result {
    $httperr:e;
      <$$networkerr("presidio analyze: failed to reach /analyze")
    raw;
      let parsed=json.dec(raw);
      mt parsed {
        $jsonerr:e;
          <$$privacyerr("presidio analyze: failed to parse JSON response")
        arr;
          let entities=@();
          let items=json.getarr(arr;"");
          mt items {
            item;
              let entitytype=json.getstr(item;"entity_type");
              let start=json.getint(item;"start");
              let end=json.getint(item;"end");
              let score=json.getint(item;"score");
              let e=$presidioentity{
                entitytype:entitytype;
                start:start;
                end:end;
                score:score
              };
              entities=@(entities;e)
          };
          <entities
      }
  }
};


f=mapsensitivity(entitytype:str):$sensitivitylevel{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <$restricted
  }el{
    if(str.eq(entitytype;"US_SSN")){
      <$restricted
    }el{
      if(str.eq(entitytype;"AU_TFN")){
        <$restricted
      }el{
        if(str.eq(entitytype;"PERSON")){
          <$confidential
        }el{
          if(str.eq(entitytype;"EMAIL_ADDRESS")){
            <$confidential
          }el{
            if(str.eq(entitytype;"PHONE_NUMBER")){
              <$confidential
            }el{
              if(str.eq(entitytype;"LOCATION")){
                <$internal
              }el{
                if(str.eq(entitytype;"ORGANIZATION")){
                  <$internal
                }el{
                  <$internal
                }
              }
            }
          }
        }
      }
    }
  }
};

f=mapconfidence(entitytype:str):f64{
  if(str.eq(entitytype;"CREDIT_CARD")){
    <0.99
  }el{
    if(str.eq(entitytype;"US_SSN")){
      <0.99
    }el{
      if(str.eq(entitytype;"AU_TFN")){
        <0.99
      }el{
        if(str.eq(entitytype;"PERSON")){
          <0.92
        }el{
          if(str.eq(entitytype;"EMAIL_ADDRESS")){
            <0.92
          }el{
            if(str.eq(entitytype;"PHONE_NUMBER")){
              <0.92
            }el{
              if(str.eq(entitytype;"LOCATION")){
                <0.75
              }el{
                if(str.eq(entitytype;"ORGANIZATION")){
                  <0.75
                }el{
                  <0.70
                }
              }
            }
          }
        }
      }
    }
  }
};



f=topiientities(presidioresults:@$presidioentity;text:str):@$piientity{
  let entities=@();
  let count=presidioresults.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let pe=str.arrayget(presidioresults;i);
      let value=str.slice(text;pe.start;pe.end);
      let index=str.arraylen(entities)+1;
      let placeholder=ph.makeplaceholder(pe.entitytype;index);
      let sensitivity=mapsensitivity(pe.entitytype);
      let confidence=mapconfidence(pe.entitytype);
      let entity=t.$piientity{
        entitytype:pe.entitytype;
        value:value;
        start:pe.start;
        end:pe.end;
        confidence:confidence;
        placeholder:placeholder
      };
      entities=@(entities;entity);
      i=i+1;
    }
  };
  <entities
};

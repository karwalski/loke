m=core.storage.backup;





i=db:std.db;
i=file:std.file;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=s:core.storage.db;

t=$restoreresult{
  ok:bool;
  message:str
};

t=$backupinfo{
  filename:str;
  path:str;
  sizebytes:u32;
  createdat:str
};



(* Declared i64!$lokeerr, not void!$lokeerr, and returns $ok(0).

   toke lowers a `void!$err` success type to LLVM `void`, so any call site that binds
   the result — a match arm, for instance — emits `alloca void` and clang rejects the
   module with "void type only allowed for function results". Filed as T-5 in
   docs/upstream/toke-issues.md, same family as T-1 ($ok(<bool>)): only an i64-width
   success type survives the `!$err` lowering today. *)
f=createbackup(store:i64;backupdir:str):$backupinfo!$lokeerr{
  
  
  
  let token=str.randhex(8);
  let nameprefix=str.concat("loke-backup-";token);
  let filename=str.concat(nameprefix;".db");

  let pathpartial=str.concat(backupdir;"/");
  let path=str.concat(pathpartial;filename);

  
  let vacuumsqlmid=str.concat("VACUUM INTO '";path);
  let vacuumsql=str.concat(vacuumsqlmid;"'");

  (* createdat was the literal string "now()" — GA5.1 again, and here not even in SQL: a
     struct field assigned four characters. `t.nowi64()` is seconds since the epoch and itself
     returned a literal 0 until this commit, so the field was wrong twice over. Rendered as a
     string because $backupinfo.createdat is declared str; a backup listing sorted by this
     field previously had every entry equal. *)
  (* F10.39: this was `db.exec(store.conn;vacuumsql)` with `store:i64`, a field read on an
     integer and std.db's arguments in the wrong places; it crashed when it ran, as the same
     shape in core.privacy.placeholder_store did. toke 3.1.0 rejects it (E4031). std.db
     runs the statement on the connection db.open established. *)
  <mt db.exec(vacuumsql;@()) {
    $ok:v $ok($backupinfo{
        filename:filename;
        path:path;
        sizebytes:0;
        createdat:str.fromi64(t.nowi64())
      });
    $err:e $err($storageerr(str.concat("VACUUM INTO failed for path: ";path)))
  }
};




f=listbackups(backupdir:str):@$backupinfo!$lokeerr{
  
  
  
  log.warn("list_backups: directory listing not yet supported -- returning empty list";"backup";"maintenance");
  <$ok(@())
};




(* Returns a $restoreresult, not an i64!$lokeerr.

   This overwrites the live database, so the caller must be able to tell refusal from
   success — and it cannot through a result type: toke takes the FIRST arm of a match
   on an X!$lokeerr whatever the value is (T-18), so an $err refusal is read as $ok by
   every caller. For an operation that destroys data on a false success, that is not a
   contract worth keeping.

   The source is checked before the copy: file.copy returns $ok for a source that does
   not exist, so a restore from a missing or mistyped path used to report SUCCESS
   while replacing the live database with nothing. *)
f=restorebackup(backuppath:str;datadir:str):$restoreresult{
  if(file.exists(backuppath)){}el{
    <$restoreresult{
      ok:false;
      message:"backup file does not exist, refusing to overwrite the live database: \(backuppath)"
    }
  };
  let dbpath=str.concat(datadir;"/loke.db");
  log.warn("restore_backup: overwriting live database at \(dbpath)";"backup";"maintenance");
  <mt file.copy(backuppath;dbpath) {
    $ok:v $restoreresult{ok:true;message:"restored from \(backuppath)"};
    $err:e $restoreresult{ok:false;message:"failed to copy backup file: \(backuppath)"}
  }
};



f=pruneold(backupdir:str;keepcount:u32):i64!$lokeerr{
  
  
  let keepstr=str.fromint(keepcount);
  log.warn(
    str.concat("prune_old: directory listing not yet supported -- keeping all backups (requested keep=";str.concat(keepstr;")"));
    "backup";
    "maintenance"
  );
  <$ok(0)
};

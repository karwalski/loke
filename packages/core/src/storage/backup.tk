m=core.storage.backup;





i=db:std.db;
i=file:std.file;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=s:core.storage.db;

t=$backupinfo{
  filename:str;
  path:str;
  sizebytes:u32;
  createdat:str
};



(* Declared i64!$lokeerr, not void!$lokeerr, and returns $ok(0).

   toke lowers a `void!$err` success type to LLVM `void`, so any call site that binds
   the result — a match arm, for instance — emits `alloca void` and clang rejects the
   module with "void type only allowed for function results". Filed as T-5 in
   docs/upstream/toke-issues.md, same family as T-1 ($ok(<bool>)): only an i64-width
   success type survives the `!$err` lowering today. *)
f=createbackup(store:i64;backupdir:str):$backupinfo!$lokeerr{
  
  
  
  let token=str.randhex(8);
  let nameprefix=str.concat("loke-backup-";token);
  let filename=str.concat(nameprefix;".db");

  let pathpartial=str.concat(backupdir;"/");
  let path=str.concat(pathpartial;filename);

  
  let vacuumsqlmid=str.concat("VACUUM INTO '";path);
  let vacuumsql=str.concat(vacuumsqlmid;"'");

  mt db.exec(store.conn;vacuumsql) {
    $ok:v $ok($backupinfo{
        filename:filename;
        path:path;
        sizebytes:0;
        createdat:"now()"
      });
    $err:e $err($storageerr(str.concat("VACUUM INTO failed for path: ";path)))
  }
};




f=listbackups(backupdir:str):@$backupinfo!$lokeerr{
  
  
  
  log.warn("list_backups: directory listing not yet supported -- returning empty list";"backup";"maintenance");
  <$ok(@())
};




f=restorebackup(backuppath:str;datadir:str):i64!$lokeerr{
  let dbpath=str.concat(datadir;"/loke.db");
  log.warn(
    str.concat("restore_backup: overwriting live database at ";dbpath);
    "backup";
    "maintenance"
  );
  (* The source is checked before the copy. file.copy returns $ok for a source that
     does not exist, so a restore from a missing or mistyped backup path reported
     SUCCESS while overwriting the live database — the one operation in this module
     where a false success destroys data. Found by
     tests/unit/storage/test_backup.tk, which could not compile until now. *)
  if(file.exists(backuppath)){}el{
    <$err($storageerr("backup file does not exist, refusing to overwrite the live database: \(backuppath)"))
  };
  mt file.copy(backuppath;dbpath) {
    $ok:v $ok(0);
    $err:e $err($storageerr(str.concat("failed to copy backup file: ";backuppath)))
  }
};



f=pruneold(backupdir:str;keepcount:u32):i64!$lokeerr{
  
  
  let keepstr=str.fromint(keepcount);
  log.warn(
    str.concat("prune_old: directory listing not yet supported -- keeping all backups (requested keep=";str.concat(keepstr;")"));
    "backup";
    "maintenance"
  );
  <$ok(0)
};

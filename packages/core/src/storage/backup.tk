m=core.storage.backup;





i=t:shared.types;
i=s:core.storage.db;
i=db:std.db;
i=file:std.file;
i=str:std.str;
i=log:shared.log;

t=$backupinfo{
  filename:str;
  path:str;
  sizebytes:u32;
  createdat:str
};



f=createbackup(store:i64;backupdir:str):$backupinfo|$lokeerr{
  
  
  
  let token=str.randhex(8);
  let nameprefix=str.concat("loke-backup-";token);
  let filename=str.concat(nameprefix;".db");

  let pathpartial=str.concat(backupdir;"/");
  let path=str.concat(pathpartial;filename);

  
  let vacuumsqlmid=str.concat("VACUUM INTO '";path);
  let vacuumsql=str.concat(vacuumsqlmid;"'");

  mt db.exec(store.conn;vacuumsql) {
    $ok: {
      log.info(str.concat("backup created: ";path);"backup";"maintenance");
      <$ok($backupinfo{
        filename:filename;
        path:path;
        sizebytes:0;
        createdat:"now()"
      })
    };
    $err:e <$err($storageerr(str.concat("VACUUM INTO failed for path: ";path)))
  };
};




f=listbackups(backupdir:str):@$backupinfo|$lokeerr{
  
  
  
  log.warn("list_backups: directory listing not yet supported — returning empty list";"backup";"maintenance");
  <$ok(@())
};




f=restorebackup(backuppath:str;datadir:str):void|$lokeerr{
  let dbpath=str.concat(datadir;"/loke.db");
  log.warn(
    str.concat("restore_backup: overwriting live database at ";dbpath);
    "backup";
    "maintenance"
  );
  mt file.copy(backuppath;dbpath) {
    $ok: {
      log.info(str.concat("database restored from: ";backuppath);"backup";"maintenance");
      <$ok(void)
    };
    $err:e <$err($storageerr(str.concat("failed to copy backup file: ";backuppath)))
  };
};



f=pruneold(backupdir:str;keepcount:u32):void|$lokeerr{
  
  
  let keepstr=str.fromint(keepcount);
  log.warn(
    str.concat("prune_old: directory listing not yet supported — keeping all backups (requested keep=";str.concat(keepstr;")"));
    "backup";
    "maintenance"
  );
  <$ok(void)
};

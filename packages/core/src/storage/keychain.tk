m=core.storage.keychain;
i=kc:std.keychain;
i=log:shared.log;
i=str:std.str;

(* X8.3 — this is the ONLY place loke gets a secret from, and the only place it may be.
   There is no key file, no environment-variable fallback and no default; the env fallback
   that used to sit in front of core.storage.db.ensuredbkey was removed rather than gated,
   and the reasoning is recorded there.

   READ THIS BEFORE ADDING A CALL. kc.get and kc.exists reach SecItemCopyMatching, which on
   macOS BLOCKS on an authorisation dialog whenever the calling binary is not the one that
   stored the item. A process that cannot answer that dialog — CI, a test runner, loke
   started by launchd — does not get an error: it hangs indefinitely. toke offers no way to
   time-bound the call, so once the block starts loke cannot recover from it.

   The consequence for design, not just for tests: a keychain read must happen only where a
   secret is actually needed, never on a general-purpose path like opening a database. That
   is why core.storage.db.openstore no longer calls ensuredbkey, and why a function that
   might be called during start-up must not call into this module speculatively.

   The consequence for verification, stated rather than hidden: these four functions'
   interaction with the real keychain is not covered by the automated suite, because a
   headless test cannot answer the dialog. Everything on both sides of them is. *)

f=setkey(account:str;secret:str):bool{
  let ok=kc.set("dev.loke";account;secret);
  log.info(str.concat("keychain: stored ";account);"keychain";"system");
  <ok
};

f=getkey(account:str):str{
  <kc.get("dev.loke";account)
};

f=deletekey(account:str):bool{
  <kc.delete("dev.loke";account)
};

f=haskey(account:str):bool{
  <kc.exists("dev.loke";account)
};

f=setapikey(provider:str;key:str):bool{
  let account=str.concat("api_key.";provider);
  <setkey(account;key)
};

f=getapikey(provider:str):str{
  let account=str.concat("api_key.";provider);
  <getkey(account)
};

f=setdbkey(key:str):bool{
  <setkey("db_encryption_key";key)
};

f=getdbkey():str{
  <getkey("db_encryption_key")
};

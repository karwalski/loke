m=core.storage.keychain;
i=kc:std.keychain;
i=log:shared.log;
i=str:std.str;

f=setkey(account:str;secret:str):bool{
  let ok=kc.set("dev.loke";account;secret);
  log.info(str.concat("keychain: stored ";account);"keychain";"system");
  <ok
};

f=getkey(account:str):str{
  <kc.get("dev.loke";account)
};

f=deletekey(account:str):bool{
  <kc.delete("dev.loke";account)
};

f=haskey(account:str):bool{
  <kc.exists("dev.loke";account)
};

f=setapikey(provider:str;key:str):bool{
  let account=str.concat("api_key.";provider);
  <setkey(account;key)
};

f=getapikey(provider:str):str{
  let account=str.concat("api_key.";provider);
  <getkey(account)
};

f=setdbkey(key:str):bool{
  let account="db_encryption_key";
  <setkey(account;key)
};

f=getdbkey():str{
  let account="db_encryption_key";
  <getkey(account)
};

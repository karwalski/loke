m=core.storage.audit;





i=t:shared.types;
i=db:std.db;
i=s:core.storage.db;
i=str:std.str;
i=json:std.json;

t=$auditevent{
  eventtype:str;
  usecase:str;
  modelid:str;
  provider:str;
  sensitivity:str;
  risktier:str;
  tokensin:u32;
  tokensout:u32;
  costusd:f64;
  durationms:u32;
  correlationid:str
};

f=logevent(store:i64;event:$auditevent):void!$lokeerr{
  let id=str.randhex(16);

  
  let prevhashval=mt db.queryone(store.conn;"SELECT hash FROM audit_log ORDER BY created_at DESC LIMIT 1") {
    $ok:row json.str(row;"hash");
    $err:v ""
  };

  
  
  let hash=str.concat(event.correlationid;event.eventtype);

  let tokensins=str.fromint(event.tokensin);
  let tokensouts=str.fromint(event.tokensout);
  let costs=str.fromfloat(event.costusd);
  let durations=str.fromint(event.durationms);

  mt db.execparams(
    store.conn;
    "INSERT INTO audit_log (id,event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,cost_usd,duration_ms,correlation_id,prev_hash,hash,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,'now()')";
    @(
      id;
      event.eventtype;
      event.usecase;
      event.modelid;
      event.provider;
      event.sensitivity;
      event.risktier;
      tokensins;
      tokensouts;
      costs;
      durations;
      event.correlationid;
      prevhashval;
      hash
    )
  ) {
    $ok:v $ok(void);
    $err:e $err($storageerr("failed to insert audit event"))
  }
};

f=getrecent(store:i64;limit:u32):@$auditevent!$lokeerr{
  let limits=str.fromint(limit);
  let sql=str.concat("SELECT event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,cost_usd,duration_ms,correlation_id FROM audit_log ORDER BY created_at DESC LIMIT ";limits);
  let queryresult=mt db.query(store.conn;sql) {
    $ok:rows rows;
    $err:e $err($storageerr("failed to query audit log"))
  };
  let events=mut.@();
  lp(let ii=0;ii<queryresult.len;ii=ii+1){
    let row=queryresult.get(ii);
    events=events.push($auditevent{
      eventtype:json.str(row;"event_type");
      usecase:json.str(row;"use_case");
      modelid:json.str(row;"model_id");
      provider:json.str(row;"provider");
      sensitivity:json.str(row;"sensitivity");
      risktier:json.str(row;"risk_tier");
      tokensin:json.i64(row;"tokens_in");
      tokensout:json.i64(row;"tokens_out");
      costusd:json.getfloat(row;"cost_usd");
      durationms:json.i64(row;"duration_ms");
      correlationid:json.str(row;"correlation_id")
    })
  };
  <events
};

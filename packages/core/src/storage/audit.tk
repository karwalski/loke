m=core.storage.audit;





i=t:shared.types;
i=db:std.db;
i=s:core.storage.db;
i=str:std.str;
i=json:std.json;

t=$auditevent{
  eventtype:str;
  usecase:str;
  modelid:str;
  provider:str;
  sensitivity:str;
  risktier:str;
  tokensin:u32;
  tokensout:u32;
  costusd:f64;
  durationms:u32;
  correlationid:str
};

f=logevent(store:$s.store;event:$auditevent):void|$lokeerr{
  let id=str.randhex(16);

  
  let prevhashval="";
  db.queryone(store.conn;mt "SELECT hash FROM audit_log ORDER BY created_at DESC LIMIT 1") {
    $ok:row {
      let prevhashval=json.getstr(row;"hash")
    };
    $err: {};
  };

  
  
  let hash=str.concat(event.correlationid;event.eventtype);

  let tokensins=str.fromint(event.tokensin);
  let tokensouts=str.fromint(event.tokensout);
  let costs=str.fromfloat(event.costusd);
  let durations=str.fromint(event.durationms);

  db.execparams(
    store.conn;
    "INSERT INTO audit_log (id,event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,cost_usd,duration_ms,correlation_id,prev_hash,hash,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,'now()')";
    @(
      id;
      event.eventtype;
      event.usecase;
      event.modelid;
      event.provider;
      event.sensitivity;
      event.risktier;
      tokensins;
      tokensouts;
      costs;
      durations;
      event.correlationid;
      prevhashval;
      hash
    )
  mt ) {
    $ok: <$ok(void);
    $err:e <$err($storageerr("failed to insert audit event"))
  };
};

f=getrecent(store:$s.store;limit:u32):@$auditevent|$lokeerr{
  let limits=str.fromint(limit);
  let sql=str.concat("SELECT event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,cost_usd,duration_ms,correlation_id FROM audit_log ORDER BY created_at DESC LIMIT ";limits);
  db.query(store.conn;mt sql) {
    $ok:rows {
      let events=rows.map|row{
        $auditevent{
          eventtype:json.getstr(row;"event_type");
          usecase:json.getstr(row;"use_case");
          modelid:json.getstr(row;"model_id");
          provider:json.getstr(row;"provider");
          sensitivity:json.getstr(row;"sensitivity");
          risktier:json.getstr(row;"risk_tier");
          tokensin:json.getint(row;"tokens_in");
          tokensout:json.getint(row;"tokens_out");
          costusd:json.getfloat(row;"cost_usd");
          durationms:json.getint(row;"duration_ms");
          correlationid:json.getstr(row;"correlation_id")
        };
      };
      <$ok(events)
    };
    $err:e <$err($storageerr("failed to query audit log"))
  };
};

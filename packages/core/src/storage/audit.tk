(* Copyright 2026 loke contributors
   SPDX-License-Identifier: Apache-2.0 *)

m=core.storage.audit;





i=db:std.db;
i=crypto:std.crypto;
i=str:std.str;
i=t:shared.types;
i=s:core.storage.db;

t=$auditevent{
  eventtype:str;
  usecase:str;
  modelid:str;
  provider:str;
  sensitivity:str;
  risktier:str;
  tokensin:u32;
  tokensout:u32;
  costusd:f64;
  durationms:u32;
  correlationid:str
};

(* The result of a chain verification. See verifychain below for why this is a plain
   struct and not a result: T-18 would make a $err arm dead, and a verifier whose failure
   reads as "chain intact" is the worst available outcome for this function. *)
t=$chainresult{
  ok:bool;
  rowschecked:i64;
  firstbadid:str;
  reason:str
};


(* Declared i64!$lokeerr, not void!$lokeerr, and returns $ok(0).

   toke lowers a `void!$err` success type to LLVM `void`, so any call site that binds
   the result — a match arm, for instance — emits `alloca void` and clang rejects the
   module with "void type only allowed for function results". Filed as T-5 in
   docs/upstream/toke-issues.md, same family as T-1 ($ok(<bool>)): only an i64-width
   success type survives the `!$err` lowering today. *)
(* The row accessors are core.storage.db's, not std.json's. db.many returns [$row] and
   this module read every field with json.str / json.i64 / json.getfloat against those
   rows, so every retrieved audit event came back with empty strings and zeros — the
   tamper-proof audit trail recorded events and could not read one back. Found by
   tests/integration/test_audit_trail_e2e.tk once it could run.

   cost_usd comes back as HUNDREDTHS in an i64, the exact integer the digest is computed
   over (GA5.15). It was first chosen because an f64 returned across a module boundary was
   corrupted (T-20, fixed in toke 3.1.0); exactness is why it stays. *)
(* GA5.1 and the tamper-evidence claim, both fixed here.

   created_at used to be written as the SQL literal 'now()' — a quoted string, not a
   function call — so every row in the audit log carried the identical text "now()".
   `ORDER BY created_at DESC, rowid DESC` was therefore meaningless: the hash chain read an
   arbitrary predecessor and `getrecent` returned rows in no particular order. It is a
   millisecond epoch integer now, which orders correctly and is comparable. rowid breaks
   ties: two events logged in the same millisecond would otherwise come back in an
   arbitrary order, and for a hash chain "the previous row" has to be exact.

   The hash was `correlationid + eventtype`. That is not a hash and not a chain: it
   covers two of eleven fields, so changing the model, the cost or the sensitivity left
   it unchanged, and it did not include the previous row's hash, so nothing bound the
   rows together. An audit trail described as tamper-proof has to be at least
   tamper-EVIDENT, and that needs the predecessor and the whole record in the digest.
   sha256 over prev_hash plus every field gives that: altering any field or removing any
   row breaks every hash after it. *)
(* The digest is over a joined field STRING, and both the writer and the verifier build that
   string, so neither has to trust a reconstruction.

   This split exists because of a real failure. The verifier first rebuilt an $auditevent
   from the stored columns and re-ran eventdigest over it — and an intact chain did not
   verify. `cost_usd` is written with str.fromfloat, and reading it back through any numeric
   type loses precision below the type's resolution: a cost of 0.005 read as hundredths is
   1, which formats back as 0.01, so the recomputed digest differed from the stored one on
   every row. The chain was fine; the reconstruction was lossy.

   Hashing the stored text directly removes most of the class: whatever str.fromfloat
   produced is what the column holds for a value SQLite renders identically.

   But not all of them, and the second failure is why cost_usd is now hashed as an INTEGER
   number of hundredths rather than as text. `cost_usd` is declared REAL, so SQLite owns its
   rendering: str.fromfloat(0.0) produces "0" and SQLite gives back "0.0". The digest was
   over "0" and the verifier recomputed it over "0.0", so an untampered chain failed on every
   row whose cost was zero — which is every row the request path writes today, because the
   cost estimate was deliberately 0.0 while T-20 corrupted an f64 returned across a module
   boundary, and is still 0.0 until LS1.1y wires it (see browser/pages/api/pipeline.tk).
   0.005 happened to survive the round-trip; 0.0 did not.

   Both sides now normalise through the same integer: the writer hashes
   f64hundredths(costusd) and the verifier hashes rowf64hundredths of the stored column, so
   the digest is stable no matter how SQLite chooses to render a REAL.

   GA5.15 finished the job: the column is now `cost_usd_cents INTEGER`, the writer stores
   the same integer it hashes, and the verifier reads that integer back with rowi64, so no
   float rendering sits between what was hashed and what is stored. The precision is a
   cent, and that is now a property of the STORED value rather than a gap between the
   stored value and the digest: sub-cent amounts are rounded once, at the writer, and
   nothing finer is kept to tamper with. Rows written before the migration keep the old
   normalisation — see core.storage.db.auditcostcols. *)
f=fieldstring(prevhash:str;id:str;eventtype:str;usecase:str;modelid:str;provider:str;sensitivity:str;risktier:str;tokensin:str;tokensout:str;costusd:str;durationms:str;correlationid:str;created:str):str{
  (* The separator keeps two different field splits from hashing alike. A pipe is enough
     here because no field is free text — the closest is the correlation id, which is
     generated. *)
  <str.join("|";@(
    prevhash;
    id;
    eventtype;
    usecase;
    modelid;
    provider;
    sensitivity;
    risktier;
    tokensin;
    tokensout;
    costusd;
    durationms;
    correlationid;
    created
  ))
};

(* sha256 takes [byte], not str — str.tobytes first. Passing the string directly
   type-checked and crashed at run time. *)
f=sha256hex(v:str):str{
  <crypto.tohex(crypto.sha256(str.tobytes(v)))
};

f=digestfields(prevhash:str;id:str;eventtype:str;usecase:str;modelid:str;provider:str;sensitivity:str;risktier:str;tokensin:str;tokensout:str;costusd:str;durationms:str;correlationid:str;created:str):str{
  <sha256hex(fieldstring(prevhash;id;eventtype;usecase;modelid;provider;sensitivity;risktier;tokensin;tokensout;costusd;durationms;correlationid;created))
};

(* DA1.10 - spec 6.3 and A15. A row that carries the digest of a disclosure_log row hashes
   it as a fifteenth field, so the chain covers the disclosure record: rewriting the stored
   disclosure digest to match an edited disclosure row breaks this row's hash, and the
   verifier recomputes the disclosure digest from the disclosure row itself. A row with no
   disclosure digest (every event that is not a dispatch or its outcome, and every row
   written before migration 40) hashes exactly as before, so an existing chain still
   verifies. *)
f=digestbound(prevhash:str;id:str;eventtype:str;usecase:str;modelid:str;provider:str;sensitivity:str;risktier:str;tokensin:str;tokensout:str;costusd:str;durationms:str;correlationid:str;created:str;disclosure:str):str{
  <digestlayered(prevhash;id;eventtype;usecase;modelid;provider;sensitivity;risktier;tokensin;tokensout;costusd;durationms;correlationid;created;disclosure;"")
};

(* F3b.10. A row whose request has privacy_layer_metrics rows hashes their digest (layerdigest
   below) as one more field, after the disclosure digest, so the chain covers what each
   detection layer found: editing, adding or deleting one of those rows breaks the row's hash
   check in the verifier. A row with no layer digest (every row written before migration 43,
   and every event with no metrics on its correlation id) hashes exactly as before. *)
f=digestlayered(prevhash:str;id:str;eventtype:str;usecase:str;modelid:str;provider:str;sensitivity:str;risktier:str;tokensin:str;tokensout:str;costusd:str;durationms:str;correlationid:str;created:str;disclosure:str;layers:str):str{
  let base=fieldstring(prevhash;id;eventtype;usecase;modelid;provider;sensitivity;risktier;tokensin;tokensout;costusd;durationms;correlationid;created);
  let bound=mut.base;
  if(str.len(disclosure)>0){ bound="\(base)|disclosure:\(disclosure)" }el{};
  if(str.len(layers)==0){ <sha256hex(bound) };
  <sha256hex("\(bound)|layers:\(layers)")
};

(* ── F3b.10: the privacy_layer_metrics rows' canonical serialisation ─────────────────
   The same construction as the disclosure record's below: SQLite's quote() of each column,
   comma-separated, one line per row in seq order, under a prefix naming the version and the
   column set. Nothing is read back through a toke numeric type. *)
f=layermetricscols():@str{
  <@("correlation_id";"seq";"kind";"layer_id";"entity_type";"state";"mode";"duration_ms";"detections";"accepted";"routed";"conf_min_milli";"conf_max_milli";"conf_sum_milli";"strategy";"vetoed_by";"voters";"resolved";"masked";"passed";"agreed";"routing_notes";"created_at")
};

f=layerserialsql():str{
  <"SELECT 'layers-v1:'||\(quotedcols(layermetricscols())) AS s FROM privacy_layer_metrics WHERE correlation_id=? ORDER BY seq ASC"
};

f=joinserials(rows:@$row):str{
  let out=mut."";
  lp(let i=0;i<rows.len;i=i+1){
    let line:str=s.rowstr(rows.get(i);"s");
    if(i==0){ out=line }el{ out="\(out)\n\(line)" }
  };
  <out
};

(* The digest of the privacy_layer_metrics rows on `correlationid`, or "" when there are none. *)
f=layerdigest(correlationid:str):str{
  let serial=mt db.many(layerserialsql();@(correlationid)) {
    $ok:rows joinserials(rows);
    $err:e ""
  };
  if(str.len(serial)==0){ <"" };
  <sha256hex(serial)
};

(* ── DA1.10: the disclosure record's canonical serialisation ───────────────────────────
   Spec 6.3: disclosure_log is a companion table, and its row is an input to the digest of
   its audit_log row. Two digests, because the row is written in two phases (spec 2.3):

     reserve  the fields of spec 5.1 to 5.4, everything about what was sent. Bound into the
              `llm_dispatch` audit row, written in the same transaction as the reserve
              (DA1.9). L3 says these fields are immutable, and this is what detects a breach
     full     the reserve fields and the outcome (state, reported tokens, response size,
              duration, outcome). Bound into the outcome audit row (`llm_request`,
              `llm_request_failed`), written in one transaction with the completion, and into
              a no-custody refusal's `llm_request_refused` row, whose record is written whole

   The serialisation is SQLite's quote() of each column, comma-separated, in a fixed order.
   quote() renders a value as an SQL literal: NULL as NULL, an integer as its digits, a
   string in single quotes with every quote doubled. So the list parses one way only, a NULL
   and an empty string differ, and an integer and the same digits stored as text differ.
   Nothing is read back through a toke numeric type, so no float rendering sits between what
   was hashed and what is stored (the GA5.15 lesson). The prefix names the version and the
   column set: a column added by a later migration is not covered until a new version names
   it, and a verifier must not guess which. *)
f=disclosurereservecols():@str{
  <@("record_id";"correlation_id";"request_id";"session_id";"parent_record_id";"occurred_at";"dispatch_kind";"pipeline_disabled";"provider";"provider_class";"model_id";"model_version";"endpoint_host";"jurisdiction";"retention_class";"bytes_body";"bytes_headers";"bytes_schema_profile";"bytes_question";"bytes_other";"tokens_estimated";"tokeniser_id";"custody";"custody_check";"fallback_reason";"fallback_selected_by";"surrogate_style";"surrogate_scope";"datasets_disclosed";"fields_disclosed";"fields_disclosed_count";"field_types_disclosed";"cardinality_disclosed";"row_count_disclosed";"entity_types";"entities_total";"detection_layers";"real_values_included";"real_value_count";"sample_values_included";"aggregates_included";"qi_combination_present";"qi_combination_fields")
};

f=disclosureoutcomecols():@str{
  <@("state";"tokens_source";"response_bytes";"tokens_in_reported";"tokens_out_reported";"duration_ms";"outcome")
};

f=quotedcols(cols:@str):str{
  let out=mut."";
  lp(let i=0;i<cols.len;i=i+1){
    if(i>0){ out="\(out)||','||" }el{};
    out="\(out)quote(\(cols.get(i)))"
  };
  <out
};

(* The SQL that serialises one row. A full digest is taken only once the row has left
   `dispatched`: an outcome row written while its record was still in flight (a completion
   that failed to update it) binds nothing, because the later sweep to `abandoned` would
   otherwise read as tampering. *)
f=disclosureserialsql(full:bool):str{
  let cols=quotedcols(disclosurereservecols());
  if(full){
    <"SELECT 'disclosure-v1-full:'||\(cols)||','||\(quotedcols(disclosureoutcomecols())) AS s FROM disclosure_log WHERE correlation_id=? AND state<>'dispatched'"
  };
  <"SELECT 'disclosure-v1-reserve:'||\(cols) AS s FROM disclosure_log WHERE correlation_id=?"
};

f=serialfromrows(rows:@$row):str{
  if(rows.len==0){ <"" };
  <s.rowstr(rows.get(0);"s")
};

f=disclosureserial(correlationid:str;full:bool):str{
  <mt db.many(disclosureserialsql(full);@(correlationid)) {
    $ok:rows serialfromrows(rows);
    $err:e ""
  }
};

(* The digest of the disclosure row on `correlationid`, or "" when there is none to bind. *)
f=disclosuredigest(correlationid:str;full:bool):str{
  let serial=disclosureserial(correlationid;full);
  if(str.len(serial)==0){ <"" };
  <sha256hex(serial)
};

(* Which digest an audit row binds is fixed by its event type, which the chain covers: the
   dispatch row binds the reserve, every other row the whole record. *)
f=bindsfull(eventtype:str):bool{
  <str.eq(eventtype;"llm_dispatch")==false
};

f=eventdigest(prevhash:str;id:str;event:$auditevent;created:i64):str{
  <eventdigestbound(prevhash;id;event;created;"")
};

f=eventdigestbound(prevhash:str;id:str;event:$auditevent;created:i64;disclosure:str):str{
  <eventdigestlayered(prevhash;id;event;created;disclosure;"")
};

f=eventdigestlayered(prevhash:str;id:str;event:$auditevent;created:i64;disclosure:str;layers:str):str{
  <digestlayered(
    prevhash;
    id;
    event.eventtype;
    event.usecase;
    event.modelid;
    event.provider;
    event.sensitivity;
    event.risktier;
    str.fromint(event.tokensin);
    str.fromint(event.tokensout);
    str.fromi64(t.f64hundredths(event.costusd));
    str.fromint(event.durationms);
    event.correlationid;
    str.fromi64(created);
    disclosure;
    layers)
};

f=insertevent(store:i64;event:$auditevent):bool{
  <insertbound(store;event;"")
};

(* DA1.10. The row for a dispatch or its outcome, with the digest of its disclosure row
   (disclosuredigest above) stored and hashed. `disclosure` is "" for an event with no
   disclosure record. The caller holds the transaction that wrote the disclosure row, so the
   digest is of the row as it is committed. *)
f=insertbound(store:i64;event:$auditevent;disclosure:str):bool{
  let id=str.randhex(16);
  let created=db.nowms();

  (* The newest row by timestamp is the chain's tail. *)
  let prevhashval=mt db.one("SELECT hash FROM audit_log ORDER BY created_at DESC, rowid DESC LIMIT 1";@()) {
    $ok:row s.rowstr(row;"hash");
    $err:v ""
  };

  (* F3b.10. Every row on a correlation id that has privacy_layer_metrics rows binds them,
     whichever writer calls this. *)
  let layers=layerdigest(event.correlationid);
  let hash=eventdigestlayered(prevhashval;id;event;created;disclosure;layers);

  <mt db.exec("INSERT INTO audit_log (id,event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,cost_usd_cents,duration_ms,correlation_id,prev_hash,hash,created_at,disclosure_digest,layer_digest) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,NULLIF(?,''),NULLIF(?,''))";@(
    id;
    event.eventtype;
    event.usecase;
    event.modelid;
    event.provider;
    event.sensitivity;
    event.risktier;
    str.fromint(event.tokensin);
    str.fromint(event.tokensout);
    str.fromi64(t.f64hundredths(event.costusd));
    str.fromint(event.durationms);
    event.correlationid;
    prevhashval;
    hash;
    str.fromi64(created);
    disclosure;
    layers)) {
    $ok:v true;
    $err:e false
  }
};

(* Kept for callers that already match its result, including the integration test. New
   callers should use insertevent: this signature cannot tell them whether the write
   happened, for the reason set out above. *)
f=logevent(store:i64;event:$auditevent):i64!$lokeerr{
  if(insertevent(store;event)){
    <$ok(0)
  }el{
    <$err($storageerr("failed to insert audit event"))
  }
};


(* GA5.3 — chain verification, reading FORWARD in insertion order.

   The digest was made real by GA5.2 (sha256 over the previous hash plus all fourteen
   fields) and the trail was made non-empty by GA1.4. Neither of those is tamper-EVIDENCE
   on its own: evidence means somebody can check, and until now nothing could. A hash chain
   nobody verifies is a hash chain that might not chain.

   Forward order matters. Each row's prev_hash must equal the previous row's hash, so the
   check is sequential and the first divergence is the useful output — everything after it
   is downstream of the same break. Reporting "the chain is broken" without saying where
   would leave an operator no better off.

   Three failures are distinguishable, and the difference is what an operator needs:

     - a FIELD was altered   -> the recomputed digest differs from the stored hash
     - the HASH was altered   -> the next row's prev_hash no longer matches
     - a ROW was deleted      -> the same symptom as an altered hash, one row earlier

   The last two present identically from inside the data, which is a real limit and is
   stated rather than papered over: the chain proves rows have not been changed or removed
   from the middle, and cannot distinguish a removal from a rewrite at the same point.

   Returns a plain struct, never a result. T-18 makes the error arm of a user-declared sum
   dead, so a verifier that returned $err would be read as "chain intact" by every caller —
   which for this function is the single worst available failure. *)
f=chainok(n:i64):$chainresult{
  <$chainresult{ok:true;rowschecked:n;firstbadid:"";reason:""}
};

f=chainbad(n:i64;id:str;reason:str):$chainresult{
  <$chainresult{ok:false;rowschecked:n;firstbadid:id;reason:reason}
};

f=digestfromrow(r:$row):str{
  (* Every column read as TEXT, which is what was hashed — except cost, which is the exact
     integer of cents (GA5.15), or for a row written before migration 28 the legacy REAL
     read through the same rounding its digest was written with. See
     core.storage.db.auditcostcols. *)
  <digestlayered(
    s.rowstr(r;"prev_hash");
    s.rowstr(r;"id");
    s.rowstr(r;"event_type");
    s.rowstr(r;"use_case");
    s.rowstr(r;"model_id");
    s.rowstr(r;"provider");
    s.rowstr(r;"sensitivity");
    s.rowstr(r;"risk_tier");
    s.rowstr(r;"tokens_in");
    s.rowstr(r;"tokens_out");
    str.fromi64(s.rowauditcostcents(r));
    s.rowstr(r;"duration_ms");
    s.rowstr(r;"correlation_id");
    s.rowstr(r;"created_at");
    s.rowstr(r;"disclosure_digest");
    s.rowstr(r;"layer_digest"))
};

f=verifyrows(rows:@$row):$chainresult{
  let expectedprev=mut."";
  lp(let i=0;i<rows.len;i=i+1){
    let r:$row=rows.get(i);
    let id=s.rowstr(r;"id");
    let storedhash=s.rowstr(r;"hash");
    let storedprev=s.rowstr(r;"prev_hash");

    if(str.eq(storedprev;expectedprev)){}el{
      <chainbad(i;id;"prev_hash does not match the previous row's hash: a row was deleted, or a hash was rewritten, at or before this point")
    };

    let recomputed=digestfromrow(r);
    if(str.eq(recomputed;storedhash)){}el{
      <chainbad(i;id;"the stored hash does not match a digest recomputed from this row's own fields: a field was altered")
    };

    (* DA1.10: the disclosure record this row is bound to must still be the one it was
       bound to. The stored digest is covered by the row hash checked above, so it cannot
       be rewritten to match an edited disclosure row without failing that check. *)
    let bound=s.rowstr(r;"disclosure_digest");
    if(str.len(bound)>0){
      if(str.eq(disclosuredigest(s.rowstr(r;"correlation_id");bindsfull(s.rowstr(r;"event_type")));bound)){}el{
        <chainbad(i;id;"the disclosure_log row this audit row is bound to was altered or deleted: its digest no longer matches")
      }
    };

    (* F3b.10: likewise the privacy_layer_metrics rows on its correlation id. *)
    let layersbound=s.rowstr(r;"layer_digest");
    if(str.len(layersbound)>0){
      if(str.eq(layerdigest(s.rowstr(r;"correlation_id"));layersbound)){}el{
        <chainbad(i;id;"the privacy_layer_metrics rows this audit row is bound to were altered, added to or deleted: their digest no longer matches")
      }
    };

    expectedprev=storedhash
  };
  <chainok(rows.len as i64)
};

(* The first row's prev_hash is "" — logevent writes the empty string when the table is
   empty — so an empty trail verifies trivially and says so through rowschecked. *)
f=verifychain(store:i64):$chainresult{
  <mt db.many(str.join("";@("SELECT id,event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,";s.auditcostcols();",duration_ms,correlation_id,prev_hash,hash,created_at,COALESCE(disclosure_digest,'') AS disclosure_digest,COALESCE(layer_digest,'') AS layer_digest FROM audit_log ORDER BY created_at ASC, rowid ASC"));@()) {
    $ok:rows verifyrows(rows);
    $err:e chainbad(0;"";"the audit trail could not be read")
  }
};

f=formatchainresult(r:$chainresult):str{
  if(r.ok){
    <str.concat("audit chain intact: ";str.concat(str.fromi64(r.rowschecked);" row(s) verified"))
  }el{
    <str.concat("AUDIT CHAIN BROKEN after ";str.concat(str.fromi64(r.rowschecked);str.concat(" row(s), at id ";str.concat(r.firstbadid;str.concat(": ";r.reason)))))
  }
};

(* The rows are mapped in their own function, which is what establishes their type.
   Binding `let queryresult=mt db.many(...) { $ok:rows rows; $err:e $err(...) }` gave
   queryresult two different types — @$row on one arm and an error on the other — so
   indexing it read whatever was there. With an empty table that happened to be
   harmless; with rows present it segfaulted. *)
f=eventsfromrows(rows:@$row):@$auditevent{
  let events=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row:$row=rows.get(i);
    events=events.push($auditevent{
      eventtype:s.rowstr(row;"event_type");
      usecase:s.rowstr(row;"use_case");
      modelid:s.rowstr(row;"model_id");
      provider:s.rowstr(row;"provider");
      sensitivity:s.rowstr(row;"sensitivity");
      risktier:s.rowstr(row;"risk_tier");
      tokensin:s.rowi64(row;"tokens_in") as u32;
      tokensout:s.rowi64(row;"tokens_out") as u32;
      costusd:(s.rowauditcostcents(row) as f64) / 100.0;
      durationms:s.rowi64(row;"duration_ms") as u32;
      correlationid:s.rowstr(row;"correlation_id")
    })
  };
  <events
};

f=getrecent(store:i64;limit:u32):@$auditevent!$lokeerr{
  let sql=str.join("";@("SELECT event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,";s.auditcostcols();",duration_ms,correlation_id FROM audit_log ORDER BY created_at DESC, rowid DESC LIMIT ";str.fromint(limit)));
  <mt db.many(sql;@()) {
    $ok:rows $ok(eventsfromrows(rows));
    $err:e $err($storageerr("failed to query audit log"))
  }
};


m=core.storage.ephemeral;
i=sm:std.securemem;
i=log:shared.log;

t=$ephemeralmap{ buf:st=$securebuf; sessionid:str; entrycount:i32 };

f=isavailable():bool{
  <true
};

f=newmap(sessionid:str;ttlseconds:i32):$ephemeralmap{
  buf=sm.alloc(65536;ttlseconds);
  sm.write(buf;"{\"entries\":{}}");
  <$ephemeralmap{ buf:buf; sessionid:sessionid; entrycount:0 };
};

f=put(m:$ephemeralmap;placeholder:str;original:str):$ephemeralmap{
  raw=sm.read(m.buf);
  parsed=json.parse(raw);
  json.set(parsed;"entries.{placeholder}";original);
  sm.write(m.buf;json.stringify(parsed));
  <$ephemeralmap{ buf:m.buf; sessionid:m.sessionid; entrycount:m.entrycount+1 };
};

f=get(m:$ephemeralmap;placeholder:str):(str){
  raw=sm.read(m.buf);
  parsed=json.parse(raw);
  <json.getopt(parsed;"entries.{placeholder}")
};

f=wipe(m:$ephemeralmap):bool{
  result=sm.wipe(m.buf);
  log.info("ephemeral map wiped: {m.session_id}");
  <result
};

f=sweep():i32{
  count=sm.sweep();
  <count
};

f=torestoremap(m:$ephemeralmap):@str{
  raw=sm.read(m.buf);
  parsed=json.parse(raw);
  entries=json.entries(parsed;"entries");
  out=array.map(entries;f=(e:$entry):str{ <"{e.key}:{e.value}" });
  <out
};

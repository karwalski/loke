m=core.storage.ephemeral;
i=sm:std.securemem;
i=json:std.json;
i=log:shared.log;
i=str:std.str;

t=$ephemeralmap{ buf:i64; sessionid:str; entrycount:i32 };

f=isavailable():bool{
  <true
};

f=newmap(sessionid:str;ttlseconds:i32):$ephemeralmap{
  let buf=sm.alloc(65536;ttlseconds);
  sm.write(buf;"{\"entries\":{}}");
  <$ephemeralmap{ buf:buf; sessionid:sessionid; entrycount:0 }
};

f=put(m:$ephemeralmap;placeholder:str;original:str):$ephemeralmap{
  let raw=sm.read(m.buf);
  let parsed=json.parse(raw);
  let key=str.concat("entries.";placeholder);
  json.set(parsed;key;original);
  sm.write(m.buf;json.stringify(parsed));
  <$ephemeralmap{ buf:m.buf; sessionid:m.sessionid; entrycount:m.entrycount+(1 as i32) }
};

f=get(m:$ephemeralmap;placeholder:str):str{
  let raw=sm.read(m.buf);
  let parsed=json.parse(raw);
  let key=str.concat("entries.";placeholder);
  <json.getopt(parsed;key)
};

f=wipe(m:$ephemeralmap):bool{
  let result=sm.wipe(m.buf);
  log.info(str.concat("ephemeral map wiped: ";m.sessionid);"ephemeral";"system");
  <result
};

f=sweep():i32{
  let count=sm.sweep();
  <count
};

f=torestoremap(m:$ephemeralmap):@str{
  let raw=sm.read(m.buf);
  let parsed=json.parse(raw);
  let entries=json.entries(parsed;"entries");
  let out=mut.@();
  lp(let i=0;i<str.arraylen(entries);i=i+1){ let e=str.arrayget(entries;i);
    out=out.append(str.concat(e.key;str.concat(":";e.value)))
  };
  <out
};

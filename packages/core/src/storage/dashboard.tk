m=core.storage.dashboard;
i=db:std.db;
i=str:std.str;
i=json:std.json;
i=s:core.storage.db;



t=$widgetstate{
  id:str;
  collapsed:bool;
  timerange:str;
  sortby:str;
  updatedat:i64
};

t=$dashboardprefs{
  widgets:@$widgetstate;
  theme:str;
  sidebaropen:bool
};


(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=defaultprefs():$dashboardprefs{
  let widgets=@(
    $widgetstate{ id:"savings";      collapsed:false; timerange:"7d"; sortby:"date";    updatedat:0 };
    $widgetstate{ id:"privacy";      collapsed:false; timerange:"7d"; sortby:"count";   updatedat:0 };
    $widgetstate{ id:"models";       collapsed:false; timerange:"7d"; sortby:"cost";    updatedat:0 };
    $widgetstate{ id:"pipeline";     collapsed:false; timerange:"7d"; sortby:"default"; updatedat:0 };
    $widgetstate{ id:"governance";   collapsed:false; timerange:"7d"; sortby:"default"; updatedat:0 };
    $widgetstate{ id:"audit";        collapsed:false; timerange:"7d"; sortby:"date";    updatedat:0 };
    $widgetstate{ id:"token-budget"; collapsed:false; timerange:"30d"; sortby:"default"; updatedat:0 }
  );
  <$dashboardprefs{ widgets:widgets; theme:"dark"; sidebaropen:true }
};


f=load(store:i64):$dashboardprefs{
  let rows=mt db.many("SELECT value FROM settings WHERE key=? LIMIT 1";@("loke.dashboard.prefs")) {
    $ok:rows rows;
    $err:v defaultprefs()
  };
  if(rows.len == 0){
    <defaultprefs()
  }el{
    let firstrow:$dbrow=rows.get(0);
    (* LS1.1w. json.dec and json.arr, the typed calls. This was json.decode, whose failed
       match bound defaultprefs() where a document was expected, and json.getarray, both
       untyped ABI helpers. A blob that does not parse now gives the defaults. *)
    let parsed=mt json.dec(s.rowstr(firstrow;"value")) {
      $ok:v v;
      $jsonerr:e $jsonval{raw:""}
    };
    if(str.len(parsed.raw)==0){ <defaultprefs() }el{};
    let widgetarr=mt json.arr(parsed;"widgets") {
      $ok:a a;
      $jsonerr:e @()
    };
    let widgets=mut.@();
    lp(let ii1=0;ii1<widgetarr.len;ii1=ii1+1){
      let w:$jsonval=widgetarr.get(ii1);
      widgets=widgets.push($widgetstate{
        id:mt json.str(w;"id"){$ok:okv okv;$err:errv ""};
        collapsed:mt json.bool(w;"collapsed"){$ok:okv okv;$err:errv false};
        timerange:mt json.str(w;"time_range"){$ok:okv okv;$err:errv ""};
        sortby:mt json.str(w;"sort_by"){$ok:okv okv;$err:errv ""};
        updatedat:mt json.i64(w;"updated_at"){$ok:okv okv;$err:errv 0}
      })
    };
    <$dashboardprefs{
      widgets:     widgets;
      theme:       mt json.str(parsed;"theme"){$ok:okv okv;$err:errv ""};
      sidebaropen:mt json.bool(parsed;"sidebar_open"){$ok:okv okv;$err:errv false}
    }
  };
};


f=save(store:i64;prefs:$dashboardprefs):bool{
  let widgetsarr=mut.@();
  lp(let ii2=0;ii2<prefs.widgets.len;ii2=ii2+1){
    let w=prefs.widgets.get(ii2);
    let collapseds=mut."false";
    if(w.collapsed){collapseds="true"}el{};
    widgetsarr=widgetsarr.push("{\"id\":\"\(w.id)\",\"collapsed\":\(collapseds),\"time_range\":\"\(w.timerange)\",\"sort_by\":\"\(w.sortby)\",\"updated_at\":\(w.updatedat)}")
  };
  let sidebars=mut."false";
  if(prefs.sidebaropen){sidebars="true"}el{};

  (* `datetime('now')` inline, not a bound parameter — the same GA5.1 defect fixed in
     core.storage.settings.upsertsql, in a second hand-written copy of that statement. A
     parameter is a value and never an expression, so the row recorded the literal text
     "now()" as its update time. Left as its own statement rather than made to call
     `settings.upsertsql()`, because this one deliberately does NOT update value_type on
     conflict and sharing the string would silently change that. *)
  <mt db.exec("INSERT INTO settings (key,value,value_type,namespace,updated_at) VALUES (?,?,?,?,datetime('now')) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at";@("loke.dashboard.prefs";"{\"widgets\":[\(str.join(",";widgetsarr))],\"theme\":\"\(prefs.theme)\",\"sidebar_open\":\(sidebars)}";"json";"dashboard")) {
    $ok:v true;
    $err:v false
  }
};



f=setwidget(store:i64;id:str;collapsed:bool;timerange:str):bool{
  let prefs=load(store);
  let nowts=0; 
  let found=mut.false;
  let updated=mut.@();
  lp(let ii3=0;ii3<prefs.widgets.len;ii3=ii3+1){
    let w=prefs.widgets.get(ii3);
    if(str.eq(w.id;id)){
      found=true;
      updated=updated.push($widgetstate{
        id:w.id;
        collapsed:collapsed;
        timerange:timerange;
        sortby:w.sortby;
        updatedat:nowts
      })
    }el{
      updated=updated.push(w)
    }
  };
  let finalwidgets=mut.updated;
  if(found){}el{

    let neww=$widgetstate{
      id:         id;
      collapsed:  collapsed;
      timerange: timerange;
      sortby:    "default";
      updatedat: nowts
    };
    finalwidgets=updated.push(neww)
  };
  let newprefs=$dashboardprefs{
    widgets:      finalwidgets;
    theme:        prefs.theme;
    sidebaropen: prefs.sidebaropen
  };
  <save(store;newprefs)
};




m=core.storage.dashboard;
i=db:std.db;
i=s:core.storage.db;
i=str:std.str;
i=json:std.json;


let prefskey="loke.dashboard.prefs";
let prefsns="dashboard";

t=$widgetstate{
  id:str;
  collapsed:bool;
  timerange:str;
  sortby:str;
  updatedat:i64
};

t=$dashboardprefs{
  widgets:@$widgetstate;
  theme:str;
  sidebaropen:bool
};


f=defaultprefs():$dashboardprefs{
  let widgets=@(
    $widgetstate{ id:"savings";      collapsed:false; timerange:"7d"; sortby:"date";    updatedat:0 };
    $widgetstate{ id:"privacy";      collapsed:false; timerange:"7d"; sortby:"count";   updatedat:0 };
    $widgetstate{ id:"models";       collapsed:false; timerange:"7d"; sortby:"cost";    updatedat:0 };
    $widgetstate{ id:"pipeline";     collapsed:false; timerange:"7d"; sortby:"default"; updatedat:0 };
    $widgetstate{ id:"governance";   collapsed:false; timerange:"7d"; sortby:"default"; updatedat:0 };
    $widgetstate{ id:"audit";        collapsed:false; timerange:"7d"; sortby:"date";    updatedat:0 };
    $widgetstate{ id:"token-budget"; collapsed:false; timerange:"30d"; sortby:"default"; updatedat:0 }
  );
  <$dashboardprefs{ widgets:widgets; theme:"dark"; sidebaropen:true }
};


f=load(store:i64):$dashboardprefs{
  mt db.queryparams(store.conn;"SELECT value FROM settings WHERE key=? LIMIT 1";@($prefskey)) {
    $ok:rows {
      if(rows.len = 0){
        <defaultprefs()
      }el{
        let blob=json.getstr(rows.get(0);"value");
        let parsed=mt json.parse(blob) {
          $ok:v { v };
          $err: { <defaultprefs() }
        };
        let widgets=json.getarray(parsed;"widgets").map|w{
          $widgetstate{
            id:           json.getstr(w;"id");
            collapsed:    json.getbool(w;"collapsed");
            timerange:   json.getstr(w;"time_range");
            sortby:      json.getstr(w;"sort_by");
            updatedat:   json.getint(w;"updated_at")
          }
        };
        <$dashboardprefs{
          widgets:     widgets;
          theme:       json.getstr(parsed;"theme");
          sidebaropen:json.getbool(parsed;"sidebar_open")
        }
      }
    };
    $err: { <defaultprefs() }
  }
};


f=save(store:i64;prefs:$dashboardprefs):bool{
  let widgetsarr=prefs.widgets.map|w{
    let collapseds=if(w.collapsed){"true"}el{"false"};
    let updateds=str.fromint(w.updatedat);
    str.concat(
      "{\"id\":\"";w.id;
      "\",\"collapsed\":";collapseds;
      ",\"time_range\":\"";w.timerange;
      "\",\"sort_by\":\"";w.sortby;
      "\",\"updated_at\":";updateds;
      "}"
    )
  };
  let widgetsjson=str.concat("[";str.join(widgetsarr;",");"]");
  let sidebars=if(prefs.sidebaropen){"true"}el{"false"};
  let blob=str.concat(
    "{\"widgets\":";widgetsjson;
    ",\"theme\":\"";prefs.theme;
    "\",\"sidebar_open\":";sidebars;
    "}"
  );
  let sql="INSERT INTO settings (key,value,value_type,namespace,updated_at) VALUES (?,?,?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at";
  mt db.execparams(store.conn;sql;@(prefskey;blob;"json";prefsns;"now()")) {
    $ok: { <true };
    $err: { <false }
  }
};



f=setwidget(store:i64;id:str;collapsed:bool;timerange:str):bool{
  let prefs=load(store);
  let nowts=0; 
  let found=false;
  let updated=prefs.widgets.map|w{
    if(str.eq(w.id;id)){
      let found=true;
      $widgetstate{
        id:          w.id;
        collapsed:   collapsed;
        timerange:  timerange;
        sortby:     w.sortby;
        updatedat:  nowts
      }
    }el{
      w
    }
  };
  let finalwidgets=if(found){
    updated
  }el{
    
    let neww=$widgetstate{
      id:         id;
      collapsed:  collapsed;
      timerange: timerange;
      sortby:    "default";
      updatedat: nowts
    };
    updated.push(neww);
    updated
  };
  let newprefs=$dashboardprefs{
    widgets:      finalwidgets;
    theme:        prefs.theme;
    sidebaropen: prefs.sidebaropen
  };
  <save(store;newprefs)
};

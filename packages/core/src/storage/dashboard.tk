


m=core.storage.dashboard;
i=db:std.db;
i=s:core.storage.db;
i=str:std.str;
i=json:std.json;



t=$widgetstate{
  id:str;
  collapsed:bool;
  timerange:str;
  sortby:str;
  updatedat:i64
};

t=$dashboardprefs{
  widgets:@$widgetstate;
  theme:str;
  sidebaropen:bool
};


f=defaultprefs():$dashboardprefs{
  let widgets=@(
    $widgetstate{ id:"savings";      collapsed:false; timerange:"7d"; sortby:"date";    updatedat:0 };
    $widgetstate{ id:"privacy";      collapsed:false; timerange:"7d"; sortby:"count";   updatedat:0 };
    $widgetstate{ id:"models";       collapsed:false; timerange:"7d"; sortby:"cost";    updatedat:0 };
    $widgetstate{ id:"pipeline";     collapsed:false; timerange:"7d"; sortby:"default"; updatedat:0 };
    $widgetstate{ id:"governance";   collapsed:false; timerange:"7d"; sortby:"default"; updatedat:0 };
    $widgetstate{ id:"audit";        collapsed:false; timerange:"7d"; sortby:"date";    updatedat:0 };
    $widgetstate{ id:"token-budget"; collapsed:false; timerange:"30d"; sortby:"default"; updatedat:0 }
  );
  <$dashboardprefs{ widgets:widgets; theme:"dark"; sidebaropen:true }
};


f=load(store:i64):$dashboardprefs{
  let rows=mt db.queryparams(store.conn;"SELECT value FROM settings WHERE key=? LIMIT 1";@("loke.dashboard.prefs")) {
    $ok:rows rows;
    $err:v defaultprefs()
  };
  if(rows.len = 0){
    <defaultprefs()
  }el{
    let blob=json.str(rows.get(0);"value");
    let parsed=mt json.parse(blob) {
      $ok:v v;
      $err:v defaultprefs()
    };
    let widgetarr=json.getarray(parsed;"widgets");
    let widgets=mut.@();
    lp(let ii1=0;ii1<widgetarr.len;ii1=ii1+1){
      let w=widgetarr.get(ii1);
      widgets=widgets.push($widgetstate{
        id:json.str(w;"id");
        collapsed:json.bool(w;"collapsed");
        timerange:json.str(w;"time_range");
        sortby:json.str(w;"sort_by");
        updatedat:json.i64(w;"updated_at")
      })
    };
    <$dashboardprefs{
      widgets:     widgets;
      theme:       json.str(parsed;"theme");
      sidebaropen:json.bool(parsed;"sidebar_open")
    }
  };
};


f=save(store:i64;prefs:$dashboardprefs):bool{
  let widgetsarr=mut.@();
  lp(let ii2=0;ii2<prefs.widgets.len;ii2=ii2+1){
    let w=prefs.widgets.get(ii2);
    let collapseds=mut."false";
    if(w.collapsed){collapseds="true"}el{};
    let updateds=str.fromint(w.updatedat);
    str.concat(
      "{\"id\":\"";w.id;
      "\",\"collapsed\":";collapseds;
      ",\"time_range\":\"";w.timerange;
      "\",\"sort_by\":\"";w.sortby;
      "\",\"updated_at\":";updateds;
      "}"
    )
  };
  let widgetsjson=str.concat("[";str.concat(str.join(widgetsarr;",");"]"));
  let sidebars=mut."false";
  if(prefs.sidebaropen){sidebars="true"}el{};
  let blob=str.concat("{\"widgets\":";str.concat(widgetsjson;str.concat(",\"theme\":\"";str.concat(prefs.theme;str.concat("\",\"sidebar_open\":";str.concat(sidebars;"}"))))));

  let sql="INSERT INTO settings (key,value,value_type,namespace,updated_at) VALUES (?,?,?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at";
  mt db.execparams(store.conn;sql;@("loke.dashboard.prefs";blob;"json";"dashboard";"now()")) {
    $ok:v true;
    $err:v false
  }
};



f=setwidget(store:i64;id:str;collapsed:bool;timerange:str):bool{
  let prefs=load(store);
  let nowts=0; 
  let found=mut.false;
  let updated=mut.@();
  lp(let ii3=0;ii3<prefs.widgets.len;ii3=ii3+1){
    let w=prefs.widgets.get(ii3);
    if(str.eq(w.id;id)){
      found=true;
      updated=updated.push($widgetstate{
        id:w.id;
        collapsed:collapsed;
        timerange:timerange;
        sortby:w.sortby;
        updatedat:nowts
      })
    }el{
      updated=updated.push(w)
    }
  };
  let finalwidgets=mut.updated;
  if(found){}el{

    let neww=$widgetstate{
      id:         id;
      collapsed:  collapsed;
      timerange: timerange;
      sortby:    "default";
      updatedat: nowts
    };
    finalwidgets=updated.push(neww)
  };
  let newprefs=$dashboardprefs{
    widgets:      finalwidgets;
    theme:        prefs.theme;
    sidebaropen: prefs.sidebaropen
  };
  <save(store;newprefs)
};

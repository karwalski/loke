{
  "schema_version": "1.0",
  "module": "core.storage.db",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "dbconn", "fields": [{"name": "handle", "type": "i64"}]},
    {"kind": "type", "name": "store", "fields": [{"name": "conn", "type": "dbconn"}, {"name": "datadir", "type": "str"}]},
    {"kind": "func", "name": "openstore", "params": ["str"], "return": "store"},
    {"kind": "func", "name": "runmigrations", "params": ["dbconn"], "return": "i64"},
    {"kind": "func", "name": "closestore", "params": ["store"], "return": "void"},
    {"kind": "func", "name": "exec", "params": ["store", "str"], "return": "i64"},
    {"kind": "func", "name": "execparams", "params": ["store", "str", "@"], "return": "i64"},
    {"kind": "func", "name": "query", "params": ["store", "str"], "return": "i64"},
    {"kind": "func", "name": "queryone", "params": ["store", "str"], "return": "i64"},
    {"kind": "func", "name": "queryparams", "params": ["store", "str", "@"], "return": "i64"},
    {"kind": "func", "name": "getstr", "params": ["store", "str"], "return": "str"},
    {"kind": "func", "name": "setstr", "params": ["store", "str", "str", "str"], "return": "i64"},
    {"kind": "func", "name": "rowstr", "params": ["i64", "i64", "i64"], "return": "str"},
    {"kind": "func", "name": "rowi64", "params": ["i64", "i64", "i64"], "return": "i64"},
    {"kind": "func", "name": "rowi32", "params": ["i64", "i64", "i64"], "return": "i32"},
    {"kind": "func", "name": "rowbool", "params": ["i64", "i64", "i64"], "return": "bool"},
    {"kind": "func", "name": "rowget", "params": ["i64", "i64"], "return": "i64"},
    {"kind": "func", "name": "rowslen", "params": ["i64"], "return": "i64"},
    {"kind": "func", "name": "boolval", "params": ["bool"], "return": "str"},
    {"kind": "func", "name": "i32val", "params": ["i32"], "return": "str"},
    {"kind": "func", "name": "i64val", "params": ["i64"], "return": "str"},
    {"kind": "func", "name": "nowms", "params": [], "return": "i64"}
  ]
}

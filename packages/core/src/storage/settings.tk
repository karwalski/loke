m=core.storage.settings;



i=db:std.db;
i=str:std.str;
i=json:std.json;
i=t:shared.types;
i=s:core.storage.db;

t=$settingvalue{
  $strval:str;
  $intval:i64;
  $floatval:f64;
  $boolval:bool;
  $jsonval:str
};


f=upsertsql():str{
  <"INSERT INTO settings (key,value,value_type,namespace,updated_at) VALUES (?,?,?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,value_type=excluded.value_type,updated_at=excluded.updated_at"
};

f=settingsgetstrrows(rows:@$row;key:str):str!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row=rows.get(0);
    let vtype=db.rowstr(row;"value_type");
    if(str.contains(vtype;"str")){
      <$ok(db.rowstr(row;"value"))
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  }
};

f=settingsgetintrows(rows:@$row;key:str):i64!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row=rows.get(0);
    let vtype=db.rowstr(row;"value_type");
    if(str.contains(vtype;"int")){
      <$ok(db.rowi64(row;"value"))
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  }
};

f=settingsgetboolrows(rows:@$row;key:str):i64!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row=rows.get(0);
    let vtype=db.rowstr(row;"value_type");
    if(str.contains(vtype;"bool")){
      let raw=db.rowstr(row;"value");
      if(str.contains(raw;"true")){
        <$ok(1)
      }el{
        <$ok(0)
      }
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  }
};

f=settingsgetfloatrows(rows:@$row;key:str):f64!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row=rows.get(0);
    let vtype=db.rowstr(row;"value_type");
    if(str.contains(vtype;"float")){
      <$ok(json.getfloat(row;"value"))
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  };
  <$err($storageerr(str.concat("setting not found: ";key)))
};

f=getstr(store:i64;key:str):str!$lokeerr{
  mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetstrrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getint(store:i64;key:str):i64!$lokeerr{
  mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetintrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getbool(store:i64;key:str):i64!$lokeerr{
  mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetboolrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getfloat(store:i64;key:str):f64!$lokeerr{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetfloatrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=setstr(store:i64;key:str;value:str;namespace:str):i64!$lokeerr{
  mt db.exec(upsertsql();@(key;value;"str";namespace;"now()")) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setint(store:i64;key:str;value:i64;namespace:str):i64!$lokeerr{
  let v=str.fromint(value);
  mt db.exec(upsertsql();@(key;v;"int";namespace;"now()")) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setbool(store:i64;key:str;value:bool;namespace:str):i64!$lokeerr{
  let v=mut."false";
  if(value){v="true"}el{};
  mt db.exec(upsertsql();@(key;v;"bool";namespace;"now()")) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setfloat(store:i64;key:str;value:f64;namespace:str):i64!$lokeerr{
  let v=str.fromfloat(value);
  mt db.exec(upsertsql();@(key;v;"float";namespace;"now()")) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=settingslistnsrows(rows:@$row):@str!$lokeerr{
  let keys=mut.@();
  lp(let ii145=0;ii145<rows.len;ii145=ii145+1){
    keys=keys.push(json.str(rows.get(ii145);"key"))
  };
  <$ok(keys)
};

f=listns(store:i64;namespace:str):@str!$lokeerr{
  mt db.many("SELECT key FROM settings WHERE namespace=? ORDER BY key";@(namespace)) {
    $ok:rows settingslistnsrows(rows);
    $err:e $err($storageerr(str.concat("failed to list namespace: ";namespace)))
  }
};

f=delete(store:i64;key:str):i64!$lokeerr{
  mt db.exec("DELETE FROM settings WHERE key=?";@(key)) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to delete key: ";key)))
  }
};

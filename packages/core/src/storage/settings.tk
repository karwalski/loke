m=core.storage.settings;



i=t:shared.types;
i=db:std.db;
i=s:core.storage.db;
i=str:std.str;
i=json:std.json;

t=$settingvalue{
  $strval(str);
  $intval(i64);
  $floatval(f64);
  $boolval(bool);
  $jsonval(str)
};


let upsertsql="INSERT INTO settings (key,value,value_type,namespace,updated_at) VALUES (?,?,?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,value_type=excluded.value_type,updated_at=excluded.updated_at";

f=getstr(store:$s.store;key:str):str|$lokeerr{
  db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";mt @(key)) {
    $ok:rows {
      if rows.len == 0{
        <$err($storageerr(str.concat("setting not found: ";key)))
      }else{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if str.contains(vtype;"str"){
          <$ok(json.getstr(row;"value"))
        }else{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        };
      };
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  };
};

f=getint(store:$s.store;key:str):i64|$lokeerr{
  db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";mt @(key)) {
    $ok:rows {
      if rows.len == 0{
        <$err($storageerr(str.concat("setting not found: ";key)))
      }else{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if str.contains(vtype;"int"){
          <$ok(json.getint(row;"value"))
        }else{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        };
      };
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  };
};

f=getbool(store:$s.store;key:str):bool|$lokeerr{
  db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";mt @(key)) {
    $ok:rows {
      if rows.len == 0{
        <$err($storageerr(str.concat("setting not found: ";key)))
      }else{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if str.contains(vtype;"bool"){
          let raw=json.getstr(row;"value");
          if str.contains(raw;"true"){
            <$ok(true)
          }else{
            <$ok(false)
          };
        }else{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        };
      };
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  };
};

f=getfloat(store:$s.store;key:str):f64|$lokeerr{
  db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";mt @(key)) {
    $ok:rows {
      if rows.len == 0{
        <$err($storageerr(str.concat("setting not found: ";key)))
      }else{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if str.contains(vtype;"float"){
          
          <$ok(json.getfloat(row;"value"))
        }else{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        };
      };
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  };
};

f=setstr(store:$s.store;key:str;value:str;namespace:str):void|$lokeerr{
  db.execparams(store.conn;upsertsql;@(key;value;"str";namespace;mt "now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  };
};

f=setint(store:$s.store;key:str;value:i64;namespace:str):void|$lokeerr{
  let v=str.fromint(value);
  db.execparams(store.conn;upsertsql;@(key;v;"int";namespace;mt "now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  };
};

f=setbool(store:$s.store;key:str;value:bool;namespace:str):void|$lokeerr{
  let v=if value{"true"}else{"false"};
  db.execparams(store.conn;upsertsql;@(key;v;"bool";namespace;mt "now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  };
};

f=setfloat(store:$s.store;key:str;value:f64;namespace:str):void|$lokeerr{
  let v=str.fromfloat(value);
  db.execparams(store.conn;upsertsql;@(key;v;"float";namespace;mt "now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  };
};

f=listns(store:$s.store;namespace:str):@(str)|$lokeerr{
  db.queryparams(store.conn;"SELECT key FROM settings WHERE namespace=? ORDER BY key";mt @(namespace)) {
    $ok:rows {
      let keys=rows.map|row{ json.getstr(row;"key") };
      <$ok(keys)
    };
    $err:e <$err($storageerr(str.concat("failed to list namespace: ";namespace)))
  };
};

f=delete(store:$s.store;key:str):void|$lokeerr{
  db.execparams(store.conn;"DELETE FROM settings WHERE key=?";mt @(key)) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to delete key: ";key)))
  };
};

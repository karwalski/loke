m=core.storage.settings;



i=t:shared.types;
i=db:std.db;
i=s:core.storage.db;
i=str:std.str;
i=json:std.json;

t=$settingvalue{
  $strval(str);
  $intval(i64);
  $floatval(f64);
  $boolval(bool);
  $jsonval(str)
};


let upsertsql="INSERT INTO settings (key,value,value_type,namespace,updated_at) VALUES (?,?,?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,value_type=excluded.value_type,updated_at=excluded.updated_at";

f=getstr(store:i64;key:str):str|$lokeerr{
  mt db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";@($key)) {
    $ok:rows {
      if(rows.len = 0){
        <$err($storageerr(str.concat("setting not found: ";key)))
      }el{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if(str.contains(vtype;"str")){
          <$ok(json.getstr(row;"value"))
        }el{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        }
      }
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getint(store:i64;key:str):i64|$lokeerr{
  mt db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";@($key)) {
    $ok:rows {
      if(rows.len = 0){
        <$err($storageerr(str.concat("setting not found: ";key)))
      }el{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if(str.contains(vtype;"int")){
          <$ok(json.getint(row;"value"))
        }el{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        }
      }
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getbool(store:i64;key:str):bool|$lokeerr{
  mt db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";@($key)) {
    $ok:rows {
      if(rows.len = 0){
        <$err($storageerr(str.concat("setting not found: ";key)))
      }el{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if(str.contains(vtype;"bool")){
          let raw=json.getstr(row;"value");
          if(str.contains(raw;"true")){
            <$ok(true)
          }el{
            <$ok(false)
          }
        }el{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        }
      }
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getfloat(store:i64;key:str):f64|$lokeerr{
  mt db.queryparams(store.conn;"SELECT value,value_type FROM settings WHERE key=?";@($key)) {
    $ok:rows {
      if(rows.len = 0){
        <$err($storageerr(str.concat("setting not found: ";key)))
      }el{
        let row=rows.get(0);
        let vtype=json.getstr(row;"value_type");
        if(str.contains(vtype;"float")){
          
          <$ok(json.getfloat(row;"value"))
        }el{
          <$err($storageerr(str.concat("type mismatch for key: ";key)))
        }
      }
    };
    $err:e <$err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=setstr(store:i64;key:str;value:str;namespace:str):void|$lokeerr{
  mt db.execparams(store.conn;upsertsql;@(key;value;"str";namespace;"now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setint(store:i64;key:str;value:i64;namespace:str):void|$lokeerr{
  let v=str.fromint(value);
  mt db.execparams(store.conn;upsertsql;@(key;v;"int";namespace;"now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setbool(store:i64;key:str;value:bool;namespace:str):void|$lokeerr{
  let v=if value{"true"}el{"false"};
  mt db.execparams(store.conn;upsertsql;@(key;v;"bool";namespace;"now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setfloat(store:i64;key:str;value:f64;namespace:str):void|$lokeerr{
  let v=str.fromfloat(value);
  mt db.execparams(store.conn;upsertsql;@(key;v;"float";namespace;"now()")) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=listns(store:i64;namespace:str):@str|$lokeerr{
  mt db.queryparams(store.conn;"SELECT key FROM settings WHERE namespace=? ORDER BY key";@($namespace)) {
    $ok:rows {
      let keys=rows.map|row{ json.getstr(row;"key") };
      <$ok(keys)
    };
    $err:e <$err($storageerr(str.concat("failed to list namespace: ";namespace)))
  }
};

f=delete(store:i64;key:str):void|$lokeerr{
  mt db.execparams(store.conn;"DELETE FROM settings WHERE key=?";@($key)) {
    $ok: <$ok(void);
    $err:e <$err($storageerr(str.concat("failed to delete key: ";key)))
  }
};

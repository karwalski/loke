m=core.storage.settings;



i=db:std.db;
i=str:std.str;
i=t:shared.types;
i=s:core.storage.db;

t=$settingvalue{
  $strval:str;
  $intval:i64;
  $floatval:f64;
  $boolval:bool;
  $jsonval:str
};


(* `datetime('now')` inline, not a bound parameter.
   The fifth placeholder used to be bound to the four-character string `"now()"`, so every row
   in the settings table recorded its update time as the literal text "now()" — a parameter is
   a value, never an expression, so SQLite stored exactly what it was given. GA5.1, in its
   third location after the audit trail and the job queue.

   `datetime('now')` in the statement text is the pattern `sync_queue.tk:69` already uses, and
   it keeps the clock where the write happens rather than plumbing a timestamp through four
   setters. The column is TEXT (migrations.tk:42), so an ISO-8601 string is the right shape;
   `excluded.updated_at` still carries it on the conflict path. *)
f=upsertsql():str{
  <"INSERT INTO settings (key,value,value_type,namespace,updated_at) VALUES (?,?,?,?,datetime('now')) ON CONFLICT(key) DO UPDATE SET value=excluded.value,value_type=excluded.value_type,updated_at=excluded.updated_at"
};

f=settingsgetstrrows(rows:@$dbrow;key:str):str!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row=rows.get(0);
    if(str.contains(db.rowstr(row;"value_type");"str")){
      <$ok(db.rowstr(row;"value"))
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  }
};

f=settingsgetintrows(rows:@$dbrow;key:str):i64!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row=rows.get(0);
    if(str.contains(db.rowstr(row;"value_type");"int")){
      <$ok(db.rowi64(row;"value"))
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  }
};

f=settingsgetboolrows(rows:@$dbrow;key:str):i64!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row=rows.get(0);
    if(str.contains(db.rowstr(row;"value_type");"bool")){
      if(str.contains(db.rowstr(row;"value");"true")){
        <$ok(1)
      }el{
        <$ok(0)
      }
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  }
};

(* The row accessors are core.storage.db's, not std.json's. The two reads below used
   json.getfloat and json.str on a $dbrow, which is not a JSON object: getfloat returned
   0.0 for every float setting the store held, and listns returned a list of empty
   strings with the right length. Both failed silently — no error, no log.

   value is stored as TEXT by setfloat (str.fromfloat), so it is read as HUNDREDTHS in
   an i64 and divided here (T-22). The f64 this returns crosses a module boundary intact
   since toke 3.1.0 (T-20, LS1.1h). *)
f=settingsgetfloatrows(rows:@$dbrow;key:str):f64!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("setting not found: ";key)))
  }el{
    let row:$dbrow=rows.get(0);
    if(str.contains(db.rowstr(row;"value_type");"float")){
      <$ok((s.rowf64hundredths(row;"value") as f64) / 100.0)
    }el{
      <$err($storageerr(str.concat("type mismatch for key: ";key)))
    }
  };
  <$err($storageerr(str.concat("setting not found: ";key)))
};

f=getstr(store:i64;key:str):str!$lokeerr{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetstrrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getint(store:i64;key:str):i64!$lokeerr{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetintrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getbool(store:i64;key:str):i64!$lokeerr{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetboolrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

f=getfloat(store:i64;key:str):f64!$lokeerr{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows settingsgetfloatrows(rows;key);
    $err:e $err($storageerr(str.concat("db error reading key: ";key)))
  }
};

(* Reads that carry their own default, and never wrap the answer in a result.

   A result-returning getter cannot be used to supply a fallback here. toke takes the
   FIRST arm of a match on X!$err whatever the value is (T-18 in
   docs/upstream/toke-issues.md), so the `$err:` arm is dead code: on failure the
   caller binds the ERROR payload as if it were the value. That is how an engaged kill
   switch came to report itself disengaged — core.governance.killswitch wrote the flag
   with setbool ("bool") and read it back with getstr, which refuses any non-"str" row,
   and the "false" in the $err arm never ran.

   So the default is applied HERE, by a plain `if` on the row count, and the caller gets
   a plain value it cannot misread. The declared value_type is not re-checked: every
   setter stores the value as text in the same column, so reading it back as text is
   what the data actually is. *)
f=strrowsor(rows:@$dbrow;dflt:str):str{
  if(rows.len == 0){
    <dflt
  }el{
    <db.rowstr(rows.get(0);"value")
  }
};

f=introwsor(rows:@$dbrow;dflt:i64):i64{
  if(rows.len == 0){
    <dflt
  }el{
    <db.rowi64(rows.get(0);"value")
  }
};

f=boolrowsor(rows:@$dbrow;dflt:bool):bool{
  if(rows.len == 0){
    <dflt
  }el{
    <str.eq(db.rowstr(rows.get(0);"value");"true")
  }
};

f=getstror(store:i64;key:str;dflt:str):str{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows strrowsor(rows;dflt);
    $err:e dflt
  }
};

f=getintor(store:i64;key:str;dflt:i64):i64{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows introwsor(rows;dflt);
    $err:e dflt
  }
};

f=getboolor(store:i64;key:str;dflt:bool):bool{
  <mt db.many("SELECT value,value_type FROM settings WHERE key=?";@(key)) {
    $ok:rows boolrowsor(rows;dflt);
    $err:e dflt
  }
};

f=setstr(store:i64;key:str;value:str;namespace:str):i64!$lokeerr{
  <mt db.exec(upsertsql();@(key;value;"str";namespace)) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setint(store:i64;key:str;value:i64;namespace:str):i64!$lokeerr{
  let v=str.fromint(value);
  <mt db.exec(upsertsql();@(key;v;"int";namespace)) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setbool(store:i64;key:str;value:bool;namespace:str):i64!$lokeerr{
  let v=mut."false";
  if(value){v="true"}el{};
  <mt db.exec(upsertsql();@(key;v;"bool";namespace)) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=setfloat(store:i64;key:str;value:f64;namespace:str):i64!$lokeerr{
  let v=str.fromfloat(value);
  <mt db.exec(upsertsql();@(key;v;"float";namespace)) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to set key: ";key)))
  }
};

f=settingslistnsrows(rows:@$dbrow):@str!$lokeerr{
  let keys=mut.@();
  lp(let ii145=0;ii145<rows.len;ii145=ii145+1){
    keys=keys.push(s.rowstr(rows.get(ii145);"key"))
  };
  <$ok(keys)
};

f=listns(store:i64;namespace:str):@str!$lokeerr{
  <mt db.many("SELECT key FROM settings WHERE namespace=? ORDER BY key";@(namespace)) {
    $ok:rows settingslistnsrows(rows);
    $err:e $err($storageerr(str.concat("failed to list namespace: ";namespace)))
  }
};

f=delete(store:i64;key:str):i64!$lokeerr{
  <mt db.exec("DELETE FROM settings WHERE key=?";@(key)) {
    $ok:v $ok(1);
    $err:e $err($storageerr(str.concat("failed to delete key: ";key)))
  }
};

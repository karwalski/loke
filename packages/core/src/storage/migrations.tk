m=core.storage.migrations;


(* One migration is ONE SQL statement, and that is a constraint of the runner rather
   than a style choice.

   core.storage.db.runmigrations applies each `sql` with std.db.exec, which is
   sqlite3_prepare_v2 followed by a step. prepare_v2 compiles the FIRST statement in
   the string and hands back a tail pointer that db.exec discards, so a migration
   holding two statements separated by a semicolon applies the first and silently
   reports success for both. Nothing in the runner can see that. So a change needing
   two statements gets two migration entries with consecutive versions, as versions 6
   and 7 below do. *)
t=$migration{
  version:u32;
  description:str;
  sql:str
};

(* ── The memory palace's tables ───────────────────────────────────────────────────
   These live here, in the migrations, rather than only in `core.memory.schema`, and the
   reason is T-30. `std.db` keeps ONE global connection: `db.open` returns something shaped
   like a handle, but `conn_db` resolves only id 0, so a second `db.open` silently replaces
   the first. The memory palace used to open its own `datadir/memory.db`, which hijacked the
   process's connection — after that, `audit_log` and `settings` did not exist for any reader,
   and before it `memory_drawers` did not. Both directions failed silently, because the row
   accessors map a failed read to 0 or "".

   So there is one database, and anything in it is created by the migration runner like
   everything else. `core.memory.schema.createtables` calls these same functions, so the DDL
   has one definition: a palace opened against a store whose migrations have already run finds
   the tables present, and `CREATE TABLE IF NOT EXISTS` makes the second call a no-op.

   `memory_scores` is the one that had no creator ANYWHERE — it was absent from
   `core.memory.schema` as well, while `memory/decay.tk`, `memory/export.tk` and
   `memory/privacy.tk` all read and write it. That is the root of M1.7.

   Its `created_at` defaults to `datetime('now')` in the DDL rather than being supplied by a
   writer, because supplying it is what went wrong everywhere else (GA5.1: eleven sites stored
   the literal text `now()`). A default the database computes cannot be got wrong by a caller. *)
f=memdrawerssql():str{
  <"CREATE TABLE IF NOT EXISTS memory_drawers (
  id TEXT PRIMARY KEY,
  wing TEXT NOT NULL,
  hall TEXT NOT NULL,
  room TEXT NOT NULL,
  role TEXT NOT NULL,
  content TEXT NOT NULL,
  session_id TEXT,
  model_id TEXT,
  tokens INTEGER DEFAULT 0,
  sensitivity TEXT DEFAULT 'PUBLIC',
  created_at TEXT NOT NULL
)"
};

f=memclosetssql():str{
  <"CREATE TABLE IF NOT EXISTS memory_closets (
  id TEXT PRIMARY KEY,
  wing TEXT NOT NULL,
  hall TEXT NOT NULL,
  room TEXT NOT NULL,
  aaak_summary TEXT NOT NULL,
  drawer_ids TEXT NOT NULL,
  created_at TEXT NOT NULL
)"
};

f=memindexsql():str{
  <"CREATE TABLE IF NOT EXISTS memory_index (
  drawer_id TEXT NOT NULL,
  keyword TEXT NOT NULL,
  weight REAL DEFAULT 1.0,
  PRIMARY KEY (drawer_id, keyword)
)"
};

f=memscoressql():str{
  <"CREATE TABLE IF NOT EXISTS memory_scores (
  id TEXT PRIMARY KEY,
  score REAL NOT NULL DEFAULT 1.0,
  tags TEXT NOT NULL DEFAULT '',
  pii_flagged INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  accessed_at TEXT
)"
};

f=memdrawersidxsql():str{
  <"CREATE INDEX IF NOT EXISTS idx_drawers_location ON memory_drawers(wing, hall, room)"
};

f=memkeywordidxsql():str{
  <"CREATE INDEX IF NOT EXISTS idx_index_keyword ON memory_index(keyword)"
};

f=mempiiidxsql():str{
  <"CREATE INDEX IF NOT EXISTS idx_scores_pii ON memory_scores(pii_flagged)"
};

(* ── Four tables that no migration created ────────────────────────────────────────
   Measured 2026-09-24 by collecting every table named in a `FROM`, `INTO`, `UPDATE` or `JOIN`
   across `packages/core/src` and subtracting every `CREATE TABLE IF NOT EXISTS` anywhere in the
   tree — not just here, because several modules create their own at runtime. Five tables came
   back created NOWHERE. Four of them are here; the fifth, `audit_entries`, is a different
   problem and is filed as GA5.12 rather than created, because creating it would give loke a
   SECOND audit trail.

   `memory_graph_entities`, `memory_graph_relations` and `memory_settings` are M1.7's remaining
   three — `memory_scores` was the fourth and landed with the palace in versions 10-16. Until
   now every read in `core.memory.graph` and `core.memory.privacy` failed against a table that
   was not there, and the row accessors map a failed read to `0` or `""` (LS1.1i), so **every
   field of every memory-graph entity and relation was empty or zero and nothing reported it**.

   `metrics_raw` is DA1.2's subject, and `core.metrics.collector` is the only writer. Its
   `record` built a 15-placeholder INSERT against a table that did not exist, so no metric event
   this project ever emitted was stored — which is worth stating plainly next to `eval/bench.tk`
   reporting 0 ms for every benchmark (LS1.1q): between them, nothing measurable was being
   measured.

   Types follow what the code actually writes, not what would be tidiest. `confidence` and
   `weight` are REAL because `memory/graph.tk` reads them through `s.rowf64hundredths` and
   divides by 100. The `metrics_raw` counters are INTEGER and the costs REAL, matching the
   `str.fromint` / `str.fromfloat` in `collector.record`. `timestamp` is INTEGER because
   `event.timestamp` is an i64 and the summary query does arithmetic on it — unlike `created_at`
   elsewhere in this schema, which is TEXT from `datetime('now')`. That inconsistency is real and
   is left alone deliberately: changing it would change what `collector.summarise` returns. *)
f=memgraphentitiessql():str{
  <"CREATE TABLE IF NOT EXISTS memory_graph_entities (
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  kind TEXT NOT NULL,
  summary TEXT NOT NULL DEFAULT '',
  confidence REAL NOT NULL DEFAULT 1.0,
  created_at TEXT NOT NULL DEFAULT (datetime('now'))
)"
};

f=memgraphrelationssql():str{
  <"CREATE TABLE IF NOT EXISTS memory_graph_relations (
  from_id TEXT NOT NULL,
  to_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  weight REAL NOT NULL DEFAULT 1.0,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  PRIMARY KEY (from_id, to_id, kind)
)"
};

f=memsettingssql():str{
  <"CREATE TABLE IF NOT EXISTS memory_settings (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
)"
};

f=metricsrawsql():str{
  <"CREATE TABLE IF NOT EXISTS metrics_raw (
  request_id TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  tokens_before INTEGER NOT NULL DEFAULT 0,
  tokens_after INTEGER NOT NULL DEFAULT 0,
  tokens_saved INTEGER NOT NULL DEFAULT 0,
  cost_before REAL NOT NULL DEFAULT 0.0,
  cost_after REAL NOT NULL DEFAULT 0.0,
  cost_saved REAL NOT NULL DEFAULT 0.0,
  pii_found INTEGER NOT NULL DEFAULT 0,
  pii_blocked INTEGER NOT NULL DEFAULT 0,
  routed_local INTEGER NOT NULL DEFAULT 0,
  cache_hit INTEGER NOT NULL DEFAULT 0,
  model_id TEXT NOT NULL DEFAULT '',
  provider_id TEXT NOT NULL DEFAULT '',
  savings_by_stage TEXT NOT NULL DEFAULT ''
)"
};

f=memgraphfromidxsql():str{
  <"CREATE INDEX IF NOT EXISTS idx_graph_rel_from ON memory_graph_relations(from_id)"
};

f=memgraphtoidxsql():str{
  <"CREATE INDEX IF NOT EXISTS idx_graph_rel_to ON memory_graph_relations(to_id)"
};

f=metricsrawtsidxsql():str{
  <"CREATE INDEX IF NOT EXISTS idx_metrics_raw_ts ON metrics_raw(timestamp)"
};

(* ── Two more tables that nothing created ─────────────────────────────────────────
   Found 2026-09-24 by `scripts/find_uncreated_tables.py` once it was narrowed enough to be
   readable. Both are written AND read by their modules, so both were silently empty:

   `compliance_events` — `core.policy.feedback` inserts a row per policy evaluation and then
   counts violations over a time window. With no table, every insert failed and every count
   returned zero, so **a policy-violation rate computed from it was always 0%** — the most
   flattering possible number, reported as though measured.

   `kv` — `core.storage.db`'s own generic key/value helpers at lines 309 and 317. A `SELECT value
   FROM kv` against a missing table returns nothing and the row accessors map that to `""`
   (LS1.1i), so every read answered "no value set".

   `timestamp` is INTEGER here because `policy/feedback.tk` compares it against `i64` bounds, the
   same reason `metrics_raw.timestamp` is. `violated` and `user_override` are INTEGER because
   toke has no boolean column type and the module writes 0/1. *)
f=complianceeventssql():str{
  <"CREATE TABLE IF NOT EXISTS compliance_events (
  request_id TEXT NOT NULL,
  policy_id TEXT NOT NULL,
  regulation TEXT NOT NULL DEFAULT '',
  violated INTEGER NOT NULL DEFAULT 0,
  user_override INTEGER NOT NULL DEFAULT 0,
  timestamp INTEGER NOT NULL
)"
};

f=kvsql():str{
  <"CREATE TABLE IF NOT EXISTS kv (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL,
  component TEXT NOT NULL DEFAULT ''
)"
};

f=complianceeventstsidxsql():str{
  <"CREATE INDEX IF NOT EXISTS idx_compliance_events_ts ON compliance_events(timestamp)"
};

f=allmigrations():@$migration{
  <@(
    $migration{
      version:1;
      description:"create schema_migrations table";
      sql:"CREATE TABLE IF NOT EXISTS schema_migrations (
  version INTEGER PRIMARY KEY,
  applied_at TEXT NOT NULL,
  description TEXT NOT NULL
)"
    };
    $migration{
      version:2;
      description:"create settings table";
      sql:"CREATE TABLE IF NOT EXISTS settings (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL,
  value_type TEXT NOT NULL,
  namespace TEXT NOT NULL DEFAULT 'loke',
  updated_at TEXT NOT NULL
)"
    };
    $migration{
      version:3;
      description:"create audit_log table";
      sql:"CREATE TABLE IF NOT EXISTS audit_log (
  id TEXT PRIMARY KEY,
  event_type TEXT NOT NULL,
  use_case TEXT NOT NULL,
  model_id TEXT NOT NULL,
  provider TEXT NOT NULL,
  sensitivity TEXT NOT NULL,
  risk_tier TEXT NOT NULL,
  tokens_in INTEGER,
  tokens_out INTEGER,
  cost_usd REAL,
  duration_ms INTEGER,
  correlation_id TEXT NOT NULL,
  prev_hash TEXT,
  hash TEXT NOT NULL,
  created_at TEXT NOT NULL
)"
    };
    $migration{
      version:4;
      description:"create placeholder_maps table";
      sql:"CREATE TABLE IF NOT EXISTS placeholder_maps (
  id TEXT PRIMARY KEY,
  request_id TEXT NOT NULL,
  original TEXT NOT NULL,
  placeholder TEXT NOT NULL,
  entity_type TEXT NOT NULL,
  created_at TEXT NOT NULL,
  expires_at TEXT
)"
    };
    $migration{
      version:5;
      description:"create sessions table";
      sql:"CREATE TABLE IF NOT EXISTS sessions (
  id TEXT PRIMARY KEY,
  name TEXT,
  mode TEXT NOT NULL,
  created_at TEXT NOT NULL,
  last_active_at TEXT NOT NULL
)"
    };
    (* GA5.9 — append-only on audit_log, enforced by the database rather than asserted
       in prose.

       Until now the trail was DESCRIBED as append-only and nothing stopped an ordinary
       UPDATE or DELETE: no trigger, no constraint, no check. The hash chain (GA5.2) made
       modification DETECTABLE after the fact; it never made it difficult. Those are
       different controls and the claim needs both.

       What these two triggers do and do not buy, stated plainly because the difference
       decides how much the claim is worth:

         - They stop every UPDATE and every DELETE that arrives over an ordinary SQLite
           connection, including loke's own code, including a hand-typed statement in the
           sqlite3 shell, including a DSAR erasure that tried to sweep the trail. Nothing
           in the product has an exemption and there is no flag to turn them off.
         - They do NOT stop an attacker who can already execute arbitrary SQL against the
           file, because such an attacker can DROP TRIGGER first. Nor do they stop one who
           can edit the file's bytes directly, or replace the file.

       So the trigger is the control against accident and against ordinary application
       paths, and the hash chain is the control against the attacker who defeats the
       trigger. Neither is sufficient; together they are what "tamper-evident, append-only"
       can honestly mean for a local SQLite file that the user owns and can read.

       That layering is why tests/integration/test_audit_trail_e2e.tk drops these triggers
       before it tampers: dropping them is exactly the move the threat model already grants
       that attacker, so the tamper tests keep exercising the real schema and the real
       verifier without any test-only escape hatch existing in the product.

       core.storage.db.auditappendonlyenforced() reads back whether both triggers are
       present, so the claim is evidenced at run time and a future migration that rebuilds
       audit_log cannot drop the control silently. *)
    $migration{
      version:6;
      description:"enforce append-only on audit_log: reject UPDATE";
      sql:"CREATE TRIGGER IF NOT EXISTS audit_log_append_only_update
BEFORE UPDATE ON audit_log
BEGIN
  SELECT RAISE(ABORT, 'audit_log is append-only: UPDATE is not permitted');
END"
    };
    $migration{
      version:7;
      description:"enforce append-only on audit_log: reject DELETE";
      sql:"CREATE TRIGGER IF NOT EXISTS audit_log_append_only_delete
BEFORE DELETE ON audit_log
BEGIN
  SELECT RAISE(ABORT, 'audit_log is append-only: DELETE is not permitted');
END"
    };
    (* X8.2 — the sealed mapping table, and the deliberate absence of a plaintext column.

       placeholder_maps, version 4 above, had `original TEXT NOT NULL` and
       `placeholder TEXT NOT NULL`: the pairing that turns an anonymised transcript back
       into named people, in the clear, in a file the user's other processes can read. It
       is rated Maximum in docs/threat-model.md:181 and it is the highest-value data loke
       holds.

       This table has NO column a plaintext value fits in. That is the point of replacing
       the table rather than adding columns to it: a future writer cannot put a name in
       here by accident, because there is nowhere for one to go. request_id and the
       timestamps are the only cleartext, and they have to be — the row is looked up by
       request id and expired by date.

       ONE ROW PER REQUEST, not one per entity, and that is a privacy property rather than
       a normalisation preference. Per-entity rows would make the row count for a request
       equal to the number of entities detected in it, so `SELECT COUNT() ... WHERE
       request_id=?` would report how many people a prompt mentioned to anybody who can
       read the file — metadata about the subject, derived without the key. With one row
       the whole mapping list is a single sealed payload and that count is not there to be
       read. What remains is payload LENGTH, which is padded to a 256-byte boundary before
       sealing so that short maps are indistinguishable from one another; a long map still
       falls into a visible bucket, and that residual is stated in placeholderstore rather
       than papered over.

       payload_hex and nonce_hex are TEXT holding lowercase hex, NOT blobs. A BLOB read
       back as text is a value whose representation SQLite chooses, and this project has
       been bitten twice by exactly that — str.fromfloat(0.0) writing "0" where a REAL
       column returns "0.0" broke the audit chain. Hex in a TEXT column has one spelling,
       so what is read is what was written, byte for byte.

       key_version records which HKDF info label sealed the row, so the derived key can be
       rotated without a migration that rewrites ciphertext. *)
    $migration{
      version:8;
      description:"create placeholder_map_records: the sealed mapping table";
      sql:"CREATE TABLE IF NOT EXISTS placeholder_map_records (
  request_id TEXT PRIMARY KEY,
  key_version INTEGER NOT NULL,
  nonce_hex TEXT NOT NULL,
  payload_hex TEXT NOT NULL,
  created_at TEXT NOT NULL,
  expires_at TEXT
)"
    };
    (* And the old plaintext table goes. Nothing ever wrote to it — core.privacy.
       placeholderstore was the only module that named it and no caller in the repository
       called that module — so there are no rows to migrate and no data to lose. Leaving it
       in place would leave a plaintext-shaped hole in the schema for a future writer to
       fall into, which is the whole reason X8.2 replaces the table instead of extending
       it.

       DROP frees the table's pages. core.storage.db.openstore sets PRAGMA secure_delete
       BEFORE running migrations so that on an installation which somehow does hold rows
       here, those pages are zeroed rather than merely unlinked — measured to happen, see
       applysecuredelete in that module. One statement per migration: the runner applies
       only the first statement of a multi-statement string and reports success for the
       rest. *)
    $migration{
      version:9;
      description:"drop the plaintext placeholder_maps table, superseded by placeholder_map_records";
      sql:"DROP TABLE IF EXISTS placeholder_maps"
    };
    (* Versions 10-16: the memory palace, moved into the one database this toolchain can
       address. Seven entries because one migration is ONE statement — see the note at the
       top of this file. *)
    $migration{
      version:10;
      description:"create memory_drawers";
      sql:memdrawerssql()
    };
    $migration{
      version:11;
      description:"create memory_closets";
      sql:memclosetssql()
    };
    $migration{
      version:12;
      description:"create memory_index";
      sql:memindexsql()
    };
    $migration{
      version:13;
      description:"create memory_scores, which had no creator anywhere (M1.7)";
      sql:memscoressql()
    };
    $migration{
      version:14;
      description:"index memory_drawers by location";
      sql:memdrawersidxsql()
    };
    $migration{
      version:15;
      description:"index memory_index by keyword";
      sql:memkeywordidxsql()
    };
    $migration{
      version:16;
      description:"index memory_scores by pii_flagged";
      sql:mempiiidxsql()
    };
    (* Versions 17-23: four tables that no migration created and the indexes they need.
       One statement per migration — see the note at the top of this file. *)
    $migration{
      version:17;
      description:"create memory_graph_entities (M1.7)";
      sql:memgraphentitiessql()
    };
    $migration{
      version:18;
      description:"create memory_graph_relations (M1.7)";
      sql:memgraphrelationssql()
    };
    $migration{
      version:19;
      description:"create memory_settings (M1.7)";
      sql:memsettingssql()
    };
    $migration{
      version:20;
      description:"create metrics_raw, which core.metrics.collector is the only writer to (DA1.2)";
      sql:metricsrawsql()
    };
    $migration{
      version:21;
      description:"index memory_graph_relations by from_id";
      sql:memgraphfromidxsql()
    };
    $migration{
      version:22;
      description:"index memory_graph_relations by to_id";
      sql:memgraphtoidxsql()
    };
    $migration{
      version:23;
      description:"index metrics_raw by timestamp, which every summary query filters on";
      sql:metricsrawtsidxsql()
    };
    $migration{
      version:24;
      description:"create compliance_events, so a violation rate is measured rather than always 0%";
      sql:complianceeventssql()
    };
    $migration{
      version:25;
      description:"create kv, core.storage.db's own key/value helpers";
      sql:kvsql()
    };
    $migration{
      version:26;
      description:"index compliance_events by timestamp, which both count queries filter on";
      sql:complianceeventstsidxsql()
    };
    (* GA5.15 — two migrations, because db.exec applies one statement (T-40). Rename, not
       rebuild: RENAME COLUMN is a schema change and rewrites no row, so the append-only
       triggers are not engaged and no hashed value moves. See core.storage.db.auditcostcols. *)
    $migration{
      version:27;
      description:"rename audit_log.cost_usd to cost_usd_legacy_dollars, so a stale reader fails loudly (GA5.15)";
      sql:"ALTER TABLE audit_log RENAME COLUMN cost_usd TO cost_usd_legacy_dollars"
    };
    $migration{
      version:28;
      description:"add audit_log.cost_usd_cents, an exact integer (GA5.15)";
      sql:"ALTER TABLE audit_log ADD COLUMN cost_usd_cents INTEGER"
    };
    (* DA1.6 - output tokens. metrics_raw recorded tokens before and after optimisation, which
       are both INPUT counts, and had nowhere for what the provider returned, so a
       per-provider breakdown could not report tokens out without inventing a figure. *)
    $migration{
      version:29;
      description:"add metrics_raw.tokens_out, the provider-reported output tokens (DA1.6)";
      sql:"ALTER TABLE metrics_raw ADD COLUMN tokens_out INTEGER NOT NULL DEFAULT 0"
    }
  )
};

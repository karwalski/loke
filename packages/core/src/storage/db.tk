m=core.storage.db;


i=t:shared.types;
i=db:std.db;
i=str:std.str;
i=m:core.storage.migrations;

t=$dbconn{handle:i64};

t=$store{
  conn:$dbconn;
  datadir:str
};

f=openstore(datadir:str):$store!$lokeerr{
  let path=str.concat(datadir;"/loke.db");
  let conn=mt db.open(path) {
    $ok:conn conn;
    $err:e $err($storageerr(str.concat("failed to open database: ";path)))
  };
  mt runmigrations(conn) {
    $ok:v2 $ok($store{conn:conn;datadir:datadir});
    $err:e $err(e)
  }
};

f=runmigrations(conn:$dbconn):i64!$lokeerr{
  let createsql="CREATE TABLE IF NOT EXISTS schema_migrations (
  version INTEGER PRIMARY KEY,
  applied_at TEXT NOT NULL,
  description TEXT NOT NULL
)";
  mt db.exec(conn;createsql) {
    $ok:v 1;
    $err:e $err($storageerr("failed to create schema_migrations table"))
  };
  let migrations=m.allmigrations();
  lp(let mi=0;mi<migrations.len;mi=mi+1){
  let mg=migrations.get(mi);
    let verstr=str.fromint(mg.version);
    let checksql=str.concat("SELECT version FROM schema_migrations WHERE version=";verstr);
    let exists=mt db.queryone(conn;checksql) {
      $ok:v true;
      $err:v false
    };
    if(!exists){
      mt db.exec(conn;mg.sql) {
        $ok:v 1;
        $err:e $err($storageerr(str.concat("migration failed: ";mg.description)))
      };
      mt db.execparams(conn;"INSERT INTO schema_migrations (version,applied_at,description) VALUES (?,?,?)";@(verstr;"now()";mg.description)) {
        $ok:v 1;
        $err:e $err($storageerr(str.concat("failed to record migration: ";mg.description)))
      };
    };
  };
  <$ok(1)
};

f=closestore(store:$store):void{

  <void
};

f=exec(store:$store;sql:str):i64!$lokeerr{
  mt db.exec(store.conn;sql) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("exec failed: ";sql)))
  }
};

f=execparams(store:$store;sql:str;params:@str):i64!$lokeerr{
  mt db.execparams(store.conn;sql;params) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("execparams failed: ";sql)))
  }
};

f=query(store:$store;sql:str):i64!$lokeerr{
  mt db.many(store.conn;sql) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("query failed: ";sql)))
  }
};

f=queryone(store:$store;sql:str):i64!$lokeerr{
  mt db.one(store.conn;sql) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("queryone failed: ";sql)))
  }
};

f=queryparams(store:$store;sql:str;params:@str):i64!$lokeerr{
  mt db.manyparams(store.conn;sql;params) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("queryparams failed: ";sql)))
  }
};

f=getstr(store:$store;key:str):str!$lokeerr{
  let sql=str.concat("SELECT value FROM kv WHERE key='";str.concat(key;"'"));
  mt db.one(store.conn;sql) {
    $ok:v $ok(db.rowstr(v;0;0));
    $err:e $err($storageerr(str.concat("getstr failed for key: ";key)))
  }
};

f=setstr(store:$store;key:str;val:str;component:str):i64!$lokeerr{
  mt db.execparams(store.conn;"INSERT OR REPLACE INTO kv (key,value,component) VALUES (?,?,?)";@(key;val;component)) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("setstr failed for key: ";key)))
  }
};

f=rowstr(rows:i64;idx:i64;col:i64):str{
  <db.rowstr(rows;idx;col)
};

f=rowi64(rows:i64;idx:i64;col:i64):i64{
  <db.rowi64(rows;idx;col)
};

f=rowi32(rows:i64;idx:i64;col:i64):i32{
  <db.rowi32(rows;idx;col)
};

f=rowbool(rows:i64;idx:i64;col:i64):bool{
  <db.rowbool(rows;idx;col)
};

f=rowget(rows:i64;idx:i64):i64{
  <db.rowget(rows;idx)
};

f=rowslen(rows:i64):i64{
  <db.rowslen(rows)
};

f=boolval(b:bool):str{
  if(b){<"1"};
  <"0"
};

f=i32val(n:i32):str{
  <str.fromint(n)
};

f=i64val(n:i64):str{
  <str.fromint(n)
};

f=nowms():i64{
  <db.nowms()
};

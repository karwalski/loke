(* Copyright 2026 loke contributors
   SPDX-License-Identifier: Apache-2.0 *)

m=core.storage.db;


i=db:std.db;
i=file:std.file;
i=str:std.str;
i=crypto:std.crypto;
i=kc:core.storage.keychain;
i=log:shared.log;
i=m:core.storage.migrations;
i=t:shared.types;

t=$dbconn{handle:i64};

t=$store{
  conn:$dbconn;
  datadir:str
};

(* GA5.11 — a resolved reporting window, in the same units audit_log.created_at is
   written in: milliseconds since the Unix epoch.

   A plain struct with a predicate, not a result. T-18 makes the error arm of a
   user-declared sum dead, and the failure this has to report — "I could not make sense
   of the dates you gave me" — must not read as success, because the symptom of reading
   it as success is a window that matches nothing, which is the exact defect GA5.11
   exists to remove. See msrangeof below. *)
t=$msrange{
  startms:i64;
  endms:i64;
  ok:bool
};

(* X8.3 — what resolvedbkey (below) did. ensuredbkey needs only .key; the X8.3 test needs
   the decision, because on a locked keychain "refused" and "generated but could not
   store" both end in an empty key, and only the first is correct. action is
   dbkeyaction's answer; kind is the keychain's error kind from the call that settled
   the outcome ("" on success). *)
t=$dbkeyresult{
  key:str;
  action:i64;
  kind:str
};

(* X8.3 — the key comes from the OS keychain and from nowhere else.

   WHAT WAS HERE, AND WHY IT IS GONE. ensuredbkey used to read LOKE_DB_KEY from the
   environment BEFORE the keychain and return it if it was 64 characters long. That is
   exactly the fallback X8.3 forbids: an environment variable is readable by any process
   running as the user and writable by anything that can set the process environment, so
   a key delivered that way is a key an attacker can both read and choose. A store whose
   records were sealed under an attacker-chosen key is a store the attacker can read.

   It was not there out of laziness. core.storage.keychain.getdbkey reaches
   SecItemCopyMatching, which on macOS blocks on an authorisation dialog when the calling
   binary is not the one that stored the item. A headless process — CI, a test runner,
   loke started by launchd — can never answer that dialog, so the read does not fail: it
   HANGS, indefinitely, with the store half-open. toke offers no way to time-bound a
   keychain read, so once the block starts loke cannot recover from it. Two integration
   tests hung the whole suite on this, and the env fallback is what unhung them.

   THE FIX IS NOT A BUILD GATE. A flag saying "this is a test build" would still leave a
   branch in the shipped binary that takes a key from ambient state, and the security of
   the store would then rest on the flag being false — one more thing to get wrong, and
   invisible in a crash report. Instead the reason the fallback was load-bearing has been
   removed:

     1. openstore no longer calls this function at all. It called it to feed a
        `PRAGMA key` that X8.1 deleted, so since X8.1 it has been fetching a key it does
        not use — which is the ONLY reason merely OPENING the database could block on the
        keychain. Opening a store now touches no secret material whatsoever.
     2. The one consumer of this key, core.privacy.placeholderstore, takes the secret as
        a PARAMETER. Production resolves it here, once, with no branch; tests construct a
        64-character secret of their own and pass it in. So there is no ambient input
        anywhere on the production path that can redirect which key is used, and nothing
        to gate: the difference between a test and production is which function calls
        which, not which value some variable happens to hold.

   Since toke 3.1.0 the keychain calls themselves are exercised too, against a throwaway
   keychain file with user interaction disallowed (X8.7): tests/unit/storage/
   test_dbkey_keychain.tk runs resolvedbkey on an absent item, a present one, and a
   LOCKED keychain with and without the item. What remains untested is the authorisation
   dialog on the user's own login keychain, which no test may touch.

   dbkeyfromenv, which read LOKE_DB_KEY and was kept only so tests/unit/storage/test_db.tk
   could assert that it did, is DELETED (2026-09-27). A function in the storage module that
   returns a key from the environment is the fallback X8.3 forbids waiting for a caller;
   nothing called it, and the next person looking for "the key" would have found it first.

   A failure returns "", not a result type. T-18 makes the error arm of a user-declared
   sum dead, so a `str!$lokeerr` here would report every failure as success; "" is a
   value no 64-character hex key can take and every caller has to test length before it
   can derive anything. *)

(* X8.3 — what ensuredbkey does with what the keychain told it, as a pure function so the
   decision is testable without touching the keychain. Its inputs are what ONE read of the
   item returned: the value, and std.keychain.lasterrkind() for that read.

     1  use the stored secret: the read returned 64 characters.
     2  generate and store one: the read failed with kind "notfound" — there is NO item. On
        first use that is simply first use. If the item was REMOVED, rows sealed under the
        old key stay sealed and fail to open under the new one, which is what X8.3
        requires: removing the keychain entry makes the store unreadable, never
        transparently readable.
     0  refuse: anything else. Either an item exists but did not read back as a usable
        secret (kind "", value malformed or empty), or the READ ITSELF failed — "locked",
        "denied", "nokeychain", "badarg", "unavailable", "failed", or a kind this code has
        never heard of. None of those says whether an item exists.

   Two branches used to be wrong. (a) ensuredbkey fell through to "generate and store"
   whenever the read did not return 64 characters, and keychain.set is an update-or-add,
   so a single failed read OVERWROTE the key that every stored mapping was sealed under
   and made all of them permanently unreadable. (b) Until toke 3.1.0, std.keychain.exists
   was a bool that was true only on errSecSuccess, so "no such item" and "the query
   failed" were the same false, and a locked or denied keychain took the generate branch.
   3.1.0 says why a call failed (keychain.lasterrkind), and "notfound" is the ONLY kind
   that means absent, so it is the only kind that may generate. Every other kind fails
   closed: the operation that wanted the key fails, the key survives, and the next attempt
   can succeed. Generating instead would orphan every mapping sealed under the real key
   the moment the keychain became readable again. *)
f=dbkeyaction(kind:str;existing:str):i64{
  if(str.len(existing)==64){
    <1
  }el{};
  if(kind=="notfound"){
    <2
  }el{};
  <0
};

(* A fresh secret: 32 bytes from the OS CSPRNG, as 64 hex characters. Separate from
   ensuredbkey so a test can obtain exactly what first use would store, without the
   keychain write that follows it. *)
f=generatedbsecret():str{
  <crypto.tohex(crypto.randombytes(32))
};

(* The 64-character hex secret, from the keychain, generating and storing one on first
   use. key "" means no secret is available, which must fail the operation that wanted it
   rather than fall back to anything.

   ONE read decides it: getdbkey, then the kind that read left. There is no exists()
   probe in front of it any more: the read already says everything the probe would, and a
   second call is a second chance for the keychain's state to change between question and
   answer.

   NOT called by openstore — see the note above. Call it only where a key is actually
   needed, so that no code path reaches the keychain for a key it does not use. *)
f=resolvedbkey():$dbkeyresult{
  let existing=kc.getdbkey();
  let kind=kc.lastkind();
  let action=dbkeyaction(kind;existing);
  if(action==1){
    <$dbkeyresult{key:existing;action:1;kind:kind}
  }el{};
  if(action==0){
    if(str.len(kind)==0){
      log.warn("db: a database key is in the keychain but could not be read as a 64-character secret; refusing rather than replacing it";"db";"system")
    }el{
      log.warn("db: the keychain could not be read (\(kind)); refusing rather than generating a key over one that may exist";"db";"system")
    };
    <$dbkeyresult{key:"";action:0;kind:kind}
  }el{};
  let hexkey=generatedbsecret();
  if(str.len(hexkey)!=64){
    log.warn("db: the generated database key is not 64 hex characters; refusing to store it";"db";"system");
    <$dbkeyresult{key:"";action:2;kind:"badkey"}
  }el{};
  if(kc.setdbkey(hexkey)){}el{
    let setkind=kc.lastkind();
    log.warn("db: could not store the database key in the keychain (\(setkind)); field encryption is unavailable";"db";"system");
    <$dbkeyresult{key:"";action:2;kind:setkind}
  };
  log.info("db: generated new database encryption key";"db";"system");
  <$dbkeyresult{key:hexkey;action:2;kind:""}
};

f=ensuredbkey():str{
  <resolvedbkey().key
};

(* X8.4 — PRAGMA secure_delete, and whether this toolchain honours it.

   MEASURED, not assumed, because PRAGMA key taught this project that SQLite accepting a
   pragma says nothing about SQLite acting on it. The measurement: insert 40 rows each
   containing a distinctive marker, DELETE them, then read the database file's bytes and
   look for the marker.

     secure_delete=OFF  marker present after insert, present after DELETE
     secure_delete=ON   marker present after insert, ABSENT  after DELETE
     either             absent after VACUUM
     secure_delete=ON   absent after DROP TABLE as well

   So it is honoured, on sqlite3 3.51.0 as linked by this toolchain, and the difference
   between the two settings is exactly the difference between a deleted value remaining
   legible in a freed page and not remaining there at all. It is set on the connection
   immediately after open, BEFORE migrations run, so that the migration which drops the
   old plaintext placeholder_maps table frees its pages with zeroing enabled.

   Read back rather than trusted: securedeleteenabled asks the database what the setting
   now is. Note that it must read the value as TEXT. Every stdlib result in this toolchain
   uses 0 for the error side, so row.i64 returning 0 is indistinguishable from row.i64
   failing — which makes a pragma whose legitimate value is 0 unreadable through the
   integer accessor. That cost an hour; it is the T-22 family again. *)
f=applysecuredelete():bool{
  mt db.exec("PRAGMA secure_delete=ON";@()) {
    $ok:v 1;
    $err:e 0
  };
  <securedeleteenabled()
};

f=securedeleteenabled():bool{
  let value=mt db.one("PRAGMA secure_delete";@()) {
    $ok:r rowstr(r;"secure_delete");
    $err:e ""
  };
  <str.eq(value;"1")
};

(* Database-level encryption is NOT available, and saying so is the deliverable.

   What used to be here was `applyencryptionkey`, issuing a `PRAGMA key`. It was removed
   under X8.1 rather than repaired, because repairing it would have been worse. It was
   broken three independent ways:

   1. The toolchain links plain SQLite — `-lsqlite3` in both build_loke.sh and
      run_tests.sh, and there is no sqlcipher anywhere in it. Plain SQLite **accepts**
      `PRAGMA key`, ignores it, and reports success.
   2. The SQL was malformed anyway: it built `PRAGMA key='x''<hex>''`, quotes unbalanced,
      the string literal never terminated.
   3. The call site discarded its own result, and the result's error side is a
      user-declared sum, so T-18 meant the first arm was taken whatever happened. The
      failure could not have surfaced even if the SQL had been valid.

   So fixing the quoting would have turned a latent honest failure into a control that
   LOOKS like it works, reports success, and encrypts nothing — indistinguishable from
   real encryption from inside the program. That is precisely the state GA2.2 was marked
   Done in, and X8.1 exists to reverse.

   The replacement is a predicate that everything asserting encryption must read, so the
   disclosure is derived from one place and flips automatically if the toolchain ever
   gains SQLCipher. `core.governance.compliance` reads it; `docs/metrics-baseline.md`
   states the same thing in prose.

   The mapping table — the highest-value data in the system, rated Maximum in
   docs/threat-model.md:181 — is protected by FIELD-level encryption instead, in
   core.privacy.placeholderstore, under X8.2. That is a narrower control than a database
   key and the status string below says so: ONE table's payload is sealed, and every other
   table in loke.db is plaintext. Do not widen the wording to "the database is encrypted",
   and do not reinstate a database-level claim. *)
f=dbencryptionavailable():bool{
  <false
};

f=dbencryptionstatus():str{
  if(dbencryptionavailable()){
    <"database encrypted at rest"
  }el{
    <"the DATABASE is NOT encrypted at rest: the toolchain links plain SQLite, which has no encryption and silently accepts PRAGMA key. One table is protected instead — the placeholder mapping payload is sealed field-by-field with AES-256-GCM under a key derived from the OS keychain secret (X8.2, core.privacy.placeholderstore). Every other table, including audit_log, settings and sessions, is plaintext on disk"
  }
};

(* Whether the process-global connection answers. db.open's failure is not reliably its
   $err arm: measured 2026-09-26, sqlite3_open returned SQLITE_CANTOPEN for a directory that
   did not exist, the $ok arm was taken, and every statement after it ran on a NULL handle. *)
(* DA1.9 follow-up - a busy database waits, it does not fail.

   The server is a pool of forked workers, each with its own connection to one loke.db, and
   SQLite's default is to answer SQLITE_BUSY at once when another connection holds the lock.
   Measured on the merged DA1.9 tree: eight concurrent POST /api/pipeline requests, four
   answered 503 "the disclosure record could not be written", and two of those four refusals
   were not even audited. The reserve's BEGIN IMMEDIATE, or its COMMIT while another worker
   was reading, met the lock and failed, and a failed reserve refuses the request (L1). The
   same race already existed for every autocommit write; the transaction made its window
   wide enough to hit whenever two requests overlap, which smoke_ui's cancel-then-send checks
   do. So every connection now waits up to busytimeoutms() for the lock. Read back, as
   secure_delete is, because a pragma accepted is not a pragma applied. *)
f=busytimeoutms():i64{ <5000 };

(* The literal in the pragma is busytimeoutms(); the read-back compares against it. *)
f=applybusytimeout():bool{
  mt db.exec("PRAGMA busy_timeout=5000";@()) {
    $ok:v 1;
    $err:e 0
  };
  <busytimeoutset()
};

f=busytimeoutset():bool{
  <str.eq(busytimeoutread();str.fromi64(busytimeoutms()))
};

(* As text, for the reason securedeleteenabled gives. "" if it cannot be read. *)
f=busytimeoutread():str{
  <mt db.one("PRAGMA busy_timeout";@()) {
    $ok:r rowstr(r;"timeout");
    $err:e ""
  }
};

f=connectionlive():bool{
  <mt db.one("SELECT 1 AS v";@()) {
    $ok:r true;
    $err:e false
  }
};

(* F10.39. The connection just opened becomes the one std.db's handle-less calls use, as it
   always was before toke 3.1.0.

   Until 3.1.0 std.db held ONE process-wide connection and every db.open replaced it (leaking
   the old one), so db.exec/one/many always reached the database opened last. 3.1.0 keeps a
   table of connections (138.6): every open gets a fresh handle, and the handle-less calls use
   the LOWEST-numbered one still open, so a second open repoints nothing. loke only uses the
   handle-less calls. Without this, every page request that opens the store (and they do,
   once each) would leave one more connection open, and a test that deletes its database file
   and reopens it would keep writing to the unlinked first file, which SQLite then refuses.

   Handles are 1, 2, 3, ... and never reused. Closing downward from the one below `conn`
   until a handle is already closed closes every older connection this module and
   core.memory.palace left open, because each of them adopted its own in turn. *)
f=adopt(conn:u64):u64{
  let i=mut.(conn as i64)-1;
  lp(let lv=0;i>0;lv=lv){
    if(db.closeon(i as u64)){ i=i-1 }el{ i=0 }
  };
  <conn
};

f=openstore(datadir:str):$store!$lokeerr{
  let path=str.concat(datadir;"/loke.db");
  (* The data directory is created here, because nothing else is guaranteed to have created
     it first. On a fresh HOME it did not exist, SQLite could not create loke.db in it, and
     every request's audit row, decision trace, budget and metrics were lost without an error
     until the log writer happened to create the directory. *)
  file.mkdir(datadir);
  let conn=mt db.open(path) {
    $ok:conn adopt(conn);
    $err:e $err($storageerr(str.concat("failed to open database: ";path)))
  };
  (* The busy timeout goes on BEFORE the liveness check. The check's SELECT reads the schema,
     which needs a shared lock, and on a connection with no timeout it failed at once whenever
     another worker was committing. openstore then returned an error its callers cannot see
     (page.api.pipeline matches it with `mt`, T-18) and left this connection in place with no
     timeout, so that request's reserve, completion and audit writes all failed at the first
     contention. Measured: 1 in 60 concurrent requests refused, with "db: the database could
     not be opened" logged just before it. *)
  if(applybusytimeout()){}el{
    log.warn("db: PRAGMA busy_timeout did not take effect; a write that meets another worker's lock will fail at once";"db";"system")
  };
  if(connectionlive()){}el{
    log.error("db: the database could not be opened, so nothing will be stored";"db";"system");
    <$err($storageerr(str.concat("failed to open database: ";path)))
  };
  (* No encryption step, and no keychain read. See dbencryptionavailable() above: there
     was a PRAGMA key, it could not work, and its failure could not surface. ensuredbkey()
     used to be called here to feed it, and since X8.1 deleted the pragma this call has
     been fetching a secret nothing used — which is the only reason opening a database
     could block on a keychain authorisation dialog. It is gone. The one consumer of the
     key asks for it where it needs it (X8.3).

     secure_delete goes on FIRST, before migrations, so that migration 9's drop of the old
     plaintext placeholder_maps table frees its pages with zeroing enabled. Measured to be
     honoured by this toolchain — see applysecuredelete. *)
  if(applysecuredelete()){}el{
    log.warn("db: PRAGMA secure_delete did not take effect; deleted rows may remain legible in freed pages";"db";"system")
  };
  let migrated=runmigrations(conn);
  let pending=pendingmigrations(m.allmigrations());
  if(pending>0){
    log.error("db: \(pending) migration(s) are not applied; the schema is incomplete and some features will read empty tables";"db";"system")
  }el{};
  <mt migrated {
    $ok:v2 $ok($store{conn:conn;datadir:datadir});
    $err:e $err(e)
  }
};

(* F10.51 - concurrent first opens. Every page request opens the store, and the server is a
   pool of forked workers, so on a fresh loke.db several processes ran the migrations at
   once. Each read "version N is not recorded", each applied N, and the loser either failed
   the migration itself (a duplicate column) or failed to record it (the PRIMARY KEY on
   schema_migrations.version). Measured against the built server on a fresh HOME: of three
   simultaneous requests, two answered 503 in five trials of five, logging "migration applied
   but could not be recorded" and "N migration(s) are not applied".

   Serialised in SQLite itself, under the write lock, and nowhere else. A lock file would
   need a lock primitive toke does not offer and leaves a stale file behind a killed process;
   migrating once at server start covers the server but not the CLI, moke's relay, the tests
   or erase.tk's rebuild, which open the same file from other processes. SQLite's lock is the
   one every process opening loke.db already shares, and the OS releases it when its holder
   dies.

   The fast path takes no lock and writes nothing: one COUNT over schema_migrations, and if
   every version is recorded the open is done. That is the case for every request but the
   first, and it replaces the single-row SELECT per migration, twice over, that this function
   and openstore used to run on every request. Only a store with something pending goes on to
   applymigrations. *)
f=runmigrations(conn:$dbconn):i64!$lokeerr{
  let all=m.allmigrations();
  if(pendingmigrations(all)==0){ <$ok(0) }el{};
  let failedat=applymigrations(all);
  if(failedat==migrationlockfailed()){
    <$err($storageerr("the database write lock could not be taken to migrate"))
  }el{};
  if(failedat==migrationcommitfailed()){
    <$err($storageerr("the migrations could not be committed"))
  }el{};
  if(failedat>0){
    <$err($storageerr(str.concat("migration failed at version ";str.fromi64(failedat))))
  }el{};
  <$ok(1)
};

(* applymigrations' answers that are not a version. *)
f=migrationlockfailed():i64{ <0-1 };
f=migrationcommitfailed():i64{ <0-2 };

f=migsqlok(sql:str):bool{
  <mt db.exec(sql;@()) {
    $ok:v true;
    $err:e false
  }
};

(* Applies each migration not yet recorded, in order, and answers the version that FAILED,
   0 when every one applied, migrationlockfailed() when the write lock could not be taken,
   or migrationcommitfailed() when the commit did not succeed.

   F10.51: the whole run is ONE transaction under BEGIN IMMEDIATE. IMMEDIATE takes the write
   lock before the first read, so a second process waits (busy_timeout, which openstore sets
   to busytimeoutms()) instead of reading the same "not yet applied" answer and racing to
   apply it. The applied set is read again INSIDE the lock, so a process that waited finds
   the first one's work committed and applies nothing. schema_migrations is created inside
   the lock too.

   A migration and its record commit together or not at all. If any statement fails, the
   run is rolled back, so nothing it applied stays behind unrecorded and nothing is recorded
   that is not applied: the store is left as the run found it, the open fails (503 at the
   page handlers), and the next open tries again. A failure to take the lock or to commit is
   the same: rolled back, logged at ERROR, and the open fails.

   Before that, each `mt db.exec(...) { $ok:v 1; $err:e $err(...) }` here was a STATEMENT,
   so its value, the error included, was thrown away. A migration whose SQL failed was then
   inserted into schema_migrations as applied, so it was never retried, and every later
   migration ran against a schema missing its predecessor.

   It stops at the first failure. Later migrations may depend on the failed one, and a
   recorded version has to mean "applied". It logs at ERROR, naming the migration. *)
f=applymigrations(migrations:@$migration):i64{
  if(migsqlok("BEGIN IMMEDIATE")){}el{
    log.error("db: the write lock could not be taken to apply migrations, so none was applied and the store is not opened";"db";"system");
    <migrationlockfailed()
  };
  let createsql="CREATE TABLE IF NOT EXISTS schema_migrations (
  version INTEGER PRIMARY KEY,
  applied_at TEXT NOT NULL,
  description TEXT NOT NULL
)";
  if(migsqlok(createsql)){}el{
    migsqlok("ROLLBACK");
    log.error("db: could not create schema_migrations; no migration was applied";"db";"system");
    <migrationlockfailed()
  };
  let applied=mut.0;
  lp(let mi=0;mi<migrations.len;mi=mi+1){
    let mg=migrations.get(mi);
    let verstr=str.fromint(mg.version);
    let exists=mt db.one(str.concat("SELECT version FROM schema_migrations WHERE version=";verstr);@()) {
      $ok:v true;
      $err:v false
    };
    if(!exists){
      if(migsqlok(mg.sql)){}el{
        migsqlok("ROLLBACK");
        log.error(str.concat("db: migration FAILED, so this run was rolled back and later migrations were not attempted: ";mg.description);"db";"system");
        <mg.version as i64
      };
      (* An ISO-8601 stamp, not the literal "now()". See GA5.1. *)
      let recorded=mt db.exec("INSERT INTO schema_migrations (version,applied_at,description) VALUES (?,?,?)";@(verstr;str.nowiso8601();mg.description)) {
        $ok:v true;
        $err:e false
      };
      if(!recorded){
        migsqlok("ROLLBACK");
        log.error(str.concat("db: a migration could not be recorded, so this run was rolled back: ";mg.description);"db";"system");
        <mg.version as i64
      }el{};
      applied=applied+1;
    }el{};
  };
  if(migsqlok("COMMIT")){}el{
    migsqlok("ROLLBACK");
    log.error("db: the migrations could not be committed, so none was applied and the store is not opened";"db";"system");
    <migrationcommitfailed()
  };
  if(applied>0){
    log.info("db: applied \(applied) migration(s) under the write lock";"db";"system")
  }el{};
  <0
};

(* How many of the given migrations are not recorded as applied, in ONE query: all of them
   when schema_migrations does not exist yet. It is runmigrations' fast path (F10.51), and
   openstore and erase.tk ask it after a run. *)
f=pendingmigrations(migrations:@$migration):i64{
  if(migrations.len==0){ <0 }el{};
  let inlist=mut."";
  lp(let mi=0;mi<migrations.len;mi=mi+1){
    let v=str.fromint(migrations.get(mi).version);
    if(mi==0){ inlist=v }el{ inlist="\(inlist),\(v)" };
  };
  let present=mt db.one("SELECT COUNT(DISTINCT version) AS n FROM schema_migrations WHERE version IN (\(inlist))";@()) {
    $ok:r rowi64(r;"n");
    $err:e 0
  };
  <(migrations.len as i64)-present
};

f=closestore(store:$store):i64{

  <0
};

f=exec(store:$store;sql:str):i64!$lokeerr{
  <mt db.exec(sql;@()) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("exec failed: ";sql)))
  }
};

f=execparams(store:$store;sql:str;params:@str):i64!$lokeerr{
  <mt db.exec(sql;params) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("execparams failed: ";sql)))
  }
};

f=query(store:$store;sql:str):@$dbrow!$lokeerr{
  <mt db.many(sql;@()) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("query failed: ";sql)))
  }
};

f=queryone(store:$store;sql:str):$dbrow!$lokeerr{
  <mt db.one(sql;@()) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("queryone failed: ";sql)))
  }
};

f=queryparams(store:$store;sql:str;params:@str):@$dbrow!$lokeerr{
  <mt db.many(sql;params) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("queryparams failed: ";sql)))
  }
};

f=getstr(store:$store;key:str):str!$lokeerr{
  let sql="SELECT value FROM kv WHERE key='\(key)'";
  <mt db.one(sql;@()) {
    $ok:v $ok(rowstr(v;"value"));
    $err:e $err($storageerr(str.concat("getstr failed for key: ";key)))
  }
};

f=setstr(store:$store;key:str;val:str;component:str):i64!$lokeerr{
  <mt db.exec("INSERT OR REPLACE INTO kv (key,value,component) VALUES (?,?,?)";@(key;val;component)) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("setstr failed for key: ";key)))
  }
};

f=rowstr(r:$dbrow;col:str):str{
  <mt row.str(r;col) {$ok:v v;$err:e ""}
};

f=rowi64(r:$dbrow;col:str):i64{
  <mt row.i64(r;col) {$ok:v v;$err:e 0}
};

f=rowi32(r:$dbrow;col:str):i32{
  <mt row.i64(r;col) {$ok:v v as i32;$err:e 0 as i32}
};

f=rowbool(r:$dbrow;col:str):bool{
  <mt row.bool(r;col) {$ok:v v;$err:e false}
};

(* rowget/rowslen predate typed row arrays. With @$dbrow they are just .get/.len, so
   these remain only for callers not yet migrated. *)
(* Reads the column as TEXT and parses it, rather than through row.f64.

   stdlib/db.tki declares row.f64 as returning `f64!DbErr`, but tk_row_f64_w returns a
   plain i64 carrying the f64 bit pattern and 0 on error — no tag. So the interface and
   the implementation disagree, and matching the "result" is undefined: it crashed.
   Filed as T-22, the same family as T-12.

   Returning HUNDREDTHS as an i64 also sidestepped T-20 (an f64 returned across a module
   boundary was corrupted; fixed in toke 3.1.0, LS1.1h). It stays because the audit chain's
   legacy rows are verified through this exact rounding (rowauditcostcents below). *)
f=rowf64hundredths(r:$dbrow;col:str):i64{
  (* Rounds rather than truncating. `x * 100.0 as i64` turned 0.29 into 28 and 1.15 into
     114 — a one-cent error on a value that decides whether a spending quota has been
     exceeded. Adding half before the cast, with the sign, rounds to nearest. *)
  let text=rowstr(r;col);
  if(str.len(text)==0){
    <0
  }el{
    let scaled=str.tofloat(text) * 100.0;
    if(scaled<0.0){
      <(scaled - 0.5) as i64
    }el{
      <(scaled + 0.5) as i64
    }
  }
};

(* GA5.15 — audit_log's cost is an exact INTEGER number of cents, in `cost_usd_cents`.

   It was `cost_usd REAL`, so SQLite owned its rendering and the hash chain had to be
   normalised through rowf64hundredths on both sides to survive "0" coming back as "0.0".
   Migration 27 renames that column to `cost_usd_legacy_dollars` and migration 28 adds
   `cost_usd_cents INTEGER`. The rename is deliberate: a reader still asking for `cost_usd`
   now fails with "no such column" instead of silently reading dollars where cents are
   meant, or cents where dollars are — a factor of 100 on a figure that feeds a spend view.

   Rows written before migration 28 have `cost_usd_cents` NULL and their cost in the legacy
   column. They are NOT rewritten: audit_log is append-only (GA5.9) and a table rebuild is
   exactly the wholesale rewrite that control exists to prevent. Legacy rows are read
   through the SAME rounding their digest was written with (rowf64hundredths of the legacy
   text), so an untampered pre-migration chain still verifies, and the digest string is
   identical in both eras because hundredths of a dollar and cents are the same integer.

   Readers select auditcostcols() and read rowauditcostcents; SQL aggregates use
   auditcostcentsexpr(). *)
f=auditcostcols():str{
  <"cost_usd_cents,cost_usd_legacy_dollars,(cost_usd_cents IS NULL) AS cost_is_legacy"
};

f=rowauditcostcents(r:$dbrow):i64{
  if(rowi64(r;"cost_is_legacy")==1){
    <rowf64hundredths(r;"cost_usd_legacy_dollars")
  }el{
    <rowi64(r;"cost_usd_cents")
  }
};

f=auditcostcentsexpr():str{
  <"COALESCE(cost_usd_cents,CAST(ROUND(cost_usd_legacy_dollars*100) AS INTEGER))"
};

(* Money, formatted from the exact integer of hundredths and never through a float.

   This exists because the two obvious spellings are both wrong for currency.
   str.fromfloat(1.50) gives "1.5" and str.fromfloat(0.0) gives "0", so a cost column
   printed that way reads $1.5 and $0. shared.types.f64fixed truncates the decimal string
   to the requested places rather than padding it, so f64fixed(1.5;2) is also "1.5". A
   governance cost report that prints $1.5 where it means $1.50 is the kind of figure
   somebody reconciles against an invoice.

   Taking the i64 of hundredths that rowf64hundredths already returns keeps the value
   exact and pads properly. *)
f=pad2(n:i64):str{
  if(n<10){
    <str.concat("0";str.fromint(n))
  }el{
    <str.fromint(n)
  }
};

f=moneyfromhundredths(h:i64):str{
  let negative=h<0;
  let magnitude=mut.h;
  if(negative){
    magnitude=0-h
  }el{};
  let whole=magnitude/100;
  let body="\(str.fromint(whole)).\(pad2(magnitude-(whole*100)))";
  if(negative){
    <str.concat("-";body)
  }el{
    <body
  }
};

f=rowget(rows:@$dbrow;idx:i64):$dbrow{
  <db.rowget(rows;idx)
};

f=rowslen(rows:@$dbrow):i64{
  <db.rowslen(rows)
};

f=boolval(b:bool):str{
  if(b){<"1"};
  <"0"
};

f=i32val(n:i32):str{
  <str.fromint(n)
};

f=i64val(n:i64):str{
  <str.fromint(n)
};

f=nowms():i64{
  <db.nowms()
};


(* ── schema introspection ─────────────────────────────────────────────────────
   "Does this table exist?" has to be answerable directly, because the alternative is
   inferring it from a query that returned nothing — and a query against a missing table
   returns an error that most of this codebase maps to an empty array. That is how
   governance/report.tk spent its life reporting zero events from a table no migration
   creates (GA5.12), and how four memory tables are referenced 24 times and created
   nowhere without anything noticing (M1.7).

   So: one predicate, here in the storage layer, for anything that wants to assert its
   schema rather than assume it. core.governance.compliance had a private copy; it now
   delegates. M1.7 should use these two rather than write a third. *)
(* Counts ROWS RETURNED, not a value in them. Read the next paragraph before using it.

   A plain i64, no result type. db.many is a STDLIB result so both arms are live (T-18 only kills
   the error arm of a user-declared sum), and a failed query counting as zero is the safe
   direction for a predicate that asks whether something exists. That is what its three callers
   want: `tableexists`, `triggerexists` and `placeholder_store.hasrequest` all ask "is there a
   row?".

   **The trap, and it is a real one (GA5.20).** Handed an aggregate it answers **1**, for every
   input, forever:

       countquery("SELECT COUNT() AS n FROM audit_log")      -> 1, not the number of rows
       countquery("SELECT SUM(cost_usd) AS c FROM audit_log") -> 1

   because `COUNT()` returns ONE ROW containing the count, and this function measures the row
   list. It is a plausible thing to reach for — the name contains "count" — and it caught this
   session once, reporting every provider as having made exactly 1 request. Use `scalari64` below
   for an aggregate. There is no live misuse in the tree today; this comment is here so there is
   not one tomorrow.

   (The aggregates above are written COUNT-open-close without the star, deliberately. Comments
   NEST in toke, and an open-paren immediately followed by a star opens a nested one — so writing
   an aggregate with a star inside a comment swallows the rest of the file. That is T-27, and
   writing THIS comment walked into it twice: db.tk type-checked clean both times while its
   emitted interface silently lost every export after this point, and fourteen call sites across
   six modules failed with `core.storage.db has no exported member`. The second time was the
   paragraph explaining the first. `placeholder_store.tk:68` uses the same star-free convention
   for the same reason.) *)
f=countquery(sql:str;params:@str):i64{
  <mt db.many(sql;params) {
    $ok:rows rows.len as i64;
    $err:e 0
  }
};

(* The aggregate reader `countquery` is mistaken for.

   Reads a NAMED COLUMN out of the first row, which is what `SELECT COUNT() AS n` and
   `SELECT SUM(x) AS s` produce. The column name is explicit rather than positional because
   `db.rowi64` takes a name, and because a positional reader would silently return the wrong
   column the first time somebody adds a second aggregate to the same query.

   `fallback` is the caller's, not a hardcoded zero: for a count, 0 is right; for "the highest
   version applied", 0 and "no rows" mean different things, and only the caller knows which. *)
f=scalari64(sql:str;params:@str;col:str;fallback:i64):i64{
  <mt db.many(sql;params) {
    $ok:rows firstrowi64(rows;col;fallback);
    $err:e fallback
  }
};

f=firstrowi64(rows:@$dbrow;col:str;fallback:i64):i64{
  if(rows.len==0){
    <fallback
  }el{
    <rowi64(rows.get(0);col)
  }
};

f=tableexists(name:str):bool{
  <countquery("SELECT name FROM sqlite_master WHERE type='table' AND name=?";@(name))>0
};

f=triggerexists(name:str):bool{
  <countquery("SELECT name FROM sqlite_master WHERE type='trigger' AND name=?";@(name))>0
};

(* GA5.9 — read back whether the append-only control is actually in place.

   Migrations 6 and 7 create the two triggers, but a migration having run once is not
   evidence that the control is live now: a later migration that rebuilds audit_log
   would take its triggers with it, and an operator with the sqlite3 shell can drop
   them. Something that asserts "the trail is append-only" should therefore ask the
   database rather than trust the migration log. core.governance.compliance reports
   this, and tests/unit/storage/test_audit_append_only.tk asserts it. *)
f=auditappendonlyenforced():bool{
  if(triggerexists("audit_log_append_only_update")){
    <triggerexists("audit_log_append_only_delete")
  }el{
    <false
  }
};


(* ── GA5.11: the reporting window ────────────────────────────────────────────
   audit_log.created_at is milliseconds since the Unix epoch, written as TEXT by
   core.storage.audit.insertevent. Every reader compared it to something else: the
   report engine to ISO dates such as "2026-01-01", the governance dashboard to
   datetime('now','-N days'). Both are string comparisons of "1790…" against "2026-…"
   or "2026-09-16 04:24:34", and "1" sorts before "2", so every window matched zero
   rows on every installation whatever the table held. The reports and the scorecard
   period were inert, and inert in the direction that looks like "nothing happened".

   THE DECISION: convert at the query boundary and leave the stored text alone.

   The alternative was to store created_at as an ISO-8601 string, which would make the
   comparisons work with no conversion at all. It is rejected, and not on taste:

     - The chain digest covers created_at's STORED TEXT (see audit.digestfields).
       Re-representing existing rows changes that text, so every existing row's stored
       hash would stop matching a digest recomputed from its own fields — the verifier
       would report the trail as tampered. The only way to migrate the rows is to
       recompute their hashes, and a migration that rewrites the hashes of a
       tamper-evident trail is indistinguishable, from inside the data, from someone
       rewriting history. An audit trail that has had its digests recomputed once is an
       audit trail whose digests mean "somebody re-derived these", not "these are what
       was recorded".
     - GA5.9, one migration earlier, makes audit_log reject UPDATE. A migration that
       rewrote created_at on existing rows would have to defeat the control this same
       change introduces.
     - This is the third instance today of the same class: a digest over a value whose
       text representation something else controls. GA5.1 (the literal 'now()'), GA5.15
       (SQLite rendering a REAL as "0.0" where the writer wrote "0"). Epoch
       milliseconds as an integer has exactly one textual form, which is the property
       that makes it safe to hash. ISO-8601 has many.

   So the stored column is untouched, nothing is re-hashed, and the conversion happens
   on the PARAMETER instead. The column side needs `CAST(created_at AS INTEGER)`, which
   is a read-only cast in a WHERE clause and never written back — without it SQLite
   applies the column's TEXT affinity to the integer bound parameter and converts the
   PARAMETER to text, putting the string comparison back.

   The conversion is done by SQLite's own date functions rather than std.time.parse,
   deliberately. created_at comes from db.nowms, which is UTC. SQLite reads a bare
   date as UTC and strftime('%s',…) yields a UTC epoch, so the two agree by
   construction. std.time.parse wraps strptime, whose result would go through the host's
   local timezone, and a window silently shifted by the operator's UTC offset is the
   same class of bug as the one being fixed — near-invisible, and wrong only at the
   edges of the window. SQLite is also the only date PARSER available here, and it
   accepts the ISO forms the CLI produces.

   Both bounds are whole UTC days: the window runs from the start of startdate to the
   start of the day AFTER enddate, half-open. That makes `--start X --end X` a full
   single day rather than an empty instant, which is what a caller passing two dates
   means. *)
f=epochmsfrom(sql:str;arg:str):i64{
  <mt db.one(sql;@(arg)) {
    $ok:r rowi64(r;"ms");
    $err:e 0
  }
};

f=badrange():$msrange{
  <$msrange{startms:0;endms:0;ok:false}
};

f=msrangeof(startdate:str;enddate:str):$msrange{
  let startms=epochmsfrom("SELECT CAST(strftime('%s',?,'start of day') AS INTEGER)*1000 AS ms";startdate);
  let endms=epochmsfrom("SELECT CAST(strftime('%s',?,'start of day','+1 day') AS INTEGER)*1000 AS ms";enddate);
  (* strftime returns NULL for anything it cannot read as a date, which arrives here as
     0, and a bound of 0 would quietly match nothing — the failure mode being fixed.
     Zero is also the Unix epoch itself, so a caller asking for 1970-01-01 is refused;
     that is the honest trade for catching a typo, and no report window starts there. *)
  if(startms==0){
    log.warn(str.concat("report window rejected: could not read a date from ";startdate);"db";"system");
    <badrange()
  }el{};
  if(endms==0){
    log.warn(str.concat("report window rejected: could not read a date from ";enddate);"db";"system");
    <badrange()
  }el{};
  if(endms<startms){
    log.warn("report window rejected: the end date precedes the start date: \(startdate) to \(enddate)";"db";"system");
    <badrange()
  }el{};
  <$msrange{startms:startms;endms:endms;ok:true}
};

(* The governance scorecard's window: the last N days, ending now. Same units, same
   clock, same reason for going through SQLite. *)
f=daysagoms(days:i64):i64{
  let modifier="-\(str.fromint(days)) days";
  <epochmsfrom("SELECT CAST(strftime('%s','now',?) AS INTEGER)*1000 AS ms";modifier)
};

(* The one spelling of the window predicate, so five report queries and the scorecard
   cannot drift apart again. Bind str.fromi64 of the two bounds, in this order. *)
f=createdatwindowclause():str{
  <"CAST(created_at AS INTEGER) >= ? AND CAST(created_at AS INTEGER) < ?"
};

f=createdatdescorder():str{
  <" ORDER BY CAST(created_at AS INTEGER) DESC, rowid DESC"
};

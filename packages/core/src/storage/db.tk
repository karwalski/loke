m=core.storage.db;


i=t:shared.types;
i=db:std.db;
i=str:std.str;
i=m:core.storage.migrations;

t=$store{
  conn:$dbconn;
  datadir:str
};

f=open(datadir:str):$store|$lokeerr{
  let path=str.concat(datadir;"/loke.db");
  mt db.open(path) {
    $ok:conn {
      mt runmigrations(conn) {
        $ok: <$ok($store{conn:conn;datadir:datadir});
        $err:e <$err(e)
      };
    };
    $err:e <$err($storageerr(str.concat("failed to open database: ";path)))
  };
};

f=runmigrations(conn:$dbconn):void|$lokeerr{
  let createsql="CREATE TABLE IF NOT EXISTS schema_migrations (
  version INTEGER PRIMARY KEY,
  applied_at TEXT NOT NULL,
  description TEXT NOT NULL
)";
  db.exec(conn;mt createsql) {
    $ok: {};
    $err:e <$err($storageerr("failed to create schema_migrations table"))
  };
  let migrations=m.allmigrations();
  let i=0;
  let count=migrations.len;
  
  migrations.each|mg{
    let verstr=str.fromint(mg.version);
    let checksql=str.concat("SELECT version FROM schema_migrations WHERE version=";verstr);
    db.queryone(conn;mt checksql) {
      $ok: {};
      $err: {
        
        db.exec(conn;mt mg.sql) {
          $ok: {};
          $err:e <$err($storageerr(str.concat("migration failed: ";mg.description)))
        };
        let insertsql=str.concat(
          "INSERT INTO schema_migrations (version,applied_at,description) VALUES (";
          str.concat(verstr;str.concat(",'now()','";str.concat(mg.description;"');")))
        );
        db.execparams(conn;"INSERT INTO schema_migrations (version,applied_at,description) VALUES (?,?,?)";@(verstr;"now()";mt mg.description)) {
          $ok: {};
          $err:e <$err($storageerr(str.concat("failed to record migration: ";mg.description)))
        };
      };
    };
  };
  <$ok(void)
};

f=close(store:$store):void{
  
  <void
};

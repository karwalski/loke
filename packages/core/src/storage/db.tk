m=core.storage.db;


i=db:std.db;
i=str:std.str;
i=env:std.env;
i=crypto:std.crypto;
i=kc:core.storage.keychain;
i=log:shared.log;
i=m:core.storage.migrations;
i=t:shared.types;

t=$dbconn{handle:i64};

t=$store{
  conn:$dbconn;
  datadir:str
};

(* GA2.2: retrieve or generate a 32-byte hex encryption key via OS keychain *)
(* The environment is checked before the keychain, and that is not a convenience.

   core.storage.keychain.getdbkey reaches SecItemCopyMatching, which on macOS blocks
   on an authorisation dialog when the calling binary is not the one that stored the
   item. A headless process — CI, a test runner, loke started by launchd — can never
   answer that dialog, so the read does not fail: it HANGS, indefinitely, with the
   store half-open. Every integration test touching the database hung on this, and so
   would a first run on a machine where the key already exists.

   toke offers no way to time-bound a keychain read, so loke cannot recover from the
   block once it starts. Avoiding it is the only option available here.

   LOKE_DB_KEY is therefore read first. It is a 64-character hex key, it is intended
   for CI and tests, and it is NOT the recommended way to run loke: an environment
   variable is readable by any process running as the user, where the keychain item is
   not. The keychain remains the default for an interactive install. *)
(* std.db takes (sql, params) and uses the connection db.open established — there is no
   connection argument any more. Five calls here still passed one, which is
   ARITY-COMPATIBLE: db.exec(conn; sql) type-checks, then reads the connection pointer
   as a SQL string and the SQL string as a parameter array. Every one of them crashed
   the moment it ran, which is why openstore segfaulted and every test that touches the
   database with it. The build could not see it. *)
f=dbkeyfromenv():str{
  let fromenv=env.getor("LOKE_DB_KEY";"");
  if(str.len(fromenv)==64){
    <fromenv
  }el{
    <""
  }
};

f=ensuredbkey():str!$lokeerr{
  let fromenv=dbkeyfromenv();
  if(str.len(fromenv)>0){
    log.info("db: using the encryption key from LOKE_DB_KEY, not the keychain";"db";"system");
    <$ok(fromenv)
  }el{};
  if(kc.haskey("db_encryption_key")){
    let existing=kc.getdbkey();
    if(str.len(existing)>0){
      <$ok(existing)
    }el{};
  }el{};
  let keybytes=crypto.randombytes(32);
  let hexkey=crypto.tohex(keybytes);
  let stored=kc.setdbkey(hexkey);
  if(!stored){
    <$err($storageerr("failed to store database encryption key in keychain"))
  }el{};
  log.info("db: generated new database encryption key";"db";"system");
  <$ok(hexkey)
};

(* Database-level encryption is NOT available, and saying so is the deliverable.

   What used to be here was `applyencryptionkey`, issuing a `PRAGMA key`. It was removed
   under X8.1 rather than repaired, because repairing it would have been worse. It was
   broken three independent ways:

   1. The toolchain links plain SQLite — `-lsqlite3` in both build_loke.sh and
      run_tests.sh, and there is no sqlcipher anywhere in it. Plain SQLite **accepts**
      `PRAGMA key`, ignores it, and reports success.
   2. The SQL was malformed anyway: it built `PRAGMA key='x''<hex>''`, quotes unbalanced,
      the string literal never terminated.
   3. The call site discarded its own result, and the result's error side is a
      user-declared sum, so T-18 meant the first arm was taken whatever happened. The
      failure could not have surfaced even if the SQL had been valid.

   So fixing the quoting would have turned a latent honest failure into a control that
   LOOKS like it works, reports success, and encrypts nothing — indistinguishable from
   real encryption from inside the program. That is precisely the state GA2.2 was marked
   Done in, and X8.1 exists to reverse.

   The replacement is a predicate that everything asserting encryption must read, so the
   disclosure is derived from one place and flips automatically if the toolchain ever
   gains SQLCipher. `core.governance.compliance` reads it; `docs/metrics-baseline.md`
   states the same thing in prose.

   The mapping table — the highest-value data in the system, rated Maximum in
   docs/threat-model.md:181 — is to be protected by FIELD-level encryption via
   `std.encrypt` (`aes256gcmencrypt`/`decrypt`/`keygen`/`noncegen`, `hkdfsha256`, all
   verified present in the toolchain) under X8.2. Do not reinstate a database-level
   claim. *)
f=dbencryptionavailable():bool{
  <false
};

f=dbencryptionstatus():str{
  if(dbencryptionavailable()){
    <"database encrypted at rest"
  }el{
    <"NOT encrypted at rest: the toolchain links plain SQLite, which has no encryption and silently accepts PRAGMA key. Field-level encryption of the mapping table is tracked as X8.2"
  }
};

f=openstore(datadir:str):$store!$lokeerr{
  let path=str.concat(datadir;"/loke.db");
  let conn=mt db.open(path) {
    $ok:conn conn;
    $err:e $err($storageerr(str.concat("failed to open database: ";path)))
  };
  (* No encryption step. See dbencryptionavailable() above: there was one, it could not
     work, and its failure could not surface. ensuredbkey() is still called because the
     key it manages is real and X8.2 will use it for field-level encryption — but it is
     no longer fed to a PRAGMA that ignores it. *)
  mt ensuredbkey() {
    $ok:k k;
    $err:e ""
  };
  <mt runmigrations(conn) {
    $ok:v2 $ok($store{conn:conn;datadir:datadir});
    $err:e $err(e)
  }
};

f=runmigrations(conn:$dbconn):i64!$lokeerr{
  let createsql="CREATE TABLE IF NOT EXISTS schema_migrations (
  version INTEGER PRIMARY KEY,
  applied_at TEXT NOT NULL,
  description TEXT NOT NULL
)";
  mt db.exec(createsql;@()) {
    $ok:v 1;
    $err:e $err($storageerr("failed to create schema_migrations table"))
  };
  let migrations=m.allmigrations();
  lp(let mi=0;mi<migrations.len;mi=mi+1){
  let mg=migrations.get(mi);
    let verstr=str.fromint(mg.version);
    let checksql=str.concat("SELECT version FROM schema_migrations WHERE version=";verstr);
    let exists=mt db.one(checksql;@()) {
      $ok:v true;
      $err:v false
    };
    if(!exists){
      mt db.exec(mg.sql;@()) {
        $ok:v 1;
        $err:e $err($storageerr(str.concat("migration failed: ";mg.description)))
      };
      mt db.exec("INSERT INTO schema_migrations (version,applied_at,description) VALUES (?,?,?)";@(verstr;"now()";mg.description)) {
        $ok:v 1;
        $err:e $err($storageerr(str.concat("failed to record migration: ";mg.description)))
      };
    };
  };
  <$ok(1)
};

f=closestore(store:$store):void{

  <void
};

f=exec(store:$store;sql:str):i64!$lokeerr{
  <mt db.exec(sql;@()) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("exec failed: ";sql)))
  }
};

f=execparams(store:$store;sql:str;params:@str):i64!$lokeerr{
  <mt db.exec(sql;params) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("execparams failed: ";sql)))
  }
};

f=query(store:$store;sql:str):@$row!$lokeerr{
  <mt db.many(sql;@()) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("query failed: ";sql)))
  }
};

f=queryone(store:$store;sql:str):$row!$lokeerr{
  <mt db.one(sql;@()) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("queryone failed: ";sql)))
  }
};

f=queryparams(store:$store;sql:str;params:@str):@$row!$lokeerr{
  <mt db.many(sql;params) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("queryparams failed: ";sql)))
  }
};

f=getstr(store:$store;key:str):str!$lokeerr{
  let sql=str.concat("SELECT value FROM kv WHERE key='";str.concat(key;"'"));
  <mt db.one(sql;@()) {
    $ok:v $ok(rowstr(v;"value"));
    $err:e $err($storageerr(str.concat("getstr failed for key: ";key)))
  }
};

f=setstr(store:$store;key:str;val:str;component:str):i64!$lokeerr{
  <mt db.exec("INSERT OR REPLACE INTO kv (key,value,component) VALUES (?,?,?)";@(key;val;component)) {
    $ok:v $ok(v);
    $err:e $err($storageerr(str.concat("setstr failed for key: ";key)))
  }
};

f=rowstr(r:$row;col:str):str{
  <mt row.str(r;col) {$ok:v v;$err:e ""}
};

f=rowi64(r:$row;col:str):i64{
  <mt row.i64(r;col) {$ok:v v;$err:e 0}
};

f=rowi32(r:$row;col:str):i32{
  <mt row.i64(r;col) {$ok:v v as i32;$err:e 0}
};

f=rowbool(r:$row;col:str):bool{
  <mt row.bool(r;col) {$ok:v v;$err:e false}
};

(* rowget/rowslen predate typed row arrays. With @$row they are just .get/.len, so
   these remain only for callers not yet migrated. *)
(* Reads the column as TEXT and parses it, rather than through row.f64.

   stdlib/db.tki declares row.f64 as returning `f64!DbErr`, but tk_row_f64_w returns a
   plain i64 carrying the f64 bit pattern and 0 on error — no tag. So the interface and
   the implementation disagree, and matching the "result" is undefined: it crashed.
   Filed as T-22, the same family as T-12.

   Returning HUNDREDTHS as an i64 also sidesteps T-20, where an f64 returned across a
   module boundary is corrupted. Callers that want a float divide locally. *)
f=rowf64hundredths(r:$row;col:str):i64{
  (* Rounds rather than truncating. `x * 100.0 as i64` turned 0.29 into 28 and 1.15 into
     114 — a one-cent error on a value that decides whether a spending quota has been
     exceeded. Adding half before the cast, with the sign, rounds to nearest. *)
  let text=rowstr(r;col);
  if(str.len(text)==0){
    <0
  }el{
    let scaled=str.tofloat(text) * 100.0;
    if(scaled<0.0){
      <(scaled - 0.5) as i64
    }el{
      <(scaled + 0.5) as i64
    }
  }
};

f=rowget(rows:@$row;idx:i64):$row{
  <db.rowget(rows;idx)
};

f=rowslen(rows:@$row):i64{
  <db.rowslen(rows)
};

f=boolval(b:bool):str{
  if(b){<"1"};
  <"0"
};

f=i32val(n:i32):str{
  <str.fromint(n)
};

f=i64val(n:i64):str{
  <str.fromint(n)
};

f=nowms():i64{
  <db.nowms()
};

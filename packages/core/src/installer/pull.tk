m=core.installer.pull;

i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=proc:std.process;
i=json:std.json;

t=$pullprogress{
  modelid:str;
  totalbytes:i64;
  downloadedbytes:i64;
  percent:f64;
  etaseconds:i64;
  status:str
};

t=$bytesinfo{
  downloaded:i64;
  total:i64
};

(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=extractbytes(line:str):$bytesinfo{
  let sepidx=str.indexof(line;"GB/");
  if(sepidx < 0){
    let sepmb=str.indexof(line;"MB/");
    if(sepmb < 0){
      <$bytesinfo{downloaded:0;total:0}
    }el{
      <parsebytepair(line;sepmb;"MB";1048576)
    }
  }el{
    <parsebytepair(line;sepidx;"GB";1073741824)
  }
};

(* ── Every push into `results` was discarded, so a pull reported nothing ───────────
   `results` is a PARAMETER, threaded in and returned, which is the right shape under T-26 —
   toke has no mutable struct field and no in-place array update. But every `results.push(...)`
   here was written bare, and an array push RETURNS the new array (T-24), so all five sites threw
   their value away and each function returned its input unchanged.

   What that cost: `handlepullchild` parsed every progress line from `ollama pull` and kept none,
   then appended a "complete" or "error" record and kept that either — so a model download
   reported **no progress and no outcome**, whatever happened. `handlepullerror` likewise
   swallowed the spawn failure it exists to record.

   `results` is reassigned through a `mut.` local, because a parameter cannot be rebound. *)
f=handlepullchild(handle:i64;modelid:str;results:@$pullprogress):@$pullprogress{
  let acc=mut.results;
  let lines=proc.readlines(handle);
  lp(let i=0;i<str.arraylen(lines);i=i+1){ let line=str.arrayget(lines;i);
    let progress=parseprogressline(modelid;line);
    acc=acc.push(progress)
  };
  let exitcode=proc.wait(handle);
  if(exitcode == 0){
    acc=acc.push($pullprogress{
      modelid:modelid;
      totalbytes:0;
      downloadedbytes:0;
      percent:100.0;
      etaseconds:0;
      status:"complete"
    })
  }el{
    log.error(str.concat("ollama pull failed with exit code: ";str.fromint(exitcode));"installer.pull";"system");
    acc=acc.push($pullprogress{
      modelid:modelid;
      totalbytes:0;
      downloadedbytes:0;
      percent:0.0;
      etaseconds:0;
      status:"error"
    })
  };
  <acc
};

f=handlepullerror(e:str;modelid:str;results:@$pullprogress):@$pullprogress{
  log.error(str.concat("failed to spawn ollama pull: ";e);"installer.pull";"system");
  let acc=mut.results;
  acc=acc.push($pullprogress{
    modelid:modelid;
    totalbytes:0;
    downloadedbytes:0;
    percent:0.0;
    etaseconds:0;
    status:"error"
  });
  <acc
};

f=pullmodel(modelid:str):@$pullprogress{
  log.info(str.concat("pulling model: ";modelid);"installer.pull";"system");
  let results=mut.@();

  let child=proc.spawn(@("ollama";"pull";modelid));
  results=mt child {
    $ok:handle handlepullchild(handle;modelid;results);
    $err:e handlepullerror(e;modelid;results)
  };
  <results
};

f=parseprogressline(modelid:str;line:str):$pullprogress{
  let pct=extractpercent(line);
  let bytesinfo=extractbytes(line);
  let eta=extracteta(line);
  let status=mut."preparing";
  if(str.contains(line;"success")){status="complete"}el{
    if(str.contains(line;"error")){status="error"}el{
      if(pct > 0.0){status="downloading"}el{}
    }
  };
  <$pullprogress{
    modelid:modelid;
    totalbytes:bytesinfo.total;
    downloadedbytes:bytesinfo.downloaded;
    percent:pct;
    etaseconds:eta;
    status:status
  }
};

f=extractpercent(line:str):f64{
  let idx=str.indexof(line;"%");
  if(idx < 0){ <0.0 }el{
    let start=mut.idx - 1;
    lp(let lv=0;true;lv=lv){
      if(start < 0){ <str.tof64(str.substr(line;1;idx)) }el{
        let ch=str.charat(line;start);
        if(str.isdigit(ch)){ start=start - 1 }el{
          if(str.eq(ch;".")){ start=start - 1 }el{
            let numstr=str.substr(line;start + 1;idx);
            <str.tof64(numstr)
          }
        }
      }
    };
    <0.0
  }
};

f=parsebytepair(line:str;sepidx:i64;unit:str;multiplier:i64):$bytesinfo{
  let dlend=sepidx;
  let dlstart=mut.dlend - 1;
  lp(let lv=0;true;lv=lv){
    if(dlstart < 0){
      let dlstr=str.substr(line;0;dlend);
      let dlgb=str.tof64(dlstr);
      let totalstart=sepidx + str.len(unit) + 1;
      let totalend=mut.totalstart;
      let linelen=str.len(line);
      lp(let lv2=0;true;lv2=lv2){
        if(!(totalend<linelen)){
          let totalstr=str.substr(line;totalstart;totalend);
          let totalgb=str.tof64(totalstr);
          let dlbytes=str.toi64(str.fromf64(dlgb * str.tof64(str.fromint(multiplier))));
          let totalbytes=str.toi64(str.fromf64(totalgb * str.tof64(str.fromint(multiplier))));
          <$bytesinfo{downloaded:dlbytes;total:totalbytes}
        }el{
          let ch2=str.charat(line;totalend);
          if(str.isdigit(ch2)){ totalend=totalend + 1 }el{
            if(str.eq(ch2;".")){ totalend=totalend + 1 }el{
              let totalstr=str.substr(line;totalstart;totalend);
              let totalgb=str.tof64(totalstr);
              let dlbytes=str.toi64(str.fromf64(dlgb * str.tof64(str.fromint(multiplier))));
              let totalbytes=str.toi64(str.fromf64(totalgb * str.tof64(str.fromint(multiplier))));
              <$bytesinfo{downloaded:dlbytes;total:totalbytes}
            }
          }
        }
      }
    }el{
      let ch3=str.charat(line;dlstart);
      if(str.isdigit(ch3)){ dlstart=dlstart - 1 }el{
        if(str.eq(ch3;".")){ dlstart=dlstart - 1 }el{
          let dlstr=str.substr(line;dlstart + 1;dlend);
          let dlgb=str.tof64(dlstr);
          let totalstart=sepidx + str.len(unit) + 1;
          let totalend=mut.totalstart;
          let linelen=str.len(line);
          lp(let lv3=0;true;lv3=lv3){
            if(!(totalend<linelen)){
              let totalstr=str.substr(line;totalstart;totalend);
              let totalgb=str.tof64(totalstr);
              let dlbytes=str.toi64(str.fromf64(dlgb * str.tof64(str.fromint(multiplier))));
              let totalbytes=str.toi64(str.fromf64(totalgb * str.tof64(str.fromint(multiplier))));
              <$bytesinfo{downloaded:dlbytes;total:totalbytes}
            }el{
              let ch4=str.charat(line;totalend);
              if(str.isdigit(ch4)){ totalend=totalend + 1 }el{
                if(str.eq(ch4;".")){ totalend=totalend + 1 }el{
                  let totalstr=str.substr(line;totalstart;totalend);
                  let totalgb=str.tof64(totalstr);
                  let dlbytes=str.toi64(str.fromf64(dlgb * str.tof64(str.fromint(multiplier))));
                  let totalbytes=str.toi64(str.fromf64(totalgb * str.tof64(str.fromint(multiplier))));
                  <$bytesinfo{downloaded:dlbytes;total:totalbytes}
                }
              }
            }
          }
        }
      }
    }
  }
};

f=extracteta(line:str):i64{
  let idx=str.lastindexof(line;"s");
  if(!(idx>0)){ <0 }el{
    let before=str.charat(line;idx - 1);
    if(str.isdigit(before)){
      let start=mut.idx - 1;
      lp(let lv=0;true;lv=lv){
        if(start < 0){
          let numstr=str.substr(line;0;idx);
          <str.toi64(numstr)
        }el{
          let ch5=str.charat(line;start);
          if(str.isdigit(ch5)){ start=start - 1 }el{
            let numstr=str.substr(line;start + 1;idx);
            <str.toi64(numstr)
          }
        }
      }
    }el{
      <0
    }
  }
};

(* LS1.1t. Whether any listed model name contains `modelid`. It used json.getarray over a
   json.decode handle, which are two of std.json's untyped ABI names reading a different
   representation (T-32), so it found nothing even once the answer was returned. These are the
   typed accessors, with $ok first, because a stdlib result binds its arms by position. *)
f=namesmatch(models:@$json;modelid:str):bool{
  let found=mut.false;
  lp(let ii=0;ii<models.len;ii=ii+1){
    let name=mt json.str(models.get(ii);"name") {$ok:v v; $err:e ""};
    if(str.contains(name;modelid)){ found=true }el{}
  };
  <found
};

f=parsemodeltagserr(e:str):bool{
  log.warn(str.concat("failed to parse tags response: ";e);"installer.pull";"system");
  <false
};

f=handlemodeltagsresp(r:$httpresp;modelid:str):bool{
  if(r.status == 200){
    (* Returned: the match used to be a statement, so a 200 fell through to toke's implicit
       `ret 0`, and "is the model installed?" answered false whenever Ollama said yes. *)
    let obj=json.dec(str.frombytes(r.body));
    <mt json.arr(obj;"models") {
      $ok:models namesmatch(models;modelid);
      $err:e parsemodeltagserr("no models array")
    }
  }el{
    log.warn(str.concat("ollama tags returned status: ";str.fromint(r.status as i64));"installer.pull";"system");
    <false
  }
};

f=handlemodeltagserr(e:str):bool{
  log.warn(str.concat("ollama not reachable: ";e);"installer.pull";"system");
  <false
};

f=ismodelavailable(modelid:str):bool{
  log.info(str.concat("checking model availability: ";modelid);"installer.pull";"system");
  let resp=http.get("http://localhost:11434/api/tags");
  <mt resp {
    $ok:r handlemodeltagsresp(r;modelid);
    $err:e handlemodeltagserr(e)
  }
};

f=parseinstalledmodels(output:str):@str{
  let lines=str.split(output;"
");
  (* `mut.` and an assignment below: `models.push(modelname)` discarded the new array (T-24),
     so this listed **no installed models, ever**, whatever `ollama list` printed. *)
  let models=mut.@();
  let i=mut.0;
  lp(let ii=0;ii<lines.len;ii=ii+1){     if(i > 0){
      let trimmed=str.trim(lines.get(ii));
      if(str.len(trimmed) > 0){
        let name=str.splitfirst(trimmed;" ");
        let nametab=str.splitfirst(trimmed;"	");
        let modelname=mut.nametab;
        if(str.len(name) > 0){modelname=name}el{};
        if(str.len(modelname) > 0){
          models=models.push(modelname)
        }el{}
      }el{}
    }el{};
    i=i+1
  };
  <models
};

f=listinstalledmodelserr(e:str):@str{
  log.warn(str.concat("failed to run ollama list: ";e);"installer.pull";"system");
  <@()
};

f=listinstalledmodels():@str{
  log.info("listing installed models";"installer.pull";"system");
  let result=proc.exec(@("ollama";"list"));
  <mt result {
    $ok:output parseinstalledmodels(output);
    $err:e listinstalledmodelserr(e)
  }
};

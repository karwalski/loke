m=core.installer.install;
i=str:std.str;
i=log:shared.log;
i=sys:std.sys;
i=process:std.process;
i=http:std.http;
i=detect:core.installer.detect;

t=$installresult{
  success:bool;
  message:str;
  version:str
};

f=handleextract(h:i64):$installresult{
  let code=process.wait(h);
  let c=mt code {
    $ok:c c;
    $err:e $installresult{success:false;message:"extract wait failed";version:""}
  };
  if(!(c = 0)){
    <$installresult{success:false;message:"failed to extract Ollama zip";version:""}
  }el{};
  <$installresult{success:true;message:"";version:""}
};

f=downloadollamamacos():$installresult{
  log.info("downloading Ollama for macOS";"installer.install";"system");

  let datadir=sys.datadir("loke");
  let bindir=str.concat(datadir;"/bin");
  let ollamapath=str.concat(bindir;"/ollama");
  let zippath=str.concat(datadir;"/Ollama-darwin.zip");

  let mkdirhandle=process.spawn("mkdir";@("-p";bindir));
  mt mkdirhandle {
    $ok:h process.wait(h);
    $err:e $installresult{success:false;message:"failed to create bin directory";version:""}
  };

  let client=http.client("https://ollama.com");
  let dlresult=http.downloadfile(client;"https://ollama.com/download/Ollama-darwin.zip";zippath);
  if(!(dlresult = 0)){
    log.error("failed to download Ollama zip";"installer.install";"system");
    <$installresult{success:false;message:"download failed  try manually from https://ollama.com/download";version:""}
  }el{};

  log.info("extracting Ollama zip";"installer.install";"system");

  let extracthandle=process.spawn("unzip";@("-o";zippath;"-d";datadir));
  mt extracthandle {
    $ok:h handleextract(h);
    $err:e $installresult{success:false;message:"could not run unzip";version:""}
  };

  let chmodhandle=process.spawn("chmod";@("+x";ollamapath));
  mt chmodhandle {
    $ok:h process.wait(h);
    $err:e 0
  };

  let verify=verifyinstallat(ollamapath);
  if(verify.success){
    log.info(str.concat("macOS install complete: ";verify.version);"installer.install";"system")
  }el{
    log.error("macOS install verification failed";"installer.install";"system")
  };

  let rmhandle=process.spawn("rm";@("-f";zippath));
  mt rmhandle {
    $ok:h process.wait(h);
    $err:e 0
  };

  <verify
};

f=downloadollamawindows():$installresult{
  log.info("downloading Ollama for Windows";"installer.install";"system");

  let datadir=sys.datadir("loke");
  let exepath=str.concat(datadir;"/OllamaSetup.exe");

  let client=http.client("https://ollama.com");
  let dlresult=http.downloadfile(client;"https://ollama.com/download/OllamaSetup.exe";exepath);
  if(!(dlresult = 0)){
    log.error("failed to download Ollama installer";"installer.install";"system");
    <$installresult{success:false;message:"download failed  try manually from https://ollama.com/download";version:""}
  }el{};

  log.info("running Ollama installer";"installer.install";"system");

  let installhandle=process.spawn(exepath;@("/S";"/CURRENTUSER"));
  let h=mt installhandle {
    $ok:h h;
    $err:e $installresult{success:false;message:"could not run installer";version:""}
  };
  let code=process.wait(h);
  let c=mt code {
    $ok:c c;
    $err:e $installresult{success:false;message:"installer wait failed";version:""}
  };
  if(!(c = 0)){
    <$installresult{success:false;message:"installer exited with error";version:""}
  }el{};

  let rmhandle=process.spawn("del";@(exepath));
  mt rmhandle {
    $ok:h process.wait(h);
    $err:e 0
  };

  <verifyinstall()
};

f=downloadollamalinux():$installresult{
  log.info("downloading Ollama for Linux";"installer.install";"system");

  let datadir=sys.datadir("loke");
  let scriptpath=str.concat(datadir;"/install_ollama.sh");

  let client=http.client("https://ollama.com");
  let dlresult=http.downloadfile(client;"https://ollama.com/install.sh";scriptpath);
  if(!(dlresult = 0)){
    log.error("failed to download Ollama install script";"installer.install";"system");
    <$installresult{success:false;message:"download failed  try manually: curl -fsSL https://ollama.com/install.sh | sh";version:""}
  }el{};

  log.info("running Ollama install script";"installer.install";"system");

  let installhandle=process.spawn("sh";@(scriptpath));
  let h2=mt installhandle {
    $ok:h h;
    $err:e $installresult{success:false;message:"could not run install script";version:""}
  };
  let code2=process.wait(h2);
  let c2=mt code2 {
    $ok:c c;
    $err:e $installresult{success:false;message:"install script wait failed";version:""}
  };
  if(!(c2 = 0)){
    <$installresult{success:false;message:"install script exited with error";version:""}
  }el{};

  let rmhandle=process.spawn("rm";@("-f";scriptpath));
  mt rmhandle {
    $ok:h process.wait(h);
    $err:e 0
  };

  <verifyinstall()
};

f=installollama():$installresult{
  log.info("starting Ollama installation";"installer.install";"system");

  let plathandle=process.spawn("uname";@("-s"));
  let platform=mut."unknown";
  let plath=mt plathandle {
    $ok:h h;
    $err:e 0
  };
  if(!(plath = 0)){
    mt process.wait(plath) {
      $ok:c c;
      $err:e 0
    };
    let stdout=mt process.stdout(plath) {
      $ok:v v;
      $err:e ""
    };
    if(str.contains(stdout;"Darwin")){ platform="macos" }el{};
    if(str.contains(stdout;"Linux")){ platform="linux" }el{}
  }el{};

  if(str.eq(platform;"macos")){
    log.info("platform: macOS";"installer.install";"system");
    <downloadollamamacos()
  }el{
    if(str.eq(platform;"linux")){
      log.info("platform: Linux";"installer.install";"system");
      <downloadollamalinux()
    }el{
      log.info("platform: Windows (assumed)";"installer.install";"system");
      <downloadollamawindows()
    }
  }
};

f=verifyinstall():$installresult{
  log.info("verifying Ollama installation";"installer.install";"system");
  let check=detect.detectollamainstalled();
  if(check.ok){
    <$installresult{success:true;message:"Ollama installed successfully";version:check.value}
  }el{
    <$installresult{success:false;message:str.concat("verification failed: ";check.error);version:""}
  }
};

f=verifyinstallat(path:str):$installresult{
  log.info(str.concat("verifying Ollama at: ";path);"installer.install";"system");
  let handle=process.spawn(path;@("--version"));
  let h=mt handle {
    $ok:h h;
    $err:e $installresult{success:false;message:"could not run ollama at install path";version:""}
  };
  let code=process.wait(h);
  let c=mt code {
    $ok:c c;
    $err:e $installresult{success:false;message:"verify wait failed";version:""}
  };
  if(!(c = 0)){
    <$installresult{success:false;message:"ollama exited with non-zero code";version:""}
  }el{};
  let out=process.stdout(h);
  mt out {
    $ok:v $installresult{success:true;message:"Ollama installed successfully";version:v};
    $err:e $installresult{success:true;message:"installed but could not read version";version:"unknown"}
  }
};


m=core.installer.verify;
i=ollama:core.models.ollama;
i=str:std.str;
i=log:shared.log;
i=time:std.time;

t=$verificationresult{
  success:bool;
  modelid:$str;
  responsetext:$str;
  latencyms:i64;
  throughputtokpersec:f64;
  errormsg:$str
};

f=verifymodel(modelid:$str):$verificationresult{
  log.info(str.concat("verifying model ";modelid);"installer.verify";"system");
  let client=ollama.new("http://localhost:11434");

  let status=mt ollama.healthcheck(client);
  status {
    $unreachable:i64;
      log.error(str.concat("ollama unreachable during verification of ";modelid);"installer.verify";"system");
      <$verificationresult{
        success:false;
        modelid:$modelid;
        responsetext:"";
        latencyms:0;
        throughputtokpersec:0.0;
        errormsg:"Ollama is not reachable at http://localhost:11434"
      };
    $stopped:i64;
      log.error(str.concat("ollama stopped during verification of ";modelid);"installer.verify";"system");
      <$verificationresult{
        success:false;
        modelid:$modelid;
        responsetext:"";
        latencyms:0;
        throughputtokpersec:0.0;
        errormsg:"Ollama is installed but not running"
      };
    $running:i64;
      let start=time.nowms();
      let opts=$ollama.$generateopts{
        model:$modelid;
        prompt:"What is 2 + 2? Reply with just the number.";
        system:"You are a helpful assistant. Reply concisely.";
        numgpu:0
      };
      let genresult=ollama.generate(client;opts);
      let elapsed=mt time.elapsedms(start);
      genresult {
        $lokeerr e;
          let msg=str.concat("verification generate failed for ";str.concat(modelid;str.concat(": ";e.message)));
          log.error(msg;"installer.verify";"system");
          <$verificationresult{
            success:false;
            modelid:$modelid;
            responsetext:"";
            latencyms:$elapsed;
            throughputtokpersec:0.0;
            errormsg:$msg
          };
        response;
          let hasfour=str.contains(response;"4");
          if(hasfour){
            log.info(str.concat("model ";str.concat(modelid;str.concat(" verified in ";str.concat(str.fromint(elapsed);"ms"))));"installer.verify";"system");
            <$verificationresult{
              success:true;
              modelid:$modelid;
              responsetext:$response;
              latencyms:$elapsed;
              throughputtokpersec:0.0;
              errormsg:""
            };
          }el{
            let msg=str.concat("model responded but answer does not contain '4': ";response);
            log.warn(msg;"installer.verify";"system");
            <$verificationresult{
              success:false;
              modelid:$modelid;
              responsetext:$response;
              latencyms:$elapsed;
              throughputtokpersec:0.0;
              errormsg:$msg
            };
          };
      };
  };
};

f=measurethroughput(modelid:$str):$verificationresult{
  log.info(str.concat("measuring throughput for ";modelid);"installer.verify";"system");
  let client=ollama.new("http://localhost:11434");

  let start=time.nowms();
  let opts=$ollama.$generateopts{
    model:$modelid;
    prompt:"Explain in exactly five sentences why the sky appears blue during the day. Be concise and scientific.";
    system:"You are a science educator. Respond in exactly five sentences.";
    numgpu:0
  };
  let genresult=ollama.generate(client;opts);
  let elapsed=mt time.elapsedms(start);

  genresult {
    $lokeerr e;
      let msg=str.concat("throughput measurement failed for ";str.concat(modelid;str.concat(": ";e.message)));
      log.error(msg;"installer.verify";"system");
      <$verificationresult{
        success:false;
        modelid:$modelid;
        responsetext:"";
        latencyms:$elapsed;
        throughputtokpersec:0.0;
        errormsg:$msg
      };
    response;
      let wordcount=str.wordcount(response);
      let approxtokens=wordcount * 1.3;
      let elapsedsec=elapsed / 1000.0;
      let tokpersec=if(elapsedsec > 0.0){ approxtokens / elapsedsec }el{ 0.0 };

      log.info(str.concat("throughput for ";str.concat(modelid;str.concat(": ";str.concat(str.fromfloat(tokpersec;1);" tok/s"))));"installer.verify";"system");
      <$verificationresult{
        success:true;
        modelid:$modelid;
        responsetext:$response;
        latencyms:$elapsed;
        throughputtokpersec:$tokpersec;
        errormsg:""
      };
  };
};

f=verifywithretry(modelid:$str;maxretries:i64):$verificationresult{
  log.info(str.concat("verify_with_retry for ";str.concat(modelid;str.concat(" max_retries=";str.fromint(maxretries))));"installer.verify";"system");

  let result=verifymodel(modelid);
  if(result.success){
    <result
  }el{
    if(maxretries > 0){
      log.warn(str.concat("verification failed, retrying (";str.concat(str.fromint(maxretries);" retries remaining)"));"installer.verify";"system");
      time.sleepms(10000);
      <verifywithretry(modelid;maxretries - 1)
    }el{
      let msg=str.concat("verification failed after all retries for ";str.concat(modelid;str.concat(". Last error: ";result.errormsg)));
      log.error(msg;"installer.verify";"system");
      <$verificationresult{
        success:false;
        modelid:$result.modelid;
        responsetext:$result.responsetext;
        latencyms:$result.latencyms;
        throughputtokpersec:$result.throughputtokpersec;
        errormsg:$str.concat(msg;str.concat(". Try: ollama run ";modelid))
      };
    };
  };
};

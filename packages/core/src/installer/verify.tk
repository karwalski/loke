m=core.installer.verify;
i=ollama:core.models.ollama;
i=str:std.str;
i=log:shared.log;
i=time:std.time;

t=$verificationresult{
  success:bool;
  modelid:str;
  responsetext:str;
  latencyms:i64;
  throughputtokpersec:f64;
  errormsg:str
};

f=verifyfailresult(modelid:str;errormsg:str):$verificationresult{
  <$verificationresult{
    success:false;
    modelid:modelid;
    responsetext:"";
    latencyms:0;
    throughputtokpersec:0.0;
    errormsg:errormsg
  }
};

f=verifygenresult(modelid:str;response:str;elapsed:i64):$verificationresult{
  let hasfour=str.contains(response;"4");
  if(hasfour){
    <$verificationresult{
      success:true;
      modelid:modelid;
      responsetext:response;
      latencyms:elapsed;
      throughputtokpersec:0.0;
      errormsg:""
    }
  }el{
    let msg=str.concat("model responded but answer does not contain '4': ";response);
    <$verificationresult{
      success:false;
      modelid:modelid;
      responsetext:response;
      latencyms:elapsed;
      throughputtokpersec:0.0;
      errormsg:msg
    }
  }
};

f=verifygenerate(client:$ollamaclient;modelid:str):$verificationresult{
  let start=time.nowms();
  let opts=$generateopts{
    model:modelid;
    prompt:"What is 2 + 2? Reply with just the number.";
    system:"You are a helpful assistant. Reply concisely.";
    numgpu:0
  };
  (* VM1.6d. generateplain, not a match on generate's result: T-18 takes the first arm of
     that match whatever the value is, so a failed generate was read as a response. *)
  let response=ollama.generateplain(client;opts);
  let elapsed=time.elapsedms(start);
  if(str.len(response)==0){
    <verifyfailresult(modelid;"verification generate failed for \(modelid): no response from Ollama")
  }el{};
  <verifygenresult(modelid;response;elapsed)
};

f=verifymodel(modelid:str):$verificationresult{
  log.info(str.concat("verifying model ";modelid);"installer.verify";"system");
  let client=ollama.new("http://localhost:11434");

  let status:$ollamastatus=ollama.healthcheck(client);
  <mt status {
    $unreachable:v verifyfailresult(modelid;"Ollama is not reachable at http://localhost:11434");
    $stopped:v verifyfailresult(modelid;"Ollama is installed but not running");
    $running:v verifygenerate(client;modelid)
  }
};

f=throughputresult(modelid:str;response:str;elapsed:i64):$verificationresult{
  let wordcount=str.fields(response).len;
  let approxtokens=wordcount * 1.3;
  let elapsedsec=(elapsed as f64) / 1000.0;
  let tokpersec=mut.0.0;
  if(elapsedsec > 0.0){ tokpersec=approxtokens / elapsedsec }el{};
  <$verificationresult{
    success:true;
    modelid:modelid;
    responsetext:response;
    latencyms:elapsed;
    throughputtokpersec:tokpersec;
    errormsg:""
  }
};

f=measurethroughput(modelid:str):$verificationresult{
  log.info(str.concat("measuring throughput for ";modelid);"installer.verify";"system");
  let client=ollama.new("http://localhost:11434");

  let start=time.nowms();
  let opts=$generateopts{
    model:modelid;
    prompt:"Explain in exactly five sentences why the sky appears blue during the day. Be concise and scientific.";
    system:"You are a science educator. Respond in exactly five sentences.";
    numgpu:0
  };
  let response=ollama.generateplain(client;opts);
  let elapsed=time.elapsedms(start);

  if(str.len(response)==0){
    <$verificationresult{
      success:false;
      modelid:modelid;
      responsetext:"";
      latencyms:elapsed;
      throughputtokpersec:0.0;
      errormsg:"throughput measurement failed for \(modelid): no response from Ollama"
    }
  }el{};
  <throughputresult(modelid;response;elapsed)
};

f=verifywithretry(modelid:str;maxretries:i64):$verificationresult{
  log.info("verify_with_retry for \(modelid) max_retries=\(str.fromint(maxretries))";"installer.verify";"system");

  let result=verifymodel(modelid);
  if(result.success){
    <result
  }el{
    if(maxretries > 0){
      log.warn("verification failed, retrying (\(str.fromint(maxretries)) retries remaining)";"installer.verify";"system");
      time.sleepms(10000);
      <verifywithretry(modelid;maxretries - 1)
    }el{
      let msg="verification failed after all retries for \(modelid). Last error: \(result.errormsg)";
      log.error(msg;"installer.verify";"system");
      <$verificationresult{
        success:false;
        modelid:modelid;
        responsetext:"";
        latencyms:0;
        throughputtokpersec:0.0;
        errormsg:"\(msg). Try: ollama run \(modelid)"
      }
    }
  }
};

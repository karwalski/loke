m=core.installer.updater;

i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=db:storage.db;
i=proc:std.process;
i=time:std.time;

t=$updatecheck{
  modelid:str;
  installeddigest:str;
  latestdigest:str;
  updateavailable:bool;
  releasenotes:str
};

t=$updateconfig{
  checkintervaldays:i64;
  autocheck:bool;
  lastchecked:i64
};

f=defaultconfig():$updateconfig{
  <$updateconfig{
    checkintervaldays:7;
    autocheck:true;
    lastchecked:0
  }
};

f=loadconfig(store:i64):$updateconfig{
  let interval=mt db.getstr(store;"installer.update_interval_days") {
    $ok:v str.toint(v);
    $err:e 7
  };
  let auto=mt db.getstr(store;"installer.auto_check") {
    $ok:v str.eq(v;"true");
    $err:e true
  };
  let last=mt db.getstr(store;"installer.last_model_check") {
    $ok:v str.toint(v);
    $err:e 0
  };
  <$updateconfig{
    checkintervaldays:interval;
    autocheck:auto;
    lastchecked:last
  }
};

f=saveconfig(store:i64;config:$updateconfig):bool{
  mt db.setstr(store;"installer.update_interval_days";str.fromint(config.checkintervaldays);"installer") {
    $ok:v 0;
    $err:e 0
  };
  let autocheckstr=mut."false"; if(config.autocheck){autocheckstr="true"}el{};
  mt db.setstr(store;"installer.auto_check";autocheckstr;"installer") {
    $ok:v 0;
    $err:e 0
  };
  mt db.setstr(store;"installer.last_model_check";str.fromint(config.lastchecked);"installer") {
    $ok:v 0;
    $err:e 0
  };
  <true
};

f=checkdue(config:$updateconfig):bool{
  if(config.autocheck=false){
    <false
  }el{};
  let now=time.nowms();
  let intervalms=config.checkintervaldays * 86400000;
  <(now - config.lastchecked) > intervalms
};

f=parsedigestfromlist(out:str;modelid:str):str{
  let lines=str.split(out;"
");
  let found="";
  lp(let i=0;i<str.arraylen(lines);i=i+1){ let line=str.arrayget(lines;i);
    if(str.contains(line;modelid)){
      let parts=str.splitwhitespace(line);
      if(str.len(parts) > 2){
        found=parts.get(1)
      }el{}
    }el{}
  };
  <found
};

f=digestlisterr(e:i64):str{
  log.warn(
    str.concat("failed to get installed digest: ";e.message);
    "installer.updater";
    "system"
  );
  <""
};

f=getinstalleddigest(modelid:str):str{
  let result=proc.exec("ollama";@("list"));
  mt result {
    $ok:out parsedigestfromlist(out;modelid);
    $err:e digestlisterr(e)
  }
};

f=parsedigestresponse(r:i64):str{
  let parsed=json.parse(r.body);
  let digest=json.getstr(parsed;"digest");
  if(str.len(digest) > 0){
    <digest
  }el{};
  let info=json.getobj(parsed;"modelinfo");
  let d2=json.getstr(info;"general.file_type");
  <d2
};

f=latestdigesterr(e:i64):str{
  log.warn(
    str.concat("failed to query model info: ";e.message);
    "installer.updater";
    "system"
  );
  <""
};

f=getlatestdigest(modelid:str):str{
  let body=str.concat("{\"name\":\"";str.concat(modelid;"\"}"));
  let resp=http.post(
    "http://localhost:11434/api/show";
    body;
    @(http.header("Content-Type";"application/json"))
  );
  mt resp {
    $ok:r parsedigestresponse(r);
    $err:e latestdigesterr(e)
  }
};

f=checkmodelupdate(modelid:str):$updatecheck{
  let installed=getinstalleddigest(modelid);
  let latest=getlatestdigest(modelid);
  let available=mut.false; if(str.len(installed) > 0){
    if(str.len(latest) > 0){
      available=str.eq(installed;latest)=false
    }el{}
  }el{};
  let availablestr=mut."false"; if(available){availablestr="true"}el{};
  log.info(
    str.concat(
      str.concat("model update check for ";modelid);
      str.concat(": available=";availablestr)
    );
    "installer.updater";
    "system"
  );
  <$updatecheck{
    modelid:modelid;
    installeddigest:installed;
    latestdigest:latest;
    updateavailable:available;
    releasenotes:""
  }
};

f=verifyupdate(modelid:str;olddigest:str):bool{
  let newdigest=getinstalleddigest(modelid);
  if(str.len(newdigest) = 0){
    log.warn(
      str.concat("model not found after update: ";modelid);
      "installer.updater";
      "system"
    );
    <false
  }el{};
  if(str.len(olddigest) > 0){
    if(str.eq(olddigest;newdigest)){
      log.info(
        str.concat("model already at latest: ";modelid);
        "installer.updater";
        "system"
      );
      <true
    }el{}
  }el{};
  log.info(
    str.concat(
      str.concat("model updated: ";modelid);
      str.concat(" digest: ";newdigest)
    );
    "installer.updater";
    "system"
  );
  <true
};

f=handleupdatefailed(e:i64):bool{
  log.warn(
    str.concat("model update failed: ";e.message);
    "installer.updater";
    "system"
  );
  <false
};

f=updatemodel(modelid:str):bool{
  log.info(
    str.concat("pulling update for ";modelid);
    "installer.updater";
    "system"
  );
  let olddigest=getinstalleddigest(modelid);
  let pullresult=proc.exec("ollama";@("pull";modelid));
  mt pullresult {
    $ok:out verifyupdate(modelid;olddigest);
    $err:e handleupdatefailed(e)
  }
};

f=periodiccheck(store:i64;modelid:str):$updatecheck{
  let config=loadconfig(store);
  if(checkdue(config)=false){
    <$updatecheck{
      modelid:modelid;
      installeddigest:"";
      latestdigest:"";
      updateavailable:false;
      releasenotes:""
    }
  }el{};
  let result=checkmodelupdate(modelid);
  let now=time.nowms();
  let updatedconfig=$updateconfig{
    checkintervaldays:config.checkintervaldays;
    autocheck:config.autocheck;
    lastchecked:now
  };
  saveconfig(store;updatedconfig);
  <result
};

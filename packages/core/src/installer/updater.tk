m=core.installer.updater;

i=json:std.json;
i=jx:shared.jsonobj;
i=reach:shared.reachability;
i=cli:core.installer.ollamacli;
i=str:std.str;
i=log:shared.log;
i=db:core.storage.db;
i=proc:std.process;
i=time:std.time;

t=$updatecheck{
  modelid:str;
  installeddigest:str;
  latestdigest:str;
  updateavailable:bool;
  releasenotes:str
};

t=$updateconfig{
  checkintervaldays:i64;
  autocheck:bool;
  lastchecked:i64
};

(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=defaultconfig():$updateconfig{
  <$updateconfig{
    checkintervaldays:7;
    autocheck:true;
    lastchecked:0
  }
};

f=loadconfig(store:$store):$updateconfig{
  let interval=mt db.getstr(store;"installer.update_interval_days") {
    $ok:v mt str.toint(v){$ok:okv okv;$err:errv 0};
    $err:e 7
  };
  let auto=mt db.getstr(store;"installer.auto_check") {
    $ok:v str.eq(v;"true");
    $err:e true
  };
  let last=mt db.getstr(store;"installer.last_model_check") {
    $ok:v mt str.toint(v){$ok:okv okv;$err:errv 0};
    $err:e 0
  };
  <$updateconfig{
    checkintervaldays:interval;
    autocheck:auto;
    lastchecked:last
  }
};

f=saveconfig(store:$store;config:$updateconfig):bool{
  mt db.setstr(store;"installer.update_interval_days";str.fromint(config.checkintervaldays);"installer") {
    $ok:v 0;
    $err:e 0
  };
  let autocheckstr=mut."false"; if(config.autocheck){autocheckstr="true"}el{};
  mt db.setstr(store;"installer.auto_check";autocheckstr;"installer") {
    $ok:v 0;
    $err:e 0
  };
  mt db.setstr(store;"installer.last_model_check";str.fromint(config.lastchecked);"installer") {
    $ok:v 0;
    $err:e 0
  };
  <true
};

f=checkdue(config:$updateconfig):bool{
  if(config.autocheck==false){
    <false
  }el{};
  <(time.nowms() - config.lastchecked) > (config.checkintervaldays * 86400000)
};

(* F10.40: the ID column of `ollama list` for the row whose NAME is the model (name, or
   name:latest). This split each line on single spaces, so with the columns aligned by runs
   of spaces it read the empty string between NAME and ID; and it took any line that merely
   contained the id, so "qwen2.5:7b" also matched "qwen2.5:7b-instruct". *)
f=parsedigestfromlist(out:str;modelid:str):str{
  let rows=cli.listrows(out);
  let found=mut."";
  lp(let k=0;k<rows.len;k=k+1){
    let parts:@str=rows.get(k);
    if(cli.samemodel(parts.get(0);modelid)){ found=parts.get(1) }el{}
  };
  <found
};

(* F10.40: `ollama list` as an argv spawn (core.installer.ollamacli); handed to
   process.exec as an array, it never ran (F10.39). A command that did not start or exited
   non-zero answers no digest, which every caller reads as "not installed / unknown". *)
f=getinstalleddigest(modelid:str):str{
  let r=cli.run(@("ollama";"list");false);
  if(!r.ok){
    log.warn("failed to get installed digest: ollama list failed (exit \(str.fromint(r.code)))";"installer.updater";"system");
    <""
  }el{};
  <parsedigestfromlist(r.out;modelid)
};

(* Read through the typed decoder and shared.jsonobj; json.decode and json.str on the
   untyped handle are the shape that crashes on a str. *)
f=parsedigestresponse(raw:str):str{
  let parsed=mt json.dec(raw) {
    $ok:o o;
    $jsonerr:e jx.emptyobj()
  };
  let digest=jx.strvalue(parsed;"digest";"");
  if(str.len(digest) > 0){
    <digest
  }el{};
  <jx.strvalue(jx.nested(parsed;"modelinfo");"general.file_type";"")
};

(* VM1.6f. The request was `http.postheaders(http.client(url);"";...)`. The runtime reads
   postheaders' first argument as a URL string, so nothing was sent (T-48), and the latest
   digest was always "", so checkmodelupdate never reported an update. reach.localpost
   sends it. The model id is escaped; it was spliced in raw. *)
f=getlatestdigestat(baseurl:str;modelid:str):str{
  let raw=reach.localpost(baseurl;"/api/show";"{\"name\":\(jx.escape(modelid))}");
  if(str.len(raw)==0){
    log.warn("failed to query model info: no answer from /api/show";"installer.updater";"system");
    <""
  }el{};
  <parsedigestresponse(raw)
};

f=getlatestdigest(modelid:str):str{
  <getlatestdigestat("http://localhost:11434";modelid)
};

f=checkmodelupdate(modelid:str):$updatecheck{
  let installed=getinstalleddigest(modelid);
  let latest=getlatestdigest(modelid);
  let available=mut.false; if(str.len(installed) > 0){
    if(str.len(latest) > 0){
      available=str.eq(installed;latest)==false
    }el{}
  }el{};
  let availablestr=mut."false"; if(available){availablestr="true"}el{};
  log.info(
    "model update check for \(modelid): available=\(availablestr)";
    "installer.updater";
    "system"
  );
  <$updatecheck{
    modelid:modelid;
    installeddigest:installed;
    latestdigest:latest;
    updateavailable:available;
    releasenotes:""
  }
};

f=verifyupdate(modelid:str;olddigest:str):bool{
  let newdigest=getinstalleddigest(modelid);
  if(str.len(newdigest) == 0){
    log.warn(
      str.concat("model not found after update: ";modelid);
      "installer.updater";
      "system"
    );
    <false
  }el{};
  if(str.len(olddigest) > 0){
    if(str.eq(olddigest;newdigest)){
      log.info(
        str.concat("model already at latest: ";modelid);
        "installer.updater";
        "system"
      );
      <true
    }el{}
  }el{};
  log.info(
    "model updated: \(modelid) digest: \(newdigest)";
    "installer.updater";
    "system"
  );
  <true
};

f=handleupdatefailed(why:str):bool{
  log.warn("model update failed: \(why)";"installer.updater";"system");
  <false
};

(* F10.40, the decision before `ollama pull` runs from an action. It runs only for an id
   that ollamacli.validmodelid accepts, so it cannot be read as an option, and only from
   `loke update [model]` (cli.modelmgmt), which the user types to ask for exactly this; no
   page calls it. It runs as an argv spawn, draining stderr first because that is where
   pull writes its progress; a non-zero exit is a failed update, and a zero exit is still
   checked by listing again (verifyupdate). *)
f=updatemodel(modelid:str):bool{
  if(!cli.validmodelid(modelid)){
    <handleupdatefailed("not a model name: refusing to pass it to ollama pull")
  }el{};
  log.info(
    str.concat("pulling update for ";modelid);
    "installer.updater";
    "system"
  );
  let olddigest=getinstalleddigest(modelid);
  let r=cli.run(@("ollama";"pull";modelid);true);
  if(!r.ok){
    <handleupdatefailed("ollama pull exited \(str.fromint(r.code))")
  }el{};
  <verifyupdate(modelid;olddigest)
};

f=periodiccheck(store:$store;modelid:str):$updatecheck{
  let config=loadconfig(store);
  if(checkdue(config)==false){
    <$updatecheck{
      modelid:modelid;
      installeddigest:"";
      latestdigest:"";
      updateavailable:false;
      releasenotes:""
    }
  }el{};
  let result=checkmodelupdate(modelid);
  let updatedconfig=$updateconfig{
    checkintervaldays:config.checkintervaldays;
    autocheck:config.autocheck;
    lastchecked:time.nowms()
  };
  saveconfig(store;updatedconfig);
  <result
};

m=core.installer.uninstall;

i=t:shared.types;
i=str:std.str;
i=log:shared.log;
i=proc:std.process;
i=file:std.file;
i=json:std.json;
i=http:std.http;

t=$removablemodel{
  name:str;
  size:str;
  digest:str;
  modified:str
};

t=$uninstallresult{
  success:bool;
  message:str;
  freedspace:str
};

f=parseremovablefromapi(r:i64;inmodels:@$removablemodel):@$removablemodel{
  let parsed=json.parse(r.body);
  let modellist=json.getarr(parsed;"models");
  let i=mut.0;
  let models=mut.inmodels;
  lp(let lv=0;true;lv=lv){
    if(!(i<json.arrlen(modellist))){
      <models
    }el{
      let m=json.arrget(modellist;i);
      let name=json.str(m;"name");
      let sizebytes=json.i64(m;"size");
      let size=formatsize(sizebytes);
      let digest=json.str(m;"digest");
      let modified=json.str(m;"modified_at");
      models=models.push($removablemodel{
        name:name;
        size:size;
        digest:digest;
        modified:modified
      });
      i=i+1
    }
  }
};

f=parseremovablefromcli(out:str;inmodels:@$removablemodel):@$removablemodel{
  let lines=str.split(out;"
");
  let models=mut.inmodels;
  let j=mut.1;
  lp(let ii52=0;ii52<lines.len;ii52=ii52+1){
    let line=lines.get(ii52);
    if(j > 0){
      if(str.len(str.trim(line)) > 0){
        let parts=str.splitwhitespace(line);
        if(str.len(parts) > 3){
          let modifiedval=mut."";
          if(str.len(parts) > 4){modifiedval=parts.get(3)}el{};
          models=models.push($removablemodel{
            name:parts.get(0);
            size:parts.get(2);
            digest:parts.get(1);
            modified:modifiedval
          })
        }el{};
      }el{};
    }el{};
    j=j+1

  };
  <models
};

f=parseremovablefallback(e:str;models:@$removablemodel):@$removablemodel{
  let result=proc.exec("ollama";@("list"));
  mt result {
    $ok:out parseremovablefromcli(out;models);
    $err:e models
  }
};

f=listremovable():@$removablemodel{
  let models=mut.@($removablemodel);
  let resp=http.get("http://localhost:11434/api/tags");
  mt resp {
    $ok:r parseremovablefromapi(r;models);
    $err:e parseremovablefallback(e;models)
  }
};

f=formatsize(bytes:i64):str{
  let gb=bytes / 1073741824;
  let remainder=(bytes % 1073741824) * 10 / 1073741824;
  if(gb > 0){
    <str.concat(
      str.concat(str.fromint(gb);".");
      str.concat(str.fromint(remainder);" GB")
    )
  }el{};
  let mb=bytes / 1048576;
  if(mb > 0){
    <str.concat(str.fromint(mb);" MB")
  }el{};
  let kb=bytes / 1024;
  <str.concat(str.fromint(kb);" KB")
};

f=verifymodelremoval(modelid:str;modelsize:str):$uninstallresult{
  let after=listremovable();
  let stillexists=mut.false;
  lp(let ii112=0;ii112<after.len;ii112=ii112+1){
    let m=after.get(ii112);
    if(str.eq(m.name;modelid)){
      stillexists=true
    }el{}

  };
  if(stillexists){
    log.warn(
      str.concat("model still present after removal: ";modelid);
      "installer.uninstall";
      "system"
    );
    <$uninstallresult{
      success:false;
      message:str.concat("removal failed  model still present: ";modelid);
      freedspace:""
    }
  }el{};
  log.info(
    str.concat(
      str.concat("model removed: ";modelid);
      str.concat(" freed: ";modelsize)
    );
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:true;
    message:str.concat("removed ";modelid);
    freedspace:modelsize
  }
};

f=handlermfailed(e:i64):$uninstallresult{
  log.warn(
    str.concat("ollama rm failed: ";e.message);
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:false;
    message:str.concat("removal failed: ";e.message);
    freedspace:""
  }
};

f=uninstallmodel(modelid:str):$uninstallresult{
  let models=mut.listremovable();
  let modelsize=mut."";
  let found=mut.false;
  lp(let ii163=0;ii163<models.len;ii163=ii163+1){
    let m=models.get(ii163);
    if(str.eq(m.name;modelid)){
      modelsize=m.size;
      found=true
    }el{}

  };
  if(found=false){
    <$uninstallresult{
      success:false;
      message:str.concat("model not found: ";modelid);
      freedspace:""
    }
  }el{};
  log.info(
    str.concat("removing model: ";modelid);
    "installer.uninstall";
    "system"
  );
  let result=proc.exec("ollama";@("rm";modelid));
  mt result {
    $ok:out verifymodelremoval(modelid;modelsize);
    $err:e handlermfailed(e)
  }
};

f=handleollamaremoved(home:str):$uninstallresult{
  cleanpathentry(home);
  log.info(
    "Ollama binary removed  models in ~/.ollama left untouched";
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:true;
    message:"Ollama removed from ~/.loke/bin. Models in ~/.ollama were not removed.";
    freedspace:""
  }
};

f=handleollamaremovefailed(e:i64):$uninstallresult{
  log.warn(
    str.concat("failed to remove Ollama binary: ";e.message);
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:false;
    message:str.concat("removal failed: ";e.message);
    freedspace:""
  }
};

f=uninstallollama():$uninstallresult{
  let home=proc.env("HOME");
  let ollamapath=str.concat(home;"/.loke/bin/ollama");
  if(file.exists(ollamapath)=false){
    <$uninstallresult{
      success:false;
      message:"Ollama binary not found at ~/.loke/bin/ollama";
      freedspace:""
    }
  }el{};
  log.info(
    "removing Ollama binary from ~/.loke/bin/ollama";
    "installer.uninstall";
    "system"
  );
  let rmresult=file.remove(ollamapath);
  mt rmresult {
    $ok:v handleollamaremoved(home);
    $err:e handleollamaremovefailed(e)
  }
};

f=cleanprofilefile(profile:str;pathline:str):i64{
  let content=file.read(profile);
  mt content {
    $ok:c cleanprofilecontent(c;profile;pathline);
    $err:e 0
  }
};

f=cleanprofilecontent(c:str;profile:str;pathline:str):i64{
  if(str.contains(c;pathline)){
    let cleaned=str.replace(c;pathline;"");
    let cleaned=str.replace(cleaned;"


";"
");
    mt file.write(profile;cleaned) {
      $ok:v logpathcleaned(profile);
      $err:e logpathcleanfailed(profile;e)
    }
  }el{
    0
  }
};

f=logpathcleaned(profile:str):i64{
  log.info(
    str.concat("cleaned PATH entry from ";profile);
    "installer.uninstall";
    "system"
  );
  <0
};

f=logpathcleanfailed(profile:str;e:i64):i64{
  log.warn(
    str.concat("failed to clean PATH from ";str.concat(profile;str.concat(": ";e.message)));
    "installer.uninstall";
    "system"
  );
  <0
};

f=cleanpathentry(home:str):i64{
  let pathline="export PATH=\"$HOME/.loke/bin:$PATH\"";
  let profiles=@(
    str.concat(home;"/.zshrc");
    str.concat(home;"/.bashrc");
    str.concat(home;"/.bash_profile")
  );
  lp(let ii289=0;ii289<profiles.len;ii289=ii289+1){
    let profile=profiles.get(ii289);
    if(file.exists(profile)){
      cleanprofilefile(profile;pathline)
    }el{
      0
    }

  };
  <0
};

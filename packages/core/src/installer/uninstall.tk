m=core.installer.uninstall;

i=str:std.str;
i=log:shared.log;
i=proc:std.process;
i=file:std.file;
i=json:std.json;
i=jx:shared.jsonobj;
i=reach:shared.reachability;
i=cli:core.installer.ollamacli;

t=$removablemodel{
  name:str;
  size:str;
  digest:str;
  modified:str
};

t=$uninstallresult{
  success:bool;
  message:str;
  freedspace:str
};

(* VM1.6h. This took an `$httpresp` and read `.body` off it, but the one-argument `http.get`
   answers the body itself, a str, and the body was then read with std.json's untyped ABI
   names (json.decode, getarr, arrlen, arrget; T-32). Measured against
   scripts/lib/http_recorder.py answering /api/tags: the GET arrived and the process died with
   SIGSEGV, so listing removable models crashed whenever Ollama was running. Now the body is
   read with the typed accessors, $ok first (T-31). *)
f=removableof(m:$jsonval):$removablemodel{
  let name=mt json.str(m;"name") {$ok:v v; $err:e ""};
  let sizebytes=mt json.i64(m;"size") {$ok:v v; $err:e 0};
  let digest=mt json.str(m;"digest") {$ok:v v; $err:e ""};
  let modified=mt json.str(m;"modified_at") {$ok:v v; $err:e ""};
  <$removablemodel{ name:name; size:formatsize(sizebytes); digest:digest; modified:modified }
};

f=parseremovablefrombody(body:str;inmodels:@$removablemodel):@$removablemodel{
  let obj=mt json.dec(body) {
    $ok:o o;
    $jsonerr:e jx.emptyobj()
  };
  let items=mt json.arr(obj;"models") {$ok:a a; $err:e @()};
  let models=mut.inmodels;
  lp(let i=0;i<items.len;i=i+1){
    models=models.push(removableof(items.get(i)))
  };
  <models
};

(* F10.40: `ollama list` aligns its columns with runs of spaces, and SIZE is a number and a
   unit ("4.7 GB"). Splitting on one space read the empty strings between the columns as
   the digest and the size, so the rows are split on whitespace runs (ollamacli.listrows). *)
f=parseremovablefromcli(out:str;inmodels:@$removablemodel):@$removablemodel{
  let rows=cli.listrows(out);
  let models=mut.inmodels;
  lp(let k=0;k<rows.len;k=k+1){
    let parts:@str=rows.get(k);
    if(parts.len > 3){
      let modified=mut."";
      lp(let j=4;j<parts.len;j=j+1){ modified=str.trim("\(modified) \(parts.get(j))") };
      models=models.push($removablemodel{
        name:parts.get(0);
        size:"\(parts.get(2)) \(parts.get(3))";
        digest:parts.get(1);
        modified:modified
      })
    }el{}
  };
  <models
};

(* F10.40: `ollama list` as an argv spawn (core.installer.ollamacli); handed to
   process.exec as an array, it never ran (F10.39). A command that did not start or exited
   non-zero adds nothing, and says so. *)
f=parseremovablefallback(e:str;models:@$removablemodel):@$removablemodel{
  let r=cli.run(@("ollama";"list");false);
  if(!r.ok){
    log.warn("ollama list failed (exit \(str.fromint(r.code))): \(str.trim(r.err))";"installer.uninstall";"system");
    <models
  }el{};
  <parseremovablefromcli(r.out;models)
};

(* The GET goes through shared.reachability.localget, which probes the port first (T-15) and
   answers "" when nothing usable came back. Then, as before, `ollama list` is asked instead. *)
f=listremovableat(baseurl:str):@$removablemodel{
  let models=@($removablemodel);
  let body=reach.localget(baseurl;"/api/tags");
  if(str.len(body)==0){
    log.warn("ollama /api/tags gave no answer; asking ollama list";"installer.uninstall";"system");
    <parseremovablefallback("no answer";models)
  }el{};
  <parseremovablefrombody(body;models)
};

f=listremovable():@$removablemodel{
  <listremovableat("http://localhost:11434")
};

f=formatsize(bytes:i64):str{
  let gb=bytes / 1073741824;
  if(gb > 0){
    <str.concat(
      str.concat(str.fromint(gb);".");
      str.concat(str.fromint((bytes % 1073741824) * 10 / 1073741824);" GB")
    )
  }el{};
  let mb=bytes / 1048576;
  if(mb > 0){
    <str.concat(str.fromint(mb);" MB")
  }el{};
  <str.concat(str.fromint(bytes / 1024);" KB")
};

f=verifymodelremovalat(baseurl:str;modelid:str;modelsize:str):$uninstallresult{
  let after=listremovableat(baseurl);
  let stillexists=mut.false;
  lp(let ii112=0;ii112<after.len;ii112=ii112+1){
    if(cli.samemodel(after.get(ii112).name;modelid)){
      stillexists=true
    }el{}

  };
  if(stillexists){
    log.warn(
      str.concat("model still present after removal: ";modelid);
      "installer.uninstall";
      "system"
    );
    <$uninstallresult{
      success:false;
      message:str.concat("removal failed  model still present: ";modelid);
      freedspace:""
    }
  }el{};
  log.info(
    "model removed: \(modelid) freed: \(modelsize)";
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:true;
    message:str.concat("removed ";modelid);
    freedspace:modelsize
  }
};

(* The reason is a str: `e:i64` was read as `e.message`, a field of no type (E4031). *)
f=handlermfailed(e:str):$uninstallresult{
  log.warn(
    str.concat("ollama rm failed: ";e);
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:false;
    message:str.concat("removal failed: ";e);
    freedspace:""
  }
};

(* F10.40, the decision before `ollama rm` runs from an action. It runs only (1) for an id
   that ollamacli.validmodelid accepts, so it cannot be read as an option; (2) for a model
   the list just answered by that name (or name:latest, ollamacli.samemodel), so it
   removes only something that is installed; and (3) from `loke uninstall-model <name>`, which asks [y/N] first
   (cli.modelmgmt). No page calls it. It runs as an argv spawn; a non-zero exit is a
   failed removal with ollama's own message, and a zero exit is still checked by listing
   again (verifymodelremovalat). *)
f=uninstallmodelat(baseurl:str;modelid:str):$uninstallresult{
  if(!cli.validmodelid(modelid)){
    <$uninstallresult{
      success:false;
      message:"not a model name: refusing to pass it to ollama rm";
      freedspace:""
    }
  }el{};
  let models=listremovableat(baseurl);
  let modelsize=mut."";
  let found=mut.false;
  lp(let ii163=0;ii163<models.len;ii163=ii163+1){
    let m=models.get(ii163);
    if(cli.samemodel(m.name;modelid)){
      modelsize=m.size;
      found=true
    }el{}

  };
  if(found==false){
    <$uninstallresult{
      success:false;
      message:str.concat("model not found: ";modelid);
      freedspace:""
    }
  }el{};
  log.info(
    str.concat("removing model: ";modelid);
    "installer.uninstall";
    "system"
  );
  let r=cli.run(@("ollama";"rm";modelid);false);
  if(!r.ok){
    <handlermfailed("exit \(str.fromint(r.code)): \(str.trim(r.err))")
  }el{};
  <verifymodelremovalat(baseurl;modelid;modelsize)
};

f=uninstallmodel(modelid:str):$uninstallresult{
  <uninstallmodelat("http://localhost:11434";modelid)
};

f=handleollamaremoved(home:str):$uninstallresult{
  cleanpathentry(home);
  log.info(
    "Ollama binary removed  models in ~/.ollama left untouched";
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:true;
    message:"Ollama removed from ~/.loke/bin. Models in ~/.ollama were not removed.";
    freedspace:""
  }
};

f=handleollamaremovefailed(e:i64):$uninstallresult{
  log.warn(
    str.concat("failed to remove Ollama binary: ";e.message);
    "installer.uninstall";
    "system"
  );
  <$uninstallresult{
    success:false;
    message:str.concat("removal failed: ";e.message);
    freedspace:""
  }
};

f=uninstallollama():$uninstallresult{
  let home=proc.env("HOME");
  let ollamapath=str.concat(home;"/.loke/bin/ollama");
  if(file.exists(ollamapath)==false){
    <$uninstallresult{
      success:false;
      message:"Ollama binary not found at ~/.loke/bin/ollama";
      freedspace:""
    }
  }el{};
  log.info(
    "removing Ollama binary from ~/.loke/bin/ollama";
    "installer.uninstall";
    "system"
  );
  <mt file.remove(ollamapath) {
    $ok:v handleollamaremoved(home);
    $err:e handleollamaremovefailed(e)
  }
};

f=cleanprofilefile(profile:str;pathline:str):i64{
  <mt file.read(profile) {
    $ok:c cleanprofilecontent(c;profile;pathline);
    $err:e 0
  }
};

f=cleanprofilecontent(c:str;profile:str;pathline:str):i64{
  if(str.contains(c;pathline)){
    let cleaned=str.replace(c;pathline;"");
    let cleaned=str.replace(cleaned;"


";"
");
    <mt file.write(profile;cleaned) {
      $ok:v logpathcleaned(profile);
      $err:e logpathcleanfailed(profile;e)
    }
  }el{
    <0
  }
};

f=logpathcleaned(profile:str):i64{
  log.info(
    str.concat("cleaned PATH entry from ";profile);
    "installer.uninstall";
    "system"
  );
  <0
};

f=logpathcleanfailed(profile:str;e:i64):i64{
  log.warn(
    "failed to clean PATH from \(profile): \(e.message)";
    "installer.uninstall";
    "system"
  );
  <0
};

f=cleanpathentry(home:str):i64{
  let pathline="export PATH=\"$HOME/.loke/bin:$PATH\"";
  let profiles=@(
    str.concat(home;"/.zshrc");
    str.concat(home;"/.bashrc");
    str.concat(home;"/.bash_profile")
  );
  lp(let ii289=0;ii289<profiles.len;ii289=ii289+1){
    let profile=profiles.get(ii289);
    if(file.exists(profile)){
      cleanprofilefile(profile;pathline)
    }el{
      0
    }

  };
  <0
};

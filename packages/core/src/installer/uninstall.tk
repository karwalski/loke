m=core.installer.uninstall;

i=t:shared.types;
i=str:std.str;
i=log:shared.log;
i=proc:std.process;
i=file:std.file;
i=json:std.json;
i=http:std.http;

t=$removablemodel{
  name:str;
  size:str;
  digest:str;
  modified:str
};

t=$uninstallresult{
  success:bool;
  message:str;
  freedspace:str
};

f=listremovable():@$removablemodel{
  let models=@($removablemodel);
  let resp=http.get("http://localhost:11434/api/tags");
  mt resp {
    $ok:r
      let parsed=json.parse(r.body);
      let modellist=json.getarr(parsed;"models");
      let i=mut.0;
      lp(let lv=0;true;lv=lv){
        if(!(i<json.arrlen(modellist))){
          <models
        }el{
          let m=json.arrget(modellist;i);
          let name=json.getstr(m;"name");
          let sizebytes=json.getint(m;"size");
          let size=formatsize(sizebytes);
          let digest=json.getstr(m;"digest");
          let modified=json.getstr(m;"modified_at");
          models=@.push(models;$removablemodel{
            name:name;
            size:size;
            digest:digest;
            modified:modified
          });
          i=i+1
        }
      };
    $err:e
      let result=proc.exec("ollama";@("list"));
      mt result {
        $ok:out
          let lines=str.split(out;"
");
          let j=mut.1;
          lines.each|line{
            if(j > 0){
              if(str.len(str.trim(line)) > 0){
                let parts=str.splitwhitespace(line);
                if(str.len(parts) > 3){
                  models=@.push(models;$removablemodel{
                    name:parts.get(0);
                    size:parts.get(2);
                    digest:parts.get(1);
                    modified:if(str.len(parts) > 4){parts.get(3)}el{""}
                  })
                }el{}
              }el{}
            }el{};
            j=j+1
          };
        $err:e 0
      }
  };
  <models
};

f=formatsize(bytes:i64):str{
  let gb=bytes / 1073741824;
  let remainder=(bytes % 1073741824) * 10 / 1073741824;
  if(gb > 0){
    <str.concat(
      str.concat(str.fromint(gb);".");
      str.concat(str.fromint(remainder);" GB")
    )
  }el{};
  let mb=bytes / 1048576;
  if(mb > 0){
    <str.concat(str.fromint(mb);" MB")
  }el{};
  let kb=bytes / 1024;
  <str.concat(str.fromint(kb);" KB")
};

f=uninstallmodel(modelid:str):$uninstallresult{
  let models=listremovable();
  let modelsize=mut."";
  let found=mut.false;
  models.each|m{
    if(str.eq(m.name;modelid)){
      modelsize=m.size;
      found=true
    }el{}
  };
  if(found=false){
    <$uninstallresult{
      success:false;
      message:str.concat("model not found: ";modelid);
      freedspace:""
    }
  }el{};
  log.info(
    str.concat("removing model: ";modelid);
    "installer.uninstall";
    "system"
  );
  let result=proc.exec("ollama";@("rm";modelid));
  mt result {
    $ok:out
      let after=listremovable();
      let stillexists=mut.false;
      after.each|m{
        if(str.eq(m.name;modelid)){
          stillexists=true
        }el{}
      };
      if(stillexists){
        log.warn(
          str.concat("model still present after removal: ";modelid);
          "installer.uninstall";
          "system"
        );
        <$uninstallresult{
          success:false;
          message:str.concat("removal failed  model still present: ";modelid);
          freedspace:""
        }
      }el{};
      log.info(
        str.concat(
          str.concat("model removed: ";modelid);
          str.concat(" freed: ";modelsize)
        );
        "installer.uninstall";
        "system"
      );
      <$uninstallresult{
        success:true;
        message:str.concat("removed ";modelid);
        freedspace:modelsize
      };
    $err:e
      log.warn(
        str.concat("ollama rm failed: ";e.message);
        "installer.uninstall";
        "system"
      );
      <$uninstallresult{
        success:false;
        message:str.concat("removal failed: ";e.message);
        freedspace:""
      }
  }
};

f=uninstallollama():$uninstallresult{
  let home=proc.env("HOME");
  let ollamapath=str.concat(home;"/.loke/bin/ollama");
  if(file.exists(ollamapath)=false){
    <$uninstallresult{
      success:false;
      message:"Ollama binary not found at ~/.loke/bin/ollama";
      freedspace:""
    }
  }el{};
  log.info(
    "removing Ollama binary from ~/.loke/bin/ollama";
    "installer.uninstall";
    "system"
  );
  let rmresult=file.remove(ollamapath);
  mt rmresult {
    $ok:v
      cleanpathentry(home);
      log.info(
        "Ollama binary removed  models in ~/.ollama left untouched";
        "installer.uninstall";
        "system"
      );
      <$uninstallresult{
        success:true;
        message:"Ollama removed from ~/.loke/bin. Models in ~/.ollama were not removed.";
        freedspace:""
      };
    $err:e
      log.warn(
        str.concat("failed to remove Ollama binary: ";e.message);
        "installer.uninstall";
        "system"
      );
      <$uninstallresult{
        success:false;
        message:str.concat("removal failed: ";e.message);
        freedspace:""
      }
  }
};

f=cleanpathentry(home:str):i64{
  let pathline="export PATH=\"$HOME/.loke/bin:$PATH\"";
  let profiles=@(
    str.concat(home;"/.zshrc");
    str.concat(home;"/.bashrc");
    str.concat(home;"/.bash_profile")
  );
  profiles.each|profile{
    if(file.exists(profile)){
      let content=file.read(profile);
      mt content {
        $ok:c
          if(str.contains(c;pathline)){
            let cleaned=str.replace(c;pathline;"");
            let cleaned=str.replace(cleaned;"


";"
");
            mt file.write(profile;cleaned) {
              $ok:v
                log.info(
                  str.concat("cleaned PATH entry from ";profile);
                  "installer.uninstall";
                  "system"
                );
              $err:e
                log.warn(
                  str.concat("failed to clean PATH from ";str.concat(profile;str.concat(": ";e.message)));
                  "installer.uninstall";
                  "system"
                )
            }
          }el{};
        $err:e 0
      }
    }el{}
  };
  <0
};

m=core.installer.detect;
i=str:std.str;
i=log:shared.log;
i=sys:std.sys;
i=process:std.process;
i=http:std.http;

t=$installstate{
  ollamainstalled:bool;
  ollamaversion:str;
  ollamarunning:bool;
  modelpulled:bool;
  modelid:str;
  diskfreegb:i64;
  ramgb:i64;
  isarm64:bool;
  hasinternet:bool;
  platform:str
};

t=$detectresult{
  ok:bool;
  value:str;
  error:str
};

f=handleollamastdout(h:i64):$detectresult{
  let out=process.stdout(h);
  mt out {
    $ok:v handleollamafound(v);
    $err:e $detectresult{ok:true;value:"unknown";error:""}
  }
};

f=handleollamafound(v:str):$detectresult{
  log.info(str.concat("ollama found: ";v);"installer.detect";"system");
  <$detectresult{ok:true;value:v;error:""}
};

f=handleollamawait(h:i64):$detectresult{
  let code=process.wait(h);
  mt code {
    $ok:c handleollamaexit(h;c);
    $err:e $detectresult{ok:false;value:"";error:"process wait failed"}
  }
};

f=handleollamaexit(h:i64;c:i64):$detectresult{
  if(c = 0){
    <handleollamastdout(h)
  }el{
    <$detectresult{ok:false;value:"";error:"ollama exited with non-zero code"}
  }
};

f=handleollamamissing(e:str):$detectresult{
  log.info("ollama not found on PATH";"installer.detect";"system");
  <$detectresult{ok:false;value:"";error:"ollama not found"}
};

f=detectollamainstalled():$detectresult{
  log.info("probing ollama --version";"installer.detect";"system");
  let handle=process.spawn("ollama";@("--version"));
  mt handle {
    $ok:h handleollamawait(h);
    $err:e handleollamamissing(e)
  }
};

f=handlerunningresponse(r:i64):$detectresult{
  if(r.status = 200){
    log.info("ollama server is running";"installer.detect";"system");
    <$detectresult{ok:true;value:str.frombytes(r.body);error:""}
  }el{
    <$detectresult{ok:false;value:"";error:str.concat("unexpected status: ";str.fromint(r.status))}
  }
};

f=handlerunningerror(e:i64):$detectresult{
  log.info("ollama server not reachable";"installer.detect";"system");
  <$detectresult{ok:false;value:"";error:e.msg}
};

f=detectollamarunning():$detectresult{
  log.info("checking if ollama is running";"installer.detect";"system");
  let client=http.client("http://localhost:11434");
  let resp=http.get(client;"/api/version");
  mt resp {
    $ok:r handlerunningresponse(r);
    $err:e handlerunningerror(e)
  }
};

f=handlemodeltags(r:i64;modelid:str):$detectresult{
  if(r.status = 200){
    let body=str.frombytes(r.body);
    if(str.contains(body;modelid)){
      log.info(str.concat("model found: ";modelid);"installer.detect";"system");
      <$detectresult{ok:true;value:modelid;error:""}
    }el{
      log.info(str.concat("model not found: ";modelid);"installer.detect";"system");
      <$detectresult{ok:false;value:"";error:"model not in tag list"}
    }
  }el{
    <$detectresult{ok:false;value:"";error:str.concat("unexpected status: ";str.fromint(r.status))}
  }
};

f=detectmodelpulled(modelid:str):$detectresult{
  log.info(str.concat("checking for model: ";modelid);"installer.detect";"system");
  let client=http.client("http://localhost:11434");
  let resp=http.get(client;"/api/tags");
  mt resp {
    $ok:r handlemodeltags(r;modelid);
    $err:e $detectresult{ok:false;value:"";error:e.msg}
  }
};

f=handlediskstdout(h:i64):$detectresult{
  let out=process.stdout(h);
  mt out {
    $ok:v handlediskinfo(v);
    $err:e $detectresult{ok:false;value:"";error:"could not read df output"}
  }
};

f=handlediskinfo(v:str):$detectresult{
  log.info(str.concat("disk info: ";v);"installer.detect";"system");
  <$detectresult{ok:true;value:v;error:""}
};

f=handlediskwait(h:i64):$detectresult{
  let code=process.wait(h);
  mt code {
    $ok:c handlediskstdout(h);
    $err:e $detectresult{ok:false;value:"";error:"df command failed"}
  }
};

f=detectdiskspace():$detectresult{
  log.info("checking disk space";"installer.detect";"system");
  let datadir=sys.datadir("loke");
  let handle=process.spawn("df";@("-g";datadir));
  mt handle {
    $ok:h handlediskwait(h);
    $err:e $detectresult{ok:false;value:"0";error:"could not run df"}
  }
};

f=detectram():i64{
  let ram=sys.totalramgb();
  log.info(str.concat("total RAM: ";str.concat(str.fromint(ram);" GB"));"installer.detect";"system");
  <ram
};

f=detectarch():bool{
  let arm=sys.isarm64();
  let armlabel=mut."no";
  if(arm){armlabel="yes"};
  log.info(str.concat("ARM64: ";armlabel);"installer.detect";"system");
  <arm
};

f=handleinternetresponse(r:i64):$detectresult{
  if(!(r.status<200)){
    if(r.status < 400){
      log.info("internet connectivity confirmed";"installer.detect";"system");
      <$detectresult{ok:true;value:"connected";error:""}
    }el{
      <$detectresult{ok:false;value:"";error:str.concat("http status: ";str.fromint(r.status))}
    }
  }el{
    <$detectresult{ok:false;value:"";error:"unexpected status"}
  }
};

f=handleinterneterror(e:i64):$detectresult{
  log.info("no internet connectivity";"installer.detect";"system");
  <$detectresult{ok:false;value:"";error:e.msg}
};

f=detectinternet():$detectresult{
  log.info("checking internet connectivity";"installer.detect";"system");
  let client=http.client("https://ollama.com");
  let resp=http.get(client;"/");
  mt resp {
    $ok:r handleinternetresponse(r);
    $err:e handleinterneterror(e)
  }
};

f=parseplatformstr(v:str):str{
  if(str.contains(v;"Darwin")){ <"macos" }el{};
  if(str.contains(v;"Linux")){ <"linux" }el{};
  if(str.contains(v;"MINGW")){ <"windows" }el{};
  if(str.contains(v;"MSYS")){ <"windows" }el{};
  <"unknown"
};

f=handleplatstdout(h:i64):str{
  mt process.stdout(h) {
    $ok:v parseplatformstr(v);
    $err:e "unknown"
  }
};

f=handleplatwait(h:i64):str{
  mt process.wait(h) {
    $ok:c handleplatstdout(h);
    $err:e "unknown"
  }
};

f=detectplatform():str{
  let platresult=process.spawn("uname";@("-s"));
  mt platresult {
    $ok:h handleplatwait(h);
    $err:e "unknown"
  }
};

f=fulldetect():$installstate{
  log.info("running full detection";"installer.detect";"system");

  let ollamacheck=detectollamainstalled();
  let runningcheck=detectollamarunning();
  let ram=detectram();
  let arm=detectarch();
  let internetcheck=detectinternet();
  let diskcheck=detectdiskspace();

  let defaultmodel=mut."qwen2.5:3b";
  if(ram > 64){ defaultmodel="qwen2.5:32b" }el{};
  if(ram > 32){ if(ram < 64){ defaultmodel="qwen2.5:14b" }el{} }el{};
  if(ram > 16){ if(ram < 32){ defaultmodel="qwen2.5:7b" }el{} }el{};
  if(ram > 8){ if(ram < 16){ defaultmodel="qwen2.5:3b" }el{} }el{};
  if(ram < 8){ defaultmodel="qwen2.5:1.5b" }el{};

  let modelcheck=mut.$detectresult{ok:false;value:"";error:"ollama not running"};
  if(runningcheck.ok){
    modelcheck=detectmodelpulled(defaultmodel)
  }el{};

  let platform=detectplatform();

  let state=$installstate{
    ollamainstalled:ollamacheck.ok;
    ollamaversion:ollamacheck.value;
    ollamarunning:runningcheck.ok;
    modelpulled:modelcheck.ok;
    modelid:defaultmodel;
    diskfreegb:0;
    ramgb:ram;
    isarm64:arm;
    hasinternet:internetcheck.ok;
    platform:platform
  };

  let b1=mut."false"; if(state.ollamainstalled){b1="true"}el{};
  let b2=mut."false"; if(state.ollamarunning){b2="true"}el{};
  let b3=mut."false"; if(state.modelpulled){b3="true"}el{};
  let b4=mut."false"; if(state.hasinternet){b4="true"}el{};
  log.info(str.concat("detection complete: ollama_installed=";str.concat(b1;str.concat(" running=";str.concat(b2;str.concat(" model=";str.concat(b3;str.concat(" internet=";b4)))))));"installer.detect";"system");
  <state
};

m=core.installer.start;
i=log:shared.log;
i=process:std.process;
i=http:std.http;
i=detect:core.installer.detect;
i=str:std.str;

t=$startresult{
  success:bool;
  message:str
};

(* std.process's ProcessErr is not nameable from loke source ($processerr does not
   resolve), so the error arm's type is i64 — and toke miscompiles a match of three
   or more arms whose subject type it does not know, emitting duplicate basic-block
   labels. Declaring a loke-side sum with the same variant names gives the match a
   known type and it links. See docs/upstream/toke-issues.md T-2. *)
t=$spawnerr{ $notfound:i64; $permission:i64; $io:i64 };


f=startollama():$startresult{
  log.info("starting ollama serve";"installer.start";"system");

  <mt process.spawn(@("ollama";"serve")) {
    $ok:h $startresult{success:true;message:"ollama serve started"};
    $err:e spawnfailed(e)
  }
};

(* The ProcessErr match is its own function rather than nested inside the $err arm
   (T-2 again: a 3+-arm `mt` nested in a match arm miscompiles the same way). *)
f=spawnfailed(e:$spawnerr):$startresult{
  <mt e {
    $notfound:v $startresult{success:false;message:"ollama binary not found — install Ollama first"};
    $permission:v $startresult{success:false;message:"permission denied running ollama"};
    $io:v $startresult{success:false;message:"IO error starting ollama serve"}
  }
};

f=waitforhealth():$startresult{
  log.info("waiting for ollama health";"installer.start";"system");

  let client=http.client("http://localhost:11434");
  let elapsed=mut.0;
  let healthy=mut.false;

  lp(let lv=0;true;lv=lv){
    if(elapsed > 15000){ <$startresult{success:false;message:"ollama failed to start within 15 seconds"} }el{};
    if(healthy){ <$startresult{success:true;message:"ollama is healthy"} }el{};

    let resp=http.get(client;"/api/version");
    let respok=mt resp {
      $ok:r r.status;
      $err:e 0
    };
    if(respok == 200){
      healthy=true
    }el{};

    if(healthy==false){
      let sleephandle=process.spawn(@("sleep";"0.5"));
      mt sleephandle {
        $ok:h process.wait(h);
        $err:e 0
      };
      elapsed=elapsed + 500
    }el{}
  }
};

f=stopollama():$startresult{
  log.info("stopping ollama serve";"installer.start";"system");
  log.info("no ollama process to stop";"installer.start";"system");
  <$startresult{success:true;message:"no ollama process was running"}
};

f=autostartifneeded(autostart:bool):$startresult{
  if(autostart==false){
    log.info("auto_start disabled, skipping";"installer.start";"system");
    <$startresult{success:true;message:"auto_start disabled"}
  }el{};

  log.info("checking if ollama needs auto-start";"installer.start";"system");

  let running=detect.detectollamarunning();
  if(running.ok){
    log.info("ollama already running, no action needed";"installer.start";"system");
    <$startresult{success:true;message:"ollama already running"}
  }el{};

  let installed=detect.detectollamainstalled();
  if(installed.ok==false){
    log.warn("ollama not installed, cannot auto-start";"installer.start";"system");
    <$startresult{success:false;message:"ollama not installed  run setup to install"}
  }el{};

  let start=startollama();
  if(start.success==false){
    <start
  }el{};

  let health=waitforhealth();
  <health
};


m=core.installer.models;
i=str:std.str;
i=log:shared.log;

t=$modelrecommendation{
  modelid:$str;
  modelname:$str;
  sizegb:f64;
  minramgb:i64;
  tokpersecest:$str;
  rationale:$str
};

f=recommendmodel(ramgb:i64):$modelrecommendation{
  log.info(str.concat("recommending model for RAM: ";str.concat(str.fromint(ramgb);" GB"));"installer.models";"system");
  if(ramgb > 64){
    <$modelrecommendation{
      modelid:"qwen2.5:32b";
      modelname:"Qwen 2.5 32B";
      sizegb:20.0;
      minramgb:64;
      tokpersecest:"5-15";
      rationale:"Considered tier; excellent quality, slower response"
    };
  }el{
    if(ramgb > 32){
      <$modelrecommendation{
        modelid:"qwen2.5:14b";
        modelname:"Qwen 2.5 14B";
        sizegb:9.0;
        minramgb:32;
        tokpersecest:"10-25";
        rationale:"High quality for complex analysis and code tasks"
      };
    }el{
      if(ramgb > 16){
        <$modelrecommendation{
          modelid:"qwen2.5:7b";
          modelname:"Qwen 2.5 7B";
          sizegb:4.5;
          minramgb:16;
          tokpersecest:"20-40";
          rationale:"Strong general-purpose; handles summarisation well"
        };
      }el{
        if(ramgb > 8){
          <$modelrecommendation{
            modelid:"qwen2.5:3b";
            modelname:"Qwen 2.5 3B";
            sizegb:2.0;
            minramgb:8;
            tokpersecest:"30-50";
            rationale:"Good balance of quality and speed for interactive use"
          };
        }el{
          <$modelrecommendation{
            modelid:"qwen2.5:1.5b";
            modelname:"Qwen 2.5 1.5B";
            sizegb:1.0;
            minramgb:4;
            tokpersecest:"40-60";
            rationale:"Fits comfortably; suitable for NER and classification"
          };
        };
      };
    };
  };
};

f=allmodels():@$modelrecommendation{
  <@(
    $modelrecommendation{
      modelid:"qwen2.5:1.5b";
      modelname:"Qwen 2.5 1.5B";
      sizegb:1.0;
      minramgb:4;
      tokpersecest:"40-60";
      rationale:"Fits comfortably; suitable for NER and classification"
    };
    $modelrecommendation{
      modelid:"qwen2.5:3b";
      modelname:"Qwen 2.5 3B";
      sizegb:2.0;
      minramgb:8;
      tokpersecest:"30-50";
      rationale:"Good balance of quality and speed for interactive use"
    };
    $modelrecommendation{
      modelid:"qwen2.5:7b";
      modelname:"Qwen 2.5 7B";
      sizegb:4.5;
      minramgb:16;
      tokpersecest:"20-40";
      rationale:"Strong general-purpose; handles summarisation well"
    };
    $modelrecommendation{
      modelid:"qwen2.5:14b";
      modelname:"Qwen 2.5 14B";
      sizegb:9.0;
      minramgb:32;
      tokpersecest:"10-25";
      rationale:"High quality for complex analysis and code tasks"
    };
    $modelrecommendation{
      modelid:"qwen2.5:32b";
      modelname:"Qwen 2.5 32B";
      sizegb:20.0;
      minramgb:64;
      tokpersecest:"5-15";
      rationale:"Considered tier; excellent quality, slower response"
    };
  )
};

f=hasenoughdisk(model:i64;diskfreegb:i64):bool{
  let required=model.sizegb + 2.0;
  let freef=str.tof64(str.fromint(diskfreegb));
  let ok=freef > required;
  if(!$ok){
    log.warn(str.concat("insufficient disk for ";str.concat(model.modelid;str.concat(": need ";str.concat(str.fromf64(required);str.concat(" GB, have ";str.concat(str.fromint(diskfreegb);" GB"))))));"installer.models";"system")
  }el{};
  <ok
};

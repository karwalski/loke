m=core.memory.context;

i=pal:core.memory.palace;
i=aaak:core.memory.aaak;
i=search:core.memory.search;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=memtypes:core.memory.types;

t=$contextlayer{
  $l0:i64;
  $l1:i64;
  $l2:i64;
  $l3:i64};

t=$loadedcontext{
  l0identity:str;
  l1palacemap:str;
  l2activecontext:str;
  l3deepresults:@$searchresult;
  totaltokensestimate:u32;
  layersloaded:@str
};

f=defaultbudgets():@u32{
  <@(20 as u32;150 as u32;500 as u32;2000 as u32)
};

f=loadl0(username:str;version:str):str{
  let vpart=str.concat("loke v";version);
  let upart=str.concat(" | user:";username);
  <str.concat(vpart;str.concat(upart;" | priv-llm-proxy on ooke"))
};

f=buildpalacemap(walkstr:str):str{
  let lines=str.split(walkstr;"
");
  let currentwing=mut."";
  let winghalls=mut.@();
  let palaceparts=mut.@();

  lp(let li=0;li<str.arraylen(lines);li=li+1){ let line=lines.get(li);
    let trimmed=str.trim(line);
    if(str.contains(trimmed;"Wing: ")){
      if(str.len(currentwing) > 0 && winghalls.len > 0){
        let hallsjoined=mut."";
        let first=mut.true;
        lp(let hi=0;hi<str.arraylen(winghalls);hi=hi+1){ let h=winghalls.get(hi);
          if(first){
            hallsjoined=h;
            first=false
          }el{
            hallsjoined=str.concat(hallsjoined;str.concat(",";h))
          }
        };
        let wingentry=str.concat(currentwing;str.concat("(";str.concat(hallsjoined;")")));
        palaceparts=palaceparts.push(wingentry)
      }el{};
      let wingparts=str.split(trimmed;"Wing: ");
      currentwing=str.trim(wingparts.get(1));
      winghalls=@()
    }el{
      if(str.contains(trimmed;"Hall: ")){
        let hallparts=str.split(trimmed;"Hall: ");
        let hallfull=str.trim(hallparts.get(1));
        let hallname=mut.hallfull;
        if(str.contains(hallfull;" (")){
          let parenparts=str.split(hallfull;" (");
          hallname=str.trim(parenparts.get(0))
        }el{};
        winghalls=winghalls.push(hallname)
      }el{}
    }
  };

  if(str.len(currentwing) > 0 && winghalls.len > 0){
    let hallsjoined=mut."";
    let first=mut.true;
    lp(let hi=0;hi<str.arraylen(winghalls);hi=hi+1){ let h=winghalls.get(hi);
      if(first){
        hallsjoined=h;
        first=false
      }el{
        hallsjoined=str.concat(hallsjoined;str.concat(",";h))
      }
    };
    let wingentry=str.concat(currentwing;str.concat("(";str.concat(hallsjoined;")")));
    palaceparts=palaceparts.push(wingentry)
  }el{};

  let mapbody=mut."";
  let first=mut.true;
  lp(let pi=0;pi<str.arraylen(palaceparts);pi=pi+1){ let part=palaceparts.get(pi);
    if(first){
      mapbody=part;
      first=false
    }el{
      mapbody=str.concat(mapbody;str.concat(" | ";part))
    }
  };

  <str.concat("PALACE: ";mapbody)
};

(* MK6.8. The three loaders matched `X!$lokeerr` results (pal.walk here, search.search in L2
   and L3), and such a match takes its first arm whatever the value is (T-18): a palace that
   could not be read was mapped from the error payload, and a failed search was indistinguishable
   from one that found nothing. Each now answers a sentinel its caller can read, and
   loadcontext leaves a layer that failed out of `layersloaded`, which is the field that says
   how much of the palace was consulted.

   loadl1 answers "" when the palace could not be walked; a map it built always starts
   "PALACE: ". *)
f=loadl1(palace:i64;level:$compresslevel):str{
  let walkstr=pal.walk(palace);
  if(pal.iswalked(walkstr)){ <buildpalacemap(walkstr) }el{};
  log.warn("L1 context load failed -- the palace could not be walked";"context";"system");
  <""
};

f=unavailablel1():str{
  <"PALACE: (unavailable)"
};

f=formatl2results(results:@$searchresult;level:$compresslevel):str{
  let joined=mut."";
  if(results.len == 0 as u64){
    <""
  }el{
    (* `mut.` and an assignment. This read `let parts=@();` with a bare `parts.push(tagged)`,
       and an array push RETURNS the new array rather than mutating in place (T-24) — so `parts`
       stayed empty, the join loop below iterated zero times, and **L3 deep memory contributed
       nothing to any context** while `results.len` had already proved there was something to
       contribute. The early `if(results.len == 0){ <"" }` above makes that especially quiet: the
       function looks as though it distinguishes "nothing found" from "nothing rendered", and it
       returned the same empty string either way. *)
    let parts=mut.@();
    lp(let ri=0;ri<str.arraylen(results);ri=ri+1){ let r=results.get(ri);
      let encoded=aaak.encodefact(r.contentexcerpt;level);
      let loc=str.concat(r.location.wing;str.concat("/";r.location.hall));
      let tagged=str.concat("[";str.concat(loc;str.concat("] ";encoded)));
      parts=parts.push(tagged)
    };
    let first=mut.true;
    lp(let pi=0;pi<str.arraylen(parts);pi=pi+1){ let p=parts.get(pi);
      if(first){
        joined=p;
        first=false
      }el{
        joined=str.concat(joined;str.concat("
";p))
      }
    };
    <joined
  }
};

(* L2 and L3 answer the search itself; search.succeeded says whether it ran. *)
f=loadl2(palace:i64;taskdescription:str):$searchfound{
  let r=search.search(palace;taskdescription;5);
  if(!search.succeeded(r)){ log.warn("L2 context load failed -- search error";"context";"system") }el{};
  <r
};

f=loadl3(palace:i64;query:str;limit:u32):$searchfound{
  let r=search.search(palace;query;limit);
  if(!search.succeeded(r)){ log.warn("L3 deep search failed";"context";"system") }el{};
  <r
};

(* Delegates to shared.types.esttokens — one estimator, so a budget and a context window
   cannot disagree about what a token is. u32 crosses a boundary intact. *)
f=estimatetokens(s:str):u32{
  <t.esttokens(s)
};

f=loadcontext(palace:i64;taskdesc:str;username:str;tokenbudget:u32):$loadedcontext{
  let level=aaak.defaultlevel();

  let l0=loadl0(username;"0.1.0");
  let l0tokens=estimatetokens(l0);
  (* `mut.`, and every push below is assigned. This was `let layersloaded=@("L0")` with three
     bare `layersloaded.push(...)` calls, and an array push returns the new array rather than
     mutating in place (T-24) — so `$loadedcontext.layersloaded` reported **`["L0"]` whatever
     layers actually loaded**. That is a provenance field: its whole job is to tell a caller how
     much of the memory palace was consulted, and it under-reported by up to three layers while
     the tokens those layers cost were counted correctly in `usedtokens`. So the two halves of
     the same struct disagreed, and the one a human reads was the wrong one. *)
  let layersloaded=mut.@("L0");

  let l1=mut.loadl1(palace;level);
  if(str.len(l1) > 0){
    layersloaded=layersloaded.push("L1")
  }el{
    l1=unavailablel1()
  };
  let l1tokens=estimatetokens(l1);

  let usedtokens=mut.l0tokens + l1tokens;

  let l2budget=500;
  let l2=mut."";
  if(tokenbudget > usedtokens + l2budget){
    let r2=loadl2(palace;taskdesc);
    if(search.succeeded(r2)){
      l2=formatl2results(r2.results;level);
      usedtokens=usedtokens + estimatetokens(l2);
      layersloaded=layersloaded.push("L2")
    }el{}
  }el{};

  let l3=mut.@($searchresult);
  let remaining=mut.0;
  if(tokenbudget > usedtokens){
    remaining=tokenbudget - usedtokens
  }el{};
  if(remaining > 200){
    let r3=loadl3(palace;taskdesc;remaining / 50);
    if(search.succeeded(r3)){
      l3=r3.results;
      layersloaded=layersloaded.push("L3")
    }el{}
  }el{};


  <$loadedcontext{
    l0identity:l0;
    l1palacemap:l1;
    l2activecontext:l2;
    l3deepresults:l3;
    totaltokensestimate:(usedtokens + (l3.len * 50));
    layersloaded:layersloaded
  }
};

f=tocontextstring(ctx:$loadedcontext):str{
  let out=mut.ctx.l0identity;

  if(str.len(ctx.l1palacemap) > 0){
    out=str.concat(out;str.concat("
";ctx.l1palacemap))
  }el{};

  if(str.len(ctx.l2activecontext) > 0){
    out=str.concat(out;str.concat("
";ctx.l2activecontext))
  }el{};

  if(ctx.l3deepresults.len > 0 as u64){
    out=str.concat(out;"
--- deep context ---");
    lp(let ri=0;ri<str.arraylen(ctx.l3deepresults);ri=ri+1){ let r=ctx.l3deepresults.get(ri);
      let loc=str.concat(r.location.wing;str.concat("/";str.concat(r.location.hall;str.concat("/";r.location.room))));
      let line=str.concat("
[";str.concat(loc;str.concat("] ";r.contentexcerpt)));
      out=str.concat(out;line)
    }
  }el{};

  <out
};

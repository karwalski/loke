m=core.memory.context;

i=t:shared.types;
i=memtypes:core.memory.types;
i=pal:core.memory.palace;
i=aaak:core.memory.aaak;
i=search:core.memory.search;
i=str:std.str;
i=log:shared.log;

t=$contextlayer{
  $l0:i64;
  $l1:i64;
  $l2:i64;
  $l3:i64};

t=$loadedcontext{
  l0identity:str;
  l1palacemap:str;
  l2activecontext:str;
  l3deepresults:@$searchresult;
  totaltokensestimate:u32;
  layersloaded:@str
};

f=defaultbudgets():@u32{
  <@(20;150;500;2000)
};

f=loadl0(username:str;version:str):str{
  let vpart=str.concat("loke v";version);
  let upart=str.concat(" | user:";username);
  let tail=" | priv-llm-proxy on ooke";
  <str.concat(vpart;str.concat(upart;tail))
};

f=loadl1(palace:i64;level:$compresslevel):str{
  mt pal.walk(palace) {
    $ok:walkstr
      let lines=str.split(walkstr;"
");
      let currentwing="";
      let winghalls=@(str);
      let palaceparts=@(str);

      lines.each|line{
        let trimmed=str.trim(line);
        if(str.contains(trimmed;"Wing: ")){
          if(str.len(currentwing) > 0 && winghalls.len > 0){
            let hallsjoined="";
            let first=true;
            winghalls.each|h{
              if(first){
                hallsjoined=h;
                first=false
              }el{
                hallsjoined=str.concat(hallsjoined;str.concat(",";h))
              }
            };
            let wingentry=str.concat(currentwing;str.concat("(";str.concat(hallsjoined;")")));
            palaceparts=@.push(palaceparts;wingentry)
          }el{};
          let wingparts=str.split(trimmed;"Wing: ");
          currentwing=str.trim(wingparts.get(1));
          winghalls=@(str)
        }el{
          if(str.contains(trimmed;"Hall: ")){
            let hallparts=str.split(trimmed;"Hall: ");
            let hallfull=str.trim(hallparts.get(1));
            let hallname=if(str.contains(hallfull;" (")){
              let parenparts=str.split(hallfull;" (");
              str.trim(parenparts.get(0))
            }el{
              hallfull
            };
            winghalls=@.push(winghalls;hallname)
          }el{}
        }
      };

      if(str.len(currentwing) > 0 && winghalls.len > 0){
        let hallsjoined="";
        let first=true;
        winghalls.each|h{
          if(first){
            hallsjoined=h;
            first=false
          }el{
            hallsjoined=str.concat(hallsjoined;str.concat(",";h))
          }
        };
        let wingentry=str.concat(currentwing;str.concat("(";str.concat(hallsjoined;")")));
        palaceparts=@.push(palaceparts;wingentry)
      }el{};

      let mapbody="";
      let first=true;
      palaceparts.each|part{
        if(first){
          mapbody=part;
          first=false
        }el{
          mapbody=str.concat(mapbody;str.concat(" | ";part))
        }
      };

      <str.concat("PALACE: ";mapbody);
    $err:e
      <"PALACE: (unavailable)"
  }
};

f=loadl2(palace:i64;taskdescription:str;level:$compresslevel):str{
  mt search.search(palace;taskdescription;5) {
    $ok:results
      if(results.len = 0){
        <""
      }el{
        let parts=@(str);
        results.each|r{
          let encoded=aaak.encodefact(r.contentexcerpt;level);
          let loc=str.concat(r.location.wing;str.concat("/";r.location.hall));
          let tagged=str.concat("[";str.concat(loc;str.concat("] ";encoded)));
          parts=@.push(parts;tagged)
        };
        let joined="";
        let first=true;
        parts.each|p{
          if(first){
            joined=p;
            first=false
          }el{
            joined=str.concat(joined;str.concat("
";p))
          }
        };
        <joined
      };
    $err:e
      log.warn("L2 context load failed -- search error";"context";"system");
      <""
  }
};

f=loadl3(palace:i64;query:str;limit:u32):@$searchresult{
  mt search.search(palace;query;limit) {
    $ok:results <results;
    $err:e
      log.warn("L3 deep search failed";"context";"system");
      <@($searchresult)
  }
};

f=estimatetokens(s:str):u32{
  str.len(s) / 4
};

f=loadcontext(palace:i64;taskdesc:str;username:str;tokenbudget:u32):$loadedcontext{
  let level=aaak.defaultlevel();

  let l0=loadl0(username;"0.1.0");
  let l0tokens=estimatetokens(l0);
  let layersloaded=@("L0");

  let l1=loadl1(palace;level);
  let l1tokens=estimatetokens(l1);
  layersloaded=@.push(layersloaded;"L1");

  let usedtokens=l0tokens + l1tokens;

  let l2budget=500;
  let l2="";
  if(tokenbudget > usedtokens + l2budget){
    l2=loadl2(palace;taskdesc;level);
    let l2actual=estimatetokens(l2);
    usedtokens=usedtokens + l2actual;
    layersloaded=@.push(layersloaded;"L2")
  }el{};

  let l3=@($searchresult);
  let remaining=if(tokenbudget > usedtokens){
    tokenbudget - usedtokens
  }el{
    0
  };
  if(remaining > 200){
    let l3limit=remaining / 50;
    l3=loadl3(palace;taskdesc;l3limit);
    layersloaded=@.push(layersloaded;"L3")
  }el{};

  let l3tokens=l3.len * 50;
  let total=usedtokens + l3tokens;

  <$loadedcontext{
    l0identity:l0;
    l1palacemap:l1;
    l2activecontext:l2;
    l3deepresults:l3;
    totaltokensestimate:total;
    layersloaded:layersloaded
  }
};

f=tocontextstring(ctx:$loadedcontext):str{
  let out=ctx.l0identity;

  if(str.len(ctx.l1palacemap) > 0){
    out=str.concat(out;str.concat("
";ctx.l1palacemap))
  }el{};

  if(str.len(ctx.l2activecontext) > 0){
    out=str.concat(out;str.concat("
";ctx.l2activecontext))
  }el{};

  if(ctx.l3deepresults.len > 0){
    let l3header="
--- deep context ---";
    out=str.concat(out;l3header);
    ctx.l3deepresults.each|r{
      let loc=str.concat(r.location.wing;str.concat("/";str.concat(r.location.hall;str.concat("/";r.location.room))));
      let line=str.concat("
[";str.concat(loc;str.concat("] ";r.contentexcerpt)));
      out=str.concat(out;line)
    }
  }el{};

  <out
};

m=core.memory.export;




i=memtypes:core.memory.types;
i=db:std.db;
i=fs:std.fs;
i=str:std.str;
i=log:shared.log;
i=json:std.json;

t=$exportformat{
  $json:i64;
  $csv:i64;
  $markdown:i64};

t=$memoryexport{
  count:i32;
  path:str;
  format:str;
  ts:i64
};



f=csvescape(s:str):str{
  let escaped=str.replace(s;"\"";  "\"\"");
  <str.concat("\"";str.concat(escaped;"\""))
};



f=formatmemorymd(id:str;content:str;tags:str;score:f32;ts:i64):str{
  let header=str.concat("## ";str.concat(id;"
"));
  let metatags=str.concat("**Tags:** ";str.concat(tags;"
"));
  let metascore=str.concat("**Score:** ";str.concat(str.fromfloat(score);"
"));
  let metats=str.concat("**Timestamp:** ";str.concat(str.fromint(ts);"
"));
  let body=str.concat("
";str.concat(content;"

---

"));
  <str.concat(header;str.concat(metatags;str.concat(metascore;str.concat(metats;body))))
};


f=rowtojson(row:i64):str{
  let id=csvescape(json.str(row;"id"));
  let wing=json.str(row;"wing");
  let hall=json.str(row;"hall");
  let room=json.str(row;"room");
  let role=json.str(row;"role");
  let content=json.str(row;"content");
  let tags=json.str(row;"tags");
  let score=json.getfloat(row;"score");
  let ts=json.i64(row;"created_at");
  
  let obj=str.concat("{");
  let obj=str.concat(obj;str.concat("\"id\":";str.concat(csvescape(json.str(row;"id"));",")));
  let obj=str.concat(obj;str.concat("\"wing\":";str.concat(csvescape(wing);",")));
  let obj=str.concat(obj;str.concat("\"hall\":";str.concat(csvescape(hall);",")));
  let obj=str.concat(obj;str.concat("\"room\":";str.concat(csvescape(room);",")));
  let obj=str.concat(obj;str.concat("\"role\":";str.concat(csvescape(role);",")));
  let obj=str.concat(obj;str.concat("\"content\":";str.concat(csvescape(content);",")));
  let obj=str.concat(obj;str.concat("\"tags\":";str.concat(csvescape(tags);",")));
  let obj=str.concat(obj;str.concat("\"score\":";str.concat(str.fromfloat(score);",")));
  let obj=str.concat(obj;str.concat("\"created_at\":";str.concat(str.fromint(ts);"}")));
  <obj
};


f=buildcontentjson(rows:i64):str{
  let lines=mut.@();
  lp(let ri=0;ri<rows.len;ri=ri+1){
    let row=rows.get(ri);
    lines=lines.push(str.concat("  ";rowtojson(row)))
  };
  <str.concat("[";str.concat(str.join(lines;",");"]"))
};

f=rowtocsv2(row:i64):str{
  let r=mut.csvescape(json.str(row;"id"));
  r=str.concat(r;str.concat(",";csvescape(json.str(row;"wing"))));
  r=str.concat(r;str.concat(",";csvescape(json.str(row;"hall"))));
  r=str.concat(r;str.concat(",";csvescape(json.str(row;"room"))));
  r=str.concat(r;str.concat(",";csvescape(json.str(row;"role"))));
  r=str.concat(r;str.concat(",";csvescape(json.str(row;"content"))));
  r=str.concat(r;str.concat(",";csvescape(json.str(row;"tags"))));
  r=str.concat(r;str.concat(",";str.fromfloat(json.getfloat(row;"score"))));
  r=str.concat(r;str.concat(",";str.fromint(json.i64(row;"created_at"))));
  <r
};

f=buildcontentcsv(rows:i64):str{
  let header="\"id\",\"wing\",\"hall\",\"room\",\"role\",\"content\",\"tags\",\"score\",\"created_at\"";
  let datalines=mut.@();
  lp(let ri=0;ri<rows.len;ri=ri+1){
    let row=rows.get(ri);
    datalines=datalines.push(rowtocsv2(row))
  };
  <str.concat(header;str.concat("\n";str.join(datalines;"\n")))
};

f=buildcontentmd(rows:i64):str{
  let title="# Memory Palace Export\n\n";
  let blocks=mut.@();
  lp(let ri=0;ri<rows.len;ri=ri+1){
    let row=rows.get(ri);
    blocks=blocks.push(formatmemorymd(
      json.str(row;"id");
      json.str(row;"content");
      json.str(row;"tags");
      json.getfloat(row;"score");
      json.i64(row;"created_at")
    ))
  };
  <str.concat(title;str.join(blocks;""))
};

f=buildcontent(rows:i64;format:$exportformat):str{
  mt format {
    $json:v buildcontentjson(rows);
    $csv:v buildcontentcsv(rows);
    $markdown:v buildcontentmd(rows)
  }
};


f=formatlabel(format:$exportformat):str{
  mt format {
    $json:v "json";
    $csv:v "csv";
    $markdown:v "markdown"
  }
};


f=exportall(palace:i64;outpath:str;format:$exportformat;now:i64):$memoryexport{
  let rows=mt db.query(
    palace.conn;
    "SELECT md.id,md.wing,md.hall,md.room,md.role,md.content,md.created_at, COALESCE(ms.tags,'') as tags, COALESCE(ms.score,1.0) as score FROM memory_drawers md LEFT JOIN memory_scores ms ON md.id=ms.id ORDER BY md.created_at ASC"
  ) {
    $ok:rows rows;
    $err:v @()
  };
  if(rows.len = 0){
    log.warn("export_all: db query failed";"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  let content=buildcontent(rows;format);
  let writeok=mt fs.write(outpath;content) {
    $ok:v true;
    $err:v false
  };
  if(!writeok){
    log.warn(str.concat("export write failed: ";outpath);"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  log.info(str.concat("exported ";str.concat(str.fromint(rows.len);str.concat(" memories to: ";outpath)));"export";"system");
  <$memoryexport{count:rows.len;path:outpath;format:formatlabel(format);ts:now}
};


f=exportrange(palace:i64;fromts:i64;tots:i64;outpath:str;format:$exportformat;now:i64):$memoryexport{
  let froms=str.fromint(fromts);
  let tos=str.fromint(tots);
  let rows=mt db.queryparams(
    palace.conn;
    "SELECT md.id,md.wing,md.hall,md.room,md.role,md.content,md.created_at, COALESCE(ms.tags,'') as tags, COALESCE(ms.score,1.0) as score FROM memory_drawers md LEFT JOIN memory_scores ms ON md.id=ms.id WHERE md.created_at >= ? AND md.created_at <= ? ORDER BY md.created_at ASC";
    @(froms;tos)
  ) {
    $ok:rows rows;
    $err:v @()
  };
  if(rows.len = 0){
    log.warn("export_range: db query failed";"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  let content=buildcontent(rows;format);
  let writeok=mt fs.write(outpath;content) {
    $ok:v true;
    $err:v false
  };
  if(!writeok){
    log.warn(str.concat("export_range write failed: ";outpath);"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  log.info(str.concat("exported range ";str.concat(froms;str.concat(" to ";str.concat(tos;str.concat(": ";outpath)))));"export";"system");
  <$memoryexport{count:rows.len;path:outpath;format:formatlabel(format);ts:now}
};




f=importjson(palace:i64;path:str):i32{
  let raw=mt fs.read(path) {
    $ok:raw raw;
    $err:v ""
  };
  if(str.len(raw) = 0){
    log.warn(str.concat("import_json: could not read file: ";path);"export";"system");
    <0
  }el{};
  let items=mt json.parsearray(raw) {
    $ok:items items;
    $err:v @()
  };
  if(items.len = 0){
    log.warn(str.concat("import_json: failed to parse JSON array from: ";path);"export";"system");
    <0
  }el{};
  let count=mut.0;
  lp(let ii=0;ii<items.len;ii=ii+1){
    let item=items.get(ii);
    let id=json.str(item;"id");
    let wing=json.str(item;"wing");
    let hall=json.str(item;"hall");
    let room=json.str(item;"room");
    let role=json.str(item;"role");
    let content=json.str(item;"content");
    let tags=json.str(item;"tags");
    let scores=str.fromfloat(json.getfloat(item;"score"));
    let tss=str.fromint(json.i64(item;"created_at"));
    let insertok=mt db.execparams(
      palace.conn;
      "INSERT OR IGNORE INTO memory_drawers (id,wing,hall,room,role,content,created_at) VALUES (?,?,?,?,?,?,?)";
      @(id;wing;hall;room;role;content;tss)
    ) {
      $ok:v true;
      $err:v false
    };
    if(insertok){
      mt db.execparams(
        palace.conn;
        "INSERT OR IGNORE INTO memory_scores (id,tags,score,accessed_at) VALUES (?,?,?,?)";
        @(id;tags;scores;tss)
      ) {
        $ok:v void;
        $err:v void
      };
      count=count + 1
    }el{
      log.warn(str.concat("import_json: skipped duplicate id: ";id);"export";"system")
    }
  };
  log.info(str.concat("imported ";str.concat(str.fromint(count);" memories from JSON"));"export";"system");
  <count
};

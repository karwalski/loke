m=core.memory.export;




i=db:std.db;
i=fs:std.fs;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=jx:shared.jsonobj;
i=s:core.storage.db;
i=memtypes:core.memory.types;

t=$exportformat{
  $json:i64;
  $csv:i64;
  $markdown:i64};

t=$memoryexport{
  count:i32;
  path:str;
  format:str;
  ts:i64
};



f=csvescape(s:str):str{
  let escaped=str.replace(s;"\"";  "\"\"");
  <str.concat("\"";str.concat(escaped;"\""))
};



f=formatmemorymd(id:str;content:str;tags:str;score:f32;ts:i64):str{
  let header=str.concat("## ";str.concat(id;"
"));
  let metatags=str.concat("**Tags:** ";str.concat(tags;"
"));
  let metascore=str.concat("**Score:** ";str.concat(str.fromfloat(score);"
"));
  let metats=str.concat("**Timestamp:** ";str.concat(str.fromint(ts);"
"));
  let body=str.concat("
";str.concat(content;"

---

"));
  <str.concat(header;str.concat(metatags;str.concat(metascore;str.concat(metats;body))))
};


(* score is read with core.storage.db's rowf64hundredths, not json.getfloat: a $row is
   not a JSON object, so json.getfloat returned 0 and every exported memory carried
   score 0.0 whatever its real weight. The other columns here already used the row
   accessors. The division happens after the module boundary is crossed (T-20). *)
(* ── JSON escaping, and why not json.enc ─────────────────────────────────────────
   These seven string fields were escaped with `csvescape`, which DOUBLES a quote:
   `he said "hi"` became `"he said ""hi"""`, which is correct for CSV and invalid JSON. Every
   JSON export of a memory whose content held a double quote was unparseable — and an
   assistant reply is about the likeliest place in this product to find one. `rowtocsv2` below
   is where csvescape belongs and still uses it; it was used here, presumably, because it was
   the escaper already in the file.

   `json.enc` is the obvious replacement and does not work here, and I cannot say why.
   Measured, by swapping it in for exactly these seven fields: three assertions in
   tests/unit/memory/test_export.tk that had been PASSING went red — the export carried
   neither the id, nor the content, nor the tags — while `validjson` stayed green, so the
   output remained well-formed and empty.

   What that is NOT: `json.enc` is correct on an ordinary string, and it is correct on a
   result-typed one. Probed directly at 0b0bc4e, `json.enc(str.slice("hello";0;5))` — a bare
   `str!SliceErr` where a `str` is wanted — and the same expression with the result matched and
   unwrapped both returned the 7 characters `"hello"`. So the first explanation I wrote here,
   that a stdlib function cannot read a `db.rowstr` result, is **false** and has been removed
   rather than left to mislead the next reader. The cause is specific to values coming out of
   `db.rowstr` and is not established.

   Rather than guess at that boundary, `jsonescape` is built from the same `str.replace` the
   working escaper used. The order is load-bearing: BACKSLASH FIRST, or the backslash inserted
   while escaping a quote is itself escaped a moment later and `\"` becomes `\\"`. Newlines
   and tabs are escaped too, which csvescape never did and which memory content needs more
   often than not — a multi-line drawer produced a raw newline inside a JSON string. *)
f=jsonescape(s:str):str{
  (* One definition, in shared.jsonobj — core.mcp.protocol needs the same escaper, and two
     copies of an escaper is how two outputs come to disagree about what is escaped. *)
  <jx.escape(s)
};


f=rowtojson(row:$row):str{
  let wing=db.rowstr(row;"wing");
  let hall=db.rowstr(row;"hall");
  let room=db.rowstr(row;"room");
  let role=db.rowstr(row;"role");
  let content=db.rowstr(row;"content");
  let tags=db.rowstr(row;"tags");
  let score=(s.rowf64hundredths(row;"score") as f64) / 100.0;
  let ts=db.rowi64(row;"created_at");

  let obj="{";
  let obj=str.concat(obj;str.concat("\"id\":";str.concat(jsonescape(db.rowstr(row;"id"));",")));
  let obj=str.concat(obj;str.concat("\"wing\":";str.concat(jsonescape(wing);",")));
  let obj=str.concat(obj;str.concat("\"hall\":";str.concat(jsonescape(hall);",")));
  let obj=str.concat(obj;str.concat("\"room\":";str.concat(jsonescape(room);",")));
  let obj=str.concat(obj;str.concat("\"role\":";str.concat(jsonescape(role);",")));
  let obj=str.concat(obj;str.concat("\"content\":";str.concat(jsonescape(content);",")));
  let obj=str.concat(obj;str.concat("\"tags\":";str.concat(jsonescape(tags);",")));
  let obj=str.concat(obj;str.concat("\"score\":";str.concat(str.fromfloat(score);",")));
  let obj=str.concat(obj;str.concat("\"created_at\":";str.concat(str.fromint(ts);"}")));
  <obj
};


f=buildcontentjson(rows:@$row):str{
  let lines=mut.@();
  lp(let ri=0;ri<rows.len;ri=ri+1){
    lines=lines.push(str.concat("  ";rowtojson(rows.get(ri))))
  };
  <str.concat("[";str.concat(str.join(",";lines);"]"))
};

f=rowtocsv2(row:$row):str{
  let r=mut.csvescape(db.rowstr(row;"id"));
  r=str.concat(r;str.concat(",";csvescape(db.rowstr(row;"wing"))));
  r=str.concat(r;str.concat(",";csvescape(db.rowstr(row;"hall"))));
  r=str.concat(r;str.concat(",";csvescape(db.rowstr(row;"room"))));
  r=str.concat(r;str.concat(",";csvescape(db.rowstr(row;"role"))));
  r=str.concat(r;str.concat(",";csvescape(db.rowstr(row;"content"))));
  r=str.concat(r;str.concat(",";csvescape(db.rowstr(row;"tags"))));
  r=str.concat(r;str.concat(",";str.fromfloat((s.rowf64hundredths(row;"score") as f64) / 100.0)));
  r=str.concat(r;str.concat(",";str.fromint(db.rowi64(row;"created_at"))));
  <r
};

f=buildcontentcsv(rows:@$row):str{
  let header="\"id\",\"wing\",\"hall\",\"room\",\"role\",\"content\",\"tags\",\"score\",\"created_at\"";
  let datalines=mut.@();
  lp(let ri=0;ri<rows.len;ri=ri+1){
    datalines=datalines.push(rowtocsv2(rows.get(ri)))
  };
  <str.concat(header;str.concat("\n";str.join("\n";datalines)))
};

f=buildcontentmd(rows:@$row):str{
  let title="# Memory Palace Export\n\n";
  let blocks=mut.@();
  lp(let ri=0;ri<rows.len;ri=ri+1){
    let row:$row=rows.get(ri);
    blocks=blocks.push(formatmemorymd(
      db.rowstr(row;"id");
      db.rowstr(row;"content");
      db.rowstr(row;"tags");
      ((s.rowf64hundredths(row;"score") as f64) / 100.0) as f32;
      db.rowi64(row;"created_at")
    ))
  };
  <str.concat(title;str.join("";blocks))
};

f=buildcontent(rows:@$row;format:$exportformat):str{
  <mt format {
    $json:v buildcontentjson(rows);
    $csv:v buildcontentcsv(rows);
    $markdown:v buildcontentmd(rows)
  }
};


f=formatlabel(format:$exportformat):str{
  <mt format {
    $json:v "json";
    $csv:v "csv";
    $markdown:v "markdown"
  }
};


f=exportall(palace:i64;outpath:str;format:$exportformat;now:i64):$memoryexport{
  let rows=mt db.many("SELECT md.id,md.wing,md.hall,md.room,md.role,md.content,md.created_at, COALESCE(ms.tags,'') as tags, COALESCE(ms.score,1.0) as score FROM memory_drawers md LEFT JOIN memory_scores ms ON md.id=ms.id ORDER BY md.created_at ASC";@()) {
    $ok:rows rows;
    $err:v @()
  };
  if(rows.len == 0){
    log.warn("export_all: db query failed";"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  let content=buildcontent(rows;format);
  let writeok=mt fs.write(outpath;content) {
    $ok:v true;
    $err:v false
  };
  if(!writeok){
    log.warn(str.concat("export write failed: ";outpath);"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  log.info(str.concat("exported ";str.concat(str.fromint(rows.len);str.concat(" memories to: ";outpath)));"export";"system");
  <$memoryexport{count:rows.len;path:outpath;format:formatlabel(format);ts:now}
};


f=exportrange(palace:i64;fromts:i64;tots:i64;outpath:str;format:$exportformat;now:i64):$memoryexport{
  let froms=str.fromint(fromts);
  let tos=str.fromint(tots);
  let rows=mt db.many("SELECT md.id,md.wing,md.hall,md.room,md.role,md.content,md.created_at, COALESCE(ms.tags,'') as tags, COALESCE(ms.score,1.0) as score FROM memory_drawers md LEFT JOIN memory_scores ms ON md.id=ms.id WHERE md.created_at >= ? AND md.created_at <= ? ORDER BY md.created_at ASC";@(froms;tos)) {
    $ok:rows rows;
    $err:v @()
  };
  if(rows.len == 0){
    log.warn("export_range: db query failed";"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  let content=buildcontent(rows;format);
  let writeok=mt fs.write(outpath;content) {
    $ok:v true;
    $err:v false
  };
  if(!writeok){
    log.warn(str.concat("export_range write failed: ";outpath);"export";"system");
    <$memoryexport{count:0;path:outpath;format:formatlabel(format);ts:now}
  }el{};
  log.info(str.concat("exported range ";str.concat(froms;str.concat(" to ";str.concat(tos;str.concat(": ";outpath)))));"export";"system");
  <$memoryexport{count:rows.len;path:outpath;format:formatlabel(format);ts:now}
};




f=importjson(palace:i64;path:str):i32{
  let raw=mt fs.read(path) {
    $ok:raw raw;
    $err:v ""
  };
  if(str.len(raw) == 0){
    log.warn(str.concat("import_json: could not read file: ";path);"export";"system");
    <0 as i32
  }el{};
  let items=mt json.parsearray(raw) {
    $ok:items items;
    $err:v @()
  };
  if(items.len == 0){
    log.warn(str.concat("import_json: failed to parse JSON array from: ";path);"export";"system");
    <0 as i32
  }el{};
  let count=mut.0;
  lp(let ii=0;ii<items.len;ii=ii+1){
    let item=items.get(ii);
    let id=db.rowstr(item;"id");
    let wing=db.rowstr(item;"wing");
    let hall=db.rowstr(item;"hall");
    let room=db.rowstr(item;"room");
    let role=db.rowstr(item;"role");
    let content=db.rowstr(item;"content");
    let tags=db.rowstr(item;"tags");
    let scores=str.fromfloat(json.getfloat(item;"score"));
    let tss=str.fromint(db.rowi64(item;"created_at"));
    let insertok=mt db.exec("INSERT OR IGNORE INTO memory_drawers (id,wing,hall,room,role,content,created_at) VALUES (?,?,?,?,?,?,?)";@(id;wing;hall;room;role;content;tss)) {
      $ok:v true;
      $err:v false
    };
    if(insertok){
      mt db.exec("INSERT OR IGNORE INTO memory_scores (id,tags,score,accessed_at) VALUES (?,?,?,?)";@(id;tags;scores;tss)) {
        $ok:v void;
        $err:v void
      };
      count=count + 1
    }el{
      log.warn(str.concat("import_json: skipped duplicate id: ";id);"export";"system")
    }
  };
  log.info(str.concat("imported ";str.concat(str.fromint(count);" memories from JSON"));"export";"system");
  <count
};

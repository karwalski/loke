m=core.memory.privacy;





i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=s:core.storage.db;
i=sh:shared.types;

t=$privacyprefs{
  optouttopics:@str;
  maxretentiondays:i32;
  autoforgetpii:bool;
  requireconsent:bool
};

t=$forgetresult{
  deletedcount:i32;
  topicscleared:@str
};



(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=defaultprivacyprefs():$privacyprefs{
  <$privacyprefs{
    optouttopics:@();
    maxretentiondays:365;
    autoforgetpii:true;
    requireconsent:false
  }
};

f=parseprefsobj(obj:$jsonval):$privacyprefs{
  let topics=sh.jsonstrarray(obj;"opt_out_topics");
  (* F10.57. A field the stored document lacks takes its default, as an unparsable document
     does. It used to read as 0 days and auto_forget_pii false: PII kept, not forgotten. *)
  let d=defaultprivacyprefs();
  let maxdays=mt json.i64(obj;"max_retention_days"){$ok:okv okv;$err:errv d.maxretentiondays as i64};
  let forgetpii=mt json.bool(obj;"auto_forget_pii"){$ok:okv okv;$err:errv d.autoforgetpii};
  let consent=mt json.bool(obj;"require_consent"){$ok:okv okv;$err:errv d.requireconsent};
  <$privacyprefs{
    optouttopics:topics;
    maxretentiondays:maxdays;
    autoforgetpii:forgetpii;
    requireconsent:consent
  }
};

f=prefsparsefail():$privacyprefs{
  log.warn("privacy_prefs row corrupt, using defaults";"privacy";"system");
  <defaultprivacyprefs()
};

(* json.dec, the typed decoder; json.decode is one of std.json's untyped ABI helpers
   (LS1.1w). *)
f=parseprefsjson(raw:str):$privacyprefs{
  <mt json.dec(raw) {
    $ok:obj parseprefsobj(obj);
    $jsonerr:v prefsparsefail()
  }
};

(* The row accessors below are core.storage.db's, not std.json's. Every read of a $dbrow
   in this module went through json.str, which does not understand a row handle and
   returns "": the prefs blob was always empty so defaults were always used, and — far
   worse — the three forget* loops built their DELETE parameter from an empty id, so
   `DELETE ... WHERE id=''` matched nothing. forget_topic, forget_before and forget_pii
   reported a deleted count and deleted nothing. parseprefsobj above is unaffected: it
   reads a genuine parsed JSON object. *)
f=loadprefsrows(rows:@$dbrow):$privacyprefs{
  if(rows.len > 0){
    let firstrow:$dbrow=rows.get(0);
    <parseprefsjson(s.rowstr(firstrow;"value"))
  }el{
    <defaultprivacyprefs()
  }
};

f=loadprefsqueryfail():$privacyprefs{
  log.warn("failed to load privacy prefs, using defaults";"privacy";"system");
  <defaultprivacyprefs()
};

f=loadprefs(palace:i64):$privacyprefs{
  <mt db.many("SELECT value FROM memory_settings WHERE key='privacy_prefs' LIMIT 1";@()) {
    $ok:rows loadprefsrows(rows);
    $err:v loadprefsqueryfail()
  }
};


f=saveprefs(palace:i64;prefs:$privacyprefs):bool{
  let topicsjoined=mut.@();
  lp(let ii84=0;ii84<prefs.optouttopics.len;ii84=ii84+1){
    topicsjoined=topicsjoined.push("\"\(prefs.optouttopics.get(ii84))\"")
  };
  let topics=topicsjoined.join(",");
  let forgetpiis=mut."false";
  if(prefs.autoforgetpii){ forgetpiis="true" }el{};
  let consents=mut."false";
  if(prefs.requireconsent){ consents="true" }el{};
  let maxs=str.fromint(prefs.maxretentiondays);
  let payload="{\"opt_out_topics\":[\(topics)],\"max_retention_days\":\(maxs),\"auto_forget_pii\":\(forgetpiis),\"require_consent\":\(consents)}";
  let ok=mt db.exec("INSERT OR REPLACE INTO memory_settings (key,value) VALUES ('privacy_prefs',?)";@(payload)) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.info("privacy prefs saved";"privacy";"system");
    <true
  }el{
    log.warn("failed to save privacy prefs";"privacy";"system");
    <false
  }
};




f=forgettopicqueryfail(topic:str):$forgetresult{
  log.warn(str.concat("forget_topic: query failed for topic: ";topic);"privacy";"system");
  <$forgetresult{deletedcount:0;topicscleared:@()}
};

f=forgettopicrows(palace:i64;topic:str;rows:@$dbrow):$forgetresult{
  let deleted=mut.0;
  lp(let ii=0;ii<rows.len;ii=ii+1){     let mid=s.rowstr(rows.get(ii);"id");
    mt db.exec("DELETE FROM memory_scores WHERE id=?";@(mid)) {
      $ok:v 0;$err:v 0
    };
    mt db.exec("DELETE FROM memory_index WHERE drawer_id=?";@(mid)) {
      $ok:v 0;$err:v 0
    };
    let delok=mt db.exec("DELETE FROM memory_drawers WHERE id=?";@(mid)) {
      $ok:v true;
      $err:v false
    };
    if(delok){
      deleted=deleted + 1
    }el{
      log.warn(str.concat("forget_topic: failed to delete drawer: ";mid);"privacy";"system")
    }
  };
  log.info(
    "forget_topic '\(topic)': deleted \(str.fromint(deleted))";
    "privacy";"system"
  );
  <$forgetresult{deletedcount:deleted;topicscleared:@()}
};

f=forgettopic(palace:i64;topic:str):$forgetresult{
  let lowertopic=str.tolower(topic);
  let liketopic="%\(lowertopic)%";
  <mt db.many("SELECT id FROM memory_drawers WHERE LOWER(content) LIKE ? OR LOWER(id) IN (SELECT id FROM memory_scores WHERE LOWER(tags) LIKE ?)";@(liketopic;liketopic)) {
    $ok:rows forgettopicrows(palace;topic;rows);
    $err:v forgettopicqueryfail(topic)
  }
};


f=forgetbeforerows(palace:i64;tss:str;rows:@$dbrow):i32{
  let deleted=mut.0;
  lp(let ii=0;ii<rows.len;ii=ii+1){     let mid=s.rowstr(rows.get(ii);"id");
    mt db.exec("DELETE FROM memory_scores WHERE id=?";@(mid)) {
      $ok:v 0;$err:v 0
    };
    mt db.exec("DELETE FROM memory_index WHERE drawer_id=?";@(mid)) {
      $ok:v 0;$err:v 0
    };
    let delok=mt db.exec("DELETE FROM memory_drawers WHERE id=?";@(mid)) {
      $ok:v true;
      $err:v false
    };
    if(delok){
      deleted=deleted + 1
    }el{
      log.warn(str.concat("forget_before: failed to delete drawer: ";mid);"privacy";"system")
    }
  };
  log.info(
    "forget_before \(tss): deleted \(str.fromint(deleted))";
    "privacy";"system"
  );
  <deleted
};

f=forgetbeforequeryfail():i32{
  log.warn("forget_before: query failed";"privacy";"system");
  <0 as i32
};

f=forgetbefore(palace:i64;beforets:i64):i32{
  let tss=str.fromint(beforets);
  <mt db.many("SELECT id FROM memory_drawers WHERE created_at < ?";@(tss)) {
    $ok:rows forgetbeforerows(palace;tss;rows);
    $err:v forgetbeforequeryfail()
  }
};




(* Two defects: `deleted` was rebound with `let` inside the branch so the count was
   always 0 and the log always read "deleted 0"; and the parameters were written
   `@($mid)` — a `$` sigil makes that a type reference, not the local `mid`. *)
f=forgetpiirows(palace:i64;rows:@$dbrow):i32{
  let deleted=mut.0;
  lp(let i=0;i<rows.len;i=i+1){
    let mid=s.rowstr(rows.get(i);"id");
    mt db.exec("DELETE FROM memory_scores WHERE id=?";@(mid)) {
      $ok:v 0;$err:v 0
    };
    mt db.exec("DELETE FROM memory_index WHERE drawer_id=?";@(mid)) {
      $ok:v 0;$err:v 0
    };
    let delok=mt db.exec("DELETE FROM memory_drawers WHERE id=?";@(mid)) {
      $ok:v true;
      $err:v false
    };
    if(delok){
      deleted=deleted + 1
    }el{
      log.warn("forget_pii: failed to delete drawer: \(mid)";"privacy";"system")
    }
  };
  log.info("forget_pii: deleted \(deleted)";"privacy";"system");
  <deleted as i32
};

f=forgetpiiqueryfail():i32{
  log.warn("forget_pii: query failed";"privacy";"system");
  <0 as i32
};

f=forgetpii(palace:i64):i32{
  <mt db.many("SELECT id FROM memory_scores WHERE pii_flagged=1"
  ;@()) {
    $ok:rows forgetpiirows(palace;rows);
    $err:v forgetpiiqueryfail()
  }
};




(* `let blocked=true` inside the if declared a second, branch-local `blocked`, so
   the outer one stayed false and this returned true for every input: the user's
   opt-out topics were never honoured and content they asked never to be stored was
   stored anyway. `mut` plus a bare assignment is the fix. *)
f=shouldstore(content:str;prefs:$privacyprefs):bool{
  let lower=str.tolower(content);
  let blocked=mut.false;
  lp(let i=0;i<prefs.optouttopics.len;i=i+1){
    if(str.contains(lower;str.tolower(prefs.optouttopics.get(i)))){
      blocked=true
    }el{}
  };
  <!blocked
};

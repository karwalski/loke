m=core.memory.privacy;





i=memtypes:core.memory.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;

t=$privacyprefs{
  optouttopics:@(str);
  maxretentiondays:i32;
  autoforgetpii:bool;
  requireconsent:bool
};

t=$forgetresult{
  deletedcount:i32;
  topicscleared:@(str)
};



f=loadprefs(palace:$memtypes.palace):$privacyprefs{
  db.query(palace.conn;"SELECT value FROM memory_settings WHERE key=mt 'privacy_prefs' LIMIT 1") {
    $ok:rows {
      if rows.len > 0{
        let raw=json.getstr(rows.get(0);"value");
        mt json.parse(raw) {
          $ok:obj {
            let topics=json.getstrarray(obj;"opt_out_topics");
            let maxdays=json.getint(obj;"max_retention_days");
            let forgetpii=json.getbool(obj;"auto_forget_pii");
            let consent=json.getbool(obj;"require_consent");
            <$privacyprefs{
              optouttopics:topics;
              maxretentiondays:maxdays;
              autoforgetpii:forgetpii;
              requireconsent:consent
            };
          };
          $err: {
            log.warn("privacy_prefs row corrupt, using defaults";"privacy";"system");
            <$privacyprefs{
              optouttopics:@();
              maxretentiondays:365;
              autoforgetpii:true;
              requireconsent:false
            };
          };
        };
      }else{
        
        <$privacyprefs{
          optouttopics:@();
          maxretentiondays:365;
          autoforgetpii:true;
          requireconsent:false
        };
      };
    };
    $err: {
      log.warn("failed to load privacy prefs, using defaults";"privacy";"system");
      <$privacyprefs{
        optouttopics:@();
        maxretentiondays:365;
        autoforgetpii:true;
        requireconsent:false
      };
    };
  };
};


f=saveprefs(palace:$memtypes.palace;prefs:$privacyprefs):bool{
  
  let topicsjoined=prefs.optouttopics.map|t{ str.concat("\"";str.concat(t;"\"")) };
  let topicsarr=str.concat("[";str.concat(topicsjoined.join(",");"]"));
  let forgetpiis=if prefs.autoforgetpii{ "true" }else{ "false" };
  let consents=if prefs.requireconsent{ "true" }else{ "false" };
  let maxs=str.fromint(prefs.maxretentiondays);
  let payload=str.concat(
    "{\"opt_out_topics\":";str.concat(
    topicsarr;str.concat(
    ",\"max_retention_days\":";str.concat(
    maxs;str.concat(
    ",\"auto_forget_pii\":";str.concat(
    forgetpiis;str.concat(
    ",\"require_consent\":";str.concat(
    consents;"}"))))))))
  );
  db.execparams(
    palace.conn;
    "INSERT OR REPLACE INTO memory_settings (key,value) VALUES ('privacy_prefs',?)";
    @(payload)
  mt ) {
    $ok: {
      log.info("privacy prefs saved";"privacy";"system");
      <true
    };
    $err: {
      log.warn("failed to save privacy prefs";"privacy";"system");
      <false
    };
  };
};




f=forgettopic(palace:$memtypes.palace;topic:str):$forgetresult{
  let lowertopic=str.tolower(topic);
  let liketopic=str.concat("%";str.concat(lowertopic;"%"));
  
  let deleted=0;
  db.queryparams(
    palace.conn;
    "SELECT id FROM memory_drawers WHERE LOWER(content) LIKE ? OR LOWER(id) IN (SELECT id FROM memory_scores WHERE LOWER(tags) LIKE ?)";
    @(liketopic;liketopic)
  mt ) {
    $ok:rows {
      rows.each|row{
        let mid=json.getstr(row;"id");
        
        db.execparams(palace.conn;"DELETE FROM memory_scores WHERE id=?";mt @(mid)) {
          $ok: {};$err: {};
        };
        
        db.execparams(palace.conn;"DELETE FROM memory_index WHERE drawer_id=?";mt @(mid)) {
          $ok: {};$err: {};
        };
        
        db.execparams(palace.conn;"DELETE FROM memory_drawers WHERE id=?";mt @(mid)) {
          $ok: { let deleted=deleted + 1 };
          $err: {
            log.warn(str.concat("forget_topic: failed to delete drawer: ";mid);"privacy";"system")
          };
        };
      };
      log.info(
        str.concat("forget_topic '";str.concat(topic;str.concat("': deleted ";str.fromint(deleted))));
        "privacy";"system"
      )
    };
    $err: {
      log.warn(str.concat("forget_topic: query failed for topic: ";topic);"privacy";"system")
    };
  };
  <$forgetresult{deletedcount:deleted;topicscleared:@(topic)};
};



f=forgetbefore(palace:$memtypes.palace;beforets:i64):i32{
  let tss=str.fromint(beforets);
  
  let deleted=0;
  db.queryparams(
    palace.conn;
    "SELECT id FROM memory_drawers WHERE created_at < ?";
    @(tss)
  mt ) {
    $ok:rows {
      rows.each|row{
        let mid=json.getstr(row;"id");
        db.execparams(palace.conn;"DELETE FROM memory_scores WHERE id=?";mt @(mid)) {
          $ok: {};$err: {};
        };
        db.execparams(palace.conn;"DELETE FROM memory_index WHERE drawer_id=?";mt @(mid)) {
          $ok: {};$err: {};
        };
        db.execparams(palace.conn;"DELETE FROM memory_drawers WHERE id=?";mt @(mid)) {
          $ok: { let deleted=deleted + 1 };
          $err: {
            log.warn(str.concat("forget_before: failed to delete drawer: ";mid);"privacy";"system")
          };
        };
      };
      log.info(
        str.concat("forget_before ";str.concat(tss;str.concat(": deleted ";str.fromint(deleted))));
        "privacy";"system"
      )
    };
    $err: {
      log.warn("forget_before: query failed";"privacy";"system")
    };
  };
  <deleted
};




f=forgetpii(palace:$memtypes.palace):i32{
  let deleted=0;
  db.query(
    palace.conn;
    "SELECT id FROM memory_scores WHERE pii_flagged=1"
  mt ) {
    $ok:rows {
      rows.each|row{
        let mid=json.getstr(row;"id");
        db.execparams(palace.conn;"DELETE FROM memory_scores WHERE id=?";mt @(mid)) {
          $ok: {};$err: {};
        };
        db.execparams(palace.conn;"DELETE FROM memory_index WHERE drawer_id=?";mt @(mid)) {
          $ok: {};$err: {};
        };
        db.execparams(palace.conn;"DELETE FROM memory_drawers WHERE id=?";mt @(mid)) {
          $ok: { let deleted=deleted + 1 };
          $err: {
            log.warn(str.concat("forget_pii: failed to delete drawer: ";mid);"privacy";"system")
          };
        };
      };
      log.info(str.concat("forget_pii: deleted ";str.fromint(deleted));"privacy";"system")
    };
    $err: {
      log.warn("forget_pii: query failed";"privacy";"system")
    };
  };
  <deleted
};




f=shouldstore(content:str;prefs:$privacyprefs):bool{
  let lower=str.tolower(content);
  let blocked=false;
  prefs.optouttopics.each|topic{
    if str.contains(lower;str.tolower(topic)){
      let blocked=true
    };
  };
  if blocked{
    <false
  }else{
    <true
  };
};

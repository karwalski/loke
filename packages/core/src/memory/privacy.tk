m=core.memory.privacy;





i=memtypes:core.memory.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;

t=$privacyprefs{
  optouttopics:@str;
  maxretentiondays:i32;
  autoforgetpii:bool;
  requireconsent:bool
};

t=$forgetresult{
  deletedcount:i32;
  topicscleared:@str
};



f=defaultprivacyprefs():$privacyprefs{
  <$privacyprefs{
    optouttopics:@();
    maxretentiondays:365;
    autoforgetpii:true;
    requireconsent:false
  }
};

f=parseprefsobj(obj:i64):$privacyprefs{
  let topics=json.strarray(obj;"opt_out_topics");
  let maxdays=json.i64(obj;"max_retention_days");
  let forgetpii=json.bool(obj;"auto_forget_pii");
  let consent=json.bool(obj;"require_consent");
  <$privacyprefs{
    optouttopics:topics;
    maxretentiondays:maxdays;
    autoforgetpii:forgetpii;
    requireconsent:consent
  }
};

f=prefsparsefail():$privacyprefs{
  log.warn("privacy_prefs row corrupt, using defaults";"privacy";"system");
  <defaultprivacyprefs()
};

f=parseprefsjson(raw:str):$privacyprefs{
  mt json.parse(raw) {
    $ok:obj parseprefsobj(obj);
    $err:v prefsparsefail()
  }
};

f=loadprefsrows(rows:i64):$privacyprefs{
  if(rows.len > 0){
    let raw=json.str(rows.get(0);"value");
    <parseprefsjson(raw)
  }el{
    <defaultprivacyprefs()
  }
};

f=loadprefsqueryfail():$privacyprefs{
  log.warn("failed to load privacy prefs, using defaults";"privacy";"system");
  <defaultprivacyprefs()
};

f=loadprefs(palace:i64):$privacyprefs{
  mt db.query(palace.conn;"SELECT value FROM memory_settings WHERE key='privacy_prefs' LIMIT 1") {
    $ok:rows loadprefsrows(rows);
    $err:v loadprefsqueryfail()
  }
};


f=saveprefs(palace:i64;prefs:$privacyprefs):bool{
  let topicsjoined=mut.@();
  lp(let ii84=0;ii84<prefs.optouttopics.len;ii84=ii84+1){
    let t=prefs.optouttopics.get(ii84);
    topicsjoined=topicsjoined.push(str.concat("\"";str.concat(t;"\"")))
  };
  let topicsarr=str.concat("[";str.concat(topicsjoined.join(",");"]"));
  let forgetpiis=mut."false";
  if(prefs.autoforgetpii){ forgetpiis="true" }el{};
  let consents=mut."false";
  if(prefs.requireconsent){ consents="true" }el{};
  let maxs=str.fromint(prefs.maxretentiondays);
  let payload=str.concat(
    "{\"opt_out_topics\":";str.concat(
    topicsarr;str.concat(
    ",\"max_retention_days\":";str.concat(
    maxs;str.concat(
    ",\"auto_forget_pii\":";str.concat(
    forgetpiis;str.concat(
    ",\"require_consent\":";str.concat(
    consents;"}"))))))));
  let ok=mt db.execparams(
    palace.conn;
    "INSERT OR REPLACE INTO memory_settings (key,value) VALUES ('privacy_prefs',?)";
    @($payload)
  ) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.info("privacy prefs saved";"privacy";"system");
    <true
  }el{
    log.warn("failed to save privacy prefs";"privacy";"system");
    <false
  }
};




f=forgettopicqueryfail(topic:str):$forgetresult{
  log.warn(str.concat("forget_topic: query failed for topic: ";topic);"privacy";"system");
  <$forgetresult{deletedcount:0;topicscleared:@()}
};

f=forgettopicrows(palace:i64;topic:str;rows:i64):$forgetresult{
  let deleted=mut.0;
  lp(let ii=0;ii<rows.len;ii=ii+1){ let row=rows.get(ii);
    let mid=json.str(row;"id");
    mt db.execparams(palace.conn;"DELETE FROM memory_scores WHERE id=?";@(mid)) {
      $ok:v void;$err:v void
    };
    mt db.execparams(palace.conn;"DELETE FROM memory_index WHERE drawer_id=?";@(mid)) {
      $ok:v void;$err:v void
    };
    let delok=mt db.execparams(palace.conn;"DELETE FROM memory_drawers WHERE id=?";@(mid)) {
      $ok:v true;
      $err:v false
    };
    if(delok){
      deleted=deleted + 1
    }el{
      log.warn(str.concat("forget_topic: failed to delete drawer: ";mid);"privacy";"system")
    }
  };
  log.info(
    str.concat("forget_topic '";str.concat(topic;str.concat("': deleted ";str.fromint(deleted))));
    "privacy";"system"
  );
  <$forgetresult{deletedcount:deleted;topicscleared:@()}
};

f=forgettopic(palace:i64;topic:str):$forgetresult{
  let lowertopic=str.tolower(topic);
  let liketopic=str.concat("%";str.concat(lowertopic;"%"));
  mt db.queryparams(
    palace.conn;
    "SELECT id FROM memory_drawers WHERE LOWER(content) LIKE ? OR LOWER(id) IN (SELECT id FROM memory_scores WHERE LOWER(tags) LIKE ?)";
    @(liketopic;liketopic)
  ) {
    $ok:rows forgettopicrows(palace;topic;rows);
    $err:v forgettopicqueryfail(topic)
  }
};


f=forgetbeforerows(palace:i64;tss:str;rows:i64):i32{
  let deleted=mut.0;
  lp(let ii=0;ii<rows.len;ii=ii+1){ let row=rows.get(ii);
    let mid=json.str(row;"id");
    mt db.execparams(palace.conn;"DELETE FROM memory_scores WHERE id=?";@(mid)) {
      $ok:v void;$err:v void
    };
    mt db.execparams(palace.conn;"DELETE FROM memory_index WHERE drawer_id=?";@(mid)) {
      $ok:v void;$err:v void
    };
    let delok=mt db.execparams(palace.conn;"DELETE FROM memory_drawers WHERE id=?";@(mid)) {
      $ok:v true;
      $err:v false
    };
    if(delok){
      deleted=deleted + 1
    }el{
      log.warn(str.concat("forget_before: failed to delete drawer: ";mid);"privacy";"system")
    }
  };
  log.info(
    str.concat("forget_before ";str.concat(tss;str.concat(": deleted ";str.fromint(deleted))));
    "privacy";"system"
  );
  <deleted
};

f=forgetbeforequeryfail():i32{
  log.warn("forget_before: query failed";"privacy";"system");
  <0 as i32
};

f=forgetbefore(palace:i64;beforets:i64):i32{
  let tss=str.fromint(beforets);
  mt db.queryparams(
    palace.conn;
    "SELECT id FROM memory_drawers WHERE created_at < ?";
    @($tss)
  ) {
    $ok:rows forgetbeforerows(palace;tss;rows);
    $err:v forgetbeforequeryfail()
  }
};




f=forgetpiirows(palace:i64;rows:i64):i32{
  let deleted=0;
  lp(let ii220=0;ii220<rows.len;ii220=ii220+1){
    let row=rows.get(ii220);
    let mid=json.str(row;"id");
    mt db.execparams(palace.conn;"DELETE FROM memory_scores WHERE id=?";@($mid)) {
      $ok:v void;$err:v void
    };
    mt db.execparams(palace.conn;"DELETE FROM memory_index WHERE drawer_id=?";@($mid)) {
      $ok:v void;$err:v void
    };
    let delok=mt db.execparams(palace.conn;"DELETE FROM memory_drawers WHERE id=?";@($mid)) {
      $ok:v true;
      $err:v false
    };
    if(delok){
      let deleted=deleted + 1
    }el{
      log.warn(str.concat("forget_pii: failed to delete drawer: ";mid);"privacy";"system")
    }

  };
  log.info(str.concat("forget_pii: deleted ";str.fromint(deleted));"privacy";"system");
  <deleted
};

f=forgetpiiqueryfail():i32{
  log.warn("forget_pii: query failed";"privacy";"system");
  <0 as i32
};

f=forgetpii(palace:i64):i32{
  mt db.query(
    palace.conn;
    "SELECT id FROM memory_scores WHERE pii_flagged=1"
  ) {
    $ok:rows forgetpiirows(palace;rows);
    $err:v forgetpiiqueryfail()
  }
};




f=shouldstore(content:str;prefs:$privacyprefs):bool{
  let lower=str.tolower(content);
  let blocked=false;
  lp(let ii265=0;ii265<prefs.optouttopics.len;ii265=ii265+1){
    let topic=prefs.optouttopics.get(ii265);
    if(str.contains(lower;str.tolower(topic))){
      let blocked=true
    }

  };
  if(blocked){
    <false
  }el{
    <true
  }
};

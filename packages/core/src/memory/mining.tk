m=core.memory.mining;




i=t:shared.types;
i=log:shared.log;
i=stor:core.memory.storage;
i=aaak:memory.aaak;
i=pal:memory.palace;
i=str:std.str;
i=file:std.file;
i=memtypes:core.memory.types;

t=$minesource{
  name:str;
  sourcetype:str;
  path:str;
  enabled:bool
};

t=$mineresult{
  source:str;
  factsextracted:i32;
  stored:i32;
  skipped:i32;
  err:str
};

f=sourceclipboard():$minesource{
  <$minesource{
    name:"clipboard";
    sourcetype:"clipboard";
    path:"";
    enabled:true
  }
};

f=sourcenotes():$minesource{
  <$minesource{
    name:"notes";
    sourcetype:"file";
    path:"~/notes.txt";
    enabled:false
  }
};




f=minetext(text:str;sourcename:str;wing:str;palace:i64;store:i64):$mineresult{
  let sentences=str.split(text;". ");
  let extracted=0;
  let storedcount=0;
  let skipped=0;
  lp(let i=0;i<str.arraylen(sentences);i=i+1){ let sentence=str.arrayget(sentences;i);
    let trimmed=str.trim(sentence);
    let length=str.len(trimmed);
    if(length > 20){
      let extracted=extracted+1;
      let encoded=aaak.encodefact(trimmed;aaak.defaultlevel());
      let id=str.randhex(16);
      let location=$palacelocation{
        wing:wing;
        hall:"Mining";
        room:"general"
      };
      let drawer=$drawer{
        id:id;
        location:location;
        role:"fact";
        content:encoded;
        sessionid:sourcename;
        modelid:"";
        tokens:length;
        sensitivity:$internal;
        createdat:""
      };
      let storeresult=mt stor.storedrawer(palace;drawer) {
        $ok:v true;
        $err:e false
      };
      if(storeresult){
        let storedcount=storedcount+1
      }el{
        log.warn(
          str.concat("mining: failed to store drawer from source: ";sourcename);
          "mining";
          "system"
        )
      }
    }el{
      let skipped=skipped+1
    }
  };
  <$mineresult{
    source:sourcename;
    factsextracted:extracted;
    stored:storedcount;
    skipped:skipped;
    err:""
  }
};



f=minefilereadfail(path:str):$mineresult{
  log.warn(
    str.concat("mining: failed to read file: ";path);
    "mining";
    "system"
  );
  <$mineresult{
    source:path;
    factsextracted:0;
    stored:0;
    skipped:0;
    err:str.concat("failed to read file: ";path)
  }
};

f=minefile(path:str;wing:str;palace:i64;store:i64):$mineresult{
  mt file.read(path) {
    $ok:text minetext(text;path;wing;palace;store);
    $err:e minefilereadfail(path)
  }
};


f=mineall(sources:@$minesource;palace:i64;store:i64):@$mineresult{
  let results=@();
  lp(let i=0;i<str.arraylen(sources);i=i+1){ let source=str.arrayget(sources;i);
    if(source.enabled){
      let result=mut.$mineresult{
              source:source.name;
              factsextracted:0;
              stored:0;
              skipped:0;
              err:str.concat("unknown source_type: ";source.sourcetype)
            };
      if(str.eq(source.sourcetype;"file")){
        result=minefile(source.path;"mining";palace;store)
      }el{
        if(str.eq(source.sourcetype;"clipboard")){
          let text=std.clipboard.read();
          result=minetext(text;source.name;"mining";palace;store)
        }el{
          if(str.eq(source.sourcetype;"text")){
            result=minetext(source.path;source.name;"mining";palace;store)
          }el{}
        }
      };
      let results=results.push(result)
    }el{

    }
  };
  <results
};


f=padright(s:str;width:u32):str{
  let len=str.len(s);
  if(len > width){
    <s
  }el{
    let diff=width-len;
    let spaces="                              ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  }
};


f=formatresults(results:@$mineresult):str{
  let header="Source                | Extracted | Stored | Skipped | Error
";
  let divider="----------------------+-----------+--------+---------+------
";
  let body="";
  lp(let i=0;i<str.arraylen(results);i=i+1){ let r=str.arrayget(results;i);
    let srccol=padright(r.source;22);
    let extcol=padright(str.fromint(r.factsextracted);11);
    let stocol=padright(str.fromint(r.stored);8);
    let skicol=padright(str.fromint(r.skipped);9);
    let line=str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(srccol;"| ");
            str.concat(extcol;"| ")
          );
          str.concat(stocol;"| ")
        );
        str.concat(skicol;"| ")
      );
      str.concat(r.err;"
")
    );
    let body=str.concat(body;line)
  };
  <str.concat(str.concat(header;divider);body)
};

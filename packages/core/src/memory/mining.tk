m=core.memory.mining;




i=t:shared.types;
i=log:shared.log;
i=stor:memory.storage;
i=aaak:memory.aaak;
i=pal:memory.palace;
i=str:std.str;
i=file:std.file;
i=memtypes:core.memory.types;

t=$minesource{
  name:str;
  sourcetype:str;
  path:str;
  enabled:bool
};

t=$mineresult{
  source:str;
  factsextracted:i32;
  stored:i32;
  skipped:i32;
  err:str
};

let sourceclipboard=$minesource{
  name:"clipboard";
  sourcetype:"clipboard";
  path:"";
  enabled:true
};

let sourcenotes=$minesource{
  name:"notes";
  sourcetype:"file";
  path:"~/notes.txt";
  enabled:false
};




f=minetext(text:str;sourcename:str;wing:str;palace:pal.$palace;store:stor.$palacedb):$mineresult{
  let sentences=str.split(text;". ");
  let extracted=0;
  let storedcount=0;
  let skipped=0;
  sentences.each|sentence{
    let trimmed=str.trim(sentence);
    let length=str.len(trimmed);
    if(length > 20){
      extracted=extracted+1;
      let encoded=aaak.encodefact(trimmed;aaak.defaultlevel());
      let id=str.randhex(16);
      let location=memtypes.$palacelocation{
        wing:wing;
        hall:"Mining";
        room:"general"
      };
      let drawer=memtypes.$drawer{
        id:id;
        location:location;
        role:"fact";
        content:encoded;
        sessionid:sourcename;
        modelid:"";
        tokens:length;
        sensitivity:$sensitivitylevel.$internal;
        createdat:""
      };
      mt stor.storedrawer(palace;drawer) {
        $ok: { storedcount=storedcount+1 };
        $err:e {
          log.warn(
            str.concat("mining: failed to store drawer from source: ";sourcename);
            "mining";
            "system"
          )
        };
      };
    }else{
      skipped=skipped+1
    };
  };
  <$mineresult{
    source:sourcename;
    factsextracted:extracted;
    stored:storedcount;
    skipped:skipped;
    err:""
  };
};



f=minefile(path:str;wing:str;palace:pal.$palace;store:stor.$palacedb):$mineresult{
  mt file.read(path) {
    $ok:text {
      <minetext(text;path;wing;palace;store)
    };
    $err:e {
      log.warn(
        str.concat("mining: failed to read file: ";path);
        "mining";
        "system"
      );
      <$mineresult{
        source:path;
        factsextracted:0;
        stored:0;
        skipped:0;
        err:str.concat("failed to read file: ";path)
      };
    };
  };
};


f=mineall(sources:@$minesource;palace:pal.$palace;store:stor.$palacedb):@$mineresult{
  let results=@();
  sources.each|source{
    if(source.enabled){
      let result=if str.eq(source.sourcetype;"file"){
        minefile(source.path;"mining";palace;store)
      }else{
        if(str.eq(source.sourcetype;"clipboard")){
          let text=std.clipboard.read();
          minetext(text;source.name;"mining";palace;store)
        }else{
          if(str.eq(source.sourcetype;"text")){
            minetext(source.path;source.name;"mining";palace;store)
          }else{
            $mineresult{
              source:source.name;
              factsextracted:0;
              stored:0;
              skipped:0;
              err:str.concat("unknown source_type: ";source.sourcetype)
            };
          };
        };
      };
      results=results.push(result)
    }else{
      
    };
  };
  <results
};


f=padright(s:str;width:u32):str{
  let len=str.len(s);
  if(len >= width){
    <s
  }else{
    let diff=width-len;
    let spaces="                              ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  };
};


f=formatresults(results:@$mineresult):str{
  let header="Source                | Extracted | Stored | Skipped | Error
";
  let divider="----------------------+-----------+--------+---------+------
";
  let body="";
  results.each|r{
    let srccol=padright(r.source;22);
    let extcol=padright(str.fromint(r.factsextracted);11);
    let stocol=padright(str.fromint(r.stored);8);
    let skicol=padright(str.fromint(r.skipped);9);
    let line=str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(srccol;"| ");
            str.concat(extcol;"| ")
          );
          str.concat(stocol;"| ")
        );
        str.concat(skicol;"| ")
      );
      str.concat(r.err;"
")
    );
    body=str.concat(body;line)
  };
  <str.concat(str.concat(header;divider);body)
};

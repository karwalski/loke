m=core.memory.mining;




i=log:shared.log;
i=stor:core.memory.storage;
i=aaak:core.memory.aaak;
i=str:std.str;
i=file:std.file;
i=clipboard:std.clipboard;
i=t:shared.types;
i=memtypes:core.memory.types;

t=$minesource{
  name:str;
  sourcetype:str;
  path:str;
  enabled:bool
};

t=$mineresult{
  source:str;
  factsextracted:i32;
  stored:i32;
  skipped:i32;
  err:str
};

f=sourceclipboard():$minesource{
  <$minesource{
    name:"clipboard";
    sourcetype:"clipboard";
    path:"";
    enabled:true
  }
};

f=sourcenotes():$minesource{
  <$minesource{
    name:"notes";
    sourcetype:"file";
    path:t.homepath("/notes.txt");
    enabled:false
  }
};




f=minetext(text:str;sourcename:str;wing:str;palace:i64;store:i64):$mineresult{
  (* All three counters were rebound with `let` inside the loop, so every one of
     them stayed 0 and $mineresult always reported nothing mined. *)
  let sentences=str.split(text;". ");
  let extracted=mut.0;
  let storedcount=mut.0;
  let skipped=mut.0;
  lp(let i=0;i<sentences.len;i=i+1){
    let trimmed=str.trim(sentences.get(i));
    let length=str.len(trimmed);
    if(length > 20){
      extracted=extracted+1;
      let encoded=aaak.encodefact(trimmed;aaak.defaultlevel());
      let id=str.randhex(16);
      let location=$palacelocation{
        wing:wing;
        hall:"Mining";
        room:"general"
      };
      let drawer=$drawer{
        id:id;
        location:location;
        role:"fact";
        content:encoded;
        sessionid:sourcename;
        modelid:"";
        tokens:length;
        sensitivity:$sensitivitylevel{$internal:0};
        createdat:""
      };
      let storeresult=mt stor.storedrawer(palace;drawer) {
        $ok:v true;
        $err:e false
      };
      if(storeresult){
        storedcount=storedcount+1
      }el{
        log.warn(
          str.concat("mining: failed to store drawer from source: ";sourcename);
          "mining";
          "system"
        )
      }
    }el{
      skipped=skipped+1
    }
  };
  <$mineresult{
    source:sourcename;
    factsextracted:extracted;
    stored:storedcount;
    skipped:skipped;
    err:""
  }
};



f=minefilereadfail(path:str):$mineresult{
  log.warn(
    str.concat("mining: failed to read file: ";path);
    "mining";
    "system"
  );
  <$mineresult{
    source:path;
    factsextracted:0;
    stored:0;
    skipped:0;
    err:str.concat("failed to read file: ";path)
  }
};

f=minefile(path:str;wing:str;palace:i64;store:i64):$mineresult{
  <mt file.read(path) {
    $ok:text minetext(text;path;wing;palace;store);
    $err:e minefilereadfail(path)
  }
};


f=mineall(sources:@$minesource;palace:i64;store:i64):@$mineresult{
  let results=mut.@();
  lp(let i=0;i<sources.len;i=i+1){
    let source:$minesource=sources.get(i);
    if(source.enabled){
      let result=mut.$mineresult{
              source:source.name;
              factsextracted:0;
              stored:0;
              skipped:0;
              err:str.concat("unknown source_type: ";source.sourcetype)
            };
      if(str.eq(source.sourcetype;"file")){
        result=minefile(source.path;"mining";palace;store)
      }el{
        if(str.eq(source.sourcetype;"clipboard")){
          let text=clipboard.read();
          result=minetext(text;source.name;"mining";palace;store)
        }el{
          if(str.eq(source.sourcetype;"text")){
            result=minetext(source.path;source.name;"mining";palace;store)
          }el{}
        }
      };
      results=results.push(result)
    }el{}
  };
  <results
};




f=formatresults(results:@$mineresult):str{
  let header="Source                | Extracted | Stored | Skipped | Error
";
  let divider="----------------------+-----------+--------+---------+------
";
  let rows=mut.@();
  lp(let i=0;i<results.len;i=i+1){
    let r:$mineresult=results.get(i);
    rows=rows.push("\(t.strpad(r.source;22))| \(t.strpad(str.fromint(r.factsextracted);11))| \(t.strpad(str.fromint(r.stored);8))| \(t.strpad(str.fromint(r.skipped);9))| \(r.err)
")
  };
  <"\(header)\(divider)\(str.join("";rows))"
};

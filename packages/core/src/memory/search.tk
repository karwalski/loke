m=core.memory.search;



i=t:shared.types;
i=memtypes:core.memory.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;


f=stopwords():@str{
  <@(
    "the";"a";"an";"and";"or";"but";"in";"on";"at";"to";"for";"of";"with";"by";
    "is";"was";"are";"be";"been";"have";"has";"had";"do";"does";"did";"will";
    "would";"could";"should";"may";"might";"not";"no";"it";"its";"this";"that";
    "i";"you";"we";"they";"he";"she"
  )
};


f=isstopword(word:str):bool{
  let stops=stopwords();
  let found=false;
  lp(let i=0;i<str.arraylen(stops);i=i+1){ let sw=str.arrayget(stops;i);
    if(str.eq(sw;word)){
      let found=true
    }
  };
  <found
};


f=extractkeywords(text:str):@str{
  let words=str.split(str.tolower(text);" ");
  let keywords=@();
  lp(let i=0;i<str.arraylen(words);i=i+1){ let w=str.arrayget(words;i);
    let longenough=str.len(w) > 3;
    let notstop=!$isstopword(w);
    if(longenough && notstop){ keywords=keywords.append(w) }el{}
  };
  <keywords
};



f=indexdrawer(palace:i64;drawer:i64):void!$lokeerr{
  let keywords=extractkeywords(drawer.content);
  lp(let i=0;i<str.arraylen(keywords);i=i+1){ let kw=str.arrayget(keywords;i);
    mt db.execparams(
      palace.conn;
      "INSERT OR REPLACE INTO memory_index (drawer_id, keyword, weight) VALUES (?, ?, 1.0)";
      @(drawer.id;kw)
    ) {
      $ok: {};
      $err:e {
        log.warn(str.concat("failed to index keyword: ";kw);"search";"system")
      }
    }
  };
  <$ok(void)
};


f=search(palace:i64;query:str;limit:u32):@($searchresult)!$lokeerr{
  let keywords=extractkeywords(query);
  if(keywords.len = 0){
    <$ok(@())
  }el{
    
    let scored=@();
    lp(let ki=0;ki<str.arraylen(keywords);ki=ki+1){ let kw=str.arrayget(keywords;ki);
      let likekw=str.concat(kw;"%");
      mt db.queryparams(
        palace.conn;
        "SELECT drawer_id, SUM(weight) as score FROM memory_index WHERE keyword LIKE ? GROUP BY drawer_id";
        @($likekw)
      ) {
        $ok:rows {
          lp(let ri=0;ri<str.arraylen(rows);ri=ri+1){ let row=str.arrayget(rows;ri);
            let did=json.getstr(row;"drawer_id");
            let sc=json.getfloat(row;"score");

            let found=false;
            lp(let ei=0;ei<str.arraylen(scored);ei=ei+1){ let entry=str.arrayget(scored;ei);
              if(str.eq(entry.drawerid;did)){
                let entry.score=entry.score + sc;
                let found=true
              }
            };
            if(!$found){
              let scored=scored.append($searchscore{drawerid:did;score:sc})
            }
          }
        };
        $err: {}
      }
    };


    let sorted=scored.sortbydesc|entry{ entry.score };
    let limits=str.fromint(limit);
    let top=sorted.take(limit);


    let results=@();
    lp(let ti=0;ti<str.arraylen(top);ti=ti+1){ let entry=str.arrayget(top;ti);
      mt db.queryparams(
        palace.conn;
        "SELECT id,wing,hall,room,content,created_at FROM memory_drawers WHERE id=?";
        @(entry.drawerid)
      ) {
        $ok:rows {
          if(rows.len > 0){
            let row=rows.get(0);
            let content=json.getstr(row;"content");
            let excerpt=if(str.len(content) > 200){
              str.slice(content;0;200)
            }el{
              content
            };
            let result=$searchresult{
              drawerid:json.getstr(row;"id");
              location:i64{
                wing:json.getstr(row;"wing");
                hall:json.getstr(row;"hall");
                room:json.getstr(row;"room")
              };
              contentexcerpt:excerpt;
              relevancescore:entry.score;
              createdat:json.getstr(row;"created_at")
            };
            let results=results.append(result)
          }
        };
        $err: {}
      }
    };
    <$ok(results)
  }
};


f=searchinwing(palace:i64;query:str;wing:str;limit:u32):@($searchresult)!$lokeerr{
  let keywords=extractkeywords(query);
  if(keywords.len = 0){
    <$ok(@())
  }el{
    let scored=@();
    lp(let ki=0;ki<str.arraylen(keywords);ki=ki+1){ let kw=str.arrayget(keywords;ki);
      let likekw=str.concat(kw;"%");
      mt db.queryparams(
        palace.conn;
        "SELECT mi.drawer_id, SUM(mi.weight) as score FROM memory_index mi JOIN memory_drawers md ON mi.drawer_id=md.id WHERE mi.keyword LIKE ? AND md.wing=? GROUP BY mi.drawer_id";
        @(likekw;wing)
      ) {
        $ok:rows {
          lp(let ri=0;ri<str.arraylen(rows);ri=ri+1){ let row=str.arrayget(rows;ri);
            let did=json.getstr(row;"drawer_id");
            let sc=json.getfloat(row;"score");
            let found=false;
            lp(let ei=0;ei<str.arraylen(scored);ei=ei+1){ let entry=str.arrayget(scored;ei);
              if(str.eq(entry.drawerid;did)){
                let entry.score=entry.score + sc;
                let found=true
              }
            };
            if(!$found){
              let scored=scored.append($searchscore{drawerid:did;score:sc})
            }
          }
        };
        $err: {}
      }
    };

    let sorted=scored.sortbydesc|entry{ entry.score };
    let top=sorted.take(limit);

    let results=@();
    lp(let ti=0;ti<str.arraylen(top);ti=ti+1){ let entry=str.arrayget(top;ti);
      mt db.queryparams(
        palace.conn;
        "SELECT id,wing,hall,room,content,created_at FROM memory_drawers WHERE id=?";
        @(entry.drawerid)
      ) {
        $ok:rows {
          if(rows.len > 0){
            let row=rows.get(0);
            let content=json.getstr(row;"content");
            let excerpt=if(str.len(content) > 200){
              str.slice(content;0;200)
            }el{
              content
            };
            let result=$searchresult{
              drawerid:json.getstr(row;"id");
              location:i64{
                wing:json.getstr(row;"wing");
                hall:json.getstr(row;"hall");
                room:json.getstr(row;"room")
              };
              contentexcerpt:excerpt;
              relevancescore:entry.score;
              createdat:json.getstr(row;"created_at")
            };
            let results=results.append(result)
          }
        };
        $err: {}
      }
    };
    <$ok(results)
  }
};

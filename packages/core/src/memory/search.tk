m=core.memory.search;



i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=memtypes:core.memory.types;


(* Declared i64!$lokeerr, not void!$lokeerr, and returns $ok(0).

   toke lowers a `void!$err` success type to LLVM `void`, so any call site that binds
   the result — a match arm, for instance — emits `alloca void` and clang rejects the
   module with "void type only allowed for function results". Filed as T-5 in
   docs/upstream/toke-issues.md, same family as T-1 ($ok(<bool>)): only an i64-width
   success type survives the `!$err` lowering today. *)
f=stopwords():@str{
  <@(
    "the";"a";"an";"and";"or";"but";"in";"on";"at";"to";"for";"of";"with";"by";
    "is";"was";"are";"be";"been";"have";"has";"had";"do";"does";"did";"will";
    "would";"could";"should";"may";"might";"not";"no";"it";"its";"this";"that";
    "i";"you";"we";"they";"he";"she"
  )
};


f=isstopword(word:str):bool{
  let stops=stopwords();
  let found=mut.false;
  lp(let i=0;i<str.arraylen(stops);i=i+1){ let sw=stops.get(i);
    if(str.eq(sw;word)){
      found=true
    }
  };
  <found
};


f=extractkeywords(text:str):@str{
  let words=str.split(str.tolower(text);" ");
  let keywords=mut.@();
  lp(let i=0;i<str.arraylen(words);i=i+1){ let w=words.get(i);
    let longenough=str.len(w) > 3;
    let notstop=!isstopword(w);
    if(longenough && notstop){ keywords=keywords.append(w) }el{}
  };
  <keywords
};



(* MK6.6. search reads memory_index and nothing wrote it, so a memory stored through any path
   could never be found by memory.search, memory.facts or a context's L2 and L3 layers. The
   old `indexdrawer` was never called; it read `.content` and `.id` off an i64 and returned
   from inside its loop after the first keyword. storage.storedrawertx now calls this inside
   the drawer's transaction, so a drawer and its keywords are written together. The keyword
   itself is not logged: it is a word of the memory's content. *)
f=indexkeywords(drawerid:str;content:str):bool{
  let keywords=extractkeywords(content);
  let ok=mut.true;
  lp(let i=0;i<keywords.len;i=i+1){
    let kw:str=keywords.get(i);
    let wrote=mt db.exec("INSERT OR REPLACE INTO memory_index (drawer_id, keyword, weight) VALUES (?, ?, 1.0)";@(drawerid;kw)) {
      $ok:v true;
      $err:e false
    };
    if(!wrote){ ok=false }el{}
  };
  if(!ok){ log.warn("memory index: a keyword insert failed";"search";"system") }el{};
  <ok
};


f=firstn(scores:@$searchscore;n:i64):@$searchscore{
  let out=mut.@();
  lp(let i=0;i<scores.len;i=i+1){
    if(i<n){
      out=out.push(scores.get(i))
    }el{}
  };
  <out
};

(* Returns the extended list, the same way searchaccumulatescores does. It used to
   take `results` as an i64, append with `let results=results.append(result)` — a new
   branch-local binding — and return void, so every search returned no results at
   all however many drawers matched. *)
f=searchbuildsingleresult(rows:@$row;entry:$searchscore;results:@$searchresult):@$searchresult{
  if(rows.len > 0){
    let row=rows.get(0);
    let content=db.rowstr(row;"content");
    let excerpt=mut.content;
    if(str.len(content) > 200){
      excerpt=str.slice(content;0;200)
    }el{};
    <results.push($searchresult{
      drawerid:db.rowstr(row;"id");
      location:$palacelocation{
        wing:db.rowstr(row;"wing");
        hall:db.rowstr(row;"hall");
        room:db.rowstr(row;"room")
      };
      contentexcerpt:excerpt;
      relevancescore:entry.score;
      createdat:db.rowstr(row;"created_at")
    })
  }el{
    <results
  }
};
f=searchaccumulatescores(rows:@$row;scored:@$searchscore):@$searchscore{
  (* Returns the updated list. The old body tried to mutate the caller's array and to
     mutate an element in place — entry.score==entry.score+scr and a bare
     scored.append(...) — neither of which does anything in a value-semantics language.
     So multi-keyword relevance never accumulated. LS1.1a. *)
  let out=mut.scored;
  lp(let ri=0;ri<rows.len;ri=ri+1){
    let row=rows.get(ri);
    let did=db.rowstr(row;"drawer_id");
    let scr=db.rowi64(row;"score") as f64;
    let merged=mut.@($searchscore);
    let found=mut.false;
    lp(let ei=0;ei<out.len;ei=ei+1){
      let entry=out.get(ei);
      if(str.eq(entry.drawerid;did)){
        found=true;
        merged=merged.push($searchscore{drawerid:entry.drawerid;score:entry.score+scr})
      }el{
        merged=merged.push(entry)
      }
    };
    if(found){
      out=merged
    }el{
      out=out.push($searchscore{drawerid:did;score:scr})
    }
  };
  <out
};

f=search(palace:i64;query:str;limit:u32):@($searchresult)!$lokeerr{
  let keywords=extractkeywords(query);
  if(keywords.len == 0){
    <$ok(@())
  }el{
    
    let scored=mut.@($searchscore);
    lp(let ki=0;ki<str.arraylen(keywords);ki=ki+1){ let kw=keywords.get(ki);
      let likekw=str.concat(kw;"%");
      scored=mt db.many("SELECT drawer_id, SUM(weight) as score FROM memory_index WHERE keyword LIKE ? GROUP BY drawer_id";@(likekw)) {
        $ok:rows searchaccumulatescores(rows;scored);
        $err:v scored
      }
    };


    (* `.take(n)` is not a toke array method — it emitted a call to an undefined
       `_take` and the only error was "Undefined symbols" at link time (T-7).
       str.arrayslice clamps to the array length, so a limit above it is safe. *)
    let top=firstn(scored;limit as i64);


    let results=mut.@();
    lp(let ti=0;ti<top.len;ti=ti+1){
      let entry:$searchscore=top.get(ti);
      results=mt db.many("SELECT id,wing,hall,room,content,created_at FROM memory_drawers WHERE id=?";@(entry.drawerid)) {
        $ok:rows searchbuildsingleresult(rows;entry;results);
        $err:v results
      }
    };
    <$ok(results)
  }
};


f=searchinwing(palace:i64;query:str;wing:str;limit:u32):@($searchresult)!$lokeerr{
  let keywords=extractkeywords(query);
  if(keywords.len == 0){
    <$ok(@())
  }el{
    let scored=mut.@($searchscore);
    lp(let ki=0;ki<str.arraylen(keywords);ki=ki+1){ let kw=keywords.get(ki);
      let likekw=str.concat(kw;"%");
      scored=mt db.many("SELECT mi.drawer_id, SUM(mi.weight) as score FROM memory_index mi JOIN memory_drawers md ON mi.drawer_id=md.id WHERE mi.keyword LIKE ? AND md.wing=? GROUP BY mi.drawer_id";@(likekw;wing)) {
        $ok:rows searchaccumulatescores(rows;scored);
        $err:v scored
      }
    };

    let top=firstn(scored;limit as i64);

    let results=mut.@();
    lp(let ti=0;ti<top.len;ti=ti+1){
      let entry:$searchscore=top.get(ti);
      results=mt db.many("SELECT id,wing,hall,room,content,created_at FROM memory_drawers WHERE id=?";@(entry.drawerid)) {
        $ok:rows searchbuildsingleresult(rows;entry;results);
        $err:v results
      }
    };
    <$ok(results)
  }
};

m=core.memory.search;



i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=t:shared.types;
i=memtypes:core.memory.types;


f=stopwords():@str{
  <@(
    "the";"a";"an";"and";"or";"but";"in";"on";"at";"to";"for";"of";"with";"by";
    "is";"was";"are";"be";"been";"have";"has";"had";"do";"does";"did";"will";
    "would";"could";"should";"may";"might";"not";"no";"it";"its";"this";"that";
    "i";"you";"we";"they";"he";"she"
  )
};


f=isstopword(word:str):bool{
  let stops=stopwords();
  let found=mut.false;
  lp(let i=0;i<str.arraylen(stops);i=i+1){ let sw=str.arrayget(stops;i);
    if(str.eq(sw;word)){
      found=true
    }
  };
  <found
};


f=extractkeywords(text:str):@str{
  let words=str.split(str.tolower(text);" ");
  let keywords=mut.@();
  lp(let i=0;i<str.arraylen(words);i=i+1){ let w=str.arrayget(words;i);
    let longenough=str.len(w) > 3;
    let notstop=!$isstopword(w);
    if(longenough && notstop){ keywords=keywords.append(w) }el{}
  };
  <keywords
};



f=indexdrawer(palace:i64;drawer:i64):void!$lokeerr{
  let keywords=extractkeywords(drawer.content);
  lp(let i=0;i<str.arraylen(keywords);i=i+1){ let kw=str.arrayget(keywords;i);
    mt db.exec("INSERT OR REPLACE INTO memory_index (drawer_id, keyword, weight) VALUES (?, ?, 1.0)";@(drawer.id;kw)) {
      $ok:v void;
      $err:e log.warn(str.concat("failed to index keyword: ";kw);"search";"system")
    }
  };
  <$ok(void)
};


f=searchbuildsingleresult(rows:@$row;entry:$searchscore;results:i64):void{
  if(rows.len > 0){
    let row=rows.get(0);
    let content=db.rowstr(row;"content");
    let excerpt=mut.content;
    if(str.len(content) > 200){
      excerpt=str.slice(content;0;200)
    }el{};
    let result=$searchresult{
      drawerid:db.rowstr(row;"id");
      location:$drawerlocation{
        wing:db.rowstr(row;"wing");
        hall:db.rowstr(row;"hall");
        room:db.rowstr(row;"room")
      };
      contentexcerpt:excerpt;
      relevancescore:entry.score;
      createdat:db.rowstr(row;"created_at")
    };
    let results=results.append(result)
  }
};

f=searchaccumulatescores(rows:@$row;scored:@$searchscore):@$searchscore{
  (* Returns the updated list. The old body tried to mutate the caller's array and to
     mutate an element in place — entry.score==entry.score+scr and a bare
     scored.append(...) — neither of which does anything in a value-semantics language.
     So multi-keyword relevance never accumulated. LS1.1a. *)
  let out=mut.scored;
  lp(let ri=0;ri<rows.len;ri=ri+1){
    let row=rows.get(ri);
    let did=db.rowstr(row;"drawer_id");
    let scr=db.rowi64(row;"score") as f64;
    let merged=mut.@($searchscore);
    let found=mut.false;
    lp(let ei=0;ei<out.len;ei=ei+1){
      let entry=out.get(ei);
      if(str.eq(entry.drawerid;did)){
        found=true;
        merged=merged.push($searchscore{drawerid:entry.drawerid;score:entry.score+scr})
      }el{
        merged=merged.push(entry)
      }
    };
    if(found){
      out=merged
    }el{
      out=out.push($searchscore{drawerid:did;score:scr})
    }
  };
  <out
};

f=search(palace:i64;query:str;limit:u32):@($searchresult)!$lokeerr{
  let keywords=extractkeywords(query);
  if(keywords.len == 0){
    <$ok(@())
  }el{
    
    let scored=mut.@($searchscore);
    lp(let ki=0;ki<str.arraylen(keywords);ki=ki+1){ let kw=str.arrayget(keywords;ki);
      let likekw=str.concat(kw;"%");
      scored=mt db.many("SELECT drawer_id, SUM(weight) as score FROM memory_index WHERE keyword LIKE ? GROUP BY drawer_id";@($likekw)) {
        $ok:rows searchaccumulatescores(rows;scored);
        $err:v scored
      }
    };


    let sorted=scored;
    let limits=str.fromint(limit);
    let top=sorted.take(limit);


    let results=@();
    lp(let ti=0;ti<str.arraylen(top);ti=ti+1){ let entry=top.get(ti);
      mt db.many("SELECT id,wing,hall,room,content,created_at FROM memory_drawers WHERE id=?";@(entry.drawerid)) {
        $ok:rows searchbuildsingleresult(rows;entry;results);
        $err:v void
      }
    };
    <$ok(results)
  }
};


f=searchinwing(palace:i64;query:str;wing:str;limit:u32):@($searchresult)!$lokeerr{
  let keywords=extractkeywords(query);
  if(keywords.len == 0){
    <$ok(@())
  }el{
    let scored=mut.@($searchscore);
    lp(let ki=0;ki<str.arraylen(keywords);ki=ki+1){ let kw=str.arrayget(keywords;ki);
      let likekw=str.concat(kw;"%");
      scored=mt db.many("SELECT mi.drawer_id, SUM(mi.weight) as score FROM memory_index mi JOIN memory_drawers md ON mi.drawer_id=md.id WHERE mi.keyword LIKE ? AND md.wing=? GROUP BY mi.drawer_id";@(likekw;wing)) {
        $ok:rows searchaccumulatescores(rows;scored);
        $err:v scored
      }
    };

    let top=scored.take(limit);

    let results=@();
    lp(let ti=0;ti<str.arraylen(top);ti=ti+1){ let entry=top.get(ti);
      mt db.many("SELECT id,wing,hall,room,content,created_at FROM memory_drawers WHERE id=?";@(entry.drawerid)) {
        $ok:rows searchbuildsingleresult(rows;entry;results);
        $err:v void
      }
    };
    <$ok(results)
  }
};

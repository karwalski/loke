m=core.memory.types;


i=t:shared.types;

t=$palacelocation{
  wing:str;
  hall:str;
  room:str
};

t=$drawer{
  id:str;
  location:$palacelocation;
  role:str;
  content:str;
  sessionid:str;
  modelid:str;
  tokens:u32;
  sensitivity:$sensitivitylevel;
  createdat:str
};

t=$closet{
  id:str;
  location:$palacelocation;
  aaaksummary:str;
  drawerids:@str;
  createdat:str
};

t=$wing{
  name:str;
  description:str;
  hallnames:@str
};

t=$palacestatus{
  totaldrawers:u32;
  totalclosets:u32;
  totalwings:u32;
  storagebytes:u32
};

t=$searchresult{
  drawerid:str;
  location:$palacelocation;
  contentexcerpt:str;
  relevancescore:f64;
  createdat:str
};


f=defaultwings():@$wing{
  <@(
    $wing{
      name:"work";
      description:"Work-related conversations and tasks";
      hallnames:@("Projects";"Tasks";"Decisions";"Meetings")
    };
    $wing{
      name:"personal";
      description:"Personal goals, learnings, and preferences";
      hallnames:@("Goals";"Learnings";"Contacts";"Preferences")
    };
    $wing{
      name:"technical";
      description:"Technical discussions: code, architecture, research";
      hallnames:@("Code";"Architecture";"Bugs";"Research")
    };
    $wing{
      name:"agent-diaries";
      description:"Per-agent diary halls — one hall per agent";
      hallnames:@()
    }
  )
};


f=locationkey(loc:$palacelocation):str{
  let wh=str.concat(loc.wing;"/");
  let whl=str.concat(wh;loc.hall);
  let whlr=str.concat(whl;"/");
  <str.concat(whlr;loc.room)
};

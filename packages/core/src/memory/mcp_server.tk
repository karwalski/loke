m=core.memory.mcpserver;




i=proto:core.mcp.protocol;
i=palace:core.memory.palace;
i=stor:core.memory.storage;
i=search:core.memory.search;
i=aaak:core.memory.aaak;
i=context:core.memory.context;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=memtypes:core.memory.types;




f=memorytools():@($mcptool){
  <@(
    $mcptool{
      name:"memory.search";
      description:"Search your memory palace for relevant past conversations and facts";
      inputschema:"{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"wing\":{\"type\":\"string\"}},\"required\":[\"query\",\"limit\"]}"
    };
    $mcptool{
      name:"memory.store";
      description:"Store a fact or note in your memory palace";
      inputschema:"{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"role\":{\"type\":\"string\"},\"wing\":{\"type\":\"string\"}},\"required\":[\"content\",\"role\"]}"
    };
    $mcptool{
      name:"memory.context";
      description:"Load relevant memory context for the current task";
      inputschema:"{\"type\":\"object\",\"properties\":{\"task\":{\"type\":\"string\"},\"token_budget\":{\"type\":\"integer\"}},\"required\":[\"task\",\"token_budget\"]}"
    };
    $mcptool{
      name:"memory.status";
      description:"Get memory palace statistics";
      inputschema:"{\"type\":\"object\",\"properties\":{}}"
    };
    $mcptool{
      name:"memory.facts";
      description:"Search for specific facts or decisions in memory";
      inputschema:"{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}"
    };
    $mcptool{
      name:"memory.diary_write";
      description:"Write an entry to the agent diary";
      inputschema:"{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"entry\":{\"type\":\"string\"}},\"required\":[\"agent_id\",\"entry\"]}"
    }
  )
};




(* Three defects in one loop, and they compiled: `let i=0` then `let i=i+1` inside
   the body declared a new binding each pass so the counter never advanced — an
   infinite loop, not a slow one; `let items=entry` inside the if-branch shadowed
   rather than assigned, so the JSON array was always empty; and the escaping was a
   single str.replace on double quotes, which leaves backslashes and newlines to
   break the payload. json.enc does the escaping properly.

   The branch-local `let items` was also what made clang reject the linked IR with
   "Instruction does not dominate all uses": toke allocated items inside the branch
   and loaded it after the branch closed. *)
f=handlesearchresults(rs:@$searchresult):$toolresult{
  let items=mut.@();
  lp(let i=0;i<rs.len;i=i+1){
    let r:$searchresult=rs.get(i);
    let loc:$palacelocation=r.location;
    let where="\(loc.wing)/\(loc.hall)/\(loc.room)";
    items=items.push("{\"drawer_id\":\(json.enc(r.drawerid)),\"location\":\(json.enc(where)),\"excerpt\":\(json.enc(r.contentexcerpt)),\"score\":\(r.relevancescore)}")
  };
  <$toolresult{contenttype:"text";text:"[\(str.join(",";items))]";iserror:false}
};


(* ── MK6.6: why memory.store, memory.status and memory.context killed their caller ──────────
   Measured with one program per tool against this module, then through moke's
   POST /api/mcp/memory. Three faults, none of them in the tools' logic:

   1. memory.store passed a bare `$public` as the sensitivity. A bare variant in a value
      position is not a value (T-13): storage.storedrawer matches on it and the process took
      SIGSEGV on every call, whatever the palace held.
   2. handlememorytool matched palace.open's `$palace!$lokeerr`, which always takes the first
      arm (T-18). When the database did not open -- moke's data directory did not exist under a
      fresh HOME -- the success arm ran with the ERROR bound as the palace. memory.status then
      matched palace.status the same way and read three fields off the next error payload, and
      memory.context walked the palace through a third (context.loadl1 on pal.walk). Both died.
      memory.search and memory.facts happened to read that garbage as an empty result, and
      memory.diary_write answered `{"ok":true}` for a drawer that was never written.
   3. Every argument was bound straight from `json.str`/`json.i64`, which return results.
      A present string happens to read through (T-33); a missing one is a null `str`.

   So the palace is opened through palace.openok, a bool; each write goes through
   storage.writedrawer, a bool; the status is palace.statusjson, formatted where it was
   counted; and every argument is read through a match with `$ok` first (T-31). A search is
   read through search.succeeded (MK6.8): it was a match on `@($searchresult)!$lokeerr` whose
   `$err` arm could not run (T-18), and search itself mapped a failed query to "no results",
   so memory.search and memory.facts answered `[]` for a palace they could not read. *)

f=strarg(obj:$json;key:str):str{
  <mt json.str(obj;key) {
    $ok:v v;
    $jsonerr:e ""
  }
};

(* A zero reads as an error from a std result (T-33), so 0 and "absent" both take the default.
   Neither is a useful limit or budget. *)
f=intarg(obj:$json;key:str;fallback:i64):i64{
  <mt json.i64(obj;key) {
    $ok:v v;
    $jsonerr:e fallback
  }
};

f=argerr(msg:str):$toolresult{
  <$toolresult{contenttype:"text";text:proto.toolresulterr(msg);iserror:true}
};

f=badargs():$toolresult{
  <argerr("invalid args JSON")
};


f=handlesearchfail():$toolresult{
  log.warn("memory.search failed";"mcp_server";"system");
  <argerr("search failed")
};

f=handlesearchobj(obj:$json):$toolresult{
  let query=strarg(obj;"query");
  let limit=intarg(obj;"limit";5) as u32;
  let wing=strarg(obj;"wing");
  if(str.len(query) == 0){ <argerr("query is required") }el{};
  let results=mut.$searchfound{results:@();failure:"not searched"};
  if(str.len(wing) > 0){
    results=search.searchinwing(0;query;wing;limit)
  }el{
    results=search.search(0;query;limit)
  };
  if(search.succeeded(results)){
    <handlesearchresults(results.results)
  }el{
    <handlesearchfail()
  }
};

f=handlesearch(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj handlesearchobj(obj);
    $jsonerr:e badargs()
  }
};


f=handlestorefail():$toolresult{
  log.warn("memory.store failed";"mcp_server";"system");
  <argerr("store failed")
};

(* The drawer id reported is the one written. It used to be a second str.randhex, unrelated to
   the drawer, so no id this tool ever returned named anything in the palace. *)
f=handlestoreobj(obj:$json):$toolresult{
  let content=strarg(obj;"content");
  let role=strarg(obj;"role");
  if(str.len(content) == 0){ <argerr("content is required") }el{};
  if(str.len(role) == 0){ <argerr("role is required") }el{};
  let drawer=stor.turndrawer(role;content;"manual";"user";0 as u32;$sensitivitylevel{$public:0});
  if(stor.writedrawer(drawer)){
    <$toolresult{contenttype:"text";text:"{\"ok\":true,\"drawer_id\":\(json.enc(drawer.id))}";iserror:false}
  }el{
    <handlestorefail()
  }
};

f=handlestore(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj handlestoreobj(obj);
    $jsonerr:e badargs()
  }
};


(* json.enc, not a replace of double quotes: the context is several lines, and a raw newline
   inside a JSON string made every answer this tool gave unparseable. *)
f=handlecontextobj(obj:$json):$toolresult{
  let task=strarg(obj;"task");
  let tokenbudget=intarg(obj;"token_budget";2000) as u32;
  let ctx=context.loadcontext(0;task;"user";tokenbudget);
  let ctxstr=context.tocontextstring(ctx);
  let tokens=ctx.totaltokensestimate as i64;
  <$toolresult{contenttype:"text";text:"{\"context\":\(json.enc(ctxstr)),\"tokens_estimate\":\(tokens)}";iserror:false}
};

f=handlecontext(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj handlecontextobj(obj);
    $jsonerr:e badargs()
  }
};


f=handlestatus():$toolresult{
  let status=palace.statusjson();
  if(str.len(status) == 0){
    log.warn("memory.status failed";"mcp_server";"system");
    <argerr("status query failed")
  }el{};
  <$toolresult{contenttype:"text";text:status;iserror:false}
};


(* Same three defects as handlesearchresults: a counter rebound with `let` so it
   never advanced, an accumulator rebound inside the if-branch so it stayed empty,
   and hand-rolled quote escaping. *)
f=handlefactsresults(rs:@$searchresult):$toolresult{
  let level=aaak.defaultlevel();
  let parts=mut.@();
  lp(let i=0;i<rs.len;i=i+1){
    let r:$searchresult=rs.get(i);
    let loc:$palacelocation=r.location;
    parts=parts.push("[\(loc.wing)/\(loc.hall)] \(aaak.encodefact(r.contentexcerpt;level))")
  };
  let facts=str.join(" | ";parts);
  <$toolresult{contenttype:"text";text:"{\"facts\":\(json.enc(facts))}";iserror:false}
};

f=handlefactsfail():$toolresult{
  log.warn("memory.facts search failed";"mcp_server";"system");
  <argerr("facts search failed")
};

f=handlefactsobj(obj:$json):$toolresult{
  let query=strarg(obj;"query");
  if(str.len(query) == 0){ <argerr("query is required") }el{};
  let results=search.search(0;query;5);
  if(search.succeeded(results)){
    <handlefactsresults(results.results)
  }el{
    <handlefactsfail()
  }
};

f=handlefacts(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj handlefactsobj(obj);
    $jsonerr:e badargs()
  }
};


f=handlediarywritefail():$toolresult{
  log.warn("memory.diary_write failed";"mcp_server";"system");
  <argerr("diary write failed")
};

f=handlediarywriteobj(obj:$json):$toolresult{
  let agentid=strarg(obj;"agent_id");
  let entry=strarg(obj;"entry");
  if(str.len(agentid) == 0){ <argerr("agent_id is required") }el{};
  if(str.len(entry) == 0){ <argerr("entry is required") }el{};
  let location=$palacelocation{wing:"agent-diaries";hall:agentid;room:"diary"};
  let drawerid=str.randhex(16);
  let drawer=$drawer{
    id:drawerid;
    location:location;
    role:"agent";
    content:entry;
    sessionid:"diary";
    modelid:agentid;
    tokens:0;
    sensitivity:$sensitivitylevel{$internal:0};
    createdat:""
  };
  if(stor.writedrawer(drawer)){
    <$toolresult{contenttype:"text";text:"{\"ok\":true}";iserror:false}
  }el{
    <handlediarywritefail()
  }
};

f=handlediarywrite(argsjson:str):$toolresult{
  <mt json.dec(argsjson) {
    $ok:obj handlediarywriteobj(obj);
    $jsonerr:e badargs()
  }
};




f=unknownmemorytool(name:str):$toolresult{
  let msg=str.concat("unknown memory tool: ";name);
  log.warn(msg;"mcp_server";"system");
  <argerr(msg)
};

f=dispatchmemorytool(name:str;argsjson:str):$toolresult{
  if(str.eq(name;"memory.search")){ <handlesearch(argsjson) }el{};
  if(str.eq(name;"memory.store")){ <handlestore(argsjson) }el{};
  if(str.eq(name;"memory.context")){ <handlecontext(argsjson) }el{};
  if(str.eq(name;"memory.status")){ <handlestatus() }el{};
  if(str.eq(name;"memory.facts")){ <handlefacts(argsjson) }el{};
  if(str.eq(name;"memory.diary_write")){ <handlediarywrite(argsjson) }el{};
  <unknownmemorytool(name)
};

f=memorytoolopenfail(datadir:str):$toolresult{
  let msg=str.concat("failed to open memory palace at: ";datadir);
  log.warn(msg;"mcp_server";"system");
  <argerr(msg)
};

(* The storage, search and context functions take a palace handle and never read it: std.db has
   one process-wide connection (T-30), which openok has just pointed at the palace. So 0 is
   passed for it, as the memory tests do. *)
f=handlememorytool(name:str;argsjson:str;datadir:str):$toolresult{
  if(palace.openok(datadir)){
    <dispatchmemorytool(name;argsjson)
  }el{
    <memorytoolopenfail(datadir)
  }
};

m=core.memory.mcpserver;




i=t:shared.types;
i=proto:core.mcp.protocol;
i=memtypes:core.memory.types;
i=palace:core.memory.palace;
i=stor:core.memory.storage;
i=search:core.memory.search;
i=aaak:core.memory.aaak;
i=context:core.memory.context;
i=json:std.json;
i=str:std.str;
i=log:shared.log;




f=memorytools():@($mcptool){
  <@(
    $mcptool{
      name:"memory.search";
      description:"Search your memory palace for relevant past conversations and facts";
      inputschema:"{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"wing\":{\"type\":\"string\"}},\"required\":[\"query\",\"limit\"]}"
    };
    $mcptool{
      name:"memory.store";
      description:"Store a fact or note in your memory palace";
      inputschema:"{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"role\":{\"type\":\"string\"},\"wing\":{\"type\":\"string\"}},\"required\":[\"content\",\"role\"]}"
    };
    $mcptool{
      name:"memory.context";
      description:"Load relevant memory context for the current task";
      inputschema:"{\"type\":\"object\",\"properties\":{\"task\":{\"type\":\"string\"},\"token_budget\":{\"type\":\"integer\"}},\"required\":[\"task\",\"token_budget\"]}"
    };
    $mcptool{
      name:"memory.status";
      description:"Get memory palace statistics";
      inputschema:"{\"type\":\"object\",\"properties\":{}}"
    };
    $mcptool{
      name:"memory.facts";
      description:"Search for specific facts or decisions in memory";
      inputschema:"{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}"
    };
    $mcptool{
      name:"memory.diary_write";
      description:"Write an entry to the agent diary";
      inputschema:"{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"entry\":{\"type\":\"string\"}},\"required\":[\"agent_id\",\"entry\"]}"
    }
  )
};




f=handlesearchresults(rs:i64):i64{
  let count=str.arraylen(rs);
  let items="";
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      br
    }el{
      let r=str.arrayget(rs;i);
      let loc=str.concat(r.location.wing;str.concat("/";str.concat(r.location.hall;str.concat("/";r.location.room))));
      let scores=str.fromfloat(r.relevancescore);
      let excerptescaped=str.replace(r.contentexcerpt;"\"";"\\\"");
      let entry=str.concat(
        "{\"drawer_id\":\"";str.concat(
        r.drawerid;str.concat(
        "\",\"location\":\"";str.concat(
        loc;str.concat(
        "\",\"excerpt\":\"";str.concat(
        excerptescaped;str.concat(
        "\",\"score\":";str.concat(
        scores;"}"
      )))))))
      );
      if(i = 0){
        let items=entry
      }el{
        let items=str.concat(items;str.concat(",";entry))
      };
      let i=i+1;
    }
  };
  let resultjson=str.concat("[";str.concat(items;"]"));
  <$toolresult{contenttype:"text";text:resultjson;iserror:false}
};

f=handlesearchfail():i64{
  log.warn("memory.search failed";"mcp_server";"system");
  <$toolresult{contenttype:"text";text:proto.toolresulterr("search failed");iserror:true}
};

f=handlesearchobj(p:i64;obj:i64):i64{
  let query=json.getstr(obj;"query");
  let limit=json.getint(obj;"limit");
  let wing=json.getstr(obj;"wing");
  let results=mut.search.search(p;query;limit);
  if(str.len(wing) > 0){
    results=search.searchinwing(p;query;wing;limit)
  }el{};
  mt results {
    $ok:rs handlesearchresults(rs);
    $err:e handlesearchfail()
  }
};

f=handlesearch(p:i64;argsjson:str):i64{
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr:e $toolresult{contenttype:"text";text:proto.toolresulterr("invalid args JSON");iserror:true};
    $ok:obj handlesearchobj(p;obj)
  }
};


f=handlestoreok():i64{
  let drawerid=str.randhex(16);
  let result=str.concat("{\"ok\":true,\"drawer_id\":\"";str.concat(drawerid;"\"}"));
  <$toolresult{contenttype:"text";text:result;iserror:false}
};

f=handlestorefail():i64{
  log.warn("memory.store failed";"mcp_server";"system");
  <$toolresult{contenttype:"text";text:proto.toolresulterr("store failed");iserror:true}
};

f=handlestoreobj(p:i64;obj:i64):i64{
  let content=json.getstr(obj;"content");
  let role=json.getstr(obj;"role");
  mt stor.storeturn(p;role;content;"manual";"user";0;$public) {
    $ok:v handlestoreok();
    $err:e handlestorefail()
  }
};

f=handlestore(p:i64;argsjson:str):i64{
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr:e $toolresult{contenttype:"text";text:proto.toolresulterr("invalid args JSON");iserror:true};
    $ok:obj handlestoreobj(p;obj)
  }
};


f=handlecontextobj(p:i64;obj:i64):i64{
  let task=json.getstr(obj;"task");
  let tokenbudget=json.getint(obj;"token_budget");
  let ctx=context.loadcontext(p;task;"user";tokenbudget);
  let ctxstr=context.tocontextstring(ctx);
  let ctxescaped=str.replace(ctxstr;"\"";"\\\"");
  let tokenss=str.fromint(ctx.totaltokensestimate);
  let result=str.concat(
    "{\"context\":\"";str.concat(
    ctxescaped;str.concat(
    "\",\"tokens_estimate\":";str.concat(
    tokenss;"}"
  ))));
  <$toolresult{contenttype:"text";text:result;iserror:false}
};

f=handlecontext(p:i64;argsjson:str):i64{
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr:e $toolresult{contenttype:"text";text:proto.toolresulterr("invalid args JSON");iserror:true};
    $ok:obj handlecontextobj(p;obj)
  }
};


f=handlestatusok(s:i64):i64{
  let drawerss=str.fromint(s.totaldrawers);
  let closetss=str.fromint(s.totalclosets);
  let wingss=str.fromint(s.totalwings);
  let result=str.concat(
    "{\"total_drawers\":";str.concat(
    drawerss;str.concat(
    ",\"total_closets\":";str.concat(
    closetss;str.concat(
    ",\"total_wings\":";str.concat(
    wingss;"}"
  )))))
  );
  <$toolresult{contenttype:"text";text:result;iserror:false}
};

f=handlestatusfail():i64{
  log.warn("memory.status failed";"mcp_server";"system");
  <$toolresult{contenttype:"text";text:proto.toolresulterr("status query failed");iserror:true}
};

f=handlestatus(p:i64):i64{
  mt palace.status(p) {
    $ok:s handlestatusok(s);
    $err:e handlestatusfail()
  }
};


f=handlefactsresults(rs:i64):i64{
  let level=aaak.defaultlevel();
  let count=str.arraylen(rs);
  let encodedparts="";
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      br
    }el{
      let r=str.arrayget(rs;i);
      let encoded=aaak.encodefact(r.contentexcerpt;level);
      let loc=str.concat(r.location.wing;str.concat("/";r.location.hall));
      let tagged=str.concat("[";str.concat(loc;str.concat("] ";encoded)));
      if(i = 0){
        let encodedparts=tagged
      }el{
        let encodedparts=str.concat(encodedparts;str.concat(" | ";tagged))
      };
      let i=i+1;
    }
  };
  let escaped=str.replace(encodedparts;"\"";"\\\"");
  let result=str.concat("{\"facts\":\"";str.concat(escaped;"\"}"));
  <$toolresult{contenttype:"text";text:result;iserror:false}
};

f=handlefactsfail():i64{
  log.warn("memory.facts search failed";"mcp_server";"system");
  <$toolresult{contenttype:"text";text:proto.toolresulterr("facts search failed");iserror:true}
};

f=handlefactsobj(p:i64;obj:i64):i64{
  let query=json.getstr(obj;"query");
  mt search.search(p;query;5) {
    $ok:rs handlefactsresults(rs);
    $err:e handlefactsfail()
  }
};

f=handlefacts(p:i64;argsjson:str):i64{
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr:e $toolresult{contenttype:"text";text:proto.toolresulterr("invalid args JSON");iserror:true};
    $ok:obj handlefactsobj(p;obj)
  }
};


f=handlediarywritefail(agentid:str):i64{
  log.warn(str.concat("memory.diary_write failed for agent: ";agentid);"mcp_server";"system");
  <$toolresult{contenttype:"text";text:proto.toolresulterr("diary write failed");iserror:true}
};

f=handlediarywriteobj(p:i64;obj:i64):i64{
  let agentid=json.getstr(obj;"agent_id");
  let entry=json.getstr(obj;"entry");

  let location=$palacelocation{wing:"agent-diaries";hall:agentid;room:"diary"};
  let drawerid=str.randhex(16);
  let drawer=$drawer{
    id:drawerid;
    location:location;
    role:"agent";
    content:entry;
    sessionid:"diary";
    modelid:agentid;
    tokens:0;
    sensitivity:$internal;
    createdat:""
  };
  mt stor.storedrawer(p;drawer) {
    $ok:v $toolresult{contenttype:"text";text:"{\"ok\":true}";iserror:false};
    $err:e handlediarywritefail(agentid)
  }
};

f=handlediarywrite(p:i64;argsjson:str):i64{
  let parsed=json.dec(argsjson);
  mt parsed {
    $jsonerr:e $toolresult{contenttype:"text";text:proto.toolresulterr("invalid args JSON");iserror:true};
    $ok:obj handlediarywriteobj(p;obj)
  }
};




f=unknownmemorytool(name:str):i64{
  let msg=str.concat("unknown memory tool: ";name);
  log.warn(msg;"mcp_server";"system");
  <$toolresult{contenttype:"text";text:proto.toolresulterr(msg);iserror:true}
};

f=dispatchmemorytool(name:str;argsjson:str;p:i64):i64{
  if(str.eq(name;"memory.search")){
    <handlesearch(p;argsjson)
  }el{
    if(str.eq(name;"memory.store")){
      <handlestore(p;argsjson)
    }el{
      if(str.eq(name;"memory.context")){
        <handlecontext(p;argsjson)
      }el{
        if(str.eq(name;"memory.status")){
          <handlestatus(p)
        }el{
          if(str.eq(name;"memory.facts")){
            <handlefacts(p;argsjson)
          }el{
            if(str.eq(name;"memory.diary_write")){
              <handlediarywrite(p;argsjson)
            }el{
              <unknownmemorytool(name)
            }
          }
        }
      }
    }
  }
};

f=memorytoolopenfail(datadir:str):i64{
  let msg=str.concat("failed to open memory palace at: ";datadir);
  log.warn(msg;"mcp_server";"system");
  <$toolresult{contenttype:"text";text:proto.toolresulterr(msg);iserror:true}
};

f=handlememorytool(name:str;argsjson:str;datadir:str):i64{
  mt palace.open(datadir) {
    $ok:p dispatchmemorytool(name;argsjson;p);
    $err:e memorytoolopenfail(datadir)
  }
};

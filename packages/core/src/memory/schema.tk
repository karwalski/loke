m=core.memory.schema;


i=db:std.db;
i=log:shared.log;
i=sdb:core.storage.db;
i=mig:core.storage.migrations;


f=execok(sql:str):bool{
  <mt db.exec(sql;@()) {
    $ok:v true;
    $err:e false
  }
};

f=drawerssql():str{
  <mig.memdrawerssql()
};


f=closetssql():str{
  <mig.memclosetssql()
};


f=indexsql():str{
  <mig.memindexsql()
};


f=scoressql():str{
  <mig.memscoressql()
};


f=createtables(conn:$dbconn):bool{
  if(execok(drawerssql())){}el{
    log.warn("memory schema: failed to create memory_drawers";"memory.schema";"system");
    <false
  };
  if(execok(closetssql())){}el{
    log.warn("memory schema: failed to create memory_closets";"memory.schema";"system");
    <false
  };
  if(execok(indexsql())){}el{
    log.warn("memory schema: failed to create memory_index";"memory.schema";"system");
    <false
  };
  if(execok(scoressql())){}el{
    log.warn("memory schema: failed to create memory_scores";"memory.schema";"system");
    <false
  };
  if(execok(mig.memdrawersidxsql())){}el{
    log.warn("memory schema: failed to create idx_drawers_location";"memory.schema";"system");
    <false
  };
  if(execok(mig.mempiiidxsql())){}el{
    log.warn("memory schema: failed to create idx_scores_pii";"memory.schema";"system");
    <false
  };
  <execok(mig.memkeywordidxsql())
};

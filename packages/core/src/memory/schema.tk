m=core.memory.schema;


i=db:std.db;
i=str:std.str;
i=t:shared.types;
i=sdb:core.storage.db;


f=createtables(conn:$dbconn):void!$lokeerr{
  mt db.exec(conn;"CREATE TABLE IF NOT EXISTS memory_drawers (
  id TEXT PRIMARY KEY,
  wing TEXT NOT NULL,
  hall TEXT NOT NULL,
  room TEXT NOT NULL,
  role TEXT NOT NULL,
  content TEXT NOT NULL,
  session_id TEXT,
  model_id TEXT,
  tokens INTEGER DEFAULT 0,
  sensitivity TEXT DEFAULT 'PUBLIC',
  created_at TEXT NOT NULL
)") {
    $ok:v void;
    $err:e $err($storageerr("failed to create memory_drawers table"))
  };

  mt db.exec(conn;"CREATE TABLE IF NOT EXISTS memory_closets (
  id TEXT PRIMARY KEY,
  wing TEXT NOT NULL,
  hall TEXT NOT NULL,
  room TEXT NOT NULL,
  aaak_summary TEXT NOT NULL,
  drawer_ids TEXT NOT NULL,
  created_at TEXT NOT NULL
)") {
    $ok:v void;
    $err:e $err($storageerr("failed to create memory_closets table"))
  };

  mt db.exec(conn;"CREATE TABLE IF NOT EXISTS memory_index (
  drawer_id TEXT NOT NULL,
  keyword TEXT NOT NULL,
  weight REAL DEFAULT 1.0,
  PRIMARY KEY (drawer_id, keyword)
)") {
    $ok:v void;
    $err:e $err($storageerr("failed to create memory_index table"))
  };

  mt db.exec(conn;"CREATE INDEX IF NOT EXISTS idx_drawers_location ON memory_drawers(wing, hall, room)") {
    $ok:v void;
    $err:e $err($storageerr("failed to create idx_drawers_location index"))
  };

  mt db.exec(conn;"CREATE INDEX IF NOT EXISTS idx_index_keyword ON memory_index(keyword)") {
    $ok:v $ok(void);
    $err:e $err($storageerr("failed to create idx_index_keyword index"))
  }
};

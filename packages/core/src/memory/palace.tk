m=core.memory.palace;



i=memtypes:core.memory.types;
i=schema:core.memory.schema;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=sdb:core.storage.db;

t=$palace{
  conn:$dbconn;
  datadir:str
};


(* ── One database, because std.db has one connection ─────────────────────────────
   This used to open `datadir/memory.db`, a SECOND file, and that is not possible in this
   toolchain. `std.db` keeps a single global `sqlite3 *g_db`; `db.open` returns something
   shaped like a handle but `conn_db` resolves only id 0, so a second `db.open` silently
   REPLACES the first without closing it and every subsequent query — from either subsystem —
   goes to whichever file was opened last (upstream T-30).

   So opening the memory palace hijacked the process's connection: after it,
   `audit_log`, `settings` and `sessions` did not exist for any reader, and before it
   `memory_drawers` did not. Both directions failed silently, because the row accessors map a
   failed read to `0` or `""`. It was found only when a de-stubbed test began asserting that
   the memory tables exist in the store it had opened.

   The palace now uses `loke.db`, the same file `core.storage.db.openstore` uses. The `memory_*`
   tables are namespaced by their prefix and `schema.createtables` is `CREATE TABLE IF NOT
   EXISTS`, so sharing the file costs nothing. When T-30 is fixed, splitting them again is a
   two-line change — but it should not be made merely because it becomes possible.

   **A pre-existing `datadir/memory.db` is no longer read, and nothing migrates it (M1.7b).**
   That was decided rather than assumed. Every version of this function that opened `memory.db`
   then called `schema.createtables`, whose statements passed the connection where the SQL
   belonged. That crashed on the first `CREATE TABLE`, so no build could create
   `memory_drawers` in that file, let alone write a drawer to it. No release has shipped. A
   migration would copy tables that cannot exist. *)
f=open(datadir:str):$palace!$lokeerr{
  let path=str.concat(datadir;"/loke.db");
  (* sdb.adopt: the new connection is the one the handle-less std.db calls use, as it was
     before toke 3.1.0 (F10.39; see core.storage.db). *)
  let conn=mt db.open(path) {
    $ok:conn sdb.adopt(conn);
    $err:e $err($storageerr(str.concat("failed to open memory database: ";path)))
  };
  (* createtables returns a plain bool: its old `i64!$lokeerr` had dead `$err` arms (T-18) and
     four of its five statements discarded their results, so a failure could not reach here. *)
  if(schema.createtables(conn)){}el{
    <$err($storageerr("failed to create the memory palace tables"))
  };
  log.info("memory palace opened";"palace";"system");
  <$ok($palace{conn:conn;datadir:datadir})
};


(* MK6.6. `open`'s `$palace!$lokeerr` cannot be matched: a result with a user-declared error
   type always takes the first arm (T-18), so a caller that matched it ran its success arm with
   the error payload bound as the palace. moke's memory panel did exactly that whenever
   `datadir` did not exist, and every tool that then read the database crashed the worker. This
   answers, as a bool a caller can branch on, whether the palace's database opened and its
   tables exist. It opens the same file as `open`. *)
f=openok(datadir:str):bool{
  <mt db.open(str.concat(datadir;"/loke.db")) {
    $ok:conn schema.createtables(sdb.adopt(conn));
    $err:e false
  }
};


(* MK6.8. The three listings and walk answered `X!$lokeerr`, and every match on that takes its
   first arm whatever the value is (T-18): walk's own match on listwings, and context.loadl1's
   on walk, read a failed query as a list of wings and a palace map. They now answer a
   `$namelist` whose `failure` is empty when the list is real (`islisted` reads it), and walk
   answers "" when it could not read the palace (`iswalked` reads that): a palace that can be
   read always has at least the four default wings, so a real walk is never empty. *)
f=islisted(n:$namelist):bool{
  <str.len(n.failure)==0
};

f=iswalked(s:str):bool{
  <str.len(s)>0
};

(* `.push` RETURNS the new array — it does not mutate in place, and a callee cannot mutate a
   caller's value either. The pushes in the original listings discarded their result, so
   listwings returned an empty array whatever the database held and whatever defaultwings()
   supplied, and every caller saw a memory palace with no wings. *)
f=namesof(sql:str;params:@str;column:str;what:str):$namelist{
  <mt db.many(sql;params) {
    $ok:rows namesfromrows(rows;column);
    $err:e $namelist{names:@();failure:"failed to query \(what)"}
  }
};

f=namesfromrows(rows:@$dbrow;column:str):$namelist{
  let names=mut.@();
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let row:$dbrow=rows.get(ii);
    names=names.push(sdb.rowstr(row;column))
  };
  <$namelist{names:names;failure:""}
};

f=listwings(palace:$palace):$namelist{
  let stored=namesof("SELECT DISTINCT wing FROM memory_drawers ORDER BY wing";@();"wing";"wings");
  if(!islisted(stored)){ <stored }el{};
  let dbwings=stored.names;
  let defaults=memtypes.defaultwings();
  let allwings=mut.dbwings;
  lp(let ii=0;ii<defaults.len;ii=ii+1){ let w=defaults.get(ii);
    let already=mut.false;
    lp(let jj=0;jj<dbwings.len;jj=jj+1){
      if(str.eq(dbwings.get(jj);w.name)){ already=true }el{}
    };
    if(!already){ allwings=allwings.push(w.name) }el{}
  };
  <$namelist{names:allwings;failure:""}
};


(* The parameter array was written `@($wing)` — the `$` sigil makes that a type
   reference, not the local `wing`, so the bound parameter was not the wing asked for and
   listhalls returned the halls of nothing. The identical defect is documented in
   memory/privacy.tk:208-210. *)
f=listhalls(palace:$palace;wing:str):$namelist{
  <namesof("SELECT DISTINCT hall FROM memory_drawers WHERE wing=? ORDER BY hall";@(wing);"hall";"halls")
};


f=listrooms(palace:$palace;wing:str;hall:str):$namelist{
  <namesof("SELECT DISTINCT room FROM memory_drawers WHERE wing=? AND hall=? ORDER BY room";@(wing;hall);"room";"rooms")
};


(* MK6.6. This was `status`, declared `i64!$lokeerr` while it returned a `$palacestatus`, and
   its one caller, core.memory.mcpserver, matched it and read `.totaldrawers` off an `i64`. A
   match on a result with a user-declared error type always takes the first arm (T-18), so a
   failed count handed the ERROR payload to the success arm, which read three fields off it:
   that is what killed moke's worker on `memory.status` whenever the palace had not opened. The
   counts are now formatted here, in the module that computed them, and a failure is the empty
   string rather than a value no caller can tell apart from success.

   A COUNT without GROUP BY yields exactly one row, so no row at all means the query failed. *)
f=countrows(sql:str;params:@str):i64{
  let rows=mt db.many(sql;params) {
    $ok:rows rows;
    $err:e @()
  };
  if(rows.len==0){ <-1 }el{};
  let row:$dbrow=rows.get(0);
  <sdb.rowi64(row;"n")
};

f=statusjson():str{
  let drawers=countrows("SELECT COUNT(*) as n FROM memory_drawers";@());
  let closets=countrows("SELECT COUNT(*) as n FROM memory_closets";@());
  let wings=countrows("SELECT COUNT(DISTINCT wing) as n FROM memory_drawers";@());
  if(drawers<0 || closets<0 || wings<0){ <"" }el{};
  <"{\"total_drawers\":\(drawers),\"total_closets\":\(closets),\"total_wings\":\(wings)}"
};


(* One line of the walk. The names arrive as parameters, which is what types them for the
   interpolation: an element read off the array is untyped and interpolates as its address, and
   a `let x:str=` annotation on it instead drops it from the `@(...)` parameter list the counts
   are bound with (LS1.1s, T-46). *)
f=walkline(indent:str;label:str;name:str;count:i64):str{
  if(count<0){ <"\(indent)\(label): \(name)
" }el{};
  <"\(indent)\(label): \(name) (\(count) drawers)
"
};

(* "" when any query it makes fails; see `iswalked`. *)
f=walk(palace:$palace):str{
  let wings=listwings(palace);
  if(!islisted(wings)){ <"" }el{};
  let out=mut."";
  lp(let ii=0;ii<wings.names.len;ii=ii+1){ let wing=wings.names.get(ii);
    out=str.concat(out;walkline("";"Wing";wing;-1));
    let halls=listhalls(palace;wing);
    if(!islisted(halls)){ <"" }el{};
    lp(let jj=0;jj<halls.names.len;jj=jj+1){ let hall=halls.names.get(jj);
      let hallcount=countrows("SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=?";@(wing;hall));
      if(hallcount<0){ <"" }el{};
      out=str.concat(out;walkline("  ";"Hall";hall;hallcount));
      let rooms=listrooms(palace;wing;hall);
      if(!islisted(rooms)){ <"" }el{};
      lp(let kk=0;kk<rooms.names.len;kk=kk+1){ let room=rooms.names.get(kk);
        let roomcount=countrows("SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=? AND room=?";@(wing;hall;room));
        if(roomcount<0){ <"" }el{};
        out=str.concat(out;walkline("    ";"Room";room;roomcount))
      }
    }
  };
  <out
};

m=core.memory.palace;



i=memtypes:core.memory.types;
i=schema:core.memory.schema;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=t:shared.types;
i=sdb:core.storage.db;

t=$palace{
  conn:$dbconn;
  datadir:str
};


f=open(datadir:str):$palace!$lokeerr{
  let path=str.concat(datadir;"/memory.db");
  let conn=mt db.open(path) {
    $ok:conn conn;
    $err:e $err($storageerr(str.concat("failed to open memory database: ";path)))
  };
  mt schema.createtables(conn) {
    $ok:v true;
    $err:e $err(e)
  };
  log.info("memory palace opened";"palace";"system");
  <$ok($palace{conn:conn;datadir:datadir})
};


f=listwings(palace:$palace):@str!$lokeerr{
  let rows=mt db.many("SELECT DISTINCT wing FROM memory_drawers ORDER BY wing";@()) {
    $ok:rows rows;
    $err:e $err($storageerr("failed to query wings"))
  };
  (* `.push` RETURNS the new array — it does not mutate in place, and a callee cannot
     mutate a caller's value either. Both pushes here discarded their result, so
     listwings returned an empty array whatever the database held and whatever
     defaultwings() supplied, and every caller saw a memory palace with no wings.
     listhalls and listrooms below were written the same way. *)
  let dbwings=mut.@();
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let row:$row=rows.get(ii);
    dbwings=dbwings.push(sdb.rowstr(row;"wing"))
  };
  let defaults=memtypes.defaultwings();

  let allwings=mut.dbwings;
  lp(let ii=0;ii<defaults.len;ii=ii+1){ let w=defaults.get(ii);
    let already=mut.false;
    lp(let jj=0;jj<dbwings.len;jj=jj+1){       if(str.eq(dbwings.get(jj);w.name)){
        already=true
      }el{};
    };
    if(!already){
      allwings=allwings.push(w.name)
    }el{};
  };
  <$ok(allwings)
};


(* The parameter array was written `@($wing)` — the `$` sigil makes that a type
   reference, not the local `wing`, so the bound parameter was not the wing asked for and
   listhalls returned the halls of nothing. The identical defect is documented in
   memory/privacy.tk:208-210. The discarded `.push` is the same defect as in listwings. *)
f=listhalls(palace:$palace;wing:str):@str!$lokeerr{
  let rows=mt db.many("SELECT DISTINCT hall FROM memory_drawers WHERE wing=? ORDER BY hall";@(wing)) {
    $ok:rows rows;
    $err:e $err($storageerr(str.concat("failed to query halls for wing: ";wing)))
  };
  let halls=mut.@();
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let row:$row=rows.get(ii);
    halls=halls.push(sdb.rowstr(row;"hall"))
  };
  <$ok(halls)
};


f=listrooms(palace:$palace;wing:str;hall:str):@str!$lokeerr{
  let rows=mt db.many("SELECT DISTINCT room FROM memory_drawers WHERE wing=? AND hall=? ORDER BY room";@(wing;hall)) {
    $ok:rows rows;
    $err:e $err($storageerr(str.concat("failed to query rooms for: ";str.concat(wing;str.concat("/";hall)))))
  };
  let rooms=mut.@();
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let row:$row=rows.get(ii);
    rooms=rooms.push(sdb.rowstr(row;"room"))
  };
  <$ok(rooms)
};


f=status(palace:$palace):i64!$lokeerr{
  let drawerrows=mt db.many("SELECT COUNT(*) as n FROM memory_drawers";@()) {
    $ok:drawerrows drawerrows;
    $err:e $err($storageerr("failed to count drawers"))
  };
  (* Guarded. An unaggregated COUNT always yields exactly one row, so .get(0) happened
     to be safe here, but nothing in the type system says so and an out-of-range .get is
     not a checked error. *)
  let totaldrawers=mut.0;
  if(drawerrows.len>0){
    let drawerrow:$row=drawerrows.get(0);
    totaldrawers=sdb.rowi64(drawerrow;"n")
  }el{};
  let closetrows=mt db.many("SELECT COUNT(*) as n FROM memory_closets";@()) {
    $ok:closetrows closetrows;
    $err:e $err($storageerr("failed to count closets"))
  };
  let totalclosets=mut.0;
  if(closetrows.len>0){
    let closetrow:$row=closetrows.get(0);
    totalclosets=sdb.rowi64(closetrow;"n")
  }el{};
  let wingrows=mt db.many("SELECT COUNT(DISTINCT wing) as n FROM memory_drawers";@()) {
    $ok:wingrows wingrows;
    $err:e $err($storageerr("failed to count wings"))
  };
  let totalwings=mut.0;
  if(wingrows.len>0){
    let wingrow:$row=wingrows.get(0);
    totalwings=sdb.rowi64(wingrow;"n")
  }el{};
  <$ok($palacestatus{
    totaldrawers:totaldrawers as u32;
    totalclosets:totalclosets as u32;
    totalwings:totalwings as u32;
    storagebytes:0
  })
};



f=walk(palace:$palace):str!$lokeerr{
  let wings=mt listwings(palace) {
    $ok:wings wings;
    $err:e $err(e)
  };
  let out=mut."";
  lp(let ii=0;ii<wings.len;ii=ii+1){ let wing=wings.get(ii);
    let wingline=str.concat("Wing: ";wing);
    out=str.concat(out;str.concat(wingline;"
"));
    let halls=mt listhalls(palace;wing) {
      $ok:halls halls;
      $err:v @()
    };
    lp(let jj=0;jj<halls.len;jj=jj+1){ let hall=halls.get(jj);
      let hrows=mt db.many("SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=?";@(wing;hall)) {
        $ok:hrows hrows;
        $err:v @()
      };
      if(hrows.len > 0){
        let hallcount=str.fromint(sdb.rowi64(hrows.get(0);"n"));
        let hallline=str.concat("  Hall: ";str.concat(hall;str.concat(" (";str.concat(hallcount;" drawers)"))));
        out=str.concat(out;str.concat(hallline;"
"));
        let rooms=mt listrooms(palace;wing;hall) {
          $ok:rooms rooms;
          $err:v @()
        };
        lp(let kk=0;kk<rooms.len;kk=kk+1){ let room=rooms.get(kk);
          let rrows=mt db.many("SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=? AND room=?";@(wing;hall;room)) {
            $ok:rrows rrows;
            $err:v @()
          };
          if(rrows.len > 0){
            let roomcount=str.fromint(sdb.rowi64(rrows.get(0);"n"));
            let roomline=str.concat("    Room: ";str.concat(room;str.concat(" (";str.concat(roomcount;" drawers)"))));
            out=str.concat(out;str.concat(roomline;"
"))
          }el{}
        }
      }el{}
    }
  };
  <$ok(out)
};

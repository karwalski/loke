m=core.memory.palace;



i=t:shared.types;
i=memtypes:core.memory.types;
i=schema:core.memory.schema;
i=db:std.db;
i=str:std.str;
i=log:shared.log;

t=$palace{
  conn:$dbconn;
  datadir:str
};


f=open(datadir:str):$palace|$lokeerr{
  let path=str.concat(datadir;"/memory.db");
  mt db.open(path) {
    $ok:conn {
      mt schema.createtables(conn) {
        $ok: {
          log.info("memory palace opened";"palace";"system");
          <$ok($palace{conn:conn;datadir:datadir})
        };
        $err:e <$err(e)
      };
    };
    $err:e <$err($storageerr(str.concat("failed to open memory database: ";path)))
  };
};


f=listwings(palace:$palace):@str|$lokeerr{
  mt db.query(palace.conn;"SELECT DISTINCT wing FROM memory_drawers ORDER BY wing") {
    $ok:rows {
      let dbwings=rows.map|row{ json.getstr(row;"wing") };
      let defaults=memtypes.defaultwings();
      
      let allwings=dbwings;
      defaults.each|w{
        let already=false;
        dbwings.each|existing{
          if(str.eq(existing;w.name)){
            let already=true
          };
        };
        if(!$already){
          let allwings=allwings.append(w.name)
        };
      };
      <$ok(allwings)
    };
    $err:e <$err($storageerr("failed to query wings"))
  };
};


f=listhalls(palace:$palace;wing:str):@str|$lokeerr{
  mt db.queryparams(palace.conn;"SELECT DISTINCT hall FROM memory_drawers WHERE wing=? ORDER BY hall";@($wing)) {
    $ok:rows {
      let halls=rows.map|row{ json.getstr(row;"hall") };
      <$ok(halls)
    };
    $err:e <$err($storageerr(str.concat("failed to query halls for wing: ";wing)))
  };
};


f=listrooms(palace:$palace;wing:str;hall:str):@str|$lokeerr{
  mt db.queryparams(palace.conn;"SELECT DISTINCT room FROM memory_drawers WHERE wing=? AND hall=? ORDER BY room";@(wing;hall)) {
    $ok:rows {
      let rooms=rows.map|row{ json.getstr(row;"room") };
      <$ok(rooms)
    };
    $err:e <$err($storageerr(str.concat("failed to query rooms for: ";str.concat(wing;str.concat("/";hall)))))
  };
};


f=status(palace:$palace):i64|$lokeerr{
  mt db.query(palace.conn;"SELECT COUNT(*) as n FROM memory_drawers") {
    $ok:drawerrows {
      let totaldrawers=json.getint(drawerrows.get(0);"n");
      mt db.query(palace.conn;"SELECT COUNT(*) as n FROM memory_closets") {
        $ok:closetrows {
          let totalclosets=json.getint(closetrows.get(0);"n");
          mt db.query(palace.conn;"SELECT COUNT(DISTINCT wing) as n FROM memory_drawers") {
            $ok:wingrows {
              let totalwings=json.getint(wingrows.get(0);"n");
              <$ok($memtypes.palacestatus{
                totaldrawers:totaldrawers;
                totalclosets:totalclosets;
                totalwings:totalwings;
                storagebytes:0
              })
            };
            $err:e <$err($storageerr("failed to count wings"))
          };
        };
        $err:e <$err($storageerr("failed to count closets"))
      };
    };
    $err:e <$err($storageerr("failed to count drawers"))
  };
};



f=walk(palace:$palace):str|$lokeerr{
  mt listwings(palace) {
    $ok:wings {
      let out="";
      wings.each|wing{
        let wingline=str.concat("Wing: ";wing);
        let out=str.concat(out;str.concat(wingline;"
"));
        mt listhalls(palace;wing) {
          $ok:halls {
            halls.each|hall{
              mt db.queryparams(palace.conn;"SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=?";@(wing;hall)) {
                $ok:hrows {
                  let hallcount=str.fromint(json.getint(hrows.get(0);"n"));
                  let hallline=str.concat("  Hall: ";str.concat(hall;str.concat(" (";str.concat(hallcount;" drawers)"))));
                  let out=str.concat(out;str.concat(hallline;"
"));
                  mt listrooms(palace;wing;hall) {
                    $ok:rooms {
                      rooms.each|room{
                        mt db.queryparams(palace.conn;"SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=? AND room=?";@(wing;hall;room)) {
                          $ok:rrows {
                            let roomcount=str.fromint(json.getint(rrows.get(0);"n"));
                            let roomline=str.concat("    Room: ";str.concat(room;str.concat(" (";str.concat(roomcount;" drawers)"))));
                            let out=str.concat(out;str.concat(roomline;"
"))
                          };
                          $err: {};
                        };
                      };
                    };
                    $err: {};
                  };
                };
                $err: {};
              };
            };
          };
          $err: {};
        };
      };
      <$ok(out)
    };
    $err:e <$err(e)
  };
};

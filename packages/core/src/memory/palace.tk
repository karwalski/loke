m=core.memory.palace;



i=t:shared.types;
i=memtypes:core.memory.types;
i=schema:core.memory.schema;
i=db:std.db;
i=str:std.str;
i=log:shared.log;

t=$palace{
  conn:$dbconn;
  datadir:str
};


f=open(datadir:str):$palace!$lokeerr{
  let path=str.concat(datadir;"/memory.db");
  let conn=mt db.open(path) {
    $ok:conn conn;
    $err:e $err($storageerr(str.concat("failed to open memory database: ";path)))
  };
  mt schema.createtables(conn) {
    $ok:v void;
    $err:e $err(e) 
  };
  log.info("memory palace opened";"palace";"system");
  <$ok($palace{conn:conn;datadir:datadir})
};


f=listwings(palace:$palace):@str!$lokeerr{
  let rows=mt db.query(palace.conn;"SELECT DISTINCT wing FROM memory_drawers ORDER BY wing") {
    $ok:rows rows;
    $err:e $err($storageerr("failed to query wings"))
  };
  let dbwings=@();
  lp(let ii=0;ii<rows.len;ii=ii+1){ let row=rows.get(ii);
    dbwings.push(json.str(row;"wing"))
  };
  let defaults=memtypes.defaultwings();

  let allwings=dbwings;
  lp(let ii=0;ii<defaults.len;ii=ii+1){ let w=defaults.get(ii);
    let already=mut.false;
    lp(let jj=0;jj<dbwings.len;jj=jj+1){ let existing=dbwings.get(jj);
      if(str.eq(existing;w.name)){
        already=true
      }el{};
    };
    if(!already){
      allwings.push(w.name)
    }el{};
  };
  <$ok(allwings)
};


f=listhalls(palace:$palace;wing:str):@str!$lokeerr{
  let rows=mt db.queryparams(palace.conn;"SELECT DISTINCT hall FROM memory_drawers WHERE wing=? ORDER BY hall";@($wing)) {
    $ok:rows rows;
    $err:e $err($storageerr(str.concat("failed to query halls for wing: ";wing)))
  };
  let halls=@();
  lp(let ii=0;ii<rows.len;ii=ii+1){ let row=rows.get(ii);
    halls.push(json.str(row;"hall"))
  };
  <$ok(halls)
};


f=listrooms(palace:$palace;wing:str;hall:str):@str!$lokeerr{
  let rows=mt db.queryparams(palace.conn;"SELECT DISTINCT room FROM memory_drawers WHERE wing=? AND hall=? ORDER BY room";@(wing;hall)) {
    $ok:rows rows;
    $err:e $err($storageerr(str.concat("failed to query rooms for: ";str.concat(wing;str.concat("/";hall)))))
  };
  let rooms=@();
  lp(let ii=0;ii<rows.len;ii=ii+1){ let row=rows.get(ii);
    rooms.push(json.str(row;"room"))
  };
  <$ok(rooms)
};


f=status(palace:$palace):i64!$lokeerr{
  let drawerrows=mt db.query(palace.conn;"SELECT COUNT(*) as n FROM memory_drawers") {
    $ok:drawerrows drawerrows;
    $err:e $err($storageerr("failed to count drawers"))
  };
  let totaldrawers=json.i64(drawerrows.get(0);"n");
  let closetrows=mt db.query(palace.conn;"SELECT COUNT(*) as n FROM memory_closets") {
    $ok:closetrows closetrows;
    $err:e $err($storageerr("failed to count closets"))
  };
  let totalclosets=json.i64(closetrows.get(0);"n");
  let wingrows=mt db.query(palace.conn;"SELECT COUNT(DISTINCT wing) as n FROM memory_drawers") {
    $ok:wingrows wingrows;
    $err:e $err($storageerr("failed to count wings"))
  };
  let totalwings=json.i64(wingrows.get(0);"n");
  <$ok($palacestatus{
    totaldrawers:totaldrawers;
    totalclosets:totalclosets;
    totalwings:totalwings;
    storagebytes:0
  })
};



f=walk(palace:$palace):str!$lokeerr{
  let wings=mt listwings(palace) {
    $ok:wings wings;
    $err:e $err(e)
  };
  let out=mut."";
  lp(let ii=0;ii<wings.len;ii=ii+1){ let wing=wings.get(ii);
    let wingline=str.concat("Wing: ";wing);
    out=str.concat(out;str.concat(wingline;"
"));
    let halls=mt listhalls(palace;wing) {
      $ok:halls halls;
      $err:v @()
    };
    lp(let jj=0;jj<halls.len;jj=jj+1){ let hall=halls.get(jj);
      let hrows=mt db.queryparams(palace.conn;"SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=?";@(wing;hall)) {
        $ok:hrows hrows;
        $err:v @()
      };
      if(hrows.len > 0){
        let hallcount=str.fromint(json.i64(hrows.get(0);"n"));
        let hallline=str.concat("  Hall: ";str.concat(hall;str.concat(" (";str.concat(hallcount;" drawers)"))));
        out=str.concat(out;str.concat(hallline;"
"));
        let rooms=mt listrooms(palace;wing;hall) {
          $ok:rooms rooms;
          $err:v @()
        };
        lp(let kk=0;kk<rooms.len;kk=kk+1){ let room=rooms.get(kk);
          let rrows=mt db.queryparams(palace.conn;"SELECT COUNT(*) as n FROM memory_drawers WHERE wing=? AND hall=? AND room=?";@(wing;hall;room)) {
            $ok:rrows rrows;
            $err:v @()
          };
          if(rrows.len > 0){
            let roomcount=str.fromint(json.i64(rrows.get(0);"n"));
            let roomline=str.concat("    Room: ";str.concat(room;str.concat(" (";str.concat(roomcount;" drawers)"))));
            out=str.concat(out;str.concat(roomline;"
"))
          }el{}
        }
      }el{}
    }
  };
  <$ok(out)
};

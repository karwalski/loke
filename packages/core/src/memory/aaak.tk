m=core.memory.aaak;

i=str:std.str;
i=t:shared.types;
i=memtypes:core.memory.types;

t=$aaakentry{
  key:str;
  value:str;
  entrytype:str;
  confidence:f64
};

t=$aaakdoc{
  entries:@$aaakentry;
  raw:str;
  sourcelen:u32;
  aaaklen:u32;
  compressionratio:f64
};

t=$compresslevel{
  $light:i64;
  $medium:i64;
  $aggressive:i64};

f=defaultlevel():$compresslevel{
  <$medium
};

f=striparticles(text:str):str{
  let s=str.replace(text;" the ";" ");
  let s=str.replace(s;" a ";" ");
  let s=str.replace(s;" an ";" ");
  let s=str.replace(s;"The ";"");
  let s=str.replace(s;"A ";"");
  <str.replace(s;"An ";"")
};

f=stripprepositions(text:str):str{
  let s=str.replace(text;" of ";" ");
  let s=str.replace(s;" for ";" ");
  let s=str.replace(s;" in ";" ");
  let s=str.replace(s;" on ";" ");
  let s=str.replace(s;" at ";" ");
  let s=str.replace(s;" to ";" ");
  let s=str.replace(s;" by ";" ");
  <str.replace(s;" with ";" ")
};

f=abbreviatelongwords(text:str):str{
  let words=str.split(text;" ");
  let result="";
  let first=true;
  words.each|w{
    let abbrev=if(str.len(w) > 8){
      str.toupper(str.slice(w;0;4))
    }el{
      w
    };
    if(first){
      result=abbrev;
      first=false
    }el{
      result=str.concat(result;str.concat(" ";abbrev))
    }
  };
  <result
};

f=isteampattern(lower:str):bool{
  let hasmanages=str.contains(lower;"manages");
  let hasleads=str.contains(lower;"leads");
  let hashandles=str.contains(lower;"handles");
  let hasfrontend=str.contains(lower;"frontend");
  let hasbackend=str.contains(lower;"backend");
  let hasinfra=str.contains(lower;"infra");
  (hasmanages || hasleads) && (hasfrontend || hasbackend || hasinfra || hashandles)
};

f=isdecisionpattern(lower:str):bool{
  let hasdecision=str.contains(lower;"decision");
  let hasdecided=str.contains(lower;"decided");
  let haschose=str.contains(lower;"chose");
  let hasselected=str.contains(lower;"selected");
  hasdecision || hasdecided || haschose || hasselected
};

f=hasreasonclause(lower:str):bool{
  let hasbecause=str.contains(lower;"because");
  let hasdue=str.contains(lower;"due to");
  let hasreason=str.contains(lower;"reason");
  hasbecause || hasdue || hasreason
};

f=iscopulapattern(lower:str):bool{
  let hasis=str.contains(lower;" is ");
  let hasare=str.contains(lower;" are ");
  hasis || hasare
};

f=applylevel(text:str;level:$compresslevel):str{
  mt level {
    $light:v
      <striparticles(text);
    $medium:v
      let s=striparticles(text);
      <stripprepositions(s);
    $aggressive:v
      let s=striparticles(text);
      let s=stripprepositions(s);
      <abbreviatelongwords(s)
  }
};

f=encodefact(text:str;level:$compresslevel):str{
  let trimmed=str.trim(text);
  let lower=str.tolower(trimmed);

  if(isdecisionpattern(lower)){
    if(hasreasonclause(lower)){
      let partsbecause=str.split(trimmed;"because");
      let partsdue=str.split(trimmed;"due to");
      let hasbecause=str.contains(lower;"because");
      if(hasbecause && str.len(partsbecause.get(0)) > 0){
        let decisionpart=applylevel(str.trim(partsbecause.get(0));level);
        let reasonpart=applylevel(str.trim(partsbecause.get(1));level);
        <str.concat("DEC: ";str.concat(decisionpart;str.concat(" <- ";reasonpart)))
      }el{
        let decisionpart=applylevel(str.trim(partsdue.get(0));level);
        let reasonpart=applylevel(str.trim(partsdue.get(1));level);
        <str.concat("DEC: ";str.concat(decisionpart;str.concat(" <- ";reasonpart)))
      }
    }el{
      let compressed=applylevel(trimmed;level);
      <str.concat("DEC: ";compressed)
    }
  }el{
    if(isteampattern(lower)){
      let compressed=applylevel(trimmed;level);
      <str.concat("TEAM: ";compressed)
    }el{
      if(str.contains(lower;"manages") || str.contains(lower;"leads")){
        let partsm=str.split(trimmed;" manages ");
        let partsl=str.split(trimmed;" leads ");
        let hasmanages=str.contains(lower;" manages ");
        if(hasmanages && str.len(partsm.get(0)) > 0){
          let subject=applylevel(str.trim(partsm.get(0));level);
          let object=applylevel(str.trim(partsm.get(1));level);
          <str.concat(subject;str.concat("(lead): ";object))
        }el{
          if(str.contains(lower;" leads ") && str.len(partsl.get(0)) > 0){
            let subject=applylevel(str.trim(partsl.get(0));level);
            let object=applylevel(str.trim(partsl.get(1));level);
            <str.concat(subject;str.concat("(lead): ";object))
          }el{
            <applylevel(trimmed;level)
          }
        }
      }el{
        if(iscopulapattern(lower)){
          let hasis=str.contains(lower;" is ");
          let partsis=str.split(trimmed;" is ");
          let partsare=str.split(trimmed;" are ");
          if(hasis && str.len(partsis.get(0)) > 0){
            let subject=applylevel(str.trim(partsis.get(0));level);
            let predicate=applylevel(str.trim(partsis.get(1));level);
            <str.concat(subject;str.concat(": ";predicate))
          }el{
            if(str.contains(lower;" are ") && str.len(partsare.get(0)) > 0){
              let subject=applylevel(str.trim(partsare.get(0));level);
              let predicate=applylevel(str.trim(partsare.get(1));level);
              <str.concat(subject;str.concat(": ";predicate))
            }el{
              <applylevel(trimmed;level)
            }
          }
        }el{
          <applylevel(trimmed;level)
        }
      }
    }
  }
};

f=measuresavings(original:str;aaak:str):f64{
  let origlen=str.len(original);
  let aaaklen=str.len(aaak);
  if(origlen = 0){
    <0.0
  }el{
    (1.0 - (aaaklen / origlen)) * 100.0
  }
};

f=encodetext(text:str;level:$compresslevel):$aaakdoc{
  let sentences=str.split(text;". ");
  let encodedparts=@(str);
  sentences.each|s{
    let trimmed=str.trim(s);
    if(str.len(trimmed) > 0){
      let encoded=encodefact(trimmed;level);
      encodedparts=@.push(encodedparts;encoded)
    }el{}
  };

  let raw="";
  let first=true;
  encodedparts.each|part{
    if(first){
      raw=part;
      first=false
    }el{
      raw=str.concat(raw;str.concat(" | ";part))
    }
  };

  let sourcelen=str.len(text);
  let aaaklen=str.len(raw);
  let ratio=measuresavings(text;raw);

  let entries=@($aaakentry);
  encodedparts.each|part{
    let entry=$aaakentry{
      key:"";
      value:part;
      entrytype:"fact";
      confidence:0.8
    };
    entries=@.push(entries;entry)
  };

  <$aaakdoc{
    entries:entries;
    raw:raw;
    sourcelen:sourcelen;
    aaaklen:aaaklen;
    compressionratio:ratio
  }
};

f=decode(aaak:str):str{
  let s=if(str.contains(aaak;"DEC: ")){
    let parts=str.split(aaak;"DEC: ");
    let after=parts.get(1);
    if(str.contains(after;" <- ")){
      let reasonparts=str.split(after;" <- ");
      str.concat("Decision: ";str.concat(reasonparts.get(0);str.concat(", because ";reasonparts.get(1))))
    }el{
      str.concat("Decision: ";after)
    }
  }el{
    aaak
  };

  let s=if(str.contains(s;"TEAM: ")){
    str.replace(s;"TEAM: ";"Team: ")
  }el{
    s
  };

  let s=if(str.contains(s;"PALACE: ")){
    str.replace(s;"PALACE: ";"Palace structure: ")
  }el{
    s
  };

  let s=str.replace(s;" | ";" and ");

  if(str.contains(s;": ")){
    let kvparts=str.split(s;": ");
    let key=str.trim(kvparts.get(0));
    if(str.contains(key;" ")=false){
      let val=str.trim(kvparts.get(1));
      str.concat(key;str.concat(" is ";val))
    }el{
      s
    }
  }el{
    s
  }
};

f=encodedrawer(drawer:i64;level:$compresslevel):str{
  let doc=encodetext(drawer.content;level);
  let lockey=str.concat(drawer.location.wing;str.concat("/";str.concat(drawer.location.hall;str.concat("/";drawer.location.room))));
  let header=str.concat(lockey;": ");
  <str.concat(header;doc.raw)
};

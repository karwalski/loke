m=core.memory.storage;



i=t:shared.types;
i=memtypes:core.memory.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;


f=storedrawer(palace:i64;drawer:i64):void|$lokeerr{
  let tokenss=str.fromint(drawer.tokens);
  let sensitivitys=mt drawer.sensitivity {
    $$public;       <"PUBLIC";
    $$internal;     <"INTERNAL";
    $$confidential; <"CONFIDENTIAL";
    $$restricted;   <"RESTRICTED"
  };
  mt db.execparams(
    palace.conn;
    "INSERT INTO memory_drawers (id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,'now()')";
    @(
      drawer.id;
      drawer.location.wing;
      drawer.location.hall;
      drawer.location.room;
      drawer.role;
      drawer.content;
      drawer.sessionid;
      drawer.modelid;
      tokenss;
      sensitivitys
    )
  ) {
    $ok: {
      log.debug(str.concat("stored drawer: ";drawer.id);"storage";"system");
      <$ok(void)
    };
    $err:e <$err($storageerr(str.concat("failed to store drawer: ";drawer.id)))
  }
};


f=getdrawer(palace:i64;id:str):i64|$lokeerr{
  mt db.queryparams(palace.conn;"SELECT id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at FROM memory_drawers WHERE id=?";@($id)) {
    $ok:rows {
      if(rows.len = 0){
        <$err($storageerr(str.concat("drawer not found: ";id)))
      }el{
        let row=rows.get(0);
        let sensitivitystr=json.getstr(row;"sensitivity");
        let sensitivity=if str.eq(sensitivitystr;"RESTRICTED"){
          $$restricted
        }el{
          if(str.eq(sensitivitystr;"CONFIDENTIAL")){
            $$confidential
          }el{
            if(str.eq(sensitivitystr;"INTERNAL")){
              $$internal
            }el{
              $$public
            }
          }
        };
        <$ok($drawer{
          id:json.getstr(row;"id");
          location:i64{
            wing:json.getstr(row;"wing");
            hall:json.getstr(row;"hall");
            room:json.getstr(row;"room")
          };
          role:json.getstr(row;"role");
          content:json.getstr(row;"content");
          sessionid:json.getstr(row;"session_id");
          modelid:json.getstr(row;"model_id");
          tokens:json.getint(row;"tokens");
          sensitivity:sensitivity;
          createdat:json.getstr(row;"created_at")
        })
      }
    };
    $err:e <$err($storageerr(str.concat("db error fetching drawer: ";id)))
  }
};


f=listdrawers(palace:i64;location:i64;limit:u32):@($drawer)|$lokeerr{
  let limits=str.fromint(limit);
  let sql=str.concat("SELECT id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at FROM memory_drawers WHERE wing=? AND hall=? AND room=? ORDER BY created_at DESC LIMIT ";limits);
  mt db.queryparams(palace.conn;sql;@(location.wing;location.hall;location.room)) {
    $ok:rows {
      let drawers=rows.map|row{
        let sensitivitystr=json.getstr(row;"sensitivity");
        let sensitivity=if str.eq(sensitivitystr;"RESTRICTED"){
          $$restricted
        }el{
          if(str.eq(sensitivitystr;"CONFIDENTIAL")){
            $$confidential
          }el{
            if(str.eq(sensitivitystr;"INTERNAL")){
              $$internal
            }el{
              $$public
            }
          }
        };
        $drawer{
          id:json.getstr(row;"id");
          location:i64{
            wing:json.getstr(row;"wing");
            hall:json.getstr(row;"hall");
            room:json.getstr(row;"room")
          };
          role:json.getstr(row;"role");
          content:json.getstr(row;"content");
          sessionid:json.getstr(row;"session_id");
          modelid:json.getstr(row;"model_id");
          tokens:json.getint(row;"tokens");
          sensitivity:sensitivity;
          createdat:json.getstr(row;"created_at")
        }
      };
      <$ok(drawers)
    };
    $err:e <$err($storageerr("failed to list drawers"))
  }
};








f=classifylocation(content:str;role:str):i64{
  let lower=str.tolower(content);
  if(str.contains(lower;"code")){
    <$palacelocation{wing:"technical";hall:"Code";room:"general"}
  }el{
    if(str.contains(lower;"function")){
      <$palacelocation{wing:"technical";hall:"Code";room:"general"}
    }el{
      if(str.contains(lower;"bug")){
        <$palacelocation{wing:"technical";hall:"Code";room:"general"}
      }el{
        if(str.contains(lower;"error")){
          <$palacelocation{wing:"technical";hall:"Code";room:"general"}
        }el{
          if(str.contains(lower;"class")){
            <$palacelocation{wing:"technical";hall:"Code";room:"general"}
          }el{
            if(str.contains(lower;"test")){
              <$palacelocation{wing:"technical";hall:"Code";room:"general"}
            }el{
              if(str.contains(lower;"meeting")){
                <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
              }el{
                if(str.contains(lower;"standup")){
                  <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
                }el{
                  if(str.contains(lower;"review")){
                    <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
                  }el{
                    if(str.contains(lower;"project")){
                      <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                    }el{
                      if(str.contains(lower;"task")){
                        <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                      }el{
                        if(str.contains(lower;"sprint")){
                          <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                        }el{
                          if(str.contains(lower;"milestone")){
                            <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                          }el{
                            if(str.contains(lower;"research")){
                              <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                            }el{
                              if(str.contains(lower;"paper")){
                                <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                              }el{
                                if(str.contains(lower;"study")){
                                  <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                                }el{
                                  <$palacelocation{wing:"work";hall:"general";room:"general"}
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};


f=storeturn(palace:i64;role:str;content:str;sessionid:str;modelid:str;tokens:u32;sensitivity:$sensitivitylevel):void|$lokeerr{
  let location=classifylocation(content;role);
  let id=str.randhex(16);
  let drawer=$drawer{
    id:id;
    location:location;
    role:role;
    content:content;
    sessionid:sessionid;
    modelid:modelid;
    tokens:tokens;
    sensitivity:sensitivity;
    createdat:""
  };
  storedrawer(palace;drawer)
};



f=storecloset(palace:i64;closet:i64):void|$lokeerr{
  let idsjoined=str.concat(""; closet.drawerids.join(","));
  mt db.execparams(
    palace.conn;
    "INSERT INTO memory_closets (id,wing,hall,room,aaak_summary,drawer_ids,created_at) VALUES (?,?,?,?,?,?,'now()')";
    @(
      closet.id;
      closet.location.wing;
      closet.location.hall;
      closet.location.room;
      closet.aaaksummary;
      idsjoined
    )
  ) {
    $ok: {
      log.debug(str.concat("stored closet: ";closet.id);"storage";"system");
      <$ok(void)
    };
    $err:e <$err($storageerr(str.concat("failed to store closet: ";closet.id)))
  }
};

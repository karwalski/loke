m=core.memory.storage;



i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=memtypes:core.memory.types;


f=storedrawerok(drawerid:str):i64!$lokeerr{
  log.debug(str.concat("stored drawer: ";drawerid);"storage";"system");
  <$ok(1)
};

f=storeclosetok(closetid:str):i64!$lokeerr{
  log.debug(str.concat("stored closet: ";closetid);"storage";"system");
  <$ok(1)
};

f=storedrawer(palace:i64;drawer:$drawer):i64!$lokeerr{
  let tokenss=str.fromint(drawer.tokens);
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let sensitivityv:$sensitivitylevel=drawer.sensitivity;
  let sensitivitys=mt sensitivityv {
    $public:v       "PUBLIC";
    $internal:v     "INTERNAL";
    $confidential:v "CONFIDENTIAL";
    $restricted:v   "RESTRICTED"
  };
  (* M1.7a — the drawer and its `memory_scores` row are written in ONE transaction, so a
     drawer can never exist without a score. Until 2026-09-24 nothing on the write path
     inserted into memory_scores at all: core.memory.privacy.forgetpii (`WHERE pii_flagged=1`)
     could never match and the decay sweep had nothing to sweep.

     pii_flagged is set HERE, from the sensitivity the caller already classified, and not by a
     later pass: a later pass is a window in which a PII-bearing memory is not flagged and
     "forget my personal data" misses it. CONFIDENTIAL and RESTRICTED are flagged; INTERNAL is
     organisational rather than personal and is not.

     created_at is bound as epoch SECONDS, not left to the column default. decay.sweeprows reads
     it with rowi64, and a datetime TEXT reads as its leading digits — 2026, i.e. 1970 plus
     half an hour — so every row would be maximally aged the moment it was written. *)
  let pii=mut."0";
  if(str.eq(sensitivitys;"CONFIDENTIAL") | str.eq(sensitivitys;"RESTRICTED")){ pii="1" }el{};
  if(execok("BEGIN";@())){
    <storedrawertx(drawer;tokenss;sensitivitys;pii)
  }el{
    <drawerfail("failed to begin drawer transaction: ";drawer.id)
  }
};

(* `datetime('now')`, not `'now()'` — GA5.1. Every drawer and every closet in the memory
   palace recorded its creation time as five literal characters, which is why
   core.memory.decay had nothing to age: decay selects by created_at, and every row's was
   the same non-date string. *)
f=storedrawertx(drawer:$drawer;tokenss:str;sensitivitys:str;pii:str):i64!$lokeerr{
  let drawerok=execok("INSERT INTO memory_drawers (id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,datetime('now'))";@(drawer.id;drawer.location.wing;drawer.location.hall;drawer.location.room;drawer.role;drawer.content;drawer.sessionid;drawer.modelid;tokenss;sensitivitys));
  let scoreok=mut.false;
  if(drawerok){
    scoreok=execok("INSERT INTO memory_scores (id,score,tags,pii_flagged,created_at) VALUES (?,1.0,'',?,?)";@(drawer.id;pii;nowsecs()))
  }el{};
  if(drawerok & scoreok){
    if(execok("COMMIT";@())){
      <storedrawerok(drawer.id)
    }el{
      execok("ROLLBACK";@());
      <drawerfail("failed to commit drawer: ";drawer.id)
    }
  }el{
    execok("ROLLBACK";@());
    <drawerfail("failed to store drawer: ";drawer.id)
  }
};

f=execok(sql:str;params:@str):bool{
  <mt db.exec(sql;params) {
    $ok:v true;
    $err:e false
  }
};

(* Epoch seconds as a declared `str`. `str.fromint`, not `str.fromi64`: a
   `let s:str=str.fromi64(...)` binding written as an array element is compiled as a spread
   and dropped, so the INSERT bound NULL into a NOT NULL column and failed (LS1.1s, T-46). *)
f=nowsecs():str{
  <str.fromint(t.nowi64())
};

f=drawerfail(what:str;id:str):i64!$lokeerr{
  <$err($storageerr(str.concat(what;id)))
};


f=parsedrawerrows(rows:@$row;id:str):$drawer!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("drawer not found: ";id)))
  }el{
    let row=rows.get(0);
    let sensitivitystr=db.rowstr(row;"sensitivity");
    let sensitivity=mut.$sensitivitylevel{$public:0};
    if(str.eq(sensitivitystr;"RESTRICTED")){
      sensitivity=$sensitivitylevel{$restricted:0}
    }el{
      if(str.eq(sensitivitystr;"CONFIDENTIAL")){
        sensitivity=$sensitivitylevel{$confidential:0}
      }el{
        if(str.eq(sensitivitystr;"INTERNAL")){
          sensitivity=$sensitivitylevel{$internal:0}
        }el{}
      }
    };
    <$ok($drawer{
      id:db.rowstr(row;"id");
      location:$palacelocation{
        wing:db.rowstr(row;"wing");
        hall:db.rowstr(row;"hall");
        room:db.rowstr(row;"room")
      };
      role:db.rowstr(row;"role");
      content:db.rowstr(row;"content");
      sessionid:db.rowstr(row;"session_id");
      modelid:db.rowstr(row;"model_id");
      tokens:db.rowi64(row;"tokens");
      sensitivity:sensitivity;
      createdat:db.rowstr(row;"created_at")
    })
  }
};

f=getdrawer(palace:i64;id:str):$drawer!$lokeerr{
  <mt db.many("SELECT id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at FROM memory_drawers WHERE id=?";@(id)) {
    $ok:rows parsedrawerrows(rows;id);
    $err:e $err($storageerr(str.concat("db error fetching drawer: ";id)))
  }
};


(* M1.7d — each drawer is PUSHED and the push is assigned (T-24). Until 2026-09-24 the
   literal below was a bare expression in the loop body, so every listing was the empty
   array this starts as, whatever the table held. *)
f=parselistdrawerrows(rows:@$row):@($drawer)!$lokeerr{
  let drawers=mut.@();
  lp(let ii1=0;ii1<rows.len;ii1=ii1+1){
    let row=rows.get(ii1);
    let sensitivitystr=db.rowstr(row;"sensitivity");
    let sensitivity=mut.$sensitivitylevel{$public:0};
    if(str.eq(sensitivitystr;"RESTRICTED")){
      sensitivity=$sensitivitylevel{$restricted:0}
    }el{
      if(str.eq(sensitivitystr;"CONFIDENTIAL")){
        sensitivity=$sensitivitylevel{$confidential:0}
      }el{
        if(str.eq(sensitivitystr;"INTERNAL")){
          sensitivity=$sensitivitylevel{$internal:0}
        }el{}
      }
    };
    drawers=drawers.push($drawer{
      id:db.rowstr(row;"id");
      location:$palacelocation{
        wing:db.rowstr(row;"wing");
        hall:db.rowstr(row;"hall");
        room:db.rowstr(row;"room")
      };
      role:db.rowstr(row;"role");
      content:db.rowstr(row;"content");
      sessionid:db.rowstr(row;"session_id");
      modelid:db.rowstr(row;"model_id");
      tokens:db.rowi64(row;"tokens");
      sensitivity:sensitivity;
      createdat:db.rowstr(row;"created_at")
    })
  };
  <$ok(drawers)
};

f=listdrawers(palace:i64;location:$palacelocation;limit:u32):@($drawer)!$lokeerr{
  let limits=str.fromint(limit);
  let sql=str.concat("SELECT id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at FROM memory_drawers WHERE wing=? AND hall=? AND room=? ORDER BY created_at DESC LIMIT ";limits);
  <mt db.many(sql;@(location.wing;location.hall;location.room)) {
    $ok:rows parselistdrawerrows(rows);
    $err:e $err($storageerr("failed to list drawers"))
  }
};








f=classifylocation(content:str;role:str):$palacelocation{
  let lower=str.tolower(content);
  if(str.contains(lower;"code")){
    <$palacelocation{wing:"technical";hall:"Code";room:"general"}
  }el{
    if(str.contains(lower;"function")){
      <$palacelocation{wing:"technical";hall:"Code";room:"general"}
    }el{
      if(str.contains(lower;"bug")){
        <$palacelocation{wing:"technical";hall:"Code";room:"general"}
      }el{
        if(str.contains(lower;"error")){
          <$palacelocation{wing:"technical";hall:"Code";room:"general"}
        }el{
          if(str.contains(lower;"class")){
            <$palacelocation{wing:"technical";hall:"Code";room:"general"}
          }el{
            if(str.contains(lower;"test")){
              <$palacelocation{wing:"technical";hall:"Code";room:"general"}
            }el{
              if(str.contains(lower;"meeting")){
                <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
              }el{
                if(str.contains(lower;"standup")){
                  <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
                }el{
                  if(str.contains(lower;"review")){
                    <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
                  }el{
                    if(str.contains(lower;"project")){
                      <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                    }el{
                      if(str.contains(lower;"task")){
                        <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                      }el{
                        if(str.contains(lower;"sprint")){
                          <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                        }el{
                          if(str.contains(lower;"milestone")){
                            <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                          }el{
                            if(str.contains(lower;"research")){
                              <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                            }el{
                              if(str.contains(lower;"paper")){
                                <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                              }el{
                                if(str.contains(lower;"study")){
                                  <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                                }el{
                                  <$palacelocation{wing:"work";hall:"general";room:"general"}
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};


f=storeturn(palace:i64;role:str;content:str;sessionid:str;modelid:str;tokens:u32;sensitivity:$sensitivitylevel):$drawer!$lokeerr{
  let location=classifylocation(content;role);
  let id=str.randhex(16);
  let drawer=$drawer{
    id:id;
    location:location;
    role:role;
    content:content;
    sessionid:sessionid;
    modelid:modelid;
    tokens:tokens;
    sensitivity:sensitivity;
    createdat:""
  };
  <mt storedrawer(palace;drawer) {
    $ok:v $ok(drawer);
    $err:e $err(e)
  }
};



f=storecloset(palace:i64;closet:i64):i64!$lokeerr{
  let idsjoined=str.concat(""; closet.drawerids.join(","));
  <mt db.exec("INSERT INTO memory_closets (id,wing,hall,room,aaak_summary,drawer_ids,created_at) VALUES (?,?,?,?,?,?,datetime('now'))";@(closet.id;closet.location.wing;closet.location.hall;closet.location.room;closet.aaaksummary;idsjoined)) {
    $ok:v storeclosetok(closet.id);
    $err:e $err($storageerr(str.concat("failed to store closet: ";closet.id)))
  }
};

m=core.memory.storage;



i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=t:shared.types;
i=memtypes:core.memory.types;


f=storedrawerok(drawerid:str):i64!$lokeerr{
  log.debug(str.concat("stored drawer: ";drawerid);"storage";"system");
  <$ok(1)
};

f=storeclosetok(closetid:str):i64!$lokeerr{
  log.debug(str.concat("stored closet: ";closetid);"storage";"system");
  <$ok(1)
};

f=storedrawer(palace:i64;drawer:i64):i64!$lokeerr{
  let tokenss=str.fromint(drawer.tokens);
  let sensitivitys=mt drawer.sensitivity {
    $public:v       "PUBLIC";
    $internal:v     "INTERNAL";
    $confidential:v "CONFIDENTIAL";
    $restricted:v   "RESTRICTED"
  };
  mt db.exec("INSERT INTO memory_drawers (id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,'now()')";@(drawer.id;drawer.location.wing;drawer.location.hall;drawer.location.room;drawer.role;drawer.content;drawer.sessionid;drawer.modelid;tokenss;sensitivitys)) {
    $ok:v storedrawerok(drawer.id);
    $err:e $err($storageerr(str.concat("failed to store drawer: ";drawer.id)))
  }
};


f=parsedrawerrows(rows:@$row;id:str):i64!$lokeerr{
  if(rows.len == 0){
    <$err($storageerr(str.concat("drawer not found: ";id)))
  }el{
    let row=rows.get(0);
    let sensitivitystr=db.rowstr(row;"sensitivity");
    let sensitivity=mut.$public;
    if(str.eq(sensitivitystr;"RESTRICTED")){
      sensitivity=$restricted
    }el{
      if(str.eq(sensitivitystr;"CONFIDENTIAL")){
        sensitivity=$confidential
      }el{
        if(str.eq(sensitivitystr;"INTERNAL")){
          sensitivity=$internal
        }el{}
      }
    };
    <$ok($drawer{
      id:db.rowstr(row;"id");
      location:$drawerlocation{
        wing:db.rowstr(row;"wing");
        hall:db.rowstr(row;"hall");
        room:db.rowstr(row;"room")
      };
      role:db.rowstr(row;"role");
      content:db.rowstr(row;"content");
      sessionid:db.rowstr(row;"session_id");
      modelid:db.rowstr(row;"model_id");
      tokens:db.rowi64(row;"tokens");
      sensitivity:sensitivity;
      createdat:db.rowstr(row;"created_at")
    })
  }
};

f=getdrawer(palace:i64;id:str):i64!$lokeerr{
  mt db.many("SELECT id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at FROM memory_drawers WHERE id=?";@($id)) {
    $ok:rows parsedrawerrows(rows;id);
    $err:e $err($storageerr(str.concat("db error fetching drawer: ";id)))
  }
};


f=parselistdrawerrows(rows:@$row):@($drawer)!$lokeerr{
  let drawers=@();
  lp(let ii1=0;ii1<rows.len;ii1=ii1+1){
    let row=rows.get(ii1);
    let sensitivitystr=db.rowstr(row;"sensitivity");
    let sensitivity=mut.$public;
    if(str.eq(sensitivitystr;"RESTRICTED")){
      sensitivity=$restricted
    }el{
      if(str.eq(sensitivitystr;"CONFIDENTIAL")){
        sensitivity=$confidential
      }el{
        if(str.eq(sensitivitystr;"INTERNAL")){
          sensitivity=$internal
        }el{}
      }
    };
    $drawer{
      id:db.rowstr(row;"id");
      location:$drawerlocation{
        wing:db.rowstr(row;"wing");
        hall:db.rowstr(row;"hall");
        room:db.rowstr(row;"room")
      };
      role:db.rowstr(row;"role");
      content:db.rowstr(row;"content");
      sessionid:db.rowstr(row;"session_id");
      modelid:db.rowstr(row;"model_id");
      tokens:db.rowi64(row;"tokens");
      sensitivity:sensitivity;
      createdat:db.rowstr(row;"created_at")
    }
  };
  <$ok(drawers)
};

f=listdrawers(palace:i64;location:i64;limit:u32):@($drawer)!$lokeerr{
  let limits=str.fromint(limit);
  let sql=str.concat("SELECT id,wing,hall,room,role,content,session_id,model_id,tokens,sensitivity,created_at FROM memory_drawers WHERE wing=? AND hall=? AND room=? ORDER BY created_at DESC LIMIT ";limits);
  mt db.many(sql;@(location.wing;location.hall;location.room)) {
    $ok:rows parselistdrawerrows(rows);
    $err:e $err($storageerr("failed to list drawers"))
  }
};








f=classifylocation(content:str;role:str):$palacelocation{
  let lower=str.tolower(content);
  if(str.contains(lower;"code")){
    <$palacelocation{wing:"technical";hall:"Code";room:"general"}
  }el{
    if(str.contains(lower;"function")){
      <$palacelocation{wing:"technical";hall:"Code";room:"general"}
    }el{
      if(str.contains(lower;"bug")){
        <$palacelocation{wing:"technical";hall:"Code";room:"general"}
      }el{
        if(str.contains(lower;"error")){
          <$palacelocation{wing:"technical";hall:"Code";room:"general"}
        }el{
          if(str.contains(lower;"class")){
            <$palacelocation{wing:"technical";hall:"Code";room:"general"}
          }el{
            if(str.contains(lower;"test")){
              <$palacelocation{wing:"technical";hall:"Code";room:"general"}
            }el{
              if(str.contains(lower;"meeting")){
                <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
              }el{
                if(str.contains(lower;"standup")){
                  <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
                }el{
                  if(str.contains(lower;"review")){
                    <$palacelocation{wing:"work";hall:"Meetings";room:"general"}
                  }el{
                    if(str.contains(lower;"project")){
                      <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                    }el{
                      if(str.contains(lower;"task")){
                        <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                      }el{
                        if(str.contains(lower;"sprint")){
                          <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                        }el{
                          if(str.contains(lower;"milestone")){
                            <$palacelocation{wing:"work";hall:"Projects";room:"general"}
                          }el{
                            if(str.contains(lower;"research")){
                              <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                            }el{
                              if(str.contains(lower;"paper")){
                                <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                              }el{
                                if(str.contains(lower;"study")){
                                  <$palacelocation{wing:"technical";hall:"Research";room:"general"}
                                }el{
                                  <$palacelocation{wing:"work";hall:"general";room:"general"}
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};


f=storeturn(palace:i64;role:str;content:str;sessionid:str;modelid:str;tokens:u32;sensitivity:$sensitivitylevel):$drawer!$lokeerr{
  let location=classifylocation(content;role);
  let id=str.randhex(16);
  let drawer=$drawer{
    id:id;
    location:location;
    role:role;
    content:content;
    sessionid:sessionid;
    modelid:modelid;
    tokens:tokens;
    sensitivity:sensitivity;
    createdat:""
  };
  storedrawer(palace;drawer)
};



f=storecloset(palace:i64;closet:i64):i64!$lokeerr{
  let idsjoined=str.concat(""; closet.drawerids.join(","));
  mt db.exec("INSERT INTO memory_closets (id,wing,hall,room,aaak_summary,drawer_ids,created_at) VALUES (?,?,?,?,?,?,'now()')";@(closet.id;closet.location.wing;closet.location.hall;closet.location.room;closet.aaaksummary;idsjoined)) {
    $ok:v storeclosetok(closet.id);
    $err:e $err($storageerr(str.concat("failed to store closet: ";closet.id)))
  }
};

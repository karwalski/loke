m=core.memory.graph;




i=memtypes:core.memory.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;

t=$entity{
  id:str;
  name:str;
  kind:str;
  summary:str;
  confidence:f32;
  createdat:i64
};

t=$relation{
  fromid:str;
  toid:str;
  kind:str;
  weight:f32;
  createdat:i64
};

t=$graphresult{
  entities:@$entity;
  relations:@$relation
};


f=upsertentity(palace:i64;e:$entity):bool{
  let confs=str.fromfloat(e.confidence);
  let tss=str.fromint(e.createdat);
  let ok=mt db.execparams(
    palace.conn;
    "INSERT OR REPLACE INTO memory_graph_entities (id,name,kind,summary,confidence,created_at) VALUES (?,?,?,?,?,?)";
    @(e.id;e.name;e.kind;e.summary;confs;tss)
  ) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.debug(str.concat("upserted entity: ";e.id);"graph";"system")
  }el{
    log.warn(str.concat("failed to upsert entity: ";e.id);"graph";"system")
  };
  <ok
};


f=addrelation(palace:i64;r:$relation):bool{
  let weights=str.fromfloat(r.weight);
  let tss=str.fromint(r.createdat);
  let ok=mt db.execparams(
    palace.conn;
    "INSERT INTO memory_graph_relations (from_id,to_id,kind,weight,created_at) VALUES (?,?,?,?,?)";
    @(r.fromid;r.toid;r.kind;weights;tss)
  ) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.debug(str.concat("added relation: ";str.concat(r.fromid;str.concat(" -[";str.concat(r.kind;str.concat("]-> ";r.toid)))));"graph";"system")
  }el{
    log.warn("failed to add relation";"graph";"system")
  };
  <ok
};


f=idsfromrows(rows:@($row)):@str{
  let ids=mut.@();
  lp(let i=0;i<str.arraylen(rows);i=i+1){ let row=str.arrayget(rows;i);
    ids=ids.append(json.str(row;"id"))
  };
  <ids
};


f=alreadyvisited(visited:@str;id:str):bool{
  let found=mut.false;
  lp(let ii85=0;ii85<visited.len;ii85=ii85+1){
    let v=visited.get(ii85);
    if(str.eq(v;id)){
      found=true
    };

  };
  <found
};


f=entityfromrow(row:i64):$entity{
  <$entity{
    id:json.str(row;"id");
    name:json.str(row;"name");
    kind:json.str(row;"kind");
    summary:json.str(row;"summary");
    confidence:json.getfloat(row;"confidence");
    createdat:json.i64(row;"created_at")
  }
};


f=relationfromrow(row:i64):$relation{
  <$relation{
    fromid:json.str(row;"from_id");
    toid:json.str(row;"to_id");
    kind:json.str(row;"kind");
    weight:json.getfloat(row;"weight");
    createdat:json.i64(row;"created_at")
  }
};



f=neighbours(palace:i64;entityid:str;depth:i32):$graphresult{
  let entities=mut.@();
  let relations=mut.@();
  let visited=mut.@($entityid);
  let frontier=mut.@($entityid);

  
  let qresult=mt db.queryparams(
    palace.conn;
    "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";
    @($entityid)
  ) {
    $ok:rows rows;
    $err:v @()
  };
  if(qresult.len > 0){
    entities=entities.append(entityfromrow(qresult.get(0)))
  };

  let remaining=mut.depth;
  let continue=mut.true;
  
  lp(let lv=0;continue;lv=lv){
    if(!(remaining>0)){
      continue=false
    }el{
      let nextfrontier=mut.@();
      lp(let ii148=0;ii148<frontier.len;ii148=ii148+1){
        let fid=frontier.get(ii148);

        let relrows=mt db.queryparams(
          palace.conn;
          "SELECT from_id,to_id,kind,weight,created_at FROM memory_graph_relations WHERE from_id=?";
          @($fid)
        ) {
          $ok:relrows relrows;
          $err:v @()
        };
        lp(let ii1=0;ii1<relrows.len;ii1=ii1+1){
          let rrow=relrows.get(ii1);
          let rel=relationfromrow(rrow);
          relations=relations.append(rel);
          let avisited=mut.false;
          lp(let vv=0;vv<visited.len;vv=vv+1){
            if(str.eq(visited.get(vv);rel.toid)){ avisited=true }el{}
          };
          if(!avisited){
            visited=visited.append(rel.toid);
            nextfrontier=nextfrontier.append(rel.toid);
            let eresult=mt db.queryparams(
              palace.conn;
              "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";
              @(rel.toid)
            ) {
              $ok:erows erows;
              $err:v @()
            };
            if(eresult.len > 0){
              entities=entities.append(entityfromrow(eresult.get(0)))
            }
          }
        };

        let relrows2=mt db.queryparams(
          palace.conn;
          "SELECT from_id,to_id,kind,weight,created_at FROM memory_graph_relations WHERE to_id=?";
          @($fid)
        ) {
          $ok:relrows relrows;
          $err:v @()
        };
        lp(let ii2=0;ii2<relrows2.len;ii2=ii2+1){
          let rrow=relrows2.get(ii2);
          let rel=relationfromrow(rrow);
          relations=relations.append(rel);
          let avisited2=mut.false;
          lp(let vv2=0;vv2<visited.len;vv2=vv2+1){
            if(str.eq(visited.get(vv2);rel.fromid)){ avisited2=true }el{}
          };
          if(!avisited2){
            visited=visited.append(rel.fromid);
            nextfrontier=nextfrontier.append(rel.fromid);
            let eresult2=mt db.queryparams(
              palace.conn;
              "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";
              @(rel.fromid)
            ) {
              $ok:erows erows;
              $err:v @()
            };
            if(eresult2.len > 0){
              entities=entities.append(entityfromrow(eresult2.get(0)))
            }
          }
        }

      };
      frontier=nextfrontier;
      remaining=remaining - 1
    }
  };

  <$graphresult{entities:entities;relations:relations}
};


f=searchentities(palace:i64;query:str):@$entity{
  let likeq=str.concat("%";str.concat(query;"%"));
  let searchresult=mt db.queryparams(
    palace.conn;
    "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE name LIKE ? OR summary LIKE ? ORDER BY confidence DESC";
    @(likeq;likeq)
  ) {
    $ok:rows rows;
    $err:v @()
  };
  let mapped=mut.@();
  lp(let ii228=0;ii228<searchresult.len;ii228=ii228+1){
    let row=searchresult.get(ii228);
    mapped=mapped.push(entityfromrow(row))
  };
  <mapped
};


f=deleteentity(palace:i64;id:str):bool{
  mt db.execparams(
    palace.conn;
    "DELETE FROM memory_graph_relations WHERE from_id=? OR to_id=?";
    @(id;id)
  ) {
    $ok:v void;
    $err:v log.warn(str.concat("failed to delete relations for entity: ";id);"graph";"system")
  };
  let ok=mt db.execparams(
    palace.conn;
    "DELETE FROM memory_graph_entities WHERE id=?";
    @($id)
  ) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.info(str.concat("deleted entity: ";id);"graph";"system")
  }el{
    log.warn(str.concat("failed to delete entity: ";id);"graph";"system")
  };
  <ok
};

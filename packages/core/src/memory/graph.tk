m=core.memory.graph;




i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=s:core.storage.db;

t=$entity{
  id:str;
  name:str;
  kind:str;
  summary:str;
  confidence:f32;
  createdat:i64
};

t=$relation{
  fromid:str;
  toid:str;
  kind:str;
  weight:f32;
  createdat:i64;
  validto:str
};

t=$graphresult{
  entities:@$entity;
  relations:@$relation
};


f=upsertentity(palace:i64;e:$entity):bool{
  let confs=str.fromfloat(e.confidence);
  let tss=str.fromint(e.createdat);
  let ok=mt db.exec("INSERT OR REPLACE INTO memory_graph_entities (id,name,kind,summary,confidence,created_at) VALUES (?,?,?,?,?,?)";@(e.id;e.name;e.kind;e.summary;confs;tss)) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.debug(str.concat("upserted entity: ";e.id);"graph";"system")
  }el{
    log.warn(str.concat("failed to upsert entity: ";e.id);"graph";"system")
  };
  <ok
};


f=addrelation(palace:i64;r:$relation):bool{
  let weights=str.fromfloat(r.weight);
  let tss=str.fromint(r.createdat);
  let ok=mt db.exec("INSERT INTO memory_graph_relations (from_id,to_id,kind,weight,created_at,valid_to) VALUES (?,?,?,?,?,?)";@(r.fromid;r.toid;r.kind;weights;tss;r.validto)) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.debug(str.concat("added relation: ";str.concat(r.fromid;str.concat(" -[";str.concat(r.kind;str.concat("]-> ";r.toid)))));"graph";"system")
  }el{
    log.warn("failed to add relation";"graph";"system")
  };
  <ok
};


f=idsfromrows(rows:@$row):@str{
  let ids=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row:$row=rows.get(i);
    ids=ids.push(s.rowstr(row;"id"))
  };
  <ids
};


f=alreadyvisited(visited:@str;id:str):bool{
  let found=mut.false;
  lp(let ii85=0;ii85<visited.len;ii85=ii85+1){
    if(str.eq(visited.get(ii85);id)){
      found=true
    };

  };
  <found
};


(* The accessors are core.storage.db's row.* wrappers, not std.json's. db.many returns
   [$row], and both mappers below read every field with json.str / json.getfloat /
   json.i64 against a row handle, which is not a JSON object: every entity and every
   relation came back with empty id, name, kind and summary and zero confidence, weight
   and created_at. neighbours, searchentities and every caller of them therefore
   returned the right NUMBER of results with no content in any of them, silently. The
   row parameter was also declared i64 rather than $row, which is what let the
   mismatch through.

   confidence and weight are written with str.fromfloat and read back as HUNDREDTHS in
   an i64 (T-22, and T-20 for f64 across a module boundary), so the division happens
   here, after the crossing. *)
f=entityfromrow(row:$row):$entity{
  <$entity{
    id:s.rowstr(row;"id");
    name:s.rowstr(row;"name");
    kind:s.rowstr(row;"kind");
    summary:s.rowstr(row;"summary");
    confidence:((s.rowf64hundredths(row;"confidence") as f64) / 100.0) as f32;
    createdat:s.rowi64(row;"created_at")
  }
};


f=relationfromrow(row:$row):$relation{
  <$relation{
    fromid:s.rowstr(row;"from_id");
    toid:s.rowstr(row;"to_id");
    kind:s.rowstr(row;"kind");
    weight:((s.rowf64hundredths(row;"weight") as f64) / 100.0) as f32;
    createdat:s.rowi64(row;"created_at");
    validto:s.rowstr(row;"valid_to")
  }
};



f=neighbours(palace:i64;entityid:str;depth:i32):$graphresult{
  let entities=mut.@();
  let relations=mut.@();
  let visited=mut.@(entityid);
  let frontier=mut.@(entityid);

  
  let qresult=mt db.many("SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";@(entityid)) {
    $ok:rows rows;
    $err:v @()
  };
  if(qresult.len > 0){
    entities=entities.append(entityfromrow(qresult.get(0)))
  };

  let remaining=mut.depth;
  let continue=mut.true;
  
  lp(let lv=0;continue;lv=lv){
    if(!(remaining>0)){
      continue=false
    }el{
      let nextfrontier=mut.@();
      lp(let ii148=0;ii148<frontier.len;ii148=ii148+1){
        let fid=frontier.get(ii148);

        let relrows=mt db.many("SELECT from_id,to_id,kind,weight,created_at,valid_to FROM memory_graph_relations WHERE from_id=?";@(fid)) {
          $ok:relrows relrows;
          $err:v @()
        };
        lp(let ii1=0;ii1<relrows.len;ii1=ii1+1){
          let rrow=relrows.get(ii1);
          let rel=relationfromrow(rrow);
          relations=relations.append(rel);
          let avisited=mut.false;
          lp(let vv=0;vv<visited.len;vv=vv+1){
            if(str.eq(visited.get(vv);rel.toid)){ avisited=true }el{}
          };
          if(!avisited){
            visited=visited.append(rel.toid);
            nextfrontier=nextfrontier.append(rel.toid);
            let eresult=mt db.many("SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";@(rel.toid)) {
              $ok:erows erows;
              $err:v @()
            };
            if(eresult.len > 0){
              entities=entities.append(entityfromrow(eresult.get(0)))
            }
          }
        };

        let relrows2=mt db.many("SELECT from_id,to_id,kind,weight,created_at,valid_to FROM memory_graph_relations WHERE to_id=?";@(fid)) {
          $ok:relrows relrows;
          $err:v @()
        };
        lp(let ii2=0;ii2<relrows2.len;ii2=ii2+1){
          let rrow=relrows2.get(ii2);
          let rel=relationfromrow(rrow);
          relations=relations.append(rel);
          let avisited2=mut.false;
          lp(let vv2=0;vv2<visited.len;vv2=vv2+1){
            if(str.eq(visited.get(vv2);rel.fromid)){ avisited2=true }el{}
          };
          if(!avisited2){
            visited=visited.append(rel.fromid);
            nextfrontier=nextfrontier.append(rel.fromid);
            let eresult2=mt db.many("SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";@(rel.fromid)) {
              $ok:erows erows;
              $err:v @()
            };
            if(eresult2.len > 0){
              entities=entities.append(entityfromrow(eresult2.get(0)))
            }
          }
        }

      };
      frontier=nextfrontier;
      remaining=remaining - 1
    }
  };

  <$graphresult{entities:entities;relations:relations}
};


(* ── T6.2: filter by relation kind, contradictions, DOT ─────────────────────────── *)
f=relationsfrom(sqltext:str;params:@str):@$relation{
  let rows=mt db.many(sqltext;params) {
    $ok:rs rs;
    $err:e @()
  };
  let out=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row:$row=rows.get(i);
    out=out.push(relationfromrow(row))
  };
  <out
};

(* The relations of one kind that touch an entity, from either end. *)
f=relationsofkind(palace:i64;entityid:str;kind:str):@$relation{
  <relationsfrom("SELECT from_id,to_id,kind,weight,created_at,valid_to FROM memory_graph_relations WHERE kind=? AND (from_id=? OR to_id=?) ORDER BY rowid";@(kind;entityid;entityid))
};

(* For a relation kind that holds towards one target at a time (employed_by, lives_in), the
   relations of that kind whose subject has MORE THAN ONE target still holding ('' valid_to):
   the graph says both are true at once. A relation that has ended does not conflict with
   its successor. The caller names the kind, because only it knows which kinds are
   single-valued: `knows` towards many people is not a contradiction. The table's primary key
   is (from, to, kind), so the same relation cannot be recorded twice. *)
f=contradictions(palace:i64;kind:str):@$relation{
  <relationsfrom("SELECT r.from_id,r.to_id,r.kind,r.weight,r.created_at,r.valid_to FROM memory_graph_relations r WHERE r.kind=? AND r.valid_to='' AND EXISTS (SELECT 1 FROM memory_graph_relations o WHERE o.from_id=r.from_id AND o.kind=r.kind AND o.to_id<>r.to_id AND o.valid_to='') ORDER BY r.rowid";@(kind))
};

f=dotid(s:str):str{
  <str.concat("\"";str.concat(str.replace(str.replace(s;"\\";"\\\\");"\"";"\\\"");"\""))
};

(* Graphviz DOT for a graph result: every entity a node labelled with its name, every
   relation an edge labelled with its kind. Identifiers are quoted and escaped. *)
f=visualisedot(g:$graphresult):str{
  let out=mut."digraph memory {\n";
  lp(let i=0;i<g.entities.len;i=i+1){
    let e:$entity=g.entities.get(i);
    out=str.concat(out;str.concat("  ";str.concat(dotid(e.id);str.concat(" [label=";str.concat(dotid(e.name);"];\n")))))
  };
  lp(let j=0;j<g.relations.len;j=j+1){
    let r:$relation=g.relations.get(j);
    out=str.concat(out;str.concat("  ";str.concat(dotid(r.fromid);str.concat(" -> ";str.concat(dotid(r.toid);str.concat(" [label=";str.concat(dotid(r.kind);"];\n")))))))
  };
  <str.concat(out;"}\n")
};

f=searchentities(palace:i64;query:str):@$entity{
  let likeq=str.concat("%";str.concat(query;"%"));
  let searchresult=mt db.many("SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE name LIKE ? OR summary LIKE ? ORDER BY confidence DESC";@(likeq;likeq)) {
    $ok:rows rows;
    $err:v @()
  };
  let mapped=mut.@();
  lp(let ii228=0;ii228<searchresult.len;ii228=ii228+1){
    mapped=mapped.push(entityfromrow(searchresult.get(ii228)))
  };
  <mapped
};


f=deleteentity(palace:i64;id:str):bool{
  mt db.exec("DELETE FROM memory_graph_relations WHERE from_id=? OR to_id=?";@(id;id)) {
    $ok:v void;
    $err:v log.warn(str.concat("failed to delete relations for entity: ";id);"graph";"system")
  };
  let ok=mt db.exec("DELETE FROM memory_graph_entities WHERE id=?";@(id)) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.info(str.concat("deleted entity: ";id);"graph";"system")
  }el{
    log.warn(str.concat("failed to delete entity: ";id);"graph";"system")
  };
  <ok
};

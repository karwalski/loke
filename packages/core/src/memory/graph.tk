m=core.memory.graph;




i=memtypes:core.memory.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;

t=$entity{
  id:str;
  name:str;
  kind:str;
  summary:str;
  confidence:f32;
  createdat:i64
};

t=$relation{
  fromid:str;
  toid:str;
  kind:str;
  weight:f32;
  createdat:i64
};

t=$graphresult{
  entities:@$entity;
  relations:@$relation
};


f=upsertentity(palace:$memtypes.palace;e:$entity):bool{
  let confs=str.fromfloat(e.confidence);
  let tss=str.fromint(e.createdat);
  mt db.execparams(
    palace.conn;
    "INSERT OR REPLACE INTO memory_graph_entities (id,name,kind,summary,confidence,created_at) VALUES (?,?,?,?,?,?)";
    @(e.id;e.name;e.kind;e.summary;confs;tss)
  ) {
    $ok: {
      log.debug(str.concat("upserted entity: ";e.id);"graph";"system");
      <true
    };
    $err: {
      log.warn(str.concat("failed to upsert entity: ";e.id);"graph";"system");
      <false
    };
  };
};


f=addrelation(palace:$memtypes.palace;r:$relation):bool{
  let weights=str.fromfloat(r.weight);
  let tss=str.fromint(r.createdat);
  mt db.execparams(
    palace.conn;
    "INSERT INTO memory_graph_relations (from_id,to_id,kind,weight,created_at) VALUES (?,?,?,?,?)";
    @(r.fromid;r.toid;r.kind;weights;tss)
  ) {
    $ok: {
      log.debug(str.concat("added relation: ";str.concat(r.fromid;str.concat(" -[";str.concat(r.kind;str.concat("]-> ";r.toid)))));"graph";"system");
      <true
    };
    $err: {
      log.warn("failed to add relation";"graph";"system");
      <false
    };
  };
};


f=idsfromrows(rows:@($json.row)):@str{
  let ids=@();
  rows.each|row{
    let ids=ids.append(json.getstr(row;"id"))
  };
  <ids
};


f=alreadyvisited(visited:@str;id:str):bool{
  let found=false;
  visited.each|v{
    if(str.eq(v;id)){
      let found=true
    };
  };
  <found
};


f=entityfromrow(row:$json.row):$entity{
  <$entity{
    id:json.getstr(row;"id");
    name:json.getstr(row;"name");
    kind:json.getstr(row;"kind");
    summary:json.getstr(row;"summary");
    confidence:json.getfloat(row;"confidence");
    createdat:json.getint(row;"created_at")
  };
};


f=relationfromrow(row:$json.row):$relation{
  <$relation{
    fromid:json.getstr(row;"from_id");
    toid:json.getstr(row;"to_id");
    kind:json.getstr(row;"kind");
    weight:json.getfloat(row;"weight");
    createdat:json.getint(row;"created_at")
  };
};



f=neighbours(palace:$memtypes.palace;entityid:str;depth:i32):$graphresult{
  let entities=@();
  let relations=@();
  let visited=@$entityid;
  let frontier=@$entityid;

  
  mt db.queryparams(
    palace.conn;
    "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";
    @$entityid
  ) {
    $ok:rows {
      if(rows.len > 0){
        let entities=entities.append(entityfromrow(rows.get(0)))
      };
    };
    $err: {};
  };

  let remaining=depth;
  let continue=true;
  
  mt frontier.eachwhile { continue }{
    if(remaining <= 0){
      let continue=false
    }else{
      let nextfrontier=@();
      frontier.each|fid{
        
        mt db.queryparams(
          palace.conn;
          "SELECT from_id,to_id,kind,weight,created_at FROM memory_graph_relations WHERE from_id=?";
          @$fid
        ) {
          $ok:relrows {
            relrows.each|rrow{
              let rel=relationfromrow(rrow);
              let relations=relations.append(rel);
              if(!$alreadyvisited(visited;rel.toid)){
                let visited=visited.append(rel.toid);
                let nextfrontier=nextfrontier.append(rel.toid);
                mt db.queryparams(
                  palace.conn;
                  "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";
                  @(rel.toid)
                ) {
                  $ok:erows {
                    if(erows.len > 0){
                      let entities=entities.append(entityfromrow(erows.get(0)))
                    };
                  };
                  $err: {};
                };
              };
            };
          };
          $err: {};
        };
        
        mt db.queryparams(
          palace.conn;
          "SELECT from_id,to_id,kind,weight,created_at FROM memory_graph_relations WHERE to_id=?";
          @$fid
        ) {
          $ok:relrows {
            relrows.each|rrow{
              let rel=relationfromrow(rrow);
              let relations=relations.append(rel);
              if(!$alreadyvisited(visited;rel.fromid)){
                let visited=visited.append(rel.fromid);
                let nextfrontier=nextfrontier.append(rel.fromid);
                mt db.queryparams(
                  palace.conn;
                  "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE id=?";
                  @(rel.fromid)
                ) {
                  $ok:erows {
                    if(erows.len > 0){
                      let entities=entities.append(entityfromrow(erows.get(0)))
                    };
                  };
                  $err: {};
                };
              };
            };
          };
          $err: {};
        };
      };
      let frontier=nextfrontier;
      let remaining=remaining - 1
    };
  };

  <$graphresult{entities:entities;relations:relations};
};


f=searchentities(palace:$memtypes.palace;query:str):@$entity{
  let likeq=str.concat("%";str.concat(query;"%"));
  mt db.queryparams(
    palace.conn;
    "SELECT id,name,kind,summary,confidence,created_at FROM memory_graph_entities WHERE name LIKE ? OR summary LIKE ? ORDER BY confidence DESC";
    @(likeq;likeq)
  ) {
    $ok:rows {
      let results=rows.map|row{ entityfromrow(row) };
      <results
    };
    $err: {
      log.warn(str.concat("graph entity search failed for: ";query);"graph";"system");
      <@()
    };
  };
};


f=deleteentity(palace:$memtypes.palace;id:str):bool{
  mt db.execparams(
    palace.conn;
    "DELETE FROM memory_graph_relations WHERE from_id=? OR to_id=?";
    @(id;id)
  ) {
    $ok: {};
    $err: {
      log.warn(str.concat("failed to delete relations for entity: ";id);"graph";"system")
    };
  };
  mt db.execparams(
    palace.conn;
    "DELETE FROM memory_graph_entities WHERE id=?";
    @$id
  ) {
    $ok: {
      log.info(str.concat("deleted entity: ";id);"graph";"system");
      <true
    };
    $err: {
      log.warn(str.concat("failed to delete entity: ";id);"graph";"system");
      <false
    };
  };
};

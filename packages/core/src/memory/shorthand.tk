m=core.memory.shorthand;




i=str:std.str;
i=t:shared.types;
i=log:shared.log;

t=$shorthanddef{
  abbrev:str;
  expansion:str;
  category:str
};

t=$expandresult{
  original:str;
  expanded:str;
  expansionsapplied:@str
};


f=builtinshorthands():@$shorthanddef{
  <@(
    
    $shorthanddef{ abbrev:"→";       expansion:" then ";          category:"operator" };
    $shorthanddef{ abbrev:"←";       expansion:" because ";       category:"operator" };
    
    $shorthanddef{ abbrev:".";       expansion:" and ";            category:"operator" };
    
    $shorthanddef{ abbrev:"|";       expansion:" or ";             category:"operator" };
    
    $shorthanddef{ abbrev:"fn";      expansion:"function";         category:"technical" };
    $shorthanddef{ abbrev:"impl";    expansion:"implement";        category:"technical" };
    $shorthanddef{ abbrev:"refac";   expansion:"refactor";         category:"technical" };
    $shorthanddef{ abbrev:"auth";    expansion:"authentication";   category:"technical" };
    $shorthanddef{ abbrev:"db";      expansion:"database";         category:"technical" };
    $shorthanddef{ abbrev:"cfg";     expansion:"configuration";    category:"technical" };
    $shorthanddef{ abbrev:"msg";     expansion:"message";          category:"technical" };
    $shorthanddef{ abbrev:"err";     expansion:"error";            category:"technical" };
    $shorthanddef{ abbrev:"req";     expansion:"request";          category:"technical" };
    $shorthanddef{ abbrev:"res";     expansion:"response";         category:"technical" };
    $shorthanddef{ abbrev:"btn";     expansion:"button";           category:"ui" };
    $shorthanddef{ abbrev:"comp";    expansion:"component";        category:"ui" };
    $shorthanddef{ abbrev:"init";    expansion:"initialise";       category:"technical" };
    $shorthanddef{ abbrev:"deps";    expansion:"dependencies";     category:"technical" };
  )
};


f=iswordabbrev(abbrev:str):bool{
  let isarrow=str.eq(abbrev;"→");
  let isback=str.eq(abbrev;"←");
  let isdot=str.eq(abbrev;".");
  let ispipe=str.eq(abbrev;"|");
  !(isarrow || isback || isdot || ispipe)
};



f=expandword(text:str;abbrev:str;expansion:str):str{
  
  let paddedabbrev=str.concat(" ";str.concat(abbrev;" "));
  let paddedexpansion=str.concat(" ";str.concat(expansion;" "));
  let s=str.replace(text;paddedabbrev;paddedexpansion);
  
  let startabbrev=str.concat(abbrev;" ");
  let startexpansion=str.concat(expansion;" ");
  
  let s=if str.contains(s;startabbrev){
    let parts=str.split(s;startabbrev);
    
    if(str.len(parts.get(0)) == 0){
      str.concat(startexpansion;parts.get(1))
    }else{
      s
    };
  }else{
    s
  };
  <s
};



f=expanddotchains(text:str):str{
  
  let words=str.split(text;" ");
  let resultwords=@();
  words.each|w{
    
    
    let hasdot=str.contains(w;".");
    let hasslash=str.contains(w;"/");
    let hascolon=str.contains(w;":");
    let lookslikepath=hasslash || hascolon;
    
    let lowerw=str.tolower(w);
    let isext=str.contains(lowerw;".tk") || str.contains(lowerw;".json") || str.contains(lowerw;".ts") || str.contains(lowerw;".js") || str.contains(lowerw;".md") || str.contains(lowerw;".toml") || str.contains(lowerw;".txt");
    if(hasdot && !$lookslikepath && !$isext){
      let expandedw=str.replace(w;".";" and ");
      let resultwords=resultwords.append(expandedw)
    }else{
      let resultwords=resultwords.append(w)
    };
  };
  
  let out="";
  let first=true;
  resultwords.each|rw{
    if(first){
      let out=rw;
      let first=false
    }else{
      let out=str.concat(out;str.concat(" ";rw))
    };
  };
  <out
};


f=expandpipe(text:str):str{
  
  if(str.contains(text;"://")){
    <text
  }else{
    <str.replace(text;"|";" or ")
  };
};


f=wasapplied(before:str;after:str):bool{
  !str.eq(before;after)
};



f=expand(text:str;customshorthands:@$shorthanddef):$expandresult{
  let builtins=builtinshorthands();
  let s=text;
  let applied=@();

  
  builtins.each|def{
    let isarrow=str.eq(def.abbrev;"→");
    let isback=str.eq(def.abbrev;"←");
    if(isarrow || isback){
      let before=s;
      let s=str.replace(s;def.abbrev;def.expansion);
      if(wasapplied(before;s)){
        let applied=applied.append(def.abbrev)
      };
    };
  };

  
  let beforedot=s;
  let s=expanddotchains(s);
  if(wasapplied(beforedot;s)){
    let applied=applied.append(".")
  };

  
  let beforepipe=s;
  let s=expandpipe(s);
  if(wasapplied(beforepipe;s)){
    let applied=applied.append("|")
  };

  
  builtins.each|def{
    if(iswordabbrev(def.abbrev)){
      let before=s;
      let s=expandword(s;def.abbrev;def.expansion);
      if(wasapplied(before;s)){
        let applied=applied.append(def.abbrev)
      };
    };
  };

  
  customshorthands.each|def{
    let before=s;
    if(iswordabbrev(def.abbrev)){
      let s=expandword(s;def.abbrev;def.expansion)
    }else{
      let s=str.replace(s;def.abbrev;def.expansion)
    };
    if(wasapplied(before;s)){
      let applied=applied.append(def.abbrev)
    };
  };

  <$expandresult{
    original:text;
    expanded:s;
    expansionsapplied:applied
  };
};



f=isshorthandtext(text:str):bool{
  
  let hasarrow=str.contains(text;"→");
  let hasback=str.contains(text;"←");
  if(hasarrow || hasback){
    <true
  }else{
    
    let lower=str.tolower(text);
    let hasdot=str.contains(text;".");
    let hasslash=str.contains(text;"/");
    let hascolon=str.contains(text;":");
    let dotchaincandidate=hasdot && !$hasslash && !$hascolon;

    
    let hasfn=str.contains(lower;" fn ") || str.contains(lower;"fn ");
    let hasimpl=str.contains(lower;" impl ") || str.contains(lower;"impl ");
    let hasrefac=str.contains(lower;"refac");
    let hasauth=str.contains(lower;" auth ") || str.contains(lower;"auth ");
    let hascfg=str.contains(lower;" cfg ") || str.contains(lower;"cfg ");
    let hasdeps=str.contains(lower;" deps") || str.contains(lower;"deps ");
    let hasdb=str.contains(lower;" db ") || str.contains(lower;"db ");
    let hasinit=str.contains(lower;" init ") || str.contains(lower;"init ");

    let hasknownabbrev=hasfn || hasimpl || hasrefac || hasauth || hascfg || hasdeps || hasdb || hasinit;

    dotchaincandidate || hasknownabbrev
  };
};



f=preview(text:str;custom:@$shorthanddef):str{
  let result=expand(text;custom);
  if(str.eq(result.original;result.expanded)){
    str.concat("No shorthand detected: ";text)
  }else{
    let origline=str.concat("Original: ";result.original);
    let expline=str.concat("Expanded: ";result.expanded);
    str.concat(origline;str.concat("
";expline))
  };
};

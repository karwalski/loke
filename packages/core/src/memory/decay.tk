m=core.memory.decay;





i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=s:core.storage.db;
i=math:std.math;

t=$decayconfig{
  halflifedays:f32;
  minscore:f32;
  prunebelow:f32;
  sweepintervalhours:i32
};




(* ── Decay in integer basis points, and why a DELETE must not read a float ────────
   `apply` returns a bare f32, and at toke 0b0bc4e a bare float return was corrupted across a
   module boundary (T-20, recorded for f64; measured here for f32; fixed in toke 3.1.0, LS1.1h,
   which does not change the conclusion below). Called from another module it returned
   **2** for a memory created now — the correct answer is 1.0 — and **-inf** for every decayed
   one, at ages of 30, 60 and 3650 days and starting scores of 0.4, 0.8 and 1.0. The
   `$decayconfig` struct fields read back perfectly in the same run, which is the signature:
   parameters and struct fields cross intact, returns do not.

   It was latent, because the only consumer was `sweeprows` in this same module. What made it
   worth fixing rather than noting is the shape of the failure. `sweeprows` does:

       if(decayed < cfg.prunebelow){ DELETE FROM memory_scores ...; DELETE FROM memory_drawers ... }

   If that comparison ever sees -inf it is TRUE FOR EVERY ROW and the sweep deletes the user's
   entire memory palace. A destructive comparison should not be one refactor away from that, so
   the delete path now compares INTEGERS and `applybp` is what a caller in another module gets.
   `apply` survives for same-module callers and for readability of the curve itself.

   Basis points: 1.0 = 10000, so two decimal places of a score without a float. *)
f=applybp(scorebp:i64;createdat:i64;now:i64;cfg:$decayconfig):i64{
  (* math.pow2neg takes an INTEGER number of half-lives, so it would truncate: a memory 1.9
     half-lives old would decay as if it were 1. math.pow over f64 keeps the fraction, which
     is what a decay curve needs — and a stdlib f64 return is intact (its wrapper really does
     bitcast), unlike a loke-module one. *)
  let decayedbp=((scorebp as f64) * math.pow(2.0;0.0 - ((((now - createdat) as f64) / 86400.0) / (cfg.halflifedays as f64)))) as i64;
  let minbp=((cfg.minscore as f64) * 10000.0) as i64;
  if(decayedbp < minbp){
    <minbp
  }el{
    <decayedbp
  }
};

(* Same-module callers only — the f32 return is corrupted across a boundary. *)
f=apply(score:f32;createdat:i64;now:i64;cfg:$decayconfig):f32{
  <((applybp(((score as f64) * 10000.0) as i64;createdat;now;cfg) as f64) / 10000.0) as f32
};

(* ── A row whose created_at cannot be read must never be swept ────────────────────
   `created_at` was written as the literal SQL text `now()` until 2026-09-23 (GA5.1), so
   `db.rowi64(row;"created_at")` returns **0** for every row this product wrote before that
   date. A created_at of 0 is 1970, which makes the row maximally aged, which drives the decay
   factor to zero, which puts it below prunebelow — so the first sweep after the memory tables
   exist would delete **every pre-existing memory in the palace**, and it would look like the
   decay policy working correctly.

   A timestamp that is zero, negative, or in the future is not evidence of age; it is evidence
   that the row's age is unknown. An unknown age must not authorise a delete. Such a row is
   skipped and counted, so it shows up rather than silently accumulating. *)
f=agereadable(createdat:i64;now:i64):bool{
  if(createdat<epochfloor()){
    <false
  }el{
    <createdat<=now
  }
};

(* M1.7c — 2020-01-01T00:00:00Z. No memory this product holds can be older, and a datetime
   TEXT read through strtoll lands far below it: "2026-09-24 10:00:00" reads as 2026. A value
   under the floor is a mis-read representation, not an age, so it authorises no delete. *)
f=epochfloor():i64{
  <1577836800
};

(* M1.7c — created_at holds two representations. storedrawer binds epoch SECONDS (M1.7a);
   every other writer, the JSON import included, leaves the column default, datetime('now')
   TEXT. db.rowi64 is strtoll, which read that TEXT as its year. So the column is normalised
   to epoch seconds IN THE QUERY: all digits is already epoch; anything else goes through
   strftime('%s'), which parses datetime TEXT and yields NULL — read as 0, and so skipped by
   agereadable — for anything it cannot parse, such as the pre-GA5.1 literal `now()`. *)
(* M1.7g. A memory ages from the LATER of when it was made and when it was last used, so
   `refresh` extends its life, which is what the word promises. It used to age by
   created_at alone, and refresh wrote accessed_at for nothing to read: a memory used every
   day decayed as fast as one never touched. Both columns are normalised the same way, and
   COALESCE keeps one unreadable value from nulling the MAX. The result keeps the name
   created_at because it is the age origin sweeprows reads. *)
f=sweepsql():str{
  <"SELECT id,score,MAX(COALESCE(CASE WHEN created_at<>'' AND created_at NOT GLOB '*[^0-9]*' THEN CAST(created_at AS INTEGER) ELSE CAST(strftime('%s',created_at) AS INTEGER) END,0),COALESCE(CASE WHEN accessed_at<>'' AND accessed_at NOT GLOB '*[^0-9]*' THEN CAST(accessed_at AS INTEGER) ELSE CAST(strftime('%s',accessed_at) AS INTEGER) END,0)) AS created_at FROM memory_scores"
};



f=sweeprows(palace:i64;cfg:$decayconfig;now:i64;rows:@$row):i32{
  let pruned=mut.0;
  lp(let ii42=0;ii42<rows.len;ii42=ii42+1){
    let row:$row=rows.get(ii42);
    let mid=db.rowstr(row;"id");
    (* Hundredths from the column, basis points for the arithmetic: 1 hundredth = 100 bp. *)
    let basescorebp=s.rowf64hundredths(row;"score")*100;
    let createdat=db.rowi64(row;"created_at");
    let decayedbp=applybp(basescorebp;createdat;now;cfg);
    let prunebelowbp=((cfg.prunebelow as f64) * 10000.0) as i64;
    if(agereadable(createdat;now) && (decayedbp < prunebelowbp)){
      mt db.exec("DELETE FROM memory_scores WHERE id=?";@(mid)) {
        $ok:v 0;
        $err:v 0
      };
      let delresult=mt db.exec("DELETE FROM memory_drawers WHERE id=?";@(mid)) {
        $ok:v true;
        $err:v false
      };
      if(delresult){
        pruned=pruned + 1
      }el{
        log.warn(str.concat("sweep: failed to delete drawer: ";mid);"decay";"system")
      };
    };

  };
  log.info(str.concat("decay sweep complete, pruned: ";str.fromint(pruned));"decay";"system");
  <pruned
};

f=sweepqueryfail():i32{
  log.warn("decay sweep: failed to query memory_scores";"decay";"system");
  <0 as i32
};

f=sweep(palace:i64;cfg:$decayconfig;now:i64):i32{
  <mt db.many(sweepsql();@()) {
    $ok:rows sweeprows(palace;cfg;now;rows);
    $err:v sweepqueryfail()
  }
};




f=refresh(palace:i64;memoryid:str;now:i64):bool{
  let ok=mt db.exec("UPDATE memory_scores SET accessed_at=? WHERE id=?";@(str.fromint(now);memoryid)) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.debug(str.concat("refreshed memory decay clock: ";memoryid);"decay";"system");
    <true
  }el{
    log.warn(str.concat("failed to refresh memory: ";memoryid);"decay";"system");
    <false
  }
};






f=defaultconfig():$decayconfig{
  <$decayconfig{
    halflifedays:30.0;
    minscore:0.1;
    prunebelow:0.05;
    sweepintervalhours:24
  }
};

m=core.memory.decay;





i=memtypes:core.memory.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=math:std.math;

t=$decayconfig{
  halflifedays:f32;
  minscore:f32;
  prunebelow:f32;
  sweepintervalhours:i32
};




f=apply(score:f32;createdat:i64;now:i64;cfg:$decayconfig):f32{
  let secondsperday=86400;
  let agesecs=now - createdat;
  let agedays=agesecs / secondsperday;
  
  let exponent=agedays / cfg.halflifedays;
  let decayfactor=math.pow2neg(exponent);
  let raw=score * decayfactor;
  
  if(raw < cfg.minscore){
    <cfg.minscore
  }el{
    <raw
  }
};



f=sweeprows(palace:i64;cfg:$decayconfig;now:i64;rows:i64):i32{
  let pruned=mut.0;
  lp(let ii42=0;ii42<rows.len;ii42=ii42+1){
    let row=rows.get(ii42);
    let mid=json.str(row;"id");
    let basescore=json.getfloat(row;"score");
    let createdat=json.i64(row;"created_at");
    let decayed=apply(basescore;createdat;now;cfg);
    if(decayed < cfg.prunebelow){
      mt db.execparams(
        palace.conn;
        "DELETE FROM memory_scores WHERE id=?";
        @($mid)
      ) {
        $ok:v void;
        $err:v void
      };
      let delresult=mt db.execparams(
        palace.conn;
        "DELETE FROM memory_drawers WHERE id=?";
        @($mid)
      ) {
        $ok:v true;
        $err:v false
      };
      if(delresult){
        pruned=pruned + 1
      }el{
        log.warn(str.concat("sweep: failed to delete drawer: ";mid);"decay";"system")
      };
    };

  };
  log.info(str.concat("decay sweep complete, pruned: ";str.fromint(pruned));"decay";"system");
  <pruned
};

f=sweepqueryfail():i32{
  log.warn("decay sweep: failed to query memory_scores";"decay";"system");
  <0 as i32
};

f=sweep(palace:i64;cfg:$decayconfig;now:i64):i32{
  mt db.query(palace.conn;"SELECT id,score,created_at FROM memory_scores") {
    $ok:rows sweeprows(palace;cfg;now;rows);
    $err:v sweepqueryfail()
  }
};




f=refresh(palace:i64;memoryid:str;now:i64):bool{
  let tss=str.fromint(now);
  let ok=mt db.execparams(
    palace.conn;
    "UPDATE memory_scores SET accessed_at=? WHERE id=?";
    @(tss;memoryid)
  ) {
    $ok:v true;
    $err:v false
  };
  if(ok){
    log.debug(str.concat("refreshed memory decay clock: ";memoryid);"decay";"system");
    <true
  }el{
    log.warn(str.concat("failed to refresh memory: ";memoryid);"decay";"system");
    <false
  }
};






f=defaultconfig():$decayconfig{
  <$decayconfig{
    halflifedays:30.0;
    minscore:0.1;
    prunebelow:0.05;
    sweepintervalhours:24
  }
};

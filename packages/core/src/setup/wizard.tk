
m=core.setup.wizard;
i=str:std.str;
i=log:shared.log;
i=sys:std.sys;

t=$hardwareprofile{
  ramgb:i64;
  gpuvramgb:i64;
  cpucores:i64;
  hasapplesilicon:bool;
  disktype:$str;
  diskfreegb:i64
};

t=$modelrecommendation{
  modelid:$str;
  modelname:$str;
  sizegb:f64;
  tier:$str;
  reason:$str
};

t=$wizardstate{
  step:$str;
  hardware:i64;
  modelsavailable:@$modelrecommendation;
  providersconfigured:@$str;
  privacypreset:$str;
  testpassed:bool;
  complete:bool
};

f=detecthardware():$hardwareprofile{
  log.info("detecting hardware capabilities";"setup.wizard";"system");
  let ram=sys.totalramgb();
  let cores=sys.cpucount();
  let applesilicon=sys.isarm64();
  log.info(str.concat("RAM: ";str.concat(str.fromint(ram);str.concat("GB, cores: ";str.concat(str.fromint(cores);str.concat(", Apple Silicon: ";if(applesilicon){"yes"}el{"no"})))));"setup.wizard";"system");
  <$hardwareprofile{
    ramgb:$ram;
    gpuvramgb:0;
    cpucores:$cores;
    hasapplesilicon:$applesilicon;
    disktype:"ssd";
    diskfreegb:0
  };
};

f=recommendmodels(hw:$hardwareprofile):@$modelrecommendation{
  let recs=@$modelrecommendation;
  if(hw.ramgb>8){
    recs:@.push(recs;$modelrecommendation{modelid:"qwen2.5:3b";modelname:"Qwen 2.5 3B";sizegb:2.0;tier:"interactive";reason:"Fast NER and classification"})
  }el{};
  if(hw.ramgb>16){
    recs:@.push(recs;$modelrecommendation{modelid:"qwen2.5:7b";modelname:"Qwen 2.5 7B";sizegb:4.5;tier:"interactive";reason:"General-purpose local inference"});
    recs:@.push(recs;$modelrecommendation{modelid:"llama3.2:3b";modelname:"Llama 3.2 3B";sizegb:2.0;tier:"interactive";reason:"Efficient instruction following"})
  }el{};
  if(hw.ramgb>32){
    recs:@.push(recs;$modelrecommendation{modelid:"qwen2.5:32b";modelname:"Qwen 2.5 32B";sizegb:20.0;tier:"considered";reason:"High-quality considered-tier inference"})
  }el{};
  if(hw.ramgb>64){
    recs:@.push(recs;$modelrecommendation{modelid:"qwen2.5:72b";modelname:"Qwen 2.5 72B";sizegb:45.0;tier:"background";reason:"Background-tier large model"})
  }el{};
  log.info(str.concat("recommended ";str.concat(str.fromint(recs.len);" models"));"setup.wizard";"system");
  <recs
};

f=init():$wizardstate{
  let hw=detecthardware();
  let models=recommendmodels(hw);
  <$wizardstate{
    step:"hardware";
    hardware:$hw;
    modelsavailable:$models;
    providersconfigured:@();
    privacypreset:"eu-gdpr";
    testpassed:false;
    complete:false
  };
};

f=nextstep(state:$wizardstate):$wizardstate{
  if(str.eq(state.step;"hardware")){
    <$wizardstate{step:"models";hardware:i64;modelsavailable:i64;providersconfigured:i64;privacypreset:i64;testpassed:i64;complete:false};
  }el{
    if(str.eq(state.step;"models")){
      <$wizardstate{step:"providers";hardware:i64;modelsavailable:i64;providersconfigured:i64;privacypreset:i64;testpassed:i64;complete:false};
    }el{
      if(str.eq(state.step;"providers")){
        <$wizardstate{step:"privacy";hardware:i64;modelsavailable:i64;providersconfigured:i64;privacypreset:i64;testpassed:i64;complete:false};
      }el{
        if(str.eq(state.step;"privacy")){
          <$wizardstate{step:"test";hardware:i64;modelsavailable:i64;providersconfigured:i64;privacypreset:i64;testpassed:i64;complete:false};
        }el{
          <$wizardstate{step:"complete";hardware:i64;modelsavailable:i64;providersconfigured:i64;privacypreset:i64;testpassed:i64;complete:true};
        };
      };
    };
  };
};

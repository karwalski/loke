m=core.extensions.gateway_hooks;














m=core.extensions.gatewayhooks;
i=str:std.string;
i=log:std.log;








t=$rulehook{
  id:str;
  description:str;
  severity:str
};




t=$hookdecision{
  hookid:str;
  action:str;
  reason:str;
  ts:i64
};


t=$rulehookregistry{
  hooks:@$rulehook
};




f=newregistry():$rulehookregistry{
  <$rulehookregistry{
    hooks:@()
  };
};




f=register(reg:$rulehookregistry;hook:$rulehook):$rulehookregistry{
  let without=@();
  let count=str.arraylen(reg.hooks);
  let i=0;
  lp(true){
    if(i>count){
      break
    }el{
      let existing=str.arrayget(reg.hooks;i);
      if(str.eq(existing.id;hook.id)){
        ()
      }el{
        without=@(without;existing)
      };
      i=i+1;
    };
  };
  log.info(
    str.concat("gateway rule hook registered: ";str.concat(hook.id;str.concat(" severity=";hook.severity)));
    "gateway_hooks";
    "system");
  <$rulehookregistry{
    hooks:@(without;hook)
  };
};


f=unregister(reg:$rulehookregistry;id:str):$rulehookregistry{
  let result=@();
  let count=str.arraylen(reg.hooks);
  let i=0;
  lp(true){
    if(i>count){
      break
    }el{
      let existing=str.arrayget(reg.hooks;i);
      if(str.eq(existing.id;id)){
        ()
      }el{
        result=@(result;existing)
      };
      i=i+1;
    };
  };
  log.info(str.concat("gateway rule hook unregistered: ";id);"gateway_hooks";"system");
  <$rulehookregistry{
    hooks:result
  };
};


f=list(reg:$rulehookregistry):@$rulehook{
  <reg.hooks
};


f=allowdecision(hookid:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"allow";
    reason:"";
    ts:0
  };
};


f=blockdecision(hookid:str;reason:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"block";
    reason:reason;
    ts:0
  };
};


f=warndecision(hookid:str;reason:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"warn";
    reason:reason;
    ts:0
  };
};



f=logdecision(d:$hookdecision):void{
  let msg=str.concat(
    str.concat("gateway hook decision: ";d.hookid);
    str.concat(
      str.concat(" action=";d.action);
      str.concat(" reason=";d.reason)));
  if(str.eq(d.action;"block")){
    log.error(msg;"gateway_hooks";d.hookid)
  }el{
    if(str.eq(d.action;"warn")){
      log.warn(msg;"gateway_hooks";d.hookid)
    }el{
      log.info(msg;"gateway_hooks";d.hookid)
    };
  };
  <()
};

m=core.extensions.gatewayhooks;

i=str:std.str;
i=log:shared.log;

t=$rulehook{
  id:str;
  description:str;
  severity:str
};

t=$hookdecision{
  hookid:str;
  action:str;
  reason:str;
  ts:i64
};

t=$rulehookregistry{
  hooks:@$rulehook
};

f=newregistry():$rulehookregistry{
  <$rulehookregistry{
    hooks:@()
  }
};

f=register(reg:$rulehookregistry;hook:$rulehook):$rulehookregistry{
  let without=@();
  let count=reg.hooks.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let existing=str.arrayget(reg.hooks;i);
      if(str.eq(existing.id;hook.id)){
        i=i+1
      }el{
        without=@(without;existing);
        i=i+1
      }
    }
  };
  log.info(
    str.concat("gateway rule hook registered: ";str.concat(hook.id;str.concat(" severity=";hook.severity)));
    "gatewayhooks";
    "system");
  <$rulehookregistry{
    hooks:@(without;hook)
  }
};

f=unregister(reg:$rulehookregistry;id:str):$rulehookregistry{
  let result=@();
  let count=reg.hooks.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let existing=str.arrayget(reg.hooks;i);
      if(str.eq(existing.id;id)){
        i=i+1
      }el{
        result=@(result;existing);
        i=i+1
      }
    }
  };
  log.info(str.concat("gateway rule hook unregistered: ";id);"gatewayhooks";"system");
  <$rulehookregistry{
    hooks:result
  }
};

f=list(reg:$rulehookregistry):@$rulehook{
  <reg.hooks
};

f=allowdecision(hookid:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"allow";
    reason:"";
    ts:0
  }
};

f=blockdecision(hookid:str;reason:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"block";
    reason:reason;
    ts:0
  }
};

f=warndecision(hookid:str;reason:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"warn";
    reason:reason;
    ts:0
  }
};

f=logdecision(d:$hookdecision):void{
  let msg=str.concat(
    str.concat("gateway hook decision: ";d.hookid);
    str.concat(
      str.concat(" action=";d.action);
      str.concat(" reason=";d.reason)));
  if(str.eq(d.action;"block")){
    log.error(msg;"gatewayhooks";d.hookid)
  }el{
    if(str.eq(d.action;"warn")){
      log.warn(msg;"gatewayhooks";d.hookid)
    }el{
      log.info(msg;"gatewayhooks";d.hookid)
    }
  }
};

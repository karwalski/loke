m=core.extensions.gatewayhooks;

i=str:std.str;
i=log:shared.log;

t=$rulehook{
  id:str;
  description:str;
  severity:str
};

t=$hookdecision{
  hookid:str;
  action:str;
  reason:str;
  ts:i64
};

t=$rulehookregistry{
  hooks:@$rulehook
};

f=newregistry():$rulehookregistry{
  <$rulehookregistry{
    hooks:@()
  }
};

f=register(reg:$rulehookregistry;hook:$rulehook):$rulehookregistry{
  let without=mut.@();
  let count=reg.hooks.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let existing=reg.hooks.get(i);
      if(str.eq(existing.id;hook.id)){
        i=i+1
      }el{
        without=without.push(existing);
        i=i+1
      }
    }
  };
  log.info(
    "gateway rule hook registered: \(hook.id) severity=\(hook.severity)";
    "gatewayhooks";
    "system");
  <$rulehookregistry{
    hooks:without.push(hook)
  }
};

f=unregister(reg:$rulehookregistry;id:str):$rulehookregistry{
  let result=mut.@();
  let count=reg.hooks.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let existing=reg.hooks.get(i);
      if(str.eq(existing.id;id)){
        i=i+1
      }el{
        result=result.push(existing);
        i=i+1
      }
    }
  };
  log.info(str.concat("gateway rule hook unregistered: ";id);"gatewayhooks";"system");
  <$rulehookregistry{
    hooks:result
  }
};

f=list(reg:$rulehookregistry):@$rulehook{
  <reg.hooks
};

f=allowdecision(hookid:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"allow";
    reason:"";
    ts:0
  }
};

f=blockdecision(hookid:str;reason:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"block";
    reason:reason;
    ts:0
  }
};

f=warndecision(hookid:str;reason:str):$hookdecision{
  <$hookdecision{
    hookid:hookid;
    action:"warn";
    reason:reason;
    ts:0
  }
};

f=logdecision(d:$hookdecision):i64{
  let msg="gateway hook decision: \(d.hookid) action=\(d.action) reason=\(d.reason)";
  if(str.eq(d.action;"block")){
    log.error(msg;"gatewayhooks";d.hookid)
  }el{
    if(str.eq(d.action;"warn")){
      log.warn(msg;"gatewayhooks";d.hookid)
    }el{
      log.info(msg;"gatewayhooks";d.hookid)
    }
  };
  <0
};

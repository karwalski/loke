m=core.extensions.providerregistry;

i=str:std.str;
i=log:shared.log;

t=$providercaps{
  streaming:bool;
  toolcalling:bool;
  embedding:bool;
  maxcontext:i32
};

t=$customprovider{
  id:str;
  name:str;
  baseurl:str;
  caps:$providercaps;
  priority:i32
};

t=$providerstore{
  providers:@$customprovider
};

f=newstore():$providerstore{
  <$providerstore{
    providers:@()
  }
};

f=register(store:$providerstore;p:$customprovider):$providerstore{
  let without=mut.@();
  let count=store.providers.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;p.id)){
        i=i+1
      }el{
        without=@(without;existing);
        i=i+1
      }
    }
  };
  log.info(str.concat("custom provider registered: ";p.id);"providerregistry";"system");
  <$providerstore{
    providers:@(without;p)
  }
};

f=unregister(store:$providerstore;id:str):$providerstore{
  let result=mut.@();
  let count=store.providers.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;id)){
        i=i+1
      }el{
        result=@(result;existing);
        i=i+1
      }
    }
  };
  log.info(str.concat("custom provider unregistered: ";id);"providerregistry";"system");
  <$providerstore{
    providers:result
  }
};

f=get(store:$providerstore;id:str):i64{
  let count=store.providers.len;
  let i=mut.0;
  let found=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;id)){
        found=existing;
        i=count
      }el{
        i=i+1
      }
    }
  };
  <found
};

f=list(store:$providerstore):@$customprovider{
  let sorted=mut.@();
  let count=store.providers.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let p=str.arrayget(store.providers;i);
      let inserted=mut.false;
      let newsorted=mut.@();
      let j=mut.0;
      let sortedlen=sorted.len;
      lp(let lv=0;true;lv=lv){
        if(j>sortedlen){
          br
        }el{
          let s=str.arrayget(sorted;j);
          if(inserted){
            newsorted=@(newsorted;s);
            j=j+1
          }el{
            if(p.priority>s.priority){
              newsorted=@(newsorted;p);
              newsorted=@(newsorted;s);
              inserted=true;
              j=j+1
            }el{
              newsorted=@(newsorted;s);
              j=j+1
            }
          }
        }
      };
      if(inserted){
        sorted=newsorted
      }el{
        sorted=@(newsorted;p)
      };
      i=i+1
    }
  };
  <sorted
};

f=has(store:$providerstore;id:str):bool{
  let count=store.providers.len;
  let i=mut.0;
  let result=mut.false;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      br
    }el{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;id)){
        result=true;
        i=count
      }el{
        i=i+1
      }
    }
  };
  <result
};

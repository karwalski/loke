m=core.extensions.provider_registry;






m=core.extensions.providerregistry;
i=str:std.string;
i=log:std.log;




t=$providercaps{
  streaming:bool;
  toolcalling:bool;
  embedding:bool;
  maxcontext:i32
};



t=$customprovider{
  id:str;
  name:str;
  baseurl:str;
  caps:$providercaps;
  priority:i32
};


t=$providerstore{
  providers:@$customprovider
};




f=newstore():$providerstore{
  <$providerstore{
    providers:@()
  };
};




f=register(store:$providerstore;p:$customprovider):$providerstore{
  
  let without=@();
  let count=str.arraylen(store.providers);
  let i=0;
  loop{
    if(i>=count){
      break
    }else{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;p.id)){
        
        ()
      }else{
        without=@(without;existing)
      };
      i=i+1;
    };
  };
  log.info(str.concat("custom provider registered: ";p.id);"provider_registry";"system");
  <$providerstore{
    providers:@(without;p)
  };
};



f=unregister(store:$providerstore;id:str):$providerstore{
  let result=@();
  let count=str.arraylen(store.providers);
  let i=0;
  loop{
    if(i>=count){
      break
    }else{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;id)){
        ()
      }else{
        result=@(result;existing)
      };
      i=i+1;
    };
  };
  log.info(str.concat("custom provider unregistered: ";id);"provider_registry";"system");
  <$providerstore{
    providers:result
  };
};


f=get(store:$providerstore;id:str):($customprovider){
  let count=str.arraylen(store.providers);
  let i=0;
  let found=();
  loop{
    if(i>=count){
      break
    }else{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;id)){
        found=(existing);
        i=count;
      }else{
        i=i+1;
      };
    };
  };
  <found
};



f=list(store:$providerstore):@$customprovider{
  let sorted=@();
  let count=str.arraylen(store.providers);
  let i=0;
  loop{
    if(i>=count){
      break
    }else{
      let p=str.arrayget(store.providers;i);
      
      let inserted=false;
      let newsorted=@();
      let j=0;
      let sortedlen=str.arraylen(sorted);
      loop{
        if(j>=sortedlen){
          break
        }else{
          let s=str.arrayget(sorted;j);
          if(inserted){
            newsorted=@(newsorted;s);
            j=j+1
          }else{
            if(p.priority>s.priority){
              newsorted=@(newsorted;p);
              newsorted=@(newsorted;s);
              inserted=true;
              j=j+1
            }else{
              newsorted=@(newsorted;s);
              j=j+1
            };
          };
        };
      };
      if(inserted){
        sorted=newsorted
      }else{
        sorted=@(newsorted;p)
      };
      i=i+1;
    };
  };
  <sorted
};


f=has(store:$providerstore;id:str):bool{
  let count=str.arraylen(store.providers);
  let i=0;
  let result=false;
  loop{
    if(i>=count){
      break
    }else{
      let existing=str.arrayget(store.providers;i);
      if(str.eq(existing.id;id)){
        result=true;
        i=count;
      }else{
        i=i+1;
      };
    };
  };
  <result
};

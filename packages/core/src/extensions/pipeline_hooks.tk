m=core.extensions.pipelinehooks;

i=str:std.str;
i=log:shared.log;

t=$hookstate{
  text:str;
  metadata:str;
  requestid:str;
  slot:str
};

t=$hookfn{
  id:str;
  slot:str
};

t=$hookregistry{
  hooks:@$hookfn
};

f=slotbeforener():str{ <"before_ner" };
f=slotafteranonymise():str{ <"after_anonymise" };
f=slotbeforerestore():str{ <"before_restore" };
f=slotafterrestore():str{ <"after_restore" };

f=newregistry():$hookregistry{
  <$hookregistry{
    hooks:@()
  }
};

f=register(reg:$hookregistry;id:str;slot:str):$hookregistry{
  let entry=$hookfn{
    id:id;
    slot:slot
  };
  log.info("pipeline hook registered: \(id) slot=\(slot)";"pipelinehooks";"system");
  <$hookregistry{
    hooks:reg.hooks.push(entry)
  }
};

f=hooksfor(reg:$hookregistry;slot:str):@$hookfn{
  let result=mut.@();
  let count=reg.hooks.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=count){
      br
    }el{
      let h=reg.hooks.get(i);
      if(str.eq(h.slot;slot)){
        result=result.push(h)
      }el{
        result=result
      };
      i=i+1
    }
  };
  <result
};

f=applytext(state:$hookstate;transformed:str):$hookstate{
  <$hookstate{
    text:transformed;
    metadata:state.metadata;
    requestid:state.requestid;
    slot:state.slot
  }
};

f=loghook(id:str;slot:str;beforelen:i32;afterlen:i32):i64{
  let deltastr=str.fromint(afterlen-beforelen);
  let beforestr=str.fromint(beforelen);
  let afterstr=str.fromint(afterlen);
  let msg="hook executed: \(id) slot=\(slot) before=\(beforestr) after=\(afterstr) delta=\(deltastr)";
  log.info(msg;"pipelinehooks";id);
  <0
};

f=validateslot(slot:str):bool{
  if(str.eq(slot;slotbeforener())){
    <true
  }el{
    if(str.eq(slot;slotafteranonymise())){
      <true
    }el{
      if(str.eq(slot;slotbeforerestore())){
        <true
      }el{
        if(str.eq(slot;slotafterrestore())){
          <true
        }el{
          <false
        }
      }
    }
  }
};

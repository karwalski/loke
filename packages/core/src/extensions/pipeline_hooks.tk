m=core.extensions.pipeline_hooks;












m=core.extensions.pipelinehooks;
i=str:std.string;
i=log:std.log;



let $slotbeforener     = "before_ner";
let $slotafteranonymise = "after_anonymise";
let $slotbeforerestore = "before_restore";
let $slotafterrestore  = "after_restore";




t=$hookstate{
  text:str;
  metadata:str;
  requestid:str;
  slot:str
};



t=$hookfn{
  id:str;
  slot:str
};


t=$hookregistry{
  hooks:@$hookfn
};




f=newregistry():$hookregistry{
  <$hookregistry{
    hooks:@()
  };
};




f=register(reg:$hookregistry;id:str;slot:str):$hookregistry{
  let entry=$hookfn{
    id:id;
    slot:slot
  };
  log.info(str.concat("pipeline hook registered: ";str.concat(id;str.concat(" slot=";slot)));"pipeline_hooks";"system");
  <$hookregistry{
    hooks:@(reg.hooks;entry)
  };
};


f=hooksfor(reg:$hookregistry;slot:str):@$hookfn{
  let result=@();
  let count=str.arraylen(reg.hooks);
  let i=0;
  loop{
    if i>=count{
      break
    }else{
      let h=str.arrayget(reg.hooks;i);
      if str.eq(h.slot;slot){
        result=@(result;h)
      }else{
        ()
      };
      i=i+1
    };
  };
  <result
};




f=applytext(state:$hookstate;transformed:str):$hookstate{
  <$hookstate{
    text:transformed;
    metadata:state.metadata;
    requestid:state.requestid;
    slot:state.slot
  };
};


f=loghook(id:str;slot:str;beforelen:i32;afterlen:i32):void{
  let delta=afterlen-beforelen;
  let deltastr=str.fromi32(delta);
  let beforestr=str.fromi32(beforelen);
  let afterstr=str.fromi32(afterlen);
  let msg=str.concat(
    str.concat("hook executed: ";id);
    str.concat(
      str.concat(" slot=";slot);
      str.concat(
        str.concat(" before=";beforestr);
        str.concat(" after=";str.concat(afterstr;str.concat(" delta=";deltastr))))));
  log.info(msg;"pipeline_hooks";id);
  <()
};


f=validateslot(slot:str):bool{
  if str.eq(slot;$slotbeforener){
    <true
  }else{
    if str.eq(slot;$slotafteranonymise){
      <true
    }else{
      if str.eq(slot;$slotbeforerestore){
        <true
      }else{
        if str.eq(slot;$slotafterrestore){
          <true
        }else{
          <false
        };
      };
    };
  };
};

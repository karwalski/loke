m=core.pipeline.emitter;
i=pt:core.pipeline.types;
i=str:std.str;
i=log:shared.log;

t=$emitter{
  runid:str;
  requestid:str;
  events:@$stageevent;
  startedat:i64
};

f=new(runid:str;requestid:str):$emitter{
  <$emitter{runid:runid;requestid:requestid;events:@();startedat:0}
};

f=emit(emitter:$emitter;stage:str;status:str;durationms:i64;details:@$stagedetail;errormsg:str):$emitter{
  let event=$stageevent{
    stage:stage;
    status:status;
    timestampms:0;
    durationms:durationms;
    details:details;
    errormessage:errormsg
  };
  let events=@(emitter.events;event);
  log.info(str.concat(pt.statussymbol(status);str.concat(" ";str.concat(pt.stagelabel(stage);str.concat(" (";str.concat(str.fromint(durationms);str.concat("ms";")"))))));"pipeline";"trace");
  <$emitter{runid:emitter.runid;requestid:emitter.requestid;events:events;startedat:emitter.startedat}
};

f=startstage(emitter:$emitter;stage:str):$emitter{
  <emit(emitter;stage;"active";0;@();"")
};

f=completestage(emitter:$emitter;stage:str;durationms:i64;details:@$stagedetail):$emitter{
  <emit(emitter;stage;"complete";durationms;details;"")
};

f=skipstage(emitter:$emitter;stage:str;reason:str):$emitter{
  <emit(emitter;stage;"skipped";0;@($stagedetail{key:"reason";value:reason});"")
};

f=errorstage(emitter:$emitter;stage:str;errormsg:str):$emitter{
  <emit(emitter;stage;"error";0;@();errormsg)
};

f=finalise(emitter:$emitter):$pipelinerun{
  let totalms=mut.0;
  let overall=mut."complete";
  emitter.events.each|e|{
    totalms=totalms+e.durationms;
    if(str.eq(e.status;"error")){overall="error"}el{}
  };
  <$pipelinerun{
    id:emitter.runid;
    requestid:emitter.requestid;
    startedat:emitter.startedat;
    completedat:0;
    events:emitter.events;
    overallstatus:overall;
    totaldurationms:totalms
  }
};

m=core.pipeline.emitter;
i=pt:core.pipeline.types;
i=str:std.str;
i=log:shared.log;

t=$emitter{
  runid:$str;
  requestid:$str;
  events:@i64);
  startedat:i64
};

f=new(runid:$str;requestid:$str):$emitter{
  <$emitter{runid:$runid;requestid:$requestid;events:@();startedat:0};
};

f=emit(emitter:i64;stage:$str;status:$str;durationms:i64;details:@i64);errormsg:$str):$emitter{
  let event=$stageevent{
    stage:$stage;
    status:$status;
    timestampms:0;
    durationms:$durationms;
    details:$details;
    errormessage:$errormsg
  };
  let events=@.push(emitter.events;event);
  log.info(str.concat(pt.statussymbol(status);str.concat(" ";str.concat(pt.stagelabel(stage);str.concat(" (";str.concat(str.fromint(durationms);str.concat("ms";")"))))));"pipeline";"trace");
  <$emitter{runid:i64;requestid:i64;events:$events;startedat:i64};
};

f=startstage(emitter:i64;stage:$str):$emitter{
  <emit(emitter;stage;"active";0;@();"")
};

f=completestage(emitter:i64;stage:$str;durationms:i64;details:@i64)):$emitter{
  <emit(emitter;stage;"complete";durationms;details;"")
};

f=skipstage(emitter:i64;stage:$str;reason:$str):$emitter{
  <emit(emitter;stage;"skipped";0;@i64{key:"reason";value:$reason});"")
};

f=errorstage(emitter:i64;stage:$str;errormsg:$str):$emitter{
  <emit(emitter;stage;"error";0;@();errormsg)
};

f=finalise(emitter:$emitter):i64{
  let totalms=mut.0;
  let overall="complete";
  emitter.events.each|e{
    totalms=totalms+e.durationms;
    if(str.eq(e.status;"error")){overall="error"}el{};
  };
  <$pipelinerun{
    id:i64;
    requestid:i64;
    startedat:i64;
    completedat:0;
    events:i64;
    overallstatus:$overall;
    totaldurationms:$totalms
  };
};

m=core.pipeline.types;
i=str:std.str;

t=$stageid{
  $input:i64;
  $privacyscan:i64;
  $anonymisation:i64;
  $tokenoptimisation:i64;
  $routing:i64;
  $llmcall:i64;
  $responsescan:i64;
  $deanonymisation:i64;
  $output:i64
};

t=$stagestatus{
  $pending:i64;
  $active:i64;
  $complete:i64;
  $skipped:i64;
  $error:i64
};

t=$stagedetail{
  key:str;
  value:str
};

t=$stageevent{
  stage:str;
  status:str;
  timestampms:i64;
  durationms:i64;
  details:@$stagedetail;
  errormessage:str
};

t=$pipelinerun{
  id:str;
  requestid:str;
  startedat:i64;
  completedat:i64;
  events:@$stageevent;
  overallstatus:str;
  totaldurationms:i64
};

f=stagelabel(s:str):str{
  if(str.eq(s;"input")){"Input"}el{
    if(str.eq(s;"privacy_scan")){"Privacy Scan"}el{
      if(str.eq(s;"anonymisation")){"Anonymisation"}el{
        if(str.eq(s;"token_optimisation")){"Token Optimisation"}el{
          if(str.eq(s;"routing")){"Routing"}el{
            if(str.eq(s;"llm_call")){"LLM Call"}el{
              if(str.eq(s;"response_scan")){"Response Scan"}el{
                if(str.eq(s;"deanonymisation")){"De-anonymisation"}el{
                  if(str.eq(s;"output")){"Output"}el{s}
                }
              }
            }
          }
        }
      }
    }
  }
};

f=statussymbol(s:str):str{
  if(str.eq(s;"pending")){"[ ]"}el{
    if(str.eq(s;"active")){"[>]"}el{
      if(str.eq(s;"complete")){"[ok]"}el{
        if(str.eq(s;"skipped")){"[--]"}el{
          if(str.eq(s;"error")){"[!!]"}el{"[?]"}
        }
      }
    }
  }
};

f=allstages():@str{
  <@("input";"privacy_scan";"anonymisation";"token_optimisation";"routing";"llm_call";"response_scan";"deanonymisation";"output")
};

m=core.pipeline.history;
i=pt:core.pipeline.types;
i=str:std.str;

t=$history{
  runs:@i64);
  maxruns:i64
};

f=new(maxruns:i64):$history{
  <$history{runs:@();maxruns:$maxruns};
};

f=add(h:i64;run:i64):$history{
  let runs=@.push(h.runs;run);
  if(runs.len>h.maxruns){
    let trimmed=mut.@($pt.pipelinerun);
    let skip=true;
    runs.each|r{
      if(skip){skip=false}el{
        trimmed=@.push(trimmed;r)
      };
    };
    <$history{runs:$trimmed;maxruns:i64};
  }el{
    <$history{runs:$runs;maxruns:i64};
  };
};

f=recent(h:i64;n:i64):@i64){
  let count=h.runs.len;
  if(count<=n){
    <h.runs
  }el{
    let start=count-n;
    let result=mut.@($pt.pipelinerun);
    let i=0;
    h.runs.each|r{
      if(i>start){
        result=@.push(result;r)
      }el{};
      i=i+1;
    };
    <result
  };
};

f=last(h:$history):i64|$lokeerr{
  if(h.runs.len=0){
    <$err($lokeerr.$unknownerr("no pipeline runs in history"))
  }el{
    <$ok(h.runs.get(h.runs.len-1))
  };
};

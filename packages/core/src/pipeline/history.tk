m=core.pipeline.history;
i=pt:core.pipeline.types;
i=str:std.str;

t=$history{
  runs:@$pipelinerun;
  maxruns:i64
};

f=new(maxruns:i64):$history{
  <$history{runs:@();maxruns:maxruns}
};

f=add(h:$history;run:$pipelinerun):$history{
  let runs=@(h.runs;run);
  if(runs.len>h.maxruns){
    let trimmed=mut.@($pipelinerun);
    let skip=mut.true;
    lp(let i=0;i<str.arraylen(runs);i=i+1){ let r=str.arrayget(runs;i); if(skip){skip=false}el{
        trimmed=@(trimmed;r)
      } };
    <$history{runs:trimmed;maxruns:h.maxruns}
  }el{
    <$history{runs:runs;maxruns:h.maxruns}
  }
};

f=recent(h:$history;n:i64):@$pipelinerun{
  let count=h.runs.len;
  if(count<=n){
    <h.runs
  }el{
    let start=count-n;
    let result=mut.@($pipelinerun);
    lp(let i=0;i<str.arraylen(h.runs);i=i+1){ let r=str.arrayget(h.runs;i); if(i>=start){
        result=@(result;r)
      }el{} };
    <result
  }
};

f=last(h:$history):$pipelinerun!$lokeerr{
  if(h.runs.len=0){
    <$err($$unknownerr("no pipeline runs in history"))
  }el{
    <$ok(h.runs.get(h.runs.len-1))
  }
};

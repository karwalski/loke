m=core.models.hardware;



i=t:shared.types;
i=str:std.str;
i=log:shared.log;

t=$disktype{
  $nvme:i64;
  $sata:i64;
  $hdd:i64;
  $unknown:i64
};

t=$hardwareprofile{
  ramgb:f64;
  gpuvramgb:f64;
  unifiedmemorygb:f64;
  disktype:$disktype;
  diskreadmbs:f64;
  cpucores:u32;
  platform:str
};

t=$tierviability{
  modelid:str;
  interactive:bool;
  considered:bool;
  background:bool;
  interactivetoks:f64;
  consideredtoks:f64;
  backgroundtoks:f64
};

f=emptyprofile():$hardwareprofile{
  let p=$hardwareprofile{
    ramgb:0.0;
    gpuvramgb:0.0;
    unifiedmemorygb:0.0;
    disktype:$disktype{$unknown:0};
    diskreadmbs:0.0;
    cpucores:0;
    platform:""
  };
  <p
};



f=totalmemorygb(profile:$hardwareprofile):f64{
  if(profile.unifiedmemorygb > 0.0){
    <profile.unifiedmemorygb
  }el{
    <profile.ramgb + profile.gpuvramgb
  }
};



f=detect():$hardwareprofile{
  
  log.info("hardware: detect() called (stub -- returning Mac defaults)";"hardware";"system");
  <$hardwareprofile{
    ramgb:0.0;
    gpuvramgb:0.0;
    unifiedmemorygb:16.0;
    disktype:$disktype{$nvme:0};
    diskreadmbs:3000.0;
    cpucores:8;
    platform:"macos"
  }
};



f=summary(profile:$hardwareprofile):str{
  let total=profile.ramgb + profile.gpuvramgb;
  let mem=mut.str.concat(str.fromfloat(total);" GB RAM+VRAM");
  if(profile.unifiedmemorygb > 0.0){
    mem=str.concat(str.fromfloat(profile.unifiedmemorygb);" GB unified")
  }el{};
  let cpu=str.concat(str.fromu32(profile.cpucores);"-core CPU");
  let disk=mt profile.disktype {
    $nvme:v    str.concat("NVMe ";str.concat(str.fromfloat(profile.diskreadmbs);" MB/s"));
    $sata:v    str.concat("SATA ";str.concat(str.fromfloat(profile.diskreadmbs);" MB/s"));
    $hdd:v     str.concat("HDD ";str.concat(str.fromfloat(profile.diskreadmbs);" MB/s"));
    $unknown:v "disk:unknown"
  };
  let s1=str.concat(mem;" |");
  let s2=str.concat(s1;str.concat(cpu;" |"));
  let s3=str.concat(s2;str.concat(disk;" |"));
  <str.concat(s3;profile.platform)
};


f=tojson(profile:$hardwareprofile):str{
  let diskstr=mt profile.disktype {
    $nvme:v    "\"nvme\"";
    $sata:v    "\"sata\"";
    $hdd:v     "\"hdd\"";
    $unknown:v "\"unknown\""
  };
  let s="{";
  let s=str.concat(s;str.concat("\"ram_gb\":";str.concat(str.fromfloat(profile.ramgb);",")));
  let s=str.concat(s;str.concat("\"gpu_vram_gb\":";str.concat(str.fromfloat(profile.gpuvramgb);",")));
  let s=str.concat(s;str.concat("\"unified_memory_gb\":";str.concat(str.fromfloat(profile.unifiedmemorygb);",")));
  let s=str.concat(s;str.concat("\"disk_type\":";str.concat(diskstr;",")));
  let s=str.concat(s;str.concat("\"disk_read_mb_s\":";str.concat(str.fromfloat(profile.diskreadmbs);",")));
  let s=str.concat(s;str.concat("\"cpu_cores\":";str.concat(str.fromu32(profile.cpucores);",")));
  let s=str.concat(s;str.concat("\"platform\":\"";str.concat(profile.platform;"\"}")));
  <s
};

f=estimatetierviability(profile:$hardwareprofile;modelsizegb:f64):$tierviability{
  let requiredfast=modelsizegb * 1.2;
  let requiredslow=modelsizegb * 0.8;

  
  let interactive=mut.profile.gpuvramgb > requiredfast;
  if(profile.unifiedmemorygb > requiredfast){
    interactive=true
  }el{};

  
  let combinedmem=profile.ramgb + profile.gpuvramgb;
  let considered=combinedmem > requiredslow;

  
  let background=mt profile.disktype {
    $nvme:v true;
    $sata:v considered;
    $hdd:v considered;
    $unknown:v considered
  };

  
  
  
  
  
  let interactivetoks=mut.0.0;
  if(profile.unifiedmemorygb > requiredfast){
    if(modelsizegb > 0.0){
      interactivetoks=60000.0 / (modelsizegb * 2000.0)
    }el{}
  }el{
    if(profile.gpuvramgb > requiredfast){
      if(modelsizegb > 0.0){
        interactivetoks=400000.0 / (modelsizegb * 2000.0)
      }el{}
    }el{}
  };

  let consideredtoks=mut.0.0;
  if(considered){
    if(modelsizegb > 0.0){
      consideredtoks=40000.0 / (modelsizegb * 2000.0)
    }el{}
  }el{};

  let isnvme=mt profile.disktype {
    $nvme:v true;
    $sata:v false;
    $hdd:v false;
    $unknown:v false
  };
  let backgroundtoks=mut.0.0;
  if(background){
    if(isnvme){
      if(modelsizegb > 0.0){
        backgroundtoks=3000.0 / (modelsizegb * 2000.0)
      }el{}
    }el{
      backgroundtoks=consideredtoks
    }
  }el{};

  let v=$tierviability{
    modelid:"";
    interactive:interactive;
    considered:considered;
    background:background;
    interactivetoks:interactivetoks;
    consideredtoks:consideredtoks;
    backgroundtoks:backgroundtoks
  };
  <v
};

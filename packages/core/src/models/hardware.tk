m=core.models.hardware;



i=str:std.str;
i=sys:std.sys;

t=$disktype{
  $nvme:i64;
  $sata:i64;
  $hdd:i64;
  $unknown:i64
};

t=$hardwareprofile{
  ramgb:f64;
  gpuvramgb:f64;
  unifiedmemorygb:f64;
  disktype:$disktype;
  diskreadmbs:f64;
  cpucores:u32;
  platform:str
};

t=$tierviability{
  modelid:str;
  interactive:bool;
  considered:bool;
  background:bool;
  interactivetoks:f64;
  consideredtoks:f64;
  backgroundtoks:f64
};

f=emptyprofile():$hardwareprofile{
  let p=$hardwareprofile{
    ramgb:0.0;
    gpuvramgb:0.0;
    unifiedmemorygb:0.0;
    disktype:$disktype{$unknown:0};
    diskreadmbs:0.0;
    cpucores:0;
    platform:""
  };
  <p
};



f=totalmemorygb(profile:$hardwareprofile):f64{
  if(profile.unifiedmemorygb > 0.0){
    <profile.unifiedmemorygb
  }el{
    <profile.ramgb + profile.gpuvramgb
  }
};



(* F2.8a. Measured, not assumed. This logged "stub -- returning Mac defaults" and returned a
   literal profile (16 GB unified, NVMe 3000 MB/s, 8 cores, macos) on every machine, so every
   tier recommendation was computed from constants. RAM and core count come from std.sys:
   whole gigabytes and a count, both as plain integers, measured to match `sysctl hw.memsize`
   and `hw.ncpu`. On Apple silicon the memory is unified, so it is reported there too. What
   is NOT measured stays zero or $unknown, which means "unknown": GPU VRAM on a discrete
   card, the disk type and the disk read speed. A zero there is never a claim of no disk. *)
f=detect():$hardwareprofile{
  let ram=sys.totalramgb();
  let cores=sys.cpucount();
  let arm=sys.isarm64();
  let platform:str=sys.platform();
  let unified=mut.0.0;
  if(arm==1){ unified=ram as f64 }el{};
  <$hardwareprofile{
    ramgb:ram as f64;
    gpuvramgb:0.0;
    unifiedmemorygb:unified;
    disktype:$disktype{$unknown:0};
    diskreadmbs:0.0;
    cpucores:cores as u32;
    platform:platform
  }
};



f=summary(profile:$hardwareprofile):str{
  (* The figure is totalmemorygb's, called within this module, rather than a second copy of
     its unified-or-split rule: an f64 RETURN is corrupted across a module boundary (T-20),
     so this string is how another module, and tests/unit/models/test_hardware.tk, can read
     the total at all. *)
  let total=totalmemorygb(profile);
  let mem=mut.str.concat(str.fromfloat(total);" GB RAM+VRAM");
  if(profile.unifiedmemorygb > 0.0){
    mem=str.concat(str.fromfloat(total);" GB unified")
  }el{};
  let cpu=str.concat(str.fromint(profile.cpucores);"-core CPU");
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let disktypev:$disktype=profile.disktype;
  let disk=mt disktypev {
    $nvme:v    str.concat("NVMe ";str.concat(str.fromfloat(profile.diskreadmbs);" MB/s"));
    $sata:v    str.concat("SATA ";str.concat(str.fromfloat(profile.diskreadmbs);" MB/s"));
    $hdd:v     str.concat("HDD ";str.concat(str.fromfloat(profile.diskreadmbs);" MB/s"));
    $unknown:v "disk:unknown"
  };
  let s1=str.concat(mem;" |");
  let s2=str.concat(s1;str.concat(cpu;" |"));
  let s3=str.concat(s2;str.concat(disk;" |"));
  <str.concat(s3;profile.platform)
};


f=tojson(profile:$hardwareprofile):str{
  let disktypev:$disktype=profile.disktype;
  let diskstr=mt disktypev {
    $nvme:v    "\"nvme\"";
    $sata:v    "\"sata\"";
    $hdd:v     "\"hdd\"";
    $unknown:v "\"unknown\""
  };
  let s="{";
  let s=str.concat(s;str.concat("\"ram_gb\":";str.concat(str.fromfloat(profile.ramgb);",")));
  let s=str.concat(s;str.concat("\"gpu_vram_gb\":";str.concat(str.fromfloat(profile.gpuvramgb);",")));
  let s=str.concat(s;str.concat("\"unified_memory_gb\":";str.concat(str.fromfloat(profile.unifiedmemorygb);",")));
  let s=str.concat(s;str.concat("\"disk_type\":";str.concat(diskstr;",")));
  let s=str.concat(s;str.concat("\"disk_read_mb_s\":";str.concat(str.fromfloat(profile.diskreadmbs);",")));
  let s=str.concat(s;str.concat("\"cpu_cores\":";str.concat(str.fromint(profile.cpucores);",")));
  let s=str.concat(s;str.concat("\"platform\":\"";str.concat(profile.platform;"\"}")));
  <s
};

f=estimatetierviability(profile:$hardwareprofile;modelsizegb:f64):$tierviability{
  let requiredfast=modelsizegb * 1.2;
  let requiredslow=modelsizegb * 0.8;

  
  let interactive=mut.profile.gpuvramgb > requiredfast;
  if(profile.unifiedmemorygb > requiredfast){
    interactive=true
  }el{};

  
  let considered=(profile.ramgb + profile.gpuvramgb) > requiredslow;

  
  let disktypev:$disktype=profile.disktype;
  let background=mt disktypev {
    $nvme:v true;
    $sata:v considered;
    $hdd:v considered;
    $unknown:v considered
  };

  
  
  
  
  
  let interactivetoks=mut.0.0;
  if(profile.unifiedmemorygb > requiredfast){
    if(modelsizegb > 0.0){
      interactivetoks=60000.0 / (modelsizegb * 2000.0)
    }el{}
  }el{
    if(profile.gpuvramgb > requiredfast){
      if(modelsizegb > 0.0){
        interactivetoks=400000.0 / (modelsizegb * 2000.0)
      }el{}
    }el{}
  };

  let consideredtoks=mut.0.0;
  if(considered){
    if(modelsizegb > 0.0){
      consideredtoks=40000.0 / (modelsizegb * 2000.0)
    }el{}
  }el{};

  let disktypev:$disktype=profile.disktype;
  let isnvme=mt disktypev {
    $nvme:v true;
    $sata:v false;
    $hdd:v false;
    $unknown:v false
  };
  let backgroundtoks=mut.0.0;
  if(background){
    if(isnvme){
      if(modelsizegb > 0.0){
        backgroundtoks=3000.0 / (modelsizegb * 2000.0)
      }el{}
    }el{
      backgroundtoks=consideredtoks
    }
  }el{};

  let v=$tierviability{
    modelid:"";
    interactive:interactive;
    considered:considered;
    background:background;
    interactivetoks:interactivetoks;
    consideredtoks:consideredtoks;
    backgroundtoks:backgroundtoks
  };
  <v
};

(* F2.8a. Returned the integer 0 from a function its caller read as a profile, so reading
   any field of it was a nil dereference (RT005; that is how /installer died, F2.10). *)
f=detectprofile():$hardwareprofile{
  <detect()
};

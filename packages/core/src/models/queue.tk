m=core.models.queue;




i=t:shared.types;
i=str:std.str;
i=log:shared.log;
i=qt:core.models.queuetypes;




f=newqueue():$jobqueue{
  <$jobqueue{
    jobs:@();
    maxconcurrent:1
  }
};




f=enqueue(queue:$jobqueue;modelid:str;prompt:str;priority:$jobpriority):str{
  let id=str.randhex(8);
  let cid=log.newcorrelationid();
  let job=$queuejob{
    id:id;
    modelid:modelid;
    prompt:prompt;
    priority:priority;
    status:$pending;
    createdat:"";
    startedat:"";
    completedat:"";
    result:"";
    error:"";
    estimatedtoks:0.0
  };
  let queue=$jobqueue{jobs:queue.jobs.append(job);maxconcurrent:queue.maxconcurrent};
  log.info(str.concat("queue: enqueued job ";id);"queue";cid);
  <id
};



f=priorityrank(p:$jobpriority):u32{
  mt p {
    $user:v 0;
    $agent:v 1;
    $evaluation:v 2
  }
};





f=nextpending(queue:$jobqueue):$queuejob!$lokeerr{
  let found=mut.false;
  let best=mut.$queuejob{
    id:"";
    modelid:"";
    prompt:"";
    priority:$evaluation;
    status:$pending;
    createdat:"";
    startedat:"";
    completedat:"";
    result:"";
    error:"";
    estimatedtoks:0.0
  };
  let bestrank=mut.3;
  lp(let qi=0;qi<queue.jobs.len;qi=qi+1){
    let job=queue.jobs.get(qi);
    let ispending=mt job.status {
      $pending:v true;
      $running:v false;
      $completed:v false;
      $failed:v false;
      $cancelled:v false
    };
    if(ispending){
      let rank=priorityrank(job.priority);
      if(rank < bestrank){
        best=job;
        bestrank=rank;
        found=true
      }el{}
    }el{}
  };

  if(found){
    <$ok(best)
  }el{
    <$err($modelerr("queue: no pending jobs"))
  }
};




f=markrunning(queue:$jobqueue;jobid:str):void{
  let count=queue.jobs.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(!(i<count)){
      let lv=1
    }el{
      let job=queue.jobs.get(i);
      if(str.eq(job.id;jobid)){
        let njob=$queuejob{
          id:job.id;
          modelid:job.modelid;
          prompt:job.prompt;
          priority:job.priority;
          status:$running;
          createdat:job.createdat;
          startedat:"now";
          completedat:job.completedat;
          result:job.result;
          error:job.error;
          estimatedtoks:job.estimatedtoks
        };
        queue.jobs.set(i;njob)
      };
      let i=i+1
    }
  }
};





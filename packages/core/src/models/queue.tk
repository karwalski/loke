    }
  }
};




f=listjobs(queue:$jobqueue):@$queuejob{
  <queue.jobs
};



f=statuslabel(status:$jobstatus):str{
  mt status {
    $pending:v "pending";
    $running:v "running";
    $completed:v "completed";
    $failed:v "failed";
    $cancelled:v "cancelled"
  }
};



f=prioritylabel(p:$jobpriority):str{
  mt p {
    $user:v "user";
    $agent:v "agent";
    $evaluation:v "eval"
  }
};




f=formatlist(queue:$jobqueue):str{
  if(queue.jobs.len = 0){
    <"No jobs in queue."
  }el{
    let header="ID       | Pri   | Status    | Model                | Prompt";
    let sep="---------|-------|-----------|----------------------|-----------------------------";
    let rows=mut.@();
    lp(let qi2=0;qi2<queue.jobs.len;qi2=qi2+1){
      let job=queue.jobs.get(qi2);
      let idcol=str.concat(job.id;"        ");
      let id8=str.slice(idcol;0;8);
      let pricol=str.concat(prioritylabel(job.priority);"     ");
      let pri5=str.slice(pricol;0;5);
      let statcol=str.concat(statuslabel(job.status);"          ");
      let stat9=str.slice(statcol;0;9);
      let modelcol=str.concat(job.modelid;"                    ");
      let model20=str.slice(modelcol;0;20);
      let promptpreview=mut.job.prompt;
      if(str.len(job.prompt) > 29){
        promptpreview=str.concat(str.slice(job.prompt;0;26);"...")
      }el{};
      let row=str.concat(id8;str.concat(" | ";str.concat(pri5;str.concat(" | ";str.concat(stat9;str.concat(" | ";str.concat(model20;str.concat(" | ";promptpreview))))))));
      rows=rows.push(row)
    };
    let body=str.join(rows;"
");
    <str.concat(header;str.concat("
";str.concat(sep;str.concat("
";body))))
  }
};

f=cancel(queue:$jobqueue;jobid:str):void{
  let count=queue.jobs.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(!(i<count)){
      let lv=1
    }el{
      let job=queue.jobs.get(i);

m=core.models.queue;




i=t:shared.types;
i=str:std.str;
i=log:shared.log;



t=$jobstatus{
  $pending:i64;
  $running:i64;
  $completed:i64;
  $failed(str);
  $cancelled
};

t=$jobpriority{
  $user:i64;
  $agent:i64;
  $evaluation
};

t=$queuejob{
  id:str;
  modelid:str;
  prompt:str;
  priority:$jobpriority;
  status:$jobstatus;
  createdat:str;
  startedat:str;
  completedat:str;
  result:str;
  error:str;
  estimatedtoks:f64
};

t=$jobqueue{
  jobs:@$queuejob;
  maxconcurrent:u32
};




f=newqueue():$jobqueue{
  <$jobqueue{
    jobs:@();
    maxconcurrent:1
  }
};




f=enqueue(queue:$jobqueue;modelid:str;prompt:str;priority:$jobpriority):str{
  let id=str.randhex(8);
  let cid=log.newcorrelationid();
  let job=$queuejob{
    id:id;
    modelid:modelid;
    prompt:prompt;
    priority:priority;
    status:i64$pending;
    createdat:"";
    startedat:"";
    completedat:"";
    result:"";
    error:"";
    estimatedtoks:0.0
  };
  queue.jobs=@(queue.jobs;job);
  log.info(str.concat("queue: enqueued job ";id);"queue";cid);
  <id
};



f=priorityrank(p:$jobpriority):u32{
  mt p {
    $user       0;
    $agent      1;
    $evaluation 2
  }
};





f=nextpending(queue:$jobqueue):$queuejob|$lokeerr{
  let found=false;
  let best=$queuejob{
    id:"";
    modelid:"";
    prompt:"";
    priority:i64$evaluation;
    status:i64$pending;
    createdat:"";
    startedat:"";
    completedat:"";
    result:"";
    error:"";
    estimatedtoks:0.0
  };
  let bestrank=3;

  mt queue.jobs {
    job;
      let ispending=mt job.status {
        $pending:   true;
        $running:   false;
        $completed: false;
        $failed:   false;
        $cancelled: false
      };
      if(ispending){
        let rank=priorityrank(job.priority);
        if(rank < bestrank){
          best=job;
          bestrank=rank;
          found=true
        }
      }
  };

  if(found){
    <$ok(best)
  }el{
    <$err($$modelerr("queue: no pending jobs"))
  }
};




f=markrunning(queue:$jobqueue;jobid:str):void{
  let count=queue.jobs.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      break
    }el{
      let job=queue.jobs.get(i);
      if(str.eq(job.id;jobid)){
        queue.jobs.get(i)=$queuejob{
          id:job.id;
          modelid:job.modelid;
          prompt:job.prompt;
          priority:job.priority;
          status:i64$running;
          createdat:job.createdat;
          startedat:"now";
          completedat:job.completedat;
          result:job.result;
          error:job.error;
          estimatedtoks:job.estimatedtoks
        }
      };
      i=i+1;
    }
  };
  <()
};




f=markcompleted(queue:$jobqueue;jobid:str;result:str):void{
  let count=queue.jobs.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      break
    }el{
      let job=queue.jobs.get(i);
      if(str.eq(job.id;jobid)){
        queue.jobs.get(i)=$queuejob{
          id:job.id;
          modelid:job.modelid;
          prompt:job.prompt;
          priority:job.priority;
          status:i64$completed;
          createdat:job.createdat;
          startedat:job.startedat;
          completedat:"now";
          result:result;
          error:job.error;
          estimatedtoks:job.estimatedtoks
        }
      };
      i=i+1;
    }
  };
  <()
};




f=markfailed(queue:$jobqueue;jobid:str;error:str):void{
  let count=queue.jobs.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      break
    }el{
      let job=queue.jobs.get(i);
      if(str.eq(job.id;jobid)){
        queue.jobs.get(i)=$queuejob{
          id:job.id;
          modelid:job.modelid;
          prompt:job.prompt;
          priority:job.priority;
          status:i64$failed(error);
          createdat:job.createdat;
          startedat:job.startedat;
          completedat:job.completedat;
          result:job.result;
          error:error;
          estimatedtoks:job.estimatedtoks
        }
      };
      i=i+1;
    }
  };
  <()
};




f=cancel(queue:$jobqueue;jobid:str):void{
  let count=queue.jobs.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      break
    }el{
      let job=queue.jobs.get(i);
      if(str.eq(job.id;jobid)){
        queue.jobs.get(i)=$queuejob{
          id:job.id;
          modelid:job.modelid;
          prompt:job.prompt;
          priority:job.priority;
          status:i64$cancelled;
          createdat:job.createdat;
          startedat:job.startedat;
          completedat:job.completedat;
          result:job.result;
          error:job.error;
          estimatedtoks:job.estimatedtoks
        }
      };
      i=i+1;
    }
  };
  <()
};




f=listjobs(queue:$jobqueue):@$queuejob{
  <queue.jobs
};



f=statuslabel(status:$jobstatus):str{
  mt status {
    $pending    "pending";
    $running    "running";
    $completed  "completed";
    $failed:e   str.concat("failed: ";e);
    $cancelled  "cancelled"
  }
};



f=prioritylabel(p:$jobpriority):str{
  mt p {
    $user       "user";
    $agent      "agent";
    $evaluation "eval"
  }
};





f=formatlist(queue:$jobqueue):str{
  if(queue.jobs.len=0){
    <"No jobs in queue."
  }el{
    let header="ID       | Pri   | Status    | Model                | Prompt";
    let sep    ="---------|-------|-----------|----------------------|-----------------------------";
    let rows=queue.jobs.map|job{
      let idcol=str.concat(job.id;"        ");
      let id8=str.slice(idcol;0;8);
      let pricol=str.concat(prioritylabel(job.priority);"     ");
      let pri5=str.slice(pricol;0;5);
      let statcol=str.concat(statuslabel(job.status);"          ");
      let stat9=str.slice(statcol;0;9);
      let modelcol=str.concat(job.modelid;"                    ");
      let model20=str.slice(modelcol;0;20);
      let promptpreview=if str.len(job.prompt) > 29{
        str.concat(str.slice(job.prompt;0;26);"...")
      }el{
        job.prompt
      };
      str.concat(
        id8;
        str.concat(
          " | ";
          str.concat(
            pri5;
            str.concat(
              " | ";
              str.concat(
                stat9;
                str.concat(
                  " | ";
                  str.concat(
                    model20;
                    str.concat(" | ";promptpreview)
                  )
                )
              )
            )
          )
        )
      )
    };
    let body=str.join(rows;"
");
    <str.concat(header;str.concat("
";str.concat(sep;str.concat("
";body))))
  }
};

m=core.models.queue;




i=str:std.str;
i=log:shared.log;
i=u8:shared.utf8;
i=t:shared.types;
i=qt:core.models.queuetypes;




(* The match is in its own function, not inline in the loop. toke emits duplicate
   basic-block labels for an inline `mt` of three or more arms inside a loop body and
   clang rejects the module ("Terminator found in the middle of a basic block!").
   Two arms is fine, which is why $ok/$err matches are unaffected. See
   docs/upstream/toke-issues.md T-2. *)
f=jobispending(st:$jobstatus):bool{
  <mt st {
    $pending:v true;
    $running:v false;
    $completed:v false;
    $failed:v false;
    $cancelled:v false
  }
};

f=newqueue():$jobqueue{
  <$jobqueue{
    jobs:@();
    maxconcurrent:1
  }
};




f=enqueue(queue:$jobqueue;modelid:str;prompt:str;priority:$jobpriority):str{
  let id=str.randhex(8);
  let cid=log.newcorrelationid();
  log.info(str.concat("queue: enqueued job ";id);"queue";cid);
  <id
};



f=priorityrank(p:$jobpriority):u32{
  <mt p {
    $user:v 0 as u32;
    $agent:v 1 as u32;
    $evaluation:v 2 as u32
  }
};





f=nextpending(queue:$jobqueue):$queuejob!$lokeerr{
  let found=mut.false;
  let best=mut.$queuejob{
    id:"";
    modelid:"";
    prompt:"";
    priority:$jobpriority{$evaluation:0};
    status:$jobstatus{$pending:0};
    createdat:"";
    startedat:"";
    completedat:"";
    result:"";
    error:"";
    estimatedtoks:0.0
  };
  let bestrank=mut.3;
  lp(let qi=0;qi<queue.jobs.len;qi=qi+1){
    let job=queue.jobs.get(qi);
    if(jobispending(job.status)){
      let rank=priorityrank(job.priority);
      if(rank < bestrank){
        best=job;
        bestrank=rank;
        found=true
      }el{}
    }el{}
  };

  if(found){
    <$ok(best)
  }el{
    <$err($modelerr("queue: no pending jobs"))
  }
};




(* All four state transitions were the same broken shape and none of them worked.

   `let lv=1` was meant as a break and `let i=i+1` as an increment; both declared a
   new binding instead of assigning, so the loop neither advanced nor terminated —
   every one of these was an infinite loop. `queue.jobs.set(i;njob)` then discarded
   its result, and `void` gave the caller no way to receive the change, so even a
   terminating version would have changed nothing.

   They return the updated queue now, and share one rebuild helper.

   F10.39: each passed a BARE variant name, `withstatus(job;$running;...)`, which is not a
   `$jobstatus` value; the field was written with something that is not a sum value, and
   reading a job's status after any transition segfaulted (tests/unit/models/test_queue.tk,
   finding 3). toke 3.1.0 rejects the bare name (E4033). They now pass the constructed
   value, `$jobstatus{$running:0}`, as nextpending always did. The status of a nextpending
   placeholder was `$stagestatus{..}`, a type of another module, now E3011. *)
f=withstatus(job:$queuejob;status:$jobstatus;startedat:str;completedat:str;result:str;error:str):$queuejob{
  <$queuejob{
    id:job.id;
    modelid:job.modelid;
    prompt:job.prompt;
    priority:job.priority;
    status:status;
    createdat:job.createdat;
    startedat:startedat;
    completedat:completedat;
    result:result;
    error:error;
    estimatedtoks:job.estimatedtoks
  }
};

(* ── Two defects the tests caught, and one they enshrined ─────────────────────────
   **maxconcurrent was dropped.** All FOUR of markrunning / markcompleted / markfailed /
   cancel rebuilt the queue as `$jobqueue{jobs:jobs}`, omitting `maxconcurrent`, so the field
   fell to 0 after any state transition. A queue whose concurrency limit is 0 starts nothing,
   and the limit was lost on the very operation that makes the next scheduling decision
   necessary. toke does not warn about a struct literal missing a field, which is why this
   compiled — the same shape as the `$jobqueue` half of X4a.5.4.

   **The timestamps were the literal string "now".** Not a formatted time — the four
   characters. `tests/unit/models/test_queue.tk` asserted `startedat == "now"` and PASSED, so
   the test held the defect in place as its expectation; that assertion is corrected in the
   same commit. Same class as GA5.1, where `settings.updated_at` stored the literal `now()`.
   `markfailed` stamped nothing at all, so a failed job had no completion time.

   `stamp()` renders `shared.types.nowi64()`, which itself returned a literal 0 until this
   commit — so even a correct call site would have stamped "0". Three layers of the same
   defect, and the test could only ever see the outermost. *)
f=stamp():str{
  <str.fromi64(t.nowi64())
};

f=markrunning(queue:$jobqueue;jobid:str):$jobqueue{
  let jobs=mut.@();
  lp(let i=0;i<queue.jobs.len;i=i+1){
    let job:$queuejob=queue.jobs.get(i);
    if(str.eq(job.id;jobid)){
      jobs=jobs.push(withstatus(job;$jobstatus{$running:0};stamp();job.completedat;job.result;job.error))
    }el{
      jobs=jobs.push(job)
    }
  };
  <$jobqueue{jobs:jobs;maxconcurrent:queue.maxconcurrent}
};

f=markcompleted(queue:$jobqueue;jobid:str;result:str):$jobqueue{
  let jobs=mut.@();
  lp(let i=0;i<queue.jobs.len;i=i+1){
    let job:$queuejob=queue.jobs.get(i);
    if(str.eq(job.id;jobid)){
      jobs=jobs.push(withstatus(job;$jobstatus{$completed:0};job.startedat;stamp();result;job.error))
    }el{
      jobs=jobs.push(job)
    }
  };
  <$jobqueue{jobs:jobs;maxconcurrent:queue.maxconcurrent}
};

f=markfailed(queue:$jobqueue;jobid:str;error:str):$jobqueue{
  let jobs=mut.@();
  lp(let i=0;i<queue.jobs.len;i=i+1){
    let job:$queuejob=queue.jobs.get(i);
    if(str.eq(job.id;jobid)){
      jobs=jobs.push(withstatus(job;$jobstatus{$failed:0};job.startedat;stamp();job.result;error))
    }el{
      jobs=jobs.push(job)
    }
  };
  <$jobqueue{jobs:jobs;maxconcurrent:queue.maxconcurrent}
};

f=cancel(queue:$jobqueue;jobid:str):$jobqueue{
  let jobs=mut.@();
  lp(let i=0;i<queue.jobs.len;i=i+1){
    let job:$queuejob=queue.jobs.get(i);
    if(str.eq(job.id;jobid)){
      jobs=jobs.push(withstatus(job;$jobstatus{$cancelled:0};job.startedat;job.completedat;job.result;job.error))
    }el{
      jobs=jobs.push(job)
    }
  };
  <$jobqueue{jobs:jobs;maxconcurrent:queue.maxconcurrent}
};

f=listjobs(queue:$jobqueue):@$queuejob{
  <queue.jobs
};



f=statuslabel(status:$jobstatus):str{
  <mt status {
    $pending:v "pending";
    $running:v "running";
    $completed:v "completed";
    $failed:v "failed";
    $cancelled:v "cancelled"
  }
};



f=prioritylabel(p:$jobpriority):str{
  <mt p {
    $user:v "user";
    $agent:v "agent";
    $evaluation:v "eval"
  }
};




f=formatlist(queue:$jobqueue):str{
  if(queue.jobs.len == 0){
    <"No jobs in queue."
  }el{
    let header="ID       | Pri   | Status    | Model                | Prompt";
    let sep="---------|-------|-----------|----------------------|-----------------------------";
    let rows=mut.@();
    lp(let qi2=0;qi2<queue.jobs.len;qi2=qi2+1){
      let job=queue.jobs.get(qi2);
      let id8=mt str.slice(str.concat(job.id;"        ");0;8){$ok:okv okv;$err:errv ""};
      let pri5=mt str.slice(str.concat(prioritylabel(job.priority);"     ");0;5){$ok:okv okv;$err:errv ""};
      let stat9=mt str.slice(str.concat(statuslabel(job.status);"          ");0;9){$ok:okv okv;$err:errv ""};
      (* The model column and the prompt preview are cut in BYTES, never inside a UTF-8
         character (F10.49); the model column is padded back to its 20 bytes. The id, the
         priority and the status are ASCII (a hex id and fixed labels), so their cuts stay. *)
      let model20=str.padright(u8.prefix(str.concat(job.modelid;"                    ");20);20;32);
      let promptpreview=mut.job.prompt;
      if(str.len(job.prompt) > 29){
        promptpreview="\(u8.prefix(job.prompt;26))..."
      }el{};
      let row=str.concat(id8;str.concat(" | ";str.concat(pri5;str.concat(" | ";str.concat(stat9;str.concat(" | ";str.concat(model20;str.concat(" | ";promptpreview))))))));
      rows=rows.push(row)
    };
    let body=str.join("
";rows);
    <"\(header)\n\(sep)\n\(body)"
  }
};

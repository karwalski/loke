m=core.models.registry;



i=str:std.str;
i=t:shared.types;
i=json:std.json;

t=$modelcapability{
  modelid:str;
  provider:$provider;
  task:$tasktype;
  qualityscore:f64;
  speedtoks:f64;
  contextwindow:u32;
  supportstools:bool;
  local:bool
};

t=$registry{
  entries:@$modelcapability
};

f=defaultentries():@$modelcapability{
  let entries=@(
    $modelcapability{modelid:"claude-3-5-sonnet-20241022";provider:$provider{$anthropic:0};task:$tasktype{$chat:0};qualityscore:0.95;speedtoks:80.0;contextwindow:200000;supportstools:true;local:false};

    $modelcapability{modelid:"gemma3:4b";provider:i64$ollama;task:i64$chat;qualityscore:0.68;speedtoks:55.0;contextwindow:8000;supportstools:false;local:true};
    $modelcapability{modelid:"gemma3:4b";provider:i64$ollama;task:i64$classification;qualityscore:0.68;speedtoks:55.0;contextwindow:8000;supportstools:false;local:true};
    $modelcapability{modelid:"gemma3:4b";provider:i64$ollama;task:i64$ner;qualityscore:0.68;speedtoks:55.0;contextwindow:8000;supportstools:false;local:true};
    $modelcapability{modelid:"nomic-embed-text";provider:i64$ollama;task:i64$embedding;qualityscore:0.85;speedtoks:200.0;contextwindow:8000;supportstools:false;local:true}
  );
  <entries
};

f=newregistry():$registry{
  let entries=defaultentries();
  let r=$registry{entries:entries};
  <r
};

f=findfortask(registry:$registry;task:$tasktype;localonly:bool):@$modelcapability{
  let matches=@();
  mt registry.entries {
    entry;
      let taskmatches=entry.task=task;
      let localok=if localonly{entry.local}el{true};
      if(taskmatches){
        if(localok){
          matches=@(matches;entry)
        }
      }
  };
  
  let sorted=@();
  mt matches {
    candidate;
      let inserted=false;
      let i=0;
      let len=str.len(json.enc(sorted));
      mt sorted {
        existing;
          if(inserted){
          }el{
            if(candidate.qualityscore > existing.qualityscore){
              sorted=@(sorted;candidate;existing);
              inserted=true
            }el{
              sorted=@(sorted;existing)
            }
          }
      };
      if(inserted){
      }el{
        sorted=@(sorted;candidate)
      }
  };
  <sorted
};

f=findbest(registry:$registry;task:$tasktype;localonly:bool;tier:$modeltier):$modelcapability!$lokeerr{
  let candidates=findfortask(registry;task;localonly);
  
  let bestopt=false;
  let best=$modelcapability{modelid:"";provider:i64$local;task:task;qualityscore:0.0;speedtoks:0.0;contextwindow:0;supportstools:false;local:false};
  mt candidates {
    entry;
      if(bestopt){
      }el{
        
        let tierok=mt tier {
          $interactive:i64; entry.speedtoks > 40.0;
          $considered:i64;  entry.speedtoks > 8.0;
          $background:i64;  true
        };
        if(tierok){
          best=entry;
          bestopt=true
        }
      }
  };
  if(bestopt){
    <best
  }el{
    <$$modelerr("find_best: no model found for task with given constraints")
  }
};

f=register(registry:$registry;entry:$modelcapability):void{
  registry.entries=@(registry.entries;entry)
};

f=byid(registry:$registry;modelid:str):$modelcapability!$lokeerr{
  let foundopt=false;
  let found=$modelcapability{modelid:"";provider:i64$local;task:i64$chat;qualityscore:0.0;speedtoks:0.0;contextwindow:0;supportstools:false;local:false};
  mt registry.entries {
    entry;
      if(foundopt){
      }el{
        if(str.contains(entry.modelid;modelid)){
          if(str.len(entry.modelid)=str.len(modelid)){
            found=entry;
            foundopt=true
          }
        }
      }
  };
  if(foundopt){
    <found
  }el{
    let msg=str.concat("by_id: model not found: ";modelid);
    <$$modelerr(msg)
  }
};

m=core.models.registry;



i=str:std.str;
i=t:shared.types;

t=$modelcapability{
  modelid:str;
  provider:$provider;
  task:$tasktype;
  qualityscore:f64;
  speedtoks:f64;
  contextwindow:u32;
  supportstools:bool;
  local:bool
};

t=$registry{
  entries:@$modelcapability
};

(* F5.11b. The Anthropic entries were claude-3-5-sonnet-20241022 and claude-3-5-haiku-20241022,
   which Anthropic lists as retired (Sonnet 3.5 on 2025-10-28, Haiku 3.5 on 2026-02-19), so a
   request routed to either would have been refused by the provider. They now name the
   current models of the same tiers, with ids and context windows as published in
   Anthropic's models overview (platform.claude.com/docs/en/about-claude/models/overview,
   read 2026-09-27): claude-sonnet-5 (1M tokens) and claude-haiku-4-5-20251001 (200K).
   Nothing here was measured against the provider.

   qualityscore and speedtoks are NOT measurements of the new models. They are the ranking
   weights the retired entries carried, kept so that routing orders the tiers as before
   (Sonnet above Haiku on quality, Haiku faster). The OpenAI ids gpt-4o and gpt-4o-mini are
   unchanged and were not re-checked against OpenAI's list.

   F5.11c. Only an embedding model is declared for $embedding, and the one this catalogue
   has is the local nomic-embed-text, which is also the model the semantic cache loads
   (core.optimiser.cache.embedmodel). claude-sonnet-5, gpt-4o and qwen2.5:72b used to be
   declared for $embedding too. They are chat models: Anthropic publishes no embeddings
   endpoint, gpt-4o is not one of OpenAI's embedding models, and nothing in loke calls an
   embeddings endpoint on either provider, so a hosted embedding route could only have been
   sent to a chat endpoint. There is no hosted embedding model here, deliberately: one
   would need its own client, and an embedding of a prompt is a disclosure of it.
   tests/unit/models/test_registry.tk fails if a model declared for any generative task is
   also declared for $embedding. *)
f=defaultentries():@$modelcapability{
  let entries=@(
    $modelcapability{modelid:"claude-sonnet-5";provider:$provider{$anthropic:0};task:$tasktype{$chat:0};qualityscore:0.95;speedtoks:80.0;contextwindow:1000000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-sonnet-5";provider:$provider{$anthropic:0};task:$tasktype{$codegeneration:0};qualityscore:0.95;speedtoks:80.0;contextwindow:1000000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-sonnet-5";provider:$provider{$anthropic:0};task:$tasktype{$codereview:0};qualityscore:0.95;speedtoks:80.0;contextwindow:1000000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-sonnet-5";provider:$provider{$anthropic:0};task:$tasktype{$summarisation:0};qualityscore:0.95;speedtoks:80.0;contextwindow:1000000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-sonnet-5";provider:$provider{$anthropic:0};task:$tasktype{$classification:0};qualityscore:0.95;speedtoks:80.0;contextwindow:1000000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-sonnet-5";provider:$provider{$anthropic:0};task:$tasktype{$ner:0};qualityscore:0.95;speedtoks:80.0;contextwindow:1000000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-sonnet-5";provider:$provider{$anthropic:0};task:$tasktype{$dataanalysis:0};qualityscore:0.95;speedtoks:80.0;contextwindow:1000000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-haiku-4-5-20251001";provider:$provider{$anthropic:0};task:$tasktype{$chat:0};qualityscore:0.82;speedtoks:120.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-haiku-4-5-20251001";provider:$provider{$anthropic:0};task:$tasktype{$codegeneration:0};qualityscore:0.82;speedtoks:120.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-haiku-4-5-20251001";provider:$provider{$anthropic:0};task:$tasktype{$summarisation:0};qualityscore:0.82;speedtoks:120.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$provider{$openai:0};task:$tasktype{$chat:0};qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$provider{$openai:0};task:$tasktype{$codegeneration:0};qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$provider{$openai:0};task:$tasktype{$codereview:0};qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$provider{$openai:0};task:$tasktype{$summarisation:0};qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$provider{$openai:0};task:$tasktype{$classification:0};qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$provider{$openai:0};task:$tasktype{$ner:0};qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$provider{$openai:0};task:$tasktype{$dataanalysis:0};qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o-mini";provider:$provider{$openai:0};task:$tasktype{$chat:0};qualityscore:0.78;speedtoks:150.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o-mini";provider:$provider{$openai:0};task:$tasktype{$summarisation:0};qualityscore:0.78;speedtoks:150.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o-mini";provider:$provider{$openai:0};task:$tasktype{$classification:0};qualityscore:0.78;speedtoks:150.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"qwen2.5:7b";provider:$provider{$ollama:0};task:$tasktype{$chat:0};qualityscore:0.72;speedtoks:45.0;contextwindow:32000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:7b";provider:$provider{$ollama:0};task:$tasktype{$codegeneration:0};qualityscore:0.72;speedtoks:45.0;contextwindow:32000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:7b";provider:$provider{$ollama:0};task:$tasktype{$summarisation:0};qualityscore:0.72;speedtoks:45.0;contextwindow:32000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:72b";provider:$provider{$ollama:0};task:$tasktype{$chat:0};qualityscore:0.88;speedtoks:8.0;contextwindow:128000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:72b";provider:$provider{$ollama:0};task:$tasktype{$codegeneration:0};qualityscore:0.88;speedtoks:8.0;contextwindow:128000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:72b";provider:$provider{$ollama:0};task:$tasktype{$codereview:0};qualityscore:0.88;speedtoks:8.0;contextwindow:128000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:72b";provider:$provider{$ollama:0};task:$tasktype{$summarisation:0};qualityscore:0.88;speedtoks:8.0;contextwindow:128000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:72b";provider:$provider{$ollama:0};task:$tasktype{$classification:0};qualityscore:0.88;speedtoks:8.0;contextwindow:128000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:72b";provider:$provider{$ollama:0};task:$tasktype{$ner:0};qualityscore:0.88;speedtoks:8.0;contextwindow:128000;supportstools:false;local:true};
    $modelcapability{modelid:"qwen2.5:72b";provider:$provider{$ollama:0};task:$tasktype{$dataanalysis:0};qualityscore:0.88;speedtoks:8.0;contextwindow:128000;supportstools:false;local:true};
    $modelcapability{modelid:"gemma3:4b";provider:$provider{$ollama:0};task:$tasktype{$chat:0};qualityscore:0.68;speedtoks:55.0;contextwindow:8000;supportstools:false;local:true};
    $modelcapability{modelid:"gemma3:4b";provider:$provider{$ollama:0};task:$tasktype{$classification:0};qualityscore:0.68;speedtoks:55.0;contextwindow:8000;supportstools:false;local:true};
    $modelcapability{modelid:"gemma3:4b";provider:$provider{$ollama:0};task:$tasktype{$ner:0};qualityscore:0.68;speedtoks:55.0;contextwindow:8000;supportstools:false;local:true};
    $modelcapability{modelid:"nomic-embed-text";provider:$provider{$ollama:0};task:$tasktype{$embedding:0};qualityscore:0.85;speedtoks:200.0;contextwindow:8000;supportstools:false;local:true}
  );
  <entries
};

f=newregistry():$registry{
  let entries=defaultentries();
  let r=$registry{entries:entries};
  <r
};

(* `let matches=matches.append(entry)` inside the branch declared a new binding, so
   this returned an empty array for every task and model selection could never
   succeed. *)
f=findfortask(registry:$registry;task:$tasktype;localonly:bool):@$modelcapability{
  let matches=mut.@();
  lp(let i=0;i<registry.entries.len;i=i+1){
    let entry:$modelcapability=registry.entries.get(i);
    let localok=mut.true;
    if(localonly){localok=entry.local}el{};
    if(entry.task == task){
      if(localok){
        matches=matches.push(entry)
      }el{}
    }el{}
  };
  <matches
};

(* Three defects: `!$bestopt` put a type sigil on a local so the guard never read
   the flag; `let best=entry` and `let bestopt=true` inside the branch shadowed
   rather than assigned, so nothing was ever selected; and the tier match was inline
   in the loop, which toke miscompiles at three or more arms (T-2).

   It also took the FIRST acceptable candidate rather than the best one. It now
   keeps the highest quality score among those that meet the tier's speed floor. *)
f=meetstier(tier:$modeltier;speedtoks:f64):bool{
  <mt tier {
    $interactive:v speedtoks > 40.0;
    $considered:v speedtoks > 8.0;
    $background:v true
  }
};

(* LS1.1j — the trustworthy form of findbest, and the sentinel it answers with.

   findbest returns $modelcapability!$lokeerr, whose error side is a user-declared sum,
   and toke takes the FIRST arm of a match on such a result whatever the value is
   (T-18). So a caller writing the $ok arm first bound the success binding even on
   failure, and a caller writing the $lokeerr arm first bound the error even on
   success. Neither looked at the value.

   That is not a silent wrong answer, which is the reason this had to be fixed before
   anything was wired to it: reading ANY field off the mis-bound value SEGFAULTS. Two
   probes this session confirmed it — binding is harmless, the first field access is
   fatal. core.router.selector.select therefore could not tell success from failure,
   and core.router.router.route crashed unconditionally.

   bestfortask answers with a plain struct instead. An empty modelid means "no model met
   the constraints": a caller tests it with iscapability, which is an `if` on a str
   length rather than a match it cannot trust. Same shape as
   core.storage.settings.getstror and core.mcp.discovery.probeport. *)
f=nocapability():$modelcapability{
  <$modelcapability{
    modelid:"";
    provider:$provider{$local:0};
    task:$tasktype{$chat:0};
    qualityscore:0.0;
    speedtoks:0.0;
    contextwindow:0 as u32;
    supportstools:false;
    local:true
  }
};

f=iscapability(c:$modelcapability):bool{
  <str.len(c.modelid)>0
};

f=bestfortask(registry:$registry;task:$tasktype;localonly:bool;tier:$modeltier):$modelcapability{
  let candidates=findfortask(registry;task;localonly);
  let bestidx=mut.0-1;
  let bestscore=mut.0.0-1.0;
  lp(let i=0;i<candidates.len;i=i+1){
    let entry:$modelcapability=candidates.get(i);
    if(meetstier(tier;entry.speedtoks)){
      if(entry.qualityscore>bestscore){
        bestscore=entry.qualityscore;
        bestidx=i
      }el{}
    }el{}
  };
  if(bestidx<0){
    <nocapability()
  }el{
    <candidates.get(bestidx)
  }
};

f=capabilitybyid(registry:$registry;modelid:str):$modelcapability{
  let foundidx=mut.0-1;
  lp(let i=0;i<registry.entries.len;i=i+1){
    let entry:$modelcapability=registry.entries.get(i);
    if(str.eq(entry.modelid;modelid)){
      foundidx=i
    }el{}
  };
  if(foundidx<0){
    <nocapability()
  }el{
    <registry.entries.get(foundidx)
  }
};

(* Kept for callers that already match its result. New callers should use bestfortask:
   this signature cannot tell them whether a model was found, for the reason above. *)
f=findbest(registry:$registry;task:$tasktype;localonly:bool;tier:$modeltier):$modelcapability!$lokeerr{
  let best=bestfortask(registry;task;localonly;tier);
  if(iscapability(best)){
    <$ok(best)
  }el{
    <$err($modelerr("findbest: no model found for task with given constraints"))
  }
};

(* Returns the updated registry. The body was empty, so registering a model did
   nothing at all, and a by-value parameter could not have carried the change out
   even if it had appended. *)
(* F5.12. Ollama names carry a tag, and an untagged catalogue id means `:latest`. *)
f=isinstalledid(id:str;installed:@str):bool{
  let found=mut.false;
  lp(let i=0;i<installed.len;i=i+1){
    let n=installed.get(i);
    if(str.eq(n;id) || str.eq(n;str.concat(id;":latest"))){ found=true }el{}
  };
  <found
};

(* F5.12. The catalogue with every LOCAL entry that is not installed removed. Cloud entries
   are kept unchanged: what is installed in Ollama says nothing about them. *)
f=installedonly(registry:$registry;installed:@str):$registry{
  let kept=mut.@();
  lp(let i=0;i<registry.entries.len;i=i+1){
    let e:$modelcapability=registry.entries.get(i);
    if(!e.local || isinstalledid(e.modelid;installed)){ kept=kept.push(e) }el{}
  };
  <$registry{entries:kept}
};

(* F5.3. The catalogue without the models named in `ids`, every entry of each, local or
   cloud. core.router.router.routechain uses it to ask the selector for the next candidate
   after the ones already in a fallback chain, so each hop is chosen by the same selection
   rules as the first rather than by a second ranking kept beside them. *)
f=excluding(registry:$registry;ids:@str):$registry{
  let kept=mut.@();
  lp(let i=0;i<registry.entries.len;i=i+1){
    let e:$modelcapability=registry.entries.get(i);
    let named=mut.false;
    lp(let k=0;k<ids.len;k=k+1){
      if(str.eq(ids.get(k);e.modelid)){ named=true }el{}
    };
    if(!named){ kept=kept.push(e) }el{}
  };
  <$registry{entries:kept}
};

f=register(registry:$registry;entry:$modelcapability):$registry{
  <$registry{entries:registry.entries.push(entry)}
};

(* Same shadowing and `!$foundopt` sigil as findbest. The two-step
   contains-then-length-equal test is just string equality. Kept for callers that
   already match its result; capabilitybyid above is the form that can be trusted. *)
f=byid(registry:$registry;modelid:str):$modelcapability!$lokeerr{
  let found=capabilitybyid(registry;modelid);
  if(iscapability(found)){
    <$ok(found)
  }el{
    <$err($modelerr("byid: no model with id \(modelid)"))
  }
};


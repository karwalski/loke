    $modelcapability{modelid:"gpt-4o";provider:$openai;task:$summarisation;qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$openai;task:$classification;qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};

    $modelcapability{modelid:"gpt-4o-mini";provider:$openai;task:$summarisation;qualityscore:0.78;speedtoks:150.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o-mini";provider:$openai;task:$classification;qualityscore:0.78;speedtoks:150.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"qwen2.5:7b";provider:$ollama;task:$chat;qualityscore:0.72;speedtoks:45.0;contextwindow:32000;supportstools:false;local:true};

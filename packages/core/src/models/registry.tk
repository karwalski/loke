    $modelcapability{modelid:"nomic-embed-text";provider:$ollama;task:$embedding;qualityscore:0.85;speedtoks:200.0;contextwindow:8000;supportstools:false;local:true}
  );
  <entries
};

f=newregistry():$registry{
  let entries=defaultentries();
  let r=$registry{entries:entries};
  <r
};

f=findfortask(registry:$registry;task:$tasktype;localonly:bool):@$modelcapability{
  let matches=@();
  lp(let i=0;i<str.arraylen(registry.entries);i=i+1){ let entry=str.arrayget(registry.entries;i);
    let taskmatches=entry.task = task;
    let localok=mut.true;
    if(localonly){localok=entry.local}el{};
    if(taskmatches){
      if(localok){
        let matches=matches.append(entry)
      };
    };
  };
  let sorted=matches;
  <sorted
};

f=findbest(registry:$registry;task:$tasktype;localonly:bool;tier:$modeltier):$modelcapability!$lokeerr{
  let candidates=findfortask(registry;task;localonly);
  let bestopt=false;
  let best=$modelcapability{modelid:"";provider:$local;task:task;qualityscore:0.0;speedtoks:0.0;contextwindow:0;supportstools:false;local:false};
  lp(let ii102=0;ii102<candidates.len;ii102=ii102+1){
    let entry=candidates.get(ii102);
    if(!$bestopt){
      let tierok=mt tier {
        $interactive:v entry.speedtoks > 40.0;
        $considered:v entry.speedtoks > 8.0;
        $background:v true
      };
      if(tierok){
        let best=entry;
        let bestopt=true
      };
    };

  };
  if(bestopt){
    <$ok(best)
  }el{
    <$err($modelerr("findbest: no model found for task with given constraints"))
  };
};

f=register(registry:$registry;entry:$modelcapability):void{
  let registry=$registry{entries:registry.entries.append(entry)}
};

f=byid(registry:$registry;modelid:str):$modelcapability!$lokeerr{
  let foundopt=false;
  let found=$modelcapability{modelid:"";provider:$local;task:$chat;qualityscore:0.0;speedtoks:0.0;contextwindow:0;supportstools:false;local:false};
  lp(let ii131=0;ii131<registry.entries.len;ii131=ii131+1){
    let entry=registry.entries.get(ii131);
    if(!$foundopt){
      if(str.contains(entry.modelid;modelid)){
        if(str.len(entry.modelid) = str.len(modelid)){
          let found=entry;
          let foundopt=true
        }
      }
    }

  };
  if(foundopt){
    <$ok(found)
  }el{
    let msg=str.concat("byid: model not found: ";modelid);
    <$err($modelerr(msg))
  }
};

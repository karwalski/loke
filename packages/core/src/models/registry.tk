  <entries
};

f=newregistry():$registry{
  let entries=defaultentries();
  let r=$registry{entries:entries};
  <r
};

f=findfortask(registry:$registry;task:$tasktype;localonly:bool):@$modelcapability{
  let matches=@();
  mt registry.entries {
    entry;
      let taskmatches=entry.task==task;
      let localok=if localonly{entry.local}else{true};
      if taskmatches{
        if localok{
          matches=@(matches;entry)
        };
      };
  };
  
  let sorted=@();
  mt matches {
    candidate;
      let inserted=false;
      let i=0;
      let len=str.len(json.enc(sorted));
      mt sorted {
        existing;
          if inserted{
          }else{
            if candidate.qualityscore > existing.qualityscore{
              sorted=@(sorted;candidate;existing);
              inserted=true
            }else{
              sorted=@(sorted;existing)
            };
          };
      };
      if inserted{
      }else{
        sorted=@(sorted;candidate)
      };
  };
  <sorted
};

f=findbest(registry:$registry;task:$tasktype;localonly:bool;tier:$modeltier):$modelcapability|$lokeerr{
  let candidates=findfortask(registry;task;localonly);
  
  let bestopt=false;
  let best=$modelcapability{modelid:"";provider:$provider.$local;task:task;qualityscore:0.0;speedtoks:0.0;contextwindow:0;supportstools:false;local:false};
  mt candidates {
    entry;
      if bestopt{
      }else{
        
        let tierok=mt tier {
          $interactive; entry.speedtoks >= 40.0;
          $considered;  entry.speedtoks >= 8.0;
          $background;  true
        };
        if tierok{
          best=entry;
          bestopt=true
        };
      };
  };
  if bestopt{
    <best
  }else{
    <$lokeerr.$modelerr("find_best: no model found for task with given constraints")
  };
};

f=register(registry:mut $registry;entry:$modelcapability):void{
  registry.entries=@(registry.entries;entry)
};

f=byid(registry:$registry;modelid:str):$modelcapability|$lokeerr{
  let foundopt=false;
  let found=$modelcapability{modelid:"";provider:$provider.$local;task:$tasktype.$chat;qualityscore:0.0;speedtoks:0.0;contextwindow:0;supportstools:false;local:false};
  mt registry.entries {
    entry;
      if foundopt{
      }else{
        if str.contains(entry.modelid;modelid){
          if str.len(entry.modelid)==str.len(modelid){
            found=entry;
            foundopt=true
          };
        };
      };
  };
  if foundopt{
    <found
  }else{
    let msg=str.concat("by_id: model not found: ";modelid);
    <$lokeerr.$modelerr(msg)
  };
};

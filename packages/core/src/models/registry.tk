    $modelcapability{modelid:"claude-3-5-haiku-20241022";provider:$anthropic;task:$codegeneration;qualityscore:0.82;speedtoks:120.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-3-5-haiku-20241022";provider:$anthropic;task:$summarisation;qualityscore:0.82;speedtoks:120.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$openai;task:$chat;qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};
    $modelcapability{modelid:"gpt-4o";provider:$openai;task:$codegeneration;qualityscore:0.93;speedtoks:90.0;contextwindow:128000;supportstools:true;local:false};

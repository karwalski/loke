m=core.models.registry;



i=t:shared.types;
i=str:std.str;
i=json:std.json;

t=$modelcapability{
  modelid:str;
  provider:$provider;
  task:$tasktype;
  qualityscore:f64;
  speedtoks:f64;
  contextwindow:u32;
  supportstools:bool;
  local:bool
};

t=$registry{
  entries:@$modelcapability
};

f=defaultentries():@$modelcapability{
  let entries=@(
    $modelcapability{modelid:"claude-3-5-sonnet-20241022";provider:$anthropic;task:$chat;qualityscore:0.95;speedtoks:80.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-3-5-sonnet-20241022";provider:$anthropic;task:$codegeneration;qualityscore:0.95;speedtoks:80.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-3-5-sonnet-20241022";provider:$anthropic;task:$codereview;qualityscore:0.95;speedtoks:80.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-3-5-sonnet-20241022";provider:$anthropic;task:$summarisation;qualityscore:0.95;speedtoks:80.0;contextwindow:200000;supportstools:true;local:false};
    $modelcapability{modelid:"claude-3-5-sonnet-20241022";provider:$anthropic;task:$classification;qualityscore:0.95;speedtoks:80.0;contextwindow:200000;supportstools:true;local:false};

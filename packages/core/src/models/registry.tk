m=core.models.registry;



i=t:shared.types;
i=str:std.str;

t=$tasktype{
  $chat:i64;
  $codegeneration:i64;
  $codereview:i64;
  $summarisation:i64;
  $classification:i64;
  $ner:i64;
  $embedding:i64;
  $dataanalysis:i64};

t=$modelcapability{
  modelid:str;
  provider:$provider;
  task:$tasktype;
  qualityscore:f64;
  speedtoks:f64;
  contextwindow:u32;
  supportstools:bool;
  local:bool
};

t=$registry{
  entries:@$modelcapability
};


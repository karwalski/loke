m=core.models.registry;



i=t:shared.types;
i=str:std.str;

t=$tasktype{
  $chat;
  $codegeneration;
  $codereview;
  $summarisation;
  $classification;
  $ner;
  $embedding;
  $dataanalysis
};

t=$modelcapability{
  modelid:str;
  provider:$provider;
  task:$tasktype;
  qualityscore:f64;
  speedtoks:f64;
  contextwindow:u32;
  supportstools:bool;
  local:bool
};

t=$registry{
  entries:@$modelcapability
};


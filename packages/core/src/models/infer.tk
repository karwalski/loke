m=core.models.infer;




i=inf:std.infer;
i=log:shared.log;
i=str:std.str;
i=t:shared.types;

t=$infermodel{
  handle:i64;
  modelid:str;
  modelpath:str;
  loadedat:i64
};

t=$inferpool{
  models:@$infermodel;
  datadir:str
};

f=newpool(datadir:str):$inferpool{
  <$inferpool{models:@();datadir:datadir}
};

f=modelpath(pool:$inferpool;modelid:str):str{
  let base=str.concat(pool.datadir;"/models/");
  let withid=str.concat(base;modelid);
  <str.concat(withid;".gguf")
};

f=load(pool:$inferpool;modelid:str):$inferpool{
  let path=modelpath(pool;modelid);
  let opts=$inferopts{ngpulayers:99;nthreads:4;seed:0};
  let handle=inf.load(path;opts);
  let entry=$infermodel{
    handle:handle;
    modelid:modelid;
    modelpath:path;
    loadedat:std.time.now()
  };
  let updatedmodels=pool.models.append(entry);
  log.info(str.concat("loaded in-process: ";modelid);"infer";"");
  <$inferpool{models:updatedmodels;datadir:pool.datadir}
};

f=unload(pool:$inferpool;modelid:str):$inferpool{
  let remaining=@();
  lp(let i=0;i<str.arraylen(pool.models);i=i+1){ let m=str.arrayget(pool.models;i);
    if(str.eq(m.modelid;modelid)){
      inf.unload(m.handle)
    }el{
      let remaining=remaining.append(m)
    }
  };
  <$inferpool{models:remaining;datadir:pool.datadir}
};

f=generate(pool:$inferpool;modelid:str;prompt:str;maxtokens:i32):str{
  let foundopt=false;
  let result="";
  lp(let ii62=0;ii62<pool.models.len;ii62=ii62+1){
    let m=pool.models.get(ii62);
    if(!$foundopt){
      if(str.eq(m.modelid;modelid)){
        let result=inf.generate(m.handle;prompt;maxtokens);
        let foundopt=true
      };
    };

  };
  <result
};

f=embed(pool:$inferpool;modelid:str;text:str):@f32{
  let foundopt=false;
  let result=@();
  lp(let ii78=0;ii78<pool.models.len;ii78=ii78+1){
    let m=pool.models.get(ii78);
    if(!$foundopt){
      if(str.eq(m.modelid;modelid)){
        let result=inf.embed(m.handle;text);
        let foundopt=true
      }
    }

  };
  <result
};

f=isloaded(pool:$inferpool;modelid:str):bool{
  let found=false;
  lp(let ii93=0;ii93<pool.models.len;ii93=ii93+1){
    let m=pool.models.get(ii93);
    if(str.eq(m.modelid;modelid)){
      let found=true
    }

  };
  <found
};

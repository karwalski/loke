m=core.models.infer;




i=inf:std.infer;
i=log:shared.log;
i=t:shared.types;

t=$infermodel{
  handle:i64;
  modelid:str;
  modelpath:str;
  loadedat:i64
};

t=$inferpool{
  models:@$infermodel;
  datadir:str
};

f=newpool(datadir:str):$inferpool{
  <$inferpool{models:@();datadir:datadir}
};

f=modelpath(pool:$inferpool;modelid:str):str{
  let base=str.concat(pool.datadir;"/models/");
  let withid=str.concat(base;modelid);
  <str.concat(withid;".gguf")
};

f=load(pool:$inferpool;modelid:str):$inferpool{
  let path=modelpath(pool;modelid);
  let opts=inf.$inferopts{ngpulayers:99;nthreads:4;seed:0};
  let handle=inf.load(path;opts);
  let entry=$infermodel{
    handle:handle;
    modelid:modelid;
    modelpath:path;
    loadedat:std.time.now()
  };
  let updatedmodels=@(pool.models;entry);
  log.info(str.concat("loaded in-process: ";modelid);"infer";"");
  <$inferpool{models:updatedmodels;datadir:pool.datadir}
};

f=unload(pool:$inferpool;modelid:str):$inferpool{
  let remaining=@();
  mt pool.models {
    m;
      if(str.eq(m.modelid;modelid)){
        inf.unload(m.handle)
      }el{
        remaining=@(remaining;m)
      }
  };
  <$inferpool{models:remaining;datadir:pool.datadir}
};

f=generate(pool:$inferpool;modelid:str;prompt:str;maxtokens:i32):str{
  let foundopt=false;
  let result="";
  mt pool.models {
    m;
      if(foundopt){
      }el{
        if(str.eq(m.modelid;modelid)){
          result=inf.generate(m.handle;prompt;maxtokens);
          foundopt=true
        }
      }
  };
  <result
};

f=embed(pool:$inferpool;modelid:str;text:str):@f32{
  let foundopt=false;
  let result=@();
  mt pool.models {
    m;
      if(foundopt){
      }el{
        if(str.eq(m.modelid;modelid)){
          result=inf.embed(m.handle;text);
          foundopt=true
        }
      }
  };
  <result
};

f=isloaded(pool:$inferpool;modelid:str):bool{
  let found=false;
  mt pool.models {
    m;
      if(str.eq(m.modelid;modelid)){
        found=true
      }
  };
  <found
};

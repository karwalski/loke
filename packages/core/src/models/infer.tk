(* In-process inference pool over std.infer.

   std.infer is a STUB in toke: load and loadstreaming return 0, isloaded returns
   0, embed returns an empty array, and generate returns the literal string
   "[infer: not available]". So this module's job today is to report that
   truthfully rather than to hide it.

   A zero handle means the model did not load, and a model that did not load is
   not added to the pool. isloaded is then honestly false, and a caller that
   depends on local inference — privacy/ner_local is one — sees an unavailable
   layer instead of receiving the stub's sentinel string as if it were output.
   Returning "[infer: not available]" to a privacy detector would read as
   "no entities found", which is a fail-open.

   F10.39, toke 3.1.0: std.infer is typed now. load takes (path; opts) and answers
   `modelhandle!infererr`, generate takes a token limit and answers `str!infererr`, and the
   stub reports no false success (T-11): with no backend compiled in, load takes $err. So
   a model is in the pool only when load took $ok, and every $err reads as "not loaded" or
   "" exactly as the zero handle did. *)

m=core.models.infer;

i=time:std.time;
i=str:std.str;
i=log:shared.log;
i=inf:std.infer;

t=$infermodel{
  handle:$modelhandle;
  modelid:str;
  modelpath:str;
  loadedat:i64
};

t=$inferpool{
  models:@$infermodel;
  datadir:str
};

f=newpool(datadir:str):$inferpool{
  <$inferpool{models:@();datadir:datadir}
};

f=modelpath(pool:$inferpool;modelid:str):str{
  <"\(pool.datadir)/models/\(modelid).gguf"
};

f=load(pool:$inferpool;modelid:str):$inferpool{
  let path=modelpath(pool;modelid);
  <mt inf.load(path;$inferopts{ngpulayers:0;nthreads:0;seed:0}) {
    $ok:handle loaded(pool;modelid;path;handle);
    $err:e notloaded(pool;modelid)
  }
};

f=notloaded(pool:$inferpool;modelid:str):$inferpool{
  log.warn("in-process inference unavailable, \(modelid) not loaded";"infer";"");
  <pool
};

f=loaded(pool:$inferpool;modelid:str;path:str;handle:$modelhandle):$inferpool{
  log.info("loaded in-process: \(modelid)";"infer";"");
  <$inferpool{
    models:pool.models.push($infermodel{
      handle:handle;
      modelid:modelid;
      modelpath:path;
      loadedat:time.now()
    });
    datadir:pool.datadir
  }
};

f=unload(pool:$inferpool;modelid:str):$inferpool{
  (* `let remaining=remaining.append(m)` inside the loop declared a new binding each
     pass instead of assigning, so unload dropped every model in the pool. *)
  let remaining=mut.@();
  lp(let i=0;i<pool.models.len;i=i+1){
    let m:$infermodel=pool.models.get(i);
    if(str.eq(m.modelid;modelid)){
      inf.unload(m.handle)
    }el{
      remaining=remaining.push(m)
    }
  };
  <$inferpool{models:remaining;datadir:pool.datadir}
};

(* The pool index of `modelid`, or -1 when it is not loaded. It replaces handlefor, whose
   zero handle meant "not loaded": a modelhandle is a record, not a number. *)
f=indexfor(pool:$inferpool;modelid:str):i64{
  let at=mut.0-1;
  lp(let i=0;i<pool.models.len;i=i+1){
    let m:$infermodel=pool.models.get(i);
    if(str.eq(m.modelid;modelid)){
      at=i
    }el{}
  };
  <at
};

(* Returns "" when the model is not loaded. The caller must distinguish that from a
   real empty generation; isloaded is the check for it. *)
f=generate(pool:$inferpool;modelid:str;prompt:str;maxtokens:i32):str{
  let at=indexfor(pool;modelid);
  if(at<0){
    <""
  }el{
    let m:$infermodel=pool.models.get(at);
    <mt inf.generate(m.handle;prompt;maxtokens) { $ok:s s; $err:e "" }
  }
};

f=embed(pool:$inferpool;modelid:str;text:str):@f32{
  let at=indexfor(pool;modelid);
  if(at<0){
    <@()
  }el{
    let m:$infermodel=pool.models.get(at);
    <mt inf.embed(m.handle;text) { $ok:v v; $err:e @() }
  }
};

f=isloaded(pool:$inferpool;modelid:str):bool{
  <indexfor(pool;modelid)>=0
};

m=core.models.tiers;






i=t:shared.types;
i=hw:core.models.hardware;
i=str:std.str;
i=log:shared.log;



t=$tierconfig{
  tier:$modeltier;
  numgpulayers:i32;
  usemmap:bool;
  usemlock:bool;
  ctxsize:u32;
  batchsize:u32
};

t=$tierselection{
  tier:$modeltier;
  config:$tierconfig;
  reason:str;
  estimatedtoks:f64;
  modelid:str
};




f=configfortier(tier:$modeltier):$tierconfig{
  <mt tier {
    $interactive:v $tierconfig{
        tier:$interactive;
        numgpulayers:-1;
        usemmap:false;
        usemlock:true;
        ctxsize:4096;
        batchsize:512
      };
    $considered:v $tierconfig{
        tier:$considered;
        numgpulayers:20;
        usemmap:true;
        usemlock:false;
        ctxsize:8192;
        batchsize:256
      };
    $background:v $tierconfig{
        tier:$background;
        numgpulayers:4;
        usemmap:true;
        usemlock:false;
        ctxsize:32768;
        batchsize:64
      }
  }
};





f=tierselectinstant(viability:i64;modelid:str;cid:str):$modeltier{
  if(viability.interactive){
    <$interactive
  }el{
    log.warn(
      str.concat("select_tier: $instant requested but hardware cannot run ";str.concat(modelid;" interactively — falling back to $considered"));
      "tiers";
      cid
    );
    <$considered
  }
};

f=tierselectpatient(viability:i64):$modeltier{
  if(viability.interactive){
    <$interactive
  }el{
    <$considered
  }
};

f=tierreasoninstant(viability:i64):str{
  if(viability.interactive){
    <"instant tolerance — full GPU offload"
  }el{
    <"instant tolerance — hardware insufficient for interactive; using considered"
  }
};

f=tierreasonpatient(viability:i64):str{
  if(viability.interactive){
    <"patient tolerance — hardware supports interactive"
  }el{
    <"patient tolerance — model too large for interactive; using considered"
  }
};

f=selecttier(tolerance:$latencytolerance;profile:i64;modelsizegb:f64;modelid:str):$tierselection{
  let viability=hw.estimatetierviability(profile;modelsizegb);
  let cid=log.newcorrelationid();

  let selectedtier=mt tolerance {
    $instant:v tierselectinstant(viability;modelid;cid);
    $patient:v tierselectpatient(viability);
    $background:v $background
  };

  let estimatedtoks=mt selectedtier {
    $interactive:v viability.interactivetoks;
    $considered:v  viability.consideredtoks;
    $background:v  viability.backgroundtoks
  };

  let reason=mt tolerance {
    $instant:v tierreasoninstant(viability);
    $patient:v tierreasonpatient(viability);
    $background:v "background tolerance — minimal GPU, large context window"
  };

  let config=configfortier(selectedtier);

  let tokss=str.fromfloat(estimatedtoks);
  log.info(
    str.concat(
      "select_tier: ";
      str.concat(
        modelid;
        str.concat(
          " → ";
          str.concat(
            tierlabel(selectedtier);
            str.concat(" (~";str.concat(tokss;" tok/s)"))
          )
        )
      )
    );
    "tiers";
    cid
  );

  <$tierselection{
    tier:selectedtier;
    config:config;
    reason:reason;
    estimatedtoks:estimatedtoks;
    modelid:modelid
  }
};





f=applytoollamaopts(config:$tierconfig):str{
  let gpus=str.fromint(config.numgpulayers as i64);
  let mmaps=mut."false";
  if(config.usemmap){mmaps="true"}el{};
  let mlocks=mut."false";
  if(config.usemlock){mlocks="true"}el{};
  let ctxs=str.fromint(config.ctxsize as i64);
  let batchs=str.fromint(config.batchsize as i64);
  <str.concat(
    "{\"num_gpu\":";
    str.concat(
      gpus;
      str.concat(
        ",\"use_mmap\":";
        str.concat(
          mmaps;
          str.concat(
            ",\"use_mlock\":";
            str.concat(
              mlocks;
              str.concat(
                ",\"num_ctx\":";
                str.concat(
                  ctxs;
                  str.concat(
                    ",\"num_batch\":";
                    str.concat(batchs;"}")
                  )
                )
              )
            )
          )
        )
      )
    )
  )
};




f=tierlabel(tier:$modeltier):str{
  mt tier {
    $interactive:v "Interactive (instant)";
    $considered:v  "Considered (~30s)";
    $background:v  "Background (minutes)"
  }
};

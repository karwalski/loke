m=core.models.tiers;






i=t:shared.types;
i=hw:core.models.hardware;
i=str:std.str;
i=log:shared.log;



t=$tierconfig{
  tier:$modeltier;
  numgpulayers:i32;
  usemmap:bool;
  usemlock:bool;
  ctxsize:u32;
  batchsize:u32
};

t=$tierselection{
  tier:$modeltier;
  config:$tierconfig;
  reason:str;
  estimatedtoks:f64;
  modelid:str
};




f=configfortier(tier:$modeltier):$tierconfig{
  mt tier {
    $interactive {
      <$tierconfig{
        tier:$modeltier.$interactive;
        numgpulayers:-1;
        usemmap:false;
        usemlock:true;
        ctxsize:4096;
        batchsize:512
      };
    };
    $considered {
      <$tierconfig{
        tier:$modeltier.$considered;
        numgpulayers:20;
        usemmap:true;
        usemlock:false;
        ctxsize:8192;
        batchsize:256
      };
    };
    $background {
      <$tierconfig{
        tier:$modeltier.$background;
        numgpulayers:4;
        usemmap:true;
        usemlock:false;
        ctxsize:32768;
        batchsize:64
      };
    };
  };
};





f=selecttier(tolerance:$latencytolerance;profile:$hw.hardwareprofile;modelsizegb:f64;modelid:str):$tierselection{
  let viability=hw.estimatetierviability(profile;modelsizegb);
  let cid=log.newcorrelationid();

  let selectedtier=mt tolerance {
    $instant {
      
      if viability.interactive{
        $modeltier.$interactive
      }else{
        log.warn(
          str.concat("select_tier: $instant requested but hardware cannot run ";str.concat(modelid;" interactively — falling back to $considered"));
          "tiers";
          cid
        );
        $modeltier.$considered
      };
    };
    $patient {
      
      if viability.interactive{
        $modeltier.$interactive
      }else{
        $modeltier.$considered
      };
    };
    $background {
      $modeltier.$background
    };
  };

  let estimatedtoks=mt selectedtier {
    $interactive viability.interactivetoks;
    $considered  viability.consideredtoks;
    $background  viability.backgroundtoks
  };

  let reason=mt tolerance {
    $instant {
      if viability.interactive{
        "instant tolerance — full GPU offload"
      }else{
        "instant tolerance — hardware insufficient for interactive; using considered"
      };
    };
    $patient {
      if viability.interactive{
        "patient tolerance — hardware supports interactive"
      }else{
        "patient tolerance — model too large for interactive; using considered"
      };
    };
    $background {
      "background tolerance — minimal GPU, large context window"
    };
  };

  let config=configfortier(selectedtier);

  let tokss=str.fromfloat(estimatedtoks);
  log.info(
    str.concat(
      "select_tier: ";
      str.concat(
        modelid;
        str.concat(
          " → ";
          str.concat(
            tierlabel(selectedtier);
            str.concat(" (~";str.concat(tokss;" tok/s)"))
          )
        )
      )
    );
    "tiers";
    cid
  );

  <$tierselection{
    tier:selectedtier;
    config:config;
    reason:reason;
    estimatedtoks:estimatedtoks;
    modelid:modelid
  };
};





f=applytoollamaopts(config:$tierconfig):str{
  let gpus=str.fromint(config.numgpulayers as i64);
  let mmaps=if config.usemmap{"true"}else{"false"};
  let mlocks=if config.usemlock{"true"}else{"false"};
  let ctxs=str.fromint(config.ctxsize as i64);
  let batchs=str.fromint(config.batchsize as i64);
  <str.concat(
    "{\"num_gpu\":";
    str.concat(
      gpus;
      str.concat(
        ",\"use_mmap\":";
        str.concat(
          mmaps;
          str.concat(
            ",\"use_mlock\":";
            str.concat(
              mlocks;
              str.concat(
                ",\"num_ctx\":";
                str.concat(
                  ctxs;
                  str.concat(
                    ",\"num_batch\":";
                    str.concat(batchs;"}")
                  )
                )
              )
            )
          )
        )
      )
    )
  )
};




f=tierlabel(tier:$modeltier):str{
  mt tier {
    $interactive "Interactive (instant)";
    $considered  "Considered (~30s)";
    $background  "Background (minutes)"
  };
};

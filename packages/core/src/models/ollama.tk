m=core.models.ollama;



i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;

t=$ollamamodel{
  name:str;
  size:u64;
  digest:str
};

t=$ollamastatus{
  $running:i64;
  $stopped:i64;
  $unreachable:i64};

t=$chatmessage{
  role:str;
  content:str
};

t=$generateopts{
  model:str;
  prompt:str;
  system:str;
  numgpu:i32
};

t=$chatopts{
  model:str;
  messages:@$chatmessage;
  system:str;
  numgpu:i32
};

t=$ollamaclient{
  baseurl:str
};

f=new(baseurl:str):$ollamaclient{
  let client=$ollamaclient{baseurl:baseurl};
  <client
};

f=healthcheck(client:$ollamaclient):$ollamastatus{
  let url=str.concat(client.baseurl;"/api/tags");
  let result=http.get(url);
  let checkerr=mt result {
    $ok:v "";
    $httperr:e json.enc(e)
  };
  if(str.eq(checkerr;"")){
    <$running
  }el{
    if(str.contains(checkerr;"connect")){
      <$unreachable
    }el{
      <$stopped
    }
  }
};

f=listmodels(client:$ollamaclient):@$ollamamodel!$lokeerr{
  let url=str.concat(client.baseurl;"/api/tags");
  let result=http.get(url);
  let body=mt result {
    $ok:body body;
    $httperr:e $err($networkerr("ollama listmodels: failed to reach /api/tags"))
  };
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e $err($modelerr("ollama listmodels: failed to parse JSON response"))
  };
  let rawarr=json.getarr(obj;"models");
  let models=@();
  lp(let i=0;i<str.arraylen(rawarr);i=i+1){ let item=str.arrayget(rawarr;i);
    let name=json.getstr(item;"name");
    let size=json.getint(item;"size");
    let digest=json.getstr(item;"digest");
    let m=$ollamamodel{name:name;size:size;digest:digest};
    let models=models.append(m)
  };
  <$ok(models)
};

f=listrunning(client:$ollamaclient):@$ollamamodel!$lokeerr{
  let url=str.concat(client.baseurl;"/api/ps");
  let result=http.get(url);
  let body=mt result {
    $ok:body body;
    $httperr:e $err($networkerr("ollama listrunning: failed to reach /api/ps"))
  };
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e $err($modelerr("ollama listrunning: failed to parse JSON response"))
  };
  let rawarr=json.getarr(obj;"models");
  let models=@();
  lp(let i=0;i<str.arraylen(rawarr);i=i+1){ let item=str.arrayget(rawarr;i);
    let name=json.getstr(item;"name");
    let size=json.getint(item;"size");
    let m=$ollamamodel{name:name;size:size;digest:""};
    let models=models.append(m)
  };
  <$ok(models)
};

f=generate(client:$ollamaclient;opts:$generateopts):str!$lokeerr{
  let url=str.concat(client.baseurl;"/api/generate");
  let bodyobj=json.enc(json.obj("model";opts.model;"prompt";opts.prompt;"system";opts.system;"numgpu";str.fromint(opts.numgpu);"stream";"false"));
  let result=http.post(url;bodyobj;"application/json");
  let body=mt result {
    $ok:body body;
    $httperr:e $err($networkerr("ollama generate: failed to reach /api/generate"))
  };
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e $err($modelerr("ollama generate: failed to parse JSON response"))
  };
  let response=json.getstr(obj;"response");
  <$ok(response)
};

f=chat(client:$ollamaclient;opts:$chatopts):str!$lokeerr{
  let url=str.concat(client.baseurl;"/api/chat");
  let bodyobj=json.enc(json.obj("model";opts.model;"messages";json.enc(opts.messages);"system";opts.system;"numgpu";str.fromint(opts.numgpu);"stream";"false"));
  let result=http.post(url;bodyobj;"application/json");
  let body=mt result {
    $ok:body body;
    $httperr:e $err($networkerr("ollama chat: failed to reach /api/chat"))
  };
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e $err($modelerr("ollama chat: failed to parse JSON response"))
  };
  let msg=json.getstr(obj;"message");
  let msgparsed=json.dec(msg);
  let msgobj=mt msgparsed {
    $ok:msgobj msgobj;
    $jsonerr:e $err($modelerr("ollama chat: failed to parse message field"))
  };
  let content=json.getstr(msgobj;"content");
  <$ok(content)
};

f=pullmodel(client:$ollamaclient;name:str):bool!$lokeerr{
  let url=str.concat(client.baseurl;"/api/pull");
  let bodyobj=json.enc(json.obj("name";name));
  let result=http.post(url;bodyobj;"application/json");
  mt result {
    $ok:body $ok(true);
    $httperr:e $err($networkerr("ollama pullmodel: failed to reach /api/pull"))
  }
};

f=deletemodel(client:$ollamaclient;name:str):bool!$lokeerr{
  let url=str.concat(client.baseurl;"/api/delete");
  let bodyobj=json.enc(json.obj("name";name));
  let result=http.post(url;bodyobj;"application/json");
  mt result {
    $ok:body $ok(true);
    $httperr:e $err($networkerr("ollama deletemodel: failed to reach /api/delete"))
  }
};

m=core.models.ollama;



i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;

t=$ollamamodel{
  name:str;
  size:u64;
  digest:str
};

t=$ollamastatus{
  $running;
  $stopped;
  $unreachable
};

t=$chatmessage{
  role:str;
  content:str
};

t=$generateopts{
  model:str;
  prompt:str;
  system:str;
  numgpu:i32
};

t=$chatopts{
  model:str;
  messages:@$chatmessage;
  system:str;
  numgpu:i32
};

t=$ollamaclient{
  baseurl:str
};

f=new(baseurl:str):$ollamaclient{
  let client=$ollamaclient{baseurl:baseurl};
  <client
};

f=healthcheck(client:$ollamaclient):$ollamastatus{
  let url=str.concat(client.baseurl;"/api/tags");
  let result=http.get(url);
  mt result {
    $httperr e;
      let msg=json.enc(e);
      if str.contains(msg;"connect"){
        <$ollamastatus.$unreachable
      }else{
        <$ollamastatus.$stopped
      };
    v;
      <$ollamastatus.$running
  };
};

f=listmodels(client:$ollamaclient):@$ollamamodel|$lokeerr{
  let url=str.concat(client.baseurl;"/api/tags");
  let result=http.get(url);
  mt result {
    $httperr e;
      <$lokeerr.$networkerr("ollama list_models: failed to reach /api/tags")
    body;
      let parsed=json.dec(body);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$modelerr("ollama list_models: failed to parse JSON response")
        obj;
          let rawarr=json.getarr(obj;"models");
          let models=@();
          mt rawarr {
            item;
              let name=json.getstr(item;"name");
              let size=json.getint(item;"size");
              let digest=json.getstr(item;"digest");
              let m=$ollamamodel{name:name;size:size;digest:digest};
              models=@(models;m)
          };
          <models
      };
  };
};

f=listrunning(client:$ollamaclient):@$ollamamodel|$lokeerr{
  let url=str.concat(client.baseurl;"/api/ps");
  let result=http.get(url);
  mt result {
    $httperr e;
      <$lokeerr.$networkerr("ollama list_running: failed to reach /api/ps")
    body;
      let parsed=json.dec(body);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$modelerr("ollama list_running: failed to parse JSON response")
        obj;
          let rawarr=json.getarr(obj;"models");
          let models=@();
          mt rawarr {
            item;
              let name=json.getstr(item;"name");
              let size=json.getint(item;"size");
              let m=$ollamamodel{name:name;size:size;digest:""};
              models=@(models;m)
          };
          <models
      };
  };
};

f=generate(client:$ollamaclient;opts:$generateopts):str|$lokeerr{
  let url=str.concat(client.baseurl;"/api/generate");
  let bodyobj=json.enc({model:opts.model;prompt:opts.prompt;system:opts.system;numgpu:opts.numgpu;stream:false});
  let result=http.post(url;bodyobj;"application/json");
  mt result {
    $httperr e;
      <$lokeerr.$networkerr("ollama generate: failed to reach /api/generate")
    body;
      let parsed=json.dec(body);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$modelerr("ollama generate: failed to parse JSON response")
        obj;
          let response=json.getstr(obj;"response");
          <response
      };
  };
};

f=chat(client:$ollamaclient;opts:$chatopts):str|$lokeerr{
  let url=str.concat(client.baseurl;"/api/chat");
  let bodyobj=json.enc({model:opts.model;messages:opts.messages;system:opts.system;numgpu:opts.numgpu;stream:false});
  let result=http.post(url;bodyobj;"application/json");
  mt result {
    $httperr e;
      <$lokeerr.$networkerr("ollama chat: failed to reach /api/chat")
    body;
      let parsed=json.dec(body);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$modelerr("ollama chat: failed to parse JSON response")
        obj;
          let msg=json.getstr(obj;"message");
          let msgparsed=json.dec(msg);
          mt msgparsed {
            $jsonerr e;
              <$lokeerr.$modelerr("ollama chat: failed to parse message field")
            msgobj;
              let content=json.getstr(msgobj;"content");
              <content
          };
      };
  };
};

f=pullmodel(client:$ollamaclient;name:str):bool|$lokeerr{
  let url=str.concat(client.baseurl;"/api/pull");
  let bodyobj=json.enc({name:name});
  let result=http.post(url;bodyobj;"application/json");
  mt result {
    $httperr e;
      <$lokeerr.$networkerr("ollama pull_model: failed to reach /api/pull")
    body;
      let parsed=json.dec(body);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$modelerr("ollama pull_model: failed to parse JSON response")
        obj;
          <true
      };
  };
};

f=deletemodel(client:$ollamaclient;name:str):bool|$lokeerr{
  let url=str.concat(client.baseurl;"/api/delete");
  let bodyobj=json.enc({name:name});
  let result=http.post(url;bodyobj;"application/json");
  mt result {
    $httperr e;
      <$lokeerr.$networkerr("ollama delete_model: failed to reach /api/delete")
    body;
      <true
  };
};

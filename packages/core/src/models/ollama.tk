m=core.models.ollama;



i=http:std.http;
i=json:std.json;
i=str:std.str;
i=t:shared.types;
i=reach:shared.reachability;

t=$ollamamodel{
  name:str;
  size:u64;
  digest:str
};

t=$ollamastatus{
  $running:i64;
  $stopped:i64;
  $unreachable:i64};

t=$chatmessage{
  role:str;
  content:str
};

t=$generateopts{
  model:str;
  prompt:str;
  system:str;
  numgpu:i32
};

t=$chatopts{
  model:str;
  messages:@$chatmessage;
  system:str;
  numgpu:i32
};

t=$ollamaclient{
  baseurl:str
};

f=new(baseurl:str):$ollamaclient{
  let client=$ollamaclient{baseurl:baseurl};
  <client
};

(* Every call here that uses http.get checks reachability FIRST. Against a closed port
   http.get returns $ok carrying a NIL response (T-15). So this healthcheck answered 1,
   "running", whenever Ollama was down, and listmodels and listrunning parsed the nil body
   and crashed the process. That crash is what killed the /installer page's worker on
   every request once the page returned its value. shared.reachability binds the port to
   find out, which is honest for a local sidecar. *)
f=healthcheck(client:$ollamaclient):$ollamastatus{
  (* Declared `:i64` and returning 1 or 0 until 2026-09-24, while all five callers bound
     the result as `$ollamastatus` and matched on it. Now it returns the sum they read. *)
  if(!reach.localserviceup(client.baseurl)){ <$ollamastatus{$unreachable:0} }el{};
  let url=str.concat(client.baseurl;"/api/tags");
  let result=http.get(url);
  let answered=mt result {
    $ok:v true;
    $httperr:e false
  };
  if(answered){ <$ollamastatus{$running:0} }el{};
  <$ollamastatus{$stopped:0}
};

f=listmodels(client:$ollamaclient):@$ollamamodel!$lokeerr{
  (* Empty, not $err: every caller matches this result, and T-18 reads a returned $err
     as $ok, so an error here would crash the caller. "No models" is also what a user
     with Ollama stopped can act on; healthcheck reports why. *)
  if(!reach.localserviceup(client.baseurl)){ <$ok(@()) }el{};
  let url=str.concat(client.baseurl;"/api/tags");
  let result=http.get(url);
  let body=mt result {
    $ok:body body;
    $httperr:e $err($networkerr("ollama listmodels: failed to reach /api/tags"))
  };
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e $err($modelerr("ollama listmodels: failed to parse JSON response"))
  };
  let rawarr=json.getarr(obj;"models");
  (* `let models=models.append(m)` declared a new binding each pass, so this always
     returned an empty list and loke never saw a single installed model. *)
  let models=mut.@();
  lp(let i=0;i<rawarr.len;i=i+1){
    let item=str.arrayget(rawarr;i);
    models=models.push($ollamamodel{
      name:json.str(item;"name");
      size:json.i64(item;"size");
      digest:json.str(item;"digest")
    })
  };
  <$ok(models)
};

f=listrunning(client:$ollamaclient):@$ollamamodel!$lokeerr{
  (* Empty, not $err: every caller matches this result, and T-18 reads a returned $err
     as $ok, so an error here would crash the caller. "No models" is also what a user
     with Ollama stopped can act on; healthcheck reports why. *)
  if(!reach.localserviceup(client.baseurl)){ <$ok(@()) }el{};
  let url=str.concat(client.baseurl;"/api/ps");
  let result=http.get(url);
  let body=mt result {
    $ok:body body;
    $httperr:e $err($networkerr("ollama listrunning: failed to reach /api/ps"))
  };
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e $err($modelerr("ollama listrunning: failed to parse JSON response"))
  };
  let rawarr=json.getarr(obj;"models");
  let models=mut.@();
  lp(let i=0;i<rawarr.len;i=i+1){
    let item=str.arrayget(rawarr;i);
    models=models.push($ollamamodel{
      name:json.str(item;"name");
      size:json.i64(item;"size");
      digest:""
    })
  };
  <$ok(models)
};

f=generate(client:$ollamaclient;opts:$generateopts):str!$lokeerr{
  let hc=http.client(client.baseurl);
  let bodyobj="{\"model\":\(json.enc(opts.model)),\"prompt\":\(json.enc(opts.prompt)),\"system\":\(json.enc(opts.system)),\"numgpu\":\(opts.numgpu),\"stream\":false}";
  let result=http.postheaders(hc;"/api/generate";str.tobytes(bodyobj);"{\"content-type\":\"application/json\"}");
  let body=mt result {
    $ok:body body;
    $httperr:e $err($networkerr("ollama generate: failed to reach /api/generate"))
  };
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e $err($modelerr("ollama generate: failed to parse JSON response"))
  };
  let response=json.str(obj;"response");
  <$ok(response)
};

(* LS1.1j — sendchatplain is the form core.providers.ollamaprovider can act on.

   Two defects were stacked here. The obvious one is T-18: sendchat returns str!$lokeerr,
   toke takes the FIRST arm of a match on a result whose error side is a user-declared sum
   whatever the value is, and ollama_provider.complete matched it with the $lokeerr arm
   FIRST — so every ollama and every local dispatch reported "chat call failed" even when
   the model had answered. That is the whole local path, which is the path loke exists to
   prefer.

   The quieter one was in this body. Each of the three inner matches on a STDLIB result —
   those do discriminate correctly — used the match as an EXPRESSION assigned to a binding
   and put an $err(...) in the failure arm, rather than returning early. So on an HTTP
   failure `body` was bound to a $lokeerr handle and the very next line called
   json.dec(body) on it. The failure path parsed the error value as a response.

   The plain form returns the content, and "" for every failure. An ollama answer with no
   content is not a usable success either, so collapsing the two is safe in the direction
   that matters: a caller is told "nothing came back" rather than handed an empty answer
   as though the model had produced it. Each failure is logged before it is collapsed, so
   the distinction survives where an operator can see it. *)
f=sendchatplain(client:$ollamaclient;opts:$chatopts):str{
  let hc=http.client(client.baseurl);
  let bodyobj="{\"model\":\(json.enc(opts.model)),\"messages\":\(json.enc(opts.messages)),\"system\":\(json.enc(opts.system)),\"numgpu\":\(opts.numgpu),\"stream\":false}";
  let result=http.postheaders(hc;"/api/chat";str.tobytes(bodyobj);"{\"content-type\":\"application/json\"}");
  let body=mt result {
    $ok:body body;
    $httperr:e ""
  };
  if(str.len(body)==0){ <"" }el{};
  let parsed=json.dec(body);
  let obj=mt parsed {
    $ok:obj obj;
    $jsonerr:e 0
  };
  if(obj==0){ <"" }el{};
  let msg=json.str(obj;"message");
  let msgparsed=json.dec(msg);
  let msgobj=mt msgparsed {
    $ok:msgobj msgobj;
    $jsonerr:e 0
  };
  if(msgobj==0){ <"" }el{};
  <json.str(msgobj;"content")
};

(* Kept for callers that already match this result, delegating, the same migration shape
   as core.storage.audit.logevent. New callers use sendchatplain. *)
f=sendchat(client:$ollamaclient;opts:$chatopts):str!$lokeerr{
  let content=sendchatplain(client;opts);
  if(str.len(content)==0){
    <$err($networkerr("ollama chat: no content returned from /api/chat"))
  }el{
    <$ok(content)
  }
};

f=pullmodel(client:$ollamaclient;name:str):i64!$lokeerr{
  let hc=http.client(client.baseurl);
  let bodyobj="{\"name\":\(json.enc(name))}";
  let result=http.postheaders(hc;"/api/pull";str.tobytes(bodyobj);"{\"content-type\":\"application/json\"}");
  <mt result {
    $ok:body $ok(1);
    $httperr:e $err($networkerr("ollama pullmodel: failed to reach /api/pull"))
  }
};

f=deletemodel(client:$ollamaclient;name:str):i64!$lokeerr{
  let hc=http.client(client.baseurl);
  let bodyobj="{\"name\":\(json.enc(name))}";
  let result=http.postheaders(hc;"/api/delete";str.tobytes(bodyobj);"{\"content-type\":\"application/json\"}");
  <mt result {
    $ok:body $ok(1);
    $httperr:e $err($networkerr("ollama deletemodel: failed to reach /api/delete"))
  }
};

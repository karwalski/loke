m=core.models.queuetypes;

t=$jobpriority{
  $user:i64;
  $agent:i64;
  $evaluation:i64
};

t=$jobstatus{
  $pending:i64;
  $running:i64;
  $completed:i64;
  $failed:i64;
  $cancelled:i64
};

t=$queuejob{
  id:str;
  modelid:str;
  prompt:str;
  priority:$jobpriority;
  status:$jobstatus;
  createdat:str;
  startedat:str;
  completedat:str;
  result:str;
  error:str;
  estimatedtoks:f64
};

t=$jobqueue{
  jobs:@$queuejob;
  maxconcurrent:u32
};

(* Disk-streaming inference over std.infer.loadstreaming.

   std.infer is a stub: loadstreaming returns 0 and generate returns the literal
   "[infer: not available]". A zero handle is therefore reported as unavailable
   rather than carried as if it were a session, and generate returns "" so no
   caller mistakes the stub's sentinel for model output.

   The RAM ceiling and prefetch depth are kept in $streamconfig because they are
   loke's policy, but std.infer.loadstreaming takes only a path — it cannot be told
   about them. They are not being honoured by anything today. *)

m=core.models.streaming;
i=inf:std.infer;
i=log:shared.log;
i=str:std.str;
i=t:shared.types;

t=$streamconfig{ modeldir:str; ramceilinggb:f32; prefetchlayers:i32 };
t=$streamsession{ handle:i64; config:$streamconfig; modelid:str };

f=defaultconfig(modeldir:str):$streamconfig{
  <$streamconfig{ modeldir:modeldir; ramceilinggb:8.0; prefetchlayers:2 }
};

f=load(cfg:$streamconfig;modelid:str):$streamsession{
  let handle=inf.loadstreaming("\(cfg.modeldir)/\(modelid)");
  if(handle==0){
    log.warn("disk-streaming inference unavailable, \(modelid) not loaded";"streaming";"system")
  }el{
    log.info("disk-streaming model loaded: \(modelid) (RAM ceiling \(cfg.ramceilinggb)GB, not enforced by std.infer)";"streaming";"system")
  };
  <$streamsession{ handle:handle; config:cfg; modelid:modelid }
};

f=isloaded(session:$streamsession):bool{
  <session.handle!=0
};

f=generate(session:$streamsession;prompt:str;maxtokens:i32):str{
  if(session.handle==0){
    <""
  }el{
    <inf.generate(session.handle;prompt)
  }
};

f=unload(session:$streamsession):bool{
  if(session.handle==0){
    <false
  }el{
    let result=inf.unload(session.handle);
    log.info("unloaded streaming model: \(session.modelid)";"streaming";"system");
    <result
  }
};

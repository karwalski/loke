m=core.models.streaming;
i=inf:std.infer;
i=log:shared.log;
i=str:std.str;
i=t:shared.types;

t=$streamconfig{ modeldir:str; ramceilinggb:f32; prefetchlayers:i32 };
t=$streamsession{ handle:i64; config:$streamconfig; modelid:str };

f=defaultconfig(modeldir:str):$streamconfig{
  <$streamconfig{ modeldir:modeldir; ramceilinggb:8.0; prefetchlayers:2 }
};

f=load(cfg:$streamconfig;modelid:str):$streamsession{
  let opts=$streamopts{ ramceilinggb:cfg.ramceilinggb; prefetchlayers:cfg.prefetchlayers; requiresnvme:true };
  let path=str.concat(cfg.modeldir;str.concat("/";modelid));
  let handle=inf.loadstreaming(path;opts);
  log.info(str.concat("disk-streaming model loaded: ";str.concat(modelid;str.concat(" (RAM ceiling: ";str.concat(str.fromfloat(cfg.ramceilinggb);"GB)"))));"streaming";"system");
  <$streamsession{ handle:handle; config:cfg; modelid:modelid }
};

f=generate(session:$streamsession;prompt:str;maxtokens:i32):str{
  <inf.generate(session.handle;prompt;maxtokens)
};

f=unload(session:$streamsession):bool{
  let result=inf.unload(session.handle);
  log.info(str.concat("unloaded streaming model: ";session.modelid);"streaming";"system");
  <result
};

(* MLX inference pool over std.mlx.

   std.mlx is a stub: isavailable returns 0 unconditionally — including on Apple
   Silicon, where its own comment says availability depends on a framework that is
   not linked — load returns 0, and generate returns the literal
   "[mlx: not available]". So this pool reports unavailable and loads nothing,
   which is the truth. No MLX throughput figure can be measured through it.

   The previous version tested `!$pool.available`, a type sigil on a local, so the
   availability guard never read the flag; and it rebound `result` and `found` with
   `let` inside the loop, so generate always returned "".

   F10.39, toke 3.1.0: std.mlx is typed. load answers `mlxmodel!mlxerr`, generate takes a
   token limit and answers `str!mlxerr`, and neither reports false success (T-11). A model
   is pooled only when load took $ok; every $err reads as "not loaded" or "" as before. *)

m=core.models.mlx;

i=time:std.time;
i=str:std.str;
i=log:shared.log;
i=mlx:std.mlx;

t=$mlxloaded{ modelid:str; handle:$mlxmodel; loadedat:i64 };
t=$mlxpool{ models:@$mlxloaded; datadir:str; available:bool };

f=newpool(datadir:str):$mlxpool{
  let available=mlx.isavailable();
  log.info("MLX available: \(available)";"mlx";"system");
  <$mlxpool{ models:@(); datadir:datadir; available:available }
};

f=load(pool:$mlxpool;modelid:str):$mlxpool{
  if(!pool.available){
    log.warn("MLX unavailable, \(modelid) not loaded";"mlx";"system");
    <pool
  }el{
    <mt mlx.load("\(pool.datadir)/models/\(modelid).mlx") {
      $ok:handle loaded(pool;modelid;handle);
      $err:e notloaded(pool;modelid)
    }
  }
};

f=notloaded(pool:$mlxpool;modelid:str):$mlxpool{
  log.warn("MLX load returned no handle for \(modelid)";"mlx";"system");
  <pool
};

f=loaded(pool:$mlxpool;modelid:str;handle:$mlxmodel):$mlxpool{
  <$mlxpool{
    models:pool.models.push($mlxloaded{ modelid:modelid; handle:handle; loadedat:time.now() });
    datadir:pool.datadir;
    available:pool.available
  }
};

(* The pool index of `modelid`, or -1 when it is not loaded. *)
f=indexfor(pool:$mlxpool;modelid:str):i64{
  let at=mut.0-1;
  lp(let i=0;i<pool.models.len;i=i+1){
    let m:$mlxloaded=pool.models.get(i);
    if(str.eq(m.modelid;modelid)){
      at=i
    }el{}
  };
  <at
};

f=generate(pool:$mlxpool;modelid:str;prompt:str;maxtokens:i32):str{
  let at=indexfor(pool;modelid);
  if(at<0){
    <""
  }el{
    let m:$mlxloaded=pool.models.get(at);
    <mt mlx.generate(m.handle;prompt;maxtokens) { $ok:s s; $err:e "" }
  }
};

f=isavailable():bool{
  <mlx.isavailable()
};

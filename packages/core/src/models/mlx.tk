m=core.models.mlx;
i=mlx:std.mlx;
i=log:shared.log;
i=t:shared.types;

t=$mlxpool{ models:@$mlxloaded; datadir:str; available:bool };
t=$mlxloaded{ modelid:str; handle:i64; loadedat:i64 };

f=newpool(datadir:str):$mlxpool{
  available=mlx.isavailable();
  log.info("MLX available: {available}");
  <$mlxpool{ models:array.empty(); datadir:datadir; available:available };
};

f=load(pool:$mlxpool;modelid:str):$mlxpool{
  if(!$pool.available){ <pool };
  handle=mlx.load("{pool.data_dir}/models/{model_id}.mlx");
  entry=$mlxloaded{ modelid:modelid; handle:handle; loadedat:time.now() };
  <$mlxpool{ models:array.append(pool.models;entry); datadir:pool.datadir; available:pool.available };
};

f=generate(pool:$mlxpool;modelid:str;prompt:str;maxtokens:i32):(str){
  if(!$pool.available){ <$none };
  found=array.find(pool.models;f=(m:$mlxloaded):bool{ <m.modelid=modelid });
  |found{
    $none { <$none };
    $some:m {
      result=mlx.generate(m.handle;prompt;maxtokens);
      <$some(result)
    };
  };
};

f=isavailable():bool{
  <mlx.isavailable()
};

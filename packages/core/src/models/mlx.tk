m=core.models.mlx;
i=mlx:std.mlx;
i=log:shared.log;
i=str:std.str;
i=t:shared.types;

t=$mlxpool{ models:@$mlxloaded; datadir:str; available:bool };
t=$mlxloaded{ modelid:str; handle:i64; loadedat:i64 };

f=newpool(datadir:str):$mlxpool{
  let available=mlx.isavailable();
  log.info(str.concat("MLX available: ";str.frombool(available));"mlx";"system");
  <$mlxpool{ models:@(); datadir:datadir; available:available }
};

f=load(pool:$mlxpool;modelid:str):$mlxpool{
  if(!$pool.available){ <pool }el{
    let path=str.concat(pool.datadir;str.concat("/models/";str.concat(modelid;".mlx")));
    let handle=mlx.load(path);
    let entry=$mlxloaded{ modelid:modelid; handle:handle; loadedat:std.time.now() };
    <$mlxpool{ models:pool.models.append(entry); datadir:pool.datadir; available:pool.available }
  }
};

f=generate(pool:$mlxpool;modelid:str;prompt:str;maxtokens:i32):str{
  if(!$pool.available){ <"" }el{
    let found=false;
    let result="";
    lp(let i=0;i<str.arraylen(pool.models);i=i+1){ let m=str.arrayget(pool.models;i);
      if(!$found){
        if(str.eq(m.modelid;modelid)){
          let result=mlx.generate(m.handle;prompt;maxtokens);
          let found=true
        }
      }
    };
    <result
  }
};

f=isavailable():bool{
  <mlx.isavailable()
};

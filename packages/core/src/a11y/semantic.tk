m=core.a11y.semantic;

i=str:std.str;
i=aria:core.a11y.ariapatterns;

(* Ported from src/platform/a11y/semantic.tk (F10.12-T2). Landmark and control markup per
   docs/specifications/accessibility-platform.md sections 2.1 and 2.3.

   Fixed in the port: `navhtml` walked its items with an `if` where a loop was meant, so a
   navigation of any length rendered its first item only. Labels, ids and input types are
   now escaped into their attributes; `items`, `content` and `extraattrs` are markup by
   contract and are passed through. *)

f=joined(items:@str):str{
  <str.join("";items)
};

f=navhtml(items:@str):str{
  <"<nav aria-label=\"Main navigation\">\(joined(items))</nav>"
};

(* `main-content` is the target the skip link jumps to (core.a11y.skiplink). *)
f=mainhtml(content:str):str{
  <"<main id=\"main-content\">\(content)</main>"
};

f=buttonhtml(label:str;onclick:str;extraattrs:str):str{
  let safe=aria.attrvalue(label);
  <"<button type=\"button\" aria-label=\"\(safe)\" \(extraattrs) onclick=\"\(aria.attrvalue(onclick))\">\(safe)</button>"
};

f=requiredattrs(required:bool):str{
  if(required){ <" required aria-required=\"true\"" }el{};
  <""
};

(* Section 2.3: every input has a visible label tied to it by `for`/`id`, and a required
   field says so to assistive technology as well as to the browser. *)
f=formfieldhtml(id:str;label:str;type:str;required:bool):str{
  let fid=aria.attrvalue(id);
  <"<div class=\"field\"><label for=\"\(fid)\">\(aria.attrvalue(label))</label><input id=\"\(fid)\" name=\"\(fid)\" type=\"\(aria.attrvalue(type))\"\(requiredattrs(required))></div>"
};

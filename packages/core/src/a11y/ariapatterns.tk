m=core.a11y.ariapatterns;

i=str:std.str;

(* Ported from src/platform/a11y/aria-patterns.tk (F10.12-T2). WAI-ARIA attribute strings
   for the patterns in docs/specifications/accessibility-platform.md section 2.2.

   One change in the port: every caller-supplied value is escaped before it is quoted into
   an attribute. The legacy builders concatenated it raw, so a label containing `"` ended
   the attribute and whatever followed it became markup. *)

(* Escapes a value for a double-quoted HTML attribute. `&` first, so the entities the later
   replacements introduce are not escaped a second time. *)
f=attrvalue(s:str):str{
  <str.replace(str.replace(str.replace(str.replace(str.replace(s;"&";"&amp;");"\"";"&quot;");"'";"&#39;");"<";"&lt;");">";"&gt;")
};

f=boolattr(b:bool):str{
  if(b){ <"true" }el{};
  <"false"
};

f=dialogattrs(labelid:str):str{
  <"role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"\(attrvalue(labelid))\""
};

f=alertdialogattrs(labelid:str;descid:str):str{
  <"role=\"alertdialog\" aria-modal=\"true\" aria-labelledby=\"\(attrvalue(labelid))\" aria-describedby=\"\(attrvalue(descid))\""
};

(* The selected tab is the one in the tab order; the rest are reached with the arrow keys
   (section 3.3, roving tabindex). *)
f=tabattrs(selected:bool):str{
  if(selected){
    <"role=\"tab\" aria-selected=\"true\" tabindex=\"0\""
  }el{
    <"role=\"tab\" aria-selected=\"false\" tabindex=\"-1\""
  }
};

f=tabpanelattrs(labelledby:str):str{
  <"role=\"tabpanel\" aria-labelledby=\"\(attrvalue(labelledby))\""
};

f=tablistattrs():str{
  <"role=\"tablist\""
};

f=menuattrs():str{
  <"role=\"menu\""
};

f=menuitemattrs():str{
  <"role=\"menuitem\""
};

f=toolbarattrs(label:str):str{
  <"role=\"toolbar\" aria-label=\"\(attrvalue(label))\""
};

f=switchattrs(checked:bool):str{
  <"role=\"switch\" aria-checked=\"\(boolattr(checked))\""
};

f=tooltipattrs():str{
  <"role=\"tooltip\""
};

f=statusattrs():str{
  <"role=\"status\""
};

f=progressbarattrs(valuenow:str;valuemin:str;valuemax:str;label:str):str{
  <"role=\"progressbar\" aria-valuenow=\"\(attrvalue(valuenow))\" aria-valuemin=\"\(attrvalue(valuemin))\" aria-valuemax=\"\(attrvalue(valuemax))\" aria-label=\"\(attrvalue(label))\""
};

f=comboboxattrs(expanded:bool):str{
  <"role=\"combobox\" aria-expanded=\"\(boolattr(expanded))\" aria-autocomplete=\"list\" aria-haspopup=\"listbox\""
};

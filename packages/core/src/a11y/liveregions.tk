m=core.a11y.liveregions;

i=str:std.str;

(* Ported from src/platform/a11y/live_regions.tk (F10.12-T2). The two persistent live
   regions of docs/specifications/accessibility-platform.md section 5.1, the announce
   function of section 5.2, and the visually-hidden class both rely on.

   The region ids are the legacy `aria-live-polite` / `aria-live-assertive`, not the
   spec's `loke-live-region-*`: `announcejs` looks them up by those ids, and
   core.a11y.announcements calls `announcejs`'s function, so the three agree with each
   other. Renaming them to the spec's is a change to all three at once, not a port. *)

f=liveregionhtml():str{
  <"<div id=\"aria-live-polite\" aria-live=\"polite\" aria-atomic=\"true\" class=\"sr-only\"></div><div id=\"aria-live-assertive\" aria-live=\"assertive\" aria-atomic=\"true\" class=\"sr-only\"></div>"
};

(* Clears the region and sets the message on the next tick, so a message identical to the
   previous one is still announced (section 5.2). *)
f=announcejs():str{
  <str.join("\n";@(
    "window.loke_announce = function(msg, priority) {";
    "  var el = document.getElementById('aria-live-' + (priority||'polite'));";
    "  if(el){";
    "    el.textContent='';";
    "    setTimeout(function(){ el.textContent=msg; }, 50);";
    "  }";
    "};";
    ""
  ))
};

f=sronlycss():str{
  <".sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }"
};

m=core.a11y.skiplink;

i=str:std.str;

(* Ported from src/platform/a11y/skip-link.tk (F10.12-T2). The skip-to-content link of
   docs/specifications/accessibility-platform.md section 3.4: the first focusable element
   on the page, off-screen until it takes focus, and moving focus to `#main-content`
   (core.a11y.semantic's `mainhtml`) when followed. Unchanged in behaviour. *)

f=skiplinkhtml():str{
  <"<a href=\"#main-content\" id=\"skip-to-main\" class=\"skip-link\">Skip to main content</a>"
};

f=skiplinkcss():str{
  <str.join("\n";@(
    ".skip-link {";
    "  position: absolute;";
    "  top: -100%;";
    "  left: 0;";
    "  z-index: var(--z-skip-link, 10000);";
    "  padding: var(--space-2, 0.5rem) var(--space-4, 1rem);";
    "  background: var(--colour-surface, #ffffff);";
    "  color: var(--colour-text, #000000);";
    "  text-decoration: underline;";
    "  font-size: 1rem;";
    "  line-height: 1.5;";
    "}";
    "";
    ".skip-link:focus {";
    "  top: 0;";
    "}";
    ""
  ))
};

f=skiplinkjs():str{
  <str.join("\n";@(
    "(function(){";
    "  document.addEventListener('DOMContentLoaded',function(){";
    "    var skip=document.getElementById('skip-to-main');";
    "    if(!skip) return;";
    "    skip.addEventListener('click',function(e){";
    "      e.preventDefault();";
    "      var main=document.getElementById('main-content');";
    "      if(main){";
    "        if(!main.getAttribute('tabindex')){";
    "          main.setAttribute('tabindex','-1');";
    "        }";
    "        main.focus();";
    "      }";
    "    });";
    "  });";
    "})();";
    ""
  ))
};

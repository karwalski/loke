m=core.a11y.keyboard;

i=str:std.str;

(* Ported from src/platform/a11y/keyboard.tk (F10.12-T2). Escape closes open overlays,
   the arrow keys move within a listbox or menu (docs/specifications/accessibility-platform.md
   section 3.3), and a link with no text and no aria-label is given its href as a label.

   One line is dropped in the port: the script logged "a11y: keyboard navigation active" to
   the browser console on every page load. The legacy module also imported std.log and
   never used it. The rest of the emitted script is unchanged. *)

f=keyboardjs():str{
  <str.join("\n";@(
    "(function(){";
    "  document.addEventListener('keydown', function(e){";
    "    if(e.key==='Escape'){";
    "      var overlays=document.querySelectorAll('.overlay.open');";
    "      for(var i=0;i<overlays.length;i++){ overlays[i].classList.remove('open'); }";
    "    }";
    "    var composites=['[role=\"listbox\"]','[role=\"menu\"]'];";
    "    for(var c=0;c<composites.length;c++){";
    "      var widget=e.target.closest(composites[c]);";
    "      if(widget){";
    "        var items=Array.from(widget.querySelectorAll('[role=\"option\"],[role=\"menuitem\"]'));";
    "        var idx=items.indexOf(document.activeElement);";
    "        if(e.key==='ArrowDown'||e.key==='ArrowRight'){";
    "          e.preventDefault();";
    "          if(idx<items.length-1){ items[idx+1].focus(); }";
    "        } else if(e.key==='ArrowUp'||e.key==='ArrowLeft'){";
    "          e.preventDefault();";
    "          if(idx>0){ items[idx-1].focus(); }";
    "        }";
    "      }";
    "    }";
    "  });";
    "  document.addEventListener('DOMContentLoaded', function(){";
    "    var links=document.querySelectorAll('a[href]');";
    "    for(var i=0;i<links.length;i++){";
    "      if(!links[i].textContent.trim()&&!links[i].getAttribute('aria-label')){";
    "        links[i].setAttribute('aria-label',links[i].getAttribute('href'));";
    "      }";
    "    }";
    "  });";
    "})();";
    ""
  ))
};

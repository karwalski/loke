m=core.a11y.focustrap;

i=str:std.str;

(* Ported from src/platform/a11y/focus-trap.tk (F10.12-T2). The modal focus trap of
   docs/specifications/accessibility-platform.md section 4.1: Tab and Shift+Tab cycle
   within the container, Escape deactivates, every sibling up to <body> is made inert and
   aria-hidden while it is active, and focus returns to where it was on release.

   The legacy JavaScript had been rewritten as if it were toke and did not work as emitted:

     var inertElements=@();               a SyntaxError: the whole script failed to load,
                                          so loke_create_focus_trap was never defined
     if(initialFocus='container')         assignment, always truthy: every trap focused
                                          the container whatever was asked for
     if(e.key='Escape'&&...)              assignment: EVERY key, Tab included,
                                          deactivated the trap, so it trapped nothing
     document.activeElement=first         an assignment to a read-only property
     }el{                                 toke's else, a SyntaxError in JavaScript

   All are restored to JavaScript's `[]`, `===` and `else`. *)

f=focusableselector():str{
  <"a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex=\"-1\"])"
};

f=focustrapjs():str{
  <str.join("\n";@(
    "(function(){";
    "  var FOCUSABLE='\(focusableselector())';";
    "";
    "  function getFocusable(el){";
    "    return Array.from(el.querySelectorAll(FOCUSABLE)).filter(function(e){";
    "      return e.offsetParent!==null;";
    "    });";
    "  }";
    "";
    "  window.loke_create_focus_trap=function(opts){";
    "    var container=opts.container;";
    "    var initialFocus=opts.initialFocus||'first';";
    "    var escapeDeactivates=opts.escapeDeactivates!==false;";
    "    var onDeactivate=opts.onDeactivate||null;";
    "    var active=false;";
    "    var savedFocus=null;";
    "    var keyHandler=null;";
    "    var inertElements=[];";
    "";
    "    function activate(){";
    "      if(active) return;";
    "      active=true;";
    "      savedFocus=document.activeElement;";
    "      var el=container;";
    "      while(el&&el!==document.body){";
    "        var parent=el.parentElement;";
    "        if(parent){";
    "          Array.from(parent.children).forEach(function(sibling){";
    "            if(sibling!==el&&!sibling.hasAttribute('aria-live')){";
    "              sibling.setAttribute('aria-hidden','true');";
    "              sibling.setAttribute('inert','');";
    "              inertElements.push(sibling);";
    "            }";
    "          });";
    "        }";
    "        el=parent;";
    "      }";
    "      var items=getFocusable(container);";
    "      if(initialFocus==='container'){";
    "        if(!container.getAttribute('tabindex')) container.setAttribute('tabindex','-1');";
    "        container.focus();";
    "      } else if(initialFocus==='first'){";
    "        if(items.length) items[0].focus();";
    "      } else {";
    "        initialFocus.focus();";
    "      }";
    "      keyHandler=function(e){";
    "        if(e.key==='Escape'&&escapeDeactivates){";
    "          e.preventDefault();";
    "          deactivate();";
    "          return;";
    "        }";
    "        if(e.key!=='Tab') return;";
    "        var items=getFocusable(container);";
    "        if(!items.length) return;";
    "        var first=items[0]; var last=items[items.length-1];";
    "        if(e.shiftKey){";
    "          if(document.activeElement===first){ e.preventDefault(); last.focus(); }";
    "        } else {";
    "          if(document.activeElement===last){ e.preventDefault(); first.focus(); }";
    "        }";
    "      };";
    "      document.addEventListener('keydown',keyHandler);";
    "    }";
    "";
    "    function deactivate(){";
    "      if(!active) return;";
    "      active=false;";
    "      if(keyHandler) document.removeEventListener('keydown',keyHandler);";
    "      keyHandler=null;";
    "      inertElements.forEach(function(el){";
    "        el.removeAttribute('aria-hidden');";
    "        el.removeAttribute('inert');";
    "      });";
    "      inertElements=[];";
    "      if(savedFocus&&savedFocus.focus){";
    "        savedFocus.focus();";
    "      }";
    "      savedFocus=null;";
    "      if(onDeactivate) onDeactivate();";
    "    }";
    "";
    "    return {";
    "      activate:activate,";
    "      deactivate:deactivate,";
    "      isActive:function(){ return active; }";
    "    };";
    "  };";
    "})();";
    ""
  ))
};

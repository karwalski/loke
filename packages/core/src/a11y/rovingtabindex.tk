m=core.a11y.rovingtabindex;

i=str:std.str;

(* Ported from src/platform/a11y/roving-tabindex.tk (F10.12-T2). The roving tabindex of
   docs/specifications/accessibility-platform.md section 3.3: one item in a group is in
   the tab order, the arrow keys for the group's orientation move between items, Home and
   End jump to the ends, and movement wraps unless `wrap` is false.

   The legacy JavaScript compared with `=`, which in JavaScript assigns, and it did not
   parse: `orientation='horizontal'||orientation='both'` reads as an assignment to an
   expression, and `node --check` rejects the script with "Invalid left-hand side in
   assignment", so loke_roving_tabindex was never defined. Had it parsed, the other
   comparisons were assignments too:

     item.setAttribute('tabindex',i=0?'0':'-1')     every item got tabindex -1, so the
                                                    group was unreachable by Tab
     if(e.key='Home'){ ... return; }               true for every key: any keypress
                                                    jumped to the first item

   All comparisons are restored to `===` and `!==`. *)

f=rovingtabindexjs():str{
  <str.join("\n";@(
    "(function(){";
    "  window.loke_roving_tabindex=function(opts){";
    "    var container=opts.container;";
    "    var selector=opts.selector;";
    "    var orientation=opts.orientation||'both';";
    "    var wrap=opts.wrap!==false;";
    "    var onFocus=opts.onFocus||null;";
    "    var currentIdx=0;";
    "    var handler=null;";
    "";
    "    function getItems(){";
    "      return Array.from(container.querySelectorAll(selector));";
    "    }";
    "";
    "    function focusItem(idx){";
    "      var items=getItems();";
    "      if(!items.length) return;";
    "      if(idx<0) idx=0;";
    "      if(idx>=items.length) idx=items.length-1;";
    "      items[currentIdx].setAttribute('tabindex','-1');";
    "      items[idx].setAttribute('tabindex','0');";
    "      items[idx].focus();";
    "      currentIdx=idx;";
    "      if(onFocus) onFocus(items[idx],idx);";
    "    }";
    "";
    "    function handleNext(items){";
    "      if(currentIdx<items.length-1){";
    "        focusItem(currentIdx+1);";
    "      } else if(wrap){";
    "        focusItem(0);";
    "      }";
    "    }";
    "";
    "    function handlePrev(items){";
    "      if(currentIdx>0){";
    "        focusItem(currentIdx-1);";
    "      } else if(wrap){";
    "        focusItem(items.length-1);";
    "      }";
    "    }";
    "";
    "    function init(){";
    "      var items=getItems();";
    "      items.forEach(function(item,i){";
    "        item.setAttribute('tabindex',i===0?'0':'-1');";
    "      });";
    "      currentIdx=0;";
    "";
    "      handler=function(e){";
    "        var items=getItems();";
    "        if(!items.length) return;";
    "        var isNext=false; var isPrev=false;";
    "        if(orientation==='horizontal'||orientation==='both'){";
    "          if(e.key==='ArrowRight') isNext=true;";
    "          if(e.key==='ArrowLeft') isPrev=true;";
    "        }";
    "        if(orientation==='vertical'||orientation==='both'){";
    "          if(e.key==='ArrowDown') isNext=true;";
    "          if(e.key==='ArrowUp') isPrev=true;";
    "        }";
    "        if(e.key==='Home'){";
    "          e.preventDefault();";
    "          focusItem(0);";
    "          return;";
    "        }";
    "        if(e.key==='End'){";
    "          e.preventDefault();";
    "          focusItem(items.length-1);";
    "          return;";
    "        }";
    "        if(isNext){ e.preventDefault(); handleNext(items); }";
    "        if(isPrev){ e.preventDefault(); handlePrev(items); }";
    "      };";
    "      container.addEventListener('keydown',handler);";
    "    }";
    "";
    "    function destroy(){";
    "      if(handler) container.removeEventListener('keydown',handler);";
    "      handler=null;";
    "    }";
    "";
    "    return {";
    "      init:init,";
    "      destroy:destroy,";
    "      focusItem:focusItem,";
    "      currentIndex:function(){ return currentIdx; }";
    "    };";
    "  };";
    "})();";
    ""
  ))
};

m=core.a11y.colour;

i=str:std.str;
i=math:std.math;

(* Ported from src/platform/a11y/colour.tk (F10.12-T2). Motion and focus CSS, and the WCAG
   2.1 contrast ratio that docs/specifications/accessibility-platform.md section 6.2 requires
   every colour pairing to meet.

   `checkcontrastratio` was a stub: it logged "contrast check (stub)" and returned 4.5 for
   every pair, which is exactly the AA threshold, so any caller asking "does this pass?" was
   told yes for black on black. It now computes the ratio from the WCAG relative-luminance
   formula. A colour it cannot parse yields 0.0, which fails every threshold: a checker
   that cannot read its input must not report a pass.

   `focusvisiblecss` now names the spec's `--colour-focus-ring` token (section 4.4) where
   the legacy CSS used `--accent`, keeping the same fallback colour. *)

f=motioncss():str{
  <str.join("\n";@(
    "@media (prefers-reduced-motion: reduce) {";
    "  *, *::before, *::after {";
    "    animation-duration: 0.01ms !important;";
    "    animation-iteration-count: 1 !important;";
    "    transition-duration: 0.01ms !important;";
    "  }";
    "}";
    ""
  ))
};

(* Removes the ring only for focus that :focus-visible does not match (a pointer click), so
   keyboard focus is never left without an indicator (section 4.4). *)
f=focusvisiblecss():str{
  <str.join("\n";@(
    ":focus-visible { outline: 2px solid var(--colour-focus-ring, #14b8a6); outline-offset: 2px; }";
    ":focus:not(:focus-visible) { outline: none; }";
    ""
  ))
};

(* The value of one hex digit, or -1. *)
f=hexdigit(c:i64):i64{
  if(c>=48 && c<=57){ <c-48 }el{};
  if(c>=97 && c<=102){ <c-87 }el{};
  if(c>=65 && c<=70){ <c-55 }el{};
  <0-1
};

(* "#rrggbb", "rrggbb", "#rgb" or "rgb" as six hex digits, or "" when it is none of those. *)
f=normalisehex(hex:str):str{
  let h=mut.str.trim(hex);
  if(str.startswith(h;"#")){ h=str.slice(h;1;str.len(h)) }el{};
  let n=str.len(h) as i64;
  lp(let i=0;i<n;i=i+1){
    if(hexdigit(str.charat(h;i))<0){ <"" }el{}
  };
  if(n==6){ <h }el{};
  if(n==3){
    let r=str.slice(h;0;1);
    let g=str.slice(h;1;2);
    let b=str.slice(h;2;3);
    <"\(r)\(r)\(g)\(g)\(b)\(b)"
  }el{};
  <""
};

(* One channel, 0-255, from two hex digits at `at`. *)
f=channel(h:str;at:i64):i64{
  <hexdigit(str.charat(h;at))*16+hexdigit(str.charat(h;at+1))
};

(* The sRGB channel linearised, per the WCAG 2.1 definition of relative luminance. *)
f=linear(c:i64):f64{
  let s=(c as f64)/255.0;
  if(s<=0.03928){ <s/12.92 }el{};
  <math.pow((s+0.055)/1.055;2.4)
};

(* Relative luminance of a normalised six-digit colour. *)
f=luminance(h:str):f64{
  <0.2126*linear(channel(h;0))+0.7152*linear(channel(h;2))+0.0722*linear(channel(h;4))
};

(* The WCAG contrast ratio of two colours, 1.0 to 21.0, in either order. 0.0 when either
   colour cannot be parsed. *)
f=checkcontrastratio(fghex:str;bghex:str):f64{
  let fg=normalisehex(fghex);
  let bg=normalisehex(bghex);
  if(str.len(fg)==0 || str.len(bg)==0){ <0.0 }el{};
  let lf=luminance(fg);
  let lb=luminance(bg);
  if(lf>lb){ <(lf+0.05)/(lb+0.05) }el{};
  <(lb+0.05)/(lf+0.05)
};

(* Section 6.2: 4.5:1 for normal text, 3:1 for large text and for UI components. *)
f=meetsaa(fghex:str;bghex:str;large:bool):bool{
  let ratio=checkcontrastratio(fghex;bghex);
  if(large){ <ratio>=3.0 }el{};
  <ratio>=4.5
};

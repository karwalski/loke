m=core.a11y.focus;

i=str:std.str;
i=skip:core.a11y.skiplink;

(* Ported from src/platform/a11y/focus.tk (F10.12-T2). Focus trap and release, save and
   restore, and focus on route change (docs/specifications/accessibility-platform.md
   sections 4.1 to 4.3), plus the skip link's click handler.

   Fixed in the port: the legacy `skiplinkhtml` emitted a link with no id, while the
   handler this module's own script installs looks the link up as `#skip-to-main`. A page
   built from this module alone therefore had a skip link whose handler never attached.
   `skiplinkhtml` is now core.a11y.skiplink's, which carries the id. The emitted script is
   unchanged. For a trap with Escape, inert siblings and a choice of initial focus, use
   core.a11y.focustrap. *)

f=focusjs():str{
  <str.join("\n";@(
    "(function(){";
    "  var _saved=null;";
    "  var _trapEl=null;";
    "  var _trapHandler=null;";
    "  var FOCUSABLE='a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex=\"-1\"])';";
    "  window.loke_focus_trap=function(el){";
    "    _trapEl=el;";
    "    var items=Array.from(el.querySelectorAll(FOCUSABLE));";
    "    if(items.length){ items[0].focus(); }";
    "    _trapHandler=function(e){";
    "      if(e.key!=='Tab') return;";
    "      items=Array.from(_trapEl.querySelectorAll(FOCUSABLE));";
    "      var first=items[0]; var last=items[items.length-1];";
    "      if(e.shiftKey){";
    "        if(document.activeElement===first){ e.preventDefault(); last.focus(); }";
    "      } else {";
    "        if(document.activeElement===last){ e.preventDefault(); first.focus(); }";
    "      }";
    "    };";
    "    document.addEventListener('keydown',_trapHandler);";
    "  };";
    "  window.loke_focus_release=function(){";
    "    if(_trapHandler){ document.removeEventListener('keydown',_trapHandler); }";
    "    _trapEl=null; _trapHandler=null;";
    "  };";
    "  window.loke_save_focus=function(){ _saved=document.activeElement; };";
    "  window.loke_restore_focus=function(){ if(_saved&&_saved.focus){ _saved.focus(); _saved=null; } };";
    "  window.loke_route_focus=function(){";
    "    var h1=document.querySelector('h1');";
    "    var main=document.getElementById('main-content');";
    "    var target=h1||main;";
    "    if(target){";
    "      if(!target.getAttribute('tabindex')){ target.setAttribute('tabindex','-1'); }";
    "      target.focus();";
    "    }";
    "  };";
    "  document.addEventListener('DOMContentLoaded',function(){";
    "    var skip=document.getElementById('skip-to-main');";
    "    if(skip){";
    "      skip.addEventListener('click',function(e){";
    "        e.preventDefault();";
    "        var main=document.getElementById('main-content');";
    "        if(main){";
    "          if(!main.getAttribute('tabindex')){ main.setAttribute('tabindex','-1'); }";
    "          main.focus();";
    "        }";
    "      });";
    "    }";
    "  });";
    "})();";
    ""
  ))
};

f=skiplinkhtml():str{
  <skip.skiplinkhtml()
};

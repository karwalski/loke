m=core.a11y.announcements;

i=str:std.str;

(* Ported from src/platform/a11y/announcements.tk (F10.12-T2). Pipeline-stage, violation,
   toast and streaming announcements over core.a11y.liveregions' `loke_announce`, with the
   batching and throttling of docs/specifications/accessibility-platform.md section 5.4.

   The legacy JavaScript had been through a toke syntax migration that rewrote JavaScript
   as if it were toke, and was broken in two places as emitted:

     var _toastTimes=@();                       not JavaScript: a SyntaxError, so the whole
                                                script failed to load and no announcement of
                                                any kind was ever made
     (variant='error'||variant='warning')       assignment, not comparison: every toast was
                                                announced assertively and its variant was
                                                overwritten with 'error' before the prefix was
                                                built, so each one read "Error: ..."

   Both are restored to `[]` and `===`. *)

f=announcementsjs():str{
  <str.join("\n";@(
    "(function(){";
    "  var _lastStreamAnnounce=0;";
    "  var STREAM_THROTTLE_MS=5000;";
    "";
    "  var _toastTimes=[];";
    "  var _toastBatchTimer=null;";
    "  var _toastBatchCount=0;";
    "  var TOAST_BATCH_WINDOW_MS=2000;";
    "  var TOAST_BATCH_THRESHOLD=3;";
    "";
    "  window.loke_announce_stage=function(stage, status){";
    "    if(!window.loke_announce) return;";
    "    var msg=stage+' '+status;";
    "    window.loke_announce(msg,'polite');";
    "  };";
    "";
    "  window.loke_announce_violation=function(violation){";
    "    if(!window.loke_announce) return;";
    "    window.loke_announce('Warning: '+violation,'assertive');";
    "  };";
    "";
    "  window.loke_announce_toast=function(message, variant){";
    "    if(!window.loke_announce) return;";
    "    var now=Date.now();";
    "    _toastTimes=_toastTimes.filter(function(t){ return now-t<TOAST_BATCH_WINDOW_MS; });";
    "    _toastTimes.push(now);";
    "";
    "    if(_toastTimes.length>TOAST_BATCH_THRESHOLD){";
    "      _toastBatchCount++;";
    "      if(_toastBatchTimer) clearTimeout(_toastBatchTimer);";
    "      _toastBatchTimer=setTimeout(function(){";
    "        window.loke_announce(_toastBatchCount+' new notifications.','polite');";
    "        _toastBatchCount=0;";
    "        _toastBatchTimer=null;";
    "      },500);";
    "      return;";
    "    }";
    "";
    "    var priority=(variant==='error'||variant==='warning')?'assertive':'polite';";
    "    var prefix=variant?variant.charAt(0).toUpperCase()+variant.slice(1)+': ':'';";
    "    window.loke_announce(prefix+message,priority);";
    "  };";
    "";
    "  window.loke_announce_streaming=function(message){";
    "    if(!window.loke_announce) return;";
    "    var now=Date.now();";
    "    if(now-_lastStreamAnnounce<STREAM_THROTTLE_MS) return;";
    "    _lastStreamAnnounce=now;";
    "    window.loke_announce(message,'polite');";
    "  };";
    "})();";
    ""
  ))
};

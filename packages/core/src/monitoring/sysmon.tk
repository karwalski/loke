m=core.monitoring.sysmon;

i=os:std.os;
i=process:std.process;
i=str:std.str;

t=$processstats{
  pid:i64;
  name:str;
  cpupercent:f64;
  rammb:f64;
  rampercent:f64;
  threads:i64
};
t=$systemstats{
  totalrammb:i64;
  usedrammb:i64;
  freerammb:i64;
  rampercent:f64;
  cpucount:i64;
  cpupercent:f64;
  ollamastats:$processstats;
  lokestats:$processstats;
  slmactive:bool;
  slmmodel:str
};
t=$cpuinfo{count:i64;percent:f64};
t=$raminfo{total:i64;used:i64;free:i64;percent:f64};

(* Every spawn here answers 0, the NULL handle, when the tool cannot be started, and the
   handle is tested before it is read or waited on. The check was `h == @()`, which is never
   true (an array == compares addresses), so a missing tool's "handle" was the address of an
   empty array and waitpid could be handed a garbage pid (F10.44). *)
f=getramstats():$raminfo{
  let total=mut.0;
  let used=mut.0;
  let handle1=mt process.spawn(@("sysctl";"-n";"hw.memsize")) {
    $ok:handle handle;
    $err:e 0
  };
  if(handle1!=0){
    let out=mt process.stdout(handle1) {$ok:s s;$err:e ""};
    process.wait(handle1);
    let bytes=mt str.parseint(str.trim(out)) {$ok:n n;$err:e 0};
    total=bytes/1048576
  };
  let handle2=mt process.spawn(@("vm_stat")) {
    $ok:handle handle;
    $err:e 0
  };
  if(handle2!=0){
    let out=mt process.stdout(handle2) {$ok:s s;$err:e ""};
    process.wait(handle2);
    used=vmstatusedmb(out)
  };
  let free=total-used;
  let percent=mut.0.0;
  if(total>0){percent=(used as f64)/(total as f64)*100.0}el{};
  <$raminfo{total:total;used:used;free:free;percent:percent}
};
(* BG1.2: used RAM, in MiB, from vm_stat's output: active, wired and compressed pages, at the
   page size vm_stat states in its header. Both halves were wrong. parsevmstatfield required a
   line to split into MORE than two parts at ":", and "Pages active:   258424." splits into
   exactly two, so every field read 0 and /sysmon reported 0 MB used and 0% RAM on every
   machine: plausible zeros, not dashes. And the page size was written in as 16384, which is
   Apple silicon's; an Intel Mac's vm_stat counts 4096-byte pages. *)
f=vmstatusedmb(output:str):i64{
  let active=parsevmstatfield(output;"Pages active:");
  let wired=parsevmstatfield(output;"Pages wired down:");
  let compressed=parsevmstatfield(output;"Pages occupied by compressor:");
  <((active+wired+compressed)*vmstatpagesize(output))/1048576
};
(* "Mach Virtual Memory Statistics: (page size of 16384 bytes)". 0 when the header is not
   there, so an unreadable listing measures nothing rather than a guess. *)
f=vmstatpagesize(output:str):i64{
  let after=str.split(output;"page size of ");
  if(after.len<2){ <0 }el{};
  let words=str.split(str.trim(after.get(1));" ");
  if(words.len<1){ <0 }el{};
  <mt str.parseint(words.get(0)) {$ok:n n;$err:e 0}
};
f=parsevmstatfield(output:str;fieldname:str):i64{
  let lines=str.split(output;"
");
  let result=mut.0;
  lp(let ii=0;ii<lines.len;ii=ii+1){ let line=lines.get(ii);
    if(str.contains(line;fieldname)){
      let parts=str.split(line;":");
      if(parts.len>=2){
        let valstr=str.trim(parts.get(1));
        let valstr2=mut.valstr;
        if(str.endswith(valstr;".")){valstr2=str.slice(valstr;0;str.len(valstr)-1)}el{};
        result=mt str.parseint(str.trim(valstr2)) {$ok:n n;$err:e 0}
      }el{}
    }el{}
  };
  <result
};
f=getcpustats():$cpuinfo{
  let count=mut.0;
  let percent=mut.0.0;
  let handle1=mt process.spawn(@("sysctl";"-n";"hw.ncpu")) {
    $ok:handle handle;
    $err:e 0
  };
  if(handle1!=0){
    let out=mt process.stdout(handle1) {$ok:s s;$err:e ""};
    process.wait(handle1);
    count=mt str.parseint(str.trim(out)) {$ok:n n;$err:e 0}
  };
  let handle2=mt process.spawn(@("top";"-l";"1";"-n";"0";"-s";"0")) {
    $ok:handle handle;
    $err:e 0
  };
  if(handle2!=0){
    let out=mt process.stdout(handle2) {$ok:s s;$err:e ""};
    process.wait(handle2);
    percent=topbusypercent(out)
  };
  <$cpuinfo{count:count;percent:percent}
};
(* BG1.2: the share of CPU not idle, from top's "CPU usage: 46.4% user, 42.55% sys, 11.39%
   idle" line. It split the line at "idle", split what came before at ",", and required MORE
   than three parts. There are exactly three (user, sys and the idle figure), so it never read
   one, and /sysmon reported 0% CPU on every machine. The idle figure is now found by its
   label. 0.0 when there is no such line, so nothing is reported busy that was not measured. *)
f=topbusypercent(output:str):f64{
  let lines=str.split(output;"
");
  let percent=mut.0.0;
  lp(let ii=0;ii<lines.len;ii=ii+1){ let line=lines.get(ii);
    if(str.contains(line;"CPU usage")){
      let parts=str.split(line;",");
      lp(let jj=0;jj<parts.len;jj=jj+1){ let part=parts.get(jj);
        if(str.contains(part;"idle")){
          let idleval=mt str.parsefloat(str.trim(str.replace(str.replace(part;"idle";"");"%";""))) {$ok:f f;$err:e 101.0};
          if(idleval>=0.0 && idleval<=100.0){percent=100.0-idleval}el{}
        }el{}
      }
    }el{}
  };
  <percent
};
f=getprocessstats(name:str):$processstats{
  let best=mut.$processstats{pid:0;name:name;cpupercent:0.0;rammb:0.0;rampercent:0.0;threads:0};
  (* Three defects fixed 2026-09-24, found when /sysmon hung the server intermittently.
     (1) `nlwp` is a Linux column. macOS ps drops it with a warning, leaving four columns,
     so the `>4` below never held and no process was read. The columns are now portable,
     and `threads` stays 0 because it is not measured here.
     (2) It waited for ps BEFORE reading its output. The full listing measured 64,608
     bytes against a 65,536-byte pipe buffer, so once the process list grew past that, ps
     blocked writing, this blocked waiting, and the request hung with the worker. The
     output is now read to EOF first and waited on after.
     (3) `-c` gives the executable name rather than its full path, which also keeps the
     listing far below the buffer. *)
  let handle=mt process.spawn(@("ps";"-A";"-c";"-o";"pid=,pcpu=,rss=,comm=")) {
    $ok:handle handle;
    $err:e 0
  };
  if(handle!=0){
    let out=mt process.stdout(handle) {$ok:s s;$err:e ""};
    process.wait(handle);
    let lines=str.split(out;"
");
    lp(let ii=0;ii<lines.len;ii=ii+1){ let line=lines.get(ii);
      if(str.contains(line;name)){
        let cand=parsepsline(line;name);
        (* `|| best.pid==0`: best starts at 0.0% CPU, so an idle process (a sleeping
           Ollama, say) never beat it and was reported as pid 0, not running. *)
        if(cand.pid>0 && (cand.cpupercent>best.cpupercent || best.pid==0)){best=cand}el{}
      }el{}
    }
  };
  <best
};
(* BG1.2: one process, by pid. snapshot() looked for loke by the name "ooke-toke", a process
   name loke has not had since it was built as its own binary, so the loke entry read pid 0,
   0% and 0 MB for a server that was answering the request. A name also cannot tell two loke
   servers apart, so loke now reports the process that is answering. pid 0 when it is gone. *)
f=getprocessstatsbypid(pid:i64;name:str):$processstats{
  let none=$processstats{pid:0;name:name;cpupercent:0.0;rammb:0.0;rampercent:0.0;threads:0};
  if(pid<=0){ <none }el{};
  let handle=mt process.spawn(@("ps";"-c";"-o";"pid=,pcpu=,rss=,comm=";"-p";str.fromint(pid))) {
    $ok:handle handle;
    $err:e 0
  };
  if(handle==0){ <none }el{};
  let out=mt process.stdout(handle) {$ok:s s;$err:e ""};
  process.wait(handle);
  let st=parsepsline(out;name);
  if(st.pid!=pid){ <none }el{};
  <st
};
(* One `ps -o pid=,pcpu=,rss=,comm=` line as a process, shared by both lookups; pid 0 when it
   does not hold four fields. *)
f=parsepsline(line:str;name:str):$processstats{
  (* `mut.` and an assignment. This read `let cleaned=@();` with a bare
     `cleaned.push(...)`: an array push RETURNS the new array and does not mutate in place
     (T-24), so `cleaned` stayed empty, `cleaned.len>4` was **always false**, and
     getprocessstats never read a pid, a CPU figure or an RSS out of `ps` for any process on
     any machine. `best` was returned as `newprocessstats()` every time.

     The same defect in the same shape was found independently in `moke.sysmon.splitws`,
     where it made the sysmon panel report 0% CPU and 0 MB for both ollama and loke on
     every poll. Two copies of one whitespace splitter, both inert. *)
  let parts=str.split(str.trim(line);" ");
  let cleaned=mut.@();
  lp(let jj=0;jj<parts.len;jj=jj+1){ let p=parts.get(jj);
    if(str.len(str.trim(p))>0){
      cleaned=cleaned.push(str.trim(p))
    }el{}
  };
  if(cleaned.len<4){ <$processstats{pid:0;name:name;cpupercent:0.0;rammb:0.0;rampercent:0.0;threads:0} }el{};
  let pid=mt str.parseint(cleaned.get(0)) {$ok:n n;$err:e 0};
  let cpu=mt str.parsefloat(cleaned.get(1)) {$ok:f f;$err:e 0.0};
  let rsskb=mt str.parseint(cleaned.get(2)) {$ok:n n;$err:e 0};
  <$processstats{pid:pid;name:name;cpupercent:cpu;rammb:((rsskb as f64)/1024.0);rampercent:0.0;threads:0}
};
f=getactivemodel():str{
  let handle=mt process.spawn(@("curl";"-s";"http://localhost:11434/api/ps")) {
    $ok:handle handle;
    $err:e 0
  };
  if(handle==0){ <"" }el{};
  let out=mt process.stdout(handle) {$ok:s s;$err:e ""};
  process.wait(handle);
  if(str.contains(out;"name")){
    let parts=str.split(out;"\"name\":\"");
    if(parts.len>2){
      let modelpart=parts.get(1);
      let end=str.indexof(modelpart;"\"");
      if(end>0){<str.slice(modelpart;0;end)}el{<"unknown"}
    }el{<""}
  }el{<""}
};
(* The figures for the machine, with loke's own entry read from the process answering. *)
f=snapshot():$systemstats{
  <snapshotof(os.getpid())
};
(* lokepid 0: the caller is not loke and cannot name its process (moke, when loke does not
   answer), so the loke entry is not measured and tojson writes it as null. *)
f=snapshotof(lokepid:i64):$systemstats{
  let ram=getramstats();
  let cpu=getcpustats();
  let ollama=getprocessstats("ollama");
  let lokeproc=getprocessstatsbypid(lokepid;"loke");
  let slmactive=ollama.cpupercent>5.0;
  let slmmodel=mut."";
  if(slmactive){slmmodel=getactivemodel()}el{};
  <$systemstats{
    totalrammb:ram.total;
    usedrammb:ram.used;
    freerammb:ram.free;
    rampercent:ram.percent;
    cpucount:cpu.count;
    cpupercent:cpu.percent;
    ollamastats:ollama;
    lokestats:lokeproc;
    slmactive:slmactive;
    slmmodel:slmmodel
  }
};
f=tojson(stats:$systemstats):str{
  (* Two-hop field access loses the middle type; the annotations are load-bearing. *)
  let ostats:$processstats=stats.ollamastats;
  let lstats:$processstats=stats.lokestats;
  let slmstr=mut."null";
  if(stats.slmactive){slmstr="\"\(stats.slmmodel)\""}el{};
  let slmactivebool=mut."false";
  if(stats.slmactive){slmactivebool="true"}el{};
  <"{\"total_ram_mb\":\(str.fromint(stats.totalrammb)),\"used_ram_mb\":\(str.fromint(stats.usedrammb)),\"free_ram_mb\":\(str.fromint(stats.freerammb)),\"ram_percent\":\(str.fromfloat(stats.rampercent)),\"cpu_count\":\(str.fromint(stats.cpucount)),\"cpu_percent\":\(str.fromfloat(stats.cpupercent)),\"ollama\":\(processjson(ostats)),\"loke\":\(processjson(lstats)),\"slm_active\":\(slmactivebool),\"slm_model\":\(slmstr)}"
};
(* BG1.2: a process that was not found is null, not {"pid":0,"cpu":0,"ram_mb":0}. Those
   zeros read as an idle process using no memory; null says it was not measured. *)
f=processjson(pst:$processstats):str{
  if(pst.pid==0){ <"null" }el{};
  <"{\"pid\":\(str.fromint(pst.pid)),\"cpu\":\(str.fromfloat(pst.cpupercent)),\"ram_mb\":\(str.fromfloat(pst.rammb))}"
};

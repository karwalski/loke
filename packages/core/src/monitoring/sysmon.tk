m=core.monitoring.sysmon;

i=process:std.process;
i=str:std.str;
i=log:shared.log;

t=$processstats{
  pid:i64;
  name:str;
  cpupercent:f64;
  rammb:f64;
  rampercent:f64;
  threads:i64
};
t=$systemstats{
  totalrammb:i64;
  usedrammb:i64;
  freerammb:i64;
  rampercent:f64;
  cpucount:i64;
  cpupercent:f64;
  ollamastats:$processstats;
  lokestats:$processstats;
  slmactive:bool;
  slmmodel:str
};
t=$cpuinfo{count:i64;percent:f64};
t=$raminfo{total:i64;used:i64;free:i64;percent:f64};

f=getramstats():$raminfo{
  let total=mut.0;
  let used=mut.0;
  let handle1=mt process.spawn(@("sysctl";"-n";"hw.memsize")) {
    $ok:handle handle;
    $err:e @()
  };
  if(!(handle1 = @())){
    mt process.wait(handle1) {$ok:v 0;$err:e 0};
    let out=mt process.stdout(handle1) {$ok:s s;$err:e ""};
    let bytes=mt str.parseint(str.trim(out)) {$ok:n n;$err:e 0};
    total=bytes/1048576
  };
  let handle2=mt process.spawn(@("vm_stat")) {
    $ok:handle handle;
    $err:e @()
  };
  if(!(handle2 = @())){
    mt process.wait(handle2) {$ok:v 0;$err:e 0};
    let out=mt process.stdout(handle2) {$ok:s s;$err:e ""};
    let active=parsevmstatfield(out;"Pages active:");
    let wired=parsevmstatfield(out;"Pages wired down:");
    let compressed=parsevmstatfield(out;"Pages occupied by compressor:");
    let pagesize=16384;
    used=((active+wired+compressed)*pagesize)/1048576
  };
  let free=total-used;
  let percent=mut.0.0;
  if(total>0){percent=(used as f64)/(total as f64)*100.0}el{};
  <$raminfo{total:total;used:used;free:free;percent:percent}
};
f=parsevmstatfield(output:str;fieldname:str):i64{
  let lines=str.split(output;"
");
  let result=mut.0;
  lp(let ii=0;ii<lines.len;ii=ii+1){ let line=lines.get(ii);
    if(str.contains(line;fieldname)){
      let parts=str.split(line;":");
      if(parts.len>2){
        let valstr=str.trim(parts.get(1));
        let valstr2=mut.valstr;
        if(str.endswith(valstr;".")){valstr2=str.slice(valstr;0;str.len(valstr)-1)}el{};
        let valstr3=str.trim(valstr2);
        result=mt str.parseint(valstr3) {$ok:n n;$err:e 0}
      }el{}
    }el{}
  };
  <result
};
f=getcpustats():$cpuinfo{
  let count=mut.0;
  let percent=mut.0.0;
  let handle1=mt process.spawn(@("sysctl";"-n";"hw.ncpu")) {
    $ok:handle handle;
    $err:e @()
  };
  if(!(handle1 = @())){
    mt process.wait(handle1) {$ok:v 0;$err:e 0};
    let out=mt process.stdout(handle1) {$ok:s s;$err:e ""};
    count=mt str.parseint(str.trim(out)) {$ok:n n;$err:e 0}
  };
  let handle2=mt process.spawn(@("top";"-l";"1";"-n";"0";"-s";"0")) {
    $ok:handle handle;
    $err:e @()
  };
  if(!(handle2 = @())){
    mt process.wait(handle2) {$ok:v 0;$err:e 0};
    let out=mt process.stdout(handle2) {$ok:s s;$err:e ""};
    let lines=str.split(out;"
");
    lp(let ii=0;ii<lines.len;ii=ii+1){ let line=lines.get(ii);
      if(str.contains(line;"CPU usage")){
        let idlepart=str.split(line;"idle");
        if(idlepart.len>1){
          let beforeidle=idlepart.get(0);
          let parts=str.split(beforeidle;",");
          if(parts.len>3){
            let idlestr=str.trim(parts.get(2));
            let idlestr2=str.replace(idlestr;"%";"");
            let idlestr3=str.trim(idlestr2);
            let idleval=mt str.parsefloat(idlestr3) {$ok:f f;$err:e 0.0};
            percent=100.0-idleval
          }el{}
        }el{}
      }el{}
    }
  };
  <$cpuinfo{count:count;percent:percent}
};
f=getprocessstats(name:str):$processstats{
  let best=mut.$processstats{pid:0;name:name;cpupercent:0.0;rammb:0.0;rampercent:0.0;threads:0};
  let handle=mt process.spawn(@("ps";"-eo";"pid,pcpu,rss,nlwp,comm")) {
    $ok:handle handle;
    $err:e @()
  };
  if(!(handle = @())){
    mt process.wait(handle) {$ok:v 0;$err:e 0};
    let out=mt process.stdout(handle) {$ok:s s;$err:e ""};
    let lines=str.split(out;"
");
    lp(let ii=0;ii<lines.len;ii=ii+1){ let line=lines.get(ii);
      if(str.contains(line;name)){
        let parts=str.split(str.trim(line);" ");
        let cleaned=@();
        lp(let jj=0;jj<parts.len;jj=jj+1){ let p=parts.get(jj);
          if(str.len(str.trim(p))>0){
            cleaned.push(str.trim(p))
          }el{}
        };
        if(cleaned.len>4){
          let pid=mt str.parseint(cleaned.get(0)) {$ok:n n;$err:e 0};
          let cpu=mt str.parsefloat(cleaned.get(1)) {$ok:f f;$err:e 0.0};
          let rsskb=mt str.parseint(cleaned.get(2)) {$ok:n n;$err:e 0};
          let rammb=(rsskb as f64)/1024.0;
          if(cpu>best.cpupercent){
            best=$processstats{pid:pid;name:name;cpupercent:cpu;rammb:rammb;rampercent:0.0;threads:0}
          }el{}
        }el{}
      }el{}
    }
  };
  <best
};
f=getactivemodel():str{
  let handle=mt process.spawn(@("curl";"-s";"http://localhost:11434/api/ps")) {
    $ok:handle handle;
    $err:e ""
  };
  mt process.wait(handle) {$ok:v 0;$err:e 0};
  let out=mt process.stdout(handle) {$ok:s s;$err:e ""};
  if(str.contains(out;"name")){
    let parts=str.split(out;"\"name\":\"");
    if(parts.len>2){
      let modelpart=parts.get(1);
      let end=str.indexof(modelpart;"\"");
      if(end>0){<str.slice(modelpart;0;end)}el{<"unknown"}
    }el{<""}
  }el{<""}
};
f=snapshot():$systemstats{
  let ram=getramstats();
  let cpu=getcpustats();
  let ollama=getprocessstats("ollama");
  let lokeproc=getprocessstats("ooke-toke");
  let slmactive=ollama.cpupercent>5.0;
  let slmmodel=mut."";
  if(slmactive){slmmodel=getactivemodel()}el{};
  <$systemstats{
    totalrammb:ram.total;
    usedrammb:ram.used;
    freerammb:ram.free;
    rampercent:ram.percent;
    cpucount:cpu.count;
    cpupercent:cpu.percent;
    ollamastats:ollama;
    lokestats:lokeproc;
    slmactive:slmactive;
    slmmodel:slmmodel
  }
};
f=tojson(stats:$systemstats):str{
  let slmstr=mut."null";
  if(stats.slmactive){slmstr=str.concat("\"";str.concat(stats.slmmodel;"\""))}el{};
  let slmactivebool=mut."false";
  if(stats.slmactive){slmactivebool="true"}el{};
  <str.concat("{\"total_ram_mb\":";str.concat(str.fromint(stats.totalrammb);
    str.concat(",\"used_ram_mb\":";str.concat(str.fromint(stats.usedrammb);
    str.concat(",\"free_ram_mb\":";str.concat(str.fromint(stats.freerammb);
    str.concat(",\"ram_percent\":";str.concat(str.fromfloat(stats.rampercent);
    str.concat(",\"cpu_count\":";str.concat(str.fromint(stats.cpucount);
    str.concat(",\"cpu_percent\":";str.concat(str.fromfloat(stats.cpupercent);
    str.concat(",\"ollama\":{\"pid\":";str.concat(str.fromint(stats.ollamastats.pid);
    str.concat(",\"cpu\":";str.concat(str.fromfloat(stats.ollamastats.cpupercent);
    str.concat(",\"ram_mb\":";str.concat(str.fromfloat(stats.ollamastats.rammb);
    str.concat("}";
    str.concat(",\"loke\":{\"pid\":";str.concat(str.fromint(stats.lokestats.pid);
    str.concat(",\"cpu\":";str.concat(str.fromfloat(stats.lokestats.cpupercent);
    str.concat(",\"ram_mb\":";str.concat(str.fromfloat(stats.lokestats.rammb);
    str.concat("}";
    str.concat(",\"slm_active\":";str.concat(slmactivebool;
    str.concat(",\"slm_model\":";str.concat(slmstr;
    "}"))))))))))))))))))))))))))))))
};

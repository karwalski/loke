
m=core.governance.approval;
i=str:std.str;
i=log:shared.log;

t=$approvalmode{
  $always:i64;
  $bysensitivity:i64;
  $byprovider:i64;
  $bypolicy:i64;
  $never:i64
};

t=$approvalrequest{
  requestid:$str;
  originalprompt:$str;
  transformedprompt:$str;
  sensitivitylevel:$str;
  providerid:$str;
  modelid:$str;
  triggerreason:$str;
  tokensbefore:i64;
  tokensafter:i64
};

t=$approvaldecision{
  approved:bool;
  requestid:$str;
  decidedby:$str;
  dontaskagain:bool;
  tasktype:$str
};

t=$diffline{
  linetype:$str;
  content:$str
};

t=$dontaskrule{
  tasktype:$str;
  providerid:$str;
  maxsensitivity:$str;
  createdat:i64
};

f=requiresapproval(mode:$str;sensitivity:$str;providerid:$str;tasktype:$str;rules:@$dontaskrule:bool{
  let suppressed=mut.false;
  rules.each|rule{
    if(str.eq(rule.tasktype;tasktype)){
      suppressed=true
    }el{};
  };
  if(suppressed){<false}el{};

  if(str.eq(mode;"always")){<true}el{
    if(str.eq(mode;"never")){<false}el{
      if(str.eq(mode;"by_sensitivity")){
        if(str.eq(sensitivity;"confidential")){<true}el{
          if(str.eq(sensitivity;"restricted")){<true}el{<false};
        };
      }el{
        if(str.eq(mode;"by_provider")){
          if(str.eq(providerid;"ollama")){<false}el{
            if(str.eq(providerid;"mlx")){<false}el{<true};
          };
        }el{
          <false
        };
      };
    };
  };
};

f=generatediff(original:$str;transformed:$str):@$diffline{
  let result=@$diffline;
  let origlines=str.split(original;"
");
  let translines=str.split(transformed;"
");

  let maxlen=if(origlines.len>translines.len):i64{origlines.len}el{translines.len};
  let i=0;
  lp(true){
    if(i>maxlen){break}el{
      let origline=if(i<origlines.len):i64{origlines.get(i)}el{""};
      let transline=if(i<translines.len):i64{translines.get(i)}el{""};
      if(str.eq(origline;transline)){
        result:@.push(result;$diffline{linetype:"unchanged";content:$origline})
      }el{
        if(str.len(origline)>0){
          result:@.push(result;$diffline{linetype:"removed";content:$origline})
        }el{};
        if(str.len(transline)>0){
          result:@.push(result;$diffline{linetype:"added";content:$transline})
        }el{};
      };
      i=i+1;
    };
  };
  <result
};

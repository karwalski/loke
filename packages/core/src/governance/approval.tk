m=core.governance.approval;
i=str:std.str;
i=log:shared.log;

t=$approvalmode{
  $always:i64;
  $bysensitivity:i64;
  $byprovider:i64;
  $bypolicy:i64;
  $never:i64
};

t=$approvalrequest{
  requestid:str;
  originalprompt:str;
  transformedprompt:str;
  sensitivitylevel:str;
  providerid:str;
  modelid:str;
  triggerreason:str;
  tokensbefore:i64;
  tokensafter:i64
};

t=$approvaldecision{
  approved:bool;
  requestid:str;
  decidedby:str;
  dontaskagain:bool;
  tasktype:str
};

t=$diffline{
  linetype:str;
  content:str
};

t=$dontaskrule{
  tasktype:str;
  providerid:str;
  maxsensitivity:str;
  createdat:i64
};

f=requiresapproval(mode:str;sensitivity:str;providerid:str;tasktype:str;rules:@$dontaskrule):bool{
  let suppressed=mut.false;
  lp(let i=0;i<str.arraylen(rules);i=i+1){ let rule=str.arrayget(rules;i);
    if(str.eq(rule.tasktype;tasktype)){
      suppressed=true
    }el{}
  };
  if(suppressed){<false}el{};

  if(str.eq(mode;"always")){<true}el{
    if(str.eq(mode;"never")){<false}el{
      if(str.eq(mode;"by_sensitivity")){
        if(str.eq(sensitivity;"confidential")){<true}el{
          if(str.eq(sensitivity;"restricted")){<true}el{<false}
        }
      }el{
        if(str.eq(mode;"by_provider")){
          if(str.eq(providerid;"ollama")){<false}el{
            if(str.eq(providerid;"mlx")){<false}el{<true}
          }
        }el{
          <false
        }
      }
    }
  }
};

f=generatediff(original:str;transformed:str):@$diffline{
  let result=mut.@();
  let origlines=str.split(original;"
");
  let translines=str.split(transformed;"
");

  let maxlen=mut.translines.len;
  if(origlines.len>translines.len){maxlen=origlines.len};
  let i=mut.0;
  lp(let lv=0;!(i>maxlen);lv=lv){
    let origline=mut."";
    if(i<origlines.len){origline=origlines.get(i)};
    let transline=mut."";
    if(i<translines.len){transline=translines.get(i)};
    if(str.eq(origline;transline)){
      result=result.push($diffline{linetype:"unchanged";content:origline})
    }el{
      if(str.len(origline)>0){
        result=result.push($diffline{linetype:"removed";content:origline})
      }el{};
      if(str.len(transline)>0){
        result=result.push($diffline{linetype:"added";content:transline})
      }el{}
    };
    i=i+1
  };
  <result
};

m=core.governance.scorecard;

i=time:std.time;
i=str:std.str;
i=t:shared.types;

t=$providerstats{
  provider:str;
  requests:i32;
  avglatencyms:i32;
  p99latencyms:i32;
  errorratepct:f64;
  totalcostusd:f64;
  avgcostperreq:f64
};

t=$providerscorecard{
  providers:@$providerstats;
  generatedat:i64
};

f=buildscorecard(store:i64):$providerscorecard{
  let anthropic=$providerstats{
    provider:"anthropic";
    requests:89;
    avglatencyms:1240;
    p99latencyms:3100;
    errorratepct:0.5;
    totalcostusd:0.31;
    avgcostperreq:0.31/89.0
  };
  let openai=$providerstats{
    provider:"openai";
    requests:34;
    avglatencyms:980;
    p99latencyms:2400;
    errorratepct:0.0;
    totalcostusd:0.18;
    avgcostperreq:0.18/34.0
  };
  let ollama=$providerstats{
    provider:"ollama";
    requests:19;
    avglatencyms:420;
    p99latencyms:890;
    errorratepct:2.1;
    totalcostusd:0.0;
    avgcostperreq:0.0
  };
  <$providerscorecard{
    providers:@(anthropic;openai;ollama);
    generatedat:time.now()
  }
};


f=formatscorecard(card:$providerscorecard):str{
  let header=str.concat(
    "Provider scorecard
";
    "==================
"
  );
  let colheader=str.concat(
    t.strpad("Provider";12);
    str.concat(
      t.strpad("Requests";10);
      str.concat(
        t.strpad("Avg ms";8);
        str.concat(
          t.strpad("P99 ms";8);
          str.concat(
            t.strpad("Error%";8);
            "Cost
"
          )
        )
      )
    )
  );
  let divider="------------  --------  ------  ------  ------  --------
";
  let rows=mut."";
  lp(let ii94=0;ii94<card.providers.len;ii94=ii94+1){
    let p=card.providers.get(ii94);
    let reqs=str.fromint(p.requests);
    let avgs=str.fromint(p.avglatencyms);
    let p99s=str.fromint(p.p99latencyms);
    let errs=str.concat(str.fromfloat(p.errorratepct);"%");
    let costs=str.concat("$";str.fromfloat(p.totalcostusd));
    let row=str.concat(
      t.strpad(p.provider;12);
      str.concat(
        t.strpad(reqs;10);
        str.concat(
          t.strpad(avgs;8);
          str.concat(
            t.strpad(p99s;8);
            str.concat(
              t.strpad(errs;8);
              str.concat(costs;"
")
            )
          )
        )
      )
    );
    rows=str.concat(rows;row)

  };
  <str.concat(
    str.concat(
      str.concat(
        str.concat(header;colheader);
        divider);
      rows);
    "")
};

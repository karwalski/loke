m=core.governance.scorecard;

i=time:std.time;
i=str:std.str;
i=t:shared.types;
i=db:std.db;
i=s:core.storage.db;

(* Every field here is now DERIVED from audit_log, or explicitly marked as not recorded.

   What was here before: buildscorecard ignored its `store` entirely and returned hardcoded
   statistics — anthropic 89 requests, openai 34, ollama 19, with invented latencies
   (p99latencyms:3100), invented error rates and invented costs — which formatscorecard then
   rendered under the heading "Provider scorecard". Anything displaying it published numbers
   nobody measured, which `CLAUDE.md` names as a hard constraint and `docs/metrics-baseline.md`
   exists to prevent. It is the DA1.5 defect in a second place.

   Costs are carried in integer HUNDREDTHS rather than as f64. Two reasons: `audit_log.cost_usd`
   is a REAL and SQLite owns its rendering, which broke the audit chain's digest twice (see
   `audit.digestfields`); and money is exact only as an integer. (A third reason, T-20, a bare
   f64 corrupted crossing a module boundary, was fixed in toke 3.1.0, LS1.1h.)

   GA5.19, CLOSED 2026-09-24. There is now a source for the error rate. The request path
   used to write event_type 'llm_request' for every outcome — a completed request, a 502
   from the provider, a route it refuses, a budget stop, a policy deny — so nothing
   downstream could tell a failure from a success and this module had to render NOT
   RECORDED rather than 0%, which would have stated that no request has ever failed.
   page.api.pipeline.recordevent now takes the event type as a parameter and
   writes five distinct values.

   Two consequences here, and the second one is a defect this row did not name:

   1. `errors` and `errorratebp` are derived, and `errorsrecorded` now means "this provider
      has dispatch attempts, so the rate below is a measurement" rather than "no source
      exists". A provider with zero attempts still reports NOT RECORDED, because 0 errors
      out of 0 attempts is not 0%.
   2. EVERY per-provider figure is now restricted to dispatch rows. It was not before, and
      the refusal paths write a real provider name and model id with a duration and no
      tokens (`unsupportedprovider`, `needsanthropickey`) — so a provider this endpoint has
      no client for was counted as having made requests, at a latency that dragged the mean
      down and a cost of zero that dragged the per-request cost down with it. The refusals
      that carry provider 'none' were worse: 'none' appeared in the scorecard as a provider.

   The rate is in integer BASIS POINTS: they divide exactly by construction. *)
t=$providerstats{
  provider:str;
  requests:i64;
  errors:i64;
  errorratebp:i64;
  avglatencyms:i64;
  p99latencyms:i64;
  totalcosthundredths:i64;
  avgcostperreqhundredths:i64;
  errorsrecorded:bool
};

t=$providerscorecard{
  providers:@$providerstats;
  generatedat:i64
};

(* The two event types that mean a provider was actually called. Spelled once: the whole
   correctness of every per-provider figure below is that they all agree about which rows
   count, and five copies of a string is five chances for one of them not to. *)
f=dispatchclause():str{
  <" AND event_type IN ('llm_request','llm_request_failed')"
};

f=providernames():@str{
  (* Read from the trail rather than hardcoded, so a provider that has never been used does
     not appear with zeroes and a new one appears without a code change. *)
  <mt db.many("SELECT DISTINCT provider FROM audit_log WHERE provider<>''\(dispatchclause()) ORDER BY provider";@()) {
    $ok:rows namesfromrows(rows);
    $err:e @("")
  }
};

f=namesfromrows(rows:@$row):@str{
  let out=mut.@("");
  out=@();
  lp(let i=0;i<rows.len;i=i+1){
    let r:$row=rows.get(i);
    out=out.push(s.rowstr(r;"provider"))
  };
  <out
};

f=avgdurationms(provider:str):i64{
  (* AVG over an INTEGER column returns a REAL, so it is read as hundredths and divided back
     — the same reason rowf64hundredths exists. Rounds rather than truncating. *)
  <mt db.one(str.concat("SELECT CAST(ROUND(AVG(duration_ms)) AS INTEGER) AS v FROM audit_log WHERE provider=?";dispatchclause());@(provider)) {
    $ok:r s.rowi64(r;"v");
    $err:e 0
  }
};

f=p99durationms(provider:str;n:i64):i64{
  (* SQLite has no percentile function, so the 99th is the row at offset ceil(n*99/100)-1 in
     ascending order. With fewer than 100 rows that is the maximum, which is the honest answer
     for a small sample rather than an interpolation nobody asked for. *)
  if(n<1){
    <0
  }el{
    let idx=mut.((n * 99) + 99) / 100 - 1;
    if(idx<0){idx=0}el{};
    if(idx>n-1){idx=n-1}el{};
    <mt db.one(str.concat("SELECT duration_ms AS v FROM audit_log WHERE provider=?\(dispatchclause()) ORDER BY CAST(duration_ms AS INTEGER) ASC LIMIT 1 OFFSET ";str.fromi64(idx));@(provider)) {
      $ok:r s.rowi64(r;"v");
      $err:e 0
    }
  }
};

f=totalcosthundredthsfor(provider:str):i64{
  <s.scalari64(
    str.join("";@("SELECT COALESCE(SUM(";s.auditcostcentsexpr();"),0) AS v FROM audit_log WHERE provider=?";dispatchclause()));
    @(provider);
    "v";
    0)
};

f=errorsfor(provider:str):i64{
  <mt db.one("SELECT COUNT(id) AS cnt FROM audit_log WHERE provider=? AND event_type='llm_request_failed'";@(provider)) {
    $ok:r s.rowi64(r;"cnt");
    $err:e 0
  }
};

(* Basis points, rounded to nearest rather than truncated: 1 failure in 3 is 3333bp, and a
   truncating divide would report 33.3% where the honest figure to one decimal is 33.3% as
   well, but 1 in 8 is 1250bp and 2 in 3 is 6667bp — the difference shows up at the
   boundary, and a rate that reads low is the wrong direction for a rate to be wrong in. *)
f=errorratebpof(errors:i64;attempts:i64):i64{
  if(attempts<1){
    <0
  }el{
    <((errors * 20000) + attempts) / (attempts * 2)
  }
};

f=statsfor(provider:str):$providerstats{
  (* db.one plus rowi64, NOT s.countquery. countquery returns the number of ROWS a query
     returns, which is 1 for any `SELECT COUNT(...)` — it is an existence check, and using it
     as a scalar reader silently reports every provider as having exactly one request. Caught
     by the count-equals-rows-written assertion, which is the assertion that exists to catch a
     constant. *)
  let n=mt db.one(str.concat("SELECT COUNT(id) AS cnt FROM audit_log WHERE provider=?";dispatchclause());@(provider)) {
    $ok:r s.rowi64(r;"cnt");
    $err:e 0
  };
  let total=totalcosthundredthsfor(provider);
  let per=mut.0;
  if(n>0){per=total/n}el{};
  let errs=errorsfor(provider);
  <$providerstats{
    provider:provider;
    requests:n;
    errors:errs;
    errorratebp:errorratebpof(errs;n);
    avglatencyms:avgdurationms(provider);
    p99latencyms:p99durationms(provider;n);
    totalcosthundredths:total;
    avgcostperreqhundredths:per;
    errorsrecorded:n>0
  }
};

f=buildscorecard(store:i64):$providerscorecard{
  (* store is still the parameter for signature compatibility; core.storage.db's helpers hold
     the connection, which is why nothing is passed on. Previously `store` was ignored because
     nothing was queried at all — it is now ignored because it is not needed. *)
  if(s.tableexists("audit_log")){
    let names=providernames();
    let rows=mut.@($providerstats);
    lp(let i=0;i<names.len;i=i+1){
      let nm=names.get(i);
      if(str.len(nm)>0){
        rows=rows.push(statsfor(nm))
      }el{}
    };
    <$providerscorecard{providers:rows;generatedat:time.now()}
  }el{
    <$providerscorecard{providers:@($providerstats);generatedat:time.now()}
  }
};

(* Basis points to a one-decimal percentage, entirely in integers. 3333bp -> "33.3%".
   str.fromfloat renders 5.0 as "5" and 33.3 as "33.299999", so the percentage is assembled
   from the integer rather than converted to one. *)
f=pctfrombp(bp:i64):str{
  let tenths=(bp + 5) / 10;
  <str.concat(str.fromi64(tenths / 10);str.concat(".";str.concat(str.fromi64(tenths % 10);"%")))
};

f=formatscorecard(card:$providerscorecard):str{
  let header=str.concat(
    "Provider scorecard
";
    "==================
"
  );
  let colheader=str.concat(
    t.strpad("Provider";12);
    str.concat(
      t.strpad("Requests";10);
      str.concat(
        t.strpad("Avg ms";8);
        str.concat(
          t.strpad("P99 ms";8);
          str.concat(
            t.strpad("Error%";8);
            "Cost
"
          )
        )
      )
    )
  );
  let divider="------------  --------  ------  ------  ------  --------
";
  let rows=mut."";
  lp(let ii94=0;ii94<card.providers.len;ii94=ii94+1){
    let p=card.providers.get(ii94);
    let reqs=str.fromi64(p.requests);
    let avgs=str.fromi64(p.avglatencyms);
    let p99s=str.fromi64(p.p99latencyms);
    (* A real figure where there is one, and "n/r" - NOT RECORDED - where there is not.
       A provider with no dispatch attempts prints n/r rather than 0.0%, because 0 failures
       out of 0 calls is not a zero failure rate, and a dash there would read as one. *)
    let errs=mut."n/r";
    if(p.errorsrecorded){errs=pctfrombp(p.errorratebp)}el{};
    let costs=s.moneyfromhundredths(p.totalcosthundredths);
    let row="\(t.strpad(p.provider;12))\(t.strpad(reqs;10))\(t.strpad(avgs;8))\(t.strpad(p99s;8))\(t.strpad(errs;8))\(costs)\n";
    rows=str.concat(rows;row)

  };
  <"\(header)\(colheader)\(divider)\(rows)"
};

m=core.governance.scorecard;



i=t:shared.types;
i=db:storage.db;
i=str:std.str;

t=$providerstats{
  provider:str;
  requests:i32;
  avglatencyms:i32;
  p99latencyms:i32;
  errorratepct:f64;
  totalcostusd:f64;
  avgcostperreq:f64
};

t=$providerscorecard{
  providers:@$providerstats;
  generatedat:i64
};



f=buildscorecard(store:i64):$providerscorecard{
  let anthropic=$providerstats{
    provider:"anthropic";
    requests:89;
    avglatencyms:1240;
    p99latencyms:3100;
    errorratepct:0.5;
    totalcostusd:0.31;
    avgcostperreq:0.31/89.0
  };
  let openai=$providerstats{
    provider:"openai";
    requests:34;
    avglatencyms:980;
    p99latencyms:2400;
    errorratepct:0.0;
    totalcostusd:0.18;
    avgcostperreq:0.18/34.0
  };
  let ollama=$providerstats{
    provider:"ollama";
    requests:19;
    avglatencyms:420;
    p99latencyms:890;
    errorratepct:2.1;
    totalcostusd:0.0;
    avgcostperreq:0.0
  };
  <$providerscorecard{
    providers:@(anthropic;openai;ollama);
    generatedat:std.time.now()
  }
};


f=padright(s:str;width:i32):str{
  let len=str.len(s);
  if(len > width){
    <s
  }el{
    let diff=width-len;
    let spaces="                              ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  }
};



f=formatscorecard(sc:$providerscorecard):str{
  let header=str.concat(
    "Provider scorecard
";
    "==================
"
  );
  let colheader=str.concat(
    padright("Provider";12);
    str.concat(
      padright("Requests";10);
      str.concat(
        padright("Avg ms";8);
        str.concat(
          padright("P99 ms";8);
          str.concat(
            padright("Error%";8);
            "Cost
"
          )
        )
      )
    )
  );
  let divider="------------  --------  ------  ------  ------  --------
";
  let rows="";
  sc.providers.each|p{
    let reqs=str.fromint(p.requests);
    let avgs=str.fromint(p.avglatencyms);
    let p99s=str.fromint(p.p99latencyms);
    let errs=str.concat(str.fromfloat(p.errorratepct);"%");
    let costs=str.concat("$";str.fromfloat(p.totalcostusd));
    let row=str.concat(
      padright(p.provider;12);
      str.concat(
        padright(reqs;10);
        str.concat(
          padright(avgs;8);
          str.concat(
            padright(p99s;8);
            str.concat(
              padright(errs;8);
              str.concat(costs;"
")
            )
          )
        )
      )
    );
    rows=str.concat(rows;row)
  };
  <str.concat(
    str.concat(
      str.concat(
        str.concat(header;colheader);
        divider);
      rows);
    "")
};

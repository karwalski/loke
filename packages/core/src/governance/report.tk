m=core.governance.report;

i=db:std.db;
i=str:std.str;
i=fs:std.fs;
i=log:shared.log;
i=time:std.time;

t=$govreport{
  period:str;
  fromts:i64;
  tots:i64;
  totalrequests:i32;
  violations:i32;
  quotabreaches:i32;
  toprules:@str;
  summary:str
};



f=countevents(store:i64;sql:str;fromts:i64;tots:i64):i32{
  let froms=str.fromint(fromts);
  let tos=str.fromint(tots);
  let rows=mt db.queryparams(store.conn;sql;@(froms;tos)) {
    $ok:rows rows;
    $err:e 0
  };
  if(rows.len=0){
    <0
  }el{
    <json.getint(rows.get(0);"cnt")
  };
};


f=querytoprulesmaprows(rows:i64):@str{
  let mapped=mut.@();
  lp(let ii37=0;ii37<rows.len;ii37=ii37+1){
    let row=rows.get(ii37);
    mapped=mapped.push(json.getstr(row;"rule_id"))
  }
};

f=querytoprulesfail():@str{
  log.warn("failed to query top rules for report";"report";"system");
  <@()
};

f=querytoprules(store:i64;fromts:i64;tots:i64):@str{
  let froms=str.fromint(fromts);
  let tos=str.fromint(tots);
  mt db.queryparams(
    store.conn;
    "SELECT rule_id FROM audit_events
     WHERE event_type='policy_fire' AND ts>=? AND ts<=?
     GROUP BY rule_id ORDER BY COUNT(*) DESC LIMIT 5";
    @(froms;tos)
  ) {
    $ok:rows querytoprulesmaprows(rows);
    $err:e querytoprulesfail()
  }
};




f=generate(store:i64;period:str;fromts:i64;tots:i64):$govreport{
  let total=countevents(
    store;
    "SELECT COUNT(*) AS cnt FROM audit_events WHERE ts>=? AND ts<=?";
    fromts;
    tots
  );
  let violations=countevents(
    store;
    "SELECT COUNT(*) AS cnt FROM audit_events WHERE event_type IN ('policy_deny','policy_require_approval') AND ts>=? AND ts<=?";
    fromts;
    tots
  );
  let quotabreaches=countevents(
    store;
    "SELECT COUNT(*) AS cnt FROM audit_events WHERE event_type='quota_exceeded' AND ts>=? AND ts<=?";
    fromts;
    tots
  );
  let toprules=querytoprules(store;fromts;tots);
  let totals=str.fromint(total);
  let viols=str.fromint(violations);
  let qbs=str.fromint(quotabreaches);
  let summary=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(period;" governance report — ");
              totals);
            " requests, ");
          viols);
        " violations, ");
      qbs);
    " quota breaches"
  );
  log.info(summary;"report";"system");
  <$govreport{
    period:period;
    fromts:fromts;
    tots:tots;
    totalrequests:total;
    violations:violations;
    quotabreaches:quotabreaches;
    toprules:toprules;
    summary:summary
  }
};


f=rulesmd(rules:@str):str{
  if(rules.len=0){
    <"_none_
"
  }el{
    let out="";
    lp(let ii124=0;ii124<rules.len;ii124=ii124+1){
      let r=rules.get(ii124);
      out=str.concat(out;str.concat("- ";str.concat(r;"
")))

    };
    <out
  }
};


f=formatmarkdown(report:$govreport):str{
  let froms=str.fromint(report.fromts);
  let tos=str.fromint(report.tots);
  let totals=str.fromint(report.totalrequests);
  let viols=str.fromint(report.violations);
  let qbs=str.fromint(report.quotabreaches);
  let rulessection=rulesmd(report.toprules);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(
                        str.concat(
                          str.concat(
                            str.concat(
                              str.concat(
                                str.concat(
                                  str.concat(
                                    str.concat(
                                      str.concat(
                                        str.concat(
                                          "# Governance Report — ";
                                          report.period);
                                        "

");
                                      "**Period:** ");
                                    froms);
                                  " → ");
                                tos);
                              "

");
                            "## Summary

");
                          report.summary);
                        "

");
                      "## Metrics

");
                    "| Metric | Value |
");
                  "|---|---|
");
                str.concat(str.concat("| Total requests | ";totals);"|
"));
              str.concat(str.concat("| Policy violations | ";viols);"|
"));
            str.concat(str.concat("| Quota breaches | ";qbs);"|
"));
          "
## Top Triggered Rules

");
        rulessection);
      "
---

_Generated by loke governance engine._
")
  )
};




f=write(report:$govreport;outdir:str):bool{
  let tss=str.fromint(report.tots);
  let filename=str.concat(
    str.concat(
      str.concat(
        str.concat("governance-";report.period);
        "-");
      tss);
    ".md"
  );
  let path=str.concat(str.concat(outdir;"/");filename);
  let content=formatmarkdown(report);
  let ok=mt fs.writetext(path;content) {
    $ok:v true;
    $err:e false
  };
  if(ok){
    log.info(str.concat("governance report written: ";path);"report";"system");
    <true
  }el{
    log.warn(str.concat("failed to write governance report: ";path);"report";"system");
    <false
  }
};

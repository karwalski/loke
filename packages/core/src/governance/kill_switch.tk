m=core.governance.killswitch;

i=t:shared.types;
i=db:core.storage.db;
i=set:core.storage.settings;
i=str:std.str;
i=log:shared.log;

t=$killswitchstate{
  engaged:bool;
  engagedat:i64;
  engagedby:str;
  reason:str;
  autoreleaseat:i64
};

f=settingkey():str{ <"governance.kill_switch.engaged" };

f=loadstate(store:i64):$killswitchstate{
  let engagedstr=mt set.getstr(store;settingkey()) {
    $ok:v v;
    $err:e "false"
  };
  let engaged=str.eq(engagedstr;"true");
  let engagedat=mt set.getint(store;"governance.kill_switch.engaged_at") {
    $ok:v v;
    $err:e 0
  };
  let engagedby=mt set.getstr(store;"governance.kill_switch.engaged_by") {
    $ok:v v;
    $err:e ""
  };
  let reason=mt set.getstr(store;"governance.kill_switch.reason") {
    $ok:v v;
    $err:e ""
  };
  let autoreleaseat=mt set.getint(store;"governance.kill_switch.auto_release_at") {
    $ok:v v;
    $err:e 0
  };
  <$killswitchstate{
    engaged:engaged;
    engagedat:engagedat;
    engagedby:engagedby;
    reason:reason;
    autoreleaseat:autoreleaseat
  }
};

f=engage(store:i64;reason:str;autoreleaseminutes:i32):bool{
  let now=str.nowunix();
  let autoreleaseat=mut.0; if(autoreleaseminutes > 0 as i32){
    autoreleaseat=now+(str.toint(str.fromint(autoreleaseminutes))*60)
  }el{};
  set.setbool(store;settingkey();true;"governance");
  set.setint(store;"governance.kill_switch.engaged_at";now;"governance");
  set.setstr(store;"governance.kill_switch.engaged_by";"system";"governance");
  set.setstr(store;"governance.kill_switch.reason";reason;"governance");
  set.setint(store;"governance.kill_switch.auto_release_at";autoreleaseat;"governance");
  log.warn(str.concat("Kill switch ENGAGED: ";reason);"kill-switch";"system");
  <true
};

f=release(store:i64):bool{
  set.setbool(store;settingkey();false;"governance");
  set.setint(store;"governance.kill_switch.engaged_at";0;"governance");
  set.setstr(store;"governance.kill_switch.engaged_by";"";"governance");
  set.setstr(store;"governance.kill_switch.reason";"";"governance");
  set.setint(store;"governance.kill_switch.auto_release_at";0;"governance");
  log.info("Kill switch released";"kill-switch";"system");
  <true
};

f=checkautorelease(store:i64):bool{
  let state=loadstate(store);
  if(state.autoreleaseat > 0){
    let now=str.nowunix();
    if(now > state.autoreleaseat){
      release(store);
      <true
    }el{
      <false
    }
  }el{
    <false
  }
};

f=isengaged(store:i64):bool{
  checkautorelease(store);
  let state=loadstate(store);
  <state.engaged
};

f=formatwidget(state:$killswitchstate):str{
  if(state.engaged){
    let line1="+-Kill Switch-------------------+
";
    let line2="| Status: ENGAGED               |
";
    let reasonpadded=str.padright(str.concat("| Reason: ";state.reason);36);
    let line3=str.concat(reasonpadded;"|
");
    let line4="| All LLM traffic blocked       |
";
    let line5="| [Release]                     |
";
    let line6="+-------------------------------+";
    <str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(line1;line2);
            line3);
          line4);
        line5);
      line6)
  }el{
    let line1="+-Kill Switch-------------------+
";
    let line2="| Status: DISENGAGED [safe]     |
";
    let line3="| [Engage] - stops all traffic  |
";
    let line4="+-------------------------------+";
    <str.concat(
      str.concat(
        str.concat(line1;line2);
        line3);
      line4)
  }
};

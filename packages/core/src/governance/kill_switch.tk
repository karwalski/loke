m=core.governance.killswitch;

i=set:core.storage.settings;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;

t=$killswitchstate{
  engaged:bool;
  engagedat:i64;
  engagedby:str;
  reason:str;
  autoreleaseat:i64
};

f=settingkey():str{ <"governance.kill_switch.engaged" };

(* Every read takes its default from settings, not from a match arm.

   This function used to read the engaged flag with set.getstr and fall back to "false"
   in an $err arm. engage() writes that flag with set.setbool, so the row's value_type
   is "bool", getstr refuses it as a type mismatch — and the $err arm never ran, because
   toke takes the first arm of a match on X!$err regardless (T-18). The caller bound the
   error payload as if it were the string, str.eq(...;"true") was false, and an ENGAGED
   kill switch reported itself DISENGAGED. The control that blocks all LLM traffic did
   nothing, silently.

   set.get*or applies the default inside settings, on a plain row count, so there is no
   result for this code to mis-unwrap. *)
f=loadstate(store:i64):$killswitchstate{
  <$killswitchstate{
    engaged:set.getboolor(store;settingkey();false);
    engagedat:set.getintor(store;"governance.kill_switch.engaged_at";0);
    engagedby:set.getstror(store;"governance.kill_switch.engaged_by";"");
    reason:set.getstror(store;"governance.kill_switch.reason";"");
    autoreleaseat:set.getintor(store;"governance.kill_switch.auto_release_at";0)
  }
};

f=engage(store:i64;reason:str;autoreleaseminutes:i32):bool{
  let now=t.nowi64();
  let autoreleaseat=mut.0; if(autoreleaseminutes > 0 as i32){
    autoreleaseat=now+(str.toint(str.fromint(autoreleaseminutes))*60)
  }el{};
  set.setbool(store;settingkey();true;"governance");
  set.setint(store;"governance.kill_switch.engaged_at";now;"governance");
  set.setstr(store;"governance.kill_switch.engaged_by";"system";"governance");
  set.setstr(store;"governance.kill_switch.reason";reason;"governance");
  set.setint(store;"governance.kill_switch.auto_release_at";autoreleaseat;"governance");
  log.warn(str.concat("Kill switch ENGAGED: ";reason);"kill-switch";"system");
  <true
};

f=release(store:i64):bool{
  set.setbool(store;settingkey();false;"governance");
  set.setint(store;"governance.kill_switch.engaged_at";0;"governance");
  set.setstr(store;"governance.kill_switch.engaged_by";"";"governance");
  set.setstr(store;"governance.kill_switch.reason";"";"governance");
  set.setint(store;"governance.kill_switch.auto_release_at";0;"governance");
  log.info("Kill switch released";"kill-switch";"system");
  <true
};

f=checkautorelease(store:i64):bool{
  let state=loadstate(store);
  if(state.autoreleaseat > 0){
    let now=t.nowi64();
    if(now > state.autoreleaseat){
      release(store);
      <true
    }el{
      <false
    }
  }el{
    <false
  }
};

f=isengaged(store:i64):bool{
  checkautorelease(store);
  let state=loadstate(store);
  <state.engaged
};

(* ── T10.1 / G1.6: per-provider scope ─────────────────────────────────────────────
   One persisted flag per provider, beside the global one. A provider is blocked when the
   global switch is engaged OR its own flag is. The global switch still fails closed on an
   unreadable store (page.api.pipeline.killswitchengaged); a provider flag that cannot be
   read defaults to false, because the global check has already refused that case. *)
f=providers():@str{
  <@("anthropic";"openai";"google";"mistral";"openrouter";"ollama";"local")
};

f=providerkey(provider:str):str{
  <str.concat("governance.kill_switch.provider.";provider)
};

f=isknownprovider(provider:str):bool{
  let all=providers();
  let found=mut.false;
  lp(let i=0;i<all.len;i=i+1){
    if(str.eq(all.get(i);provider)){ found=true }el{}
  };
  <found
};

(* Refuses a provider name it does not know, so a typo cannot leave the real provider open
   while reporting it blocked. Success is the flag reading back as set. *)
f=engageprovider(store:i64;provider:str;reason:str):bool{
  if(store==0 || !isknownprovider(provider)){ <false }el{};
  set.setbool(store;providerkey(provider);true;"governance");
  set.setstr(store;str.concat(providerkey(provider);".reason");reason;"governance");
  log.warn(str.concat("Kill switch ENGAGED for provider ";str.concat(provider;str.concat(": ";reason)));"kill-switch";"system");
  <set.getboolor(store;providerkey(provider);false)
};

f=releaseprovider(store:i64;provider:str):bool{
  if(store==0 || !isknownprovider(provider)){ <false }el{};
  set.setbool(store;providerkey(provider);false;"governance");
  set.setstr(store;str.concat(providerkey(provider);".reason");"";"governance");
  log.info(str.concat("Kill switch released for provider ";provider);"kill-switch";"system");
  <!set.getboolor(store;providerkey(provider);true)
};

(* usecase is accepted for the row's shape and not yet scoped: per-use-case and per-agent
   scope are the rest of G1.6. *)
f=isblocked(store:i64;provider:str;usecase:str):bool{
  if(store==0){ <true }el{};
  if(isengaged(store)){ <true }el{};
  <set.getboolor(store;providerkey(provider);false)
};

(* Every active entry: "global" when the global switch is engaged, then each blocked
   provider by name. *)
f=listactive(store:i64):@str{
  let out=mut.@();
  if(isengaged(store)){ out=out.push("global") }el{};
  let all=providers();
  lp(let i=0;i<all.len;i=i+1){
    let p=all.get(i);
    if(set.getboolor(store;providerkey(p);false)){ out=out.push(p) }el{}
  };
  <out
};

f=fallbackmessage(provider:str):str{
  <"\(provider) is switched off by the kill switch, so this request was not sent. A local model can still answer, or an administrator can release the switch."
};

f=formatwidget(state:$killswitchstate):str{
  if(state.engaged){
    let line1="+-Kill Switch-------------------+
";
    let line2="| Status: ENGAGED               |
";
    let reasonpadded=t.strpad("| Reason: \(state.reason)";36);
    let line3=str.concat(reasonpadded;"|
");
    let line4="| All LLM traffic blocked       |
";
    <str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(line1;line2);
            line3);
          line4);
        "| [Release]                     |
");
      "+-------------------------------+")
  }el{
    let line1="+-Kill Switch-------------------+
";
    let line2="| Status: DISENGAGED [safe]     |
";
    let line3="| [Engage] - stops all traffic  |
";
    let line4="+-------------------------------+";
    <str.concat(
      str.concat(
        str.concat(line1;line2);
        line3);
      line4)
  }
};

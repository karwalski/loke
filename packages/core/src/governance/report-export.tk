m=core.governance.reportexport;
i=str:std.str;
i=log:shared.log;
i=re:core.governance.reportengine;
i=jx:shared.jsonobj;

f=export(report:$report):str{
  if(str.eq(report.format;"csv")){
    <tocsv(report)
  }el if(str.eq(report.format;"json")){
    <tojson(report)
  }el{
    <totext(report)
  }
};

(* GA5.31's Not-done, closed. The CSV export wrapped the detail in quotes and nothing else,
   and doubled no quote inside it; the JSON export carried no rows at all and escaped no
   string, so a value with a quote or a newline in it produced a file no parser reads. A
   report's fields come from audit_log, which the request path writes, but use_case,
   model_id and provider are names a caller or a config file chose, so nothing here may
   assume they are tame.

   CSV is RFC 4180: a field holding a comma, a double quote, CR or LF is quoted, and a
   double quote inside it is doubled. Records end in LF, which RFC 4180 readers (Python's
   csv, spreadsheets) accept.

   JSON strings go through shared.jsonobj's escape, the tested one (test_jsonobj,
   test_jsonescape), not a new escaper written here. *)
f=quotesdoubled(v:str):str{
  <str.replace(v;"\"";"\"\"")
};

f=csvfield(v:str):str{
  if(str.contains(v;",") || str.contains(v;"\"") || str.contains(v;"\r") || str.contains(v;"\n")){
    <"\"\(quotesdoubled(v))\""
  }el{};
  <v
};

f=comma():str{ <"," };

f=csvline(row:$reportrow):str{
  <"\(str.join(comma();@(csvfield(row.timestamp);csvfield(row.category);csvfield(row.detail);csvfield(row.severity);csvfield(row.value))))\n"
};

f=tocsv(report:$report):str{
  let out=mut."timestamp,category,detail,severity,value\n";
  lp(let i=0;i<report.rows.len;i=i+1){
    out=str.concat(out;csvline(report.rows.get(i)))
  };
  log.info("exported CSV report: \(str.fromint(report.rows.len))";"report_export";"system");
  <out
};

f=braced(fields:@str):str{
  <"{\(str.join(comma();fields))}"
};

f=jsonrow(row:$reportrow):str{
  <braced(@(
    "\"timestamp\":\(jx.escape(row.timestamp))";
    "\"category\":\(jx.escape(row.category))";
    "\"detail\":\(jx.escape(row.detail))";
    "\"severity\":\(jx.escape(row.severity))";
    "\"value\":\(jx.escape(row.value))"))
};

f=jsonrows(report:$report):str{
  let out=mut."";
  lp(let i=0;i<report.rows.len;i=i+1){
    if(i>0){ out=str.concat(out;comma()) }el{};
    out=str.concat(out;jsonrow(report.rows.get(i)))
  };
  <"[\(out)]"
};

f=tojson(report:$report):str{
  log.info("exported JSON report: \(str.fromint(report.rows.len))";"report_export";"system");
  <braced(@(
    "\"title\":\(jx.escape(report.title))";
    "\"type\":\(jx.escape(report.reporttype))";
    "\"generated_at\":\(jx.escape(report.generatedat))";
    "\"period_start\":\(jx.escape(report.periodstart))";
    "\"period_end\":\(jx.escape(report.periodend))";
    "\"summary\":\(jx.escape(report.summary))";
    "\"row_count\":\(str.fromint(report.rows.len))";
    "\"rows\":\(jsonrows(report))"))
};

f=totext(report:$report):str{
  let out=mut."= \(report.title) =\n";
  out="\(out)Period: \(report.periodstart) to \(report.periodend)\n";
  out="\(out)Summary: \(report.summary)\n\n";
  lp(let i=0;i<report.rows.len;i=i+1){ let row:$reportrow=report.rows.get(i);
    out="\(out)[\(row.severity)] \(row.timestamp) | \(row.category): \(row.detail)\n"
  };
  <out
};

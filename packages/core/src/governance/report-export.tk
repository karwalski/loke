m=core.governance.reportexport;
i=re:core.governance.reportengine;
i=str:std.str;
i=log:shared.log;

f=export(report:$report):str{
  if(str.eq(report.format;"csv")){
    <tocsv(report)
  }el{
    if(str.eq(report.format;"json")){
      <tojson(report)
    }el{
      <totext(report)
    }
  }
};

f=tocsv(report:$report):str{
  let out=mut."timestamp,category,detail,severity,value
";
  lp(let i=0;i<str.arraylen(report.rows);i=i+1){ let row=str.arrayget(report.rows;i);
    let line=str.concat(row.timestamp;str.concat(",";str.concat(row.category;str.concat(",";str.concat("\"";str.concat(row.detail;str.concat("\"";str.concat(",";str.concat(row.severity;str.concat(",";str.concat(row.value;"
")))))))))));
    out=str.concat(out;line)
  };
  log.info(str.concat("exported CSV report: ";str.fromint(report.rows.len));"report_export";"system");
  <out
};

f=tojson(report:$report):str{
  let out=str.concat("{\"title\":\"";str.concat(report.title;str.concat("\",\"type\":\"";str.concat(report.reporttype;str.concat("\",\"period_start\":\"";str.concat(report.periodstart;str.concat("\",\"period_end\":\"";str.concat(report.periodend;str.concat("\",\"summary\":\"";str.concat(report.summary;str.concat("\",\"row_count\":";str.concat(str.fromint(report.rows.len);"}"))))))))))));
  log.info(str.concat("exported JSON report: ";str.fromint(report.rows.len));"report_export";"system");
  <out
};

f=totext(report:$report):str{
  let out=mut.str.concat("= ";str.concat(report.title;" =
"));
  out=str.concat(out;str.concat("Period: ";str.concat(report.periodstart;str.concat(" to ";str.concat(report.periodend;"
")))));
  out=str.concat(out;str.concat("Summary: ";str.concat(report.summary;"

")));
  lp(let i=0;i<str.arraylen(report.rows);i=i+1){ let row=str.arrayget(report.rows;i);
    out=str.concat(out;str.concat("[";str.concat(row.severity;str.concat("] ";str.concat(row.timestamp;str.concat(" | ";str.concat(row.category;str.concat(": ";str.concat(row.detail;"
")))))))))
  };
  <out
};

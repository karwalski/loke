m=core.governance.external;

i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=json:std.json;

t=$integrationtype{
  $monitoring:i64;
  $incidentmanagement:i64;
  $reporting:i64;
  $siem:i64;
  $alerting:i64
};
t=$authmethod{
  $none:i64;
  $bearertoken:i64;
  $apikeyheader:i64;
  $basicauth:i64
};
t=$externalendpoint{
  id:str;
  name:str;
  integrationtype:str;
  url:str;
  authmethod:str;
  authtokenenv:str;
  authheadername:str;
  enabled:bool;
  retrycount:i64;
  timeoutms:i64;
  events:@str
};
t=$dispatchresult{
  endpointid:str;
  success:bool;
  statuscode:i64;
  error:str;
  latencyms:i64
};
t=$externalconfig{
  endpoints:@$externalendpoint;
  batchintervalms:i64;
  maxbatchsize:i64;
  failopen:bool
};
t=$governanceevent{
  eventtype:str;
  timestamp:str;
  severity:str;
  title:str;
  description:str;
  source:str;
  requestid:str;
  metadata:str
};

f=defaultconfig():$externalconfig{
  <$externalconfig{
    endpoints:@();
    batchintervalms:5000;
    maxbatchsize:100;
    failopen:true
  }
};
f=pagerduty(routingkeyenv:str):$externalendpoint{
  <$externalendpoint{
    id:"pagerduty";
    name:"PagerDuty";
    integrationtype:"incident_management";
    url:"https://events.pagerduty.com/v2/enqueue";
    authmethod:"none";
    authtokenenv:routingkeyenv;
    authheadername:"";
    enabled:true;
    retrycount:3;
    timeoutms:10000;
    events:@("incident.created";"incident.resolved";"violation.block";"kill_switch.engaged")
  }
};
f=datadog(apikeyenv:str):$externalendpoint{
  <$externalendpoint{
    id:"datadog";
    name:"Datadog";
    integrationtype:"monitoring";
    url:"https://api.datadoghq.com/api/v2/series";
    authmethod:"api_key_header";
    authtokenenv:apikeyenv;
    authheadername:"DD-API-KEY";
    enabled:true;
    retrycount:2;
    timeoutms:5000;
    events:@("metrics.pipeline";"metrics.tokens";"metrics.cost";"metrics.pii";"metrics.cache")
  }
};
f=grafana(pushurl:str;authtokenenv:str):$externalendpoint{
  <$externalendpoint{
    id:"grafana";
    name:"Grafana";
    integrationtype:"monitoring";
    url:pushurl;
    authmethod:"bearer_token";
    authtokenenv:authtokenenv;
    authheadername:"";
    enabled:true;
    retrycount:2;
    timeoutms:5000;
    events:@("metrics.pipeline";"metrics.tokens";"metrics.cost";"metrics.pii")
  }
};
f=splunk(hecurl:str;tokenenv:str):$externalendpoint{
  <$externalendpoint{
    id:"splunk";
    name:"Splunk HEC";
    integrationtype:"siem";
    url:hecurl;
    authmethod:"bearer_token";
    authtokenenv:tokenenv;
    authheadername:"";
    enabled:true;
    retrycount:3;
    timeoutms:10000;
    events:@("audit.all";"incident.all";"violation.all";"compliance.report")
  }
};
f=elastic(url:str;apikeyenv:str):$externalendpoint{
  <$externalendpoint{
    id:"elastic";
    name:"Elastic";
    integrationtype:"siem";
    url:url;
    authmethod:"api_key_header";
    authtokenenv:apikeyenv;
    authheadername:"Authorization";
    enabled:true;
    retrycount:2;
    timeoutms:5000;
    events:@("audit.all";"incident.all";"violation.all")
  }
};
f=slack(webhookurl:str):$externalendpoint{
  <$externalendpoint{
    id:"slack";
    name:"Slack";
    integrationtype:"alerting";
    url:webhookurl;
    authmethod:"none";
    authtokenenv:"";
    authheadername:"";
    enabled:true;
    retrycount:2;
    timeoutms:5000;
    events:@("incident.created";"violation.block";"kill_switch.engaged";"compliance.violation")
  }
};
f=teams(webhookurl:str):$externalendpoint{
  <$externalendpoint{
    id:"teams";
    name:"Microsoft Teams";
    integrationtype:"alerting";
    url:webhookurl;
    authmethod:"none";
    authtokenenv:"";
    authheadername:"";
    enabled:true;
    retrycount:2;
    timeoutms:5000;
    events:@("incident.created";"violation.block";"kill_switch.engaged")
  }
};
f=opsgenie(apikeyenv:str):$externalendpoint{
  <$externalendpoint{
    id:"opsgenie";
    name:"Opsgenie";
    integrationtype:"incident_management";
    url:"https://api.opsgenie.com/v2/alerts";
    authmethod:"api_key_header";
    authtokenenv:apikeyenv;
    authheadername:"Authorization";
    enabled:true;
    retrycount:3;
    timeoutms:10000;
    events:@("incident.created";"incident.resolved";"violation.block")
  }
};
f=servicenow(instanceurl:str;authtokenenv:str):$externalendpoint{
  <$externalendpoint{
    id:"servicenow";
    name:"ServiceNow";
    integrationtype:"incident_management";
    url:str.concat(instanceurl;"/api/now/table/incident");
    authmethod:"bearer_token";
    authtokenenv:authtokenenv;
    authheadername:"";
    enabled:true;
    retrycount:3;
    timeoutms:15000;
    events:@("incident.created";"incident.resolved";"compliance.report")
  }
};
f=webhook(id:str;name:str;url:str;authmethod:str;authtokenenv:str;events:@str):$externalendpoint{
  <$externalendpoint{
    id:id;
    name:name;
    integrationtype:"monitoring";
    url:url;
    authmethod:authmethod;
    authtokenenv:authtokenenv;
    authheadername:"Authorization";
    enabled:true;
    retrycount:2;
    timeoutms:5000;
    events:events
  }
};
f=dispatch(config:$externalconfig;event:$governanceevent):@$dispatchresult{
  let results=@();
  lp(let i=0;i<str.arraylen(config.endpoints);i=i+1){ let ep=str.arrayget(config.endpoints;i);
    if(ep.enabled){
      let subscribed=false;
      lp(let j=0;j<str.arraylen(ep.events);j=j+1){ let evt=str.arrayget(ep.events;j);
        if(str.eq(evt;event.eventtype)){subscribed=true}el{};
        if(str.contains(evt;".all")){
          let prefixparts=str.split(evt;".");
          let prefix=prefixparts.get(0);
          if(str.startswith(event.eventtype;prefix)){subscribed=true}el{}
        }el{};
        if(str.eq(evt;"audit.all")){subscribed=true}el{}
      };
      if(subscribed){
        let result=sendtoendpoint(ep;event);
        results=arr.push(results;result)
      }el{}
    }el{}
  };
  <results
};
f=sendtoendpoint(ep:$externalendpoint;event:$governanceevent):$dispatchresult{
  let payload=formatpayload(ep;event);
  let headers=buildauthheaders(ep);
  let attempt=mut.0;
  let lasterror=mut."";
  let laststatus=0;
  let done=false;
  let finalresult=$dispatchresult{endpointid:ep.id;success:false;statuscode:0;error:"";latencyms:0};

  lp(let lv=0;done=false;lv=lv){
    if(attempt>ep.retrycount){
      done=true
    }el{
      let httpok=mt http.post(ep.url;payload;headers) {
        $ok:resp true;
        $err:e false
      };
      if(httpok){
        finalresult=$dispatchresult{endpointid:ep.id;success:true;statuscode:200;error:"";latencyms:0};
        done=true
      }el{
        lasterror=str.concat("HTTP error dispatching to ";ep.name);
        attempt=attempt+1
      }
    }
  };
  <finalresult
};
f=formatpayload(ep:$externalendpoint;event:$governanceevent):str{
  if(str.eq(ep.id;"pagerduty")){
    <formatpagerduty(ep;event)
  }el{
    if(str.eq(ep.id;"slack")){
      <formatslack(event)
    }el{
      if(str.eq(ep.id;"teams")){
        <formatteams(event)
      }el{
        if(str.eq(ep.id;"datadog")){
          <formatdatadog(event)
        }el{
          <formatgeneric(event)
        }
      }
    }
  }
};
f=formatpagerduty(ep:$externalendpoint;event:$governanceevent):str{
  let severity=mut."info";
  if(str.eq(event.severity;"P0")){severity="critical"}el{
    if(str.eq(event.severity;"P1")){severity="error"}el{
      if(str.eq(event.severity;"P2")){severity="warning"}el{}
    }
  };
  <str.concat("{\"routing_key\":\"";str.concat(ep.authtokenenv;
    str.concat("\",\"event_action\":\"trigger\",\"payload\":{\"summary\":\"";str.concat(event.title;
    str.concat("\",\"severity\":\"";str.concat(severity;
    str.concat("\",\"source\":\"loke\",\"component\":\"";str.concat(event.source;
    str.concat("\",\"custom_details\":{\"description\":\"";str.concat(event.description;
    str.concat("\",\"request_id\":\"";str.concat(event.requestid;
    "\"}}}"))))))))))))
};

f=formatslack(event:$governanceevent):str{
  let emoji=mut.":informationsource:";
  if(str.eq(event.severity;"P0")){emoji=":rotatinglight:"}el{
    if(str.eq(event.severity;"P1")){emoji=":warning:"}el{}
  };
  <str.concat("{\"text\":\"";str.concat(emoji;str.concat(" *";str.concat(event.title;
    str.concat("*\nSeverity: ";str.concat(event.severity;
    str.concat("\nSource: ";str.concat(event.source;
    str.concat("\n";str.concat(event.description;
    "\"}"))))))))))
};
f=formatteams(event:$governanceevent):str{
  let themecolor=mut."FFA500";
  if(str.eq(event.severity;"P0")){themecolor="FF0000"}el{};
  <str.concat("{\"@type\":\"MessageCard\",\"summary\":\"";str.concat(event.title;
    str.concat("\",\"themeColor\":\"";str.concat(themecolor;
    str.concat("\",\"title\":\"loke: ";str.concat(event.title;
    str.concat("\",\"text\":\"";str.concat(event.description;
    str.concat("\n\nSeverity: ";str.concat(event.severity;
    str.concat(" | Source: ";str.concat(event.source;
    "\"}"))))))))))))
};

f=formatdatadog(event:$governanceevent):str{
  <str.concat("{\"series\":[{\"metric\":\"loke.governance.";str.concat(str.replace(event.eventtype;".";"_");
    str.concat("\",\"type\":0,\"points\":[[";str.concat(event.timestamp;
    str.concat(",1]],\"tags\":[\"severity:";str.concat(event.severity;
    str.concat("\",\"source:";str.concat(event.source;
    "\"]}]}"))))))))
};
f=formatgeneric(event:$governanceevent):str{
  <str.concat("{\"event_type\":\"";str.concat(event.eventtype;
    str.concat("\",\"timestamp\":\"";str.concat(event.timestamp;
    str.concat("\",\"severity\":\"";str.concat(event.severity;
    str.concat("\",\"title\":\"";str.concat(event.title;
    str.concat("\",\"description\":\"";str.concat(event.description;
    str.concat("\",\"source\":\"";str.concat(event.source;
    str.concat("\",\"request_id\":\"";str.concat(event.requestid;
    str.concat("\",\"metadata\":";str.concat(event.metadata;
    "}")))))))))))))))
  )
};
f=buildauthheaders(ep:$externalendpoint):str{
  if(str.eq(ep.authmethod;"bearer_token")){
    <str.concat("Authorization: Bearer ";ep.authtokenenv)
  }el{
    if(str.eq(ep.authmethod;"api_key_header")){
      <str.concat(ep.authheadername;str.concat(": ";ep.authtokenenv))
    }el{
      <"Content-Type: application/json"
    }
  }
};
f=dispatchincident(config:$externalconfig;severity:str;title:str;description:str;requestid:str):@$dispatchresult{
  <dispatch(config;$governanceevent{
    eventtype:"incident.created";
    timestamp:"";
    severity:severity;
    title:title;
    description:description;
    source:"governance.incidents";
    requestid:requestid;
    metadata:"{}"
  })
};
f=dispatchviolation(config:$externalconfig;severity:str;violationtype:str;description:str;requestid:str):@$dispatchresult{
  <dispatch(config;$governanceevent{
    eventtype:str.concat("violation.";violationtype);
    timestamp:"";
    severity:severity;
    title:str.concat("Governance violation: ";violationtype);
    description:description;
    source:"governance.compliance";
    requestid:requestid;
    metadata:"{}"
  })
};
f=dispatchkillswitch(config:$externalconfig;engaged:bool;scope:str):@$dispatchresult{
  let action=mut."released";
  if(engaged){action="engaged"}el{};
  let kseverity=mut."P3";
  if(engaged){kseverity="P1"}el{};
  <dispatch(config;$governanceevent{
    eventtype:str.concat("kill_switch.";action);
    timestamp:"";
    severity:kseverity;
    title:str.concat("Kill switch ";action);
    description:str.concat("Kill switch ";str.concat(action;str.concat(" for scope: ";scope)));
    source:"governance.kill_switch";
    requestid:"";
    metadata:"{}"
  })
};
f=dispatchreport(config:$externalconfig;reporttype:str;summary:str):@$dispatchresult{
  <dispatch(config;$governanceevent{
    eventtype:"compliance.report";
    timestamp:"";
    severity:"P3";
    title:str.concat("Compliance report: ";reporttype);
    description:summary;
    source:"governance.reporting";
    requestid:"";
    metadata:"{}"
  })
};
f=dispatchmetrics(config:$externalconfig;metrictype:str;value:str):@$dispatchresult{
  <dispatch(config;$governanceevent{
    eventtype:str.concat("metrics.";metrictype);
    timestamp:"";
    severity:"P3";
    title:str.concat("Metric: ";metrictype);
    description:value;
    source:"governance.metrics";
    requestid:"";
    metadata:value
  })
};
f=configtojson(config:$externalconfig):str{
  let eps=@();
  lp(let i=0;i<str.arraylen(config.endpoints);i=i+1){ let ep=str.arrayget(config.endpoints;i);
    let enabledstr=mut."false";
    if(ep.enabled){enabledstr="true"}el{};
    let epjson=str.concat("{\"id\":\"";str.concat(ep.id;
      str.concat("\",\"name\":\"";str.concat(ep.name;
      str.concat("\",\"type\":\"";str.concat(ep.integrationtype;
      str.concat("\",\"url\":\"";str.concat(ep.url;
      str.concat("\",\"enabled\":";str.concat(enabledstr;
      str.concat(",\"events\":";str.concat(str.fromint(ep.events.len);
      "}"))))))))))));
    eps=eps.push(epjson)
  };
  <str.concat("[";str.concat(str.join(eps;",");"]"))
};

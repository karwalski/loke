
m=core.governance.responsescanner;
i=vt:core.governance.violationtypes;
i=privacy:core.privacy.pipeline;
i=str:std.str;
i=log:shared.log;

f=scanresponse(rawresponse:str;restoredresponse:str;requestid:str;blockedentities:@str):$scanresult{
  let violations=mut.@($violation);

  let previolations=scanforpiileakage(rawresponse;requestid);
  lp(let i=0;i<str.arraylen(previolations);i=i+1){ let v=str.arrayget(previolations;i);
    violations=@.push(violations;v)
  };

  let postviolations=scanagainstpolicy(restoredresponse;requestid;blockedentities);
  lp(let i=0;i<str.arraylen(postviolations);i=i+1){ let v=str.arrayget(postviolations;i);
    violations=@.push(violations;v)
  };

  let requiresconf=false;
  lp(let i=0;i<str.arraylen(violations);i=i+1){ let v=str.arrayget(violations;i);
    if(str.eq(v.severity;"WARNING")){requiresconf=true}el{};
    if(str.eq(v.severity;"BLOCK")){requiresconf=true}el{}
  };

  let count=violations.len;
  if(count>0){
    log.warn(str.concat("response scan found ";str.concat(str.fromint(count);" violations"));"response_scanner";"compliance")
  }el{
    log.info("response scan clean";"response_scanner";"compliance")
  };

  <$scanresult{
    violations:violations;
    scannedat:0;
    requestid:requestid;
    requiresconfirmation:requiresconf
  }
};

f=scanforpiileakage(text:str;requestid:str):@$violation{
  let violations=@($violation);
  if(str.contains(text;"@")){
    if(str.contains(text;".com")){
      violations=@.push(violations;$violation{
        id:str.concat("pii-leak-email-";requestid);
        violationtype:"pii_in_response";
        severity:"WARNING";
        description:"Possible email address detected in LLM response";
        entitytype:"email";
        sourcestage:"response_scan";
        requestid:requestid;
        suppressed:false
      })
    }el{};
  }el{};
  <violations
};

f=scanagainstpolicy(text:str;requestid:str;blockedentities:@str):@$violation{
  let violations=@($violation);
  lp(let i=0;i<str.arraylen(blockedentities);i=i+1){ let entity=str.arrayget(blockedentities;i);
    if(str.contains(text;entity)){
      violations=@.push(violations;$violation{
        id:str.concat("policy-";str.concat(entity;str.concat("-";requestid)));
        violationtype:"blocked_entity_detected";
        severity:"BLOCK";
        description:str.concat("Blocked entity type detected in response: ";entity);
        entitytype:entity;
        sourcestage:"response_scan";
        requestid:requestid;
        suppressed:false
      })
    }el{}
  };
  <violations
};

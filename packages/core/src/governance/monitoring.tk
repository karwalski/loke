m=core.governance.monitoring;




i=t:shared.types;
i=s:core.storage.db;
i=db:std.db;
i=str:std.str;
i=log:shared.log;

t=$qualitysignal{
  requestid:str;
  modelid:str;
  provider:str;
  usecase:str;
  thumbsup:bool;
  coherencescore:f64;
  relevancescore:f64
};

t=$qualitytrend{
  modelid:str;
  perioddays:u32;
  thumbsuprate:f64;
  avgcoherence:f64;
  avgrelevance:f64;
  totalsignals:u32;
  degradationdetected:bool
};


f=ensuretable(store:i64):void|$lokeerr{
  let sql="CREATE TABLE IF NOT EXISTS quality_signals (
  id TEXT PRIMARY KEY,
  request_id TEXT NOT NULL,
  model_id TEXT NOT NULL,
  provider TEXT NOT NULL,
  use_case TEXT NOT NULL,
  thumbs_up INTEGER NOT NULL DEFAULT 0,
  coherence_score REAL,
  relevance_score REAL,
  created_at TEXT NOT NULL
)";
  mt db.execparams(store.conn;sql;@()) {
    $ok: <$ok(void);
    $err:e <$err($lokeerr.$storageerr("failed to create quality_signals table"))
  };
};


f=recordsignal(store:i64;signal:$qualitysignal):void|$lokeerr{
  let id=str.randhex(16);
  let thumbsups=if signal.thumbsup{ "1" }el{ "0" };
  let coherences=str.fromfloat(signal.coherencescore);
  let relevances=str.fromfloat(signal.relevancescore);
  mt db.execparams(
    store.conn;
    "INSERT INTO quality_signals (id,request_id,model_id,provider,use_case,thumbs_up,coherence_score,relevance_score,created_at) VALUES (?,?,?,?,?,?,?,?,'now()')";
    @(
      id;
      signal.requestid;
      signal.modelid;
      signal.provider;
      signal.usecase;
      thumbsups;
      coherences;
      relevances
    )
  ) {
    $ok: {
      log.debug(
        str.concat("quality signal recorded for model: ";signal.modelid);
        "monitoring";
        signal.requestid
      );
      <$ok(void)
    };
    $err:e <$err($lokeerr.$storageerr(str.concat("failed to record quality signal for: ";signal.modelid)))
  };
};



f=computetrend(store:i64;modelid:str;days:u32):$qualitytrend|$lokeerr{
  let dayss=str.fromint(days);
  let sql=str.concat(
    "SELECT thumbs_up,coherence_score,relevance_score FROM quality_signals WHERE model_id=? AND created_at >= datetime('now','-";
    str.concat(dayss;" days')")
  );
  mt db.queryparams(store.conn;sql;@$modelid) {
    $ok:rows {
      let total=rows.len;
      if(total = 0){
        <$ok($qualitytrend{
          modelid:modelid;
          perioddays:days;
          thumbsuprate:0.0;
          avgcoherence:0.0;
          avgrelevance:0.0;
          totalsignals:0;
          degradationdetected:false
        })
      }el{
        let thumbsupcount=0;
        let coherencesum=0.0;
        let relevancesum=0.0;
        rows.each|row{
          let tu=json.getint(row;"thumbs_up");
          if(tu = 1){
            thumbsupcount=thumbsupcount+1
          }el{};
          coherencesum=coherencesum+json.getfloat(row;"coherence_score");
          relevancesum=relevancesum+json.getfloat(row;"relevance_score")
        };
        let totalf=str.tofloat(str.fromint(total));
        let thumbsupcountf=str.tofloat(str.fromint(thumbsupcount));
        let rate=thumbsupcountf/totalf;
        let avgcoh=coherencesum/totalf;
        let avgrel=relevancesum/totalf;
        let degraded=if total > 10{
          rate < 0.7
        }el{
          false
        };
        log.debug(
          str.concat("trend computed for model: ";modelid);
          "monitoring";
          "system"
        );
        <$ok($qualitytrend{
          modelid:modelid;
          perioddays:days;
          thumbsuprate:rate;
          avgcoherence:avgcoh;
          avgrelevance:avgrel;
          totalsignals:total;
          degradationdetected:degraded
        })
      };
    };
    $err:e <$err($lokeerr.$storageerr(str.concat("failed to compute trend for model: ";modelid)))
  };
};


f=thumbsdownrate(store:i64;modelid:str;days:u32):f64|$lokeerr{
  mt computetrend(store;modelid;days) {
    $ok:trend {
      if(trend.totalsignals = 0){
        <$ok(0.0)
      }el{
        <$ok(1.0-trend.thumbsuprate)
      };
    };
    $err:e <$err(e)
  };
};


f=pctstr(v:f64):str{
  let pct=v*100.0;
  str.concat(str.fromfloat(pct);"%")
};


f=padright(s:str;width:u32):str{
  let len=str.len(s);
  if(len > width){
    <s
  }el{
    let diff=width-len;
    let spaces="                    ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  };
};







f=formatqualityreport(trends:@$qualitytrend):str{
  let header="Quality Report
==============
";
  let body="";
  trends.each|trend{
    let prefix=if trend.degradationdetected{
      "[DEGRADED] "
    }el{
      ""
    };
    let name=str.concat(prefix;trend.modelid);
    let namepadded=padright(name;22);
    let rates=pctstr(trend.thumbsuprate);
    let cohs=str.fromfloat(trend.avgcoherence);
    let rels=str.fromfloat(trend.avgrelevance);
    let totals=str.fromint(trend.totalsignals);
    let line=if trend.degradationdetected{
      str.concat(
        str.concat(
          str.concat(
            str.concat(namepadded;"thumbs-up: ");
            rates);
          "  <- below threshold
");
        "")
    }el{
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(namepadded;"thumbs-up: ");
                      rates);
                    "  coherence: ");
                  cohs);
                "  relevance: ");
              rels);
            "  (");
          totals);
        " signals)
")
    };
    body=str.concat(body;line)
  };
  <str.concat(header;body)
};

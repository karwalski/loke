m=core.governance.monitoring;

i=s:core.storage.db;
i=db:std.db;
i=str:std.str;
i=t:shared.types;

t=$qualitysignal{
  requestid:str;
  modelid:str;
  provider:str;
  usecase:str;
  thumbsup:bool;
  coherencescore:f64;
  relevancescore:f64
};

t=$qualitytrend{
  modelid:str;
  perioddays:u32;
  thumbsuprate:f64;
  avgcoherence:f64;
  avgrelevance:f64;
  totalsignals:u32;
  degradationdetected:bool
};


(* Declared i64!$lokeerr, not void!$lokeerr, and returns $ok(0).

   toke lowers a `void!$err` success type to LLVM `void`, so any call site that binds
   the result — a match arm, for instance — emits `alloca void` and clang rejects the
   module with "void type only allowed for function results". Filed as T-5 in
   docs/upstream/toke-issues.md, same family as T-1 ($ok(<bool>)): only an i64-width
   success type survives the `!$err` lowering today. *)
f=ensuretable(store:i64):i64!$lokeerr{
  let sql="CREATE TABLE IF NOT EXISTS quality_signals (
  id TEXT PRIMARY KEY,
  request_id TEXT NOT NULL,
  model_id TEXT NOT NULL,
  provider TEXT NOT NULL,
  use_case TEXT NOT NULL,
  thumbs_up INTEGER NOT NULL DEFAULT 0,
  coherence_score REAL,
  relevance_score REAL,
  created_at TEXT NOT NULL
)";
  <mt db.exec(sql;@()) {
    $ok:v $ok(0);
    $err:e $err($storageerr("failed to create quality_signals table"))
  }
};


f=recordsignal(store:i64;signal:$qualitysignal):i64!$lokeerr{
  let id=str.randhex(16);
  let thumbsups=mut."0";
  if(signal.thumbsup){ thumbsups="1" }el{};
  let coherences=str.fromfloat(signal.coherencescore);
  let relevances=str.fromfloat(signal.relevancescore);
  (* `datetime('now')`, not `'now()'`. GA5.1 in a fifth place, and by a third mechanism: not a
     bound parameter this time but a QUOTED SQL STRING inside the statement, so SQLite stored
     the five characters now() rather than calling anything.

     The consequence was not merely a wrong column. `trend` at line 124 filters
     `created_at >= datetime('now','-N days')`, comparing a TEXT column whose every value was
     the literal `now()` against a real ISO-8601 timestamp — and `'now()'` is never >= a
     digit-leading string, so **every trend window returned nothing**, for every model, always.
     `tests/unit/governance/test_monitoring.tk` characterised the stored literal as an expected
     value, so the defect was asserted green; that assertion is inverted in the same commit. *)
  <mt db.exec("INSERT INTO quality_signals (id,request_id,model_id,provider,use_case,thumbs_up,coherence_score,relevance_score,created_at) VALUES (?,?,?,?,?,?,?,?,datetime('now'))";@(id;signal.requestid;signal.modelid;signal.provider;signal.usecase;thumbsups;coherences;relevances)) {
    $ok:v $ok(0);
    $err:e $err($storageerr(str.concat("failed to record quality signal for: ";signal.modelid)))
  }
};



f=buildtrend(rows:@$row;modelid:str;days:u32):$qualitytrend{
  let total=rows.len;
  if(total == 0){
    <$qualitytrend{
      modelid:modelid;
      perioddays:days;
      thumbsuprate:0.0;
      avgcoherence:0.0;
      avgrelevance:0.0;
      totalsignals:0;
      degradationdetected:false
    }
  }el{
    let thumbsupcount=mut.0;
    let coherencesum=mut.0.0;
    let relevancesum=mut.0.0;
    lp(let ii91=0;ii91<rows.len;ii91=ii91+1){
      let row:$row=rows.get(ii91);
      let tu=db.rowi64(row;"thumbs_up");
      if(tu == 1){
        thumbsupcount=thumbsupcount+1
      }el{};
      coherencesum=coherencesum+((s.rowf64hundredths(row;"coherence_score") as f64) / 100.0);
      relevancesum=relevancesum+((s.rowf64hundredths(row;"relevance_score") as f64) / 100.0)

    };
    let totalf=str.tofloat(str.fromint(total));
    let thumbsupcountf=str.tofloat(str.fromint(thumbsupcount));
    let rate=thumbsupcountf/totalf;
    let avgcoh=coherencesum/totalf;
    let avgrel=relevancesum/totalf;
    let degraded=mut.false;
    if(total > 10){
      degraded=rate < 0.7
    }el{};
    <$qualitytrend{
      modelid:modelid;
      perioddays:days;
      thumbsuprate:rate;
      avgcoherence:avgcoh;
      avgrelevance:avgrel;
      totalsignals:total as u32;
      degradationdetected:degraded
    }
  };
};

(* GA5.17. A row whose created_at is not an ISO-8601 timestamp is excluded from the window.

   This is NOT the defect the story row describes, and the difference matters. The row says
   this comparison is "epoch-ms against ISO, the same comparison that made every governance
   report window match nothing". It is not: quality_signals.created_at has always been TEXT
   and, since the writer was fixed, always holds datetime('now') output. ISO-8601 sorts
   lexicographically, so ISO >= ISO is a correct window and needs no conversion helper.

   What the row missed is the residual, and it runs the OTHER WAY. Before the writer was
   fixed every row stored the five characters now(). Lexicographically 'n' is 0x6E and '2'
   is 0x32, so "now()" is greater than any ISO date this century — those rows satisfy
   `created_at >= <any bound>` and appear in EVERY window, for ever, with a timestamp that
   means nothing. A defect that admits stale rows to every period is quieter than one that
   admits none, because the figures still look plausible.

   `LIKE '____-__-__%'` rather than a date function: it is a shape test on four digits, a
   dash, two, a dash, two, which "now()" fails and every datetime('now') value passes, and
   it needs no agreement about representation with anything else. Underscore is LIKE's
   single-character wildcard, so this is nine positions checked, not a literal match. *)
f=computetrend(store:i64;modelid:str;days:u32):$qualitytrend!$lokeerr{
  let dayss=str.fromint(days);
  let sql="SELECT thumbs_up,coherence_score,relevance_score FROM quality_signals WHERE model_id=? AND created_at LIKE '____-__-__%' AND created_at >= datetime('now','-\(dayss) days')";
  <mt db.many(sql;@(modelid)) {
    $ok:rows $ok(buildtrend(rows;modelid;days));
    $err:e $err($storageerr(str.concat("failed to compute trend for model: ";modelid)))
  }
};


f=thumbsdownrate(store:i64;modelid:str;days:u32):f64!$lokeerr{
  let tresult=computetrend(store;modelid;days);
  let trend=mt tresult {
    $ok:trend trend;
    $err:e $err(e)
  };
  let rate=mut.0.0;
  if(!(trend.totalsignals == 0)){ rate=1.0-trend.thumbsuprate }el{};
  <rate
};


f=pctstr(v:f64):str{
  <str.concat(str.fromfloat(v*100.0);"%")
};









f=formatqualityreport(trends:@$qualitytrend):str{
  let header="Quality Report
==============
";
  let body=mut."";
  lp(let ii172=0;ii172<trends.len;ii172=ii172+1){
    let trend=trends.get(ii172);
    let prefix=mut."";
    if(trend.degradationdetected){
      prefix="[DEGRADED] "
    }el{};
    let name=str.concat(prefix;trend.modelid);
    let namepadded=t.strpad(name;22);
    let rates=str.concat(str.fromfloat(trend.thumbsuprate*100.0);"%");
    let cohs=str.fromfloat(trend.avgcoherence);
    let rels=str.fromfloat(trend.avgrelevance);
    let totals=str.fromint(trend.totalsignals as i64);
    let line=mut."\(namepadded)thumbs-up: \(rates)  coherence: \(cohs)  relevance: \(rels)  (\(totals) signals)\n";
    if(trend.degradationdetected){
      line="\(namepadded)thumbs-up: \(rates)  <- below threshold\n"
    }el{};
    body=str.concat(body;line)

  };
  <str.concat(header;body)
};

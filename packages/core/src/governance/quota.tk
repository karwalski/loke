m=core.governance.quota;





i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=time:std.time;

t=$quotarule{
  id:str;
  scope:str;
  limittokens:i64;
  limitcostusd:f32;
  period:str
};

t=$quotastatus{
  ruleid:str;
  usedtokens:i64;
  usedcost:f32;
  remainingpct:f32;
  exceeded:bool
};


f=ensuretables(store:i64):bool{
  let sqlrules="CREATE TABLE IF NOT EXISTS quota_rules (
  id TEXT PRIMARY KEY,
  scope TEXT NOT NULL,
  limit_tokens INTEGER NOT NULL DEFAULT 0,
  limit_cost_usd REAL NOT NULL DEFAULT 0.0,
  period TEXT NOT NULL
)";
  let sqlusage="CREATE TABLE IF NOT EXISTS quota_usage (
  id TEXT PRIMARY KEY,
  rule_id TEXT NOT NULL,
  scope TEXT NOT NULL,
  period_key TEXT NOT NULL,
  used_tokens INTEGER NOT NULL DEFAULT 0,
  used_cost_usd REAL NOT NULL DEFAULT 0.0,
  UNIQUE(rule_id, period_key)
)";
  mt db.execparams(store.conn;sqlrules;@()) {
    $ok: {};
    $err:e {
      log.warn("failed to create quota_rules table";"quota";"system");
      <false
    };
  };
  mt db.execparams(store.conn;sqlusage;@()) {
    $ok: <true;
    $err:e {
      log.warn("failed to create quota_usage table";"quota";"system");
      <false
    };
  };
};






f=periodkey(period:str):str{
  if(period="daily"){
    <time.formatnow("%Y-%m-%d")
  }else{
    if(period="weekly"){
      <time.formatnow("%Y-W%V")
    }else{
      if(period="monthly"){
        <time.formatnow("%Y-%m")
      }else{
        <"all-time"
      };
    };
  };
};



f=findrule(store:i64;scope:str):$quotarule{
  mt db.queryparams(
    store.conn;
    "SELECT id,scope,limit_tokens,limit_cost_usd,period FROM quota_rules WHERE scope=? LIMIT 1";
    @$scope
  ) {
    $ok:rows {
      if(rows.len=0){
        <$quotarule{
          id:"";
          scope:scope;
          limittokens:0;
          limitcostusd:0.0;
          period:""
        };
      }else{
        let row=rows.get(0);
        <$quotarule{
          id:json.getstr(row;"id");
          scope:json.getstr(row;"scope");
          limittokens:json.getint(row;"limit_tokens");
          limitcostusd:json.getfloat(row;"limit_cost_usd");
          period:json.getstr(row;"period")
        };
      };
    };
    $err:e {
      log.warn(str.concat("failed to find quota rule for scope: ";scope);"quota";"system");
      <$quotarule{
        id:"";
        scope:scope;
        limittokens:0;
        limitcostusd:0.0;
        period:""
      };
    };
  };
};




f=check(store:i64;scope:str;tokens:i64;cost:f32):$quotastatus{
  let rule=findrule(store;scope);
  if(rule.id=""){
    <$quotastatus{
      ruleid:"";
      usedtokens:0;
      usedcost:0.0;
      remainingpct:100.0;
      exceeded:false
    };
  }else{
    let pk=periodkey(rule.period);
    mt db.queryparams(
      store.conn;
      "SELECT used_tokens,used_cost_usd FROM quota_usage WHERE rule_id=? AND period_key=? LIMIT 1";
      @(rule.id;pk)
    ) {
      $ok:rows {
        let usedtokens=if rows.len=0{
          0
        }else{
          json.getint(rows.get(0);"used_tokens")
        };
        let usedcost=if rows.len=0{
          0.0
        }else{
          json.getfloat(rows.get(0);"used_cost_usd")
        };
        let tokenpct=if rule.limittokens>0{
          let usedf=str.tofloat(str.fromint(usedtokens));
          let limitf=str.tofloat(str.fromint(rule.limittokens));
          (1.0-(usedf/limitf))*100.0
        }else{
          100.0
        };
        let costpct=if rule.limitcostusd>0.0{
          ((rule.limitcostusd-usedcost)/rule.limitcostusd)*100.0
        }else{
          100.0
        };
        let remainingpct=if tokenpct<costpct{ tokenpct }else{ costpct };
        let exceeded=remainingpct<=0.0;
        <$quotastatus{
          ruleid:rule.id;
          usedtokens:usedtokens;
          usedcost:usedcost;
          remainingpct:remainingpct;
          exceeded:exceeded
        };
      };
      $err:e {
        log.warn(str.concat("failed to query quota usage for scope: ";scope);"quota";"system");
        <$quotastatus{
          ruleid:rule.id;
          usedtokens:0;
          usedcost:0.0;
          remainingpct:100.0;
          exceeded:false
        };
      };
    };
  };
};




f=recordusage(store:i64;scope:str;tokens:i64;cost:f32):bool{
  let rule=findrule(store;scope);
  if(rule.id=""){
    <false
  }else{
    let pk=periodkey(rule.period);
    let id=str.randhex(16);
    let tokenss=str.fromint(tokens);
    let costs=str.fromfloat(cost);
    mt db.execparams(
      store.conn;
      "INSERT INTO quota_usage (id,rule_id,scope,period_key,used_tokens,used_cost_usd)
       VALUES (?,?,?,?,?,?)
       ON CONFLICT(rule_id,period_key) DO UPDATE SET
         used_tokens=used_tokens+excluded.used_tokens,
         used_cost_usd=used_cost_usd+excluded.used_cost_usd";
      @(id;rule.id;scope;pk;tokenss;costs)
    ) {
      $ok: {
        log.debug(
          str.concat(str.concat("quota usage recorded scope=";scope);str.concat(" tokens=";tokenss));
          "quota";
          "system"
        );
        <true
      };
      $err:e {
        log.warn(str.concat("failed to record quota usage for scope: ";scope);"quota";"system");
        <false
      };
    };
  };
};



f=setrule(store:i64;rule:$quotarule):bool{
  let tokenss=str.fromint(rule.limittokens);
  let costs=str.fromfloat(rule.limitcostusd);
  mt db.execparams(
    store.conn;
    "INSERT INTO quota_rules (id,scope,limit_tokens,limit_cost_usd,period)
     VALUES (?,?,?,?,?)
     ON CONFLICT(id) DO UPDATE SET
       scope=excluded.scope,
       limit_tokens=excluded.limit_tokens,
       limit_cost_usd=excluded.limit_cost_usd,
       period=excluded.period";
    @(rule.id;rule.scope;tokenss;costs;rule.period)
  ) {
    $ok: {
      log.info(str.concat("quota rule saved: ";rule.id);"quota";"system");
      <true
    };
    $err:e {
      log.warn(str.concat("failed to save quota rule: ";rule.id);"quota";"system");
      <false
    };
  };
};


f=listrules(store:i64):@$quotarule{
  mt db.queryparams(
    store.conn;
    "SELECT id,scope,limit_tokens,limit_cost_usd,period FROM quota_rules ORDER BY scope";
    @()
  ) {
    $ok:rows {
      <rows.map|row{
        $quotarule{
          id:json.getstr(row;"id");
          scope:json.getstr(row;"scope");
          limittokens:json.getint(row;"limit_tokens");
          limitcostusd:json.getfloat(row;"limit_cost_usd");
          period:json.getstr(row;"period")
        };
      };
    };
    $err:e {
      log.warn("failed to list quota rules";"quota";"system");
      <@()
    };
  };
};

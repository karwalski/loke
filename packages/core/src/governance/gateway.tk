m=core.governance.gateway;

i=t:shared.types;
i=gt:core.governance.types;
i=uc:core.governance.usecases;
i=pol:core.governance.policy;
i=log:shared.log;
i=str:std.str;

t=$gateway{
  registry:i64;
  killswitchactive:bool;
  killswitchreason:str
};


f=new():$gateway{
  let registry=uc.newregistry();
  <$gateway{
    registry:registry;
    killswitchactive:false;
    killswitchreason:""
  }
};


f=defaultrouting():$routingdecision{
  let spec=$modelspec{
    id:"";
    provider:$local;
    contextwindow:0;
    costper1kinput:0.0;
    costper1koutput:0.0;
    tier:$interactive
  };
  <$routingdecision{
    model:spec;
    reason:"pending";
    tier:$interactive;
    estimatedcost:0.0;
    estimatedlatencyms:0
  }
};












f=submit(gw:$gateway;req:i64):i64!$lokeerr{
  if(gw.killswitchactive){
    let reason=str.concat("Kill switch active: ";gw.killswitchreason);
    let decision=$gatewaydecision{
      requestid:req.requestid;
      policydecision:$deny(reason);
      risktier:$high;
      routing:defaultrouting();
      controlsapplied:@("kill-switch");
      explanation:reason;
      timestamp:str.nowiso8601()
    };
    log.error(str.concat("gateway deny -- ";reason);"gateway";req.correlationid);
    <decision
  }el{
    <submitinner(gw;req)
  }
};

f=submitinner(gw:$gateway;req:i64):i64!$lokeerr{
  let usecaseresult=uc.find(gw.registry;req.usecaseid);
  let founduc=mt usecaseresult {
    $ok:v v;
    $err:e {
      let denymsg=str.concat("Unknown use case: ";req.usecaseid);
      let decision=$gatewaydecision{
        requestid:req.requestid;
        policydecision:$deny(denymsg);
        risktier:$high;
        routing:defaultrouting();
        controlsapplied:@("audit-logging");
        explanation:denymsg;
        timestamp:str.nowiso8601()
      };
      log.error(str.concat("gateway deny -- ";denymsg);"gateway";req.correlationid);
      <decision
    }
  };
  let usecaserisk=founduc.risklevel;
  let risk=pol.classifyrisk(req.sensitivity;usecaserisk;req.estimatedcost);
  let policy=pol.evaluate(risk;req.sensitivity;req.modelid;req.usecaseid);
  let controls=pol.controlsforrisk(risk;req.sensitivity);
  let riskstr=gt.risklabel(risk);
  let decisionstr=gt.decisionlabel(policy);
  let logmsg=str.concat(
    str.concat(
      str.concat(
        str.concat("gateway ";decisionstr);
        " use_case=");
      req.usecaseid);
    str.concat(" risk=";riskstr));
  mt policy {
    $allow;
      log.info(logmsg;"gateway";req.correlationid);
    $allowwithwarning:warning;
      log.warn(logmsg;"gateway";req.correlationid);
    $requireapproval:msg;
      log.warn(logmsg;"gateway";req.correlationid);
    $deny:msg;
      log.error(logmsg;"gateway";req.correlationid)
  };
  let explanation=mt policy {
    $allow;                  "Request approved";
    $allowwithwarning:w;   w;
    $requireapproval:msg;   msg;
    $deny:msg;               msg
  };
  let decision=$gatewaydecision{
    requestid:req.requestid;
    policydecision:policy;
    risktier:risk;
    routing:defaultrouting();
    controlsapplied:controls;
    explanation:explanation;
    timestamp:str.nowiso8601()
  };
  <decision
};


f=activatekillswitch(gw:$gateway;reason:str):void{
  gw.killswitchactive=true;
  gw.killswitchreason=reason;
  log.error(str.concat("kill switch activated: ";reason);"gateway";"system")
};


f=deactivatekillswitch(gw:$gateway):void{
  gw.killswitchactive=false;
  gw.killswitchreason="";
  log.info("kill switch deactivated";"gateway";"system")
};


f=isblocked(decision:i64):bool{
  mt decision.policydecision {
    $allow;                  <false;
    $allowwithwarning:msg; <false;
    $requireapproval:msg;   <true;
    $deny:msg;               <true
  }
};

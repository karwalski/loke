m=core.governance.gateway;

i=gt:core.governance.types;
i=uc:core.governance.usecases;
i=pol:core.governance.policy;
i=log:shared.log;
i=str:std.str;
i=t:shared.types;

t=$gateway{
  registry:i64;
  killswitchactive:bool;
  killswitchreason:str
};


f=new():$gateway{
  let registry=uc.newregistry();
  <$gateway{
    registry:registry;
    killswitchactive:false;
    killswitchreason:""
  }
};


f=defaultrouting():$routingdecision{
  let spec=$modelspec{
    id:"";
    provider:$provider{$local:0};
    contextwindow:0;
    costper1kinput:0.0;
    costper1koutput:0.0;
    tier:$modeltier{$interactive:0}
  };
  <$routingdecision{
    model:spec;
    reason:"pending";
    tier:$modeltier{$interactive:0};
    estimatedcost:0.0;
    estimatedlatencyms:0
  }
};












(* LS1.1j — trysubmit is the gateway's plain form, and the only one.

   submit, submitinner and submitinnerwithuc returned $gatewaydecision!$lokeerr. None of
   them ever returned an $err — every path builds a decision — so the result type added
   nothing but the hazard, and the one real failure inside them was unreachable:
   submitinner matched uc.find's result, and toke takes the FIRST arm of a match on a
   result with a user-declared error side whatever the value is (T-18). An unknown use case
   therefore took the $ok arm with the error payload bound as the use case, and the DENY
   written for it in submitinnerunknownuc never ran. On top of that, submitinnerwithuc took
   the use case as a bare i64 and passed its integer risklevel where policy.classifyrisk
   wants a $risktier, so a KNOWN use case segfaulted (tests/unit/governance/test_gateway.tk,
   Finding 1). Nothing called any of them.

   The outcome a caller acts on is isblocked(decision). An unknown use case is the
   gateway's failure path and it is fail-closed: DENY at HIGH risk, which isblocked reads
   as blocked. The use-case lookup goes through uc.findor and uc.isusecase, whose sentinel
   is an empty id, and the tier through uc.risktierof. *)
f=trysubmit(gw:$gateway;req:$gatewayrequest):$gatewaydecision{
  if(gw.killswitchactive){
    let reason="Kill switch active: \(gw.killswitchreason)";
    log.error("gateway deny -- \(reason)";"gateway";req.correlationid);
    <$gatewaydecision{
      requestid:req.requestid;
      policydecision:$deny(reason);
      risktier:$risktier{$high:0};
      routing:defaultrouting();
      controlsapplied:@("kill-switch");
      explanation:reason;
      timestamp:str.nowiso8601()
    }
  }el{};
  let found=uc.findor(gw.registry;req.usecaseid);
  if(uc.isusecase(found)){
    <submitinnerwithuc(req;found)
  }el{
    <submitinnerunknownuc(req)
  }
};

f=submitinnerunknownuc(req:$gatewayrequest):$gatewaydecision{
  let denymsg="Unknown use case: \(req.usecaseid)";
  log.error("gateway deny -- \(denymsg)";"gateway";req.correlationid);
  <$gatewaydecision{
    requestid:req.requestid;
    policydecision:$deny(denymsg);
    risktier:$risktier{$high:0};
    routing:defaultrouting();
    controlsapplied:@("audit-logging");
    explanation:denymsg;
    timestamp:str.nowiso8601()
  }
};

f=submitinnerwithuc(req:$gatewayrequest;founduc:$usecasedef):$gatewaydecision{
  let risk=pol.classifyrisk(req.sensitivity;uc.risktierof(founduc);req.estimatedcost);
  let policy=pol.evaluate(risk;req.sensitivity;req.modelid;req.usecaseid);
  let controls=pol.controlsforrisk(risk;req.sensitivity);
  let logmsg="gateway \(gt.decisionlabel(policy)) use_case=\(req.usecaseid) risk=\(gt.risklabel(risk))";
  let gwloglevel=mt policy {
    $allow:v 0;
    $allowwithwarning:warning 1;
    $requireapproval:msg 2;
    $deny:msg 3
  };
  if(gwloglevel==0){
    log.info(logmsg;"gateway";req.correlationid)
  }el{
    if(gwloglevel==3){
      log.error(logmsg;"gateway";req.correlationid)
    }el{
      log.warn(logmsg;"gateway";req.correlationid)
    }
  };
  let explanation=mt policy {
    $allow:v                  "Request approved";
    $allowwithwarning:w   w;
    $requireapproval:msg   msg;
    $deny:msg               msg
  };
  <$gatewaydecision{
    requestid:req.requestid;
    policydecision:policy;
    risktier:risk;
    routing:defaultrouting();
    controlsapplied:controls;
    explanation:explanation;
    timestamp:str.nowiso8601()
  }
};


(* ── A kill switch that never engaged ─────────────────────────────────────────────
   Both of these were no-ops. `gw.killswitchactive==true` is a COMPARISON — toke has no
   assignment to a struct field (T-26) and `==` where `=` was meant is a legal expression
   statement whose value is discarded. So `activatekillswitch` logged
   **"kill switch activated"** at error level and left the flag false, and
   `deactivatekillswitch` logged the opposite and changed nothing either. A control whose only
   observable effect is a log line saying it worked is worse than an absent one.

   Two things keep this from being a live P0, and both are worth stating so the severity is not
   over- or under-read. There are **no cross-module callers** of either function (checked), and
   the kill switch the browser route actually consults is a different one —
   `core.governance.killswitch`, backed by the settings table, which is asserted engaged-then-
   read-back in `tests/unit/governance/test_kill_switch.tk`. So loke has **two** kill switches:
   one that works and is wired, and this one, which did not work and is not. That is its own
   problem — GA1.9 — but it is not an unguarded hole today.

   Returning `$gateway` rather than `:void` is the fix toke allows, and `:void` is what made the
   no-op invisible: a function returning nothing reads like one that works by mutation. *)
f=activatekillswitch(gw:$gateway;reason:str):$gateway{
  log.error(str.concat("kill switch activated: ";reason);"gateway";"system");
  <$gateway{
    registry:gw.registry;
    killswitchactive:true;
    killswitchreason:reason
  }
};


f=deactivatekillswitch(gw:$gateway):$gateway{
  log.info("kill switch deactivated";"gateway";"system");
  <$gateway{
    registry:gw.registry;
    killswitchactive:false;
    killswitchreason:""
  }
};


f=isblocked(decision:i64):bool{
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let policydecisionv:$policydecision=decision.policydecision;
  <mt policydecisionv {
    $allow:v                  false;
    $allowwithwarning:msg false;
    $requireapproval:msg   true;
    $deny:msg               true
  }
};

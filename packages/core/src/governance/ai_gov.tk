m=core.governance.ai_gov;





m=core.governance.aigov;
i=str:std.string;
i=db:std.db;
i=log:shared.log;






t=$modelpolicy{
  modelid:str;
  approved:bool;
  tier:str;
  maxsensitivity:i32;
  requiresaudit:bool
};






t=$promptrisk{
  injectionscore:f32;
  hallucinationrisk:str;
  sensitiverequest:bool;
  notes:@(str)
};





t=$outputrisk{
  piiinoutput:bool;
  factualclaimcount:i32;
  risklevel:str
};


f=ensuretable(store:db.$store):bool{
  let sql="CREATE TABLE IF NOT EXISTS model_policies (
  model_id TEXT PRIMARY KEY,
  approved INTEGER NOT NULL DEFAULT 0,
  tier TEXT NOT NULL DEFAULT 'cloud-standard',
  max_sensitivity INTEGER NOT NULL DEFAULT 1,
  requires_audit INTEGER NOT NULL DEFAULT 0
)";
  db.execparams(store.conn;sql;mt @()) {
    $ok: <true;
    $err:e {
      log.warn("failed to create model_policies table";"ai_gov";"system");
      <false
    };
  };
};




f=islocalmodel(modelid:str):bool{
  if str.startswith(modelid;"ollama/"){
    <true
  }else{
    if str.startswith(modelid;"local/"){
      <true
    }else{
      if str.startswith(modelid;"llama"){
        <true
      }else{
        if str.startswith(modelid;"mistral"){
          <true
        }else{
          if str.startswith(modelid;"phi"){
            <true
          }else{
            if str.startswith(modelid;"gemma"){
              <true
            }else{
              if str.startswith(modelid;"qwen"){
                <true
              }else{
                <false
              };
            };
          };
        };
      };
    };
  };
};






f=checkmodel(store:db.$store;modelid:str):$modelpolicy{
  db.queryparams(
    store.conn;
    "SELECT model_id,approved,tier,max_sensitivity,requires_audit FROM model_policies WHERE model_id=? LIMIT 1";
    @(modelid)
  mt ) {
    $ok:rows {
      if rows.len==0{
        
        if islocalmodel(modelid){
          log.debug(
            str.concat("ai_gov: auto-approving local model: ";modelid);
            "ai_gov";
            "system"
          );
          <$modelpolicy{
            modelid:modelid;
            approved:true;
            tier:"local";
            maxsensitivity:3;
            requiresaudit:false
          };
        }else{
          log.warn(
            str.concat("ai_gov: no policy found for cloud model: ";modelid);
            "ai_gov";
            "system"
          );
          <$modelpolicy{
            modelid:modelid;
            approved:false;
            tier:"cloud-standard";
            maxsensitivity:0;
            requiresaudit:true
          };
        };
      }else{
        let row=rows.get(0);
        <$modelpolicy{
          modelid:json.getstr(row;"model_id");
          approved:json.getint(row;"approved")==1;
          tier:json.getstr(row;"tier");
          maxsensitivity:json.getint(row;"max_sensitivity");
          requiresaudit:json.getint(row;"requires_audit")==1
        };
      };
    };
    $err:e {
      log.warn(str.concat("ai_gov: failed to query policy for: ";modelid);"ai_gov";"system");
      
      if islocalmodel(modelid){
        <$modelpolicy{
          modelid:modelid;
          approved:true;
          tier:"local";
          maxsensitivity:3;
          requiresaudit:false
        };
      }else{
        <$modelpolicy{
          modelid:modelid;
          approved:false;
          tier:"cloud-standard";
          maxsensitivity:0;
          requiresaudit:true
        };
      };
    };
  };
};



f=approvemodel(store:db.$store;policy:$modelpolicy):bool{
  let approveds=if policy.approved{ "1" }else{ "0" };
  let maxsenss=str.fromint(policy.maxsensitivity);
  let requiresaudits=if policy.requiresaudit{ "1" }else{ "0" };
  db.execparams(
    store.conn;
    "INSERT INTO model_policies (model_id,approved,tier,max_sensitivity,requires_audit)
     VALUES (?,?,?,?,?)
     ON CONFLICT(model_id) DO UPDATE SET
       approved=excluded.approved,
       tier=excluded.tier,
       max_sensitivity=excluded.max_sensitivity,
       requires_audit=excluded.requires_audit";
    @(policy.modelid;approveds;policy.tier;maxsenss;requiresaudits)
  mt ) {
    $ok: {
      log.info(
        str.concat(
          str.concat("ai_gov: model policy saved: ";policy.modelid);
          if policy.approved{ " (approved)" }else{ " (NOT approved)" };
        );
        "ai_gov";
        "system"
      );
      <true
    };
    $err:e {
      log.warn(str.concat("ai_gov: failed to save policy for: ";policy.modelid);"ai_gov";"system");
      <false
    };
  };
};















f=assessprompt(prompt:str):$promptrisk{
  let notes=@();
  let injectionhits=0;

  
  if str.containsignorecase(prompt;"ignore previous instructions"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'ignore previous instructions'")
  }else{};
  if str.containsignorecase(prompt;"ignore all previous"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'ignore all previous'")
  }else{};
  if str.containsignorecase(prompt;"pretend you are"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'pretend you are'")
  }else{};
  if str.containsignorecase(prompt;"you are now"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'you are now'")
  }else{};
  if str.containsignorecase(prompt;"jailbreak"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'jailbreak'")
  }else{};
  if str.containsignorecase(prompt;"do anything now"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'DAN / do anything now'")
  }else{};
  if str.contains(prompt;"DAN"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'DAN'")
  }else{};
  if str.containsignorecase(prompt;"disregard your"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'disregard your'")
  }else{};
  if str.containsignorecase(prompt;"override your instructions"){
    injectionhits=injectionhits+1;
    notes=@(notes;"injection: 'override your instructions'")
  }else{};

  
  let injectionhitsf=str.tofloat(str.fromint(injectionhits));
  let rawscore=injectionhitsf*0.25;
  let injectionscore=if rawscore>1.0{ 1.0 }else{ rawscore };

  
  let promptlen=str.len(prompt);
  let hallhits=0;
  if promptlen>400{
    hallhits=hallhits+1
  }else{};
  if str.containsignorecase(prompt;"according to"){
    hallhits=hallhits+1;
    notes=@(notes;"hallucination-risk: cites sources")
  }else{};
  if str.containsignorecase(prompt;"statistics"){
    hallhits=hallhits+1;
    notes=@(notes;"hallucination-risk: requests statistics")
  }else{};
  if str.containsignorecase(prompt;"citation"){
    hallhits=hallhits+1;
    notes=@(notes;"hallucination-risk: requests citation")
  }else{};
  if str.containsignorecase(prompt;"exactly when"){
    hallhits=hallhits+1;
    notes=@(notes;"hallucination-risk: requests exact date/event")
  }else{};
  if str.containsignorecase(prompt;"what is the current"){
    hallhits=hallhits+1;
    notes=@(notes;"hallucination-risk: requests current information")
  }else{};
  let hallucinationrisk=if hallhits>=3{
    "high"
  }else{
    if hallhits>=1{
      "medium"
    }else{
      "low"
    };
  };

  
  let sensitive=false;
  if str.containsignorecase(prompt;"medical"){
    sensitive=true;
    notes=@(notes;"sensitive: medical keyword")
  }else{};
  if str.containsignorecase(prompt;"diagnosis"){
    sensitive=true;
    notes=@(notes;"sensitive: diagnosis keyword")
  }else{};
  if str.containsignorecase(prompt;"prescription"){
    sensitive=true;
    notes=@(notes;"sensitive: prescription keyword")
  }else{};
  if str.containsignorecase(prompt;"legal"){
    sensitive=true;
    notes=@(notes;"sensitive: legal keyword")
  }else{};
  if str.containsignorecase(prompt;"lawsuit"){
    sensitive=true;
    notes=@(notes;"sensitive: lawsuit keyword")
  }else{};
  if str.containsignorecase(prompt;"contract"){
    sensitive=true;
    notes=@(notes;"sensitive: contract keyword")
  }else{};
  if str.containsignorecase(prompt;"financial"){
    sensitive=true;
    notes=@(notes;"sensitive: financial keyword")
  }else{};
  if str.containsignorecase(prompt;"investment"){
    sensitive=true;
    notes=@(notes;"sensitive: investment keyword")
  }else{};
  if str.containsignorecase(prompt;"tax"){
    sensitive=true;
    notes=@(notes;"sensitive: tax keyword")
  }else{};
  if str.containsignorecase(prompt;"compliance"){
    sensitive=true;
    notes=@(notes;"sensitive: compliance keyword")
  }else{};

  <$promptrisk{
    injectionscore:injectionscore;
    hallucinationrisk:hallucinationrisk;
    sensitiverequest:sensitive;
    notes:notes
  };
};















f=assessoutput(output:str):$outputrisk{
  
  let pii=false;
  if str.contains(output;"@"){
    
    if str.contains(output;".com"){
      pii=true
    }else{
      if str.contains(output;".co."){
        pii=true
      }else{
        if str.contains(output;".org"){
          pii=true
        }else{
          if str.contains(output;".net"){
            pii=true
          }else{};
        };
      };
    };
  }else{};
  
  if str.matches(output;"\d{4}[- ]\d{4}[- ]\d{4}[- ]\d{4}"){
    pii=true
  }else{};
  
  if str.matches(output;"\+\d{1,3}[\s.-]?\d{3,5}[\s.-]?\d{4,6}"){
    pii=true
  }else{};
  
  if str.matches(output;"\d{3}-\d{2}-\d{4}"){
    pii=true
  }else{};

  
  let sentences=str.split(output;".");
  let factualcount=0;
  let monthwords=@("January";"February";"March";"April";"May";"June";"July";"August";"September";"October";"November";"December");
  sentences.each|sentence{
    let hasdigit=str.matches(sentence;"\d");
    let hasmonth=false;
    monthwords.each|month{
      if str.contains(sentence;month){
        hasmonth=true
      }else{};
    };
    if hasdigit{
      factualcount=factualcount+1
    }else{
      if hasmonth{
        factualcount=factualcount+1
      }else{};
    };
  };

  let risklevel=if pii{
    "high"
  }else{
    if factualcount>=8{
      "high"
    }else{
      if factualcount>=3{
        "medium"
      }else{
        "low"
      };
    };
  };

  <$outputrisk{
    piiinoutput:pii;
    factualclaimcount:factualcount;
    risklevel:risklevel
  };
};















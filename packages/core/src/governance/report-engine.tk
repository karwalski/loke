};

f=generatecost(conn:i64;filter:$reportfilter):$report!$lokeerr{
  let sql="SELECT created_at, event_type, use_case FROM audit_log WHERE created_at >= ? AND created_at <= ? AND event_type LIKE '%cost%' ORDER BY created_at DESC";
  <mt db.many(sql;@(filter.startdate;filter.enddate)) {

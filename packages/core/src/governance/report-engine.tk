
m=core.governance.reportengine;
i=db:std.db;
i=audit:core.storage.audit;
i=str:std.str;
i=log:shared.log;
i=external:core.governance.external;

t=$reporttype{
  $compliancesummary:i64;
  $piidetectionlog:i64;
  $routingdecisions:i64;
  $policychanges:i64;
  $costsavings:i64
};

t=$reportfilter{
  startdate:$str;
  enddate:$str;
  reporttype:$str;
  format:$str
};

t=$reportrow{
  timestamp:$str;
  category:$str;
  detail:$str;
  severity:$str;
  value:$str
};

t=$report{
  title:$str;
  reporttype:$str;
  generatedat:$str;
  periodstart:$str;
  periodend:$str;
  rows:@$reportrow;
  summary:$str;
  format:$str
};

f=generate(conn:i64;filter:i64;extconfig:$external.$externalconfig|void):$report|$lokeerr{
  log.info(str.concat("generating report: ";filter.reporttype);"report_engine";"system");
  let result=if(str.eq(filter.reporttype;"compliance_summary")):i64{
    generatecompliance(conn;filter)
  }el{
    if(str.eq(filter.reporttype;"pii_detection_log")){
      generatepii(conn;filter)
    }el{
      if(str.eq(filter.reporttype;"routing_decisions")){
        generaterouting(conn;filter)
      }el{
        if(str.eq(filter.reporttype;"policy_changes")){
          generatepolicychanges(conn;filter)
        }el{
          generatecost(conn;filter)
        };
      };
    };
  };
  mt result {
    $ok:report {
      mt extconfig {
        $ok:cfg {
          external.dispatchreport(cfg;report.reporttype;report.summary)
        };
        $$err:e {};
      };
    };
    $$err:e {};
  };
  <result
};

f=generatecompliance(conn:i64;filter:$reportfilter):$report|$lokeerr{
  let rows=@$reportrow;
  let sql="SELECT timestamp, event_type, detail FROM audit_log WHERE timestamp >= ? AND timestamp <= ? AND event_type LIKE '%compliance%' ORDER BY timestamp DESC";
  db.queryparams(conn;sql;@(mt filter.startdate;filter.enddate)) {
    $ok:results {
      results.each|r{
        let ts=json.getstr(r;"timestamp");
        let detail=json.getstr(r;"detail");
        rows:@.push(rows;$reportrow{timestamp:$ts;category:"compliance";detail:$detail;severity:"INFO";value:""})
      };
      <$ok($report{
        title:"Compliance Summary Report";
        reporttype:"compliance_summary";
        generatedat:"now";
        periodstart:$filter.startdate;
        periodend:$filter.enddate;
        rows:$rows;
        summary:$str.concat("Total compliance events: ";str.fromint(rows.len));
        format:$filter.format
      })
    };
    $err:e <$err($lokeerr.$storageerr("failed to query audit log for compliance"))
  };
};

f=generatepii(conn:i64;filter:$reportfilter):$report|$lokeerr{
  let sql="SELECT timestamp, event_type, detail FROM audit_log WHERE timestamp >= ? AND timestamp <= ? AND event_type LIKE '%pii%' ORDER BY timestamp DESC";
  db.queryparams(conn;sql;@(mt filter.startdate;filter.enddate)) {
    $ok:results {
      let rows=@$reportrow;
      results.each|r{
        rows:@.push(rows;$reportrow{timestamp:$json.getstr(r;"timestamp");category:"pii";detail:$json.getstr(r;"detail");severity:"INFO";value:""})
      };
      <$ok($report{title:"PII Detection Log";reporttype:"pii_detection_log";generatedat:"now";periodstart:$filter.startdate;periodend:$filter.enddate;rows:$rows;summary:$str.concat("Total PII events: ";str.fromint(rows.len));format:$filter.format})
    };
    $err:e <$err($lokeerr.$storageerr("failed to query pii events"))
  };
};


m=core.governance.reportengine;
i=db:std.db;
i=audit:core.storage.audit;
i=str:std.str;
i=log:shared.log;
i=external:core.governance.external;

t=$reporttype{
  $compliancesummary:i64;
  $piidetectionlog:i64;
  $routingdecisions:i64;
  $policychanges:i64;
  $costsavings:i64
};

t=$reportfilter{
  startdate:str;
  enddate:str;
  reporttype:str;
  format:str
};

t=$reportrow{
  timestamp:str;
  category:str;
  detail:str;
  severity:str;
  value:str
};

t=$report{
  title:str;
  reporttype:str;
  generatedat:str;
  periodstart:str;
  periodend:str;
  rows:@$reportrow;
  summary:str;
  format:str
};

f=generate(conn:i64;filter:$reportfilter;extconfig:$externalconfig):$report!$lokeerr{
  log.info(str.concat("generating report: ";filter.reporttype);"report_engine";"system");
  let result=mut.generatecost(conn;filter); if(str.eq(filter.reporttype;"compliance_summary")){
    result=generatecompliance(conn;filter)
  }el{
    if(str.eq(filter.reporttype;"pii_detection_log")){
      result=generatepii(conn;filter)
    }el{
      if(str.eq(filter.reporttype;"routing_decisions")){
        result=generaterouting(conn;filter)
      }el{
        if(str.eq(filter.reporttype;"policy_changes")){
          result=generatepolicychanges(conn;filter)
        }el{};
      };
    };
  };
  <result
};

f=buildcompliancerows(results:i64;filter:$reportfilter):$report!$lokeerr{
  let rows=@();
  lp(let ii63=0;ii63<results.len;ii63=ii63+1){
    let r=results.get(ii63);
    let ts=json.str(r;"timestamp");
    let detail=json.str(r;"detail");
    rows=arr.push(rows;$reportrow{timestamp:ts;category:"compliance";detail:detail;severity:"INFO";value:""})

  };
  <$ok($report{
    title:"Compliance Summary Report";
    reporttype:"compliance_summary";
    generatedat:"now";
    periodstart:filter.startdate;
    periodend:filter.enddate;
    rows:rows;
    summary:str.concat("Total compliance events: ";str.fromint(rows.len));
    format:filter.format
  })
};

f=generatecompliance(conn:i64;filter:$reportfilter):$report!$lokeerr{
  let sql="SELECT timestamp, event_type, detail FROM audit_log WHERE timestamp >= ? AND timestamp <= ? AND event_type LIKE '%compliance%' ORDER BY timestamp DESC";
  mt db.queryparams(conn;sql;@(filter.startdate;filter.enddate)) {
    $ok:results buildcompliancerows(results;filter);
    $err:e $err($storageerr("failed to query audit log for compliance"))
  }
};

f=buildpiirows(results:i64;filter:$reportfilter):$report!$lokeerr{
  let rows=@();
  lp(let ii92=0;ii92<results.len;ii92=ii92+1){
    let r=results.get(ii92);
    rows=arr.push(rows;$reportrow{timestamp:json.str(r;"timestamp");category:"pii";detail:json.str(r;"detail");severity:"INFO";value:""})

  };
  <$ok($report{title:"PII Detection Log";reporttype:"pii_detection_log";generatedat:"now";periodstart:filter.startdate;periodend:filter.enddate;rows:rows;summary:str.concat("Total PII events: ";str.fromint(rows.len));format:filter.format})
};

f=generatepii(conn:i64;filter:$reportfilter):$report!$lokeerr{
  let sql="SELECT timestamp, event_type, detail FROM audit_log WHERE timestamp >= ? AND timestamp <= ? AND event_type LIKE '%pii%' ORDER BY timestamp DESC";
  mt db.queryparams(conn;sql;@(filter.startdate;filter.enddate)) {
    $ok:results buildpiirows(results;filter);
    $err:e $err($storageerr("failed to query pii events"))
  }
};


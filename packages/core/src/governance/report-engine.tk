m=core.governance.reportengine;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=t:shared.types;
i=audit:core.storage.audit;
i=s:core.storage.db;
i=external:core.governance.external;

t=$reporttype{
  $compliancesummary:i64;
  $piidetectionlog:i64;
  $routingdecisions:i64;
  $policychanges:i64;
  $costsavings:i64
};

t=$reportfilter{
  startdate:str;
  enddate:str;
  reporttype:str;
  format:str
};

t=$reportrow{
  timestamp:str;
  category:str;
  detail:str;
  severity:str;
  value:str
};

t=$report{
  title:str;
  reporttype:str;
  generatedat:str;
  periodstart:str;
  periodend:str;
  rows:@$reportrow;
  summary:str;
  format:str
};

f=generate(conn:i64;filter:$reportfilter;extconfig:$externalconfig):$report!$lokeerr{
  log.info(str.concat("generating report: ";filter.reporttype);"report_engine";"system");
  let result=mut.generatecost(conn;filter); if(str.eq(filter.reporttype;"compliance_summary")){
    result=generatecompliance(conn;filter)
  }el{
    if(str.eq(filter.reporttype;"pii_detection_log")){
      result=generatepii(conn;filter)
    }el{
      if(str.eq(filter.reporttype;"routing_decisions")){
        result=generaterouting(conn;filter)
      }el{
        if(str.eq(filter.reporttype;"policy_changes")){
          result=generatepolicychanges(conn;filter)
        }el{};
      };
    };
  };
  <result
};

(* The row accessors are core.storage.db's, not std.json's. db.many returns [$row] and
   all five report builders below read their fields with json.str against those rows, so
   every governance report came back with empty timestamps and empty details: the row
   count was right and every row was blank.

   The column names were wrong as well. audit_log (migrations.tk:38) has no `timestamp`
   and no `detail` column — the timestamp is `created_at`, and the nearest per-event
   detail the table carries is `use_case`. A typed accessor on the old names would have
   gone on returning "" just as silently, so the SQL is corrected with them.

   NOT fixed here, and still broken: `created_at` is a millisecond epoch integer stored
   as TEXT (audit.tk:46-54) while $reportfilter.startdate/enddate are ISO dates such as
   "2026-01-01" (cli/report.tk:38). The range comparison is therefore a string compare
   between "1758..." and "2026-...", which matches nothing. The filter dates need
   converting to epoch milliseconds before these reports return any row at all. *)
f=buildcompliancerows(results:@$row;filter:$reportfilter):$report!$lokeerr{
  let rows=mut.@();
  lp(let ii63=0;ii63<results.len;ii63=ii63+1){
    let r:$row=results.get(ii63);
    let ts=s.rowstr(r;"created_at");
    let detail=s.rowstr(r;"use_case");
    rows=rows.push($reportrow{timestamp:ts;category:"compliance";detail:detail;severity:"INFO";value:""})

  };
  <$ok($report{
    title:"Compliance Summary Report";
    reporttype:"compliance_summary";
    generatedat:"now";
    periodstart:filter.startdate;
    periodend:filter.enddate;
    rows:rows;
    summary:str.concat("Total compliance events: ";str.fromint(rows.len));
    format:filter.format
  })
};

f=generatecompliance(conn:i64;filter:$reportfilter):$report!$lokeerr{
  let sql="SELECT created_at, event_type, use_case FROM audit_log WHERE created_at >= ? AND created_at <= ? AND event_type LIKE '%compliance%' ORDER BY created_at DESC";
  <mt db.many(sql;@(filter.startdate;filter.enddate)) {
    $ok:results buildcompliancerows(results;filter);
    $err:e $err($storageerr("failed to query audit log for compliance"))
  }
};

f=buildpiirows(results:@$row;filter:$reportfilter):$report!$lokeerr{
  let rows=mut.@();
  lp(let ii92=0;ii92<results.len;ii92=ii92+1){
    let r:$row=results.get(ii92);
    rows=rows.push($reportrow{timestamp:s.rowstr(r;"created_at");category:"pii";detail:s.rowstr(r;"use_case");severity:"INFO";value:""})

  };
  <$ok($report{title:"PII Detection Log";reporttype:"pii_detection_log";generatedat:"now";periodstart:filter.startdate;periodend:filter.enddate;rows:rows;summary:str.concat("Total PII events: ";str.fromint(rows.len));format:filter.format})
};

f=generatepii(conn:i64;filter:$reportfilter):$report!$lokeerr{
  let sql="SELECT created_at, event_type, use_case FROM audit_log WHERE created_at >= ? AND created_at <= ? AND event_type LIKE '%pii%' ORDER BY created_at DESC";
  <mt db.many(sql;@(filter.startdate;filter.enddate)) {
    $ok:results buildpiirows(results;filter);
    $err:e $err($storageerr("failed to query pii events"))
  }
};


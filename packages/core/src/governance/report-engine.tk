  let sql="SELECT timestamp, event_type, detail FROM audit_log WHERE timestamp >= ? AND timestamp <= ? AND event_type LIKE '%policy%' ORDER BY timestamp DESC";
  mt db.queryparams(conn;sql;@(filter.startdate;filter.enddate)) {
    $ok:results {
      let rows=@();
      results.each|r{
        rows=arr.push(rows;$reportrow{timestamp:json.getstr(r;"timestamp");category:"policy";detail:json.getstr(r;"detail");severity:"INFO";value:""})
      };
      <$ok($report{title:"Policy Changes Report";reporttype:"policy_changes";generatedat:"now";periodstart:filter.startdate;periodend:filter.enddate;rows:rows;summary:str.concat("Total policy changes: ";str.fromint(rows.len));format:filter.format})
    };
    $err:e <$err($storageerr("failed to query policy events"))

  let rows=@();
  lp(let ii128=0;ii128<results.len;ii128=ii128+1){
    let r=results.get(ii128);
    rows=arr.push(rows;$reportrow{timestamp:json.str(r;"timestamp");category:"policy";detail:json.str(r;"detail");severity:"INFO";value:""})


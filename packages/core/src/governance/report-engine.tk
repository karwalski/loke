  };
  <$ok($report{title:"Routing Decisions Report";reporttype:"routing_decisions";generatedat:"now";periodstart:filter.startdate;periodend:filter.enddate;rows:rows;summary:str.concat("Total routing decisions: ";str.fromint(rows.len));format:filter.format})
};

f=generaterouting(conn:i64;filter:$reportfilter):$report!$lokeerr{

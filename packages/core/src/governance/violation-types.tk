m=core.governance.violationtypes;
i=str:std.str;

t=$violationseverity{
  $info:i64;
  $advisory:i64;
  $warning:i64;
  $block:i64};

t=$violationtype{
  $piiinresponse:i64;
  $policybreach:i64;
  $classificationmismatch:i64;
  $crossborderviolation:i64;
  $budgetexceeded:i64;
  $blockedentitydetected:i64;
  $unregisteredusecase:i64;
  $modelnotapproved:i64};

t=$violation{
  id:str;
  violationtype:str;
  severity:str;
  description:str;
  entitytype:str;
  sourcestage:str;
  requestid:str;
  suppressed:bool
};

t=$scanresult{
  violations:@$violation;
  scannedat:i64;
  requestid:str;
  requiresconfirmation:bool
};

f=severitylabel(s:$violationseverity):str{
  mt s {
    $info:v "INFO";
    $advisory:v "ADVISORY";
    $warning:v "WARNING";
    $block:v "BLOCK"
  }
};

f=severityrank(s:str):i64{
  if(str.eq(s;"BLOCK")){<4}el{
    if(str.eq(s;"WARNING")){<3}el{
      if(str.eq(s;"ADVISORY")){<2}el{<1}
    }
  }
};

f=highestseverity(violations:@$violation):str{
  let maxrank=mut.0;
  let result=mut."INFO";
  lp(let i=0;i<str.arraylen(violations);i=i+1){ let v=str.arrayget(violations;i);
    let rank=severityrank(v.severity);
    if(rank>maxrank){
      maxrank=rank;
      result=v.severity
    }el{}
  };
  <result
};

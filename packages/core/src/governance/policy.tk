m=core.governance.policy;



i=t:shared.types;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;







f=classifyrisk(sensitivity:$sensitivitylevel;usecaserisk:i64;estimatedcost:f64):i64{
  if(sensitivity=$sensitivitylevel.$restricted){
    <$gt.risktier.$high
  }el{
    let basetier=usecaserisk;
    if(sensitivity=$sensitivitylevel.$confidential){
      mt basetier {
        $gt.risktier.$low;    basetier=$gt.risktier.$medium;
        $gt.risktier.$medium; 
        $gt.risktier.$high;   
      };
    }el{
      
    };
    if(estimatedcost>1.0){
      mt basetier {
        $gt.risktier.$low;    <$gt.risktier.$medium;
        $gt.risktier.$medium; <$gt.risktier.$high;
        $gt.risktier.$high;   <$gt.risktier.$high
      };
    }el{
      <basetier
    };
  };
};


f=evaluate(risk:i64;sensitivity:$sensitivitylevel;modelid:str;usecaseid:str):i64{
  mt risk {
    $gt.risktier.$low;
      if(sensitivity=$sensitivitylevel.$confidential){
        <$gt.policydecision.$allowwithwarning("Confidential data — anonymisation applied")
      }el{
        if(sensitivity=$sensitivitylevel.$restricted){
          <$gt.policydecision.$allowwithwarning("Confidential data — anonymisation applied")
        }el{
          <$gt.policydecision.$allow
        };
      };
    $gt.risktier.$medium;
      <$gt.policydecision.$allowwithwarning("Medium risk: audit trail enabled, human-visible preview recommended");
    $gt.risktier.$high;
      if(sensitivity=$sensitivitylevel.$restricted){
        <$gt.policydecision.$requireapproval("High risk + restricted data: explicit approval required")
      }el{
        <$gt.policydecision.$allowwithwarning("High risk: enhanced audit trail enabled")
      };
  };
};






f=controlsforrisk(risk:i64;sensitivity:$sensitivitylevel):@str{
  let controls=@("anonymisation";"audit-logging";"guardian-prompt");
  mt risk {
    $gt.risktier.$low;
      
    $gt.risktier.$medium;
      controls=@(controls;"human-visible-preview";"cost-confirmation");
    $gt.risktier.$high;
      controls=@(controls;"human-visible-preview";"cost-confirmation";"enhanced-audit";"explainability-trace")
  };
  if(sensitivity=$sensitivitylevel.$restricted){
    controls=@(controls;"local-only-routing")
  }el{
    
  };
  <controls
};

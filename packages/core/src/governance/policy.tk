m=core.governance.policy;



i=t:shared.types;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;







f=classifyrisk(sensitivity:$sensitivitylevel;usecaserisk:i64;estimatedcost:f64):i64{
  if(sensitivity=$$restricted){
    <$risktier.$high
  }el{
    let basetier=usecaserisk;
    if(sensitivity=$$confidential){
      mt basetier {
        $risktier.$low;    basetier=$risktier.$medium;
        $risktier.$medium; 
        $risktier.$high;   
      }
    }el{
      
    };
    if(estimatedcost>1.0){
      mt basetier {
        $risktier.$low;    <$risktier.$medium;
        $risktier.$medium; <$risktier.$high;
        $risktier.$high;   <$risktier.$high
      }
    }el{
      <basetier
    }
  }
};


f=evaluate(risk:i64;sensitivity:$sensitivitylevel;modelid:str;usecaseid:str):i64{
  mt risk {
    $risktier.$low;
      if(sensitivity=$$confidential){
        <$policydecision.$allowwithwarning("Confidential data — anonymisation applied")
      }el{
        if(sensitivity=$$restricted){
          <$policydecision.$allowwithwarning("Confidential data — anonymisation applied")
        }el{
          <$policydecision.$allow
        }
      };
    $risktier.$medium;
      <$policydecision.$allowwithwarning("Medium risk: audit trail enabled, human-visible preview recommended");
    $risktier.$high;
      if(sensitivity=$$restricted){
        <$policydecision.$requireapproval("High risk + restricted data: explicit approval required")
      }el{
        <$policydecision.$allowwithwarning("High risk: enhanced audit trail enabled")
      }
  }
};






f=controlsforrisk(risk:i64;sensitivity:$sensitivitylevel):@str{
  let controls=@("anonymisation";"audit-logging";"guardian-prompt");
  mt risk {
    $risktier.$low;
      
    $risktier.$medium;
      controls=@(controls;"human-visible-preview";"cost-confirmation");
    $risktier.$high;
      controls=@(controls;"human-visible-preview";"cost-confirmation";"enhanced-audit";"explainability-trace")
  };
  if(sensitivity=$$restricted){
    controls=@(controls;"local-only-routing")
  }el{
    
  };
  <controls
};

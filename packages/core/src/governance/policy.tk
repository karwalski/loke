m=core.governance.policy;
i=t:shared.types;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;










(* `basetier==$medium` was a COMPARISON whose result was discarded, and `basetier` was
   not mut, so the confidential escalation never happened: a confidential request with
   a low use-case risk was classified low, and only the cost rule could raise it.
   The escalations are separate functions now, applied in order. *)
f=escalate(tier:$risktier):$risktier{
  <mt tier {
    $low:v    $risktier{$medium:0};
    $medium:v $risktier{$high:0};
    $high:v   $risktier{$high:0}
  }
};

f=classifyrisk(sensitivity:$sensitivitylevel;usecaserisk:$risktier;estimatedcost:f64):$risktier{
  if(t.senseq(sensitivity;t.restricted())){
    <$risktier{$high:0}
  }el{
    let basetier=mut.usecaserisk;
    if(t.senseq(sensitivity;t.confidential())){
      basetier=escalate(basetier)
    }el{};
    if(estimatedcost>1.0){
      basetier=escalate(basetier)
    }el{};
    <basetier
  }
};


f=evaluatelow(sensitivity:$sensitivitylevel):$policydecision{
  if(t.senseq(sensitivity;t.confidential())){
    <$allowwithwarning("Confidential data — anonymisation applied")
  }el{
    if(t.senseq(sensitivity;t.restricted())){
      <$allowwithwarning("Confidential data — anonymisation applied")
    }el{
      <$policydecision{$allow:""}
    }
  }
};

f=evaluatehigh(sensitivity:$sensitivitylevel):$policydecision{
  if(t.senseq(sensitivity;t.restricted())){
    <$requireapproval("High risk + restricted data: explicit approval required")
  }el{
    <$allowwithwarning("High risk: enhanced audit trail enabled")
  }
};

f=evaluate(risk:$risktier;sensitivity:$sensitivitylevel;modelid:str;usecaseid:str):$policydecision{
  <mt risk {
    $low:v evaluatelow(sensitivity);
    $medium:v $allowwithwarning("Medium risk: audit trail enabled, human-visible preview recommended");
    $high:v evaluatehigh(sensitivity)
  }
};






(* The controls a decision requires are actually attached to it now.

   Each tier arm used to read `controls==@(controls;"human-visible-preview";…)` — a
   discarded COMPARISON wrapped around a nesting literal, in a match whose value was
   also discarded. So every risk tier returned the same three base controls: a HIGH
   risk decision demanded no enhanced audit, no explainability trace, no cost
   confirmation and no human-visible preview. LS1.1a listed this as one of the
   thirteen, and it sits under a story marked Done.

   A match arm is an expression, so the extra controls are produced by the match and
   appended after it rather than assigned inside it. *)
f=extracontrols(risk:$risktier):@str{
  <mt risk {
    $low:v @();
    $medium:v @("human-visible-preview";"cost-confirmation");
    $high:v @("human-visible-preview";"cost-confirmation";"enhanced-audit";"explainability-trace")
  }
};

f=controlsforrisk(risk:$risktier;sensitivity:$sensitivitylevel):@str{
  let controls=mut.@("anonymisation";"audit-logging";"guardian-prompt");
  let extra=extracontrols(risk);
  lp(let i=0;i<extra.len;i=i+1){
    controls=controls.push(extra.get(i))
  };
  if(t.senseq(sensitivity;t.restricted())){
    controls=controls.push("local-only-routing")
  }el{};
  <controls
};

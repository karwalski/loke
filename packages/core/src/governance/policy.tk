m=core.governance.policy;



i=t:shared.types;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;







f=classifyrisk(sensitivity:$sensitivitylevel;usecaserisk:i64;estimatedcost:f64):i64{
  if(sensitivity=$restricted){
    <$high
  }el{
    let basetier=usecaserisk;
    if(sensitivity=$confidential){
      mt basetier {
        $low:v    basetier=$medium;
        $medium:v 0;
        $high:v   0
      }
    }el{
      
    };
    if(estimatedcost>1.0){
      mt basetier {
        $low:v    $medium;
        $medium:v $high;
        $high:v   $high
      }
    }el{
      <basetier
    }
  }
};


f=evaluatelow(sensitivity:$sensitivitylevel):i64{
  if(sensitivity=$confidential){
    <$allowwithwarning("Confidential data — anonymisation applied")
  }el{
    if(sensitivity=$restricted){
      <$allowwithwarning("Confidential data — anonymisation applied")
    }el{
      <$allow
    }
  }
};

f=evaluatehigh(sensitivity:$sensitivitylevel):i64{
  if(sensitivity=$restricted){
    <$requireapproval("High risk + restricted data: explicit approval required")
  }el{
    <$allowwithwarning("High risk: enhanced audit trail enabled")
  }
};

f=evaluate(risk:i64;sensitivity:$sensitivitylevel;modelid:str;usecaseid:str):i64{
  mt risk {
    $low:v evaluatelow(sensitivity);
    $medium:v $allowwithwarning("Medium risk: audit trail enabled, human-visible preview recommended");
    $high:v evaluatehigh(sensitivity)
  }
};






f=controlsforrisk(risk:i64;sensitivity:$sensitivitylevel):@str{
  let controls=@("anonymisation";"audit-logging";"guardian-prompt");
  mt risk {
    $low:v
      0;
    $medium:v
      controls=@(controls;"human-visible-preview";"cost-confirmation");
    $high:v
      controls=@(controls;"human-visible-preview";"cost-confirmation";"enhanced-audit";"explainability-trace")
  };
  if(sensitivity=$restricted){
    controls=@(controls;"local-only-routing")
  }el{
    
  };
  <controls
};

m=core.governance.consent;







i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=time:std.time;

t=$consentrecord{
  id:str;
  userid:str;
  purpose:str;
  granted:bool;
  ts:i64;
  expiryts:i64
};



t=$consentpurposes{
  telemetry:bool;
  improvement:bool;
  cloudrouting:bool;
  companionsync:bool
};


f=ensuretable(store:i64):bool{
  let sql="CREATE TABLE IF NOT EXISTS consent_records (
  id TEXT PRIMARY KEY,
  user_id TEXT NOT NULL,
  purpose TEXT NOT NULL,
  granted INTEGER NOT NULL DEFAULT 0,
  ts INTEGER NOT NULL,
  expiry_ts INTEGER NOT NULL,
  UNIQUE(user_id, purpose)
)";
  mt db.execparams(store.conn;sql;@()) {
    $ok: <true;
    $err:e {
      log.warn("failed to create consent_records table";"consent";"system");
      <false
    }
  }
};





f=grant(store:i64;userid:str;purpose:str;expirydays:i32):bool{
  let id=str.randhex(16);
  let now=time.nowunix();
  let nows=str.fromint(now);
  let expiryts=if expirydays<=0{
    0
  }el{
    let dayssecs=expirydays*86400;
    now+dayssecs
  };
  let expirys=str.fromint(expiryts);
  mt db.execparams(
    store.conn;
    "INSERT INTO consent_records (id,user_id,purpose,granted,ts,expiry_ts)
     VALUES (?,?,?,1,?,?)
     ON CONFLICT(user_id,purpose) DO UPDATE SET
       granted=1,
       ts=excluded.ts,
       expiry_ts=excluded.expiry_ts";
    @(id;userid;purpose;nows;expirys)
  ) {
    $ok: {
      log.info(
        str.concat(
          str.concat("consent granted user=";userid);
          str.concat(" purpose=";purpose)
        );
        "consent";
        userid
      );
      <true
    };
    $err:e {
      log.warn(
        str.concat(
          str.concat("failed to grant consent user=";userid);
          str.concat(" purpose=";purpose)
        );
        "consent";
        userid
      );
      <false
    }
  }
};



f=revoke(store:i64;userid:str;purpose:str):bool{
  let now=time.nowunix();
  let nows=str.fromint(now);
  mt db.execparams(
    store.conn;
    "UPDATE consent_records SET granted=0,ts=? WHERE user_id=? AND purpose=?";
    @(nows;userid;purpose)
  ) {
    $ok: {
      log.info(
        str.concat(
          str.concat("consent revoked user=";userid);
          str.concat(" purpose=";purpose)
        );
        "consent";
        userid
      );
      <true
    };
    $err:e {
      log.warn(
        str.concat(
          str.concat("failed to revoke consent user=";userid);
          str.concat(" purpose=";purpose)
        );
        "consent";
        userid
      );
      <false
    }
  }
};



f=check(store:i64;userid:str;purpose:str):bool{
  let now=time.nowunix();
  let nows=str.fromint(now);
  mt db.queryparams(
    store.conn;
    "SELECT granted,expiry_ts FROM consent_records WHERE user_id=? AND purpose=? LIMIT 1";
    @(userid;purpose)
  ) {
    $ok:rows {
      if(rows.len=0){
        <false
      }el{
        let row=rows.get(0);
        let granted=json.getint(row;"granted");
        let expiryts=json.getint(row;"expiry_ts");
        if(granted=0){
          <false
        }el{
          if(expiryts=0){
            <true
          }el{
            <expiryts>now
          }
        }
      }
    };
    $err:e {
      log.warn(
        str.concat(
          str.concat("failed to check consent user=";userid);
          str.concat(" purpose=";purpose)
        );
        "consent";
        userid
      );
      <false
    }
  }
};



f=loadprefs(store:i64;userid:str):$consentpurposes{
  let telemetry=check(store;userid;"telemetry");
  let improvement=check(store;userid;"improvement");
  let cloudrouting=check(store;userid;"cloud_routing");
  let companionsync=check(store;userid;"companion_sync");
  <$consentpurposes{
    telemetry:telemetry;
    improvement:improvement;
    cloudrouting:cloudrouting;
    companionsync:companionsync
  }
};

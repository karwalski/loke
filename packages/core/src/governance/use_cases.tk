m=core.governance.usecases;

i=str:std.str;
i=t:shared.types;

t=$usecasedef{
  id:str;
  name:str;
  description:str;
  risklevel:i64;
  purpose:str;
  approvedmodels:@str;
  owner:str
};

t=$usecaseregistry{
  entries:@$usecasedef
};

f=builtinusecases():@$usecasedef{
  let cases=@(
    $usecasedef{
      id:"chat-completion";
      name:"General chat and Q&A";
      description:"General purpose conversational assistant";
      risklevel:0;
      purpose:"Assist with information and questions";
      approvedmodels:@("*");
      owner:"loke"
    };
    $usecasedef{
      id:"code-generation";
      name:"Generate code from description";
      description:"Produces code from natural language descriptions";
      risklevel:0;
      purpose:"Accelerate software development";
      approvedmodels:@("*");
      owner:"loke"
    };
    $usecasedef{
      id:"code-review";
      name:"Review and analyse code";
      description:"Inspects code for quality, bugs, and security issues";
      risklevel:1;
      purpose:"Improve code quality and security";
      approvedmodels:@("*");
      owner:"loke"
    };
    $usecasedef{
      id:"summarisation";
      name:"Summarise long documents";
      description:"Condenses lengthy documents into key points";
      risklevel:0;
      purpose:"Extract key information";
      approvedmodels:@("*");
      owner:"loke"
    };
    $usecasedef{
      id:"data-analysis";
      name:"Analyse datasets";
      description:"Processes and interprets structured or unstructured data";
      risklevel:1;
      purpose:"Derive insights from data";
      approvedmodels:@("*");
      owner:"loke"
    };
    $usecasedef{
      id:"classification";
      name:"Classify text into categories";
      description:"Assigns text to predefined categories";
      risklevel:0;
      purpose:"Automate categorisation";
      approvedmodels:@("*");
      owner:"loke"
    };
    $usecasedef{
      id:"agent-task";
      name:"Automated agent action";
      description:"Executes complex multi-step automated tasks autonomously";
      risklevel:2;
      purpose:"Automate complex multi-step tasks";
      approvedmodels:@("*");
      owner:"loke"
    };
    $usecasedef{
      id:"mcp-tool-call";
      name:"MCP tool invocation";
      description:"Invokes external tools via the Model Context Protocol";
      risklevel:1;
      purpose:"Enable LLM tool use";
      approvedmodels:@("*");
      owner:"loke"
    }
  );
  <cases
};

f=newregistry():$usecaseregistry{
  let entries=builtinusecases();
  <$usecaseregistry{entries:entries}
};

f=find(registry:$usecaseregistry;id:str):$usecasedef!$lokeerr{
  let count=registry.entries.len;
  let i=mut.0;
  let uc=mut.$usecasedef{id:"";name:"";description:"";risklevel:0;purpose:"";approvedmodels:@();owner:""};
  lp(let lv=0;true;lv=lv){
    if(!(i<count)){
      <$unknownerr(str.concat("use case not found: ";id))
    }el{
      uc=registry.entries.get(i);
      if(str.eq(uc.id;id)){
        <uc
      }el{
        i=i+1
      }
    }
  }
};

(* LS1.1j — findor is the form a caller can act on. find's error side is a user-declared
   sum, so a match on it takes the first arm whatever the value is (T-18): an unknown use
   case read as found, with the error payload bound as the $usecasedef. findor answers with
   the nousecase sentinel, an empty id that no registered use case carries, tested with
   isusecase. *)
f=nousecase():$usecasedef{
  <$usecasedef{id:"";name:"";description:"";risklevel:0;purpose:"";approvedmodels:@();owner:""}
};

f=isusecase(u:$usecasedef):bool{
  <str.len(u.id)>0
};

f=findor(registry:$usecaseregistry;id:str):$usecasedef{
  lp(let i=0;i<registry.entries.len;i=i+1){
    let uc=registry.entries.get(i);
    if(str.eq(uc.id;id)){
      <uc
    }el{}
  };
  <nousecase()
};

(* risklevel is stored as a plain i64 — 0, 1 or 2 — and policy.classifyrisk takes a
   $risktier. Passing the integer where the sum was expected is what made
   gateway.submitinner segfault; this is the conversion it was missing. Anything out of
   range is HIGH, so an unexpected value cannot lower the tier. *)
f=risktierof(u:$usecasedef):$risktier{
  if(u.risklevel==0){
    <$risktier{$low:0}
  }el{};
  if(u.risklevel==1){
    <$risktier{$medium:0}
  }el{};
  <$risktier{$high:0}
};

(* Returns the new registry. It cannot modify the caller's.

   This was `:i64` and its body was `registry.entries==@(registry.entries;uc)` — a
   COMPARISON, whose result was discarded, wrapped around an array literal that nests
   rather than appends, against a struct a callee cannot mutate in the first place.
   Three independent reasons it registered nothing and reported success. *)
f=register(registry:$usecaseregistry;uc:$usecasedef):$usecaseregistry{
  <$usecaseregistry{entries:registry.entries.push(uc)}
};

f=list(registry:$usecaseregistry):@$usecasedef{
  <registry.entries
};

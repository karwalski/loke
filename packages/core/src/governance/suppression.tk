m=core.governance.suppression;
i=str:std.str;
i=log:shared.log;
i=vt:core.governance.violationtypes;

t=$suppressionrule{
  violationtype:str;
  entitytype:str;
  suppressedat:i64;
  expiresat:i64;
  reason:str
};

f=issuppressed(violation:$violation;rules:@$suppressionrule):bool{
  let found=mut.false;
  lp(let i=0;i<str.arraylen(rules);i=i+1){ let rule:$suppressionrule=rules.get(i);
    if(str.eq(rule.violationtype;violation.violationtype)){
      if(str.len(rule.entitytype)==0){
        found=true
      }el if(str.eq(rule.entitytype;violation.entitytype)){
        found=true
      }el{}
    }el{}
  };
  <found
};

f=applysuppressions(result:$scanresult;rules:@$suppressionrule):$scanresult{
  let filtered=mut.@($violation);
  let suppresscount=mut.0;
  lp(let i=0;i<str.arraylen(result.violations);i=i+1){
    (* Declared, because `str.arrayget` is one of std.str's untyped (i64,i64)->i64 helpers
       (T-36) so it establishes no type, and `violationtype`, `entitytype` and `requestid`
       are each declared by several structs at different offsets — E4034 then lands on the
       READ rather than on the binding. *)
    let v:$violation=result.violations.get(i);
    if(issuppressed(v;rules)){
      (* Rebuilt, not mutated. This was `let suppressed=v; suppressed.suppressed==true;` — a
         COMPARISON, discarded, because toke has no assignment to a struct field (T-26). So the
         violation was pushed back UNCHANGED with `suppressed:false`, and `applysuppressions`
         counted suppressions it had not applied: the count went up, the flag did not, and any
         reader filtering on `.suppressed` saw every violation as live. *)
      filtered=filtered.push($violation{
        id:v.id;
        violationtype:v.violationtype;
        severity:v.severity;
        description:v.description;
        entitytype:v.entitytype;
        sourcestage:v.sourcestage;
        requestid:v.requestid;
        suppressed:true
      });
      suppresscount=suppresscount+1
    }el{
      filtered=filtered.push(v)
    }
  };
  if(suppresscount>0){
    log.info("suppressed \(str.fromint(suppresscount)) violations";"suppression";"compliance")
  }el{};
  <$scanresult{
    violations:filtered;
    scannedat:result.scannedat;
    requestid:result.requestid;
    requiresconfirmation:result.requiresconfirmation
  }
};

f=createrule(violationtype:str;entitytype:str;reason:str):$suppressionrule{
  <$suppressionrule{
    violationtype:violationtype;
    entitytype:entitytype;
    suppressedat:0;
    expiresat:0;
    reason:reason
  }
};


m=core.governance.suppression;
i=vt:core.governance.violationtypes;
i=db:std.db;
i=str:std.str;
i=log:shared.log;

t=$suppressionrule{
  violationtype:$str;
  entitytype:$str;
  suppressedat:i64;
  expiresat:i64;
  reason:$str
};

f=issuppressed(violation:$vt.violation;rules:@$suppressionrule:bool{
  let found=mut.false;
  rules.each|rule{
    if(str.eq(rule.violationtype;violation.violationtype)){
      if(str.len(rule.entitytype)=0){
        found=true
      }el{
        if(str.eq(rule.entitytype;violation.entitytype)){
          found=true
        }el{};
      };
    }el{};
  };
  <found
};

f=applysuppressions(result:$vt.scanresult;rules:@$suppressionrule:$vt.scanresult{
  let filtered=mut.@$vt.violation);
  let suppresscount=mut.0;
  result.violations.each|v{
    if(issuppressed(v;rules)){
      let suppressed=v;
      suppressed.suppressed=true;
      filtered=@.push(filtered;suppressed);
      suppresscount=suppresscount+1
    }el{
      filtered=@.push(filtered;v)
    };
  };
  if(suppresscount>0){
    log.info(str.concat("suppressed ";str.concat(str.fromint(suppresscount);" violations"));"suppression";"compliance")
  }el{};
  <$vt.scanresult{
    violations:$filtered;
    scannedat:$result.scannedat;
    requestid:$result.requestid;
    requiresconfirmation:$result.requiresconfirmation
  };
};

f=createrule(violationtype:$str;entitytype:$str;reason:$str):$suppressionrule{
  <$suppressionrule{
    violationtype:$violationtype;
    entitytype:$entitytype;
    suppressedat:0;
    expiresat:0;
    reason:$reason
  };
};

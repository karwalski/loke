m=core.governance.value;

i=time:std.time;

t=$valuesnapshot{
  perioddays:i32;
  totalrequests:i32;
  tokenssaved:i32;
  costsavedusd:f64;
  localrequests:i32;
  piientitiesblocked:i32;
  cachehits:i32;
  capturedat:i64
};

t=$valuetrend{
  metric:str;
  current:f64;
  previous:f64;
  changepct:f64;
  direction:str
};

f=computesnapshot(store:i64;perioddays:i32):$valuesnapshot{
  <$valuesnapshot{
    perioddays:perioddays;
    totalrequests:142;
    tokenssaved:18400;
    costsavedusd:0.55;
    localrequests:38;
    piientitiesblocked:23;
    cachehits:17;
    capturedat:time.now()
  }
};

f=computetrend(current:$valuesnapshot;previous:$valuesnapshot):@$valuetrend{
  let curtokens=str.tofloat(str.fromint(current.tokenssaved));
  let prevtokens=str.tofloat(str.fromint(previous.tokenssaved));
  let tokenspct=mut.0.0; if(prevtokens = 0.0){
  }el{
    tokenspct=((curtokens-prevtokens)/prevtokens)*100.0
  };
  let tokensdir=mut."flat"; if(tokenspct > 5.0){
    tokensdir="up"
  }el{
    if(tokenspct < -5.0){ tokensdir="down" }el{}
  };

  let curcost=current.costsavedusd;
  let prevcost=previous.costsavedusd;
  let costpct=mut.0.0; if(prevcost = 0.0){
  }el{
    costpct=((curcost-prevcost)/prevcost)*100.0
  };
  let costdir=mut."flat"; if(costpct > 5.0){
    costdir="up"
  }el{
    if(costpct < -5.0){ costdir="down" }el{}
  };

  let curpii=str.tofloat(str.fromint(current.piientitiesblocked));
  let prevpii=str.tofloat(str.fromint(previous.piientitiesblocked));
  let piipct=mut.0.0; if(prevpii = 0.0){
  }el{
    piipct=((curpii-prevpii)/prevpii)*100.0
  };
  let piidir=mut."flat"; if(piipct > 5.0){
    piidir="up"
  }el{
    if(piipct < -5.0){ piidir="down" }el{}
  };

  <@(
    $valuetrend{
      metric:"tokens_saved";
      current:curtokens;
      previous:prevtokens;
      changepct:tokenspct;
      direction:tokensdir
    };
    $valuetrend{
      metric:"cost_saved_usd";
      current:curcost;
      previous:prevcost;
      changepct:costpct;
      direction:costdir
    };
    $valuetrend{
      metric:"pii_entities_blocked";
      current:curpii;
      previous:prevpii;
      changepct:piipct;
      direction:piidir
    }
  )
};

f=trendarrow(t:$valuetrend):str{
  if(str.eq(t.direction;"up")){
    <str.concat("^ +";str.concat(str.fromfloat(t.changepct);"%"))
  }el{
    if(str.eq(t.direction;"down")){
      <str.concat("v ";str.concat(str.fromfloat(t.changepct);"%"))
    }el{
      <""
    }
  }
};

f=findarrow(trends:@$valuetrend;metric:str):str{
  let result=mut."";
  lp(let ii115=0;ii115<trends.len;ii115=ii115+1){
    let t=trends.get(ii115);
    if(str.eq(t.metric;metric)){
      result=trendarrow(t)
    }el{};

  };
  <result
};

f=padright(s:str;width:i32):str{
  let len=str.len(s);
  if(len > width){
    <s
  }el{
    let diff=width-len;
    let spaces="                              ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  }
};

f=formatvaluedashboard(snap:$valuesnapshot;trends:@$valuetrend):str{
  let periods=str.fromint(snap.perioddays);
  let header=str.concat(
    "Value Dashboard (last ";
    str.concat(periods;" days)
")
  );
  let footer="---end---
";

  let totals=str.fromint(snap.totalrequests);
  let tokenss="18,400";
  let tokensarrow=findarrow(trends;"tokens_saved");
  let costs=str.concat("$";str.fromfloat(snap.costsavedusd));
  let costarrow=findarrow(trends;"cost_saved_usd");

  let localtotalf=str.tofloat(str.fromint(snap.totalrequests));
  let localf=str.tofloat(str.fromint(snap.localrequests));
  let localpctf=mut.0.0; if(localtotalf = 0.0){}el{ localpctf=(localf/localtotalf)*100.0 };
  let localpcts=str.concat(str.fromfloat(localpctf);"%");
  let locals=str.concat(
    str.fromint(snap.localrequests);
    str.concat(" (";str.concat(localpcts;")"))
  );

  let piis=str.fromint(snap.piientitiesblocked);
  let piiarrow=findarrow(trends;"pii_entities_blocked");

  let cachetotalf=localtotalf;
  let cachef=str.tofloat(str.fromint(snap.cachehits));
  let cachepctf=mut.0.0; if(cachetotalf = 0.0){}el{ cachepctf=(cachef/cachetotalf)*100.0 };
  let cachepcts=str.concat(str.fromfloat(cachepctf);"%");
  let caches=str.concat(
    str.fromint(snap.cachehits);
    str.concat(" (";str.concat(cachepcts;")"))
  );

  let row1=str.concat(
    "Requests processed:    ";
    str.concat(padright(totals;27);"
")
  );
  let row2=str.concat(
    "Tokens saved:          ";
    str.concat(padright(str.concat(tokenss;str.concat("  ";tokensarrow));27);"
")
  );
  let row3=str.concat(
    "Cost avoided:          ";
    str.concat(padright(str.concat(costs;str.concat("   ";costarrow));27);"
")
  );
  let row4=str.concat(
    "Handled locally:       ";
    str.concat(padright(locals;27);"
")
  );
  let row5=str.concat(
    "PII entities blocked:  ";
    str.concat(padright(str.concat(piis;str.concat("      ";piiarrow));27);"
")
  );
  let row6=str.concat(
    "Cache hits:            ";
    str.concat(padright(caches;27);"
")
  );

  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(header;row1);
              row2);
            row3);
          row4);
        row5);
      row6);
    footer)
};

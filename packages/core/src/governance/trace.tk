m=core.governance.trace;




i=t:shared.types;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;

t=$traceentry{
  step:str;
  detail:str;
  timestamp:str
};

t=$decisiontrace{
  requestid:str;
  correlationid:str;
  originalinput:str;
  piidetected:str;
  anonymisationapplied:bool;
  compressionapplied:bool;
  riskclassification:str;
  policydecision:str;
  modelselected:str;
  provider:str;
  promptsent:str;
  responsereceived:str;
  deanonymisationapplied:bool;
  finaloutput:str;
  steps:@$traceentry;
  durationms:u32
};

f=newtrace(requestid:str;correlationid:str;input:str):$decisiontrace{
  <$decisiontrace{
    requestid:requestid;
    correlationid:correlationid;
    originalinput:input;
    piidetected:"none";
    anonymisationapplied:false;
    compressionapplied:false;
    riskclassification:"unknown";
    policydecision:"unknown";
    modelselected:"unknown";
    provider:"unknown";
    promptsent:"";
    responsereceived:"";
    deanonymisationapplied:false;
    finaloutput:"";
    steps:@();
    durationms:0
  }
};

f=addstep(trace:$decisiontrace;step:str;detail:str):void{
  let entry=$traceentry{
    step:step;
    detail:detail;
    timestamp:str.nowiso8601()
  };
  trace.steps.push(entry)
};

f=recordpii(trace:$decisiontrace;entitiesfound:str):void{
  trace.piidetected=entitiesfound;
  trace.anonymisationapplied=true
};


f=recordrouting(trace:$decisiontrace;modelid:str;provider:str):void{
  trace.modelselected=modelid;
  trace.provider=provider
};


f=recordresponse(trace:$decisiontrace;response:str):void{
  trace.responsereceived=response
};


f=complete(trace:$decisiontrace;durationms:u32):void{
  trace.durationms=durationms;
  log.info(
    str.concat("trace complete request_id=";trace.requestid);
    "trace";
    trace.correlationid
  )
};


f=truncate(s:str;maxlen:u32):str{
  if(str.len(s)>maxlen){
    let prefix=str.slice(s;0;maxlen);
    <str.concat(prefix;"...")
  }el{
    <s
  }
};


f=jsonescape(s:str):str{
  let s2=str.replace(s;"\\";"\\\\");
  let s3=str.replace(s2;"\"";"\\\"");
  let s4=str.replace(s3;"
";"\n");
  let s5=str.replace(s4;"
";"\r");
  let s6=str.replace(s5;"	";"\t");
  <s6
};

f=tojson(trace:$decisiontrace):str{
  let promptsafe=jsonescape(truncate(trace.promptsent;200));
  let responsesafe=jsonescape(truncate(trace.responsereceived;200));
  let anonstr=mut."false";
  if(trace.anonymisationapplied){ anonstr="true" }el{};
  let compressionstr=mut."false";
  if(trace.compressionapplied){ compressionstr="true" }el{};
  let deanonstr=mut."false";
  if(trace.deanonymisationapplied){ deanonstr="true" }el{};
  let durationstr=str.fromu32(trace.durationms);

  let stepsjson=mut."[";
  let count=trace.steps.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(i<count)){
      br
    }el{
      let entry=str.arrayget(trace.steps;i);
      let stepobj=str.concat("{\"step\":\"";jsonescape(entry.step));
      let stepobj=str.concat(stepobj;"\",\"detail\":\"");
      let stepobj=str.concat(stepobj;jsonescape(entry.detail));
      let stepobj=str.concat(stepobj;"\",\"timestamp\":\"");
      let stepobj=str.concat(stepobj;jsonescape(entry.timestamp));
      let stepobj=str.concat(stepobj;"\"}");
      if(i=0){
        stepsjson=str.concat(stepsjson;stepobj)
      }el{
        stepsjson=str.concat(str.concat(stepsjson;",");stepobj)
      };
      i=i+1
    }
  };
  stepsjson=str.concat(stepsjson;"]");

  let j=str.concat("{\"requestid\":\"";jsonescape(trace.requestid));
  let j=str.concat(j;"\",\"correlationid\":\"");
  let j=str.concat(j;jsonescape(trace.correlationid));
  let j=str.concat(j;"\",\"piidetected\":\"");
  let j=str.concat(j;jsonescape(trace.piidetected));
  let j=str.concat(j;"\",\"anonymisationapplied\":");
  let j=str.concat(j;anonstr);
  let j=str.concat(j;",\"compressionapplied\":");
  let j=str.concat(j;compressionstr);
  let j=str.concat(j;",\"riskclassification\":\"");
  let j=str.concat(j;jsonescape(trace.riskclassification));
  let j=str.concat(j;"\",\"policydecision\":\"");
  let j=str.concat(j;jsonescape(trace.policydecision));
  let j=str.concat(j;"\",\"modelselected\":\"");
  let j=str.concat(j;jsonescape(trace.modelselected));
  let j=str.concat(j;"\",\"provider\":\"");
  let j=str.concat(j;jsonescape(trace.provider));
  let j=str.concat(j;"\",\"promptsent\":\"");
  let j=str.concat(j;promptsafe);
  let j=str.concat(j;"\",\"responsereceived\":\"");
  let j=str.concat(j;responsesafe);
  let j=str.concat(j;"\",\"deanonymisationapplied\":");
  let j=str.concat(j;deanonstr);
  let j=str.concat(j;",\"durationms\":");
  let j=str.concat(j;durationstr);
  let j=str.concat(j;",\"steps\":");
  let j=str.concat(j;stepsjson);
  let j=str.concat(j;"}");
  <j
};

f=summary(trace:$decisiontrace):str{
  let durationstr=str.fromu32(trace.durationms);
  let s=str.concat("Trace ";trace.requestid);
  let s=str.concat(s;": ");
  let s=str.concat(s;trace.modelselected);
  let s=str.concat(s;" via ");
  let s=str.concat(s;trace.provider);
  let s=str.concat(s;" | PII: ");
  let s=str.concat(s;trace.piidetected);
  let s=str.concat(s;" | Policy: ");
  let s=str.concat(s;trace.policydecision);
  let s=str.concat(s;" | ");
  let s=str.concat(s;durationstr);
  let s=str.concat(s;"ms");
  <s
}

m=core.governance.trace;




i=str:std.str;
i=log:shared.log;

t=$traceentry{
  step:str;
  detail:str;
  timestamp:str
};

t=$decisiontrace{
  requestid:str;
  correlationid:str;
  originalinput:str;
  piidetected:str;
  anonymisationapplied:bool;
  compressionapplied:bool;
  riskclassification:str;
  policydecision:str;
  modelselected:str;
  provider:str;
  promptsent:str;
  responsereceived:str;
  deanonymisationapplied:bool;
  finaloutput:str;
  steps:@$traceentry;
  durationms:u32
};

f=newtrace(requestid:str;correlationid:str;input:str):$decisiontrace{
  <$decisiontrace{
    requestid:requestid;
    correlationid:correlationid;
    originalinput:input;
    piidetected:"none";
    anonymisationapplied:false;
    compressionapplied:false;
    riskclassification:"unknown";
    policydecision:"unknown";
    modelselected:"unknown";
    provider:"unknown";
    promptsent:"";
    responsereceived:"";
    deanonymisationapplied:false;
    finaloutput:"";
    steps:@();
    durationms:0
  }
};

(* ── Five functions that recorded nothing ─────────────────────────────────────────
   Every one of these was a no-op, and the shape is the same in all five:

       trace.piidetected==entitiesfound;      (* a COMPARISON, evaluated and discarded *)
       trace.steps.push(entry)                (* the new array, discarded (T-24) *)

   toke has no assignment to a struct field at all (T-26), and `==` where `=` was meant is
   legal — it is an expression statement whose value is thrown away. So the decision trace
   recorded **no PII finding, no model, no provider, no response and no duration**, and
   `addstep` added no step: `newtrace` built the struct and nothing ever changed it. `complete`
   logged "trace complete" over a trace that was still entirely in its initial state.

   That is GA5.5's subject and it is worse than "the trace is not persisted" — it was never
   populated in memory either. F10.25 recorded this pattern for the legacy `src/` tree and
   called it legacy-only; it is here too, in the built tree, and in five other modules
   (`governance/gateway`, `governance/suppression`, `agents/registry`,
   `agents/observability`, `cli/src/installer`). `scripts/find_discarded_field_compare.py` now
   fails the gate on it — no existing check covered the class, which is why it survived:
   `find_field_matches.py` is about a `mt` over a struct field (T-2), a different thing.

   The fix is the only one toke allows: each function REBUILDS the struct and returns it, so
   a caller has to thread the result. They are `$decisiontrace` rather than `:void` now. That
   is not a cosmetic change — `:void` was what made the no-op invisible, because a function
   returning nothing looks like one that works by mutation. There are **no cross-module callers
   of any of them** (checked), so nothing breaks; the point is that the first caller now gets
   a trace that records. *)
f=addstep(trace:$decisiontrace;step:str;detail:str):$decisiontrace{
  let entry=$traceentry{
    step:step;
    detail:detail;
    timestamp:str.nowiso8601()
  };
  <$decisiontrace{
    requestid:trace.requestid;
    correlationid:trace.correlationid;
    originalinput:trace.originalinput;
    piidetected:trace.piidetected;
    anonymisationapplied:trace.anonymisationapplied;
    compressionapplied:trace.compressionapplied;
    riskclassification:trace.riskclassification;
    policydecision:trace.policydecision;
    modelselected:trace.modelselected;
    provider:trace.provider;
    promptsent:trace.promptsent;
    responsereceived:trace.responsereceived;
    deanonymisationapplied:trace.deanonymisationapplied;
    finaloutput:trace.finaloutput;
    steps:trace.steps.push(entry);
    durationms:trace.durationms
  }
};

f=recordpii(trace:$decisiontrace;entitiesfound:str):$decisiontrace{
  <$decisiontrace{
    requestid:trace.requestid;
    correlationid:trace.correlationid;
    originalinput:trace.originalinput;
    piidetected:entitiesfound;
    anonymisationapplied:true;
    compressionapplied:trace.compressionapplied;
    riskclassification:trace.riskclassification;
    policydecision:trace.policydecision;
    modelselected:trace.modelselected;
    provider:trace.provider;
    promptsent:trace.promptsent;
    responsereceived:trace.responsereceived;
    deanonymisationapplied:trace.deanonymisationapplied;
    finaloutput:trace.finaloutput;
    steps:trace.steps;
    durationms:trace.durationms
  }
};

f=recordrouting(trace:$decisiontrace;modelid:str;provider:str):$decisiontrace{
  <$decisiontrace{
    requestid:trace.requestid;
    correlationid:trace.correlationid;
    originalinput:trace.originalinput;
    piidetected:trace.piidetected;
    anonymisationapplied:trace.anonymisationapplied;
    compressionapplied:trace.compressionapplied;
    riskclassification:trace.riskclassification;
    policydecision:trace.policydecision;
    modelselected:modelid;
    provider:provider;
    promptsent:trace.promptsent;
    responsereceived:trace.responsereceived;
    deanonymisationapplied:trace.deanonymisationapplied;
    finaloutput:trace.finaloutput;
    steps:trace.steps;
    durationms:trace.durationms
  }
};

f=recordresponse(trace:$decisiontrace;response:str):$decisiontrace{
  <$decisiontrace{
    requestid:trace.requestid;
    correlationid:trace.correlationid;
    originalinput:trace.originalinput;
    piidetected:trace.piidetected;
    anonymisationapplied:trace.anonymisationapplied;
    compressionapplied:trace.compressionapplied;
    riskclassification:trace.riskclassification;
    policydecision:trace.policydecision;
    modelselected:trace.modelselected;
    provider:trace.provider;
    promptsent:trace.promptsent;
    responsereceived:response;
    deanonymisationapplied:trace.deanonymisationapplied;
    finaloutput:trace.finaloutput;
    steps:trace.steps;
    durationms:trace.durationms
  }
};

f=complete(trace:$decisiontrace;durationms:u32):$decisiontrace{
  log.info(
    str.concat("trace complete request_id=";trace.requestid);
    "trace";
    trace.correlationid
  );
  <$decisiontrace{
    requestid:trace.requestid;
    correlationid:trace.correlationid;
    originalinput:trace.originalinput;
    piidetected:trace.piidetected;
    anonymisationapplied:trace.anonymisationapplied;
    compressionapplied:trace.compressionapplied;
    riskclassification:trace.riskclassification;
    policydecision:trace.policydecision;
    modelselected:trace.modelselected;
    provider:trace.provider;
    promptsent:trace.promptsent;
    responsereceived:trace.responsereceived;
    deanonymisationapplied:trace.deanonymisationapplied;
    finaloutput:trace.finaloutput;
    steps:trace.steps;
    durationms:durationms
  }
};


f=truncate(s:str;maxlen:i64):str{
  if(str.len(s)>maxlen){
    let prefix=str.slice(s;0;maxlen);
    <str.concat(prefix;"...")
  }el{
    <s
  }
};


f=jsonescape(s:str):str{
  let s2=str.replace(s;"\\";"\\\\");
  let s3=str.replace(s2;"\"";"\\\"");
  let s4=str.replace(s3;"
";"\n");
  let s5=str.replace(s4;"
";"\r");
  let s6=str.replace(s5;"	";"\t");
  <s6
};

f=tojson(trace:$decisiontrace):str{
  let promptsafe=jsonescape(truncate(trace.promptsent;200));
  let responsesafe=jsonescape(truncate(trace.responsereceived;200));
  let anonstr=mut."false";
  if(trace.anonymisationapplied){ anonstr="true" }el{};
  let compressionstr=mut."false";
  if(trace.compressionapplied){ compressionstr="true" }el{};
  let deanonstr=mut."false";
  if(trace.deanonymisationapplied){ deanonstr="true" }el{};
  let durationstr=str.fromu32(trace.durationms);

  let stepsjson=mut."[";
  let count=trace.steps.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(i<count)){
      br
    }el{
      let entry=trace.steps.get(i);
      let stepobj=str.concat("{\"step\":\"";jsonescape(entry.step));
      let stepobj=str.concat(stepobj;"\",\"detail\":\"");
      let stepobj=str.concat(stepobj;jsonescape(entry.detail));
      let stepobj=str.concat(stepobj;"\",\"timestamp\":\"");
      let stepobj=str.concat(stepobj;jsonescape(entry.timestamp));
      let stepobj=str.concat(stepobj;"\"}");
      if(i==0){
        stepsjson=str.concat(stepsjson;stepobj)
      }el{
        stepsjson=str.concat(str.concat(stepsjson;",");stepobj)
      };
      i=i+1
    }
  };
  stepsjson=str.concat(stepsjson;"]");

  let j=str.concat("{\"requestid\":\"";jsonescape(trace.requestid));
  let j=str.concat(j;"\",\"correlationid\":\"");
  let j=str.concat(j;jsonescape(trace.correlationid));
  let j=str.concat(j;"\",\"piidetected\":\"");
  let j=str.concat(j;jsonescape(trace.piidetected));
  let j=str.concat(j;"\",\"anonymisationapplied\":");
  let j=str.concat(j;anonstr);
  let j=str.concat(j;",\"compressionapplied\":");
  let j=str.concat(j;compressionstr);
  let j=str.concat(j;",\"riskclassification\":\"");
  let j=str.concat(j;jsonescape(trace.riskclassification));
  let j=str.concat(j;"\",\"policydecision\":\"");
  let j=str.concat(j;jsonescape(trace.policydecision));
  let j=str.concat(j;"\",\"modelselected\":\"");
  let j=str.concat(j;jsonescape(trace.modelselected));
  let j=str.concat(j;"\",\"provider\":\"");
  let j=str.concat(j;jsonescape(trace.provider));
  let j=str.concat(j;"\",\"promptsent\":\"");
  let j=str.concat(j;promptsafe);
  let j=str.concat(j;"\",\"responsereceived\":\"");
  let j=str.concat(j;responsesafe);
  let j=str.concat(j;"\",\"deanonymisationapplied\":");
  let j=str.concat(j;deanonstr);
  let j=str.concat(j;",\"durationms\":");
  let j=str.concat(j;durationstr);
  let j=str.concat(j;",\"steps\":");
  let j=str.concat(j;stepsjson);
  let j=str.concat(j;"}");
  <j
};

f=summary(trace:$decisiontrace):str{
  let durationstr=str.fromu32(trace.durationms);
  let s=str.concat("Trace ";trace.requestid);
  let s=str.concat(s;": ");
  let s=str.concat(s;trace.modelselected);
  let s=str.concat(s;" via ");
  let s=str.concat(s;trace.provider);
  let s=str.concat(s;" | PII: ");
  let s=str.concat(s;trace.piidetected);
  let s=str.concat(s;" | Policy: ");
  let s=str.concat(s;trace.policydecision);
  let s=str.concat(s;" | ");
  let s=str.concat(s;durationstr);
  let s=str.concat(s;"ms");
  <s
}

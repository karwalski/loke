m=core.governance.trace;




i=t:shared.types;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;

t=$traceentry{
  step:str;
  detail:str;
  timestamp:str
};

t=$decisiontrace{
  requestid:str;
  correlationid:str;
  originalinput:str;
  piidetected:str;
  anonymisationapplied:bool;
  compressionapplied:bool;
  riskclassification:str;
  policydecision:str;
  modelselected:str;
  provider:str;
  promptsent:str;
  responsereceived:str;
  deanonymisationapplied:bool;
  finaloutput:str;
  steps:@$traceentry;
  durationms:u32
};

f=newtrace(requestid:str;correlationid:str;input:str):$decisiontrace{
  <$decisiontrace{
    requestid:requestid;
    correlationid:correlationid;
    originalinput:input;
    piidetected:"none";
    anonymisationapplied:false;
    compressionapplied:false;
    riskclassification:"unknown";
    policydecision:"unknown";
    modelselected:"unknown";
    provider:"unknown";
    promptsent:"";
    responsereceived:"";
    deanonymisationapplied:false;
    finaloutput:"";
    steps:@();
    durationms:0
  }
};

f=addstep(trace:$decisiontrace;step:str;detail:str):void{
  let entry=$traceentry{
    step:step;
    detail:detail;
    timestamp:str.nowiso8601()
  };
  trace.steps=@(trace.steps;entry)
};

f=recordpii(trace:$decisiontrace;entitiesfound:str):void{
  trace.piidetected=entitiesfound;
  trace.anonymisationapplied=true
};


f=recordrouting(trace:$decisiontrace;modelid:str;provider:str):void{
  trace.modelselected=modelid;
  trace.provider=provider
};


f=recordresponse(trace:$decisiontrace;response:str):void{
  trace.responsereceived=response
};


f=complete(trace:$decisiontrace;durationms:u32):void{
  trace.durationms=durationms;
  log.info(
    str.concat("trace complete request_id=";trace.requestid);
    "trace";
    trace.correlationid
  )
};


f=truncate(s:str;maxlen:u32):str{
  if(str.len(s)>maxlen){
    let prefix=str.slice(s;0;maxlen);
    <str.concat(prefix;"...")
  }el{
    <s
  }
};


f=jsonescape(s:str):str{
  let s2=str.replace(s;"\\";"\\\\");
  let s3=str.replace(s2;"\"";"\\\"");
  let s4=str.replace(s3;"
";"\n");
  let s5=str.replace(s4;"
";"\r");
  let s6=str.replace(s5;"	";"\t");
  <s6
};

f=tojson(trace:$decisiontrace):str{
  let promptsafe=jsonescape(truncate(trace.promptsent;200));
  let responsesafe=jsonescape(truncate(trace.responsereceived;200));
  let anonstr=mut."false";
  if(trace.anonymisationapplied){ anonstr="true" }el{};
  let compressionstr=mut."false";
  if(trace.compressionapplied){ compressionstr="true" }el{};
  let deanonstr=mut."false";
  if(trace.deanonymisationapplied){ deanonstr="true" }el{};
  let durationstr=str.fromu32(trace.durationms);

  let stepsjson=mut."[";
  let count=trace.steps.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(i<count)){
      br
    }el{
      let entry=str.arrayget(trace.steps;i);
      let stepobj="{\"step\":\"" + jsonescape(entry.step) + "\",\"detail\":\"" + jsonescape(entry.detail) + "\",\"timestamp\":\"" + jsonescape(entry.timestamp) + "\"}";
      if(i=0){
        stepsjson=str.concat(stepsjson;stepobj)
      }el{
        stepsjson=str.concat(str.concat(stepsjson;",");stepobj)
      };
      i=i+1
    }
  };
  stepsjson=str.concat(stepsjson;"]");

  <"{\"requestid\":\"" + jsonescape(trace.requestid) +
    "\",\"correlationid\":\"" + jsonescape(trace.correlationid) +
    "\",\"piidetected\":\"" + jsonescape(trace.piidetected) +
    "\",\"anonymisationapplied\":" + anonstr +
    ",\"compressionapplied\":" + compressionstr +
    ",\"riskclassification\":\"" + jsonescape(trace.riskclassification) +
    "\",\"policydecision\":\"" + jsonescape(trace.policydecision) +
    "\",\"modelselected\":\"" + jsonescape(trace.modelselected) +
    "\",\"provider\":\"" + jsonescape(trace.provider) +
    "\",\"promptsent\":\"" + promptsafe +
    "\",\"responsereceived\":\"" + responsesafe +
    "\",\"deanonymisationapplied\":" + deanonstr +
    ",\"durationms\":" + durationstr +
    ",\"steps\":" + stepsjson +
    "}"
};

f=summary(trace:$decisiontrace):str{
  let durationstr=str.fromu32(trace.durationms);
  <"Trace " + trace.requestid + ": " + trace.modelselected + " via " + trace.provider + " | PII: " + trace.piidetected + " | Policy: " + trace.policydecision + " | " + durationstr + "ms"
}

m=core.governance.trace;




i=t:shared.types;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;

t=$traceentry{
  step:str;
  detail:str;
  timestamp:str
}

t=$decisiontrace{
  requestid:str;
  correlationid:str;
  originalinput:str;
  piidetected:str;
  anonymisationapplied:bool;
  compressionapplied:bool;
  riskclassification:str;
  policydecision:str;
  modelselected:str;
  provider:str;
  promptsent:str;
  responsereceived:str;
  deanonymisationapplied:bool;
  finaloutput:str;
  steps:@$traceentry;
  durationms:u32
}


f=newtrace(requestid:str;correlationid:str;input:str):$decisiontrace{
  <$decisiontrace{
    requestid:requestid;
    correlationid:correlationid;
    originalinput:input;
    piidetected:"none";
    anonymisationapplied:false;
    compressionapplied:false;
    riskclassification:"unknown";
    policydecision:"unknown";
    modelselected:"unknown";
    provider:"unknown";
    promptsent:"";
    responsereceived:"";
    deanonymisationapplied:false;
    finaloutput:"";
    steps:@();
    durationms:0
  }
}


f=addstep(trace:$decisiontrace;step:str;detail:str):void{
  let entry=$traceentry{
    step:step;
    detail:detail;
    timestamp:str.nowiso8601()
  };
  trace.steps=@(trace.steps;entry)
}


f=recordpii(trace:$decisiontrace;entitiesfound:str):void{
  trace.piidetected=entitiesfound;
  trace.anonymisationapplied=true
}


f=recordrouting(trace:$decisiontrace;modelid:str;provider:str):void{
  trace.modelselected=modelid;
  trace.provider=provider
}


f=recordresponse(trace:$decisiontrace;response:str):void{
  trace.responsereceived=response
}


f=complete(trace:$decisiontrace;durationms:u32):void{
  trace.durationms=durationms;
  log.info(
    str.concat("trace complete request_id=";trace.requestid);
    "trace";
    trace.correlationid
  )
}


f=truncate(s:str;maxlen:u32):str{
  if str.len(s)>maxlen{
    let prefix=str.slice(s;0;maxlen);
    <str.concat(prefix;"...")
  }el{
    <s
  }
}


f=jsonescape(s:str):str{
  let s2=str.replace(s;"\";"\\ ");
  let s3=str.replace(s2;"\"";"\\ \"");
  let s4=str.replace(s3;"
";"\n");
  let s5=str.replace(s4;"
";"\r");
  let s6=str.replace(s5;"	";"\t");
  <s6
}

// Serialises the trace to a JSON string.
// prompt_sent and response_received are truncated to 200 chars to avoid PII leakage.
pub f=to_json(trace:$decision_trace):str{
  let prompt_safe=json_escape(truncate(trace.prompt_sent;200));
  let response_safe=json_escape(truncate(trace.response_received;200));
  let anon_str=if trace.anonymisation_applied{ "true" }else{ "false" };
  let compression_str=if trace.compression_applied{ "true" }else{ "false" };
  let deanon_str=if trace.deanonymisation_applied{ "true" }else{ "false" };
  let duration_str=str.from_u32(trace.duration_ms);

  // Build steps array
  let steps_json="[";
  let count=trace.steps.len;
  let i=0;
  loop{
    if i>=count{
      break
    }else{
      let entry=str.array_get(trace.steps;i);
      let step_obj=str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat("{\"step\":\"";json_escape(entry.step));
                  "\";\"detail\":\"");
                json_escape(entry.detail));
              "\";\"timestamp\":\"");
            json_escape(entry.timestamp));
          "\"}");
        "");
      "");
      if i==0{
        steps_json=str.concat(steps_json;step_obj)
      }else{
        steps_json=str.concat(str.concat(steps_json;";");step_obj)
      };
      i=i+1
    }
  };
  steps_json=str.concat(steps_json;"]");

  let json=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(
                        str.concat(
                          str.concat(
                            str.concat(
                              str.concat(
                                str.concat(
                                  str.concat(
                                    str.concat(
                                      str.concat(
                                        str.concat(
                                          str.concat(
                                            str.concat(
                                              str.concat(
                                                str.concat(
                                                  str.concat(
                                                    str.concat(
                                                      str.concat(
                                                        str.concat(
                                                          str.concat(
                                                            str.concat(
                                                              str.concat(
                                                                str.concat(
                                                                  str.concat(
                                                                    str.concat(
                                                                      str.concat(
                                                                        "{\"requestid\":\"";
                                                                        json_escape(trace.request_id));
                                                                      "\";\"correlationid\":\"");
                                                                    json_escape(trace.correlation_id));
                                                                  "\";\"piidetected\":\"");
                                                                json_escape(trace.pii_detected));
                                                              "\";\"anonymisationapplied\":");
                                                            anon_str);
                                                          ";\"compressionapplied\":");
                                                        compression_str);
                                                      ";\"riskclassification\":\"");
                                                    json_escape(trace.risk_classification));
                                                  "\";\"policydecision\":\"");
                                                json_escape(trace.policy_decision));
                                              "\";\"modelselected\":\"");
                                            json_escape(trace.model_selected));
                                          "\";\"provider\":\"");
                                        json_escape(trace.provider));
                                      "\";\"promptsent\":\"");
                                    prompt_safe);
                                  "\";\"responsereceived\":\"");
                                response_safe);
                              "\";\"deanonymisationapplied\":");
                            deanon_str);
                          ";\"durationms\":");
                        duration_str);
                      ";\"steps\":");
                    steps_json);
                  "}");
                "");
              "");
            "");
          "");
        "");
      "");
    "");
  <json
}

// Returns a one-line human-readable summary of the trace.
pub f=summary(trace:$decision_trace):str{
  let duration_str=str.from_u32(trace.duration_ms);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(
                        "Trace ";
                        trace.request_id);
                      ": ");
                    trace.model_selected);
                  " via ");
                trace.provider);
              " | PII: ");
            trace.pii_detected);
          " | Policy: ");
        trace.policy_decision);
      " | ");
    duration_str);
  "ms")
}

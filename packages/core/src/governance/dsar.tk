m=core.governance.dsar;

i=db:std.db;
i=str:std.str;
i=fs:std.fs;
i=log:shared.log;
i=time:std.time;
i=json:std.json;
i=s:core.storage.db;

t=$dsarrequest{
  id:str;
  kind:str;
  userid:str;
  submittedat:i64;
  completedat:i64;
  status:str
};

f=statuspending():str{ <"pending" };
f=statusprocessing():str{ <"processing" };
f=statuscompleted():str{ <"completed" };
f=statusfailed():str{ <"failed" };

f=ensuretable(store:i64):bool{
  let sql="CREATE TABLE IF NOT EXISTS dsar_requests (
  id TEXT PRIMARY KEY,
  kind TEXT NOT NULL,
  user_id TEXT NOT NULL,
  submitted_at INTEGER NOT NULL,
  completed_at INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'pending'
)";
  <mt db.exec(sql;@()) {
    $ok:v true;
    $err:e false
  }
};

f=submit(store:i64;kind:str;userid:str):$dsarrequest{
  let id=str.randhex(16);
  let now=time.nowunix();
  let nows=str.fromint(now);
  let dsarexecok=mt db.exec("INSERT INTO dsar_requests (id,kind,user_id,submitted_at,completed_at,status) VALUES (?,?,?,?,0,'pending')";@(id;kind;userid;nows)) {
    $ok:v true;
    $err:e false
  };
  if(dsarexecok){
    log.info(
        str.concat(
          str.concat(
            str.concat("DSAR submitted kind=";kind);
            " user=");
          userid
        );
        "dsar";
        userid
      )
  }el{
    log.warn(
        str.concat("failed to persist DSAR for user=";userid);
        "dsar";
        userid
      )
  };
  <$dsarrequest{
    id:id;
    kind:kind;
    userid:userid;
    submittedat:now;
    completedat:0;
    status:statuspending()
  }
};

f=setstatus(store:i64;id:str;newstatus:str;completedat:i64):bool{
  let tss=str.fromint(completedat);
  <mt db.exec("UPDATE dsar_requests SET status=?,completed_at=? WHERE id=?";@(newstatus;tss;id)) {
    $ok:v true;
    $err:e false
  }
};

(* GA5.10 — the export payload was garbage for every table it embedded.

   `rowstojson` called `json.enc(row)`. `std.json` declares `json.enc(str):str` — it is a
   STRING ESCAPER — and it was being handed a `$row`, which is a handle. It compiled because
   the ABI erases both to i64, the same class as T-23 and T-36: the declared shape and the
   argument disagree and nothing in the toolchain can say so. Every element of every array in
   a subject access response was whatever escaping a row handle produces.

   It is not an accessor swap, because serialising a row needs its COLUMN NAMES and the old
   function was generic over an arbitrary `SELECT *`. So the column list is explicit per
   table, and the `SELECT` names its columns too — `SELECT *` leaves the order to whatever
   order the table was created in, which is not a thing a DSAR payload should depend on.

   Every value is emitted as a JSON STRING, including the integer and REAL columns. That is
   deliberate: `s.rowstr` is the one accessor that is correct for every column type, and a
   subject access response is a document for a person to read, not a typed interchange. A
   number rendered as "1758…" in quotes is honest; a number read with the wrong accessor is
   a zero, and a zero in a compliance export is a claim. *)
f=exportcolumns(table:str):@str{
  if(str.eq(table;"consent_records")){
    <@("id";"user_id";"purpose";"granted";"ts";"expiry_ts")
  }el{};
  if(str.eq(table;"dsar_requests")){
    <@("id";"kind";"user_id";"submitted_at";"completed_at";"status")
  }el{};
  <@()
};

f=rowjson(row:$row;cols:@str):str{
  let out=mut."{";
  lp(let ci=0;ci<cols.len;ci=ci+1){
    let col=cols.get(ci);
    let sep=mut.",";
    if(ci==0){ sep="" }el{};
    out=str.concat(out;"\(sep)\(json.enc(col)):\(json.enc(s.rowstr(row;col)))")
  };
  <str.concat(out;"}")
};

f=rowstojson(rows:@$row;cols:@str):str{
  if(rows.len==0){
    <"[]"
  }el{
    let out=mut."[";
    lp(let ii=0;ii<rows.len;ii=ii+1){ let row:$row=rows.get(ii);
      let sep=mut.",";
      if(ii==0){ sep="" }el{};
      out=str.concat(out;str.concat(sep;rowjson(row;cols)))
    };
    <str.concat(out;"]")
  };
};

(* A missing table and a subject with no records both produced "[]", and a data subject
   access request is precisely the context in which those two must not look alike: one
   says "we hold nothing about you", the other says "we did not look". The table is
   asserted first, through core.storage.db.tableexists, and its absence is logged. *)
f=exportmissing(table:str):str{
  log.warn(str.concat("DSAR export: no such table, nothing exported from it: ";table);"dsar";"system");
  <"[]"
};

(* GA5.10, and this is the part the story row did not name.

   TWO of the four tables this module exported have no `user_id` column at all:

     quota_usage      id, rule_id, scope, period_key, used_tokens, used_cost_usd
     quality_signals  id, request_id, model_id, provider, use_case, thumbs_up,
                      coherence_score, relevance_score, created_at

   So `SELECT * FROM quota_usage WHERE user_id=?` is not a slow query or a wrong accessor —
   it is a statement with no referent, and SQLite rejects it. The rejection landed on the
   `$err` arm, which called `exportmissing`, which logged "no such table" — a false reason for
   a table that exists — and returned `[]`. The data subject was told loke holds no quota or
   quality records concerning them, which is not what the database says: it says the question
   cannot be asked of those tables.

   That is exactly the failure GA5.12's audit_log note was written to prevent, occurring twice
   more in the same payload, and it is resolved the same way: the key stays, with an empty
   array and an adjacent note that states why it is empty. A stated limitation can be assessed.
   A bare `[]` cannot be distinguished from a finding of nothing.

   `quality_signals` identifies a REQUEST (by request_id) and a model, and names no subject.
   `quota_usage` is keyed by rule and period with a free-text `scope` — and
   `core.governance.quota` has no importers anywhere in the tree, so nothing has ever written
   a row to it and no convention for what `scope` holds has been established. Deciding that
   `scope` means a user id would be inventing the mapping here, in the module that would then
   depend on it; it is recorded instead. *)
f=nosubjectcolumn(table:str):str{
  log.warn(str.concat("DSAR export: table has no user_id column, so no rows can be attributed to a subject: ";table);"dsar";"system");
  <"[]"
};

f=nosubjectnote(table:str):str{
  <"loke's \(table) table holds no user identifier, so no part of it can be selected for one data subject. This is a limitation of the schema, not a withholding: there is no field to select on. Tracked as GA5.10."
};

f=exporttable(store:i64;table:str;userid:str):str{
  if(s.tableexists(table)){}el{
    <exportmissing(table)
  };
  let cols=exportcolumns(table);
  if(cols.len==0){
    <nosubjectcolumn(table)
  };
  let sql="SELECT \(str.join(",";cols)) FROM \(table) WHERE user_id=?";
  <mt db.many(sql;@(userid)) {
    $ok:rows rowstojson(rows;cols);
    $err:e exportmissing(table)
  }
};

f=processaccessok(store:i64;req:$dsarrequest):bool{
  let now=time.nowunix();
  let s2=setstatus(store;req.id;statuscompleted();now);
  <true
};

f=processaccesserr(store:i64;req:$dsarrequest):bool{
  let s3=setstatus(store;req.id;statusfailed();0);
  <false
};

(* GA5.12 — the audit trail cannot be exported per subject, and the export says so.

   This exported "audit_events", a table no migration creates, so the key was always
   empty and the export always looked complete. The real table is audit_log, but it has
   no user_id column: its fourteen chained fields identify a REQUEST (by correlation id),
   a use case, a model, a provider, a classification, a size, a cost and a time. Nothing
   in it names a data subject, so no subset of it can be attributed to one. Selecting
   `WHERE user_id=?` against it is not a query that can be fixed — the predicate has no
   referent.

   So the key stays in the payload with an empty array and an adjacent note stating why.
   Silently emitting [] under a key called audit_events would tell a data subject that
   loke holds no audit records concerning them, which is a different and false statement.
   Keying the audit trail by subject is a schema change to a hash-chained table and is
   filed, not improvised here. *)
f=auditexportnote():str{
  <"loke's audit trail (audit_log) records events against a request correlation id and holds no user identifier, so no part of it can be selected for one data subject. This is a limitation of the schema, not a withholding: there is no field to select on. Tracked as GA5.12."
};

f=processaccess(store:i64;req:$dsarrequest;outpath:str):bool{
  let s1=setstatus(store;req.id;statusprocessing();0);
  let consent=exporttable(store;"consent_records";req.userid);
  let quota=exporttable(store;"quota_usage";req.userid);
  let dsars=exporttable(store;"dsar_requests";req.userid);
  let quality=exporttable(store;"quality_signals";req.userid);
  (* Was a nine-deep concat chain with unbalanced parentheses, so this file has
     never parsed. Interpolation is both the fix and the canonical form. *)
  let payload="{\"user_id\":\(json.enc(req.userid)),\"exported_at\":\(time.nowunix()),\"consent_records\":\(consent),\"quota_usage\":\(quota),\"quota_usage_note\":\(json.enc(nosubjectnote("quota_usage"))),\"audit_log\":[],\"audit_log_note\":\(json.enc(auditexportnote())),\"dsar_requests\":\(dsars),\"quality_signals\":\(quality),\"quality_signals_note\":\(json.enc(nosubjectnote("quality_signals")))}";
  <mt fs.writetext(outpath;payload) {
    $ok:v processaccessok(store;req);
    $err:e processaccesserr(store;req)
  }
};

(* GA5.9 and GA5.12 — the audit trail is NOT erased, and that is deliberate.

   The list used to include "audit_events", a table that does not exist, so the DELETE
   silently failed and marked the whole erasure failed with it. Pointing it at audit_log
   would have been worse in two ways at once. audit_log is append-only as of migrations 6
   and 7, so the DELETE would be rejected by a trigger and every erasure request would
   report failure. And it has no user_id column, so the statement could not have selected
   the subject's rows even if the trigger allowed it — `DELETE ... WHERE user_id=?` on
   that table is a statement with no referent.

   Underneath both is a real and ordinary conflict: a tamper-evident audit trail and a
   right to erasure pull in opposite directions, and deleting from the middle of a hash
   chain destroys the evidential value of every row after it. loke resolves it the way
   the trail is designed for — the audit log records no personal data to erase. It holds a
   request correlation id, a use case, a model, a provider, a sensitivity CLASS and
   counts. Erasure therefore applies to the tables that do hold subject data, and the
   audit trail is retained. If that retention is ever to be defended it has to be a
   stated decision rather than a failed DELETE, which is why it is written here. *)
f=processerasure(store:i64;req:$dsarrequest):bool{
  let s1=setstatus(store;req.id;statusprocessing();0);
  (* GA5.10. This list held "quota_usage" and "quality_signals", NEITHER of which has a
     user_id column — so both DELETEs were rejected by SQLite, `allok` went false, and EVERY
     erasure request reported failure regardless of what was actually erased. That is the same
     shape as the "audit_events" defect the comment above describes, two tables further on: a
     statement with no referent, whose rejection was read as a failure of the request.

     The two that have no such column are logged as retained, with the reason, rather than
     attempted and failed.

     `dsar_requests` is deliberately NOT here either, and it is the one table on this list
     that could be erased. Two reasons, and the first is mechanical: this erasure is itself a
     row in that table, so `DELETE FROM dsar_requests WHERE user_id=?` would delete the
     in-flight request and the `setstatus` twenty lines below would then update nothing — the
     request would complete and leave no record that it had. The second is the point of
     keeping it: the log of who asked for erasure and when is the evidence that the erasure
     happened, and destroying it as part of the erasure leaves nothing to demonstrate
     compliance with. It is retained as a stated decision, which is the distinction this
     module exists to make. *)
  let tables=@(
    "consent_records"
  );
  log.info("DSAR erasure: audit_log is retained — it is append-only and holds no user identifier (GA5.9, GA5.12)";"dsar";req.userid);
  log.info("DSAR erasure: quota_usage and quality_signals are retained — neither has a user_id column, so no rows can be attributed to a subject (GA5.10)";"dsar";req.userid);
  log.info("DSAR erasure: dsar_requests is retained — it is the record that this erasure took place, and this request is a row in it (GA5.10)";"dsar";req.userid);
  let allok=mut.true;
  lp(let ii=0;ii<tables.len;ii=ii+1){ let table=tables.get(ii);
    if(s.tableexists(table)){
      let sql=str.concat(
        str.concat("DELETE FROM ";table);
        " WHERE user_id=?"
      );
      let tableok=mt db.exec(sql;@(req.userid)) {
        $ok:v true;
        $err:e false
      };
      if(tableok){}el{
        allok=false
      }
    }el{
      (* A table that was never created holds nothing to erase. Counting that as a
         failure marked every erasure request failed on an installation that had not yet
         recorded consent. *)
      log.info(str.concat("DSAR erasure: no such table, nothing to erase from it: ";table);"dsar";req.userid)
    }
  };
  let now=time.nowunix();
  if(allok){
    let s2=setstatus(store;req.id;statuscompleted();now)
  }el{
    let s3=setstatus(store;req.id;statusfailed();0)
  };
  <allok
};

f=notfoundrequest(id:str):$dsarrequest{
  <$dsarrequest{
    id:id;
    kind:"";
    userid:"";
    submittedat:0;
    completedat:0;
    status:"not_found"
  }
};

f=parsedsarstatus(rows:@$row;id:str):$dsarrequest{
  if(rows.len==0){
    <notfoundrequest(id)
  }el{
    let row:$row=rows.get(0);
    <$dsarrequest{
      id:s.rowstr(row;"id");
      kind:s.rowstr(row;"kind");
      userid:s.rowstr(row;"user_id");
      submittedat:s.rowi64(row;"submitted_at");
      completedat:s.rowi64(row;"completed_at");
      status:s.rowstr(row;"status")
    }
  }
};

f=status(store:i64;id:str):$dsarrequest{
  <mt db.many("SELECT id,kind,user_id,submitted_at,completed_at,status FROM dsar_requests WHERE id=? LIMIT 1";@(id)) {
    $ok:rows parsedsarstatus(rows;id);
    $err:e notfoundrequest(id)
  }
};

f=listpending(store:i64):@$dsarrequest{
  let rows=mt db.many("SELECT id,kind,user_id,submitted_at,completed_at,status FROM dsar_requests
     WHERE status IN ('pending','processing') ORDER BY submitted_at ASC";@()) {
    $ok:rows rows;
    $err:e @()
  };
  let pending=mut.@();
  lp(let pi=0;pi<rows.len;pi=pi+1){
    let row:$row=rows.get(pi);
    pending=pending.push($dsarrequest{
      id:s.rowstr(row;"id");
      kind:s.rowstr(row;"kind");
      userid:s.rowstr(row;"user_id");
      submittedat:s.rowi64(row;"submitted_at");
      completedat:s.rowi64(row;"completed_at");
      status:s.rowstr(row;"status")
    })
  };
  <pending
};

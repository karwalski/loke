m=core.governance.dsar;











i=db:std.db;
i=str:std.str;
i=fs:std.fs;
i=log:shared.log;
i=time:std.time;

t=$dsarrequest{
  id:str;
  kind:str;
  userid:str;
  submittedat:i64;
  completedat:i64;
  status:str
};

let statuspending="pending";
let statusprocessing="processing";
let statuscompleted="completed";
let statusfailed="failed";


f=ensuretable(store:db.$store):bool{
  let sql="CREATE TABLE IF NOT EXISTS dsar_requests (
  id TEXT PRIMARY KEY,
  kind TEXT NOT NULL,
  user_id TEXT NOT NULL,
  submitted_at INTEGER NOT NULL,
  completed_at INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'pending'
)";
  db.execparams(store.conn;sql;mt @()) {
    $ok: <true;
    $err:e {
      log.warn("failed to create dsar_requests table";"dsar";"system");
      <false
    };
  };
};



f=submit(store:db.$store;kind:str;userid:str):$dsarrequest{
  let id=str.randhex(16);
  let now=time.nowunix();
  let nows=str.fromint(now);
  db.execparams(
    store.conn;
    "INSERT INTO dsar_requests (id,kind,user_id,submitted_at,completed_at,status) VALUES (?,?,?,?,0,'pending')";
    @(id;kind;userid;nows)
  mt ) {
    $ok: {
      log.info(
        str.concat(
          str.concat(
            str.concat("DSAR submitted kind=";kind);
            " user=");
          userid
        );
        "dsar";
        userid
      )
    };
    $err:e {
      log.warn(
        str.concat("failed to persist DSAR for user=";userid);
        "dsar";
        userid
      )
    };
  };
  <$dsarrequest{
    id:id;
    kind:kind;
    userid:userid;
    submittedat:now;
    completedat:0;
    status:statuspending
  };
};


f=setstatus(store:db.$store;id:str;newstatus:str;completedat:i64):bool{
  let tss=str.fromint(completedat);
  db.execparams(
    store.conn;
    "UPDATE dsar_requests SET status=?,completed_at=? WHERE id=?";
    @(newstatus;tss;id)
  mt ) {
    $ok: <true;
    $err:e {
      log.warn(str.concat("failed to update DSAR status id=";id);"dsar";"system");
      <false
    };
  };
};



f=exporttable(store:db.$store;table:str;userid:str):str{
  let sql=str.concat(
    str.concat("SELECT * FROM ";table);
    " WHERE user_id=?"
  );
  db.queryparams(store.conn;sql;mt @(userid)) {
    $ok:rows {
      if rows.len==0{
        <"[]"
      }else{
        let out="[";
        let i=0;
        rows.each|row{
          let sep=if i==0{ "" }else{ "," };
          out=str.concat(out;str.concat(sep;json.tostr(row)));
          i=i+1
        };
        <str.concat(out;"]")
      };
    };
    $err:e <"[]"
  };
};




f=processaccess(store:db.$store;req:$dsarrequest;outpath:str):bool{
  let  =setstatus(store;req.id;statusprocessing;0);
  let consent=exporttable(store;"consent_records";req.userid);
  let quota=exporttable(store;"quota_usage";req.userid);
  let audit=exporttable(store;"audit_events";req.userid);
  let dsars=exporttable(store;"dsar_requests";req.userid);
  let quality=exporttable(store;"quality_signals";req.userid);
  let payload=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(
                        str.concat(
                          str.concat(
                            str.concat(
                              str.concat(
                                str.concat(
                                  "{\"user_id\":\"";
                                  req.userid);
                                "\",\"exported_at\":\"");
                              str.fromint(time.nowunix()));
                            "\",\"consent_records\":";
                          consent);
                        ",\"quota_usage\":";
                      quota);
                    ",\"audit_events\":";
                  audit);
                ",\"dsar_requests\":";
              dsars);
            ",\"quality_signals\":";
          quality);
        "}");
      "");
    ""
  );
  fs.writetext(outpath;mt payload) {
    $ok: {
      let now=time.nowunix();
      let  =setstatus(store;req.id;statuscompleted;now);
      log.info(
        str.concat(
          str.concat("DSAR access export written user=";req.userid);
          str.concat(" path=";outpath)
        );
        "dsar";
        req.userid
      );
      <true
    };
    $err:e {
      let  =setstatus(store;req.id;statusfailed;0);
      log.warn(
        str.concat("DSAR access export failed user=";req.userid);
        "dsar";
        req.userid
      );
      <false
    };
  };
};





f=processerasure(store:db.$store;req:$dsarrequest):bool{
  let  =setstatus(store;req.id;statusprocessing;0);
  let tables=@(
    "consent_records";
    "quota_usage";
    "audit_events";
    "quality_signals"
  );
  let allok=true;
  tables.each|table{
    let sql=str.concat(
      str.concat("DELETE FROM ";table);
      " WHERE user_id=?"
    );
    db.execparams(store.conn;sql;mt @(req.userid)) {
      $ok: {
        log.debug(
          str.concat(str.concat("erased rows from ";table);str.concat(" for user=";req.userid));
          "dsar";
          req.userid
        )
      };
      $err:e {
        log.warn(
          str.concat(str.concat("failed to erase from ";table);str.concat(" for user=";req.userid));
          "dsar";
          req.userid
        );
        allok=false
      };
    };
  };
  let now=time.nowunix();
  if allok{
    let  =setstatus(store;req.id;statuscompleted;now);
    log.info(
      str.concat("DSAR erasure completed user=";req.userid);
      "dsar";
      req.userid
    )
  }else{
    let  =setstatus(store;req.id;statusfailed;0);
    log.warn(
      str.concat("DSAR erasure completed with errors user=";req.userid);
      "dsar";
      req.userid
    )
  };
  <allok
};



f=status(store:db.$store;id:str):$dsarrequest{
  db.queryparams(
    store.conn;
    "SELECT id,kind,user_id,submitted_at,completed_at,status FROM dsar_requests WHERE id=? LIMIT 1";
    @(id)
  mt ) {
    $ok:rows {
      if rows.len==0{
        <$dsarrequest{
          id:id;
          kind:"";
          userid:"";
          submittedat:0;
          completedat:0;
          status:"not_found"
        };
      }else{
        let row=rows.get(0);
        <$dsarrequest{
          id:json.getstr(row;"id");
          kind:json.getstr(row;"kind");
          userid:json.getstr(row;"user_id");
          submittedat:json.getint(row;"submitted_at");
          completedat:json.getint(row;"completed_at");
          status:json.getstr(row;"status")
        };
      };
    };
    $err:e {
      log.warn(str.concat("failed to query DSAR id=";id);"dsar";"system");
      <$dsarrequest{
        id:id;
        kind:"";
        userid:"";
        submittedat:0;
        completedat:0;
        status:"not_found"
      };
    };
  };
};



f=listpending(store:db.$store):@$dsarrequest{
  db.queryparams(
    store.conn;
    "SELECT id,kind,user_id,submitted_at,completed_at,status FROM dsar_requests
     WHERE status IN ('pending','processing') ORDER BY submitted_at ASC";
    @()
  mt ) {
    $ok:rows {
      <rows.map|row{
        $dsarrequest{
          id:json.getstr(row;"id");
          kind:json.getstr(row;"kind");
          userid:json.getstr(row;"user_id");
          submittedat:json.getint(row;"submitted_at");
          completedat:json.getint(row;"completed_at");
          status:json.getstr(row;"status")
        };
      };
    };
    $err:e {
      log.warn("failed to list pending DSARs";"dsar";"system");
      <@()
    };
  };
};

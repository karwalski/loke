m=core.governance.dsar;

i=db:std.db;
i=str:std.str;
i=fs:std.fs;
i=log:shared.log;
i=time:std.time;

t=$dsarrequest{
  id:str;
  kind:str;
  userid:str;
  submittedat:i64;
  completedat:i64;
  status:str
};

f=statuspending():str{ <"pending" };
f=statusprocessing():str{ <"processing" };
f=statuscompleted():str{ <"completed" };
f=statusfailed():str{ <"failed" };

f=ensuretable(store:i64):bool{
  let sql="CREATE TABLE IF NOT EXISTS dsar_requests (
  id TEXT PRIMARY KEY,
  kind TEXT NOT NULL,
  user_id TEXT NOT NULL,
  submitted_at INTEGER NOT NULL,
  completed_at INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'pending'
)";
  mt db.execparams(store.conn;sql;@()) {
    $ok:v true;
    $err:e false
  }
};

f=submit(store:i64;kind:str;userid:str):$dsarrequest{
  let id=str.randhex(16);
  let now=time.nowunix();
  let nows=str.fromint(now);
  mt db.execparams(
    store.conn;
    "INSERT INTO dsar_requests (id,kind,user_id,submitted_at,completed_at,status) VALUES (?,?,?,?,0,'pending')";
    @(id;kind;userid;nows)
  ) {
    $ok:v log.info(
        str.concat(
          str.concat(
            str.concat("DSAR submitted kind=";kind);
            " user=");
          userid
        );
        "dsar";
        userid
      );
    $err:e log.warn(
        str.concat("failed to persist DSAR for user=";userid);
        "dsar";
        userid
      )
  };
  <$dsarrequest{
    id:id;
    kind:kind;
    userid:userid;
    submittedat:now;
    completedat:0;
    status:statuspending()
  }
};

f=setstatus(store:i64;id:str;newstatus:str;completedat:i64):bool{
  let tss=str.fromint(completedat);
  mt db.execparams(
    store.conn;
    "UPDATE dsar_requests SET status=?,completed_at=? WHERE id=?";
    @(newstatus;tss;id)
  ) {
    $ok:v true;
    $err:e false
  }
};

f=rowstojson(rows:i64):str{
  if(rows.len=0){
    <"[]"
  }el{
    let out=mut."[";
    let i=mut.0;
    lp(let ii=0;ii<rows.len;ii=ii+1){ let row=rows.get(ii);
      let sep=mut.",";
      if(i=0){ sep="" }el{};
      out=str.concat(out;str.concat(sep;json.enc(row)));
      i=i+1
    };
    <str.concat(out;"]")
  };
};

f=exporttable(store:i64;table:str;userid:str):str{
  let sql=str.concat(
    str.concat("SELECT * FROM ";table);
    " WHERE user_id=?"
  );
  mt db.queryparams(store.conn;sql;@(userid)) {
    $ok:rows rowstojson(rows);
    $err:e "[]"
  }
};

f=processaccessok(store:i64;req:$dsarrequest):bool{
  let now=time.nowunix();
  let s2=setstatus(store;req.id;statuscompleted();now);
  <true
};

f=processaccesserr(store:i64;req:$dsarrequest):bool{
  let s3=setstatus(store;req.id;statusfailed();0);
  <false
};

f=processaccess(store:i64;req:$dsarrequest;outpath:str):bool{
  let s1=setstatus(store;req.id;statusprocessing();0);
  let consent=exporttable(store;"consent_records";req.userid);
  let quota=exporttable(store;"quota_usage";req.userid);
  let audit=exporttable(store;"audit_events";req.userid);
  let dsars=exporttable(store;"dsar_requests";req.userid);
  let quality=exporttable(store;"quality_signals";req.userid);
  let payload=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      str.concat(
                        str.concat(
                          str.concat(
                            "{\"user_id\":\"";
                            req.userid);
                          "\",\"exported_at\":\"");
                        str.fromint(time.nowunix()));
                      "\",\"consent_records\":";
                    consent);
                  ",\"quota_usage\":";
                quota);
              ",\"audit_events\":";
            audit);
          ",\"dsar_requests\":";
        dsars);
      ",\"quality_signals\":";
    quality);
  "}"))
  )));
  mt fs.writetext(outpath;payload) {
    $ok:v processaccessok(store;req);
    $err:e processaccesserr(store;req)
  }
};

f=processerasure(store:i64;req:$dsarrequest):bool{
  let s1=setstatus(store;req.id;statusprocessing();0);
  let tables=@(
    "consent_records";
    "quota_usage";
    "audit_events";
    "quality_signals"
  );
  let allok=mut.true;
  lp(let ii=0;ii<tables.len;ii=ii+1){ let table=tables.get(ii);
    let sql=str.concat(
      str.concat("DELETE FROM ";table);
      " WHERE user_id=?"
    );
    let tableok=mt db.execparams(store.conn;sql;@(req.userid)) {
      $ok:v true;
      $err:e false
    };
    if(tableok){}el{
      allok=false
    }
  };
  let now=time.nowunix();
  if(allok){
    let s2=setstatus(store;req.id;statuscompleted();now)
  }el{
    let s3=setstatus(store;req.id;statusfailed();0)
  };
  <allok
};

f=notfoundrequest(id:str):$dsarrequest{
  <$dsarrequest{
    id:id;
    kind:"";
    userid:"";
    submittedat:0;
    completedat:0;
    status:"not_found"
  }
};

f=parsedsarstatus(rows:i64;id:str):$dsarrequest{
  if(rows.len=0){
    <notfoundrequest(id)
  }el{
    let row=rows.get(0);
    <$dsarrequest{
      id:json.str(row;"id");
      kind:json.str(row;"kind");
      userid:json.str(row;"user_id");
      submittedat:json.i64(row;"submitted_at");
      completedat:json.i64(row;"completed_at");
      status:json.str(row;"status")
    }
  }
};

f=status(store:i64;id:str):$dsarrequest{
  mt db.queryparams(
    store.conn;
    "SELECT id,kind,user_id,submitted_at,completed_at,status FROM dsar_requests WHERE id=? LIMIT 1";
    @(id)
  ) {
    $ok:rows parsedsarstatus(rows;id);
    $err:e notfoundrequest(id)
  }
};

f=listpending(store:i64):@$dsarrequest{
  mt db.queryparams(
    store.conn;
    "SELECT id,kind,user_id,submitted_at,completed_at,status FROM dsar_requests
     WHERE status IN ('pending','processing') ORDER BY submitted_at ASC";
    @()
  ) {
    $ok:rows rows;
    $err:e @()
  };
  let pending=mut.@();
  lp(let pi=0;pi<rows.len;pi=pi+1){
    let row=rows.get(pi);
    pending=pending.push($dsarrequest{
      id:json.str(row;"id");
      kind:json.str(row;"kind");
      userid:json.str(row;"user_id");
      submittedat:json.i64(row;"submitted_at");
      completedat:json.i64(row;"completed_at");
      status:json.str(row;"status")
    })
  };
  <pending
};

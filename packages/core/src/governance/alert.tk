m=core.governance.alert;





i=str:std.str;
i=log:shared.log;
i=reach:shared.reachability;
i=time:std.time;


t=$quotastatus{
  ruleid:str;
  usedtokens:i64;
  usedcost:f32;
  remainingpct:f32;
  exceeded:bool
};

t=$alert{
  id:str;
  kind:str;
  severity:str;
  message:str;
  ts:i64
};

t=$alertconfig{
  quotathresholdpct:f32;
  webhookurl:str;
  logonly:bool
};




f=defaultconfig():$alertconfig{
  <$alertconfig{
    quotathresholdpct:20.0;
    webhookurl:"";
    logonly:true
  }
};


f=makealert(kind:str;severity:str;message:str):$alert{
  <$alert{
    id:str.randhex(16);
    kind:kind;
    severity:severity;
    message:message;
    ts:time.nowunix()
  }
};


f=alerttojson(a:$alert):str{
  let tss=str.fromint(a.ts);
  <"{\"id\":\"\(a.id)\",\"kind\":\"\(a.kind)\",\"severity\":\"\(a.severity)\",\"message\":\"\(a.message)\",\"ts\":\(tss)}"
};



(* VM1.6f. The webhook was posted with `http.postheaders(http.client(url);"";...)`. The
   runtime reads postheaders' first argument as a URL string, so nothing was sent (T-48).
   A webhook on this machine is posted through reach.localpost, which arrives; true only when
   it answered with a body, because posturl exposes no status, so a webhook answering 204
   reads as not delivered. No client call at this toolchain is measured to send a POST to another host
   (T-48, F5.11), so a webhook anywhere else is reported as not delivered rather than handed
   to a call that sends nothing. *)
f=postwebhook(url:str;body:str):bool{
  if(!reach.isloopbackurl(url)){
    log.warn("governance alert: webhook is not on this machine and cannot be reached (T-48)";"alert";"system");
    <false
  }el{};
  <str.len(reach.localpost(url;"";body))>0
};

f=send(config:$alertconfig;alert:$alert):bool{
  let json=alerttojson(alert);
  if(str.eq(alert.severity;"critical")){
    log.error(str.concat("governance alert: ";alert.message);"alert";"system")
  }el{
    if(str.eq(alert.severity;"warn")){
      log.warn(str.concat("governance alert: ";alert.message);"alert";"system")
    }el{
      log.info(str.concat("governance alert: ";alert.message);"alert";"system")
    }
  };
  if(config.logonly){
    <true
  }el{
    if(config.webhookurl==""){
      <true
    }el{
      <postwebhook(config.webhookurl;json)
    }
  }
};




f=quotaalert(config:$alertconfig;status:$quotastatus):bool{
  let shouldalert=mut.status.remainingpct<config.quotathresholdpct;
  if(status.exceeded){
    shouldalert=true
  }el{};
  if(shouldalert){
    let severity=mut."warn";
    if(status.exceeded){ severity="critical" }el{};
    let pcts=str.fromfloat(status.remainingpct);
    let msg=mut."Quota low (\(pcts)% remaining) for rule: \(status.ruleid)";
    if(status.exceeded){
      msg=str.concat("Quota exceeded for rule: ";status.ruleid)
    }el{};
    <send(config;makealert("quota";severity;msg))
  }el{
    <false
  }
};





f=policyalert(config:$alertconfig;ruleid:str;regulation:str;action:str):bool{
  let severity=mut."warn";
  if(action=="DENY"){ severity="critical" }el{};
  let msg="Policy violation — rule=\(ruleid) regulation=\(regulation) action=\(action)";
  <send(config;makealert("policy";severity;msg))
};

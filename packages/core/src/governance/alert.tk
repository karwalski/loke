m=core.governance.alert;





i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=time:std.time;


t=$quotastatus{
  ruleid:str;
  usedtokens:i64;
  usedcost:f32;
  remainingpct:f32;
  exceeded:bool
};

t=$alert{
  id:str;
  kind:str;
  severity:str;
  message:str;
  ts:i64
};

t=$alertconfig{
  quotathresholdpct:f32;
  webhookurl:str;
  logonly:bool
};




f=defaultconfig():$alertconfig{
  <$alertconfig{
    quotathresholdpct:20.0;
    webhookurl:"";
    logonly:true
  };
};


f=makealert(kind:str;severity:str;message:str):$alert{
  <$alert{
    id:str.randhex(16);
    kind:kind;
    severity:severity;
    message:message;
    ts:time.nowunix()
  };
};


f=alerttojson(a:$alert):str{
  let tss=str.fromint(a.ts);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      "{\"id\":\"";
                      a.id);
                    "\",\"kind\":\"");
                  a.kind);
                "\",\"severity\":\"");
              a.severity);
            "\",\"message\":\"");
          a.message);
        "\",\"ts\":");
      tss);
    "}")
};



f=send(config:$alertconfig;alert:$alert):bool{
  let json=alerttojson(alert);
  mt alert.severity {
    "critical"; log.error(str.concat("governance alert: ";alert.message);"alert";"system");
    "warn";     log.warn(str.concat("governance alert: ";alert.message);"alert";"system");
    ;          log.info(str.concat("governance alert: ";alert.message);"alert";"system")
  };
  if(config.logonly){
    <true
  }else{
    if(config.webhookurl=""){
      <true
    }else{
      mt http.post(config.webhookurl;json;"application/json") {
        $ok: <true;
        $err:e {
          log.warn(
            str.concat("failed to POST alert to webhook: ";config.webhookurl);
            "alert";
            "system"
          );
          <false
        };
      };
    };
  };
};




f=quotaalert(config:$alertconfig;status:$quotastatus):bool{
  let shouldalert=if status.exceeded{
    true
  }else{
    status.remainingpct<config.quotathresholdpct
  };
  if(shouldalert){
    let severity=if status.exceeded{ "critical" }else{ "warn" };
    let pcts=str.fromfloat(status.remainingpct);
    let msg=if status.exceeded{
      str.concat("Quota exceeded for rule: ";status.ruleid)
    }else{
      str.concat(
        str.concat("Quota low (";pcts);
        str.concat("% remaining) for rule: ";status.ruleid)
      )
    };
    let a=makealert("quota";severity;msg);
    <send(config;a)
  }else{
    <false
  };
};





f=policyalert(config:$alertconfig;ruleid:str;regulation:str;action:str):bool{
  let severity=if action="DENY"{ "critical" }else{ "warn" };
  let msg=str.concat(
    str.concat(
      str.concat(
        str.concat("Policy violation — rule=";ruleid);
        " regulation=");
      regulation);
    str.concat(" action=";action)
  );
  let a=makealert("policy";severity;msg);
  <send(config;a)
};

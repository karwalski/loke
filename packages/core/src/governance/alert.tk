m=core.governance.alert;





i=str:std.str;
i=log:shared.log;
i=http:std.http;
i=time:std.time;


t=$quotastatus{
  ruleid:str;
  usedtokens:i64;
  usedcost:f32;
  remainingpct:f32;
  exceeded:bool
};

t=$alert{
  id:str;
  kind:str;
  severity:str;
  message:str;
  ts:i64
};

t=$alertconfig{
  quotathresholdpct:f32;
  webhookurl:str;
  logonly:bool
};




f=defaultconfig():$alertconfig{
  <$alertconfig{
    quotathresholdpct:20.0;
    webhookurl:"";
    logonly:true
  }
};


f=makealert(kind:str;severity:str;message:str):$alert{
  <$alert{
    id:str.randhex(16);
    kind:kind;
    severity:severity;
    message:message;
    ts:time.nowunix()
  }
};


f=alerttojson(a:$alert):str{
  let tss=str.fromint(a.ts);
  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat(
                  str.concat(
                    str.concat(
                      "{\"id\":\"";
                      a.id);
                    "\",\"kind\":\"");
                  a.kind);
                "\",\"severity\":\"");
              a.severity);
            "\",\"message\":\"");
          a.message);
        "\",\"ts\":");
      tss);
    "}")
};



f=send(config:$alertconfig;alert:$alert):bool{
  let json=alerttojson(alert);
  if(str.eq(alert.severity;"critical")){
    log.error(str.concat("governance alert: ";alert.message);"alert";"system")
  }el{
    if(str.eq(alert.severity;"warn")){
      log.warn(str.concat("governance alert: ";alert.message);"alert";"system")
    }el{
      log.info(str.concat("governance alert: ";alert.message);"alert";"system")
    }
  };
  if(config.logonly){
    <true
  }el{
    if(config.webhookurl=""){
      <true
    }el{
      mt http.post(config.webhookurl;json;"application/json") {
        $ok:v true;
        $err:e false
      }
    }
  }
};




f=quotaalert(config:$alertconfig;status:$quotastatus):bool{
  let shouldalert=mut.status.remainingpct<config.quotathresholdpct;
  if(status.exceeded){
    shouldalert=true
  }el{};
  if(shouldalert){
    let severity=mut."warn";
    if(status.exceeded){ severity="critical" }el{};
    let pcts=str.fromfloat(status.remainingpct);
    let msg=mut.str.concat(
        str.concat("Quota low (";pcts);
        str.concat("% remaining) for rule: ";status.ruleid)
      );
    if(status.exceeded){
      msg=str.concat("Quota exceeded for rule: ";status.ruleid)
    }el{};
    let a=makealert("quota";severity;msg);
    <send(config;a)
  }el{
    <false
  }
};





f=policyalert(config:$alertconfig;ruleid:str;regulation:str;action:str):bool{
  let severity=mut."warn";
  if(action="DENY"){ severity="critical" }el{};
  let msg=str.concat(
    str.concat(
      str.concat(
        str.concat("Policy violation — rule=";ruleid);
        " regulation=");
      regulation);
    str.concat(" action=";action)
  );
  let a=makealert("policy";severity;msg);
  <send(config;a)
};

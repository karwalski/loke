m=core.governance.types;


i=t:shared.types;
i=str:std.str;

t=$risktier{
  $low:i64;
  $medium:i64;
  $high:i64};

t=$usecase{
  id:str;
  name:str;
  description:str;
  risklevel:$risktier;
  purpose:str;
  approvedmodels:@str;
  owner:str
};

t=$policydecision{
  $allow:i64;
  $allowwithwarning:str;
  $requireapproval:str;
  $deny:str
};

t=$gatewayrequest{
  requestid:str;
  usecaseid:str;
  text:str;
  modelid:str;
  provider:$provider;
  sensitivity:$sensitivitylevel;
  estimatedcost:f64;
  correlationid:str
};

t=$gatewaydecision{
  requestid:str;
  policydecision:$policydecision;
  risktier:$risktier;
  routing:$routingdecision;
  controlsapplied:@str;
  explanation:str;
  timestamp:str
};



f=sensitivitytorisk(level:$sensitivitylevel):$risktier{
  mt level {
    $public:v      $low;
    $internal:v    $low;
    $confidential:v $medium;
    $restricted:v  $high
  }
};


f=risklabel(tier:$risktier):str{
  mt tier {
    $low:v   "LOW";
    $medium:v "MEDIUM";
    $high:v  "HIGH"
  }
};


f=decisionlabel(d:$policydecision):str{
  mt d {
    $allow:v                  "ALLOW";
    $allowwithwarning:msg "ALLOW_WITH_WARNING";
    $requireapproval:msg   "REQUIRE_APPROVAL";
    $deny:msg               "DENY"
  }
};

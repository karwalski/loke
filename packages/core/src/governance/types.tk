m=core.governance.types;
i=t:shared.types;



t=$usecase{
  id:str;
  name:str;
  description:str;
  risklevel:$risktier;
  purpose:str;
  approvedmodels:@str;
  owner:str
};

t=$gatewayrequest{
  requestid:str;
  usecaseid:str;
  text:str;
  modelid:str;
  provider:$provider;
  sensitivity:$sensitivitylevel;
  estimatedcost:f64;
  correlationid:str
};

t=$gatewaydecision{
  requestid:str;
  policydecision:$policydecision;
  risktier:$risktier;
  routing:$routingdecision;
  controlsapplied:@str;
  explanation:str;
  timestamp:str
};



f=sensitivitytorisk(level:$sensitivitylevel):$risktier{
  <mt level {
    $public:v      $risktier{$low:0};
    $internal:v    $risktier{$low:0};
    $confidential:v $risktier{$medium:0};
    $restricted:v  $risktier{$high:0}
  }
};


f=risklabel(tier:$risktier):str{
  <mt tier {
    $low:v   "LOW";
    $medium:v "MEDIUM";
    $high:v  "HIGH";
    $critical:v "CRITICAL"
  }
};


f=decisionlabel(d:$policydecision):str{
  <mt d {
    $allow:v                  "ALLOW";
    $allowwithwarning:msg "ALLOW_WITH_WARNING";
    $requireapproval:msg   "REQUIRE_APPROVAL";
    $deny:msg               "DENY"
  }
};

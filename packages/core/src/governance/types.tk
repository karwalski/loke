m=core.governance.types;


i=t:shared.types;
i=str:std.str;

t=$risktier{
  $low:i64;
  $medium:i64;
  $high
};

t=$usecase{
  id:str;
  name:str;
  description:str;
  risklevel:$risktier;
  purpose:str;
  approvedmodels:@str;
  owner:str
};

t=$policydecision{
  $allow:i64;
  $allowwithwarning(str);
  $requireapproval(str);
  $deny(str)
};

t=$gatewayrequest{
  requestid:str;
  usecaseid:str;
  text:str;
  modelid:str;
  provider:$provider;
  sensitivity:$sensitivitylevel;
  estimatedcost:f64;
  correlationid:str
};

t=$gatewaydecision{
  requestid:str;
  policydecision:$policydecision;
  risktier:$risktier;
  routing:$routingdecision;
  controlsapplied:@str;
  explanation:str;
  timestamp:str
};



f=sensitivitytorisk(level:$sensitivitylevel):$risktier{
  mt level {
    $sensitivitylevel.$public;      <$risktier.$low;
    $sensitivitylevel.$internal;    <$risktier.$low;
    $sensitivitylevel.$confidential;<$risktier.$medium;
    $sensitivitylevel.$restricted;  <$risktier.$high
  };
};


f=risklabel(tier:$risktier):str{
  mt tier {
    $risktier.$low;   <"LOW";
    $risktier.$medium;<"MEDIUM";
    $risktier.$high;  <"HIGH"
  };
};


f=decisionlabel(d:$policydecision):str{
  mt d {
    $policydecision.$allow;                  <"ALLOW";
    $policydecision.$allowwithwarning msg; <"ALLOW_WITH_WARNING";
    $policydecision.$requireapproval msg;   <"REQUIRE_APPROVAL";
    $policydecision.$deny msg;               <"DENY"
  };
};

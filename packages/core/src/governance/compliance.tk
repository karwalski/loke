m=core.governance.compliance;

i=time:std.time;
i=str:std.str;
i=db:std.db;
i=s:core.storage.db;
i=audit:core.storage.audit;

t=$compliancecheck{
  name:str;
  status:str;
  detail:str
};

t=$compliancereport{
  framework:str;
  checks:@$compliancecheck;
  generatedat:i64;
  overall:str
};



(* FAIL dominates WARN dominates PASS; ASSERTED is non-blocking.

   Rewritten from a nested if/else over str.arrayget, which erases the element type. The
   typed `.get()` over `@$compliancecheck` keeps it. *)
f=overallstatus(checks:@$compliancecheck):str{
  let anyfail=mut.false;
  let anywarn=mut.false;
  lp(let i=0;i<checks.len;i=i+1){
    let c=checks.get(i);
    if(str.eq(c.status;"FAIL")){anyfail=true}el{};
    if(str.eq(c.status;"WARN")){anywarn=true}el{}
  };
  if(anyfail){
    <"FAIL"
  }el if(anywarn){
    <"WARN"
  }el{
    <"PASS"
  }
};

f=countrows(sql:str):i64{
  (* A plain i64, no result type. T-18 makes the $err arm of a user-declared error union
     dead, but db.many is a STDLIB result and does discriminate, so the arms here are
     real. A failed query returns 0, which reads as "no evidence" — the safe direction
     for a compliance check. *)
  <mt db.many(sql;@()) {
    $ok:rows rows.len as i64;
    $err:e 0
  }
};

(* Delegates to the storage layer's predicate rather than keeping a second copy, so
   "does this table exist?" has one answer in this codebase. The private version also
   interpolated the name straight into the SQL; the shared one binds it. *)
f=tableexists(name:str):bool{
  <s.tableexists(name)
};

f=auditrowcount():i64{
  if(tableexists("audit_log")){
    <countrows("SELECT id FROM audit_log")
  }el{
    <0
  }
};

f=checkauditrecording():$compliancecheck{
  let n=auditrowcount();
  if(n>0){
    <$compliancecheck{
      name:"Audit log enabled";
      status:"PASS";
      detail:"audit_log holds \(str.fromint(n)) event(s)"
    }
  }el{
    <$compliancecheck{
      name:"Audit log enabled";
      status:"FAIL";
      detail:"audit_log is EMPTY, so no request has ever been recorded. GA1.4 gave the request path a writer (browser/pages/api/pipeline.tk calls audit.insertevent), so an empty table now means no request has been served rather than that nothing records them. This was previously reported as PASS"
    }
  }
};

(* Non-empty is necessary and not sufficient: completeness means the hash chain is
   unbroken. That used to be unverifiable and this check said so, naming GA5.3. GA5.3
   landed, so the check now RUNS the verifier instead of citing its absence — a compliance
   row that quotes a story number is a placeholder, and a stale one is worse than none.

   verifychain returns a plain struct, not a result: T-18 would make the error arm of a
   user-declared sum dead, and a verifier whose failure read as "intact" is the one
   outcome this check must never produce. *)
f=checkaudittrailcomplete(store:i64):$compliancecheck{
  if(auditrowcount()>0){
    let chain=audit.verifychain(store);
    if(chain.ok){
      <$compliancecheck{
        name:"Audit trail complete";
        status:"PASS";
        detail:audit.formatchainresult(chain)
      }
    }el{
      <$compliancecheck{
        name:"Audit trail complete";
        status:"FAIL";
        detail:audit.formatchainresult(chain)
      }
    }
  }el{
    <$compliancecheck{
      name:"Audit trail complete";
      status:"FAIL";
      detail:"audit_log is EMPTY, so there is no trail to be complete (GA1.4). This was previously reported as PASS"
    }
  }
};

(* GA5.9 — read the control back from the database instead of asserting it.

   "The audit trail is append-only" was a sentence in the documentation with nothing
   behind it. Migrations 6 and 7 put two triggers behind it, and this reports whether both
   are present RIGHT NOW rather than whether a migration once ran: a rebuild of audit_log
   would take its triggers with it, and an operator with the sqlite3 shell can drop them.

   The detail states the limit of the control rather than overselling it. Someone who can
   already run arbitrary SQL can drop these triggers, which is why the hash chain exists
   as well — and why the check reports on both. *)
f=checkappendonly():$compliancecheck{
  if(s.auditappendonlyenforced()){
    <$compliancecheck{
      name:"Audit trail append-only";
      status:"PASS";
      detail:"audit_log rejects UPDATE and DELETE by database trigger. This stops modification over any ordinary connection; it does not stop someone who can DROP TRIGGER first, which is what the hash chain covers"
    }
  }el{
    <$compliancecheck{
      name:"Audit trail append-only";
      status:"FAIL";
      detail:"audit_log does NOT reject UPDATE or DELETE — one or both append-only triggers are missing, so the trail can be modified in place. Expected audit_log_append_only_update and audit_log_append_only_delete from migrations 6 and 7"
    }
  }
};

f=checkencryptionatrest():$compliancecheck{
  (* Derived from the one predicate that knows, so this row cannot drift from reality and
     flips on its own if the toolchain ever gains SQLCipher. *)
  if(s.dbencryptionavailable()){
    <$compliancecheck{name:"Encryption at rest";status:"PASS";detail:s.dbencryptionstatus()}
  }el{
    <$compliancecheck{name:"Encryption at rest";status:"WARN";detail:s.dbencryptionstatus()}
  }
};

f=checkconsentrecorded():$compliancecheck{
  if(tableexists("consent_records")){
    let n=countrows("SELECT id FROM consent_records");
    if(n>0){
      <$compliancecheck{name:"User consent recorded";status:"PASS";detail:"consent_records holds \(str.fromint(n)) record(s)"}
    }el{
      <$compliancecheck{name:"User consent recorded";status:"WARN";detail:"consent_records exists but is empty"}
    }
  }el{
    <$compliancecheck{name:"User consent recorded";status:"WARN";detail:"Consent capture not yet implemented — no consent_records table"}
  }
};

f=asserted(name:str;detail:str):$compliancecheck{
  <$compliancecheck{name:name;status:"ASSERTED";detail:detail}
};

f=rungdprchecks(store:i64):$compliancereport{
  let checks=@(
    checkauditrecording();
    checkappendonly();
    asserted("PII anonymised before cloud";
      "Held by the pipeline's fail-closed gate, not by stored state: core.privacy.pipeline.issafetoforward refuses the request when no detection layer completed, asserted in tests/unit/privacy/test_fail_closed.tk (NC1.9)");
    asserted("Data minimisation active";
      "core.optimiser.toon reduces the payload, but it is NOT yet called from any request path (GA1.5), so this is an available capability rather than an active control");
    checkconsentrecorded();
    $compliancecheck{
      name:"Right to erasure supported";
      status:"WARN";
      detail:"Deletion drops rows from consent_records. Three tables are retained, each for a stated reason: audit_log is append-only and records no user identifier (GA5.9, GA5.12); quota_usage and quality_signals have no user_id column, so no rows in them can be attributed to a subject (GA5.10); and dsar_requests is the record that the erasure took place. Per-subject erasure is not yet proven at the byte level. Erasing everything (loke erase --everything, X8.4) is: no file under the data directory holds an erased value afterwards"
    }
  );
  let overall=overallstatus(checks);
  <$compliancereport{
    framework:"GDPR";
    checks:checks;
    generatedat:time.now();
    overall:overall
  }
};



f=runhipaachecks(store:i64):$compliancereport{
  let checks=@(
    asserted("PHI detection active";
      "Held by the detection layers and their corpus, not by stored state. The measured figure is in docs/metrics-baseline.md and is regex-layer-only; the recall floor on the full pipeline is AD1.2 and is not yet measured");
    checkaudittrailcomplete(store);
    checkappendonly();
    checkencryptionatrest();
    $compliancecheck{
      name:"Access controls";
      status:"WARN";
      detail:"Single-user local install; multi-user access controls not implemented"
    }
  );
  let overall=overallstatus(checks);
  <$compliancereport{
    framework:"HIPAA";
    checks:checks;
    generatedat:time.now();
    overall:overall
  }
};



f=formatreport(report:$compliancereport):str{
  let title=str.concat(
    report.framework;
    " Compliance Report
"
  );
  let underline="==========================================
";
  let rows=mut."";
  (* The typed .len/.get over @$compliancecheck, not str.arraylen/str.arrayget: those
     erase the element type, which is why overallstatus above was rewritten away from
     them. This loop was the one that still used them. *)
  lp(let i=0;i<report.checks.len;i=i+1){ let c:$compliancecheck=report.checks.get(i);
    let prefix="[\(c.status)] ";
    let line="\(prefix)\(c.name) — \(c.detail)\n";
    rows=str.concat(rows;line)
  };
  let footer="\nOverall: \(report.overall)\n";
  <"\(title)\(underline)\(rows)\(footer)"
};

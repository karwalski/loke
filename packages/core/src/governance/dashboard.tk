m=core.governance.dashboard;

i=t:shared.types;
i=s:core.storage.db;
i=db:std.db;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;

t=$ragstatus{
  $green:i64;
  $amber:i64;
  $red:i64};

t=$dashboardmetric{
  name:str;
  value:str;
  status:$ragstatus;
  detail:str
};

t=$governancescorecard{
  overall:$ragstatus;
  metrics:@$dashboardmetric;
  perioddays:u32;
  generatedat:str
};


f=statussymbol(s:$ragstatus):str{
  mt s {
    $green:v "[OK]" ;
    $amber:v "[!!]" ;
    $red:v "[X] " 
  }
};


f=worst(a:$ragstatus;b:$ragstatus):$ragstatus{
  mt a {
    $red:v   $red;
    $amber:v mt b {
        $red:v   $red;
        $amber:v $amber;
        $green:v $amber
      };
    $green:v b
  }
};








f=buildscorecard(store:i64;perioddays:u32):$governancescorecard!$lokeerr{
  let dayss=str.fromint(perioddays);
  let window=str.concat(
    "datetime('now','-";
    str.concat(dayss;" days')")
  );

  
  let totalsql=str.concat(
    "SELECT COUNT(*) as cnt FROM audit_log WHERE created_at >= ";
    window
  );
  let totalcount=mut.0;
  let totalrows=mt db.queryparams(store.conn;totalsql;@()) {
    $ok:rows rows;
    $err:e $err($storageerr("failed to query audit_log total"))
  };
  if(totalrows.len > 0){ totalcount=json.getint(totalrows.get(0);"cnt") }el{};

  
  let privsql=str.concat(
    "SELECT COUNT(*) as cnt FROM audit_log WHERE created_at >= ";
    str.concat(window;" AND (sensitivity='CONFIDENTIAL' OR sensitivity='RESTRICTED')")
  );
  let privcount=mut.0;
  let privrows=mt db.queryparams(store.conn;privsql;@()) {
    $ok:rows rows;
    $err:e $err($storageerr("failed to query privacy coverage"))
  };
  if(privrows.len > 0){ privcount=json.getint(privrows.get(0);"cnt") }el{};

  let localsql=str.concat(
    "SELECT COUNT(*) as cnt FROM audit_log WHERE created_at >= ";
    str.concat(window;" AND (provider='local' OR provider='ollama')")
  );
  let localcount=mut.0;
  let localrows=mt db.queryparams(store.conn;localsql;@()) {
    $ok:rows rows;
    $err:e $err($storageerr("failed to query local routing ratio"))
  };
  if(localrows.len > 0){ localcount=json.getint(localrows.get(0);"cnt") }el{};

  let costsql=str.concat(
    "SELECT COALESCE(SUM(cost_usd),0.0) as total FROM audit_log WHERE created_at >= ";
    window
  );
  let totalcost=mut.0.0;
  let costrows=mt db.queryparams(store.conn;costsql;@()) {
    $ok:rows rows;
    $err:e $err($storageerr("failed to query cost"))
  };
  if(costrows.len > 0){ totalcost=json.getfloat(costrows.get(0);"total") }el{};

  
  let totalf=str.tofloat(str.fromint(totalcount));

  let privrate=mut.1.0;
  if(totalcount = 0){}el{
    privrate=str.tofloat(str.fromint(privcount))/totalf
  };
  let localrate=mut.1.0;
  if(totalcount = 0){}el{
    localrate=str.tofloat(str.fromint(localcount))/totalf
  };

  let govrate=mut.1.0;
  if(totalcount = 0){}el{};

  
  let privstatus=mut.$red;
  if(privrate > 0.95){
    privstatus=$green
  }el{
    if(privrate > 0.80){
      privstatus=$amber
    }el{}
  };
  let localstatus=mut.$red;
  if(localrate > 0.60){
    localstatus=$green
  }el{
    if(localrate > 0.40){
      localstatus=$amber
    }el{}
  };

  let coststatus=mut.$red;
  if(totalcost < 100.0){
    coststatus=$green
  }el{
    if(totalcost < 200.0){
      coststatus=$amber
    }el{}
  };

  let incidents=0;
  let incidentstatus=mut.$red;
  if(incidents = 0){
    incidentstatus=$green
  }el{
    if(!(incidents>2)){
      incidentstatus=$amber
    }el{}
  };
  let govstatus=mut.$red;
  if(govrate > 0.99){
    govstatus=$green
  }el{
    if(govrate > 0.95){
      govstatus=$amber
    }el{}
  };

  
  let privpct=str.concat(str.fromfloat(privrate*100.0);"%");
  let localpct=str.concat(str.fromfloat(localrate*100.0);"%");
  let coststr=str.concat("$";str.fromfloat(totalcost));
  let incidentstr=str.fromint(incidents);
  let govpct=str.concat(str.fromfloat(govrate*100.0);"%");

  let metrics=@(
    $dashboardmetric{
      name:"Privacy coverage";
      value:privpct;
      status:privstatus;
      detail:"% of requests where anonymisation was applied"
    };
    $dashboardmetric{
      name:"Local routing ratio";
      value:localpct;
      status:localstatus;
      detail:"% of requests routed to local models"
    };
    $dashboardmetric{
      name:"Cost (period)";
      value:coststr;
      status:coststatus;
      detail:"total USD spend from audit log"
    };
    $dashboardmetric{
      name:"Open incidents";
      value:incidentstr;
      status:incidentstatus;
      detail:"count of unresolved incidents"
    };
    $dashboardmetric{
      name:"Governance coverage";
      value:govpct;
      status:govstatus;
      detail:"% of requests with complete audit trail"
    }
  );

  let overall=worst(
    worst(
      worst(
        worst(privstatus;localstatus);
        coststatus);
      incidentstatus);
    govstatus
  );

  log.info("governance scorecard built";"dashboard";"system");
  <$ok($governancescorecard{
    overall:overall;
    metrics:metrics;
    perioddays:perioddays;
    generatedat:str.nowiso8601()
  })
};


f=padright(s:str;width:u32):str{
  let len=str.len(s);
  if(len > width){
    <s
  }el{
    let diff=width-len;
    let spaces="                              ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  }
};













f=formatscorecard(scorecard:$governancescorecard):str{
  let periods=str.fromint(scorecard.perioddays);
  let overalllabel=mt scorecard.overall {
    $green:v "GREEN";
    $amber:v "AMBER";
    $red:v "RED"
  };
  let border="+==========================================+
";
  let title=str.concat(
    str.concat("|     loke Governance Dashboard            |
|     Period: ";periods);
    str.concat(" days  Status: ";str.concat(overalllabel;"       |
"))
  );
  let rows="";
  lp(let ii267=0;ii267<scorecard.metrics.len;ii267=ii267+1){
    let m=scorecard.metrics.get(ii267);
    let sym=statussymbol(m.status);
    let namepadded=padright(m.name;22);
    let valpadded=padright(m.value;10);
    let row=str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("| ";sym);
            "  ");
          namepadded);
        valpadded);
      "|
")
    ;
    rows=str.concat(rows;row)

  };
  <str.concat(
    str.concat(
      str.concat(
        str.concat(border;title);
        border);
      rows);
    border)
};

m=core.governance.dashboard;



i=t:shared.types;
i=s:core.storage.db;
i=db:std.db;
i=gt:core.governance.types;
i=str:std.str;
i=log:shared.log;

t=$ragstatus{
  $green;
  $amber;
  $red
};

t=$dashboardmetric{
  name:str;
  value:str;
  status:$ragstatus;
  detail:str
};

t=$governancescorecard{
  overall:$ragstatus;
  metrics:@$dashboardmetric;
  perioddays:u32;
  generatedat:str
};


f=statussymbol(s:$ragstatus):str{
  mt s {
    $ragstatus.$green; <"[OK]";
    $ragstatus.$amber; <"[!!]";
    $ragstatus.$red;   <"[X] "
  };
};


f=worst(a:$ragstatus;b:$ragstatus):$ragstatus{
  mt a {
    $ragstatus.$red;   <$ragstatus.$red;
    $ragstatus.$amber; {
      mt b {
        $ragstatus.$red;   <$ragstatus.$red;
        $ragstatus.$amber; <$ragstatus.$amber;
        $ragstatus.$green; <$ragstatus.$amber
      };
    };
    $ragstatus.$green; <b
  };
};








f=buildscorecard(store:$s.store;perioddays:u32):$governancescorecard|$lokeerr{
  let dayss=str.fromint(perioddays);
  let window=str.concat(
    "datetime('now','-";
    str.concat(dayss;" days')")
  );

  
  let totalsql=str.concat(
    "SELECT COUNT(*) as cnt FROM audit_log WHERE created_at >= ";
    window
  );
  let totalcount=0;
  db.queryparams(store.conn;totalsql;mt @()) {
    $ok:rows {
      if rows.len > 0{
        totalcount=json.getint(rows.get(0);"cnt")
      }else{};
    };
    $err:e <$err($lokeerr.$storageerr("failed to query audit_log total"))
  };

  
  let privsql=str.concat(
    "SELECT COUNT(*) as cnt FROM audit_log WHERE created_at >= ";
    str.concat(window;" AND (sensitivity='CONFIDENTIAL' OR sensitivity='RESTRICTED')")
  );
  let privcount=0;
  db.queryparams(store.conn;privsql;mt @()) {
    $ok:rows {
      if rows.len > 0{
        privcount=json.getint(rows.get(0);"cnt")
      }else{};
    };
    $err:e <$err($lokeerr.$storageerr("failed to query privacy coverage"))
  };

  
  let localsql=str.concat(
    "SELECT COUNT(*) as cnt FROM audit_log WHERE created_at >= ";
    str.concat(window;" AND (provider='local' OR provider='ollama')")
  );
  let localcount=0;
  db.queryparams(store.conn;localsql;mt @()) {
    $ok:rows {
      if rows.len > 0{
        localcount=json.getint(rows.get(0);"cnt")
      }else{};
    };
    $err:e <$err($lokeerr.$storageerr("failed to query local routing ratio"))
  };

  
  let costsql=str.concat(
    "SELECT COALESCE(SUM(cost_usd),0.0) as total FROM audit_log WHERE created_at >= ";
    window
  );
  let totalcost=0.0;
  db.queryparams(store.conn;costsql;mt @()) {
    $ok:rows {
      if rows.len > 0{
        totalcost=json.getfloat(rows.get(0);"total")
      }else{};
    };
    $err:e <$err($lokeerr.$storageerr("failed to query cost"))
  };

  
  let totalf=str.tofloat(str.fromint(totalcount));

  let privrate=if totalcount == 0{ 1.0 }else{
    str.tofloat(str.fromint(privcount))/totalf
  };
  let localrate=if totalcount == 0{ 1.0 }else{
    str.tofloat(str.fromint(localcount))/totalf
  };
  
  let govrate=if totalcount == 0{ 1.0 }else{ 1.0 };

  
  let privstatus=if privrate > 0.95{
    $ragstatus.$green
  }else{
    if privrate > 0.80{
      $ragstatus.$amber
    }else{
      $ragstatus.$red
    };
  };
  let localstatus=if localrate > 0.60{
    $ragstatus.$green
  }else{
    if localrate > 0.40{
      $ragstatus.$amber
    }else{
      $ragstatus.$red
    };
  };
  
  let coststatus=if totalcost < 100.0{
    $ragstatus.$green
  }else{
    if totalcost < 200.0{
      $ragstatus.$amber
    }else{
      $ragstatus.$red
    };
  };
  
  let incidents=0;
  let incidentstatus=if incidents == 0{
    $ragstatus.$green
  }else{
    if incidents <= 2{
      $ragstatus.$amber
    }else{
      $ragstatus.$red
    };
  };
  let govstatus=if govrate > 0.99{
    $ragstatus.$green
  }else{
    if govrate > 0.95{
      $ragstatus.$amber
    }else{
      $ragstatus.$red
    };
  };

  
  let privpct=str.concat(str.fromfloat(privrate*100.0);"%");
  let localpct=str.concat(str.fromfloat(localrate*100.0);"%");
  let coststr=str.concat("$";str.fromfloat(totalcost));
  let incidentstr=str.fromint(incidents);
  let govpct=str.concat(str.fromfloat(govrate*100.0);"%");

  let metrics=@(
    $dashboardmetric{
      name:"Privacy coverage";
      value:privpct;
      status:privstatus;
      detail:"% of requests where anonymisation was applied"
    };
    $dashboardmetric{
      name:"Local routing ratio";
      value:localpct;
      status:localstatus;
      detail:"% of requests routed to local models"
    };
    $dashboardmetric{
      name:"Cost (period)";
      value:coststr;
      status:coststatus;
      detail:"total USD spend from audit log"
    };
    $dashboardmetric{
      name:"Open incidents";
      value:incidentstr;
      status:incidentstatus;
      detail:"count of unresolved incidents"
    };
    $dashboardmetric{
      name:"Governance coverage";
      value:govpct;
      status:govstatus;
      detail:"% of requests with complete audit trail"
    };
  );

  let overall=worst(
    worst(
      worst(
        worst(privstatus;localstatus);
        coststatus);
      incidentstatus);
    govstatus
  );

  log.info("governance scorecard built";"dashboard";"system");
  <$ok($governancescorecard{
    overall:overall;
    metrics:metrics;
    perioddays:perioddays;
    generatedat:str.nowiso8601()
  })
};


f=padright(s:str;width:u32):str{
  let len=str.len(s);
  if len >= width{
    <s
  }else{
    let diff=width-len;
    let spaces="                              ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  };
};













f=formatscorecard(scorecard:$governancescorecard):str{
  let periods=str.fromint(scorecard.perioddays);
  let overalllabel=mt scorecard.overall {
    $ragstatus.$green; <"GREEN";
    $ragstatus.$amber; <"AMBER";
    $ragstatus.$red;   <"RED"
  };
  let border="+==========================================+
";
  let title=str.concat(
    str.concat("|     loke Governance Dashboard            |
|     Period: ";periods);
    str.concat(" days  Status: ";str.concat(overalllabel;"       |
"))
  );
  let rows="";
  scorecard.metrics.each|m{
    let sym=statussymbol(m.status);
    let namepadded=padright(m.name;22);
    let valpadded=padright(m.value;10);
    let row=str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("| ";sym);
            "  ");
          namepadded);
        valpadded);
      "|
")
    ;
    rows=str.concat(rows;row)
  };
  <str.concat(
    str.concat(
      str.concat(
        str.concat(border;title);
        border);
      rows);
    border)
};

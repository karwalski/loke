m=core.governance.rulesengine;
i=str:std.str;
i=db:std.db;
i=log:shared.log;
i=time:std.time;
i=json:std.json;

t=$ruleop{
  $and:i64;
  $or:i64;
  $not:i64};

t=$condition{
  field:str;
  op:str;
  value:str
};

t=$compoundrule{
  id:str;
  name:str;
  logic:$ruleop;
  conditions:@$condition;
  action:str;
  severity:str
};

t=$evalcontext{
  sensitivity:i32;
  modeltier:str;
  requestcount:i32;
  hourofday:i32;
  scope:str
};

t=$evalresult{
  ruleid:str;
  matched:bool;
  action:str;
  reason:str
};

f=ensuretable(store:i64):bool{
  let sql="CREATE TABLE IF NOT EXISTS rate_limit_events (
  id TEXT PRIMARY KEY,
  scope TEXT NOT NULL,
  event_ts INTEGER NOT NULL
)";
  mt db.execparams(store.conn;sql;@()) {
    $ok:v true;
    $err:e false
  }
};

f=evalcondition(cond:$condition;ctx:$evalcontext):bool{
  if(cond.field="sensitivity"){
    let ctxval=ctx.sensitivity;
    let cmpval=str.toint(cond.value);
    if(cond.op="eq"){
      <ctxval=cmpval
    }el{
      if(cond.op="gt"){
        <ctxval>cmpval
      }el{
        if(cond.op="lt"){
          <ctxval<cmpval
        }el{
          <false
        }
      }
    }
  }el{
    if(cond.field="model_tier"){
      if(cond.op="eq"){
        <ctx.modeltier=cond.value
      }el{
        if(cond.op="contains"){
          <str.contains(ctx.modeltier;cond.value)
        }el{
          if(cond.op="matches"){
            <str.matches(ctx.modeltier;cond.value)
          }el{
            <false
          }
        }
      }
    }el{
      if(cond.field="request_count"){
        let ctxval=ctx.requestcount;
        let cmpval=str.toint(cond.value);
        if(cond.op="eq"){
          <ctxval=cmpval
        }el{
          if(cond.op="gt"){
            <ctxval>cmpval
          }el{
            if(cond.op="lt"){
              <ctxval<cmpval
            }el{
              <false
            }
          }
        }
      }el{
        if(cond.field="hour_of_day"){
          let ctxval=ctx.hourofday;
          let cmpval=str.toint(cond.value);
          if(cond.op="eq"){
            <ctxval=cmpval
          }el{
            if(cond.op="gt"){
              <ctxval>cmpval
            }el{
              if(cond.op="lt"){
                <ctxval<cmpval
              }el{
                <false
              }
            }
          }
        }el{
          if(cond.field="scope"){
            if(cond.op="eq"){
              <ctx.scope=cond.value
            }el{
              if(cond.op="contains"){
                <str.contains(ctx.scope;cond.value)
              }el{
                if(cond.op="matches"){
                  <str.matches(ctx.scope;cond.value)
                }el{
                  <false
                }
              }
            }
          }el{
            log.warn(str.concat("eval_condition: unknown field: ";cond.field);"rules_engine";"system");
            <false
          }
        }
      }
    }
  }
};

f=evaland(conditions:@$condition;ctx:$evalcontext):bool{
  let allpass=mut.true;
  lp(let ii146=0;ii146<conditions.len;ii146=ii146+1){
    let cond=conditions.get(ii146);
    if(allpass){
      if(evalcondition(cond;ctx)){
        allpass=allpass
      }el{
        allpass=false
      };
    }el{}

  };
  <allpass
};

f=evalor(conditions:@$condition;ctx:$evalcontext):bool{
  let anypass=mut.false;
  lp(let ii162=0;ii162<conditions.len;ii162=ii162+1){
    let cond=conditions.get(ii162);
    if(anypass){
      anypass=anypass
    }el{
      if(evalcondition(cond;ctx)){
        anypass=true
      }el{}
    }

  };
  <anypass
};

f=evalnot(conditions:@$condition;ctx:$evalcontext):bool{
  if(conditions.len=0 as u64){
    <false
  }el{
    let first=conditions.get(0);
    <evalcondition(first;ctx)=false
  }
};

f=evaluate(rule:$compoundrule;ctx:$evalcontext):$evalresult{
  let matched=mt rule.logic {
    $and:v evaland(rule.conditions;ctx);
    $or:v evalor(rule.conditions;ctx);
    $not:v evalnot(rule.conditions;ctx)
  };
  let reason=mut.str.concat("Rule not matched: ";rule.name);
  if(matched){
    reason=str.concat(str.concat("Rule matched: ";rule.name);str.concat(" -> ";rule.action))
  }el{};
  let action=mut."allow";
  if(matched){ action=rule.action }el{};
  <$evalresult{
    ruleid:rule.id;
    matched:matched;
    action:action;
    reason:reason
  }
};

f=evaluateall(rules:@$compoundrule;ctx:$evalcontext):@$evalresult{
  let results=@();
  lp(let ii207=0;ii207<rules.len;ii207=ii207+1){
    let rule=rules.get(ii207);
    let result=evaluate(rule;ctx);
    if(result.matched){
      results=@(results;result)
    }el{}

  };
  <results
};

f=ratecheckcount(rows:i64;limit:i32):bool{
  let count=mut.0;
  if(rows.len=0){}el{
    count=json.i64(rows.get(0);"cnt")
  };
  <!(count>limit)
};

f=ratecheck(store:i64;scope:str;limit:i32;windowseconds:i32):bool{
  let nowts=time.unixnow();
  let cutoffts=nowts-windowseconds;
  let cutoffs=str.fromint(cutoffts);

  mt db.execparams(
    store.conn;
    "DELETE FROM rate_limit_events WHERE scope=? AND event_ts<?";
    @(scope;cutoffs)
  ) {
    $ok:v 0;
    $err:e
      log.warn(str.concat("rate_check: failed to prune stale events for scope: ";scope);"rules_engine";"system")
  };

  let eventid=str.randhex(16);
  let nows=str.fromint(nowts);
  mt db.execparams(
    store.conn;
    "INSERT INTO rate_limit_events (id,scope,event_ts) VALUES (?,?,?)";
    @(eventid;scope;nows)
  ) {
    $ok:v 0;
    $err:e
      log.warn(str.concat("rate_check: failed to insert event for scope: ";scope);"rules_engine";"system")
  };

  mt db.queryparams(
    store.conn;
    "SELECT COUNT(*) as cnt FROM rate_limit_events WHERE scope=? AND event_ts>=?";
    @(scope;cutoffs)
  ) {
    $ok:rows ratecheckcount(rows;limit);
    $err:e true
  }
};

f=defaultrules():@$compoundrule{
  let rulehighsens=$compoundrule{
    id:"default-high-sensitivity-cloud";
    name:"High sensitivity + cloud model";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"sensitivity"; op:"eq"; value:"3" };
      $condition{ field:"model_tier"; op:"contains"; value:"cloud" }
    );
    action:"warn";
    severity:"high"
  };
  let rulerateburst=$compoundrule{
    id:"default-rate-burst-throttle";
    name:"Request burst exceeds 100";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"request_count"; op:"gt"; value:"100" }
    );
    action:"throttle";
    severity:"medium"
  };
  let ruleoffhours=$compoundrule{
    id:"default-off-hours-premium";
    name:"Premium cloud model used off-hours";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"model_tier"; op:"eq"; value:"cloud-premium" };
      $condition{ field:"hour_of_day"; op:"gt"; value:"21" }
    );
    action:"warn";
    severity:"low"
  };
  let ruleconfidentialexternal=$compoundrule{
    id:"default-confidential-external-scope";
    name:"Confidential data to external scope";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"sensitivity"; op:"gt"; value:"1" };
      $condition{ field:"scope"; op:"contains"; value:"external" }
    );
    action:"deny";
    severity:"high"
  };
  <@(rulehighsens;rulerateburst;ruleoffhours;ruleconfidentialexternal)
};

m=core.governance.rulesengine;
i=str:std.str;
i=db:std.db;
i=log:shared.log;
i=time:std.time;
i=json:std.json;
i=s:core.storage.db;
i=preg:core.policy.presets.registry;

t=$ruleop{
  $and:i64;
  $or:i64;
  $not:i64};

t=$condition{
  field:str;
  op:str;
  value:str
};

t=$compoundrule{
  id:str;
  name:str;
  logic:$ruleop;
  conditions:@$condition;
  action:str;
  severity:str
};

t=$evalcontext{
  sensitivity:i32;
  modeltier:str;
  requestcount:i32;
  hourofday:i32;
  scope:str
};

t=$evalresult{
  ruleid:str;
  matched:bool;
  action:str;
  reason:str
};

f=ensuretable(store:i64):bool{
  let sql="CREATE TABLE IF NOT EXISTS rate_limit_events (
  id TEXT PRIMARY KEY,
  scope TEXT NOT NULL,
  event_ts INTEGER NOT NULL
)";
  <mt db.exec(sql;@()) {
    $ok:v true;
    $err:e false
  }
};

f=evalcondition(cond:$condition;ctx:$evalcontext):bool{
  if(cond.field=="sensitivity"){
    let ctxval=ctx.sensitivity;
    let cmpval=str.toint(cond.value);
    if(cond.op=="eq"){
      <ctxval==cmpval
    }el{
      if(cond.op=="gt"){
        <ctxval>cmpval
      }el{
        if(cond.op=="lt"){
          <ctxval<cmpval
        }el{
          <false
        }
      }
    }
  }el{
    if(cond.field=="model_tier"){
      if(cond.op=="eq"){
        <ctx.modeltier==cond.value
      }el{
        if(cond.op=="contains"){
          <str.contains(ctx.modeltier;cond.value)
        }el{
          if(cond.op=="matches"){
            <str.matches(ctx.modeltier;cond.value)
          }el{
            <false
          }
        }
      }
    }el{
      if(cond.field=="request_count"){
        let ctxval=ctx.requestcount;
        let cmpval=str.toint(cond.value);
        if(cond.op=="eq"){
          <ctxval==cmpval
        }el{
          if(cond.op=="gt"){
            <ctxval>cmpval
          }el{
            if(cond.op=="lt"){
              <ctxval<cmpval
            }el{
              <false
            }
          }
        }
      }el{
        if(cond.field=="hour_of_day"){
          let ctxval=ctx.hourofday;
          let cmpval=str.toint(cond.value);
          if(cond.op=="eq"){
            <ctxval==cmpval
          }el{
            if(cond.op=="gt"){
              <ctxval>cmpval
            }el{
              if(cond.op=="lt"){
                <ctxval<cmpval
              }el{
                <false
              }
            }
          }
        }el{
          if(cond.field=="scope"){
            if(cond.op=="eq"){
              <ctx.scope==cond.value
            }el{
              if(cond.op=="contains"){
                <str.contains(ctx.scope;cond.value)
              }el{
                if(cond.op=="matches"){
                  <str.matches(ctx.scope;cond.value)
                }el{
                  <false
                }
              }
            }
          }el{
            log.warn(str.concat("eval_condition: unknown field: ";cond.field);"rules_engine";"system");
            <false
          }
        }
      }
    }
  }
};

f=evaland(conditions:@$condition;ctx:$evalcontext):bool{
  let allpass=mut.true;
  lp(let ii146=0;ii146<conditions.len;ii146=ii146+1){
    if(allpass){
      if(evalcondition(conditions.get(ii146);ctx)){
        allpass=allpass
      }el{
        allpass=false
      };
    }el{}

  };
  <allpass
};

f=evalor(conditions:@$condition;ctx:$evalcontext):bool{
  let anypass=mut.false;
  lp(let ii162=0;ii162<conditions.len;ii162=ii162+1){
    if(anypass){
      anypass=anypass
    }el{
      if(evalcondition(conditions.get(ii162);ctx)){
        anypass=true
      }el{}
    }

  };
  <anypass
};

f=evalnot(conditions:@$condition;ctx:$evalcontext):bool{
  if(conditions.len==0 as u64){
    <false
  }el{
    <evalcondition(conditions.get(0);ctx)==false
  }
};

f=evaluate(rule:$compoundrule;ctx:$evalcontext):$evalresult{
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let logicv:$ruleop=rule.logic;
  let matched=mt logicv {
    $and:v evaland(rule.conditions;ctx);
    $or:v evalor(rule.conditions;ctx);
    $not:v evalnot(rule.conditions;ctx)
  };
  let reason=mut.str.concat("Rule not matched: ";rule.name);
  if(matched){
    reason=str.concat(str.concat("Rule matched: ";rule.name);str.concat(" -> ";rule.action))
  }el{};
  let action=mut."allow";
  if(matched){ action=rule.action }el{};
  <$evalresult{
    ruleid:rule.id;
    matched:matched;
    action:action;
    reason:reason
  }
};

f=evaluateall(rules:@$compoundrule;ctx:$evalcontext):@$evalresult{
  let results=mut.@();
  lp(let ii207=0;ii207<rules.len;ii207=ii207+1){
    let result=evaluate(rules.get(ii207);ctx);
    if(result.matched){
      results=results.push(result)
    }el{}

  };
  <results
};

f=ratecheckcount(rows:@$row;limit:i32):bool{
  let count=mut.0;
  if(rows.len==0 as u64){}el{
    count=s.rowi64(rows.get(0);"cnt")
  };
  <!(count>limit)
};

f=ratecheck(store:i64;scope:str;limit:i32;windowseconds:i32):bool{
  let nowts=time.unixnow(0);
  let cutoffs=str.fromint(nowts-(windowseconds as i64));

  mt db.exec("DELETE FROM rate_limit_events WHERE scope=? AND event_ts<?";@(scope;cutoffs)) {
    $ok:v 0;
    $err:e
      log.warn(str.concat("rate_check: failed to prune stale events for scope: ";scope);"rules_engine";"system")
  };

  let eventid=str.randhex(16);
  let nows=str.fromint(nowts);
  mt db.exec("INSERT INTO rate_limit_events (id,scope,event_ts) VALUES (?,?,?)";@(eventid;scope;nows)) {
    $ok:v 0;
    $err:e
      log.warn(str.concat("rate_check: failed to insert event for scope: ";scope);"rules_engine";"system")
  };

  <mt db.many("SELECT COUNT(*) as cnt FROM rate_limit_events WHERE scope=? AND event_ts>=?";@(scope;cutoffs)) {
    $ok:rows ratecheckcount(rows;limit);
    $err:e true
  }
};

f=defaultrules():@$compoundrule{
  let rulehighsens=$compoundrule{
    id:"default-high-sensitivity-cloud";
    name:"High sensitivity + cloud model";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"sensitivity"; op:"eq"; value:"3" };
      $condition{ field:"model_tier"; op:"contains"; value:"cloud" }
    );
    action:"warn";
    severity:"high"
  };
  let rulerateburst=$compoundrule{
    id:"default-rate-burst-throttle";
    name:"Request burst exceeds 100";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"request_count"; op:"gt"; value:"100" }
    );
    action:"throttle";
    severity:"medium"
  };
  let ruleoffhours=$compoundrule{
    id:"default-off-hours-premium";
    name:"Premium cloud model used off-hours";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"model_tier"; op:"eq"; value:"cloud-premium" };
      $condition{ field:"hour_of_day"; op:"gt"; value:"21" }
    );
    action:"warn";
    severity:"low"
  };
  let ruleconfidentialexternal=$compoundrule{
    id:"default-confidential-external-scope";
    name:"Confidential data to external scope";
    logic:$ruleop{$and:0};
    conditions:@(
      $condition{ field:"sensitivity"; op:"gt"; value:"1" };
      $condition{ field:"scope"; op:"contains"; value:"external" }
    );
    action:"deny";
    severity:"high"
  };
  <@(rulehighsens;rulerateburst;ruleoffhours;ruleconfidentialexternal)
};

(* Bridge from a named policy preset to this engine's compound rules.

   Only the two preset settings that $evalcontext can actually express are derived, and
   nothing is synthesised beyond them: requireapprovalabove is a sensitivity threshold, and
   crossborderallowed false is a prohibition on the external scope — the same field and
   value the built-in default-confidential-external-scope rule already uses. The rest of a
   preset is not expressible here. Its per-entity anonymisation actions, blocked entity
   types, retention periods and provider permissions have no $condition field to match on,
   so they are enforced through core.policy.loader.evaluate against the preset's own rule
   list, not through this engine. Do not add conditions for them by inventing fields.

   The approval rule's action is "approve", which is not in the vocabulary the built-in
   rules use — allow, warn, throttle, deny. evaluate() copies the action through verbatim
   and this module has no importers, so nothing is being misled; a future consumer must
   handle "approve" as a recorded human decision. Downgrading it to "warn" here would make
   the preset's control quietly weaker than the preset says it is. *)
f=classificationrank(level:str):i64{
  if(str.eq(level;"restricted")){ <3 }el{
    if(str.eq(level;"confidential")){ <2 }el{
      if(str.eq(level;"internal")){ <1 }el{
        <0
      }
    }
  }
};

f=presetrules(name:str):@$compoundrule{
  let out=mut.@();
  if(preg.isknownname(name)){
    let threshold=preg.approvalthresholdfor(name);
    let above=classificationrank(threshold);
    out=out.push($compoundrule{
      id:str.concat(name;"-approval-required");
      name:str.concat("Preset requires a recorded approval above ";threshold);
      logic:$ruleop{$and:0};
      conditions:@(
        $condition{ field:"sensitivity"; op:"gt"; value:str.fromint(above) }
      );
      action:"approve";
      severity:"high"
    });
    if(preg.crossborderallowedfor(name)){}el{
      out=out.push($compoundrule{
        id:str.concat(name;"-no-cross-border");
        name:"Preset forbids cross-border disclosure";
        logic:$ruleop{$and:0};
        conditions:@(
          $condition{ field:"scope"; op:"contains"; value:"external" }
        );
        action:"deny";
        severity:"high"
      })
    }
  }el{
    log.warn(str.concat("preset_rules: no preset registered under name: ";name);"rules_engine";"system")
  };
  <out
};

m=core.governance.forecast;



i=t:shared.types;
i=db:storage.db;
i=str:std.str;

t=$costforecast{
  perioddays:i32;
  projectedcostusd:f64;
  projectedtokens:i32;
  projectedrequests:i32;
  confidence:str;
  generatedat:i64
};






f=forecast(store:i64;historydays:i32;forecastdays:i32):$costforecast{
  let dailyrateusd=0.004;
  let forecastdaysf=str.tofloat(str.fromint(forecastdays));
  let projectedcost=dailyrateusd*forecastdaysf;

  
  
  let dailytokens=613.0;
  let dailyrequests=4.7;
  let projectedtokensf=dailytokens*forecastdaysf;
  let projectedrequestsf=dailyrequests*forecastdaysf;

  let confidence=if(historydays < 7{
    "low"
  }else{
    if(historydays < 30{ "medium" }else{ "high" };
  };

  <$costforecast{
    perioddays:forecastdays;
    projectedcostusd:projectedcost;
    projectedtokens:str.toint(str.fromfloat(projectedtokensf));
    projectedrequests:str.toint(str.fromfloat(projectedrequestsf));
    confidence:confidence;
    generatedat:std.time.now()
  };
};



f=formatforecast(fc:$costforecast):str{
  let periods=str.fromint(fc.perioddays);
  let costs=str.concat("$";str.fromfloat(fc.projectedcostusd));
  let tokenss=str.fromint(fc.projectedtokens);
  let requestss=str.fromint(fc.projectedrequests);

  let header=str.concat(
    "Cost Forecast (next ";
    str.concat(periods;" days)
")
  );
  let divider="==============================
";
  let row1=str.concat("Projected cost:     ";str.concat(costs;"
"));
  let row2=str.concat("Projected tokens:   ";str.concat(tokenss;"
"));
  let row3=str.concat("Projected requests: ";str.concat(requestss;"
"));
  let row4=str.concat("Confidence:         ";str.concat(fc.confidence;"
"));

  <str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(header;divider);
            row1);
          row2);
        row3);
      row4);
    "")
};

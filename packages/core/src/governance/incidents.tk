m=core.governance.incidents;

i=t:shared.types;
i=db:core.storage.db;
i=log:shared.log;
i=str:std.str;
i=sql:std.db;
i=time:std.time;
i=json:std.json;

t=$incidentseverity{ name:str };

t=$incidentstatus{ name:str };

t=$incident{
  id:str;
  title:str;
  severity:str;
  status:str;
  description:str;
  createdat:i64;
  resolvedat:i64;
  resolutionnote:str
};

f=sevp0():str{ <"P0" };
f=sevp1():str{ <"P1" };
f=sevp2():str{ <"P2" };
f=sevp3():str{ <"P3" };

f=statusopen():str{ <"open" };
f=statusinvestigating():str{ <"investigating" };
f=statusresolved():str{ <"resolved" };

f=ensuretable(store:i64):bool{
  let sqltext="CREATE TABLE IF NOT EXISTS incidents (
  id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  severity TEXT NOT NULL,
  status TEXT NOT NULL,
  description TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  resolved_at INTEGER NOT NULL DEFAULT 0,
  resolution_note TEXT NOT NULL DEFAULT ''
)";
  mt sql.execparams(store.conn;sqltext;@()) {
    $ok:v true;
    $err:e false
  }
};

f=openincident(store:i64;title:str;severity:str;description:str):str{
  let id=str.randhex(16);
  let now=time.nowunix();
  let nows=str.fromint(now);
  mt sql.execparams(
    store.conn;
    "INSERT INTO incidents (id,title,severity,status,description,created_at) VALUES (?,?,?,?,?,?)";
    @(id;title;severity;statusopen();description;nows)
  ) {
    $ok:v id;
    $err:e id
  }
};

f=updatestatus(store:i64;id:str;status:str):bool{
  mt sql.execparams(
    store.conn;
    "UPDATE incidents SET status=? WHERE id=?";
    @(status;id)
  ) {
    $ok:v true;
    $err:e false
  }
};

f=resolve(store:i64;id:str;note:str):bool{
  let now=time.nowunix();
  let nows=str.fromint(now);
  mt sql.execparams(
    store.conn;
    "UPDATE incidents SET status=?,resolved_at=?,resolution_note=? WHERE id=?";
    @(statusresolved();nows;note;id)
  ) {
    $ok:v true;
    $err:e false
  }
};

f=listopen(store:i64):@$incident{
  let rows=mt sql.queryparams(
    store.conn;
    "SELECT id,title,severity,status,description,created_at,resolved_at,resolution_note FROM incidents WHERE status != 'resolved' ORDER BY created_at DESC";
    @()
  ) {
    $ok:rows rows;
    $err:e @()
  };
  let openlist=mut.@();
  lp(let oi=0;oi<rows.len;oi=oi+1){
    let row=rows.get(oi);
    openlist=openlist.push($incident{
      id:json.str(row;"id");
      title:json.str(row;"title");
      severity:json.str(row;"severity");
      status:json.str(row;"status");
      description:json.str(row;"description");
      createdat:json.i64(row;"created_at");
      resolvedat:json.i64(row;"resolved_at");
      resolutionnote:json.str(row;"resolution_note")
    })
  };
  <openlist
};

f=autoopenifdegraded(store:i64;model:str;thumbsuprate:f64):bool{
  if(thumbsuprate < 0.5){
    let pct=thumbsuprate*100.0;
    let pcts=str.fromfloat(pct);
    let title=str.concat("Quality degradation: ";model);
    let desc=str.concat("Thumbs-up rate dropped to ";str.concat(pcts;"%"));
    let id=openincident(store;title;sevp2();desc);
    <true
  }el{
    <false
  }
};

f=padright(s:str;width:u32):str{
  let len=str.len(s);
  if(len > width){
    <s
  }el{
    let diff=width-len;
    let spaces="                              ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  }
};

f=formatincidents(incidents:@$incident):str{
  let header="ID               | Severity | Status         | Title                              | Age
";
  let divider="-----------------+----------+----------------+------------------------------------+-------
";
  let body=mut."";
  let now=time.nowunix();
  lp(let ii142=0;ii142<incidents.len;ii142=ii142+1){
    let inc=incidents.get(ii142);
    let agesecs=now-inc.createdat;
    let agemins=agesecs/60;
    let ages=mut."";
    if(agemins < 60){
      ages=str.concat(str.fromint(agemins);"m")
    }el{
      let agehrs=agemins/60;
      if(agehrs < 48){
        ages=str.concat(str.fromint(agehrs);"h")
      }el{
        let agedays=agehrs/24;
        ages=str.concat(str.fromint(agedays);"d")
      }
    };
    let idcol=padright(inc.id;17);
    let sevcol=padright(inc.severity;10);
    let statuscol=padright(inc.status;16);
    let titlecol=padright(inc.title;36);
    let line=str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(idcol;"| ");
            str.concat(sevcol;"| ")
          );
          str.concat(statuscol;"| ")
        );
        str.concat(titlecol;"| ")
      );
      str.concat(ages;"
")
    );
    body=str.concat(body;line)

  };
  <str.concat(str.concat(header;divider);body)
};

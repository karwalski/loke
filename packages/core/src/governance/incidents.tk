m=core.governance.incidents;

i=str:std.str;
i=sql:std.db;
i=time:std.time;
i=t:shared.types;
i=db:core.storage.db;
i=log:shared.log;

t=$incidentseverity{ name:str };

t=$incidentstatus{ name:str };

t=$incident{
  id:str;
  title:str;
  severity:str;
  status:str;
  description:str;
  createdat:i64;
  resolvedat:i64;
  resolutionnote:str
};

f=sevp0():str{ <"P0" };
f=sevp1():str{ <"P1" };
f=sevp2():str{ <"P2" };
f=sevp3():str{ <"P3" };

f=statusopen():str{ <"open" };
f=statusinvestigating():str{ <"investigating" };
f=statusresolved():str{ <"resolved" };

f=ensuretable(store:i64):bool{
  let sqltext="CREATE TABLE IF NOT EXISTS incidents (
  id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  severity TEXT NOT NULL,
  status TEXT NOT NULL,
  description TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  resolved_at INTEGER NOT NULL DEFAULT 0,
  resolution_note TEXT NOT NULL DEFAULT ''
)";
  <mt sql.exec(sqltext;@()) {
    $ok:v true;
    $err:e false
  }
};

f=openincident(store:i64;title:str;severity:str;description:str):str{
  let id=str.randhex(16);
  let now=time.nowunix();
  let nows=str.fromint(now);
  <mt sql.exec("INSERT INTO incidents (id,title,severity,status,description,created_at) VALUES (?,?,?,?,?,?)";@(id;title;severity;statusopen();description;nows)) {
    $ok:v id;
    $err:e id
  }
};

(* ── Both of these reported success for an id that does not exist ─────────────────
   An `UPDATE` matching no row is not an error, and neither function checked, so resolving a
   mistyped incident id returned **true** while the incident stayed open. In an incident
   register that is the worst place for a false success: the operator is told the thing is
   closed and it is not.

   `exists` is the check, and it is deliberately BEFORE the write rather than a row-count
   afterwards — `core.storage.db.countquery` returns `rows.len`, so a
   `SELECT COUNT(1)` through it is 1 for every input and cannot distinguish anything (the
   trap is recorded in `tests/unit/governance/test_incidents.tk` too). `sql.one` returning an
   `$err` for a missing row is the honest signal available here.

   Behaviour on a VALID id is unchanged; only the lie is removed. No callers today (checked). *)
f=exists(id:str):bool{
  <mt sql.one("SELECT id FROM incidents WHERE id=? LIMIT 1";@(id)) {
    $ok:row true;
    $err:e false
  }
};

f=updatestatus(store:i64;id:str;status:str):bool{
  if(exists(id)){}el{
    log.warn(str.concat("updatestatus: no such incident: ";id);"incidents";"system");
    <false
  };
  <mt sql.exec("UPDATE incidents SET status=? WHERE id=?";@(status;id)) {
    $ok:v true;
    $err:e false
  }
};

f=resolve(store:i64;id:str;note:str):bool{
  if(exists(id)){}el{
    log.warn(str.concat("resolve: no such incident: ";id);"incidents";"system");
    <false
  };
  let now=time.nowunix();
  let nows=str.fromint(now);
  <mt sql.exec("UPDATE incidents SET status=?,resolved_at=?,resolution_note=? WHERE id=?";@(statusresolved();nows;note;id)) {
    $ok:v true;
    $err:e false
  }
};

f=rowtoincident(row:$row):$incident{
  <$incident{
    id:db.rowstr(row;"id");
    title:db.rowstr(row;"title");
    severity:db.rowstr(row;"severity");
    status:db.rowstr(row;"status");
    description:db.rowstr(row;"description");
    createdat:db.rowi64(row;"created_at");
    resolvedat:db.rowi64(row;"resolved_at");
    resolutionnote:db.rowstr(row;"resolution_note")
  }
};

f=incidentsfrom(sqltext:str;params:@str):@$incident{
  let rows=mt sql.many(sqltext;params) {
    $ok:rows rows;
    $err:e @()
  };
  let out=mut.@();
  lp(let oi=0;oi<rows.len;oi=oi+1){
    let row:$row=rows.get(oi);
    out=out.push(rowtoincident(row))
  };
  <out
};

f=listopen(store:i64):@$incident{
  <incidentsfrom("SELECT id,title,severity,status,description,created_at,resolved_at,resolution_note FROM incidents WHERE status != ? ORDER BY created_at DESC";@(statusresolved()))
};

(* T10.2. Every incident, resolved ones included: the register is a record, and a resolved
   incident is the part of it an assessor reads. *)
f=listall(store:i64):@$incident{
  <incidentsfrom("SELECT id,title,severity,status,description,created_at,resolved_at,resolution_note FROM incidents WHERE id<>? ORDER BY created_at DESC";@(""))
};

(* T10.2. One incident by id. An unknown id is an incident with an empty id, tested with
   isincident: a caller cannot tell the arms of a user-sum result apart (T-18). *)
f=noincident():$incident{
  <$incident{id:"";title:"";severity:"";status:"";description:"";createdat:0;resolvedat:0;resolutionnote:""}
};

f=isincident(inc:$incident):bool{
  <str.len(inc.id)>0
};

f=get(store:i64;id:str):$incident{
  let found=incidentsfrom("SELECT id,title,severity,status,description,created_at,resolved_at,resolution_note FROM incidents WHERE id=?";@(id));
  if(found.len==0){ <noincident() }el{};
  <found.get(0)
};

(* T10.2 / G3.2. The post-incident review, pre-filled with what the register knows and with
   the questions the register cannot answer left as headings to fill in. The description and
   resolution note are the operator's own words and are copied as written. *)
f=postincidenttemplate(inc:$incident):str{
  <"# Post-incident review: \(inc.title)

- Incident: \(inc.id)
- Severity: \(inc.severity)
- Status: \(inc.status)

## What happened
\(inc.description)

## Resolution
\(inc.resolutionnote)

## Impact
Who and what was affected, and for how long.

## Root cause

## Detection
How it was found, and how it could have been found sooner.

## Actions
Each with an owner and a date.
"
};

f=autoopenifdegraded(store:i64;model:str;thumbsuprate:f64):bool{
  if(thumbsuprate < 0.5){
    let pcts=str.fromfloat(thumbsuprate*100.0);
    let title=str.concat("Quality degradation: ";model);
    let desc="Thumbs-up rate dropped to \(pcts)%";
    let id=openincident(store;title;sevp2();desc);
    <true
  }el{
    <false
  }
};


f=formatincidents(incidents:@$incident):str{
  let header="ID               | Severity | Status         | Title                              | Age
";
  let divider="-----------------+----------+----------------+------------------------------------+-------
";
  let body=mut."";
  let now=time.nowunix();
  lp(let ii142=0;ii142<incidents.len;ii142=ii142+1){
    let inc=incidents.get(ii142);
    let agemins=(now-inc.createdat)/60;
    let ages=mut."";
    if(agemins < 60){
      ages=str.concat(str.fromint(agemins);"m")
    }el{
      let agehrs=agemins/60;
      if(agehrs < 48){
        ages=str.concat(str.fromint(agehrs);"h")
      }el{
        ages=str.concat(str.fromint(agehrs/24);"d")
      }
    };
    let idcol=t.strpad(inc.id;17);
    let sevcol=t.strpad(inc.severity;10);
    let statuscol=t.strpad(inc.status;16);
    let titlecol=t.strpad(inc.title;36);
    let line="\(idcol)| \(sevcol)| \(statuscol)| \(titlecol)| \(ages)\n";
    body=str.concat(body;line)

  };
  <"\(header)\(divider)\(body)"
};

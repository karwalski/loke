m=core.i18n.locales;

(* Ported from src/platform/i18n/locales.tk (F10.12-T1).

   Three things changed in the port, and none of them is cosmetic.

   The type declarations moved here from the translator. The legacy pair was
   circular in effect: locales imported the translator only to reach
   $locale/$localeentry, while the translator held no locale data at all. The data
   module owns the data types, and the translator imports this one.

   Every entry list is now one array LITERAL. The legacy bodies were sixty
   `entries.push(...)` statements whose results were all discarded — `.push` returns
   the new array and does not mutate in place (T-24), so both tables were built and
   then thrown away and `enau()`/`enus()` each returned an empty locale. Nothing had
   ever run this module, so the empty tables were never observed. A literal cannot
   have that defect.

   `initdefault()` is gone rather than ported. It called `tr.loadlocale(enau())` and
   `tr.setlocale("en-AU")` with one argument each when both took two, and discarded
   all three of its results. It had no callers, and the stateless translator this
   port lands alongside has nothing for it to initialise.

   F10.12c added the 51 `loke.cli.*` keys that cli.feedback, cli.locale, cli.policy,
   cli.stats and cli.verbose ask for; before it each would have printed as its key. The
   CLI carries no fallback strings, so the text follows the usage descriptions in
   locales/en.json (`loke.cli.cmd.*`) and what each call site prints after it: a value
   that ends in ": " is followed by the value the caller concatenates. Both tables carry
   every key (the parity cli.locale's validate checks); none of these strings has an
   en-AU/en-US spelling difference, so the two are identical. *)

t=$localeentry{
  key:str;
  value:str
};

t=$locale{
  code:str;
  entries:@$localeentry
};

f=enau():$locale{
  <$locale{
    code:"en-AU";
    entries:@(
      $localeentry{ key:"loke.app_name"; value:"loke" };
      $localeentry{ key:"loke.tagline"; value:"Your intelligence layer. Your data, your rules." };
      $localeentry{ key:"loke.nav.datasets"; value:"Datasets" };
      $localeentry{ key:"loke.nav.analysis"; value:"Analysis" };
      $localeentry{ key:"loke.nav.dashboard"; value:"Dashboard" };
      $localeentry{ key:"loke.nav.insight"; value:"Insight" };
      $localeentry{ key:"loke.nav.upload"; value:"Upload" };
      $localeentry{ key:"loke.nav.settings"; value:"Settings" };
      $localeentry{ key:"loke.status.connecting"; value:"Connecting…" };
      $localeentry{ key:"loke.status.connected"; value:"Connected" };
      $localeentry{ key:"loke.status.offline"; value:"Offline" };
      $localeentry{ key:"loke.privacy.on"; value:"Privacy on — anonymising your data" };
      $localeentry{ key:"loke.privacy.off"; value:"Privacy off — data sent as-is" };
      $localeentry{ key:"loke.sensitivity.public"; value:"Public" };
      $localeentry{ key:"loke.sensitivity.internal"; value:"Internal" };
      $localeentry{ key:"loke.sensitivity.confidential"; value:"Confidential" };
      $localeentry{ key:"loke.sensitivity.restricted"; value:"Restricted" };
      $localeentry{ key:"loke.btn.load"; value:"Load" };
      $localeentry{ key:"loke.btn.cancel"; value:"Cancel" };
      $localeentry{ key:"loke.btn.approve"; value:"Approve" };
      $localeentry{ key:"loke.btn.save"; value:"Save" };
      $localeentry{ key:"loke.btn.delete"; value:"Delete" };
      $localeentry{ key:"loke.btn.export"; value:"Export" };
      $localeentry{ key:"loke.err.nodataset"; value:"No dataset loaded. Please upload or select a dataset to continue." };
      $localeentry{ key:"loke.err.lokeoffline"; value:"loke is offline. Check your connection and try again." };
      $localeentry{ key:"loke.pipeline.ready"; value:"Pipeline ready" };
      $localeentry{ key:"loke.pipeline.running"; value:"Pipeline running…" };
      $localeentry{ key:"loke.pipeline.done"; value:"Pipeline complete" };
      $localeentry{ key:"loke.feedback.thumbsup"; value:"This response was helpful" };
      $localeentry{ key:"loke.feedback.thumbsdown"; value:"This response was not helpful" };
      $localeentry{ key:"loke.entities_zero"; value:"No personal data found" };
      $localeentry{ key:"loke.entities_one"; value:"{{0}} item of personal data anonymised" };
      $localeentry{ key:"loke.entities_other"; value:"{{0}} items of personal data anonymised" };
      $localeentry{ key:"loke.cli.feedback.usage"; value:"Usage: loke feedback <report|version>" };
      $localeentry{ key:"loke.cli.feedback.usage_report"; value:"  report    Submit feedback or a bug report" };
      $localeentry{ key:"loke.cli.feedback.usage_version"; value:"  version   Check for available updates" };
      $localeentry{ key:"loke.cli.feedback.issue_report"; value:"Issue report" };
      $localeentry{ key:"loke.cli.feedback.issue_type"; value:"Issue type: bug" };
      $localeentry{ key:"loke.cli.feedback.report_created"; value:"Report created: " };
      $localeentry{ key:"loke.cli.feedback.checking_updates"; value:"Checking for updates…" };
      $localeentry{ key:"loke.cli.feedback.current_version"; value:"Current version:" };
      $localeentry{ key:"loke.cli.feedback.channel"; value:"Update channel:" };
      $localeentry{ key:"loke.cli.feedback.up_to_date"; value:"loke is up to date." };
      $localeentry{ key:"loke.cli.locale.usage"; value:"Usage: loke locale <list|validate>" };
      $localeentry{ key:"loke.cli.locale.usage_list"; value:"  list       List available locales" };
      $localeentry{ key:"loke.cli.locale.usage_validate"; value:"  validate   Check that en-US has every en-AU key" };
      $localeentry{ key:"loke.cli.locale.available"; value:"Available locales:" };
      $localeentry{ key:"loke.cli.locale.active_marker"; value:" (active)" };
      $localeentry{ key:"loke.cli.locale.validation_ok"; value:"en-US has every en-AU key." };
      $localeentry{ key:"loke.cli.locale.validation_passed"; value:"Locale validation passed." };
      $localeentry{ key:"loke.cli.locale.missing_keys"; value:" missing keys:" };
      $localeentry{ key:"loke.cli.locale.validation_failed"; value:"Locale validation failed." };
      $localeentry{ key:"loke.cli.policy.usage"; value:"Usage: loke policy <list|validate|show>" };
      $localeentry{ key:"loke.cli.policy.usage_list"; value:"  list              Show the policy tiers and their merge order" };
      $localeentry{ key:"loke.cli.policy.usage_validate"; value:"  validate <file>   Validate a policy file" };
      $localeentry{ key:"loke.cli.policy.usage_show"; value:"  show <file>       Show the settings in a policy file" };
      $localeentry{ key:"loke.cli.policy.validate_usage"; value:"Usage: loke policy validate <file>" };
      $localeentry{ key:"loke.cli.policy.show_usage"; value:"Usage: loke policy show <file>" };
      $localeentry{ key:"loke.cli.policy.unknown_sub"; value:"Unknown policy subcommand: " };
      $localeentry{ key:"loke.cli.policy.active_sources"; value:"Policy tiers, highest precedence first:" };
      $localeentry{ key:"loke.cli.policy.source_enterprise"; value:"  enterprise" };
      $localeentry{ key:"loke.cli.policy.source_team"; value:"  team" };
      $localeentry{ key:"loke.cli.policy.source_user"; value:"  user" };
      $localeentry{ key:"loke.cli.policy.merge_order"; value:"Merge order: built-in defaults, then user, then team, then enterprise." };
      $localeentry{ key:"loke.cli.policy.enterprise_blocks"; value:"An enterprise setting overrides the same team or user setting; blocked entity types and custom rules from every tier are kept." };
      $localeentry{ key:"loke.cli.policy.validating"; value:"Validating policy file: " };
      $localeentry{ key:"loke.cli.policy.load_failed"; value:"Could not load policy file: " };
      $localeentry{ key:"loke.cli.policy.valid"; value:"Policy is valid." };
      $localeentry{ key:"loke.cli.policy.validation_failed"; value:"Policy validation failed." };
      $localeentry{ key:"loke.cli.stats.dashboard"; value:"Savings and usage statistics" };
      $localeentry{ key:"loke.cli.stats.separator"; value:"------------------------------" };
      $localeentry{ key:"loke.cli.stats.total_requests"; value:"Total requests: " };
      $localeentry{ key:"loke.cli.stats.tokens_saved"; value:"Tokens saved: " };
      $localeentry{ key:"loke.cli.stats.cost_saved"; value:"Cost saved (USD): " };
      $localeentry{ key:"loke.cli.stats.pii_intercepted"; value:"PII items intercepted: " };
      $localeentry{ key:"loke.cli.stats.local_requests"; value:"Local requests: " };
      $localeentry{ key:"loke.cli.stats.cloud_requests"; value:"Cloud requests: " };
      $localeentry{ key:"loke.cli.stats.cache_hit_rate"; value:"Cache hit rate: " };
      $localeentry{ key:"loke.cli.stats.load_failed"; value:"Could not load usage statistics." };
      $localeentry{ key:"loke.cli.verbose.pipeline_run"; value:"Pipeline run: " };
      $localeentry{ key:"loke.cli.verbose.request"; value:"Request: " };
      $localeentry{ key:"loke.cli.verbose.status"; value:"Status: " };
      $localeentry{ key:"loke.cli.verbose.duration"; value:"Duration: " };
      $localeentry{ key:"loke.cli.verbose.pipeline_summary"; value:"Pipeline summary: " }
    )
  }
};


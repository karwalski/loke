m=core.i18n.layout;

i=str:std.str;

(* Ported from src/platform/i18n/layout.tk (F10.12-T2).

   Two behaviours changed in the port, because the legacy bodies contradicted the spec they
   were written against (docs/specifications/internationalisation.md section 5).

   `dir` returned "ltr" and `isrtl` returned false for every locale. Section 5.3 says RTL
   support is not required in v1 but that nothing may HARDCODE a left-to-right assumption,
   and a direction function that ignores its argument is exactly that hardcoding. Both now
   read the primary language subtag. No locale this build ships is right-to-left, so every
   caller today still gets "ltr"; the difference is that a future Arabic or Hebrew table
   would not be laid out backwards by this module.

   `expandtolerance()` returned one figure, 1.4, for every string. Section 5.1 gives the
   expected expansion by source length and the short strings expand the most, so
   `expansionfor(len)` returns the upper bound of the band the length falls in. The single
   figure is kept, as f64, for callers that want the old constant. *)

(* The primary language subtag of a locale code, lower-cased: "ar-EG" and "AR" both give
   "ar". *)
f=primarytag(localecode:str):str{
  let lower=str.lower(str.trim(localecode));
  let dash=str.indexof(lower;"-");
  let under=str.indexof(lower;"_");
  if(dash>0){ <mt str.slice(lower;0;dash){$ok:okv okv;$err:errv ""} }el{};
  if(under>0){ <mt str.slice(lower;0;under){$ok:okv okv;$err:errv ""} }el{};
  <lower
};

(* Languages written right to left. *)
f=rtltags():@str{
  <@("ar";"he";"fa";"ur";"yi";"ps";"dv";"ckb";"sd";"ug")
};

f=isrtl(localecode:str):bool{
  let tag=primarytag(localecode);
  let tags=rtltags();
  lp(let i=0;i<tags.len;i=i+1){
    if(str.eq(tags.get(i);tag)){ <true }el{}
  };
  <false
};

f=dir(localecode:str):str{
  if(isrtl(localecode)){ <"rtl" }el{};
  <"ltr"
};

(* The code is quoted into an attribute, so a quote or angle bracket in it is dropped
   rather than allowed to end the attribute. *)
f=langattr(localecode:str):str{
  <"lang=\"\(unquoted(localecode))\""
};

f=unquoted(s:str):str{
  <str.replace(str.replace(str.replace(s;"\"";"");"<";"");">";"")
};

(* `dir="…"` for the same locale, so a container can carry both. *)
f=dirattr(localecode:str):str{
  <"dir=\"\(dir(localecode))\""
};

(* The legacy single figure. *)
f=expandtolerance():f64{
  <1.4
};

(* Section 5.1: the upper bound of the expected expansion for an English source string of
   `len` characters. *)
f=expansionfor(len:i64):f64{
  if(len<=10){ <3.0 }el{};
  if(len<=20){ <2.0 }el{};
  if(len<=70){ <1.8 }el{};
  <1.5
};

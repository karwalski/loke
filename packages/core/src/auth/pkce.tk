m=loke.core.auth.pkce;

i=str:std.str;
i=crypto:std.crypto;
i=encoding:std.encoding;

f=minverifierlen():i32{ <43 };
f=maxverifierlen():i32{ <128 };

f=generateverifier():str{
  <crypto.randombase64url(64)
};

f=generatechallenge(verifier:str):str{
  let hash=crypto.sha256(str.tobytes(verifier));
  <encoding.base64urlencodenopad(hash)
};

f=challengemethod():str{
  <"S256"
};

f=isvalidverifier(verifier:str):bool{
  let len=str.len(verifier);
  if(len<43){
    <false
  }el{
    if(len>128){
      <false
    }el{
      <true
    }
  }
};

f=verify(verifier:str;challenge:str):bool{
  let computed=generatechallenge(verifier);
  <str.eq(computed;challenge)
};

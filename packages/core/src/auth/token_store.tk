m=loke.core.auth.tokenstore;

i=str:std.str;
i=log:std.log;
i=kc:std.keychain;

t=$tokenset{
  accesstoken:str;
  refreshtoken:str;
  expiresat:i64;
  scopes:str
};

f=service():str{ <"dev.loke" };

f=account(adapterid:str;field:str):str{
  <"oauth.\(adapterid).\(field)"
};

(* LS1.1m — these three were declared `i64`, returned nothing, and discarded every
   keychain result, so a token that failed to save was reported as saved. Each now returns
   whether EVERY keychain operation succeeded. *)
f=savetokens(adapterid:str;tokens:$tokenset):bool{
  let ok=mut.true;
  if(kc.set(service();account(adapterid;"access_token");tokens.accesstoken)){}el{ ok=false };
  if(kc.set(service();account(adapterid;"refresh_token");tokens.refreshtoken)){}el{ ok=false };
  if(kc.set(service();account(adapterid;"expires_at");str.fromint(tokens.expiresat))){}el{ ok=false };
  if(kc.set(service();account(adapterid;"scope");tokens.scopes)){}el{ ok=false };
  log.info(str.concat("loke.core.auth.tokenstore: saved tokens for ";adapterid);@());
  <ok
};

f=loadaccesstoken(adapterid:str):str{
  <mt kc.get(service();account(adapterid;"access_token")) {
    $some:v v;
    $none:v ""
  }
};

f=loadrefreshtoken(adapterid:str):str{
  <mt kc.get(service();account(adapterid;"refresh_token")) {
    $some:v v;
    $none:v ""
  }
};

f=loadexpiresat(adapterid:str):i64{
  <mt kc.get(service();account(adapterid;"expires_at")) {
    $some:v str.toint64(v);
    $none:v 0
  }
};

f=loadscopes(adapterid:str):str{
  <mt kc.get(service();account(adapterid;"scope")) {
    $some:v v;
    $none:v ""
  }
};

f=hastokens(adapterid:str):bool{
  <kc.exists(service();account(adapterid;"access_token"))
};

f=cleartokens(adapterid:str):bool{
  let ok=mut.true;
  if(kc.delete(service();account(adapterid;"access_token"))){}el{ ok=false };
  if(kc.delete(service();account(adapterid;"refresh_token"))){}el{ ok=false };
  if(kc.delete(service();account(adapterid;"expires_at"))){}el{ ok=false };
  if(kc.delete(service();account(adapterid;"scope"))){}el{ ok=false };
  log.info(str.concat("loke.core.auth.tokenstore: cleared tokens for ";adapterid);@());
  <ok
};

f=updateaccesstoken(adapterid:str;accesstoken:str;expiresat:i64):bool{
  let ok=mut.true;
  if(kc.set(service();account(adapterid;"access_token");accesstoken)){}el{ ok=false };
  if(kc.set(service();account(adapterid;"expires_at");str.fromint(expiresat))){}el{ ok=false };
  log.info(str.concat("loke.core.auth.tokenstore: updated access token for ";adapterid);@());
  <ok
};

m=loke.core.auth.tokenstore;

i=str:std.str;
i=log:std.log;
i=kc:std.keychain;

t=$tokenset{
  accesstoken:str;
  refreshtoken:str;
  expiresat:i64;
  scopes:str
};

f=service():str{ <"dev.loke" };

f=account(adapterid:str;field:str):str{
  <str.concat("oauth.";str.concat(adapterid;str.concat(".";field)))
};

f=savetokens(adapterid:str;tokens:$tokenset):i64{
  kc.set(service();account(adapterid;"access_token");tokens.accesstoken);
  kc.set(service();account(adapterid;"refresh_token");tokens.refreshtoken);
  kc.set(service();account(adapterid;"expires_at");str.fromint64(tokens.expiresat));
  kc.set(service();account(adapterid;"scope");tokens.scopes);
  log.info(str.concat("loke.core.auth.tokenstore: saved tokens for ";adapterid))
};

f=loadaccesstoken(adapterid:str):str{
  let result=kc.get(service();account(adapterid;"access_token"));
  mt result {
    $some:v v;
    $none:v ""
  }
};

f=loadrefreshtoken(adapterid:str):str{
  let result=kc.get(service();account(adapterid;"refresh_token"));
  mt result {
    $some:v v;
    $none:v ""
  }
};

f=loadexpiresat(adapterid:str):i64{
  let result=kc.get(service();account(adapterid;"expires_at"));
  mt result {
    $some:v str.toint64(v);
    $none:v 0
  }
};

f=loadscopes(adapterid:str):str{
  let result=kc.get(service();account(adapterid;"scope"));
  mt result {
    $some:v v;
    $none:v ""
  }
};

f=hastokens(adapterid:str):bool{
  <kc.exists(service();account(adapterid;"access_token"))
};

f=cleartokens(adapterid:str):i64{
  kc.delete(service();account(adapterid;"access_token"));
  kc.delete(service();account(adapterid;"refresh_token"));
  kc.delete(service();account(adapterid;"expires_at"));
  kc.delete(service();account(adapterid;"scope"));
  log.info(str.concat("loke.core.auth.tokenstore: cleared tokens for ";adapterid))
};

f=updateaccesstoken(adapterid:str;accesstoken:str;expiresat:i64):i64{
  kc.set(service();account(adapterid;"access_token");accesstoken);
  kc.set(service();account(adapterid;"expires_at");str.fromint64(expiresat));
  log.info(str.concat("loke.core.auth.tokenstore: updated access token for ";adapterid))
};

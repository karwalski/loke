m=loke.core.auth.oauth;

i=time:std.time;
i=crypto:std.crypto;
i=http:std.http;
i=str:std.str;
i=json:std.json;
i=jx:shared.jsonobj;
i=log:shared.log;
i=reach:shared.reachability;
i=pkce:loke.core.auth.pkce;
i=refresh:loke.core.auth.refresh;
i=store:loke.core.auth.tokenstore;

t=$oautherr{
  adapterid:str;
  errorcode:str;
  errordesc:str
};

t=$authstate{
  stateparam:str;
  codeverifier:str;
  redirecturi:str
};

(* VM1.6i: the outcome of a token exchange; see exchange below. *)
t=$tokenreply{
  ok:bool;
  tokens:$tokenset;
  err:$oautherr
};

f=newconfig(adapterid:str;clientid:str;authoriseurl:str;tokenurl:str;scopes:str):$oauthconfig{
  <$oauthconfig{
    adapterid:adapterid;
    clientid:clientid;
    authoriseurl:authoriseurl;
    tokenurl:tokenurl;
    scopes:scopes;
    revokeurl:"";
    callbackport:0
  }
};

f=withrevokeurl(cfg:$oauthconfig;url:str):$oauthconfig{
  <$oauthconfig{
    adapterid:cfg.adapterid;
    clientid:cfg.clientid;
    authoriseurl:cfg.authoriseurl;
    tokenurl:cfg.tokenurl;
    scopes:cfg.scopes;
    revokeurl:url;
    callbackport:cfg.callbackport
  }
};

f=withcallbackport(cfg:$oauthconfig;port:i32):$oauthconfig{
  <$oauthconfig{
    adapterid:cfg.adapterid;
    clientid:cfg.clientid;
    authoriseurl:cfg.authoriseurl;
    tokenurl:cfg.tokenurl;
    scopes:cfg.scopes;
    revokeurl:cfg.revokeurl;
    callbackport:port
  }
};

f=buildauthoriseurl(cfg:$oauthconfig;stateparam:str;codechallenge:str;redirecturi:str):str{
  let url=str.concat(cfg.authoriseurl;"?response_type=code");
  let url="\(url)&client_id=\(cfg.clientid)";
  let url="\(url)&redirect_uri=\(redirecturi)";
  let url="\(url)&scope=\(cfg.scopes)";
  let url="\(url)&state=\(stateparam)";
  let url="\(url)&code_challenge=\(codechallenge)";
  let url=str.concat(url;"&code_challenge_method=S256");
  <url
};

f=redirecturi(port:i32):str{
  <"http://localhost:\(str.fromint(port))/callback"
};

f=generatestate():str{
  <crypto.randomhex(32)
};

(* F10.39, toke 3.1.0. This was `http.postheaders(http.client(url);"";bytes;headersjson)`,
   the client-first four-argument shape that toke 0b0bc4e compiled and that sent NOTHING
   (T-48): the request never left the machine and the match took its error arm. 3.1.0
   rejects that shape (E4026), and the typed three-argument call that replaces it really
   sends. Migrating the call must not quietly start sending to a host it never reached, so a
   non-loopback URL takes the error path without a byte sent, which is what callers observed
   before.

   VM1.6g, measured at toke 3.1.0: this call verifies the server's certificate and its name,
   and the form Content-Type given here replaces the default instead of being sent beside it
   (tests/integration/test_hosted_tls.tk drives it at a TLS recorder on loopback: one
   Content-Type arrives, the form one, and nothing arrives from a self-signed certificate).
   So the hold is no longer the client's (T-58 was lifted for the providers on 2026-10-01).
   Sending to a remote token endpoint is a product decision with a privacy review, since a token request carries the authorisation code and the client id:
   F10.41. *)
f=exchangecode(cfg:$oauthconfig;code:str;codeverifier:str;redir:str):$tokenset!$oautherr{
  let x=exchange(cfg;code;codeverifier;redir);
  if(x.ok){ <$ok(x.tokens) }el{};
  <$err(x.err)
};

(* VM1.6i. The exchange's outcome as a plain struct, so that neither exchangecode nor
   completeauthorise carries a result out of a match arm. Before this, the send's ok arm
   answered tokensfromresp's own `$tokenset!$oautherr`, a function that returned a BARE
   `$tokenset` or `$oautherr`, and it read its tokens with `encoding.jsonfield`, an untyped
   (i64,i64) ABI helper, from `str.frombytes(resp.body)` left unmatched (a `str!EncodingErr`
   since toke 3.1.0). Measured by tests/integration/test_hosted_tls.tk: the caller's
   `accesstoken` held the REFRESH token. Each token is now read from its own field with the
   typed std.json accessors.

   Success is a 2xx carrying an access token, and nothing else. The old test was
   `status>400`, so a 400 (RFC 6749's invalid_grant) was a success with an empty token, and
   so were 1xx and 3xx. No token, code or verifier is written to a log or to an error. *)
f=notokens():$tokenset{
  <$tokenset{accesstoken:"";refreshtoken:"";expiresat:0;scopes:""}
};

f=failed(cfg:$oauthconfig;errorcode:str;errordesc:str):$tokenreply{
  <$tokenreply{ok:false;tokens:notokens();err:$oautherr{adapterid:cfg.adapterid;errorcode:errorcode;errordesc:errordesc}}
};

f=issuccess(status:u64):bool{
  <status>=200 && status<300
};

f=exchange(cfg:$oauthconfig;code:str;codeverifier:str;redir:str):$tokenreply{
  if(!reach.isloopbackurl(cfg.tokenurl)){
    log.warn("token exchange refused: only a loopback token endpoint is sent to (F10.39)";"auth.oauth";"");
    <failed(cfg;"network_error";"token request failed")
  }el{};
  <mt http.postheaders(cfg.tokenurl;"grant_type=authorization_code&code=\(code)&redirect_uri=\(redir)&client_id=\(cfg.clientid)&code_verifier=\(codeverifier)";@(@("content-type";"application/x-www-form-urlencoded"))) {
    $ok:r tokensfromresp(cfg;r);
    $err:e failed(cfg;"network_error";"token request failed")
  }
};

(* Reading the response in its own function is what establishes its type. Binding
   `let resp=mt ... { $ok:r r; $err:e $err(...) }` gave resp two different types,
   so resp.status and resp.body resolved against no struct at all. *)
f=tokensfromresp(cfg:$oauthconfig;resp:$httpresp):$tokenreply{
  if(!issuccess(resp.status)){
    let msg="token endpoint returned \(resp.status)";
    log.warn("loke.core.auth.oauth: \(msg)";"auth.oauth";"");
    <failed(cfg;"token_exchange_failed";msg)
  }el{};
  let body=mt str.frombytes(resp.body) { $ok:s s; $err:e "" };
  let o=mt json.dec(body) { $ok:v v; $jsonerr:e jx.emptyobj() };
  let access=jx.strvalue(o;"access_token";"");
  if(str.len(access)==0){
    log.warn("loke.core.auth.oauth: token response carried no access token";"auth.oauth";"");
    <failed(cfg;"token_exchange_failed";"token response carried no access token")
  }el{};
  let expiresin=mt json.i64(o;"expires_in") { $ok:n n; $err:x 0 };
  log.info("loke.core.auth.oauth: tokens acquired for \(cfg.adapterid)";"auth.oauth";"");
  <$tokenreply{
    ok:true;
    tokens:$tokenset{
      accesstoken:access;
      refreshtoken:jx.strvalue(o;"refresh_token";"");
      expiresat:time.nowunix()+expiresin;
      scopes:cfg.scopes
    };
    err:$oautherr{adapterid:cfg.adapterid;errorcode:"";errordesc:""}
  }
};

f=validatestate(expected:str;actual:str):bool{
  <str.eq(expected;actual)
};

(* One `port`, not two. `let port=8739` inside the if shadowed the outer binding, and
   toke emits invalid LLVM IR for ANY let that shadows an enclosing one — the branch
   allocates and the load sits outside it. Both arms were otherwise identical, so
   they are one body now.

   The authorise URL is built and logged rather than bound and dropped: $authstate has
   no field for it, and the previous `let url=...` was never read. The caller needs
   the URL, so it is returned. *)
f=beginauthorise(cfg:$oauthconfig):$authstate{
  let verifier=pkce.generateverifier();
  let challenge=pkce.generatechallenge(verifier);
  let stateparam=generatestate();
  let port=mut.cfg.callbackport;
  if(port==0){
    port=8739
  }el{};
  let redir=redirecturi(port);
  log.info("loke.core.auth.oauth: authorise URL for \(cfg.adapterid): \(buildauthoriseurl(cfg;stateparam;challenge;redir))";"auth.oauth";"");
  <$authstate{
    stateparam:stateparam;
    codeverifier:verifier;
    redirecturi:redir
  }
};



(* VM1.6i. A failed exchange stores nothing and answers its error. Before, the error arm
   assigned an `$err(...)` to the tokenset being built and savetokens ran whatever came back.
   The access token goes to the keychain account `oauth.<adapter>.access_token` and the
   refresh token to `oauth.<adapter>.refresh_token` (core.auth.tokenstore); a keychain write
   that fails is an error, not a completed authorisation. *)
f=completeauthorise(cfg:$oauthconfig;auth:$authstate;callbackstate:str;code:str):$tokenset!$oautherr{
  if(!validatestate(auth.stateparam;callbackstate)){
    log.warn(str.concat("loke.core.auth.oauth: state mismatch for ";cfg.adapterid);"auth.oauth";"");
    <$err($oautherr{adapterid:cfg.adapterid;errorcode:"state_mismatch";errordesc:"CSRF validation failed state parameter does not match"})
  }el{};
  let x=exchange(cfg;code;auth.codeverifier;auth.redirecturi);
  if(!x.ok){ <$err(x.err) }el{};
  if(!store.savetokens(cfg.adapterid;x.tokens)){
    log.warn(str.concat("loke.core.auth.oauth: tokens could not be saved to the keychain for ";cfg.adapterid);"auth.oauth";"");
    <$err($oautherr{adapterid:cfg.adapterid;errorcode:"keychain_failed";errordesc:"tokens could not be saved"})
  }el{};
  log.info(str.concat("loke.core.auth.oauth: authorisation complete for ";cfg.adapterid);"auth.oauth";"");
  <$ok(x.tokens)
};

f=getaccesstoken(cfg:$oauthconfig):str{
  <refresh.getvalidtoken(cfg)
};

f=isauthorised(adapterid:str):bool{
  <store.hastokens(adapterid)
};

(* LS1.1m — declared `i64` and returned nothing. It now returns whether the local tokens
   were cleared, which is the part of revocation this process controls; the remote
   revocation request is best-effort and logged. *)
f=revoke(cfg:$oauthconfig):bool{
  let access=store.loadaccesstoken(cfg.adapterid);
  if(str.len(access)>0){
    if(str.len(cfg.revokeurl)>0){
      (* F10.39: the same loopback rule as exchangecode. A refused revocation is logged as a
         failed request, which is what the client-first call always produced. *)
      if(reach.isloopbackurl(cfg.revokeurl)){
        mt http.postheaders(cfg.revokeurl;str.concat("token=";access);@(@("content-type";"application/x-www-form-urlencoded"))) {
          $ok:v 0;
          $err:v log.warn("loke.core.auth.oauth: revocation request failed";"auth.oauth";"")
        };
        log.info(str.concat("loke.core.auth.oauth: revocation request sent for ";cfg.adapterid);"auth.oauth";"")
      }el{
        log.warn("loke.core.auth.oauth: revocation request failed: only a loopback revoke url is sent to (F10.39)";"auth.oauth";"")
      }
    }el{
      log.info("loke.core.auth.oauth: no revoke url configured";"auth.oauth";"")
    }
  }el{
    log.info("loke.core.auth.oauth: no access token to revoke";"auth.oauth";"")
  };
  let cleared=store.cleartokens(cfg.adapterid);
  log.info(str.concat("loke.core.auth.oauth: tokens cleared for ";cfg.adapterid);"auth.oauth";"");
  <cleared
};

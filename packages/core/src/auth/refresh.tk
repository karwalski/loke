m=loke.core.auth.refresh;

i=time:std.time;

t=$oauthconfig{
  adapterid:str;
  clientid:str;
  authoriseurl:str;
  tokenurl:str;
  scopes:str;
  revokeurl:str;
  callbackport:i32
};

t=$refreshresult{
  ok:bool;
  accesstoken:str;
  refreshtoken:str;
  expiresin:i64;
  status:i32;
  errormsg:str
};

f=refreshbuffersecs():i64{ <300 };

f=needsrefresh(expiresat:i64;now:i64):bool{
  let threshold=expiresat-refreshbuffersecs();
  <now>threshold
};

f=isexpired(expiresat:i64;now:i64):bool{
  <now>expiresat
};

f=dorefresh(tokenurl:str;clientid:str;refreshtok:str):$refreshresult{
  let client=http.client(tokenurl);
  let body=str.concat("grant_type=refresh_token";
    str.concat("&refresh_token=";str.concat(refreshtok;
    str.concat("&client_id=";clientid))));
  let httpresult=http.post(client;"";str.tobytes(body);"application/x-www-form-urlencoded");
  let httpok=mt httpresult {
    $ok:r true;
    $err:e false
  };
  if(!$httpok){
    <$refreshresult{ok:false;accesstoken:"";refreshtoken:"";expiresin:0;status:0;errormsg:"network error"}
  }el{};
  let resp=mt httpresult {
    $ok:r r;
    $err:e e
  };
  if(resp.status>400){
    let msg=str.concat("refresh failed with status ";str.fromint(resp.status));
    <$refreshresult{
      ok:false;
      accesstoken:"";
      refreshtoken:"";
      expiresin:0;
      status:resp.status;
      errormsg:msg
    }
  }el{
    let bodystr=str.frombytes(resp.body);
    let access=encoding.jsonfield(bodystr;"access_token");
    let newrefresh=encoding.jsonfield(bodystr;"refresh_token");
    let exp=encoding.jsonfieldint(bodystr;"expires_in");
    if(str.len(newrefresh)=0){
      <$refreshresult{ok:true;accesstoken:access;refreshtoken:refreshtok;expiresin:exp;status:resp.status;errormsg:""}
    }el{
      <$refreshresult{ok:true;accesstoken:access;refreshtoken:newrefresh;expiresin:exp;status:resp.status;errormsg:""}
    }
  }
};

f=getvalidtoken(cfg:$oauthconfig):str{
  let access=store.loadaccesstoken(cfg.adapterid);
  if(str.len(access)=0){
    <""
  }el{
    let expiresat=store.loadexpiresat(cfg.adapterid);
    let now=time.nowunix();
    if(needsrefresh(expiresat;now)){
      let refreshtok=store.loadrefreshtoken(cfg.adapterid);
      if(str.len(refreshtok)=0){
        if(isexpired(expiresat;now)){
          log.warn(str.concat("loke.core.auth.refresh: token expired and no refresh token for ";cfg.adapterid));
          <""
        }el{
          <access
        }
      }el{
        let result=dorefresh(cfg.tokenurl;cfg.clientid;refreshtok);
        if(result.ok){
          let newexpires=now+result.expiresin;
          store.updateaccesstoken(cfg.adapterid;result.accesstoken;newexpires);
          log.info(str.concat("loke.core.auth.refresh: token refreshed for ";cfg.adapterid));
          <result.accesstoken
        }el{
          if(result.status>400){
            if(result.status<500){
              log.warn(str.concat("loke.core.auth.refresh: permanent refresh failure for ";cfg.adapterid));
              store.cleartokens(cfg.adapterid);
              <""
            }el{
              log.warn(str.concat("loke.core.auth.refresh: transient refresh failure for ";cfg.adapterid));
              if(isexpired(expiresat;now)){
                <""
              }el{
                <access
              }
            }
          }el{
            log.warn(str.concat("loke.core.auth.refresh: transient refresh failure for ";cfg.adapterid));
            if(isexpired(expiresat;now)){
              <""
            }el{
              <access
            }
          }
        }
      }
    }el{
      <access
    }
  }
};

   SPDX-License-Identifier: Apache-2.0 *)

m=loke.core.auth.refresh;

i=time:std.time;
i=http:std.http;
i=json:std.json;
i=jx:shared.jsonobj;
i=str:std.str;
i=log:shared.log;
i=reach:shared.reachability;
i=store:loke.core.auth.tokenstore;

t=$oauthconfig{
  adapterid:str;
  clientid:str;
  authoriseurl:str;
  tokenurl:str;
  scopes:str;
  revokeurl:str;
  callbackport:i32
};

t=$refreshresult{
  ok:bool;
  accesstoken:str;
  refreshtoken:str;
  expiresin:i64;
  status:i32;
  errormsg:str
};

f=refreshbuffersecs():i64{ <300 };

f=needsrefresh(expiresat:i64;now:i64):bool{
  <now>(expiresat-refreshbuffersecs())
};

f=isexpired(expiresat:i64;now:i64):bool{
  <now>expiresat
};

(* F10.39, toke 3.1.0. This was `http.postheaders(http.client(url);"";bytes;headersjson)`,
   the client-first four-argument shape that toke 0b0bc4e compiled and that sent NOTHING
   (T-48): the request never left the machine and the match took its error arm. 3.1.0
   rejects that shape (E4026), and the typed three-argument call that replaces it really
   sends. Migrating the call must not quietly start sending to a host it never reached, so a
   non-loopback URL takes the error path without a byte sent, which is what callers observed
   before.

   VM1.6g, measured at toke 3.1.0: this call verifies the server's certificate and its name,
   and the form Content-Type given here replaces the default instead of being sent beside it
   (tests/integration/test_hosted_tls.tk drives it at a TLS recorder on loopback: one
   Content-Type arrives, the form one, and nothing arrives from a self-signed certificate).
   So the hold is no longer the client's (T-58 was lifted for the providers on 2026-10-01).
   Sending to a remote token endpoint is a product decision with a privacy review, since a refresh request carries the refresh token:
   F10.41. *)
f=dorefresh(tokenurl:str;clientid:str;refreshtok:str):$refreshresult{
  if(!reach.isloopbackurl(tokenurl)){
    log.warn("token refresh refused: only a loopback token endpoint is sent to (F10.39)";"auth.refresh";"");
    <$refreshresult{ok:false;accesstoken:"";refreshtoken:"";expiresin:0;status:0;errormsg:"network error"}
  }el{};
  <mt http.postheaders(tokenurl;"grant_type=refresh_token&refresh_token=\(refreshtok)&client_id=\(clientid)";@(@("content-type";"application/x-www-form-urlencoded"))) {
    $ok:r refreshfromresp(r;refreshtok);
    $err:e $refreshresult{ok:false;accesstoken:"";refreshtoken:"";expiresin:0;status:0;errormsg:"network error"}
  }
};

(* The response is read in its own function rather than lifted out of the match.
   The old shape matched httpresult twice — once for a bool, once binding `resp` to
   an $httpresp on the ok arm and an httperr on the err arm — so `resp.status` had
   no established type. It also tested `!$httpok`, a type sigil on a local, which
   never read the bool it was meant to. *)
(* VM1.6i. Success is a 2xx carrying an access token. The test was `status>400`, so a 400,
   which is what RFC 6749 answers for an expired or revoked refresh token (invalid_grant),
   was a SUCCESS with an empty access token, and getvalidtoken stored that empty token over
   the old one; 1xx and 3xx were successes too. Each field is read with the typed std.json
   accessors: `encoding.jsonfield` is an untyped (i64,i64) ABI helper and was handed
   `str.frombytes(resp.body)` unmatched, a `str!EncodingErr` since toke 3.1.0. *)
f=refreshfromresp(resp:$httpresp;refreshtok:str):$refreshresult{
  if(resp.status<200 || resp.status>=300){
    <$refreshresult{
      ok:false;
      accesstoken:"";
      refreshtoken:"";
      expiresin:0;
      status:resp.status as i32;
      errormsg:"refresh failed with status \(resp.status)"
    }
  }el{};
  let body=mt str.frombytes(resp.body) { $ok:s s; $err:e "" };
  let o=mt json.dec(body) { $ok:v v; $jsonerr:e jx.emptyobj() };
  let access=jx.strvalue(o;"access_token";"");
  if(str.len(access)==0){
    <$refreshresult{ok:false;accesstoken:"";refreshtoken:"";expiresin:0;status:resp.status as i32;errormsg:"refresh answer carried no access token"}
  }el{};
  let newrefresh=jx.strvalue(o;"refresh_token";"");
  let exp=mt json.i64(o;"expires_in") { $ok:n n; $err:x 0 };
  if(str.len(newrefresh)==0){
    <$refreshresult{ok:true;accesstoken:access;refreshtoken:refreshtok;expiresin:exp;status:resp.status as i32;errormsg:""}
  }el{
    <$refreshresult{ok:true;accesstoken:access;refreshtoken:newrefresh;expiresin:exp;status:resp.status as i32;errormsg:""}
  }
};

f=getvalidtoken(cfg:$oauthconfig):str{
  let access=store.loadaccesstoken(cfg.adapterid);
  if(str.len(access)==0){
    <""
  }el{
    let expiresat=store.loadexpiresat(cfg.adapterid);
    let now=time.nowunix();
    if(needsrefresh(expiresat;now)){
      let refreshtok=store.loadrefreshtoken(cfg.adapterid);
      if(str.len(refreshtok)==0){
        if(isexpired(expiresat;now)){
          log.warn(str.concat("loke.core.auth.refresh: token expired and no refresh token for ";cfg.adapterid);"auth.refresh";"");
          <""
        }el{
          <access
        }
      }el{
        let result=dorefresh(cfg.tokenurl;cfg.clientid;refreshtok);
        if(result.ok){
          store.updateaccesstoken(cfg.adapterid;result.accesstoken;now+result.expiresin);
          (* VM1.6i: a server that rotates refresh tokens invalidates the old one, so the
             new one is stored too. It was dropped, and the next refresh then failed. *)
          if(!str.eq(result.refreshtoken;refreshtok)){
            store.updaterefreshtoken(cfg.adapterid;result.refreshtoken);
          }el{};
          log.info(str.concat("loke.core.auth.refresh: token refreshed for ";cfg.adapterid);"auth.refresh";"");
          <result.accesstoken
        }el{
          (* A 400 is permanent too: RFC 6749's invalid_grant (VM1.6i). *)
          if(result.status>=400){
            if(result.status<500){
              log.warn(str.concat("loke.core.auth.refresh: permanent refresh failure for ";cfg.adapterid);"auth.refresh";"");
              store.cleartokens(cfg.adapterid);
              <""
            }el{
              log.warn(str.concat("loke.core.auth.refresh: transient refresh failure for ";cfg.adapterid);"auth.refresh";"");
              if(isexpired(expiresat;now)){
                <""
              }el{
                <access
              }
            }
          }el{
            log.warn(str.concat("loke.core.auth.refresh: transient refresh failure for ";cfg.adapterid);"auth.refresh";"");
            if(isexpired(expiresat;now)){
              <""
            }el{
              <access
            }
          }
        }
      }
    }el{
      <access
    }
  }
};

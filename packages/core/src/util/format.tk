m=core.util.format;
i=str:std.str;

f=formatcost(microdollars:i64):str{
  let dollars=microdollars/1000000;
  let cents=(microdollars-(dollars*1000000))/10000;
  <str.concat("$";str.concat(str.fromint(dollars);str.concat(".";str.concat(str.fromint(cents/10);str.fromint(cents-(cents/10)*10)))))
};

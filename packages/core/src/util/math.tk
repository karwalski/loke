m=core.util.math;

f=maxint(a:i64;b:i64):i64{
  if(a>b){<a}el{<b}
};

f=minint(a:i64;b:i64):i64{
  if(a<b){<a}el{<b}
};

f=clampint(minval:i64;val:i64;maxval:i64):i64{
  if(val<minval){<minval}el{};
  if(val>maxval){<maxval}el{};
  <val
};

f=absval(n:i64):i64{
  if(n<0){<0-n}el{<n}
};

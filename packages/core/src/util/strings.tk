m=core.util.strings;
i=str:std.str;

f=startswith(s:str;prefix:str):bool{
  let plen=str.len(prefix);
  if(str.len(s)<plen){<false}el{};
  let sub=str.substr(s;0;plen);
  if(str.eq(sub;prefix)){<true}el{<false}
};

f=endswith(s:str;suffix:str):bool{
  let slen=str.len(s);
  let suflen=str.len(suffix);
  if(suflen>slen){<false}el{};
  let sub=str.substr(s;slen-suflen;suflen);
  if(str.eq(sub;suffix)){<true}el{<false}
};

f=trimprefix(s:str;prefix:str):str{
  let slen=str.len(s);
  let plen=str.len(prefix);
  if(plen>slen){<s}el{};
  let sub=str.substr(s;0;plen);
  if(str.eq(sub;prefix)){<str.substr(s;plen;slen-plen)}el{<s}
};

f=joinpair(a:str;b:str;sep:str):str{
  <str.concat(a;str.concat(sep;b))
};

f=isempty(s:str):bool{
  let len=str.len(s);
  if(len==0){<true}el{<false}
};

f=maskstr(val:str):str{
  let len=str.len(val);
  if(len<5){<val}el{};
  let prefix=str.substr(val;0;4);
  <str.concat(prefix;"****")
};

m=core.eval.bench;
i=t:shared.types;
i=log:shared.log;
i=prov:providers.types;
i=disp:providers.dispatcher;
i=json:std.json;

t=$benchcase{
  id:str;
  prompt:str;
  expectedkeywords:@str;
  category:str
}

t=$benchresult{
  caseid:str;
  model:str;
  latencyms:i32;
  tokensused:i32;
  costusd:f64;
  keywordsmatched:i32;
  keywordstotal:i32;
  score:f64;
  responsesnippet:str
}

t=$benchrun{
  model:str;
  casesrun:i32;
  avgscore:f64;
  avglatencyms:i32;
  totalcostusd:f64;
  results:@$benchresult;
  runat:i64
}

defaultcases:@$benchcase = [
  $benchcase{
    id:"sum-1";
    prompt:"What is 15 + 27?";
    expectedkeywords:@"42";
    category:"reasoning"
  };
  $benchcase{
    id:"code-1";
    prompt:"Write a function to reverse a string in Python";
    expectedkeywords:@"def";"return";"[::-1]";
    category:"coding"
  };
  $benchcase{
    id:"analysis-1";
    prompt:"List 3 benefits of caching";
    expectedkeywords:@"performance";"latency";"cost";
    category:"analysis"
  };
  $benchcase{
    id:"reason-1";
    prompt:"If all cats are mammals and Felix is a cat, is Felix a mammal?";
    expectedkeywords:@"yes";"mammal";
    category:"reasoning"
  };
  $benchcase{
    id:"creative-1";
    prompt:"Write a one-sentence tagline for a privacy-first AI tool";
    expectedkeywords:@"privacy";"AI";
    category:"creative"
  }
]

f=runcase(case:$benchcase;model:str;disp:i64):$benchresult{
  log.info("bench: running case " + case.id + " on model " + model);
  startms:i64 = t.nowms();
  response:i64 = disp.dispatch(disp;model;case.prompt);
  elapsedms:i32 = (t.nowms() - startms) as i32;
  resplower:str = t.strlower(response.text);
  matched:i32 = 0;
  total:i32 = case.expectedkeywords.len as i32;
  i:i32 = 0;
  loop{
    if i >= total { break };
    kw:str = t.strlower(case.expectedkeywords.get(i));
    if t.strcontains(resplower;kw){
      matched = matched + 1
    };
    i = i + 1
  };
  sc:f64 = 0.0;
  if total > 0{
    sc = (matched as f64) / (total as f64)
  };
  snippet:str = t.strslice(response.text;0;120);
  <$benchresult{
    caseid:case.id;
    model:model;
    latencyms:elapsedms;
    tokensused:response.tokensused;
    costusd:response.costusd;
    keywordsmatched:matched;
    keywordstotal:total;
    score:sc;
    responsesnippet:snippet
  }
}

f=runbenchmark(model:str;cases:@$benchcase;disp:i64):$benchrun{
  log.info("bench: starting benchmark for model " + model);
  results:@$benchresult = @();
  totalscore:f64 = 0.0;
  totallatency:i32 = 0;
  totalcost:f64 = 0.0;
  n:i32 = cases.len as i32;
  i:i32 = 0;
  loop{
    if i >= n { break };
    r:$benchresult = runcase(cases.get(i);model;disp);
    results = t.arrpush(results;r);
    totalscore = totalscore + r.score;
    totallatency = totallatency + r.latencyms;
    totalcost = totalcost + r.costusd;
    i = i + 1
  };
  avgsc:f64 = 0.0;
  avglat:i32 = 0;
  if n > 0{
    avgsc = totalscore / (n as f64);
    avglat = totallatency / n
  };
  <$benchrun{
    model:model;
    casesrun:n;
    avgscore:avgsc;
    avglatencyms:avglat;
    totalcostusd:totalcost;
    results:results;
    runat:t.nowms()
  }
}

f=formatrun(run:$benchrun):str{
  header:str = "Benchmark: " + run.model + "
";
  sep:str = "─────────────────────────────────────────────────────────
";
  colhdr:str = t.strpad("Case";16) + t.strpad("Score";8) + t.strpad("Latency";10) + t.strpad("Cost";10) + "Keywords
";
  rows:str = "";
  i:i32 = 0;
  n:i32 = run.results.len as i32;
  loop{
    if i >= n { break };
    r:$benchresult = run.results.get(i);
    kwstr:str = t.inttostr(r.keywordsmatched) + "/" + t.inttostr(r.keywordstotal);
    row:str = t.strpad(r.caseid;16)
      + t.strpad(t.f64tostr(r.score;2);8)
      + t.strpad(t.inttostr(r.latencyms) + "ms";10)
      + t.strpad("$" + t.f64tostr(r.costusd;4);10)
      + kwstr + "
";
    rows = rows + row;
    i = i + 1
  };
  summary:str = sep
    + t.strpad("AVERAGE";16)
    + t.strpad(t.f64tostr(run.avgscore;2);8)
    + t.strpad(t.inttostr(run.avglatencyms) + "ms";10)
    + t.strpad("$" + t.f64tostr(run.totalcostusd;4);10)
    + t.inttostr(run.casesrun) + " cases
";
  <header + sep + colhdr + sep + rows + summary
}

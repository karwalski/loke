m=core.eval.bench;

i=t:shared.types;
i=log:shared.log;
i=disp:core.providers.dispatcher;
i=str:std.str;
i=prov:core.providers.types;
i=json:std.json;

t=$benchcase{
  id:str;
  prompt:str;
  expectedkeywords:@str;
  category:str
};

t=$benchresult{
  caseid:str;
  model:str;
  latencyms:i64;
  tokensused:i64;
  costusd:f64;
  keywordsmatched:i64;
  keywordstotal:i64;
  score:f64;
  responsesnippet:str
};

t=$benchrun{
  model:str;
  casesrun:i64;
  avgscore:f64;
  avglatencyms:i64;
  totalcostusd:f64;
  results:@$benchresult;
  runat:i64
};

f=defaultcases():@$benchcase{
  <@(
    $benchcase{
      id:"sum-1";
      prompt:"What is 15 + 27?";
      expectedkeywords:@("42");
      category:"reasoning"
    };
    $benchcase{
      id:"code-1";
      prompt:"Write a function to reverse a string in Python";
      expectedkeywords:@("def";"return");
      category:"coding"
    };
    $benchcase{
      id:"analysis-1";
      prompt:"List 3 benefits of caching";
      expectedkeywords:@("performance";"latency";"cost");
      category:"analysis"
    };
    $benchcase{
      id:"reason-1";
      prompt:"If all cats are mammals and Felix is a cat, is Felix a mammal?";
      expectedkeywords:@("yes";"mammal");
      category:"reasoning"
    };
    $benchcase{
      id:"creative-1";
      prompt:"Write a one-sentence tagline for a privacy-first AI tool";
      expectedkeywords:@("privacy";"AI");
      category:"creative"
    }
  )
};

(* The provider is chosen from the model id. Benchmarking defaults to ollama so a
   bench run cannot silently spend money on a hosted provider. *)
f=providerformodel(model:str):$provider{
  if(str.startswith(model;"claude")){
    <$anthropic
  }el{
    if(str.startswith(model;"gpt")){
      <$openai
    }el{
      <$ollama
    }
  }
};

f=scorekeywords(response:$completionresponse;bcase:$benchcase):i64{
  let resplower=t.strlower(response.content);
  let matched=mut.0;
  (* `i>total` ran one iteration past the end and read out of bounds. *)
  lp(let i=0;i<bcase.expectedkeywords.len;i=i+1){
    if(t.strcontains(resplower;t.strlower(bcase.expectedkeywords.get(i)))){
      matched=matched+1
    }el{}
  };
  <matched
};

f=casefailed(bcase:$benchcase;model:str;elapsedms:i64;total:i64):$benchresult{
  log.warn("bench: case \(bcase.id) failed against \(model)";"eval";"bench");
  <$benchresult{
    caseid:bcase.id;
    model:model;
    latencyms:elapsedms;
    tokensused:0;
    costusd:0.0;
    keywordsmatched:0;
    keywordstotal:total;
    score:0.0;
    responsesnippet:""
  }
};

f=caseresult(bcase:$benchcase;model:str;elapsedms:i64;response:$completionresponse):$benchresult{
  let total=bcase.expectedkeywords.len as i64;
  let matched=scorekeywords(response;bcase);
  let scr=mut.0.0;
  if(total>0){
    scr=str.tofloat(str.fromint(matched))/str.tofloat(str.fromint(total))
  }el{};
  <$benchresult{
    caseid:bcase.id;
    model:model;
    latencyms:elapsedms;
    tokensused:(response.inputtokens+response.outputtokens) as i64;
    costusd:response.costusd;
    keywordsmatched:matched;
    keywordstotal:total;
    score:scr;
    responsesnippet:t.strslice(response.content;0;120)
  }
};

f=runcase(bcase:$benchcase;model:str;dispatcher:$dispatcher):$benchresult{
  log.info("bench: running case \(bcase.id) on model \(model)";"eval";"bench");
  let startms=t.nowms();
  let req=$completionrequest{
    modelid:model;
    messages:@(prov.usermsg(bcase.prompt));
    systemprompt:"";
    maxtokens:1024 as u32;
    temperature:0.0;
    stream:false
  };
  let outcome=disp.dispatch(dispatcher;req;providerformodel(model));
  let elapsedms=t.nowms()-startms;
  mt outcome {
    $ok:response caseresult(bcase;model;elapsedms;response);
    $err:e casefailed(bcase;model;elapsedms;bcase.expectedkeywords.len as i64)
  }
};

f=runbenchmark(model:str;cases:@$benchcase;dispatcher:$dispatcher):$benchrun{
  log.info(str.concat("bench: starting benchmark for model ";model);"eval";"bench");
  let results=mut.@();
  let totalscore=mut.0.0;
  let totallatency=mut.0;
  let totalcost=mut.0.0;
  let n=cases.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>n){
      br
    }el{
      let r=runcase(cases.get(i);model;dispatcher);
      results=results.push(r);
      totalscore=totalscore+r.score;
      totallatency=totallatency+r.latencyms;
      totalcost=totalcost+r.costusd;
      i=i+1
    }
  };
  let avgscr=mut.0.0;
  let avglat=mut.0;
  if(n>0){
    let totalscf=totalscore;
    let nf=str.tofloat(str.fromint(n));
    avgscr=totalscf/nf;
    avglat=totallatency/n
  }el{
    avgscr=0.0
  };
  <$benchrun{
    model:model;
    casesrun:n;
    avgscore:avgscr;
    avglatencyms:avglat;
    totalcostusd:totalcost;
    results:results;
    runat:t.nowms()
  }
};

f=formatrun(run:$benchrun):str{
  let header=str.concat("Benchmark: ";str.concat(run.model;"
"));
  let sep="---
";
  let colhdr=str.concat(t.strpad("Case";16);str.concat(t.strpad("Score";8);str.concat(t.strpad("Latency";10);str.concat(t.strpad("Cost";10);"Keywords
"))));
  let rows=mut."";
  let i=mut.0;
  let n=run.results.len;
  lp(let lv=0;true;lv=lv){
    if(i>n){
      br
    }el{
      let r=run.results.get(i);
      let kwstr=str.concat(str.fromint(r.keywordsmatched);str.concat("/";str.fromint(r.keywordstotal)));
      let row=str.concat(t.strpad(r.caseid;16);str.concat(t.strpad(t.f64fixed(r.score;2);8);str.concat(t.strpad(str.concat(str.fromint(r.latencyms);"ms");10);str.concat(t.strpad(str.concat("$";t.f64fixed(r.costusd;4));10);str.concat(kwstr;"
")))));
      rows=str.concat(rows;row);
      i=i+1
    }
  };
  let summary=str.concat(sep;str.concat(t.strpad("AVERAGE";16);str.concat(t.strpad(t.f64fixed(run.avgscore;2);8);str.concat(t.strpad(str.concat(str.fromint(run.avglatencyms);"ms");10);str.concat(t.strpad(str.concat("$";t.f64fixed(run.totalcostusd;4));10);str.concat(str.fromint(run.casesrun);" cases
"))))));
  <str.concat(header;str.concat(sep;str.concat(colhdr;str.concat(sep;str.concat(rows;summary)))))
};

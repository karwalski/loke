m=core.eval.bench;

i=t:shared.types;
i=log:shared.log;
i=prov:core.providers.types;
i=disp:core.providers.dispatcher;
i=json:std.json;
i=str:std.str;

t=$benchcase{
  id:str;
  prompt:str;
  expectedkeywords:@str;
  category:str
};

t=$benchresult{
  caseid:str;
  model:str;
  latencyms:i64;
  tokensused:i64;
  costusd:f64;
  keywordsmatched:i64;
  keywordstotal:i64;
  score:f64;
  responsesnippet:str
};

t=$benchrun{
  model:str;
  casesrun:i64;
  avgscore:f64;
  avglatencyms:i64;
  totalcostusd:f64;
  results:@$benchresult;
  runat:i64
};

f=defaultcases():@$benchcase{
  <@(
    $benchcase{
      id:"sum-1";
      prompt:"What is 15 + 27?";
      expectedkeywords:@("42");
      category:"reasoning"
    };
    $benchcase{
      id:"code-1";
      prompt:"Write a function to reverse a string in Python";
      expectedkeywords:@("def";"return");
      category:"coding"
    };
    $benchcase{
      id:"analysis-1";
      prompt:"List 3 benefits of caching";
      expectedkeywords:@("performance";"latency";"cost");
      category:"analysis"
    };
    $benchcase{
      id:"reason-1";
      prompt:"If all cats are mammals and Felix is a cat, is Felix a mammal?";
      expectedkeywords:@("yes";"mammal");
      category:"reasoning"
    };
    $benchcase{
      id:"creative-1";
      prompt:"Write a one-sentence tagline for a privacy-first AI tool";
      expectedkeywords:@("privacy";"AI");
      category:"creative"
    }
  )
};

f=runcase(bcase:$benchcase;model:str;dispatcher:i64):$benchresult{
  log.info(str.concat("bench: running case ";str.concat(bcase.id;str.concat(" on model ";model)));"eval";"bench");
  let startms=str.toint(str.fromint(t.nowms()));
  let response=disp.dispatch(dispatcher;model;bcase.prompt);
  let endms=str.toint(str.fromint(t.nowms()));
  let elapsedms=endms-startms;
  let resplower=t.strlower(response.text);
  let matched=mut.0;
  let total=bcase.expectedkeywords.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>total){
      br
    }el{
      let kw=t.strlower(str.arrayget(bcase.expectedkeywords;i));
      if(t.strcontains(resplower;kw)){
        matched=matched+1
      }el{
        matched=matched
      };
      i=i+1
    }
  };
  let scr=mut.0.0;
  if(total>0){
    let matchedf=str.tofloat(str.fromint(matched));
    let totalf=str.tofloat(str.fromint(total));
    scr=matchedf/totalf
  }el{
    scr=0.0
  };
  let snippet=t.strslice(response.text;0;120);
  <$benchresult{
    caseid:bcase.id;
    model:model;
    latencyms:elapsedms;
    tokensused:response.tokensused;
    costusd:response.costusd;
    keywordsmatched:matched;
    keywordstotal:total;
    score:scr;
    responsesnippet:snippet
  }
};

f=runbenchmark(model:str;cases:@$benchcase;dispatcher:i64):$benchrun{
  log.info(str.concat("bench: starting benchmark for model ";model);"eval";"bench");
  let results=mut.@();
  let totalscore=mut.0.0;
  let totallatency=mut.0;
  let totalcost=mut.0.0;
  let n=cases.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>n){
      br
    }el{
      let r=runcase(str.arrayget(cases;i);model;dispatcher);
      results=@(results;r);
      totalscore=totalscore+r.score;
      totallatency=totallatency+r.latencyms;
      totalcost=totalcost+r.costusd;
      i=i+1
    }
  };
  let avgscr=mut.0.0;
  let avglat=mut.0;
  if(n>0){
    let totalscf=totalscore;
    let nf=str.tofloat(str.fromint(n));
    avgscr=totalscf/nf;
    avglat=totallatency/n
  }el{
    avgscr=0.0
  };
  <$benchrun{
    model:model;
    casesrun:n;
    avgscore:avgscr;
    avglatencyms:avglat;
    totalcostusd:totalcost;
    results:results;
    runat:t.nowms()
  }
};

f=formatrun(run:$benchrun):str{
  let header=str.concat("Benchmark: ";str.concat(run.model;"
"));
  let sep="---
";
  let colhdr=str.concat(t.strpad("Case";16);str.concat(t.strpad("Score";8);str.concat(t.strpad("Latency";10);str.concat(t.strpad("Cost";10);"Keywords
"))));
  let rows=mut."";
  let i=mut.0;
  let n=run.results.len;
  lp(let lv=0;true;lv=lv){
    if(i>n){
      br
    }el{
      let r=str.arrayget(run.results;i);
      let kwstr=str.concat(str.fromint(r.keywordsmatched);str.concat("/";str.fromint(r.keywordstotal)));
      let row=str.concat(t.strpad(r.caseid;16);str.concat(t.strpad(t.f64tostr(r.score;2);8);str.concat(t.strpad(str.concat(str.fromint(r.latencyms);"ms");10);str.concat(t.strpad(str.concat("$";t.f64tostr(r.costusd;4));10);str.concat(kwstr;"
")))));
      rows=str.concat(rows;row);
      i=i+1
    }
  };
  let summary=str.concat(sep;str.concat(t.strpad("AVERAGE";16);str.concat(t.strpad(t.f64tostr(run.avgscore;2);8);str.concat(t.strpad(str.concat(str.fromint(run.avglatencyms);"ms");10);str.concat(t.strpad(str.concat("$";t.f64tostr(run.totalcostusd;4));10);str.concat(str.fromint(run.casesrun);" cases
"))))));
  <str.concat(header;str.concat(sep;str.concat(colhdr;str.concat(sep;str.concat(rows;summary)))))
};

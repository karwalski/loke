m=core.eval.bench;

i=t:shared.types;
i=log:shared.log;
i=disp:core.providers.dispatcher;
i=str:std.str;
i=prov:core.providers.types;
i=ol:core.models.ollama;
i=sink:core.eval.resultsink;
i=file:std.file;

t=$benchcase{
  id:str;
  prompt:str;
  expectedkeywords:@str;
  category:str
};

t=$benchresult{
  caseid:str;
  model:str;
  latencyms:i64;
  tokensused:i64;
  costusd:f64;
  keywordsmatched:i64;
  keywordstotal:i64;
  score:f64;
  responsesnippet:str;
  ok:bool
};

t=$benchrun{
  model:str;
  casesrun:i64;
  avgscore:f64;
  avglatencyms:i64;
  totalcostusd:f64;
  results:@$benchresult;
  runat:i64
};

f=defaultcases():@$benchcase{
  <@(
    $benchcase{
      id:"sum-1";
      prompt:"What is 15 + 27?";
      expectedkeywords:@("42");
      category:"reasoning"
    };
    $benchcase{
      id:"code-1";
      prompt:"Write a function to reverse a string in Python";
      expectedkeywords:@("def";"return");
      category:"coding"
    };
    $benchcase{
      id:"analysis-1";
      prompt:"List 3 benefits of caching";
      expectedkeywords:@("performance";"latency";"cost");
      category:"analysis"
    };
    $benchcase{
      id:"reason-1";
      prompt:"If all cats are mammals and Felix is a cat, is Felix a mammal?";
      expectedkeywords:@("yes";"mammal");
      category:"reasoning"
    };
    $benchcase{
      id:"creative-1";
      prompt:"Write a one-sentence tagline for a privacy-first AI tool";
      expectedkeywords:@("privacy";"AI");
      category:"creative"
    }
  )
};

(* The provider is chosen from the model id. Benchmarking defaults to ollama so a
   bench run cannot silently spend money on a hosted provider. *)
f=providerformodel(model:str):$provider{
  if(str.startswith(model;"claude")){
    <$provider{$anthropic:0}
  }el{
    if(str.startswith(model;"gpt")){
      <$provider{$openai:0}
    }el{
      <$provider{$ollama:0}
    }
  }
};

f=scorekeywords(response:$completionresponse;bcase:$benchcase):i64{
  let resplower=t.strlower(response.content);
  let matched=mut.0;
  (* `i>total` ran one iteration past the end and read out of bounds. *)
  lp(let i=0;i<bcase.expectedkeywords.len;i=i+1){
    if(t.strcontains(resplower;t.strlower(bcase.expectedkeywords.get(i)))){
      matched=matched+1
    }el{}
  };
  <matched
};

f=casefailed(bcase:$benchcase;model:str;elapsedms:i64;total:i64):$benchresult{
  log.warn("bench: case \(bcase.id) failed against \(model)";"eval";"bench");
  <$benchresult{
    caseid:bcase.id;
    model:model;
    latencyms:elapsedms;
    tokensused:0;
    costusd:0.0;
    keywordsmatched:0;
    keywordstotal:total;
    score:0.0;
    responsesnippet:"";
    ok:false
  }
};

f=caseresult(bcase:$benchcase;model:str;elapsedms:i64;response:$completionresponse):$benchresult{
  let total=bcase.expectedkeywords.len as i64;
  let matched=scorekeywords(response;bcase);
  let scr=mut.0.0;
  if(total>0){
    scr=str.tofloat(str.fromint(matched))/str.tofloat(str.fromint(total))
  }el{};
  <$benchresult{
    caseid:bcase.id;
    model:model;
    latencyms:elapsedms;
    tokensused:(response.inputtokens+response.outputtokens) as i64;
    costusd:response.costusd;
    keywordsmatched:matched;
    keywordstotal:total;
    score:scr;
    responsesnippet:t.strslice(response.content;0;120);
    ok:true
  }
};

f=runcase(bcase:$benchcase;model:str;dispatcher:$dispatcher):$benchresult{
  log.info("bench: running case \(bcase.id) on model \(model)";"eval";"bench");
  let startms=t.nowms();
  let req=$completionrequest{
    modelid:model;
    messages:@(prov.usermsg(bcase.prompt));
    systemprompt:"";
    maxtokens:1024 as u32;
    temperature:0.0;
    stream:false
  };
  (* LS1.1j — migrated off disp.dispatch onto disp.trydispatch.

     The `mt outcome { $ok:response caseresult(...); $err:e ... }` this replaces was not a
     mis-scored case, it was a crash: toke takes the FIRST arm of a match on a result whose
     error side is a user-declared sum whatever the value is (T-18), so the $ok arm ran on
     failure too and caseresult read response.content off a $lokeerr value. The benchmark
     segfaulted on the first provider error. isdispatched is an `if` on a sentinel field,
     which discriminates. *)
  let outcome=disp.trydispatch(dispatcher;req;providerformodel(model));
  let elapsedms=t.nowms()-startms;
  if(disp.isdispatched(outcome)){
    <caseresult(bcase;model;elapsedms;outcome)
  }el{
    log.warn("bench: dispatch failed — \(disp.dispatcherror(outcome))";"eval";"bench");
    <casefailed(bcase;model;elapsedms;bcase.expectedkeywords.len as i64)
  }
};

f=runbenchmark(model:str;cases:@$benchcase;dispatcher:$dispatcher):$benchrun{
  log.info(str.concat("bench: starting benchmark for model ";model);"eval";"bench");
  let results=mut.@();
  let totalscore=mut.0.0;
  let totallatency=mut.0;
  let totalcost=mut.0.0;
  let n=cases.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=n){
      br
    }el{
      let r=runcase(cases.get(i);model;dispatcher);
      results=results.push(r);
      totalscore=totalscore+r.score;
      totallatency=totallatency+r.latencyms;
      totalcost=totalcost+r.costusd;
      i=i+1
    }
  };
  let avgscr=mut.0.0;
  let avglat=mut.0;
  if(n>0){
    let totalscf=totalscore;
    let nf=str.tofloat(str.fromint(n));
    avgscr=totalscf/nf;
    avglat=totallatency/n
  }el{
    avgscr=0.0
  };
  <$benchrun{
    model:model;
    casesrun:n;
    avgscore:avgscr;
    avglatencyms:avglat;
    totalcostusd:totalcost;
    results:results;
    runat:t.nowms()
  }
};

f=formatrun(run:$benchrun):str{
  let header=str.concat("Benchmark: ";str.concat(run.model;"
"));
  let sep="---
";
  let colhdr=str.concat(t.strpad("Case";16);str.concat(t.strpad("Score";8);str.concat(t.strpad("Latency";10);str.concat(t.strpad("Cost";10);"Keywords
"))));
  let rows=mut."";
  let i=mut.0;
  let n=run.results.len;
  lp(let lv=0;true;lv=lv){
    if(i>=n){
      br
    }el{
      let r=run.results.get(i);
      let kwstr=str.concat(str.fromint(r.keywordsmatched);str.concat("/";str.fromint(r.keywordstotal)));
      let row=str.concat(t.strpad(r.caseid;16);str.concat(t.strpad(t.f64fixed(r.score;2);8);str.concat(t.strpad(str.concat(str.fromint(r.latencyms);"ms");10);str.concat(t.strpad(str.concat("$";t.f64fixed(r.costusd;4));10);str.concat(kwstr;"
")))));
      rows=str.concat(rows;row);
      i=i+1
    }
  };
  let summary=str.concat(sep;str.concat(t.strpad("AVERAGE";16);str.concat(t.strpad(t.f64fixed(run.avgscore;2);8);str.concat(t.strpad(str.concat(str.fromint(run.avglatencyms);"ms");10);str.concat(t.strpad(str.concat("$";t.f64fixed(run.totalcostusd;4));10);str.concat(str.fromint(run.casesrun);" cases
"))))));
  <str.concat(header;str.concat(sep;str.concat(colhdr;str.concat(sep;str.concat(rows;summary)))))
};

(* VM1.6 — the entry points `loke benchmark` uses, and persistence through the VM1.1 sink.

   A benchmark only ever runs against a LOCAL model. providerformodel sends claude* and gpt*
   to a hosted provider, so the CLI refuses those ids before anything is dispatched, and a
   benchmark cannot spend money. *)
f=iscloudmodel(model:str):bool{
  <str.startswith(model;"claude") || str.startswith(model;"gpt")
};

(* Names the case set, not the model. *)
f=defaultworkload():str{
  <"bench-default-\(defaultcases().len)"
};

(* The installed model's Ollama digest, which is the pinned version VM1.1 requires; "" when
   Ollama does not list the model. listmodels answers an empty list rather than an $err when
   Ollama is down, because T-18 would send an $err to the first arm below. *)
f=modelversion(ollamaurl:str;model:str):str{
  let models=mt ol.listmodels(ol.new(ollamaurl)) {$ok:v v; $err:e @()};
  let found=mut."";
  lp(let i=0;i<models.len;i=i+1){
    let m:$ollamamodel=models.get(i);
    if(str.len(found)==0 && (str.eq(m.name;model) || str.eq(m.name;"\(model):latest"))){ found=m.digest }el{}
  };
  <found
};

f=allok(run:$benchrun):bool{
  let ok=mut.true;
  lp(let i=0;i<run.results.len;i=i+1){
    if(!run.results.get(i).ok){ ok=false }el{}
  };
  <ok
};

(* ~/.loke/benchmarks/<date>.jsonl, creating the directory. HOME decides where ~ is. *)
f=defaultresultspath():str{
  let dir=t.lokefile("benchmarks");
  file.mkdir(t.lokedir());
  file.mkdir(dir);
  let now:str=str.nowiso8601();
  <"\(dir)/\(t.strslice(now;0;10)).jsonl"
};

f=runmeasurement(run:$benchrun;metric:str;value:str;units:str;digest:str;workload:str):$measurement{
  <$measurement{
    metric:metric;
    value:value;
    units:units;
    workload:workload;
    n:run.casesrun;
    arm:"";
    tokenizer:"";
    model:run.model;
    modelversion:digest;
    seed:sink.noseed();
    notes:"loke benchmark: keyword matching over \(run.casesrun) fixed prompts, one run each. Toolchain commits are not known to a running binary.";
    caveat:"temperature is not forwarded to Ollama (core.models.ollama.sendchatplain), so the model sampled at its own default and a rerun may differ"
  }
};

(* Writes the run's two summary figures, or neither. Returns "" or why nothing was written.
   The numbers are formatted to str here, in the module that computed them (T-20).

   A run in which any case failed to dispatch is refused: casefailed scores it 0.0, and a
   network failure averaged in as a wrong answer is not a measurement of the model. *)
f=record(run:$benchrun;digest:str;workload:str;path:str):str{
  if(!allok(run)){ <"a case failed to dispatch, and a failure scored as zero is not a measurement of the model" }el{};
  let score=runmeasurement(run;"keyword_score";t.f64fixed(run.avgscore;4);"ratio";digest;workload);
  let latency=runmeasurement(run;"latency_mean";str.fromint(run.avglatencyms);"ms";digest;workload);
  let bad=sink.validate(score);
  if(str.len(bad)>0){ <bad }el{};
  let badl=sink.validate(latency);
  if(str.len(badl)>0){ <badl }el{};
  let wrote=sink.write(score;path);
  if(str.len(wrote)>0){ <wrote }el{};
  <sink.write(latency;path)
};

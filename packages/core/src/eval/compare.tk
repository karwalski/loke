m=core.eval.compare;

i=t:shared.types;
i=log:shared.log;
i=b:eval.bench;
i=disp:providers.dispatcher;
i=str:std.str;

t=$comparison{
  modela:str;
  modelb:str;
  runa:$benchrun;
  runb:$benchrun;
  winner:str;
  scoredelta:f64;
  costdelta:f64;
  latencydeltams:i32
};

f=compare(modela:str;modelb:str;cases:@$benchcase;dispatcher:i64):$comparison{
  log.info(str.concat("compare: running benchmark for ";modela);"eval";"compare");
  let runa=b.runbenchmark(modela;cases;dispatcher);
  log.info(str.concat("compare: running benchmark for ";modelb);"eval";"compare");
  let runb=b.runbenchmark(modelb;cases;dispatcher);
  let winner=modela;
  if(runb.avgscore>runa.avgscore){
    winner=modelb
  }el{
    if(runb.avgscore=runa.avgscore){
      if(runb.totalcostusd<runa.totalcostusd){
        winner=modelb
      }el{
        winner=winner
      }
    }el{
      winner=winner
    }
  };
  let scoredelta=runa.avgscore-runb.avgscore;
  let costdelta=runa.totalcostusd-runb.totalcostusd;
  let latencydelta=runa.avglatencyms-runb.avglatencyms;
  <$comparison{
    modela:modela;
    modelb:modelb;
    runa:runa;
    runb:runb;
    winner:winner;
    scoredelta:scoredelta;
    costdelta:costdelta;
    latencydeltams:latencydelta
  }
};

f=formatcomparison(c:$comparison):str{
  let wlabel=str.concat("Winner: ";c.winner);
  let scoredstr=t.f64tostr(t.f64abs(c.scoredelta);2);
  let costdstr=t.f64tostr(t.f64abs(c.costdelta);2);
  let winnernote=str.concat(wlabel;str.concat(" (score +";str.concat(scoredstr;str.concat(", cost +$";str.concat(costdstr;")")))));
  let cola=t.strpad(c.modela;14);
  let colb=t.strpad(c.modelb;14);
  let scorea=t.strpad(t.f64tostr(c.runa.avgscore;2);14);
  let scoreb=t.strpad(t.f64tostr(c.runb.avgscore;2);14);
  let lata=t.strpad(str.concat(str.fromint(c.runa.avglatencyms);"ms");14);
  let latb=t.strpad(str.concat(str.fromint(c.runb.avglatencyms);"ms");14);
  let costa=t.strpad(str.concat("$";t.f64tostr(c.runa.totalcostusd;2));14);
  let costb=t.strpad(str.concat("$";t.f64tostr(c.runb.totalcostusd;2));14);
  let linetop="Model Comparison
";
  let linehdr=str.concat("                  ";str.concat(cola;str.concat(colb;"
")));
  let linescore=str.concat(" Score:           ";str.concat(scorea;str.concat(scoreb;"
")));
  let linelat=str.concat(" Avg latency:     ";str.concat(lata;str.concat(latb;"
")));
  let linecost=str.concat(" Total cost:      ";str.concat(costa;str.concat(costb;"
")));
  let linewinner=str.concat(" ";str.concat(t.strpad(winnernote;44);"
"));
  <str.concat(linetop;str.concat(linehdr;str.concat(linescore;str.concat(linelat;str.concat(linecost;linewinner)))))
};

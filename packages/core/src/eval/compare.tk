m=core.eval.compare;

i=t:shared.types;
i=log:shared.log;
i=b:core.eval.bench;
i=str:std.str;

t=$comparison{
  modela:str;
  modelb:str;
  runa:$benchrun;
  runb:$benchrun;
  winner:str;
  scoredelta:f64;
  costdelta:f64;
  latencydeltams:i32
};

f=compare(modela:str;modelb:str;cases:@$benchcase;dispatcher:i64):$comparison{
  log.info(str.concat("compare: running benchmark for ";modela);"eval";"compare");
  let runa=b.runbenchmark(modela;cases;dispatcher);
  log.info(str.concat("compare: running benchmark for ";modelb);"eval";"compare");
  let runb=b.runbenchmark(modelb;cases;dispatcher);
  let winner=mut.modela;
  if(runb.avgscore>runa.avgscore){
    winner=modelb
  }el{
    if(runb.avgscore==runa.avgscore){
      if(runb.totalcostusd<runa.totalcostusd){
        winner=modelb
      }el{
        winner=winner
      }
    }el{
      winner=winner
    }
  };
  <$comparison{
    modela:modela;
    modelb:modelb;
    runa:runa;
    runb:runb;
    winner:winner;
    scoredelta:(runa.avgscore-runb.avgscore);
    costdelta:(runa.totalcostusd-runb.totalcostusd);
    latencydeltams:(runa.avglatencyms-runb.avglatencyms)
  }
};

f=formatcomparison(c:$comparison):str{
  let wlabel=str.concat("Winner: ";c.winner);
  (* LS1.1h. t.f64abs's f64 comes back across the module boundary intact on toke 3.1.0 (T-20
     fixed, B5), so the nested form is used again; t.f64absfixed, which did both in shared.types
     so that only a str crossed, is gone. tests/unit/eval/test_compare_format.tk asserts the
     deltas. *)
  let scoredstr=t.f64fixed(t.f64abs(c.scoredelta);2);
  let costdstr=t.f64fixed(t.f64abs(c.costdelta);2);
  let winnernote="\(wlabel) (score +\(scoredstr), cost +$\(costdstr))";
  let cola=t.strpad(c.modela;14);
  let colb=t.strpad(c.modelb;14);
  let scorea=t.strpad(t.f64fixed(c.runa.avgscore;2);14);
  let scoreb=t.strpad(t.f64fixed(c.runb.avgscore;2);14);
  let lata=t.strpad(str.concat(str.fromint(c.runa.avglatencyms);"ms");14);
  let latb=t.strpad(str.concat(str.fromint(c.runb.avglatencyms);"ms");14);
  let costa=t.strpad(str.concat("$";t.f64fixed(c.runa.totalcostusd;2));14);
  let costb=t.strpad(str.concat("$";t.f64fixed(c.runb.totalcostusd;2));14);
  let linetop="Model Comparison
";
  let linehdr="                  \(cola)\(colb)\n";
  let linescore=" Score:           \(scorea)\(scoreb)\n";
  let linelat=" Avg latency:     \(lata)\(latb)\n";
  let linecost=" Total cost:      \(costa)\(costb)\n";
  let linewinner=" \(t.strpad(winnernote;44))\n";
  <"\(linetop)\(linehdr)\(linescore)\(linelat)\(linecost)\(linewinner)"
};

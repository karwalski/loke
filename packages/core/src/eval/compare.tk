m=core.eval.compare;
i=t:shared.types
i=log:shared.log
i=b:eval.bench
i=disp:providers.dispatcher

t=$comparison{
  modela:str;
  modelb:str;
  runa:b.$benchrun;
  runb:b.$benchrun;
  winner:str;
  scoredelta:f64;
  costdelta:f64;
  latencydeltams:i32
};

f=compare(modela:str;modelb:str;cases:@(b.$benchcase);disp:disp.$dispatcher):$comparison{
  log.info("compare: running benchmark for " + modela);
  runa:b.$benchrun = b.runbenchmark(modela;cases;disp);
  log.info("compare: running benchmark for " + modelb);
  runb:b.$benchrun = b.runbenchmark(modelb;cases;disp);
  winner:str = modela;
  if(runb.avgscore > runa.avgscore{
    winner = modelb
  };
  if(runb.avgscore == runa.avgscore{
    if(runb.totalcostusd < runa.totalcostusd{
      winner = modelb
    };
  };
  scoredelta:f64 = runa.avgscore - runb.avgscore;
  costdelta:f64 = runa.totalcostusd - runb.totalcostusd;
  latencydelta:i32 = runa.avglatencyms - runb.avglatencyms;
  <$comparison{
    modela:modela;
    modelb:modelb;
    runa:runa;
    runb:runb;
    winner:winner;
    scoredelta:scoredelta;
    costdelta:costdelta;
    latencydeltams:latencydelta
  };
};

f=formatcomparison(c:$comparison):str{
  wlabel:str = "Winner: " + c.winner;
  scoredstr:str = t.f64tostr(t.f64abs(c.scoredelta);2);
  costdstr:str = t.f64tostr(t.f64abs(c.costdelta);2);
  winnernote:str = wlabel
    + " (score +" + scoredstr
    + ", cost +$" + costdstr + ")";
  cola:str = t.strpad(c.modela;14);
  colb:str = t.strpad(c.modelb;14);
  scorea:str = t.strpad(t.f64tostr(c.runa.avgscore;2);14);
  scoreb:str = t.strpad(t.f64tostr(c.runb.avgscore;2);14);
  lata:str = t.strpad(t.inttostr(c.runa.avglatencyms) + "ms";14);
  latb:str = t.strpad(t.inttostr(c.runb.avglatencyms) + "ms";14);
  costa:str = t.strpad("$" + t.f64tostr(c.runa.totalcostusd;2);14);
  costb:str = t.strpad("$" + t.f64tostr(c.runb.totalcostusd;2);14);
  linetop:str    = "┌─ Model Comparison ──────────────────────────┐
";
  linehdr:str    = "│                  " + cola + colb + "│
";
  linescore:str  = "│ Score:           " + scorea + scoreb + "│
";
  linelat:str    = "│ Avg latency:     " + lata + latb + "│
";
  linecost:str   = "│ Total cost:      " + costa + costb + "│
";
  linewinner:str = "│ " + t.strpad(winnernote;44) + "│
";
  linebot:str    = "└──────────────────────────────────────────────┘
";
  <linetop + linehdr + linescore + linelat + linecost + linewinner + linebot
};

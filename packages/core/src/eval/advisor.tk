m=core.eval.advisor;

i=t:shared.types;
i=log:shared.log;
i=reg:models.registry;
i=str:std.str;

t=$localadvice{
  canrunlocally:bool;
  recommendedmodel:str;
  confidence:str;
  reason:str;
  estimatedquality:str
};

f=advise(taskdescription:str;requiredquality:str):$localadvice{
  log.info("advisor: evaluating task for local feasibility";"eval";"advisor");
  let lower=t.strlower(taskdescription);
  if(t.strcontains(lower;"code")){
    <$localadvice{
      canrunlocally:true;
      recommendedmodel:"qwen2.5:7b";
      confidence:"high";
      reason:"Coding tasks are well-handled by local code-specialised models";
      estimatedquality:"good"
    }
  }el{
    if(t.strcontains(lower;"summarise")){
      <$localadvice{
        canrunlocally:true;
        recommendedmodel:"llama3.1:8b";
        confidence:"high";
        reason:"Summarisation and classification are strong suits of local instruction-tuned models";
        estimatedquality:"excellent"
      }
    }el{
      if(t.strcontains(lower;"creative")){
        <$localadvice{
          canrunlocally:true;
          recommendedmodel:"qwen2.5:72b";
          confidence:"medium";
          reason:"Creative tasks are feasible locally but quality may vary; larger model recommended";
          estimatedquality:"acceptable"
        }
      }el{
        if(t.strcontains(lower;"complex")){
          <$localadvice{
            canrunlocally:false;
            recommendedmodel:"claude-3-5-sonnet-20241022";
            confidence:"high";
            reason:"Task complexity exceeds local model capability";
            estimatedquality:"excellent"
          }
        }el{
          <$localadvice{
            canrunlocally:true;
            recommendedmodel:"llama3.1:8b";
            confidence:"low";
            reason:"No strong signal detected; defaulting to a capable general-purpose local model";
            estimatedquality:"acceptable"
          }
        }
      }
    }
  }
};

f=formatadvice(a:$localadvice):str{
  let runline="  Can run locally:    ";
  let runline=if(a.canrunlocally){
    str.concat(runline;"YES")
  }el{
    str.concat(runline;"NO (cloud recommended)")
  };
  let linetop="Local Model Advisor
";
  let linerun=str.concat("  ";str.concat(runline;"
"));
  let linemodel=str.concat("  Recommended model: ";str.concat(a.recommendedmodel;"
"));
  let lineconf=str.concat("  Confidence:        ";str.concat(a.confidence;"
"));
  let linequal=str.concat("  Est. quality:      ";str.concat(a.estimatedquality;"
"));
  let linereason=str.concat("  Reason: ";str.concat(a.reason;"
"));
  <str.concat(linetop;str.concat(linerun;str.concat(linemodel;str.concat(lineconf;str.concat(linequal;linereason)))))
};

m=core.eval.advisor;
i=t:shared.types
i=log:shared.log
i=reg:models.registry

t=$localadvice{
  canrunlocally:bool;
  recommendedmodel:str;
  confidence:str;
  reason:str;
  estimatedquality:str
};

f=advise(taskdescription:str;requiredquality:str):$localadvice{
  log.info("advisor: evaluating task for local feasibility");
  lower:str = t.strlower(taskdescription);
  if(t.strcontains(lower;"code")
    || t.strcontains(lower;"function")
    || t.strcontains(lower;"debug")
    || t.strcontains(lower;"refactor"){
    <$localadvice{
      canrunlocally:true;
      recommendedmodel:"qwen2.5:7b";
      confidence:"high";
      reason:"Coding tasks are well-handled by local code-specialised models";
      estimatedquality:"good"
    };
  };
  if(t.strcontains(lower;"summarise")
    || t.strcontains(lower;"summarize")
    || t.strcontains(lower;"classify")
    || t.strcontains(lower;"extract"){
    <$localadvice{
      canrunlocally:true;
      recommendedmodel:"llama3.1:8b";
      confidence:"high";
      reason:"Summarisation and classification are strong suits of local instruction-tuned models";
      estimatedquality:"excellent"
    };
  };
  if(t.strcontains(lower;"creative")
    || t.strcontains(lower;"write")
    || t.strcontains(lower;"story")
    || t.strcontains(lower;"poem"){
    <$localadvice{
      canrunlocally:true;
      recommendedmodel:"qwen2.5:72b";
      confidence:"medium";
      reason:"Creative tasks are feasible locally but quality may vary; larger model recommended";
      estimatedquality:"acceptable"
    };
  };
  if(t.strcontains(lower;"complex")
    || t.strcontains(lower;"analyse")
    || t.strcontains(lower;"analyze")
    || t.strcontains(lower;"reasoning")
    || t.strcontains(lower;"research"){
    <$localadvice{
      canrunlocally:false;
      recommendedmodel:"claude-3-5-sonnet-20241022";
      confidence:"high";
      reason:"Task complexity exceeds local model capability";
      estimatedquality:"excellent"
    };
  };
  <$localadvice{
    canrunlocally:true;
    recommendedmodel:"llama3.1:8b";
    confidence:"low";
    reason:"No strong signal detected; defaulting to a capable general-purpose local model";
    estimatedquality:"acceptable"
  };
};

f=formatadvice(a:$localadvice):str{
  runline:str = "  Can run locally:    ";
  if(a.canrunlocally{
    runline = runline + "YES"
  };
  if(!$a.canrunlocally{
    runline = runline + "NO (cloud recommended)"
  };
  linetop:str     = "┌─ Local Model Advisor ────────────────────────┐
";
  linerun:str     = "│ " + t.strpad(runline;44) + "│
";
  linemodel:str   = "│ " + t.strpad("  Recommended model: " + a.recommendedmodel;44) + "│
";
  lineconf:str    = "│ " + t.strpad("  Confidence:        " + a.confidence;44) + "│
";
  linequal:str    = "│ " + t.strpad("  Est. quality:      " + a.estimatedquality;44) + "│
";
  linereason:str  = "│ " + t.strpad("  Reason: " + a.reason;44) + "│
";
  linebot:str     = "└──────────────────────────────────────────────┘
";
  <linetop + linerun + linemodel + lineconf + linequal + linereason + linebot
};

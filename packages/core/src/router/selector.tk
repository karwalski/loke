m=core.router.selector;



i=t:shared.types;
i=reg:core.models.registry;
i=str:std.str;
i=log:shared.log;

t=$selectioncriteria{
  task:$tasktype;
  sensitivity:$sensitivitylevel;
  tolerance:$latencytolerance;
  preferlocal:bool;
  maxcostper1k:f64;
  requiretools:bool
};

t=$selectionresult{
  modelid:str;
  provider:str;
  reason:str;
  islocal:bool;
  estimatedcost:f64;
  tier:$modeltier
};


f=providertostr(p:$provider):str{
  mt p {
    $anthropic:v "anthropic" ;
    $openai:v "openai" ;
    $google:v "google" ;
    $mistral:v "mistral" ;
    $openrouter:v "openrouter" ;
    $ollama:v "ollama" ;
    $local:v "local" 
  }
};



f=tolerancefromstr(s:str):$latencytolerance{
  if(str.eq(s;"patient")){
    <$patient
  }el{
    if(str.eq(s;"background")){
      <$background
    }el{
      <$instant
    }
  }
};


f=tierfromtolerance(tolerance:$latencytolerance):$modeltier{
  mt tolerance {
    $instant:v $interactive ;
    $patient:v $considered ;
    $background:v $background 
  }
};


f=tiertostr(tier:$modeltier):str{
  mt tier {
    $interactive:v "interactive" ;
    $considered:v "considered" ;
    $background:v "background" 
  }
};


f=senstostr(level:$sensitivitylevel):str{
  mt level {
    $public:v "PUBLIC" ;
    $internal:v "INTERNAL" ;
    $confidential:v "CONFIDENTIAL" ;
    $restricted:v "RESTRICTED" 
  }
};


f=buildreason(modelid:str;localonly:bool;sensitivitystr:str;tierstr:str):str{
  let localpart=mut."cloud-eligible (sensitivity: ";
  if(localonly){localpart="local-only (sensitivity: "}el{};
  let senspart=str.concat(localpart;sensitivitystr);
  let closepart=str.concat(senspart;", tier: ");
  let tierpart=str.concat(closepart;tierstr);
  let reasonmid=str.concat(tierpart;") => ");
  let reason=str.concat(reasonmid;modelid);
  <reason
};




f=select(criteria:$selectioncriteria;registry:i64):$selectionresult!$lokeerr{
  
  let isrestricted=criteria.sensitivity=$restricted;
  let localonly=mut.criteria.preferlocal;
  if(isrestricted){localonly=true}el{};

  
  let tier=tierfromtolerance(criteria.tolerance);

  
  let found=reg.findbest(registry;criteria.task;localonly;tier);
  let foundok=mt found {
    $lokeerr:e false;
    $ok:v true
  };
  if(foundok){
    let cap=mt found { $ok:cap cap; $lokeerr:e 0 };
    let providerstr=providertostr(cap.provider);
    let sensstr=senstostr(criteria.sensitivity);
    let tierstr=tiertostr(tier);
    let reason=buildreason(cap.modelid;localonly;sensstr;tierstr);
    log.info(reason;"selector";"");
    <$selectionresult{
      modelid:cap.modelid;
      provider:providerstr;
      reason:reason;
      islocal:cap.local;
      estimatedcost:0.0;
      tier:tier
    }
  }el{};
  if(!localonly){
    <$err($modelerr("selector: no model available for task"))
  }el{};
  if(isrestricted){
    <$err($modelerr("selector: no local model available for RESTRICTED sensitivity"))
  }el{};
  let retry=reg.findbest(registry;criteria.task;false;tier);
  let retryok=mt retry {
    $lokeerr:e2 false;
    $ok:v true
  };
  if(!retryok){
    <$err($modelerr("selector: no model available after cloud fallback"))
  }el{};
  let cap2=mt retry { $ok:cap cap; $lokeerr:e 0 };
  let providerstr2=providertostr(cap2.provider);
  let sensstr2=senstostr(criteria.sensitivity);
  let tierstr2=tiertostr(tier);
  let reason2=buildreason(cap2.modelid;false;sensstr2;tierstr2);
  let cloudreason=str.concat("cloud fallback: ";reason2);
  log.info(cloudreason;"selector";"");
  <$selectionresult{
    modelid:cap2.modelid;
    provider:providerstr2;
    reason:cloudreason;
    islocal:cap2.local;
    estimatedcost:0.0;
    tier:tier
  }
};




f=estimatecost(modelid:str;inputtokens:u32;outputtokens:u32;registry:i64):f64{
  let found=reg.byid(registry;modelid);
  let foundok=mt found {
    $lokeerr:e false;
    $ok:v true
  };
  if(!foundok){ <0.0 }el{};
  let cap=mt found { $ok:c c; $lokeerr:e 0 };
  if(cap.local){ <0.0 }el{};
  let costin=mut.0.001;
  if(str.contains(modelid;"claude-3-5-sonnet")){costin=0.003}el{
    if(str.contains(modelid;"claude-3-5-haiku")){costin=0.001}el{
      if(str.contains(modelid;"gpt-4o-mini")){costin=0.00015}el{
        if(str.contains(modelid;"gpt-4o")){costin=0.005}el{}
      }
    }
  };
  let costout=mut.0.003;
  if(str.contains(modelid;"claude-3-5-sonnet")){costout=0.015}el{
    if(str.contains(modelid;"claude-3-5-haiku")){costout=0.005}el{
      if(str.contains(modelid;"gpt-4o-mini")){costout=0.0006}el{
        if(str.contains(modelid;"gpt-4o")){costout=0.015}el{}
      }
    }
  };
  let inputcost=((inputtokens/1000) as f64)*costin;
  let outputcost=((outputtokens/1000) as f64)*costout;
  <inputcost+outputcost
};

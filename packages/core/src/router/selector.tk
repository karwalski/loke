m=core.router.selector;



i=t:shared.types;
i=reg:core.models.registry;
i=str:std.str;
i=log:shared.log;

t=$selectioncriteria{
  task:$tasktype;
  sensitivity:$sensitivitylevel;
  tolerance:$latencytolerance;
  preferlocal:bool;
  maxcostper1k:f64;
  requiretools:bool
};

t=$selectionresult{
  modelid:str;
  provider:str;
  reason:str;
  islocal:bool;
  estimatedcost:f64;
  tier:$modeltier
};


f=providertostr(p:$provider):str{
  mt p {
    $provider.$anthropic;  <"anthropic";
    $provider.$openai;     <"openai";
    $provider.$google;     <"google";
    $provider.$mistral;    <"mistral";
    $provider.$openrouter; <"openrouter";
    $provider.$ollama;     <"ollama";
    $provider.$local;      <"local"
  };
};



f=tolerancefromstr(s:str):$latencytolerance{
  if(str.eq(s;"patient")){
    <$latencytolerance.$patient
  }else{
    if(str.eq(s;"background")){
      <$latencytolerance.$background
    }else{
      <$latencytolerance.$instant
    };
  };
};


f=tierfromtolerance(tolerance:$latencytolerance):$modeltier{
  mt tolerance {
    $latencytolerance.$instant;    <$modeltier.$interactive;
    $latencytolerance.$patient;    <$modeltier.$considered;
    $latencytolerance.$background; <$modeltier.$background
  };
};


f=tiertostr(tier:$modeltier):str{
  mt tier {
    $modeltier.$interactive; <"interactive";
    $modeltier.$considered;  <"considered";
    $modeltier.$background;  <"background"
  };
};


f=senstostr(level:$sensitivitylevel):str{
  mt level {
    $sensitivitylevel.$public;      <"PUBLIC";
    $sensitivitylevel.$internal;    <"INTERNAL";
    $sensitivitylevel.$confidential;<"CONFIDENTIAL";
    $sensitivitylevel.$restricted;  <"RESTRICTED"
  };
};


f=buildreason(modelid:str;localonly:bool;sensitivitystr:str;tierstr:str):str{
  let localpart=if localonly{"local-only (sensitivity: "}else{"cloud-eligible (sensitivity: "};
  let senspart=str.concat(localpart;sensitivitystr);
  let closepart=str.concat(senspart;", tier: ");
  let tierpart=str.concat(closepart;tierstr);
  let reasonmid=str.concat(tierpart;") => ");
  let reason=str.concat(reasonmid;modelid);
  <reason
};




f=select(criteria:$selectioncriteria;registry:$reg.registry):$selectionresult|$lokeerr{
  
  let isrestricted=criteria.sensitivity=$restricted;
  let localonly=if isrestricted{true}else{criteria.preferlocal};

  
  let tier=tierfromtolerance(criteria.tolerance);

  
  let found=reg.findbest(registry;criteria.task;localonly;tier);
  mt found {
    $lokeerr e;
      
      if(localonly){
        if(isrestricted){
          
          <$lokeerr.$modelerr("selector: no local model available for RESTRICTED sensitivity")
        }else{
          
          let retry=reg.findbest(registry;criteria.task;false;tier);
          mt retry {
            $lokeerr e2;
              <$lokeerr.$modelerr("selector: no model available after cloud fallback")
            cap;
              let providerstr=providertostr(cap.provider);
              let sensstr=senstostr(criteria.sensitivity);
              let tierstr=tiertostr(tier);
              let reason=buildreason(cap.modelid;false;sensstr;tierstr);
              let cloudreason=str.concat("cloud fallback: ";reason);
              log.info(cloudreason;"selector";"");
              let result=$selectionresult{
                modelid:cap.modelid;
                provider:providerstr;
                reason:cloudreason;
                islocal:cap.local;
                estimatedcost:0.0;
                tier:tier
              };
              <result
          };
        };
      }else{
        <$lokeerr.$modelerr("selector: no model available for task")
      };
    cap;
      
      let providerstr=providertostr(cap.provider);
      let sensstr=senstostr(criteria.sensitivity);
      let tierstr=tiertostr(tier);
      let reason=buildreason(cap.modelid;localonly;sensstr;tierstr);
      log.info(reason;"selector";"");
      
      let result=$selectionresult{
        modelid:cap.modelid;
        provider:providerstr;
        reason:reason;
        islocal:cap.local;
        estimatedcost:0.0;
        tier:tier
      };
      <result
  };
};




f=estimatecost(modelid:str;inputtokens:u32;outputtokens:u32;registry:$reg.registry):f64{
  let found=reg.byid(registry;modelid);
  mt found {
    $lokeerr e;
      <0.0
    cap;
      if(cap.local){
        <0.0
      }else{
        
        
        
        
        
        let costin=if str.contains(modelid;"claude-3-5-sonnet"){0.003}else{
          if(str.contains(modelid;"claude-3-5-haiku")){0.001}else{
            if(str.contains(modelid;"gpt-4o-mini")){0.00015}else{
              if(str.contains(modelid;"gpt-4o")){0.005}else{0.001};
            };
          };
        };
        let costout=if str.contains(modelid;"claude-3-5-sonnet"){0.015}else{
          if(str.contains(modelid;"claude-3-5-haiku")){0.005}else{
            if(str.contains(modelid;"gpt-4o-mini")){0.0006}else{
              if(str.contains(modelid;"gpt-4o")){0.015}else{0.003};
            };
          };
        };
        let inputcost=(inputtokens/1000)*costin;
        let outputcost=(outputtokens/1000)*costout;
        <inputcost+outputcost
      };
  };
};

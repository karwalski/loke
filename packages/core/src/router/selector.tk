m=core.router.selector;



i=reg:core.models.registry;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;

t=$selectioncriteria{
  task:$tasktype;
  sensitivity:$sensitivitylevel;
  tolerance:$latencytolerance;
  preferlocal:bool;
  maxcostper1k:f64;
  requiretools:bool
};

t=$selectionresult{
  modelid:str;
  provider:str;
  reason:str;
  islocal:bool;
  estimatedcost:f64;
  tier:$modeltier
};


f=providertostr(p:$provider):str{
  <mt p {
    $anthropic:v "anthropic" ;
    $openai:v "openai" ;
    $google:v "google" ;
    $mistral:v "mistral" ;
    $openrouter:v "openrouter" ;
    $ollama:v "ollama" ;
    $local:v "local" 
  }
};



f=tolerancefromstr(s:str):$latencytolerance{
  if(str.eq(s;"patient")){
    <$latencytolerance{$patient:0}
  }el{
    if(str.eq(s;"background")){
      <$modeltier{$background:0}
    }el{
      <$latencytolerance{$instant:0}
    }
  }
};


f=tierfromtolerance(tolerance:$latencytolerance):$modeltier{
  <mt tolerance {
    $instant:v $modeltier{$interactive:0} ;
    $patient:v $modeltier{$considered:0} ;
    $background:v $modeltier{$background:0} 
  }
};


f=tiertostr(tier:$modeltier):str{
  <mt tier {
    $interactive:v "interactive" ;
    $considered:v "considered" ;
    $background:v "background" 
  }
};


f=senstostr(level:$sensitivitylevel):str{
  <mt level {
    $public:v "PUBLIC" ;
    $internal:v "INTERNAL" ;
    $confidential:v "CONFIDENTIAL" ;
    $restricted:v "RESTRICTED" 
  }
};


f=buildreason(modelid:str;localonly:bool;sensitivitystr:str;tierstr:str):str{
  let localpart=mut."cloud-eligible (sensitivity: ";
  if(localonly){localpart="local-only (sensitivity: "}el{};
  let senspart=str.concat(localpart;sensitivitystr);
  let closepart=str.concat(senspart;", tier: ");
  let tierpart=str.concat(closepart;tierstr);
  let reasonmid=str.concat(tierpart;") => ");
  let reason=str.concat(reasonmid;modelid);
  <reason
};




(* LS1.1j / GA1.7 — selectmodel is the form a caller can trust; select cannot be.

   select returns $selectionresult!$lokeerr. toke takes the FIRST arm of a match on a
   result whose error side is a user-declared sum, whatever the value is (T-18), so no
   caller of select could tell a chosen model from a failed selection. For
   sensitivity-scored routing that is the worst failure available: a failed selection read
   as a success names a garbage provider, and restricted data would be sent to whatever
   endpoint that turned out to be. It is why nothing was ever wired to this function.

   Worse than a wrong answer, in fact. Reading any field off the mis-bound value
   segfaults rather than returning nonsense, verified with a probe this session. And
   select had a second bug on top of T-18: its internal `mt` on reg.findbest was written
   with the $lokeerr arm FIRST, so `foundok` was false even when a model had been found,
   every path fell through, and select returned $err for EVERY input. Both halves of the
   request path downstream of it were dead.

   selectmodel answers with a plain struct. An empty modelid means "nothing was
   selected", tested with isselected, and the reason string carries the message the
   caller can log even though it cannot match on it. The capability lookup now goes
   through reg.bestfortask, which is plain for the same reason. *)
f=noselection(reason:str):$selectionresult{
  <$selectionresult{
    modelid:"";
    provider:"";
    reason:reason;
    islocal:false;
    estimatedcost:0.0;
    tier:$modeltier{$interactive:0}
  }
};

f=isselected(r:$selectionresult):bool{
  <str.len(r.modelid)>0
};

f=selectmodel(criteria:$selectioncriteria;registry:i64):$selectionresult{

  (* senseq, not ==: a sensitivity that arrived through $routingcriteria compares
     unequal to a locally constructed $restricted (T-14). *)
  let isrestricted=t.senseq(criteria.sensitivity;t.restricted());
  let localonly=mut.criteria.preferlocal;
  if(isrestricted){localonly=true}el{};

  let tier=tierfromtolerance(criteria.tolerance);

  let found=reg.bestfortask(registry;criteria.task;localonly;tier);
  if(reg.iscapability(found)){
    let cap:$modelcapability=found;
    let providerstr=providertostr(cap.provider);
    let sensstr=senstostr(criteria.sensitivity);
    let tierstr=tiertostr(tier);
    let reason=buildreason(cap.modelid;localonly;sensstr;tierstr);
    log.info(reason;"selector";"");
    <$selectionresult{
      modelid:cap.modelid;
      provider:providerstr;
      reason:reason;
      islocal:cap.local;
      estimatedcost:0.0;
      tier:tier
    }
  }el{};

  (* A cloud-eligible request that found nothing has nowhere left to look. Only a
     local-only request has a fallback, and a RESTRICTED one must not take it. *)
  if(!localonly){
    <noselection("selector: no model available for task")
  }el{};
  if(isrestricted){
    <noselection("selector: no local model available for RESTRICTED sensitivity")
  }el{};

  let retry=reg.bestfortask(registry;criteria.task;false;tier);
  if(reg.iscapability(retry)){}el{
    <noselection("selector: no model available after cloud fallback")
  };
  let cap2:$modelcapability=retry;
  let providerstr2=providertostr(cap2.provider);
  let sensstr2=senstostr(criteria.sensitivity);
  let tierstr2=tiertostr(tier);
  let reason2=buildreason(cap2.modelid;false;sensstr2;tierstr2);
  let cloudreason=str.concat("cloud fallback: ";reason2);
  log.info(cloudreason;"selector";"");
  <$selectionresult{
    modelid:cap2.modelid;
    provider:providerstr2;
    reason:cloudreason;
    islocal:cap2.local;
    estimatedcost:0.0;
    tier:tier
  }
};

(* Kept so that callers already matching this result keep compiling, and so the change
   to them can be a separate diff. It delegates, exactly as
   core.storage.audit.logevent does — but note that it can only ever hand back a value
   its caller cannot discriminate. New callers use selectmodel and isselected. *)
f=select(criteria:$selectioncriteria;registry:i64):$selectionresult!$lokeerr{
  let picked=selectmodel(criteria;registry);
  if(isselected(picked)){
    <$ok(picked)
  }el{
    <$err($modelerr(picked.reason))
  }
};




(* Three defects here, all found while converting select.

   1. T-18 again. `foundok` read the FIRST arm of a match on reg.byid's result, which was
      the $lokeerr arm, so foundok was false for every model that exists and estimatecost
      returned 0.0 unconditionally. The lookup now goes through reg.capabilitybyid, which
      answers with a plain struct.
   2. `(inputtokens/1000) as f64` divided two u32s BEFORE the cast, so any request under a
      thousand tokens costed at exactly zero — the cast was applied to an integer quotient
      that was already 0. The cast now comes first.
   3. T-20: an f64 RETURNED across a module boundary is corrupted. Nothing outside this
      module calls estimatecost today, so the f64 return is not currently a live defect,
      but it is a trap for the first caller in another module. estimatecosthundredths
      below is the form to cross with. *)
f=estimatecost(modelid:str;inputtokens:u32;outputtokens:u32;registry:i64):f64{
  let cap=reg.capabilitybyid(registry;modelid);
  if(reg.iscapability(cap)){}el{ <0.0 };
  if(cap.local){ <0.0 }el{};
  let costin=mut.0.001;
  if(str.contains(modelid;"claude-3-5-sonnet")){costin=0.003}el{
    if(str.contains(modelid;"claude-3-5-haiku")){costin=0.001}el{
      if(str.contains(modelid;"gpt-4o-mini")){costin=0.00015}el{
        if(str.contains(modelid;"gpt-4o")){costin=0.005}el{}
      }
    }
  };
  let costout=mut.0.003;
  if(str.contains(modelid;"claude-3-5-sonnet")){costout=0.015}el{
    if(str.contains(modelid;"claude-3-5-haiku")){costout=0.005}el{
      if(str.contains(modelid;"gpt-4o-mini")){costout=0.0006}el{
        if(str.contains(modelid;"gpt-4o")){costout=0.015}el{}
      }
    }
  };
  <(((inputtokens as f64)/1000.0)*costin)+(((outputtokens as f64)/1000.0)*costout)
};

(* The cross-module form of estimatecost: an f64 parameter crosses a module boundary
   intact, an f64 return does not (T-20), so the crossing carries hundredths of a cent as
   an exact integer and the caller divides locally. Same reason
   shared.types.f64hundredths exists. *)
f=estimatecosthundredths(modelid:str;inputtokens:u32;outputtokens:u32;registry:i64):i64{
  <t.f64hundredths(estimatecost(modelid;inputtokens;outputtokens;registry))
};

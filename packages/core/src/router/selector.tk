m=core.router.selector;



i=t:shared.types;
i=reg:core.models.registry;
i=str:std.str;
i=log:shared.log;

t=$selectioncriteria{
  task:$tasktype;
  sensitivity:$sensitivitylevel;
  tolerance:$latencytolerance;
  preferlocal:bool;
  maxcostper1k:f64;
  requiretools:bool
};

t=$selectionresult{
  modelid:str;
  provider:str;
  reason:str;
  islocal:bool;
  estimatedcost:f64;
  tier:$modeltier
};


f=providertostr(p:$provider):str{
  mt p {
    $$anthropic;  <"anthropic";
    $$openai;     <"openai";
    $$google;     <"google";
    $$mistral;    <"mistral";
    $$openrouter; <"openrouter";
    $$ollama;     <"ollama";
    $$local;      <"local"
  }
};



f=tolerancefromstr(s:str):$latencytolerance{
  if(str.eq(s;"patient")){
    <$$patient
  }el{
    if(str.eq(s;"background")){
      <$$background
    }el{
      <$$instant
    }
  }
};


f=tierfromtolerance(tolerance:$latencytolerance):$modeltier{
  mt tolerance {
    $$instant;    <$$interactive;
    $$patient;    <$$considered;
    $$background; <$$background
  }
};


f=tiertostr(tier:$modeltier):str{
  mt tier {
    $$interactive; <"interactive";
    $$considered;  <"considered";
    $$background;  <"background"
  }
};


f=senstostr(level:$sensitivitylevel):str{
  mt level {
    $$public;      <"PUBLIC";
    $$internal;    <"INTERNAL";
    $$confidential;<"CONFIDENTIAL";
    $$restricted;  <"RESTRICTED"
  }
};


f=buildreason(modelid:str;localonly:bool;sensitivitystr:str;tierstr:str):str{
  let localpart=if localonly{"local-only (sensitivity: "}el{"cloud-eligible (sensitivity: "};
  let senspart=str.concat(localpart;sensitivitystr);
  let closepart=str.concat(senspart;", tier: ");
  let tierpart=str.concat(closepart;tierstr);
  let reasonmid=str.concat(tierpart;") => ");
  let reason=str.concat(reasonmid;modelid);
  <reason
};




f=select(criteria:$selectioncriteria;registry:i64):$selectionresult!$lokeerr{
  
  let isrestricted=criteria.sensitivity=$restricted;
  let localonly=if isrestricted{true}el{criteria.preferlocal};

  
  let tier=tierfromtolerance(criteria.tolerance);

  
  let found=reg.findbest(registry;criteria.task;localonly;tier);
  mt found {
    $lokeerr:e;
      
      if(localonly){
        if(isrestricted){
          
          <$$modelerr("selector: no local model available for RESTRICTED sensitivity")
        }el{
          
          let retry=reg.findbest(registry;criteria.task;false;tier);
          mt retry {
            $lokeerr:e2;
              <$$modelerr("selector: no model available after cloud fallback")
            cap;
              let providerstr=providertostr(cap.provider);
              let sensstr=senstostr(criteria.sensitivity);
              let tierstr=tiertostr(tier);
              let reason=buildreason(cap.modelid;false;sensstr;tierstr);
              let cloudreason=str.concat("cloud fallback: ";reason);
              log.info(cloudreason;"selector";"");
              let result=$selectionresult{
                modelid:cap.modelid;
                provider:providerstr;
                reason:cloudreason;
                islocal:cap.local;
                estimatedcost:0.0;
                tier:tier
              };
              <result
          }
        }
      }el{
        <$$modelerr("selector: no model available for task")
      };
    cap;
      
      let providerstr=providertostr(cap.provider);
      let sensstr=senstostr(criteria.sensitivity);
      let tierstr=tiertostr(tier);
      let reason=buildreason(cap.modelid;localonly;sensstr;tierstr);
      log.info(reason;"selector";"");
      
      let result=$selectionresult{
        modelid:cap.modelid;
        provider:providerstr;
        reason:reason;
        islocal:cap.local;
        estimatedcost:0.0;
        tier:tier
      };
      <result
  }
};




f=estimatecost(modelid:str;inputtokens:u32;outputtokens:u32;registry:i64):f64{
  let found=reg.byid(registry;modelid);
  mt found {
    $lokeerr:e;
      <0.0
    cap;
      if(cap.local){
        <0.0
      }el{
        
        
        
        
        
        let costin=if str.contains(modelid;"claude-3-5-sonnet"){0.003}el{
          if(str.contains(modelid;"claude-3-5-haiku")){0.001}el{
            if(str.contains(modelid;"gpt-4o-mini")){0.00015}el{
              if(str.contains(modelid;"gpt-4o")){0.005}el{0.001}
            }
          }
        };
        let costout=if str.contains(modelid;"claude-3-5-sonnet"){0.015}el{
          if(str.contains(modelid;"claude-3-5-haiku")){0.005}el{
            if(str.contains(modelid;"gpt-4o-mini")){0.0006}el{
              if(str.contains(modelid;"gpt-4o")){0.015}el{0.003}
            }
          }
        };
        let inputcost=(inputtokens/1000)*costin;
        let outputcost=(outputtokens/1000)*costout;
        <inputcost+outputcost
      }
  }
};

m=core.router.escalation;




i=t:shared.types;
i=log:shared.log;
i=prov:core.providers.types;
i=sens:core.router.sensitivity;

t=$escalationtrigger{
  reason:str;
  frommodel:str;
  tomodel:str;
  triggeredat:i64
};

(* F5.8. `minconfidence` is gone. Nothing could honour it: $completionresponse carries
   no confidence, so the field was a threshold with nothing to compare against, and a
   policy field that cannot take effect is the defect this row was filed for. The two
   fields that remain are both read, below. *)
t=$escalationpolicy{
  maxretries:i32;
  allowcloudescalation:bool
};



f=defaultpolicy():$escalationpolicy{
  <$escalationpolicy{
    maxretries:2;
    allowcloudescalation:true
  }
};



(* `attempts` is how many escalations this request has already made. The policy's retry
   budget is checked first: a budget of 0 means never escalate, whatever the answer
   looked like. F5.8: this function used to take the policy and never read it. *)
f=shouldescalate(response:$completionresponse;policy:$escalationpolicy;attempts:i32):bool{
  if(attempts >= policy.maxretries){
    <false
  }el{};
  if(t.strisempty(response.content)){
    <true
  }el{
    if(response.outputtokens < 10){
      <true
    }el{
      let short=t.strlen(response.content) < 100;
      if(short){
        let hasidk=t.strcontains(response.content;"I don't know");
        let hascannot=t.strcontains(response.content;"I cannot");
        let hasunsure=t.strcontains(response.content;"I'm not sure");
        if(hasidk){<true}el{if(hascannot){<true}el{if(hasunsure){<true}el{<false}}}
      }el{
        <false
      }
    }
  }
};



(* The raw ladder. "" means there is no next rung: the model is unrecognised, is empty
   (which is what providers.types.nocompletion carries), or is already the top. The old
   fallback answered claude-3-5-sonnet for all three, so a FAILED completion escalated to a
   cloud provider and the top rung escalated to itself.

   F5.11b: the cloud rungs were Haiku 3.5 and Sonnet 3.5, both retired by Anthropic. They
   are now the current models of the same tiers, Haiku 4.5 and Sonnet 5, by the ids
   Anthropic publishes. *)
f=nextrung(currentmodel:str):str{
  if(t.streq(currentmodel;"qwen2.5:7b")){
    <"qwen2.5:72b"
  }el{
    if(t.streq(currentmodel;"llama3.2:3b")){
      <"llama3.1:8b"
    }el{
      if(t.streq(currentmodel;"llama3.1:8b")){
        <"claude-haiku-4-5-20251001"
      }el{
        if(t.streq(currentmodel;"qwen2.5:72b")){
          <"claude-sonnet-5"
        }el{
          if(t.streq(currentmodel;"claude-haiku-4-5-20251001")){
            <"claude-sonnet-5"
          }el{
            <""
          }
        }
      }
    }
  }
};

(* The rungs that leave the machine. Exact ids, not a prefix: this ladder is the only
   source of targets, and a guess about a name it does not produce is not needed. *)
f=iscloudrung(model:str):bool{
  if(t.streq(model;"claude-haiku-4-5-20251001")){
    <true
  }el{};
  <t.streq(model;"claude-sonnet-5")
};

(* The next model to try, or "" for do not escalate. A cloud rung is returned only when
   the policy allows cloud escalation AND the prompt's sensitivity may use the cloud
   (core.router.sensitivity.canusecloud, the same gate routerequest applies). So a
   RESTRICTED prompt can still climb the local rungs and is refused at the first cloud
   one. F5.8: this took no policy and no sensitivity, so nothing could stop it. *)
f=escalationtarget(currentmodel:str;policy:$escalationpolicy;level:$sensitivitylevel):str{
  let next=nextrung(currentmodel);
  if(iscloudrung(next)){
    if(policy.allowcloudescalation && sens.canusecloud(level)){
      <next
    }el{
      <""
    }
  }el{};
  <next
};



f=recordescalation(frommodel:str;tomodel:str;reason:str):$escalationtrigger{
  let now=t.nowunixms();
  let trigger=$escalationtrigger{
    reason:reason;
    frommodel:frommodel;
    tomodel:tomodel;
    triggeredat:now
  };
  let msg=formattrigger(trigger);
  log.info(msg;"escalation";"");
  <trigger
};



f=formattrigger(trigger:$escalationtrigger):str{
  let part1=t.strconcat("Escalated: ";trigger.frommodel);
  let part2=t.strconcat(part1;" → ");
  let part3=t.strconcat(part2;trigger.tomodel);
  let part4=t.strconcat(part3;" (");
  let part5=t.strconcat(part4;trigger.reason);
  <t.strconcat(part5;")")
};

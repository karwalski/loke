m=core.router.escalation;




i=t:shared.types;
i=log:shared.log;
i=prov:core.providers.types;

t=$escalationtrigger{
  reason:str;
  frommodel:str;
  tomodel:str;
  triggeredat:i64
};

t=$escalationpolicy{
  minconfidence:f64;
  maxretries:i32;
  allowcloudescalation:bool
};



f=defaultpolicy():$escalationpolicy{
  <$escalationpolicy{
    minconfidence:0.7;
    maxretries:2;
    allowcloudescalation:true
  }
};






f=shouldescalate(response:i64;policy:$escalationpolicy):bool{
  
  if(t.strisempty(response.content)){
    <true
  }el{
    
    if(response.outputtokens < 10){
      <true
    }el{
      
      let short=t.strlen(response.content) < 100;
      if(short){
        let hasidk=t.strcontains(response.content;"I don't know");
        let hascannot=t.strcontains(response.content;"I cannot");
        let hasunsure=t.strcontains(response.content;"I'm not sure");
        if(hasidk){<true}el{if(hascannot){<true}el{if(hasunsure){<true}el{<false}}}
      }el{
        <false
      }
    }
  }
};



f=escalationtarget(currentmodel:str):str{
  if(t.streq(currentmodel;"qwen2.5:7b")){
    <"qwen2.5:72b"
  }el{
    if(t.streq(currentmodel;"llama3.2:3b")){
      <"llama3.1:8b"
    }el{
      if(t.streq(currentmodel;"llama3.1:8b")){
        <"claude-3-5-haiku-20241022"
      }el{
        if(t.streq(currentmodel;"qwen2.5:72b")){
          <"claude-3-5-sonnet-20241022"
        }el{
          <"claude-3-5-sonnet-20241022"
        }
      }
    }
  }
};



f=recordescalation(frommodel:str;tomodel:str;reason:str):$escalationtrigger{
  let now=t.nowunixms();
  let trigger=$escalationtrigger{
    reason:reason;
    frommodel:frommodel;
    tomodel:tomodel;
    triggeredat:now
  };
  let msg=formattrigger(trigger);
  log.info(msg;"escalation";"");
  <trigger
};



f=formattrigger(trigger:$escalationtrigger):str{
  let part1=t.strconcat("Escalated: ";trigger.frommodel);
  let part2=t.strconcat(part1;" → ");
  let part3=t.strconcat(part2;trigger.tomodel);
  let part4=t.strconcat(part3;" (");
  let part5=t.strconcat(part4;trigger.reason);
  <t.strconcat(part5;")")
};

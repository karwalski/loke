m=core.router.latency_router;




i=t:shared.types;
i=sel:router.selector;
i=log:shared.log;

t=$latencyconstraint{
  tolerance:t.$latencytolerance;
  maxttftms:i32;
  maxtotalms:i32
};


constraintinteractive=$latencyconstraint{
  tolerance:t.$latencytolerance.$interactive;
  maxttftms:500;
  maxtotalms:10000
};


constraintconsidered=$latencyconstraint{
  tolerance:t.$latencytolerance.$considered;
  maxttftms:2000;
  maxtotalms:60000
};


constraintbackground=$latencyconstraint{
  tolerance:t.$latencytolerance.$background;
  maxttftms:30000;
  maxtotalms:3600000
};


f=constraintfor(tolerance:t.$latencytolerance):$latencyconstraint{
  mt tolerance {
    t.$latencytolerance.$interactive; <constraintinteractive;
    t.$latencytolerance.$considered;  <constraintconsidered;
    t.$latencytolerance.$background;  <constraintbackground
  };
};





f=filterbylatency(candidates:@(t.$modelspec);constraint:$latencyconstraint):@(t.$modelspec){
  if constraint.maxttftms < 1000 {
    
    let filtered=t.filtermodels(candidates;f=(spec:t.$modelspec):bool{
      spec.provider == t.$provider.$ollama || spec.provider == t.$provider.$local
    });
    log.info("latency_router: INTERACTIVE — restricted to local models";"latency_router";"");
    <filtered
  }else{
    
    <candidates
  };
};




f=applylatencyrouting(criteria:sel.$selectioncriteria;tolerance:t.$latencytolerance):sel.$selectioncriteria{
  let constraint=constraintfor(tolerance);
  let forcelocal=tolerance == t.$latencytolerance.$interactive;
  let updated=sel.$selectioncriteria{
    task:criteria.task;
    sensitivity:criteria.sensitivity;
    tolerance:criteria.tolerance;
    preferlocal:forcelocal || criteria.preferlocal;
    maxcostper1k:criteria.maxcostper1k;
    requiretools:criteria.requiretools
  };
  let ttftstr=t.i32tostr(constraint.maxttftms);
  let msg=t.strconcat("latency_router: applied constraint max_ttft_ms=";ttftstr);
  log.info(msg;"latency_router";"");
  <updated
};

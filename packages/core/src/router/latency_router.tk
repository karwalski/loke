m=core.router.latencyrouter;
i=str:std.str;




i=t:shared.types;
i=sel:router.selector;
i=log:shared.log;

t=$latencyconstraint{
  tolerance:i64;
  maxttftms:i32;
  maxtotalms:i32
};


f=constraintinteractive():$latencyconstraint{
  <$latencyconstraint{
    tolerance:i64;
    maxttftms:500;
    maxtotalms:10000
  }
};


f=constraintconsidered():$latencyconstraint{
  <$latencyconstraint{
    tolerance:i64;
    maxttftms:2000;
    maxtotalms:60000
  }
};


f=constraintbackground():$latencyconstraint{
  <$latencyconstraint{
    tolerance:i64;
    maxttftms:30000;
    maxtotalms:3600000
  }
};


f=constraintfor(tolerance:i64):$latencyconstraint{
  mt tolerance {
    t.$$interactive; constraintinteractive();
    t.$$considered;  constraintconsidered();
    t.$$background;  constraintbackground()
  }
};





f=filterbylatency(candidates:@i64;constraint:$latencyconstraint):@i64{
  if(constraint.maxttftms < 1000){
    let filtered=t.filtermodels(candidates;true);
    log.info("latency_router: INTERACTIVE — restricted to local models";"latency_router";"");
    <filtered
  }el{
    <candidates
  }
};




f=applylatencyrouting(criteria:i64;tolerance:i64):i64{
  let constraint=constraintfor(tolerance);
  let forcelocal=if(tolerance = t.$$interactive){true}el{false};
  let preflocal=if(forcelocal){true}el{criteria.preferlocal};
  let updated=$selectioncriteria{
    task:criteria.task;
    sensitivity:criteria.sensitivity;
    tolerance:criteria.tolerance;
    preferlocal:preflocal;
    maxcostper1k:criteria.maxcostper1k;
    requiretools:criteria.requiretools
  };
  let ttftstr=t.i32tostr(constraint.maxttftms);
  let msg=t.strconcat("latency_router: applied constraint max_ttft_ms=";ttftstr);
  log.info(msg;"latency_router";"");
  <updated
};

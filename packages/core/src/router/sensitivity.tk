m=core.router.sensitivity;




i=t:shared.types;
i=str:std.str;
i=log:shared.log;


f=levelrank(level:$sensitivitylevel):u32{
  mt level {
    $sensitivitylevel.$public;       <0;
    $sensitivitylevel.$internal;     <1;
    $sensitivitylevel.$confidential; <2;
    $sensitivitylevel.$restricted;   <3
  };
};



f=scorefrompii(piisensitivity:$sensitivitylevel;entitycount:u32):$sensitivitylevel{
  
  if(entitycount > 0){
    let isrestricted=levelrank(piisensitivity)=3;
    if(isrestricted){
      <$restricted
    }el{
      
      let isconfidential=levelrank(piisensitivity)=2;
      if(isconfidential){
        if(entitycount > 3){
          <$restricted
        }el{
          <piisensitivity
        };
      }el{
        <piisensitivity
      };
    };
  }el{
    <piisensitivity
  };
};



f=scorefromcontent(text:str):$sensitivitylevel{
  
  if(str.contains(text;"password")){
    <$restricted
  }el{
    if(str.contains(text;"api key")){
      <$restricted
    }el{
      if(str.contains(text;"secret")){
        <$restricted
      }el{
        if(str.contains(text;"credential")){
          <$restricted
        }el{
          if(str.contains(text;"private key")){
            <$restricted
          }el{
            if(str.contains(text;"access token")){
              <$restricted
            }el{
              if(str.contains(text;"bank account")){
                <$restricted
              }el{
                if(str.contains(text;"credit card")){
                  <$restricted
                }el{
                  if(str.contains(text;"bsb")){
                    <$restricted
                  }el{
                    if(str.contains(text;"iban")){
                      <$restricted
                    }el{
                      if(str.contains(text;"routing number")){
                        <$restricted
                      }el{
                        
                        if(str.contains(text;"internal")){
                          <$confidential
                        }el{
                          if(str.contains(text;"confidential")){
                            <$confidential
                          }el{
                            if(str.contains(text;"do not share")){
                              <$confidential
                            }el{
                              if(str.contains(text;"proprietary")){
                                <$confidential
                              }el{
                                if(str.contains(text;"diagnosis")){
                                  <$confidential
                                }el{
                                  if(str.contains(text;"prescription")){
                                    <$confidential
                                  }el{
                                    if(str.contains(text;"medical record")){
                                      <$confidential
                                    }el{
                                      if(str.contains(text;"patient")){
                                        <$confidential
                                      }el{
                                        <$public
                                      };
                                    };
                                  };
                                };
                              };
                            };
                          };
                        };
                      };
                    };
                  };
                };
              };
            };
          };
        };
      };
    };
  };
};



f=combine(piilevel:$sensitivitylevel;contentlevel:$sensitivitylevel):$sensitivitylevel{
  let piirank=levelrank(piilevel);
  let contentrank=levelrank(contentlevel);
  if(piirank > contentrank){
    <piilevel
  }el{
    <contentlevel
  };
};



f=canusecloud(level:$sensitivitylevel):bool{
  mt level {
    $sensitivitylevel.$restricted;  <false;
    $sensitivitylevel.$confidential;<true;
    $sensitivitylevel.$internal;    <true;
    $sensitivitylevel.$public;      <true
  };
};


f=leveltostr(level:$sensitivitylevel):str{
  mt level {
    $sensitivitylevel.$public;      <"PUBLIC";
    $sensitivitylevel.$internal;    <"INTERNAL";
    $sensitivitylevel.$confidential;<"CONFIDENTIAL";
    $sensitivitylevel.$restricted;  <"RESTRICTED"
  };
};

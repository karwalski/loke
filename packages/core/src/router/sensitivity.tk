m=core.router.sensitivity;




i=str:std.str;
i=t:shared.types;


f=levelrank(level:$sensitivitylevel):u32{
  <mt level {
    $public:v 0 as u32;
    $internal:v 1 as u32;
    $confidential:v 2 as u32;
    $restricted:v 3 as u32
  }
};



f=scorefrompii(piisensitivity:$sensitivitylevel;entitycount:u32):$sensitivitylevel{
  
  if(entitycount > 0 as u32){
    if(levelrank(piisensitivity)==3){
      <$sensitivitylevel{$restricted:0}
    }el if(levelrank(piisensitivity)==2){
      if(entitycount > 3 as u32){
        <$sensitivitylevel{$restricted:0}
      }el{
        <piisensitivity
      }
    }el{
      <piisensitivity
    }
  }el{
    <piisensitivity
  }
};



f=scorefromcontent(text:str):$sensitivitylevel{
  
  if(str.contains(text;"password")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"api key")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"secret")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"credential")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"private key")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"access token")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"bank account")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"credit card")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"bsb")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"iban")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"routing number")){
    <$sensitivitylevel{$restricted:0}
  }el if(str.contains(text;"internal")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.contains(text;"confidential")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.contains(text;"do not share")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.contains(text;"proprietary")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.contains(text;"diagnosis")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.contains(text;"prescription")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.contains(text;"medical record")){
    <$sensitivitylevel{$confidential:0}
  }el if(str.contains(text;"patient")){
    <$sensitivitylevel{$confidential:0}
  }el{
    <$sensitivitylevel{$public:0}
  }
};



f=combine(piilevel:$sensitivitylevel;contentlevel:$sensitivitylevel):$sensitivitylevel{
  if(levelrank(piilevel) > levelrank(contentlevel)){
    <piilevel
  }el{
    <contentlevel
  }
};



f=canusecloud(level:$sensitivitylevel):bool{
  <mt level {
    $restricted:v false ;
    $confidential:v true ;
    $internal:v true ;
    $public:v true 
  }
};


f=leveltostr(level:$sensitivitylevel):str{
  <mt level {
    $public:v "PUBLIC" ;
    $internal:v "INTERNAL" ;
    $confidential:v "CONFIDENTIAL" ;
    $restricted:v "RESTRICTED" 
  }
};

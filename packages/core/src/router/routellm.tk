m=core.router.routellm;





i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$routellmrequest{
  prompt:str;
  threshold:f64
};

t=$routellmresponse{
  score:f64;
  route:str;
  modelsuggestion:str
};

t=$routellmresult{
  available:bool;
  score:f64;
  preferstrong:bool
};




f=routellmunavailable():$routellmresult{
  log.warn("routellm: service unavailable, skipping signal";"routellm";"");
  <$routellmresult{available:false;score:0.5;preferstrong:false}
};

f=routellmhandlecap(cap:i64):$routellmresult{
  if(http.iserror(cap)){
    log.warn("routellm: HTTP error from /route";"routellm";"");
    <$routellmresult{available:false;score:0.5;preferstrong:false}
  }el{
    let parsed=json.dec(cap.body);
    mt parsed {
      $lokeerr:e2 routellmparsefailed();
      $ok:rr routellmparsed(rr)
    }
  }
};

f=routellmparsefailed():$routellmresult{
  log.warn("routellm: failed to parse response";"routellm";"");
  <$routellmresult{available:false;score:0.5;preferstrong:false}
};

f=routellmparsed(rr:i64):$routellmresult{
  let isstrong=str.eq(rr.route;"strong");
  <$routellmresult{available:true;score:rr.score;preferstrong:isstrong}
};

f=query(prompt:str;threshold:f64):$routellmresult{
  let req=$routellmrequest{prompt:prompt;threshold:threshold};
  let body=json.enc(req);
  let resp=http.post("http://localhost:11431/route";body);
  mt resp {
    $lokeerr:e routellmunavailable();
    $ok:cap routellmhandlecap(cap)
  }
};


f=isavailable():bool{
  let resp=http.get("http://localhost:11431/health");
  mt resp {
    $lokeerr:e false;
    $ok:cap http.isok(cap)
  }
};



f=defaultthreshold():f64{
  <0.3
};

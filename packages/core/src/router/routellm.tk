m=core.router.routellm;





i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=reach:shared.reachability;
i=jx:shared.jsonobj;

t=$routellmrequest{
  prompt:str;
  threshold:f64
};

t=$routellmresponse{
  score:f64;
  route:str;
  modelsuggestion:str
};

t=$routellmresult{
  available:bool;
  score:f64;
  preferstrong:bool
};




f=routellmunavailable():$routellmresult{
  log.warn("routellm: service unavailable, skipping signal";"routellm";"");
  <$routellmresult{available:false;score:0.5;preferstrong:false}
};

f=routellmparsefailed():$routellmresult{
  log.warn("routellm: failed to parse response";"routellm";"");
  <$routellmresult{available:false;score:0.5;preferstrong:false}
};

f=routellmparsed(rr:$routellmresponse):$routellmresult{
  let isstrong=str.eq(rr.route;"strong");
  <$routellmresult{available:true;score:rr.score;preferstrong:isstrong}
};

f=query(prompt:str;threshold:f64):$routellmresult{
  <queryat("http://localhost:11431";prompt;threshold)
};

(* MK6.15. The body was `json.enc(req)` on a $routellmrequest struct, and json.enc takes a
   str. Measured at toke 3.1.0 against scripts/lib/http_recorder.py: the sidecar received
   `"pW7"`, a JSON string of the struct's bytes, with neither the prompt nor the threshold
   in it, so no routing signal was ever computed from a prompt. The body is built as text;
   the prompt goes through jx.escape (multi-line prompts, MK6.13). The sidecar's URL is a
   parameter so a test can point the request at a recorder. *)
f=requestbody(prompt:str;threshold:f64):str{
  <"{\"prompt\":\(jx.escape(prompt)),\"threshold\":\(str.fromfloat(threshold))}"
};

f=queryat(url:str;prompt:str;threshold:f64):$routellmresult{
  let body=requestbody(prompt;threshold);
  (* reach.localpost, not http.post, which REGISTERS A SERVER ROUTE in std.http (see
     shared.reachability.localpost). The old call made this JSON body a route handler. *)
  let raw=reach.localpost(url;"/route";body);
  if(str.len(raw)==0){ <routellmunavailable() }el{};
  let obj=mt json.dec(raw) {
    $ok:o o;
    $jsonerr:e json.dec("{}")
  };
  let route=mt json.str(obj;"route") {$ok:v v; $jsonerr:e ""};
  if(str.len(route)==0){ <routellmparsefailed() }el{};
  let score=mt json.f64(obj;"score") {$ok:v v; $jsonerr:e 0.5};
  <$routellmresult{available:true;score:score;preferstrong:str.eq(route;"strong")}
};


f=isavailable():bool{
  (* reachability, not http.get: against a closed port http.get answers $ok (T-15), so
     this reported the sidecar available whenever it was down. *)
  <reach.localserviceup("http://localhost:11431")
};



f=defaultthreshold():f64{
  <0.3
};

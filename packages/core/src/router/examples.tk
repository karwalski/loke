m=core.router.examples;





i=vs:std.vecstore;
i=log:shared.log;
i=json:std.json;
i=str:std.str;
i=time:std.time;



t=$routingexample{
  promptsnippet:str;
  modelid:str;
  confirmedat:i64
};




f=open(datadir:str):i64{
  <vs.open(datadir)
};


f=collection(store:i64):i64{
  <vs.collection(store;"routing_examples")
};





f=addexample(col:i64;promptembedding:@f32;modelid:str;promptsnippet:str):bool{
  let now=time.nowunix();
  let payload=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("{\"model\":";json.quote(modelid));
            ",\"snippet\":");
          json.quote(promptsnippet));
        ",\"at\":");
      str.fromi64(now));
    "}");
  let id=str.randhex(16);
  <vs.upsert(col;id;promptembedding;payload)
};





f=findsimilar(col:i64;queryembedding:@f32;topk:i32):@$routingexample{
  let results=vs.search(col;queryembedding;topk;0.85);
  let examples=@();
  lp(let i=0;i<str.arraylen(results);i=i+1){ let r=str.arrayget(results;i);
    let parsed=json.decode(r.payload);
    mt parsed {
      $ok:p {
        let modelid=json.getstr(p;"model");
        let snippet=json.getstr(p;"snippet");
        let confirmedat=json.geti64(p;"at");
        let ex=$routingexample{
          promptsnippet:snippet;
          modelid:modelid;
          confirmedat:confirmedat
        };
        let examples=examples.append(ex)
      };
      $err:e {
        log.warn("examples: failed to parse routing example payload";"examples";"")
      }
    }
  };
  <examples
};





f=formatexamples(examples:@$routingexample):str{
  if(examples.len = 0){
    <"(no routing examples)"
  }el{
    let lines=@();
    lp(let i=0;i<str.arraylen(examples);i=i+1){ let ex=str.arrayget(examples;i);
      lines=lines.append(str.concat(
        str.concat(
          str.concat("(";ex.modelid);
          ") ");
        ex.promptsnippet))
    };
    <str.join(lines;"
")
  }
};

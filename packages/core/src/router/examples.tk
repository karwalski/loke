m=core.router.examples;





i=vs:std.vecstore;
i=log:shared.log;
i=json:std.json;
i=str:std.str;
i=time:std.time;



t=$routingexample{
  promptsnippet:str;
  modelid:str;
  confirmedat:i64
};




f=open(datadir:str):vs.$vecstore{
  <vs.open(datadir)
};


f=collection(store:vs.$vecstore):vs.$veccollection{
  <vs.collection(store;"routing_examples")
};





f=addexample(col:vs.$veccollection;promptembedding:@(f32);modelid:str;promptsnippet:str):bool{
  let now=time.nowunix();
  let payload=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("{\"model\":";json.quote(modelid));
            ",\"snippet\":");
          json.quote(promptsnippet));
        ",\"at\":");
      str.fromi64(now));
    "}");
  let id=str.randhex(16);
  <vs.upsert(col;id;promptembedding;payload)
};





f=findsimilar(col:vs.$veccollection;queryembedding:@(f32);topk:i32):@$routingexample{
  let results=vs.search(col;queryembedding;topk;0.85);
  let examples=@();
  results.each|r{
    let parsed=json.decode(r.payload);
    mt parsed {
      $ok:p {
        let modelid=json.getstr(p;"model");
        let snippet=json.getstr(p;"snippet");
        let confirmedat=json.geti64(p;"at");
        let ex=$routingexample{
          promptsnippet:snippet;
          modelid:modelid;
          confirmedat:confirmedat
        };
        let examples=examples.append(ex)
      };
      $err:e {
        log.warn("examples: failed to parse routing example payload";"examples";"")
      };
    };
  };
  <examples
};





f=formatexamples(examples:@$routingexample):str{
  if(examples.len == 0{
    <"(no routing examples)"
  }else{
    let lines=examples.map|ex{
      str.concat(
        str.concat(
          str.concat("(";ex.modelid);
          ") ");
        ex.promptsnippet)
    };
    <str.join(lines;"
")
  };
};

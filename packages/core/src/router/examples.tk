m=core.router.examples;





i=vs:std.vecstore;
i=log:shared.log;
i=json:std.json;
i=jx:shared.jsonobj;
i=str:std.str;
i=time:std.time;



t=$routingexample{
  promptsnippet:str;
  modelid:str;
  confirmedat:i64
};




f=open(datadir:str):i64{
  <vs.open(datadir)
};


f=collection(store:i64):i64{
  <vs.collection(store;"routing_examples")
};





f=addexample(col:i64;promptembedding:@f32;modelid:str;promptsnippet:str):bool{
  let now=time.nowunix();
  let payload=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat("{\"model\":";jx.escape(modelid));
            ",\"snippet\":");
          jx.escape(promptsnippet));
        ",\"at\":");
      str.fromi64(now));
    "}");
  let id=str.randhex(16);
  <vs.upsert(col;id;promptembedding;payload)
};





(* LS1.1w: typed reads of a typed $json. json.quote, json.geti64 and json.decode are
   std.json's untyped ABI helpers; jx.escape also escapes a control character in a snippet,
   which json.quote left raw. *)
f=parseexample(p:$json):$routingexample{
  let modelid=jx.strvalue(p;"model";"");
  let snippet=jx.strvalue(p;"snippet";"");
  let confirmedat=mt json.i64(p;"at") {$ok:v v;$jsonerr:e 0};
  <$routingexample{
    promptsnippet:snippet;
    modelid:modelid;
    confirmedat:confirmedat
  }
};

(* str.arrayget erases the element type of what it returns; .len / .get(i) are the typed
   accessors, and are what the rest of the repository uses. Same change as
   core.optimiser.profiler and core.optimiser.budget.new. *)
f=tryappendexample(examples:@$routingexample;p:$json):@$routingexample{
  <examples.append(parseexample(p))
};

f=logexampleparsefail(examples:@$routingexample):@$routingexample{
  log.warn("examples: failed to parse routing example payload";"examples";"");
  <examples
};

f=findsimilar(col:i64;queryembedding:@f32;topk:i32):@$routingexample{
  let results=vs.search(col;queryembedding;topk;0.85);
  let examples=mut.@();
  lp(let i=0;i<results.len;i=i+1){ let r=results.get(i);
    examples=mt json.dec(r.payload) {
      $ok:p tryappendexample(examples;p);
      $jsonerr:e logexampleparsefail(examples)
    }
  };
  <examples
};





f=formatexamples(examples:@$routingexample):str{
  if(examples.len == 0 as u64){
    <"(no routing examples)"
  }el{
    let lines=mut.@();
    lp(let i=0;i<examples.len;i=i+1){ let ex=examples.get(i);
      lines=lines.append(str.concat(
        str.concat(
          str.concat("(";ex.modelid);
          ") ");
        ex.promptsnippet))
    };
    <str.join("
";lines)
  }
};

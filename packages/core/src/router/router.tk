   SPDX-License-Identifier: Apache-2.0 *)

m=core.router.router;



i=intent:core.router.intent;
i=sens:core.router.sensitivity;
i=sel:core.router.selector;
i=strat:core.router.strategy;
i=reg:core.models.registry;
i=log:shared.log;
i=str:std.str;
i=t:shared.types;
i=lokecfg:shared.config;
i=settings:core.storage.settings;

t=$routerconfig{
  ollamaurl:str;
  preferlocal:bool;
  maxcostper1k:f64;
  defaulttolerance:$latencytolerance;
  strategy:$routingstrategy;
  fallbacktocloud:bool
};

(* F5.3. A fallback chain: the routed first choice and the candidates to try, in order, if
   it fails. chainsens is the sensitivity the router computed (the PII level combined with
   the content score), so every hop is judged against the same level as the first choice,
   and never against one a caller supplies. An empty chainhops means not routed, and
   chainnote says why. *)
t=$fallbackchain{
  chainhops:@$routingdecision;
  chainsens:$sensitivitylevel;
  chainnote:str
};

t=$router{
  config:$routerconfig;
  registry:i64
};



(* X8.6 — the default strategy is local-first, which is what README.md and
   packages/cli/src/commands.tk already say loke is.

   It is also the choice that changes nothing measurable: newconfig sets preferlocal:true,
   so the candidate pool is already local-only, and local-first and best-quality rank an
   all-local pool identically — both fall through to highest qualityscore. Verified against
   the routing this session already observed, routerequest -> qwen2.5:7b.

   newconfigwith is for a caller that wants one of the other three. *)
f=newconfig(ollamaurl:str):$routerconfig{
  <newconfigwith(ollamaurl;strat.localfirst())
};

f=newconfigwith(ollamaurl:str;strategy:$routingstrategy):$routerconfig{
  <newconfigfull(ollamaurl;true;0.05;strategy)
};

(* preferlocal and maxcostper1k were reachable only through the two defaults above, so a
   caller that wanted cloud-eligible routing, or a tighter cost ceiling, had to construct
   $routerconfig by hand.

   preferlocal:false does NOT make a RESTRICTED request cloud-eligible. The sensitivity gate
   in core.router.selector.selectmodelwith forces local-only regardless, and routerequest
   re-checks the resulting decision. preferlocal is a preference; RESTRICTED is a rule. *)
f=newconfigfull(ollamaurl:str;preferlocal:bool;maxcostper1k:f64;strategy:$routingstrategy):$routerconfig{
  <$routerconfig{
    ollamaurl:ollamaurl;
    preferlocal:preferlocal;
    maxcostper1k:maxcostper1k;
    defaulttolerance:$instant(0);
    strategy:strategy;
    fallbacktocloud:false
  }
};

(* F5.3. Whether a fallback chain whose first choice was LOCAL may go on to a cloud model.
   Off unless the operator turns it on: that hop changes where the prompt goes, so it is not
   taken because Ollama happened to be down. It never admits RESTRICTED data (hopallowed). *)
f=withcloudfallback(c:$routerconfig;allow:bool):$routerconfig{
  <$routerconfig{
    ollamaurl:c.ollamaurl;
    preferlocal:c.preferlocal;
    maxcostper1k:c.maxcostper1k;
    defaulttolerance:c.defaulttolerance;
    strategy:c.strategy;
    fallbacktocloud:allow
  }
};

(* F5.3. The strategy a configuration names. Unlike strat.strategyfromname, an empty or
   unrecognised name is the default, local-first, not best-quality: a typo in a setting
   should leave routing as it was, and local-first is what it was. *)
f=configstrategy(name:str):$routingstrategy{
  if(strat.isstrategyname(name)){ <strat.strategyfromname(name) }el{};
  if(str.len(name)>0){
    log.warn("router: routing strategy \"\(name)\" is not one of cheapest-adequate, fastest, best-quality, local-first; using local-first";"router";"")
  }el{};
  <strat.localfirst()
};

(* F5.3. The one place a routing configuration is built from settings, whichever file they
   came from: configfor reads config.toml's [routing] table (the CLI), configfromsettings
   the settings store (the browser request path). *)
f=namedconfig(ollamaurl:str;strategyname:str;preferlocal:bool;fallbacktocloud:bool):$routerconfig{
  <withcloudfallback(newconfigfull(ollamaurl;preferlocal;0.05;configstrategy(strategyname));fallbacktocloud)
};

f=configfor(c:$lokeconfig):$routerconfig{
  <namedconfig(c.ollamaurl;c.routingstrategy;c.routingpreferlocal;c.routingfallbacktocloud)
};

(* The settings key routing.strategy, for the browser request path. Only the strategy:
   prefer_local stays on and fallback_to_cloud off there, because a strategy chooses
   between the models already permitted, and those two would change WHICH destinations are
   permitted on a path that has no user interface for them. A store that could not be
   opened gives the defaults, the same routing as newconfig. *)
f=configfromsettings(store:i64;ollamaurl:str):$routerconfig{
  if(store==0){ <newconfig(ollamaurl) }el{};
  <namedconfig(ollamaurl;settings.getstror(store;"routing.strategy";"local-first");true;false)
};


f=new(config:$routerconfig):$router{
  let registry=reg.newregistry();
  <$router{config:config;registry:registry}
};


(* F5.12. Routes against the models Ollama reports as installed, and keeps that route only
   if it chose a LOCAL model. Anything else is routed exactly as before, against the full
   catalogue. So knowing what is installed can change WHICH local model is chosen, and never
   whether a request goes to the cloud. Filtering alone would have done that: with no
   installed model fit for a task, a CONFIDENTIAL request would have fallen through to the
   selector's cloud fallback where it is refused today. An empty list means the install
   state is unknown (Ollama down), and routes as before. *)
f=routepreferinstalled(
  rtr:$router;
  installed:@str;
  text:str;
  piisensitivity:$sensitivitylevel;
  piientitycount:u32;
  tolerance:$latencytolerance;
  cid:str
):$routingdecision{
  if(installed.len>0){
    let narrowed=$router{config:rtr.config;registry:reg.installedonly(rtr.registry;installed)};
    let first=routerequest(narrowed;text;piisensitivity;piientitycount;tolerance;cid);
    if(isrouted(first) && !isclouddecision(first)){ <first }el{}
  }el{};
  <routerequest(rtr;text;piisensitivity;piientitycount;tolerance;cid)
};

f=tasktostr(task:$tasktype):str{
  <mt task {
    $chat:v           "chat";
    $codegeneration:v "code_generation";
    $codereview:v    "code_review";
    $summarisation:v  "summarisation";
    $classification:v "classification";
    $ner:v            "ner";
    $embedding:v      "embedding";
    $dataanalysis:v  "data_analysis"
  }
};


f=providerfromstr(s:str):$provider{
  if(str.eq(s;"anthropic")){
    <$provider{$anthropic:0}
  }el{
    if(str.eq(s;"openai")){
      <$provider{$openai:0}
    }el{
      if(str.eq(s;"google")){
        <$provider{$google:0}
      }el{
        if(str.eq(s;"mistral")){
          <$provider{$mistral:0}
        }el{
          if(str.eq(s;"openrouter")){
            <$provider{$openrouter:0}
          }el{
            if(str.eq(s;"ollama")){
              <$provider{$ollama:0}
            }el{
              <$provider{$local:0}
            }
          }
        }
      }
    }
  }
};


(* F5.11b. Context windows and rates for the Anthropic models are Anthropic's published
   figures (models overview and pricing pages, read 2026-09-27): Claude Sonnet 5 has a 1M
   window at $2 / $10 per million tokens in / out, Claude Haiku 4.5 200K at $1 / $5. Every
   other Claude id keeps the 200K it always had. The OpenAI figures are unchanged and were
   not re-checked; core.providers.openai prices gpt-4o at $2.50 / $10, not the $5 / $15
   used here. *)
f=ctxfrommodel(modelid:str):u32{
  if(str.contains(modelid;"claude-sonnet-5")){ <1000000 as u32 }el{};
  if(str.contains(modelid;"claude")){
    <200000 as u32
  }el{
    if(str.contains(modelid;"gpt-4o")){
      <128000 as u32
    }el{
      if(str.contains(modelid;"qwen2.5:72b")){
        <128000 as u32
      }el{
        if(str.contains(modelid;"qwen2.5:7b")){
          <32000 as u32
        }el{
          if(str.contains(modelid;"gemma3")){
            <8000 as u32
          }el{
            if(str.contains(modelid;"nomic-embed")){
              <8000 as u32
            }el{
              <32000 as u32
            }
          }
        }
      }
    }
  }
};


f=costinfrommodel(modelid:str):f64{
  if(str.contains(modelid;"claude-sonnet-5")){
    <0.002
  }el{
    if(str.contains(modelid;"claude-haiku-4-5")){
      <0.001
    }el{
      if(str.contains(modelid;"gpt-4o-mini")){
        <0.00015
      }el{
        if(str.contains(modelid;"gpt-4o")){
          <0.005
        }el{
          <0.0
        }
      }
    }
  }
};


f=costoutfrommodel(modelid:str):f64{
  if(str.contains(modelid;"claude-sonnet-5")){
    <0.010
  }el{
    if(str.contains(modelid;"claude-haiku-4-5")){
      <0.005
    }el{
      if(str.contains(modelid;"gpt-4o-mini")){
        <0.0006
      }el{
        if(str.contains(modelid;"gpt-4o")){
          <0.015
        }el{
          <0.0
        }
      }
    }
  }
};


f=specfromresult(result:$selectionresult):$modelspec{
  let provider=providerfromstr(result.provider);
  let ctx=ctxfrommodel(result.modelid);
  let costin=costinfrommodel(result.modelid);
  let costout=costoutfrommodel(result.modelid);
  <$modelspec{
    id:result.modelid;
    provider:provider;
    contextwindow:ctx;
    costper1kinput:costin;
    costper1koutput:costout;
    tier:result.tier
  }
};


f=estimatelatency(result:$selectionresult):u32{
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let tierv:$modeltier=result.tier;
  <mt tierv {
    $interactive:v 500 as u32;
    $considered:v  3000 as u32;
    $background:v  15000 as u32
  }
};







(* LS1.1j — routerequest is the form a caller can trust. route could never be, and
   until this change it did not merely mislead: it crashed.

   The old body read

     let result:$selectionresult=mt selected {
       $lokeerr:e $err($modelerr("router: model selection failed"));
       $ok:result result
     };

   and toke takes the FIRST arm of a match on a result whose error side is a
   user-declared sum, whatever the value is (T-18). So `result` was bound to the
   $err(...) value on EVERY call, success included, and the very next line —
   specfromresult(result), which reads result.provider — dereferenced a $lokeerr sum as a
   $selectionresult struct. Reproduced this session: router.route segfaults
   unconditionally, for every input. Note also that the $err in that arm was an
   expression assigned to a $selectionresult binding, not an early return, so even with
   T-18 fixed the failure path would have built a decision out of it.

   routerequest answers with a plain $routingdecision. An empty model id means "not
   routed" — tested with isrouted — and the reason field carries the message. Nothing
   downstream has to match on a value it cannot discriminate, which is what GA1.5 to
   GA1.7 were waiting for. *)
f=noroute(reason:str):$routingdecision{
  <$routingdecision{
    model:$modelspec{
      id:"";
      provider:$provider{$local:0};
      contextwindow:0 as u32;
      costper1kinput:0.0;
      costper1koutput:0.0;
      tier:$modeltier{$interactive:0}
    };
    reason:reason;
    tier:$modeltier{$interactive:0};
    estimatedcost:0.0;
    estimatedlatencyms:0 as u32
  }
};

(* The declared type on the intermediate is load-bearing for the same reason it is in
   estimatelatency above: the field name is ambiguous across structs without it. *)
f=isrouted(d:$routingdecision):bool{
  let spec:$modelspec=d.model;
  <str.len(spec.id)>0
};

(* GA1.7 — the route-level half of the safety property.

   core.router.selector refuses a RESTRICTED request that no local model can serve, and
   tests/unit/router/test_selection_outcome.tk asserts that refusal at the selector. This is
   the same property asserted again at the layer that matters, because this is the value a
   provider call is actually made from: whatever a strategy, a config, a cloud-fallback path
   or a future edit to the selector does, a decision naming a cloud provider for RESTRICTED
   data does not leave this function.

   It is deliberately a second, independent check rather than trust in the first one. The
   privacy invariant in CLAUDE.md is a contributor invariant enforced by review; this is the
   one place in the routing path where it can be enforced by the machine, and the cost of
   enforcing it twice is one comparison. *)
f=iscloudprovider(p:$provider):bool{
  <mt p {
    $anthropic:v true;
    $openai:v true;
    $google:v true;
    $mistral:v true;
    $openrouter:v true;
    $ollama:v false;
    $local:v false
  }
};

f=isclouddecision(d:$routingdecision):bool{
  let spec:$modelspec=d.model;
  <iscloudprovider(spec.provider)
};

f=routerequest(
  rtr:$router;
  text:str;
  piisensitivity:$sensitivitylevel;
  piientitycount:u32;
  tolerance:$latencytolerance;
  cid:str
):$routingdecision{

  let intentresult=intent.classify(text;rtr.config.ollamaurl);
  let taskstr=tasktostr(intentresult.task);
  let confstr=str.fromfloat(intentresult.confidence);
  let intentmsg=str.concat(str.concat(str.concat("intent: ";taskstr);" confidence=");confstr);
  log.info(intentmsg;"router";cid);


  let piiscored=sens.scorefrompii(piisensitivity;piientitycount);
  let contentscored=sens.scorefromcontent(text);
  let finalsensitivity=sens.combine(piiscored;contentscored);
  let sensstr=sens.leveltostr(finalsensitivity);
  let sensmsg=str.concat("sensitivity: ";sensstr);
  log.info(sensmsg;"router";cid);

  (* F5.11c. Whatever the intent, this routes a prompt that will be sent as a chat
     completion, and only an embedding model is declared for $embedding (nomic-embed-text),
     which cannot answer one. "Rank these by similarity" is a question for a chat model, so
     an embedding intent is routed as chat. Constructed here rather than returned from a
     helper: a returned sum does not compare equal to a constructed one (T-14), and
     core.models.registry.findfortask compares tasks with ==. *)
  let task=mut.intentresult.task;
  if(str.eq(taskstr;"embedding")){
    task=$tasktype{$chat:0};
    log.info("route: an embedding intent is routed as chat, because the request is a completion";"router";cid)
  }el{};
  <routedecided(rtr;task;finalsensitivity;tolerance;cid)
};

(* The selection and the route-level safety check, for a task and a sensitivity already
   worked out. routerequest calls it once; routechain calls it once per hop, so every
   fallback hop passes the same selector rules and the same RESTRICTED check as the first
   choice. *)
f=routedecided(
  rtr:$router;
  task:$tasktype;
  finalsensitivity:$sensitivitylevel;
  tolerance:$latencytolerance;
  cid:str
):$routingdecision{
  (* The annotation is load-bearing: rtr.config.preferlocal loses the middle
     type and the field name is ambiguous across structs without it. *)
  let cfg:$routerconfig=rtr.config;
  let criteria=$selectioncriteria{
    task:task;
    sensitivity:finalsensitivity;
    tolerance:tolerance;
    preferlocal:cfg.preferlocal;
    maxcostper1k:cfg.maxcostper1k;
    requiretools:false
  };


  let selected=sel.selectmodelwith(criteria;rtr.registry;cfg.strategy);
  if(sel.isselected(selected)){}el{
    log.warn(str.concat("route: no model selected — ";selected.reason);"router";cid);
    <noroute(selected.reason)
  };
  let result:$selectionresult=selected;
  let modelspec=specfromresult(result);
  let latency=estimatelatency(result);
  let decision=$routingdecision{
    model:modelspec;
    reason:result.reason;
    tier:result.tier;
    estimatedcost:result.estimatedcost;
    estimatedlatencyms:latency
  };

  (* The route-level safety check. senseq, not ==, because finalsensitivity came out of
     sens.combine and a returned sum does not compare equal to a locally constructed one
     (T-14). *)
  if(t.senseq(finalsensitivity;t.restricted())){
    if(isclouddecision(decision)){
      log.error(str.concat("route: REFUSED — RESTRICTED request selected cloud provider ";result.provider);"router";cid);
      <noroute(str.concat("router: RESTRICTED data must not be routed to a cloud provider (selection named ";str.concat(result.provider;")")))
    }el{}
  }el{};

  let routemsg=str.concat(str.concat(str.concat("route: selected ";result.modelid);" via ");result.provider);
  log.info(routemsg;"router";cid);
  <decision
};

(* F5.3 — whether a fallback hop may be tried, judged on its own and not inherited from the
   first choice. It is the check a hop must pass when the chain is built AND again
   immediately before it is dispatched (core.router.fallback.dispatchchain), because the
   dispatch side is where a hop would leak.

   A local hop is always allowed: it does not change where the prompt goes. A cloud hop is
   refused for RESTRICTED data, by the same rule routedecided applies to a first choice
   (senseq for T-14, and sens.canusecloud as the second, independent reading of the level),
   and refused when the first choice was local and the operator has not turned on
   routing.fallback_to_cloud. *)
f=hopallowed(cfg:$routerconfig;firstlocal:bool;hop:$routingdecision;sensitivity:$sensitivitylevel):bool{
  if(isrouted(hop)){}el{ <false };
  if(isclouddecision(hop)){}el{ <true };
  if(t.senseq(sensitivity;t.restricted())){ <false }el{};
  if(sens.canusecloud(sensitivity)){}el{ <false };
  if(firstlocal && !cfg.fallbacktocloud){ <false }el{};
  <true
};

(* F5.3 — the fallback chain. The first hop is exactly what routerequest returns for the
   same input. Each further hop is the selector's answer for the same task, sensitivity,
   tolerance, strategy and configuration with every model already considered removed from
   the catalogue (reg.excluding), so the order is the strategy's order and the rules are the
   first choice's rules; no second ranking is kept here. A hop hopallowed refuses is left
   out and the search goes on past it. maxhops counts the first choice; the search looks at
   no more than eight further candidates whatever it is.

   The intent is classified once, not once per hop. *)
f=routechain(
  rtr:$router;
  text:str;
  piisensitivity:$sensitivitylevel;
  piientitycount:u32;
  tolerance:$latencytolerance;
  cid:str;
  maxhops:i64
):$fallbackchain{
  let intentresult=intent.classify(text;rtr.config.ollamaurl);
  let taskstr=tasktostr(intentresult.task);
  let finalsensitivity=sens.combine(sens.scorefrompii(piisensitivity;piientitycount);sens.scorefromcontent(text));
  log.info("route chain: intent \(taskstr), sensitivity \(sens.leveltostr(finalsensitivity))";"router";cid);
  let task=mut.intentresult.task;
  if(str.eq(taskstr;"embedding")){ task=$tasktype{$chat:0} }el{};

  let first=routedecided(rtr;task;finalsensitivity;tolerance;cid);
  if(isrouted(first)){}el{
    <$fallbackchain{chainhops:@();chainsens:finalsensitivity;chainnote:first.reason}
  };
  let cfg:$routerconfig=rtr.config;
  let firstspec:$modelspec=first.model;
  let firstlocal=!isclouddecision(first);
  let hops=mut.@();
  hops=hops.push(first);
  let seen=mut.@();
  seen=seen.push(firstspec.id);
  let done=mut.false;
  lp(let k=0;k<8 && !done && (hops.len as i64)<maxhops;k=k+1){
    let next=routedecided($router{config:cfg;registry:reg.excluding(rtr.registry;seen)};task;finalsensitivity;tolerance;cid);
    if(isrouted(next)){
      let nspec:$modelspec=next.model;
      seen=seen.push(nspec.id);
      if(hopallowed(cfg;firstlocal;next;finalsensitivity)){
        hops=hops.push(next)
      }el{
        log.info("route chain: \(nspec.id) is not a permitted fallback for this request";"router";cid)
      }
    }el{
      done=true
    }
  };
  <$fallbackchain{chainhops:hops;chainsens:finalsensitivity;chainnote:first.reason}
};

(* F5.3a. routechain against the models Ollama reports as installed, kept only if its first
   choice is LOCAL, exactly as routepreferinstalled keeps a single route: knowing what is
   installed can change which local models the chain holds, never whether it goes to the
   cloud. An empty list means the install state is unknown, and routes as routechain does. *)
f=routechainpreferinstalled(
  rtr:$router;
  installed:@str;
  text:str;
  piisensitivity:$sensitivitylevel;
  piientitycount:u32;
  tolerance:$latencytolerance;
  cid:str;
  maxhops:i64
):$fallbackchain{
  if(installed.len>0){
    let first=routechain($router{config:rtr.config;registry:reg.installedonly(rtr.registry;installed)};text;piisensitivity;piientitycount;tolerance;cid;maxhops);
    if(first.chainhops.len>0){
      if(!isclouddecision(first.chainhops.get(0))){ <first }el{}
    }el{}
  }el{};
  <routechain(rtr;text;piisensitivity;piientitycount;tolerance;cid;maxhops)
};

(* F5.3a. Whether hop i of a chain may be sent: hopallowed, with the first choice and the
   sensitivity taken from the chain itself, never from a caller. This is the one gate both
   dispatchers of a chain ask immediately before each send: core.router.fallback.dispatchchain
   (`loke ask`) and page.api.pipeline (the browser request path). A hop past the end is not
   allowed. *)
f=chainhopallowed(cfg:$routerconfig;chain:$fallbackchain;i:i64):bool{
  if(i<0 || i>=(chain.chainhops.len as i64)){ <false }el{};
  <hopallowed(cfg;!isclouddecision(chain.chainhops.get(0));chain.chainhops.get(i);chain.chainsens)
};

f=providerstr(p:$provider):str{
  <mt p {
    $anthropic:v "anthropic";
    $openai:v "openai";
    $google:v "google";
    $mistral:v "mistral";
    $openrouter:v "openrouter";
    $ollama:v "ollama";
    $local:v "local"
  }
};

(* A hop as `provider:model`, the label both dispatchers report hops by. *)
f=hoplabel(d:$routingdecision):str{
  let spec:$modelspec=d.model;
  <"\(providerstr(spec.provider)):\(spec.id)"
};

(* F5.3a. Whether two decisions send to the same place: both local (this machine), or the
   same cloud provider. A different model at the same provider is the same destination. *)
f=samedestination(a:$routingdecision;b:$routingdecision):bool{
  let ca=isclouddecision(a);
  if(ca!=isclouddecision(b)){ <false }el{};
  if(!ca){ <true }el{};
  let sa:$modelspec=a.model;
  let pa=providerstr(sa.provider);
  let sb:$modelspec=b.model;
  <str.eq(pa;providerstr(sb.provider))
};

(* LS1.1j, completed 2026-09-27 — route, the $routingdecision!$lokeerr wrapper over
   routerequest, is gone. Its last caller, packages/cli/src/ask.tk, now calls routerequest
   and refuses to dispatch unless isrouted holds. A result signature here could only ever
   hand back an outcome its caller cannot discriminate (T-18). *)

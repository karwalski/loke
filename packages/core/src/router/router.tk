m=core.router.router;



i=t:shared.types;
i=intent:core.router.intent;
i=sens:core.router.sensitivity;
i=sel:core.router.selector;
i=reg:core.models.registry;
i=log:shared.log;
i=str:std.str;

t=$routerconfig{
  ollamaurl:str;
  preferlocal:bool;
  maxcostper1k:f64;
  defaulttolerance:$latencytolerance
};

t=$router{
  config:$routerconfig;
  registry:i64
};



f=newconfig(ollamaurl:str):$routerconfig{
  <$routerconfig{
    ollamaurl:ollamaurl;
    preferlocal:true;
    maxcostper1k:0.05;
    defaulttolerance:$instant(0)
  }
};


f=new(config:$routerconfig):$router{
  let registry=reg.newregistry();
  <$router{config:config;registry:registry}
};


f=tasktostr(task:$tasktype):str{
  mt task {
    $chat:v           "chat";
    $codegeneration:v "code_generation";
    $codereview:v    "code_review";
    $summarisation:v  "summarisation";
    $classification:v "classification";
    $ner:v            "ner";
    $embedding:v      "embedding";
    $dataanalysis:v  "data_analysis"
  }
};


f=providerfromstr(s:str):$provider{
  if(str.eq(s;"anthropic")){
    <$anthropic
  }el{
    if(str.eq(s;"openai")){
      <$openai
    }el{
      if(str.eq(s;"google")){
        <$google
      }el{
        if(str.eq(s;"mistral")){
          <$mistral
        }el{
          if(str.eq(s;"openrouter")){
            <$openrouter
          }el{
            if(str.eq(s;"ollama")){
              <$ollama
            }el{
              <$local
            }
          }
        }
      }
    }
  }
};


f=ctxfrommodel(modelid:str):u32{
  if(str.contains(modelid;"claude")){
    <200000 as u32
  }el{
    if(str.contains(modelid;"gpt-4o")){
      <128000 as u32
    }el{
      if(str.contains(modelid;"qwen2.5:72b")){
        <128000 as u32
      }el{
        if(str.contains(modelid;"qwen2.5:7b")){
          <32000 as u32
        }el{
          if(str.contains(modelid;"gemma3")){
            <8000 as u32
          }el{
            if(str.contains(modelid;"nomic-embed")){
              <8000 as u32
            }el{
              <32000 as u32
            }
          }
        }
      }
    }
  }
};


f=costinfrommodel(modelid:str):f64{
  if(str.contains(modelid;"claude-3-5-sonnet")){
    <0.003
  }el{
    if(str.contains(modelid;"claude-3-5-haiku")){
      <0.001
    }el{
      if(str.contains(modelid;"gpt-4o-mini")){
        <0.00015
      }el{
        if(str.contains(modelid;"gpt-4o")){
          <0.005
        }el{
          <0.0
        }
      }
    }
  }
};


f=costoutfrommodel(modelid:str):f64{
  if(str.contains(modelid;"claude-3-5-sonnet")){
    <0.015
  }el{
    if(str.contains(modelid;"claude-3-5-haiku")){
      <0.005
    }el{
      if(str.contains(modelid;"gpt-4o-mini")){
        <0.0006
      }el{
        if(str.contains(modelid;"gpt-4o")){
          <0.015
        }el{
          <0.0
        }
      }
    }
  }
};


f=specfromresult(result:i64):$modelspec{
  let provider=providerfromstr(result.provider);
  let ctx=ctxfrommodel(result.modelid);
  let costin=costinfrommodel(result.modelid);
  let costout=costoutfrommodel(result.modelid);
  <$modelspec{
    id:result.modelid;
    provider:provider;
    contextwindow:ctx;
    costper1kinput:costin;
    costper1koutput:costout;
    tier:result.tier
  }
};


f=estimatelatency(result:i64):u32{
  mt result.tier {
    $interactive:v 500;
    $considered:v  3000;
    $background:v  15000
  }
};







f=route(
  router:$router;
  text:str;
  piisensitivity:$sensitivitylevel;
  piientitycount:u32;
  tolerance:$latencytolerance;
  cid:str
):$routingdecision!$lokeerr{
  
  let intentresult=intent.classify(text;router.config.ollamaurl);
  let taskstr=tasktostr(intentresult.task);
  let confstr=str.fromfloat(intentresult.confidence);
  let intentmsg=str.concat(str.concat(str.concat("intent: ";taskstr);" confidence=");confstr);
  log.info(intentmsg;"router";cid);

  
  let piiscored=sens.scorefrompii(piisensitivity;piientitycount);
  let contentscored=sens.scorefromcontent(text);
  let finalsensitivity=sens.combine(piiscored;contentscored);
  let sensstr=sens.leveltostr(finalsensitivity);
  let sensmsg=str.concat("sensitivity: ";sensstr);
  log.info(sensmsg;"router";cid);

  
  let criteria=$selectioncriteria{
    task:intentresult.task;
    sensitivity:finalsensitivity;
    tolerance:tolerance;
    preferlocal:router.config.preferlocal;
    maxcostper1k:router.config.maxcostper1k;
    requiretools:false
  };

  
  let selected=sel.select(criteria;router.registry);
  let result=mt selected {
    $lokeerr:e $err($modelerr("router: model selection failed"));
    $ok:result result
  };
  let modelspec=specfromresult(result);
  let latency=estimatelatency(result);
  let decision=$routingdecision{
    model:modelspec;
    reason:result.reason;
    tier:result.tier;
    estimatedcost:result.estimatedcost;
    estimatedlatencyms:latency
  };
  let routemsg=str.concat(str.concat(str.concat("route: selected ";result.modelid);" via ");result.provider);
  log.info(routemsg;"router";cid);
  <decision
};

  };
};





f=classify(text:str;ollamaurl:str):$intentresult{
  let fast=classifyfast(text);
  if(fast.confidence >= 0.80{
    <fast
  }else{
    let chaturl=str.concat(ollamaurl;"/api/chat");
    let systemmsg="Classify the intent as one of: chat, code_generation, code_review, summarisation, classification, ner, embedding, data_analysis. Reply with just the category name.";
    let body=json.enc({
      model:"qwen2.5:7b";
      stream:false;
      messages:@(
        {role:"system";content:systemmsg};
        {role:"user";content:text};
      )
    });
    let resp=http.post(chaturl;body;"application/json");
    mt resp {
      $httErr:e e;
        <fast
      raw;
        let parsed=json.dec(raw);
        mt parsed {
          $jsonerr e;
            <fast
          obj;
            
            let msgraw=json.getstr(obj;"message");
            let msgparsed=json.dec(msgraw);
            mt msgparsed {
              $jsonerr e;
                <fast
              msgobj;
                let content=json.getstr(msgobj;"content");
                let task=taskfromstr(content);
                <$intentresult{task:task;confidence:0.72;method:"llm"};
            };
        };
    };
  };
};

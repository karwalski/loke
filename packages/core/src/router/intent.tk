m=core.router.intent;




i=str:std.str;
i=http:std.http;
i=json:std.json;
i=t:shared.types;
i=reg:core.models.registry;
i=log:shared.log;

t=$intentresult{
  task:$tasktype;
  confidence:f64;
  method:str
};



f=taskfromstr(s:str):$tasktype{
  if(str.eq(s;"code_generation")){
    <$tasktype{$codegeneration:0}
  }el{
    if(str.eq(s;"code_review")){
      <$tasktype{$codereview:0}
    }el{
      if(str.eq(s;"summarisation")){
        <$tasktype{$summarisation:0}
      }el{
        if(str.eq(s;"classification")){
          <$tasktype{$classification:0}
        }el{
          if(str.eq(s;"ner")){
            <$tasktype{$ner:0}
          }el{
            if(str.eq(s;"embedding")){
              <$tasktype{$embedding:0}
            }el{
              if(str.eq(s;"data_analysis")){
                <$tasktype{$dataanalysis:0}
              }el{
                <$tasktype{$chat:0}
              }
            }
          }
        }
      }
    }
  }
};



f=classifyfast(text:str):$intentresult{
  
  if(str.contains(text;"embed")){
    <$intentresult{task:$tasktype{$embedding:0};confidence:0.90;method:"keyword"}
  }el{
    if(str.contains(text;"embedding")){
      <$intentresult{task:$tasktype{$embedding:0};confidence:0.90;method:"keyword"}
    }el{
      if(str.contains(text;"vector")){
        <$intentresult{task:$tasktype{$embedding:0};confidence:0.90;method:"keyword"}
      }el{
        if(str.contains(text;"similarity")){
          <$intentresult{task:$tasktype{$embedding:0};confidence:0.90;method:"keyword"}
        }el{
          
          if(str.contains(text;"summarise")){
            <$intentresult{task:$tasktype{$summarisation:0};confidence:0.85;method:"keyword"}
          }el{
            if(str.contains(text;"summarize")){
              <$intentresult{task:$tasktype{$summarisation:0};confidence:0.85;method:"keyword"}
            }el{
              if(str.contains(text;"tldr")){
                <$intentresult{task:$tasktype{$summarisation:0};confidence:0.85;method:"keyword"}
              }el{
                if(str.contains(text;"summary")){
                  <$intentresult{task:$tasktype{$summarisation:0};confidence:0.85;method:"keyword"}
                }el{
                  if(str.contains(text;"brief")){
                    <$intentresult{task:$tasktype{$summarisation:0};confidence:0.85;method:"keyword"}
                  }el{
                    
                    if(str.contains(text;"categorise")){
                      <$intentresult{task:$tasktype{$classification:0};confidence:0.82;method:"keyword"}
                    }el{
                      if(str.contains(text;"categorize")){
                        <$intentresult{task:$tasktype{$classification:0};confidence:0.82;method:"keyword"}
                      }el{
                        if(str.contains(text;"classify")){
                          <$intentresult{task:$tasktype{$classification:0};confidence:0.82;method:"keyword"}
                        }el{
                          if(str.contains(text;"label")){
                            <$intentresult{task:$tasktype{$classification:0};confidence:0.82;method:"keyword"}
                          }el{
                            if(str.contains(text;"which category")){
                              <$intentresult{task:$tasktype{$classification:0};confidence:0.82;method:"keyword"}
                            }el{
                              
                              let hasreview=str.contains(text;"review");
                              let hascheckcode=str.contains(text;"check my code");
                              let haslook=str.contains(text;"look at this");
                              let hascodeword=str.contains(text;"code");
                              let hasfnword=str.contains(text;"function");
                              let hasclassword=str.contains(text;"class");
                              let reviewtrigger=mut.haslook;
                              if(hasreview){reviewtrigger=true}el{if(hascheckcode){reviewtrigger=true}el{}};
                              let codesignal=mut.hasclassword;
                              if(hascodeword){codesignal=true}el{if(hasfnword){codesignal=true}el{}};
                              if(reviewtrigger){
                                if(codesignal){
                                  <$intentresult{task:$tasktype{$codereview:0};confidence:0.78;method:"keyword"}
                                }el{
                                  
                                  if(str.contains(text;"code")){
                                    <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                  }el{
                                    if(str.contains(text;"function")){
                                      <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                    }el{
                                      if(str.contains(text;"class")){
                                        <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                      }el{
                                        if(str.contains(text;"def ")){
                                          <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                        }el{
                                          if(str.contains(text;"implement")){
                                            <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                          }el{
                                            if(str.contains(text;"refactor")){
                                              <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                            }el{
                                              if(str.contains(text;"debug")){
                                                <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                              }el{
                                                if(str.contains(text;"fix the")){
                                                  <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                                }el{
                                                  
                                                  if(str.contains(text;"analyse")){
                                                    <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                  }el{
                                                    if(str.contains(text;"analyze")){
                                                      <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                    }el{
                                                      if(str.contains(text;"data")){
                                                        <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                      }el{
                                                        if(str.contains(text;"csv")){
                                                          <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                        }el{
                                                          if(str.contains(text;"chart")){
                                                            <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                          }el{
                                                            if(str.contains(text;"trend")){
                                                              <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                            }el{
                                                              if(str.contains(text;"distribution")){
                                                                <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                              }el{
                                                                
                                                                if(str.contains(text;"who is")){
                                                                  <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                                }el{
                                                                  if(str.contains(text;"what is")){
                                                                    <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                                  }el{
                                                                    if(str.contains(text;"find the name")){
                                                                      <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                                    }el{
                                                                      if(str.contains(text;"identify")){
                                                                        <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                                      }el{
                                                                        
                                                                        <$intentresult{task:$tasktype{$chat:0};confidence:0.60;method:"keyword"}
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }el{
                                
                                if(str.contains(text;"code")){
                                  <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                }el{
                                  if(str.contains(text;"function")){
                                    <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                  }el{
                                    if(str.contains(text;"class")){
                                      <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                    }el{
                                      if(str.contains(text;"def ")){
                                        <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                      }el{
                                        if(str.contains(text;"implement")){
                                          <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                        }el{
                                          if(str.contains(text;"refactor")){
                                            <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                          }el{
                                            if(str.contains(text;"debug")){
                                              <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                            }el{
                                              if(str.contains(text;"fix the")){
                                                <$intentresult{task:$tasktype{$codegeneration:0};confidence:0.80;method:"keyword"}
                                              }el{
                                                
                                                if(str.contains(text;"analyse")){
                                                  <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                }el{
                                                  if(str.contains(text;"analyze")){
                                                    <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                  }el{
                                                    if(str.contains(text;"data")){
                                                      <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                    }el{
                                                      if(str.contains(text;"csv")){
                                                        <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                      }el{
                                                        if(str.contains(text;"chart")){
                                                          <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                        }el{
                                                          if(str.contains(text;"trend")){
                                                            <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                          }el{
                                                            if(str.contains(text;"distribution")){
                                                              <$intentresult{task:$tasktype{$dataanalysis:0};confidence:0.78;method:"keyword"}
                                                            }el{
                                                              
                                                              if(str.contains(text;"who is")){
                                                                <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                              }el{
                                                                if(str.contains(text;"what is")){
                                                                  <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                                }el{
                                                                  if(str.contains(text;"find the name")){
                                                                    <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                                  }el{
                                                                    if(str.contains(text;"identify")){
                                                                      <$intentresult{task:$tasktype{$ner:0};confidence:0.70;method:"keyword"}
                                                                    }el{
                                                                      
                                                                      <$intentresult{task:$tasktype{$chat:0};confidence:0.60;method:"keyword"}
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};





(* Four defects, stacked, and together they made an unreachable classifier look like a
   confident one.

   1. A stdlib result's `mt` arms bind BY POSITION, not by label. Measured directly this
      session with no loke module involved:

        f=okfirst(raw:str):i64{  <mt json.dec(raw) { $ok:o 1; $jsonerr:e 2 } };
        f=errfirst(raw:str):i64{ <mt json.dec(raw) { $jsonerr:e 2; $ok:o 1 } };

          okfirst(valid)  -> ok arm     okfirst(invalid)  -> err arm     correct
          errfirst(valid) -> ERR arm    errfirst(invalid) -> OK arm      INVERTED

      All three matches here were written error-arm-first, so the failure path ran the
      success code and the success path threw the LLM answer away. $ok is written first
      throughout now. This is the wider form of T-18: T-18 says the error arm of a
      USER-declared result is dead; this says a STDLIB result discriminates only when $ok
      comes first.

   2. `$ok:raw raw` bound the whole $httpresp and the next line called json.dec on it. The
      body is str.frombytes(r.body), which is how browser.pages.api.pipeline reads one.

   3. The request body was built with `json.enc($jsonobj{...})`. $jsonobj is declared in no
      module in this repository, and json.enc takes a str. Measured: that expression returns
      a string containing neither the model id, nor "messages", nor the user's text — so the
      request sent to Ollama named no model and carried no prompt. It is str.concat now.
      core.providers.anthropic and core.providers.openai still build their bodies this way
      and are reported, not fixed here: they are not this module.

   4. The combined symptom, measured before this change: classify("review this code please";
      <closed port>) returned method:"llm" with task chat at confidence 0.72 — a fabricated
      classification, labelled as having come from a model, more confident than the keyword
      result it had actually fallen back from. A code-generation prompt routed as chat picks a
      different model.

   Every failure path now returns `fast` unchanged, so the method stays "keyword" and the
   confidence stays the keyword confidence. The provenance label is the only witness a caller
   has for whether a model was consulted, and it now tells the truth. *)
f=classifybody(text:str):str{
  let sys="Classify the intent as one of: chat, code_generation, code_review, summarisation, classification, ner, embedding, data_analysis. Reply with just the category name.";
  let head=str.concat("{\"model\":\"qwen2.5:7b\",\"stream\":false,\"messages\":[{\"role\":\"system\",\"content\":";json.enc(sys));
  <str.concat(
    str.concat(head;"},{\"role\":\"user\",\"content\":");
    str.concat(json.enc(text);"}]}")
  )
};

f=classifyfromcontent(content:str;fast:$intentresult):$intentresult{
  if(str.len(content)==0){
    <fast
  }el{};
  (* The confidence is the LLM path's own 0.72, which is deliberately BELOW every keyword
     confidence that short-circuits above it: a model consulted because the keywords were
     unsure should not claim more certainty than they did. *)
  <$intentresult{task:taskfromstr(content);confidence:0.72;method:"llm"}
};

f=classifyfrommessage(msgobj:$json;fast:$intentresult):$intentresult{
  <classifyfromcontent(json.str(msgobj;"content");fast)
};

f=classifyfromobj(obj:$json;fast:$intentresult):$intentresult{
  <mt json.dec(json.str(obj;"message")) {
    $ok:msgobj classifyfrommessage(msgobj;fast);
    $jsonerr:e fast
  }
};

f=classifyfromjson(raw:str;fast:$intentresult):$intentresult{
  <mt json.dec(raw) {
    $ok:obj classifyfromobj(obj;fast);
    $jsonerr:e fast
  }
};

f=classifyfromresp(r:$httpresp;fast:$intentresult):$intentresult{
  <classifyfromjson(str.frombytes(r.body);fast)
};

f=classify(text:str;ollamaurl:str):$intentresult{
  let fast=classifyfast(text);
  if(fast.confidence > 0.80){
    <fast
  }el{};
  let hc=http.client(ollamaurl);
  let resp=http.postheaders(hc;"/api/chat";str.tobytes(classifybody(text));"{\"content-type\":\"application/json\"}");
  <mt resp {
    $ok:r classifyfromresp(r;fast);
    $httperr:e fast
  }
};

                            <$intentresult{task:i64.$classification;confidence:0.82;method:"keyword"}
                          }el{
                            if(str.contains(text;"which category")){
                              <$intentresult{task:i64.$classification;confidence:0.82;method:"keyword"}
                            }el{
                              
                              let hasreview=str.contains(text;"review");
                              let hascheckcode=str.contains(text;"check my code");
                              let haslook=str.contains(text;"look at this");
                              let hascodeword=str.contains(text;"code");
                              let hasfnword=str.contains(text;"function");
                              let hasclassword=str.contains(text;"class");
                              let reviewtrigger=if(hasreview){true}el{if(hascheckcode){true}el{haslook}};
                              let codesignal=if(hascodeword){true}el{if(hasfnword){true}el{hasclassword}};
                              if(reviewtrigger){
                                if(codesignal){
                                  <$intentresult{task:i64.$codereview;confidence:0.78;method:"keyword"}
                                }el{
                                  
                                  if(str.contains(text;"code")){
                                    <$intentresult{task:i64.$codegeneration;confidence:0.80;method:"keyword"}
                                  }el{
                                    if(str.contains(text;"function")){
                                      <$intentresult{task:i64.$codegeneration;confidence:0.80;method:"keyword"}

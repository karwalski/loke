m=core.router.intent;




i=t:shared.types;
i=reg:core.models.registry;
i=str:std.str;
i=http:std.http;
i=json:std.json;
i=log:shared.log;

t=$intentresult{
  task:$reg.tasktype;
  confidence:f64;
  method:str
};



f=taskfromstr(s:str):$reg.tasktype{
  if(str.eq(s;"code_generation"){
    <$reg.tasktype.$codegeneration
  }else{
    if(str.eq(s;"code_review"){
      <$reg.tasktype.$codereview
    }else{
      if(str.eq(s;"summarisation"){
        <$reg.tasktype.$summarisation
      }else{
        if(str.eq(s;"classification"){
          <$reg.tasktype.$classification
        }else{
          if(str.eq(s;"ner"){
            <$reg.tasktype.$ner
          }else{
            if(str.eq(s;"embedding"){
              <$reg.tasktype.$embedding
            }else{
              if(str.eq(s;"data_analysis"){
                <$reg.tasktype.$dataanalysis
              }else{
                <$reg.tasktype.$chat
              };
            };
          };
        };
      };
    };
  };
};



f=classifyfast(text:str):$intentresult{
  
  if(str.contains(text;"embed"){
    <$intentresult{task:$reg.tasktype.$embedding;confidence:0.90;method:"keyword"};
  }else{
    if(str.contains(text;"embedding"){
      <$intentresult{task:$reg.tasktype.$embedding;confidence:0.90;method:"keyword"};
    }else{
      if(str.contains(text;"vector"){
        <$intentresult{task:$reg.tasktype.$embedding;confidence:0.90;method:"keyword"};
      }else{
        if(str.contains(text;"similarity"){
          <$intentresult{task:$reg.tasktype.$embedding;confidence:0.90;method:"keyword"};

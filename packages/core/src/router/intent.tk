m=core.router.intent;




i=t:shared.types;
i=reg:core.models.registry;
i=str:std.str;
i=http:std.http;
i=json:std.json;
i=log:shared.log;

t=$intentresult{
  task:$tasktype;
  confidence:f64;
  method:str
};



f=taskfromstr(s:str):$tasktype{
  if(str.eq(s;"code_generation")){
    <$codegeneration
  }el{
    if(str.eq(s;"code_review")){
      <$codereview
    }el{
      if(str.eq(s;"summarisation")){
        <$summarisation
      }el{
        if(str.eq(s;"classification")){
          <$classification
        }el{
          if(str.eq(s;"ner")){
            <$ner
          }el{
            if(str.eq(s;"embedding")){
              <$embedding
            }el{
              if(str.eq(s;"data_analysis")){
                <$dataanalysis
              }el{
                <$chat
              }
            }
          }
        }
      }
    }
  }
};



f=classifyfast(text:str):$intentresult{
  
  if(str.contains(text;"embed")){
    <$intentresult{task:$embedding;confidence:0.90;method:"keyword"}
  }el{
    if(str.contains(text;"embedding")){
      <$intentresult{task:$embedding;confidence:0.90;method:"keyword"}
    }el{
      if(str.contains(text;"vector")){
        <$intentresult{task:$embedding;confidence:0.90;method:"keyword"}
      }el{
        if(str.contains(text;"similarity")){
          <$intentresult{task:$embedding;confidence:0.90;method:"keyword"}
        }el{
          
          if(str.contains(text;"summarise")){
            <$intentresult{task:$summarisation;confidence:0.85;method:"keyword"}
          }el{
            if(str.contains(text;"summarize")){
              <$intentresult{task:$summarisation;confidence:0.85;method:"keyword"}
            }el{
              if(str.contains(text;"tldr")){
                <$intentresult{task:$summarisation;confidence:0.85;method:"keyword"}
              }el{
                if(str.contains(text;"summary")){
                  <$intentresult{task:$summarisation;confidence:0.85;method:"keyword"}
                }el{
                  if(str.contains(text;"brief")){
                    <$intentresult{task:$summarisation;confidence:0.85;method:"keyword"}
                  }el{
                    
                    if(str.contains(text;"categorise")){
                      <$intentresult{task:$classification;confidence:0.82;method:"keyword"}
                    }el{
                      if(str.contains(text;"categorize")){
                        <$intentresult{task:$classification;confidence:0.82;method:"keyword"}
                      }el{
                        if(str.contains(text;"classify")){
                          <$intentresult{task:$classification;confidence:0.82;method:"keyword"}
                        }el{
                          if(str.contains(text;"label")){
                            <$intentresult{task:$classification;confidence:0.82;method:"keyword"}
                          }el{
                            if(str.contains(text;"which category")){
                              <$intentresult{task:$classification;confidence:0.82;method:"keyword"}
                            }el{
                              
                              let hasreview=str.contains(text;"review");
                              let hascheckcode=str.contains(text;"check my code");
                              let haslook=str.contains(text;"look at this");
                              let hascodeword=str.contains(text;"code");
                              let hasfnword=str.contains(text;"function");
                              let hasclassword=str.contains(text;"class");
                              let reviewtrigger=mut.haslook;
                              if(hasreview){reviewtrigger=true}el{if(hascheckcode){reviewtrigger=true}el{}};
                              let codesignal=mut.hasclassword;
                              if(hascodeword){codesignal=true}el{if(hasfnword){codesignal=true}el{}};
                              if(reviewtrigger){
                                if(codesignal){
                                  <$intentresult{task:$codereview;confidence:0.78;method:"keyword"}
                                }el{
                                  
                                  if(str.contains(text;"code")){
                                    <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                  }el{
                                    if(str.contains(text;"function")){
                                      <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                    }el{
                                      if(str.contains(text;"class")){
                                        <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                      }el{
                                        if(str.contains(text;"def ")){
                                          <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                        }el{
                                          if(str.contains(text;"implement")){
                                            <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                          }el{
                                            if(str.contains(text;"refactor")){
                                              <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                            }el{
                                              if(str.contains(text;"debug")){
                                                <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                              }el{
                                                if(str.contains(text;"fix the")){
                                                  <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                                }el{
                                                  
                                                  if(str.contains(text;"analyse")){
                                                    <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                  }el{
                                                    if(str.contains(text;"analyze")){
                                                      <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                    }el{
                                                      if(str.contains(text;"data")){
                                                        <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                      }el{
                                                        if(str.contains(text;"csv")){
                                                          <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                        }el{
                                                          if(str.contains(text;"chart")){
                                                            <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                          }el{
                                                            if(str.contains(text;"trend")){
                                                              <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                            }el{
                                                              if(str.contains(text;"distribution")){
                                                                <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                              }el{
                                                                
                                                                if(str.contains(text;"who is")){
                                                                  <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                                }el{
                                                                  if(str.contains(text;"what is")){
                                                                    <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                                  }el{
                                                                    if(str.contains(text;"find the name")){
                                                                      <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                                    }el{
                                                                      if(str.contains(text;"identify")){
                                                                        <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                                      }el{
                                                                        
                                                                        <$intentresult{task:$chat;confidence:0.60;method:"keyword"}
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }el{
                                
                                if(str.contains(text;"code")){
                                  <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                }el{
                                  if(str.contains(text;"function")){
                                    <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                  }el{
                                    if(str.contains(text;"class")){
                                      <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                    }el{
                                      if(str.contains(text;"def ")){
                                        <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                      }el{
                                        if(str.contains(text;"implement")){
                                          <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                        }el{
                                          if(str.contains(text;"refactor")){
                                            <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                          }el{
                                            if(str.contains(text;"debug")){
                                              <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                            }el{
                                              if(str.contains(text;"fix the")){
                                                <$intentresult{task:$codegeneration;confidence:0.80;method:"keyword"}
                                              }el{
                                                
                                                if(str.contains(text;"analyse")){
                                                  <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                }el{
                                                  if(str.contains(text;"analyze")){
                                                    <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                  }el{
                                                    if(str.contains(text;"data")){
                                                      <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                    }el{
                                                      if(str.contains(text;"csv")){
                                                        <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                      }el{
                                                        if(str.contains(text;"chart")){
                                                          <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                        }el{
                                                          if(str.contains(text;"trend")){
                                                            <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                          }el{
                                                            if(str.contains(text;"distribution")){
                                                              <$intentresult{task:$dataanalysis;confidence:0.78;method:"keyword"}
                                                            }el{
                                                              
                                                              if(str.contains(text;"who is")){
                                                                <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                              }el{
                                                                if(str.contains(text;"what is")){
                                                                  <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                                }el{
                                                                  if(str.contains(text;"find the name")){
                                                                    <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                                  }el{
                                                                    if(str.contains(text;"identify")){
                                                                      <$intentresult{task:$ner;confidence:0.70;method:"keyword"}
                                                                    }el{
                                                                      
                                                                      <$intentresult{task:$chat;confidence:0.60;method:"keyword"}
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};





f=classify(text:str;ollamaurl:str):$intentresult{
  let fast=classifyfast(text);
  if(fast.confidence > 0.80){
    <fast
  }el{
    let chaturl=str.concat(ollamaurl;"/api/chat");
    let systemmsg="Classify the intent as one of: chat, code_generation, code_review, summarisation, classification, ner, embedding, data_analysis. Reply with just the category name.";
    let body=json.enc($jsonobj{
      model:"qwen2.5:7b";
      stream:false;
      messages:@(
        $jsonobj{role:"system";content:systemmsg};
        $jsonobj{role:"user";content:text}
      )
    });
    let resp=http.post(chaturl;body;"application/json");
    let raw=mt resp {
      $httperr:e fast;
      $ok:raw raw
    };
    let parsed=json.dec(raw);
    let obj=mt parsed {
      $jsonerr:e fast;
      $ok:obj obj
    };
    let msgraw=json.str(obj;"message");
    let msgparsed=json.dec(msgraw);
    let msgobj=mt msgparsed {
      $jsonerr:e fast;
      $ok:msgobj msgobj
    };
    let content=json.str(msgobj;"content");
    let task=taskfromstr(content);
    <$intentresult{task:task;confidence:0.72;method:"llm"}
  }
};

m=core.providers.ollama_provider;



i=t:shared.types;
i=pt:core.providers.types;
i=ollama:core.models.ollama;
i=str:std.str;
i=log:shared.log;

t=$ollamaprovider{
  client:i64
};


f=new(baseurl:str):$ollamaprovider{
  let client=ollama.new(baseurl);
  <$ollamaprovider{client:client}
};




f=complete(provider:$ollamaprovider;req:i64):i64|$lokeerr{
  let opts=$chatopts{
    model:req.modelid;
    messages:req.messages;
    system:req.systemprompt;
    numgpu:-1
  };
  let result=ollama.chat(provider.client;opts);
  mt result {
    $lokeerr:e;
      let msg="ollama_provider complete: chat call failed";
      log.error(msg;"ollama_provider";"");
      <$networkerr(msg)
    text;
      let resp=$completionresponse{
        content:text;
        modelid:req.modelid;
        inputtokens:0;
        outputtokens:0;
        finishreason:"stop";
        costusd:0.0
      };
      log.info(str.concat("ollama_provider complete: ok model=";req.modelid);"ollama_provider";"");
      <resp
  }
};


f=isavailable(provider:$ollamaprovider):bool{
  let status=ollama.healthcheck(provider.client);
  mt status {
    $running;  <true;
    $stopped;  <false;
    $unreachable; <false
  }
};

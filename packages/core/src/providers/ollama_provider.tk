m=core.providers.ollamaprovider;



i=ollama:core.models.ollama;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=pt:core.providers.types;

t=$ollamaprovider{
  client:$ollamaclient
};


f=new(baseurl:str):$ollamaprovider{
  <$ollamaprovider{client:ollama.new(baseurl)}
};




(* LS1.1j — the local path, which was the most broken of the three and matters most.

   complete matched ollama.sendchat, a str!$lokeerr, with the $lokeerr arm FIRST. toke takes
   the FIRST arm of a match on a result whose error side is a user-declared sum whatever the
   value is (T-18), so this returned $err("chat call failed") for EVERY ollama and every
   local dispatch, including the successful ones. loke prefers the local model for anything
   sensitive; that preference could not be honoured, because the local provider always
   reported failure.

   completeplain goes through ollama.sendchatplain, which is plain for the same reason, and
   reports a missing answer with the shared sentinel from core.providers.types. *)
f=completeplain(provider:$ollamaprovider;req:$completionrequest):$completionresponse{
  let opts=$chatopts{
    model:req.modelid;
    messages:req.messages;
    system:req.systemprompt;
    numgpu:-1
  };
  let text=ollama.sendchatplain(provider.client;opts);
  if(str.len(text)==0){
    <pt.nocompletion("ollama_provider complete: no content returned from the local model")
  }el{};
  <ollamabuildresp(text;req.modelid)
};

(* Kept for callers that already match this result, delegating as
   core.storage.audit.logevent does. New callers use completeplain and
   core.providers.types.iscompletion. *)
f=complete(provider:$ollamaprovider;req:$completionrequest):$completionresponse!$lokeerr{
  let resp=completeplain(provider;req);
  if(pt.iscompletion(resp)){
    <$ok(resp)
  }el{
    <$err($networkerr(pt.completionerror(resp)))
  }
};

f=ollamabuildresp(text:str;modelid:str):$completionresponse{
  let resp=$completionresponse{
    content:text;
    modelid:modelid;
    inputtokens:0;
    outputtokens:0;
    finishreason:"stop";
    costusd:0.0
  };
  log.info(str.concat("ollama_provider complete: ok model=";modelid);"ollama_provider";"");
  <resp
};


f=isavailable(provider:$ollamaprovider):bool{
  let status:$ollamastatus=ollama.healthcheck(provider.client);
  <mt status {
    $running:v true;
    $stopped:v false;
    $unreachable:v false
  }
};

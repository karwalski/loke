m=core.providers.ollamaprovider;



i=t:shared.types;
i=pt:core.providers.types;
i=ollama:core.models.ollama;
i=str:std.str;
i=log:shared.log;

t=$ollamaprovider{
  client:i64
};


f=new(baseurl:str):$ollamaprovider{
  let client=ollama.new(baseurl);
  <$ollamaprovider{client:client}
};




f=complete(provider:$ollamaprovider;req:i64):i64!$lokeerr{
  let opts=$chatopts{
    model:req.modelid;
    messages:req.messages;
    system:req.systemprompt;
    numgpu:-1
  };
  let result=ollama.chat(provider.client;opts);
  mt result {
    $lokeerr:e $err($networkerr("ollama_provider complete: chat call failed"));
    $ok:text ollamabuildresp(text;req.modelid)
  }
};

f=ollamabuildresp(text:str;modelid:str):i64!$lokeerr{
  let resp=$completionresponse{
    content:text;
    modelid:modelid;
    inputtokens:0;
    outputtokens:0;
    finishreason:"stop";
    costusd:0.0
  };
  log.info(str.concat("ollama_provider complete: ok model=";modelid);"ollama_provider";"");
  <resp
};


f=isavailable(provider:$ollamaprovider):bool{
  let status=ollama.healthcheck(provider.client);
  mt status {
    $running:v true;
    $stopped:v false;
    $unreachable:v false
  }
};

m=core.providers.transport;

i=http:std.http;
i=str:std.str;
i=log:shared.log;
i=reach:shared.reachability;

(* F5.11. The one HTTP POST the hosted providers are sent through.

   Every Anthropic and OpenAI request used to be written
   `http.postheaders(http.client(url);path;bytes;headers)`. At loke's toolchain pin
   (toke 0b0bc4e) `http.postheaders` is declared `(i64, i64, i64, i64) -> i64` with
   `gen:"abi"`, and its C glue, tk_http_postheaders_w, reads its four arguments as
   (url, body, headersjson, ignored). Called client-first, the glue took the client
   handle for the URL and the path for the body, and nothing was sent: measured against a
   local recorder, the request never arrived and the match took its error arm (T-48,
   docs/upstream/repro-2026-09-27/T-48/). toke main now refuses that shape at compile time.
   Called URL-first it sends, with the headers.

   So this calls it URL-first, and says what it measured:
   - over http, the method, path, body and every header arrive (tests/integration/
     test_hosted_requests.tk, against scripts/lib/http_recorder.py);
   - over https it is NOT measured. The glue does a TLS handshake with SNI when the URL is
     https and openssl was linked in, but proving that a request reaches a provider needs
     a real key and costs money, which is the user's decision. F5.11 carries the one
     command that measures it.

   The glue answers the response BODY, or 0 when the connection, the TLS handshake or the
   read failed. It does not expose the status code, so a 401 with an error document reads
   as a body like any other. Callers therefore judge the body: a reply with no completion
   text in it is a failure, never an empty success.

   The glue always sends its own `Content-Type: application/json`. A second content-type
   in `headersjson` is sent as a second header line, not merged, so the header builders
   below do not add one.

   F10.39, toke 3.1.0. `http.postheaders` is now typed, `(url; body; headers:[[str]]) ->
   httpresp!httperr`: the four-argument form above is E4026, the headers are @(name; value)
   pairs instead of a JSON string, a header holding CR or LF is refused with nothing sent,
   and $err means a transport failure. The response is still read as its BODY whatever the
   status, so a 401 with an error document reads as a body exactly as before, and the
   default Content-Type is still application/json (a caller's would replace it; the
   builders below still add none). What this call shape does NOT change is the refusal in
   `sendable` below: 3.1.0 verifies certificates (B0), and lifting the refusal is its own
   story with its own test, not a side effect of a toolchain move. *)

(* The production endpoints. Tests pass a loopback URL to the functions that take one;
   nothing here reads a URL from configuration or the environment, so no production path
   can be pointed anywhere else. *)
f=anthropicurl():str{
  <"https://api.anthropic.com/v1/messages"
};

f=openaiurl():str{
  <"https://api.openai.com/v1/chat/completions"
};

f=anthropicheaders(key:str):@@str{
  <@(@("x-api-key";key);@("anthropic-version";"2023-06-01"))
};

f=openaiheaders(key:str):@@str{
  <@(@("authorization";"Bearer \(key)"))
};

(* POST `body` to `url` with `headers`, and answer the response body, or "" when nothing
   came back: a transport failure, a refused header, or a body that is not UTF-8. *)
(* T-58: nothing leaves the machine through this until toke verifies certificates.

   Measured 2026-09-27 against the pinned toke: tk_http_postheaders_w creates its TLS client
   context, sets SNI and connects, and never calls SSL_CTX_set_verify, SSL_set1_host or
   SSL_get_verify_result, so OpenSSL verifies nothing. A local probe with a self-signed
   certificate for CN=probe.invalid received the request, authorization header included
   (docs/upstream/toke-issues.md T-58). Every call here carries a provider API key, so an
   https send today hands the key to anyone who can intercept the connection.

   So only a loopback URL is sendable. Anything else is refused before the glue is called,
   and the caller sees "", which every caller already reports as a provider failure, never
   as an answer. This undoes nothing F5.11 measured: the URL-first call still arrives over
   loopback, and the refusal lifts, here and only here, when T-58 is fixed upstream and a
   test proves an untrusted certificate is rejected. *)
f=sendable(url:str):bool{
  <reach.isloopbackurl(url)
};

f=post(url:str;body:str;headers:@@str):str{
  if(sendable(url)==false){
    log.warn("provider request refused: toke's https client does not verify certificates (T-58), so a provider API key is not sent";"providers.transport";"");
    <""
  }el{};
  <mt http.postheaders(url;body;headers) {
    $ok:r mt str.frombytes(r.body) { $ok:s s; $err:e "" };
    $err:e ""
  }
};

m=core.providers.types;
i=t:shared.types;
(* std.str, not shared.types.strlen. shared.types' streq/strlen/strconcat/strcontains all
   have a body that is a bare expression with no `<`, so toke discards it and returns zero:
   t.strlen("abcdef") is 0, t.streq("a";"a") is false and t.strconcat("ab";"cd") is "".
   Measured this session — see the LS1.1j report. iscompletion below was written against
   t.strlen first and reported every real response as a failure. *)
i=str:std.str;
i=jx:shared.jsonobj;




t=$chatmessage{
  role:str;
  content:str
};

t=$completionrequest{
  modelid:str;
  messages:@$chatmessage;
  systemprompt:str;
  maxtokens:u32;
  temperature:f64;
  stream:bool
};

t=$completionresponse{
  content:str;
  modelid:str;
  inputtokens:u32;
  outputtokens:u32;
  finishreason:str;
  costusd:f64
};

t=$providerconfig{
  apikey:str;
  baseurl:str;
  provider:$provider;
  timeoutms:u32
};


(* LS1.1j — the sentinel every provider answers a failed completion with, and the
   predicate that names it.

   A provider's complete returns $completionresponse!$lokeerr. toke takes the FIRST arm of
   a match on a result whose error side is a user-declared sum, whatever the value is
   (T-18), so no caller of complete or of core.providers.dispatcher could tell a real
   answer from a failure. Reading a field off the mis-bound value does not return
   nonsense, it SEGFAULTS — which is what packages/cli's `mt disp.dispatch(...) { $ok:r
   r.content; ... }` does today the moment a provider call fails.

   So the plain forms (completeplain in each provider, trydispatch in the dispatcher)
   answer with a $completionresponse whose modelid is empty. A response that actually came
   back from a provider always names the model that produced it, so an empty modelid
   cannot occur on success, and a caller tests it with an `if` rather than a match it
   cannot trust. Same shape as core.mcp.discovery.probeport and
   core.storage.settings.getstror.

   The message goes in finishreason rather than being thrown away: a caller can log why
   the completion did not happen even though it cannot match on which kind of failure it
   was. finishreason is the right field for it — it says why generation stopped, and "it
   never started" is an answer to that question. Use completionerror to read it, which
   returns "" on success so a caller cannot mistake "stop" for a fault.

   The predicate reads through std.str rather than shared.types.strlen; the note on the
   import above says why that matters. *)
f=nocompletion(reason:str):$completionresponse{
  <$completionresponse{
    content:"";
    modelid:"";
    inputtokens:0 as u32;
    outputtokens:0 as u32;
    finishreason:reason;
    costusd:0.0
  }
};

f=iscompletion(r:$completionresponse):bool{
  <str.len(r.modelid)>0
};

f=completionerror(r:$completionresponse):str{
  if(iscompletion(r)){
    <""
  }el{
    <r.finishreason
  }
};


f=usermsg(content:str):$chatmessage{
  <$chatmessage{role:"user";content:content}
};


f=assistantmsg(content:str):$chatmessage{
  <$chatmessage{role:"assistant";content:content}
};


f=systemmsg(content:str):$chatmessage{
  <$chatmessage{role:"system";content:content}
};


(* ── Request bodies, built with str.concat ─────────────────────────────────────────────
   Both providers used to build their request body as

     json.enc($jsonobj{ model:req.modelid; maxtokens:req.maxtokens; messages:messages })

   and `$jsonobj` is declared in NO module in this repository. json.enc takes a str, so that
   expression compiles, links, and returns a string containing neither the model id, nor
   "messages", nor the user's text. Measured on the identical expression in core.router.intent.
   Every hosted completion this project has ever sent named no model and carried no prompt, on
   the live path (dispatcher:57-66 -> pipeline.dispatch). It is the reason nothing downstream
   of a cloud request has ever been observed working.

   Two further defects were hidden behind it and are fixed here because they would have
   surfaced the moment the body became real: the wire field is `max_tokens` on both APIs, not
   `maxtokens`, and Anthropic takes `system` as a TOP-LEVEL string, not as a message with
   role "system".

   Every str is escaped into a JSON string literal with shared.jsonobj.escape. A prompt
   containing a quote or a newline would otherwise produce a body the provider rejects, and a
   prompt is exactly the field most likely to contain both. MK6.13: this used json.enc, which
   escapes a quote and leaves a newline or a tab raw, so every multi-line message or system
   prompt went out as a body a strict JSON parser refuses. *)

f=messagesjson(messages:@$chatmessage):str{
  let out=mut."[";
  lp(let mj=0;mj<messages.len;mj=mj+1){
    let m=messages.get(mj);
    let sep=mut."";
    if(mj>0){sep=","}el{};
    out="\(out)\(sep){\"role\":\(jx.escape(m.role)),\"content\":\(jx.escape(m.content))}"
  };
  <str.concat(out;"]")
};

(* Omitted entirely when empty rather than sent as "": Anthropic rejects an empty `system`. *)
f=systemfield(sysprompt:str):str{
  if(str.len(sysprompt)==0){
    <""
  }el{
    <str.concat(",\"system\":";jx.escape(sysprompt))
  }
};

f=anthropicbody(req:$completionrequest):str{
  <"{\"model\":\(jx.escape(req.modelid)),\"max_tokens\":\(str.fromint(req.maxtokens as i64))\(systemfield(req.systemprompt)),\"messages\":\(messagesjson(req.messages))}"
};

(* OpenAI has no top-level system field: the system prompt is prepended as a message by the
   caller, which is what openai.completeplain already did. *)
f=openaibody(modelid:str;messages:@$chatmessage;maxtokens:u32):str{
  <"{\"model\":\(jx.escape(modelid)),\"max_tokens\":\(str.fromint(maxtokens as i64)),\"messages\":\(messagesjson(messages))}"
};

m=core.providers.types;



i=t:shared.types;

t=$chatmessage{
  role:str;
  content:str
};

t=$completionrequest{
  modelid:str;
  messages:@$chatmessage;
  systemprompt:str;
  maxtokens:u32;
  temperature:f64;
  stream:bool
};

t=$completionresponse{
  content:str;
  modelid:str;
  inputtokens:u32;
  outputtokens:u32;
  finishreason:str;
  costusd:f64
};

t=$providerconfig{
  apikey:str;
  baseurl:str;
  provider:$provider;
  timeoutms:u32
};


f=usermsg(content:str):$chatmessage{
  <$chatmessage{role:"user";content:content}
};


f=assistantmsg(content:str):$chatmessage{
  <$chatmessage{role:"assistant";content:content}
};


f=systemmsg(content:str):$chatmessage{
  <$chatmessage{role:"system";content:content}
};

m=core.providers.anthropic;



i=t:shared.types;
i=pt:core.providers.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$anthropicclient{
  config:i64
};


f=new(apikey:str):$anthropicclient{
  let config=$providerconfig{
    apikey:apikey;
    baseurl:"https://api.anthropic.com";
    provider:$anthropic(0);
    timeoutms:30000
  };
  <$anthropicclient{config:config}
};





f=calccost(modelid:str;inputtokens:u32;outputtokens:u32):f64{
  let costin=mut.0.000003;
  if(str.contains(modelid;"claude-3-5-haiku")){costin=0.0000008}el{};
  let costout=mut.0.000015;
  if(str.contains(modelid;"claude-3-5-haiku")){costout=0.000004}el{};
  let inputcost=(inputtokens as f64)*costin;
  let outputcost=(outputtokens as f64)*costout;
  <inputcost+outputcost
};





f=parseresponse(obj:i64):i64!$lokeerr{
  let contentarr=json.getarr(obj;"content");
  let first=contentarr.get(0);
  let text=json.str(first;"text");
  let usage=json.str(obj;"usage");
  let usageobj=json.dec(usage);
  let inputtokens=mt usageobj {
    $jsonerr:e 0;
    $ok:u json.i64(u;"input_tokens")
  };
  let outputtokens=mt usageobj {
    $jsonerr:e 0;
    $ok:u json.i64(u;"output_tokens")
  };
  let modelout=json.str(obj;"model");
  let cost=calccost(modelout;inputtokens;outputtokens);
  let resp=$completionresponse{
    content:text;
    modelid:modelout;
    inputtokens:inputtokens;
    outputtokens:outputtokens;
    finishreason:"stop";
    costusd:cost
  };
  log.info(str.concat("anthropic complete: ok model=";modelout);"anthropic";"");
  <resp
};

f=parseraw(raw:str):i64!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $err($modelerr("anthropic complete: failed to parse response JSON"));
    $ok:obj parseresponse(obj)
  }
};

f=complete(client:$anthropicclient;req:i64):i64!$lokeerr{
  let url="https://api.anthropic.com/v1/messages";
  let body=json.enc($jsonobj{
    model:req.modelid;
    maxtokens:req.maxtokens;
    system:req.systemprompt;
    messages:req.messages
  });
  let headers=@(
    $httpheader{key:"x-api-key";value:client.config.apikey};
    $httpheader{key:"anthropic-version";value:"2023-06-01"};
    $httpheader{key:"content-type";value:"application/json"}
  );
  let result=http.postheaders(url;body;headers);
  mt result {
    $httperr:e $err($networkerr(str.concat("anthropic complete: HTTP error — ";json.enc(e))));
    $ok:raw parseraw(raw)
  }
};


f=isavailable(client:$anthropicclient):bool{
  <true
};

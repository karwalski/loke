m=core.providers.openai;



i=t:shared.types;
i=pt:core.providers.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$openaiclient{
  config:i64
};


f=new(apikey:str):$openaiclient{
  let config=$providerconfig{
    apikey:apikey;
    baseurl:"https://api.openai.com";
    provider:$openai(0);
    timeoutms:30000
  };
  <$openaiclient{config:config}
};





f=calccost(modelid:str;inputtokens:u32;outputtokens:u32):f64{
  let costin=mut.0.0000025;
  if(str.contains(modelid;"gpt-4o-mini")){costin=0.00000015}el{};
  let costout=mut.0.00001;
  if(str.contains(modelid;"gpt-4o-mini")){costout=0.0000006}el{};
  let inputcost=inputtokens*costin;
  let outputcost=outputtokens*costout;
  <inputcost+outputcost
};




f=complete(client:$openaiclient;req:i64):i64!$lokeerr{
  let url="https://api.openai.com/v1/chat/completions";
  let messages=mut.req.messages;
  if(str.len(req.systemprompt)=0){}el{
    let sys=$chatmessage{role:"system";content:req.systemprompt};
    messages=@(sys;req.messages)
  };
  let body=json.enc($jsonobj{
    model:req.modelid;
    messages:messages;
    maxtokens:req.maxtokens
  });
  let authvalue=str.concat("Bearer ";client.config.apikey);
  let headers=@(
    $httpheader{key:"Authorization";value:authvalue};
    $httpheader{key:"content-type";value:"application/json"}
  );
  let result=http.postheaders(url;body;headers);
  mt result {
    $httperr:e $err($networkerr(str.concat("openai complete: HTTP error — ";json.enc(e))));
    $ok:raw openaiparseraw(raw)
  }
};

f=openaiparseraw(raw:str):i64!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $err($modelerr("openai complete: failed to parse response JSON"));
    $ok:obj openaiparseobj(obj)
  }
};

f=openaiparseobj(obj:i64):i64!$lokeerr{
  let choices=json.getarr(obj;"choices");
  let first=choices.get(0);
  let message=json.str(first;"message");
  let msgobj=json.dec(message);
  let text=mt msgobj {
    $jsonerr:e "";
    $ok:m json.str(m;"content")
  };
  let usage=json.str(obj;"usage");
  let usageobj=json.dec(usage);
  let inputtokens=mt usageobj {
    $jsonerr:e 0;
    $ok:u json.i64(u;"prompt_tokens")
  };
  let outputtokens=mt usageobj {
    $jsonerr:e 0;
    $ok:u json.i64(u;"completion_tokens")
  };
  let modelout=json.str(obj;"model");
  let cost=calccost(modelout;inputtokens;outputtokens);
  let resp=$completionresponse{
    content:text;
    modelid:modelout;
    inputtokens:inputtokens;
    outputtokens:outputtokens;
    finishreason:"stop";
    costusd:cost
  };
  log.info(str.concat("openai complete: ok model=";modelout);"openai";"");
  <resp
};


f=isavailable(client:$openaiclient):bool{
  <true
};

m=core.providers.openai;



i=t:shared.types;
i=pt:core.providers.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$openaiclient{
  config:$pt.providerconfig
};


f=new(apikey:str):$openaiclient{
  let config=$pt.providerconfig{
    apikey:apikey;
    baseurl:"https://api.openai.com";
    provider:$provider.$openai;
    timeoutms:30000
  };
  <$openaiclient{config:config};
};





f=calccost(modelid:str;inputtokens:u32;outputtokens:u32):f64{
  let costin=if str.contains(modelid;"gpt-4o-mini"){0.00000015}else{0.0000025};
  let costout=if str.contains(modelid;"gpt-4o-mini"){0.0000006}else{0.00001};
  let inputcost=inputtokens*costin;
  let outputcost=outputtokens*costout;
  <inputcost+outputcost
};




f=complete(client:$openaiclient;req:$pt.completionrequest):$pt.completionresponse|$lokeerr{
  let url="https://api.openai.com/v1/chat/completions";
  let messages=if str.len(req.systemprompt)==0{
    req.messages
  }else{
    let sys=$pt.chatmessage{role:"system";content:req.systemprompt};
    @(sys;req.messages)
  };
  let body=json.enc({
    model:req.modelid;
    messages:messages;
    maxtokens:req.maxtokens
  });
  let authvalue=str.concat("Bearer ";client.config.apikey);
  let headers=@(
    $httpheader{key:"Authorization";value:authvalue};
    $httpheader{key:"content-type";value:"application/json"};
  );
  let result=http.postheaders(url;body;headers);
  mt result {
    $httperr e;
      let msg=str.concat("openai complete: HTTP error — ";json.enc(e));
      log.error(msg;"openai";"");
      <$lokeerr.$networkerr(msg)
    raw;
      let parsed=json.dec(raw);
      mt parsed {
        $jsonerr e;
          let msg="openai complete: failed to parse response JSON";
          log.error(msg;"openai";"");
          <$lokeerr.$modelerr(msg)
        obj;
          let choices=json.getarr(obj;"choices");
          let first=choices.get(0);
          let message=json.getstr(first;"message");
          let msgobj=json.dec(message);
          let text=mt msgobj {
            $jsonerr e; "";
            m; json.getstr(m;"content")
          };
          let usage=json.getstr(obj;"usage");
          let usageobj=json.dec(usage);
          let inputtokens=mt usageobj {
            $jsonerr e; 0;
            u; json.getint(u;"prompt_tokens")
          };
          let outputtokens=mt usageobj {
            $jsonerr e; 0;
            u; json.getint(u;"completion_tokens")
          };
          let modelout=json.getstr(obj;"model");
          let cost=calccost(modelout;inputtokens;outputtokens);
          let resp=$pt.completionresponse{
            content:text;
            modelid:modelout;
            inputtokens:inputtokens;
            outputtokens:outputtokens;
            finishreason:"stop";
            costusd:cost
          };
          log.info(str.concat("openai complete: ok model=";modelout);"openai";"");
          <resp
      };
  };
};


f=isavailable(client:$openaiclient):bool{
  <true
};

m=core.metrics.collector;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=external:core.governance.external;

t=$metricevent{
  requestid:$str;
  timestamp:$str;
  tokensbefore:i64;
  tokensafter:i64;
  tokenssaved:i64;
  costbeforeusd:f64;
  costafterusd:f64;
  costsavedusd:f64;
  piientitiesfound:i64;
  piientitiesblocked:i64;
  routedlocal:bool;
  cachehit:bool;
  modelid:$str;
  providerid:$str;
  savingsbystage:$str
};

t=$metricssummary{
  totaltokenssaved:i64;
  totalcostsavedusd:f64;
  totalpiiintercepted:i64;
  totalrequests:i64;
  localrequests:i64;
  cloudrequests:i64;
  cachehits:i64;
  cachemisses:i64;
  localratio:f64;
  cachehitrate:f64;
  avgsavingpct:f64
};

f=record(conn:i64;event:i64;extconfig:$external.$externalconfig|void):void|$lokeerr{
  let sql="INSERT INTO metrics_raw (request_id,timestamp,tokens_before,tokens_after,tokens_saved,cost_before,cost_after,cost_saved,pii_found,pii_blocked,routed_local,cache_hit,model_id,provider_id,savings_by_stage) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";
  let localint=if(event.routedlocal):i64{1}el{0};
  let cacheint=if(event.cachehit):i64{1}el{0};
  db.execparams(conn;sql;@(
    mt event.requestid;event.timestamp;
    str.fromint(event.tokensbefore);str.fromint(event.tokensafter);str.fromint(event.tokenssaved);
    str.fromfloat(event.costbeforeusd);str.fromfloat(event.costafterusd);str.fromfloat(event.costsavedusd);
    str.fromint(event.piientitiesfound);str.fromint(event.piientitiesblocked);
    str.fromint(localint);str.fromint(cacheint);
    event.modelid;event.providerid;event.savingsbystage
  )) {
    $$ok:v {
      mt extconfig {
        $ok:cfg {
          if(event.tokenssaved > 0){
            external.dispatchmetrics(cfg;"tokens";str.fromint(event.tokenssaved))
          }el{};
          if(event.costsavedusd > 0.0){
            external.dispatchmetrics(cfg;"cost";str.fromfloat(event.costsavedusd))
          }el{};
          if(event.piientitiesfound > 0){
            external.dispatchmetrics(cfg;"pii";str.fromint(event.piientitiesfound))
          }el{};
          if(event.cachehit){
            external.dispatchmetrics(cfg;"cache";"1")
          }el{};
          external.dispatchmetrics(cfg;"pipeline";str.concat("{\"model\":\"";str.concat(event.modelid;str.concat("\",\"provider\":\"";str.concat(event.providerid;"\"}")))));
        };
        $$err:e {};
      };
      <$ok(void)
    };
    $err:e <$err($lokeerr.$storageerr("failed to record metric event"))
  };
};

f=summarise(conn:$dbconn):$metricssummary|$lokeerr{
  let sql="SELECT COUNT(*) as total, SUM(tokens_saved) as ts, SUM(cost_saved) as cs, SUM(pii_found) as pii, SUM(routed_local) as local_count, SUM(cache_hit) as cache_count FROM metrics_raw";
  mt db.query(conn;sql) {
    $ok:rows {
      let row=rows.get(0);
      let total=json.getint(row;"total");
      let ts=json.getint(row;"ts");
      let cs=json.getfloat(row;"cs");
      let pii=json.getint(row;"pii");
      let localcount=json.getint(row;"local_count");
      let cachecount=json.getint(row;"cache_count");
      let cloudcount=total-localcount;
      let cachemisses=total-cachecount;
      let localratio=if(total>0):i64{(localcount as f64)/(total as f64)*100.0}el{0.0};
      let cacherate=if(total>0):i64{(cachecount as f64)/(total as f64)*100.0}el{0.0};
      <$ok($metricssummary{
        totaltokenssaved:$ts;totalcostsavedusd:$cs;totalpiiintercepted:$pii;
        totalrequests:$total;localrequests:$localcount;cloudrequests:$cloudcount;
        cachehits:$cachecount;cachemisses:$cachemisses;
        localratio:$localratio;cachehitrate:$cacherate;avgsavingpct:0.0
      })
    };
    $err:e <$err($lokeerr.$storageerr("failed to summarise metrics"))
  };
};

m=core.metrics.collector;
i=t:shared.types;
i=db:std.db;
i=str:std.str;
i=log:shared.log;
i=json:std.json;
i=external:core.governance.external;

t=$metricevent{
  requestid:str;
  timestamp:str;
  tokensbefore:i64;
  tokensafter:i64;
  tokenssaved:i64;
  costbeforeusd:f64;
  costafterusd:f64;
  costsavedusd:f64;
  piientitiesfound:i64;
  piientitiesblocked:i64;
  routedlocal:bool;
  cachehit:bool;
  modelid:str;
  providerid:str;
  savingsbystage:str
};

t=$metricssummary{
  totaltokenssaved:i64;
  totalcostsavedusd:f64;
  totalpiiintercepted:i64;
  totalrequests:i64;
  localrequests:i64;
  cloudrequests:i64;
  cachehits:i64;
  cachemisses:i64;
  localratio:f64;
  cachehitrate:f64;
  avgsavingpct:f64
};

f=recorddispatch(event:$metricevent;extconfig:i64):void!$lokeerr{
  if(event.tokenssaved > 0){
    external.dispatchmetrics(extconfig;"tokens";str.fromint(event.tokenssaved))
  }el{};
  if(event.costsavedusd > 0.0){
    external.dispatchmetrics(extconfig;"cost";str.fromfloat(event.costsavedusd))
  }el{};
  if(event.piientitiesfound > 0){
    external.dispatchmetrics(extconfig;"pii";str.fromint(event.piientitiesfound))
  }el{};
  if(event.cachehit){
    external.dispatchmetrics(extconfig;"cache";"1")
  }el{};
  external.dispatchmetrics(extconfig;"pipeline";str.concat("{\"model\":\"";str.concat(event.modelid;str.concat("\",\"provider\":\"";str.concat(event.providerid;"\"}")))));
  <$ok(void)
};

f=record(conn:i64;event:$metricevent;extconfig:i64):void!$lokeerr{
  let sql="INSERT INTO metrics_raw (request_id,timestamp,tokens_before,tokens_after,tokens_saved,cost_before,cost_after,cost_saved,pii_found,pii_blocked,routed_local,cache_hit,model_id,provider_id,savings_by_stage) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";
  let localint=mut.0; if(event.routedlocal){localint=1}el{};
  let cacheint=mut.0; if(event.cachehit){cacheint=1}el{};
  mt db.execparams(conn;sql;@(
    event.requestid;event.timestamp;
    str.fromint(event.tokensbefore);str.fromint(event.tokensafter);str.fromint(event.tokenssaved);
    str.fromfloat(event.costbeforeusd);str.fromfloat(event.costafterusd);str.fromfloat(event.costsavedusd);
    str.fromint(event.piientitiesfound);str.fromint(event.piientitiesblocked);
    str.fromint(localint);str.fromint(cacheint);
    event.modelid;event.providerid;event.savingsbystage
  )) {
    $ok:v recorddispatch(event;extconfig);
    $err:e $err($storageerr("failed to record metric event"))
  }
};

f=summarisebuildresult(rows:i64):$metricssummary!$lokeerr{
  let row=rows.get(0);
  let total=json.i64(row;"total");
  let ts=json.i64(row;"ts");
  let cs=json.getfloat(row;"cs");
  let pii=json.i64(row;"pii");
  let localcount=json.i64(row;"local_count");
  let cachecount=json.i64(row;"cache_count");
  let cloudcount=total - localcount;
  let cachemisses=total - cachecount;
  let localratio=mut.0.0; if(total > 0){localratio=(localcount as f64) / (total as f64) * 100.0}el{};
  let cacherate=mut.0.0; if(total > 0){cacherate=(cachecount as f64) / (total as f64) * 100.0}el{};
  <$ok($metricssummary{
    totaltokenssaved:ts;totalcostsavedusd:cs;totalpiiintercepted:pii;
    totalrequests:total;localrequests:localcount;cloudrequests:cloudcount;
    cachehits:cachecount;cachemisses:cachemisses;
    localratio:localratio;cachehitrate:cacherate;avgsavingpct:0.0
  })
};

f=summarise(conn:i64):$metricssummary!$lokeerr{
  let sql="SELECT COUNT(*) as total, SUM(tokens_saved) as ts, SUM(cost_saved) as cs, SUM(pii_found) as pii, SUM(routed_local) as local_count, SUM(cache_hit) as cache_count FROM metrics_raw";
  mt db.query(conn;sql) {
    $ok:rows summarisebuildresult(rows);
    $err:e $err($storageerr("failed to summarise metrics"))
  }
};

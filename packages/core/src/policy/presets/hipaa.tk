m=core.policy.presets.hipaa;
i=s:core.policy.schema;
i=ty:core.policy.types;

f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"US HIPAA";
    description:"Health Insurance Portability and Accountability Act";
    source:"builtin:hipaa";
    priority:100;
    classificationdefault:"restricted";
    providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"ssn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medical_record";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"insurance";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"zip";action:"anonymise";strength:"full";exceptions:@()}
    );
    (* maxcostusd is sourced: docs/specifications/policy-examples/hipaa.yaml sets a monthly
       global limit of 100.00 USD with on_exceed warn_and_block and allow_override false.
       The currency matches this field, so the figure is carried across unconverted.
       maxtokens stays zero: the source document gives no token figure, and the limit
       waits on core.optimiser.budget being wired, GA1.5. *)
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:100.0;actiononexceed:"block"};
    retention:$retentionpolicy{auditlogdays:2190;conversationdays:30;piimappingdays:7;cachedays:1};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("health";"ssn";"medical_record";"insurance";"dob");
    crossborderallowed:false;
    requireapprovalabove:"public";
    customrules:@("baa_required";"safe_harbor_deidentification";"60_day_breach_notification";"minimum_necessary_standard")
  }
};

f=rules():@$policyrule{
  <@(
    $policyrule{ id:"hipaa-phi"; description:"Protected Health Information must not be transmitted without authorisation"; action:"block"; severity:"critical" };
    $policyrule{ id:"hipaa-minimum-necessary"; description:"Use minimum necessary PHI for purpose"; action:"warn"; severity:"high" };
    $policyrule{ id:"hipaa-audit"; description:"All PHI access must be logged"; action:"log"; severity:"high" };
    $policyrule{ id:"hipaa-baa-required"; description:"A business associate agreement is required before any provider receives PHI"; action:"block"; severity:"critical" };
    $policyrule{ id:"hipaa-safe-harbor"; description:"Safe harbor de-identification requires all eighteen identifier categories to be removed; loke does not guarantee complete detection, so this is evidence toward the standard and not a determination of it"; action:"warn"; severity:"high" };
    $policyrule{ id:"hipaa-breach-notification"; description:"A breach of unsecured PHI must be notified within 60 days; the obligation rests with the covered entity"; action:"warn"; severity:"critical" }
  )
};

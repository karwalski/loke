m=core.policy.presets.hipaa;
i=s:core.policy.schema;

f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"US HIPAA";
    description:"Health Insurance Portability and Accountability Act";
    source:"builtin:hipaa";
    priority:100;
    classificationdefault:"restricted";
    providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"ssn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medical_record";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"insurance";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"zip";action:"anonymise";strength:"full";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"block"};
    retention:$retentionpolicy{auditlogdays:2190;conversationdays:30;piimappingdays:7;cachedays:1};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("health";"ssn";"medical_record";"insurance";"dob");
    crossborderallowed:false;
    requireapprovalabove:"public";
    customrules:@("baa_required";"safe_harbor_deidentification";"60_day_breach_notification";"minimum_necessary_standard")
  }
};

m=core.policy.presets.gdpr;
i=s:core.policy.schema;
i=ty:core.policy.types;

f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"EU GDPR";
    description:"General Data Protection Regulation (EU) 2016/679";
    source:"builtin:eu-gdpr";
    priority:100;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"national_id";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"political";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"religion";action:"block";strength:"full";exceptions:@()}
    );
    (* Both limits are zero on purpose. docs/specifications/policy-examples/eu-gdpr.yaml
       sets a monthly global limit of 100.00 EUR, and this field is USD-denominated: there
       is no rate in the repository to convert it with, and inventing one would put a
       number nobody measured into a regulatory preset. maxtokens has no figure in the
       source document at all. Both wait on core.optimiser.budget being wired, GA1.5, and
       on a currency field or a sourced rate. *)
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:1825;conversationdays:90;piimappingdays:30;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("health";"biometric";"political";"religion";"sexual_orientation";"trade_union";"genetic");
    crossborderallowed:false;
    requireapprovalabove:"internal";
    customrules:@("dpa_required_for_providers";"art9_special_categories_blocked";"right_to_erasure_supported")
  }
};

f=rules():@$policyrule{
  <@(
    $policyrule{ id:"gdpr-pii-export"; description:"Personal data must not leave the EU without an adequacy decision"; action:"warn"; severity:"high" };
    $policyrule{ id:"gdpr-consent"; description:"Processing requires valid consent or legitimate interest"; action:"warn"; severity:"high" };
    $policyrule{ id:"gdpr-minimisation"; description:"Only collect data necessary for stated purpose"; action:"log"; severity:"medium" };
    $policyrule{ id:"gdpr-retention"; description:"Data must not be retained longer than necessary"; action:"log"; severity:"medium" };
    $policyrule{ id:"gdpr-right-erasure"; description:"Users have right to erasure — no persistent PII storage"; action:"warn"; severity:"high" };
    $policyrule{ id:"gdpr-art9-special-categories"; description:"Article 9 special category data is blocked from the forward path rather than substituted, because substitution is not de-identification"; action:"block"; severity:"critical" };
    $policyrule{ id:"gdpr-dpa-required"; description:"Any processor receiving personal data requires a data processing agreement"; action:"warn"; severity:"high" }
  )
};

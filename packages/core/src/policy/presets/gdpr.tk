
m=core.policy.presets.gdpr;
i=s:core.policy.schema;

f=preset():i64{
  <$policy{
    version:"1.0";
    name:"EU GDPR";
    description:"General Data Protection Regulation (EU) 2016/679";
    source:"builtin:eu-gdpr";
    priority:100;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"national_id";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"political";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"religion";action:"block";strength:"full";exceptions:@()};
    );
    budget:i64{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:i64{auditlogdays:1825;conversationdays:90;piimappingdays:30;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("health";"biometric";"political";"religion";"sexual_orientation";"trade_union";"genetic");
    crossborderallowed:false;
    requireapprovalabove:"internal";
    customrules:@("dpa_required_for_providers";"art9_special_categories_blocked";"right_to_erasure_supported")
  };
};

m=core.policy.presets.apracps234;
i=s:core.policy.schema;
i=ty:core.policy.types;

f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"APRA CPS 234 — Information Security";
    description:"Preset shaped by Prudential Standard CPS 234 for APRA-regulated entities. Defaults to no-custody analysis, requires a recorded provider assessment, and classifies information assets by criticality and sensitivity. Not compliance: the obligations rest on the entity.";
    source:"builtin:apra-cps-234";
    priority:100;
    classificationdefault:"confidential";
    providers:@(
      $providerpermission{
        providerid:"local";
        allowed:true;
        maxsensitivity:"restricted";
        requiresdpa:false;
        notes:"On-device inference is not a third party, so no assessment is required. The YAML permits level critical here; loke's classification vocabulary has four levels and no critical, so this is capped at restricted. The fifth level is not expressible."
      };
      $providerpermission{
        providerid:"*";
        allowed:false;
        maxsensitivity:"confidential";
        requiresdpa:true;
        notes:"Every external provider is denied until the entity records an assessment that is not past its review date. loke stores no assessment record, so allowed cannot be flipped by evidence it holds; an operator flipping it is asserting the assessment exists."
      }
    );
    anonymisation:@(
      $anonymisationrule{entitytype:"tfn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medicare";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bsb";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bank_account";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"credit_card";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"api_key";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"password";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"abn";action:"anonymise";strength:"reasonable";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:500.0;actiononexceed:"block"};
    retention:$retentionpolicy{auditlogdays:2555;conversationdays:0;piimappingdays:1;cachedays:0};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("tfn";"medicare";"bsb";"bank_account";"credit_card";"api_key";"password";"health";"biometric");
    crossborderallowed:false;
    requireapprovalabove:"confidential";
    customrules:@(
      "no_custody_default_path";
      "redact_and_forward_requires_recorded_justification";
      "restricted_and_critical_assets_local_only";
      "recorded_provider_assessment_required";
      "apra_material_incident_72_hours";
      "apra_material_control_weakness_10_business_days";
      "unimplemented_interaction_ledger_ga5_5_ga1_4";
      "unimplemented_ledger_tamper_evidence_ga5_2_ga5_3";
      "unimplemented_at_rest_encryption_x8";
      "unimplemented_fail_closed_nc1_9";
      "unmeasured_detection_recall_ad1_2";
      "entity_review_required_before_adoption"
    )
  }
};

f=rules():@$policyrule{
  <@(
    $policyrule{
      id:"cps234-no-custody-default";
      description:"disclosure.default_path — Analysis defaults to the no-custody path: schema profile and intent are disclosed, no data values are. An external provider that never receives an information asset is not a third party managing one.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-forward-requires-justification";
      description:"disclosure.redact_and_forward.requires_justification — The redact-and-forward path is available only with an explicit, attributable and recorded justification, because it makes the provider a third party managing an information asset.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-restricted-never-forwarded";
      description:"disclosure.redact_and_forward.prohibited_levels — Restricted and critical assets may not take the redact-and-forward path at all. There is no configuration that permits it.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-redaction-is-not-deidentification";
      description:"disclosure.redact_and_forward.stated_limitation — Redaction reduces disclosure and does not prevent identification. Do not represent this path to an assessor as de-identification.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-fail-closed";
      description:"UNIMPLEMENTED NC1.9 — disclosure.fail_closed — When no detection layer is healthy the request must fail rather than proceed. loke currently fails OPEN and transmits the original text, so this control is aspirational and an entity must not rely on it.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-provider-assessment-required";
      description:"provider_restrictions.default_action and requires_recorded_assessment — Every external provider is denied until the entity records an assessment covering residency, retention, training use, subprocessors, incident terms, right to audit and a review date.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-restricted-assets-local-only";
      description:"provider_restrictions.providers local — On-device inference is the only provider permitted for restricted and critical assets by default, which is why local capability is a control rather than a convenience.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-provider-concentration";
      description:"provider_restrictions.concentration_warning_threshold — Reliance above 0.8 of requests on a single provider for a critical operation is a dependency to manage; local capability is what reduces it.";
      action:"warn";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-asset-classification";
      description:"data_classification — Information assets are classified by sensitivity, defaulting to confidential, with criticality recorded alongside because loke's single sensitivity axis is not sufficient on its own.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-detector-gap-au-identifiers";
      description:"UNIMPLEMENTED AD1.1 — data_classification.rules detector_status absent — Medicare number, BSB and bank account number are classified restricted but loke has no detector for any of them, and an account number is indistinguishable from any eight-digit number.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-aggregates-not-safe";
      description:"data_classification.rules aggregate_statistic — Aggregates are not automatically safe. Small cell counts and repeated differently-filtered queries can reconstruct individual records.";
      action:"warn";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-query-channel-residual-risk";
      description:"disclosure.no_custody.residual_risks — A returned query is an information channel; an adversary able to shape queries and observe results across turns can extract values a piece at a time. Bounding this is an open problem, NC1.10.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-interaction-ledger";
      description:"UNIMPLEMENTED GA5.5 and GA1.4 — evidence.interaction_ledger — Control-operation evidence requires a ledger recording correlation id, disclosure path, classification, provider, detection layers, decision, justification, approver and volume. Nothing writes it today, so that evidence does not exist.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-ledger-tamper-evidence";
      description:"UNIMPLEMENTED GA5.2 and GA5.3 — evidence.tamper_evidence — A ledger that cannot be shown to be unaltered is a usage record, not control evidence. The stored digest does not incorporate the previous record.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-control-testing";
      description:"evidence.control_testing — Detection recall, the no-custody invariant, fail-closed behaviour and enforcement coverage must each be tested. Only the regex layer is measured; the other three harnesses are specified and not run.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-independent-review-not-dischargeable";
      description:"NOT DISCHARGEABLE BY LOKE — evidence.independent_review — loke can supply records for review and cannot conduct the review. The entity's internal audit function retains that obligation.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-notification-not-dischargeable";
      description:"NOT DISCHARGEABLE BY LOKE — incident.notify_apra is false — APRA must be notified of a material information security incident within 72 hours and of a material control weakness within 10 business days. The obligation rests with the APRA-regulated entity; loke detects and records only.";
      action:"warn";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-trigger-unredacted-disclosure";
      description:"incident.triggers_to_surface unredacted_disclosure — Data transmitted without the detection layer having run, including via the fail-open path. The highest-severity trigger and the most likely to be materially reportable.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-trigger-restricted-on-forward-path";
      description:"incident.triggers_to_surface restricted_asset_on_forward_path — A restricted or critical asset took the redact-and-forward path.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-trigger-provider-unassessed";
      description:"incident.triggers_to_surface provider_used_without_assessment — An external provider was used with no recorded assessment, or past its review date.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-trigger-detection-unavailable";
      description:"incident.triggers_to_surface detection_layer_unavailable — A configured detection layer was unavailable for a request.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-trigger-credential-outbound";
      description:"incident.triggers_to_surface credential_detected_outbound — An API key or password was detected in an outbound payload. Compromise of a credential is an incident, not a disclosure.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-trigger-bypass-observed";
      description:"incident.triggers_to_surface bypass_observed — Traffic reached a provider without transiting loke. Enforcement coverage is reported as N of 6 bypass classes and the corpus has not been run.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-kill-switch";
      description:"incident.kill_switch — Immediate cessation of outbound traffic, globally or per provider or per agent. Its operation must be recorded in the ledger so it can be evidenced.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-prompt-content-not-retained";
      description:"retention.notes — Prompt content is deliberately not retained, with the consequence that the ledger cannot evidence what was in a prompt, only that one occurred and how it was classified. State that limitation to an assessor.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-encryption-at-rest";
      description:"UNIMPLEMENTED X8 — retention.at_rest_encryption — The encryption pragma is ignored by the underlying database, so records are plaintext on disk. For a CPS 234 entity this should be treated as blocking.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-special-categories-blocked";
      description:"anonymisation.special_categories — Health, biometric and similar categories are blocked from the forward path rather than substituted, because substitution is not de-identification.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-placeholder-collision";
      description:"KNOWN DEFECT PL1.1 — anonymisation.known_defect — Both NER layers emit a constant token, so several entities of the same type in one request collapse to a single placeholder and restoration can substitute the wrong person's value. The fallback path must not be used for multi-party data until this is fixed.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-approval-must-be-recorded";
      description:"sensitivity_thresholds.approval_must_be_recorded — Approval above the confidential level means a recorded human decision, not a dialog that defaults to yes.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-budget-tolerance-blocks";
      description:"budget_limits.on_exceed — An uncapped dependency on an external provider is the exposure CPS 230 asks an entity to hold a tolerance limit for, so exceeding the limit blocks rather than warns.";
      action:"block";
      severity:"high"
    };
    $policyrule{
      id:"cps234-entity-review-required";
      description:"metadata.requires_entity_review and cannot_discharge — This preset is a starting point. loke cannot perform the third-party assessment, maintain the entity's notification obligations, substitute for internal audit, or carry Board-level accountability. Have the mapping reviewed by the entity's own risk function.";
      action:"log";
      severity:"high"
    }
  )
};

f=blockingstories():@str{
  <@("GA5.5";"GA1.4";"GA5.2";"GA5.3";"X8";"NC1.9";"AD1.2";"AD1.1";"PL1.1";"NC1.10")
};

m=core.policy.presets.apracps234;
i=s:core.policy.schema;
i=ty:core.policy.types;

(* APRA Prudential Standard CPS 234 Information Security, as published by APRA: determination
   No. 1 of 2018 (F2018L01745), made 30 November 2018, in force from 1 July 2019 (para 5).
   For information assets a third party manages it applied from the earlier of the next
   contract renewal or 1 July 2020 (para 6), so it applies in full to any model provider today.
   Read 2026-10-01 from APRA's July 2019 PDF and its standards page, which still lists this
   instrument as current.

   Every rule cites the paragraph it rests on and opens with one of three classes:
     EVALUABLE           the condition is a field of this preset that loke's own policy code
                         reads, and that field is asserted by the test.
     DOCUMENTATION ONLY  an obligation of the entity, or a fact about loke, that no field of
                         $policy can express. Always log: a rule nothing can evaluate must not
                         pretend to warn or block.
     UNIMPLEMENTED       something the standard asks of a control like loke that loke does not
                         do, named with the story that would close it.
   Evaluable is not enforced. Nothing on the request path calls core.policy.loader.evaluate,
   so no rule here acts on traffic yet. Cross-references to other standards are written as
   "paragraph N", never in the short form, so the test's citation check counts only CPS 234. *)
f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"APRA CPS 234 — Information Security";
    description:"Preset shaped by Prudential Standard CPS 234 (in force 1 July 2019) for APRA-regulated entities. Denies every external provider until the entity records its para 16 assessment, keeps restricted assets on local inference, and blocks special categories and credentials. Not compliance: the obligations rest on the entity, and this preset is not yet enforced on the request path.";
    source:"builtin:apra-cps-234";
    priority:100;
    classificationdefault:"confidential";
    providers:@(
      $providerpermission{
        providerid:"local";
        allowed:true;
        maxsensitivity:"restricted";
        requiresdpa:false;
        notes:"On-device inference is not a third party, so para 16 and para 22 do not reach it. The YAML permits level critical here; loke's classification vocabulary has four levels and no critical, so this is capped at restricted. Criticality, which para 20 requires alongside sensitivity, is not expressible."
      };
      $providerpermission{
        providerid:"*";
        allowed:false;
        maxsensitivity:"confidential";
        requiresdpa:true;
        notes:"Every external provider is denied until the entity records the para 16 assessment of its information security capability and the para 22 evaluation of its controls. loke stores no assessment record, so allowed cannot be flipped by evidence it holds; an operator flipping it is asserting the assessment exists."
      }
    );
    anonymisation:@(
      $anonymisationrule{entitytype:"tfn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medicare";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bsb";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bank_account";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"credit_card";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"api_key";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"password";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"abn";action:"anonymise";strength:"reasonable";exceptions:@()}
    );
    (* CPS 234 sets no spend limit. The figure is carried from the YAML for parity with the
       CPS 230 preset, where a limit is a tolerance under paragraph 15(b) of that standard. *)
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:500.0;actiononexceed:"block"};
    retention:$retentionpolicy{auditlogdays:2555;conversationdays:0;piimappingdays:1;cachedays:0};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("tfn";"medicare";"bsb";"bank_account";"credit_card";"api_key";"password";"health";"biometric");
    (* CPS 234 says nothing about geography. Cross-border is off because loke cannot see where
       a provider processes, which the para 16 assessment must establish. *)
    crossborderallowed:false;
    requireapprovalabove:"confidential";
    customrules:@(
      "cps234_in_force_2019_07_01_para_5";
      "cps234_para_16_provider_denied_until_assessed";
      "cps234_para_20_sensitivity_only_criticality_not_expressible";
      "cps234_para_21_restricted_assets_local_only";
      "cps234_para_35_apra_notification_72_hours_entity_obligation";
      "cps234_para_36_control_weakness_10_business_days_entity_obligation";
      "unimplemented_preset_not_enforced_on_request_path";
      "unimplemented_at_rest_encryption_x8";
      "unimplemented_au_identifier_detectors";
      "entity_review_required_before_adoption"
    )
  }
};

f=rules():@$policyrule{
  <@(
    (* Roles, capability and policy framework, paras 13 to 19. *)
    $policyrule{
      id:"cps234-board-accountability";
      description:"DOCUMENTATION ONLY — CPS 234 para 13, para 14. The Board is ultimately responsible for the entity's information security, and roles for decision-making, approval, oversight and operation must be defined. NOT DISCHARGEABLE BY LOKE: a tool cannot hold an accountability the standard places on the Board.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-capability-maintained";
      description:"DOCUMENTATION ONLY — CPS 234 para 15, para 17. Information security capability must be commensurate with the threats and actively maintained as threats and assets change. loke can be one control within that capability; whether the capability as a whole is commensurate is the entity's judgement.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-policy-framework";
      description:"DOCUMENTATION ONLY — CPS 234 para 18, para 19. The entity's information security policy framework must give direction to every party with an obligation, which footnote 8 extends to third parties. This preset is an input to that framework and not the framework.";
      action:"log";
      severity:"medium"
    };

    (* Third parties, paras 16 and 22. A model provider that receives a request is a third
       party managing an information asset: para 12(d) defines that as information and data. *)
    $policyrule{
      id:"cps234-provider-assessment-required";
      description:"EVALUABLE — CPS 234 para 16, para 22. Every external provider is denied (providers entry * has allowed false and requiresdpa true) until the entity records its assessment of the provider's information security capability and its evaluation of the design of the provider's controls.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-third-party-assessment";
      description:"DOCUMENTATION ONLY — CPS 234 para 16, para 22, para 28. NOT DISCHARGEABLE BY LOKE: the assessment of a provider's capability, the evaluation of its control design and, where the entity relies on the provider's own control testing, the judgement whether that testing is commensurate, are all the entity's. loke stores no assessment record.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-no-custody-default";
      description:"DOCUMENTATION ONLY — CPS 234 para 16, para 21. The no-custody path discloses a schema profile and the user's intent rather than data values. That narrows what the provider manages; it does not take the provider outside para 16, because a schema and an intent are themselves information assets under para 12. The policy schema has no field for the disclosure path.";
      action:"log";
      severity:"high"
    };

    (* Classification, para 20. *)
    $policyrule{
      id:"cps234-asset-classification";
      description:"EVALUABLE — CPS 234 para 20. Information assets are classified by sensitivity, defaulting to confidential (classificationdefault). This covers the sensitivity half of para 20 only.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-criticality-axis";
      description:"UNIMPLEMENTED RG1.1 — CPS 234 para 20. Para 20 requires classification by criticality as well as sensitivity, and para 12 defines criticality as the impact of a loss of availability. loke has one sensitivity axis and no criticality field, so half of the classification the standard asks for cannot be recorded.";
      action:"log";
      severity:"high"
    };

    (* Controls, para 21: commensurate with threats, criticality and sensitivity, life-cycle
       stage and the consequences of an incident. *)
    $policyrule{
      id:"cps234-restricted-assets-local-only";
      description:"EVALUABLE — CPS 234 para 21. Restricted assets are permitted only to on-device inference: the local provider's maxsensitivity is restricted and every external provider's is confidential.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-restricted-never-forwarded";
      description:"EVALUABLE — CPS 234 para 21. A restricted asset may not take the redact-and-forward path to any external provider, at any approval. The control is the confidential ceiling on the external providers entry.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-approval-above-confidential";
      description:"EVALUABLE — CPS 234 para 21. Above confidential a recorded human approval is required (requireapprovalabove), and the rules engine derives the apra-cps-234-approval-required rule from it.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps234-special-categories-blocked";
      description:"EVALUABLE — CPS 234 para 21. Health, biometric and government and financial identifiers are in blockedentitytypes, blocked from the forward path rather than substituted, because the consequence of their compromise is the highest.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-credential-outbound-blocked";
      description:"EVALUABLE — CPS 234 para 21, para 23. API keys and passwords are in blockedentitytypes. A credential in an outbound payload is a compromise of an information asset, not a disclosure to be minimised.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-au-identifier-detectors";
      description:"UNIMPLEMENTED RG1.7 — CPS 234 para 21. Medicare number, BSB and bank account number are blocked by this preset but loke's detectors name none of them, so the block cannot fire on a value nothing detects. The preset's entity names are also not yet reconciled with the detector vocabulary.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-redaction-is-not-deidentification";
      description:"DOCUMENTATION ONLY — CPS 234 para 21. Redaction reduces what is disclosed and does not prevent identification. Do not present the redact-and-forward path to an assessor as de-identification.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-query-channel-residual-risk";
      description:"DOCUMENTATION ONLY — CPS 234 para 21. A returned query is an information channel: an adversary who can shape queries and observe results across turns can extract values a piece at a time, and small aggregates can reconstruct records. Bounding this is NC1.10, which is partial.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-encryption-at-rest";
      description:"UNIMPLEMENTED X8 — CPS 234 para 21. The database is plaintext on disk because the toolchain has no SQLCipher. Only the placeholder mapping table is sealed, field by field (X8.2). An entity should treat whole-store encryption as missing.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-preset-not-enforced";
      description:"UNIMPLEMENTED RG1.1 — CPS 234 para 21. Para 21 asks for controls that are implemented. Nothing on loke's request path calls core.policy.loader.evaluate, so the EVALUABLE rules in this preset describe controls the policy code can decide and do not yet act on traffic.";
      action:"log";
      severity:"critical"
    };

    (* Incident management, paras 23 to 26. *)
    $policyrule{
      id:"cps234-detection-fails-closed";
      description:"DOCUMENTATION ONLY — CPS 234 para 23. loke's privacy pipeline fails closed when no detection layer is healthy (NC1.9, tests/unit/privacy/test_fail_closed.tk) whatever preset is selected, and the kill switch writes an audit event when it is engaged. No field of this preset controls either.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-incident-triggers";
      description:"DOCUMENTATION ONLY — CPS 234 para 23, para 25. Conditions the entity's detection mechanisms should treat as candidate incidents: a restricted asset reaching an external provider, a provider used without a recorded assessment, a detection layer unavailable, a credential outbound, traffic reaching a provider without transiting loke. Whether one is an incident, and its escalation, is the entity's response plan.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps234-response-plans";
      description:"DOCUMENTATION ONLY — CPS 234 para 24, para 25, para 26. NOT DISCHARGEABLE BY LOKE: response plans for plausible incidents, covering detection to post-incident review and escalation to the Board, reviewed and tested annually, are the entity's.";
      action:"log";
      severity:"medium"
    };

    (* Testing control effectiveness, paras 27 to 31. *)
    $policyrule{
      id:"cps234-control-testing";
      description:"DOCUMENTATION ONLY — CPS 234 para 27, para 29, para 31. The entity's systematic testing program must cover loke as a control, with deficiencies that cannot be remediated in time escalated to the Board or senior management. loke's own test suite is input to that program and is not the program.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-untrusted-environment";
      description:"DOCUMENTATION ONLY — CPS 234 para 27. Para 27(d) ties testing frequency to exposure to environments where the entity cannot enforce its policies. An external model provider is such an environment, which is an argument for testing the forward path more often than the local one.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-independent-testing";
      description:"DOCUMENTATION ONLY — CPS 234 para 30. Testing must be conducted by appropriately skilled and functionally independent specialists. Tests written by loke's developers are not functionally independent of loke.";
      action:"log";
      severity:"medium"
    };

    (* Internal audit, paras 32 to 34. *)
    $policyrule{
      id:"cps234-internal-audit";
      description:"DOCUMENTATION ONLY — CPS 234 para 32, para 33, para 34. NOT DISCHARGEABLE BY LOKE: internal audit's review of the design and operating effectiveness of controls, including those a third party maintains, is the entity's. loke can supply records for review and cannot conduct it.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps234-audit-evidence";
      description:"DOCUMENTATION ONLY — CPS 234 para 32. The records loke can supply: an audit row per browser request (GA1.4), hash-chained with chain verification (GA5.2, GA5.3), and a disclosure_log row per external dispatch (DA1.3). Prompt content is deliberately not retained, so the records evidence that a request occurred and how it was classified, not what it said.";
      action:"log";
      severity:"high"
    };

    (* APRA notification, paras 35 and 36. *)
    $policyrule{
      id:"cps234-notify-apra-incident";
      description:"DOCUMENTATION ONLY — CPS 234 para 35. NOT DISCHARGEABLE BY LOKE: APRA must be notified as soon as possible and no later than 72 hours after the entity becomes aware of an information security incident that materially affected, or could have, the entity or its customers, or that was notified to another regulator. The obligation is the entity's; loke records and surfaces only.";
      action:"log";
      severity:"critical"
    };
    $policyrule{
      id:"cps234-notify-apra-control-weakness";
      description:"DOCUMENTATION ONLY — CPS 234 para 36. NOT DISCHARGEABLE BY LOKE: APRA must be notified as soon as possible and no later than 10 business days after the entity becomes aware of a material information security control weakness it expects not to remediate in a timely manner. The UNIMPLEMENTED rules in this preset are candidates for that assessment.";
      action:"log";
      severity:"critical"
    };

    (* Commencement and the limits of the preset. *)
    $policyrule{
      id:"cps234-commencement";
      description:"DOCUMENTATION ONLY — CPS 234 para 5, para 6. In force from 1 July 2019; for assets a third party manages, from the earlier of the next contract renewal or 1 July 2020. Both dates have passed, so the standard applies in full to any model provider.";
      action:"log";
      severity:"low"
    };
    $policyrule{
      id:"cps234-entity-review-required";
      description:"DOCUMENTATION ONLY — CPS 234 para 13. This preset is a starting point and makes no compliance determination. loke cannot perform the third-party assessment, notify APRA, substitute for internal audit or carry the Board's accountability. Have the mapping reviewed by the entity's own risk function.";
      action:"log";
      severity:"high"
    }
  )
};

f=blockingstories():@str{
  <@("RG1.1";"RG1.7";"X8";"NC1.10")
};

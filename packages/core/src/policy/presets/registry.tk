m=core.policy.presets.registry;
i=s:core.policy.schema;
i=ty:core.policy.types;
i=str:std.str;
i=time:std.time;
i=gdpr:core.policy.presets.gdpr;
i=hipaa:core.policy.presets.hipaa;
i=ccpa:core.policy.presets.ccpa;
i=au:core.policy.presets.auprivacy;
i=rest:core.policy.presets.remaining;
i=cps234:core.policy.presets.apracps234;
i=cps230:core.policy.presets.apracps230;

f=names():@str{
  <@(
    "eu-gdpr";
    "au-privacy";
    "hipaa";
    "ccpa";
    "uk-gdpr";
    "sg-pdpa";
    "minimal";
    "eu-ai-act";
    "colorado-ai";
    "apra-cps-234";
    "apra-cps-230"
  )
};

(* The not-found value is a sentinel struct plus a predicate, not an error side. T-18: a
   match on an X!$err with a user-declared error side always takes the first arm, so an
   $err: arm here would be dead code and every unknown name would be reported as a
   successfully loaded policy. Same shape as core.storage.settings.getstror and
   core.router.selector.selectmodel plus isselected. *)
f=unknown():$policy{
  <$policy{
    version:"1.0";
    name:"";
    description:"no preset is registered under that name";
    source:"builtin:unknown";
    priority:0;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@();
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:0;conversationdays:0;piimappingdays:0;cachedays:0};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@();
    crossborderallowed:false;
    requireapprovalabove:"public";
    customrules:@()
  }
};

f=isknown(p:$policy):bool{
  <!str.eq(p.source;"builtin:unknown")
};

f=hasname(name:str):bool{
  let found=mut.false;
  let all=names();
  let i=mut.0;
  lp(let lv2=0;i<all.len;lv2=lv2){
    if(str.eq(all.get(i);name)){found=true}el{};
    i=i+1
  };
  <found
};

f=byname(name:str):$policy{
  let p=mut.unknown();
  if(str.eq(name;"eu-gdpr")){p=gdpr.preset()}el{};
  if(str.eq(name;"au-privacy")){p=au.preset()}el{};
  if(str.eq(name;"hipaa")){p=hipaa.preset()}el{};
  if(str.eq(name;"ccpa")){p=ccpa.preset()}el{};
  if(str.eq(name;"uk-gdpr")){p=rest.ukgdpr()}el{};
  if(str.eq(name;"sg-pdpa")){p=rest.singaporepdpa()}el{};
  if(str.eq(name;"minimal")){p=rest.minimal()}el{};
  if(str.eq(name;"eu-ai-act")){p=rest.euaiact()}el{};
  if(str.eq(name;"colorado-ai")){p=rest.coloradoaiact()}el{};
  if(str.eq(name;"apra-cps-234")){p=cps234.preset()}el{};
  if(str.eq(name;"apra-cps-230")){p=cps230.preset()}el{};
  <p
};

(* Scalar accessors so a consumer can read the two settings it can act on without pulling
   core.policy.schema into its own scope. core.governance.rulesengine needs exactly these
   two and nothing else; importing schema there would put $anonymisationrule.action at
   offset 1 alongside $compoundrule.action at offset 4 and $evalresult.action at offset 2,
   which is the E4034 shape that breaks an unrelated module. *)
f=approvalthresholdfor(name:str):str{
  let p:$policy=byname(name);
  <p.requireapprovalabove
};

f=crossborderallowedfor(name:str):bool{
  let p:$policy=byname(name);
  <p.crossborderallowed
};

f=isknownname(name:str):bool{
  let p:$policy=byname(name);
  <isknown(p)
};

f=rulesfor(name:str):@$policyrule{
  let rs=mut.@();
  if(str.eq(name;"eu-gdpr")){rs=gdpr.rules()}el{};
  if(str.eq(name;"au-privacy")){rs=au.rules()}el{};
  if(str.eq(name;"hipaa")){rs=hipaa.rules()}el{};
  if(str.eq(name;"ccpa")){rs=ccpa.rules()}el{};
  if(str.eq(name;"uk-gdpr")){rs=rest.ukgdprrules()}el{};
  if(str.eq(name;"sg-pdpa")){rs=rest.singaporepdparules()}el{};
  if(str.eq(name;"minimal")){rs=rest.minimalrules()}el{};
  if(str.eq(name;"eu-ai-act")){rs=rest.euaiactrules()}el{};
  if(str.eq(name;"colorado-ai")){rs=rest.coloradoaiactrules()}el{};
  if(str.eq(name;"apra-cps-234")){rs=cps234.rules()}el{};
  if(str.eq(name;"apra-cps-230")){rs=cps230.rules()}el{};
  <rs
};

(* $policy carries no jurisdiction field and $regulation requires one, so the mapping lives
   here rather than being derived from the preset name by string surgery. Each value is the
   jurisdiction its own source document states. *)
f=jurisdictionfor(name:str):str{
  let j=mut."";
  if(str.eq(name;"eu-gdpr")){j="EU"}el{};
  if(str.eq(name;"au-privacy")){j="AU"}el{};
  if(str.eq(name;"hipaa")){j="US"}el{};
  if(str.eq(name;"ccpa")){j="US-CA"}el{};
  if(str.eq(name;"uk-gdpr")){j="UK"}el{};
  if(str.eq(name;"sg-pdpa")){j="SG"}el{};
  if(str.eq(name;"minimal")){j="none"}el{};
  if(str.eq(name;"eu-ai-act")){j="EU"}el{};
  if(str.eq(name;"colorado-ai")){j="US-CO"}el{};
  if(str.eq(name;"apra-cps-234")){j="AU"}el{};
  if(str.eq(name;"apra-cps-230")){j="AU"}el{};
  <j
};

(* $regulation and $policyset are the shapes core.policy.loader already evaluates against.
   They are a derived VIEW of a preset, not a second source of truth: the preset owns the
   configuration and the rule list, and this projects them into the loader's types. The
   module this replaces, core.policy.regulations, held a parallel hand-written copy of the
   same six regulations and had drifted — its ukgdpr() was a verbatim duplicate of gdpr(),
   gdpr- rule ids and EU adequacy text included, under jurisdiction UK. *)
f=regulationfor(name:str):$regulation{
  let p:$policy=byname(name);
  <$regulation{
    name:p.name;
    jurisdiction:jurisdictionfor(name);
    rules:rulesfor(name);
    version:p.version
  }
};

f=policysetfor(name:str):$policyset{
  <$policyset{
    name:name;
    source:str.concat("builtin:preset:";name);
    regulations:@(regulationfor(name));
    loadedat:time.nowms();
    hash:""
  }
};

f=policysetformany(wanted:@str):$policyset{
  let regs=mut.@();
  let i=mut.0;
  lp(let lv=0;i<wanted.len;lv=lv){
    let one=wanted.get(i);
    if(hasname(one)){
      regs=regs.push(regulationfor(one))
    }el{};
    i=i+1
  };
  <$policyset{
    name:"loke-presets";
    source:"builtin:preset";
    regulations:regs;
    loadedat:time.nowms();
    hash:""
  }
};

f=defaultset():$policyset{
  <policysetformany(names())
};

f=allregulations():@$regulation{
  let ps:$policyset=defaultset();
  <ps.regulations
};

m=core.policy.presets.apracps230;
i=s:core.policy.schema;
i=ty:core.policy.types;

f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"APRA CPS 230 — Operational Risk Management";
    description:"Preset shaped by Prudential Standard CPS 230 for APRA-regulated entities. Treats an external model provider as a candidate material service provider, denies it until registered and assessed, and prefers local execution so an outage degrades capability rather than stopping an operation. Not compliance: the framework is the entity's.";
    source:"builtin:apra-cps-230";
    priority:100;
    classificationdefault:"confidential";
    providers:@(
      $providerpermission{
        providerid:"local";
        allowed:true;
        maxsensitivity:"restricted";
        requiresdpa:false;
        notes:"On-device inference is not a service provider, so no register entry and no assessment. It is the substitute that makes a provider outage survivable and therefore the continuity control this preset relies on. UNVALIDATED on target hardware: the tiered-inference stories are marked complete and have never run on an Apple Silicon machine, epic LC1. An untested fallback should not be presented to an assessor as a continuity control."
      };
      $providerpermission{
        providerid:"*";
        allowed:false;
        maxsensitivity:"confidential";
        requiresdpa:true;
        notes:"Denied until a register entry exists with a current assessment, a recorded materiality determination, a recorded exit plan and recorded substitutability. loke has no service-provider register, so none of those four can be checked by the machine."
      }
    );
    anonymisation:@(
      $anonymisationrule{entitytype:"tfn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medicare";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bsb";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bank_account";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"credit_card";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"api_key";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"password";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"abn";action:"anonymise";strength:"reasonable";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:500.0;actiononexceed:"block"};
    retention:$retentionpolicy{auditlogdays:2555;conversationdays:0;piimappingdays:1;cachedays:0};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("tfn";"medicare";"bsb";"bank_account";"credit_card";"api_key";"password";"health";"biometric");
    crossborderallowed:false;
    requireapprovalabove:"confidential";
    customrules:@(
      "no_custody_default_path";
      "service_provider_denied_until_registered_and_assessed";
      "materiality_determined_by_the_entity";
      "exit_plan_required_per_provider";
      "substitutability_recorded_per_provider";
      "model_version_pinning_required";
      "degrade_to_local_on_provider_unavailable";
      "fail_visibly_on_local_unavailable";
      "local_request_ratio_warn_below_20_percent";
      "unimplemented_service_provider_register";
      "unimplemented_disruption_measurement_da1_2_da1_3";
      "unvalidated_local_degraded_mode_lc1";
      "unimplemented_at_rest_encryption_x8";
      "unimplemented_fail_closed_nc1_9";
      "entity_review_required_before_adoption"
    )
  }
};

f=rules():@$policyrule{
  <@(
    $policyrule{
      id:"cps230-critical-operations-declared-by-entity";
      description:"NOT DISCHARGEABLE BY LOKE — critical_operations.declared_by_entity — The entity identifies its critical operations and sets tolerance levels for maximum period of disruption, maximum data loss and minimum service level. loke cannot know them, so the entries list is deliberately empty rather than guessed at.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-assume-critical-until-declared";
      description:"critical_operations.default_assumed_critical — Until an operation is declared, any loke use case is treated as supporting one, because an undeclared operation is more likely to be an omission than a genuine absence.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps230-tolerances-recorded-not-enforced";
      description:"NOT ENFORCEABLE BY LOKE — critical_operations.entry_schema tolerance fields — Tolerance levels can be recorded but not enforced, because loke does not control the provider.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-provider-denied-until-registered";
      description:"service_providers.default_action — Every external provider is denied until a register entry exists with a current assessment and a recorded materiality determination.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps230-materiality-determined-by-entity";
      description:"NOT DISCHARGEABLE BY LOKE — service_providers.materiality_test — Whether a provider supports a critical operation, or would materially affect operations, risk profile or customer obligations, is the entity's determination and must be recorded.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-service-provider-register";
      description:"UNIMPLEMENTED — service_providers.register — loke has no service-provider register. The eighteen fields the standard needs, from legal entity through residency, training use, subprocessors, exit plan, substitutability and review date, describe what one must carry; nothing maintains it.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-local-degraded-mode";
      description:"UNVALIDATED LC1 — service_providers.providers local.validation_status — Local inference is the primary degraded mode and the continuity control this preset relies on, and it has never been run on target Apple Silicon hardware. A continuity control that has never been exercised must not be presented as one.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps230-exit-plan-recorded";
      description:"service_providers.providers conditions and exit_plan.required_per_provider — A provider may not be used without a recorded exit plan naming what data it holds, how deletion is evidenced, the substitute, the period to switch and the capability lost on switching.";
      action:"block";
      severity:"high"
    };
    $policyrule{
      id:"cps230-substitutability-recorded";
      description:"service_providers.register.substitutability — Whether an alternative exists, and how quickly it could be switched to, must be recorded per provider.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-local-ratio-concentration";
      description:"UNIMPLEMENTED DA1.2 and DA1.3 — service_providers.concentration — If fewer than 0.20 of requests can be served locally the dependency is concentrated and the exit and continuity positions should be re-examined. Nothing measures the ratio today, so the warning cannot fire.";
      action:"warn";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-fourth-party-disclosure";
      description:"service_providers.fourth_party — A provider's own subprocessors are in scope. An entity cannot assess a dependency it cannot see, and model providers commonly use infrastructure subprocessors across jurisdictions.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps230-degrade-to-local";
      description:"disruption.on_provider_unavailable — When a provider is unavailable, requests are served by local inference: a reduction in capability rather than a stop. That is the continuity control, and it is the real one.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-fail-visibly";
      description:"disruption.on_local_unavailable — When local inference is also unavailable the request fails visibly. Never silently queue and forget: an operation that appears to work and has not is worse for an operational-risk assessment than one that visibly fails.";
      action:"block";
      severity:"high"
    };
    $policyrule{
      id:"cps230-degraded-mode-surfaced";
      description:"disruption.degraded_mode.must_surface_to_user — Reduced capability, a smaller model and higher latency are surfaced to the user rather than hidden, so the operation can be assessed against its tolerance, and the entry is recorded in the ledger.";
      action:"warn";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-in-flight-analysis-survives";
      description:"disruption.in_flight_analysis — An artifact already returned executes locally against local data, so an analysis in progress survives a provider outage. This is a genuine continuity property of the no-custody path.";
      action:"log";
      severity:"low"
    };
    $policyrule{
      id:"cps230-disruption-measurement";
      description:"UNIMPLEMENTED DA1.2 and DA1.3 — disruption.measurement — Tolerance cannot be assessed without measurement of provider availability, latency, failure count, degraded-mode entries and duration, and requests served locally. Nothing calls the metrics collector and the metrics table has no migration, so there is no disruption record at all. An entity should treat that as blocking.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-disruption-notification";
      description:"NOT DISCHARGEABLE BY LOKE — disruption.notification — APRA must be notified of material service provider arrangements and of disruptions outside tolerance. The obligation rests with the APRA-regulated entity; loke surfaces the trigger only.";
      action:"warn";
      severity:"critical"
    };
    $policyrule{
      id:"cps230-no-custody-simplifies-exit";
      description:"disclosure.rationale — On the no-custody path the provider holds nothing, so the impact of a provider compromise is bounded to the schema and exit requires no deletion or repatriation. Do not claim this makes the entity independent of its provider: a no-custody request still needs the provider reachable to return an artifact.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-forward-creates-exit-obligation";
      description:"disclosure.redact_and_forward.operational_consequence — Data held by a provider must be covered by the exit plan: what is deleted, by when, and how deletion is evidenced. Choosing this path creates an exit obligation that no-custody does not.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps230-fail-closed";
      description:"UNIMPLEMENTED NC1.9 — disclosure.fail_closed — When no detection layer is healthy the request must fail rather than proceed. loke currently fails OPEN, so this control is aspirational and an entity must not rely on it.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps230-provider-change-reassessment";
      description:"change_management.provider_change_requires_reassessment — A change of provider requires the assessment and the register entry to be redone.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps230-model-version-pinning";
      description:"change_management.model_version_pinning — An unpinned model can change behaviour without notice, which is an operational risk and destroys reproducibility of any evidence produced against it. Pin the version and record it in the ledger.";
      action:"warn";
      severity:"high"
    };
    $policyrule{
      id:"cps230-deprecation-watch";
      description:"change_management.deprecation_watch — A provider deprecating a model is an availability event with a date, and a silently updated model is a behaviour change. Both are routinely treated as invisible.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-encryption-at-rest";
      description:"UNIMPLEMENTED X8 — retention.at_rest_encryption — The encryption pragma is ignored by the underlying database, so the interaction ledger and the disruption record are plaintext on disk.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps230-disruption-record-retention";
      description:"NOT EXPRESSIBLE IN LOKE — retention.disruption_record_days — The standard retains the disruption record for 2555 days alongside the interaction ledger. loke's retention policy has one audit-log period and no separate disruption-record period, so only the ledger figure is carried.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-budget-tolerance-blocks";
      description:"budget_limits.rationale — An uncapped spend on a material service provider is an unbounded operational exposure. A tolerance limit that is not enforced is not a tolerance limit, so exceeding it blocks rather than warns.";
      action:"block";
      severity:"high"
    };
    $policyrule{
      id:"cps230-entity-review-required";
      description:"metadata.requires_entity_review and cannot_discharge — loke cannot identify critical operations, set tolerance levels, maintain the service-provider register, notify APRA, or own the business continuity plan and its testing. It can be a control within the entity's framework; it cannot be the framework.";
      action:"log";
      severity:"high"
    }
  )
};

f=blockingstories():@str{
  <@("DA1.2";"DA1.3";"LC1";"X8";"NC1.9")
};

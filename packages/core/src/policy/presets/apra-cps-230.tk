m=core.policy.presets.apracps230;
i=s:core.policy.schema;
i=ty:core.policy.types;

(* APRA Prudential Standard CPS 230 Operational Risk Management. Two instruments matter, both
   read 2026-10-01 on the Federal Register of Legislation:
     F2023L01242  determination No. 2 of 2023, made 11 September 2023, in force from 1 July
                  2025, varied by F2024L01107 (30 August 2024), which gave pre-existing
                  service-provider contracts until the earlier of renewal or 1 July 2026 and
                  deferred some continuity paragraphs for non-SFIs to 1 July 2026.
     F2026L00475  determination No. 1 of 2026, made 23 April 2026, which revokes the 2023
                  instrument and remakes the standard, in force from 1 July 2026 (para 6).
   The paragraph numbers cited here are the 2026 instrument's, the one in force today. The
   2023 text numbered the same requirements one higher from 2026 para 7 to para 56 (it had a
   transitional para 7), and one lower for 2026 para 59 to para 61; 2026 para 57 and para 58,
   the exemption for standardised terms with listed provider categories, are new.

   The classes are the same as the CPS 234 preset's: EVALUABLE (a field of this preset that
   loke's policy code reads, asserted by the test), DOCUMENTATION ONLY (always log), and
   UNIMPLEMENTED (with the story that would close it). Evaluable is not enforced: nothing on
   the request path calls core.policy.loader.evaluate. Cross-references to other standards
   are written "paragraph N" so the test's citation check counts only CPS 230. *)
f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"APRA CPS 230 — Operational Risk Management";
    description:"Preset shaped by Prudential Standard CPS 230 (the 2026 instrument, in force 1 July 2026; first in force 1 July 2025) for APRA-regulated entities. Treats an external model provider as a candidate material service provider, denies it until the entity has done the para 52 due diligence, keeps external scope off until the para 60 offshoring question is answered, and permits local inference as a substitute. Not compliance: the framework is the entity's, and this preset is not yet enforced on the request path.";
    source:"builtin:apra-cps-230";
    priority:100;
    classificationdefault:"confidential";
    providers:@(
      $providerpermission{
        providerid:"local";
        allowed:true;
        maxsensitivity:"restricted";
        requiresdpa:false;
        notes:"On-device inference is not a service provider, so no register entry and no due diligence. It is the substitute an exit or a disruption would fall back to. UNVALIDATED: local inference has never been run on target Apple Silicon hardware (LC1, blocked on hardware). Since RG1.8 (2026-10-06) a request first routed to a cloud provider that fails is retried on a local model, but no tolerance is checked against the disruptions it records. Do not present it to an assessor as a tested continuity arrangement."
      };
      $providerpermission{
        providerid:"*";
        allowed:false;
        maxsensitivity:"confidential";
        requiresdpa:true;
        notes:"Denied until the entity has decided materiality (para 48, para 49), done due diligence (para 52), put a formal agreement in place where para 53 and para 54 require one, and planned an exit (para 55). loke has no service-provider register, so none of that can be checked by the machine; an operator flipping allowed is asserting it was done."
      }
    );
    anonymisation:@(
      $anonymisationrule{entitytype:"tfn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medicare";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bsb";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bank_account";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"credit_card";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"api_key";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"password";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"abn";action:"anonymise";strength:"reasonable";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:500.0;actiononexceed:"block"};
    (* CPS 230 sets no retention period. 2555 days is the YAML's figure, carried as the audit
       log period; the policy schema has no separate disruption-record period. *)
    retention:$retentionpolicy{auditlogdays:2555;conversationdays:0;piimappingdays:1;cachedays:0};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("tfn";"medicare";"bsb";"bank_account";"credit_card";"api_key";"password";"health";"biometric");
    crossborderallowed:false;
    requireapprovalabove:"confidential";
    customrules:@(
      "cps230_2026_instrument_in_force_2026_07_01_para_6";
      "cps230_first_in_force_2025_07_01_f2023l01242";
      "cps230_para_48_material_service_provider_determined_by_entity";
      "cps230_para_52_provider_denied_until_due_diligence";
      "cps230_para_55_exit_plan_required_per_provider";
      "cps230_para_60_external_scope_off_until_offshoring_answered";
      "cps230_para_15_budget_limit_blocks";
      "unimplemented_preset_not_enforced_on_request_path";
      "unimplemented_service_provider_register";
      "unimplemented_tolerance_measurement";
      "unimplemented_degrade_to_local_rg1_8";
      "unvalidated_local_inference_lc1";
      "unimplemented_at_rest_encryption_x8";
      "entity_review_required_before_adoption"
    )
  }
};

f=rules():@$policyrule{
  <@(
    (* Framework, accountability and operational risk, paras 11 to 30. *)
    $policyrule{
      id:"cps230-operational-risk-framework";
      description:"DOCUMENTATION ONLY — CPS 230 para 11, para 12, para 15, para 16, para 17. The entity must identify, assess and manage operational risk within a framework of governance, a risk profile with appetite and tolerance levels, internal controls, monitoring, business continuity plans and service-provider processes, reviewed with the risk management framework. loke is a control inside that framework; it cannot be the framework.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-board-accountability";
      description:"DOCUMENTATION ONLY — CPS 230 para 19, para 20, para 21, para 22. NOT DISCHARGEABLE BY LOKE: the Board is ultimately accountable for operational risk management, including continuity and service providers, approves the BCP, tolerance levels and the service provider management policy, and must be told how decisions affect critical operations.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-technology-risk";
      description:"DOCUMENTATION ONLY — CPS 230 para 23, para 24. Technology, data and change management risk are operational risks, and para 24 requires the entity to meet CPS 234 for information security. Select the apra-cps-234 preset alongside this one. loke's privacy pipeline fails closed when no detection layer is healthy (NC1.9) whatever preset is selected.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-new-technology-assessment";
      description:"DOCUMENTATION ONLY — CPS 230 para 25, para 26. Adopting a model provider is a new technology whose impact on the operational risk profile must be assessed, and the entity must document the people, technology, information and service providers each critical operation needs, with scenario analysis of severe events. A provider outage is such a scenario.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-controls-tested";
      description:"DOCUMENTATION ONLY — CPS 230 para 28, para 29, para 30. Controls must be designed, embedded, tested for design and operating effectiveness, and their gaps remediated and held in the risk profile until closed. The UNIMPLEMENTED rules in this preset are such gaps and belong in that profile.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-preset-not-enforced";
      description:"UNIMPLEMENTED RG1.2 — CPS 230 para 28. Para 28 asks for controls that are implemented and embedded. Nothing on loke's request path calls core.policy.loader.evaluate, so the EVALUABLE rules in this preset describe controls the policy code can decide and do not yet act on traffic.";
      action:"log";
      severity:"critical"
    };

    (* Incidents and notification, paras 31 and 32. *)
    $policyrule{
      id:"cps230-incidents-recorded";
      description:"DOCUMENTATION ONLY — CPS 230 para 31. Operational risk incidents and near misses must be identified, escalated, recorded and addressed. loke's per-request audit rows (GA1.4) and per-dispatch disclosure_log rows (DA1.3) are records the entity's incident process can draw on; deciding what is an incident is the entity's.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-notify-apra-incident";
      description:"DOCUMENTATION ONLY — CPS 230 para 32. NOT DISCHARGEABLE BY LOKE: APRA must be notified as soon as possible and not later than 72 hours after the entity becomes aware of an operational risk incident likely to have a material financial impact or a material impact on its critical operations. Footnote 11: an incident already notified under CPS 234 need not be notified again.";
      action:"log";
      severity:"critical"
    };

    (* Business continuity, paras 33 to 45. *)
    $policyrule{
      id:"cps230-critical-operations-declared-by-entity";
      description:"DOCUMENTATION ONLY — CPS 230 para 33, para 34, para 37. NOT DISCHARGEABLE BY LOKE: the entity keeps the register of critical operations and sets, for each, the maximum period of disruption, the maximum data loss and the minimum service level. loke cannot know them, so this preset declares none rather than guess.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-assume-critical-until-declared";
      description:"DOCUMENTATION ONLY — CPS 230 para 35. Customer enquiries, and the systems and infrastructure that support critical operations, are critical operations for every entity unless it can justify otherwise. A loke deployment that sits in such a path is therefore in scope by default.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-tolerances-not-measured";
      description:"UNIMPLEMENTED RG1.2 — CPS 230 para 37, para 40. Para 40 requires the entity to monitor compliance with its tolerance levels. The policy schema has no tolerance fields and nothing compares a provider disruption against one. Per-dispatch records exist (DA1.2, DA1.3); a tolerance check over them does not.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-bcp-owned-by-entity";
      description:"DOCUMENTATION ONLY — CPS 230 para 39, para 42, para 43, para 44, para 45. NOT DISCHARGEABLE BY LOKE: the BCP, its triggers and actions, a systematic testing program with an annual exercise whose scenarios include disruption of material service providers, its annual update, and internal audit's assurance on it, are the entity's.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-degrade-to-local";
      description:"UNIMPLEMENTED RG1.8 — CPS 230 para 33, para 40, para 55. Local inference could be the alternative arrangement that keeps an operation within tolerance when a provider fails, and the capability to execute it must be maintained. The path exists since RG1.8 (2026-10-06): a chain first routed to a cloud model ends with a local model, tried when every cloud hop fails, the reply is marked degraded, and each provider disruption's entry and exit are written to audit_log. The RULE is unimplemented: no field of this preset turns the path on or off, and no tolerance is configured or compared with a recorded disruption. UNVALIDATED as well: local inference has never been run on target hardware (LC1).";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-fail-visibly";
      description:"DOCUMENTATION ONLY — CPS 230 para 13, para 31. When no model can serve a request it must fail visibly rather than queue silently, so a disruption can be recognised, recorded and measured against tolerance. No field of this preset controls that behaviour.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-notify-apra-disruption";
      description:"DOCUMENTATION ONLY — CPS 230 para 41. NOT DISCHARGEABLE BY LOKE: APRA must be notified as soon as possible and not later than 24 hours after a disruption to a critical operation outside tolerance, with its nature, the action taken, the likely impact and the timeframe for return to normal.";
      action:"log";
      severity:"critical"
    };

    (* Service providers, paras 46 to 61. A model provider a critical operation relies on is
       a material service provider under para 48, and core technology services are material
       by default under para 49 unless the entity justifies otherwise. *)
    $policyrule{
      id:"cps230-provider-denied-until-registered";
      description:"EVALUABLE — CPS 230 para 14, para 48, para 52. Every external provider is denied (providers entry * has allowed false and requiresdpa true). Para 14 forbids relying on a provider unless the entity can still meet its prudential obligations, and para 52 requires due diligence before a material arrangement is entered.";
      action:"block";
      severity:"critical"
    };
    $policyrule{
      id:"cps230-local-substitute-permitted";
      description:"EVALUABLE — CPS 230 para 47, para 55. Local inference is permitted up to restricted, so a substitute exists to exit to (the local provider entry). Whether loke actually falls back to it is cps230-degrade-to-local, which is unimplemented.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-budget-tolerance-blocks";
      description:"EVALUABLE — CPS 230 para 15. A risk appetite supported by limits: monthly spend on external providers is capped and exceeding the cap blocks rather than warns (budget actiononexceed block).";
      action:"block";
      severity:"high"
    };
    $policyrule{
      id:"cps230-offshoring-denied";
      description:"EVALUABLE — CPS 230 para 60. APRA must be notified before a material offshoring arrangement, including where data relevant to the service will be held offshore. loke cannot see where a provider processes, so external scope as a whole is off (crossborderallowed false) and the rules engine derives the apra-cps-230-no-cross-border deny from it.";
      action:"block";
      severity:"high"
    };
    $policyrule{
      id:"cps230-materiality-determined-by-entity";
      description:"DOCUMENTATION ONLY — CPS 230 para 48, para 49. NOT DISCHARGEABLE BY LOKE: whether a model provider is material, because a critical operation relies on it or it exposes the entity to material operational risk, is the entity's determination. Para 49 makes core technology services material by default.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-service-provider-register";
      description:"UNIMPLEMENTED RG1.2 — CPS 230 para 48, para 50. The entity must keep a register of material service providers and submit it to APRA annually. loke has no register and the policy schema has no field for one.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-service-provider-policy";
      description:"DOCUMENTATION ONLY — CPS 230 para 46, para 47. The entity's service provider management policy must cover entering, monitoring, substituting and exiting material arrangements and the fourth parties they rely on. This preset is an input to that policy.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-fourth-party-disclosure";
      description:"DOCUMENTATION ONLY — CPS 230 para 47, para 52, para 53. A model provider's own subprocessors are fourth parties (footnote 14). Due diligence covers the location and concentration of the parties a provider relies on, and the formal agreement must require the provider to notify its material sub-contracting.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-due-diligence-and-agreement";
      description:"DOCUMENTATION ONLY — CPS 230 para 52, para 53, para 54. NOT DISCHARGEABLE BY LOKE: due diligence before entering or materially modifying a material arrangement, and a formal agreement covering service levels, ownership and control of data, audit access, sub-contractor liability, termination, and APRA's access to information and premises.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-standardised-terms-no-exemption";
      description:"DOCUMENTATION ONLY — CPS 230 para 57, para 58. The relief from the formal-agreement requirements for standardised terms applies only to the provider categories in the Attachment: government agencies, regulators, central banks, exchanges, clearing and settlement, payment systems and financial messaging. A model provider's click-through terms are not in that list, so only a written APRA exemption under para 58 removes the requirement.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-exit-plan-recorded";
      description:"DOCUMENTATION ONLY — CPS 230 para 47, para 55. For each material arrangement the entity must be able to execute its BCP and exit in an orderly way: what the provider holds, how deletion is evidenced, the substitute, the time to switch and the capability lost. The policy schema has no exit-plan field; the provider deny is the evaluable part.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-no-custody-simplifies-exit";
      description:"DOCUMENTATION ONLY — CPS 230 para 55. On the no-custody path the provider is sent a schema profile and intent rather than data values, so an exit plan has less to cover. It does not remove the dependency: a no-custody request still needs the provider reachable to return an artifact.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-provider-concentration";
      description:"UNIMPLEMENTED RG1.2 — CPS 230 para 52. Due diligence must assess concentration risk. The share of requests served locally rather than by one provider is the measurable form of it for loke, and nothing computes it from the per-dispatch records.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-provider-change-reassessment";
      description:"DOCUMENTATION ONLY — CPS 230 para 52, para 60. Materially modifying an arrangement, including a change of provider, repeats the due diligence, and an agreement for a service a critical operation relies on must be notified to APRA.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-model-version-pinning";
      description:"DOCUMENTATION ONLY — CPS 230 para 23, para 59. Change management risk is named in para 23, and para 59 requires monitoring of performance under the arrangement. An unpinned or silently updated model changes behaviour without notice, and a deprecated one is an availability event with a date: pin the version and record it.";
      action:"log";
      severity:"high"
    };
    $policyrule{
      id:"cps230-monitoring";
      description:"DOCUMENTATION ONLY — CPS 230 para 59. Senior management must receive reporting on material arrangements, assessing performance against service levels, control effectiveness and compliance with the agreement. loke's disclosure_log rows record each external dispatch and are input to that reporting.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-notify-apra-material-arrangement";
      description:"DOCUMENTATION ONLY — CPS 230 para 60. NOT DISCHARGEABLE BY LOKE: APRA must be notified within 20 business days of entering into or materially changing an agreement for a service a critical operation relies on, and before entering any material offshoring arrangement.";
      action:"log";
      severity:"critical"
    };
    $policyrule{
      id:"cps230-internal-audit";
      description:"DOCUMENTATION ONLY — CPS 230 para 45, para 61. NOT DISCHARGEABLE BY LOKE: internal audit reviews the BCP and any proposed material arrangement that outsources a critical operation, and reports to the Board on compliance with the service provider management policy.";
      action:"log";
      severity:"medium"
    };
    $policyrule{
      id:"cps230-encryption-at-rest";
      description:"UNIMPLEMENTED X8 — CPS 230 para 24. Para 24 requires the information security CPS 234 sets. The database is plaintext on disk because the toolchain has no SQLCipher; only the placeholder mapping table is sealed (X8.2).";
      action:"block";
      severity:"critical"
    };

    (* Commencement and the limits of the preset. *)
    $policyrule{
      id:"cps230-commencement";
      description:"DOCUMENTATION ONLY — CPS 230 para 6. The standard first commenced on 1 July 2025 (F2023L01242). APRA remade it by determination No. 1 of 2026 (F2026L00475), in force from 1 July 2026; the paragraph numbers in this preset are that instrument's. The 2024 variation's transition for pre-existing contracts and for non-SFIs ended on 1 July 2026.";
      action:"log";
      severity:"low"
    };
    $policyrule{
      id:"cps230-entity-review-required";
      description:"DOCUMENTATION ONLY — CPS 230 para 19. This preset is a starting point and makes no compliance determination. loke cannot identify critical operations, set tolerance levels, keep the service-provider register, notify APRA, or own the BCP and its testing. Have the mapping reviewed by the entity's own risk function.";
      action:"log";
      severity:"high"
    }
  )
};

f=blockingstories():@str{
  <@("RG1.2";"RG1.8";"LC1";"X8")
};

m=core.policy.presets.auprivacy;
i=s:core.policy.schema;
i=ty:core.policy.types;

(* RG1.3. The Australian Privacy Act 1988 (Cth) and the Australian Privacy Principles, with the
   reforms made by the Privacy and Other Legislation Amendment Act 2024 (No. 128, 2024), and
   the proposed second tranche recorded apart from them.

   What is ENACTED and what is PROPOSED is carried in each rule's id and description, because a
   preset that states a proposal as law would direct a deployment to obligations it does not
   have, and one that omits enacted law would hide ones it does:

     apa-t1-*            enacted by the 2024 Act. Royal Assent 10 December 2024; most of
                         Schedule 1 and Schedule 3 in force from 11 December 2024; the statutory
                         tort (Schedule 2) from 10 June 2025; the automated-decision privacy
                         policy duty (Schedule 1 Part 15) from 10 December 2026, so NOT YET IN
                         FORCE on the date this preset was written, 2026-09-27.
     apa-t2-proposed-*   NOT LAW. The Privacy Amendment (Personal Data Protection) Bill 2026 was
                         released as an exposure draft for consultation on 31 August 2026 and,
                         in the sources read, had not been introduced. These rules are "log" and
                         nothing else, so no proposal can block or warn on a request.
     apa-*               the APPs as they stood before 2024, from regulatory-defaults.md 3.2.

   Sources, read 2026-09-27: the Act as made (legislation.gov.au C2024A00128), for its Parts and
   Schedules; the OAIC's statement on the Bill's passage (29 November 2024) and its Children's
   Online Privacy Code page, for the substance and the code's 10 December 2026 deadline; a
   law-firm summary of the tranche 2 exposure draft (Spruson and Ferguson). loke has not read the
   exposure draft itself, so the tranche 2 rules are only as good as that summary.

   Corrected here: this preset said the 2024 Act made inferred and technical data personal
   information and prohibited re-identification. It did neither. The first is a tranche 2
   proposal (a "relates to" definition); the second is not in the 2024 Act. It also attributed
   the AUD 50 million penalty ceiling to the 2024 Act, which came from the Privacy Legislation
   Amendment (Enforcement and Other Measures) Act 2022. regulatory-defaults.md section 3 carried
   the same errors and is corrected with this file.

   Nothing in this preset makes a deployment compliant with anything. It records what the law
   asks and says where loke does not help. *)
f=preset():$policy{
  <$policy{
    version:"1.1";
    name:"AU Privacy Act";
    description:"Australian Privacy Act 1988 and Australian Privacy Principles, with the enacted Privacy and Other Legislation Amendment Act 2024. The proposed second tranche is recorded as log-only rules and is not law. A starting point for an entity's own assessment, not compliance";
    source:"builtin:au-privacy";
    priority:100;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"ip_address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"abn";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"tfn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medicare";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"drivers_licence";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"passport";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"crn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bsb";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bank_account";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"credit_card";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"super_member";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"api_key";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"password";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"genetic";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"racial";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"political";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"religion";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"sexual_orientation";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"trade_union";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"criminal";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"inferred";action:"anonymise";strength:"full";exceptions:@()}
    );
    (* Both limits are zero on purpose. docs/specifications/policy-examples/au-privacy-act.yaml
       sets a monthly global limit of 150.00 AUD, and this field is USD-denominated: there is
       no rate in the repository to convert it with, and a converted figure would be a number
       nobody measured sitting in a regulatory preset. maxtokens has no figure in the source
       document at all. Both wait on core.optimiser.budget being wired, GA1.5, and on a
       currency field or a sourced rate. *)
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    (* piimappingdays is 2, regulatory-defaults.md section 3.5: mapping tables are kept for 48
       hours after session close. That is a loke design choice under APP 11.2 (destroy or
       de-identify what is no longer needed), not a statutory period: the mapping table is a
       re-identification capability, so it is kept short. auditlogdays is 2555, seven years,
       per section 3.5 and the Corporations Act 2001 record-keeping period it cites. *)
    retention:$retentionpolicy{auditlogdays:2555;conversationdays:180;piimappingdays:2;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("tfn";"medicare";"drivers_licence";"passport";"crn";"bsb";"bank_account";"credit_card";"super_member";"api_key";"password";"health";"genetic";"biometric";"racial";"political";"religion";"sexual_orientation";"trade_union";"criminal");
    (* APP 8 does not prohibit overseas disclosure; it makes the discloser take reasonable steps
       and, by s 16C, accountable for the recipient. The 2024 Act added a way to prescribe
       countries and binding schemes (Schedule 1 Part 6), and the sources read name none
       prescribed. loke cannot make the entity's assessment, so the preset keeps cross-border
       disclosure off until the entity turns it on, and the rules engine derives a deny rule
       from that (core.governance.rulesengine.presetrules). *)
    crossborderallowed:false;
    requireapprovalabove:"internal";
    customrules:@(
      "app2_anonymity_and_pseudonymity_option";
      "app3_collect_only_what_is_reasonably_necessary";
      "app6_disclosure_requires_consent_or_exception";
      "app8_comparable_protections";
      "app9_government_related_identifier_restrictions";
      "app11_reasonable_steps_security";
      "app11_2_destroy_or_deidentify_when_no_longer_needed";
      "tfn_guidelines_2015_strict_handling";
      "eligible_data_breach_30_days";
      "oaic_notification_required";
      "enacted_2024_app11_3_technical_and_organisational_measures";
      "enacted_2024_app8_prescribed_countries_mechanism";
      "enacted_2024_eligible_data_breach_declarations";
      "enacted_2024_civil_penalty_tiers_and_infringement_notices";
      "enacted_2024_oaic_investigation_and_inquiry_powers";
      "enacted_2024_childrens_online_privacy_code_due_2026_12_10";
      "enacted_2024_statutory_tort_serious_invasion_of_privacy";
      "enacted_2024_doxxing_offences";
      "enacted_2024_automated_decisions_privacy_policy_from_2026_12_10";
      "proposed_tranche2_not_law_personal_information_relates_to";
      "proposed_tranche2_not_law_fair_and_reasonable_test";
      "proposed_tranche2_not_law_controller_processor";
      "proposed_tranche2_not_law_72_hour_breach_notification"
    )
  }
};

f=rules():@$policyrule{
  <@(
    $policyrule{ id:"apa-sensitive-info"; description:"Sensitive information requires explicit consent"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-cross-border"; description:"Cross-border disclosure requires safeguards"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-collection-notice"; description:"Must notify individuals of collection purpose"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app2-anonymity"; description:"APP 2 — individuals must have the option of dealing with the entity anonymously or by pseudonym where lawful and practicable"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app3-collection"; description:"APP 3 — personal information may be collected only by lawful and fair means and only where reasonably necessary for the entity's functions"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app6-secondary-use"; description:"APP 6 — sending user data to an LLM provider is a disclosure and requires consent or an exception; de-identification reduces what is disclosed"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app8-accountability"; description:"APP 8 and s 16C — the disclosing entity remains accountable for the overseas recipient's handling, and the assessment of the recipient is the entity's own"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app9-government-identifiers"; description:"APP 9 — government related identifiers must not be adopted as the entity's own identifier, and their use and disclosure is restricted; TFN handling is further constrained by the Tax File Number Guidelines 2015"; action:"block"; severity:"critical" };
    $policyrule{ id:"apa-app11-security"; description:"APP 11 — reasonable steps must be taken to protect personal information from misuse, interference, loss and unauthorised access or disclosure"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app11-2-destruction"; description:"APP 11.2 — personal information must be destroyed or de-identified when no longer needed for any permitted purpose"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app12-access"; description:"APP 12 — individuals have a right to access their personal information, which the audit trail supports"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app13-correction"; description:"APP 13 — individuals may request correction of inaccurate personal information"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-ndb-30-days"; description:"Notifiable Data Breaches scheme, Part IIIC — an entity that suspects an eligible data breach has 30 days to assess it, and an eligible breach must be notified to the OAIC and to affected individuals as soon as practicable; the obligation rests with the entity"; action:"warn"; severity:"critical" };
    $policyrule{ id:"apa-personal-information-includes-opinion"; description:"s 6(1) — personal information is information or an opinion about an identified or reasonably identifiable individual, whether true or not, so a model's statement about a reasonably identifiable person can be personal information today, which is why outbound responses need scanning. The 2024 Act did not change this definition"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-mapping-table-reidentification"; description:"loke design rule, not a statutory provision — the local placeholder mapping table re-identifies what was de-identified, so under APP 11 and 11.2 it is kept for 48 hours and must be secured. No enacted provision prohibits re-identification as such"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-t1-app11-technical-organisational-measures"; description:"ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 1 Part 5, in force 11 December 2024 — APP 11.3: the reasonable steps APP 11 requires include technical and organisational measures. loke's own store is not encrypted at rest (X8), which is a technical measure an assessor will ask about"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-t1-app8-prescribed-countries"; description:"ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 1 Part 6 — regulations may prescribe countries and binding schemes with substantially similar protection, and disclosure to them is an exception to APP 8.1. The sources read name none prescribed and loke carries no list, so the APP 8 assessment stays the entity's"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-t1-eligible-data-breach-declarations"; description:"ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 1 Part 7 — after an eligible data breach the Minister may make a declaration permitting personal information to be handled to prevent or reduce harm. It changes what an entity may do after a breach, not the duty to notify"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-t1-penalty-tiers"; description:"ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 1 Part 8 — a civil penalty for an interference with privacy below the serious threshold, and infringement notices the OAIC can issue for specified breaches such as a deficient privacy policy. The ceiling for serious or repeated interferences, the greater of AUD 50 million, three times the benefit or 30 per cent of adjusted turnover, dates from the 2022 Enforcement and Other Measures Act, not the 2024 Act"; action:"log"; severity:"high" };
    $policyrule{ id:"apa-t1-oaic-powers"; description:"ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 1 Parts 9 to 14 — among them broader Federal Court orders, public inquiries directed by the Minister, determinations after investigations, and monitoring and investigation powers under the Regulatory Powers Act. The audit trail is what an entity would be asked to produce"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-t1-childrens-online-privacy-code"; description:"NOT IMPLEMENTED — ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 1 Part 4 — the OAIC must develop and register a Children's Online Privacy Code by 10 December 2026, covering online services likely to be accessed by children. loke has no age signal, no child-user determination and no code-specific handling, so nothing in this preset addresses it"; action:"log"; severity:"high" };
    $policyrule{ id:"apa-t1-statutory-tort"; description:"ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 2, in force 10 June 2025 — a cause of action for serious invasions of privacy, including misuse of information, so a disclosure that breaches no APP may still found a civil claim"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-t1-doxxing-offences"; description:"ENACTED — Privacy and Other Legislation Amendment Act 2024, Schedule 3, in force 11 December 2024 — Criminal Code offences for using a carriage service to make personal data available in a menacing or harassing way, which raises the consequence of an unredacted outbound disclosure beyond regulatory penalty"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-t1-automated-decisions-privacy-policy"; description:"ENACTED, NOT YET IN FORCE — Privacy and Other Legislation Amendment Act 2024, Schedule 1 Part 15, from 10 December 2026 — a privacy policy must describe the kinds of personal information used, and the kinds of decisions made, by computer programs that make or substantially contribute to decisions that could reasonably be expected to significantly affect an individual's rights or interests. loke's routing chooses a model, not an outcome for a person; a deployment that feeds model output into such a decision must disclose it"; action:"log"; severity:"high" };
    $policyrule{ id:"apa-t2-proposed-relates-to-definition"; description:"PROPOSED, NOT LAW — tranche 2 exposure draft, Privacy Amendment (Personal Data Protection) Bill 2026, released 31 August 2026 — personal information would be information that relates to an identified or reasonably identifiable individual, rather than information about one, and precise geolocation and genomic information would become sensitive"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-t2-proposed-fair-and-reasonable"; description:"PROPOSED, NOT LAW — tranche 2 exposure draft — handling of personal information would have to be fair and reasonable in the circumstances, weighing reasonable expectations, minimisation, proportionality and children's best interests. If enacted, sending a whole prompt where a schema would do is the kind of choice it asks an entity to justify"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-t2-proposed-controller-processor"; description:"PROPOSED, NOT LAW — tranche 2 exposure draft — a controller and processor framework in which a processor acts on documented instructions and remains liable under APP 1 and APP 11. An LLM provider receiving forwarded text would be the processor, and the entity would need those instructions recorded"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-t2-proposed-72-hour-notification"; description:"PROPOSED, NOT LAW — tranche 2 exposure draft — an eligible data breach would be notified to the Information Commissioner within 72 hours, with staged reporting, and every data breach would carry response obligations. The enacted 30-day assessment window in apa-ndb-30-days still applies"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-detector-gap-au-identifiers"; description:"UNIMPLEMENTED RG1.7a — the special categories this preset blocks (genetic, biometric, racial, political, religion, sexual orientation, trade union, criminal) have no detector, so the block cannot fire on them: they are what a text is about, not a string in it, and need a model layer that labels them; health is found only by the NER layer. Driver's licence, passport, Centrelink CRN and superannuation member number are detected by the regex layer since RG1.7a, but only after the words that name them: none has a check loke can apply (the CRN check letter's algorithm is not published), so the same number without its label is not seen. Medicare number, BSB and bank account number are detected since RG1.7"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-deidentification-not-a-conclusion"; description:"Section 3.4 — the standard is reasonable steps in the circumstances. A multi-layer pipeline is evidence toward reasonable steps; whether it is reasonable in a deployment's circumstances is for that deployment and its assessor to determine, and only two layers are enabled by default"; action:"log"; severity:"medium" }
  )
};

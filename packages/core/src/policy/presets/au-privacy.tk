
m=core.policy.presets.auprivacy;
i=s:core.policy.schema;

f=preset():$s.policy{
  <$s.policy{
    version:"1.0";
    name:"AU Privacy Act";
    description:"Australian Privacy Act 1988 and Australian Privacy Principles";
    source:"builtin:au-privacy";
    priority:100;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@(
      $s.anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $s.anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $s.anonymisationrule{entitytype:"phone";action:"anonymise";strength:"reasonable";exceptions:@()};
      $s.anonymisationrule{entitytype:"tfn";action:"block";strength:"full";exceptions:@()};
      $s.anonymisationrule{entitytype:"abn";action:"anonymise";strength:"reasonable";exceptions:@()};
      $s.anonymisationrule{entitytype:"medicare";action:"block";strength:"full";exceptions:@()};
      $s.anonymisationrule{entitytype:"health";action:"anonymise";strength:"full";exceptions:@()};
    );
    budget:$s.budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$s.retentionpolicy{auditlogdays:2555;conversationdays:180;piimappingdays:30;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("tfn";"medicare");
    crossborderallowed:false;
    requireapprovalabove:"internal";
    customrules:@("app8_comparable_protections";"eligible_data_breach_30_days";"oaic_notification_required")
  };
};

m=core.policy.presets.auprivacy;
i=s:core.policy.schema;
i=ty:core.policy.types;

f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"AU Privacy Act";
    description:"Australian Privacy Act 1988 and Australian Privacy Principles, including the Privacy and Other Legislation Amendment (Tranche 1) Act 2024 reforms";
    source:"builtin:au-privacy";
    priority:100;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"ip_address";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"abn";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"tfn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"medicare";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"drivers_licence";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"passport";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"crn";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bsb";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"bank_account";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"credit_card";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"super_member";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"api_key";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"password";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"genetic";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"racial";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"political";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"religion";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"sexual_orientation";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"trade_union";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"criminal";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"inferred";action:"anonymise";strength:"full";exceptions:@()}
    );
    (* Both limits are zero on purpose. docs/specifications/policy-examples/au-privacy-act.yaml
       sets a monthly global limit of 150.00 AUD, and this field is USD-denominated: there is
       no rate in the repository to convert it with, and a converted figure would be a number
       nobody measured sitting in a regulatory preset. maxtokens has no figure in the source
       document at all. Both wait on core.optimiser.budget being wired, GA1.5, and on a
       currency field or a sourced rate. *)
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    (* piimappingdays is 2, not 30. regulatory-defaults.md section 3.5 puts PII mapping
       tables at 48 hours after session close, and section 3.4 records that the 2024
       amendments reinforce the prohibition on re-identifying de-identified data: a mapping
       table held for a month is a month of re-identification capability. auditlogdays is
       2555, seven years, per section 3.5 and the Corporations Act 2001 record-keeping
       period it cites. *)
    retention:$retentionpolicy{auditlogdays:2555;conversationdays:180;piimappingdays:2;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@("tfn";"medicare";"drivers_licence";"passport";"crn";"bsb";"bank_account";"credit_card";"super_member";"api_key";"password";"health";"genetic";"biometric";"racial";"political";"religion";"sexual_orientation";"trade_union";"criminal");
    crossborderallowed:false;
    requireapprovalabove:"internal";
    customrules:@(
      "app2_anonymity_and_pseudonymity_option";
      "app3_collect_only_what_is_reasonably_necessary";
      "app6_disclosure_requires_consent_or_exception";
      "app8_comparable_protections";
      "app9_government_related_identifier_restrictions";
      "app11_reasonable_steps_security";
      "app11_2_destroy_or_deidentify_when_no_longer_needed";
      "tfn_guidelines_2015_strict_handling";
      "eligible_data_breach_30_days";
      "oaic_notification_required";
      "tranche1_2024_statutory_tort_serious_invasion_of_privacy";
      "tranche1_2024_childrens_online_privacy_code";
      "tranche1_2024_doxxing_criminalised";
      "tranche1_2024_oaic_enhanced_enforcement_powers";
      "tranche1_2024_personal_information_includes_inferred_and_technical_data";
      "amendments_2024_reidentification_prohibited"
    )
  }
};

f=rules():@$policyrule{
  <@(
    $policyrule{ id:"apa-sensitive-info"; description:"Sensitive information requires explicit consent"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-cross-border"; description:"Cross-border disclosure requires safeguards"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-collection-notice"; description:"Must notify individuals of collection purpose"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app2-anonymity"; description:"APP 2 — individuals must have the option of dealing with the entity anonymously or by pseudonym where lawful and practicable"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app3-collection"; description:"APP 3 — personal information may be collected only by lawful and fair means and only where reasonably necessary for the entity's functions"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app6-secondary-use"; description:"APP 6 — sending user data to an LLM provider is a disclosure and requires consent or an exception; de-identification reduces what is disclosed"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app8-accountability"; description:"APP 8 and s 16C — the disclosing entity remains accountable for the overseas recipient's handling; Australia maintains no adequacy list, so the assessment is the entity's own"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app9-government-identifiers"; description:"APP 9 — government related identifiers must not be adopted as the entity's own identifier, and their use and disclosure is restricted; TFN handling is further constrained by the Tax File Number Guidelines 2015"; action:"block"; severity:"critical" };
    $policyrule{ id:"apa-app11-security"; description:"APP 11 — reasonable steps must be taken to protect personal information from misuse, interference, loss and unauthorised access or disclosure"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-app11-2-destruction"; description:"APP 11.2 — personal information must be destroyed or de-identified when no longer needed for any permitted purpose"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app12-access"; description:"APP 12 — individuals have a right to access their personal information, which the audit trail supports"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-app13-correction"; description:"APP 13 — individuals may request correction of inaccurate personal information"; action:"log"; severity:"medium" };
    $policyrule{ id:"apa-ndb-30-days"; description:"Notifiable Data Breaches scheme, Part IIIC — an eligible data breach must be notified to the OAIC and to affected individuals as soon as practicable and within 30 calendar days; the obligation rests with the entity"; action:"warn"; severity:"critical" };
    $policyrule{ id:"apa-2024-inferred-data"; description:"Tranche 1 Act 2024 — the definition of personal information explicitly covers inferred and technical data, so model output containing inferences about an individual is in scope and needs outbound response scanning"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-2024-reidentification-prohibited"; description:"Tranche 1 Act 2024 — re-identification of de-identified data is prohibited, so the local placeholder mapping table is itself a control surface and must be secured and short-lived"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-2024-statutory-tort"; description:"Tranche 1 Act 2024 — a statutory tort for serious invasion of privacy is in force from mid-2025, so a disclosure that is not a breach of an APP may still found a civil action"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-2024-doxxing-offence"; description:"Tranche 1 Act 2024 — malicious release of personal data is a criminal offence, which raises the consequence of an unredacted outbound disclosure beyond regulatory penalty"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-2024-childrens-online-privacy-code"; description:"NOT IMPLEMENTED — Tranche 1 Act 2024 — a Children's Online Privacy Code is expected to be enforceable from 2026. loke has no age signal, no child-user determination and no code-specific handling, so nothing in this preset addresses it"; action:"log"; severity:"high" };
    $policyrule{ id:"apa-2024-oaic-enforcement-powers"; description:"Tranche 1 Act 2024 — the OAIC's enforcement powers are enhanced, and maximum penalties for serious or repeated interferences reach the greater of AUD 50 million, three times the benefit obtained, or 30 per cent of adjusted turnover"; action:"log"; severity:"high" };
    $policyrule{ id:"apa-detector-gap-au-identifiers"; description:"UNIMPLEMENTED AD1.1 — Medicare number, BSB, bank account number, driver's licence, passport, Centrelink CRN and superannuation member number are all blocked by this preset and loke has a detector for none of them, so the block cannot fire on a value it never sees"; action:"warn"; severity:"high" };
    $policyrule{ id:"apa-deidentification-not-a-conclusion"; description:"Section 3.4 — the standard is reasonable steps in the circumstances. A multi-layer pipeline is evidence toward reasonable steps; whether it is reasonable in a deployment's circumstances is for that deployment and its assessor to determine, and only two layers are enabled by default"; action:"log"; severity:"medium" }
  )
};

m=core.policy.presets.remaining;
i=s:core.policy.schema;
i=ty:core.policy.types;

(* Every maxtokens and every maxcostusd left at zero in this file is deliberate.
   docs/specifications/policy-examples holds no policy example for UK GDPR, Singapore
   PDPA, the EU AI Act or the Colorado AI Act, so no source document in this repository
   gives a figure for those four, and inventing one would put an unmeasured number in a
   regulatory preset. They wait on a sourced figure and on core.optimiser.budget being
   wired, GA1.5. minimal() is the one exception and says so where it is set. *)

f=ukgdpr():$policy{
  <$policy{
    version:"1.0";name:"UK GDPR";description:"UK General Data Protection Regulation, as retained EU law amended by the Data Protection Act 2018 and the Data Protection and Digital Information Act 2024";source:"builtin:uk-gdpr";priority:100;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"address";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"dob";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"nino";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"nhs_number";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"uk_passport";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"uk_driving_licence";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"sort_code";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"genetic";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"political";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"religion";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"sexual_orientation";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"trade_union";action:"block";strength:"full";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:1825;conversationdays:90;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@("nino";"nhs_number";"uk_passport";"uk_driving_licence";"sort_code";"health";"biometric";"genetic";"political";"religion";"sexual_orientation";"trade_union");
    crossborderallowed:false;requireapprovalabove:"internal";
    customrules:@("uk_adequacy_regulations_secretary_of_state";"uk_idta_required";"uk_addendum_to_eu_sccs";"dpdi_2024_data_protection_test";"uk_us_data_bridge";"72_hour_ico_notification";"dpa_required";"ico_motivated_intruder_test";"art9_special_categories_blocked")
  }
};

(* This rule list used to be a verbatim copy of the EU GDPR list, ids and all: five rules
   still prefixed gdpr- and one of them asserting that personal data "must not leave EU
   without adequacy decision" under jurisdiction UK. That is wrong on the substance, not
   merely on the prefix — the UK left the EU transfer regime on 1 January 2021 and runs its
   own adequacy regulations, the IDTA and the UK Addendum, assessed against the DPDI Act's
   data protection test rather than EU essential equivalence. Source for every rule below
   is docs/specifications/regulatory-defaults.md section 6. *)
f=ukgdprrules():@$policyrule{
  <@(
    $policyrule{ id:"ukgdpr-pii-export"; description:"Personal data must not leave the UK unless the destination is covered by UK adequacy regulations made by the Secretary of State, or an appropriate safeguard is in place — the UK International Data Transfer Agreement or the UK Addendum to the EU standard contractual clauses"; action:"warn"; severity:"high" };
    $policyrule{ id:"ukgdpr-data-protection-test"; description:"Under the Data Protection and Digital Information Act 2024 a transfer is permitted where the destination's protection is not materially lower than UK standards. That assessment is made by the transferring organisation, and it is less prescriptive than the EU essential-equivalence threshold rather than absent"; action:"warn"; severity:"high" };
    $policyrule{ id:"ukgdpr-us-data-bridge"; description:"Transfers to US providers may rely on the UK Extension to the EU-US Data Privacy Framework, the UK-US Data Bridge, in force from October 2023; the provider must actually be certified under it"; action:"log"; severity:"medium" };
    $policyrule{ id:"ukgdpr-lawful-basis"; description:"Processing requires a lawful basis under the UK GDPR read with the Data Protection Act 2018; the DPDI Act's recognised legitimate interests remove the balancing test for a limited list only"; action:"warn"; severity:"high" };
    $policyrule{ id:"ukgdpr-minimisation"; description:"Personal data must be adequate, relevant and limited to what is necessary for the stated purpose"; action:"log"; severity:"medium" };
    $policyrule{ id:"ukgdpr-retention"; description:"Personal data must not be kept in a form permitting identification for longer than is necessary; the ICO enforcement limitation period is six years for most matters"; action:"log"; severity:"medium" };
    $policyrule{ id:"ukgdpr-right-erasure"; description:"Data subjects have a right to erasure — no persistent identifiable storage"; action:"warn"; severity:"high" };
    $policyrule{ id:"ukgdpr-ico-notification"; description:"A personal data breach must be notified to the ICO within 72 hours of becoming aware of it unless it is unlikely to result in a risk to rights and freedoms, and to data subjects without undue delay where the risk is high. The obligation rests with the controller, not with loke"; action:"warn"; severity:"critical" };
    $policyrule{ id:"ukgdpr-motivated-intruder"; description:"The ICO's anonymisation guidance applies the motivated intruder test: whether a motivated person without specialist knowledge, but with access to the internet, public libraries and public records, could re-identify the individual. loke retains a local mapping, so its output is pseudonymised rather than anonymised"; action:"warn"; severity:"high" };
    $policyrule{ id:"ukgdpr-automated-decisions"; description:"Solely automated decisions with legal or similarly significant effects are restricted; the DPDI Act narrows this to decisions made without meaningful human involvement"; action:"warn"; severity:"high" };
    $policyrule{ id:"ukgdpr-special-categories"; description:"Special category data is blocked from the forward path rather than substituted, because substitution is not de-identification"; action:"block"; severity:"critical" };
    $policyrule{ id:"ukgdpr-dpa-required"; description:"Any processor requires a data processing agreement, and it must reference the UK GDPR and the Data Protection Act 2018 rather than the EU GDPR"; action:"warn"; severity:"high" }
  )
};

f=singaporepdpa():$policy{
  <$policy{
    version:"1.0";name:"Singapore PDPA";description:"Personal Data Protection Act 2012";source:"builtin:sg-pdpa";priority:100;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"nric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:1825;conversationdays:180;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@("nric");
    crossborderallowed:false;requireapprovalabove:"internal";
    customrules:@("transfer_limitation";"3_day_pdpc_notification";"data_intermediary_obligations")
  }
};

f=singaporepdparules():@$policyrule{
  <@(
    $policyrule{ id:"pdpa-purpose"; description:"Personal data collected only for stated purpose"; action:"warn"; severity:"high" };
    $policyrule{ id:"pdpa-consent"; description:"Consent required before collection"; action:"warn"; severity:"high" };
    $policyrule{ id:"pdpa-transfer-limitation"; description:"Personal data may only be transferred outside Singapore where the recipient is bound by a standard of protection comparable to the PDPA"; action:"warn"; severity:"high" };
    $policyrule{ id:"pdpa-notification"; description:"A notifiable data breach must be reported to the PDPC within 3 calendar days of assessing it as notifiable; the obligation rests with the organisation"; action:"warn"; severity:"critical" };
    $policyrule{ id:"pdpa-data-intermediary"; description:"An organisation processing personal data on another's behalf carries protection and retention obligations in its own right"; action:"log"; severity:"medium" }
  )
};

f=minimal():$policy{
  <$policy{
    version:"1.0";name:"Minimal";description:"Minimal restrictions for testing and development";source:"builtin:minimal";priority:0;
    classificationdefault:"public";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"placeholder";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"placeholder";exceptions:@()}
    );
    (* Sourced: docs/specifications/policy-examples/minimal.yaml sets a monthly global limit
       of 500.00 USD with on_exceed action warn, warn only and never block. The currency
       matches this field so the figure carries across unconverted. maxtokens stays zero
       because the source gives no token figure. *)
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:500.0;actiononexceed:"warning"};
    retention:$retentionpolicy{auditlogdays:0;conversationdays:0;piimappingdays:0;cachedays:30};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@();
    crossborderallowed:true;requireapprovalabove:"restricted";
    customrules:@()
  }
};

(* minimal() imposes no regulatory constraint by design, and its rule list is still not
   empty: a preset that loads with zero rules is indistinguishable from the T-24 defect
   where @(rules; rule) silently produces a two-element literal instead of an append, so
   every preset says something even when what it says is that it constrains nothing. *)
f=minimalrules():@$policyrule{
  <@(
    $policyrule{ id:"minimal-development-only"; description:"This preset is for testing and development. It asserts no regulatory position, blocks nothing, and permits cross-border disclosure. Do not deploy it where real personal data is handled"; action:"warn"; severity:"high" }
  )
};

f=euaiact():$policy{
  <$policy{
    version:"1.0";name:"EU AI Act";description:"Regulation (EU) 2024/1689 on Artificial Intelligence";source:"builtin:eu-ai-act";priority:90;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"emotion";action:"block";strength:"full";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:3650;conversationdays:365;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@("biometric";"emotion";"social_scoring");
    crossborderallowed:false;requireapprovalabove:"internal";
    customrules:@("high_risk_ai_transparency";"human_oversight_required";"conformity_assessment";"10_year_record_keeping")
  }
};

f=euaiactrules():@$policyrule{
  <@(
    $policyrule{ id:"euaiact-transparency"; description:"A high-risk AI system must be transparent about its operation to the extent needed for a deployer to interpret and use its output"; action:"warn"; severity:"high" };
    $policyrule{ id:"euaiact-human-oversight"; description:"A high-risk AI system must be designed so that natural persons can oversee its operation and override or disregard its output"; action:"warn"; severity:"high" };
    $policyrule{ id:"euaiact-conformity-assessment"; description:"A high-risk AI system requires a conformity assessment before being placed on the market; loke cannot perform or evidence one"; action:"log"; severity:"high" };
    $policyrule{ id:"euaiact-record-keeping"; description:"Logs of a high-risk AI system's operation must be kept for a period appropriate to its purpose, and this preset retains audit records for ten years"; action:"log"; severity:"medium" };
    $policyrule{ id:"euaiact-prohibited-practices"; description:"Biometric categorisation, emotion inference in the workplace and education, and social scoring are prohibited practices and are blocked rather than substituted"; action:"block"; severity:"critical" }
  )
};

f=coloradoaiact():$policy{
  <$policy{
    version:"1.0";name:"Colorado AI Act";description:"Colorado Artificial Intelligence Act SB 24-205";source:"builtin:colorado-ai";priority:80;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"protected_class";action:"anonymise";strength:"full";exceptions:@()}
    );
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:1825;conversationdays:180;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@();
    crossborderallowed:true;requireapprovalabove:"confidential";
    customrules:@("algorithmic_discrimination_prevention";"impact_assessment_required";"consumer_disclosure";"opt_out_supported")
  }
};

f=coloradoaiactrules():@$policyrule{
  <@(
    $policyrule{ id:"coloradoai-discrimination"; description:"A developer or deployer of a high-risk artificial intelligence system must use reasonable care to protect consumers from known or reasonably foreseeable risks of algorithmic discrimination"; action:"warn"; severity:"high" };
    $policyrule{ id:"coloradoai-impact-assessment"; description:"A deployer must complete an impact assessment for a high-risk system; loke can supply records toward one and cannot produce the assessment"; action:"log"; severity:"high" };
    $policyrule{ id:"coloradoai-consumer-disclosure"; description:"A consumer must be told when a high-risk artificial intelligence system is being used to make, or is a substantial factor in making, a consequential decision about them"; action:"warn"; severity:"high" };
    $policyrule{ id:"coloradoai-opt-out"; description:"A consumer may opt out of profiling in furtherance of a decision that produces a legal or similarly significant effect"; action:"warn"; severity:"high" }
  )
};

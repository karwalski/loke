
m=core.policy.presets.remaining;
i=s:core.policy.schema;

f=ukgdpr():i64{
  <$policy{
    version:"1.0";name:"UK GDPR";description:"UK General Data Protection Regulation";source:"builtin:uk-gdpr";priority:100;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"nino";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"health";action:"block";strength:"full";exceptions:@()};
    );
    budget:i64{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:i64{auditlogdays:1825;conversationdays:90;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@("health";"biometric";"political";"religion");
    crossborderallowed:false;requireapprovalabove:"internal";
    customrules:@("uk_idta_required";"72_hour_ico_notification";"dpa_required")
  };
};

f=singaporepdpa():i64{
  <$policy{
    version:"1.0";name:"Singapore PDPA";description:"Personal Data Protection Act 2012";source:"builtin:sg-pdpa";priority:100;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"nric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
    );
    budget:i64{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:i64{auditlogdays:1825;conversationdays:180;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@("nric");
    crossborderallowed:false;requireapprovalabove:"internal";
    customrules:@("transfer_limitation";"3_day_pdpc_notification";"data_intermediary_obligations")
  };
};

f=minimal():i64{
  <$policy{
    version:"1.0";name:"Minimal";description:"Minimal restrictions for testing and development";source:"builtin:minimal";priority:0;
    classificationdefault:"public";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"placeholder";exceptions:@()};
      $anonymisationrule{entitytype:"phone";action:"anonymise";strength:"placeholder";exceptions:@()};
    );
    budget:i64{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"info"};
    retention:i64{auditlogdays:0;conversationdays:0;piimappingdays:0;cachedays:30};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@();
    crossborderallowed:true;requireapprovalabove:"restricted";
    customrules:@()
  };
};

f=euaiact():i64{
  <$policy{
    version:"1.0";name:"EU AI Act";description:"Regulation (EU) 2024/1689 on Artificial Intelligence";source:"builtin:eu-ai-act";priority:90;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"biometric";action:"block";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"emotion";action:"block";strength:"full";exceptions:@()};
    );
    budget:i64{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:i64{auditlogdays:3650;conversationdays:365;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@("biometric";"emotion";"social_scoring");
    crossborderallowed:false;requireapprovalabove:"internal";
    customrules:@("high_risk_ai_transparency";"human_oversight_required";"conformity_assessment";"10_year_record_keeping")
  };
};

f=coloradoaiact():i64{
  <$policy{
    version:"1.0";name:"Colorado AI Act";description:"Colorado Artificial Intelligence Act SB 24-205";source:"builtin:colorado-ai";priority:80;
    classificationdefault:"confidential";providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"protected_class";action:"anonymise";strength:"full";exceptions:@()};
    );
    budget:i64{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:i64{auditlogdays:1825;conversationdays:180;piimappingdays:30;cachedays:7};
    mcpservers:@();allowedusecases:@();blockedentitytypes:@();
    crossborderallowed:true;requireapprovalabove:"confidential";
    customrules:@("algorithmic_discrimination_prevention";"impact_assessment_required";"consumer_disclosure";"opt_out_supported")
  };
};

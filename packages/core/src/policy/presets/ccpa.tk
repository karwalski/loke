
m=core.policy.presets.ccpa;
i=s:core.policy.schema;

f=preset():$s.policy{
  <$s.policy{
    version:"1.0";
    name:"US CCPA/CPRA";
    description:"California Consumer Privacy Act and California Privacy Rights Act";
    source:"builtin:ccpa";
    priority:100;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@(
      $s.anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $s.anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $s.anonymisationrule{entitytype:"ssn";action:"anonymise";strength:"full";exceptions:@()};
      $s.anonymisationrule{entitytype:"financial";action:"anonymise";strength:"full";exceptions:@()};
      $s.anonymisationrule{entitytype:"biometric";action:"anonymise";strength:"full";exceptions:@()};
      $s.anonymisationrule{entitytype:"geolocation";action:"anonymise";strength:"reasonable";exceptions:@()};
    );
    budget:$s.budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$s.retentionpolicy{auditlogdays:730;conversationdays:365;piimappingdays:30;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@();
    crossborderallowed:true;
    requireapprovalabove:"confidential";
    customrules:@("service_provider_contract_required";"45_day_consumer_response";"opt_out_of_sale_supported";"sensitive_pi_consent_required")
  };
};

m=core.policy.presets.ccpa;
i=s:core.policy.schema;
i=ty:core.policy.types;

f=preset():$policy{
  <$policy{
    version:"1.0";
    name:"US CCPA/CPRA";
    description:"California Consumer Privacy Act and California Privacy Rights Act";
    source:"builtin:ccpa";
    priority:100;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@(
      $anonymisationrule{entitytype:"name";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"email";action:"anonymise";strength:"reasonable";exceptions:@()};
      $anonymisationrule{entitytype:"ssn";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"financial";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"biometric";action:"anonymise";strength:"full";exceptions:@()};
      $anonymisationrule{entitytype:"geolocation";action:"anonymise";strength:"reasonable";exceptions:@()}
    );
    (* Both limits are zero on purpose. There is no CCPA or CPRA policy example in
       docs/specifications/policy-examples, so no source document gives a figure for this
       preset, and a budget is not a CCPA requirement. They wait on either a sourced
       figure or core.optimiser.budget being wired, GA1.5. *)
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:730;conversationdays:365;piimappingdays:30;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@();
    crossborderallowed:true;
    requireapprovalabove:"confidential";
    customrules:@("service_provider_contract_required";"45_day_consumer_response";"opt_out_of_sale_supported";"sensitive_pi_consent_required")
  }
};

f=rules():@$policyrule{
  <@(
    $policyrule{ id:"ccpa-opt-out"; description:"Must honour opt-out of personal information sale"; action:"warn"; severity:"high" };
    $policyrule{ id:"ccpa-disclosure"; description:"Must disclose categories of personal information collected"; action:"log"; severity:"medium" };
    $policyrule{ id:"ccpa-service-provider-contract"; description:"A provider receiving personal information must be under a service provider contract restricting its use of that information"; action:"warn"; severity:"high" };
    $policyrule{ id:"ccpa-consumer-response-45-days"; description:"A verifiable consumer request must be responded to within 45 days"; action:"log"; severity:"medium" };
    $policyrule{ id:"ccpa-sensitive-pi-consent"; description:"Use of sensitive personal information beyond permitted purposes requires the consumer to opt in"; action:"warn"; severity:"high" }
  )
};

m=core.policy.feedback;

i=db:core.storage.db;
i=sdb:std.db;
i=str:std.str;
i=log:shared.log;

t=$complianceevent{
  requestid:str;
  policyid:str;
  regulation:str;
  violated:bool;
  useroverride:bool;
  timestamp:i64
};

t=$compliancesummary{
  periodstart:i64;
  periodend:i64;
  totalrequests:i32;
  violations:i32;
  useroverrides:i32;
  violationrate:f64;
  topregulations:@str
};

(* Every function here takes the store explicitly.

   The module previously called `db.exec(sql;params)` and `db.queryone(sql;params)`,
   which match the ARITY of core.storage.db's `exec(store;sql)` and
   `queryone(store;sql)` but not their meaning: a SQL string was being passed where a
   store handle belongs, and the parameters where the SQL belongs. It compiled.
   Three other functions referenced a bare `store` that was declared nowhere — that
   resolves to std.db's `store` TYPE and reaches codegen unreported (T-4).

   The query helpers return @$row!$lokeerr, so each result is matched rather than
   indexed directly. *)
f=record(store:$store;event:$complianceevent):bool{
  let ok=mt db.execparams(store;
    "INSERT INTO compliance_events (request_id, policy_id, regulation, violated, user_override, timestamp) VALUES (?, ?, ?, ?, ?, ?)";
    @(event.requestid;event.policyid;event.regulation;db.boolval(event.violated);db.boolval(event.useroverride);db.i64val(event.timestamp))) {
    $ok:v true;
    $err:e false
  };
  if(ok){}el{
    log.warn("compliance: failed to record event";"policy.feedback";"")
  };
  <ok
};

f=countevents(store:$store;sql:str;fromts:i64;tots:i64):i32{
  <mt db.queryparams(store;sql;@(db.i64val(fromts);db.i64val(tots))) {
    $ok:rows firstn(rows);
    $err:e 0 as i32
  }
};

f=firstn(rows:@$row):i32{
  if(rows.len==0){
    <0 as i32
  }el{
    <db.rowi32(rows.get(0);"n")
  }
};

f=regulationsfromrows(rows:@$row):@str{
  let out=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    out=out.push(db.rowstr(rows.get(i);"regulation"))
  };
  <out
};

f=summarise(store:$store;fromts:i64;tots:i64):$compliancesummary{
  let total=countevents(store;
    "SELECT COUNT(*) AS n FROM compliance_events WHERE timestamp >= ? AND timestamp <= ?";fromts;tots);
  let violations=countevents(store;
    "SELECT COUNT(*) AS n FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND violated = 1";fromts;tots);
  let overrides=countevents(store;
    "SELECT COUNT(*) AS n FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND user_override = 1";fromts;tots);

  let rate=mut.0.0;
  if(total > 0 as i32){
    rate=str.tofloat(str.fromint(violations)) / str.tofloat(str.fromint(total))
  }el{};

  let topregs=mt db.queryparams(store;
    "SELECT regulation FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND violated = 1 GROUP BY regulation ORDER BY COUNT(*) DESC LIMIT 5";
    @(db.i64val(fromts);db.i64val(tots))) {
    $ok:rows regulationsfromrows(rows);
    $err:e @()
  };

  <$compliancesummary{
    periodstart:fromts;
    periodend:tots;
    totalrequests:total;
    violations:violations;
    useroverrides:overrides;
    violationrate:rate;
    topregulations:topregs
  }
};

f=eventsfromrows(rows:@$row):@$complianceevent{
  let events=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let r:$row=rows.get(i);
    events=events.push($complianceevent{
      requestid:db.rowstr(r;"request_id");
      policyid:db.rowstr(r;"policy_id");
      regulation:db.rowstr(r;"regulation");
      violated:db.rowbool(r;"violated");
      useroverride:db.rowbool(r;"user_override");
      timestamp:db.rowi64(r;"timestamp")
    })
  };
  <events
};

f=exportevents(store:$store;fromts:i64;tots:i64):@$complianceevent{
  <mt db.queryparams(store;
    "SELECT request_id, policy_id, regulation, violated, user_override, timestamp FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? ORDER BY timestamp ASC";
    @(db.i64val(fromts);db.i64val(tots))) {
    $ok:rows eventsfromrows(rows);
    $err:e @()
  }
};

f=policyidsfromrows(rows:@$row):@str{
  let out=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    out=out.push(db.rowstr(rows.get(i);"policy_id"))
  };
  <out
};

f=topviolations(store:$store;limit:i32):@str{
  <mt db.queryparams(store;
    "SELECT policy_id FROM compliance_events WHERE violated = 1 GROUP BY policy_id ORDER BY COUNT(*) DESC LIMIT ?";
    @(db.i32val(limit))) {
    $ok:rows policyidsfromrows(rows);
    $err:e @()
  }
};

m=core.policy.feedback;

i=db:core.storage.db;
i=str:std.str;
i=log:shared.log;

t=$complianceevent{
  requestid:str;
  policyid:str;
  regulation:str;
  violated:bool;
  useroverride:bool;
  timestamp:i64
};

t=$compliancesummary{
  periodstart:i64;
  periodend:i64;
  totalrequests:i32;
  violations:i32;
  useroverrides:i32;
  violationrate:f64;
  topregulations:@str
};

f=record(event:$complianceevent):bool{
  let result=db.exec("INSERT INTO compliance_events (request_id, policy_id, regulation, violated, user_override, timestamp) VALUES (?, ?, ?, ?, ?, ?)";@(event.requestid;event.policyid;event.regulation;db.boolval(event.violated);db.boolval(event.useroverride);db.i64val(event.timestamp)));
  let ok=mt result {
    $ok:v true;
    $err:e false
  };
  if(!ok){
    log.warn("compliance: failed to record event";"policy.feedback";"")
  }el{};
  <ok
};

f=summarise(fromts:i64;tots:i64):$compliancesummary{
  let totalresult=db.queryone(
    "SELECT COUNT(*) AS n FROM compliance_events WHERE timestamp >= ? AND timestamp <= ?";
    @(db.i64val(fromts);db.i64val(tots))
  );
  let total=db.rowi32(totalresult;"n");

  let violationsresult=db.queryone(
    "SELECT COUNT(*) AS n FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND violated = 1";
    @(db.i64val(fromts);db.i64val(tots))
  );
  let violations=db.rowi32(violationsresult;"n");

  let overridesresult=db.queryone(
    "SELECT COUNT(*) AS n FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND user_override = 1";
    @(db.i64val(fromts);db.i64val(tots))
  );
  let overrides=db.rowi32(overridesresult;"n");

  let rate=mut.0.0;
  if(total > 0){
    rate=str.tofloat(str.fromint(violations)) / str.tofloat(str.fromint(total))
  }el{};

  let topresult=db.query(
    "SELECT regulation FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND violated = 1 GROUP BY regulation ORDER BY COUNT(*) DESC LIMIT 5";
    @(db.i64val(fromts);db.i64val(tots))
  );
  let topregs=mut.@();
  let ri=mut.0;
  lp(let lv=0;ri<db.rowslen(topresult);lv=lv){
    topregs=topregs.push(db.rowstr(topresult.get(ri);"regulation"));
    ri=ri+1
  };

  <$compliancesummary{
    periodstart:fromts;
    periodend:tots;
    totalrequests:total;
    violations:violations;
    useroverrides:overrides;
    violationrate:rate;
    topregulations:topregs
  }
};

f=exportevents(fromts:i64;tots:i64):@$complianceevent{
  let rows=db.query(
    "SELECT request_id, policy_id, regulation, violated, user_override, timestamp FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? ORDER BY timestamp ASC";
    @(db.i64val(fromts);db.i64val(tots))
  );
  let events=mut.@();
  let i=mut.0;
  lp(let lv=0;i<db.rowslen(rows);lv=lv){
    let ev=$complianceevent{
      requestid:db.rowstr(rows.get(i);"request_id");
      policyid:db.rowstr(rows.get(i);"policy_id");
      regulation:db.rowstr(rows.get(i);"regulation");
      violated:db.rowbool(rows.get(i);"violated");
      useroverride:db.rowbool(rows.get(i);"user_override");
      timestamp:db.rowi64(rows.get(i);"timestamp")
    };
    events=events.push(ev);
    i=i+1
  };
  <events
};

f=topviolations(limit:i32):@str{
  let rows=db.query(
    "SELECT policy_id FROM compliance_events WHERE violated = 1 GROUP BY policy_id ORDER BY COUNT(*) DESC LIMIT ?";
    @(db.i32val(limit))
  );
  let ids=mut.@();
  let i=mut.0;
  lp(let lv=0;i<db.rowslen(rows);lv=lv){
    ids=ids.push(db.rowstr(rows.get(i);"policy_id"));
    i=i+1
  };
  <ids
};

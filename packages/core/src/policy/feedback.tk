m=core.policy.feedback;

i=db:storage.db;
i=str:std.str;
i=log:shared.log;

t=$complianceevent{
  requestid:str;
  policyid:str;
  regulation:str;
  violated:bool;
  useroverride:bool;
  timestamp:i64
};

t=$compliancesummary{
  periodstart:i64;
  periodend:i64;
  totalrequests:i32;
  violations:i32;
  useroverrides:i32;
  violationrate:f32;
  topregulations:@str
};

f=record(event:$complianceevent):bool{
  result=db.exec(
    "INSERT INTO compliance_events (request_id, policy_id, regulation, violated, user_override, timestamp) VALUES (?, ?, ?, ?, ?, ?)";
    @(event.requestid; event.policyid; event.regulation; db.boolval(event.violated); db.boolval(event.useroverride); db.i64val(event.timestamp))
  );
  |result{
    $ok:
      <true;
    $err:e
      log.warn(str.concat("compliance: failed to record event: "; e));
      <false
  };
};

f=summarise(fromts:i64; tots:i64):$compliancesummary{
  totalresult=db.queryone(
    "SELECT COUNT(*) FROM compliance_events WHERE timestamp >= ? AND timestamp <= ?";
    @(db.i64val(fromts); db.i64val(tots))
  );
  total=db.rowi32(totalresult; 0);

  violationsresult=db.queryone(
    "SELECT COUNT(*) FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND violated = 1";
    @(db.i64val(fromts); db.i64val(tots))
  );
  violations=db.rowi32(violationsresult; 0);

  overridesresult=db.queryone(
    "SELECT COUNT(*) FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND user_override = 1";
    @(db.i64val(fromts); db.i64val(tots))
  );
  overrides=db.rowi32(overridesresult; 0);

  rate=(total > 0){
    <f32.fromi32(violations) / f32.fromi32(total)
  }:{
    <0.0
  };

  topresult=db.query(
    "SELECT regulation FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? AND violated = 1 GROUP BY regulation ORDER BY COUNT(*) DESC LIMIT 5";
    @(db.i64val(fromts); db.i64val(tots))
  );
  topregs=@();
  ri=0;
  loop ri < db.rowslen(topresult){
    topregs=arr.push(topregs; db.rowstr(topresult; ri; 0));
    ri=ri+1
  };

  <$compliancesummary{
    periodstart:fromts;
    periodend:tots;
    totalrequests:total;
    violations:violations;
    useroverrides:overrides;
    violationrate:rate;
    topregulations:topregs
  };
};

f=exportevents(fromts:i64; tots:i64):@$complianceevent{
  rows=db.query(
    "SELECT request_id, policy_id, regulation, violated, user_override, timestamp FROM compliance_events WHERE timestamp >= ? AND timestamp <= ? ORDER BY timestamp ASC";
    @(db.i64val(fromts); db.i64val(tots))
  );
  events=@();
  i=0;
  loop i < db.rowslen(rows){
    ev=$complianceevent{
      requestid:db.rowstr(rows; i; 0);
      policyid:db.rowstr(rows; i; 1);
      regulation:db.rowstr(rows; i; 2);
      violated:db.rowbool(rows; i; 3);
      useroverride:db.rowbool(rows; i; 4);
      timestamp:db.rowi64(rows; i; 5)
    };
    events=arr.push(events; ev);
    i=i+1
  };
  <events
};

f=topviolations(limit:i32):@str{
  rows=db.query(
    "SELECT policy_id FROM compliance_events WHERE violated = 1 GROUP BY policy_id ORDER BY COUNT(*) DESC LIMIT ?";
    @(db.i32val(limit))
  );
  ids=@();
  i=0;
  loop i < db.rowslen(rows){
    ids=arr.push(ids; db.rowstr(rows; i; 0));
    i=i+1
  };
  <ids
};

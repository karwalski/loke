m=core.policy.types;
t=$policyrule{ id:str; description:str; action:str; severity:str };

t=$regulation{ name:str; jurisdiction:str; rules:@$policyrule; version:str };

t=$policyset{ name:str; source:str; regulations:@$regulation; loadedat:i64; hash:str };

t=$policyviolation{ ruleid:str; ruledesc:str; action:str; severity:str; context:str };

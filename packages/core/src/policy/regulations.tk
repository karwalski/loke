m=core.policy.regulations;
i=t:policy.types;

f=gdpr():i64{
  <$regulation{
    name:"GDPR";
    jurisdiction:"EU";
    version:"2016/679";
    rules:@(
      $policyrule{ id:"gdpr-pii-export"; description:"Personal data must not leave EU without adequacy decision"; action:"warn"; severity:"high" };
      $policyrule{ id:"gdpr-consent"; description:"Processing requires valid consent or legitimate interest"; action:"warn"; severity:"high" };
      $policyrule{ id:"gdpr-minimisation"; description:"Only collect data necessary for stated purpose"; action:"log"; severity:"medium" };
      $policyrule{ id:"gdpr-retention"; description:"Data must not be retained longer than necessary"; action:"log"; severity:"medium" };
      $policyrule{ id:"gdpr-right-erasure"; description:"Users have right to erasure — no persistent PII storage"; action:"warn"; severity:"high" }
    )
  }
};

f=auprivacyact():i64{
  <$regulation{
    name:"Australian Privacy Act 1988";
    jurisdiction:"AU";
    version:"1988";
    rules:@(
      $policyrule{ id:"apa-sensitive-info"; description:"Sensitive information requires explicit consent"; action:"warn"; severity:"high" };
      $policyrule{ id:"apa-cross-border"; description:"Cross-border disclosure requires safeguards"; action:"warn"; severity:"high" };
      $policyrule{ id:"apa-collection-notice"; description:"Must notify individuals of collection purpose"; action:"log"; severity:"medium" }
    )
  }
};

f=hipaa():i64{
  <$regulation{
    name:"HIPAA";
    jurisdiction:"US";
    version:"1996";
    rules:@(
      $policyrule{ id:"hipaa-phi"; description:"Protected Health Information must not be transmitted without authorisation"; action:"block"; severity:"critical" };
      $policyrule{ id:"hipaa-minimum-necessary"; description:"Use minimum necessary PHI for purpose"; action:"warn"; severity:"high" };
      $policyrule{ id:"hipaa-audit"; description:"All PHI access must be logged"; action:"log"; severity:"high" }
    )
  }
};

f=ccpa():i64{
  <$regulation{
    name:"CCPA";
    jurisdiction:"US-CA";
    version:"2018";
    rules:@(
      $policyrule{ id:"ccpa-opt-out"; description:"Must honour opt-out of personal information sale"; action:"warn"; severity:"high" };
      $policyrule{ id:"ccpa-disclosure"; description:"Must disclose categories of personal information collected"; action:"log"; severity:"medium" }
    )
  }
};

f=ukgdpr():i64{
  <$regulation{
    name:"UK GDPR";
    jurisdiction:"UK";
    version:"2021";
    rules:@(
      $policyrule{ id:"gdpr-pii-export"; description:"Personal data must not leave EU without adequacy decision"; action:"warn"; severity:"high" };
      $policyrule{ id:"gdpr-consent"; description:"Processing requires valid consent or legitimate interest"; action:"warn"; severity:"high" };
      $policyrule{ id:"gdpr-minimisation"; description:"Only collect data necessary for stated purpose"; action:"log"; severity:"medium" };
      $policyrule{ id:"gdpr-retention"; description:"Data must not be retained longer than necessary"; action:"log"; severity:"medium" };
      $policyrule{ id:"gdpr-right-erasure"; description:"Users have right to erasure — no persistent PII storage"; action:"warn"; severity:"high" }
    )
  }
};

f=pdpa():i64{
  <$regulation{
    name:"PDPA";
    jurisdiction:"SG";
    version:"2012";
    rules:@(
      $policyrule{ id:"pdpa-purpose"; description:"Personal data collected only for stated purpose"; action:"warn"; severity:"high" };
      $policyrule{ id:"pdpa-consent"; description:"Consent required before collection"; action:"warn"; severity:"high" }
    )
  }
};

f=allregulations():@i64{
  <@(
    gdpr();
    auprivacyact();
    hipaa();
    ccpa();
    ukgdpr();
    pdpa()
  )
};

f=defaultset():i64{
  <$policyset{
    name:"loke-defaults";
    source:"built-in";
    regulations:allregulations();
    loadedat:std.nowms();
    hash:""
  }
};

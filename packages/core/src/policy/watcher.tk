
m=core.policy.watcher;
i=s:core.policy.schema;
i=loader:core.policy.loader;
i=merge:core.policy.merge;
i=validate:core.policy.validate;
i=file:std.file;
i=str:std.str;
i=log:shared.log;

t=$watchstate{
  enterprisepath:$str;
  teampath:$str;
  userpath:$str;
  enterprisehash:$str;
  teamhash:$str;
  userhash:$str;
  current:i64
};

f=init(enterprisepath:$str;teampath:$str;userpath:$str):$watchstate!$lokeerr{
  let enterprise=mt loader.loadfile(enterprisepath) {
    $ok:p p;
    $$err:e s.defaultpolicy()
  };
  let team=mt loader.loadfile(teampath) {
    $ok:p p;
    $$err:e s.defaultpolicy()
  };
  let user=mt loader.loadfile(userpath) {
    $ok:p p;
    $$err:e s.defaultpolicy()
  };
  let merged=merge.mergetiers(enterprise;team;user);
  let vr=validate.validate(merged);
  if(vr.valid){
    log.info("policy watcher initialised";"policy.watcher";"system")
  }el{
    log.warn("policy loaded with validation errors";"policy.watcher";"system")
  };
  <$ok($watchstate{
    enterprisepath:$enterprisepath;
    teampath:$teampath;
    userpath:$userpath;
    enterprisehash:$hashfile(enterprisepath);
    teamhash:$hashfile(teampath);
    userhash:$hashfile(userpath);
    current:$merged
  })
};

f=check(state:$watchstate):$watchstate{
  let ehash=hashfile(state.enterprisepath);
  let thash=hashfile(state.teampath);
  let uhash=hashfile(state.userpath);
  let changed=false;
  if(str.eq(ehash;state.enterprisehash)){}el{changed=true};
  if(str.eq(thash;state.teamhash)){}el{changed=true};
  if(str.eq(uhash;state.userhash)){}el{changed=true};
  if(changed){
    log.info("policy file change detected, reloading";"policy.watcher";"system");
    let result=mt init(state.enterprisepath;state.teampath;state.userpath) {
      $ok:s s;
      $$err:e state
    };
    <result
  }el{
    <state
  };
};

f=hashfile(path:$str):$str{
  let content=mt file.read(path) {$ok:s s;$$err:e ""};
  let len=str.fromint(str.len(content));
  let prefix=if(str.len(content)>64){str.slice(content;0;64)}el{content};
  <str.concat(len;str.concat(":";prefix))
};

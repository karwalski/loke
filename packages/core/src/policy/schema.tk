m=core.policy.schema;

t=$classification{
  $public:i64;
  $internal:i64;
  $confidential:i64;
  $restricted:i64
};

t=$policyaction{
  $info:i64;
  $advisory:i64;
  $warning:i64;
  $block:i64
};

t=$providerpermission{
  providerid:str;
  allowed:bool;
  maxsensitivity:str;
  requiresdpa:bool;
  notes:str
};

t=$anonymisationrule{
  entitytype:str;
  action:str;
  strength:str;
  exceptions:@str
};

t=$budgetlimit{
  period:str;
  maxtokens:i64;
  maxcostusd:f64;
  actiononexceed:str
};

t=$retentionpolicy{
  auditlogdays:i64;
  conversationdays:i64;
  piimappingdays:i64;
  cachedays:i64
};

t=$mcppermission{
  serverid:str;
  allowedtools:@str;
  deniedtools:@str;
  maxcostpercall:f64;
  requiresapproval:bool
};

t=$policy{
  version:str;
  name:str;
  description:str;
  source:str;
  priority:i64;
  classificationdefault:str;
  providers:@$providerpermission;
  anonymisation:@$anonymisationrule;
  budget:$budgetlimit;
  retention:$retentionpolicy;
  mcpservers:@$mcppermission;
  allowedusecases:@str;
  blockedentitytypes:@str;
  crossborderallowed:bool;
  requireapprovalabove:str;
  customrules:@str
};

t=$policysource{
  sourcetype:str;
  path:str;
  url:str;
  refreshinterval:i64;
  authtype:str;
  authtokenenv:str;
  required:bool
};

t=$validationresult{
  valid:bool;
  errors:@str;
  warnings:@str
};

f=defaultpolicy():$policy{
  <$policy{
    version:"1.0";
    name:"default";
    description:"Built-in default policy";
    source:"builtin";
    priority:0;
    classificationdefault:"confidential";
    providers:@();
    anonymisation:@();
    budget:$budgetlimit{period:"monthly";maxtokens:0;maxcostusd:0.0;actiononexceed:"advisory"};
    retention:$retentionpolicy{auditlogdays:1825;conversationdays:90;piimappingdays:30;cachedays:7};
    mcpservers:@();
    allowedusecases:@();
    blockedentitytypes:@();
    crossborderallowed:false;
    requireapprovalabove:"confidential";
    customrules:@()
  }
};

m=core.policy.merge;
i=s:core.policy.schema;
i=str:std.str;
i=log:shared.log;

f=mergetwo(base:$policy;overlay:$policy):$policy{
  let name=if(str.len(overlay.name)>0){overlay.name}el{base.name};
  let desc=if(str.len(overlay.description)>0){overlay.description}el{base.description};
  let source=str.concat(base.source;str.concat("+";overlay.source));
  let priority=if(overlay.priority>base.priority){overlay.priority}el{base.priority};
  let classification=if(str.len(overlay.classificationdefault)>0){overlay.classificationdefault}el{base.classificationdefault};
  let providers=if(overlay.providers.len>0){overlay.providers}el{base.providers};
  let anonymisation=if(overlay.anonymisation.len>0){overlay.anonymisation}el{base.anonymisation};
  let budget=if(overlay.budget.maxtokens>0){overlay.budget}el{base.budget};
  let retention=overlay.retention;
  let mcp=if(overlay.mcpservers.len>0){overlay.mcpservers}el{base.mcpservers};
  let usecases=if(overlay.allowedusecases.len>0){overlay.allowedusecases}el{base.allowedusecases};
  let blocked=mergestringlists(base.blockedentitytypes;overlay.blockedentitytypes);
  let crossborder=overlay.crossborderallowed;
  let approval=if(str.len(overlay.requireapprovalabove)>0){overlay.requireapprovalabove}el{base.requireapprovalabove};
  let rules=mergestringlists(base.customrules;overlay.customrules);
  <$policy{
    version:base.version;
    name:name;
    description:desc;
    source:source;
    priority:priority;
    classificationdefault:classification;
    providers:providers;
    anonymisation:anonymisation;
    budget:budget;
    retention:retention;
    mcpservers:mcp;
    allowedusecases:usecases;
    blockedentitytypes:blocked;
    crossborderallowed:crossborder;
    requireapprovalabove:approval;
    customrules:rules
  }
};

f=mergestringlists(a:@str;b:@str):@str{
  let result=mut.a;
  b.each|item|{
    let found=mut.false;
    a.each|existing|{
      if(str.eq(existing;item)){found=true}el{}
    };
    if(found){}el{
      result=@(result;item)
    }
  };
  <result
};

f=mergetiers(enterprise:$policy;team:$policy;user:$policy):$policy{
  log.info("merging policy tiers: enterprise > team > user";"policy.merge";"system");
  let base=s.defaultpolicy();
  let withuser=mergetwo(base;user);
  let withteam=mergetwo(withuser;team);
  let final=mergetwo(withteam;enterprise);
  log.info(str.concat("merged policy: ";final.name);"policy.merge";"system");
  <final
};

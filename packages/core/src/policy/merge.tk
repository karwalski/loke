m=core.policy.merge;
i=s:core.policy.schema;
i=str:std.str;
i=log:shared.log;

f=mergetwo(base:$policy;overlay:$policy):$policy{
  let name=mut.base.name; if(str.len(overlay.name)>0){name=overlay.name}el{};
  let desc=mut.base.description; if(str.len(overlay.description)>0){desc=overlay.description}el{};
  let source=str.concat(base.source;str.concat("+";overlay.source));
  let priority=mut.base.priority; if(overlay.priority>base.priority){priority=overlay.priority}el{};
  let classification=mut.base.classificationdefault; if(str.len(overlay.classificationdefault)>0){classification=overlay.classificationdefault}el{};
  let providers=mut.base.providers; if(overlay.providers.len>0){providers=overlay.providers}el{};
  let anonymisation=mut.base.anonymisation; if(overlay.anonymisation.len>0){anonymisation=overlay.anonymisation}el{};
  let budget=mut.base.budget; if(overlay.budget.maxtokens>0){budget=overlay.budget}el{};
  let retention=overlay.retention;
  let mcp=mut.base.mcpservers; if(overlay.mcpservers.len>0){mcp=overlay.mcpservers}el{};
  let usecases=mut.base.allowedusecases; if(overlay.allowedusecases.len>0){usecases=overlay.allowedusecases}el{};
  let blocked=mergestringlists(base.blockedentitytypes;overlay.blockedentitytypes);
  let crossborder=overlay.crossborderallowed;
  let approval=mut.base.requireapprovalabove; if(str.len(overlay.requireapprovalabove)>0){approval=overlay.requireapprovalabove}el{};
  let rules=mergestringlists(base.customrules;overlay.customrules);
  <$policy{
    version:base.version;
    name:name;
    description:desc;
    source:source;
    priority:priority;
    classificationdefault:classification;
    providers:providers;
    anonymisation:anonymisation;
    budget:budget;
    retention:retention;
    mcpservers:mcp;
    allowedusecases:usecases;
    blockedentitytypes:blocked;
    crossborderallowed:crossborder;
    requireapprovalabove:approval;
    customrules:rules
  }
};

f=mergestringlists(a:@str;b:@str):@str{
  let result=mut.a;
  b.each|item|{
    let found=mut.false;
    a.each|existing|{
      if(str.eq(existing;item)){found=true}el{}
    };
    if(found){}el{
      result=@(result;item)
    }
  };
  <result
};

f=mergetiers(enterprise:$policy;team:$policy;user:$policy):$policy{
  log.info("merging policy tiers: enterprise > team > user";"policy.merge";"system");
  let base=s.defaultpolicy();
  let withuser=mergetwo(base;user);
  let withteam=mergetwo(withuser;team);
  let final=mergetwo(withteam;enterprise);
  log.info(str.concat("merged policy: ";final.name);"policy.merge";"system");
  <final
};

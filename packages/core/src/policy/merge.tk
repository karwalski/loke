
m=core.policy.merge;
i=s:core.policy.schema;
i=str:std.str;
i=log:shared.log;

f=mergetwo(base:i64;overlay:i64):i64{
  let name=if(str.len(overlay.name)>0):i64{overlay.name}el{base.name};
  let desc=if(str.len(overlay.description)>0):i64{overlay.description}el{base.description};
  let source=str.concat(base.source;str.concat("+";overlay.source));
  let priority=if(overlay.priority>base.priority):i64{overlay.priority}el{base.priority};
  let classification=if(str.len(overlay.classificationdefault)>0):i64{overlay.classificationdefault}el{base.classificationdefault};
  let providers=if(overlay.providers.len>0):i64{overlay.providers}el{base.providers};
  let anonymisation=if(overlay.anonymisation.len>0):i64{overlay.anonymisation}el{base.anonymisation};
  let budget=if(overlay.budget.maxtokens>0):i64{overlay.budget}el{base.budget};
  let retention=overlay.retention;
  let mcp=if(overlay.mcpservers.len>0):i64{overlay.mcpservers}el{base.mcpservers};
  let usecases=if(overlay.allowedusecases.len>0):i64{overlay.allowedusecases}el{base.allowedusecases};
  let blocked=mergestringlists(base.blockedentitytypes;overlay.blockedentitytypes);
  let crossborder=overlay.crossborderallowed;
  let approval=if(str.len(overlay.requireapprovalabove)>0):i64{overlay.requireapprovalabove}el{base.requireapprovalabove};
  let rules=mergestringlists(base.customrules;overlay.customrules);
  <$policy{
    version:i64;
    name:$name;
    description:$desc;
    source:$source;
    priority:$priority;
    classificationdefault:$classification;
    providers:$providers;
    anonymisation:$anonymisation;
    budget:$budget;
    retention:$retention;
    mcpservers:$mcp;
    allowedusecases:$usecases;
    blockedentitytypes:$blocked;
    crossborderallowed:$crossborder;
    requireapprovalabove:$approval;
    customrules:$rules
  };
};

f=mergestringlists(a:@$str;b:@$str:@$str{
  let result=mut.a;
  b.each|item{
    let found=false;
    a.each|existing{
      if(str.eq(existing;item)){ found=true }el{};
    };
    if(found){}el{
      result=@.push(result;item)
    };
  };
  <result
};

f=mergetiers(enterprise:i64;team:i64;user:i64):i64{
  log.info("merging policy tiers: enterprise > team > user";"policy.merge";"system");
  let base=s.defaultpolicy();
  let withuser=mergetwo(base;user);
  let withteam=mergetwo(withuser;team);
  let final=mergetwo(withteam;enterprise);
  log.info(str.concat("merged policy: ";final.name);"policy.merge";"system");
  <final
};

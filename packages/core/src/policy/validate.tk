
m=core.policy.validate;
i=s:core.policy.schema;
i=str:std.str;
i=log:shared.log;

f=validate(policy:$s.policy):$s.validationresult{
  let errors=mut.@str;
  let warnings=mut.@str;

  if(str.len(policy.version)=0){
    errors=@.push(errors;"missing required field: version")
  }el{};

  if(str.len(policy.name)=0){
    errors=@.push(errors;"missing required field: name")
  }el{};

  let validclass=str.eq(policy.classificationdefault;"public");
  let validclass=validclass;
  if(str.eq(policy.classificationdefault;"internal")){validclass=true}el{};
  if(str.eq(policy.classificationdefault;"confidential")){validclass=true}el{};
  if(str.eq(policy.classificationdefault;"restricted")){validclass=true}el{};
  if(validclass){}el{
    errors=@.push(errors;str.concat("invalid classification_default: ";policy.classificationdefault))
  };

  if(policy.budget.maxtokens<0){
    errors=@.push(errors;"budget.max_tokens must be non-negative")
  }el{};
  if(policy.budget.maxcostusd<0.0){
    errors=@.push(errors;"budget.max_cost_usd must be non-negative")
  }el{};

  if(policy.retention.auditlogdays<0){
    warnings=@.push(warnings;"retention.audit_log_days is negative; will use default")
  }el{};

  policy.providers.each|p{
    if(str.len(p.providerid)=0){
      errors=@.push(errors;"provider entry missing provider_id")
    }el{};
  };

  policy.anonymisation.each|a{
    if(str.len(a.entitytype)=0){
      errors=@.push(errors;"anonymisation rule missing entity_type")
    }el{};
  };

  if(str.len(policy.requireapprovalabove)>0){
    let validlevel=str.eq(policy.requireapprovalabove;"public");
    if(str.eq(policy.requireapprovalabove;"internal")){validlevel=true}el{};
    if(str.eq(policy.requireapprovalabove;"confidential")){validlevel=true}el{};
    if(str.eq(policy.requireapprovalabove;"restricted")){validlevel=true}el{};
    if(validlevel){}el{
      warnings=@.push(warnings;str.concat("unknown require_approval_above level: ";policy.requireapprovalabove))
    };
  }el{};

  let valid=errors.len=0;
  if(valid){
    log.info("policy validation passed";"policy.validate";"system")
  }el{
    log.warn(str.concat("policy validation failed with ";str.concat(str.fromint(errors.len);" errors"));"policy.validate";"system")
  };

  <$s.validationresult{valid:$valid;errors:$errors;warnings:$warnings};
};

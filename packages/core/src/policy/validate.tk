m=core.policy.validate;
i=s:core.policy.schema;
i=str:std.str;
i=log:shared.log;

f=validate(policy:$policy):$validationresult{
  let errors=mut.@();
  let warnings=mut.@();

  if(str.len(policy.version)=0){
    errors=@(errors;"missing required field: version")
  }el{};

  if(str.len(policy.name)=0){
    errors=@(errors;"missing required field: name")
  }el{};

  let validclass=mut.str.eq(policy.classificationdefault;"public");
  if(str.eq(policy.classificationdefault;"internal")){validclass=true}el{};
  if(str.eq(policy.classificationdefault;"confidential")){validclass=true}el{};
  if(str.eq(policy.classificationdefault;"restricted")){validclass=true}el{};
  if(validclass){}el{
    errors=@(errors;str.concat("invalid classification_default: ";policy.classificationdefault))
  };

  if(policy.budget.maxtokens<0){
    errors=@(errors;"budget.max_tokens must be non-negative")
  }el{};
  if(policy.budget.maxcostusd<0.0){
    errors=@(errors;"budget.max_cost_usd must be non-negative")
  }el{};

  if(policy.retention.auditlogdays<0){
    warnings=@(warnings;"retention.audit_log_days is negative; will use default")
  }el{};

  lp(let i=0;i<str.arraylen(policy.providers);i=i+1){ let p=str.arrayget(policy.providers;i);
    if(str.len(p.providerid)=0){
      errors=@(errors;"provider entry missing provider_id")
    }el{}
  };

  lp(let i=0;i<str.arraylen(policy.anonymisation);i=i+1){ let a=str.arrayget(policy.anonymisation;i);
    if(str.len(a.entitytype)=0){
      errors=@(errors;"anonymisation rule missing entity_type")
    }el{}
  };

  if(str.len(policy.requireapprovalabove)>0){
    let validlevel=mut.str.eq(policy.requireapprovalabove;"public");
    if(str.eq(policy.requireapprovalabove;"internal")){validlevel=true}el{};
    if(str.eq(policy.requireapprovalabove;"confidential")){validlevel=true}el{};
    if(str.eq(policy.requireapprovalabove;"restricted")){validlevel=true}el{};
    if(validlevel){}el{
      warnings=@(warnings;str.concat("unknown require_approval_above level: ";policy.requireapprovalabove))
    }
  }el{};

  let valid=errors.len=0;
  if(valid){
    log.info("policy validation passed";"policy.validate";"system")
  }el{
    log.warn(str.concat("policy validation failed with ";str.concat(str.fromint(errors.len);" errors"));"policy.validate";"system")
  };

  <$validationresult{valid:valid;errors:errors;warnings:warnings}
};


m=core.policy.conflict;
i=s:core.policy.schema;
i=str:std.str;
i=log:shared.log;

t=$conflictresolution{
  chosenvalue:$str;
  chosensource:$str;
  reason:$str
};

f=resolveretention(adays:i64;asource:$str;bdays:i64;bsource:$str):$conflictresolution{
  if(adays<=bdays){
    <$conflictresolution{chosenvalue:i64(adays);chosensource:$asource;reason:"shortest retention wins (data minimisation)"};
  }el{
    <$conflictresolution{chosenvalue:i64(bdays);chosensource:$bsource;reason:"shortest retention wins (data minimisation)"};
  };
};

f=resolveanonymisation(a:$str;asource:$str;b:$str;bsource:$str):$conflictresolution{
  let arank=strengthrank(a);
  let brank=strengthrank(b);
  if(arank>brank){
    <$conflictresolution{chosenvalue:$a;chosensource:$asource;reason:"strongest anonymisation wins"};
  }el{
    <$conflictresolution{chosenvalue:$b;chosensource:$bsource;reason:"strongest anonymisation wins"};
  };
};

f=strengthrank(s:$str):i64{
  if(str.eq(s;"full")){<4}el{
    if(str.eq(s;"pseudonymisation")){<3}el{
      if(str.eq(s;"reasonable")){<2}el{
        if(str.eq(s;"placeholder")){<1}el{<0};
      };
    };
  };
};

f=resolvepiiscope(a:$str;asource:$str;b:$str;bsource:$str):$conflictresolution{
  let arank=scoperank(a);
  let brank=scoperank(b);
  if(arank>brank){
    <$conflictresolution{chosenvalue:$a;chosensource:$asource;reason:"broadest PII scope wins (most protective)"};
  }el{
    <$conflictresolution{chosenvalue:$b;chosensource:$bsource;reason:"broadest PII scope wins (most protective)"};
  };
};

f=scoperank(s:$str):i64{
  if(str.eq(s;"broad")){<3}el{
    if(str.eq(s;"phi_identifiers")){<2}el{
      if(str.eq(s;"email_phone")){<1}el{<0};
    };
  };
};

f=resolvecrossborder(a:bool;asource:$str;b:bool;bsource:$str):$conflictresolution{
  if(a){
    if(b){
      <$conflictresolution{chosenvalue:"allowed";chosensource:$asource;reason:"both allow cross-border"};
    }el{
      <$conflictresolution{chosenvalue:"blocked";chosensource:$bsource;reason:"most restrictive wins"};
    };
  }el{
    <$conflictresolution{chosenvalue:"blocked";chosensource:$asource;reason:"most restrictive wins"};
  };
};

f=resolveauditretention(adays:i64;asource:$str;bdays:i64;bsource:$str):$conflictresolution{
  if(adays>bdays){
    <$conflictresolution{chosenvalue:i64(adays);chosensource:$asource;reason:"longest audit retention wins (compliance)"};
  }el{
    <$conflictresolution{chosenvalue:i64(bdays);chosensource:$bsource;reason:"longest audit retention wins (compliance)"};
  };
};

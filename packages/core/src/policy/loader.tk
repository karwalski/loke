m=core.policy.loader;
i=t:policy.types
i=file:std.file
i=http:std.http
i=json:std.json
i=log:shared.log
i=str:std.str

t=$loaderconfig{ policydir:str; enterpriseurl:str; hotreload:bool; reloadintervalseconds:i32 };

f=defaultconfig(datadir:str):$loaderconfig{
  <$loaderconfig{
    policydir:str.concat(datadir;"/policies");
    enterpriseurl:"";
    hotreload:true;
    reloadintervalseconds:60
  };
};

f=loadfile(path:str):t.$policyset{
  result=file.read(path);
  |result{
    $ok:contents
      parsed=json.parse(contents);
      |parsed{
        $ok:data
          <t.$policyset{
            name:json.getstr(data;"name");
            source:path;
            regulations:json.getregulations(data;"regulations");
            loadedat:std.nowms();
            hash:str.randhex(8)
          };
        $err:e
          log.warn(str.concat("policy: failed to parse file: ";path));
          <t.$policyset{
            name:"";
            source:path;
            regulations:@();
            loadedat:std.nowms();
            hash:str.randhex(8)
          };
      };
    $err:e
      log.warn(str.concat("policy: failed to read file: ";path));
      <t.$policyset{
        name:"";
        source:path;
        regulations:@();
        loadedat:std.nowms();
        hash:str.randhex(8)
      };
  };
};

f=loadurl(url:str):t.$policyset{
  result=http.get(url);
  |result{
    $ok:resp
      parsed=json.parse(resp.body);
      |parsed{
        $ok:data
          <t.$policyset{
            name:json.getstr(data;"name");
            source:url;
            regulations:json.getregulations(data;"regulations");
            loadedat:std.nowms();
            hash:str.randhex(8)
          };
        $err:e
          log.warn(str.concat("policy: failed to parse url response: ";url));
          <t.$policyset{
            name:"";
            source:url;
            regulations:@();
            loadedat:std.nowms();
            hash:""
          };
      };
    $err:e
      log.warn(str.concat("policy: failed to fetch url: ";url));
      <t.$policyset{
        name:"";
        source:url;
        regulations:@();
        loadedat:std.nowms();
        hash:""
      };
  };
};

f=loadall(cfg:$loaderconfig):@(t.$policyset){
  sets=@();
  files=file.listglob(cfg.policydir;"*.json");
  |files{
    $ok:paths
      i=0;
      loop i < paths.len{
        path=paths.get(i);
        ps=loadfile(path);
        sets=sets.push(ps);
        i=i+1
      };
    $err:e
      log.warn(str.concat("policy: could not list policy dir: ";cfg.policydir))
  };
  cfg.enterpriseurl != ""{
    ps=loadurl(cfg.enterpriseurl);
    sets=sets.push(ps)
  };
  <sets
};

f=checkreloadneeded(cfg:$loaderconfig;lastloadedat:i64):bool{
  now=std.nowms();
  threshold=cfg.reloadintervalseconds * 1000;
  <now - lastloadedat > threshold
};

f=evaluate(sets:@(t.$policyset);context:str;sensitivity:str):@(t.$policyviolation){
  violations=@();
  severityrank=f(sev:str):i32{
    sev == "critical"{ <4 };
    sev == "high"{ <3 };
    sev == "medium"{ <2 };
    sev == "low"{ <1 };
    <0
  };
  sensrank=severityrank(sensitivity);
  si=0;
  loop si < sets.len{
    ps=sets.get(si);
    ri=0;
    loop ri < ps.regulations.len{
      reg=ps.regulations.get(ri);
      ki=0;
      loop ki < reg.rules.len{
        rule=reg.rules.get(ki);
        keywordmatch=str.contains(context;rule.id) || str.contains(context;rule.description);
        severitymatch=severityrank(rule.severity) >= sensrank;
        keywordmatch || severitymatch{
          v=t.$policyviolation{
            ruleid:rule.id;
            ruledesc:rule.description;
            action:rule.action;
            severity:rule.severity;
            context:context
          };
          violations=violations.push(v)
        };
        ki=ki+1
      };
      ri=ri+1
    };
    si=si+1
  };
  <violations
};

f=formatviolations(violations:@(t.$policyviolation)):str{
  violations.len == 0{
    <"No policy violations."
  };
  out="";
  i=0;
  loop i < violations.len{
    v=violations.get(i);
    line=str.concat("[";str.upper(v.severity);"] ";v.ruleid;": ";v.ruledesc;" → ";v.action);
    out == ""{
      out=line
    };
    out != ""{
      out=str.concat(out;"
";line)
    };
    i=i+1
  };
  <out
};

m=core.policy.loader;
i=file:std.file;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=time:std.time;
i=t:core.policy.types;
i=reg:core.policy.presets.registry;
i=jx:shared.jsonobj;

t=$loaderconfig{ policydir:str; enterpriseurl:str; hotreload:bool; reloadintervalseconds:i32 };

(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=defaultconfig(datadir:str):$loaderconfig{
  <$loaderconfig{
    policydir:str.concat(datadir;"/policies");
    enterpriseurl:"";
    hotreload:true;
    reloadintervalseconds:60
  }
};

f=emptypolicyset(source:str;hash:str):$policyset{
  <$policyset{
    name:"";
    source:source;
    regulations:@();
    loadedat:time.nowms();
    hash:hash
  }
};

(* X4b.5. The regulations of a policy document, read with the typed accessors. This used
   `json.getregulations`, one of std.json's untyped ABI names (T-32). It returned nothing,
   so every policy loaded with its name and NO RULES, and nothing it declared could ever be
   evaluated. Strings are read with jx.strvalue, which keeps escapes (T-44). *)
f=rulesof(items:@$json):@$policyrule{
  let rules=mut.@();
  lp(let i=0;i<items.len;i=i+1){
    let r=items.get(i);
    rules=rules.push($policyrule{id:jx.strvalue(r;"id";"");description:jx.strvalue(r;"description";"");action:jx.strvalue(r;"action";"");severity:jx.strvalue(r;"severity";"")})
  };
  <rules
};

f=regulationof(o:$json):$regulation{
  let rules=mt json.arr(o;"rules") {$ok:a rulesof(a); $err:e @()};
  <$regulation{name:jx.strvalue(o;"name";"");jurisdiction:jx.strvalue(o;"jurisdiction";"");rules:rules;version:jx.strvalue(o;"version";"")}
};

f=regulationsof(doc:str):@$regulation{
  let regs=mut.@();
  let items=mt json.arr(json.dec(doc);"regulations") {$ok:a a; $err:e @()};
  lp(let i=0;i<items.len;i=i+1){
    regs=regs.push(regulationof(items.get(i)))
  };
  <regs
};

f=parsefilecontents(contents:str;path:str):i64{
  let parsed=json.decode(contents);
  <mt parsed {
    $ok:data $policyset{
        name:json.str(data;"name");
        source:path;
        regulations:regulationsof(contents);
        loadedat:time.nowms();
        hash:str.randhex(8)
      };
    $err:e emptypolicyset(path;str.randhex(8))
  }
};

f=loadfile(path:str):i64{
  let result=file.read(path);
  <mt result {
    $ok:contents parsefilecontents(contents;path);
    $err:e emptypolicyset(path;str.randhex(8))
  }
};

f=parseurlcontents(body:str;url:str):i64{
  let parsed=json.decode(body);
  <mt parsed {
    $ok:data $policyset{
        name:json.str(data;"name");
        source:url;
        regulations:regulationsof(body);
        loadedat:time.nowms();
        hash:str.randhex(8)
      };
    $err:e emptypolicyset(url;"")
  }
};

f=loadurl(url:str):i64{
  <mt http.get(url) {
    $ok:resp policyfromresponse(resp;url);
    $err:e emptypolicyset(url;"")
  }
};

(* Typed so that resp.body resolves: a match binding carries no struct type, and
   `body` is declared at different offsets by more than one struct. *)
f=policyfromresponse(resp:$httpresp;url:str):i64{
  <parseurlcontents(str.frombytes(resp.body);url)
};

f=loadallpaths(cfg:$loaderconfig;paths:@str):@i64{
  let sets=mut.@();
  let i=mut.0;
  lp(let lv=0;i < paths.len;lv=lv){
    let ps=loadfile(paths.get(i));
    sets=sets.push(ps);
    i=i+1
  };
  <sets
};

f=loadall(cfg:$loaderconfig):@i64{
  let files=file.listglob("\(cfg.policydir)/*.json");
  let sets=mut.mt files {
    $ok:paths loadallpaths(cfg;paths);
    $err:e @()
  };
  if(str.len(cfg.enterpriseurl) > 0){
    let ps=loadurl(cfg.enterpriseurl);
    sets=sets.push(ps)
  }el{};
  <sets
};

f=checkreloadneeded(cfg:$loaderconfig;lastloadedat:i64):bool{
  let now=time.nowms();
  <now - lastloadedat > (cfg.reloadintervalseconds * 1000)
};

(* Severity and sensitivity are different scales, and conflating them made `evaluate`
   flag almost every rule.

   `severityrank` knows critical/high/medium/low. A SENSITIVITY is
   public/internal/confidential/restricted — none of which it knows, so it returned 0 for
   every real sensitivity, and the third branch of `evaluate` tested
   `severityrank(rule.severity) > 0`, true for every rule above severity "none". With the
   eleven presets now loadable through `loadpreset` that was roughly 96 violations per
   evaluation, whatever the input.

   `sensitivityrank` exists so the two scales are at least named apart. It is not used by
   `evaluate` — see the comment there for why no comparison between the two is defensible
   with the fields `$policyrule` currently has. *)
f=sensitivityrank(given:str):i32{
  (* Case-insensitive: most of this codebase writes the levels in capitals (RESTRICTED), and
     an exact lowercase match ranked every one of those 0. *)
  let level=str.tolower(given);
  if(str.eq(level;"restricted")){ <4 as i32 }el{
    if(str.eq(level;"confidential")){ <3 as i32 }el{
      if(str.eq(level;"internal")){ <2 as i32 }el{
        if(str.eq(level;"public")){ <1 as i32 }el{
          <0 as i32
        }
      }
    }
  }
};

f=severityrank(givensev:str):i32{
  let sev=str.tolower(givensev);
  if(str.eq(sev;"critical")){ <4 as i32 }el{
    if(str.eq(sev;"high")){ <3 as i32 }el{
      if(str.eq(sev;"medium")){ <2 as i32 }el{
        if(str.eq(sev;"low")){ <1 as i32 }el{
          <0 as i32
        }
      }
    }
  }
};

(* A rule matches on what the CONTEXT says, never on its own severity.

   The third branch here used to be `severityrank(rule.severity) > severityrank(sensitivity)`,
   which is a category error in both operands — see the comment on `sensitivityrank`. It is
   removed rather than repaired, and that is a decision on the merits rather than a
   convenience: **severity describes the consequence of violating a rule, not the
   circumstances in which the rule applies.** A `critical` data-residency rule is critical
   whether the data is public or restricted; ranking it against the data's sensitivity answers
   no question anybody asked.

   Deciding "does this rule apply at this sensitivity?" needs a threshold on the rule, and
   `$policyrule` has no such field. Adding one is RG1.5 — deliberately a separate story,
   because it changes when enforcement fires and that deserves its own review.

   Nothing on the request path calls `evaluate` yet (the presets are loadable, not enforced),
   so this narrows what it reports rather than changing live behaviour. *)
f=evaluate(sets:@$policyset;context:str;sensitivity:str):@$policyviolation{
  let violations=mut.@();
  let si=mut.0;
  lp(let lv=0;si < sets.len;lv=lv){
    let ps=sets.get(si);
    let ri=mut.0;
    lp(let lv2=0;ri < ps.regulations.len;lv2=lv2){
      let reg=ps.regulations.get(ri);
      let ki=mut.0;
      lp(let lv3=0;ki < reg.rules.len;lv3=lv3){
        let rule=reg.rules.get(ki);
        let keywordmatch=str.contains(context;rule.id);
        let descmatch=str.contains(context;rule.description);
        if(keywordmatch){
          let v=$policyviolation{
            ruleid:rule.id;
            ruledesc:rule.description;
            action:rule.action;
            severity:rule.severity;
            context:context
          };
          violations=violations.push(v)
        }el{
          if(descmatch){
            let v=$policyviolation{
              ruleid:rule.id;
              ruledesc:rule.description;
              action:rule.action;
              severity:rule.severity;
              context:context
            };
            violations=violations.push(v)
          }el{}
        };
        ki=ki+1
      };
      ri=ri+1
    };
    si=si+1
  };
  <violations
};

f=formatviolations(violations:@i64):str{
  if(violations.len == 0 as u64){
    <"No policy violations."
  }el{};
  let out=mut."";
  let i=mut.0;
  lp(let lv=0;i < violations.len;lv=lv){
    let v=violations.get(i);
    let line=str.concat("[";str.concat(str.upper(v.severity);str.concat("] ";str.concat(v.ruleid;str.concat(": ";str.concat(v.ruledesc;str.concat(" -> ";v.action)))))));
    if(str.len(out) == 0){
      out=line
    }el{
      out=str.concat(out;str.concat("
";line))
    };
    i=i+1
  };
  <out
};

(* Named-preset loading. core.policy.presets is the single source of truth for what loke
   ships as a regulatory default, and core.policy.regulations — a parallel hand-written set
   of the same six regulations, with a ukgdpr() that was a verbatim copy of gdpr() — is
   gone. The registry projects a preset into the $regulation and $policyset shapes evaluate()
   already consumes, so a preset is loadable and enforceable rather than being a document.

   presetnames() is the list of valid arguments. An unrecognised name returns a set whose
   single regulation has an empty rule list, which evaluate() then finds nothing in: use
   presetknown() to tell that apart from a preset that genuinely constrains nothing. It is a
   sentinel and a predicate rather than a $policyset!$err because T-18 makes the $err arm of
   a user-declared error side dead code. *)
f=presetnames():@str{
  <reg.names()
};

f=presetknown(name:str):bool{
  <reg.hasname(name)
};

f=loadpreset(name:str):$policyset{
  <reg.policysetfor(name)
};

f=loadpresets(wanted:@str):$policyset{
  <reg.policysetformany(wanted)
};

f=builtinset():$policyset{
  <reg.defaultset()
};

f=evaluatepreset(name:str;context:str;sensitivity:str):@$policyviolation{
  <evaluate(@(loadpreset(name));context;sensitivity)
};

m=core.policy.loader;
i=t:core.policy.types;
i=file:std.file;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=str:std.str;
i=time:std.time;

t=$loaderconfig{ policydir:str; enterpriseurl:str; hotreload:bool; reloadintervalseconds:i32 };

f=defaultconfig(datadir:str):$loaderconfig{
  <$loaderconfig{
    policydir:str.concat(datadir;"/policies");
    enterpriseurl:"";
    hotreload:true;
    reloadintervalseconds:60
  }
};

f=emptypolicyset(source:str;hash:str):i64{
  <$policyset{
    name:"";
    source:source;
    regulations:@();
    loadedat:time.nowms();
    hash:hash
  }
};

f=parsefilecontents(contents:str;path:str):i64{
  let parsed=json.parse(contents);
  mt parsed {
    $ok:data $policyset{
        name:json.str(data;"name");
        source:path;
        regulations:json.getregulations(data;"regulations");
        loadedat:time.nowms();
        hash:str.randhex(8)
      };
    $err:e emptypolicyset(path;str.randhex(8))
  }
};

f=loadfile(path:str):i64{
  let result=file.read(path);
  mt result {
    $ok:contents parsefilecontents(contents;path);
    $err:e emptypolicyset(path;str.randhex(8))
  }
};

f=parseurlcontents(body:str;url:str):i64{
  let parsed=json.parse(body);
  mt parsed {
    $ok:data $policyset{
        name:json.str(data;"name");
        source:url;
        regulations:json.getregulations(data;"regulations");
        loadedat:time.nowms();
        hash:str.randhex(8)
      };
    $err:e emptypolicyset(url;"")
  }
};

f=loadurl(url:str):i64{
  let result=http.get(url);
  mt result {
    $ok:resp parseurlcontents(resp.body;url);
    $err:e emptypolicyset(url;"")
  }
};

f=loadallpaths(cfg:$loaderconfig;paths:i64):@i64{
  let sets=mut.@();
  let i=mut.0;
  lp(let lv=0;i < paths.len;lv=lv){
    let path=paths.get(i);
    let ps=loadfile(path);
    sets=sets.push(ps);
    i=i+1
  };
  <sets
};

f=loadall(cfg:$loaderconfig):@i64{
  let files=file.listglob(cfg.policydir;"*.json");
  let sets=mut.mt files {
    $ok:paths loadallpaths(cfg;paths);
    $err:e @()
  };
  if(str.len(cfg.enterpriseurl) > 0){
    let ps=loadurl(cfg.enterpriseurl);
    sets=sets.push(ps)
  }el{};
  <sets
};

f=checkreloadneeded(cfg:$loaderconfig;lastloadedat:i64):bool{
  let now=time.nowms();
  let threshold=cfg.reloadintervalseconds * 1000;
  <now - lastloadedat > threshold
};

f=severityrank(sev:str):i32{
  if(str.eq(sev;"critical")){ <4 as i32 }el{
    if(str.eq(sev;"high")){ <3 as i32 }el{
      if(str.eq(sev;"medium")){ <2 as i32 }el{
        if(str.eq(sev;"low")){ <1 as i32 }el{
          <0 as i32
        }
      }
    }
  }
};

f=evaluate(sets:@i64;context:str;sensitivity:str):@i64{
  let violations=mut.@();
  let sensrank=severityrank(sensitivity);
  let si=mut.0;
  lp(let lv=0;si < sets.len;lv=lv){
    let ps=sets.get(si);
    let ri=mut.0;
    lp(let lv2=0;ri < ps.regulations.len;lv2=lv2){
      let reg=ps.regulations.get(ri);
      let ki=mut.0;
      lp(let lv3=0;ki < reg.rules.len;lv3=lv3){
        let rule=reg.rules.get(ki);
        let keywordmatch=str.contains(context;rule.id);
        let descmatch=str.contains(context;rule.description);
        let severitymatch=severityrank(rule.severity) > sensrank;
        if(keywordmatch){
          let v=$policyviolation{
            ruleid:rule.id;
            ruledesc:rule.description;
            action:rule.action;
            severity:rule.severity;
            context:context
          };
          violations=violations.push(v)
        }el{
          if(descmatch){
            let v=$policyviolation{
              ruleid:rule.id;
              ruledesc:rule.description;
              action:rule.action;
              severity:rule.severity;
              context:context
            };
            violations=violations.push(v)
          }el{
            if(severitymatch){
              let v=$policyviolation{
                ruleid:rule.id;
                ruledesc:rule.description;
                action:rule.action;
                severity:rule.severity;
                context:context
              };
              violations=violations.push(v)
            }el{}
          }
        };
        ki=ki+1
      };
      ri=ri+1
    };
    si=si+1
  };
  <violations
};

f=formatviolations(violations:@i64):str{
  if(violations.len = 0 as u64){
    <"No policy violations."
  }el{};
  let out=mut."";
  let i=mut.0;
  lp(let lv=0;i < violations.len;lv=lv){
    let v=violations.get(i);
    let line=str.concat("[";str.concat(str.upper(v.severity);str.concat("] ";str.concat(v.ruleid;str.concat(": ";str.concat(v.ruledesc;str.concat(" -> ";v.action)))))));
    if(str.len(out) = 0){
      out=line
    }el{
      out=str.concat(out;str.concat("
";line))
    };
    i=i+1
  };
  <out
};

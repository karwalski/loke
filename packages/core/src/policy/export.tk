m=core.policy.export;

i=fb:core.policy.feedback;
i=db:storage.db;
i=file:std.file;
i=str:std.str;
i=log:shared.log;


$formatcsv:i32=0;
$formatjson:i32=1;
$formatjsonl:i32=2;

t=$exportopts{
  format:i32;
  fromts:i64;
  tots:i64;
  includeoverrides:bool;
  anonymiseids:bool
};

t=$exportresult{
  path:str;
  rows:i32;
  format:i32;
  sizebytes:i32
};

f=formatcsvrow(fields:@str):str{
  escaped=@();
  i=0;
  loop i < arr.len(fields){
    raw=fields.get(i);
    needsquote=str.contains(raw; ",") || str.contains(raw; "\"") || str.contains(raw; "
");
    cell=(needsquote){
      inner=str.replaceall(raw; "\""; "\"\"");
      <str.concat("\""; inner; "\"")
    }:{
      <raw
    };
    escaped=arr.push(escaped; cell);
    i=i+1;
  };
  <str.join(escaped; ",")
};

f=formatjsonlrecord(fields:@str; keys:@str):str{
  pairs=@();
  i=0;
  loop i < arr.len(keys){
    k=keys.get(i);
    v=(i < arr.len(fields)){ <fields.get(i) }:{ <"" };
    escapedv=str.replaceall(v; "\""; "\\"");
    pair=str.concat("\""; k; "\":\""; escapedv; "\"");
    pairs=arr.push(pairs; pair);
    i=i+1;
  };
  <str.concat("{"; str.join(pairs; ","); "}")
};

f=exportaudit(opts:$exportopts):$exportresult{
  ts=std.nowms();
  ext=(opts.format == $formatcsv){ <"csv" }:{
    (opts.format == $formatjsonl){ <"jsonl" }:{ <"json" };
  };
  path=str.concat(std.homedir(); "/.loke/exports/audit_"; str.fromi64(ts); "."; ext);

  rows=db.query(
    "SELECT id, request_id, model_id, action, timestamp, regulation, severity FROM audit_entries WHERE timestamp >= ? AND timestamp <= ? ORDER BY timestamp ASC";
    @(db.i64val(opts.fromts); db.i64val(opts.tots))
  );

  rowcount=db.rowslen(rows);
  keys=@("id";"request_id";"model_id";"action";"timestamp";"regulation";"severity");
  header=formatcsvrow(keys);

  content=(opts.format == $formatcsv){
    lines=@$header;
    i=0;
    loop i < rowcount{
      idraw=db.rowstr(rows; i; 0);
      ridraw=db.rowstr(rows; i; 1);
      idval=(opts.anonymiseids){ <str.sha256prefix(idraw; 8) }:{ <idraw };
      ridval=(opts.anonymiseids){ <str.sha256prefix(ridraw; 8) }:{ <ridraw };
      fields=@(idval; ridval; db.rowstr(rows; i; 2); db.rowstr(rows; i; 3); str.fromi64(db.rowi64(rows; i; 4)); db.rowstr(rows; i; 5); db.rowstr(rows; i; 6));
      lines=arr.push(lines; formatcsvrow(fields));
      i=i+1;
    };
    <str.join(lines; "
")
  }:{
    (opts.format == $formatjsonl){
      lines=@();
      i=0;
      loop i < rowcount{
        idraw=db.rowstr(rows; i; 0);
        ridraw=db.rowstr(rows; i; 1);
        idval=(opts.anonymiseids){ <str.sha256prefix(idraw; 8) }:{ <idraw };
        ridval=(opts.anonymiseids){ <str.sha256prefix(ridraw; 8) }:{ <ridraw };
        fields=@(idval; ridval; db.rowstr(rows; i; 2); db.rowstr(rows; i; 3); str.fromi64(db.rowi64(rows; i; 4)); db.rowstr(rows; i; 5); db.rowstr(rows; i; 6));
        lines=arr.push(lines; formatjsonlrecord(fields; keys));
        i=i+1;
      };
      <str.join(lines; "
")
    }:{
      
      items=@();
      i=0;
      loop i < rowcount{
        idraw=db.rowstr(rows; i; 0);
        ridraw=db.rowstr(rows; i; 1);
        idval=(opts.anonymiseids){ <str.sha256prefix(idraw; 8) }:{ <idraw };
        ridval=(opts.anonymiseids){ <str.sha256prefix(ridraw; 8) }:{ <ridraw };
        fields=@(idval; ridval; db.rowstr(rows; i; 2); db.rowstr(rows; i; 3); str.fromi64(db.rowi64(rows; i; 4)); db.rowstr(rows; i; 5); db.rowstr(rows; i; 6));
        items=arr.push(items; formatjsonlrecord(fields; keys));
        i=i+1;
      };
      <str.concat("["; str.join(items; ","); "]")
    };
  };

  file.ensuredir(str.concat(std.homedir(); "/.loke/exports"));
  writeresult=file.write(path; content);
  |writeresult{
    $ok:
      <$exportresult{
        path:path;
        rows:rowcount;
        format:opts.format;
        sizebytes:str.bytelen(content)
      };
    $err:e
      log.warn(str.concat("export: failed to write audit file: "; e));
      <$exportresult{ path:""; rows:0; format:opts.format; sizebytes:0 };
  };
};

f=exportcompliance(opts:$exportopts):$exportresult{
  ts=std.nowms();
  ext=(opts.format == $formatcsv){ <"csv" }:{
    (opts.format == $formatjsonl){ <"jsonl" }:{ <"json" };
  };
  path=str.concat(std.homedir(); "/.loke/exports/audit_"; str.fromi64(ts); "."; ext);

  events=fb.exportevents(opts.fromts; opts.tots);
  keys=@("request_id";"policy_id";"regulation";"violated";"user_override";"timestamp");
  header=formatcsvrow(keys);

  filtered=@();
  i=0;
  loop i < arr.len(events){
    ev=events.get(i);
    include=(opts.includeoverrides){ <true }:{ <!(ev.useroverride) };
    (include){
      filtered=arr.push(filtered; ev)
    };
    i=i+1;
  };

  rowcount=arr.len(filtered);

  content=(opts.format == $formatcsv){
    lines=@$header;
    i=0;
    loop i < rowcount{
      ev=filtered.get(i);
      ridval=(opts.anonymiseids){ <str.sha256prefix(ev.requestid; 8) }:{ <ev.requestid };
      pidval=(opts.anonymiseids){ <str.sha256prefix(ev.policyid; 8) }:{ <ev.policyid };
      fields=@(ridval; pidval; ev.regulation; str.frombool(ev.violated); str.frombool(ev.useroverride); str.fromi64(ev.timestamp));
      lines=arr.push(lines; formatcsvrow(fields));
      i=i+1;
    };
    <str.join(lines; "
")
  }:{
    (opts.format == $formatjsonl){
      lines=@();
      i=0;
      loop i < rowcount{
        ev=filtered.get(i);
        ridval=(opts.anonymiseids){ <str.sha256prefix(ev.requestid; 8) }:{ <ev.requestid };
        pidval=(opts.anonymiseids){ <str.sha256prefix(ev.policyid; 8) }:{ <ev.policyid };
        fields=@(ridval; pidval; ev.regulation; str.frombool(ev.violated); str.frombool(ev.useroverride); str.fromi64(ev.timestamp));
        lines=arr.push(lines; formatjsonlrecord(fields; keys));
        i=i+1;
      };
      <str.join(lines; "
")
    }:{
      items=@();
      i=0;
      loop i < rowcount{
        ev=filtered.get(i);
        ridval=(opts.anonymiseids){ <str.sha256prefix(ev.requestid; 8) }:{ <ev.requestid };
        pidval=(opts.anonymiseids){ <str.sha256prefix(ev.policyid; 8) }:{ <ev.policyid };
        fields=@(ridval; pidval; ev.regulation; str.frombool(ev.violated); str.frombool(ev.useroverride); str.fromi64(ev.timestamp));
        items=arr.push(items; formatjsonlrecord(fields; keys));
        i=i+1;
      };
      <str.concat("["; str.join(items; ","); "]")
    };
  };

  file.ensuredir(str.concat(std.homedir(); "/.loke/exports"));
  writeresult=file.write(path; content);
  |writeresult{
    $ok:
      <$exportresult{
        path:path;
        rows:rowcount;
        format:opts.format;
        sizebytes:str.bytelen(content)
      };
    $err:e
      log.warn(str.concat("export: failed to write compliance file: "; e));
      <$exportresult{ path:""; rows:0; format:opts.format; sizebytes:0 };
  };
};

m=core.policy.export;

i=fb:core.policy.feedback;
i=db:core.storage.db;
i=sdb:std.db;
i=file:std.file;
i=str:std.str;
i=log:shared.log;
i=std:std;
i=time:std.time;
i=sqldb:std.db;
i=crypto:std.crypto;

t=$exportopts{
  format:i32;
  fromts:i64;
  tots:i64;
  includeoverrides:bool;
  anonymiseids:bool
};

t=$exportresult{
  path:str;
  rows:i32;
  format:i32;
  sizebytes:i32
};

f=formatcsv():i32{ <0 as i32 };
f=formatjson():i32{ <1 as i32 };
f=formatjsonl():i32{ <2 as i32 };

f=formatcsvrow(fields:@str):str{
  let escaped=mut.@();
  let i=mut.0;
  lp(let lv=0;i<fields.len;lv=lv){
    let raw=fields.get(i);
    let needsquote=str.contains(raw;",") || str.contains(raw;"\"");
    let cell=mut.raw;
    if(needsquote){
      let inner=str.replaceall(raw;"\"";  "\"\"");
      cell=str.concat("\"";str.concat(inner;"\""))
    }el{};
    escaped=escaped.push(cell);
    i=i+1
  };
  <str.join(",";escaped)
};

f=formatjsonlrecord(fields:@str;keys:@str):str{
  let pairs=mut.@();
  let i=mut.0;
  lp(let lv=0;i<keys.len;lv=lv){
    let k=keys.get(i);
    let v=mut."";
    if(i<fields.len){ v=fields.get(i) }el{};
    let escapedv=str.replaceall(v;"\"";  "\\\"");
    let pair=str.concat("\"";str.concat(k;str.concat("\":\"";str.concat(escapedv;"\""))));
    pairs=pairs.push(pair);
    i=i+1
  };
  <str.concat("{";str.concat(str.join(",";pairs);"}"))
};

(* F10.39: this called `str.sha256prefix(raw;8)`, an untyped std.str entry whose C glue
   reads its first argument as a byte ARRAY, length word first. Handed a str it read the
   bytes before the string as a length, so an "anonymised" id was whatever that produced,
   or a crash; toke 3.1.0 rejects the call (E4031). The prefix is now the first eight hex
   digits of the id's SHA-256, which is what the name and the option promise. When the
   slice cannot be taken the whole digest is used: never the raw id. *)
f=maybeanon(opts:$exportopts;raw:str):str{
  let result=mut.raw;
  if(opts.anonymiseids){
    let hex=crypto.tohex(crypto.sha256(str.bytes(raw)));
    result=mt str.slice(hex;0;8) { $ok:p p; $err:e hex }
  }el{};
  <result
};

f=buildauditfields(opts:$exportopts;rows:@$row;i:i64):@str{
  let idval=maybeanon(opts;db.rowstr(rows.get(i);"id"));
  let ridval=maybeanon(opts;db.rowstr(rows.get(i);"request_id"));
  <@(idval;ridval;db.rowstr(rows.get(i);"model_id");db.rowstr(rows.get(i);"action");str.fromi64(db.rowi64(rows.get(i);"timestamp"));db.rowstr(rows.get(i);"regulation");db.rowstr(rows.get(i);"severity"))
};

f=buildrowscontent(opts:$exportopts;rows:@$row;rowcount:i64;keys:@str):str{
  if(opts.format == formatcsv()){
    let header=formatcsvrow(keys);
    let lines=mut.@(header);
    let i=mut.0;
    lp(let lv=0;i<rowcount;lv=lv){
      let fields=buildauditfields(opts;rows;i);
      lines=lines.push(formatcsvrow(fields));
      i=i+1
    };
    <str.join("\n";lines)
  }el{};
  if(opts.format == formatjsonl()){
    let lines=mut.@();
    let i=mut.0;
    lp(let lv2=0;i<rowcount;lv2=lv2){
      let fields=buildauditfields(opts;rows;i);
      lines=lines.push(formatjsonlrecord(fields;keys));
      i=i+1
    };
    <str.join("\n";lines)
  }el{};
  let items=mut.@();
  let i=mut.0;
  lp(let lv3=0;i<rowcount;lv3=lv3){
    let fields=buildauditfields(opts;rows;i);
    items=items.push(formatjsonlrecord(fields;keys));
    i=i+1
  };
  <str.concat("[";str.concat(str.join(",";items);"]"))
};

f=extforformat(format:i32):str{
  if(format == formatcsv()){ <"csv" }el{};
  if(format == formatjsonl()){ <"jsonl" }el{};
  <"json"
};

f=writeexport(path:str;content:str;opts:$exportopts;rowcount:i64):$exportresult{
  file.ensuredir(str.concat(std.homedir();"/.loke/exports"));
  let writeok=mt file.write(path;content) {
    $ok:v true;
    $err:v false
  };
  if(writeok){
    <$exportresult{path:path;rows:rowcount;format:opts.format;sizebytes:str.len(content)}
  }el{};
  log.warn(str.concat("export: failed to write file: ";path);"policy.export";"");
  <$exportresult{path:"";rows:0;format:opts.format;sizebytes:0}
};

f=exportaudit(store:$store;opts:$exportopts):$exportresult{
  let ts=time.nowms();
  let ext=extforformat(opts.format);
  let path=str.concat(std.homedir();str.concat("/.loke/exports/audit_";str.concat(str.fromi64(ts);str.concat(".";ext))));
  let rows=db.queryparams(
    store;
    "SELECT id, request_id, model_id, action, timestamp, regulation, severity FROM audit_entries WHERE timestamp >= ? AND timestamp <= ? ORDER BY timestamp ASC";
    @(db.i64val(opts.fromts);db.i64val(opts.tots))
  );
  let rowcount=rows.len;
  let keys=@("id";"request_id";"model_id";"action";"timestamp";"regulation";"severity");
  let content=buildrowscontent(opts;rows;rowcount;keys);
  <writeexport(path;content;opts;rowcount)
};

(* `store` was a bare identifier here, declared nowhere. It resolved to std.db's
   `store` TYPE, so toke emitted a reference to an SSA value that does not exist and
   the only diagnostic was "clang invocation failed" with no source location. It is
   a real parameter now. See docs/upstream/toke-issues.md T-4. *)
f=exportcompliance(store:$store;opts:$exportopts):$exportresult{
  let ts=time.nowms();
  let ext=extforformat(opts.format);
  let path=str.concat(std.homedir();str.concat("/.loke/exports/compliance_";str.concat(str.fromi64(ts);str.concat(".";ext))));
  let events=fb.exportevents(store;opts.fromts;opts.tots);
  let keys=@("request_id";"policy_id";"regulation";"violated";"user_override";"timestamp");
  let filtered=mut.@();
  let i=mut.0;
  lp(let lv=0;i<events.len;lv=lv){
    let ev=events.get(i);
    let include=mut.true;
    if(!opts.includeoverrides){
      if(ev.useroverride){ include=false }el{}
    }el{};
    if(include){ filtered=filtered.push(ev) }el{};
    i=i+1
  };
  let rowcount=filtered.len;
  let lines=mut.@();
  if(opts.format == formatcsv()){
    lines=lines.push(formatcsvrow(keys))
  }el{};
  let fi=mut.0;
  lp(let lv2=0;fi<rowcount;lv2=lv2){
    let ev:$complianceevent=filtered.get(fi);
    let ridval=maybeanon(opts;ev.requestid);
    let pidval=maybeanon(opts;ev.policyid);
    let fields=@(ridval;pidval;ev.regulation;str.frombool(ev.violated);str.frombool(ev.useroverride);str.fromi64(ev.timestamp));
    let row=mut.formatcsvrow(fields);
    if(!(opts.format == formatcsv())){ row=formatjsonlrecord(fields;keys) }el{};
    lines=lines.push(row);
    fi=fi+1
  };
  let content=mut.str.join("\n";lines);
  if(opts.format == formatjson()){
    content=str.concat("[";str.concat(str.join(",";lines);"]"))
  }el{};
  <writeexport(path;content;opts;rowcount)
};

m=core.policy.export;

i=fb:core.policy.feedback;
i=db:core.storage.db;
i=file:std.file;
i=str:std.str;
i=log:shared.log;
i=std:std;
i=time:std.time;

t=$exportopts{
  format:i32;
  fromts:i64;
  tots:i64;
  includeoverrides:bool;
  anonymiseids:bool
};

t=$exportresult{
  path:str;
  rows:i32;
  format:i32;
  sizebytes:i32
};

f=formatcsv():i32{ <0 as i32 };
f=formatjson():i32{ <1 as i32 };
f=formatjsonl():i32{ <2 as i32 };

f=formatcsvrow(fields:@str):str{
  let escaped=mut.@();
  let i=mut.0;
  lp(let lv=0;i<fields.len;lv=lv){
    let raw=fields.get(i);
    let needsquote=str.contains(raw;",") || str.contains(raw;"\"");
    let cell=mut.raw;
    if(needsquote){
      let inner=str.replaceall(raw;"\"";  "\"\"");
      cell=str.concat("\"";str.concat(inner;"\""))
    }el{};
    escaped=escaped.push(cell);
    i=i+1
  };
  <str.join(escaped;",")
};

f=formatjsonlrecord(fields:@str;keys:@str):str{
  let pairs=mut.@();
  let i=mut.0;
  lp(let lv=0;i<keys.len;lv=lv){
    let k=keys.get(i);
    let v=mut."";
    if(i<fields.len){ v=fields.get(i) }el{};
    let escapedv=str.replaceall(v;"\"";  "\\\"");
    let pair=str.concat("\"";str.concat(k;str.concat("\":\"";str.concat(escapedv;"\""))));
    pairs=pairs.push(pair);
    i=i+1
  };
  <str.concat("{";str.concat(str.join(pairs;",");"}"))
};

f=maybeanon(opts:$exportopts;raw:str):str{
  let result=mut.raw;
  if(opts.anonymiseids){ result=str.sha256prefix(raw;8) }el{};
  <result
};

f=buildauditfields(opts:$exportopts;rows:i64;i:i32):@str{
  let idval=maybeanon(opts;db.rowstr(rows;i;0));
  let ridval=maybeanon(opts;db.rowstr(rows;i;1));
  <@(idval;ridval;db.rowstr(rows;i;2);db.rowstr(rows;i;3);str.fromi64(db.rowi64(rows;i;4));db.rowstr(rows;i;5);db.rowstr(rows;i;6))
};

f=buildrowscontent(opts:$exportopts;rows:i64;rowcount:i32;keys:@str):str{
  if(opts.format = formatcsv()){
    let header=formatcsvrow(keys);
    let lines=mut.@(header);
    let i=mut.0;
    lp(let lv=0;i<rowcount;lv=lv){
      let fields=buildauditfields(opts;rows;i);
      lines=lines.push(formatcsvrow(fields));
      i=i+1
    };
    <str.join(lines;"\n")
  }el{};
  if(opts.format = formatjsonl()){
    let lines=mut.@();
    let i=mut.0;
    lp(let lv=0;i<rowcount;lv=lv){
      let fields=buildauditfields(opts;rows;i);
      lines=lines.push(formatjsonlrecord(fields;keys));
      i=i+1
    };
    <str.join(lines;"\n")
  }el{};
  let items=mut.@();
  let i=mut.0;
  lp(let lv=0;i<rowcount;lv=lv){
    let fields=buildauditfields(opts;rows;i);
    items=items.push(formatjsonlrecord(fields;keys));
    i=i+1
  };
  <str.concat("[";str.concat(str.join(items;",");"]"))
};

f=extforformat(format:i32):str{
  if(format = formatcsv()){ <"csv" }el{};
  if(format = formatjsonl()){ <"jsonl" }el{};
  <"json"
};

f=writeexport(path:str;content:str;opts:$exportopts;rowcount:i32):$exportresult{
  file.ensuredir(str.concat(std.homedir();"/.loke/exports"));
  let writeok=mt file.write(path;content) {
    $ok:v true;
    $err:v false
  };
  if(writeok){
    <$exportresult{path:path;rows:rowcount;format:opts.format;sizebytes:str.bytelen(content)}
  }el{};
  log.warn(str.concat("export: failed to write file: ";path));
  <$exportresult{path:"";rows:0;format:opts.format;sizebytes:0}
};

f=exportaudit(opts:$exportopts):$exportresult{
  let ts=time.nowms();
  let ext=extforformat(opts.format);
  let path=str.concat(std.homedir();str.concat("/.loke/exports/audit_";str.concat(str.fromi64(ts);str.concat(".";ext))));
  let rows=db.query(
    "SELECT id, request_id, model_id, action, timestamp, regulation, severity FROM audit_entries WHERE timestamp >= ? AND timestamp <= ? ORDER BY timestamp ASC";
    @(db.i64val(opts.fromts);db.i64val(opts.tots))
  );
  let rowcount=db.rowslen(rows);
  let keys=@("id";"request_id";"model_id";"action";"timestamp";"regulation";"severity");
  let content=buildrowscontent(opts;rows;rowcount;keys);
  <writeexport(path;content;opts;rowcount)
};

f=exportcompliance(opts:$exportopts):$exportresult{
  let ts=time.nowms();
  let ext=extforformat(opts.format);
  let path=str.concat(std.homedir();str.concat("/.loke/exports/compliance_";str.concat(str.fromi64(ts);str.concat(".";ext))));
  let events=fb.exportevents(opts.fromts;opts.tots);
  let keys=@("request_id";"policy_id";"regulation";"violated";"user_override";"timestamp");
  let filtered=mut.@();
  let i=mut.0;
  lp(let lv=0;i<events.len;lv=lv){
    let ev=events.get(i);
    let include=mut.true;
    if(!opts.includeoverrides){
      if(ev.useroverride){ include=false }el{}
    }el{};
    if(include){ filtered=filtered.push(ev) }el{};
    i=i+1
  };
  let rowcount=filtered.len;
  let lines=mut.@();
  if(opts.format = formatcsv()){
    lines=lines.push(formatcsvrow(keys))
  }el{};
  let fi=mut.0;
  lp(let lv2=0;fi<rowcount;lv2=lv2){
    let ev=filtered.get(fi);
    let ridval=maybeanon(opts;ev.requestid);
    let pidval=maybeanon(opts;ev.policyid);
    let fields=@(ridval;pidval;ev.regulation;str.frombool(ev.violated);str.frombool(ev.useroverride);str.fromi64(ev.timestamp));
    let row=mut.formatcsvrow(fields);
    if(!(opts.format = formatcsv())){ row=formatjsonlrecord(fields;keys) }el{};
    lines=lines.push(row);
    fi=fi+1
  };
  let content=mut.str.join(lines;"\n");
  if(opts.format = formatjson()){
    content=str.concat("[";str.concat(str.join(lines;",");"]"))
  }el{};
  <writeexport(path;content;opts;rowcount)
};

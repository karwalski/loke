m=core.companion.discovery;
i=t:companion.types;
i=mdns:std.mdns;
i=log:shared.log;
i=db:storage.db;

f=advertise(port:i32;devicename:str):bool{
  svc=mdns.$servicerecord{ name=devicename; type="_loke-companion._tcp"; port=port; txt=["version=1.0"] };
  log.info "advertising as companion: {device_name}:{port}";
  <mdns.advertise(svc)
}

f=browse(cb:f(t.$companion):void):bool{
  innercb=f(d:i64):void{
    now=db.nowms();
    companion=t.$companion{ id=d.name; name=d.name; host=d.host; port=d.port; certpem=""; paired=false; pairedat=0; lastseen=now };
    cb(companion)
  };
  <mdns.browse("_loke-companion._tcp";innercb)
}

f=stop():bool{
  a=mdns.stopadvertise("_loke-companion._tcp");
  b=mdns.stopbrowse("_loke-companion._tcp");
  <a
}

f=generatepairingcode(certpem:str):i64{
  prefix=certpem.get(0..6);
  n=0;
  i=0;
  |{ i<6: ch=prefix.get(i); d=ch mod 10; n=n*10+d; i=i+1 };
  codenum=n mod 1000000;
  code="{code_num:06}";
  expiresat=db.nowms()+300000;
  <t.$pairingcode{ code=code; expiresat=expiresat }
}

f=savecompanion(store:i64;companion:i64):bool{
  db.exec(store;"CREATE TABLE IF NOT EXISTS companions (id TEXT PRIMARY KEY, name TEXT, host TEXT, port INT, cert_pem TEXT, paired INT, paired_at INT, last_seen INT)");
  pairedint=0;
  |{ companion.paired: pairedint=1 };
  <db.exec(store;"INSERT OR REPLACE INTO companions (id, name, host, port, cert_pem, paired, paired_at, last_seen) VALUES (?,?,?,?,?,?,?,?)";[companion.id;companion.name;companion.host;"{companion.port}";companion.certpem;"{paired_int}";"{companion.paired_at}";"{companion.last_seen}"])
}

f=loadcompanions(store:i64):@i64{
  rows=db.query(store;"SELECT id, name, host, port, cert_pem, paired, paired_at, last_seen FROM companions WHERE paired=1");
  result=@i64@();
  |{ rows: row=rows.next(); |{ row.$some:r
    id=r.get(0); name=r.get(1); host=r.get(2); port=r.get(3) as i32; certpem=r.get(4);
    pairedint=r.get(5) as i32; paired=pairedint!=0;
    pairedat=r.get(6) as i64; lastseen=r.get(7) as i64;
    c=t.$companion{ id=id; name=name; host=host; port=port; certpem=certpem; paired=paired; pairedat=pairedat; lastseen=lastseen };
    result.push(c)
  } };
  <result
}

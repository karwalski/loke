m=core.companion.discovery;

i=t:companion.types;
i=mdns:std.mdns;
i=log:shared.log;
i=db:storage.db;
i=str:std.str;

f=advertise(port:i32;devicename:str):bool{
  let svc=mdns.servicerecord(devicename;"_loke-companion._tcp";port;"version=1.0");
  log.info(str.concat("advertising as companion: ";str.concat(devicename;str.concat(":";str.fromint(port))));"companion";"discovery");
  <mdns.advertise(svc)
};

f=browse(cb:i64):bool{
  <mdns.browse("_loke-companion._tcp";cb)
};

f=stop():bool{
  let a=mdns.stopadvertise("_loke-companion._tcp");
  let b=mdns.stopbrowse("_loke-companion._tcp");
  <a
};

f=generatepairingcode(certpem:str):$pairingcode{
  let prefix=str.slice(certpem;0;6);
  let n=0;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>5){
      break
    }el{
      let ch=str.charat(prefix;i);
      let d=ch-48;
      n=n*10+d;
      i=i+1
    }
  };
  let codenum=n-((n/1000000)*1000000);
  let code=str.padleft(str.fromint(codenum);6;"0");
  let expiresat=db.nowms()+300000;
  <$pairingcode{ code:code; expiresat:expiresat }
};

f=savecompanion(store:i64;companion:$companion):bool{
  db.exec(store;"CREATE TABLE IF NOT EXISTS companions (id TEXT PRIMARY KEY, name TEXT, host TEXT, port INT, cert_pem TEXT, paired INT, paired_at INT, last_seen INT)");
  let pairedint=0;
  if(companion.paired){
    pairedint=1
  }el{
    pairedint=0
  };
  <db.exec(store;"INSERT OR REPLACE INTO companions (id, name, host, port, cert_pem, paired, paired_at, last_seen) VALUES (?,?,?,?,?,?,?,?)";companion.id;companion.name;companion.host;str.fromint(companion.port);companion.certpem;str.fromint(pairedint);str.fromint64(companion.pairedat);str.fromint64(companion.lastseen))
};

f=loadcompanions(store:i64):@$companion{
  let rows=db.query(store;"SELECT id, name, host, port, cert_pem, paired, paired_at, last_seen FROM companions WHERE paired=1");
  let result=@();
  let count=rows.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>count){
      break
    }el{
      let r=str.arrayget(rows;i);
      let id=db.rowget(r;0);
      let name=db.rowget(r;1);
      let host=db.rowget(r;2);
      let port=str.toint(db.rowget(r;3));
      let certpem=db.rowget(r;4);
      let pairedint=str.toint(db.rowget(r;5));
      let paired=pairedint>0;
      let pairedat=str.toint64(db.rowget(r;6));
      let lastseen=str.toint64(db.rowget(r;7));
      let c=$companion{ id:id; name:name; host:host; port:port; certpem:certpem; paired:paired; pairedat:pairedat; lastseen:lastseen };
      result=@(result;c);
      i=i+1
    }
  };
  <result
};

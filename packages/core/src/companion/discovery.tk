(* Companion discovery over std.mdns.

   std.mdns is a stub: advertise returns 0 (its own comment reads "no handle, not
   available"), browse returns an empty array, and servicerecord returns 0. So
   advertise reports failure and browse finds nothing. There is no mDNS on this
   toolchain, and nothing here pretends otherwise.

   servicerecord is not called at all now: it took a TXT record loke wanted to
   publish ("version=1.0") and the current three-parameter form has nowhere to put
   it, so building a record that advertise cannot accept was pure ceremony. *)

m=core.companion.discovery;

i=mdns:std.mdns;
i=log:shared.log;
i=db:core.storage.db;
i=sdb:std.db;
i=str:std.str;
i=t:core.companion.types;

f=servicetype():str{
  <"_loke-companion._tcp"
};

(* F10.39, toke 3.1.0: std.mdns takes the arguments its .tki publishes. advertise takes one
   $servicerecord and answers a bool; the stub answers false, never a false success (T-11),
   exactly as its zero handle did. *)
f=advertise(port:i32;devicename:str):bool{
  if(!mdns.advertise($servicerecord{name:devicename;type:servicetype();port:port;txt:@()})){
    log.warn("mDNS advertise unavailable: \(devicename) is not discoverable";"companion";"discovery");
    <false
  }el{
    log.info("advertising as companion: \(devicename):\(port)";"companion";"discovery");
    <true
  }
};

(* Returns the service instances found.

   F10.39, toke 3.1.0: std.mdns.browse takes the callback its .tki publishes,
   `browse(type; &callback)`, and answers whether browsing started. At 3.0.0 it took the
   type alone and answered an array, always empty. A toke callback cannot append to a
   caller's array, and the stub starts nothing and finds nothing (T-11), so this still
   answers no instances, and says so. Collecting what a real browse reports is for when
   std.mdns is implemented. *)
f=onfound(d:$discovered):void{
  log.info("mDNS browse saw \(d.name)";"companion";"discovery")
};

f=browse():@str{
  let started=mdns.browse(servicetype();&onfound);
  log.warn("mDNS browse found no companions (std.mdns is not implemented; browse started: \(started))";"companion";"discovery");
  <@()
};

f=stop():bool{
  <mdns.stopadvertise(servicetype())
};

(* X4b.10. The code was the first six characters of the certificate PEM read as digits, and
   every PEM begins `-----BEGIN`, so every device was offered the same code: a confirmation
   code an attacker knew in advance. It also read the result of str.slice as a string. It is
   now six decimal digits from 32 random bits (str.randhex forwards to arc4random). *)
f=hexval(c:i64):i64{
  if(c>=48 && c<=57){ <c-48 }el{};
  if(c>=97 && c<=102){ <c-87 }el{};
  if(c>=65 && c<=70){ <c-55 }el{};
  <0
};

f=codefromhex(h:str):str{
  let n=mut.0;
  lp(let i=0;i<str.len(h);i=i+1){
    n=n*16+hexval(str.charat(h;i))
  };
  let digits=mut.str.fromint(n-((n/1000000)*1000000));
  (* By hand: str.padleft is a gen:"abi" entry declared i64 -> i64, and its result is not a
     string this code can use (the T-41 family). *)
  lp(let k=0;str.len(digits)<6;k=k+1){ digits=str.concat("0";digits) };
  <digits
};

f=generatepairingcode():$pairingcode{
  let h:str=str.randhex(4);
  <$pairingcode{
    code:codefromhex(h);
    expiresat:db.nowms()+300000
  }
};

(* X4b.10. Saving and loading went through core.storage.db's result-returning wrappers,
   whose arms a caller cannot tell apart (T-18), so savecompanion returned true whatever
   happened. std.db directly, with bools. *)
f=ensurecompanions():bool{
  <mt sdb.exec("CREATE TABLE IF NOT EXISTS companions (id TEXT PRIMARY KEY, name TEXT, host TEXT, port INT, cert_pem TEXT, paired INT, paired_at INT, last_seen INT)";@()) {
    $ok:v true;
    $err:e false
  }
};

f=savecompanion(store:i64;companion:$companion):bool{
  if(!ensurecompanions()){ <false }el{};
  <mt sdb.exec("INSERT OR REPLACE INTO companions (id, name, host, port, cert_pem, paired, paired_at, last_seen) VALUES (?,?,?,?,?,?,?,?)";
    @(companion.id;companion.name;companion.host;str.fromint(companion.port as i64);companion.certpem;db.boolval(companion.paired);str.fromint(companion.pairedat);str.fromint(companion.lastseen))) {
    $ok:v true;
    $err:e false
  }
};

(* The user confirmed the code on both devices: the companion is remembered as paired. *)
f=confirm(store:i64;companion:$companion;now:i64):bool{
  <savecompanion(store;$companion{id:companion.id;name:companion.name;host:companion.host;port:companion.port;certpem:companion.certpem;paired:true;pairedat:now;lastseen:now})
};

(* The user rejected it: nothing about the device is kept. *)
f=reject(store:i64;id:str):bool{
  if(!ensurecompanions()){ <false }el{};
  <mt sdb.exec("DELETE FROM companions WHERE id=?";@(id)) {
    $ok:v true;
    $err:e false
  }
};

f=companionfromrow(r:$row):$companion{
  <$companion{
    id:db.rowstr(r;"id");
    name:db.rowstr(r;"name");
    host:db.rowstr(r;"host");
    port:db.rowi32(r;"port");
    certpem:db.rowstr(r;"cert_pem");
    paired:db.rowbool(r;"paired");
    pairedat:db.rowi64(r;"paired_at");
    lastseen:db.rowi64(r;"last_seen")
  }
};

f=companionsfromrows(rows:@$row):@$companion{
  let result=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    result=result.push(companionfromrow(rows.get(i)))
  };
  <result
};

f=loadcompanions(store:i64):@$companion{
  if(!ensurecompanions()){ <@() }el{};
  <mt sdb.many("SELECT id, name, host, port, cert_pem, paired, paired_at, last_seen FROM companions WHERE paired=?";@("1")) {
    $ok:rows companionsfromrows(rows);
    $err:e @()
  }
};

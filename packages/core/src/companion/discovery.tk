(* Companion discovery over std.mdns.

   std.mdns is a stub: advertise returns 0 (its own comment reads "no handle, not
   available"), browse returns an empty array, and servicerecord returns 0. So
   advertise reports failure and browse finds nothing. There is no mDNS on this
   toolchain, and nothing here pretends otherwise.

   servicerecord is not called at all now: it took a TXT record loke wanted to
   publish ("version=1.0") and the current three-parameter form has nowhere to put
   it, so building a record that advertise cannot accept was pure ceremony. *)

m=core.companion.discovery;

i=mdns:std.mdns;
i=log:shared.log;
i=db:core.storage.db;
i=sdb:std.db;
i=str:std.str;
i=t:core.companion.types;

f=servicetype():str{
  <"_loke-companion._tcp"
};

f=advertise(port:i32;devicename:str):bool{
  let handle=mdns.advertise(servicetype();devicename;port);
  if(handle==0){
    log.warn("mDNS advertise unavailable: \(devicename) is not discoverable";"companion";"discovery");
    <false
  }el{
    log.info("advertising as companion: \(devicename):\(port)";"companion";"discovery");
    <true
  }
};

(* Returns the service instances found. std.mdns.browse takes no callback and
   returns an array, so the old callback parameter had nowhere to go. *)
f=browse():@str{
  let found=mdns.browse(servicetype());
  if(found.len==0){
    log.warn("mDNS browse found no companions (std.mdns is not implemented)";"companion";"discovery")
  }el{};
  <found
};

f=stop():bool{
  <mdns.stopadvertise(servicetype())!=0
};

f=generatepairingcode(certpem:str):$pairingcode{
  let prefix=str.slice(certpem;0;6);
  let n=mut.0;
  (* `i>5` read a seventh character from a six-character slice. *)
  lp(let i=0;i<str.len(prefix);i=i+1){
    n=n*10+(str.charat(prefix;i)-48)
  };
  <$pairingcode{
    code:str.padleft(str.fromint(n-((n/1000000)*1000000));6;"0");
    expiresat:db.nowms()+300000
  }
};

f=savecompanion(store:$store;companion:$companion):bool{
  mt db.exec(store;"CREATE TABLE IF NOT EXISTS companions (id TEXT PRIMARY KEY, name TEXT, host TEXT, port INT, cert_pem TEXT, paired INT, paired_at INT, last_seen INT)") {
    $ok:v v;
    $err:e 0
  };
  <mt db.execparams(store;
    "INSERT OR REPLACE INTO companions (id, name, host, port, cert_pem, paired, paired_at, last_seen) VALUES (?,?,?,?,?,?,?,?)";
    @(companion.id;companion.name;companion.host;str.fromint(companion.port);companion.certpem;db.boolval(companion.paired);str.fromint64(companion.pairedat);str.fromint64(companion.lastseen))) {
    $ok:v true;
    $err:e false
  }
};

f=companionfromrow(r:$row):$companion{
  <$companion{
    id:db.rowstr(r;"id");
    name:db.rowstr(r;"name");
    host:db.rowstr(r;"host");
    port:db.rowi32(r;"port");
    certpem:db.rowstr(r;"cert_pem");
    paired:db.rowbool(r;"paired");
    pairedat:db.rowi64(r;"paired_at");
    lastseen:db.rowi64(r;"last_seen")
  }
};

f=companionsfromrows(rows:@$row):@$companion{
  let result=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    result=result.push(companionfromrow(rows.get(i)))
  };
  <result
};

f=loadcompanions(store:$store):@$companion{
  mt db.query(store;"SELECT id, name, host, port, cert_pem, paired, paired_at, last_seen FROM companions WHERE paired=1") {
    $ok:rows companionsfromrows(rows);
    $err:e @()
  }
};

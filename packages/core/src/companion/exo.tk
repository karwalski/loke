m=core.companion.exo;
i=t:companion.types
i=http:std.http
i=json:std.json
i=log:shared.log

t=$exoconfig{ host:str; port:i32 }
t=$exonode{ id:str; device:str; memorygb:f32; models:@(str) }
t=$exocluster{ nodes:@$exonode; totalmemorygb:f32 }

f=defaultconfig():$exoconfig{
  <$exoconfig{ host="localhost"; port=52415 }
}

f=isavailable(cfg:$exoconfig):bool{
  url="http://{cfg.host}:{cfg.port}/v1/health";
  resp=http.get(url);
  |{ resp.$ok:r <r.status==200 };
  |{ resp.$err: <false }
}

f=clusterstatus(cfg:$exoconfig):$exocluster{
  url="http://{cfg.host}:{cfg.port}/v1/nodes";
  resp=http.get(url);
  |{ resp.$err:
    <$exocluster{ nodes=@(); totalmemorygb=0.0 }
  };
  r=resp.$ok;
  |{ r.status!=200:
    <$exocluster{ nodes=@(); totalmemorygb=0.0 }
  };
  parsed=json.decode(r.body);
  rawnodes=parsed.get("nodes") as @(json.$val);
  nodes=@$exonode@();
  total=0.0;
  i=0;
  |{ i<rawnodes.len():
    n=rawnodes.get(i);
    id=n.get("id") as str;
    device=n.get("device") as str;
    memorygb=n.get("memory_gb") as f32;
    models=n.get("models") as @(str);
    nodes.push($exonode{ id=id; device=device; memorygb=memorygb; models=models });
    total=total+memorygb;
    i=i+1
  };
  <$exocluster{ nodes=nodes; totalmemorygb=total }
}

f=generate(cfg:$exoconfig;model:str;prompt:str;maxtokens:i32):str{
  url="http://{cfg.host}:{cfg.port}/v1/chat/completions";
  body=json.encode({ model=model; messages=[{ role="user"; content=prompt }]; maxtokens=maxtokens });
  resp=http.post(url;body);
  |{ resp.$err: <"" };
  r=resp.$ok;
  |{ r.status!=200: <"" };
  parsed=json.decode(r.body);
  choices=parsed.get("choices") as @(json.$val);
  |{ choices.len()==0: <"" };
  <choices.get(0).get("message").get("content") as str
}

f=formatcluster(c:$exocluster):str{
  n=c.nodes.len();
  parts="Exo cluster: {n} nodes, {c.total_memory_gb}GB total | ";
  i=0;
  |{ i<n:
    node=c.nodes.get(i);
    parts="{parts}{node.device}({node.memory_gb}GB)";
    |{ i<n-1: parts="{parts}, " };
    i=i+1
  };
  <parts
}

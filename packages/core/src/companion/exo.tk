m=core.companion.exo;

i=t:companion.types;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=str:std.str;

t=$exoconfig{
  host:str;
  port:i32
};

t=$exonode{
  id:str;
  device:str;
  memorygb:f32;
  models:@str
};

t=$exocluster{
  nodes:@$exonode;
  totalmemorygb:f32
};

f=defaultconfig():$exoconfig{
  <$exoconfig{ host:"localhost"; port:52415 }
};

f=isavailable(cfg:$exoconfig):bool{
  let url=str.concat("http://";str.concat(cfg.host;str.concat(":";str.concat(str.fromint(cfg.port);"/v1/health"))));
  let resp=http.get(url);
  mt resp {
    $ok:r r.status=200;
    $err:e false
  }
};

f=clusterstatus(cfg:$exoconfig):$exocluster{
  let url=str.concat("http://";str.concat(cfg.host;str.concat(":";str.concat(str.fromint(cfg.port);"/v1/nodes"))));
  let resp=http.get(url);
  mt resp {
    $err:e
      <$exocluster{ nodes:@(); totalmemorygb:0.0 };
    $ok:r
      if(r.status>199){
        if(r.status<300){
          let parsed=json.decode(r.body);
          let rawnodes=json.getarray(parsed;"nodes");
          let nodes=@();
          let total=0.0;
          let i=0;
          let count=rawnodes.len;
          lp(let lv=0;true;lv=lv){
            if(i>count){
              break
            }el{
              let n=str.arrayget(rawnodes;i);
              let id=json.getstr(n;"id");
              let device=json.getstr(n;"device");
              let memorygb=json.getf32(n;"memory_gb");
              let models=json.getstrarr(n;"models");
              nodes=@(nodes;$exonode{ id:id; device:device; memorygb:memorygb; models:models });
              total=total+memorygb;
              i=i+1
            }
          };
          <$exocluster{ nodes:nodes; totalmemorygb:total }
        }el{
          <$exocluster{ nodes:@(); totalmemorygb:0.0 }
        }
      }el{
        <$exocluster{ nodes:@(); totalmemorygb:0.0 }
      }
  }
};

f=generate(cfg:$exoconfig;model:str;prompt:str;maxtokens:i32):str{
  let url=str.concat("http://";str.concat(cfg.host;str.concat(":";str.concat(str.fromint(cfg.port);"/v1/chat/completions"))));
  let body=json.encode(json.obj("model";model;"messages";json.arr(json.obj("role";"user";"content";prompt));"maxtokens";str.fromint(maxtokens)));
  let resp=http.post(url;body);
  mt resp {
    $err:e <"";
    $ok:r
      if(r.status>199){
        if(r.status<300){
          let parsed=json.decode(r.body);
          let choices=json.getarray(parsed;"choices");
          if(choices.len=0){
            <""
          }el{
            let first=str.arrayget(choices;0);
            let msg=json.getobj(first;"message");
            <json.getstr(msg;"content")
          }
        }el{
          <""
        }
      }el{
        <""
      }
  }
};

f=formatcluster(c:$exocluster):str{
  let n=c.nodes.len;
  let parts=str.concat("Exo cluster: ";str.concat(str.fromint(n);str.concat(" nodes, ";str.concat(str.fromf32(c.totalmemorygb);"GB total | "))));
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i>n){
      break
    }el{
      let node=str.arrayget(c.nodes;i);
      parts=str.concat(parts;str.concat(node.device;str.concat("(";str.concat(str.fromf32(node.memorygb);"GB)"))));
      if(i<n-1){
        parts=str.concat(parts;", ")
      }el{
        parts=parts
      };
      i=i+1
    }
  };
  <parts
};

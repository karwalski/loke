m=core.companion.exo;

i=json:std.json;
i=jx:shared.jsonobj;
i=sh:shared.types;
i=str:std.str;
i=reach:shared.reachability;

t=$exoconfig{
  host:str;
  port:i32
};

t=$exonode{
  id:str;
  device:str;
  memorygb:f32;
  models:@str
};

t=$exocluster{
  nodes:@$exonode;
  totalmemorygb:f32
};

f=defaultconfig():$exoconfig{
  <$exoconfig{ host:"localhost"; port:52415 }
};

f=baseurl(cfg:$exoconfig):str{
  <str.concat("http://";str.concat(cfg.host;str.concat(":";str.fromint(cfg.port as i64))))
};

(* X4b.10. http.get against a closed port returns $ok with a nil response (T-15), so the
   status read that followed dereferenced nil whenever Exo was not running, which is the
   usual case. The port is probed first, as core.models.ollama does. *)
(* VM1.6f. The one-argument http.get answers the response BODY, a str, and this read
   `.status` off it. reach.localanswers probes the port and then GETs, as the other local
   health checks do since VM1.6e. *)
f=isavailable(cfg:$exoconfig):bool{
  <reach.localanswers(baseurl(cfg);"/v1/health")
};

(* X4b.10. The body is parsed by its own function, so the node and model list can be tested
   without a running Exo. *)
f=typednodes(bodytext:str):@$json{
  <mt json.dec(bodytext) {
    $ok:obj nodesof(obj);
    $err:e @()
  }
};

f=nodesof(obj:$json):@$json{
  <mt json.arr(obj;"nodes") {
    $ok:a a;
    $err:e @()
  }
};

(* memory_gb through the TYPED accessor. json.getf32 answers a value that is not an f32
   this code can do arithmetic on: measured, a cluster of 192 GB and 64 GB summed to 9.3e18,
   and reading it back through the struct crashed the process. *)
f=memoryof(nodes:@$json;i:i64):f64{
  if(i>=(nodes.len as i64)){ <0.0 }el{};
  <mt json.f64(nodes.get(i);"memory_gb") {
    $ok:v v;
    $err:e 0.0
  }
};

(* A body that is not even shaped like an object is refused before any JSON accessor sees it:
   json.decode and json.getarray crashed on `{not json` (LS1.1w), and at toke 0b0bc4e json.dec
   accepted it (T-51). This is a shape check, not a validator. *)
f=objectshaped(bodytext:str):bool{
  let b=str.trim(bodytext);
  <str.startswith(b;"{") && str.endswith(b;"}") && str.contains(b;"\"nodes\"")
};

f=parsecluster(bodytext:str):$exocluster{
  if(!objectshaped(bodytext)){ <$exocluster{ nodes:@(); totalmemorygb:0.0 } }el{};
  (* LS1.1w: the nodes come from typednodes (json.dec, json.arr) only. This also read them a
     second time through json.decode and json.getarray, two of std.json's untyped ABI
     helpers, and took the names from that copy. *)
  let typed=typednodes(bodytext);
  if(typed.len==0){ <$exocluster{ nodes:@(); totalmemorygb:0.0 } }el{};
  let nodes=mut.@();
  let total=mut.0.0;
  lp(let i=0;i<typed.len;i=i+1){
    let n:$json=typed.get(i);
    let mem=memoryof(typed;i as i64);
    nodes=nodes.push($exonode{ id:json.str(n;"id"); device:json.str(n;"device"); memorygb:mem as f32; models:sh.jsonstrarray(n;"models") });
    total=total+mem
  };
  <$exocluster{ nodes:nodes; totalmemorygb:total as f32 }
};

(* VM1.6f. As isavailable: the GET answers the body, and this read `.status` and `.body`
   off it. An empty answer is refused by parsecluster's shape check. *)
f=clusterstatus(cfg:$exoconfig):$exocluster{
  <parsecluster(reach.localget(baseurl(cfg);"/v1/nodes"))
};

(* VM1.6f. The request was `http.postheaders(http.client(url);"";...)`. The runtime reads
   postheaders' first argument as a URL string, so nothing was sent (T-48) and generate
   answered "" for every prompt. reach.localpost sends it.

   The request carries the prompt in clear, so it goes only to a loopback host, as the NER
   layer's does (VM1.6e). An Exo configured on another machine answers "". The body's
   token limit is `max_tokens`, the OpenAI-compatible name Exo reads; it was `maxtokens`. *)
f=generate(cfg:$exoconfig;model:str;prompt:str;maxtokens:i32):str{
  if(!reach.isloopbackurl(baseurl(cfg))){ <"" }el{};
  let body="{\"model\":\(jx.escape(model)),\"messages\":[{\"role\":\"user\",\"content\":\(jx.escape(prompt))}],\"max_tokens\":\(maxtokens)}";
  <completioncontent(reach.localpost(baseurl(cfg);"/v1/chat/completions";body))
};

(* choices[0].message.content, or "" when the answer has none. Through shared.jsonobj, as
   core.models.ollama reads message.content: json.str refuses an object (T-32). *)
f=decoded(raw:str):$json{
  <mt json.dec(raw) {
    $ok:o o;
    $jsonerr:e jx.emptyobj()
  }
};

f=completioncontent(raw:str):str{
  if(str.len(raw)==0){ <"" }el{};
  <jx.strvalue(jx.nested(jx.elem(decoded(raw);"choices";0);"message");"content";"")
};

f=formatcluster(c:$exocluster):str{
  let n=c.nodes.len;
  let parts=mut.str.concat("Exo cluster: ";str.concat(str.fromint(n);str.concat(" nodes, ";str.concat(str.fromfloat(c.totalmemorygb);"GB total | "))));
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=n){
      br
    }el{
      let node=c.nodes.get(i);
      parts=str.concat(parts;str.concat(node.device;str.concat("(";str.concat(str.fromfloat(node.memorygb);"GB)"))));
      if(i<n-1){
        parts=str.concat(parts;", ")
      }el{
        parts=parts
      };
      i=i+1
    }
  };
  <parts
};

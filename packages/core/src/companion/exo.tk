m=core.companion.exo;

i=http:std.http;
i=json:std.json;
i=sh:shared.types;
i=str:std.str;
i=reach:shared.reachability;

t=$exoconfig{
  host:str;
  port:i32
};

t=$exonode{
  id:str;
  device:str;
  memorygb:f32;
  models:@str
};

t=$exocluster{
  nodes:@$exonode;
  totalmemorygb:f32
};

f=defaultconfig():$exoconfig{
  <$exoconfig{ host:"localhost"; port:52415 }
};

f=baseurl(cfg:$exoconfig):str{
  <str.concat("http://";str.concat(cfg.host;str.concat(":";str.fromint(cfg.port as i64))))
};

(* X4b.10. http.get against a closed port returns $ok with a nil response (T-15), so the
   status read that followed dereferenced nil whenever Exo was not running, which is the
   usual case. The port is probed first, as core.models.ollama does. *)
f=isavailable(cfg:$exoconfig):bool{
  if(!reach.localserviceup(baseurl(cfg))){ <false }el{};
  let resp=http.get(str.concat(baseurl(cfg);"/v1/health"));
  <mt resp {
    $ok:r r.status==200;
    $err:e false
  }
};

(* X4b.10. The body is parsed by its own function, so the node and model list can be tested
   without a running Exo. *)
f=typednodes(bodytext:str):@$json{
  <mt json.dec(bodytext) {
    $ok:obj nodesof(obj);
    $err:e @()
  }
};

f=nodesof(obj:$json):@$json{
  <mt json.arr(obj;"nodes") {
    $ok:a a;
    $err:e @()
  }
};

(* memory_gb through the TYPED accessor. json.getf32 answers a value that is not an f32
   this code can do arithmetic on: measured, a cluster of 192 GB and 64 GB summed to 9.3e18,
   and reading it back through the struct crashed the process. *)
f=memoryof(nodes:@$json;i:i64):f64{
  if(i>=(nodes.len as i64)){ <0.0 }el{};
  <mt json.f64(nodes.get(i);"memory_gb") {
    $ok:v v;
    $err:e 0.0
  }
};

(* A body that is not even shaped like an object is refused before any JSON accessor sees it:
   json.decode and json.getarray crashed on `{not json` (LS1.1w), and json.dec accepts it
   (T-51). This is a shape check, not a validator. *)
f=objectshaped(bodytext:str):bool{
  let b=str.trim(bodytext);
  <str.startswith(b;"{") && str.endswith(b;"}") && str.contains(b;"\"nodes\"")
};

f=parsecluster(bodytext:str):$exocluster{
  if(!objectshaped(bodytext)){ <$exocluster{ nodes:@(); totalmemorygb:0.0 } }el{};
  let parsed=json.decode(bodytext);
  let rawnodes=json.getarray(parsed;"nodes");
  if(rawnodes.len==0){ <$exocluster{ nodes:@(); totalmemorygb:0.0 } }el{};
  (* Only once a node list was found: json.dec accepts `{not json` (T-51), and json.arr on
     what it returns crashed. *)
  let typed=typednodes(bodytext);
  let nodes=mut.@();
  let total=mut.0.0;
  lp(let i=0;i<rawnodes.len;i=i+1){
    let n=str.arrayget(rawnodes;i);
    let mem=memoryof(typed;i as i64);
    nodes=nodes.push($exonode{ id:json.str(n;"id"); device:json.str(n;"device"); memorygb:mem as f32; models:sh.jsonstrarray(n;"models") });
    total=total+mem
  };
  <$exocluster{ nodes:nodes; totalmemorygb:total as f32 }
};

f=parseclusterresp(r:$httpresp):$exocluster{
  if(r.status>199 && r.status<300){ <parsecluster(r.body) }el{};
  <$exocluster{ nodes:@(); totalmemorygb:0.0 }
};

f=clusterstatus(cfg:$exoconfig):$exocluster{
  if(!reach.localserviceup(baseurl(cfg))){ <$exocluster{ nodes:@(); totalmemorygb:0.0 } }el{};
  let resp=http.get(str.concat(baseurl(cfg);"/v1/nodes"));
  <mt resp {
    $ok:r parseclusterresp(r);
    $err:e $exocluster{ nodes:@(); totalmemorygb:0.0 }
  }
};

f=generate(cfg:$exoconfig;model:str;prompt:str;maxtokens:i32):str{
  let url=str.concat("http://";str.concat(cfg.host;str.concat(":";str.concat(str.fromint(cfg.port);"/v1/chat/completions"))));
  let body="{\"model\":\(json.enc(model)),\"messages\":[{\"role\":\"user\",\"content\":\(json.enc(prompt))}],\"maxtokens\":\(maxtokens)}";
  let hc=http.client(url);
  let resp=http.postheaders(hc;"";str.tobytes(body);"{\"content-type\":\"application/json\"}");
  <mt resp {
    $ok:r completioncontent(r);
    $err:e ""
  }
};

(* The response is read in its own function, not lifted out of the match arm.
   Binding `let r=mt resp { $err:e ""; $ok:r r }` gave `r` two types — str on the
   error arm, $httpresp on the ok arm — and `r.body` then had no established type
   at all, which is what E4034 was reporting. *)
f=completioncontent(r:$httpresp):str{
  if(!(r.status>199)){ <"" }el{};
  if(!(r.status<300)){ <"" }el{};
  let parsed=json.decode(r.body);
  let choices=json.getarray(parsed;"choices");
  if(choices.len==0){ <"" }el{};
  let first=str.arrayget(choices;0);
  let msg=json.getobj(first;"message");
  <json.str(msg;"content")
};

f=formatcluster(c:$exocluster):str{
  let n=c.nodes.len;
  let parts=mut.str.concat("Exo cluster: ";str.concat(str.fromint(n);str.concat(" nodes, ";str.concat(str.fromf32(c.totalmemorygb);"GB total | "))));
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=n){
      br
    }el{
      let node=c.nodes.get(i);
      parts=str.concat(parts;str.concat(node.device;str.concat("(";str.concat(str.fromf32(node.memorygb);"GB)"))));
      if(i<n-1){
        parts=str.concat(parts;", ")
      }el{
        parts=parts
      };
      i=i+1
    }
  };
  <parts
};

m=core.companion.channel;

i=t:core.companion.types;
i=tls:std.tls;
i=log:shared.log;
i=str:std.str;

f=genidentity(devicename:str):i64{
  let kp=tls.genselfsigned(str.concat("loke.";devicename);3650);
  log.info(str.concat("generated identity cert for: ";devicename);"companion";"channel");
  <kp
};

f=connect(companion:i64;ourkeypair:i64):i64{
  let cfg=tls.tlsconfig(ourkeypair.certpem;ourkeypair.keypem;companion.certpem;true);
  <tls.connecttls(companion.host;companion.port;cfg)
};

f=listen(port:i32;keypair:i64;cb:i64):bool{
  let cfg=tls.tlsconfig(keypair.certpem;keypair.keypem;"";false);
  <tls.listentls(port;cfg;cb)
};

f=send(conn:i64;msg:str):bool{
  <tls.write(conn;msg)
};

f=recv(conn:i64):str{
  <tls.read(conn)
};

f=close(conn:i64):bool{
  <tls.close(conn)
};

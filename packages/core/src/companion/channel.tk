(* Mutually-authenticated channel to a paired companion device.

   As of toke 445f519 this is real. std.tls was a facade over a finished TLS 1.3
   implementation — every wrapper was `(void)arg; return 0;` — and `connecttls` and
   `listentls` were glue names that resolved to symbols which did not exist. That is
   fixed upstream (their story 136.44), and the module now exposes the mutual-auth
   configuration loke needs as a constructor, `tls.mutualconfig(cert; key; peercert)`,
   because the TlsConfig field names contain underscores that a toke program cannot
   write.

   So the connection below verifies the peer. Before this it could not: the old
   two-parameter tlsconfig had nowhere to put the companion's certificate, which is
   why F8.2's "TLS 1.3 mutual auth" was reopened. *)

m=core.companion.channel;

i=tls:std.tls;
i=log:shared.log;
i=str:std.str;
i=t:core.companion.types;

(* F10.56: connect answered the connection as an i64, with 0 for "not connected", and send,
   recv, close and pairingcode took it back as an i64. std.tls reads a $tlsconn through its
   address, and toke 3.3.0 refuses an i64 there (E4031); a record cannot be compared with 0.
   So a connection is held as a $chanlink: up says whether conn is a live connection that
   std.tls handed out. When up is false, conn is an empty record that is never given to
   std.tls: every function below tests up first. *)
t=$chanlink{
  up:bool;
  conn:$tlsconn
};

f=identityvaliddays():i32{
  <3650 as i32
};

(* toke 3.2.0 types the keypair (E4031 on an i64 return). A failure answers an empty
   keypair, which no peer can pin and tls.mutualconfig cannot use. (F10.53) *)
f=genidentity(devicename:str):$tlskeypair{
  <mt tls.genselfsigned("loke.\(devicename)";identityvaliddays()) {
    $ok:kp kp;
    $err:e identityfailed(devicename)
  }
};

f=identityfailed(devicename:str):$tlskeypair{
  log.error("could not generate an identity certificate for \(devicename)";"companion";"channel");
  <$tlskeypair{certpem:"";keypem:""}
};

f=down():$chanlink{
  <$chanlink{up:false;conn:$tlsconn{id:""}}
};

f=linked(conn:$tlsconn):$chanlink{
  <$chanlink{up:true;conn:conn}
};

(* Verifies the companion's certificate. A companion with no pinned certificate is
   refused rather than connected to without authentication. *)
f=connect(companion:$companion;ourkeypair:$tlskeypair):$chanlink{
  if(str.len(companion.certpem)==0){
    log.error("refusing to connect to \(companion.host): no pinned certificate for this companion";"companion";"channel");
    <down()
  }el{
    <mt tls.connect(companion.host;companion.port;tls.mutualconfig(tls.certof(ourkeypair);tls.keyof(ourkeypair);companion.certpem)) {
      $some:conn linked(conn);
      $none:v connectfailed(companion.host)
    }
  }
};

f=connectfailed(host:str):$chanlink{
  log.warn("TLS connection to \(host) failed";"companion";"channel");
  <down()
};

(* The handler is declared with toke's function-type syntax — `fn` is the .tki's
   spelling and is not nameable in source. *)
f=listen(port:i32;keypair:$tlskeypair;handler:($str):$str):bool{
  <tls.listen(port;tls.tlsconfig(tls.certof(keypair);tls.keyof(keypair));handler)
};

f=send(link:$chanlink;msg:str):bool{
  if(!link.up){
    <false
  }el{
    <tls.write(link.conn;msg)
  }
};

f=recv(link:$chanlink):str{
  if(!link.up){
    <""
  }el{
    <mt tls.read(link.conn) {
      $some:s s;
      $none:v ""
    }
  }
};

f=close(link:$chanlink):bool{
  if(!link.up){
    <false
  }el{
    <tls.close(link.conn)
  }
};

(* The pairing code is derived from the live connection's certificate by std.tls, so
   both ends compute the same value from the same handshake. *)
f=pairingcode(link:$chanlink):str{
  if(!link.up){
    <""
  }el{
    <tls.pairingcode(link.conn)
  }
};

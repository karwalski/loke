(* Mutually-authenticated channel to a paired companion device.

   IT IS NOT MUTUALLY AUTHENTICATED, AND IT IS NOT ENCRYPTED. Every function in
   toke's std.tls is a stub that ignores its arguments and returns 0: tlsconfig,
   connecttls, listentls and genselfsigned all return 0, and read/write/close act on
   a handle that was never a connection. There is no TLS on this toolchain.

   Two consequences are recorded here rather than left to be rediscovered:

     1. `tlsconfig` now takes only (cert, key). The old call passed the companion's
        certificate and a verify-peer flag as well — that is the mutual-auth half —
        and the current signature has nowhere to put them. So peer verification
        cannot be expressed through std.tls at all, not merely "is untested".
     2. `genselfsigned` takes only a common name. The 3650-day validity loke asked
        for is not passed to anything.

   Every function therefore reports failure instead of returning a zero handle that
   a caller would treat as a live socket. A channel that silently is not encrypted
   is worse than one that refuses to open. *)

m=core.companion.channel;

i=tls:std.tls;
i=log:shared.log;
i=str:std.str;
i=t:core.companion.types;

f=unavailable(what:str):i64{
  log.error("companion channel unavailable: std.tls is not implemented, cannot \(what)";"companion";"channel");
  <0
};

f=genidentity(devicename:str):i64{
  let kp=tls.genselfsigned("loke.\(devicename)");
  if(kp==0){
    <unavailable("generate an identity certificate for \(devicename)")
  }el{
    log.info("generated identity cert for: \(devicename)";"companion";"channel");
    <kp
  }
};

f=connect(companion:$companion;ourkeypair:i64):i64{
  (* The companion's certificate is deliberately not passed: std.tls.tlsconfig has
     no parameter for it, so this connection cannot verify the peer. *)
  let cfg=tls.tlsconfig("";"");
  if(cfg==0){
    <unavailable("verify \(companion.host) — peer authentication is not available")
  }el{
    <tls.connecttls(companion.host;companion.port)
  }
};

f=listen(port:i32;keypair:i64):bool{
  let cfg=tls.tlsconfig("";"");
  if(cfg==0){
    <unavailable("listen on \(port)")!=0
  }el{
    <tls.listentls(port;cfg)!=0
  }
};

f=send(conn:i64;msg:str):bool{
  if(conn==0){
    <false
  }el{
    <tls.write(conn;msg)
  }
};

f=recv(conn:i64):str{
  if(conn==0){
    <""
  }el{
    <tls.read(conn)
  }
};

f=close(conn:i64):bool{
  if(conn==0){
    <false
  }el{
    <tls.close(conn)
  }
};

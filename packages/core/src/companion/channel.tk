m=core.companion.channel;
i=t:companion.types;
i=tls:std.tls;
i=log:shared.log;

f=genidentity(devicename:str):tls.$tlskeypair{
  kp=tls.genselfsigned("loke.{device_name}";3650);
  log.info "generated identity cert for: {device_name}";
  <kp
};

f=connect(companion:t.$companion;ourkeypair:tls.$tlskeypair):(tls.$tlsconn){
  cfg=tls.$tlsconfig{ certpem=ourkeypair.certpem; keypem=ourkeypair.keypem; peercertpem=companion.certpem; requiremutual=true };
  <tls.connecttls(companion.host;companion.port;cfg)
};

f=listen(port:i32;keypair:tls.$tlskeypair;cb:f(tls.$tlsconn):void):bool{
  cfg=tls.$tlsconfig{ certpem=keypair.certpem; keypem=keypair.keypem; peercertpem=""; requiremutual=false };
  <tls.listentls(port;cfg;cb)
};

f=send(conn:tls.$tlsconn;msg:str):bool{
  <tls.write(conn;msg)
};

f=recv(conn:tls.$tlsconn):(str){
  <tls.read(conn)
};

f=close(conn:tls.$tlsconn):bool{
  <tls.close(conn)
};

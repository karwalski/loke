m=core.companion.executor;

i=ch:core.companion.channel;
i=json:std.json;
i=jx:shared.jsonobj;
i=sh:shared.types;
i=str:std.str;
i=t:core.companion.types;
i=tls:std.tls;

t=$remoterequest{
  model:str;
  prompt:str;
  maxtokens:i32
};

t=$remoteresponse{
  text:str;
  tokensused:i32;
  latencyms:i32;
  ok:bool;
  err:str
};

f=failedresponse(err:str):$remoteresponse{
  <$remoteresponse{ text:""; tokensused:0; latencyms:0; ok:false; err:err }
};

(* F10.53: core.companion.channel answers "" from recv when nothing arrived and 0 from
   connect when it did not connect; this module matched both as options, which they are not,
   and took a $companion and a keypair as i64. toke 3.2.0 refuses the i64s (E4031). It now
   reads the channel's sentinels. Nothing imports this module yet.
   F10.56: a connection is a channel $chanlink, not an i64; connect's "not connected" is
   a link whose up is false. *)
f=executerecv(conn:$chanlink):$remoteresponse{
  let raw=ch.recv(conn);
  ch.close(conn);
  if(str.len(raw)==0){ <failedresponse("no response") }el{};
  <parseremoteresponse(raw)
};

(* LS1.1w: json.dec, the typed decoder, where json.decode (an untyped ABI helper) was. A body
   that does not parse reads as an empty object, so its fields take their zero values. *)
f=docof(raw:str):$jsonval{
  <mt json.dec(raw) {
    $ok:j j;
    $jsonerr:e jx.emptyobj()
  }
};

f=parseremoteresponse(raw:str):$remoteresponse{
  let parsed=docof(raw);
  let text=mt json.str(parsed;"text"){$ok:okv okv;$err:errv ""};
  let tokensused=mt json.i64(parsed;"tokens_used"){$ok:okv okv;$err:errv 0};
  let latencyms=mt json.i64(parsed;"latency_ms"){$ok:okv okv;$err:errv 0};
  <$remoteresponse{ text:text; tokensused:tokensused; latencyms:latencyms; ok:true; err:"" }
};

f=executeconn(conn:$chanlink;req:$remoterequest):$remoteresponse{
  if(ch.send(conn;"{\"type\":\"generate\",\"model\":\(jx.escape(req.model)),\"prompt\":\(jx.escape(req.prompt)),\"maxtokens\":\(req.maxtokens)}")){
    <executerecv(conn)
  }el{
    ch.close(conn);
    <failedresponse("send failed")
  }
};

f=execute(companion:$companion;keypair:$tlskeypair;req:$remoterequest):$remoteresponse{
  let conn=ch.connect(companion;keypair);
  if(!conn.up){ <failedresponse("connection failed") }el{};
  <executeconn(conn;req)
};

f=offlinestatus(companionid:str):$companionstatus{
  <$companionstatus{ companionid:companionid; online:false; models:@(); gpugb:0.0 as f32; ramgb:0.0 as f32 }
};

f=statusrecv(conn:$chanlink;companionid:str):$companionstatus{
  let raw=ch.recv(conn);
  ch.close(conn);
  if(str.len(raw)==0){ <offlinestatus(companionid) }el{};
  <parsestatusresponse(raw;companionid)
};

f=parsestatusresponse(raw:str;companionid:str):$companionstatus{
  let parsed=docof(raw);
  let models=sh.jsonstrarray(parsed;"models");
  (* json.f64, typed: json.getf32 takes untyped i64 arguments, and core.companion.exo measured
     it answering a value no arithmetic could use. *)
  let gpugb=mt json.f64(parsed;"gpu_gb") {$ok:v v as f32;$jsonerr:e 0.0 as f32};
  let ramgb=mt json.f64(parsed;"ram_gb") {$ok:v v as f32;$jsonerr:e 0.0 as f32};
  <$companionstatus{ companionid:companionid; online:true; models:models; gpugb:gpugb; ramgb:ramgb }
};

f=statusconn(conn:$chanlink;companionid:str):$companionstatus{
  if(ch.send(conn;"{\"type\":\"status\"}")){
    <statusrecv(conn;companionid)
  }el{
    ch.close(conn);
    <offlinestatus(companionid)
  }
};

f=status(companion:$companion;keypair:$tlskeypair):$companionstatus{
  let conn=ch.connect(companion;keypair);
  if(!conn.up){ <offlinestatus(companion.id) }el{};
  <statusconn(conn;companion.id)
};

f=formatstatus(s:$companionstatus):str{
  let state=mut."offline";
  if(s.online){ state="online" }el{};
  <"Companion \(s.companionid): \(state) | \(str.fromint(s.models.len)) models | \(str.fromfloat(s.gpugb))GB GPU | \(str.fromfloat(s.ramgb))GB RAM"
};

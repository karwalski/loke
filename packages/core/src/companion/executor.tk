m=core.companion.executor;
i=t:companion.types;
i=ch:companion.channel;
i=tls:std.tls;
i=json:std.json;
i=log:shared.log;
i=pt:providers.types;

t=$remoterequest{ model:str; prompt:str; maxtokens:i32 };
t=$remoteresponse{ text:str; tokensused:i32; latencyms:i32; ok:bool; err:str };

f=execute(companion:i64;keypair:i64;req:$remoterequest):$remoteresponse{
  connopt=ch.connect(companion;keypair);
  mt  { connopt.$none:
    <$remoteresponse{ text=""; tokensused=0; latencyms=0; ok=false; err="connection failed" };
  };
  conn=connopt.$some;
  payload=json.encode({ type="generate"; model=req.model; prompt=req.prompt; maxtokens=req.maxtokens });
  sent=ch.send(conn;payload);
  mt  { sent.$false:
    ch.close(conn);
    <$remoteresponse{ text=""; tokensused=0; latencyms=0; ok=false; err="send failed" };
  };
  rawopt=ch.recv(conn);
  mt  { rawopt.$none:
    ch.close(conn);
    <$remoteresponse{ text=""; tokensused=0; latencyms=0; ok=false; err="no response" };
  };
  raw=rawopt.$some;
  ch.close(conn);
  parsed=json.decode(raw);
  text=parsed.get("text") as str;
  tokensused=parsed.get("tokens_used") as i32;
  latencyms=parsed.get("latency_ms") as i32;
  <$remoteresponse{ text=text; tokensused=tokensused; latencyms=latencyms; ok=true; err="" };
};

f=status(companion:i64;keypair:i64):i64{
  connopt=ch.connect(companion;keypair);
  mt  { connopt.$none:
    <t.$companionstatus{ companionid=companion.id; online=false; models=@(); gpugb=0.0; ramgb=0.0 };
  };
  conn=connopt.$some;
  payload=json.encode({ type="status" });
  sent=ch.send(conn;payload);
  mt  { sent.$false:
    ch.close(conn);
    <t.$companionstatus{ companionid=companion.id; online=false; models=@(); gpugb=0.0; ramgb=0.0 };
  };
  rawopt=ch.recv(conn);
  mt  { rawopt.$none:
    ch.close(conn);
    <t.$companionstatus{ companionid=companion.id; online=false; models=@(); gpugb=0.0; ramgb=0.0 };
  };
  raw=rawopt.$some;
  ch.close(conn);
  parsed=json.decode(raw);
  models=parsed.get("models") as @str;
  gpugb=parsed.get("gpu_gb") as f32;
  ramgb=parsed.get("ram_gb") as f32;
  <t.$companionstatus{ companionid=companion.id; online=true; models=models; gpugb=gpugb; ramgb=ramgb };
};

f=formatstatus(s:i64):str{
  state="offline";
  mt  { s.online: state="online" };
  n=s.models.len();
  <"Companion {s.companion_id}: {state} | {n} models | {s.gpu_gb}GB GPU | {s.ram_gb}GB RAM"
};

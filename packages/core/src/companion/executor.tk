m=core.companion.executor;

i=t:companion.types;
i=ch:companion.channel;
i=tls:std.tls;
i=json:std.json;
i=log:shared.log;
i=str:std.str;
i=pt:providers.types;

t=$remoterequest{
  model:str;
  prompt:str;
  maxtokens:i32
};

t=$remoteresponse{
  text:str;
  tokensused:i32;
  latencyms:i32;
  ok:bool;
  err:str
};

f=execute(companion:i64;keypair:i64;req:$remoterequest):$remoteresponse{
  let connopt=ch.connect(companion;keypair);
  mt connopt {
    $none
      <$remoteresponse{ text:""; tokensused:0; latencyms:0; ok:false; err:"connection failed" };
    $some:conn
      let payload=json.encode(json.obj("type";"generate";"model";req.model;"prompt";req.prompt;"maxtokens";str.fromint(req.maxtokens)));
      let sent=ch.send(conn;payload);
      if(sent){
        let rawopt=ch.recv(conn);
        mt rawopt {
          $none
            ch.close(conn);
            <$remoteresponse{ text:""; tokensused:0; latencyms:0; ok:false; err:"no response" };
          $some:raw
            ch.close(conn);
            let parsed=json.decode(raw);
            let text=json.getstr(parsed;"text");
            let tokensused=json.getint(parsed;"tokens_used");
            let latencyms=json.getint(parsed;"latency_ms");
            <$remoteresponse{ text:text; tokensused:tokensused; latencyms:latencyms; ok:true; err:"" }
        }
      }el{
        ch.close(conn);
        <$remoteresponse{ text:""; tokensused:0; latencyms:0; ok:false; err:"send failed" }
      }
  }
};

f=status(companion:i64;keypair:i64):$companionstatus{
  let connopt=ch.connect(companion;keypair);
  mt connopt {
    $none
      <$companionstatus{ companionid:companion.id; online:false; models:@(); gpugb:0.0; ramgb:0.0 };
    $some:conn
      let payload=json.encode(json.obj("type";"status"));
      let sent=ch.send(conn;payload);
      if(sent){
        let rawopt=ch.recv(conn);
        mt rawopt {
          $none
            ch.close(conn);
            <$companionstatus{ companionid:companion.id; online:false; models:@(); gpugb:0.0; ramgb:0.0 };
          $some:raw
            ch.close(conn);
            let parsed=json.decode(raw);
            let models=json.getstrarr(parsed;"models");
            let gpugb=json.getf32(parsed;"gpu_gb");
            let ramgb=json.getf32(parsed;"ram_gb");
            <$companionstatus{ companionid:companion.id; online:true; models:models; gpugb:gpugb; ramgb:ramgb }
        }
      }el{
        ch.close(conn);
        <$companionstatus{ companionid:companion.id; online:false; models:@(); gpugb:0.0; ramgb:0.0 }
      }
  }
};

f=formatstatus(s:$companionstatus):str{
  let state=if(s.online){ "online" }el{ "offline" };
  let n=s.models.len;
  <str.concat("Companion ";str.concat(s.companionid;str.concat(": ";str.concat(state;str.concat(" | ";str.concat(str.fromint(n);str.concat(" models | ";str.concat(str.fromf32(s.gpugb);str.concat("GB GPU | ";str.concat(str.fromf32(s.ramgb);"GB RAM"))))))))))
};

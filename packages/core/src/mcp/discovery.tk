m=core.mcp.discovery;

i=json:std.json;
i=jx:shared.jsonobj;
i=str:std.str;
i=log:shared.log;
i=time:std.time;
i=t:shared.types;
i=reach:shared.reachability;

t=$discoveredserver{
  host:str;
  port:i32;
  name:str;
  version:str;
  toolscount:i32
};

t=$discoveryresult{
  servers:@$discoveredserver;
  scannedports:i32;
  found:i32;
  scanms:i32
};

f=wellknownports():@i32{
  <@(11434 as i32;11436 as i32;11437 as i32;11460 as i32;3000 as i32;8080 as i32;8000 as i32;5000 as i32)
};

(* VM1.6f. These read the answers through the typed accessors and shared.jsonobj. They used
   json.getval, json.str and json.getarr on an i64 handle, which is the untyped shape that
   crashes on a str; it never mattered while no answer ever arrived. *)
f=extractserverinfo(initraw:str):@str{
  <mt json.dec(initraw) {
    $ok:obj extractinfofromobj(obj;"unknown";"unknown");
    $jsonerr:e @("unknown";"unknown")
  }
};

f=extractinfofromobj(obj:$json;defname:str;defversion:str):@str{
  let infoval=jx.nested(jx.nested(obj;"result");"serverInfo");
  <@(jx.strvalue(infoval;"name";defname);jx.strvalue(infoval;"version";defversion))
};

f=counttoolsfromraw(toolsraw:str):i32{
  <mt json.dec(toolsraw) {
    $ok:toolsobj counttoolsfromobj(toolsobj);
    $jsonerr:e 0 as i32
  }
};

f=counttoolsfromobj(toolsobj:$json):i32{
  <mt json.arr(jx.nested(toolsobj;"result");"tools") {
    $ok:a a.len as i32;
    $jsonerr:e 0 as i32
  }
};

(* The $ok arm comes first in every match in this file, deliberately.

   toke binds a result's match arms by POSITION, not by label (T-31): ok selects arm 0 and
   err selects arm 1 whatever the arms are called. So with $httperr written first the match
   is INVERTED — a server that answered ran the error arm and reported name="unknown" with
   toolscount=0, and a server that did not answer ran the $ok arm and bound the error
   payload as if it were the response body.

   The two matches above this comment had exactly that defect until the T-31 sweep; this
   comment used to claim only these two were deliberate, which is how they were missed.
   scripts/find_err_arm_first.py now fails the gate on any result match whose $ok arm is
   not first, so the ordering is enforced rather than remembered.

   probeport also only reaches buildserver once net.portavailable has confirmed something
   is listening, because http.get cannot detect a closed port at all (T-15). Two separate
   compiler bugs, two separate workarounds; when T-31 is fixed the arm order stops
   mattering, and T-15 still will. *)
(* VM1.6f. Both requests below were `http.postheaders(http.client(url);"";...)`, and the
   runtime reads postheaders' first argument as a URL string, so neither was sent (T-48):
   every server discovery found was named "unknown" with no tools. probeport only calls this
   for a port on this machine, so reach.localpost is the client. An empty answer reads as
   "unknown" and 0 tools, as a failed request did. *)
f=buildserver(host:str;port:i32;baseurl:str):$discoveredserver{
  let initraw=reach.localpost(baseurl;"/mcp";"{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"loke-discovery\",\"version\":\"0.1.0\"}}}");
  let info=mut.@("unknown";"unknown");
  if(str.len(initraw)>0){ info=extractserverinfo(initraw) }el{};
  let servername=info.get(0);
  let serverversion=info.get(1);

  let toolsraw=reach.localpost(baseurl;"/mcp";"{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":null}");
  let toolscount=mut.0 as i32;
  if(str.len(toolsraw)>0){ toolscount=counttoolsfromraw(toolsraw) }el{};

  log.debug(
    "discovered MCP server at \(baseurl) name=\(servername)";
    "mcp-discovery";
    "system"
  );
  <$discoveredserver{
    host:host;
    port:port;
    name:servername;
    version:serverversion;
    toolscount:toolscount
  }
};

(* A liveness probe that cannot lie, and a sentinel instead of a result.

   This used to be `$discoveredserver!$lokeerr` and match on http.get. Two things made
   it always report nothing:

   - toke takes the FIRST arm of a match on a result whatever the value is (T-18), so
     the `$httperr` arm ran even for a live server and every probe returned an error;
   - http.get cannot detect a closed port anyway — it returns $ok carrying a nil
     response (T-15), which is why shared.reachability exists.

   So the port is tested by net.portavailable, which BINDS and therefore answers
   honestly, and the answer comes back as a plain struct. An empty `name` means nothing
   was listening: a caller checks it with an `if`, not with a match it cannot trust. *)
f=noserver():$discoveredserver{
  <$discoveredserver{host:"";port:0 as i32;name:"";version:"";toolscount:0 as i32}
};

f=probeport(host:str;port:i32):$discoveredserver{
  let ports=str.fromint(port);
  let baseurl="http://\(host):\(ports)";
  if(reach.localserviceup(baseurl)){
    <buildserver(host;port;baseurl)
  }el{
    <noserver()
  }
};

f=isserver(s:$discoveredserver):bool{
  <str.len(s.name)>0
};

f=scanlocalhost():$discoveryresult{
  let startms=time.nowms();
  let servers=mut.@($discoveredserver);
  let ports=wellknownports();
  lp(let ii114=0;ii114<ports.len;ii114=ii114+1){
    let found=probeport("localhost";ports.get(ii114));
    (* `servers==@(servers;s)` — a comparison, discarded, wrapped around a nesting
       array literal, inside a match arm that never ran. Three separate reasons this
       loop accumulated nothing. *)
    if(isserver(found)){servers=servers.push(found)}el{}
  };
  let elapsed=time.nowms()-startms;
  let foundcount=servers.len;
  log.info(
    "MCP scan complete: found \(str.fromint(foundcount)) servers";
    "mcp-discovery";
    "system"
  );
  <$discoveryresult{
    servers:servers;
    scannedports:ports.len;
    found:foundcount;
    scanms:elapsed
  }
};

f=scanrange(startport:i32;endport:i32):$discoveryresult{
  let cap=100 as i32;
  let startms=time.nowms();
  let servers=@($discoveredserver);
  let limit=mut.endport;
  if((endport-startport)+1 as i32 > cap){
    limit=startport+cap-1 as i32
  }el{};

  <scanrangefrom(startport;limit;servers;0 as i32;startms)
};

f=scanrangefrom(port:i32;limit:i32;acc:@$discoveredserver;scanned:i32;startms:i64):$discoveryresult{
  if(port > limit){
    <$discoveryresult{
      servers:acc;
      scannedports:scanned;
      found:acc.len;
      scanms:(time.nowms()-startms)
    }
  }el{
    let found=probeport("localhost";port);
    let nextacc=mut.acc;
    if(isserver(found)){nextacc=acc.push(found)}el{};
    <scanrangefrom(port+1 as i32;limit;nextacc;scanned+1 as i32;startms)
  }
};


f=formatresult(result:$discoveryresult):str{
  let header=str.concat(
    str.concat(
      str.concat(
        str.concat(
          t.strpad("Host";16);
          t.strpad("Port";8));
        t.strpad("Name";24));
      t.strpad("Version";16));
    "Tools
"
  );
  let separator="---------------- -------- ------------------------ ---------------- -----\n"
  ;
  let rows=mut."";
  lp(let ii213=0;ii213<result.servers.len;ii213=ii213+1){
    let s=result.servers.get(ii213);
    let ports=str.fromint(s.port);
    let toolss=str.fromint(s.toolscount);
    rows=str.concat(rows;"\(t.strpad(s.host;16))\(t.strpad(ports;8))\(t.strpad(s.name;24))\(t.strpad(s.version;16))\(toolss)\n")

  };
  let scanneds=str.fromint(result.scannedports);
  let founds=str.fromint(result.found);
  let mss=str.fromint(result.scanms);
  let summary="Found \(founds) MCP servers on \(scanneds) ports scanned (\(mss)ms)";
  <"\(header)\(separator)\(rows)\n\(summary)"
};

m=core.mcp.discovery;

i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=time:std.time;
i=t:shared.types;
i=reach:shared.reachability;

t=$discoveredserver{
  host:str;
  port:i32;
  name:str;
  version:str;
  toolscount:i32
};

t=$discoveryresult{
  servers:@$discoveredserver;
  scannedports:i32;
  found:i32;
  scanms:i32
};

f=wellknownports():@i32{
  <@(11434 as i32;11435 as i32;11436 as i32;11437 as i32;3000 as i32;8080 as i32;8000 as i32;5000 as i32)
};

f=extractserverinfo(initraw:str):@str{
  let name="unknown";
  let version="unknown";
  let parsed=json.dec(initraw);
  <mt parsed {
    $jsonerr:e @(name;version);
    $ok:obj extractinfofromobj(obj;name;version)
  }
};

f=extractinfofromobj(obj:i64;defname:str;defversion:str):@str{
  let resultval=json.getval(obj;"result");
  let infoval=json.getval(resultval;"serverInfo");
  let name=json.str(infoval;"name");
  let version=json.str(infoval;"version");
  let rname=mut.defname;
  if(str.len(name) > 0){ rname=name };
  let rversion=mut.defversion;
  if(str.len(version) > 0){ rversion=version };
  <@(rname;rversion)
};

f=counttoolsfromraw(toolsraw:str):i32{
  let toolsparsed=json.dec(toolsraw);
  <mt toolsparsed {
    $jsonerr:e 0;
    $ok:toolsobj counttoolsfromobj(toolsobj)
  }
};

f=counttoolsfromobj(toolsobj:i64):i32{
  let resultval=json.getval(toolsobj;"result");
  let toolsarr=json.getarr(resultval;"tools");
  <toolsarr.len
};

(* The $ok arm comes first in both matches below, deliberately.

   toke takes the first arm of a match on a result whatever the value is (T-18), so arm
   ORDER decides the outcome and the $httperr arms are unreachable. Written $httperr
   first, every discovered server reported name="unknown" and toolscount=0 even when it
   had answered. probeport now only calls this once net.portavailable has confirmed
   something is listening, so $ok is the case worth being right about. This is a
   workaround for a compiler bug, not a design: when T-18 is fixed, the error arms start
   running and the order stops mattering. *)
f=buildserver(host:str;port:i32;baseurl:str):$discoveredserver{
  let initurl=str.concat(baseurl;"/mcp");
  let initresp=http.postheaders(http.client(initurl);"";str.tobytes("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"loke-discovery\",\"version\":\"0.1.0\"}}}");"{\"content-type\":\"application/json\"}");
  let info=mt initresp {
    $ok:initraw extractserverinfo(initraw);
    $httperr:e @("unknown";"unknown")
  };
  let servername=info.get(0);
  let serverversion=info.get(1);

  let toolsurl=str.concat(baseurl;"/mcp");
  let toolsresp=http.postheaders(http.client(toolsurl);"";str.tobytes("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":null}");"{\"content-type\":\"application/json\"}");
  let toolscount=mt toolsresp {
    $ok:toolsraw counttoolsfromraw(toolsraw);
    $httperr:e 0
  };

  log.debug(
    str.concat(
      str.concat("discovered MCP server at ";baseurl);
      str.concat(" name=";servername));
    "mcp-discovery";
    "system"
  );
  <$discoveredserver{
    host:host;
    port:port;
    name:servername;
    version:serverversion;
    toolscount:toolscount
  }
};

(* A liveness probe that cannot lie, and a sentinel instead of a result.

   This used to be `$discoveredserver!$lokeerr` and match on http.get. Two things made
   it always report nothing:

   - toke takes the FIRST arm of a match on a result whatever the value is (T-18), so
     the `$httperr` arm ran even for a live server and every probe returned an error;
   - http.get cannot detect a closed port anyway — it returns $ok carrying a nil
     response (T-15), which is why shared.reachability exists.

   So the port is tested by net.portavailable, which BINDS and therefore answers
   honestly, and the answer comes back as a plain struct. An empty `name` means nothing
   was listening: a caller checks it with an `if`, not with a match it cannot trust. *)
f=noserver():$discoveredserver{
  <$discoveredserver{host:"";port:0 as i32;name:"";version:"";toolscount:0 as i32}
};

f=probeport(host:str;port:i32):$discoveredserver{
  let ports=str.fromint(port);
  let baseurl=str.concat(str.concat("http://";host);str.concat(":";ports));
  if(reach.localserviceup(baseurl)){
    <buildserver(host;port;baseurl)
  }el{
    <noserver()
  }
};

f=isserver(s:$discoveredserver):bool{
  <str.len(s.name)>0
};

f=scanlocalhost():$discoveryresult{
  let startms=time.nowms();
  let servers=mut.@($discoveredserver);
  let ports=wellknownports();
  lp(let ii114=0;ii114<ports.len;ii114=ii114+1){
    let found=probeport("localhost";ports.get(ii114));
    (* `servers==@(servers;s)` — a comparison, discarded, wrapped around a nesting
       array literal, inside a match arm that never ran. Three separate reasons this
       loop accumulated nothing. *)
    if(isserver(found)){servers=servers.push(found)}el{}
  };
  let endms=time.nowms();
  let elapsed=endms-startms;
  let foundcount=servers.len;
  log.info(
    str.concat(
      str.concat("MCP scan complete: found ";str.fromint(foundcount));
      " servers");
    "mcp-discovery";
    "system"
  );
  <$discoveryresult{
    servers:servers;
    scannedports:ports.len;
    found:foundcount;
    scanms:elapsed
  }
};

f=scanrange(startport:i32;endport:i32):$discoveryresult{
  let cap=100 as i32;
  let startms=time.nowms();
  let servers=@($discoveredserver);
  let limit=mut.endport;
  if((endport-startport)+1 as i32 > cap){
    limit=startport+cap-1 as i32
  }el{};

  let result=scanrangefrom(startport;limit;servers;0 as i32;startms);
  <result
};

f=scanrangefrom(port:i32;limit:i32;acc:@$discoveredserver;scanned:i32;startms:i64):$discoveryresult{
  if(port > limit){
    let endms=time.nowms();
    <$discoveryresult{
      servers:acc;
      scannedports:scanned;
      found:acc.len;
      scanms:(endms-startms)
    }
  }el{
    let found=probeport("localhost";port);
    let nextacc=mut.acc;
    if(isserver(found)){nextacc=acc.push(found)}el{};
    <scanrangefrom(port+1 as i32;limit;nextacc;scanned+1 as i32;startms)
  }
};


f=formatresult(result:$discoveryresult):str{
  let header=str.concat(
    str.concat(
      str.concat(
        str.concat(
          t.strpad("Host";16);
          t.strpad("Port";8));
        t.strpad("Name";24));
      t.strpad("Version";16));
    "Tools
"
  );
  let separator=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("---------------- ";
            "-------- ");
          "------------------------ ");
        "---------------- ");
      "-----
");
    "")
  ;
  let rows=mut."";
  lp(let ii213=0;ii213<result.servers.len;ii213=ii213+1){
    let s=result.servers.get(ii213);
    let ports=str.fromint(s.port);
    let toolss=str.fromint(s.toolscount);
    let row=str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              t.strpad(s.host;16);
              t.strpad(ports;8));
            t.strpad(s.name;24));
          t.strpad(s.version;16));
        toolss);
      "
")
    ;
    rows=str.concat(rows;row)

  };
  let scanneds=str.fromint(result.scannedports);
  let founds=str.fromint(result.found);
  let mss=str.fromint(result.scanms);
  let summary=str.concat(
    str.concat(
      str.concat(
        str.concat("Found ";founds);
        str.concat(" MCP servers on ";scanneds));
      str.concat(" ports scanned (";mss));
    "ms)");
  <str.concat(
    str.concat(
      str.concat(
        str.concat(header;separator);
        rows);
      "
");
    summary)
};

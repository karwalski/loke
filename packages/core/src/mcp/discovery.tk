m=core.mcp.discovery;

i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=time:std.time;

t=$discoveredserver{
  host:str;
  port:i32;
  name:str;
  version:str;
  toolscount:i32
};

t=$discoveryresult{
  servers:@$discoveredserver;
  scannedports:i32;
  found:i32;
  scanms:i32
};

f=wellknownports():@i32{
  <@(11434 as i32;11435 as i32;11436 as i32;11437 as i32;3000 as i32;8080 as i32;8000 as i32;5000 as i32)
};

f=extractserverinfo(initraw:str):@str{
  let name="unknown";
  let version="unknown";
  let parsed=json.dec(initraw);
  mt parsed {
    $jsonerr:e @(name;version);
    $ok:obj extractinfofromobj(obj;name;version)
  }
};

f=extractinfofromobj(obj:i64;defname:str;defversion:str):@str{
  let resultval=json.getval(obj;"result");
  let infoval=json.getval(resultval;"serverInfo");
  let name=json.str(infoval;"name");
  let version=json.str(infoval;"version");
  let rname=mut.defname;
  if(str.len(name) > 0){ rname=name };
  let rversion=mut.defversion;
  if(str.len(version) > 0){ rversion=version };
  <@(rname;rversion)
};

f=counttoolsfromraw(toolsraw:str):i32{
  let toolsparsed=json.dec(toolsraw);
  mt toolsparsed {
    $jsonerr:e 0;
    $ok:toolsobj counttoolsfromobj(toolsobj)
  }
};

f=counttoolsfromobj(toolsobj:i64):i32{
  let resultval=json.getval(toolsobj;"result");
  let toolsarr=json.getarr(resultval;"tools");
  <toolsarr.len
};

f=buildserver(host:str;port:i32;baseurl:str):$discoveredserver{
  let initurl=str.concat(baseurl;"/mcp");
  let initbody="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"loke-discovery\",\"version\":\"0.1.0\"}}}";
  let initresp=http.post(initurl;initbody;"application/json");
  let info=mt initresp {
    $httperr:e @("unknown";"unknown");
    $ok:initraw extractserverinfo(initraw)
  };
  let servername=info.get(0);
  let serverversion=info.get(1);

  let toolsurl=str.concat(baseurl;"/mcp");
  let toolsbody="{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":null}";
  let toolsresp=http.post(toolsurl;toolsbody;"application/json");
  let toolscount=mt toolsresp {
    $httperr:e 0;
    $ok:toolsraw counttoolsfromraw(toolsraw)
  };

  log.debug(
    str.concat(
      str.concat("discovered MCP server at ";baseurl);
      str.concat(" name=";servername));
    "mcp-discovery";
    "system"
  );
  <$discoveredserver{
    host:host;
    port:port;
    name:servername;
    version:serverversion;
    toolscount:toolscount
  }
};

f=probeport(host:str;port:i32):$discoveredserver!$lokeerr{
  let ports=str.fromint(port);
  let baseurl=str.concat(str.concat("http://";host);str.concat(":";ports));
  let healthurl=str.concat(baseurl;"/health");

  let healthresp=http.get(healthurl);
  mt healthresp {
    $httperr:e $networkerr("port not responding");
    $ok:raw $ok(buildserver(host;port;baseurl))
  }
};

f=scanlocalhost():$discoveryresult{
  let startms=time.nowms();
  let servers=@($discoveredserver);
  let ports=wellknownports();
  lp(let ii114=0;ii114<ports.len;ii114=ii114+1){
    let port=ports.get(ii114);
    let found=probeport("localhost";port);
    mt found {
      $lokeerr:e 0;
      $ok:s
        servers=@(servers;s)
    };

  };
  let endms=time.nowms();
  let elapsed=endms-startms;
  let foundcount=servers.len;
  log.info(
    str.concat(
      str.concat("MCP scan complete: found ";str.fromint(foundcount));
      " servers");
    "mcp-discovery";
    "system"
  );
  <$discoveryresult{
    servers:servers;
    scannedports:ports.len;
    found:foundcount;
    scanms:elapsed
  }
};

f=scanrange(startport:i32;endport:i32):$discoveryresult{
  let cap=100 as i32;
  let startms=time.nowms();
  let servers=@($discoveredserver);
  let limit=mut.endport;
  if((endport-startport)+1 as i32 > cap){
    limit=startport+cap-1 as i32
  }el{};

  let result=scanrangefrom(startport;limit;servers;0 as i32;startms);
  <result
};

f=scanrangefrom(port:i32;limit:i32;acc:@$discoveredserver;scanned:i32;startms:i64):$discoveryresult{
  if(port > limit){
    let endms=time.nowms();
    let elapsed=endms-startms;
    let foundcount=acc.len;
    <$discoveryresult{
      servers:acc;
      scannedports:scanned;
      found:foundcount;
      scanms:elapsed
    }
  }el{
    let found=probeport("localhost";port);
    let nextacc=mt found {
      $lokeerr:e acc;
      $ok:s @(acc;s)
    };
    <scanrangefrom(port+1 as i32;limit;nextacc;scanned+1 as i32;startms)
  }
};

f=padright(s:str;width:i32):str{
  let len=str.len(s);
  if(len > width){
    <s
  }el{
    let diff=width-len;
    let spaces="                                        ";
    let pad=str.slice(spaces;0;diff);
    <str.concat(s;pad)
  }
};

f=formatresult(result:$discoveryresult):str{
  let header=str.concat(
    str.concat(
      str.concat(
        str.concat(
          padright("Host";16);
          padright("Port";8));
        padright("Name";24));
      padright("Version";16));
    "Tools
"
  );
  let separator=str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("---------------- ";
            "-------- ");
          "------------------------ ");
        "---------------- ");
      "-----
");
    "")
  ;
  let rows=mut."";
  lp(let ii213=0;ii213<result.servers.len;ii213=ii213+1){
    let s=result.servers.get(ii213);
    let ports=str.fromint(s.port);
    let toolss=str.fromint(s.toolscount);
    let row=str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              padright(s.host;16);
              padright(ports;8));
            padright(s.name;24));
          padright(s.version;16));
        toolss);
      "
")
    ;
    rows=str.concat(rows;row)

  };
  let scanneds=str.fromint(result.scannedports);
  let founds=str.fromint(result.found);
  let mss=str.fromint(result.scanms);
  let summary=str.concat(
    str.concat(
      str.concat(
        str.concat("Found ";founds);
        str.concat(" MCP servers on ";scanneds));
      str.concat(" ports scanned (";mss));
    "ms)");
  <str.concat(
    str.concat(
      str.concat(
        str.concat(header;separator);
        rows);
      "
");
    summary)
};

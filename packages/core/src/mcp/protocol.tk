m=core.mcp.protocol;



i=json:std.json;
i=str:std.str;
i=t:shared.types;



t=$jsonrpcrequest{
  jsonrpc:str;
  id:i64;
  method:str;
  paramsraw:str
};

t=$jsonrpcresponse{
  jsonrpc:str;
  id:i64;
  resultraw:str;
  errorcode:i32;
  errormsg:str;
  iserror:bool
};

t=$mcptool{
  name:str;
  description:str;
  inputschema:str
};

t=$toolresult{
  contenttype:str;
  text:str;
  iserror:bool
};





f=parserequest(raw:str):$jsonrpcrequest|$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr e;
      <$lokeerr.$networkerr(str.concat("parse_request: invalid JSON: ";raw))
    obj;
      let id=json.getint(obj;"id");
      let method=json.getstr(obj;"method");
      let paramsraw=json.enc(json.getval(obj;"params"));
      <$jsonrpcrequest{
        jsonrpc:"2.0";
        id:id;
        method:method;
        paramsraw:paramsraw
      };
  };
};





f=okresponse(id:i64;resultjson:str):str{
  let idstr=str.fromint(id);
  let p1=str.concat("{\"jsonrpc\":\"2.0\",\"id\":";idstr);
  let p2=str.concat(p1;",\"result\":");
  <str.concat(p2;str.concat(resultjson;"}"))
};


f=errorresponse(id:i64;code:i32;msg:str):str{
  let idstr=str.fromint(id);
  let codestr=str.fromint(code);
  let p1=str.concat("{\"jsonrpc\":\"2.0\",\"id\":";idstr);
  let p2=str.concat(p1;",\"error\":{\"code\":");
  let p3=str.concat(p2;codestr);
  let p4=str.concat(p3;",\"message\":\"");
  let p5=str.concat(p4;msg);
  <str.concat(p5;"\"}}")
};




f=toolresultok(text:str):str{
  let escaped=str.replace(text;"\"";"\\"");
  let p1=str.concat("{\"content\":[{\"type\":\"text\",\"text\":\"";escaped);
  <str.concat(p1;"\"}]}")
};


f=toolresulterr(msg:str):str{
  let escaped=str.replace(msg;"\"";"\\"");
  let p1=str.concat("{\"content\":[{\"type\":\"text\",\"text\":\"";escaped);
  <str.concat(p1;"\"}],\"isError\":true}")
};




f=toolslistresult(tools:@$mcptool):str{
  let count=tools.len;
  let i=0;
  let items="";
  loop{
    if(i>=count){
      break
    }else{
      let tool=str.arrayget(tools;i);
      let nameescaped=str.replace(tool.name;"\"";"\\"");
      let descescaped=str.replace(tool.description;"\"";"\\"");
      let entryp1=str.concat("{\"name\":\"";nameescaped);
      let entryp2=str.concat(entryp1;"\",\"description\":\"");
      let entryp3=str.concat(entryp2;descescaped);
      let entryp4=str.concat(entryp3;"\",\"inputSchema\":");
      let entry=str.concat(entryp4;str.concat(tool.inputschema;"}"));
      if(i==0){
        items=entry
      }else{
        items=str.concat(items;str.concat(",";entry))
      };
      i=i+1;
    };
  };
  <str.concat("{\"tools\":[";str.concat(items;"]}"))
};




f=initresponse(servername:str;version:str):str{
  let nameescaped=str.replace(servername;"\"";"\\"");
  let verescaped=str.replace(version;"\"";"\\"");
  let p1=str.concat("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"";nameescaped);
  let p2=str.concat(p1;"\",\"version\":\"");
  let p3=str.concat(p2;verescaped);
  <str.concat(p3;"\"}}")
};

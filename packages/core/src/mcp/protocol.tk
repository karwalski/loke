m=core.mcp.protocol;

i=json:std.json;
i=jx:shared.jsonobj;
i=str:std.str;
i=t:shared.types;

t=$jsonrpcrequest{
  jsonrpc:str;
  id:i64;
  method:str;
  paramsraw:str
};

t=$jsonrpcresponse{
  jsonrpc:str;
  id:i64;
  resultraw:str;
  errorcode:i32;
  errormsg:str;
  iserror:bool
};

t=$mcptool{
  name:str;
  description:str;
  inputschema:str
};

t=$toolresult{
  contenttype:str;
  text:str;
  iserror:bool
};

(* `obj:$json`, not `obj:i64`. The caller binds it from `json.dec`, so it always was one; the
   i64 declaration worked because a one-field struct and a handle share an ABI (T-23).

   `paramsraw` used to be `json.enc(json.getval(obj;"params"))`. `json.getval` is one of
   std.json's untyped `(i64,i64)->i64` helpers and `json.enc` takes a `str`, so that rendered
   the HANDLE — every MCP request reached the tool layer with its params replaced by a decimal
   pointer value, and no tool call carrying arguments could ever have worked.
   `jx.valueraw` returns the raw JSON text of the value, whether it is an object, an array or
   null, which is what a params field has to carry for the tool layer to decode it. *)
f=buildrequestfromobj(obj:$json):$jsonrpcrequest{
  let id=json.i64(obj;"id");
  let method=json.str(obj;"method");
  let paramsraw=jx.valueraw(obj;"params");
  <$jsonrpcrequest{
    jsonrpc:"2.0";
    id:id;
    method:method;
    paramsraw:paramsraw
  }
};

f=parserequest(raw:str):$jsonrpcrequest!$lokeerr{
  let parsed=json.dec(raw);
  <mt parsed {
    $ok:obj $ok(buildrequestfromobj(obj));
    $jsonerr:e $networkerr(str.concat("parse_request: invalid JSON: ";raw))
  }
};

f=okresponse(id:i64;resultjson:str):str{
  let idstr=str.fromint(id);
  let p1=str.concat("{\"jsonrpc\":\"2.0\",\"id\":";idstr);
  let p2=str.concat(p1;",\"result\":");
  <str.concat(p2;str.concat(resultjson;"}"))
};

f=errorresponse(id:i64;code:i32;msg:str):str{
  let idstr=str.fromint(id);
  let codestr=str.fromint(code);
  let p1=str.concat("{\"jsonrpc\":\"2.0\",\"id\":";idstr);
  let p2=str.concat(p1;",\"error\":{\"code\":");
  let p3=str.concat(p2;codestr);
  (* jx.escape, because `msg` used to be concatenated between two literal quote characters
     with no escaping at all. Any message containing a quote broke the envelope and the client
     saw a JSON parse error instead of the diagnosis — and a provider error message, which is
     the commonest thing to end up in here, routinely quotes the offending value. jx.escape
     supplies the surrounding quotes, so the literals around it are gone. *)
  let p4=str.concat(p3;",\"message\":");
  let p5=str.concat(p4;jx.escape(msg));
  <str.concat(p5;"}}")
};

f=toolresultok(text:str):str{
  let escaped=str.replace(text;"\"";"\\\"");
  let p1=str.concat("{\"content\":[{\"type\":\"text\",\"text\":\"";escaped);
  <str.concat(p1;"\"}]}")
};

f=toolresulterr(msg:str):str{
  let escaped=str.replace(msg;"\"";"\\\"");
  let p1=str.concat("{\"content\":[{\"type\":\"text\",\"text\":\"";escaped);
  <str.concat(p1;"\"}],\"isError\":true}")
};

f=toolslistresult(tools:@$mcptool):str{
  let count=tools.len;
  let i=mut.0;
  let items=mut."";
  lp(let lv=0;true;lv=lv){
    if(!(i<count)){
      <str.concat("{\"tools\":[";str.concat(items;"]}"))
    }el{
      let tool=tools.get(i);
      let nameescaped=str.replace(tool.name;"\"";"\\\"");
      let descescaped=str.replace(tool.description;"\"";"\\\"");
      let entryp1=str.concat("{\"name\":\"";nameescaped);
      let entryp2=str.concat(entryp1;"\",\"description\":\"");
      let entryp3=str.concat(entryp2;descescaped);
      let entryp4=str.concat(entryp3;"\",\"inputSchema\":");
      let entry=str.concat(entryp4;str.concat(tool.inputschema;"}"));
      if(i==0){
        items=entry
      }el{
        items=str.concat(items;str.concat(",";entry))
      };
      i=i+1
    }
  }
};

f=initresponse(servername:str;version:str):str{
  let nameescaped=str.replace(servername;"\"";"\\\"");
  let verescaped=str.replace(version;"\"";"\\\"");
  let p1=str.concat("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"";nameescaped);
  let p2=str.concat(p1;"\",\"version\":\"");
  let p3=str.concat(p2;verescaped);
  <str.concat(p3;"\"}}")
};

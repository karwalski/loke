m=core.mcp.client;



i=t:shared.types;
i=proto:core.mcp.protocol;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;



t=$mcpclient{
  serverurl:str;
  servername:str;
  nextid:u32
};



f=new(serverurl:str;servername:str):$mcpclient{
  <$mcpclient{
    serverurl:serverurl;
    servername:servername;
    nextid:1
  };
};





f=sendrequest(client:mut $mcpclient;method:str;paramsjson:str):str|$lokeerr{
  let cid=log.newcorrelationid();
  let id=client.nextid;
  client.nextid=client.nextid+1;
  let idstr=str.fromint(id);
  let url=str.concat(client.serverurl;"/mcp");

  
  let bodyp1=str.concat("{\"jsonrpc\":\"2.0\",\"id\":";idstr);
  let bodyp2=str.concat(bodyp1;",\"method\":\"");
  let bodyp3=str.concat(bodyp2;method);
  let bodyp4=str.concat(bodyp3;"\",\"params\":");
  let body=str.concat(bodyp4;str.concat(paramsjson;"}"));

  log.debug(str.concat("mcp send: ";method);"mcp-client";cid);

  let resp=http.post(url;body;"application/json");
  mt resp {
    $httperr e;
      <$lokeerr.$networkerr(str.concat("mcp send_request: HTTP error calling ";url))
    raw;
      let parsed=json.dec(raw);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$networkerr("mcp send_request: invalid JSON response")
        obj;
          
          let iserror=json.haskey(obj;"error");
          if(iserror){
            let errobj=json.getval(obj;"error");
            let errmsg=json.getstr(errobj;"message");
            <$lokeerr.$networkerr(str.concat("mcp server error: ";errmsg))
          }else{
            let resultval=json.getval(obj;"result");
            <json.enc(resultval)
          };
      };
  };
};





f=initialize(client:mut $mcpclient):bool|$lokeerr{
  let cid=log.newcorrelationid();
  let params="{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"loke\",\"version\":\"0.1.0\"}}";
  let result=sendrequest(client;"initialize";params);
  mt result {
    $lokeerr e;
      <$lokeerr(e)
    raw;
      let parsed=json.dec(raw);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$networkerr("initialize: could not parse response")
        obj;
          let protover=json.getstr(obj;"protocolVersion");
          let ok=str.eq(protover;"2024-11-05");
          if(ok){
            log.info(str.concat("MCP initialized with server: ";client.servername);"mcp-client";cid)
          }else{
            log.warn(str.concat("MCP protocol version mismatch: ";protover);"mcp-client";cid)
          };
          <ok
      };
  };
};




f=listtools(client:mut $mcpclient):@($proto.mcptool)|$lokeerr{
  let result=sendrequest(client;"tools/list";"null");
  mt result {
    $lokeerr e;
      <$lokeerr(e)
    raw;
      let parsed=json.dec(raw);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$networkerr("list_tools: could not parse response")
        obj;
          let toolsarr=json.getarr(obj;"tools");
          let tools=@();
          mt toolsarr {
            item;
              let name=json.getstr(item;"name");
              let desc=json.getstr(item;"description");
              let schemaval=json.getval(item;"inputSchema");
              let schema=json.enc(schemaval);
              let tool=$proto.mcptool{
                name:name;
                description:desc;
                inputschema:schema
              };
              tools=@(tools;tool)
          };
          <tools
      };
  };
};




f=calltool(client:mut $mcpclient;toolname:str;argsjson:str):$proto.toolresult|$lokeerr{
  let cid=log.newcorrelationid();
  let nameescaped=str.replace(toolname;"\"";"\\"");
  let params=str.concat("{\"name\":\"";str.concat(nameescaped;str.concat("\",\"arguments\":";str.concat(argsjson;"}"))));
  let result=sendrequest(client;"tools/call";params);
  mt result {
    $lokeerr e;
      <$lokeerr(e)
    raw;
      let parsed=json.dec(raw);
      mt parsed {
        $jsonerr e;
          <$lokeerr.$networkerr("call_tool: could not parse response")
        obj;
          
          let iserr=json.haskey(obj;"isError");
          let contentarr=json.getarr(obj;"content");
          let text="";
          mt contentarr {
            item;
              let itemtext=json.getstr(item;"text");
              if(str.eq(text;"")){
                text=itemtext
              }else{
                text=str.concat(text;str.concat("
";itemtext))
              };
          };
          log.debug(str.concat("call_tool result for: ";toolname);"mcp-client";cid);
          <$proto.toolresult{
            contenttype:"text";
            text:text;
            iserror:iserr
          };
      };
  };
};

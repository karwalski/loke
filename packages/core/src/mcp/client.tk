m=core.mcp.client;

i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=t:shared.types;
i=proto:core.mcp.protocol;
i=reach:shared.reachability;
i=jx:shared.jsonobj;

t=$mcpclient{
  serverurl:str;
  servername:str;
  nextid:u32
};

f=new(serverurl:str;servername:str):$mcpclient{
  <$mcpclient{
    serverurl:serverurl;
    servername:servername;
    nextid:1
  }
};

(* F10.39: `obj` was declared i64 and read with the untyped json.haskey/getval, and the
   error object's text was handed to json.str as if it were a document; toke 3.1.0 rejects
   that (E4031). The typed shared.jsonobj readers do the same job. The result is answered
   as its raw JSON text: it was passed through json.enc, which quoted it as a JSON string. *)
f=extractresultorerr(obj:$json):str!$lokeerr{
  if(str.len(jx.rawvalue(obj;"error"))>0){
    <$networkerr(str.concat("mcp server error: ";jx.nestedstr(obj;"error";"message";"")))
  }el{
    <jx.rawvalue(obj;"result")
  }
};

f=parsesendresponse(raw:str):str!$lokeerr{
  <mt json.dec(raw) {
    $ok:obj extractresultorerr(obj);
    $jsonerr:e $networkerr("mcp send_request: invalid JSON response")
  }
};

(* VM1.6f. The request went through `http.postheaders(http.client(url);"/mcp";...)`. The
   runtime reads postheaders' first argument as a URL string, so the client handle's bytes
   were the URL and nothing was ever sent (T-48). sendraw posts through reach.localpost,
   which arrives, and answers the response text, or "" when there is none.

   Only to a loopback server. No client call at this toolchain is measured to send a
   header-carrying POST to another host, so an MCP server configured off-machine is refused
   here, in the open, rather than handed to a call that sends nothing.

   The id is sent as a JSON STRING. It is a random hex correlation id and was spliced in
   bare, which is not JSON (`"id":3fa9...`), so any server that parsed the request would
   have refused it. JSON-RPC 2.0 allows a string id. *)
f=requestbody(id:str;method:str;paramsjson:str):str{
  <"{\"jsonrpc\":\"2.0\",\"id\":\"\(id)\",\"method\":\"\(method)\",\"params\":\(paramsjson)}"
};

f=sendraw(client:$mcpclient;method:str;paramsjson:str):str{
  (* The id must differ per request so a response can be matched to its request.
     client.nextid==client.nextid+1 never incremented anything — toke cannot mutate
     the caller's struct — so every request reused id 1. Deriving it from the
     correlation id keeps requests distinguishable without a mutable field. LS1.1a. *)
  let cid=log.newcorrelationid();
  if(!reach.isloopbackurl(client.serverurl)){
    log.warn("mcp send: \(client.servername) is not on this machine, and no client call reaches it (T-48)";"mcp-client";cid);
    <""
  }el{};
  log.debug("mcp send: \(method)";"mcp-client";cid);
  <reach.localpost(client.serverurl;"/mcp";requestbody(cid;method;paramsjson))
};

f=sendrequest(client:$mcpclient;method:str;paramsjson:str):str!$lokeerr{
  let raw=sendraw(client;method;paramsjson);
  if(str.len(raw)==0){
    <$networkerr("mcp send_request: no answer from \(client.serverurl)")
  }el{};
  <parsesendresponse(raw)
};

f=checkinitobj(obj:$json;servername:str;cid:str):bool{
  let protover=jx.strvalue(obj;"protocolVersion";"");
  let ok=str.eq(protover;"2024-11-05");
  if(ok){
    log.info(str.concat("MCP initialized with server: ";servername);"mcp-client";cid)
  }el{
    log.warn(str.concat("MCP protocol version mismatch: ";protover);"mcp-client";cid)
  };
  <ok
};

(* Declared i64!$lokeerr, not bool!$lokeerr, and returns 1/0.

   toke cannot compile `$ok(<bool>)` in a function whose success type is bool: it
   emits `inttoptr i64 %t` on an i1 value without widening it first, and clang
   rejects the module with "'%t' defined with type 'i1' but expected 'i64'". Binding
   the bool to a local first, using a bool literal, and branching all fail the same
   way, so i64 with 1/0 is the only shape that links. Filed in
   docs/upstream/toke-issues.md as T-1. *)
f=parseinitresponse(raw:str;servername:str;cid:str):i64!$lokeerr{
  <mt json.dec(raw) {
    $ok:obj initok(checkinitobj(obj;servername;cid));
    $jsonerr:e $networkerr("initialize: could not parse response")
  }
};

f=initok(agreed:bool):i64!$lokeerr{
  if(agreed){
    <$ok(1)
  }el{
    <$ok(0)
  }
};

f=initialize(client:$mcpclient):i64!$lokeerr{
  let cid=log.newcorrelationid();
  let result=sendrequest(client;"initialize";"{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"loke\",\"version\":\"0.1.0\"}}");
  <mt result {
    $ok:raw parseinitresponse(raw;client.servername;cid);
    $lokeerr:e $lokeerr(e)
  }
};

f=parsetoolsobj(obj:i64):@$mcptool{
  let toolsarr=json.getarr(obj;"tools");
  let tools=mut.@($mcptool);
  lp(let i=0;i<str.arraylen(toolsarr);i=i+1){ let item=toolsarr.get(i);
    let name=json.str(item;"name");
    let desc=json.str(item;"description");
    (* MK6.15: json.getval answers the value's raw JSON text at toke 3.1.0, and this
       passed it through json.enc, which quoted it: measured against a recorder, a tool
       whose inputSchema was {"type":"object"} was listed with that text as a JSON STRING.
       The raw text is the schema. *)
    let schema=json.getval(item;"inputSchema");
    let tool=$mcptool{
      name:name;
      description:desc;
      inputschema:schema
    };
    tools=tools.push(tool)
  };
  <tools
};

f=parsetoolsresponse(raw:str):@$mcptool!$lokeerr{
  <mt json.dec(raw) {
    $ok:obj $ok(parsetoolsobj(obj));
    $jsonerr:e $networkerr("list_tools: could not parse response")
  }
};

f=listtools(client:$mcpclient):@$mcptool!$lokeerr{
  <mt sendrequest(client;"tools/list";"null") {
    $ok:raw parsetoolsresponse(raw);
    $lokeerr:e $lokeerr(e)
  }
};

f=parsecalltoolobj(obj:i64;toolname:str;cid:str):$toolresult{
  let iserr=json.haskey(obj;"isError");
  let contentarr=json.getarr(obj;"content");
  let text=mut."";
  lp(let ii132=0;ii132<contentarr.len;ii132=ii132+1){
    let itemtext=json.str(contentarr.get(ii132);"text");
    if(str.eq(text;"")){
      text=itemtext
    }el{
      text="\(text)\n\(itemtext)"
    };

  };
  log.debug(str.concat("call_tool result for: ";toolname);"mcp-client";cid);
  <$toolresult{
    contenttype:"text";
    text:text;
    iserror:iserr
  }
};

f=parsecalltoolresponse(raw:str;toolname:str;cid:str):$toolresult!$lokeerr{
  <mt json.dec(raw) {
    $ok:obj $ok(parsecalltoolobj(obj;toolname;cid));
    $jsonerr:e $networkerr("call_tool: could not parse response")
  }
};

f=calltool(client:$mcpclient;toolname:str;argsjson:str):$toolresult!$lokeerr{
  let cid=log.newcorrelationid();
  let nameescaped=str.replace(toolname;"\"";"\\\"");
  let params="{\"name\":\"\(nameescaped)\",\"arguments\":\(argsjson)}";
  <mt sendrequest(client;"tools/call";params) {
    $ok:raw parsecalltoolresponse(raw;toolname;cid);
    $lokeerr:e $lokeerr(e)
  }
};

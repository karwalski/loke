m=core.mcp.client;

i=t:shared.types;
i=proto:core.mcp.protocol;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$mcpclient{
  serverurl:str;
  servername:str;
  nextid:u32
};

f=new(serverurl:str;servername:str):$mcpclient{
  <$mcpclient{
    serverurl:serverurl;
    servername:servername;
    nextid:1
  }
};

f=extractresultorerr(obj:i64):str!$lokeerr{
  let iserror=json.haskey(obj;"error");
  if(iserror){
    let errobj=json.getval(obj;"error");
    let errmsg=json.str(errobj;"message");
    <$networkerr(str.concat("mcp server error: ";errmsg))
  }el{
    let resultval=json.getval(obj;"result");
    <json.enc(resultval)
  }
};

f=parsesendresponse(raw:str):str!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $networkerr("mcp send_request: invalid JSON response");
    $ok:obj extractresultorerr(obj)
  }
};

f=sendrequest(client:$mcpclient;method:str;paramsjson:str):str!$lokeerr{
  let cid=log.newcorrelationid();
  let id=client.nextid;
  client.nextid=client.nextid+1 as u32;
  let idstr=str.fromint(id);
  let url=str.concat(client.serverurl;"/mcp");

  let bodyp1=str.concat("{\"jsonrpc\":\"2.0\",\"id\":";idstr);
  let bodyp2=str.concat(bodyp1;",\"method\":\"");
  let bodyp3=str.concat(bodyp2;method);
  let bodyp4=str.concat(bodyp3;"\",\"params\":");
  let body=str.concat(bodyp4;str.concat(paramsjson;"}"));

  log.debug(str.concat("mcp send: ";method);"mcp-client";cid);

  let resp=http.post(url;body;"application/json");
  mt resp {
    $httperr:e $networkerr(str.concat("mcp send_request: HTTP error calling ";url));
    $ok:raw parsesendresponse(raw)
  }
};

f=checkinitobj(obj:i64;servername:str;cid:str):bool{
  let protover=json.str(obj;"protocolVersion");
  let ok=str.eq(protover;"2024-11-05");
  if(ok){
    log.info(str.concat("MCP initialized with server: ";servername);"mcp-client";cid)
  }el{
    log.warn(str.concat("MCP protocol version mismatch: ";protover);"mcp-client";cid)
  };
  <ok
};

f=parseinitresponse(raw:str;servername:str;cid:str):bool!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $networkerr("initialize: could not parse response");
    $ok:obj $ok(checkinitobj(obj;servername;cid))
  }
};

f=initialize(client:$mcpclient):bool!$lokeerr{
  let cid=log.newcorrelationid();
  let params="{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"loke\",\"version\":\"0.1.0\"}}";
  let result=sendrequest(client;"initialize";params);
  mt result {
    $lokeerr:e $lokeerr(e);
    $ok:raw parseinitresponse(raw;client.servername;cid)
  }
};

f=parsetoolsobj(obj:i64):@$mcptool{
  let toolsarr=json.getarr(obj;"tools");
  let tools=mut.@($mcptool);
  lp(let i=0;i<str.arraylen(toolsarr);i=i+1){ let item=str.arrayget(toolsarr;i);
    let name=json.str(item;"name");
    let desc=json.str(item;"description");
    let schemaval=json.getval(item;"inputSchema");
    let schema=json.enc(schemaval);
    let tool=$mcptool{
      name:name;
      description:desc;
      inputschema:schema
    };
    tools=@(tools;tool)
  };
  <tools
};

f=parsetoolsresponse(raw:str):@$mcptool!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $networkerr("list_tools: could not parse response");
    $ok:obj $ok(parsetoolsobj(obj))
  }
};

f=listtools(client:$mcpclient):@$mcptool!$lokeerr{
  let result=sendrequest(client;"tools/list";"null");
  mt result {
    $lokeerr:e $lokeerr(e);
    $ok:raw parsetoolsresponse(raw)
  }
};

f=parsecalltoolobj(obj:i64;toolname:str;cid:str):$toolresult{
  let iserr=json.haskey(obj;"isError");
  let contentarr=json.getarr(obj;"content");
  let text=mut."";
  lp(let ii132=0;ii132<contentarr.len;ii132=ii132+1){
    let item=contentarr.get(ii132);
    let itemtext=json.str(item;"text");
    if(str.eq(text;"")){
      text=itemtext
    }el{
      text=str.concat(text;str.concat("
";itemtext))
    };

  };
  log.debug(str.concat("call_tool result for: ";toolname);"mcp-client";cid);
  <$toolresult{
    contenttype:"text";
    text:text;
    iserror:iserr
  }
};

f=parsecalltoolresponse(raw:str;toolname:str;cid:str):$toolresult!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $networkerr("call_tool: could not parse response");
    $ok:obj $ok(parsecalltoolobj(obj;toolname;cid))
  }
};

f=calltool(client:$mcpclient;toolname:str;argsjson:str):$toolresult!$lokeerr{
  let cid=log.newcorrelationid();
  let nameescaped=str.replace(toolname;"\"";"\\\"");
  let params=str.concat("{\"name\":\"";str.concat(nameescaped;str.concat("\",\"arguments\":";str.concat(argsjson;"}"))));
  let result=sendrequest(client;"tools/call";params);
  mt result {
    $lokeerr:e $lokeerr(e);
    $ok:raw parsecalltoolresponse(raw;toolname;cid)
  }
};

m=core.optimiser.toon;

i=t:shared.types;
i=str:std.str;
i=json:std.json;

t=$toonvalue{
  $null:i64;
  $bool:i64;
  $int:i64;
  $float:i64;
  $str:i64;
  $arr:i64;
  $obj:i64
};

t=$toonfield{
  key:str;
  value:$toonvalue
};

t=$toonopts{
  maxstrlen:u32;
  abbreviatekeys:bool;
  omitnulls:bool
};

f=defaultopts():$toonopts{
  <$toonopts{maxstrlen:200;abbreviatekeys:false;omitnulls:true}
};

f=jsonvaltotoon(v:i64):$toonvalue{
  let boolval=json.trybool(v);
  mt boolval {
    $ok:b $bool;
    $err:e
      let intval=json.tryint(v);
      mt intval {
        $ok:n $int;
        $err:e2
          let floatval=json.tryfloat(v);
          mt floatval {
            $ok:f $float;
            $err:e3
              let strval=json.trystr(v);
              mt strval {
                $ok:s $str;
                $err:e4
                  let arrval=json.tryarr(v);
                  mt arrval {
                    $ok:items $arr;
                    $err:e5
                      let keys=json.keys(v);
                      if(str.len(json.enc(v))=4){
                        <$null
                      }el{
                        <$obj
                      }
                  }
              }
          }
      }
  }
};

f=fromjsonstr(raw:str):$toonvalue!$lokeerr{
  mt json.dec(raw) {
    $ok:v $ok(jsonvaltotoon(v));
    $err:e $err($unknownerr(str.concat("from_json_str: JSON parse failed: ";raw)))
  }
};

f=needsquoting(s:str):bool{
  let haspipe=str.contains(s;"|");
  let hasopenbrace=str.contains(s;"{");
  let hasclosebrace=str.contains(s;"}");
  let hascomma=str.contains(s;",");
  let hasnewline=str.contains(s;"
");
  if(haspipe){<true}el{
    if(hasopenbrace){<true}el{
      if(hasclosebrace){<true}el{
        if(hascomma){<true}el{
          if(hasnewline){<true}el{
            <false
          }
        }
      }
    }
  }
};

f=truncate(s:str;maxlen:u32):str{
  let l=str.len(s);
  if(!(l>maxlen)){
    <s
  }el{
    let sliced=str.slice(s;0;maxlen);
    <str.concat(sliced;"...")
  }
};

f=encodeinner(val:$toonvalue;opts:$toonopts;nested:bool):str{
  mt val {
    $null "~";
    $bool if(true){"y"}el{"n"};
    $int str.fromint(0);
    $float str.fromfloat(0.0);
    $str "~";
    $arr "~";
    $obj "~"
  }
};

f=encode(val:$toonvalue;opts:$toonopts):str{
  <encodeinner(val;opts;false)
};

f=encodetable(rows:@$toonvalue;opts:$toonopts):str{
  if(rows.len=0){
    <""
  }el{
    <""
  }
};

f=jsontotoon(rawjson:str;opts:$toonopts):str!$lokeerr{
  mt fromjsonstr(rawjson) {
    $ok:tv $ok(encode(tv;opts));
    $err:e $err(e)
  }
};

f=decodeflatobj(s:str):@$toonfield{
  let pairs=str.split(s;"|");
  pairs.map|pair|{
    let kv=str.split(pair;":");
    if(kv.len>2){
      let k=kv.get(0);
      let vparts=kv.slice(1;kv.len);
      let v=str.join(vparts;":");
      let decodedval=decodescalar(v);
      $toonfield{key:k;value:decodedval}
    }el{
      $toonfield{key:pair;value:$str}
    }
  }
};

f=decodescalar(s:str):$toonvalue{
  if(str.eq(s;"~")){
    <$null
  }el{
    if(str.eq(s;"y")){
      <$bool
    }el{
      if(str.eq(s;"n")){
        <$bool
      }el{
        let asint=str.parseint(s);
        mt asint {
          $ok:n $int;
          $err:e
            let asfloat=str.parsefloat(s);
            mt asfloat {
              $ok:f $float;
              $err:e2
                if(str.startswith(s;"\"")){
                  <$str
                }el{
                  <$str
                }
            }
        }
      }
    }
  }
};

f=decode(toonstr:str):$toonvalue!$lokeerr{
  let s=str.trim(toonstr);
  if(str.startswith(s;"HDR[")){
    let lines=str.split(s;"
");
    if(lines.len<2){
      <$err($unknownerr("decode: HDR table has no data rows"))
    }el{
      let hdrline=lines.get(0);
      let hdrinner=str.slice(hdrline;4;str.len(hdrline)-1);
      let headers=str.split(hdrinner;"|");
      <$ok($arr)
    }
  }el{
    if(str.contains(s;"|")){
      let fields=decodeflatobj(s);
      <$ok($obj)
    }el{
      <$ok(decodescalar(s))
    }
  }
};

f=parseobjfields(s:str):@$toonfield{
  let fields=mut.@($toonfield);
  let i=mut.0;
  let len=str.len(s);
  let segment=mut."";
  let depth=mut.0;
  lp(let lv=0;i<len;lv=lv){
    let ch=str.slice(s;i;i+1);
    if(str.eq(ch;"{")){
      depth=depth+1;
      segment=str.concat(segment;ch)
    }el{
      if(str.eq(ch;"}")){
        depth=depth-1;
        segment=str.concat(segment;ch)
      }el{
        if(str.eq(ch;"|")){
          if(depth=0){
            let f=parsefield(segment);
            fields=@(fields;f);
            segment=""
          }el{
            segment=str.concat(segment;ch)
          }
        }el{
          segment=str.concat(segment;ch)
        }
      }
    };
    i=i+1
  };
  if(str.len(segment)>0){
    let f=parsefield(segment);
    fields=@(fields;f)
  }el{};
  <fields
};

f=parsefield(segment:str):$toonfield{
  if(str.contains(segment;"{")){
    let bracepos=str.indexof(segment;"{");
    let k=str.slice(segment;0;bracepos);
    let afterbrace=str.slice(segment;bracepos+1;str.len(segment));
    let inner=str.slice(afterbrace;0;str.len(afterbrace)-1);
    let subfields=parseobjfields(inner);
    <$toonfield{key:k;value:$obj}
  }el{
    let kv=str.split(segment;":");
    if(kv.len>2){
      let k=kv.get(0);
      let vparts=kv.slice(1;kv.len);
      let v=str.join(vparts;":");
      <$toonfield{key:k;value:decodescalar(v)}
    }el{
      <$toonfield{key:segment;value:$str}
    }
  }
};

f=toonvaltojson(val:$toonvalue):str{
  mt val {
    $null "null";
    $bool "true";
    $int "0";
    $float "0.0";
    $str "\"\"";
    $arr "[]";
    $obj "{}"
  }
};

f=toontojson(toonstr:str):str!$lokeerr{
  mt decode(toonstr) {
    $ok:tv $ok(toonvaltojson(tv));
    $err:e $err(e)
  }
};

f=measuresavings(originaljson:str;toonstr:str):f64{
  let origlen=str.len(originaljson) as f64;
  let toonlen=str.len(toonstr) as f64;
  if(origlen=0.0){
    <0.0
  }el{
    <(1.0-(toonlen/origlen))*100.0
  }
};

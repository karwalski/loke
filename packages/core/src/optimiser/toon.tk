m=core.optimiser.toon;




i=t:shared.types;
i=str:std.str;
i=json:std.json;



t=$toonvalue{
  $null:i64;
  $bool(bool);
  $int(i64);
  $float(f64);
  $str(str);
  $arr(@($toonvalue));
  $obj(@($toonfield))
};

t=$toonfield{
  key:str;
  value:$toonvalue
};

t=$toonopts{
  maxstrlen:u32;
  abbreviatekeys:bool;
  omitnulls:bool
};



f=defaultopts():$toonopts{
  <$toonopts{maxstrlen:200;abbreviatekeys:false;omitnulls:true};
};




f=jsonvaltotoon(v:any):$toonvalue{
  
  let asbool=json.getbool(v;"__scalar__");
  
  
  
  let boolval=json.trybool(v);
  mt boolval {
    $ok:b <$toonvalue.$bool(b);
    $err: {
      let intval=json.tryint(v);
      mt intval {
        $ok:n <$toonvalue.$int(n);
        $err: {
          let floatval=json.tryfloat(v);
          mt floatval {
            $ok:f <$toonvalue.$float(f);
            $err: {
              let strval=json.trystr(v);
              mt strval {
                $ok:s <$toonvalue.$str(s);
                $err: {
                  let arrval=json.tryarr(v);
                  mt arrval {
                    $ok:items {
                      let toonitems=items.map|item{
                        jsonvaltotoon(item)
                      };
                      <$toonvalue.$arr(toonitems)
                    };
                    $err: {
                      let keys=json.keys(v);
                      let fields=keys.map|k{
                        let child=json.getval(v;k);
                        $toonfield{key:k;value:jsonvaltotoon(child)};
                      };
                      if(str.len(json.enc(v))=4){
                        
                        <$toonvalue.$null
                      }el{
                        <$toonvalue.$obj(fields)
                      };
                    };
                  };
                };
              };
            };
          };
        };
      };
    };
  };
};


f=fromjsonstr(raw:str):$toonvalue|$lokeerr{
  mt json.dec(raw) {
    $ok:v <$ok(jsonvaltotoon(v));
    $err:e <$err($lokeerr.$unknownerr(str.concat("from_json_str: JSON parse failed: ";raw)))
  };
};





f=needsquoting(s:str):bool{
  let haspipe=str.contains(s;"|");
  let hasopenbrace=str.contains(s;"{");
  let hasclosebrace=str.contains(s;"}");
  let hasopensq=str.contains(s;"[");
  let hasclosesq=str.contains(s;"]");
  let hascomma=str.contains(s;",");
  let hasnewline=str.contains(s;"
");
  if(haspipe){<true}el{
    if(hasopenbrace){<true}el{
      if(hasclosebrace){<true}el{
        if(hasopensq){<true}el{
          if(hasclosesq){<true}el{
            if(hascomma){<true}el{
              if(hasnewline){<true}el{
                <false
              };
            };
          };
        };
      };
    };
  };
};


f=truncate(s:str;maxlen:u32):str{
  let l=str.len(s);
  if(l<=maxlen){
    <s
  }el{
    let sliced=str.slice(s;0;maxlen);
    <str.concat(sliced;"…")
  };
};



f=encodeinner(val:$toonvalue;opts:$toonopts;nested:bool):str{
  mt val {
    $null "~";
    $bool:b if(b){"y"}el{"n"};
    $int:n str.fromint(n);
    $float:f str.fromfloat(f);
    $str:s {
      let truncated=truncate(s;opts.maxstrlen);
      if(needsquoting(truncated)){
        let quoted=str.concat("\"";truncated);
        <str.concat(quoted;"\"")
      }el{
        <truncated
      };
    };
    $arr:items {
      let parts=items.map|item{
        encodeinner(item;opts;true)
      };
      let joined=str.join(parts;",");
      <str.concat("[";str.concat(joined;"]"))
    };
    $obj:fields {
      
      let visiblefields=fields;
      if(opts.omitnulls){
        visiblefields=fields.filter|f{
          mt f.value {
            $null:false;
            $bool: true;
            $int: true;
            $float: true;
            $str: true;
            $arr: true;
            $obj: true
          };
        };
      };
      
      let pairstrs=visiblefields.map|fld{
        let encodedval=encodeinner(fld.value;opts;true);
        
        mt fld.value {
          $obj: {
            let innerparts=mt fld.value {
              $obj:fs {
                let subpairs=fs.map|sf{
                  let sv=encodeinner(sf.value;opts;true);
                  str.concat(str.concat(sf.key;":");sv)
                };
                str.join(subpairs;"|")
              };
              $null "";
              $bool: "";
              $int: "";
              $float: "";
              $str: "";
              $arr: ""
            };
            <str.concat(str.concat(str.concat(fld.key;"{");innerparts);"}")
          };
          $null:  str.concat(str.concat(fld.key;":");"~");
          $bool: str.concat(str.concat(fld.key;":");encodedval);
          $int:  str.concat(str.concat(fld.key;":");encodedval);
          $float: str.concat(str.concat(fld.key;":");encodedval);
          $str:  str.concat(str.concat(fld.key;":");encodedval);
          $arr:  str.concat(str.concat(fld.key;":");encodedval)
        };
      };
      let joined=str.join(pairstrs;"|");
      if(nested){
        <joined
      }el{
        <joined
      };
    };
  };
};


f=encode(val:$toonvalue;opts:$toonopts):str{
  <encodeinner(val;opts;false)
};







f=encodetable(rows:@$toonvalue;opts:$toonopts):str{
  if(rows.len=0){
    <""
  }el{
    
    let headers=mt rows.get(0) {
      $obj:fields fields.map|f{f.key};
      $null @();
      $bool: @();
      $int: @();
      $float: @();
      $str: @();
      $arr: @()
    };
    let hdrinner=str.join(headers;"|");
    let hdrline=str.concat("HDR[";str.concat(hdrinner;"]"));
    
    let datalines=rows.map|row{
      let cols=headers.map|h{
        mt row {
          $obj:fields {
            let matching=fields.filter|f{str.eq(f.key;h)};
            if(matching.len=0){
              "~"
            }el{
              encodeinner(matching.get(0).value;opts;true)
            };
          };
          $null "~";
          $bool: "~";
          $int: "~";
          $float: "~";
          $str: "~";
          $arr: "~"
        };
      };
      str.join(cols;"|")
    };
    let body=str.join(datalines;"
");
    <str.concat(str.concat(hdrline;"
");body)
  };
};



f=jsontotoon(rawjson:str;opts:$toonopts):str|$lokeerr{
  mt fromjsonstr(rawjson) {
    $ok:tv <$ok(encode(tv;opts));
    $err:e <$err(e)
  };
};




f=decodeflatobj(s:str):@$toonfield{
  let pairs=str.split(s;"|");
  pairs.map|pair{
    let kv=str.split(pair;":");
    if(kv.len>2){
      let k=kv.get(0);
      
      let vparts=kv.slice(1;kv.len);
      let v=str.join(vparts;":");
      let decodedval=decodescalar(v);
      $toonfield{key:k;value:decodedval};
    }el{
      $toonfield{key:pair;value:i64$str(pair)};
    };
  };
};


f=decodescalar(s:str):$toonvalue{
  if(str.eq(s;"~")){
    <$toonvalue.$null
  }el{
    if(str.eq(s;"y")){
      <$toonvalue.$bool(true)
    }el{
      if(str.eq(s;"n")){
        <$toonvalue.$bool(false)
      }el{
        
        let asint=str.parseint(s);
        mt asint {
          $ok:n <$toonvalue.$int(n);
          $err: {
            
            let asfloat=str.parsefloat(s);
            mt asfloat {
              $ok:f <$toonvalue.$float(f);
              $err: {
                
                if(str.startswith(s;"\"")){
                  let inner=str.slice(s;1;str.len(s)-1);
                  <$toonvalue.$str(inner)
                }el{
                  <$toonvalue.$str(s)
                };
              };
            };
          };
        };
      };
    };
  };
};






f=decode(toonstr:str):$toonvalue|$lokeerr{
  let s=str.trim(toonstr);
  
  if(str.startswith(s;"HDR[")){
    let lines=str.split(s;"
");
    if(lines.len<2){
      <$err($lokeerr.$unknownerr("decode: HDR table has no data rows"))
    }el{
      let hdrline=lines.get(0);
      
      let hdrinner=str.slice(hdrline;4;str.len(hdrline)-1);
      let headers=str.split(hdrinner;"|");
      let datalines=lines.slice(1;lines.len);
      let rowvals=datalines.map|line{
        let cols=str.split(line;"|");
        let fields=headers.map|h{
          let colidx=headers.indexof(h);
          let v=if colidx<cols.len{cols.get(colidx)}el{"~"};
          $toonfield{key:h;value:decodescalar(v)};
        };
        $toonvalue.$obj(fields)
      };
      <$ok($toonvalue.$arr(rowvals))
    };
  }el{
    
    if(str.contains(s;"){"){
      
      
      let fields=parseobjfields(s);
      <$ok($toonvalue.$obj(fields))
    }el{
      
      let fields=decodeflatobj(s);
      <$ok($toonvalue.$obj(fields))
    };
  };
};


f=parseobjfields(s:str):@$toonfield{
  
  let fields=@();
  let depth=0;
  let segment="";
  let i=0;
  let len=str.len(s);
  lp(true){
    if(i>len){
      break
    }el{
      let ch=str.slice(s;i;i+1);
      if(str.eq(ch;"){"){
        depth=depth+1;
        segment=str.concat(segment;ch)
      }el{
        if(str.eq(ch;"}")){
          depth=depth-1;
          segment=str.concat(segment;ch)
        }el{
          if(str.eq(ch;"|")){
            if(depth=0){
              let f=parsefield(segment);
              fields=@(fields;f);
              segment=""
            }el{
              segment=str.concat(segment;ch)
            };
          }el{
            segment=str.concat(segment;ch)
          };
        };
      };
      i=i+1;
    };
  };
  
  if(str.len(segment)>0){
    let f=parsefield(segment);
    fields=@(fields;f)
  };
  <fields
};


f=parsefield(segment:str):$toonfield{
  
  if(str.contains(segment;"){"){
    let bracepos=str.indexof(segment;"{");
    let k=str.slice(segment;0;bracepos);
    let afterbrace=str.slice(segment;bracepos+1;str.len(segment));
    
    let inner=str.slice(afterbrace;0;str.len(afterbrace)-1);
    let subfields=parseobjfields(inner);
    <$toonfield{key:k;value:i64$obj(subfields)};
  }el{
    let kv=str.split(segment;":");
    if(kv.len>2){
      let k=kv.get(0);
      let vparts=kv.slice(1;kv.len);
      let v=str.join(vparts;":");
      <$toonfield{key:k;value:decodescalar(v)};
    }el{
      <$toonfield{key:segment;value:i64$str(segment)};
    };
  };
};




f=toonvaltojson(val:$toonvalue):str{
  mt val {
    $null "null";
    $bool:b if(b){"true"}el{"false"};
    $int:n str.fromint(n);
    $float:f str.fromfloat(f);
    $str:s {
      let escaped=str.replace(s;"\"";"\\"");
      <str.concat("\"";str.concat(escaped;"\""))
    };
    $arr:items {
      let parts=items.map|item{toonvaltojson(item)};
      let joined=str.join(parts;",");
      <str.concat("[";str.concat(joined;"]"))
    };
    $obj:fields {
      let parts=fields.map|fld{
        let keyjson=str.concat("\"";str.concat(fld.key;"\""));
        let valjson=toonvaltojson(fld.value);
        str.concat(str.concat(keyjson;":");valjson)
      };
      let joined=str.join(parts;",");
      <str.concat("{";str.concat(joined;"}"))
    };
  };
};


f=toontojson(toonstr:str):str|$lokeerr{
  mt decode(toonstr) {
    $ok:tv <$ok(toonvaltojson(tv));
    $err:e <$err(e)
  };
};





f=measuresavings(originaljson:str;toonstr:str):f64{
  let origlen=str.len(originaljson) as f64;
  let toonlen=str.len(toonstr) as f64;
  if(origlen=0.0){
    <0.0
  }el{
    <(1.0-(toonlen/origlen))*100.0
  };
};

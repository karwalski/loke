m=core.optimiser.toon;

i=str:std.str;
i=json:std.json;
i=tt:core.optimiser.toontypes;

(* LS1.1x: what fromjsonstr and decode answer; see isparsed. *)
t=$toonparsed{
  tvalue:$toonvalue;
  failure:str
};

f=defaultopts():$toonopts{
  <$toonopts{maxstrlen:200;abbreviatekeys:false;omitnulls:true}
};

(* The old shape was a six-deep cascade: json.trybool, then tryint, then tryfloat,
   then trystr, then tryarr, each catching the previous one's $err to mean "not that
   type". std.json is entirely KEYED now — json.str(Json, key) — so there is no
   value-level type test left to cascade over.

   Json is {raw: str}, so the type is readable directly from the first character of
   the raw text. That is one pass instead of six attempted parses, and it detects
   null properly rather than by the old trick of checking json.enc(v) is 4 bytes
   long. *)
f=jsonvaltotoon(v:$json):$toonvalue{
  let raw=str.trimws(v.raw);
  if(str.len(raw)==0){
    <$toonvalue{$tvnull:0}
  }el{
    let c=str.slice(raw;0;1);
    if(str.eq(c;"{")){
      <$toonvalue{$tvobj:0}
    }el{
      if(str.eq(c;"[")){
        <$toonvalue{$tvarr:0}
      }el{
        if(str.eq(c;"\"")){
          <$toonvalue{$tvstr:0}
        }el{
          if(str.eq(raw;"true")){
            <$toonvalue{$tvbool:0}
          }el{
            if(str.eq(raw;"false")){
              <$toonvalue{$tvbool:0}
            }el{
              if(str.eq(raw;"null")){
                <$toonvalue{$tvnull:0}
              }el{
                if(str.contains(raw;".")){
                  <$toonvalue{$tvfloat:0}
                }el{
                  <$toonvalue{$tvint:0}
                }
              }
            }
          }
        }
      }
    }
  }
};


(* LS1.1x — the optimiser's entry points answer plain values with a predicate, as LS1.1j's
   chokepoints do. They returned `X!$lokeerr`, and a caller's match on that takes the FIRST
   arm whatever the value is (T-18): a failed conversion read as a successful one.

   $toonparsed (declared at the top of this file) carries a value, or a non-empty `failure`
   and a null value that is not to be used; isparsed tells them apart. *)
f=parsed(v:$toonvalue):$toonparsed{
  <$toonparsed{tvalue:v;failure:""}
};

f=notparsed(reason:str):$toonparsed{
  <$toonparsed{tvalue:$toonvalue{$tvnull:0};failure:reason}
};

f=isparsed(p:$toonparsed):bool{
  <str.len(p.failure)==0
};

(* The failure no longer quotes the input: it was the caller's JSON, which may hold anything.
   Blank input is refused before json.dec, which does not reliably refuse what is not JSON
   (T-51); json.dec's own verdict is taken for the rest. *)
f=fromjsonstr(raw:str):$toonparsed{
  if(str.len(str.trimws(raw))==0){ <notparsed("from_json_str: empty input") }el{};
  <mt json.dec(raw) {
    $ok:v parsed(jsonvaltotoon(v));
    $jsonerr:e notparsed("from_json_str: JSON parse failed")
  }
};

f=needsquoting(s:str):bool{
  let haspipe=str.contains(s;"|");
  let hasopenbrace=str.contains(s;"{");
  let hasclosebrace=str.contains(s;"}");
  let hascomma=str.contains(s;",");
  let hasnewline=str.contains(s;"
");
  if(haspipe){<true}el{
    if(hasopenbrace){<true}el{
      if(hasclosebrace){<true}el{
        if(hascomma){<true}el{
          if(hasnewline){<true}el{
            <false
          }
        }
      }
    }
  }
};

f=truncate(s:str;maxlen:i64):str{
  let l=str.len(s);
  if(!(l>maxlen)){
    <s
  }el{
    let sliced=str.slice(s;0;maxlen);
    <str.concat(sliced;"...")
  }
};

f=encodebool(v:bool):str{
  let r=mut."n";
  if(v){r="y"}el{};
  <r
};

(* GA1.5 — READ THIS BEFORE WIRING toon.encode INTO ANYTHING.

   This is not a codec. It is a type-tag classifier, and it cannot be made into a codec
   without changing $toonvalue.

   core.optimiser.toontypes declares every variant of $toonvalue with an i64 payload —
   $tvstr:i64, $tvarr:i64, $tvobj:i64 — so a $toonvalue records WHICH KIND of value it saw
   and nothing about the value itself. That is why the arms below return "~" for a string, an
   array and an object, and str.fromint(0) for every integer whatever its magnitude:
   `opts` and `nested` are accepted and unused, encodetable returns "" for every input, and
   jsontotoon returns "~" for any JSON object at all. decode is the same in reverse — it
   computes `headers`, `fields` and `subfields` and then returns a bare tag, discarding them.

   So wiring this into the request path would replace the user's prompt with a tilde. GA1.5's
   token-optimisation half is withdrawn rather than wired, for that reason.

   Making it real means giving $toonvalue payloads of mixed type — str, i64, f64, bool and a
   recursive array of itself — and a sum with MIXED payload types crashes when it is matched
   across a module boundary (the reason shared.types.$policydecision carries a str in every
   arm). The alternative, encoding straight from $json without an intermediate value type,
   needs to enumerate an object's keys, and the typed std.json API is entirely KEYED —
   json.str(Json, key) — with no key enumeration. Neither route is available today.

   tests/integration/test_toon_roundtrip.tk does not catch any of this: its round-trip
   assertion checks only that the output is non-empty, which "~" satisfies. *)
f=encodeinner(val:$toonvalue;opts:$toonopts;nested:bool):str{
  <mt val {
    $tvnull:v "~";
    $tvbool:v encodebool(v);
    $tvint:v str.fromint(0);
    $tvfloat:v str.fromfloat(0.0);
    $tvstr:v "~";
    $tvarr:v "~";
    $tvobj:v "~"
  }
};

f=encode(val:$toonvalue;opts:$toonopts):str{
  <encodeinner(val;opts;false)
};

f=encodetable(rows:@$toonvalue;opts:$toonopts):str{
  if(rows.len==0 as u64){
    <""
  }el{
    <""
  }
};

(* LS1.1x. "" when the input is not JSON; encode never answers "" for a value (its smallest
   outputs are "~", "y", "n" and "0"), so isconverted reads the sentinel. It was
   str!$lokeerr, which a caller could not see fail (T-18). *)
f=jsontotoon(rawjson:str;opts:$toonopts):str{
  let p=fromjsonstr(rawjson);
  if(!isparsed(p)){ <"" }el{};
  <encode(p.tvalue;opts)
};

f=isconverted(s:str):bool{
  <str.len(s)>0
};

f=decodeflatobj(s:str):@$toonfield{
  let pairs=str.split(s;"|");
  let result=mut.@();
  lp(let ii=0;ii<pairs.len;ii=ii+1){
    let pair=pairs.get(ii);
    let kv=str.split(pair;":");
    let field=mut.$toonfield{key:pair;value:$toonvalue{$tvstr:0}};
    if(kv.len>2){
      let k=kv.get(0);
      let vparts=kv.slice(1;kv.len);
      let v=str.join(":";vparts);
      let decodedval=decodescalar(v);
      field=$toonfield{key:k;value:decodedval}
    }el{};
    result=result.push(field)
  };
  <result
};

f=decodescalarfloatorstr(s:str):$toonvalue{
  let asfloat=str.parsefloat(s);
  <mt asfloat {
    $ok:f $toonvalue{$tvfloat:0};
    $err:e2 $toonvalue{$tvstr:0}
  }
};

f=decodescalar(s:str):$toonvalue{
  if(str.eq(s;"~")){
    <$toonvalue{$tvnull:0}
  }el{
    if(str.eq(s;"y")){
      <$toonvalue{$tvbool:0}
    }el{
      if(str.eq(s;"n")){
        <$toonvalue{$tvbool:0}
      }el{
        let asint=str.parseint(s);
        <mt asint {
          $ok:n $toonvalue{$tvint:0};
          $err:e decodescalarfloatorstr(s)
        }
      }
    }
  }
};

(* LS1.1x. decode answers a plain $toonparsed; isparsed says whether it holds a value.

   It returned $toonvalue!$lokeerr, and a caller's match took the first arm whatever the
   value was (T-18), so a table with no rows read as decoded. Its two structured arms also
   returned the BARE variants `$tvarr` and `$tvobj`, which toke accepts in a value position
   and which crash when matched (T-13); they are built as `$toonvalue{$tvarr:0}` now, as
   jsonvaltotoon builds them. What they carry is still only the kind of value (see the GA1.5
   note above encodeinner). The rows and fields the old code computed and discarded are not
   computed. *)
f=decode(toonstr:str):$toonparsed{
  let s=str.trim(toonstr);
  if(str.startswith(s;"HDR[")){
    if(str.split(s;"
").len<2){
      <notparsed("decode: HDR table has no data rows")
    }el{};
    <parsed($toonvalue{$tvarr:0})
  }el{};
  if(str.contains(s;"|")){
    <parsed($toonvalue{$tvobj:0})
  }el{};
  <parsed(decodescalar(s))
};

f=parseobjfields(s:str):@$toonfield{
  let fields=mut.@($toonfield);
  let i=mut.0;
  let len=str.len(s);
  let segment=mut."";
  let depth=mut.0;
  lp(let lv=0;i<len;lv=lv){
    let ch=str.slice(s;i;i+1);
    if(str.eq(ch;"{")){
      depth=depth+1;
      segment=str.concat(segment;ch)
    }el{
      if(str.eq(ch;"}")){
        depth=depth-1;
        segment=str.concat(segment;ch)
      }el{
        if(str.eq(ch;"|")){
          if(depth==0){
            let f=parsefield(segment);
            fields=fields.push(f);
            segment=""
          }el{
            segment=str.concat(segment;ch)
          }
        }el{
          segment=str.concat(segment;ch)
        }
      }
    };
    i=i+1
  };
  if(str.len(segment)>0){
    let f=parsefield(segment);
    fields=fields.push(f)
  }el{};
  <fields
};

f=parsefield(segment:str):$toonfield{
  if(str.contains(segment;"{")){
    let bracepos=str.indexof(segment;"{");
    let k=str.slice(segment;0;bracepos);
    let afterbrace=str.slice(segment;bracepos+1;str.len(segment));
    let inner=str.slice(afterbrace;0;str.len(afterbrace)-1);
    let subfields=parseobjfields(inner);
    <$toonfield{key:k;value:$toonvalue{$tvobj:0}}
  }el{
    let kv=str.split(segment;":");
    if(kv.len>2){
      let k=kv.get(0);
      let vparts=kv.slice(1;kv.len);
      let v=str.join(":";vparts);
      <$toonfield{key:k;value:decodescalar(v)}
    }el{
      <$toonfield{key:segment;value:$toonvalue{$tvstr:0}}
    }
  }
};

f=toonvaltojson(val:$toonvalue):str{
  <mt val {
    $tvnull:v "null";
    $tvbool:v "true";
    $tvint:v "0";
    $tvfloat:v "0.0";
    $tvstr:v "\"\"";
    $tvarr:v "[]";
    $tvobj:v "{}"
  }
};

(* LS1.1x. "" when the TOON did not decode; a decoded value always has non-empty JSON, so
   isconverted reads the sentinel. It was str!$lokeerr (T-18). *)
f=toontojson(toonstr:str):str{
  let d=decode(toonstr);
  if(!isparsed(d)){ <"" }el{};
  <toonvaltojson(d.tvalue)
};

(* A CHARACTER ratio, not a token saving, and it must never be reported as one.

   benchmarks/toon/README.md exists to correct exactly this conflation, and
   docs/metrics-baseline.md records that minified JSON alone already achieves 1.35x-1.80x —
   so a compression figure has to beat b2_json_min, not pretty-printed JSON, and this
   function compares against whatever string it was handed. It is also a bare f64 RETURN,
   which is corrupted across a module boundary (T-20): a caller in another module receives a
   different number from the one computed here. memory/aaak.tk's measuresavingsbp is the
   shape that crosses correctly, if a figure is ever genuinely wanted.

   Kept because tests/integration/test_toon_roundtrip.tk calls it. No caller in the product
   does, and none should. *)
(* ── Savings, in integer basis points, and what they actually measure ─────────────
   Two things were wrong with the f64 form below, and only one of them was the float.

   **T-20.** `measuresavings` returns a BARE f64, which is corrupted across a module
   boundary. Measured from a test in another module: 37.5 arrived as 4.94066e-323, 0 as
   3.95253e-323, -300 as 3.95253e-323. Every caller outside this module — `mcp-toke`'s
   `tools.tk:165` among them — received a denormal. `core.memory.aaak.measuresavingsbp` is
   the same fix, landed earlier; this follows it so the two agree.

   **What is measured is CHARACTERS, not tokens.** `str.len` over `str.len` is a
   character-length ratio, and TOON's claim is about token efficiency. A ratio of characters
   is not a ratio of tokens and can move the other way — a dense encoding with fewer
   characters may tokenise into more. `docs/claims.md` C1 is `stub` for exactly this reason,
   and this function is not evidence for a token-efficiency claim however precise it becomes.
   Naming it honestly in the companion rather than in the identifier, because
   `aaak.measuresavingsbp` measures the same thing and two names for one quantity is its own
   cost. VM1.7 owns whether a real token count is possible.

   The i64 casts are not decoration. `str.len` returns **u64**, so `origlen - toonlen`
   underflows when the output is LONGER than the input — the negative-saving case, which is
   the one a caller most needs to be told about. `aaak.measuresavingsbp` has that latent bug
   and is fixed in the same commit; its own tests only asserted the positive, zero and
   halving cases, so nothing caught it. *)
f=measuresavingsbp(originaljson:str;toonstr:str):i64{
  let origlen=str.len(originaljson) as i64;
  if(origlen==0){
    <0
  }el{
    let toonlen=str.len(toonstr) as i64;
    <((origlen-toonlen)*10000)/origlen
  }
};

(* Kept for callers inside this module, where the f64 return is intact. *)
f=measuresavings(originaljson:str;toonstr:str):f64{
  <(measuresavingsbp(originaljson;toonstr) as f64)/100.0
};

m=core.optimiser.budgettypes;

t=$budgetperiod{
  $daily:i64;
  $weekly:i64;
  $monthly:i64
};

t=$budgetlimit{
  period:$budgetperiod;
  maxtokens:u32;
  maxcostusd:f64;
  warnatpct:f64
};

t=$budgetusage{
  periodstart:str;
  tokensused:u32;
  costusd:f64;
  requestcount:u32
};

t=$budgetmanager{
  limits:@$budgetlimit;
  usage:@$budgetusage
};

t=$budgetcheck{
  allowed:bool;
  reason:str;
  tokensremaining:u32;
  costremaining:f64;
  pctused:f64
};

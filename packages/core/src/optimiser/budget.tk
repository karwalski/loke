m=core.optimiser.budget;




i=t:shared.types;
i=str:std.str;
i=log:shared.log;



t=$budgetperiod{
  $daily:i64;
  $weekly:i64;
  $monthly
};

t=$budgetlimit{
  period:$budgetperiod;
  maxtokens:u32;
  maxcostusd:f64;
  warnatpct:f64
};

t=$budgetusage{
  periodstart:str;
  tokensused:u32;
  costusd:f64;
  requestcount:u32
};

t=$budgetcheck{
  allowed:bool;
  reason:str;
  tokensremaining:u32;
  costremaining:f64;
  pctused:f64
};

t=$budgetmanager{
  limits:@$budgetlimit;
  usage:@$budgetusage
};





f=new(limits:@$budgetlimit):$budgetmanager{
  let usage=limits.map|lim{
    $budgetusage{
      periodstart:"";
      tokensused:0;
      costusd:0.0;
      requestcount:0
    }
  };
  <$budgetmanager{limits:limits;usage:usage}
};






f=defaultlimits():@$budgetlimit{
  <@(
    $budgetlimit{
      period:i64$daily;
      maxtokens:100000;
      maxcostusd:5.0;
      warnatpct:80.0
    };
    $budgetlimit{
      period:i64$monthly;
      maxtokens:1000000;
      maxcostusd:50.0;
      warnatpct:80.0
    }
  )
};



f=periodlabel(period:$budgetperiod):str{
  mt period {
    $daily   "daily";
    $weekly  "weekly";
    $monthly "monthly"
  }
};







f=check(manager:$budgetmanager;estimatedtokens:u32;estimatedcost:f64):$budgetcheck{
  let allowed=true;
  let reason="";
  let tokensremaining=4294967295;
  let costremaining=99999999.0;
  let pctused=0.0;
  let cid=log.newcorrelationid();

  let limitcount=manager.limits.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > limitcount){
      break
    }el{
      let lim=manager.limits.get(i);
      let usg=manager.usage.get(i);

      
      let newtokens=usg.tokensused + estimatedtokens;
      let newcost=usg.costusd + estimatedcost;

      
      let tokpct=if lim.maxtokens=0{
        0.0
      }el{
        (newtokens as f64 / lim.maxtokens as f64) * 100.0
      };

      
      let costpct=if lim.maxcostusd=0.0{
        0.0
      }el{
        (newcost / lim.maxcostusd) * 100.0
      };

      let periods=periodlabel(lim.period);

      
      if(newtokens > lim.maxtokens){
        allowed=false;
        let rems=str.fromint(0);
        let useds=str.fromint(usg.tokensused as i64);
        let maxs=str.fromint(lim.maxtokens as i64);
        reason=str.concat(periods;str.concat(" token limit exceeded: used ";str.concat(useds;str.concat("/";maxs))));
        tokensremaining=0;
        pctused=100.0
      }el{
        
        if(newcost > lim.maxcostusd){
          allowed=false;
          reason=str.concat(periods;" cost limit exceeded");
          costremaining=0.0;
          pctused=100.0
        }el{
          
          let effectivepct=if tokpct > costpct{tokpct}el{costpct};
          if(effectivepct > lim.warnatpct){
            let pcts=str.fromfloat(effectivepct);
            log.warn(
              str.concat(periods;str.concat(" budget at ";str.concat(pcts;"%")));
              "budget";
              cid
            )
          };

          
          let thistokrem=lim.maxtokens - newtokens;
          if(thistokrem < tokensremaining){
            tokensremaining=thistokrem
          };

          
          let thiscostrem=lim.maxcostusd - newcost;
          if(thiscostrem < costremaining){
            costremaining=thiscostrem
          };

          
          if(effectivepct > pctused){
            pctused=effectivepct
          }
        }
      };

      i=i+1;
    }
  };

  if(allowed){
    if(str.len(reason)=0){
      reason="within budget"
    }
  };

  <$budgetcheck{
    allowed:allowed;
    reason:reason;
    tokensremaining:tokensremaining;
    costremaining:costremaining;
    pctused:pctused
  }
};





f=record(manager:$budgetmanager;tokens:u32;cost:f64):void{
  let count=manager.usage.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      break
    }el{
      let usg=manager.usage.get(i);
      manager.usage.get(i)=$budgetusage{
        periodstart:usg.periodstart;
        tokensused:usg.tokensused + tokens;
        costusd:usg.costusd + cost;
        requestcount:usg.requestcount + 1
      };
      i=i+1;
    }
  };
  <()
};




f=resetperiod(manager:$budgetmanager;period:$budgetperiod):void{
  let count=manager.limits.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      break
    }el{
      let lim=manager.limits.get(i);
      let matches=mt lim.period {
        mt $daily:  period {$daily:true; $weekly:false; $monthly:false};
        mt $weekly: period {$daily:false; $weekly:true; $monthly:false};
        mt $monthly:period {$daily:false; $weekly:false; $monthly:true}
      };
      if(matches){
        manager.usage.get(i)=$budgetusage{
          periodstart:"";
          tokensused:0;
          costusd:0.0;
          requestcount:0
        }
      };
      i=i+1;
    }
  };
  <()
};




f=formatusage(manager:$budgetmanager):str{
  let lines=@();
  let count=manager.limits.len;
  let i=0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      break
    }el{
      let lim=manager.limits.get(i);
      let usg=manager.usage.get(i);
      let periods=periodlabel(lim.period);
      let tokpct=if lim.maxtokens=0{
        0.0
      }el{
        (usg.tokensused as f64 / lim.maxtokens as f64) * 100.0
      };
      let costpct=if lim.maxcostusd=0.0{
        0.0
      }el{
        (usg.costusd / lim.maxcostusd) * 100.0
      };
      let usedtoks=str.fromint(usg.tokensused as i64);
      let maxtoks=str.fromint(lim.maxtokens as i64);
      let tokpcts=str.fromfloat(tokpct);
      let costs=str.fromfloat(usg.costusd);
      let maxcosts=str.fromfloat(lim.maxcostusd);
      let costpcts=str.fromfloat(costpct);
      let reqs=str.fromint(usg.requestcount as i64);
      let line=str.concat(
        periods;
        str.concat(
          ": tokens ";
          str.concat(
            usedtoks;
            str.concat(
              "/";
              str.concat(
                maxtoks;
                str.concat(
                  " (";
                  str.concat(
                    tokpcts;
                    str.concat(
                      "%)  cost $";
                      str.concat(
                        costs;
                        str.concat(
                          "/$";
                          str.concat(
                            maxcosts;
                            str.concat(
                              " (";
                              str.concat(
                                costpcts;
                                str.concat(
                                  "%)  requests: ";
                                  reqs
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
      lines=@(lines;line);
      i=i+1;
    }
  };
  <str.join(lines;"
")
};

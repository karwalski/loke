m=core.optimiser.budget;




i=str:std.str;
i=log:shared.log;
i=bt:core.optimiser.budgettypes;





(* str.arraylen/str.arrayget replaced with .len/.push. str.arrayget erases the element type
   of what it returns — the same reason PL1.1 took it out of
   core.privacy.placeholder.buildplaceholdermap — and `lim` was bound and never used, which
   is the only thing that kept it harmless here. .push is also the form the rest of this
   module already uses (resetperiod), so the file no longer disagrees with itself about how
   to build an array. *)
f=new(limits:@$budgetlimit):$budgetmanager{
  let usage=mut.@();
  lp(let i=0;i<limits.len;i=i+1){
    usage=usage.push($budgetusage{
      periodstart:"";
      tokensused:0;
      costusd:0.0;
      requestcount:0
    })
  };
  <$budgetmanager{limits:limits;usage:usage}
};






f=defaultlimits():@$budgetlimit{
  <@(
    $budgetlimit{
      period:$daily(0);
      maxtokens:100000;
      maxcostusd:5.0;
      warnatpct:80.0
    };
    $budgetlimit{
      period:$monthly(0);
      maxtokens:1000000;
      maxcostusd:50.0;
      warnatpct:80.0
    }
  )
};



f=periodlabel(period:$budgetperiod):str{
  <mt period {
    $daily:v "daily";
    $weekly:v "weekly";
    $monthly:v "monthly"
  }
};







f=check(manager:$budgetmanager;estimatedtokens:u32;estimatedcost:f64):$budgetcheck{
  let allowed=mut.true;
  let reason=mut."";
  let tokensremaining=mut.4294967295;
  let costremaining=mut.99999999.0;
  let pctused=mut.0.0;
  let cid=log.newcorrelationid();

  let limitcount=manager.limits.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i >= limitcount){
      br
    }el{
      let lim=manager.limits.get(i);
      let usg=manager.usage.get(i);

      
      let newtokens=(usg.tokensused as i64 + estimatedtokens as i64) as u32;
      let newcost=usg.costusd + estimatedcost;

      
      let tokpct=mut.0.0;
      if(lim.maxtokens==0){}el{
        tokpct=(newtokens as f64 / lim.maxtokens as f64) * 100.0
      };

      
      let costpct=mut.0.0;
      if(lim.maxcostusd==0.0){}el{
        costpct=(newcost / lim.maxcostusd) * 100.0
      };

      let periods=periodlabel(lim.period);

      
      if(newtokens > lim.maxtokens){
        allowed=false;
        let rems=str.fromint(0);
        let useds=str.fromint(usg.tokensused as i64);
        let maxs=str.fromint(lim.maxtokens as i64);
        reason="\(periods) token limit exceeded: used \(useds)/\(maxs)";
        tokensremaining=0;
        pctused=100.0
      }el if(newcost > lim.maxcostusd){
        allowed=false;
        reason=str.concat(periods;" cost limit exceeded");
        costremaining=0.0;
        pctused=100.0
      }el{
        
        let effectivepct=mut.costpct;
        if(tokpct > costpct){effectivepct=tokpct}el{};
        if(effectivepct > lim.warnatpct){
          let pcts=str.fromfloat(effectivepct);
          log.warn(
            "\(periods) budget at \(pcts)%";
            "budget";
            cid
          )
        };

        
        let thistokrem=lim.maxtokens - newtokens;
        if(thistokrem < tokensremaining){
          tokensremaining=thistokrem
        };

        
        let thiscostrem=lim.maxcostusd - newcost;
        if(thiscostrem < costremaining){
          costremaining=thiscostrem
        };

        
        if(effectivepct > pctused){
          pctused=effectivepct
        }
      };

      i=i+1;
    }
  };

  if(allowed){
    if(str.len(reason)==0){
      reason="within budget"
    }
  };

  <$budgetcheck{
    allowed:allowed;
    reason:reason;
    tokensremaining:tokensremaining;
    costremaining:costremaining;
    pctused:pctused
  }
};





(* GA1.5 — record did nothing at all, and said nothing about it.

   The old body was

     manager.usage.get(i)==$budgetusage{ ... };

   which is a COMPARISON. It computed a bool and threw it away, so no usage row was ever
   updated: every request recorded against the budget left the counters at zero, and a
   budget that never accumulates never refuses. There is no assignment to a struct field or
   an array element in toke, and E2002's advice to "use `==`" produces exactly this silent
   no-op (T-26) — the identical defect was already found and fixed in resetperiod below, and
   left in place here.

   Nor could writing through .get(i) have worked. toke structs are values, so the manager has
   to be RETURNED for a caller to see the change, which is why the signature is no longer
   void. Nothing in the repository called record, so no compatibility shim is owed: the
   signature change cannot break a caller that does not exist.

   requestcount is cast to u32, not i32: $budgetusage declares it u32, and the old i32 cast
   was a narrowing the type did not ask for. *)
f=record(manager:$budgetmanager;tokens:u32;cost:f64):$budgetmanager{
  let usage=mut.@();
  lp(let i=0;i<manager.usage.len;i=i+1){
    let usg:$budgetusage=manager.usage.get(i);
    usage=usage.push($budgetusage{
      periodstart:usg.periodstart;
      tokensused:((usg.tokensused as i64 + tokens as i64) as u32);
      costusd:usg.costusd + cost;
      requestcount:((usg.requestcount as i64 + 1) as u32)
    })
  };
  <$budgetmanager{limits:manager.limits;usage:usage}
};

(* Per-ROW accessors, deliberately not a total.

   Summing across rows would be wrong: defaultlimits returns one row per PERIOD — daily and
   monthly — and both rows count the same spend. A "total" over them double-counts, so a
   caller that persisted it would inflate the recorded usage every time it round-tripped.
   The caller names the row it means. *)
f=rowtokens(manager:$budgetmanager;idx:i64):i64{
  if(idx<0){ <0 }el{};
  if(idx>=manager.usage.len){ <0 }el{};
  let usg:$budgetusage=manager.usage.get(idx);
  <usg.tokensused as i64
};

(* Cost in MILLIONTHS of a US dollar, as an exact integer, so the day's accumulated total is
   a sum of integers and does not drift. It was first chosen because an f64 RETURNED across a
   module boundary was corrupted (T-20); toke 3.1.0 fixed that (LS1.1h), and exactness is why
   it stays.

   shared.types.f64hundredths is deliberately NOT used here. It multiplies by 100, which for
   a USD amount is CENTS — and a single request to gpt-4o-mini costs a small fraction of one
   cent, so rounding to cents would record every request as zero and the accumulated total
   would never move. The unit has to be finer than the quantity being counted. *)
f=microusd(cost:f64):i64{
  if(cost<0.0){
    <((cost * 1000000.0) - 0.5) as i64
  }el{
    <((cost * 1000000.0) + 0.5) as i64
  }
};

f=rowcostmicrousd(manager:$budgetmanager;idx:i64):i64{
  if(idx<0){ <0 }el{};
  if(idx>=manager.usage.len){ <0 }el{};
  let usg:$budgetusage=manager.usage.get(idx);
  <microusd(usg.costusd)
};

(* Seeds every usage row from counters a caller persisted, so a budget survives the process
   that spent it. A budget held only in memory in a request handler is reset by every
   request, which is the same as no budget. *)
f=withusage(manager:$budgetmanager;tokens:i64;costmicrousd:i64):$budgetmanager{
  let usage=mut.@();
  lp(let i=0;i<manager.usage.len;i=i+1){
    usage=usage.push($budgetusage{
      periodstart:"";
      tokensused:tokens as u32;
      costusd:(costmicrousd as f64)/1000000.0;
      requestcount:0
    })
  };
  <$budgetmanager{limits:manager.limits;usage:usage}
};




(* resetperiod had the same four defects record had, and they were fixed here first.

   `manager.usage.get(i)==$budgetusage{...}` is a COMPARISON. It computed a bool and
   discarded it, so no usage row was ever reset. Writing through `.get(i)` could not
   have worked anyway: toke structs are values, so the manager has to be returned.
   `i > count` also ran one iteration past the end, and the period comparison was an
   inline three-arm match in a loop, which toke miscompiles (T-2).

   It returns the updated manager now, so a caller can actually see the reset. *)
f=periodeq(a:$budgetperiod;b:$budgetperiod):bool{
  <mt a {
    $daily:v isdaily(b);
    $weekly:v isweekly(b);
    $monthly:v ismonthly(b)
  }
};

f=isdaily(p:$budgetperiod):bool{
  <mt p { $daily:v true; $weekly:v false; $monthly:v false }
};

f=isweekly(p:$budgetperiod):bool{
  <mt p { $daily:v false; $weekly:v true; $monthly:v false }
};

f=ismonthly(p:$budgetperiod):bool{
  <mt p { $daily:v false; $weekly:v false; $monthly:v true }
};

f=resetperiod(manager:$budgetmanager;period:$budgetperiod):$budgetmanager{
  let usage=mut.@();
  lp(let i=0;i<manager.limits.len;i=i+1){
    let lim:$budgetlimit=manager.limits.get(i);
    if(periodeq(lim.period;period)){
      usage=usage.push($budgetusage{
        periodstart:"";
        tokensused:0;
        costusd:0.0;
        requestcount:0
      })
    }el{
      usage=usage.push(manager.usage.get(i))
    }
  };
  <$budgetmanager{limits:manager.limits;usage:usage}
};




f=formatusage(manager:$budgetmanager):str{
  let lines=mut.@();
  let count=manager.limits.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i >= count){
      br
    }el{
      let lim=manager.limits.get(i);
      let usg=manager.usage.get(i);
      let periods=periodlabel(lim.period);
      let tokpct=mut.0.0;
      if(lim.maxtokens==0){}el{
        tokpct=(usg.tokensused as f64 / lim.maxtokens as f64) * 100.0
      };
      let costpct=mut.0.0;
      if(lim.maxcostusd==0.0){}el{
        costpct=(usg.costusd / lim.maxcostusd) * 100.0
      };
      let usedtoks=str.fromint(usg.tokensused as i64);
      let maxtoks=str.fromint(lim.maxtokens as i64);
      let tokpcts=str.fromfloat(tokpct);
      let costs=str.fromfloat(usg.costusd);
      let maxcosts=str.fromfloat(lim.maxcostusd);
      let costpcts=str.fromfloat(costpct);
      let reqs=str.fromint(usg.requestcount as i64);
      let line="\(periods): tokens \(usedtoks)/\(maxtoks) (\(tokpcts)%)  cost $\(costs)/$\(maxcosts) (\(costpcts)%)  requests: \(reqs)";
      lines=lines.push(line);
      i=i+1;
    }
  };
  <str.join("
";lines)
};

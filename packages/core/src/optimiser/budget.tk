m=core.optimiser.budget;




i=t:shared.types;
i=str:std.str;
i=log:shared.log;
i=bt:core.optimiser.budgettypes;





f=new(limits:@$budgetlimit):$budgetmanager{
  let usage=mut.@();
  lp(let i=0;i<str.arraylen(limits);i=i+1){ let lim=str.arrayget(limits;i);
    usage=usage.append($budgetusage{
      periodstart:"";
      tokensused:0;
      costusd:0.0;
      requestcount:0
    })
  };
  <$budgetmanager{limits:limits;usage:usage}
};






f=defaultlimits():@$budgetlimit{
  <@(
    $budgetlimit{
      period:$daily(0);
      maxtokens:100000;
      maxcostusd:5.0;
      warnatpct:80.0
    };
    $budgetlimit{
      period:$monthly(0);
      maxtokens:1000000;
      maxcostusd:50.0;
      warnatpct:80.0
    }
  )
};



f=periodlabel(period:$budgetperiod):str{
  mt period {
    $daily:v "daily";
    $weekly:v "weekly";
    $monthly:v "monthly"
  }
};







f=check(manager:$budgetmanager;estimatedtokens:u32;estimatedcost:f64):$budgetcheck{
  let allowed=mut.true;
  let reason=mut."";
  let tokensremaining=mut.4294967295;
  let costremaining=mut.99999999.0;
  let pctused=mut.0.0;
  let cid=log.newcorrelationid();

  let limitcount=manager.limits.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i > limitcount){
      br
    }el{
      let lim=manager.limits.get(i);
      let usg=manager.usage.get(i);

      
      let newtokens=(usg.tokensused as i64 + estimatedtokens as i64) as u32;
      let newcost=usg.costusd + estimatedcost;

      
      let tokpct=mut.0.0;
      if(lim.maxtokens=0){}el{
        tokpct=(newtokens as f64 / lim.maxtokens as f64) * 100.0
      };

      
      let costpct=mut.0.0;
      if(lim.maxcostusd=0.0){}el{
        costpct=(newcost / lim.maxcostusd) * 100.0
      };

      let periods=periodlabel(lim.period);

      
      if(newtokens > lim.maxtokens){
        allowed=false;
        let rems=str.fromint(0);
        let useds=str.fromint(usg.tokensused as i64);
        let maxs=str.fromint(lim.maxtokens as i64);
        reason=str.concat(periods;str.concat(" token limit exceeded: used ";str.concat(useds;str.concat("/";maxs))));
        tokensremaining=0;
        pctused=100.0
      }el{
        
        if(newcost > lim.maxcostusd){
          allowed=false;
          reason=str.concat(periods;" cost limit exceeded");
          costremaining=0.0;
          pctused=100.0
        }el{
          
          let effectivepct=mut.costpct;
          if(tokpct > costpct){effectivepct=tokpct}el{};
          if(effectivepct > lim.warnatpct){
            let pcts=str.fromfloat(effectivepct);
            log.warn(
              str.concat(periods;str.concat(" budget at ";str.concat(pcts;"%")));
              "budget";
              cid
            )
          };

          
          let thistokrem=lim.maxtokens - newtokens;
          if(thistokrem < tokensremaining){
            tokensremaining=thistokrem
          };

          
          let thiscostrem=lim.maxcostusd - newcost;
          if(thiscostrem < costremaining){
            costremaining=thiscostrem
          };

          
          if(effectivepct > pctused){
            pctused=effectivepct
          }
        }
      };

      i=i+1;
    }
  };

  if(allowed){
    if(str.len(reason)=0){
      reason="within budget"
    }
  };

  <$budgetcheck{
    allowed:allowed;
    reason:reason;
    tokensremaining:tokensremaining;
    costremaining:costremaining;
    pctused:pctused
  }
};





f=record(manager:$budgetmanager;tokens:u32;cost:f64):void{
  let count=manager.usage.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      br
    }el{
      let usg=manager.usage.get(i);
      let newtokens=(usg.tokensused as i64 + tokens as i64) as u32;
      let newreqs=(usg.requestcount as i64 + 1) as i32;
      manager.usage.get(i)=$budgetusage{
        periodstart:usg.periodstart;
        tokensused:newtokens;
        costusd:usg.costusd + cost;
        requestcount:newreqs
      };
      i=i+1;
    }
  };
  <void
};




f=resetperiod(manager:$budgetmanager;period:$budgetperiod):void{
  let count=manager.limits.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      br
    }el{
      let lim=manager.limits.get(i);
      let matches=mt lim.period {
        $daily:v mt period { $daily:v true; $weekly:v false; $monthly:v false };
        $weekly:v mt period { $daily:v false; $weekly:v true; $monthly:v false };
        $monthly:v mt period { $daily:v false; $weekly:v false; $monthly:v true }
      };
      if(matches){
        manager.usage.get(i)=$budgetusage{
          periodstart:"";
          tokensused:0;
          costusd:0.0;
          requestcount:0
        }
      };
      i=i+1;
    }
  };
  <void
};




f=formatusage(manager:$budgetmanager):str{
  let lines=mut.@();
  let count=manager.limits.len;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i > count){
      br
    }el{
      let lim=manager.limits.get(i);
      let usg=manager.usage.get(i);
      let periods=periodlabel(lim.period);
      let tokpct=mut.0.0;
      if(lim.maxtokens=0){}el{
        tokpct=(usg.tokensused as f64 / lim.maxtokens as f64) * 100.0
      };
      let costpct=mut.0.0;
      if(lim.maxcostusd=0.0){}el{
        costpct=(usg.costusd / lim.maxcostusd) * 100.0
      };
      let usedtoks=str.fromint(usg.tokensused as i64);
      let maxtoks=str.fromint(lim.maxtokens as i64);
      let tokpcts=str.fromfloat(tokpct);
      let costs=str.fromfloat(usg.costusd);
      let maxcosts=str.fromfloat(lim.maxcostusd);
      let costpcts=str.fromfloat(costpct);
      let reqs=str.fromint(usg.requestcount as i64);
      let line=str.concat(
        periods;
        str.concat(
          ": tokens ";
          str.concat(
            usedtoks;
            str.concat(
              "/";
              str.concat(
                maxtoks;
                str.concat(
                  " (";
                  str.concat(
                    tokpcts;
                    str.concat(
                      "%)  cost $";
                      str.concat(
                        costs;
                        str.concat(
                          "/$";
                          str.concat(
                            maxcosts;
                            str.concat(
                              " (";
                              str.concat(
                                costpcts;
                                str.concat(
                                  "%)  requests: ";
                                  reqs
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
      lines=@(lines;line);
      i=i+1;
    }
  };
  <str.join(lines;"
")
};

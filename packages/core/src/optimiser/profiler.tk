m=core.optimiser.profiler;




i=t:shared.types;
i=toon:core.optimiser.toon;
i=str:std.str;
i=json:std.json;



t=$coltype{
  $intcol;
  $floatcol;
  $strcol;
  $boolcol;
  $datecol;
  $unknowncol
};

t=$colprofile{
  name:str;
  coltype:$coltype;
  nullcount:u32;
  nullpct:f64;
  uniquecount:u32;
  minval:str;
  maxval:str;
  samplevals:@(str);
  ispiicandidate:bool
};

t=$datasetprofile{
  name:str;
  rowcount:u32;
  colcount:u32;
  columns:@$colprofile;
  sensitivityhint:str
};




f=ispiiname(colname:str):bool{
  let lower=str.tolower(colname);
  let markers=@("email";"phone";"name";"address";"ssn";"dob";"birth";"credit";"account";"password";"key";"token");
  let found=false;
  mt markers {
    m;
      if found{
      }else{
        if str.contains(lower;m){
          found=true
        };
      };
  };
  <found
};





f=infercoltype(samples:@(str)):$coltype{
  if samples.len==0{
    <$coltype.$unknowncol
  }else{
    
    let allbool=true;
    mt samples {
      s;
        let lower=str.tolower(s);
        let isboolval=str.eq(lower;"true");
        let isbooln=str.eq(lower;"false");
        let isbooly=str.eq(lower;"y");
        let isboolno=str.eq(lower;"n");
        if isboolval{
        }else{
          if isbooln{
          }else{
            if isbooly{
            }else{
              if isboolno{
              }else{
                allbool=false
              };
            };
          };
        };
    };
    if allbool{
      <$coltype.$boolcol
    }else{
      
      let alldate=true;
      mt samples {
        s;
          
          if str.len(s)==10{
            let c4=str.slice(s;4;5);
            let c7=str.slice(s;7;8);
            if str.eq(c4;"-"){
              if str.eq(c7;"-"){
                
              }else{
                alldate=false
              };
            }else{
              alldate=false
            };
          }else{
            alldate=false
          };
      };
      if alldate{
        <$coltype.$datecol
      }else{
        
        let allint=true;
        mt samples {
          s;
            mt str.parseint(s) {
              $ok: {};
              $err: allint=false
            };
        };
        if allint{
          <$coltype.$intcol
        }else{
          
          let allfloat=true;
          mt samples {
            s;
              mt str.parsefloat(s) {
                $ok: {};
                $err: allfloat=false
              };
          };
          if allfloat{
            <$coltype.$floatcol
          }else{
            <$coltype.$strcol
          };
        };
      };
    };
  };
};





f=extractcolvalues(rows:@(any);colname:str):@(str){
  let vals=@();
  mt rows {
    row;
      
      let sval=json.trystrkey(row;colname);
      mt sval {
        $ok:s {
          if str.eq(s;""){
            
            vals=@(vals;s)
          }else{
            vals=@(vals;s)
          };
        };
        $err: {
          
          let ival=json.tryintkey(row;colname);
          mt ival {
            $ok:n vals=@(vals;str.fromint(n));
            $err: {
              let fval=json.tryfloatkey(row;colname);
              mt fval {
                $ok:f vals=@(vals;str.fromfloat(f));
                $err: {
                  let bval=json.tryboolkey(row;colname);
                  mt bval {
                    $ok:b {
                      if b{vals=@(vals;"true")}else{vals=@(vals;"false")};
                    };
                    $err: {
                      
                    };
                  };
                };
              };
            };
          };
        };
      };
  };
  <vals
};


f=countnulls(rows:@(any);colname:str):u32{
  let count=0;
  mt rows {
    row;
      let isnull=json.isnullkey(row;colname);
      if isnull{
        count=count+1
      }else{
        let missing=json.haskey(row;colname);
        if missing{
        }else{
          count=count+1
        };
      };
  };
  <count
};


f=countunique(vals:@(str)):u32{
  let seen=@();
  mt vals {
    v;
      let already=false;
      mt seen {
        s;
          if already{
          }else{
            if str.eq(s;v){
              already=true
            };
          };
      };
      if already{
      }else{
        seen=@(seen;v)
      };
  };
  <seen.len
};


f=findmin(vals:@(str)):str{
  if vals.len==0{
    <""
  }else{
    let m=vals.get(0);
    mt vals {
      v;
        
        
        let cmp=str.compare(v;m);
        if cmp<0{
          m=v
        };
    };
    <m
  };
};


f=findmax(vals:@(str)):str{
  if vals.len==0{
    <""
  }else{
    let m=vals.get(0);
    mt vals {
      v;
        let cmp=str.compare(v;m);
        if cmp>0{
          m=v
        };
    };
    <m
  };
};


f=takesamples(vals:@(str);n:u32):@(str){
  if vals.len<=n{
    <vals
  }else{
    <vals.slice(0;n)
  };
};


f=profilecol(rows:@(any);colname:str;totalrows:u32):$colprofile{
  let nullcount=countnulls(rows;colname);
  let nullpct=if totalrows==0{0.0}else{(nullcount as f64/(totalrows as f64))*100.0};
  let vals=extractcolvalues(rows;colname);
  let uniquecount=countunique(vals);
  let minval=findmin(vals);
  let maxval=findmax(vals);
  let samples=takesamples(vals;3);
  let coltype=infercoltype(vals);
  let ispii=ispiiname(colname);
  <$colprofile{
    name:colname;
    coltype:coltype;
    nullcount:nullcount;
    nullpct:nullpct;
    uniquecount:uniquecount;
    minval:minval;
    maxval:maxval;
    samplevals:samples;
    ispiicandidate:ispii
  };
};






f=profilejsonarray(data:str;name:str):$datasetprofile|$lokeerr{
  mt json.dec(data) {
    $ok:parsed {
      let rows=json.tryarr(parsed);
      mt rows {
        $ok:rowarr {
          let rowcount=rowarr.len;
          if rowcount==0{
            let profile=$datasetprofile{
              name:name;
              rowcount:0;
              colcount:0;
              columns:@();
              sensitivityhint:"no data"
            };
            <$ok(profile)
          }else{
            
            let colnames=json.keys(rowarr.get(0));
            let colcount=colnames.len;
            let columns=colnames.map|colname{
              profilecol(rowarr;colname;rowcount)
            };
            
            let haspii=false;
            mt columns {
              cp;
                if cp.ispiicandidate{
                  haspii=true
                };
            };
            let sensitivityhint=if haspii{"contains PII candidates"}else{"no obvious PII"};
            let profile=$datasetprofile{
              name:name;
              rowcount:rowcount;
              colcount:colcount;
              columns:columns;
              sensitivityhint:sensitivityhint
            };
            <$ok(profile)
          };
        };
        $err: {
          <$err($lokeerr.$unknownerr("profile_json_array: input is not a JSON array"))
        };
      };
    };
    $err: {
      <$err($lokeerr.$unknownerr(str.concat("profile_json_array: JSON parse failed for dataset: ";name)))
    };
  };
};




f=coltypetostr(t:$coltype):str{
  mt t {
    $intcol   "int";
    $floatcol "float";
    $strcol   "str";
    $boolcol  "bool";
    $datecol  "date";
    $unknowncol "?"
  };
};




f=fmtpct(pct:f64):str{
  if pct==0.0{
    <"0%"
  }else{
    
    let rounded=str.fromfloat(pct);
    <str.concat(rounded;"%")
  };
};


f=totoonschema(profile:$datasetprofile):str{
  let rowcounts=str.fromint(profile.rowcount);
  let colcounts=str.fromint(profile.colcount);
  let header=str.concat(
    "SCHEMA:";
    str.concat(
      profile.name;
      str.concat(
        " rows:";
        str.concat(
          rowcounts;
          str.concat(" cols:";colcounts)
        )
      )
    )
  );
  let collines=profile.columns.map|cp{
    let types=coltypetostr(cp.coltype);
    
    let samplepart=if cp.samplevals.len==0{
      ""
    }else{
      let inner=str.join(cp.samplevals;",");
      str.concat("[";str.concat(inner;"]"))
    };
    let nullss=fmtpct(cp.nullpct);
    let uniqs=str.fromint(cp.uniquecount);
    let piipart=if cp.ispiicandidate{" [PII]"}else{""};
    
    let datehint=mt cp.coltype {
      $datecol " [date?]";
      $intcol "";
      $floatcol "";
      $strcol "";
      $boolcol "";
      $unknowncol ""
    };
    
    let suffix=if cp.ispiicandidate{piipart}else{datehint};
    str.concat(
      cp.name;
      str.concat(
        ":";
        str.concat(
          types;
          str.concat(
            samplepart;
            str.concat(
              " nulls:";
              str.concat(
                nullss;
                str.concat(
                  " uniq:";
                  str.concat(uniqs;suffix)
                )
              )
            )
          )
        )
      )
    )
  };
  let colblock=str.join(collines;"
");
  <str.concat(header;str.concat("
";colblock))
};

m=core.optimiser.profiler;

i=t:shared.types;
i=toon:core.optimiser.toon;
i=str:std.str;
i=json:std.json;

t=$coltype{
  $intcol:i64;
  $floatcol:i64;
  $strcol:i64;
  $boolcol:i64;
  $datecol:i64;
  $unknowncol:i64
};

t=$colprofile{
  name:str;
  coltype:$coltype;
  nullcount:u32;
  nullpct:f64;
  uniquecount:u32;
  minval:str;
  maxval:str;
  samplevals:@str;
  ispiicandidate:bool
};

t=$datasetprofile{
  name:str;
  rowcount:u32;
  colcount:u32;
  columns:@$colprofile;
  sensitivityhint:str
};

f=ispiiname(colname:str):bool{
  let lower=str.tolower(colname);
  let markers=@("email";"phone";"name";"address";"ssn";"dob";"birth";"credit";"account";"password";"key";"token");
  let found=mut.false;
  lp(let i=0;i<str.arraylen(markers);i=i+1){ let m=str.arrayget(markers;i);
    if(found){}el{
      if(str.contains(lower;m)){
        found=true
      }el{}
    }
  };
  <found
};

f=infercoltype(samples:@str):$coltype{
  if(samples.len=0 as u64){
    <$coltype{$unknowncol:0}
  }el{
    let allbool=mut.true;
    lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
      let lower=str.tolower(s);
      let isboolval=str.eq(lower;"true");
      let isbooln=str.eq(lower;"false");
      let isbooly=str.eq(lower;"y");
      let isboolno=str.eq(lower;"n");
      if(isboolval){}el{
        if(isbooln){}el{
          if(isbooly){}el{
            if(isboolno){}el{
              allbool=false
            }
          }
        }
      }
    };
    if(allbool){
      <$coltype{$boolcol:0}
    }el{
      let alldate=mut.true;
      lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
        if(str.len(s)=10){
          let c4=str.slice(s;4;5);
          let c7=str.slice(s;7;8);
          if(str.eq(c4;"-")){
            if(str.eq(c7;"-")){}el{
              alldate=false
            }
          }el{
            alldate=false
          }
        }el{
          alldate=false
        }
      };
      if(alldate){
        <$coltype{$datecol:0}
      }el{
        let allint=mut.true;
        lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
          mt str.parseint(s) {
            $ok:v 0;
            $err:e allint=false
          }
        };
        if(allint){
          <$coltype{$intcol:0}
        }el{
          let allfloat=mut.true;
          lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
            mt str.parsefloat(s) {
              $ok:v 0;
              $err:e allfloat=false
            }
          };
          if(allfloat){
            <$coltype{$floatcol:0}
          }el{
            <$coltype{$strcol:0}
          }
        }
      }
    }
  }
};

f=tryfloatorbool(row:i64;colname:str;vals:@str):@str{
  let fval=json.tryfloatkey(row;colname);
  mt fval {
    $ok:f @(vals;str.fromfloat(f));
    $err:e3 tryboolval(row;colname;vals)
  }
};

f=formatboolval(b:bool;vals:@str):@str{
  let bstr=mut."false";
  if(b){bstr="true"}el{};
  <vals.append(bstr)
};

f=tryboolval(row:i64;colname:str;vals:@str):@str{
  let bval=json.tryboolkey(row;colname);
  mt bval {
    $ok:b formatboolval(b;vals);
    $err:e4 vals
  }
};

f=tryintorfloat(row:i64;colname:str;vals:@str):@str{
  let ival=json.tryintkey(row;colname);
  mt ival {
    $ok:n @(vals;str.fromint(n));
    $err:e2 tryfloatorbool(row;colname;vals)
  }
};

f=extractcolvalues(rows:@i64;colname:str):@str{
  let vals=mut.@();
  lp(let i=0;i<str.arraylen(rows);i=i+1){ let row=str.arrayget(rows;i);
    let sval=json.trystrkey(row;colname);
    vals=mt sval {
      $ok:s @(vals;s);
      $err:e tryintorfloat(row;colname;vals)
    }
  };
  <vals
};

f=countnulls(rows:@i64;colname:str):u32{
  let count=mut.0;
  lp(let i=0;i<str.arraylen(rows);i=i+1){ let row=str.arrayget(rows;i);
    let isnull=json.isnullkey(row;colname);
    if(isnull){
      count=count+1
    }el{
      let missing=json.haskey(row;colname);
      if(missing){}el{
        count=count+1
      }
    }
  };
  <count
};

f=countunique(vals:@str):u32{
  let seen=mut.@();
  lp(let i=0;i<str.arraylen(vals);i=i+1){ let v=str.arrayget(vals;i);
    let already=mut.false;
    lp(let j=0;j<str.arraylen(seen);j=j+1){ let s=str.arrayget(seen;j);
      if(already){}el{
        if(str.eq(s;v)){
          already=true
        }el{}
      }
    };
    if(already){}el{
      seen=@(seen;v)
    }
  };
  <seen.len
};

f=findmin(vals:@str):str{
  let m=mut."";
  if(vals.len=0 as u64){
    <""
  }el{
    m=vals.get(0);
    lp(let i=0;i<str.arraylen(vals);i=i+1){ let v=str.arrayget(vals;i);
      let cmp=str.compare(v;m);
      if(cmp<0){
        m=v
      }el{}
    };
    <m
  }
};

f=findmax(vals:@str):str{
  let m=mut."";
  if(vals.len=0 as u64){
    <""
  }el{
    m=vals.get(0);
    lp(let i=0;i<str.arraylen(vals);i=i+1){ let v=str.arrayget(vals;i);
      let cmp=str.compare(v;m);
      if(cmp>0){
        m=v
      }el{}
    };
    <m
  }
};

f=takesamples(vals:@str;n:u32):@str{
  if(!(vals.len>n as u64)){
    <vals
  }el{
    <vals.slice(0;n)
  }
};

f=profilecol(rows:@i64;colname:str;totalrows:u32):$colprofile{
  let nullcount=countnulls(rows;colname);
  let nullpct=mut.0.0;
  if(totalrows=0 as u32){}el{nullpct=(nullcount as f64/(totalrows as f64))*100.0};
  let vals=extractcolvalues(rows;colname);
  let uniquecount=countunique(vals);
  let minval=findmin(vals);
  let maxval=findmax(vals);
  let samples=takesamples(vals;3);
  let coltype=infercoltype(vals);
  let ispii=ispiiname(colname);
  <$colprofile{
    name:colname;
    coltype:coltype;
    nullcount:nullcount;
    nullpct:nullpct;
    uniquecount:uniquecount;
    minval:minval;
    maxval:maxval;
    samplevals:samples;
    ispiicandidate:ispii
  }
};

f=profilerowarr(rowarr:@i64;name:str):$datasetprofile!$lokeerr{
  let rowcount=rowarr.len;
  if(rowcount=0){
    let profile=$datasetprofile{
      name:name;
      rowcount:0;
      colcount:0;
      columns:@();
      sensitivityhint:"no data"
    };
    <$ok(profile)
  }el{
    let colnames=json.keys(rowarr.get(0));
    let colcount=colnames.len;
    let columns=mut.@();
    lp(let ci=0;ci<str.arraylen(colnames);ci=ci+1){ let colname=str.arrayget(colnames;ci);
      columns=columns.append(profilecol(rowarr;colname;rowcount))
    };
    let haspii=mut.false;
    lp(let ci=0;ci<str.arraylen(columns);ci=ci+1){ let cp=str.arrayget(columns;ci);
      if(cp.ispiicandidate){
        haspii=true
      }el{}
    };
    let sensitivityhint=mut."no obvious PII";
    if(haspii){sensitivityhint="contains PII candidates"}el{};
    let profile=$datasetprofile{
      name:name;
      rowcount:rowcount;
      colcount:colcount;
      columns:columns;
      sensitivityhint:sensitivityhint
    };
    <$ok(profile)
  }
};

f=profileparsedjson(parsed:i64;name:str):$datasetprofile!$lokeerr{
  let rows=json.tryarr(parsed);
  mt rows {
    $ok:rowarr profilerowarr(rowarr;name);
    $err:e $err($unknownerr("profile_json_array: input is not a JSON array"))
  }
};

f=profilejsonarray(data:str;name:str):$datasetprofile!$lokeerr{
  mt json.dec(data) {
    $ok:parsed profileparsedjson(parsed;name);
    $err:e2 $err($unknownerr(str.concat("profile_json_array: JSON parse failed for dataset: ";name)))
  }
};

f=coltypetostr(ct:$coltype):str{
  mt ct {
    $intcol:v "int";
    $floatcol:v "float";
    $strcol:v "str";
    $boolcol:v "bool";
    $datecol:v "date";
    $unknowncol:v "?"
  }
};

f=fmtpct(pct:f64):str{
  if(pct=0.0){
    <"0%"
  }el{
    let rounded=str.fromfloat(pct);
    <str.concat(rounded;"%")
  }
};

f=totoonschema(profile:$datasetprofile):str{
  let rowcounts=str.fromint(profile.rowcount);
  let colcounts=str.fromint(profile.colcount);
  let header=str.concat(
    "SCHEMA:";
    str.concat(
      profile.name;
      str.concat(
        " rows:";
        str.concat(
          rowcounts;
          str.concat(" cols:";colcounts)
        )
      )
    )
  );
  let collines=mut.@();
  lp(let i=0;i<str.arraylen(profile.columns);i=i+1){ let cp=str.arrayget(profile.columns;i);
    let types=coltypetostr(cp.coltype);
    let samplepart=mut."";
    if(cp.samplevals.len=0){}el{
      let inner=str.join(cp.samplevals;",");
      samplepart=str.concat("[";str.concat(inner;"]"))
    };
    let nullss=mut."0%";
    if(cp.nullpct=0.0){}el{
      nullss=str.concat(str.fromfloat(cp.nullpct);"%")
    };
    let uniqs=str.fromint(cp.uniquecount);
    let piipart=mut."";
    if(cp.ispiicandidate){piipart=" [PII]"}el{};
    let datehint=mt cp.coltype {
      $datecol:v " [date?]";
      $intcol:v "";
      $floatcol:v "";
      $strcol:v "";
      $boolcol:v "";
      $unknowncol:v ""
    };
    let suffix=mut.datehint;
    if(cp.ispiicandidate){suffix=piipart}el{};
    collines=collines.append(str.concat(
      cp.name;
      str.concat(
        ":";
        str.concat(
          types;
          str.concat(
            samplepart;
            str.concat(
              " nulls:";
              str.concat(
                nullss;
                str.concat(
                  " uniq:";
                  str.concat(uniqs;suffix)
                )
              )
            )
          )
        )
      )
    ))
  };
  let colblock=str.join(collines;"
");
  <str.concat(header;str.concat("
";colblock))
};

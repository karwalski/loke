m=core.optimiser.profiler;

i=t:shared.types;
i=toon:core.optimiser.toon;
i=str:std.str;
i=json:std.json;

t=$coltype{
  $intcol:i64;
  $floatcol:i64;
  $strcol:i64;
  $boolcol:i64;
  $datecol:i64;
  $unknowncol:i64
};

t=$colprofile{
  name:str;
  coltype:$coltype;
  nullcount:u32;
  nullpct:f64;
  uniquecount:u32;
  minval:str;
  maxval:str;
  samplevals:@str;
  ispiicandidate:bool
};

t=$datasetprofile{
  name:str;
  rowcount:u32;
  colcount:u32;
  columns:@$colprofile;
  sensitivityhint:str
};

f=ispiiname(colname:str):bool{
  let lower=str.tolower(colname);
  let markers=@("email";"phone";"name";"address";"ssn";"dob";"birth";"credit";"account";"password";"key";"token");
  let found=mut.false;
  lp(let i=0;i<str.arraylen(markers);i=i+1){ let m=str.arrayget(markers;i);
    if(found){}el{
      if(str.contains(lower;m)){
        found=true
      }el{}
    }
  };
  <found
};

f=infercoltype(samples:@str):$coltype{
  if(samples.len=0){
    <$unknowncol
  }el{
    let allbool=mut.true;
    lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
      let lower=str.tolower(s);
      let isboolval=str.eq(lower;"true");
      let isbooln=str.eq(lower;"false");
      let isbooly=str.eq(lower;"y");
      let isboolno=str.eq(lower;"n");
      if(isboolval){}el{
        if(isbooln){}el{
          if(isbooly){}el{
            if(isboolno){}el{
              allbool=false
            }
          }
        }
      }
    };
    if(allbool){
      <$boolcol
    }el{
      let alldate=mut.true;
      lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
        if(str.len(s)=10){
          let c4=str.slice(s;4;5);
          let c7=str.slice(s;7;8);
          if(str.eq(c4;"-")){
            if(str.eq(c7;"-")){}el{
              alldate=false
            }
          }el{
            alldate=false
          }
        }el{
          alldate=false
        }
      };
      if(alldate){
        <$datecol
      }el{
        let allint=mut.true;
        lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
          mt str.parseint(s) {
            $ok:v 0;
            $err:e allint=false
          }
        };
        if(allint){
          <$intcol
        }el{
          let allfloat=mut.true;
          lp(let i=0;i<str.arraylen(samples);i=i+1){ let s=str.arrayget(samples;i);
            mt str.parsefloat(s) {
              $ok:v 0;
              $err:e allfloat=false
            }
          };
          if(allfloat){
            <$floatcol
          }el{
            <$strcol
          }
        }
      }
    }
  }
};

f=extractcolvalues(rows:@$any;colname:str):@str{
  let vals=mut.@(str);
  lp(let i=0;i<str.arraylen(rows);i=i+1){ let row=str.arrayget(rows;i);
    let sval=json.trystrkey(row;colname);
    mt sval {
      $ok:s vals=@(vals;s);
      $err:e
        let ival=json.tryintkey(row;colname);
        mt ival {
          $ok:n vals=@(vals;str.fromint(n));
          $err:e2
            let fval=json.tryfloatkey(row;colname);
            mt fval {
              $ok:f vals=@(vals;str.fromfloat(f));
              $err:e3
                let bval=json.tryboolkey(row;colname);
                mt bval {
                  $ok:b if(b){vals=@(vals;"true")}el{vals=@(vals;"false")};
                  $err:e4 0
                }
            }
        }
    }
  };
  <vals
};

f=countnulls(rows:@$any;colname:str):u32{
  let count=mut.0;
  lp(let i=0;i<str.arraylen(rows);i=i+1){ let row=str.arrayget(rows;i);
    let isnull=json.isnullkey(row;colname);
    if(isnull){
      count=count+1
    }el{
      let missing=json.haskey(row;colname);
      if(missing){}el{
        count=count+1
      }
    }
  };
  <count
};

f=countunique(vals:@str):u32{
  let seen=mut.@(str);
  lp(let i=0;i<str.arraylen(vals);i=i+1){ let v=str.arrayget(vals;i);
    let already=mut.false;
    lp(let j=0;j<str.arraylen(seen);j=j+1){ let s=str.arrayget(seen;j);
      if(already){}el{
        if(str.eq(s;v)){
          already=true
        }el{}
      }
    };
    if(already){}el{
      seen=@(seen;v)
    }
  };
  <seen.len
};

f=findmin(vals:@str):str{
  if(vals.len=0){
    <""
  }el{
    let m=mut.vals.get(0);
    lp(let i=0;i<str.arraylen(vals);i=i+1){ let v=str.arrayget(vals;i);
      let cmp=str.compare(v;m);
      if(cmp<0){
        m=v
      }el{}
    };
    <m
  }
};

f=findmax(vals:@str):str{
  if(vals.len=0){
    <""
  }el{
    let m=mut.vals.get(0);
    lp(let i=0;i<str.arraylen(vals);i=i+1){ let v=str.arrayget(vals;i);
      let cmp=str.compare(v;m);
      if(cmp>0){
        m=v
      }el{}
    };
    <m
  }
};

f=takesamples(vals:@str;n:u32):@str{
  if(vals.!(len>n)){
    <vals
  }el{
    <vals.slice(0;n)
  }
};

f=profilecol(rows:@$any;colname:str;totalrows:u32):$colprofile{
  let nullcount=countnulls(rows;colname);
  let nullpct=if(totalrows=0){0.0}el{(nullcount as f64/(totalrows as f64))*100.0};
  let vals=extractcolvalues(rows;colname);
  let uniquecount=countunique(vals);
  let minval=findmin(vals);
  let maxval=findmax(vals);
  let samples=takesamples(vals;3);
  let coltype=infercoltype(vals);
  let ispii=ispiiname(colname);
  <$colprofile{
    name:colname;
    coltype:coltype;
    nullcount:nullcount;
    nullpct:nullpct;
    uniquecount:uniquecount;
    minval:minval;
    maxval:maxval;
    samplevals:samples;
    ispiicandidate:ispii
  }
};

f=profilejsonarray(data:str;name:str):$datasetprofile!$lokeerr{
  mt json.dec(data) {
    $ok:parsed
      let rows=json.tryarr(parsed);
      mt rows {
        $ok:rowarr
          let rowcount=rowarr.len;
          if(rowcount=0){
            let profile=$datasetprofile{
              name:name;
              rowcount:0;
              colcount:0;
              columns:@();
              sensitivityhint:"no data"
            };
            <$ok(profile)
          }el{
            let colnames=json.keys(rowarr.get(0));
            let colcount=colnames.len;
            let columns=@();
            lp(let ci=0;ci<str.arraylen(colnames);ci=ci+1){ let colname=str.arrayget(colnames;ci);
              columns=columns.append(profilecol(rowarr;colname;rowcount))
            };
            let haspii=mut.false;
            lp(let ci=0;ci<str.arraylen(columns);ci=ci+1){ let cp=str.arrayget(columns;ci);
              if(cp.ispiicandidate){
                haspii=true
              }el{}
            };
            let sensitivityhint=if(haspii){"contains PII candidates"}el{"no obvious PII"};
            let profile=$datasetprofile{
              name:name;
              rowcount:rowcount;
              colcount:colcount;
              columns:columns;
              sensitivityhint:sensitivityhint
            };
            <$ok(profile)
          };
        $err:e $err($unknownerr("profile_json_array: input is not a JSON array"))
      };
    $err:e2
      <$err($unknownerr(str.concat("profile_json_array: JSON parse failed for dataset: ";name)))
  }
};

f=coltypetostr(ct:$coltype):str{
  mt ct {
    $intcol "int";
    $floatcol "float";
    $strcol "str";
    $boolcol "bool";
    $datecol "date";
    $unknowncol "?"
  }
};

f=fmtpct(pct:f64):str{
  if(pct=0.0){
    <"0%"
  }el{
    let rounded=str.fromfloat(pct);
    <str.concat(rounded;"%")
  }
};

f=totoonschema(profile:$datasetprofile):str{
  let rowcounts=str.fromint(profile.rowcount);
  let colcounts=str.fromint(profile.colcount);
  let header=str.concat(
    "SCHEMA:";
    str.concat(
      profile.name;
      str.concat(
        " rows:";
        str.concat(
          rowcounts;
          str.concat(" cols:";colcounts)
        )
      )
    )
  );
  let collines=@();
  lp(let i=0;i<str.arraylen(profile.columns);i=i+1){ let cp=str.arrayget(profile.columns;i);
    let types=coltypetostr(cp.coltype);
    let samplepart=if(cp.samplevals.len=0){
      ""
    }el{
      let inner=str.join(cp.samplevals;",");
      str.concat("[";str.concat(inner;"]"))
    };
    let nullss=fmtpct(cp.nullpct);
    let uniqs=str.fromint(cp.uniquecount);
    let piipart=if(cp.ispiicandidate){" [PII]"}el{""};
    let datehint=mt cp.coltype {
      $datecol " [date?]";
      $intcol "";
      $floatcol "";
      $strcol "";
      $boolcol "";
      $unknowncol ""
    };
    let suffix=if(cp.ispiicandidate){piipart}el{datehint};
    collines=collines.append(str.concat(
      cp.name;
      str.concat(
        ":";
        str.concat(
          types;
          str.concat(
            samplepart;
            str.concat(
              " nulls:";
              str.concat(
                nullss;
                str.concat(
                  " uniq:";
                  str.concat(uniqs;suffix)
                )
              )
            )
          )
        )
      )
    ))
  };
  let colblock=str.join(collines;"
");
  <str.concat(header;str.concat("
";colblock))
};

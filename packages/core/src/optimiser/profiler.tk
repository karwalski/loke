m=core.optimiser.profiler;

i=str:std.str;
i=json:std.json;
i=t:shared.types;

t=$coltype{
  $intcol:i64;
  $floatcol:i64;
  $strcol:i64;
  $boolcol:i64;
  $datecol:i64;
  $unknowncol:i64
};

t=$colprofile{
  name:str;
  coltype:$coltype;
  nullcount:u32;
  nullpct:f64;
  uniquecount:u32;
  minval:str;
  maxval:str;
  samplevals:@str;
  ispiicandidate:bool
};

t=$datasetprofile{
  name:str;
  rowcount:u32;
  colcount:u32;
  columns:@$colprofile;
  sensitivityhint:str
};

(* str.arrayget erases the element type of what it returns, and str.arraylen is its partner.
   Both are replaced throughout this module with the typed .len / .get(i) accessors — the
   same change PL1.1 made to core.privacy.placeholder.buildplaceholdermap and this session
   made to core.optimiser.budget.new.

   This is a hazard removal, not a bug fix, and it is worth saying so rather than claiming a
   result it did not produce: converting these eleven call sites changed no assertion in
   tests/unit/optimiser/test_profiler.tk. findmin and findmax were broken by something else
   entirely, and strlt below is what fixes them. *)
f=ispiiname(colname:str):bool{
  let lower=str.tolower(colname);
  let markers=@("email";"phone";"name";"address";"ssn";"dob";"birth";"credit";"account";"password";"key";"token");
  let found=mut.false;
  lp(let i=0;i<markers.len;i=i+1){ let m=markers.get(i);
    if(found){}el{
      if(str.contains(lower;m)){
        found=true
      }el{}
    }
  };
  <found
};

f=infercoltype(samples:@str):$coltype{
  if(samples.len==0 as u64){
    <$coltype{$unknowncol:0}
  }el{
    let allbool=mut.true;
    lp(let i1=0;i1<samples.len;i1=i1+1){
            let s=samples.get(i1);
      let lower=str.tolower(s);
      let isboolval=str.eq(lower;"true");
      let isbooln=str.eq(lower;"false");
      let isbooly=str.eq(lower;"y");
      let isboolno=str.eq(lower;"n");
      if(isboolval){}el{
        if(isbooln){}el{
          if(isbooly){}el{
            if(isboolno){}el{
              allbool=false
            }
          }
        }
      }
    };
    if(allbool){
      <$coltype{$boolcol:0}
    }el{
      let alldate=mut.true;
      lp(let i2=0;i2<samples.len;i2=i2+1){
            let s=samples.get(i2);
        if(str.len(s)==10){
          let c4=str.slice(s;4;5);
          let c7=str.slice(s;7;8);
          if(str.eq(c4;"-")){
            if(str.eq(c7;"-")){}el{
              alldate=false
            }
          }el{
            alldate=false
          }
        }el{
          alldate=false
        }
      };
      if(alldate){
        <$coltype{$datecol:0}
      }el{
        let allint=mut.true;
        lp(let i3=0;i3<samples.len;i3=i3+1){
            let s=samples.get(i3);
          (* The flag is the VALUE of the match. `allint==false` inside an arm was a
             discarded comparison, so every column typed as int; and an assignment is not
             permitted inside an arm, because an arm is an expression. *)
          allint=mt str.parseint(s) {
            $ok:v allint;
            $err:e false
          }
        };
        if(allint){
          <$coltype{$intcol:0}
        }el{
          let allfloat=mut.true;
          lp(let i4=0;i4<samples.len;i4=i4+1){
            let s=samples.get(i4);
            (* The flag is the VALUE of the match. `allfloat==false` inside an arm was a
               discarded comparison, so every column typed as int; and an assignment is not
               permitted inside an arm, because an arm is an expression. *)
            allfloat=mt str.parsefloat(s) {
              $ok:v allfloat;
              $err:e false
            }
          };
          if(allfloat){
            <$coltype{$floatcol:0}
          }el{
            <$coltype{$strcol:0}
          }
        }
      }
    }
  }
};

f=tryfloatorbool(row:i64;colname:str;vals:@str):@str{
  let fval=json.tryfloatkey(row;colname);
  <mt fval {
    $ok:f vals.push(str.fromfloat(f));
    $err:e3 tryboolval(row;colname;vals)
  }
};

f=formatboolval(b:bool;vals:@str):@str{
  let bstr=mut."false";
  if(b){bstr="true"}el{};
  <vals.append(bstr)
};

f=tryboolval(row:i64;colname:str;vals:@str):@str{
  let bval=json.tryboolkey(row;colname);
  <mt bval {
    $ok:b formatboolval(b;vals);
    $err:e4 vals
  }
};

f=tryintorfloat(row:i64;colname:str;vals:@str):@str{
  let ival=json.tryintkey(row;colname);
  <mt ival {
    $ok:n vals.push(str.fromint(n));
    $err:e2 tryfloatorbool(row;colname;vals)
  }
};

f=extractcolvalues(rows:@i64;colname:str):@str{
  let vals=mut.@();
  lp(let i=0;i<rows.len;i=i+1){ let row=rows.get(i);
    let sval=json.trystrkey(row;colname);
    vals=mt sval {
      $ok:s vals.push(s);
      $err:e tryintorfloat(row;colname;vals)
    }
  };
  <vals
};

f=countnulls(rows:@i64;colname:str):u32{
  let count=mut.0;
  lp(let i=0;i<rows.len;i=i+1){ let row=rows.get(i);
    let isnull=json.isnullkey(row;colname);
    if(isnull){
      count=count+1
    }el{
      let missing=json.haskey(row;colname);
      if(missing){}el{
        count=count+1
      }
    }
  };
  <count
};

f=countunique(vals:@str):u32{
  let seen=mut.@();
  lp(let i=0;i<vals.len;i=i+1){ let v=vals.get(i);
    let already=mut.false;
    lp(let j=0;j<seen.len;j=j+1){ let s=seen.get(j);
      if(already){}el{
        if(str.eq(s;v)){
          already=true
        }el{}
      }
    };
    if(already){}el{
      seen=seen.push(v)
    }
  };
  <seen.len
};

(* std.str.compare is NOT a three-way comparison. Measured directly this session:

     str.compare("apple";"banana")  ->  1
     str.compare("banana";"apple")  ->  1
     str.compare("apple";"apple")   ->  0

   It reports EQUAL or DIFFERENT and never returns a negative, so `cmp<0` can never be true.
   findmin therefore never moved off element zero — findmin(["banana","apple","cherry"])
   answered "banana" — and findmax only appeared to work: with `cmp>0` true for every
   difference it takes the LAST value that differs from the running one, which coincides with
   the maximum when the input happens to be ascending and not otherwise.
   findmax(["cherry","apple","banana"]) answered "banana".

   That matters beyond these two functions: minval and maxval go into a $colprofile, which is
   what totoonschema describes to a model. A wrong range in a schema profile is a wrong
   statement about the caller's data.

   strlt is a real lexicographic less-than, byte by byte. str.charat answers a byte value as
   an i64, which is why T-28 says to compare it against 48..57 rather than hand it to
   str.isdigit; comparing two of them to each other is the same arithmetic. The loop cannot
   return early — `decided` latches instead — because a bare return inside `lp` is not a shape
   this module uses. *)
f=strlt(a:str;b:str):bool{
  let la=str.len(a);
  let lb=str.len(b);
  let n=mut.la;
  if(lb<n){n=lb}el{};
  let decided=mut.false;
  let result=mut.false;
  lp(let i=0;i<n;i=i+1){
    if(decided){}el{
      let ca=str.charat(a;i);
      let cb=str.charat(b;i);
      if(ca<cb){
        decided=true;
        result=true
      }el{
        if(cb<ca){
          decided=true;
          result=false
        }el{}
      }
    }
  };
  if(decided){
    <result
  }el{
    (* Every shared byte is equal, so the shorter string sorts first. *)
    <la<lb
  }
};

f=findmin(vals:@str):str{
  let m=mut."";
  if(vals.len==0 as u64){
    <""
  }el{
    m=vals.get(0);
    lp(let i=0;i<vals.len;i=i+1){ let v=vals.get(i);
      if(strlt(v;m)){
        m=v
      }el{}
    };
    <m
  }
};

f=findmax(vals:@str):str{
  let m=mut."";
  if(vals.len==0 as u64){
    <""
  }el{
    m=vals.get(0);
    lp(let i=0;i<vals.len;i=i+1){ let v=vals.get(i);
      if(strlt(m;v)){
        m=v
      }el{}
    };
    <m
  }
};

f=takesamples(vals:@str;n:i64):@str{
  if(!(vals.len>n as u64)){
    <vals
  }el{
    <vals.slice(0;n)
  }
};

f=profilecol(rows:@i64;colname:str;totalrows:u32):$colprofile{
  let nullcount=countnulls(rows;colname);
  let nullpct=mut.0.0;
  if(totalrows==0 as u32){}el{nullpct=(nullcount as f64/(totalrows as f64))*100.0};
  let vals=extractcolvalues(rows;colname);
  let uniquecount=countunique(vals);
  let minval=findmin(vals);
  let maxval=findmax(vals);
  let samples=takesamples(vals;3);
  let coltype=infercoltype(vals);
  let ispii=ispiiname(colname);
  <$colprofile{
    name:colname;
    coltype:coltype;
    nullcount:nullcount;
    nullpct:nullpct;
    uniquecount:uniquecount;
    minval:minval;
    maxval:maxval;
    samplevals:samples;
    ispiicandidate:ispii
  }
};

f=profilerowarr(rowarr:@i64;name:str):$datasetprofile!$lokeerr{
  let rowcount=rowarr.len;
  if(rowcount==0){
    let profile=$datasetprofile{
      name:name;
      rowcount:0;
      colcount:0;
      columns:@();
      sensitivityhint:"no data"
    };
    <$ok(profile)
  }el{
    let colnames=json.keys(rowarr.get(0));
    let colcount=colnames.len;
    let columns=mut.@();
    lp(let ci=0;ci<colnames.len;ci=ci+1){ let colname=colnames.get(ci);
      columns=columns.append(profilecol(rowarr;colname;rowcount))
    };
    let haspii=mut.false;
    lp(let ci=0;ci<columns.len;ci=ci+1){ let cp=columns.get(ci);
      if(cp.ispiicandidate){
        haspii=true
      }el{}
    };
    let sensitivityhint=mut."no obvious PII";
    if(haspii){sensitivityhint="contains PII candidates"}el{};
    let profile=$datasetprofile{
      name:name;
      rowcount:rowcount;
      colcount:colcount;
      columns:columns;
      sensitivityhint:sensitivityhint
    };
    <$ok(profile)
  }
};

f=profileparsedjson(parsed:$json;name:str):$datasetprofile!$lokeerr{
  (* json.tryarr(value) is gone — std.json is keyed now, json.arr(Json,key). A root
     value has no key, so the array test reads the raw text, the same discriminator
     optimiser/toon.tk uses. *)
  let raw=str.trimws(parsed.raw);
  if(str.len(raw)==0){
    <$err($unknownerr("profile_json_array: input is not a JSON array"))
  }el{
    if(str.eq(str.slice(raw;0;1);"[")){
      <profilerowarr(json.arr(parsed;"")!$lokeerr;name)
    }el{
      <$err($unknownerr("profile_json_array: input is not a JSON array"))
    }
  }
};

f=profilejsonarray(data:str;name:str):$datasetprofile!$lokeerr{
  <mt json.dec(data) {
    $ok:parsed profileparsedjson(parsed;name);
    $err:e2 $err($unknownerr(str.concat("profile_json_array: JSON parse failed for dataset: ";name)))
  }
};

f=coltypetostr(ct:$coltype):str{
  <mt ct {
    $intcol:v "int";
    $floatcol:v "float";
    $strcol:v "str";
    $boolcol:v "bool";
    $datecol:v "date";
    $unknowncol:v "?"
  }
};

f=fmtpct(pct:f64):str{
  if(pct==0.0){
    <"0%"
  }el{
    let rounded=str.fromfloat(pct);
    <str.concat(rounded;"%")
  }
};

(* The match is in its own function, not inline in the loop. toke emits duplicate
   basic-block labels for an inline `mt` of three or more arms inside a loop body and
   clang rejects the module ("Terminator found in the middle of a basic block!").
   Two arms is fine, which is why $ok/$err matches are unaffected. See
   docs/upstream/toke-issues.md T-2. *)
f=datehintfor(ct:$coltype):str{
  <mt ct {
    $datecol:v " [date?]";
    $intcol:v "";
    $floatcol:v "";
    $strcol:v "";
    $boolcol:v "";
    $unknowncol:v ""
  }
};

f=totoonschema(profile:$datasetprofile):str{
  let rowcounts=str.fromint(profile.rowcount);
  let colcounts=str.fromint(profile.colcount);
  let header=str.concat(
    "SCHEMA:";
    str.concat(
      profile.name;
      str.concat(
        " rows:";
        str.concat(
          rowcounts;
          str.concat(" cols:";colcounts)
        )
      )
    )
  );
  let collines=mut.@();
  lp(let i=0;i<profile.columns.len;i=i+1){ let cp=profile.columns.get(i);
    let types=coltypetostr(cp.coltype);
    (* NC1.2. No sample values at all. T3.3 suppressed them only for PII candidates, so every
       other column still put its first three values into the one artefact whose purpose is
       to describe data without disclosing it. Name, type, null rate and distinct count are
       what a model needs, and none of them is a value. *)
    let samplepart="";
    let nullss=mut."0%";
    if(cp.nullpct==0.0){}el{
      nullss=str.concat(str.fromfloat(cp.nullpct);"%")
    };
    let uniqs=str.fromint(cp.uniquecount);
    let piipart=mut."";
    if(cp.ispiicandidate){piipart=" [PII]"}el{};
      let datehint=datehintfor(cp.coltype);
    let suffix=mut.datehint;
    if(cp.ispiicandidate){suffix=piipart}el{};
    collines=collines.push(str.concat(
      cp.name;
      str.concat(
        ":";
        str.concat(
          types;
          str.concat(
            samplepart;
            str.concat(
              " nulls:";
              str.concat(
                nullss;
                str.concat(
                  " uniq:";
                  str.concat(uniqs;suffix)
                )
              )
            )
          )
        )
      )
    ))
  };
  let colblock=str.join("
";collines);
  <str.concat(header;str.concat("
";colblock))
};

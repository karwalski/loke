m=core.optimiser.llmlingua;

i=t:shared.types;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;

t=$compressresult{
  original:str;
  compressed:str;
  origintokens:u32;
  compressedtokens:u32;
  actualratio:f64;
  savingspct:f64
};

t=$llmlinguaclient{
  baseurl:str
};

f=new(baseurl:str):$llmlinguaclient{
  <$llmlinguaclient{baseurl:baseurl}
};

f=isavailable(client:$llmlinguaclient):bool{
  let url=str.concat(client.baseurl;"/health");
  let result=http.gettimeout(url;2000);
  mt result {
    $httperr:e false;
    $ok:body true
  }
};

f=buildcompressresult(original:str;obj:i64):$compressresult!$lokeerr{
  let compressed=json.str(obj;"compressed_prompt");
  let origintokensi64=json.i64(obj;"origin_tokens");
  let compressedtokensi64=json.i64(obj;"compressed_tokens");
  let origintokens=origintokensi64 as u32;
  let compressedtokens=compressedtokensi64 as u32;
  let savingspct=mut.0.0;
  if(origintokens=0){}el{
    savingspct=(1.0-(compressedtokens as f64/origintokens as f64))*100.0
  };
  let actualratio=mut.0.0;
  if(origintokens=0){}el{
    actualratio=compressedtokens as f64/origintokens as f64
  };
  let result=$compressresult{
    original:original;
    compressed:compressed;
    origintokens:origintokens;
    compressedtokens:compressedtokens;
    actualratio:actualratio;
    savingspct:savingspct
  };
  <$ok(result)
};

f=parsecompressresponse(original:str;raw:str):$compressresult!$lokeerr{
  let parsed=json.dec(raw);
  mt parsed {
    $jsonerr:e $err($networkerr("llmlingua compress: failed to parse JSON response"));
    $ok:obj buildcompressresult(original;obj)
  }
};

f=compressfailed(cid:str):$compressresult!$lokeerr{
  log.error("llmlingua compress: POST /compress failed";"llmlingua";cid);
  <$err($networkerr("llmlingua compress: failed to reach /compress"))
};

f=compressautofailed(cid:str):$compressresult!$lokeerr{
  log.error("llmlingua compress_auto: POST /compress failed";"llmlingua";cid);
  <$err($networkerr("llmlingua compress_auto: failed to reach /compress"))
};

f=compress(client:$llmlinguaclient;prompt:str;targetratio:f64):$compressresult!$lokeerr{
  let url=str.concat(client.baseurl;"/compress");
  let ratios=str.fromfloat(targetratio);
  let bodyp1=str.concat("{\"prompt\":\"";prompt);
  let bodyp2=str.concat(bodyp1;"\",\"ratio\":");
  let body=str.concat(bodyp2;str.concat(ratios;"}"));
  let cid=log.newcorrelationid();
  log.debug(str.concat("llmlingua compress: ratio=";ratios);"llmlingua";cid);
  let result=http.post(url;body;"application/json");
  mt result {
    $httperr:e compressfailed(cid);
    $ok:raw parsecompressresponse(prompt;raw)
  }
};

f=compressauto(client:$llmlinguaclient;prompt:str;maxtokens:u32):$compressresult!$lokeerr{
  let url=str.concat(client.baseurl;"/compress");
  let maxs=str.fromint(maxtokens as i64);
  let bodyp1=str.concat("{\"prompt\":\"";prompt);
  let bodyp2=str.concat(bodyp1;"\",\"target_token\":");
  let body=str.concat(bodyp2;str.concat(maxs;"}"));
  let cid=log.newcorrelationid();
  log.debug(str.concat("llmlingua compress_auto: max_tokens=";maxs);"llmlingua";cid);
  let result=http.post(url;body;"application/json");
  mt result {
    $httperr:e compressautofailed(cid);
    $ok:raw parsecompressresponse(prompt;raw)
  }
};

f=shouldcompress(promptlen:u32;thresholdchars:u32):bool{
  let effectivethreshold=mut.thresholdchars;
  if(thresholdchars=0){
    effectivethreshold=2000
  }el{};
  <promptlen>effectivethreshold
};

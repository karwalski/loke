m=core.optimiser.toontypes;

t=$toonopts{
  maxstrlen:u32;
  abbreviatekeys:bool;
  omitnulls:bool
};
t=$toonvalue{
  $tvnull:i64;
  $tvbool:i64;
  $tvint:i64;
  $tvfloat:i64;
  $tvstr:i64;
  $tvarr:i64;
  $tvobj:i64
};
t=$toonfield{
  key:str;
  value:$toonvalue
};

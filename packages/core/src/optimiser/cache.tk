m=core.optimiser.cache;

i=vs:std.vecstore;
i=inf:models.infer;
i=json:std.json;
i=log:shared.log;
i=t:shared.types;
i=str:std.str;
i=time:std.time;

t=$cacheconfig{
  threshold:f64;
  ttlseconds:i32;
  datadir:str
};

t=$cachehit{
  response:str;
  score:f64;
  ageseconds:i32
};

t=$cachestats{
  hits:i32;
  misses:i32;
  entries:i32;
  evictions:i32
};

t=$cacheresult{
  $none:i64;
  $some:i64
};

f=defaultconfig(datadir:str):$cacheconfig{
  <$cacheconfig{
    threshold:0.92;
    ttlseconds:86400;
    datadir:datadir
  }
};

f=open(cfg:$cacheconfig):i64{
  <vs.open(cfg.datadir)
};

f=collection(store:i64):i64{
  <vs.collection(store;"prompt_cache")
};

f=lookup(col:i64;prompt:str;pool:i64;cfg:$cacheconfig):$cacheresult{
  let embedding=inf.embedtext(pool;prompt);
  let results=vs.search(col;embedding;1;cfg.threshold);
  if(results.len=0){
    <$$none
  }el{
    let top=results.get(0);
    if(top.score<cfg.threshold){
      <$$none
    }el{
      let parsed=json.decode(top.payload);
      mt parsed {
        $ok:p
          let response=json.getstr(p;"response");
          let createdat=json.geti64(p;"created_at");
          let now=time.nowunix();
          let age=now-createdat;
          if(age>cfg.ttlseconds){
            vs.delete(col;top.id);
            log.debug("cache: evicted expired entry";"cache";"");
            $$none
          }el{
            $$some
          };
        $err:e
          log.warn("cache: failed to parse payload";"cache";"");
          $$none
      }
    }
  }
};

f=store(col:i64;prompt:str;response:str;pool:i64):bool{
  let embedding=inf.embedtext(pool;prompt);
  let now=time.nowunix();
  let payload=str.concat(
    str.concat(
      str.concat(
        str.concat("{\"response\":";json.quote(response));
        ",\"created_at\":");
      str.fromi64(now));
    "}");
  let id=str.randhex(16);
  <vs.upsert(col;id;embedding;payload)
};

f=evictexpired(col:i64;ttlseconds:i32):i32{
  let now=time.nowunix();
  let before=now-ttlseconds;
  <vs.deletebefore(col;before)
};

f=formatstats(stats:$cachestats):str{
  str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(
                str.concat("Cache: ";str.fromint(stats.hits));
                " hits / ");
              str.fromint(stats.misses));
            " misses / ");
          str.fromint(stats.entries));
        " entries / ");
      str.fromint(stats.evictions));
    " evicted")
};

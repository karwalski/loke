m=moke.extensions.core;












m=moke.extension.core;
i=hooks:core.extensions.pipelinehooks;
i=gwhooks:core.extensions.gatewayhooks;
i=providers:core.extensions.providerregistry;
i=mokehooks:moke.hooks;
i=mokeprovider:moke.provider;
i=log:std.log;




let ghookregistry    = hooks.newregistry();
let ggwregistry      = gwhooks.newregistry();
let gproviderstore   = providers.newstore();




f=init(ookecfg:$ookecfg):void{
  
  
  
  
  ghookregistry=hooks.register(
    ghookregistry;
    "moke.schema_first";
    hooks.$slotafterner
  );

  
  
  
  let guard=$gwhooks.rulehook{
    id:"moke.raw_data_guard";
    description:"Blocks requests containing raw structured data outside NER coverage";
    severity:"block"
  };
  ggwregistry=gwhooks.register(ggwregistry;guard);

  
  
  
  
  let caps=$providers.providercaps{
    streaming:false;
    toolcalling:false;
    embedding:false;
    maxcontext:8192
  };
  let localprovider=$providers.customprovider{
    id:"moke.local_compute";
    name:"moke Local Compute";
    baseurl:"http://127.0.0.1:11432/internal";
    caps:caps;
    priority:10
  };
  gproviderstore=providers.register(gproviderstore;localprovider);

  
  
  
  
  
  mokehooks.registerafteranonymise(
    "moke.schema_first";
    "moke.hooks.schema_first_hook"
  );

  
  mokeprovider.registerschemafirstprovider();

  
  
  
  mokehooks.registerrulehook(
    "moke.raw_data_guard";
    "moke.hooks.raw_data_guard_hook"
  );

  log.info("moke extension initialised";"moke.extension.core";"system");
  <()
};


f=onshutdown():void{
  log.info("moke extension shutting down";"moke.extension.core";"system");
  <()
};



f=gethookregistry():$hooks.hookregistry{
  <ghookregistry
};

f=getgwregistry():$gwhooks.rulehookregistry{
  <ggwregistry
};

f=getproviderstore():$providers.providerstore{
  <gproviderstore
};

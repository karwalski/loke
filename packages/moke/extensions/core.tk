m=moke.extension.core;
i=hooks:core.extensions.pipelinehooks;
i=gwhooks:core.extensions.gatewayhooks;
i=providers:core.extensions.providerregistry;
i=mokehooks:moke.hooks;
i=mokeprovider:moke.provider;
i=log:std.log;
i=str:std.str;

t=$corestate{
  hookregistry:i64;
  gwregistry:i64;
  providerstore:i64
};

f=newstate():$corestate{
  <$corestate{
    hookregistry:hooks.newregistry();
    gwregistry:gwhooks.newregistry();
    providerstore:providers.newstore()
  }
};

f=init(ookecfg:i64):$corestate{
  let state=newstate();

  let hookregistry=hooks.register(
    state.hookregistry;
    "moke.schema_first";
    $slotafterner
  );

  let guard=$rulehook{
    id:"moke.raw_data_guard";
    description:"Blocks requests containing raw structured data outside NER coverage";
    severity:"block"
  };
  let gwregistry=gwhooks.register(state.gwregistry;guard);

  let caps=$providercaps{
    streaming:false;
    toolcalling:false;
    embedding:false;
    maxcontext:8192
  };
  let localprovider=$customprovider{
    id:"moke.local_compute";
    name:"moke Local Compute";
    baseurl:"http://127.0.0.1:11432/internal";
    caps:caps;
    priority:10
  };
  let providerstore=providers.register(state.providerstore;localprovider);

  mokehooks.registerafteranonymise(
    "moke.schema_first";
    "moke.hooks.schema_first_hook"
  );

  mokeprovider.registerschemafirstprovider();

  mokehooks.registerrulehook(
    "moke.raw_data_guard";
    "moke.hooks.raw_data_guard_hook"
  );

  log.info("moke extension initialised";"moke.extension.core";"system");
  <$corestate{
    hookregistry:hookregistry;
    gwregistry:gwregistry;
    providerstore:providerstore
  }
};


f=onshutdown():void{
  log.info("moke extension shutting down";"moke.extension.core";"system");
  <void
};



f=gethookregistry(state:$corestate):i64{
  <state.hookregistry
};

f=getgwregistry(state:$corestate):i64{
  <state.gwregistry
};

f=getproviderstore(state:$corestate):i64{
  <state.providerstore
};

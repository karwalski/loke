m=page.moke.sysmon;
i=http:std.http;
i=str:std.str;
i=reach:shared.reachability;
i=sysmon:core.monitoring.sysmon;

(* BG1.2. This page measured the machine itself, with its own copy of the ps parsing, and
   wrote cpu_percent, ram_percent, used_ram_mb and free_ram_mb into its answer as the literal
   0, on every machine: plausible zeros, not dashes. It looked for loke by the name
   "ooke-toke", which no loke process has, so the loke entry was zeros too. Measured on
   2026-10-08 against the built server: {"cpu_count":12,"total_ram_mb":16384,"cpu_percent":0,
   "ram_percent":0,"used_ram_mb":0,"free_ram_mb":0,...,"loke":{"pid":0,"cpu":0.0,"ram_mb":0}}
   while the machine was 89% busy with 11 GB in use.

   Now loke's own /sysmon is the answer when loke gives one, because only loke can name its
   own process. When loke does not answer, moke measures the machine through the same module,
   core.monitoring.sysmon, and the loke entry is null: not measured, rather than a process
   using nothing. *)
f=get(req:i64):i64{
  let fromloke=reach.localget("http://127.0.0.1:11430";"/sysmon");
  if(str.startswith(fromloke;"{\"total_ram_mb\":")){ <http.resjson(200;fromloke) }el{};
  <http.resjson(200;sysmon.tojson(sysmon.snapshotof(0)))
};

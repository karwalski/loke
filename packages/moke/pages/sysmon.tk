m=page.moke.sysmon;
i=http:std.http;
i=str:std.str;
i=process:std.process;

f=get(req:i64):i64{
  <http.res.json(200;buildstatsjson())
};

f=buildstatsjson():str{
  let ollamacpu=mut."0";
  let ollamaram=mut."0";
  let lokecpu=mut."0";
  let lokeram=mut."0";
  let totalram=mut."0";
  let cpucount=mut."0";

  let h=mt process.spawn(@("ps";"-eo";"pid,%cpu,rss,comm")) {
    $ok:v v;
    $err:e 0
  };
  mt process.wait(h) {$ok:v v;$err:e 0};
  let out=mt process.stdout(h) {$ok:v v;$err:e ""};
  let lines=str.split(out;"\n");
  lp(let li=0;li<lines.len();li=li+1){
    let line=lines.get(li);
    if(str.contains(line;"ollama")){
      let parts=splitws(line);
      if(parts.len()>3){ollamacpu=parts.get(1);ollamaram=parts.get(2)}el{}
    }el{};
    if(str.contains(line;"ooke-toke")){
      let parts=splitws(line);
      if(parts.len()>3){lokecpu=parts.get(1);lokeram=parts.get(2)}el{}
    }el{}
  };

  let h2=mt process.spawn(@("sysctl";"-n";"hw.memsize")) {
    $ok:v v;
    $err:e 0
  };
  mt process.wait(h2) {$ok:v v;$err:e 0};
  let out2=mt process.stdout(h2) {$ok:v v;$err:e "0"};
  let mb=mt str.parseint(str.trim(out2)) {$ok:v v/1048576;$err:e 0};
  totalram=str.fromint(mb);

  let h3=mt process.spawn(@("sysctl";"-n";"hw.ncpu")) {
    $ok:v v;
    $err:e 0
  };
  mt process.wait(h3) {$ok:v v;$err:e 0};
  let out3=mt process.stdout(h3) {$ok:v v;$err:e "0"};
  cpucount=str.trim(out3);

  let ollamarammb=str.fromint(mt str.parseint(ollamaram) {$ok:v v/1024;$err:e 0});
  let lokerammb=str.fromint(mt str.parseint(lokeram) {$ok:v v/1024;$err:e 0});

  let j1=str.concat("{\"cpu_count\":";cpucount);
  let j2=str.concat(j1;str.concat(",\"total_ram_mb\":";totalram));
  let j3=str.concat(j2;",\"cpu_percent\":0,\"ram_percent\":0,\"used_ram_mb\":0,\"free_ram_mb\":0");
  let j4=str.concat(j3;str.concat(",\"ollama\":{\"pid\":0,\"cpu\":";ollamacpu));
  let j5=str.concat(j4;str.concat(",\"ram_mb\":";ollamarammb));
  let j6=str.concat(j5;str.concat("},\"loke\":{\"pid\":0,\"cpu\":";lokecpu));
  let j7=str.concat(j6;str.concat(",\"ram_mb\":";lokerammb));
  let j8=str.concat(j7;"},\"slm_active\":false,\"slm_model\":null}");
  <j8
};

f=splitws(s:str):@str{
  let parts=str.split(s;" ");
  let result=mut.@(str);
  lp(let pi=0;pi<parts.len();pi=pi+1){
    let p=parts.get(pi);
    if(str.len(str.trim(p))>0){result.push(str.trim(p))}el{}
  };
  <result
};

m=page.moke.sysmon;
i=http:std.http;
i=str:std.str;
i=process:std.process;

f=get(req:i64):i64{
  <http.res.json(200;buildstatsjson())
};

f=buildstatsjson():$str{
  let ollamacpu="0";
  let ollamaram="0";
  let lokecpu="0";
  let lokeram="0";
  let totalram=mut."0";
  let cpucount=mut."0";

  let h=mt process.spawn(@("ps";"-eo";"pid,%cpu,rss,comm")) {
    ok:$handle {
      mt process.wait(handle) {$ok:v {};$err:e {}};
      let out=mt process.stdout(handle) {Ok:v s;$err:e ""};
      let lines=str.split(out;"
");
      lines.each|line{
        if(str.contains(line;"ollama")){
          let parts=splitws(line);
          if(parts.len>=3){ollamacpu=parts.get(1);ollamaram=parts.get(2)}el{};
        }el{};
        if(str.contains(line;"ooke-toke")){
          let parts=splitws(line);
          if(parts.len>=3){lokecpu=parts.get(1);lokeram=parts.get(2)}el{};
        }el{};
      };
      true
    };
    $err:e false
  };

  let h2=mt process.spawn(@("sysctl";"-n";"hw.memsize")) {
    ok:$handle {
      mt process.wait(handle) {$ok:v {};$err:e {}};
      let out=mt process.stdout(handle) {Ok:v s;$err:e "0"};
      let mb=mt str.parseint(str.trim(out)) {ok:$n n/1048576;$err:e 0};
      totalram=str.fromint(mb);
      true
    };
    $err:e false
  };

  let h3=mt process.spawn(@("sysctl";"-n";"hw.ncpu")) {
    ok:$handle {
      mt process.wait(handle) {$ok:v {};$err:e {}};
      let out=mt process.stdout(handle) {Ok:v s;$err:e "0"};
      cpucount=str.trim(out);
      true
    };
    $err:e false
  };

  let ollamarammb=str.fromint(mt str.parseint(ollamaram) {ok:$n n/1024;$err:e 0});
  let lokerammb=str.fromint(mt str.parseint(lokeram) {ok:$n n/1024;$err:e 0});

  <str.concat("{\"cpu_count\":";str.concat(cpucount;
    str.concat(",\"total_ram_mb\":";str.concat(totalram;
    str.concat(",\"cpu_percent\":0,\"ram_percent\":0,\"used_ram_mb\":0,\"free_ram_mb\":0";
    str.concat(",\"ollama\":{\"pid\":0,\"cpu\":";str.concat(ollamacpu;
    str.concat(",\"ram_mb\":";str.concat(ollamarammb;
    str.concat("},\"loke\":{\"pid\":0,\"cpu\":";str.concat(lokecpu;
    str.concat(",\"ram_mb\":";str.concat(lokerammb;
    str.concat("},\"slm_active\":false,\"slm_model\":null";
    "}"))))))))))))
  )
};

f=splitws(s:$str):@$str{
  let parts=str.split(s;" ");
  let result=@str;
  parts.each|p{
    if(str.len(str.trim(p))>0){result=@.push(result;str.trim(p))}el{};
  };
  <result
};

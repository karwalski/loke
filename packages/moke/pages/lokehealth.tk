m=page.moke.lokehealth;
i=http:std.http;
i=tpl:ooke.template;
i=reach:shared.reachability;
i=org:shared.origin;

(* VM1.6h. Both probes were `mt http.get(url) { $ok:v true; $err:e false }` on the
   one-argument GET, with no reachability probe first. Measured at the pin against
   scripts/lib/http_recorder.py, that shape was NOT broken: it answered true for a server
   that answered and false with nothing listening (the one-argument GET answers "" there,
   T-15). They now go through
   shared.reachability.localanswers like every other local health check, which probes the
   port first and needs a body, and the URLs are parameters so a test can point them at a
   recorder. *)
f=statusjsonat(lokeurl:str;ollamaurl:str):str{
  let okstr=mut."false";
  if(reach.localanswers(lokeurl;"")){ okstr="true" }el{};
  let ollamastatus=mut."offline";
  if(reach.localanswers(ollamaurl;"/api/version")){ ollamastatus="running" }el{};
  <"{\"ok\":\(okstr),\"version\":\"0.3.0\",\"ollama\":\"\(ollamastatus)\"}"
};

f=get(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It probes loke and the model server and says whether each is up. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <mt tpl.tplrenderfile("templates/lokehealth.tkt";@("json":statusjsonat("http://127.0.0.1:11430";"http://localhost:11434"));"templates") {
    $ok:h http.res(200;h);
    $err:e http.res(500;"template render failed")
  }
};

m=page.moke.lokehealth;
i=http:std.http;
i=str:std.str;
i=tpl:ooke.template;

f=get(req:i64):i64{
  let lokeok=mut.false;
  let ollamastatus=mut."offline";

  let lokeres=mt http.get("http://127.0.0.1:11430") {
    $ok:v true;
    $err:e false
  };
  if(lokeres){ lokeok=true }el{};

  let ollamares=mt http.get("http://localhost:11434/api/version") {
    $ok:v true;
    $err:e false
  };
  if(ollamares){ ollamastatus="running" }el{};

  let okstr=mut."false";
  if(lokeok){okstr="true"}el{};
  let json=str.concat("{\"ok\":";str.concat(okstr;
    str.concat(",\"version\":\"0.2.0\",\"ollama\":\"";str.concat(ollamastatus;
    "\"}"))));

  <tpl.renderfile("templates/lokehealth.tkt";@("json":json))
};

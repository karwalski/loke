m=page.moke.lokehealth;
i=http:std.http;
i=str:std.str;
i=tpl:ooke.template;

f=get(req:i64):i64{
  let lokeok=mut.false;
  let ollamastatus=mut."offline";

  mt http.get("http://127.0.0.1:11430") {
    $ok:v lokeok=true;
    $err:e ()
  };

  mt http.get("http://localhost:11434/api/version") {
    $ok:v ollamastatus="running";
    $err:e ()
  };

  let json=str.concat("{\"ok\":";str.concat(if(lokeok){"true"}el{"false"};
    str.concat(",\"version\":\"0.3.0\",\"ollama\":\"";str.concat(ollamastatus;
    "\"}"))));

  <tpl.renderfile("templates/lokehealth.tkt";@("json":json))
};

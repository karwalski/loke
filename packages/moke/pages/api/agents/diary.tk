m=page.moke.api.agents.diary;

i=agents:page.moke.api.agents;

(* MK6.5. GET /api/agents/diary?agent_id=..., one agent's run diary. ooke registers one get and
   one post per page file, so getdiary in pages/api/agents.tk had no route; this file is the
   route. *)
f=get(req:i64):i64{
  <agents.getdiary(req)
};

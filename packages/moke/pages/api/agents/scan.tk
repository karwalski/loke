m=page.moke.api.agents.scan;

i=agents:page.moke.api.agents;

(* MK6.5. POST /api/agents/scan, the data-quality scanner. ooke registers one get and one post
   per page file, so postscan in pages/api/agents.tk had no route; this file is the route. *)
f=post(req:i64):i64{
  <agents.postscan(req)
};

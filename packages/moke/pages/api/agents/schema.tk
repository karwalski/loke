m=page.moke.api.agents.schema;

i=agents:page.moke.api.agents;

(* MK6.5. POST /api/agents/schema, the schema-change detector. ooke registers one get and one
   post per page file, so postschema in pages/api/agents.tk had no route; this file is the
   route. *)
f=post(req:i64):i64{
  <agents.postschema(req)
};

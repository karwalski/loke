m=moke.pages.api.upload;





m=page.moke.api.upload;
i=http:std.http;
i=json:std.json;
i=str:std.string;
i=upload:moke.upload;

f=post(req:i64):i64{
  
  
  
  let contentdisp=http.header(req;"content-disposition");
  let filename="uploaded_dataset";

  if(str.len(contentdisp) > 0){
    
    let fnidx=str.indexof(contentdisp;"filename=\"");
    if(fnidx > 0){
      let start=fnidx + 10;
      let rest=str.slice(contentdisp;start;str.len(contentdisp));
      let endidx=str.indexof(rest;"\"");
      if(endidx > 0){
        filename=str.slice(rest;0;endidx)
      }
    }
  };

  
  let qname=http.queryparam(req;"name");
  if(str.len(qname) > 0){ filename=qname };

  
  
  
  let rawtext=req.body;

  if(str.len(str.trim(rawtext)) = 0){
    let errbody="{\"ok\":false,\"error\":\"empty body\",\"col_count\":0,\"row_count\":0,\"headers\":[],\"preview_rows\":[]}";
    <http.res.json(400;errbody)
  };

  
  let opts=upload.defaultopts();
  let result=upload.parsecsv(rawtext;opts);

  if(result.ok = false){
    let errbody=str.concat("{\"ok\":false,\"error\":";
      str.concat(str.jsonencode(result.error);
      ",\"col_count\":0,\"row_count\":0,\"headers\":[],\"preview_rows\":[]}"));
    <http.res.json(422;errbody)
  };

  
  let previewparts=@();
  let pi=0;
  if(pi < result.previewrows.len()){
    let row=result.previewrows.get(pi);
    let cellparts=@();
    let ci=0;
    if(ci < row.len()){
      cellparts.push(str.jsonencode(row.get(ci)));
      ci=ci + 1
    }el{};
    previewparts.push(str.concat("[";str.concat(str.join(cellparts;",");"]")));
    pi=pi + 1
  }el{};
  let previewjson=str.concat("[";str.concat(str.join(previewparts;",");"]"));

  
  let headerparts=@();
  let hi=0;
  if(hi < result.dataset.headers.len()){
    headerparts.push(str.jsonencode(result.dataset.headers.get(hi)));
    hi=hi + 1
  }el{};
  let headersjson=str.concat("[";str.concat(str.join(headerparts;",");"]"));

  
  let displayname=upload.guessname(filename);

  let respbody=str.concat("{\"ok\":true,";
    str.concat("\"filename\":";
    str.concat(str.jsonencode(filename);
    str.concat(",\"display_name\":";
    str.concat(str.jsonencode(displayname);
    str.concat(",\"col_count\":";
    str.concat(str.fromi32(result.colcount);
    str.concat(",\"row_count\":";
    str.concat(str.fromi32(result.rowcount);
    str.concat(",\"headers\":";
    str.concat(headersjson;
    str.concat(",\"preview_rows\":";
    str.concat(previewjson;
    ",\"error\":\"\"}")))))))))));

  <http.res.json(200;respbody)
};

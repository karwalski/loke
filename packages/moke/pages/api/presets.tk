m=page.moke.api.presets;
i=http:std.http;
i=cat:core.policy.presets.catalog;

(* RG1.9. GET /api/presets: every preset in core.policy.presets.registry, with its fields and
   each rule's status, as core.policy.presets.catalog renders it. The governance page builds
   its preset selector, details and rule table from this body and holds no preset data of its
   own, so a preset added to the registry is listed without a template change.

   bodyfor takes the views as a parameter so a test can pass a registry with a preset added or
   a rule reclassified and see this page's body change (the drift guard); get serves the real
   registry. *)
f=bodyfor(views:@$presetview):str{
  <cat.catalogjson(views)
};

f=body():str{
  <bodyfor(cat.registryviews())
};

f=get(req:i64):i64{
  <http.res(200;body())
};

m=moke.pages.api.ml;






m=page.moke.api.ml;
i=http:std.http;
i=json:std.json;
i=str:std.string;
i=engine:moke.ml.engine;
i=proposal:moke.ml.proposal;






f=postrun(req:http.$req):http.$res{
  let body=req.body;

  let kind=json.getstr(body;mt "kind") {
    $ok:v v;
    $err: ""
  };
  let optsraw=json.getobj(body;mt "opts") {
    $ok:v v;
    $err: "{}"
  };
  let datasetname=json.getstr(body;mt "dataset_name") {
    $ok:v v;
    $err: ""
  };

  if str.eq(kind;""){
    <http.res.err(400;"missing required field: kind")
  };

  
  
  
  let headers=json.getstrarray(body;mt "headers") {
    $ok:v v;
    $err: @()
  };
  let rowsjson=json.getstr(body;mt "rows_json") {
    $ok:v v;
    $err: "[]"
  };
  let rows=mt json.parse2dstrarray(rowsjson) {
    $ok:v v;
    $err: @()
  };

  
  let respbody="";

  if str.eq(kind;"kmeans"){
    let kstr=json.getstr(optsraw;mt "k") { $ok:v v; $err: "4" };
    let maxiterstr=json.getstr(optsraw;mt "max_iter") { $ok:v v; $err: "100" };
    let k=4;
    let maxiter=100;
    if str.isnumeric(kstr){ k=str.parsei32(kstr) };
    if str.isnumeric(maxiterstr){ maxiter=str.parsei32(maxiterstr) };
    let colnames=json.getstrarray(optsraw;mt "columns") {
      $ok:v v;
      $err: @()
    };
    let opts=engine.$kmeansopts{
      k=k;
      maxiter=maxiter;
      columns=colnames
    };
    let result=engine.kmeans(headers;rows;opts);
    respbody=str.concat("{";
      str.concat("\"ok\":true,\"kind\":\"kmeans\",";
      str.concat("\"k\":";
      str.concat(str.fromi32(result.k);
      str.concat(",\"iterations\":";
      str.concat(str.fromi32(result.iterations);
      str.concat(",\"inertia\":";
      str.concat(str.fromf32(result.inertia);
      str.concat(",\"assignments\":";
      str.concat(json.encodei32array(result.assignments);
      "}")))))))))
  };

  if str.eq(kind;"zscore"){
    let column=json.getstr(optsraw;mt "column") { $ok:v v; $err: "" };
    let threshstr=json.getstr(optsraw;mt "threshold") { $ok:v v; $err: "3.0" };
    let threshold=3.0;
    if str.isfloat(threshstr){ threshold=str.tofloat(threshstr) };
    let opts=engine.$anomalyopts{
      column=column;
      threshold=threshold;
      method="zscore"
    };
    let result=engine.zscoreanomalies(headers;rows;opts);
    respbody=str.concat("{";
      str.concat("\"ok\":true,\"kind\":\"zscore\",";
      str.concat("\"column\":";
      str.concat(str.jsonencode(result.column);
      str.concat(",\"method\":\"zscore\",\"threshold\":";
      str.concat(str.fromf32(result.threshold);
      str.concat(",\"anomaly_count\":";
      str.concat(str.fromi32(result.anomalies.len());
      "}"))))))));
  };

  if str.eq(kind;"iqr"){
    let column=json.getstr(optsraw;mt "column") { $ok:v v; $err: "" };
    let threshstr=json.getstr(optsraw;mt "threshold") { $ok:v v; $err: "1.5" };
    let threshold=1.5;
    if str.isfloat(threshstr){ threshold=str.tofloat(threshstr) };
    let opts=engine.$anomalyopts{
      column=column;
      threshold=threshold;
      method="iqr"
    };
    let result=engine.iqranomalies(headers;rows;opts);
    respbody=str.concat("{";
      str.concat("\"ok\":true,\"kind\":\"iqr\",";
      str.concat("\"column\":";
      str.concat(str.jsonencode(result.column);
      str.concat(",\"method\":\"iqr\",\"threshold\":";
      str.concat(str.fromf32(result.threshold);
      str.concat(",\"anomaly_count\":";
      str.concat(str.fromi32(result.anomalies.len());
      "}"))))))));
  };

  if str.eq(kind;"correlation"){
    let results=engine.correlationmatrix(headers;rows);
    let pairsparts=@();
    let ri=0;
    if(ri < results.len()){
      let r=results.get(ri);
      let part=str.concat("{\"col_a\":";
        str.concat(str.jsonencode(r.cola);
        str.concat(",\"col_b\":";
        str.concat(str.jsonencode(r.colb);
        str.concat(",\"pearson_r\":";
        str.concat(str.fromf32(r.pearsonr);
        str.concat(",\"strength\":";
        str.concat(str.jsonencode(r.strength);
        "}")))))));
      pairsparts.push(part);
      ri=ri + 1
    }{};
    respbody=str.concat("{\"ok\":true,\"kind\":\"correlation\",\"pairs\":[";
      str.concat(str.join(pairsparts;",");
      "]}"))
  };

  if str.len(respbody) == 0{
    <http.res.err(400;str.concat("unknown kind: ";kind))
  };

  <http.res.json(200;respbody)
};





f=postpropose(req:http.$req):http.$res{
  let body=req.body;

  let schematoon=json.getstr(body;mt "schema_toon") {
    $ok:v v;
    $err: ""
  };
  let numcols=json.getstrarray(body;mt "num_cols") {
    $ok:v v;
    $err: @()
  };
  let catcols=json.getstrarray(body;mt "cat_cols") {
    $ok:v v;
    $err: @()
  };

  if str.eq(schematoon;"") && numcols.len() == 0 && catcols.len() == 0{
    <http.res.err(400;"at least one of schema_toon, num_cols, or cat_cols is required")
  };

  let result=proposal.fromschema(schematoon;numcols;catcols);

  
  let suggestionparts=@();
  let si=0;
  if(si < result.suggestions.len()){
    let s=result.suggestions.get(si);
    let coljson=json.encodestrarray(s.columns);
    let part=str.concat("{\"kind\":";
      str.concat(str.jsonencode(s.kind);
      str.concat(",\"title\":";
      str.concat(str.jsonencode(s.title);
      str.concat(",\"description\":";
      str.concat(str.jsonencode(s.description);
      str.concat(",\"columns\":";
      str.concat(coljson;
      str.concat(",\"params\":";
      str.concat(str.jsonencode(s.params);
      str.concat(",\"rationale\":";
      str.concat(str.jsonencode(s.rationale);
      "}")))))))))));
    suggestionparts.push(part);
    si=si + 1
  }{};

  let respbody=str.concat("{\"ok\":true,\"source\":";
    str.concat(str.jsonencode(result.source);
    str.concat(",\"suggestions\":[";
    str.concat(str.join(suggestionparts;",");
    "]}"))));

  <http.res.json(200;respbody)
};

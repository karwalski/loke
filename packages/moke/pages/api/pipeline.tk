m=moke.pages.api.pipeline;






m=page.moke.api.pipeline;
i=http:std.http;
i=json:std.json;
i=str:std.string;
i=hooks:moke.hooks;
i=compute:moke.compute;
i=consolelog:moke.consolelog;

f=post(req:i64):i64{
  let body=req.body;

  
  let prompt=json.getstr(body;mt "prompt") {
    $ok:v v;
    $err: ""
  };
  let model=json.getstr(body;mt "model") {
    $ok:v v;
    $err: ""
  };
  let sessionid=json.getstr(body;mt "session_id") {
    $ok:v v;
    $err: "unknown"
  };
  let datasetname=json.getstr(body;mt "dataset_name") {
    $ok:v v;
    $err: "dataset"
  };

  if(str.eq(prompt;""){
    <http.res.err(400;"missing required field: prompt")
  };

  
  let clog=consolelog.newsession(sessionid);

  
  let t0=std.nowms();
  let hookresult=hooks.applyschemafirst(prompt;datasetname);
  let t1=std.nowms();

  let schemafirst=hookresult.rawdatadetected;
  let effectiveprompt=hookresult.transformed;

  if(schemafirst{
    clog=consolelog.append(clog;"schema_extract";"ok";
      str.concat("raw data replaced with schema profile — ";
        str.concat(str.fromi32(hookresult.profile.colcount);" columns"));
      str.toi32(str.fromi64(t1 - t0)));
    clog=consolelog.append(clog;"profile";"ok";
      str.concat(str.fromi32(hookresult.profile.rowcount);" rows profiled");
      0)
  }else{
    clog=consolelog.append(clog;"schema_extract";"skip";
      "no raw tabular data detected in prompt";
      str.toi32(str.fromi64(t1 - t0)))
  };

  
  let upstreambody="{";
  upstreambody=str.concat(upstreambody;str.concat("\"text\":";str.jsonencode(effectiveprompt)));
  upstreambody=str.concat(upstreambody;",\"system_prompt\":\"\"");
  upstreambody=str.concat(upstreambody;",\"tolerance\":\"instant\"");
  upstreambody=str.concat(upstreambody;",\"mode\":\"chat\"");
  if(str.len(model) > 0{
    upstreambody=str.concat(upstreambody;str.concat(",\"model\":";str.jsonencode(model)))
  };
  upstreambody=str.concat(upstreambody;"}");

  clog=consolelog.append(clog;"llm_call";"ok";
    str.concat("forwarding to loke pipeline — model=";
      if(str.len(model) > 0{ model }else{ "auto" });
    0);

  let t2=std.nowms();
  let upstreamres=http.post("http://127.0.0.1:11430/api/pipeline";
    "application/json";upstreambody);
  let t3=std.nowms();
  let upstreamms=str.toi32(str.fromi64(t3 - t2));

  if(!$http.ok(upstreamres){
    clog=consolelog.append(clog;"response";"error";
      str.concat("loke pipeline returned HTTP ";str.fromi32(http.status(upstreamres)));
      upstreamms);
    let errbody="{";
    errbody=str.concat(errbody;"\"ok\":false");
    errbody=str.concat(errbody;str.concat(",\"error\":";
      str.jsonencode(str.concat("upstream error: HTTP ";
        str.fromi32(http.status(upstreamres))))));
    errbody=str.concat(errbody;str.concat(",\"schema_first\":";
      if(schemafirst{ "true" }else{ "false" }));
    errbody=str.concat(errbody;",\"raw_data_detected\":false");
    errbody=str.concat(errbody;str.concat(",\"console_log\":";
      consolelog.tojson(clog)));
    errbody=str.concat(errbody;"}");
    <http.res.json(502;errbody)
  };

  clog=consolelog.append(clog;"response";"ok";
    "loke pipeline response received";upstreamms);

  
  let upstreamjson=http.body(upstreamres);

  
  let base=str.trim(upstreamjson);
  let baselen=str.len(base);
  let respbody=base;
  if(baselen > 1{
    
    let inner=str.slice(base;0;baselen - 1);
    respbody=str.concat(inner;",");
    respbody=str.concat(respbody;str.concat("\"schema_first\":";
      if(schemafirst{ "true" }else{ "false" }));
    respbody=str.concat(respbody;str.concat(",\"raw_data_detected\":";
      if(schemafirst{ "true" }else{ "false" }));
    respbody=str.concat(respbody;str.concat(",\"console_log\":";
      consolelog.tojson(clog)));
    respbody=str.concat(respbody;"}")
  };

  <http.res.json(200;respbody)
};

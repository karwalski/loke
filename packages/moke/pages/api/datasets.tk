m=page.moke.api.datasets;

i=http:std.http;
i=json:std.json;
i=str:std.string;
i=registry:moke.data.registry;
i=profiler:moke.profiler;

f=post(req:i64):i64{
  let body=req.body;
  let id=mt json.getstr(body;"id") {
    $ok:v v;
    $err:e ""
  };

  if(str.len(str.trim(id)) = 0){
    <http.res.err(400;"{\"ok\":false,\"error\":\"missing required field: id\"}")
  };

  let ds=registry.getdataset(id);

  if(str.len(ds.name) = 0){
    let err=str.concat("{\"ok\":false,\"error\":";
      str.concat(str.jsonencode(str.concat("dataset not found: ";id));
      "}"));
    <http.res.json(404;err)
  };

  let headersjson=json.encodestrarray(ds.headers);

  let rowparts=mut.@(str);
  lp(let ri=0;ri<ds.rows.len();ri=ri+1){
    let row=ds.rows.get(ri);
    let cellparts=mut.@(str);
    lp(let ci=0;ci<row.len();ci=ci+1){
      cellparts=cellparts.push(str.jsonencode(row.get(ci)))
    };
    rowparts=rowparts.push(str.concat("[";str.concat(str.join(cellparts;",");"]")))
  };
  let rowsjson=str.concat("[";str.concat(str.join(rowparts;",");"]"));

  let prof=profiler.profile(ds.headers;ds.rows;ds.name);

  let statparts=mut.@(str);
  lp(let si=0;si<prof.stats.len();si=si+1){
    let s=prof.stats.get(si);
    let samplejson=json.encodestrarray(s.sample);
    let ispiistr=mut."false";
    if(s.ispiicandidate){ispiistr="true"}el{};
    let stat=str.concat("{\"name\":";
      str.concat(str.jsonencode(s.name);
      str.concat(",\"inferred_type\":";
      str.concat(str.jsonencode(s.inferredtype);
      str.concat(",\"is_pii_candidate\":";
      str.concat(ispiistr;
      "}"))))));
    statparts=statparts.push(stat)
  };

  let profilejson=str.concat("{\"dataset_name\":";
    str.concat(str.jsonencode(prof.datasetname);
    str.concat(",\"row_count\":";
    str.concat(str.fromi32(prof.rowcount);
    str.concat(",\"col_count\":";
    str.concat(str.fromi32(prof.colcount);
    str.concat(",\"pii_col_count\":";
    str.concat(str.fromi32(prof.piicolcount);
    str.concat(",\"stats\":[";
    str.concat(str.join(statparts;",");
    "]}"))))))))));

  let resp=str.concat("{\"ok\":true,\"id\":";
    str.concat(str.jsonencode(id);
    str.concat(",\"name\":";
    str.concat(str.jsonencode(ds.name);
    str.concat(",\"col_count\":";
    str.concat(str.fromi32(ds.headers.len());
    str.concat(",\"row_count\":";
    str.concat(str.fromi32(ds.rows.len());
    str.concat(",\"headers\":";
    str.concat(headersjson;
    str.concat(",\"rows\":";
    str.concat(rowsjson;
    str.concat(",\"profile\":";
    str.concat(profilejson;
    "}"))))))))))))));

  <http.res.json(200;resp)
};

m=page.moke.api.routing;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=routing:moke.routingexplainer;
i=tiers:moke.tiervisualiser;
i=rq:moke.routingrequest;
i=time:std.time;
i=jx:shared.jsonobj;

(* http.res(status;body), not http.res.json. A three-segment stdlib member name is lowered by
   this toolchain as a call to a BARE global named after its last segment, so it never reaches
   std.http at all. Measured this session at the pinned commit: http.res.json emits a reference
   to an undefined `_json` and the link fails; http.res.ok wants `_ok`, http.res.bad wants
   `_bad`. Worse, http.res.err resolves to libc's err(3) — a program calling
   http.res.err(400;"missing field") printed the message to stderr through err(3) and EXITED the
   process with status 144, which is 400 & 0xff — so every 4xx this API returned would have
   killed the moke server. http.res(status;body) is the two-argument form the migrated browser tree
   uses throughout; it links and runs. Filed as T-34. *)


(* json.dec once, then the typed json.str, not json.getstr. json.getstr is one of the ~50 names
   std.json declares `(i64, i64) -> i64`; they read a different representation and, given raw
   request text, dereference its first word as a pointer — measured this session, a program
   calling json.getstr on a str exits 139, SIGSEGV. The arms are also labelled $ok / $jsonerr
   with $ok first, because mt binds a result's arms by POSITION and not by label (T-31), so a
   bare `ok` / `err` arm list says nothing about which arm is which. *)
f=post(req:i64):i64{
  (* http.reqbody(req), not the `body` field of req. std.http declares five structs and three of
     them carry a `body` at a different offset (req, res, httpreq, httpresp), and `req` here is an
     i64 handle whose type the checker cannot establish — so the field access is E4034 at codegen,
     a stage --check never reaches. http.reqbody is declared (i64) -> str for exactly this:
     "extract body from raw req pointer in handler". *)
  let obj=mt json.dec(http.reqbody(req)) {
    $ok:o o;
    $jsonerr:e jx.emptyobj()
  };

  let prompt=mt json.str(obj;"prompt") {
    $ok:v v;
    $jsonerr:e ""
  };
  let sensitivity=mt json.str(obj;"sensitivity") {
    $ok:v v;
    $jsonerr:e "PUBLIC"
  };
  let tolerance=mt json.str(obj;"tolerance") {
    $ok:v v;
    $jsonerr:e "instant"
  };
  let modelid=mt json.str(obj;"model_id") {
    $ok:v v;
    $jsonerr:e "llama3.2:3b"
  };

  (* LS1.4a. `prompt`, `sensitivity` and `tolerance` now reach the answer, through loke's
     router modules (moke.routingrequest): the intent is classifyfast's on the prompt, the
     sensitivity is the caller's level raised by the prompt's content, and the tier follows
     the tolerance. They were read and dropped: the intent was data_analysis / 0.85 for every
     prompt and the tier interactive for every tolerance. A tolerance or sensitivity the
     router does not know is refused with 400 rather than quietly treated as the default. *)
  if(!rq.toleranceknown(tolerance)){
    <http.res(400;"{\"ok\":false,\"error\":\"tolerance must be instant, patient or background\"}")
  }el{};
  if(!rq.sensitivityknown(sensitivity)){
    <http.res(400;"{\"ok\":false,\"error\":\"sensitivity must be PUBLIC, INTERNAL, CONFIDENTIAL or RESTRICTED\"}")
  }el{};
  let ri=rq.inputs(prompt;sensitivity;tolerance);

  (* str.concat throughout, not `+`. Every one of the six `+` joins in this function was an
     E4031: one side is a declared str and the other is a call whose return type the checker
     cannot resolve, and `+` demands both sides agree. ADR-0004 says str.concat or interpolation.
     time.nowms rather than std.nowms, and str.fromint rather than str.fromint64: there is no
     `std` module interface and no tk_std_nowms_w symbol in the runtime — measured, std.nowms()
     type-checks and then fails to LINK — while str.fromint64 is one of std.str's untyped
     `(i64) -> i64` names and str.fromint is declared (i64) -> str. *)
  let reason="\(ri.sensitivityrouting) (sensitivity: \(ri.sensitivity), tier: \(ri.tier)) => \(modelid)";
  let decision=mut.routing.newdecision(str.concat("req-";str.fromint(time.nowms())));
  decision=routing.withintent(decision;ri.intent;ri.confidence;ri.method);
  decision=routing.withsensitivity(decision;ri.sensitivity;ri.sensitivityrouting);
  decision=routing.withtolerance(decision;ri.tolerance);
  decision=routing.withselection(decision;modelid;"ollama";true;ri.tier;reason;0.0);

  (* NOT FIXED: the model is the caller's model_id and the provider is always local ollama,
     because choosing one needs core.router.router.routerequest and a model registry, which
     moke does not hold; and the hardware summary is a fixed Apple M-series string, not a
     measurement of this machine. *)
  let tiervisual=tiers.buildvisual(ri.tier;"Apple M-series  16GB+ unified memory");

  (* GA1.5c: `cost` was moke.costcomparison over a fixed 500 tokens in and 200 out, whatever
     the prompt, with the whole cloud price counted as saved for a local run. No token is
     counted before dispatch, so the answer says the cost is not measured; loke reports the
     provider's tokens and cost with each /api/pipeline reply. *)
  let costnote="{\"measured\":false,\"reason\":\"not measured: no tokens are counted before dispatch\"}";

  let resp=mut."{";
  resp="\(resp)\"routing\":\(routing.tojson(decision))";
  resp="\(resp),\"tiers\":\(tiers.tojson(tiervisual))";
  resp=str.concat(resp;",\"cost\":\(costnote)");
  resp=str.concat(resp;"}");

  <http.res(200;resp)
};


m=page.moke.api.routing;
i=http:std.http;
i=json:std.json;
i=str:std.string;
i=routing:moke.routingexplainer;
i=tiers:moke.tiervisualiser;
i=companion:moke.companionsimulator;
i=cost:moke.costcomparison;

f=post(req:i64):i64{
  let body=req.body;

  let prompt=mt json.getstr(body;"prompt") {
    ok:$v v;
    $err:e ""
  };
  let sensitivity=mt json.getstr(body;"sensitivity") {
    ok:$v v;
    $err:e "PUBLIC"
  };
  let tolerance=mt json.getstr(body;"tolerance") {
    ok:$v v;
    $err:e "instant"
  };
  let modelid=mt json.getstr(body;"model_id") {
    ok:$v v;
    $err:e "llama3.2:3b"
  };

  let decision=mut.routing.newdecision("req-" + str.fromint64(std.nowms()));
  decision=routing.withintent(decision;"data_analysis";0.85;"keyword");
  decision=routing.withsensitivity(decision;sensitivity;"prefer-local");
  decision=routing.withselection(decision;modelid;"ollama";true;"interactive";
    "local-only (sensitivity: " + sensitivity + ", tier: interactive) => " + modelid;
    0.0);

  let tiervisual=tiers.buildvisual("interactive";"Apple M-series  16GB+ unified memory");

  let comparison=cost.compute(modelid;500;200;true);

  let resp=mut."{";
  resp=str.concat(resp;"\"routing\":" + routing.tojson(decision));
  resp=str.concat(resp;",\"tiers\":" + tiers.tojson(tiervisual));
  resp=str.concat(resp;",\"cost\":" + cost.comparisontojson(comparison));
  resp=str.concat(resp;"}");

  <http.res.json(200;resp)
};

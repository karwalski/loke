
m=page.moke.api.mcp;
i=http:std.http;
i=json:std.json;
i=str:std.string;
i=toolpanel:moke.mcp.toolpanel;
i=broker:moke.mcp.brokerstatus;
i=memory:moke.mcp.memorydemo;

f=initstate():i64{
  let gtoolstate=mut.toolpanel.newpanelstate();
  let gbrokerstate=mut.broker.newpanelstate();
  let gmemorystate=mut.memory.newstate("~/.loke/memory");
  let demoservers=broker.demoservers();
  let dsi=mut.0;
  lp(let lv=0;dsi < demoservers.len();lv=lv){
    gbrokerstate=broker.addserver(gbrokerstate;demoservers.get(dsi));
    dsi=dsi + 1
  };
  gbrokerstate.$initialized=true;
  <0
};

f=gettools(req:i64):i64{
  let resp=toolpanel.panelstatetojson(gtoolstate);
  <http.res.json(200;resp)
};


f=postinvoke(req:i64):i64{
  let body=req.body;
  let toolname=mt json.getstr(body;"tool_name") {
    ok:v v;
    err:e ""
  };
  let args=mt json.getraw(body;"args") {
    ok:v v;
    err:e "{}"
  };

  if(str.len(toolname) = 0){
    <http.res.err(400;"{\"ok\":false,\"error\":\"tool_name is required\"}")
  };

  let inv=toolpanel.invoketool(toolname;args;"";"";
    str.fromi64(str.timestampms()));
  gtoolstate=toolpanel.addinvocation(gtoolstate;inv);

  let resp=toolpanel.invocationtojson(inv);
  <http.res.json(200;resp)
};


f=getbroker(req:i64):i64{
  let resp=broker.panelstatetojson(gbrokerstate);
  <http.res.json(200;resp)
};


f=getmemory(req:i64):i64{
  let resp=memory.statetojson(gmemorystate);
  <http.res.json(200;resp)
};


f=postmemory(req:i64):i64{
  let body=req.body;
  let toolname=mt json.getstr(body;"tool_name") {
    ok:v v;
    err:e ""
  };
  let args=mt json.getraw(body;"args") {
    ok:v v;
    err:e "{}"
  };

  if(str.len(toolname) = 0){
    <http.res.err(400;"{\"ok\":false,\"error\":\"tool_name is required\"}")
  };

  let inv=memory.invoke(gmemorystate;toolname;args;
    str.fromi64(str.timestampms()));
  gmemorystate=memory.recordinvocation(gmemorystate;inv);

  let resp=memory.invocationtojson(inv);
  <http.res.json(200;resp)
};

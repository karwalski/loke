m=page.moke.api.session;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=reach:shared.reachability;

(* NC1.13. POST /api/session on moke: asks loke for a session and hands it back.

   loke now issues the session ids its artifact and pipeline routes accept, and refuses any it
   did not issue. moke's pages run on moke's own origin, and loke refuses a request whose Origin
   is foreign (GA2.6), so a page cannot ask loke directly. This route asks on the page's behalf,
   server to server on loopback, and returns loke's answer unchanged. It adds nothing of its
   own: the id is loke's, and moke keeps no copy. A caller then sends it as `session_id` to
   moke's /api/pipeline, which forwards it to loke, where it is checked.

   A page that sends no session_id is dispatched with none, recorded as `none`, exactly as
   before. No session is invented on its behalf. *)

f=errjson(status:i64;message:str):i64{
  <http.res(status;"{\"ok\":false,\"error\":\(json.enc(message))}")
};

f=post(req:i64):i64{
  let answer=reach.localpost("http://127.0.0.1:11430";"/api/session";"{}");
  if(str.contains(answer;"\"session_id\":\"nc-")){ <http.res(200;answer) }el{};
  <errjson(502;"loke at 127.0.0.1:11430 issued no session")
};

m=page.moke.api.feedback;
i=http:std.http;
i=json:std.json;
i=str:std.string;

f=post(req:i64):i64{
  let body=req.body;

  let rating=mt json.getstr(body;"rating") {
    $ok:v v;
    $err:e ""
  };
  let featurearea=mt json.getstr(body;"feature_area") {
    $ok:v v;
    $err:e "chat_response"
  };
  let requestid=mt json.getstr(body;"request_id") {
    $ok:v v;
    $err:e ""
  };
  let modelid=mt json.getstr(body;"model_id") {
    $ok:v v;
    $err:e ""
  };
  let dataset=mt json.getstr(body;"dataset") {
    $ok:v v;
    $err:e ""
  };
  let comment=mt json.getstr(body;"comment") {
    $ok:v v;
    $err:e ""
  };

  if(str.eq(rating;"")){
    <http.res.err(400;"missing required field: rating")
  };

  if(!str.eq(rating;"thumbs_up") && !str.eq(rating;"thumbs_down")){
    <http.res.err(400;"rating must be thumbs_up or thumbs_down")
  };

  let id=str.concat("fb_";str.fromi64(std.nowms()));

  let resp=mut."{";
  resp=str.concat(resp;"\"ok\":true");
  resp=str.concat(resp;str.concat(",\"id\":";str.jsonencode(id)));
  resp=str.concat(resp;str.concat(",\"rating\":";str.jsonencode(rating)));
  resp=str.concat(resp;str.concat(",\"request_id\":";str.jsonencode(requestid)));
  resp=str.concat(resp;"}");

  <http.res.json(200;resp)
};

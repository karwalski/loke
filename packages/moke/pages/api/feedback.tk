m=page.moke.api.feedback;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=jx:shared.jsonobj;
i=rec:moke.feedbackrecord;
i=org:shared.origin;

(* http.res(status;body), not http.res.json. A three-segment stdlib member name is lowered by
   this toolchain as a call to a BARE global named after its last segment, so it never reaches
   std.http at all. Measured this session at the pinned commit: http.res.json emits a reference
   to an undefined `_json` and the link fails; http.res.ok wants `_ok`, http.res.bad wants
   `_bad`. Worse, http.res.err resolves to libc's err(3) — a program calling
   http.res.err(400;"missing field") printed the message to stderr through err(3) and EXITED the
   process with status 144, which is 400 & 0xff — so every 4xx this API returned would have
   killed the moke server. http.res(status;body) is the two-argument form the migrated browser tree
   uses throughout; it links and runs. Filed as T-34. *)

(* errjson, because http.res.err does not exist. See the note on http.res above: the
   three-segment name binds to libc's err(3) and terminates the process with the status code
   as its exit status. This builds the same {"ok":false,"error":...} envelope the success
   paths in this file use, with jx.escape supplying the quotes and the escaping (MK6.13:
   json.enc, which this used, leaves a newline or a tab raw). *)
f=errjson(status:i64;message:str):i64{
  <http.res(status;"{\"ok\":false,\"error\":\(jx.escape(message))}")
};

(* json.dec once, then the TYPED json.str accessor, because json.getstr — which every field
   below used to go through — is one of roughly fifty names std.json declares as
   `(i64, i64) -> i64`. They operate on a different representation, reached through
   json.parse, and a one-field struct shares an ABI with a handle, so handing one of them a
   `str` compiles, links, and then dereferences the first word of the string as a pointer.
   Measured this session at the pinned toolchain: a program calling
   `json.getstr("{\"rating\":\"thumbs_up\"}";"rating")` exits 139 — SIGSEGV. Every POST to
   this endpoint would have killed the moke server on its first field read. See T-32.

   json.str is one of the eight typed accessors that do work, and it needs a decoded Json
   rather than raw text, hence the single json.dec above it. A body that is not JSON at all
   yields the empty object, so every field falls to its default and the rating check below
   answers 400 — the same answer a caller gets for a body with no rating in it. *)
f=post(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It writes a row into loke's feedback store. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  (* http.reqbody(req), not the `body` field of req. std.http declares five structs and three of
     them carry a `body` at a different offset (req, res, httpreq, httpresp), and `req` here is an
     i64 handle whose type the checker cannot establish — so the field access is E4034 at codegen,
     a stage --check never reaches. http.reqbody is declared (i64) -> str for exactly this:
     "extract body from raw req pointer in handler". *)
  let obj=mt json.dec(http.reqbody(req)) {
    $ok:o o;
    $jsonerr:e jx.emptyobj()
  };

  let rating=mt json.str(obj;"rating") {
    $ok:v v;
    $jsonerr:e ""
  };
  let featurearea=mt json.str(obj;"feature_area") {
    $ok:v v;
    $jsonerr:e "chat_response"
  };
  let requestid=mt json.str(obj;"request_id") {
    $ok:v v;
    $jsonerr:e ""
  };
  let modelid=mt json.str(obj;"model_id") {
    $ok:v v;
    $jsonerr:e ""
  };
  let dataset=mt json.str(obj;"dataset") {
    $ok:v v;
    $jsonerr:e ""
  };
  let comment=mt json.str(obj;"comment") {
    $ok:v v;
    $jsonerr:e ""
  };

  if(str.eq(rating;"")){
    <errjson(400;"missing required field: rating")
  };

  if(!str.eq(rating;"thumbs_up") && !str.eq(rating;"thumbs_down")){
    <errjson(400;"rating must be thumbs_up or thumbs_down")
  };

  (* LS1.4a. The rating is stored, in loke's feedback store (see moke.feedbackrecord), and the
     id answered is the stored row's. This handler used to read feature_area, model_id,
     dataset and comment and drop them, generate an id from the clock and answer ok, so a
     rating "recorded" here was recorded nowhere. If the store cannot be opened or written,
     the answer says so with a 503 instead of ok. *)
  let id=rec.save(rating;featurearea;requestid;modelid;dataset;comment);
  if(str.len(id)==0){
    <errjson(503;"feedback could not be stored")
  }el{};

  let resp=mut."{";
  resp=str.concat(resp;"\"ok\":true,\"stored\":true");
  (* json.enc, not str.jsonencode: std.str declares no jsonencode, in the interface or in the
     runtime, so the three calls that used to be here did not compile. jx.escape (MK6.13; json.enc
     leaves a newline raw) returns the value WITH its surrounding quotes — which is
     why there are none in the literals it is concatenated to. *)
  resp="\(resp),\"id\":\(jx.escape(id))";
  resp="\(resp),\"rating\":\(jx.escape(rating))";
  resp="\(resp),\"request_id\":\(jx.escape(requestid))";
  resp=str.concat(resp;"}");

  <http.res(200;resp)
};

m=page.moke.api.mcp.memory;

i=mcp:page.moke.api.mcp;
i=org:shared.origin;

(* MK6.5. GET and POST /api/mcp/memory, the MCP panel's memory demo. ooke registers one get and
   one post per page file, so getmemory and postmemory in pages/api/mcp.tk had no route; this
   file is the route. It is not pages/api/memory.tk, which is moke's own memory API. *)
f=get(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It reads the shared memory-panel log. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <mcp.getmemory(req)
};

f=post(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It runs a memory tool, which writes the memory store. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <mcp.postmemory(req)
};

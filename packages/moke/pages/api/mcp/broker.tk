m=page.moke.api.mcp.broker;

i=mcp:page.moke.api.mcp;
i=org:shared.origin;

(* MK6.5. GET /api/mcp/broker, the MCP broker panel. ooke registers one get and one post per
   page file, so getbroker in pages/api/mcp.tk had no route; this file is the route. *)
f=get(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     Read-only, but every moke API route is guarded unless it says why not. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <mcp.getbroker(req)
};

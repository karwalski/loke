m=page.moke.api.mcp.invoke;

i=mcp:page.moke.api.mcp;
i=org:shared.origin;

(* MK6.5. POST /api/mcp/invoke, the MCP panel's tool invocation. ooke registers one get and one
   post per page file, so postinvoke in pages/api/mcp.tk had no route; this file is the route. *)
f=post(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It runs an MCP tool on the caller's text and logs the call. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <mcp.postinvoke(req)
};

m=page.moke.api.mcp.invoke;

i=mcp:page.moke.api.mcp;

(* MK6.5. POST /api/mcp/invoke, the MCP panel's tool invocation. ooke registers one get and one
   post per page file, so postinvoke in pages/api/mcp.tk had no route; this file is the route. *)
f=post(req:i64):i64{
  <mcp.postinvoke(req)
};

m=page.moke.api.mcp.tools;

i=mcp:page.moke.api.mcp;
i=org:shared.origin;

(* MK6.5. GET /api/mcp/tools, the MCP panel's tool list and invocation log. ooke registers one
   get and one post per page file, so gettools in pages/api/mcp.tk had no route; this file is
   the route. *)
f=get(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It reads the shared tool log. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <mcp.gettools(req)
};

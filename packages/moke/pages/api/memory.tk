m=page.moke.api.memory;
i=http:std.http;
i=json:std.json;
i=str:std.string;
i=std:std;

f=post(req:i64):i64{
  let body=req.body;

  let action=mt json.getstr(body;"action") {
    $ok:v v;
    $err:e "store"
  };

  if(str.eq(action;"store")){
    let wing=mt json.getstr(body;"wing") { $ok:v v; $err:e "work" };
    let hall=mt json.getstr(body;"hall") { $ok:v v; $err:e "general" };
    let room=mt json.getstr(body;"room") { $ok:v v; $err:e "default" };
    let content=mt json.getstr(body;"content") { $ok:v v; $err:e "" };
    let source=mt json.getstr(body;"source") { $ok:v v; $err:e "chat" };

    if(str.eq(content;"")){
      <http.res.err(400;"missing required field: content")
    };

    let id=str.concat("drw_";str.fromi64(std.nowms()));

    let resp=mut."{";
    resp=str.concat(resp;"\"ok\":true");
    resp=str.concat(resp;str.concat(",\"id\":";str.jsonencode(id)));
    resp=str.concat(resp;str.concat(",\"wing\":";str.jsonencode(wing)));
    resp=str.concat(resp;str.concat(",\"hall\":";str.jsonencode(hall)));
    resp=str.concat(resp;str.concat(",\"room\":";str.jsonencode(room)));
    resp=str.concat(resp;"}");

    <http.res.json(200;resp)
  }el{
    if(str.eq(action;"aaak")){
      let text=mt json.getstr(body;"text") { $ok:v v; $err:e "" };
      let mode=mt json.getstr(body;"mode") { $ok:v v; $err:e "compress" };

      let resp="{\"ok\":true,\"mode\":";
      resp=str.concat(resp;str.jsonencode(mode));
      resp=str.concat(resp;"}");
      <http.res.json(200;resp)
    }el{
      <http.res.err(400;"unknown action")
    }
  }
};

f=get(req:i64):i64{
  let resp="{\"ok\":true,\"message\":\"Memory Palace API ready\"}";
  <http.res.json(200;resp)
};

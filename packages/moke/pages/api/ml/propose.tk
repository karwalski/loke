m=page.moke.api.ml.propose;

i=ml:page.moke.api.ml;
i=org:shared.origin;

(* NC1.3 / MK6.5. POST /api/ml/propose. ooke registers one get and one post per page file,
   so postpropose in pages/api/ml.tk had no route at all; this file is the route. *)
f=post(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It sends column names to loke's /api/pipeline, and so to a model. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <ml.postpropose(req)
};

m=page.moke.api.ml.propose;

i=ml:page.moke.api.ml;

(* NC1.3 / MK6.5. POST /api/ml/propose. ooke registers one get and one post per page file,
   so postpropose in pages/api/ml.tk had no route at all; this file is the route. *)
f=post(req:i64):i64{
  <ml.postpropose(req)
};

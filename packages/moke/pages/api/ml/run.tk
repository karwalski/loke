m=page.moke.api.ml.run;

i=ml:page.moke.api.ml;
i=org:shared.origin;

(* MK6.5. POST /api/ml/run: the route postrun in pages/api/ml.tk never had. *)
f=post(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It runs an analysis on whatever rows the caller posts. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <ml.postrun(req)
};

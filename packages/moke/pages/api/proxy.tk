m=page.moke.api.proxy;

i=http:std.http;
i=args:std.args;
i=path:std.path;
i=config:ooke.config;
i=g:moke.proxy.guard;
i=fetch:moke.proxy.fetch;

(* MK19.9 — POST /api/proxy, the one place moke fetches a URL the browser names.

   The connection modules (datagov-source.js, graphql-source.js, openapi-discovery.js,
   url-import.js, auth-methods.js) and the Connections page's Test Connection button send
   their requests here through static/js/moke-proxy.js. Everything is decided in
   moke.proxy.fetch.handle, which the tests call directly; this route only reads the
   request. The policy is always guard.production(): its allowlist is MOKE_PROXY_ALLOW and
   nothing else, and it carries no test override.

   The answer is JSON and says so (http.resjson, application/json): the envelope carries
   upstream text, and served as text/html it was one missed check from a stored XSS
   (independent review, 2026-10-01). *)

(* The port moke serves on, read as the generated server main reads it
   (scripts/build_trees.sh, write_ooke_main): the project directory is argument 1, else
   ".", and its ooke.toml's [server] port; with no readable ooke.toml, 11432. *)
f=serverport():i64{
  let dir=mt args.get(1 as u64) { $ok:v v; $err:e "." };
  <mt config.configload(path.join(dir;"ooke.toml")) { $ok:c c.serverport; $err:e 11432 }
};

f=post(req:i64):i64{
  let host=http.reqheader(req;"host");
  let origin=http.reqheader(req;"origin");
  let site=http.reqheader(req;"sec-fetch-site");
  let ctype=http.reqheader(req;"content-type");
  let r=fetch.handle(serverport();host;origin;site;ctype;http.reqbody(req);g.production());
  <http.resjson(r.code;r.body)
};

m=page.moke.api.models;
i=http:std.http;
i=org:shared.origin;
i=relay:moke.lokerelay;

(* BG1.4. GET /api/models on moke's own origin: loke's model list, relayed unchanged with
   loke's status. The chat, settings and setup pages ask for it at window.LOKE_URL, which is ''
   when moke answers for loke, and moke had no such route, so the request answered 404. *)
f=get(req:i64):i64{
  (* GA2.6, GA2.7: the refusal loke itself makes, before anything is relayed. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let r=relay.getfrom(relay.lokebase();"/api/models");
  <http.res(r.status;r.body)
};

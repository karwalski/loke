m=page.moke.api.health;
i=http:std.http;
i=str:std.str;
i=reach:shared.reachability;
(* shared.log, not std.log. The two call sites below pass (message; module; requestid) —
   the three-argument shape shared.log declares. std.log.info takes TWO arguments,
   (str, [[str]]), so this import was a straight mismatch and the file did not compile.
   Taking the import to shared.log rather than dropping the two extra arguments keeps the
   module tag and the request field, which are what make a log line greppable; std.log
   would have discarded both. *)
i=log:shared.log;
i=org:shared.origin;

(* http.res(status;body), not http.res.json. A three-segment stdlib member name is lowered by
   this toolchain as a call to a BARE global named after its last segment, so it never reaches
   std.http at all. Measured this session at the pinned commit: http.res.json emits a reference
   to an undefined `_json` and the link fails; http.res.ok wants `_ok`, http.res.bad wants
   `_bad`. Worse, http.res.err resolves to libc's err(3) — a program calling
   http.res.err(400;"missing field") printed the message to stderr through err(3) and EXITED the
   process with status 144, which is 400 & 0xff — so every 4xx this API returned would have
   killed the moke server. http.res(status;body) is the two-argument form the migrated browser tree
   uses throughout; it links and runs. Filed as T-34. *)


(* VM1.6h. loke's /api/health body, or "" when nothing usable answered. This was
   `mt http.get(lokeurl) { $ok:v v; $err:e "" }` with no reachability probe first. Measured at
   the pin against scripts/lib/http_recorder.py, that shape was NOT broken: it answered the
   body, and "" with nothing listening (T-15). It now goes through
   shared.reachability.localget like every other local GET, with the base URL a parameter so a
   test can point it at a recorder. *)
f=lokehealthat(lokebase:str):str{
  <reach.localget(lokebase;"/api/health")
};

f=get(req:i64):i64{
  (* BG1.5, GA2.6, GA2.7: loke's own refusal (a foreign Origin, a non-loopback Host), first.
     It relays loke's own health body, which a rebound page could read. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let lokeurl="http://127.0.0.1:11430/api/health";
  let resp=lokehealthat("http://127.0.0.1:11430");
  if(str.len(resp) > 0){
    log.info("loke health: connected";"moke.health";"system");
    <http.res(200;resp)
  }el{
    log.info("loke health: unreachable";"moke.health";"system");
    let fallback="{\"ok\":false,\"moke\":\"0.3.0\",\"loke\":\"unreachable\",\"ollama\":\"unknown\",\"error\":\"loke unreachable at \(lokeurl)\"}";
    <http.res(503;fallback)
  }
};

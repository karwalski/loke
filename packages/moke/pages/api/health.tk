m=page.moke.api.health;
i=http:std.http;
i=str:std.str;
i=log:std.log;

f=get(req:i64):i64{
  let lokeurl="http://127.0.0.1:11430/api/health";
  let resp=mt http.get(lokeurl) {
    $ok:v v;
    $err:e ""
  };
  if(str.len(resp) > 0){
    log.info("loke health: connected";"moke.health";"system");
    <http.res.json(200;resp)
  }el{
    log.info("loke health: unreachable";"moke.health";"system");
    let fallback=str.concat("{\"ok\":false,\"moke\":\"0.2.0\",\"loke\":\"unreachable\",\"ollama\":\"unknown\",\"error\":\"loke unreachable at ";str.concat(lokeurl;"\"}"));
    <http.res.json(503;fallback)
  }
};

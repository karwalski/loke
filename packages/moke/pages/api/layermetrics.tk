m=page.moke.api.layermetrics;
i=http:std.http;
i=str:std.str;
i=org:shared.origin;
i=relay:moke.lokerelay;
i=query:moke.query;

(* F3b.10. GET /api/layermetrics[?window=...] on moke's own origin: loke's per-layer privacy
   metrics (page.api.layermetrics), relayed unchanged with loke's status. The governance page's
   "Privacy layer metrics" section reads it, with the time window its selector names. moke
   computes nothing: every figure is loke's, from the rows loke recorded, and which windows
   exist is loke's to say (it refuses one it does not know).

   The window is passed on only when it is letters and digits, which every window loke knows
   is, so nothing else can be spliced into the path moke asks loke for. Anything else is
   refused here, with 400, before loke is asked. *)

f=plainword(w:str):bool{
  let ok=mut.true;
  lp(let i=0;i<(str.len(w) as i64);i=i+1){
    let c=str.charat(w;i);
    if(!((c>=48 && c<=57) || (c>=97 && c<=122) || (c>=65 && c<=90))){ ok=false }el{}
  };
  <ok
};

(* The path to ask loke for, or "" when the window cannot be passed on. *)
f=lokepath(target:str):str{
  let w=query.value(target;"window");
  if(str.len(w)==0){ <"/api/layermetrics" }el{};
  if(!plainword(w)){ <"" }el{};
  <"/api/layermetrics?window=\(w)"
};

f=get(req:i64):i64{
  (* GA2.6, GA2.7: the refusal loke itself makes, before anything is relayed. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let path=lokepath(http.reqpath(req));
  if(str.len(path)==0){ <http.res(400;"{\"measured\":false,\"error\":\"unknown window: use 24h, 7d, 30d or all\",\"relayed_by\":\"moke\"}") }el{};
  let r=relay.getfrom(relay.lokebase();path);
  <http.res(r.status;r.body)
};

m=page.moke.api.layermetrics;
i=http:std.http;
i=org:shared.origin;
i=relay:moke.lokerelay;

(* F3b.10. GET /api/layermetrics on moke's own origin: loke's per-layer privacy metrics
   (page.api.layermetrics), relayed unchanged with loke's status. The governance page's
   "Privacy layer metrics" section reads it. moke computes nothing: every figure is loke's,
   from the rows loke recorded. *)
f=get(req:i64):i64{
  (* GA2.6, GA2.7: the refusal loke itself makes, before anything is relayed. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let r=relay.getfrom(relay.lokebase();"/api/layermetrics");
  <http.res(r.status;r.body)
};

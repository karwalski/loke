m=page.moke.dashboard;
i=http:std.http;
i=tpl:ooke.template;

f=get(req:i64):i64{
  mt tpl.tplrenderfile("templates/dashboard.tkt"; @();"templates") {
    $ok:h http.res(200;h);
    $err:e http.res(500;"template render failed")
  }
};

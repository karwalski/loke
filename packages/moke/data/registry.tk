m=moke.data.registry;
i=str:std.str;
i=json:std.json;
i=file:std.file;
i=ld:moke.data.loader;
i=compute:moke.compute;

(* Every dataset is looked up in static/data/manifest.json, the one store the browser
   reads too (MK19.1).

   This module used to be a second catalogue. getdataset() dispatched seventeen ids to
   four modules reading data/csv, and listall() repeated their names, sizes and
   sensitivities by hand. Those tables were not the ones the UI showed under the same
   ids: au.medicare here was 30 rows and 26 columns, and 500 and 28 on the landing page.
   listall() had no caller, and its counts were wrong for half its entries (it said 392
   customer rows for a file of 70). Both are gone. A dataset now exists when the
   manifest names it, and is read from the file the manifest points at.

   The id is matched against the manifest and never turned into a path itself, so an id
   from a request cannot name a file outside the store. *)

t=$manifestentry{
  found:bool;
  name:str;
  relpath:str
};

f=notfound():$manifestentry{
  <$manifestentry{ found:false; name:""; relpath:"" }
};

f=manifesttext():str{
  <mt file.read("\(ld.datadir())/manifest.json") {$ok:v v; $err:e ""}
};

(* The manifest's paths are site paths, /static/data/fixtures/x.csv. The loader wants
   them relative to the store, so the prefix comes off. A path without it is not one
   of the store's files and is refused. *)
f=storerelative(sitepath:str):str{
  let prefix="/static/data/";
  if(!str.startswith(sitepath;prefix)){ <"" }el{};
  <mt str.slice(sitepath;str.len(prefix);str.len(sitepath)) {$ok:v v; $err:e ""}
};

f=entryfor(item:$json;id:str):$manifestentry{
  let eid=mt json.str(item;"id") {$ok:v v; $jsonerr:e ""};
  if(!str.eq(eid;id)){ <notfound() }el{};
  let name=mt json.str(item;"name") {$ok:v v; $jsonerr:e id};
  let data=mt json.at(item;"data") {$ok:d d; $jsonerr:e $json{raw:"{}"}};
  let sitepath=mt json.str(data;"path") {$ok:v v; $jsonerr:e ""};
  let rel=storerelative(sitepath);
  if(str.len(rel)==0){ <notfound() }el{};
  <$manifestentry{ found:true; name:name; relpath:rel }
};

f=lookup(id:str):$manifestentry{
  let text=manifesttext();
  if(str.len(text)==0){ <notfound() }el{};
  let doc=mt json.dec(text) {$ok:o o; $jsonerr:e $json{raw:"{}"}};
  let items=mt json.arr(doc;"datasets") {$ok:a a; $jsonerr:e @()};
  lp(let i=0;i<items.len;i=i+1){
    let hit=entryfor(items.get(i);id);
    if(hit.found){ <hit }el{}
  };
  <notfound()
};

f=getdataset(id:str):$dataset{
  let hit=lookup(id);
  if(!hit.found){ <ld.emptydataset("") }el{};
  <ld.loaddataset(hit.name;hit.relpath)
};

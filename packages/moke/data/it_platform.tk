m=moke.data.itplatform;
i=compute:moke.compute;
i=ld:moke.data.loader;

f=getusers():$dataset{
  <ld.loaddataset("wc_users";"it_platform_users.csv")
};

f=getorders():$dataset{
  <ld.loaddataset("wc_orders";"it_platform_orders.csv")
};

f=gettraffic():$dataset{
  <ld.loaddataset("wc_traffic";"it_platform_traffic.csv")
};

f=getincidents():$dataset{
  <ld.loaddataset("wc_incidents";"it_platform_incidents.csv")
};

f=getfeedback():$dataset{
  <ld.loaddataset("wc_feedback";"it_platform_feedback.csv")
};

f=getshipping():$dataset{
  <ld.loaddataset("wc_shipping";"it_platform_shipping.csv")
};

f=listdatasets():@str{
  <@("wc_users";"wc_orders";"wc_traffic";"wc_incidents";"wc_feedback";"wc_shipping")
};

f=getbyname(name:str):$dataset{
  if(name == "wc_users"){ <getusers() };
  if(name == "wc_orders"){ <getorders() };
  if(name == "wc_traffic"){ <gettraffic() };
  if(name == "wc_incidents"){ <getincidents() };
  if(name == "wc_feedback"){ <getfeedback() };
  if(name == "wc_shipping"){ <getshipping() };
  <$dataset{
    name:"not_found";
    headers:@();
    rows:@()
  }
};

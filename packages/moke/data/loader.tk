m=moke.data.loader;

i=str:std.str;
i=env:std.env;
i=file:std.file;
i=log:shared.log;
i=compute:moke.compute;
i=upload:moke.upload;

(* Demo datasets are CSV files in moke's one dataset store, static/data, read when asked
   for (MK21.16, MK19.1).

   They used to be literal arrays compiled into four modules of 737 to 757 string
   constants each. That crossed toke's silent IR-truncation limit (T-35): the emitted IR
   was cut off mid-token, toke exited 0, and clang refused the object, so moke could
   never link. MK21.16 moved them to data/csv. That was a second store: the browser read
   its datasets from an object inline in templates/index.tkt, and the two held different
   tables under the same ids. MK19.1 merged both into static/data, which the browser
   fetches and this module reads, so there is one copy of each dataset.

   The directory is MOKE_DATA_DIR when that is set. Otherwise the first of two relative
   paths that exists is used: `static/data` for the server, which runs from packages/moke,
   and `packages/moke/static/data` for anything run from the repository root, such as
   the test suite. A dataset that cannot be read comes back EMPTY with its name, and the
   failure is logged. An empty table is visibly empty, and a partial one would not
   be. *)

f=datadir():str{
  let fromenv=env.getor("MOKE_DATA_DIR";"");
  if(str.len(fromenv)>0){ <fromenv }el{};
  if(file.exists("static/data/manifest.json")){ <"static/data" }el{};
  <"packages/moke/static/data"
};

f=emptydataset(name:str):$dataset{
  <$dataset{ name:name; headers:@(); rows:@() }
};

(* `relpath` is relative to datadir(), as the manifest's paths are once their
   /static/data/ prefix is taken off. *)
f=loaddataset(name:str;relpath:str):$dataset{
  let dir=datadir();
  let path="\(dir)/\(relpath)";
  let text=mt file.read(path) {$ok:v v; $err:e ""};
  if(str.len(text)==0){
    log.warn("demo dataset file missing or empty: \(path)";"moke.data";"system");
    <emptydataset(name)
  }el{};
  let parsed:$parseresult=upload.parsecsv(text;upload.defaultopts());
  if(!parsed.ok){
    log.warn("demo dataset did not parse: \(path)";"moke.data";"system");
    <emptydataset(name)
  }el{};
  let ds:$dataset=parsed.dataset;
  <$dataset{ name:name; headers:ds.headers; rows:ds.rows }
};

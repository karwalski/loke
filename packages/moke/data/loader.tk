m=moke.data.loader;

i=str:std.str;
i=env:std.env;
i=file:std.file;
i=log:shared.log;
i=compute:moke.compute;
i=upload:moke.upload;

(* Demo datasets are CSV files under data/csv, read when asked for (MK21.16).

   They used to be literal arrays compiled into four modules of 737 to 757 string
   constants each. That crossed toke's silent IR-truncation limit (T-35): the emitted IR
   was cut off mid-token, toke exited 0, and clang refused the object, so moke could
   never link. It was also the wrong design. A demo dataset compiled into the binary
   cannot be changed without a rebuild.

   The directory is MOKE_DATA_DIR when that is set. Otherwise the first of two relative
   paths that exists is used: `data/csv` for the server, which runs from packages/moke,
   and `packages/moke/data/csv` for anything run from the repository root, such as the
   test suite. A dataset that cannot be read comes back EMPTY with its name, and the
   failure is logged. An empty table is visibly empty, and a partial one would not
   be. *)

f=datadir():str{
  let fromenv=env.getor("MOKE_DATA_DIR";"");
  if(str.len(fromenv)>0){ <fromenv }el{};
  if(file.exists("data/csv")){ <"data/csv" }el{};
  <"packages/moke/data/csv"
};

f=emptydataset(name:str):$dataset{
  <$dataset{ name:name; headers:@(); rows:@() }
};

f=loaddataset(name:str;filename:str):$dataset{
  let path=str.concat(str.concat(datadir();"/");filename);
  let text=mt file.read(path) {$ok:v v; $err:e ""};
  if(str.len(text)==0){
    log.warn(str.concat("demo dataset file missing or empty: ";path);"moke.data";"system");
    <emptydataset(name)
  }el{};
  let parsed:$parseresult=upload.parsecsv(text;upload.defaultopts());
  if(!parsed.ok){
    log.warn(str.concat("demo dataset did not parse: ";path);"moke.data";"system");
    <emptydataset(name)
  }el{};
  let ds:$dataset=parsed.dataset;
  <$dataset{ name:name; headers:ds.headers; rows:ds.rows }
};

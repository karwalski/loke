m=moke.data.audatasets;
i=str:std.str;
i=compute:moke.compute;
i=ld:moke.data.loader;

t=$datasetinfo{
  id:str;
  name:str;
  description:str;
  rowcount:i32;
  colcount:i32;
  sensitivity:str;
  category:str
};

f=getmedicare():$dataset{
  <ld.loaddataset("Medicare Benefits Schedule";"au_datasets_medicare.csv")
};

f=getschools():$dataset{
  <ld.loaddataset("NSW Public Schools";"au_datasets_schools.csv")
};

f=getopal():$dataset{
  <ld.loaddataset("Opal Card Tap Data";"au_datasets_opal.csv")
};

f=getwater():$dataset{
  <ld.loaddataset("Sydney Water Quality Readings";"au_datasets_water.csv")
};

f=getproperty():$dataset{
  <ld.loaddataset("NSW Land Registry Property Transactions";"au_datasets_property.csv")
};

f=getemployment():$dataset{
  <ld.loaddataset("ABS Employment by Occupation";"au_datasets_employment.csv")
};

f=listdatasets():@$datasetinfo{
  <@(
    $datasetinfo{
      id:"medicare";
      name:"Medicare Benefits Schedule";
      description:"MBS claims with patient PII, benefit amounts, and provider details";
      rowcount:30;
      colcount:26;
      sensitivity:"RESTRICTED";
      category:"Health"
    };
    $datasetinfo{
      id:"schools";
      name:"NSW Public Schools";
      description:"School-level enrolment, ICSEA, ATAR, and principal data for NSW government schools";
      rowcount:30;
      colcount:22;
      sensitivity:"CONFIDENTIAL";
      category:"Education"
    };
    $datasetinfo{
      id:"opal";
      name:"Opal Card Tap Data";
      description:"Pseudonymous Opal card journey records across all NSW public transport modes";
      rowcount:30;
      colcount:24;
      sensitivity:"CONFIDENTIAL";
      category:"Transport"
    };
    $datasetinfo{
      id:"water";
      name:"Sydney Water Quality Readings";
      description:"Sensor-based water quality measurements across Sydney distribution network";
      rowcount:30;
      colcount:23;
      sensitivity:"INTERNAL";
      category:"Utilities"
    };
    $datasetinfo{
      id:"property";
      name:"NSW Land Registry Property Transactions";
      description:"Property sales with vendor and purchaser names, prices, and settlement details";
      rowcount:30;
      colcount:25;
      sensitivity:"CONFIDENTIAL";
      category:"Property"
    };
    $datasetinfo{
      id:"employment";
      name:"ABS Employment by Occupation";
      description:"Aggregate employment statistics by ANZSCO occupation and industry — no individual PII";
      rowcount:30;
      colcount:22;
      sensitivity:"PUBLIC";
      category:"Economics"
    }
  )
};

f=getbyid(id:str):$dataset{
  if(str.eq(id;"medicare")){ <getmedicare()   };
  if(str.eq(id;"schools")){ <getschools()    };
  if(str.eq(id;"opal")){ <getopal()       };
  if(str.eq(id;"water")){ <getwater()      };
  if(str.eq(id;"property")){ <getproperty()   };
  if(str.eq(id;"employment")){ <getemployment() };
  <$dataset{
    name:"";
    headers:@();
    rows:@()
  }
};

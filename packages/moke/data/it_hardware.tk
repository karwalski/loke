m=moke.data.ithardware;
i=compute:moke.compute;
i=ld:moke.data.loader;

f=getinventory():$dataset{
  <ld.loaddataset("server_inventory";"it_hardware_inventory.csv")
};

f=getmetrics():$dataset{
  <ld.loaddataset("performance_metrics";"it_hardware_metrics.csv")
};

f=getnetwork():$dataset{
  <ld.loaddataset("network_topology";"it_hardware_network.csv")
};

f=getusers():$dataset{
  <ld.loaddataset("user_assignments";"it_hardware_users.csv")
};

f=listdatasets():@str{
  <@("server_inventory";"performance_metrics";"network_topology";"user_assignments")
};

f=getbyname(name:str):$dataset{
  if(name == "server_inventory"){ <getinventory() };
  if(name == "performance_metrics"){ <getmetrics() };
  if(name == "network_topology"){ <getnetwork() };
  if(name == "user_assignments"){ <getusers() };
  <$dataset{
    name:"not_found";
    headers:@();
    rows:@()
  }
};

m=moke.routingrequest;
i=str:std.str;
i=intent:core.router.intent;
i=rr:core.router.router;
i=sel:core.router.selector;
i=sens:core.router.sensitivity;
i=t:shared.types;

(* LS1.4a. What /api/routing takes from a request's `prompt`, `sensitivity` and `tolerance`,
   through loke's own router modules, so the explanation moke shows depends on the request.

   - intent: core.router.intent.classifyfast, the keyword classifier the router runs before
     any model is asked (F5.2). No model is consulted here, so the method is "keyword".
   - sensitivity: the caller's level is a floor, and core.router.sensitivity.scorefromcontent
     may raise it from the prompt's words (a prompt naming a password is RESTRICTED), never
     lower it. combine takes the higher of the two, as routerequest does.
   - tier: core.router.selector maps the latency tolerance onto a tier (F5.6): instant to
     interactive, patient to considered, background to background.

   The model is NOT chosen here: it is still the caller's model_id, and the provider is still
   local. Choosing it needs core.router.router.routerequest with a model registry, which moke
   does not hold. So the endpoint explains the classification and the tier, not a selection.

   Only str, bool and f64 cross out of this module: shared.types and moke.routingexplainer
   both declare a $routingdecision, and a page that sees both would not compile. *)

t=$routeinputs{
  intent:str;
  confidence:f64;
  method:str;
  sensitivity:str;
  sensitivityrouting:str;
  tolerance:str;
  tier:str
};

f=toleranceknown(tolerance:str):bool{
  <str.eq(tolerance;"instant") || str.eq(tolerance;"patient") || str.eq(tolerance;"background")
};

f=sensitivityknown(level:str):bool{
  <str.eq(level;"PUBLIC") || str.eq(level;"INTERNAL") || str.eq(level;"CONFIDENTIAL") || str.eq(level;"RESTRICTED")
};

f=levelfor(level:str):$sensitivitylevel{
  if(str.eq(level;"RESTRICTED")){ <$sensitivitylevel{$restricted:0} }el{};
  if(str.eq(level;"CONFIDENTIAL")){ <$sensitivitylevel{$confidential:0} }el{};
  if(str.eq(level;"INTERNAL")){ <$sensitivitylevel{$internal:0} }el{};
  <$sensitivitylevel{$public:0}
};

(* Callers check toleranceknown and sensitivityknown first; an unknown value here falls to
   instant and PUBLIC, the router's own defaults. *)
f=inputs(prompt:str;sensitivity:str;tolerance:str):$routeinputs{
  let ir=intent.classifyfast(prompt);
  let level=sens.combine(levelfor(sensitivity);sens.scorefromcontent(prompt));
  <$routeinputs{
    intent:rr.tasktostr(ir.task);
    confidence:ir.confidence;
    method:ir.method;
    sensitivity:sens.leveltostr(level);
    sensitivityrouting:if(sens.canusecloud(level)){"prefer-local"}el{"local-only"};
    tolerance:tolerance;
    tier:sel.tiertostr(sel.tierfromtolerance(sel.tolerancefromstr(tolerance)))
  }
};

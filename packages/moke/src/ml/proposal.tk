m=moke.ml.proposal;
i=str:std.string;
i=http:std.http;




t=$mlsuggestion{
  kind:str;         
  title:str;
  description:str;
  columns:@str;
  params:str;       
  rationale:str
};

t=$proposalresult{
  suggestions:@$mlsuggestion;
  source:str  
};



f=heuristicproposals(numcols:@str;catcols:@str):@$mlsuggestion{
  let suggestions=@();
  let nnum=numcols.len();
  let ncat=catcols.len();

  
  if(nnum > 2){
    let kmcols=@();
    let take=mut.3;
    if(take > nnum){ take=nnum };
    let ki=mut.0;
    if(ki < take){ kmcols.push(numcols.get(ki)); ki=ki + 1 }el{};
    suggestions.push($mlsuggestion{
      kind:"kmeans";
      title:"K-Means Clustering";
      description:"Group rows into natural clusters based on numeric patterns. Useful for segmenting customers, products, or events.";
      columns:kmcols;
      params:"{\"k\":4,\"max_iter\":100}";
      rationale:str.concat("Dataset has ";str.concat(str.fromint(nnum);" numeric columns — clustering will reveal natural groupings."))
    });
  };

  
  if(nnum > 1){
    let azcols=@();
    azcols.push(numcols.get(0));
    suggestions.push($mlsuggestion{
      kind:"zscore";
      title:"Z-Score Anomaly Detection";
      description:"Flag rows where a numeric value lies more than N standard deviations from the column mean.";
      columns:azcols;
      params:"{\"threshold\":3.0}";
      rationale:str.concat("Outliers in ";str.concat(numcols.get(0);" may indicate data quality issues or exceptional events."))
    });
  };

  
  if(nnum > 2){
    suggestions.push($mlsuggestion{
      kind:"correlation";
      title:"Pearson Correlation Matrix";
      description:"Compute pairwise linear correlation between all numeric columns to surface relationships.";
      columns:numcols;
      params:"{}";
      rationale:"Correlation will reveal which numeric features move together and guide further modelling."
    });
  };

  
  if(nnum > 1 && ncat > 1){
    let gbcols=@();
    gbcols.push(catcols.get(0));
    gbcols.push(numcols.get(0));
    suggestions.push($mlsuggestion{
      kind:"groupby";
      title:"Group-By Analysis";
      description:str.concat("Compute mean and variance of ";str.concat(numcols.get(0);str.concat(" within each category of ";str.concat(catcols.get(0);"."))));
      columns:gbcols;
      params:"{\"agg\":\"mean\"}";
      rationale:str.concat("Segment ";str.concat(numcols.get(0);str.concat(" by ";str.concat(catcols.get(0);" to compare performance across categories."))))
    });
  };

  <suggestions
};



f=buildprompt(schematoon:str;numcols:@str;catcols:@str):str{
  let prompt=mut."You are a data analyst. Given the dataset schema below, suggest 2-4 ML analyses.

";
  prompt=str.concat(prompt;str.concat("SCHEMA PROFILE (no raw data):
";str.concat(schematoon;"

")));
  prompt=str.concat(prompt;str.concat("Numeric columns: ";str.concat(str.join(numcols; ", ");"
")));
  prompt=str.concat(prompt;str.concat("Categorical columns: ";str.concat(str.join(catcols; ", ");"

")));
  prompt=str.concat(prompt;"Respond as a JSON array of objects, each with keys: kind, title, description, columns (array), params (JSON string), rationale.
");
  prompt=str.concat(prompt;"Kinds available: kmeans, zscore, iqr, correlation, groupby.
");
  prompt=str.concat(prompt;"Be concise and practical. Do not include any raw data or PII in your response.");
  <prompt
};

f=parsellmsuggestions(body:str):@$mlsuggestion{
  
  
  let suggestions=@();
  let arr=str.jsonarray(body; "response");
  if(!str.ok(arr)){ <suggestions };
  let i=mut.0;
  let items=str.jsonparsearray(arr);
  if(i < items.len()){
    let item=items.get(i);
    let kind=str.jsonstring(item; "kind");
    let title=str.jsonstring(item; "title");
    let desc=str.jsonstring(item; "description");
    let rationale=str.jsonstring(item; "rationale");
    let params=str.jsonstring(item; "params");
    let colsraw=str.jsonarray(item; "columns");
    let cols=str.jsonparsestringarray(colsraw);
    if(str.len(kind) > 0 && str.len(title) > 0){
      suggestions.push($mlsuggestion{
        kind:kind;
        title:title;
        description:desc;
        columns:cols;
        params:params;
        rationale:rationale
      });
    };
    i=i + 1;
  }el{};
  <suggestions
};

f=fromschema(schematoon:str;numcols:@str;catcols:@str):$proposalresult{
  let prompt=buildprompt(schematoon; numcols; catcols);
  let body=str.concat("{\"text\":";str.concat(str.jsonencode(prompt);",\"system_prompt\":\"\",\"tolerance\":\"patient\",\"mode\":\"chat\"}"));
  let res=http.post("/api/moke/pipeline"; "application/json"; body);
  if(http.ok(res)){
    let suggestions=parsellmsuggestions(http.body(res));
    if(suggestions.len() > 0){
      <$proposalresult{
        suggestions:suggestions;
        source:"llm"
      }
    };
  };
  
  <$proposalresult{
    suggestions:heuristicproposals(numcols; catcols);
    source:"heuristic"
  }
};



f=formatsuggestions(result:$proposalresult):str{
  let lines=@();
  lines.push(str.concat("Analysis proposals (source: ";str.concat(result.source;")")));
  lines.push("---");
  let i=mut.0;
  if(i < result.suggestions.len()){
    let s=result.suggestions.get(i);
    lines.push(str.concat(str.fromint(i + 1);str.concat(". [";str.concat(str.upper(s.kind);str.concat("] ";s.title)))));
    lines.push(str.concat("   ";s.description));
    lines.push(str.concat("   Columns: ";str.join(s.columns; ", ")));
    lines.push(str.concat("   Why: ";s.rationale));
    if(str.len(s.params) > 2){
      lines.push(str.concat("   Params: ";s.params));
    };
    lines.push("");
    i=i + 1;
  }el{};
  <str.join(lines; "
")
};

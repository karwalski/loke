m=moke.ml.proposal;
i=str:std.string;
i=http:std.http;




t=$mlsuggestion{
  kind:str;         
  title:str;
  description:str;
  columns:@str;
  params:str;       
  rationale:str
};

t=$proposalresult{
  suggestions:@$mlsuggestion;
  source:str  
};



f=heuristicproposals(numcols:@str;catcols:@str):@$mlsuggestion{
  let suggestions=@();
  let nnum=numcols.len();
  let ncat=catcols.len();

  
  if(nnum >= 2{
    let kmcols=@();
    let take=3;
    if(take > nnum{ take=nnum };
    let ki=0;
    if(ki < take){ kmcols.push(numcols.get(ki)); ki=ki + 1 }{};
    suggestions.push($mlsuggestion{
      kind="kmeans";
      title="K-Means Clustering";
      description="Group rows into natural clusters based on numeric patterns. Useful for segmenting customers, products, or events.";
      columns=kmcols;
      params="{\"k\":4,\"max_iter\":100}";
      rationale="Dataset has " + str.fromint(nnum) + " numeric columns — clustering will reveal natural groupings."
    });
  };

  
  if(nnum >= 1{
    let azcols=@();
    azcols.push(numcols.get(0));
    suggestions.push($mlsuggestion{
      kind="zscore";
      title="Z-Score Anomaly Detection";
      description="Flag rows where a numeric value lies more than N standard deviations from the column mean.";
      columns=azcols;
      params="{\"threshold\":3.0}";
      rationale="Outliers in " + numcols.get(0) + " may indicate data quality issues or exceptional events."
    });
  };

  
  if(nnum >= 2{
    suggestions.push($mlsuggestion{
      kind="correlation";
      title="Pearson Correlation Matrix";
      description="Compute pairwise linear correlation between all numeric columns to surface relationships.";
      columns=numcols;
      params="{}";
      rationale="Correlation will reveal which numeric features move together and guide further modelling."
    });
  };

  
  if(nnum >= 1 && ncat >= 1{
    let gbcols=@();
    gbcols.push(catcols.get(0));
    gbcols.push(numcols.get(0));
    suggestions.push($mlsuggestion{
      kind="groupby";
      title="Group-By Analysis";
      description="Compute mean and variance of " + numcols.get(0) + " within each category of " + catcols.get(0) + ".";
      columns=gbcols;
      params="{\"agg\":\"mean\"}";
      rationale="Segment " + numcols.get(0) + " by " + catcols.get(0) + " to compare performance across categories."
    });
  };

  <suggestions
};



f=buildprompt(schematoon:str;numcols:@str;catcols:@str):str{
  let prompt="You are a data analyst. Given the dataset schema below, suggest 2-4 ML analyses.

";
  prompt=prompt + "SCHEMA PROFILE (no raw data):
" + schematoon + "

";
  prompt=prompt + "Numeric columns: " + str.join(numcols; ", ") + "
";
  prompt=prompt + "Categorical columns: " + str.join(catcols; ", ") + "

";
  prompt=prompt + "Respond as a JSON array of objects, each with keys: kind, title, description, columns (array), params (JSON string), rationale.
";
  prompt=prompt + "Kinds available: kmeans, zscore, iqr, correlation, groupby.
";
  prompt=prompt + "Be concise and practical. Do not include any raw data or PII in your response.";
  <prompt
};

f=parsellmsuggestions(body:str):@$mlsuggestion{
  
  
  let suggestions=@();
  let arr=str.jsonarray(body; "response");
  if(!str.ok(arr){ <suggestions };
  let i=0;
  let items=str.jsonparsearray(arr);
  if(i < items.len()){
    let item=items.get(i);
    let kind=str.jsonstring(item; "kind");
    let title=str.jsonstring(item; "title");
    let desc=str.jsonstring(item; "description");
    let rationale=str.jsonstring(item; "rationale");
    let params=str.jsonstring(item; "params");
    let colsraw=str.jsonarray(item; "columns");
    let cols=str.jsonparsestringarray(colsraw);
    if(str.len(kind) > 0 && str.len(title) > 0{
      suggestions.push($mlsuggestion{
        kind=kind;
        title=title;
        description=desc;
        columns=cols;
        params=params;
        rationale=rationale
      });
    };
    i=i + 1
  }{};
  <suggestions
};

f=fromschema(schematoon:str;numcols:@str;catcols:@str):$proposalresult{
  let prompt=buildprompt(schematoon; numcols; catcols);
  let body="{\"text\":" + str.jsonencode(prompt) + ",\"system_prompt\":\"\",\"tolerance\":\"patient\",\"mode\":\"chat\"}";
  let res=http.post("/api/moke/pipeline"; "application/json"; body);
  if(http.ok(res){
    let suggestions=parsellmsuggestions(http.body(res));
    if(suggestions.len() > 0{
      <$proposalresult{
        suggestions=suggestions;
        source="llm"
      };
    };
  };
  
  <$proposalresult{
    suggestions=heuristicproposals(numcols; catcols);
    source="heuristic"
  };
};



f=formatsuggestions(result:$proposalresult):str{
  let lines=@();
  lines.push("Analysis proposals (source: " + result.source + ")");
  lines.push("---");
  let i=0;
  if(i < result.suggestions.len()){
    let s=result.suggestions.get(i);
    lines.push(str.fromint(i + 1) + ". [" + str.upper(s.kind) + "] " + s.title);
    lines.push("   " + s.description);
    lines.push("   Columns: " + str.join(s.columns; ", "));
    lines.push("   Why: " + s.rationale);
    if(str.len(s.params) > 2{
      lines.push("   Params: " + s.params);
    };
    lines.push("");
    i=i + 1
  }{};
  <str.join(lines; "
")
};

m=moke.ml.proposal;
i=str:std.str;
i=http:std.http;
i=json:std.json;
i=reach:shared.reachability;
i=jx:shared.jsonobj;




t=$mlsuggestion{
  kind:str;         
  title:str;
  description:str;
  columns:@str;
  params:str;       
  rationale:str
};

t=$proposalresult{
  suggestions:@$mlsuggestion;
  source:str  
};



(* --- The JSON reader here was five functions that do not exist ---------------------
   `str.jsonencode`, `str.jsonarray`, `str.ok`, `str.jsonparsearray`, `str.jsonstring` and
   `str.jsonparsestringarray` are in neither the std.str interface nor the runtime. The encoder
   meant strings went out unquoted and unescaped; the five readers meant `parsellmsuggestions`
   could never return anything, so `fromschema` always fell through to the heuristics and the
   "llm" source was unreachable. std.json plus `shared.jsonobj` is the reader this tree uses,
   and a raw array handle from `json.getarr` is walked with `str.arraylen`/`str.arrayget`, as
   `core.privacy.ner.buildentities` does -- `.len`/`.get` are for typed arrays.

   `http.post("/api/moke/pipeline"; "application/json"; body)` had three arguments where the
   client takes two, and `/api/moke/pipeline` is not a route anything serves: moke's own server
   listens on 11432 and exposes `/api/pipeline`, and what that route does is forward to the loke
   pipeline on 11430. This posts to that pipeline directly, the same endpoint and pattern
   `moke.dashboardflow` uses.

   And every loop in the file was an `if(i < n){ ...; i=i+1 }el{}`, which runs once: the k-means
   column list held one column, the parsed-suggestion list one suggestion, and `formatsuggestions`
   printed one. Each `.push` result was also discarded (T-24), so in practice they held none. *)
f=jsonencode(s:str):str{
  <"\(jx.escape(s))"
};

f=heuristicproposals(numcols:@str;catcols:@str):@$mlsuggestion{
  let suggestions=mut.@();
  let nnum=numcols.len;
  let ncat=catcols.len;

  if(nnum > 2){
    let take=mut.3;
    if(take > nnum){ take=nnum };
    let kmcols=mut.@();
    lp(let ki=0;ki<take;ki=ki+1){
      kmcols=kmcols.push(numcols.get(ki))
    };
    suggestions=suggestions.push($mlsuggestion{
      kind:"kmeans";
      title:"K-Means Clustering";
      description:"Group rows into natural clusters based on numeric patterns. Useful for segmenting customers, products, or events.";
      columns:kmcols;
      params:"{\"k\":4,\"max_iter\":100}";
      rationale:"Dataset has \(str.fromint(nnum)) numeric columns — clustering will reveal natural groupings."
    })
  };

  if(nnum > 1){
    suggestions=suggestions.push($mlsuggestion{
      kind:"zscore";
      title:"Z-Score Anomaly Detection";
      description:"Flag rows where a numeric value lies more than N standard deviations from the column mean.";
      columns:@(numcols.get(0));
      params:"{\"threshold\":3.0}";
      rationale:"Outliers in \(numcols.get(0)) may indicate data quality issues or exceptional events."
    })
  };

  if(nnum > 2){
    suggestions=suggestions.push($mlsuggestion{
      kind:"correlation";
      title:"Pearson Correlation Matrix";
      description:"Compute pairwise linear correlation between all numeric columns to surface relationships.";
      columns:numcols;
      params:"{}";
      rationale:"Correlation will reveal which numeric features move together and guide further modelling."
    })
  };

  if(nnum > 1 && ncat > 1){
    suggestions=suggestions.push($mlsuggestion{
      kind:"groupby";
      title:"Group-By Analysis";
      description:"Compute mean and variance of \(numcols.get(0)) within each category of \(catcols.get(0)).";
      columns:@(catcols.get(0);numcols.get(0));
      params:"{\"agg\":\"mean\"}";
      rationale:"Segment \(numcols.get(0)) by \(catcols.get(0)) to compare performance across categories."
    })
  };

  <suggestions
};

f=buildprompt(schematoon:str;numcols:@str;catcols:@str):str{
  <"You are a data analyst. Given the dataset schema below, suggest 2-4 ML analyses.\n\nSCHEMA PROFILE (no raw data):\n\(schematoon)\n\nNumeric columns: \(str.join(", ";numcols))\nCategorical columns: \(str.join(", ";catcols))\n\nRespond as a JSON array of objects, each with keys: kind, title, description, columns (array), params (JSON string), rationale.\nKinds available: kmeans, zscore, iqr, correlation, groupby.\nBe concise and practical. Do not include any raw data or PII in your response."
};

(* NC1.3. The reply is read through std.json's TYPED accessors (json.dec, json.str, json.arr),
   each matched with $ok first (T-31). It used the untyped json.getarr over i64 handles, which
   does not work (LS1.1w): a model's suggestions were never read even once one was asked. *)
f=strof(o:$jsonval;key:str):str{
  <mt json.str(o;key) {
    $ok:v v;
    $jsonerr:e ""
  }
};

(* A JSON string element, from its raw text. *)
f=elemstr(e:$jsonval):str{
  let t=str.trim(e.raw);
  if(str.len(t)<2){ <"" }el{};
  <jx.unescape(str.trimsuffix(str.trimprefix(t;"\"");"\""))
};

f=colsof(item:$jsonval):@str{
  let arr=mt json.arr(item;"columns") {
    $ok:a a;
    $jsonerr:e @()
  };
  let out=mut.@();
  lp(let i=0;i<arr.len;i=i+1){
    let e:$jsonval=arr.get(i);
    out=out.push(elemstr(e))
  };
  <out
};

f=suggestionsfromitems(items:@$jsonval):@$mlsuggestion{
  let out=mut.@();
  lp(let i=0;i<items.len;i=i+1){
    let item:$jsonval=items.get(i);
    let kind=strof(item;"kind");
    let title=strof(item;"title");
    if(str.len(kind) > 0 && str.len(title) > 0){
      out=out.push($mlsuggestion{
        kind:kind;
        title:title;
        description:strof(item;"description");
        columns:colsof(item);
        params:strof(item;"params");
        rationale:strof(item;"rationale")
      })
    }el{}
  };
  <out
};

(* The model is asked for a bare JSON array. The loke pipeline wraps a completion as
   {"ok":true,"response":"<text>"}; a reply that is already the array is read directly. The
   array is read by wrapping it as {"a":...}, because json.arr reads a keyed field. *)
f=parsellmsuggestions(body:str):@$mlsuggestion{
  let inner=mt json.dec(body) {
    $ok:o strof(o;"response");
    $jsonerr:e ""
  };
  let payload=mut.str.trim(body);
  if(str.len(inner)>0){ payload=str.trim(inner) }el{};
  if(!str.startswith(payload;"[")){ <@() }el{};
  <mt json.dec("{\"a\":\(payload)}") {
    $ok:w itemsof(w);
    $jsonerr:e @()
  }
};

f=itemsof(w:$jsonval):@$mlsuggestion{
  <mt json.arr(w;"a") {
    $ok:items suggestionsfromitems(items);
    $jsonerr:e @()
  }
};

f=pipelinebaseurl():str{
  <"http://127.0.0.1:11430"
};

(* NC1.12. The dataset the proposal is about, as loke's no-custody dispatch reads it: `headers`
   and `rows` go to loke, on this machine, as the reference its check reads, and never into
   what loke sends a model. Both must be JSON arrays exactly as the caller sent them; anything
   else, or nothing, leaves them out, and loke then takes the fallback this request selects. *)
f=datasetfields(name:str;headersraw:str;rowsraw:str):str{
  if(str.startswith(str.trim(headersraw);"[") && str.startswith(str.trim(rowsraw);"[")){
    <",\"dataset_name\":\(jsonencode(name)),\"headers\":\(headersraw),\"rows\":\(rowsraw)"
  }el{};
  <""
};

(* `http.postheaders` against a dead port reports $ok carrying nothing (T-15), so the port is
   checked first rather than treating an empty body as a model that had nothing to say. *)
f=askpipelinewith(prompt:str;dsfields:str):str{
  if(reach.localserviceup(pipelinebaseurl())){}el{
    <""
  };
  (* NC1.12: column names only. With the dataset attached (`dsfields`, from datasetfields), loke
     tries this as a no-custody dispatch first and records it no-custody only when the body it
     sends holds no cell of the data. Without one there is nothing to check against, and loke
     takes the fallback selected here, recorded as directed by policy (NC1.8). *)
  let body="{\"text\":\(jsonencode(prompt)),\"system_prompt\":\"\",\"tolerance\":\"patient\",\"mode\":\"chat\",\"fallback_reason\":\"policy_directed\",\"fallback_selected_by\":\"policy\"\(dsfields)}";
  (* NC1.3: http.posturl. http.postheaders sends nothing in this shape (T-48), so the model
     was never asked and every proposal was the heuristic. *)
  <http.posturl(str.concat(pipelinebaseurl();"/api/pipeline");body)
};

f=askpipeline(prompt:str):str{
  <askpipelinewith(prompt;"")
};

f=fromschemawith(schematoon:str;numcols:@str;catcols:@str;dsfields:str):$proposalresult{
  let reply=askpipelinewith(buildprompt(schematoon;numcols;catcols);dsfields);
  if(str.len(reply)>0){
    let suggestions=parsellmsuggestions(reply);
    if(suggestions.len > 0){
      <$proposalresult{
        suggestions:suggestions;
        source:"llm"
      }
    }
  };
  <$proposalresult{
    suggestions:heuristicproposals(numcols;catcols);
    source:"heuristic"
  }
};

f=fromschema(schematoon:str;numcols:@str;catcols:@str):$proposalresult{
  <fromschemawith(schematoon;numcols;catcols;"")
};

f=formatsuggestions(result:$proposalresult):str{
  let lines=mut.@();
  lines=lines.push("Analysis proposals (source: \(result.source))");
  lines=lines.push("---");
  lp(let i=0;i<result.suggestions.len;i=i+1){
    let s:$mlsuggestion=result.suggestions.get(i);
    lines=lines.push("\(str.fromint(i+1)). [\(str.upper(s.kind))] \(s.title)");
    lines=lines.push("   \(s.description)");
    lines=lines.push("   Columns: \(str.join(", ";s.columns))");
    lines=lines.push("   Why: \(s.rationale)");
    if(str.len(s.params) > 2){
      lines=lines.push("   Params: \(s.params)")
    };
    lines=lines.push("")
  };
  <str.join("\n";lines)
};

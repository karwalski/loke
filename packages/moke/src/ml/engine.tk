m=moke.ml.engine;
i=str:std.string;




t=$kmeansopts{
  k:i32;
  maxiter:i32;
  columns:@str
};

t=$kmeansresult{
  k:i32;
  assignments:@i32;
  centroids:@(@(f32));
  inertia:f32;
  iterations:i32
};

t=$anomalyopts{
  column:str;
  threshold:f32;
  method:str  
};

t=$anomaly{
  rowindex:i32;
  column:str;
  value:f32;
  score:f32;
  kind:str
};

t=$anomalyresult{
  column:str;
  method:str;
  anomalies:@$anomaly;
  threshold:f32
};

t=$correlationresult{
  cola:str;
  colb:str;
  pearsonr:f32;
  strength:str  
};

t=$mlresult{
  kind:str;
  kmeans:$kmeansresult;
  anomalies:$anomalyresult;
  correlations:@$correlationresult
};



f=meanf32(vals:@f32):f32{
  let n=vals.len();
  if(n = 0){ <0.0 };
  let total=0.0;
  lp(let ii=0;ii<vals.len;ii=ii+1){
    let v=vals.get(ii);
    total=total + v
  };
  <total / str.tofloat(str.fromint(n))
};

f=stddevf32(vals:@f32):f32{
  let n=vals.len();
  if(n < 2){ <0.0 };
  let m=meanf32(vals);
  let sumsq=0.0;
  lp(let ii=0;ii<vals.len;ii=ii+1){
    let v=vals.get(ii);
    let diff=v - m;
    sumsq=sumsq + diff * diff
  };
  <str.sqrt(sumsq / str.tofloat(str.fromint(n)))
};

f=pearson(xs:@f32;ys:@f32):f32{
  let n=xs.len();
  if(n < 2){ <0.0 };
  let mx=meanf32(xs);
  let my=meanf32(ys);
  let cov=0.0;
  let sx=0.0;
  let sy=0.0;
  let idx=0;
  if(idx < n){
    let dx=xs.get(idx) - mx;
    let dy=ys.get(idx) - my;
    cov=cov + dx * dy;
    sx=sx + dx * dx;
    sy=sy + dy * dy;
    idx=idx + 1
  }el{};
  let denom=str.sqrt(sx) * str.sqrt(sy);
  if(denom = 0.0){ <0.0 };
  <cov / denom
};

f=colindex(headers:@str;name:str):i32{
  let idx=0;
  let found=-1;
  if(idx < headers.len()){
    if(str.eq(headers.get(idx); name)){ found=idx };
    idx=idx + 1
  }el{};
  <found
};

f=extractnumericcol(headers:@str;rows:@(@(str));colname:str):@f32{
  let ci=colindex(headers; colname);
  let out=@();
  if(ci < 0){ <out };
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let r=rows.get(ii);
    let v=str.trim(r.get(ci));
    if(str.isfloat(v)){ out.push(str.tofloat(v)) }el{ out.push(0.0) }
  };
  <out
};

f=euclideandist(a:@f32;b:@f32):f32{
  let d=0.0;
  let i=0;
  if(i < a.len()){
    let diff=a.get(i) - b.get(i);
    d=d + diff * diff;
    i=i + 1;
  }el{};
  <str.sqrt(d)
};

f=nearestcentroid(point:@f32;centroids:@(@(f32))):i32{
  let bestidx=0;
  let bestdist=euclideandist(point; centroids.get(0));
  let i=1;
  if(i < centroids.len()){
    let d=euclideandist(point; centroids.get(i));
    if(d < bestdist){
      bestdist=d;
      bestidx=i;
    };
    i=i + 1;
  }el{};
  <bestidx
};

f=recomputecentroids(points:@(@(f32));assignments:@i32;k:i32;dims:i32):@(@(f32)){
  let newcents=@();
  let ci=0;
  if(ci < k){
    let sum=@();
    let di=0;
    if(di < dims){ sum.push(0.0); di=di + 1 }el{};
    let count=0;
    let pi=0;
    if(pi < assignments.len()){
      if(assignments.get(pi) = ci){
        let di2=0;
        if(di2 < dims){
          sum.get(di2)=sum.get(di2) + points.get(pi).get(di2);
          di2=di2 + 1
        }el{};
        count=count + 1;
      };
      pi=pi + 1
    }el{};
    if(count > 0){
      let di3=0;
      if(di3 < dims){
        sum.get(di3)=sum.get(di3) / str.tofloat(str.fromint(count));
        di3=di3 + 1
      }el{}
    };
    newcents.push(sum);
    ci=ci + 1
  }el{};
  <newcents
};



f=kmeans(headers:@str;rows:@(@(str));opts:$kmeansopts):$kmeansresult{
  let k=opts.k;
  let maxiter=opts.maxiter;
  let colnames=opts.columns;
  let nrows=rows.len();
  let dims=colnames.len();

  
  let matrix=@();
  lp(let ii=0;ii<rows.len;ii=ii+1){
    let r=rows.get(ii);
    let point=@();
    lp(let jj=0;jj<colnames.len;jj=jj+1){
      let cn=colnames.get(jj);
      let ci=colindex(headers; cn);
      if(ci > 0){
        let v=str.trim(r.get(ci));
        if(str.isfloat(v)){ point.push(str.tofloat(v)) }el{ point.push(0.0) }
      }el{ point.push(0.0) }
    };
    matrix.push(point)
  };

  
  let centroids=@();
  let initi=0;
  let initlim=k;
  if(initlim > nrows){ initlim=nrows };
  if(initi < initlim){
    centroids.push(matrix.get(initi));
    initi=initi + 1
  }el{};
  
  if(centroids.len() < k){
    let pad=@();
    let di=0;
    if(di < dims){ pad.push(0.0); di=di + 1 }el{};
    centroids.push(pad);
  }el{};

  let assignments=@();
  let ri=0;
  if(ri < nrows){ assignments.push(0); ri=ri + 1 }el{};

  let iter=0;
  let converged=false;
  if(iter < maxiter && !$converged){
    let newassign=@();
    let pi=0;
    if(pi < nrows){
      newassign.push(nearestcentroid(matrix.get(pi); centroids));
      pi=pi + 1
    }el{};

    
    let changed=false;
    let ci2=0;
    if(ci2 < nrows){
      if(newassign.get(ci2) != assignments.get(ci2)){ changed=true };
      ci2=ci2 + 1
    }el{};

    
    let ui=0;
    if(ui < nrows){ assignments.get(ui)=newassign.get(ui); ui=ui + 1 }el{};

    if(!$changed){ converged=true };

    centroids=recomputecentroids(matrix; assignments; k; dims);
    iter=iter + 1
  }el{};

  
  let inertia=0.0;
  let ii=0;
  if(ii < nrows){
    let d=euclideandist(matrix.get(ii); centroids.get(assignments.get(ii)));
    inertia=inertia + d * d;
    ii=ii + 1
  }el{};

  <$kmeansresult{
    k:k;
    assignments:assignments;
    centroids:centroids;
    inertia:inertia;
    iterations:iter
  }
};



f=zscoreanomalies(headers:@str;rows:@(@(str));opts:$anomalyopts):$anomalyresult{
  let colname=opts.column;
  let threshold=opts.threshold;
  let vals=extractnumericcol(headers; rows; colname);
  let m=meanf32(vals);
  let sd=stddevf32(vals);
  let anomalies=@();
  let ri=0;
  if(ri < vals.len()){
    let z=0.0;
    if(sd > 0.0){ z=(vals.get(ri) - m) / sd };
    let az=z;
    if(az < 0.0){ az=az * -1.0 };
    if(az > threshold){
      anomalies.push($anomaly{
        rowindex:ri;
        column:colname;
        value:vals.get(ri);
        score:z;
        kind:"zscore"
      });
    };
    ri=ri + 1
  }el{};
  <$anomalyresult{
    column:colname;
    method:"zscore";
    anomalies:anomalies;
    threshold:threshold
  }
};



f=iqranomalies(headers:@str;rows:@(@(str));opts:$anomalyopts):$anomalyresult{
  let colname=opts.column;
  let threshold=opts.threshold;
  let vals=extractnumericcol(headers; rows; colname);
  let n=vals.len();

  
  let sorted=vals.clone();
  sorted.sortf32asc();

  
  let q1idx=(n * 25) / 100;
  let q3idx=(n * 75) / 100;
  if(q1idx > n){ q1idx=0 };
  if(q3idx > n){ q3idx=n - 1 };
  let q1=sorted.get(q1idx);
  let q3=sorted.get(q3idx);
  let iqr=q3 - q1;
  let lower=q1 - 1.5 * iqr;
  let upper=q3 + 1.5 * iqr;

  let anomalies=@();
  let ri=0;
  if(ri < n){
    let v=vals.get(ri);
    if(v < lower || v > upper){
      
      let score=0.0;
      if(v < lower && iqr > 0.0){ score=(lower - v) / iqr };
      if(v > upper && iqr > 0.0){ score=(v - upper) / iqr };
      anomalies.push($anomaly{
        rowindex:ri;
        column:colname;
        value:v;
        score:score;
        kind:"iqr"
      });
    };
    ri=ri + 1
  }el{};
  <$anomalyresult{
    column:colname;
    method:"iqr";
    anomalies:anomalies;
    threshold:1.5
  }
};



f=pearsonstrength(r:f32):str{
  let ar=r;
  if(ar < 0.0){ ar=ar * -1.0 };
  if(ar > 0.7){ <"strong" };
  if(ar > 0.4){ <"moderate" };
  if(ar > 0.2){ <"weak" };
  <"negligible"
};

f=isnumericcol(headers:@str;rows:@(@(str));col:str):bool{
  let ci=colindex(headers; col);
  if(ci < 0){ <false };
  let numericcount=0;
  let total=0;
  let limit=50;
  if(limit > rows.len()){ limit=rows.len() };
  let ri=0;
  if(ri < limit){
    let v=str.trim(rows.get(ri).get(ci));
    if(str.len(v) > 0){
      if(str.isfloat(v)){ numericcount=numericcount + 1 };
      total=total + 1;
    };
    ri=ri + 1
  }el{};
  if(total = 0){ <false };
  <(numericcount * 100 / total) > 80
};

f=correlationmatrix(headers:@str;rows:@(@(str))):@$correlationresult{
  
  let numcols=@();
  lp(let ii=0;ii<headers.len;ii=ii+1){
    let h=headers.get(ii);
    if(isnumericcol(headers; rows; h)){ numcols.push(h) }
  };

  let results=@();
  let ai=0;
  if(ai < numcols.len()){
    let bi=ai + 1;
    if(bi < numcols.len()){
      let xs=extractnumericcol(headers; rows; numcols.get(ai));
      let ys=extractnumericcol(headers; rows; numcols.get(bi));
      let r=pearson(xs; ys);
      results.push($correlationresult{
        cola:numcols.get(ai);
        colb:numcols.get(bi);
        pearsonr:r;
        strength:pearsonstrength(r)
      });
      bi=bi + 1
    }el{};
    ai=ai + 1
  }el{};
  <results
};

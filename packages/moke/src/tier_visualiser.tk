
m=moke.tiervisualiser;
i=str:std.string;

t=$tierinfo{
  name:$str;
  label:$str;
  gpulayers:$str;
  ctxsize:$str;
  batchsize:$str;
  estimatedtoks:f64;
  recommendedmodels:@$str;
  isactive:bool
};

t=$tiervisual{
  interactive:i64;
  considered:i64;
  background:i64;
  activetier:$str;
  hardwaresummary:$str
};

f=buildvisual(activetier:$str;hardwaresummary:$str):$tiervisual{
  let interactive=$tierinfo{
    name:"interactive";
    label:"Interactive (instant)";
    gpulayers:"all (-1)";
    ctxsize:"4096";
    batchsize:"512";
    estimatedtoks:45.0;
    recommendedmodels:@("llama3.2:3b";"qwen2.5:0.5b";"phi-3:mini");
    isactive:str.eq(activetier;"interactive")
  };
  let considered=$tierinfo{
    name:"considered";
    label:"Considered (~30s)";
    gpulayers:"20";
    ctxsize:"8192";
    batchsize:"256";
    estimatedtoks:18.0;
    recommendedmodels:@("llama3.1:8b";"qwen2.5:7b";"mistral:7b");
    isactive:str.eq(activetier;"considered")
  };
  let background=$tierinfo{
    name:"background";
    label:"Background (minutes)";
    gpulayers:"4";
    ctxsize:"32768";
    batchsize:"64";
    estimatedtoks:4.0;
    recommendedmodels:@("llama3.1:70b";"qwen2.5:72b";"mixtral:8x7b");
    isactive:str.eq(activetier;"background")
  };
  <$tiervisual{
    interactive:$interactive;
    considered:$considered;
    background:$background;
    activetier:$activetier;
    hardwaresummary:$hardwaresummary
  };
};

f=tiertojson(t:$tierinfo):$str{
  let modelsjson=str.join(t.recommendedmodels.map(m{ <"\"" + str.jsonescape(m) + "\"" }); ",");
  let j=mut."{";
  j=str.concat(j;"\"name\":\"" + str.jsonescape(t.name) + "\"");
  j=str.concat(j;",\"label\":\"" + str.jsonescape(t.label) + "\"");
  j=str.concat(j;",\"gpu_layers\":\"" + str.jsonescape(t.gpulayers) + "\"");
  j=str.concat(j;",\"ctx_size\":\"" + str.jsonescape(t.ctxsize) + "\"");
  j=str.concat(j;",\"batch_size\":\"" + str.jsonescape(t.batchsize) + "\"");
  j=str.concat(j;",\"estimated_tok_s\":" + str.fromfloat(t.estimatedtoks));
  j=str.concat(j;",\"recommended_models\":[" + modelsjson + "]");
  j=str.concat(j;",\"is_active\":" + if(t.isactive){ "true" }el{ "false" });
  j=str.concat(j;"}");
  <j
};

f=tojson(v:$tiervisual):$str{
  let j="{";
  j=str.concat(j;"\"interactive\":" + tiertojson(v.interactive));
  j=str.concat(j;",\"considered\":" + tiertojson(v.considered));
  j=str.concat(j;",\"background\":" + tiertojson(v.background));
  j=str.concat(j;",\"active_tier\":\"" + str.jsonescape(v.activetier) + "\"");
  j=str.concat(j;",\"hardware_summary\":\"" + str.jsonescape(v.hardwaresummary) + "\"");
  j=str.concat(j;"}");
  <j
};

m=moke.tiervisualiser;
i=str:std.str;
i=jx:shared.jsonobj;

(* `str.jsonescape` exists in neither the std.str interface nor the runtime (E4027), so every
   string this module put on the wire went out unescaped: one quote or backslash in a model id or
   a device name produced malformed JSON. `shared.jsonobj.escape` is the escaper this tree uses,
   and std.json is not usable for building output at all (T-32). *)

t=$tierinfo{
  name:str;
  label:str;
  gpulayers:str;
  ctxsize:str;
  batchsize:str;
  estimatedtoks:f64;
  recommendedmodels:@str;
  isactive:bool
};

t=$tiervisual{
  interactive:$tierinfo;
  considered:$tierinfo;
  background:$tierinfo;
  activetier:str;
  hardwaresummary:str
};

f=buildvisual(activetier:str;hardwaresummary:str):$tiervisual{
  let interactive=$tierinfo{
    name:"interactive";
    label:"Interactive (instant)";
    gpulayers:"all (-1)";
    ctxsize:"4096";
    batchsize:"512";
    estimatedtoks:45.0;
    recommendedmodels:@("llama3.2:3b";"qwen2.5:0.5b";"phi-3:mini");
    isactive:str.eq(activetier;"interactive")
  };
  let considered=$tierinfo{
    name:"considered";
    label:"Considered (~30s)";
    gpulayers:"20";
    ctxsize:"8192";
    batchsize:"256";
    estimatedtoks:18.0;
    recommendedmodels:@("llama3.1:8b";"qwen2.5:7b";"mistral:7b");
    isactive:str.eq(activetier;"considered")
  };
  let background=$tierinfo{
    name:"background";
    label:"Background (minutes)";
    gpulayers:"4";
    ctxsize:"32768";
    batchsize:"64";
    estimatedtoks:4.0;
    recommendedmodels:@("llama3.1:70b";"qwen2.5:72b";"mixtral:8x7b");
    isactive:str.eq(activetier;"background")
  };
  <$tiervisual{
    interactive:interactive;
    considered:considered;
    background:background;
    activetier:activetier;
    hardwaresummary:hardwaresummary
  };
};

f=tiertojson(t:$tierinfo):str{
  let modelsjsonparts=mut.@();
  lp(let ii=0;ii<t.recommendedmodels.len;ii=ii+1){
    let m=t.recommendedmodels.get(ii);
    modelsjsonparts=modelsjsonparts.push(jx.escape(m))
  };
  let modelsjson=str.join(",";modelsjsonparts);
  let j=mut."{";
  j="\(j)\"name\":\(jx.escape(t.name))";
  j="\(j),\"label\":\(jx.escape(t.label))";
  j="\(j),\"gpu_layers\":\(jx.escape(t.gpulayers))";
  j="\(j),\"ctx_size\":\(jx.escape(t.ctxsize))";
  j="\(j),\"batch_size\":\(jx.escape(t.batchsize))";
  j="\(j),\"estimated_tok_s\":\(str.fromfloat(t.estimatedtoks))";
  j="\(j),\"recommended_models\":[\(modelsjson)]";
  let isactivebool=mut."false";
  if(t.isactive){ isactivebool="true" };
  j="\(j),\"is_active\":\(isactivebool)";
  j=str.concat(j;"}");
  <j
};

f=tojson(v:$tiervisual):str{
  let j=mut."{";
  j="\(j)\"interactive\":\(tiertojson(v.interactive))";
  j="\(j),\"considered\":\(tiertojson(v.considered))";
  j="\(j),\"background\":\(tiertojson(v.background))";
  j="\(j),\"active_tier\":\(jx.escape(v.activetier))";
  j="\(j),\"hardware_summary\":\(jx.escape(v.hardwaresummary))";
  j=str.concat(j;"}");
  <j
};

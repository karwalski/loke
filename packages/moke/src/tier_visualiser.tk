m=moke.tiervisualiser;
i=str:std.string;

t=$tierinfo{
  name:str;
  label:str;
  gpulayers:str;
  ctxsize:str;
  batchsize:str;
  estimatedtoks:f64;
  recommendedmodels:@str;
  isactive:bool
};

t=$tiervisual{
  interactive:$tierinfo;
  considered:$tierinfo;
  background:$tierinfo;
  activetier:str;
  hardwaresummary:str
};

f=buildvisual(activetier:str;hardwaresummary:str):$tiervisual{
  let interactive=$tierinfo{
    name:"interactive";
    label:"Interactive (instant)";
    gpulayers:"all (-1)";
    ctxsize:"4096";
    batchsize:"512";
    estimatedtoks:45.0;
    recommendedmodels:@("llama3.2:3b";"qwen2.5:0.5b";"phi-3:mini");
    isactive:str.eq(activetier;"interactive")
  };
  let considered=$tierinfo{
    name:"considered";
    label:"Considered (~30s)";
    gpulayers:"20";
    ctxsize:"8192";
    batchsize:"256";
    estimatedtoks:18.0;
    recommendedmodels:@("llama3.1:8b";"qwen2.5:7b";"mistral:7b");
    isactive:str.eq(activetier;"considered")
  };
  let background=$tierinfo{
    name:"background";
    label:"Background (minutes)";
    gpulayers:"4";
    ctxsize:"32768";
    batchsize:"64";
    estimatedtoks:4.0;
    recommendedmodels:@("llama3.1:70b";"qwen2.5:72b";"mixtral:8x7b");
    isactive:str.eq(activetier;"background")
  };
  <$tiervisual{
    interactive:interactive;
    considered:considered;
    background:background;
    activetier:activetier;
    hardwaresummary:hardwaresummary
  };
};

f=tiertojson(t:$tierinfo):str{
  let modelsjsonparts=mut.@();
  lp(let ii=0;ii<t.recommendedmodels.len;ii=ii+1){
    let m=t.recommendedmodels.get(ii);
    modelsjsonparts=modelsjsonparts.push(str.concat("\"";str.concat(str.jsonescape(m);"\"")))
  };
  let modelsjson=str.join(modelsjsonparts; ",");
  let j=mut."{";
  j=str.concat(j;str.concat("\"name\":\"";str.concat(str.jsonescape(t.name);"\"")));
  j=str.concat(j;str.concat(",\"label\":\"";str.concat(str.jsonescape(t.label);"\"")));
  j=str.concat(j;str.concat(",\"gpu_layers\":\"";str.concat(str.jsonescape(t.gpulayers);"\"")));
  j=str.concat(j;str.concat(",\"ctx_size\":\"";str.concat(str.jsonescape(t.ctxsize);"\"")));
  j=str.concat(j;str.concat(",\"batch_size\":\"";str.concat(str.jsonescape(t.batchsize);"\"")));
  j=str.concat(j;str.concat(",\"estimated_tok_s\":";str.fromfloat(t.estimatedtoks)));
  j=str.concat(j;str.concat(",\"recommended_models\":[";str.concat(modelsjson;"]")));
  let isactivebool=mut."false";
  if(t.isactive){ isactivebool="true" };
  j=str.concat(j;str.concat(",\"is_active\":";isactivebool));
  j=str.concat(j;"}");
  <j
};

f=tojson(v:$tiervisual):str{
  let j=mut."{";
  j=str.concat(j;str.concat("\"interactive\":";tiertojson(v.interactive)));
  j=str.concat(j;str.concat(",\"considered\":";tiertojson(v.considered)));
  j=str.concat(j;str.concat(",\"background\":";tiertojson(v.background)));
  j=str.concat(j;str.concat(",\"active_tier\":\"";str.concat(str.jsonescape(v.activetier);"\"")));
  j=str.concat(j;str.concat(",\"hardware_summary\":\"";str.concat(str.jsonescape(v.hardwaresummary);"\"")));
  j=str.concat(j;"}");
  <j
};

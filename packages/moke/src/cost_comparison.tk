
m=moke.costcomparison;
i=str:std.string;

t=$costcomparison{
  cloudcostusd:f64;
  localcostusd:f64;
  savedusd:f64;
  modelid:$str;
  tokensin:i32;
  tokensout:i32;
  islocal:bool
};

t=$sessionsavings{
  totalcloudcost:f64;
  totallocalcost:f64;
  totalsaved:f64;
  requestcount:i32;
  localrequestcount:i32
};

f=estimatecloudcost(modelid:$str;tokensin:i32;tokensout:i32):f64{
  let costin=if(str.contains(modelid;"claude-3-5-sonnet")){ 0.003
  }el{ if(str.contains(modelid;"claude-3-5-haiku")){ 0.001
  }el{ if(str.contains(modelid;"gpt-4o-mini")){ 0.00015
  }el{ if(str.contains(modelid;"gpt-4o")){ 0.005
  }el{ if(str.contains(modelid;"llama")){ 0.0002
  }el{ if(str.contains(modelid;"qwen")){ 0.0002
  }el{ 0.001 }}}}}};

  let costout=if(str.contains(modelid;"claude-3-5-sonnet")){ 0.015
  }el{ if(str.contains(modelid;"claude-3-5-haiku")){ 0.005
  }el{ if(str.contains(modelid;"gpt-4o-mini")){ 0.0006
  }el{ if(str.contains(modelid;"gpt-4o")){ 0.015
  }el{ if(str.contains(modelid;"llama")){ 0.0002
  }el{ if(str.contains(modelid;"qwen")){ 0.0002
  }el{ 0.003 }}}}}};

  let incost=(tokensin / 1000) * costin;
  let outcost=(tokensout / 1000) * costout;
  <incost + outcost
};

f=compute(modelid:$str;tokensin:i32;tokensout:i32;islocal:bool):$costcomparison{
  let cloud=estimatecloudcost(modelid;tokensin;tokensout);
  let local=0.0;
  let saved=if(islocal){ cloud }el{ 0.0 };
  <$costcomparison{
    cloudcostusd:$cloud;
    localcostusd:$local;
    savedusd:$saved;
    modelid:$modelid;
    tokensin:$tokensin;
    tokensout:$tokensout;
    islocal:$islocal
  };
};

f=newsessionsavings():$sessionsavings{
  <$sessionsavings{
    totalcloudcost:0.0;
    totallocalcost:0.0;
    totalsaved:0.0;
    requestcount:0;
    localrequestcount:0
  };
};

f=accumulate(s:i64;c:$costcomparison):$sessionsavings{
  <$sessionsavings{
    totalcloudcost:i64 + c.cloudcostusd;
    totallocalcost:i64 + c.localcostusd;
    totalsaved:i64 + c.savedusd;
    requestcount:i64 + 1;
    localrequestcount:i64 + if(c.islocal){ 1 }el{ 0 };
  };
};

f=comparisontojson(c:$costcomparison):$str{
  let j=mut."{";
  j=str.concat(j;"\"cloud_cost_usd\":" + str.fromfloat(c.cloudcostusd));
  j=str.concat(j;",\"local_cost_usd\":" + str.fromfloat(c.localcostusd));
  j=str.concat(j;",\"saved_usd\":" + str.fromfloat(c.savedusd));
  j=str.concat(j;",\"model_id\":\"" + str.jsonescape(c.modelid) + "\"");
  j=str.concat(j;",\"tokens_in\":" + str.fromint(c.tokensin));
  j=str.concat(j;",\"tokens_out\":" + str.fromint(c.tokensout));
  j=str.concat(j;",\"is_local\":" + if(c.islocal){ "true" }el{ "false" });
  j=str.concat(j;"}");
  <j
};

f=savingstojson(s:$sessionsavings):$str{
  let j="{";
  j=str.concat(j;"\"total_cloud_cost\":" + str.fromfloat(s.totalcloudcost));
  j=str.concat(j;",\"total_local_cost\":" + str.fromfloat(s.totallocalcost));
  j=str.concat(j;",\"total_saved\":" + str.fromfloat(s.totalsaved));
  j=str.concat(j;",\"request_count\":" + str.fromint(s.requestcount));
  j=str.concat(j;",\"local_request_count\":" + str.fromint(s.localrequestcount));
  j=str.concat(j;"}");
  <j
};

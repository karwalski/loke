m=moke.costcomparison;
i=str:std.str;
i=jx:shared.jsonobj;

(* `str.jsonescape` exists in neither the std.str interface nor the runtime (E4027), so every
   string this module put on the wire went out unescaped: one quote or backslash in a model id or
   a device name produced malformed JSON. `shared.jsonobj.escape` is the escaper this tree uses,
   and std.json is not usable for building output at all (T-32). *)

t=$costcomparison{
  cloudcostusd:f64;
  localcostusd:f64;
  savedusd:f64;
  modelid:str;
  tokensin:i32;
  tokensout:i32;
  islocal:bool
};

t=$sessionsavings{
  totalcloudcost:f64;
  totallocalcost:f64;
  totalsaved:f64;
  requestcount:i32;
  localrequestcount:i32
};

f=estimatecloudcost(modelid:str;tokensin:i32;tokensout:i32):f64{
  let costin=mut.0.001;
  if(str.contains(modelid;"claude-3-5-sonnet")){ costin=0.003
  }el{ if(str.contains(modelid;"claude-3-5-haiku")){ costin=0.001
  }el{ if(str.contains(modelid;"gpt-4o-mini")){ costin=0.00015
  }el{ if(str.contains(modelid;"gpt-4o")){ costin=0.005
  }el{ if(str.contains(modelid;"llama")){ costin=0.0002
  }el{ if(str.contains(modelid;"qwen")){ costin=0.0002
  }el{} } } } } };

  let costout=mut.0.003;
  if(str.contains(modelid;"claude-3-5-sonnet")){ costout=0.015
  }el{ if(str.contains(modelid;"claude-3-5-haiku")){ costout=0.005
  }el{ if(str.contains(modelid;"gpt-4o-mini")){ costout=0.0006
  }el{ if(str.contains(modelid;"gpt-4o")){ costout=0.015
  }el{ if(str.contains(modelid;"llama")){ costout=0.0002
  }el{ if(str.contains(modelid;"qwen")){ costout=0.0002
  }el{} } } } } };

  (* ── Two defects in three lines, and only one of them stopped the build ───────
     **Integer division.** `tokensin` is `i32`, so `tokensin / 1000` was an INTEGER divide:
     999 tokens divided by 1000 is 0, and the whole term vanished. Every request under 1000
     tokens in or out was costed at **zero**, and every other request was rounded down to a
     whole thousand — 2,999 tokens billed as 2,000. The rates are per 1,000 tokens, so the
     divide has to happen in f64 or the unit conversion destroys the figure it is converting.

     **The type slot.** toke gave `incost` an `i32` slot while the expression evaluates to a
     double, and emitted `store i32 %t93, i32* %incost` for a value defined as `double` — IR
     that clang refuses, so this module never assembled. That is the visible half; the silent
     half above is the one that would have shipped a wrong number. Annotating both locals
     `:f64` settles it.

     Kept as f64 rather than converted to the integer-microdollar pattern used by
     `core.optimiser.budget` and `core.providers.*.calccostnano`, because
     `estimatecloudcost` is called only from `compute` in this same module, where an f64
     return is intact (T-20 corrupts bare f64 returns across a boundary, not within one). If a
     caller outside this module ever needs it, it needs the integer form first. *)
  let incost:f64=((tokensin as f64) / 1000.0) * costin;
  let outcost:f64=((tokensout as f64) / 1000.0) * costout;
  <incost + outcost
};

f=compute(modelid:str;tokensin:i32;tokensout:i32;islocal:bool):$costcomparison{
  let cloud=estimatecloudcost(modelid;tokensin;tokensout);
  let local=0.0;
  let saved=mut.0.0; if(islocal){ saved=cloud }el{};
  <$costcomparison{
    cloudcostusd:cloud;
    localcostusd:local;
    savedusd:saved;
    modelid:modelid;
    tokensin:tokensin;
    tokensout:tokensout;
    islocal:islocal
  }
};

f=newsessionsavings():$sessionsavings{
  <$sessionsavings{
    totalcloudcost:0.0;
    totallocalcost:0.0;
    totalsaved:0.0;
    requestcount:0;
    localrequestcount:0
  }
};

f=accumulate(s:$sessionsavings;c:$costcomparison):$sessionsavings{
  let localinc=mut.0; if(c.islocal){ localinc=1 }el{};
  <$sessionsavings{
    totalcloudcost:s.totalcloudcost + c.cloudcostusd;
    totallocalcost:s.totallocalcost + c.localcostusd;
    totalsaved:s.totalsaved + c.savedusd;
    requestcount:s.requestcount + (1 as i32);
    localrequestcount:s.localrequestcount + localinc
  }
};

f=comparisontojson(c:$costcomparison):str{
  let j=mut."{";
  j=str.concat(j;str.concat("\"cloud_cost_usd\":";str.fromfloat(c.cloudcostusd)));
  j=str.concat(j;str.concat(",\"local_cost_usd\":";str.fromfloat(c.localcostusd)));
  j=str.concat(j;str.concat(",\"saved_usd\":";str.fromfloat(c.savedusd)));
  j=str.concat(j;str.concat(",\"model_id\":";jx.escape(c.modelid)));
  j=str.concat(j;str.concat(",\"tokens_in\":";str.fromint(c.tokensin)));
  j=str.concat(j;str.concat(",\"tokens_out\":";str.fromint(c.tokensout)));
  let islocalstr=mut."false"; if(c.islocal){ islocalstr="true" }el{};
  j=str.concat(j;str.concat(",\"is_local\":";islocalstr));
  j=str.concat(j;"}");
  <j
};

f=savingstojson(s:$sessionsavings):str{
  let j=mut."{";
  j=str.concat(j;str.concat("\"total_cloud_cost\":";str.fromfloat(s.totalcloudcost)));
  j=str.concat(j;str.concat(",\"total_local_cost\":";str.fromfloat(s.totallocalcost)));
  j=str.concat(j;str.concat(",\"total_saved\":";str.fromfloat(s.totalsaved)));
  j=str.concat(j;str.concat(",\"request_count\":";str.fromint(s.requestcount)));
  j=str.concat(j;str.concat(",\"local_request_count\":";str.fromint(s.localrequestcount)));
  j=str.concat(j;"}");
  <j
};

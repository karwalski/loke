
m=moke.costcomparison;
i=str:std.str;

t=$costcomparison{
  cloudcostusd:f64;
  localcostusd:f64;
  savedusd:f64;
  modelid:str;
  tokensin:i32;
  tokensout:i32;
  islocal:bool
};

t=$sessionsavings{
  totalcloudcost:f64;
  totallocalcost:f64;
  totalsaved:f64;
  requestcount:i32;
  localrequestcount:i32
};

f=estimatecloudcost(modelid:str;tokensin:i32;tokensout:i32):f64{
  let costin=mut.0.001;
  if(str.contains(modelid;"claude-3-5-sonnet")){ costin=0.003
  }el{ if(str.contains(modelid;"claude-3-5-haiku")){ costin=0.001
  }el{ if(str.contains(modelid;"gpt-4o-mini")){ costin=0.00015
  }el{ if(str.contains(modelid;"gpt-4o")){ costin=0.005
  }el{ if(str.contains(modelid;"llama")){ costin=0.0002
  }el{ if(str.contains(modelid;"qwen")){ costin=0.0002
  }el{} } } } } };

  let costout=mut.0.003;
  if(str.contains(modelid;"claude-3-5-sonnet")){ costout=0.015
  }el{ if(str.contains(modelid;"claude-3-5-haiku")){ costout=0.005
  }el{ if(str.contains(modelid;"gpt-4o-mini")){ costout=0.0006
  }el{ if(str.contains(modelid;"gpt-4o")){ costout=0.015
  }el{ if(str.contains(modelid;"llama")){ costout=0.0002
  }el{ if(str.contains(modelid;"qwen")){ costout=0.0002
  }el{} } } } } };

  let incost=(tokensin / 1000) * costin;
  let outcost=(tokensout / 1000) * costout;
  <incost + outcost
};

f=compute(modelid:str;tokensin:i32;tokensout:i32;islocal:bool):$costcomparison{
  let cloud=estimatecloudcost(modelid;tokensin;tokensout);
  let local=0.0;
  let saved=mut.0.0; if(islocal){ saved=cloud }el{};
  <$costcomparison{
    cloudcostusd:cloud;
    localcostusd:local;
    savedusd:saved;
    modelid:modelid;
    tokensin:tokensin;
    tokensout:tokensout;
    islocal:islocal
  }
};

f=newsessionsavings():$sessionsavings{
  <$sessionsavings{
    totalcloudcost:0.0;
    totallocalcost:0.0;
    totalsaved:0.0;
    requestcount:0;
    localrequestcount:0
  }
};

f=accumulate(s:$sessionsavings;c:$costcomparison):$sessionsavings{
  let localinc=mut.0; if(c.islocal){ localinc=1 }el{};
  <$sessionsavings{
    totalcloudcost:s.totalcloudcost + c.cloudcostusd;
    totallocalcost:s.totallocalcost + c.localcostusd;
    totalsaved:s.totalsaved + c.savedusd;
    requestcount:s.requestcount + (1 as i32);
    localrequestcount:s.localrequestcount + localinc
  }
};

f=comparisontojson(c:$costcomparison):str{
  let j=mut."{";
  j=str.concat(j;str.concat("\"cloud_cost_usd\":";str.fromfloat(c.cloudcostusd)));
  j=str.concat(j;str.concat(",\"local_cost_usd\":";str.fromfloat(c.localcostusd)));
  j=str.concat(j;str.concat(",\"saved_usd\":";str.fromfloat(c.savedusd)));
  j=str.concat(j;str.concat(",\"model_id\":\"";str.concat(str.jsonescape(c.modelid);"\"")));
  j=str.concat(j;str.concat(",\"tokens_in\":";str.fromint(c.tokensin)));
  j=str.concat(j;str.concat(",\"tokens_out\":";str.fromint(c.tokensout)));
  let islocalstr=mut."false"; if(c.islocal){ islocalstr="true" }el{};
  j=str.concat(j;str.concat(",\"is_local\":";islocalstr));
  j=str.concat(j;"}");
  <j
};

f=savingstojson(s:$sessionsavings):str{
  let j=mut."{";
  j=str.concat(j;str.concat("\"total_cloud_cost\":";str.fromfloat(s.totalcloudcost)));
  j=str.concat(j;str.concat(",\"total_local_cost\":";str.fromfloat(s.totallocalcost)));
  j=str.concat(j;str.concat(",\"total_saved\":";str.fromfloat(s.totalsaved)));
  j=str.concat(j;str.concat(",\"request_count\":";str.fromint(s.requestcount)));
  j=str.concat(j;str.concat(",\"local_request_count\":";str.fromint(s.localrequestcount)));
  j=str.concat(j;"}");
  <j
};

m=moke.profiler;
i=str:std.string;

t=$colstats{
  name:str;
  inferredtype:str;
  nullpct:f32;
  uniquecount:i32;
  cardinality:str;
  sample:@str;
  minstr:str;
  maxstr:str;
  meanstr:str;
  ispiicandidate:bool
};

t=$profileresult{
  datasetname:str;
  rowcount:i32;
  colcount:i32;
  stats:@$colstats;
  piicolcount:i32;
  suggestedsensitivity:str
};

f=ispiiname(col:str):bool{
  let lc=str.lower(col);
  let hits=@(
    "name";"email";"phone";"mobile";"id";"dob";"birth";"address";"street";"suburb";
    "postcode";"ssn";"tfn";"abn";"medicare";"card";"passport";"licence";"license";
    "gender";"sex";"age";"salary";"income";"account";"bsb";"iban";"ip";"device"
  );
  let found=false;
  hits.each(h{
    if(str.contains(lc;h)){ found=true };
  });
  <found
};

f=infertype(values:@str):str{
  let nonnull=values.filter(v{ <str.len(v) > 0 });
  if(str.len(nonnull) = 0){ <"categorical" };
  let allnumeric=true;
  let allbool=true;
  let alldate=true;
  nonnull.each(v{
    if(!str.isfloat(v)){ allnumeric=false };
    let lv=str.lower(v);
    if(lv != "true" && lv != "false" && lv != "yes" && lv != "no" && lv != "1" && lv != "0"){
      allbool=false
    };
    if(!str.matches(v;"^\d){4}[-/]\d{2}[-/]\d{2}") && !str.matches(v;"^\d{2}[-/]\d{2}[-/]\d{4}"){
      alldate=false
    };
  });
  if(allnumeric){ <"numeric" };
  if(alldate){ <"datetime" };
  if(allbool){ <"boolean" };
  let uniquecount=nonnull.distinct().len();
  if(uniquecount < 20){ <"categorical" };
  let avglen=nonnull.map(v{ <str.len(v) }).sum() / nonnull.len();
  if(avglen > 40){ <"text" };
  <"categorical"
};

f=numericstats(values:@str):@str{
  let nums=values.filter(v{ <str.isfloat(v) }).map(v{ <str.tofloat(v) });
  if(nums.len() = 0){ <@(""; ""; "") };
  let mn=nums.min();
  let mx=nums.max();
  let mean=nums.sum() / nums.len();
  <@(str.fromfloat(mn; 4); str.fromfloat(mx; 4); str.fromfloat(mean; 4))
};

f=profile(headers:@str;rows:@(@(str));name:str):$profileresult{
  let rowcount=rows.len();
  let colcount=headers.len();
  let stats=@();
  let piicount=0;
  headers.eachwithindex(col; ci{
    let colvals=rows.map(r{ <r.get(ci) });
    let nullcount=colvals.filter(v{ <str.len(str.trim(v)) = 0 }).len();
    let nullpct=if rowcount > 0{ <(nullcount * 100 / rowcount) }el { <0 };
    let nonnull=colvals.filter(v{ <str.len(str.trim(v)) > 0 });
    let distinct=nonnull.distinct();
    let uniquecount=distinct.len();
    let cardinality=if uniquecount = 1{ <"constant"
    }el if(uniquecount < 10){ <"low"
    }el if(uniquecount < 100){ <"medium"
    }el { <"high" };
    let sample=distinct.take(3);
    let itype=infertype(nonnull);
    let minstr="";
    let maxstr="";
    let meanstr="";
    if(itype = "numeric"){
      let ns=numericstats(nonnull);
      minstr=ns.get(0);
      maxstr=ns.get(1);
      meanstr=ns.get(2);
    };
    let ispii=ispiiname(col);
    if(ispii){ piicount=piicount + 1 };
    stats.push($colstats{
      name=col;
      inferredtype=itype;
      nullpct=str.tofloat(str.fromint(nullpct));
      uniquecount=uniquecount;
      cardinality=cardinality;
      sample=sample;
      minstr=minstr;
      maxstr=maxstr;
      meanstr=meanstr;
      ispiicandidate=ispii
    });
  });
  let sensitivity="PUBLIC";
  let haspii=stats.any(s{ <s.ispiicandidate });
  let hasid=stats.any(s{ <str.contains(str.lower(s.name);"id") || str.contains(str.lower(s.name);"key") });
  if(haspii){ sensitivity="CONFIDENTIAL" }el if(hasid){ sensitivity="INTERNAL" };
  <$profileresult{
    datasetname=name;
    rowcount=rowcount;
    colcount=colcount;
    stats=stats;
    piicolcount=piicount;
    suggestedsensitivity=sensitivity
  }
};

f=formatprofile(result:$profileresult):str{
  let lines=@();
  lines.push("Dataset: " + result.datasetname);
  lines.push("Rows: " + str.fromint(result.rowcount) + "  Columns: " + str.fromint(result.colcount));
  lines.push("Suggested sensitivity: " + result.suggestedsensitivity);
  lines.push("PII candidate columns: " + str.fromint(result.piicolcount));
  lines.push("---");
  result.stats.each(s{
    let piiflag=if s.ispiicandidate{ " [PII]" }el { "" };
    lines.push(s.name + " (" + s.inferredtype + ")" + piiflag);
    lines.push("  nulls=" + str.fromfloat(s.nullpct; 1) + "%  unique=" + str.fromint(s.uniquecount) + "  cardinality=" + s.cardinality);
    if(str.len(s.sample) > 0){
      lines.push("  sample=[" + str.join(s.sample; ", ") + "]");
    };
    if(str.len(s.minstr) > 0){
      lines.push("  min=" + s.minstr + "  max=" + s.maxstr + "  mean=" + s.meanstr);
    };
  });
  <str.join(lines; "
")
};

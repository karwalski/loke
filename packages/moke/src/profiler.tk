m=moke.profiler;
i=str:std.string;

t=$colstats{
  name:str;
  inferredtype:str;
  nullpct:f32;
  uniquecount:i32;
  cardinality:str;
  sample:@str;
  minstr:str;
  maxstr:str;
  meanstr:str;
  ispiicandidate:bool
};

t=$profileresult{
  datasetname:str;
  rowcount:i32;
  colcount:i32;
  stats:@$colstats;
  piicolcount:i32;
  suggestedsensitivity:str
};

f=ispiiname(col:str):bool{
  let lc=str.lower(col);
  let hits=@(
    "name";"email";"phone";"mobile";"id";"dob";"birth";"address";"street";"suburb";
    "postcode";"ssn";"tfn";"abn";"medicare";"card";"passport";"licence";"license";
    "gender";"sex";"age";"salary";"income";"account";"bsb";"iban";"ip";"device"
  );
  let found=mut.false;
  lp(let ii=0;ii<hits.len;ii=ii+1){
    let h=hits.get(ii);
    if(str.contains(lc;h)){ found=true }
  };
  <found
};

f=infertype(values:@str):str{
  let nonnull=mut.@();
  lp(let ii=0;ii<values.len;ii=ii+1){
    let v=values.get(ii);
    if(str.len(v) > 0){ nonnull=nonnull.push(v) };
  };
  if(str.len(nonnull) = 0){ <"categorical" };
  let allnumeric=mut.true;
  let allbool=mut.true;
  let alldate=mut.true;
  lp(let ii=0;ii<nonnull.len;ii=ii+1){
    let v=nonnull.get(ii);
    if(!str.isfloat(v)){ allnumeric=false };
    let lv=str.lower(v);
    if(!(lv = "true") && !(lv = "false") && !(lv = "yes") && !(lv = "no") && !(lv = "1") && !(lv = "0")){
      allbool=false
    };
    if(!str.matchesdate(v)){
      alldate=false
    };
  };
  if(allnumeric){ <"numeric" };
  if(alldate){ <"datetime" };
  if(allbool){ <"boolean" };
  let uniquecount=nonnull.len;
  if(uniquecount < 20){ <"categorical" };
  let avglensum=mut.0;
  lp(let ii=0;ii<nonnull.len;ii=ii+1){
    let v=nonnull.get(ii);
    avglensum=avglensum + str.len(v)
  };
  let avglen=avglensum / nonnull.len();
  if(avglen > 40){ <"text" };
  <"categorical"
};

f=numericstats(values:@str):@str{
  let nums=mut.@();
  lp(let ii=0;ii<values.len;ii=ii+1){
    let v=values.get(ii);
    if(str.isfloat(v)){ nums=nums.push(str.tofloat(v)) }
  };
  if(nums.len() = 0){ <@("";""; "") };
  let mn=nums.min();
  let mx=nums.max();
  let mean=nums.sum() / nums.len();
  <@(str.fromfloat(mn;4);str.fromfloat(mx;4);str.fromfloat(mean;4))
};

f=profile(headers:@str;rows:@(@str);name:str):$profileresult{
  let rowcount=rows.len();
  let colcount=headers.len();
  let stats=mut.@();
  let piicount=mut.0;
  lp(let ci=0;ci<headers.len;ci=ci+1){
    let col=headers.get(ci);
    let colvals=mut.@();
    lp(let ri=0;ri<rows.len;ri=ri+1){
      let r=rows.get(ri);
      colvals=colvals.push(r.get(ci))
    };
    let nullcount=mut.0;
    lp(let ni=0;ni<colvals.len;ni=ni+1){
      let v=colvals.get(ni);
      if(str.len(str.trim(v)) = 0){ nullcount=nullcount+1 }
    };
    let nullpct=mut.0;
    if(rowcount > 0){ nullpct=(nullcount * 100 / rowcount) }el{};
    let nonnull=mut.@();
    lp(let ni=0;ni<colvals.len;ni=ni+1){
      let v=colvals.get(ni);
      if(str.len(str.trim(v)) > 0){ nonnull=nonnull.push(v) }
    };
    let distinct=nonnull.distinct();
    let uniquecount=distinct.len();
    let cardinality=mut."high";
    if(uniquecount = 1){ cardinality="constant"
    }el{ if(uniquecount < 10){ cardinality="low"
    }el{ if(uniquecount < 100){ cardinality="medium"
    }el{} }};
    let sample=distinct.take(3);
    let itype=infertype(nonnull);
    let minstr=mut."";
    let maxstr=mut."";
    let meanstr=mut."";
    if(itype = "numeric"){
      let ns=numericstats(nonnull);
      minstr=ns.get(0);
      maxstr=ns.get(1);
      meanstr=ns.get(2)
    };
    let ispii=ispiiname(col);
    if(ispii){ piicount=piicount + 1 };
    stats=stats.push($colstats{
      name:col;
      inferredtype:itype;
      nullpct:str.tofloat(str.fromint(nullpct));
      uniquecount:uniquecount;
      cardinality:cardinality;
      sample:sample;
      minstr:minstr;
      maxstr:maxstr;
      meanstr:meanstr;
      ispiicandidate:ispii
    })
  };
  let sensitivity=mut."PUBLIC";
  let haspii=mut.false;
  lp(let ii=0;ii<stats.len;ii=ii+1){
    let s=stats.get(ii);
    if(s.ispiicandidate){ haspii=true }
  };
  let hasid=mut.false;
  lp(let ii=0;ii<stats.len;ii=ii+1){
    let s=stats.get(ii);
    if(str.contains(str.lower(s.name);"id") || str.contains(str.lower(s.name);"key")){ hasid=true }
  };
  if(haspii){ sensitivity="CONFIDENTIAL" }el{ if(hasid){ sensitivity="INTERNAL" } };
  <$profileresult{
    datasetname:name;
    rowcount:rowcount;
    colcount:colcount;
    stats:stats;
    piicolcount:piicount;
    suggestedsensitivity:sensitivity
  }
};

f=formatprofile(result:$profileresult):str{
  let lines=mut.@();
  lines=lines.push(str.concat("Dataset: ";result.datasetname));
  lines=lines.push(str.concat("Rows: ";str.concat(str.fromint(result.rowcount);str.concat("  Columns: ";str.fromint(result.colcount)))));
  lines=lines.push(str.concat("Suggested sensitivity: ";result.suggestedsensitivity));
  lines=lines.push(str.concat("PII candidate columns: ";str.fromint(result.piicolcount)));
  lines.push("---");
  lp(let ii=0;ii<result.stats.len;ii=ii+1){
    let s=result.stats.get(ii);
    let piiflag=mut."";
    if(s.ispiicandidate){ piiflag=" [PII]" }el{};
    lines.push(s.name + " (" + s.inferredtype + ")" + piiflag);
    lines.push("  nulls=" + str.fromfloat(s.nullpct;1) + "%  unique=" + str.fromint(s.uniquecount) + "  cardinality=" + s.cardinality);
    if(str.len(s.sample) > 0){
      lines.push("  sample=[" + str.join(s.sample;", ") + "]")
    };
    if(str.len(s.minstr) > 0){
      lines.push("  min=" + s.minstr + "  max=" + s.maxstr + "  mean=" + s.meanstr)
    }
  };
  <str.join(lines;"
")
};

m=moke.approval;

i=str:std.str;
i=log:std.log;
i=sens:moke.sensitivity;
i=clog:moke.consolelog;

t=$difftoken{
  text:$str;
  kind:$str  
};
t=$reviewpayload{
  requestid:$str;
  originalprompt:$str;
  transformedprompt:$str;
  sensitivitylevel:$str;
  difftokens:@$difftoken;
  piicount:i32;
  tokencountbefore:i32;
  tokencountafter:i32
};
t=$approvaldecision{
  requestid:$str;
  action:$str;       
  timestamp:i64;
  sensitivity:$str
};

f=requiresreview(sensitivitylevel:$str):bool{
  let level=sens.fromstring(sensitivitylevel);
  if(level = "CONFIDENTIAL" ){ <true };
  if(level = "RESTRICTED"   ){ <true };
  <false
};
f=builddiff(original:$str; transformed:$str; piientities:@$str:@$difftoken{
  let tokens=@$difftoken;

  let origwords=str.split(original; " ");
  let transwords=str.split(transformed; " ");
  let oi=mut.0;
  let ti=mut.0;

  lp(true) {
    if(oi > str.len(origwords) && ti > str.len(transwords) ){ break }el{
      if(oi > str.len(origwords) ){
        let tw=str.get(transwords; ti);
        tokens:@.push(tokens; $difftoken{ text=tw; kind="anonymised" });
        ti:$ti+1
      }; else if(ti > str.len(transwords) ){
        let ow=str.get(origwords; oi);
        let ispii=false;
        piientities.each|e{
          if(str.contains(ow; e) ){ ispii=true }el{};
        };
        if(ispii ){
          tokens:@.push(tokens; $difftoken{ text=ow; kind="removed_pii" })
        }el{
          tokens:@.push(tokens; $difftoken{ text=ow; kind="compressed" })
        };
        oi=oi+1
      }el{
        let ow=str.get(origwords; oi);
        let tw=str.get(transwords; ti);
        if(str.eq(ow; tw) ){
          tokens:@.push(tokens; $difftoken{ text=ow; kind="unchanged" });
          oi:$oi+1;
          ti:$ti+1
        }el{
          let isplaceholder=str.contains(tw; "_1") || str.contains(tw; "_2") ||
                             str.contains(tw; "PERSON") || str.contains(tw; "MEDICARE") ||
                             str.contains(tw; "ADDRESS") || str.contains(tw; "PHONE") ||
                             str.contains(tw; "EMAIL") || str.contains(tw; "DOB") ||
                             str.contains(tw; "SUPPRESSED");
          if(isplaceholder ){
            tokens:@.push(tokens; $difftoken{ text=ow; kind="removed_pii" });
            tokens:@.push(tokens; $difftoken{ text=tw; kind="anonymised" })
          }el{
            tokens:@.push(tokens; $difftoken{ text=ow; kind="compressed" });
            tokens:@.push(tokens; $difftoken{ text=tw; kind="compressed" })
          };
          oi=oi+1;
          ti=ti+1
        };
      };
    };
  };
  <tokens
};
f=logdecision(sessionlog:i64$sessionlog:i64; requestid:$str; action:$str; sensitivity:$str):i64$sessionlog{
  let detail="request=" + requestid + " action=" + action + " sensitivity=" + sensitivity;
  log.info("moke.approval: " + detail);
  <clog.append(sessionlog; "approval"; action; detail; 0)
};

m=moke.approval;

i=str:std.str;
i=log:std.log;
i=sens:moke.sensitivity;
i=clog:moke.consolelog;

t=$difftoken{
  text:str;
  kind:str
};
t=$reviewpayload{
  requestid:str;
  originalprompt:str;
  transformedprompt:str;
  sensitivitylevel:str;
  difftokens:@$difftoken;
  piicount:i32;
  tokencountbefore:i32;
  tokencountafter:i32
};
t=$approvaldecision{
  requestid:str;
  action:str;
  timestamp:i64;
  sensitivity:str
};

f=requiresreview(sensitivitylevel:str):bool{
  let level=sens.fromstring(sensitivitylevel);
  if(level = "CONFIDENTIAL"){ <true };
  if(level = "RESTRICTED"){ <true };
  <false
};

f=builddiff(original:str;transformed:str;piientities:@str):@$difftoken{
  let tokens=@();

  let origwords=str.split(original;" ");
  let transwords=str.split(transformed;" ");
  let oi=mut.0;
  let ti=mut.0;

  lp(let lv=0;true;lv=lv){
    if(oi > str.len(origwords) && ti > str.len(transwords)){ <tokens }el{
      if(oi > str.len(origwords)){
        let tw=str.get(transwords;ti);
        tokens.push($difftoken{ text=tw; kind="anonymised" });
        ti=ti+1
      }el{
        if(ti > str.len(transwords)){
          let ow=str.get(origwords;oi);
          let ispii=false;
          let ei=0;
          lp(let lv2=0;ei < piientities.len();lv2=lv2){
            let e=piientities.get(ei);
            if(str.contains(ow;e)){ ispii=true };
            ei=ei+1
          };
          if(ispii){
            tokens.push($difftoken{ text=ow; kind="removed_pii" })
          }el{
            tokens.push($difftoken{ text=ow; kind="compressed" })
          };
          oi=oi+1
        }el{
          let ow=str.get(origwords;oi);
          let tw=str.get(transwords;ti);
          if(str.eq(ow;tw)){
            tokens.push($difftoken{ text=ow; kind="unchanged" });
            oi=oi+1;
            ti=ti+1
          }el{
            let isplaceholder=str.contains(tw;"PERSON") || str.contains(tw;"MEDICARE") ||
                               str.contains(tw;"ADDRESS") || str.contains(tw;"PHONE") ||
                               str.contains(tw;"EMAIL") || str.contains(tw;"DOB") ||
                               str.contains(tw;"SUPPRESSED");
            if(isplaceholder){
              tokens.push($difftoken{ text=ow; kind="removed_pii" });
              tokens.push($difftoken{ text=tw; kind="anonymised" })
            }el{
              tokens.push($difftoken{ text=ow; kind="compressed" });
              tokens.push($difftoken{ text=tw; kind="compressed" })
            };
            oi=oi+1;
            ti=ti+1
          }
        }
      }
    }
  };
  <tokens
};

f=logdecision(sessionlog:i64;requestid:str;action:str;sensitivity:str):i64{
  let detail="request=" + requestid + " action=" + action + " sensitivity=" + sensitivity;
  log.info("moke.approval: " + detail);
  <clog.append(sessionlog;"approval";action;detail;0)
};

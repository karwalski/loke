m=ooke.handlers;
i=http:std.http;
i=agents:page.moke.agents;
i=apiagents:page.moke.api.agents;
i=apidatasets:page.moke.api.datasets;
i=apifeedback:page.moke.api.feedback;
i=apihealth:page.moke.api.health;
i=apimemory:page.moke.api.memory;
i=apipipeline:page.moke.api.pipeline;
i=apirouting:page.moke.api.routing;
i=apistream:page.moke.api.stream;
i=apiupload:page.moke.api.upload;
i=chat:page.moke.chat;
i=confirm:page.moke.confirm;
i=dashboard:page.moke.dashboard;
i=governance:page.moke.governance;
i=index:page.moke.index;
i=insight:page.moke.insight;
i=lokehealth:page.moke.lokehealth;
i=mcp:page.moke.mcp;
i=memory:page.moke.memory;
i=settings:page.moke.settings;
i=sysmon:page.moke.sysmon;
i=upload:page.moke.upload;

f=hagentsget(req:i64):i64{
  <agents.get(req)
};

f=hapiagentsget(req:i64):i64{
  <apiagents.get(req)
};

f=hapidatasetspost(req:i64):i64{
  <apidatasets.post(req)
};

f=hapifeedbackpost(req:i64):i64{
  <apifeedback.post(req)
};

f=hapihealthget(req:i64):i64{
  <apihealth.get(req)
};

f=hapimemoryget(req:i64):i64{
  <apimemory.get(req)
};

f=hapimemorypost(req:i64):i64{
  <apimemory.post(req)
};

f=hapipipelineget(req:i64):i64{
  <apipipeline.get(req)
};

f=hapipipelinepost(req:i64):i64{
  <apipipeline.post(req)
};

f=hapiroutingpost(req:i64):i64{
  <apirouting.post(req)
};

f=hapistreampost(req:i64):i64{
  <apistream.post(req)
};

f=hapiuploadpost(req:i64):i64{
  <apiupload.post(req)
};

f=hchatget(req:i64):i64{
  <chat.get(req)
};

f=hconfirmget(req:i64):i64{
  <confirm.get(req)
};

f=hdashboardget(req:i64):i64{
  <dashboard.get(req)
};

f=hgovernanceget(req:i64):i64{
  <governance.get(req)
};

f=hindexget(req:i64):i64{
  <index.get(req)
};

f=hinsightget(req:i64):i64{
  <insight.get(req)
};

f=hlokehealthget(req:i64):i64{
  <lokehealth.get(req)
};

f=hmcpget(req:i64):i64{
  <mcp.get(req)
};

f=hmemoryget(req:i64):i64{
  <memory.get(req)
};

f=hsettingsget(req:i64):i64{
  <settings.get(req)
};

f=hsysmonget(req:i64):i64{
  <sysmon.get(req)
};

f=huploadget(req:i64):i64{
  <upload.get(req)
};

f=registerall():@str{
  let paths=mut.@();
  http.get("/agents";&hagentsget);
  paths=paths.append("/agents");
  http.get("/api/agents";&hapiagentsget);
  paths=paths.append("/api/agents");
  http.post("/api/datasets";&hapidatasetspost);
  http.post("/api/feedback";&hapifeedbackpost);
  http.get("/api/health";&hapihealthget);
  paths=paths.append("/api/health");
  http.get("/api/memory";&hapimemoryget);
  paths=paths.append("/api/memory");
  http.post("/api/memory";&hapimemorypost);
  http.get("/api/pipeline";&hapipipelineget);
  paths=paths.append("/api/pipeline");
  http.post("/api/pipeline";&hapipipelinepost);
  http.post("/api/routing";&hapiroutingpost);
  http.post("/api/stream";&hapistreampost);
  http.post("/api/upload";&hapiuploadpost);
  http.get("/chat";&hchatget);
  paths=paths.append("/chat");
  http.get("/confirm";&hconfirmget);
  paths=paths.append("/confirm");
  http.get("/dashboard";&hdashboardget);
  paths=paths.append("/dashboard");
  http.get("/governance";&hgovernanceget);
  paths=paths.append("/governance");
  http.get("/";&hindexget);
  paths=paths.append("/");
  http.get("/insight";&hinsightget);
  paths=paths.append("/insight");
  http.get("/lokehealth";&hlokehealthget);
  paths=paths.append("/lokehealth");
  http.get("/mcp";&hmcpget);
  paths=paths.append("/mcp");
  http.get("/memory";&hmemoryget);
  paths=paths.append("/memory");
  http.get("/settings";&hsettingsget);
  paths=paths.append("/settings");
  http.get("/sysmon";&hsysmonget);
  paths=paths.append("/sysmon");
  http.get("/upload";&huploadget);
  paths=paths.append("/upload");
  <paths
};

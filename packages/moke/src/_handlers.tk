m=ooke.handlers;
i=http:std.http;
i=agents:page.moke.agents;
i=apiagents:page.moke.api.agents;
i=apiagentsdiary:page.moke.api.agents.diary;
i=apiagentsscan:page.moke.api.agents.scan;
i=apiagentsschema:page.moke.api.agents.schema;
i=apidatasets:page.moke.api.datasets;
i=apifeedback:page.moke.api.feedback;
i=apihealth:page.moke.api.health;
i=apimcpbroker:page.moke.api.mcp.broker;
i=apimcpinvoke:page.moke.api.mcp.invoke;
i=apimcpmemory:page.moke.api.mcp.memory;
i=apimcptools:page.moke.api.mcp.tools;
i=apimemory:page.moke.api.memory;
i=apimlpropose:page.moke.api.ml.propose;
i=apimlrun:page.moke.api.ml.run;
i=apipipeline:page.moke.api.pipeline;
i=apiproxy:page.moke.api.proxy;
i=apirouting:page.moke.api.routing;
i=apisession:page.moke.api.session;
i=apistream:page.moke.api.stream;
i=apiupload:page.moke.api.upload;
i=chat:page.moke.chat;
i=confirm:page.moke.confirm;
i=connections:page.moke.connections;
i=dashboard:page.moke.dashboard;
i=governance:page.moke.governance;
i=index:page.moke.index;
i=insight:page.moke.insight;
i=lokehealth:page.moke.lokehealth;
i=mcp:page.moke.mcp;
i=memory:page.moke.memory;
i=presentation:page.moke.presentation;
i=settings:page.moke.settings;
i=setup:page.moke.setup;
i=sysmon:page.moke.sysmon;
i=upload:page.moke.upload;

f=hagentsget(req:i64):i64{
  <agents.get(req)
};

f=hapiagentsget(req:i64):i64{
  <apiagents.get(req)
};

f=hapiagentsdiaryget(req:i64):i64{
  <apiagentsdiary.get(req)
};

f=hapiagentsscanpost(req:i64):i64{
  <apiagentsscan.post(req)
};

f=hapiagentsschemapost(req:i64):i64{
  <apiagentsschema.post(req)
};

f=hapidatasetspost(req:i64):i64{
  <apidatasets.post(req)
};

f=hapifeedbackpost(req:i64):i64{
  <apifeedback.post(req)
};

f=hapihealthget(req:i64):i64{
  <apihealth.get(req)
};

f=hapimcpbrokerget(req:i64):i64{
  <apimcpbroker.get(req)
};

f=hapimcpinvokepost(req:i64):i64{
  <apimcpinvoke.post(req)
};

f=hapimcpmemoryget(req:i64):i64{
  <apimcpmemory.get(req)
};

f=hapimcpmemorypost(req:i64):i64{
  <apimcpmemory.post(req)
};

f=hapimcptoolsget(req:i64):i64{
  <apimcptools.get(req)
};

f=hapimemoryget(req:i64):i64{
  <apimemory.get(req)
};

f=hapimemorypost(req:i64):i64{
  <apimemory.post(req)
};

f=hapimlproposepost(req:i64):i64{
  <apimlpropose.post(req)
};

f=hapimlrunpost(req:i64):i64{
  <apimlrun.post(req)
};

f=hapipipelineget(req:i64):i64{
  <apipipeline.get(req)
};

f=hapipipelinepost(req:i64):i64{
  <apipipeline.post(req)
};

f=hapiproxypost(req:i64):i64{
  <apiproxy.post(req)
};

f=hapiroutingpost(req:i64):i64{
  <apirouting.post(req)
};

f=hapisessionpost(req:i64):i64{
  <apisession.post(req)
};

f=hapistreampost(req:i64):i64{
  <apistream.post(req)
};

f=hapiuploadpost(req:i64):i64{
  <apiupload.post(req)
};

f=hchatget(req:i64):i64{
  <chat.get(req)
};

f=hconfirmget(req:i64):i64{
  <confirm.get(req)
};

f=hconnectionsget(req:i64):i64{
  <connections.get(req)
};

f=hdashboardget(req:i64):i64{
  <dashboard.get(req)
};

f=hgovernanceget(req:i64):i64{
  <governance.get(req)
};

f=hindexget(req:i64):i64{
  <index.get(req)
};

f=hinsightget(req:i64):i64{
  <insight.get(req)
};

f=hlokehealthget(req:i64):i64{
  <lokehealth.get(req)
};

f=hmcpget(req:i64):i64{
  <mcp.get(req)
};

f=hmemoryget(req:i64):i64{
  <memory.get(req)
};

f=hpresentationget(req:i64):i64{
  <presentation.get(req)
};

f=hsettingsget(req:i64):i64{
  <settings.get(req)
};

f=hsetupget(req:i64):i64{
  <setup.get(req)
};

f=hsysmonget(req:i64):i64{
  <sysmon.get(req)
};

f=huploadget(req:i64):i64{
  <upload.get(req)
};

f=registerall():@$str{
  let paths=mut.@($str);
  (http.get("/agents";&hagentsget));
  paths=paths.append("/agents");
  (http.get("/api/agents";&hapiagentsget));
  paths=paths.append("/api/agents");
  (http.get("/api/agents/diary";&hapiagentsdiaryget));
  paths=paths.append("/api/agents/diary");
  (http.post("/api/agents/scan";&hapiagentsscanpost));
  (http.post("/api/agents/schema";&hapiagentsschemapost));
  (http.post("/api/datasets";&hapidatasetspost));
  (http.post("/api/feedback";&hapifeedbackpost));
  (http.get("/api/health";&hapihealthget));
  paths=paths.append("/api/health");
  (http.get("/api/mcp/broker";&hapimcpbrokerget));
  paths=paths.append("/api/mcp/broker");
  (http.post("/api/mcp/invoke";&hapimcpinvokepost));
  (http.get("/api/mcp/memory";&hapimcpmemoryget));
  paths=paths.append("/api/mcp/memory");
  (http.post("/api/mcp/memory";&hapimcpmemorypost));
  (http.get("/api/mcp/tools";&hapimcptoolsget));
  paths=paths.append("/api/mcp/tools");
  (http.get("/api/memory";&hapimemoryget));
  paths=paths.append("/api/memory");
  (http.post("/api/memory";&hapimemorypost));
  (http.post("/api/ml/propose";&hapimlproposepost));
  (http.post("/api/ml/run";&hapimlrunpost));
  (http.get("/api/pipeline";&hapipipelineget));
  paths=paths.append("/api/pipeline");
  (http.post("/api/pipeline";&hapipipelinepost));
  (http.post("/api/proxy";&hapiproxypost));
  (http.post("/api/routing";&hapiroutingpost));
  (http.post("/api/session";&hapisessionpost));
  (http.post("/api/stream";&hapistreampost));
  (http.post("/api/upload";&hapiuploadpost));
  (http.get("/chat";&hchatget));
  paths=paths.append("/chat");
  (http.get("/confirm";&hconfirmget));
  paths=paths.append("/confirm");
  (http.get("/connections";&hconnectionsget));
  paths=paths.append("/connections");
  (http.get("/dashboard";&hdashboardget));
  paths=paths.append("/dashboard");
  (http.get("/governance";&hgovernanceget));
  paths=paths.append("/governance");
  (http.get("/";&hindexget));
  paths=paths.append("/");
  (http.get("/insight";&hinsightget));
  paths=paths.append("/insight");
  (http.get("/lokehealth";&hlokehealthget));
  paths=paths.append("/lokehealth");
  (http.get("/mcp";&hmcpget));
  paths=paths.append("/mcp");
  (http.get("/memory";&hmemoryget));
  paths=paths.append("/memory");
  (http.get("/presentation";&hpresentationget));
  paths=paths.append("/presentation");
  (http.get("/settings";&hsettingsget));
  paths=paths.append("/settings");
  (http.get("/setup";&hsetupget));
  paths=paths.append("/setup");
  (http.get("/sysmon";&hsysmonget));
  paths=paths.append("/sysmon");
  (http.get("/upload";&huploadget));
  paths=paths.append("/upload");
  <paths
};
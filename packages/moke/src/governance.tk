m=moke.governance;

i=str:std.str;
(* shared.types is no longer imported: `$lokeerr`/`$configerr` were its only use here
   and `findpreset` no longer returns a result. An unused import still costs a slot in the
   signature table that `max_funcs` bounds (T-25). *)
i=time:std.time;
i=jx:shared.jsonobj;

t=$regulatorypreset{
  id:str;
  name:str;
  description:str;
  classificationdefault:str;
  blockedentitytypes:@str;
  crossborderallowed:bool;
  anonymisationstrength:str;
  customrules:@str
};
t=$riskassessment{
  tier:str;
  score:i32;
  reasons:@str
};
t=$complianceevent{
  timestamp:str;
  eventtype:str;
  detail:str;
  severity:str;
  risktier:str
};
t=$compliancereport{
  generatedat:str;
  presetname:str;
  totalrequests:i32;
  violations:i32;
  privacypct:i32;
  riskbreakdownlow:i32;
  riskbreakdownmedium:i32;
  riskbreakdownhigh:i32;
  events:@$complianceevent
};

f=getpresets():@$regulatorypreset{
  <@(
    $regulatorypreset{
      id:"eu-gdpr";name:"EU GDPR";description:"General Data Protection Regulation (EU) 2016/679";
      classificationdefault:"confidential";blockedentitytypes:@("health";"biometric";"political";"religion";"sexual_orientation";"trade_union";"genetic");
      crossborderallowed:false;anonymisationstrength:"full";
      customrules:@("dpa_required_for_providers";"art9_special_categories_blocked";"right_to_erasure_supported")
    };
    $regulatorypreset{
      id:"au-privacy";name:"AU Privacy Act";description:"Australian Privacy Act 1988 and Australian Privacy Principles";
      classificationdefault:"confidential";blockedentitytypes:@("tfn";"medicare");
      crossborderallowed:false;anonymisationstrength:"reasonable";
      customrules:@("app8_comparable_protections";"eligible_data_breach_30_days";"oaic_notification_required")
    };
    $regulatorypreset{
      id:"hipaa";name:"US HIPAA";description:"Health Insurance Portability and Accountability Act";
      classificationdefault:"restricted";blockedentitytypes:@("health";"ssn";"medical_record";"insurance";"dob");
      crossborderallowed:false;anonymisationstrength:"full";
      customrules:@("baa_required";"safe_harbor_deidentification";"60_day_breach_notification";"minimum_necessary_standard")
    };
    $regulatorypreset{
      id:"ccpa";name:"US CCPA/CPRA";description:"California Consumer Privacy Act and California Privacy Rights Act";
      classificationdefault:"confidential";blockedentitytypes:@();
      crossborderallowed:true;anonymisationstrength:"reasonable";
      customrules:@("service_provider_contract_required";"45_day_consumer_response";"opt_out_of_sale_supported")
    };
    $regulatorypreset{
      id:"uk-gdpr";name:"UK GDPR";description:"UK General Data Protection Regulation";
      classificationdefault:"confidential";blockedentitytypes:@("health";"biometric";"political";"religion");
      crossborderallowed:false;anonymisationstrength:"full";
      customrules:@("uk_idta_required";"72_hour_ico_notification";"dpa_required")
    };
    $regulatorypreset{
      id:"sg-pdpa";name:"Singapore PDPA";description:"Personal Data Protection Act 2012";
      classificationdefault:"confidential";blockedentitytypes:@("nric");
      crossborderallowed:false;anonymisationstrength:"reasonable";
      customrules:@("transfer_limitation";"3_day_pdpc_notification";"data_intermediary_obligations")
    };
    $regulatorypreset{
      id:"minimal";name:"Minimal";description:"Minimal restrictions for testing and development";
      classificationdefault:"public";blockedentitytypes:@();
      crossborderallowed:true;anonymisationstrength:"placeholder";
      customrules:@()
    }
  )
};

(* --- Why this returns a sentinel and not a result --------------------------------
   It used to be `$regulatorypreset!$lokeerr`. For a result whose error side is a USER-declared
   sum the discriminant is never read: `mt` always takes arm 0 (T-18). So `$err($configerr(...))`
   was indistinguishable from a found preset at every call site -- a caller asking for a
   regulation that does not exist would have been handed the first arm's binding and gone on to
   enforce it. An unknown preset id is now an inert preset: no blocked entity types, no
   cross-border permission, and an empty id that `haspreset` reports as absent. Fail-closed, and
   discriminable. *)
(* `generatedat` was the literal string "now", so every compliance report this module produced
   was stamped with the word rather than a time — and `scripts/find_sql_literal_now.py` flags it,
   because that is exactly the mistake that put the text `now()` in the database (GA5.1). *)
f=nowiso():str{
  <time.format(time.now();"%Y-%m-%dT%H:%M:%SZ")
};

f=nopreset():$regulatorypreset{
  <$regulatorypreset{
    id:"";
    name:"";
    description:"";
    classificationdefault:"restricted";
    blockedentitytypes:@();
    crossborderallowed:false;
    anonymisationstrength:"full";
    customrules:@()
  }
};

f=findpreset(id:str):$regulatorypreset{
  let presets=getpresets();
  lp(let ii=0;ii<presets.len;ii=ii+1){
    let p:$regulatorypreset=presets.get(ii);
    if(p.id == id){ <p }
  };
  <nopreset()
};

f=haspreset(id:str):bool{
  <str.len(findpreset(id).id)>0
};

f=classifyrisk(sensitivity:str;entitycount:i32;crossborder:bool;hasblockedentities:bool):$riskassessment{
  let score=mut.0;
  let reasons=mut.@();

  if(sensitivity == "RESTRICTED"){
    score=score+40;
    reasons=reasons.push("RESTRICTED classification")
  }el{ if(sensitivity == "CONFIDENTIAL"){
    score=score+25;
    reasons=reasons.push("CONFIDENTIAL classification")
  }el{ if(sensitivity == "INTERNAL"){
    score=score+10;
    reasons=reasons.push("INTERNAL classification")
  }}};
  if(entitycount > 10){
    score=score+30;
    reasons=reasons.push("High PII entity count (\(str.fromint(entitycount as i64)))")
  }el{ if(entitycount > 3){
    score=score+15;
    reasons=reasons.push("Moderate PII entity count (\(str.fromint(entitycount as i64)))")
  }el{ if(entitycount > 0){
    score=score+5;
    reasons=reasons.push("Low PII entity count (\(str.fromint(entitycount as i64)))")
  }}};
  if(crossborder){
    score=score+15;
    reasons=reasons.push("Cross-border data transfer")
  };
  if(hasblockedentities){
    score=score+20;
    reasons=reasons.push("Contains blocked entity types")
  };
  let tier=mut."Low";
  if(score > 50){ tier="High"
  }el{ if(score > 25){ tier="Medium"
  }el{} };
  <$riskassessment{tier:tier;score:score as i32;reasons:reasons}
};

f=generatereport(presetname:str;events:@$complianceevent):$compliancereport{
  let violations=mut.0;
  let low=mut.0;
  let medium=mut.0;
  let high=mut.0;
  lp(let ii=0;ii<events.len;ii=ii+1){
    let e=events.get(ii);
    if(e.severity == "violation"){ violations=violations+1 };
    if(e.risktier == "Low"){ low=low+1 }el{
      if(e.risktier == "Medium"){ medium=medium+1 }el{
        if(e.risktier == "High"){ high=high+1 }
      }
    }
  };
  (* `events.len()` read as property. Measured in the emitted IR, `arr.len()` and `arr.len` are
     the identical `getelementptr i64, i64* %p, i32 -1` -- the method spelling was not a defect,
     only an inconsistency. *)
  let total=events.len;
  let privacypct=mut.100;
  if(total > 0){ privacypct=((total - violations) * 100) / total };

  <$compliancereport{
    generatedat:nowiso();
    presetname:presetname;
    totalrequests:total as i32;
    violations:violations as i32;
    privacypct:privacypct as i32;
    riskbreakdownlow:low as i32;
    riskbreakdownmedium:medium as i32;
    riskbreakdownhigh:high as i32;
    events:events
  }
};

(* RFC 4180: a quoted CSV field escapes a double quote by doubling it. `detail` was interpolated
   into a quoted field raw, so one quote in an event detail ended the field early and shifted
   every remaining column of that row -- which in a compliance export is a silently wrong
   record, not a formatting nuisance. *)
f=csvquote(v:str):str{
  <"\"\(str.replace(v;"\"";"\"\""))\""
};

f=reporttocsv(report:$compliancereport):str{
  let out=mut."timestamp,event_type,detail,severity,risk_tier\n";
  lp(let ii=0;ii<report.events.len;ii=ii+1){
    let e:$complianceevent=report.events.get(ii);
    out=str.concat(out;"\(e.timestamp),\(e.eventtype),\(csvquote(e.detail)),\(e.severity),\(e.risktier)\n")
  };
  <out
};

(* The preset name and the generated-at stamp went into the JSON unescaped. *)
f=reporttojson(report:$compliancereport):str{
  <"{\"generated_at\":\(jx.escape(report.generatedat)),\"preset\":\(jx.escape(report.presetname)),\"total_requests\":\(str.fromint(report.totalrequests as i64)),\"violations\":\(str.fromint(report.violations as i64)),\"privacy_pct\":\(str.fromint(report.privacypct as i64)),\"risk_breakdown\":{\"low\":\(str.fromint(report.riskbreakdownlow as i64)),\"medium\":\(str.fromint(report.riskbreakdownmedium as i64)),\"high\":\(str.fromint(report.riskbreakdownhigh as i64))}}"
};

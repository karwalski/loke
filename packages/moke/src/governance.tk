m=moke.governance;

i=str:std.string;

t=$regulatorypreset{
  id:$str;
  name:$str;
  description:$str;
  classificationdefault:$str;
  blockedentitytypes:@$str;
  crossborderallowed:bool;
  anonymisationstrength:$str;
  customrules:@$str
};
t=$risktier{
  $low:i64;
  $medium:i64;
  $high:i64
};
t=$riskassessment{
  tier:$str;
  score:i32;
  reasons:@$str
};
t=$complianceevent{
  timestamp:$str;
  eventtype:$str;
  detail:$str;
  severity:$str;
  risktier:$str
};
t=$compliancereport{
  generatedat:$str;
  presetname:$str;
  totalrequests:i32;
  violations:i32;
  privacypct:i32;
  riskbreakdownlow:i32;
  riskbreakdownmedium:i32;
  riskbreakdownhigh:i32;
  events:@$complianceevent
};

f=getpresets():@$regulatorypreset{
  <@(
    $regulatorypreset{
      id:"eu-gdpr";name:"EU GDPR";description:"General Data Protection Regulation (EU) 2016/679";
      classificationdefault:"confidential";blockedentitytypes:@("health";"biometric";"political";"religion";"sexual_orientation";"trade_union";"genetic");
      crossborderallowed:false;anonymisationstrength:"full";
      customrules:@("dpa_required_for_providers";"art9_special_categories_blocked";"right_to_erasure_supported")
    };
    $regulatorypreset{
      id:"au-privacy";name:"AU Privacy Act";description:"Australian Privacy Act 1988 and Australian Privacy Principles";
      classificationdefault:"confidential";blockedentitytypes:@("tfn";"medicare");
      crossborderallowed:false;anonymisationstrength:"reasonable";
      customrules:@("app8_comparable_protections";"eligible_data_breach_30_days";"oaic_notification_required")
    };
    $regulatorypreset{
      id:"hipaa";name:"US HIPAA";description:"Health Insurance Portability and Accountability Act";
      classificationdefault:"restricted";blockedentitytypes:@("health";"ssn";"medical_record";"insurance";"dob");
      crossborderallowed:false;anonymisationstrength:"full";
      customrules:@("baa_required";"safe_harbor_deidentification";"60_day_breach_notification";"minimum_necessary_standard")
    };
    $regulatorypreset{
      id:"ccpa";name:"US CCPA/CPRA";description:"California Consumer Privacy Act and California Privacy Rights Act";
      classificationdefault:"confidential";blockedentitytypes:@();
      crossborderallowed:true;anonymisationstrength:"reasonable";
      customrules:@("service_provider_contract_required";"45_day_consumer_response";"opt_out_of_sale_supported")
    };
    $regulatorypreset{
      id:"uk-gdpr";name:"UK GDPR";description:"UK General Data Protection Regulation";
      classificationdefault:"confidential";blockedentitytypes:@("health";"biometric";"political";"religion");
      crossborderallowed:false;anonymisationstrength:"full";
      customrules:@("uk_idta_required";"72_hour_ico_notification";"dpa_required")
    };
    $regulatorypreset{
      id:"sg-pdpa";name:"Singapore PDPA";description:"Personal Data Protection Act 2012";
      classificationdefault:"confidential";blockedentitytypes:@("nric");
      crossborderallowed:false;anonymisationstrength:"reasonable";
      customrules:@("transfer_limitation";"3_day_pdpc_notification";"data_intermediary_obligations")
    };
    $regulatorypreset{
      id:"minimal";name:"Minimal";description:"Minimal restrictions for testing and development";
      classificationdefault:"public";blockedentitytypes:@();
      crossborderallowed:true;anonymisationstrength:"placeholder";
      customrules:@()
    };
  )
};
f=findpreset(id:$str):$regulatorypreset|$err{
  let presets=getpresets();
  presets.each(p{
    if(p.id = id ){ <$ok(p) };
  });
  <$err("preset not found: " + id)
};
f=classifyrisk(sensitivity:$str;entitycount:i32;crossborder:bool;hasblockedentities:bool):$riskassessment{
  let score=mut.0;
  let reasons=mut.@();

  if(sensitivity = "RESTRICTED" ){
    score=score+40;
    reasons=reasons.pushcopy("RESTRICTED classification")
  }; else if(sensitivity = "CONFIDENTIAL" ){
    score=score+25;
    reasons=reasons.pushcopy("CONFIDENTIAL classification")
  }; else if(sensitivity = "INTERNAL" ){
    score=score+10;
    reasons=reasons.pushcopy("INTERNAL classification")
  };
  if(entitycount > 10 ){
    score=score+30;
    reasons=reasons.pushcopy("High PII entity count (" + str.fromint(entitycount) + ")")
  }; else if(entitycount > 3 ){
    score=score+15;
    reasons=reasons.pushcopy("Moderate PII entity count (" + str.fromint(entitycount) + ")")
  }; else if(entitycount > 0 ){
    score=score+5;
    reasons=reasons.pushcopy("Low PII entity count (" + str.fromint(entitycount) + ")")
  };
  if(crossborder ){
    score=score+15;
    reasons=reasons.pushcopy("Cross-border data transfer")
  };
  if(hasblockedentities ){
    score=score+20;
    reasons=reasons.pushcopy("Contains blocked entity types")
  };
  let tier=if(score > 50 ):i64{ "High" };
    else if(score > 25 ){ "Medium" };
    else { "Low" };
  <$riskassessment{tier:$tier;score:$score;reasons:$reasons};
};
f=generatereport(presetname:$str;events:@$complianceevent:$compliancereport{
  let violations=0;
  let low=0;
  let medium=0;
  let high=0;
  events.each(e{
    if(e.severity = "violation" ){ violations=violations+1 };
    if(e.risktier = "Low" ){ low=low+1 };
    else if(e.risktier = "Medium" ){ medium=medium+1 };
    else if(e.risktier = "High" ){ high=high+1 };
  });
  let total=events.len();
  let privacypct=if(total > 0 ):i64{ ((total - violations) * 100) / total }el{ 100 };

  <$compliancereport{
    generatedat:"now";
    presetname:$presetname;
    totalrequests:$total;
    violations:$violations;
    privacypct:$privacypct;
    riskbreakdownlow:$low;
    riskbreakdownmedium:$medium;
    riskbreakdownhigh:$high;
    events:$events
  };
};
f=reporttocsv(report:$compliancereport):$str{
  let out=mut."timestamp,event_type,detail,severity,risk_tier
";
  report.events.each(e{
    out=out + e.timestamp + "," + e.eventtype + ",\"" + e.detail + "\"," + e.severity + "," + e.risktier + "
"
  });
  <out
};
f=reporttojson(report:$compliancereport):$str{
  let out="{\"generated_at\":\"" + report.generatedat + "\",";
  out=out + "\"preset\":\"" + report.presetname + "\",";
  out=out + "\"total_requests\":" + str.fromint(report.totalrequests) + ",";
  out=out + "\"violations\":" + str.fromint(report.violations) + ",";
  out=out + "\"privacy_pct\":" + str.fromint(report.privacypct) + ",";
  out=out + "\"risk_breakdown\":{\"low\":" + str.fromint(report.riskbreakdownlow);
  out=out + ",\"medium\":" + str.fromint(report.riskbreakdownmedium);
  out=out + ",\"high\":" + str.fromint(report.riskbreakdownhigh) + "}}";
  <out
};

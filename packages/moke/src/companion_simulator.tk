
m=moke.companionsimulator;
i=str:std.string;

t=$companionstate{
  $idle:i64;
  $scanning:i64;
  $discovered:i64;
  $pairing:i64;
  $paired:i64;
  $offloading:i64;
  $complete:i64;
  $error:i64
};

t=$simulateddevice{
  name:str;
  devicetype:str;
  hardware:str;
  gpuvramgb:f64;
  estimatedtoks:f64;
  signalstrength:str
};

t=$companionsession{
  state:i64;
  device:$simulateddevice;
  offloadmodel:str;
  offloadtokens:i32;
  offloaddurationms:i64;
  events:@str
};

f=defaultdevice():$simulateddevice{
  <$simulateddevice{
    name:"Mac Studio (Office)";
    devicetype:"mac_studio";
    hardware:"Apple M2 Ultra  76-core GPU  192GB";
    gpuvramgb:192.0;
    estimatedtoks:85.0;
    signalstrength:"strong"
  }
};

f=newsession():$companionsession{
  <$companionsession{
    state:0;
    device:defaultdevice();
    offloadmodel:"";
    offloadtokens:0;
    offloaddurationms:0;
    events:@("Session created -- idle")
  }
};

f=startscan(s:$companionsession):$companionsession{
  <$companionsession{
    state:1;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.pushcopy("Scanning local network via mDNS...")
  }
};

f=discover(s:$companionsession):$companionsession{
  <$companionsession{
    state:2;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.pushcopy("Discovered: " + s.device.name + " (" + s.device.hardware + ")")
  }
};

f=startpairing(s:$companionsession):$companionsession{
  <$companionsession{
    state:3;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.pushcopy("Pairing via TLS mutual auth...")
  }
};

f=completepairing(s:$companionsession):$companionsession{
  <$companionsession{
    state:4;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.pushcopy("Paired successfully -- encrypted channel established")
  }
};

f=startoffload(s:$companionsession;modelid:str):$companionsession{
  <$companionsession{
    state:5;
    device:s.device;
    offloadmodel:modelid;
    offloadtokens:0;
    offloaddurationms:0;
    events:s.events.pushcopy("Offloading inference: " + modelid + " to " + s.device.name)
  }
};

f=completeoffload(s:$companionsession;tokens:i32;durationms:i64):$companionsession{
  <$companionsession{
    state:6;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:tokens;
    offloaddurationms:durationms;
    events:s.events.pushcopy("Offload complete: " + str.fromi32(tokens) + " tokens in " + str.fromint64(durationms) + "ms")
  }
};

f=statelabel(state:i64):str{
  if(state = 0){ <"Idle" };
  if(state = 1){ <"Scanning..." };
  if(state = 2){ <"Device Found" };
  if(state = 3){ <"Pairing..." };
  if(state = 4){ <"Paired" };
  if(state = 5){ <"Offloading..." };
  if(state = 6){ <"Complete" };
  if(state = 7){ <"Error" };
  <"Unknown"
};

f=tojson(s:$companionsession):str{
  let eventsjson=str.join(s.events.map(e{ <"\"" + str.jsonescape(e) + "\"" });",");
  let j=mut."{";
  j=str.concat(j;"\"state\":\"" + statelabel(s.state) + "\"");
  j=str.concat(j;",\"device\":{");
  j=str.concat(j;"\"name\":\"" + str.jsonescape(s.device.name) + "\"");
  j=str.concat(j;",\"device_type\":\"" + str.jsonescape(s.device.devicetype) + "\"");
  j=str.concat(j;",\"hardware\":\"" + str.jsonescape(s.device.hardware) + "\"");
  j=str.concat(j;",\"gpu_vram_gb\":" + str.fromfloat(s.device.gpuvramgb));
  j=str.concat(j;",\"estimated_tok_s\":" + str.fromfloat(s.device.estimatedtoks));
  j=str.concat(j;",\"signal_strength\":\"" + str.jsonescape(s.device.signalstrength) + "\"");
  j=str.concat(j;"}");
  j=str.concat(j;",\"offload_model\":\"" + str.jsonescape(s.offloadmodel) + "\"");
  j=str.concat(j;",\"offload_tokens\":" + str.fromi32(s.offloadtokens));
  j=str.concat(j;",\"offload_duration_ms\":" + str.fromint64(s.offloaddurationms));
  j=str.concat(j;",\"events\":[" + eventsjson + "]");
  j=str.concat(j;"}");
  <j
};

m=moke.companionsimulator;
i=str:std.string;

t=$companionstate{
  $idle:i64;
  $scanning:i64;
  $discovered:i64;
  $pairing:i64;
  $paired:i64;
  $offloading:i64;
  $complete:i64;
  $error:i64
};

t=$simulateddevice{
  name:str;
  devicetype:str;
  hardware:str;
  gpuvramgb:f64;
  estimatedtoks:f64;
  signalstrength:str
};

t=$companionsession{
  state:i64;
  device:$simulateddevice;
  offloadmodel:str;
  offloadtokens:i32;
  offloaddurationms:i64;
  events:@str
};

f=defaultdevice():$simulateddevice{
  <$simulateddevice{
    name:"Mac Studio (Office)";
    devicetype:"mac_studio";
    hardware:"Apple M2 Ultra  76-core GPU  192GB";
    gpuvramgb:192.0;
    estimatedtoks:85.0;
    signalstrength:"strong"
  }
};

f=newsession():$companionsession{
  <$companionsession{
    state:0;
    device:defaultdevice();
    offloadmodel:"";
    offloadtokens:0;
    offloaddurationms:0;
    events:@("Session created -- idle")
  }
};

f=startscan(s:$companionsession):$companionsession{
  <$companionsession{
    state:1;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.push("Scanning local network via mDNS...")
  }
};

f=discover(s:$companionsession):$companionsession{
  <$companionsession{
    state:2;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.push(str.concat("Discovered: ";str.concat(s.device.name;str.concat(" (";str.concat(s.device.hardware;")")))))
  }
};

f=startpairing(s:$companionsession):$companionsession{
  <$companionsession{
    state:3;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.push("Pairing via TLS mutual auth...")
  }
};

f=completepairing(s:$companionsession):$companionsession{
  <$companionsession{
    state:4;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:s.offloadtokens;
    offloaddurationms:s.offloaddurationms;
    events:s.events.push("Paired successfully -- encrypted channel established")
  }
};

f=startoffload(s:$companionsession;modelid:str):$companionsession{
  <$companionsession{
    state:5;
    device:s.device;
    offloadmodel:modelid;
    offloadtokens:0;
    offloaddurationms:0;
    events:s.events.push(str.concat("Offloading inference: ";str.concat(modelid;str.concat(" to ";s.device.name))))
  }
};

f=completeoffload(s:$companionsession;tokens:i32;durationms:i64):$companionsession{
  <$companionsession{
    state:6;
    device:s.device;
    offloadmodel:s.offloadmodel;
    offloadtokens:tokens;
    offloaddurationms:durationms;
    events:s.events.push(str.concat("Offload complete: ";str.concat(str.fromi32(tokens);str.concat(" tokens in ";str.concat(str.fromi64(durationms);"ms")))))
  }
};

f=statelabel(state:i64):str{
  if(state = 0){ <"Idle" };
  if(state = 1){ <"Scanning..." };
  if(state = 2){ <"Device Found" };
  if(state = 3){ <"Pairing..." };
  if(state = 4){ <"Paired" };
  if(state = 5){ <"Offloading..." };
  if(state = 6){ <"Complete" };
  if(state = 7){ <"Error" };
  <"Unknown"
};

f=tojson(s:$companionsession):str{
  let eventparts=mut.@();
  lp(let ii=0;ii<s.events.len;ii=ii+1){
    let e=s.events.get(ii);
    eventparts=eventparts.push(str.concat("\"";str.concat(str.jsonescape(e);"\"")))
  };
  let eventsjson=str.join(eventparts;",");
  let j=mut."{";
  j=str.concat(j;str.concat("\"state\":\"";str.concat(statelabel(s.state);"\"")));
  j=str.concat(j;",\"device\":{");
  j=str.concat(j;str.concat("\"name\":\"";str.concat(str.jsonescape(s.device.name);"\"")));
  j=str.concat(j;str.concat(",\"device_type\":\"";str.concat(str.jsonescape(s.device.devicetype);"\"")));
  j=str.concat(j;str.concat(",\"hardware\":\"";str.concat(str.jsonescape(s.device.hardware);"\"")));
  j=str.concat(j;str.concat(",\"gpu_vram_gb\":";str.fromfloat(s.device.gpuvramgb)));
  j=str.concat(j;str.concat(",\"estimated_tok_s\":";str.fromfloat(s.device.estimatedtoks)));
  j=str.concat(j;str.concat(",\"signal_strength\":\"";str.concat(str.jsonescape(s.device.signalstrength);"\"")));
  j=str.concat(j;"}");
  j=str.concat(j;str.concat(",\"offload_model\":\"";str.concat(str.jsonescape(s.offloadmodel);"\"")));
  j=str.concat(j;str.concat(",\"offload_tokens\":";str.fromi32(s.offloadtokens)));
  j=str.concat(j;str.concat(",\"offload_duration_ms\":";str.fromi64(s.offloaddurationms)));
  j=str.concat(j;str.concat(",\"events\":[";str.concat(eventsjson;"]")));
  j=str.concat(j;"}");
  <j
};

m=moke.ddl;
i=str:std.str;

t=$cardtype{ $metric:i64; $chart:i64; $table:i64; $text:i64; $list:i64};

t=$charttype{ $line:i64; $bar:i64; $pie:i64; $area:i64; $scatter:i64};

t=$metriccard{
  label:str;
  queryop:str;
  querycol:str;
  querygroup:str;
  unit:str;
  deltaqueryop:str
};

t=$chartcard{
  title:str;
  charttype:str;
  xcol:str;
  ycol:str;
  queryop:str;
  filtercol:str;
  filterval:str;
  topn:i32
};

t=$tablecard{
  title:str;
  columns:@str;
  queryop:str;
  sortcol:str;
  limit:i32
};

t=$textcard{
  markdown:str
};

t=$listcard{
  title:str;
  items:@str
};

t=$dashboardcard{
  id:str;
  kind:str;
  title:str;
  colspan:i32;
  metric:$metriccard;
  chart:$chartcard;
  table:$tablecard;
  text:$textcard;
  list:$listcard
};

t=$dashboard{
  title:str;
  summary:str;
  cards:@$dashboardcard
};

f=newdashboard(title:str;summary:str):$dashboard{
  <$dashboard{
    title:title;
    summary:summary;
    cards:@()
  }
};

(* `dash.cards.push(card); <dash` discarded the new array and returned the dashboard it was
   given, so every dashboard this module built had zero cards (T-24). `.push` allocates and
   returns; there is no in-place append and no field assignment (T-26), so the dashboard is
   rebuilt around the new card array. *)
f=addcard(dash:$dashboard;card:$dashboardcard):$dashboard{
  <$dashboard{
    title:dash.title;
    summary:dash.summary;
    cards:dash.cards.push(card)
  }
};

(* `newmetric` fills a $metriccard from its own arguments and cannot express a unit or a delta
   op. `demodashboard` reached for `card.metric == mc`, which E2002 invites and which compiles
   to a DISCARDED COMPARISON that does nothing (T-26): all four demo metric cards carried no
   unit and no delta query. A $dashboardcard has nine fields and no field assignment, so this
   is the rebuild. *)
f=withmetric(card:$dashboardcard;mc:$metriccard):$dashboardcard{
  <$dashboardcard{
    id:card.id;
    kind:card.kind;
    title:card.title;
    colspan:card.colspan;
    metric:mc;
    chart:card.chart;
    table:card.table;
    text:card.text;
    list:card.list
  }
};

f=newmetric(id:str;title:str;col:i32;op:str;querycol:str):$dashboardcard{
  let mc=$metriccard{
    label:title;
    queryop:op;
    querycol:querycol;
    querygroup:"";
    unit:"";
    deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"metric";
    title:title;
    colspan:col;
    metric:mc;
    chart:emptychart;
    table:emptytable;
    text:emptytext;
    list:emptylist
  }
};

f=newchart(id:str;title:str;col:i32;charttype:str;x:str;y:str;op:str):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let cc=$chartcard{
    title:title;
    charttype:charttype;
    xcol:x;
    ycol:y;
    queryop:op;
    filtercol:"";
    filterval:"";
    topn:10
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"chart";
    title:title;
    colspan:col;
    metric:emptymetric;
    chart:cc;
    table:emptytable;
    text:emptytext;
    list:emptylist
  }
};

f=newtable(id:str;title:str;col:i32;columns:@str;op:str;sort:str;limit:i32):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let tc=$tablecard{
    title:title;
    columns:columns;
    queryop:op;
    sortcol:sort;
    limit:limit
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"table";
    title:title;
    colspan:col;
    metric:emptymetric;
    chart:emptychart;
    table:tc;
    text:emptytext;
    list:emptylist
  }
};

f=newtext(id:str;content:str):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let tc=$textcard{ markdown:content };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"text";
    title:"";
    colspan:3;
    metric:emptymetric;
    chart:emptychart;
    table:emptytable;
    text:tc;
    list:emptylist
  }
};

f=jsonstr(s:str):str{
  let out=mut.str.replace(s;"\\";"\\\\");
  out=str.replace(out;"\"";"\\\"");
  out=str.replace(out;"
";"\\n");
  out=str.replace(out;"	";"\\t");
  <"\"\(out)\""
};

f=jsonstrarr(arr:@str):str{
  let parts=mut.@();
  lp(let ii=0;ii<arr.len;ii=ii+1){
    let v=arr.get(ii);
    parts=parts.push(jsonstr(v))
  };
  <str.concat("[";str.concat(str.join(",";parts);"]"))
};

f=tojson(dash:$dashboard):str{
  let cardjsons=mut.@();
  lp(let ii=0;ii<dash.cards.len;ii=ii+1){
    (* Declared types on `c` and on each card variant, because `queryop` and `title` are each
       declared by three or more structs in this file at different offsets. Without the
       annotation toke cannot tell which struct `c.metric` is, and E4034 lands on the READ
       rather than on the binding — so the diagnostic points at a `str.concat` forty characters
       wide and says nothing about where the type was lost. Annotating the intermediate is the
       established fix in this repository; `browser/pages/api/pipeline.tk` carries the same note
       for `$budgetcheck` / `$selectionresult` / `$routingdecision`, which collide on `reason`. *)
    let c:$dashboardcard=dash.cards.get(ii);
    let m:$metriccard=c.metric;
    let ch:$chartcard=c.chart;
    let tb:$tablecard=c.table;
    let tx:$textcard=c.text;
    let ls:$listcard=c.list;
    let kindblock=mut."";
    if(c.kind == "metric"){
      kindblock=str.concat("\"metric\":{\"label\":";str.concat(jsonstr(m.label);str.concat(",\"query_op\":";str.concat(jsonstr(m.queryop);str.concat(",\"query_col\":";str.concat(jsonstr(m.querycol);str.concat(",\"query_group\":";str.concat(jsonstr(m.querygroup);str.concat(",\"unit\":";str.concat(jsonstr(m.unit);str.concat(",\"delta_query_op\":";str.concat(jsonstr(m.deltaqueryop);"}"))))))))))))
    };
    if(c.kind == "chart"){
      kindblock=str.concat("\"chart\":{\"title\":";str.concat(jsonstr(ch.title);str.concat(",\"chart_type\":";str.concat(jsonstr(ch.charttype);str.concat(",\"x_col\":";str.concat(jsonstr(ch.xcol);str.concat(",\"y_col\":";str.concat(jsonstr(ch.ycol);str.concat(",\"query_op\":";str.concat(jsonstr(ch.queryop);str.concat(",\"filter_col\":";str.concat(jsonstr(ch.filtercol);str.concat(",\"filter_val\":";str.concat(jsonstr(ch.filterval);str.concat(",\"top_n\":";str.concat(str.fromint(ch.topn as i64);"}"))))))))))))))))
    };
    if(c.kind == "table"){
      kindblock=str.concat("\"table\":{\"title\":";str.concat(jsonstr(tb.title);str.concat(",\"columns\":";str.concat(jsonstrarr(tb.columns);str.concat(",\"query_op\":";str.concat(jsonstr(tb.queryop);str.concat(",\"sort_col\":";str.concat(jsonstr(tb.sortcol);str.concat(",\"limit\":";str.concat(str.fromint(tb.limit as i64);"}"))))))))))
    };
    if(c.kind == "text"){
      kindblock=str.concat("\"text\":{\"markdown\":";str.concat(jsonstr(tx.markdown);"}"))
    };
    if(c.kind == "list"){
      kindblock=str.concat("\"list\":{\"title\":";str.concat(jsonstr(ls.title);str.concat(",\"items\":";str.concat(jsonstrarr(ls.items);"}"))))
    };
    let cardjson="{\"id\":\(jsonstr(c.id)),\"kind\":\(jsonstr(c.kind)),\"title\":\(jsonstr(c.title)),\"col_span\":\(str.fromint(c.colspan as i64)),\(kindblock)}";
    cardjsons=cardjsons.push(cardjson)
  };
  <str.concat("{\"title\":";str.concat(jsonstr(dash.title);str.concat(",\"summary\":";str.concat(jsonstr(dash.summary);str.concat(",\"cards\":[";str.concat(str.join(",";cardjsons);"]}"))))))
};

f=validate(dash:$dashboard):bool{
  if(str.len(str.trim(dash.title)) == 0){ <false };
  if(dash.cards.len == 0){ <false };
  let valid=mut.true;
  lp(let ii=0;ii<dash.cards.len;ii=ii+1){
    let c=dash.cards.get(ii);
    if(str.len(str.trim(c.id)) == 0){ valid=false };
    if(str.len(str.trim(c.kind)) == 0){ valid=false }
  };
  <valid
};

f=demodashboard():$dashboard{
  let dash=mut.newdashboard(
    "Customer Intelligence";
    "Key customer metrics, lifetime value distribution, order trends, and top-performer ranking"
  );

  let totalcustomers=mut.newmetric("m-total-customers";"Total Customers";1 as i32;"count";"customer_id");
  let totalcustomersm=$metriccard{
    label:"Total Customers";
    queryop:"count";
    querycol:"customer_id";
    querygroup:"";
    unit:"";
    deltaqueryop:"count_prev_period"
  };
  totalcustomers=withmetric(totalcustomers;totalcustomersm);

  let avgltv=mut.newmetric("m-avg-ltv";"Avg LTV";1 as i32;"mean";"lifetime_value");
  let avgltvm=$metriccard{
    label:"Avg LTV";
    queryop:"mean";
    querycol:"lifetime_value";
    querygroup:"";
    unit:"$";
    deltaqueryop:"mean_prev_period"
  };
  avgltv=withmetric(avgltv;avgltvm);

  let churnrate=mut.newmetric("m-churn";"Churn Rate";1 as i32;"mean";"churned");
  let churnm=$metriccard{
    label:"Churn Rate";
    queryop:"mean";
    querycol:"churned";
    querygroup:"";
    unit:"%";
    deltaqueryop:"mean_prev_period"
  };
  churnrate=withmetric(churnrate;churnm);

  let avgorder=mut.newmetric("m-avg-order";"Avg Order Value";1 as i32;"mean";"order_value");
  let avgorderm=$metriccard{
    label:"Avg Order Value";
    queryop:"mean";
    querycol:"order_value";
    querygroup:"";
    unit:"$";
    deltaqueryop:"mean_prev_period"
  };
  avgorder=withmetric(avgorder;avgorderm);

  let ltvchart=newchart("c-ltv-cluster";"LTV by Cluster";2 as i32;"bar";"cluster";"lifetime_value";"mean_by_group");
  let orderschart=newchart("c-orders-time";"Orders over Time";2 as i32;"line";"order_date";"order_count";"count_by_day");

  let topcustomers=newtable(
    "t-top-customers";
    "Top 10 Customers by LTV";
    3 as i32;
    @("customer_id";"name";"cluster";"lifetime_value";"order_count";"last_order_date");
    "top_n";
    "lifetime_value";
    10 as i32
  );

  dash=addcard(dash;totalcustomers);
  dash=addcard(dash;avgltv);
  dash=addcard(dash;churnrate);
  dash=addcard(dash;avgorder);
  dash=addcard(dash;ltvchart);
  dash=addcard(dash;orderschart);
  dash=addcard(dash;topcustomers);

  <dash
};

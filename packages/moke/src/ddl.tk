m=moke.ddl;
i=str:std.string;

t=$cardtype{ $metric:i64; $chart:i64; $table:i64; $text:i64; $list:i64};

t=$charttype{ $line:i64; $bar:i64; $pie:i64; $area:i64; $scatter:i64};

t=$metriccard{
  label:str;
  queryop:str;
  querycol:str;
  querygroup:str;
  unit:str;
  deltaqueryop:str
};

t=$chartcard{
  title:str;
  charttype:str;
  xcol:str;
  ycol:str;
  queryop:str;
  filtercol:str;
  filterval:str;
  topn:i32
};

t=$tablecard{
  title:str;
  columns:@str;
  queryop:str;
  sortcol:str;
  limit:i32
};

t=$textcard{
  markdown:str
};

t=$listcard{
  title:str;
  items:@str
};

t=$dashboardcard{
  id:str;
  kind:str;
  title:str;
  colspan:i32;
  metric:$metriccard;
  chart:$chartcard;
  table:$tablecard;
  text:$textcard;
  list:$listcard
};

t=$dashboard{
  title:str;
  summary:str;
  cards:@$dashboardcard
};

f=newdashboard(title:str;summary:str):$dashboard{
  <$dashboard{
    title:title;
    summary:summary;
    cards:@()
  }
};

f=addcard(dash:$dashboard;card:$dashboardcard):$dashboard{
  dash.cards.push(card);
  <dash
};

f=newmetric(id:str;title:str;col:i32;op:str;querycol:str):$dashboardcard{
  let mc=$metriccard{
    label:title;
    queryop:op;
    querycol:querycol;
    querygroup:"";
    unit:"";
    deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"metric";
    title:title;
    colspan:col;
    metric:mc;
    chart:emptychart;
    table:emptytable;
    text:emptytext;
    list:emptylist
  }
};

f=newchart(id:str;title:str;col:i32;charttype:str;x:str;y:str;op:str):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let cc=$chartcard{
    title:title;
    charttype:charttype;
    xcol:x;
    ycol:y;
    queryop:op;
    filtercol:"";
    filterval:"";
    topn:10
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"chart";
    title:title;
    colspan:col;
    metric:emptymetric;
    chart:cc;
    table:emptytable;
    text:emptytext;
    list:emptylist
  }
};

f=newtable(id:str;title:str;col:i32;columns:@str;op:str;sort:str;limit:i32):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let tc=$tablecard{
    title:title;
    columns:columns;
    queryop:op;
    sortcol:sort;
    limit:limit
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"table";
    title:title;
    colspan:col;
    metric:emptymetric;
    chart:emptychart;
    table:tc;
    text:emptytext;
    list:emptylist
  }
};

f=newtext(id:str;content:str):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let tc=$textcard{ markdown:content };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"text";
    title:"";
    colspan:3;
    metric:emptymetric;
    chart:emptychart;
    table:emptytable;
    text:tc;
    list:emptylist
  }
};

f=jsonstr(s:str):str{
  let out=str.replace(s;"\\";"\\\\");
  out=str.replace(out;"\"";"\\\"");
  out=str.replace(out;"
";"\\n");
  out=str.replace(out;"	";"\\t");
  <"\"" + out + "\""
};

f=jsonstrarr(arr:@str):str{
  let parts=@();
  arr.each(v{
    parts.push(jsonstr(v))
  });
  <"[" + str.join(parts;",") + "]"
};

f=tojson(dash:$dashboard):str{
  let cardjsons=@();
  dash.cards.each(c{
    let kindblock="";
    if(c.kind = "metric"){
      kindblock="\"metric\":{\"label\":" + jsonstr(c.metric.label)
        + ",\"query_op\":" + jsonstr(c.metric.queryop)
        + ",\"query_col\":" + jsonstr(c.metric.querycol)
        + ",\"query_group\":" + jsonstr(c.metric.querygroup)
        + ",\"unit\":" + jsonstr(c.metric.unit)
        + ",\"delta_query_op\":" + jsonstr(c.metric.deltaqueryop)
        + "}"
    };
    if(c.kind = "chart"){
      kindblock="\"chart\":{\"title\":" + jsonstr(c.chart.title)
        + ",\"chart_type\":" + jsonstr(c.chart.charttype)
        + ",\"x_col\":" + jsonstr(c.chart.xcol)
        + ",\"y_col\":" + jsonstr(c.chart.ycol)
        + ",\"query_op\":" + jsonstr(c.chart.queryop)
        + ",\"filter_col\":" + jsonstr(c.chart.filtercol)
        + ",\"filter_val\":" + jsonstr(c.chart.filterval)
        + ",\"top_n\":" + str.fromi32(c.chart.topn)
        + "}"
    };
    if(c.kind = "table"){
      kindblock="\"table\":{\"title\":" + jsonstr(c.table.title)
        + ",\"columns\":" + jsonstrarr(c.table.columns)
        + ",\"query_op\":" + jsonstr(c.table.queryop)
        + ",\"sort_col\":" + jsonstr(c.table.sortcol)
        + ",\"limit\":" + str.fromi32(c.table.limit)
        + "}"
    };
    if(c.kind = "text"){
      kindblock="\"text\":{\"markdown\":" + jsonstr(c.text.markdown) + "}"
    };
    if(c.kind = "list"){
      kindblock="\"list\":{\"title\":" + jsonstr(c.list.title)
        + ",\"items\":" + jsonstrarr(c.list.items)
        + "}"
    };
    let cardjson="{\"id\":" + jsonstr(c.id)
      + ",\"kind\":" + jsonstr(c.kind)
      + ",\"title\":" + jsonstr(c.title)
      + ",\"col_span\":" + str.fromi32(c.colspan)
      + "," + kindblock
      + "}";
    cardjsons.push(cardjson)
  });
  <"{\"title\":" + jsonstr(dash.title)
    + ",\"summary\":" + jsonstr(dash.summary)
    + ",\"cards\":[" + str.join(cardjsons;",") + "]}"
};

f=validate(dash:$dashboard):bool{
  if(str.len(str.trim(dash.title)) = 0){ <false };
  if(dash.cards.len() = 0){ <false };
  let valid=mut.true;
  dash.cards.each(c{
    if(str.len(str.trim(c.id)) = 0){ valid=false };
    if(str.len(str.trim(c.kind)) = 0){ valid=false }
  });
  <valid
};

f=demodashboard():$dashboard{
  let dash=newdashboard(
    "Customer Intelligence";
    "Key customer metrics, lifetime value distribution, order trends, and top-performer ranking"
  );

  let totalcustomers=newmetric("m-total-customers";"Total Customers";1;"count";"customer_id");
  let totalcustomersm=$metriccard{
    label:"Total Customers";
    queryop:"count";
    querycol:"customer_id";
    querygroup:"";
    unit:"";
    deltaqueryop:"count_prev_period"
  };
  totalcustomers.metric=totalcustomersm;

  let avgltv=newmetric("m-avg-ltv";"Avg LTV";1;"mean";"lifetime_value");
  let avgltvm=$metriccard{
    label:"Avg LTV";
    queryop:"mean";
    querycol:"lifetime_value";
    querygroup:"";
    unit:"$";
    deltaqueryop:"mean_prev_period"
  };
  avgltv.metric=avgltvm;

  let churnrate=newmetric("m-churn";"Churn Rate";1;"mean";"churned");
  let churnm=$metriccard{
    label:"Churn Rate";
    queryop:"mean";
    querycol:"churned";
    querygroup:"";
    unit:"%";
    deltaqueryop:"mean_prev_period"
  };
  churnrate.metric=churnm;

  let avgorder=newmetric("m-avg-order";"Avg Order Value";1;"mean";"order_value");
  let avgorderm=$metriccard{
    label:"Avg Order Value";
    queryop:"mean";
    querycol:"order_value";
    querygroup:"";
    unit:"$";
    deltaqueryop:"mean_prev_period"
  };
  avgorder.metric=avgorderm;

  let ltvchart=newchart("c-ltv-cluster";"LTV by Cluster";2;"bar";"cluster";"lifetime_value";"mean_by_group");
  let orderschart=newchart("c-orders-time";"Orders over Time";2;"line";"order_date";"order_count";"count_by_day");

  let topcustomers=newtable(
    "t-top-customers";
    "Top 10 Customers by LTV";
    3;
    @("customer_id";"name";"cluster";"lifetime_value";"order_count";"last_order_date");
    "top_n";
    "lifetime_value";
    10
  );

  dash=addcard(dash;totalcustomers);
  dash=addcard(dash;avgltv);
  dash=addcard(dash;churnrate);
  dash=addcard(dash;avgorder);
  dash=addcard(dash;ltvchart);
  dash=addcard(dash;orderschart);
  dash=addcard(dash;topcustomers);

  <dash
};

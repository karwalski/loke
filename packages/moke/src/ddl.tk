m=moke.ddl;
i=str:std.string;

t=$cardtype{ $metric:i64; $chart:i64; $table:i64; $text:i64; $list:i64};

t=$charttype{ $line:i64; $bar:i64; $pie:i64; $area:i64; $scatter:i64};

t=$metriccard{
  label:str;
  queryop:str;
  querycol:str;
  querygroup:str;
  unit:str;
  deltaqueryop:str
};

t=$chartcard{
  title:str;
  charttype:str;
  xcol:str;
  ycol:str;
  queryop:str;
  filtercol:str;
  filterval:str;
  topn:i32
};

t=$tablecard{
  title:str;
  columns:@str;
  queryop:str;
  sortcol:str;
  limit:i32
};

t=$textcard{
  markdown:str
};

t=$listcard{
  title:str;
  items:@str
};

t=$dashboardcard{
  id:str;
  kind:str;
  title:str;
  colspan:i32;
  metric:$metriccard;
  chart:$chartcard;
  table:$tablecard;
  text:$textcard;
  list:$listcard
};

t=$dashboard{
  title:str;
  summary:str;
  cards:@$dashboardcard
};

f=newdashboard(title:str;summary:str):$dashboard{
  <$dashboard{
    title:title;
    summary:summary;
    cards:@()
  }
};

f=addcard(dash:$dashboard;card:$dashboardcard):$dashboard{
  dash.cards.push(card);
  <dash
};

f=newmetric(id:str;title:str;col:i32;op:str;querycol:str):$dashboardcard{
  let mc=$metriccard{
    label:title;
    queryop:op;
    querycol:querycol;
    querygroup:"";
    unit:"";
    deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"metric";
    title:title;
    colspan:col;
    metric:mc;
    chart:emptychart;
    table:emptytable;
    text:emptytext;
    list:emptylist
  }
};

f=newchart(id:str;title:str;col:i32;charttype:str;x:str;y:str;op:str):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let cc=$chartcard{
    title:title;
    charttype:charttype;
    xcol:x;
    ycol:y;
    queryop:op;
    filtercol:"";
    filterval:"";
    topn:10
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"chart";
    title:title;
    colspan:col;
    metric:emptymetric;
    chart:cc;
    table:emptytable;
    text:emptytext;
    list:emptylist
  }
};

f=newtable(id:str;title:str;col:i32;columns:@str;op:str;sort:str;limit:i32):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let tc=$tablecard{
    title:title;
    columns:columns;
    queryop:op;
    sortcol:sort;
    limit:limit
  };
  let emptytext=$textcard{ markdown:"" };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"table";
    title:title;
    colspan:col;
    metric:emptymetric;
    chart:emptychart;
    table:tc;
    text:emptytext;
    list:emptylist
  }
};

f=newtext(id:str;content:str):$dashboardcard{
  let emptymetric=$metriccard{
    label:"";queryop:"";querycol:"";querygroup:"";unit:"";deltaqueryop:""
  };
  let emptychart=$chartcard{
    title:"";charttype:"";xcol:"";ycol:"";queryop:"";filtercol:"";filterval:"";topn:0
  };
  let emptytable=$tablecard{
    title:"";columns:@();queryop:"";sortcol:"";limit:0
  };
  let tc=$textcard{ markdown:content };
  let emptylist=$listcard{ title:"";items:@() };
  <$dashboardcard{
    id:id;
    kind:"text";
    title:"";
    colspan:3;
    metric:emptymetric;
    chart:emptychart;
    table:emptytable;
    text:tc;
    list:emptylist
  }
};

f=jsonstr(s:str):str{
  let out=mut.str.replace(s;"\\";"\\\\");
  out=str.replace(out;"\"";"\\\"");
  out=str.replace(out;"
";"\\n");
  out=str.replace(out;"	";"\\t");
  <str.concat("\"";str.concat(out;"\""))
};

f=jsonstrarr(arr:@str):str{
  let parts=mut.@();
  lp(let ii=0;ii<arr.len;ii=ii+1){
    let v=arr.get(ii);
    parts=parts.push(jsonstr(v))
  };
  <str.concat("[";str.concat(str.join(parts;",");"]"))
};

f=tojson(dash:$dashboard):str{
  let cardjsons=mut.@();
  lp(let ii=0;ii<dash.cards.len;ii=ii+1){
    let c=dash.cards.get(ii);
    let kindblock=mut."";
    if(c.kind = "metric"){
      kindblock=str.concat("\"metric\":{\"label\":";str.concat(jsonstr(c.metric.label);str.concat(",\"query_op\":";str.concat(jsonstr(c.metric.queryop);str.concat(",\"query_col\":";str.concat(jsonstr(c.metric.querycol);str.concat(",\"query_group\":";str.concat(jsonstr(c.metric.querygroup);str.concat(",\"unit\":";str.concat(jsonstr(c.metric.unit);str.concat(",\"delta_query_op\":";str.concat(jsonstr(c.metric.deltaqueryop);"}"))))))))))))
    };
    if(c.kind = "chart"){
      kindblock=str.concat("\"chart\":{\"title\":";str.concat(jsonstr(c.chart.title);str.concat(",\"chart_type\":";str.concat(jsonstr(c.chart.charttype);str.concat(",\"x_col\":";str.concat(jsonstr(c.chart.xcol);str.concat(",\"y_col\":";str.concat(jsonstr(c.chart.ycol);str.concat(",\"query_op\":";str.concat(jsonstr(c.chart.queryop);str.concat(",\"filter_col\":";str.concat(jsonstr(c.chart.filtercol);str.concat(",\"filter_val\":";str.concat(jsonstr(c.chart.filterval);str.concat(",\"top_n\":";str.concat(str.fromi32(c.chart.topn);"}"))))))))))))))))
    };
    if(c.kind = "table"){
      kindblock=str.concat("\"table\":{\"title\":";str.concat(jsonstr(c.table.title);str.concat(",\"columns\":";str.concat(jsonstrarr(c.table.columns);str.concat(",\"query_op\":";str.concat(jsonstr(c.table.queryop);str.concat(",\"sort_col\":";str.concat(jsonstr(c.table.sortcol);str.concat(",\"limit\":";str.concat(str.fromi32(c.table.limit);"}"))))))))))
    };
    if(c.kind = "text"){
      kindblock=str.concat("\"text\":{\"markdown\":";str.concat(jsonstr(c.text.markdown);"}"))
    };
    if(c.kind = "list"){
      kindblock=str.concat("\"list\":{\"title\":";str.concat(jsonstr(c.list.title);str.concat(",\"items\":";str.concat(jsonstrarr(c.list.items);"}"))))
    };
    let cardjson=str.concat("{\"id\":";str.concat(jsonstr(c.id);str.concat(",\"kind\":";str.concat(jsonstr(c.kind);str.concat(",\"title\":";str.concat(jsonstr(c.title);str.concat(",\"col_span\":";str.concat(str.fromi32(c.colspan);str.concat(",";str.concat(kindblock;"}"))))))))));
    cardjsons=cardjsons.push(cardjson)
  };
  <str.concat("{\"title\":";str.concat(jsonstr(dash.title);str.concat(",\"summary\":";str.concat(jsonstr(dash.summary);str.concat(",\"cards\":[";str.concat(str.join(cardjsons;",");"]}"))))))
};

f=validate(dash:$dashboard):bool{
  if(str.len(str.trim(dash.title)) = 0){ <false };
  if(dash.cards.len() = 0){ <false };
  let valid=mut.true;
  lp(let ii=0;ii<dash.cards.len;ii=ii+1){
    let c=dash.cards.get(ii);
    if(str.len(str.trim(c.id)) = 0){ valid=false };
    if(str.len(str.trim(c.kind)) = 0){ valid=false }
  };
  <valid
};

f=demodashboard():$dashboard{
  let dash=mut.newdashboard(
    "Customer Intelligence";
    "Key customer metrics, lifetime value distribution, order trends, and top-performer ranking"
  );

  let totalcustomers=newmetric("m-total-customers";"Total Customers";1;"count";"customer_id");
  let totalcustomersm=$metriccard{
    label:"Total Customers";
    queryop:"count";
    querycol:"customer_id";
    querygroup:"";
    unit:"";
    deltaqueryop:"count_prev_period"
  };
  totalcustomers.metric=totalcustomersm;

  let avgltv=newmetric("m-avg-ltv";"Avg LTV";1;"mean";"lifetime_value");
  let avgltvm=$metriccard{
    label:"Avg LTV";
    queryop:"mean";
    querycol:"lifetime_value";
    querygroup:"";
    unit:"$";
    deltaqueryop:"mean_prev_period"
  };
  avgltv.metric=avgltvm;

  let churnrate=newmetric("m-churn";"Churn Rate";1;"mean";"churned");
  let churnm=$metriccard{
    label:"Churn Rate";
    queryop:"mean";
    querycol:"churned";
    querygroup:"";
    unit:"%";
    deltaqueryop:"mean_prev_period"
  };
  churnrate.metric=churnm;

  let avgorder=newmetric("m-avg-order";"Avg Order Value";1;"mean";"order_value");
  let avgorderm=$metriccard{
    label:"Avg Order Value";
    queryop:"mean";
    querycol:"order_value";
    querygroup:"";
    unit:"$";
    deltaqueryop:"mean_prev_period"
  };
  avgorder.metric=avgorderm;

  let ltvchart=newchart("c-ltv-cluster";"LTV by Cluster";2;"bar";"cluster";"lifetime_value";"mean_by_group");
  let orderschart=newchart("c-orders-time";"Orders over Time";2;"line";"order_date";"order_count";"count_by_day");

  let topcustomers=newtable(
    "t-top-customers";
    "Top 10 Customers by LTV";
    3;
    @("customer_id";"name";"cluster";"lifetime_value";"order_count";"last_order_date");
    "top_n";
    "lifetime_value";
    10
  );

  dash=addcard(dash;totalcustomers);
  dash=addcard(dash;avgltv);
  dash=addcard(dash;churnrate);
  dash=addcard(dash;avgorder);
  dash=addcard(dash;ltvchart);
  dash=addcard(dash;orderschart);
  dash=addcard(dash;topcustomers);

  <dash
};

m=moke.compute;
i=str:std.string;
i=log:std.log;

t=$dataset{
  name:str;
  headers:@str;
  rows:@(@str)
};

t=$query{
  op:str;
  column:str;
  groupby:str;
  filtercol:str;
  filterval:str;
  topn:i32;
  bucketcount:i32;
  joincol:str
};

t=$result{
  op:str;
  column:str;
  value:str;
  rows:@(@str);
  labels:@str;
  values:@str
};

f=colindex(ds:$dataset;colname:str):i32{
  let idx=mut.0;
  lp(let lv=0;idx<str.len(ds.headers);lv=lv){
    if(str.eq(str.trim(str.get(ds.headers;idx));colname)){
      <idx
    };
    idx=idx+1
  };
  <-1
};

f=getcol(row:@str;idx:i32):str{
  if(idx<0 || idx>str.len(row)){
    <""
  };
  <str.get(row;idx)
};

f=parsefloat(s:str):f32{
  let trimmed=str.trim(s);
  if(str.len(trimmed)=0){ <0.0 };
  if(str.isnumeric(trimmed)){
    <str.parsef32(trimmed)
  };
  <0.0
};

f=applyfilter(ds:$dataset;filtercol:str;filterval:str):$dataset{
  if(str.len(filtercol)=0 || str.len(filterval)=0){
    <ds
  };
  let fcidx=colindex(ds;filtercol);
  if(fcidx<0){ <ds };
  let filtered=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(ds.rows);lv=lv){
    let row=str.get(ds.rows;rowidx);
    let cell=getcol(row;fcidx);
    if(str.eq(cell;filterval)){
      filtered.push(row)
    };
    rowidx=rowidx+1
  };
  <$dataset{
    name:ds.name;
    headers:ds.headers;
    rows:filtered
  }
};

f=opcount(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cnt=str.len(working.rows);
  <$result{
    op:"count";
    column:q.column;
    value:str.fromi32(cnt);
    rows:@();
    labels:@();
    values:@()
  }
};

f=opsum(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let total=mut.0.0;
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    total=total+parsefloat(v);
    rowidx=rowidx+1
  };
  <$result{
    op:"sum";
    column:q.column;
    value:str.fromf32(total);
    rows:@();
    labels:@();
    values:@()
  }
};

f=opavg(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let total=mut.0.0;
  let count=mut.0;
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      total=total+parsefloat(v);
      count=count+1
    };
    rowidx=rowidx+1
  };
  let avgval=0.0;
  if(count>0){ avgval=total/str.tof32(count) };
  <$result{
    op:"avg";
    column:q.column;
    value:str.formatf32(avgval;2);
    rows:@();
    labels:@();
    values:@()
  }
};

f=opmin(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let minval=mut.0.0;
  let found=mut.false;
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      let n=parsefloat(v);
      if(found=false){
        minval=n;
        found=true
      }el{
        if(n<minval){ minval=n }
      }
    };
    rowidx=rowidx+1
  };
  <$result{
    op:"min";
    column:q.column;
    value:str.fromf32(minval);
    rows:@();
    labels:@();
    values:@()
  }
};

f=opmax(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let maxval=mut.0.0;
  let found=mut.false;
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      let n=parsefloat(v);
      if(found=false){
        maxval=n;
        found=true
      }el{
        if(n>maxval){ maxval=n }
      }
    };
    rowidx=rowidx+1
  };
  <$result{
    op:"max";
    column:q.column;
    value:str.fromf32(maxval);
    rows:@();
    labels:@();
    values:@()
  }
};

f=opgroup(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let gidx=colindex(working;q.groupby);
  let groupkeys=mut.@();
  let groupcounts=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let key=getcol(row;gidx);
    let foundgroup=mut.false;
    let gi=mut.0;
    lp(let lv2=0;gi<str.len(groupkeys);lv2=lv2){
      if(str.eq(str.get(groupkeys;gi);key)){
        let oldcount=str.get(groupcounts;gi);
        str.set(groupcounts;gi;oldcount+1);
        foundgroup=true
      };
      gi=gi+1
    };
    if(foundgroup=false){
      str.push(groupkeys;key);
      str.push(groupcounts;1)
    };
    rowidx=rowidx+1
  };
  let countstrs=mut.@();
  let ci=mut.0;
  lp(let lv=0;ci<str.len(groupcounts);lv=lv){
    str.push(countstrs;str.fromi32(str.get(groupcounts;ci)));
    ci=ci+1
  };
  <$result{
    op:"group";
    column:q.groupby;
    value:"";
    rows:@();
    labels:groupkeys;
    values:countstrs
  }
};

f=optimeseries(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let didx=colindex(working;q.groupby);
  let vidx=colindex(working;q.column);
  let datekeys=mut.@();
  let datesums=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let rawdate=getcol(row;didx);
    let daykey=str.slice(rawdate;0;10);
    let valstr=getcol(row;vidx);
    let n=parsefloat(valstr);
    let foundday=mut.false;
    let di=mut.0;
    lp(let lv2=0;di<str.len(datekeys);lv2=lv2){
      if(str.eq(str.get(datekeys;di);daykey)){
        let oldsum=str.get(datesums;di);
        str.set(datesums;di;oldsum+n);
        foundday=true
      };
      di=di+1
    };
    if(foundday=false){
      str.push(datekeys;daykey);
      str.push(datesums;n)
    };
    rowidx=rowidx+1
  };
  let sumstrs=mut.@();
  let si=mut.0;
  lp(let lv=0;si<str.len(datesums);lv=lv){
    str.push(sumstrs;str.fromf32(str.get(datesums;si)));
    si=si+1
  };
  <$result{
    op:"timeseries";
    column:q.column;
    value:"";
    rows:@();
    labels:datekeys;
    values:sumstrs
  }
};

f=optopn(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let nlimit=mut.q.topn;
  if(!(nlimit>0)){ nlimit=10 };
  let sortedrows=mut.@();
  let sortedvals=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=parsefloat(getcol(row;cidx));
    let insertpos=mut.str.len(sortedvals);
    let checkidx=mut.0;
    lp(let lv2=0;checkidx<str.len(sortedvals);lv2=lv2){
      if(v>str.get(sortedvals;checkidx)){
        insertpos=checkidx;
        checkidx=str.len(sortedvals)
      };
      checkidx=checkidx+1
    };
    str.insert(sortedrows;insertpos;row);
    str.insert(sortedvals;insertpos;v);
    rowidx=rowidx+1
  };
  let toprows=mut.@();
  let taken=mut.0;
  lp(let lv=0;taken<nlimit && taken<str.len(sortedrows);lv=lv){
    str.push(toprows;str.get(sortedrows;taken));
    taken=taken+1
  };
  <$result{
    op:"topn";
    column:q.column;
    value:"";
    rows:toprows;
    labels:@();
    values:@()
  }
};

f=opdistribution(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let bucketcount=mut.q.bucketcount;
  if(!(bucketcount>0)){ bucketcount=10 };
  let minval=mut.0.0;
  let maxval=mut.0.0;
  let first=mut.true;
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      let n=parsefloat(v);
      if(first){
        minval=n;
        maxval=n;
        first=false
      }el{
        if(n<minval){ minval=n };
        if(n>maxval){ maxval=n }
      }
    };
    rowidx=rowidx+1
  };
  let range=maxval-minval;
  let bucketwidth=mut.range/str.tof32(bucketcount);
  if(!(bucketwidth>0.0)){ bucketwidth=1.0 };
  let bucketlabels=mut.@();
  let bucketcounts=mut.@();
  let bidx=mut.0;
  lp(let lv=0;bidx<bucketcount;lv=lv){
    let lo=minval+str.tof32(bidx)*bucketwidth;
    let hi=lo+bucketwidth;
    let label=str.concat(str.fromf32(lo);"-");
    label=str.concat(label;str.fromf32(hi));
    str.push(bucketlabels;label);
    str.push(bucketcounts;0);
    bidx=bidx+1
  };
  rowidx=0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      let n=parsefloat(v);
      let bucketidx=mut.str.toi32((n-minval)/bucketwidth);
      if(bucketidx>bucketcount){ bucketidx=bucketcount-1 };
      if(bucketidx<0){ bucketidx=0 };
      let old=str.get(bucketcounts;bucketidx);
      str.set(bucketcounts;bucketidx;old+1)
    };
    rowidx=rowidx+1
  };
  let countstrs=mut.@();
  let ci=mut.0;
  lp(let lv=0;ci<str.len(bucketcounts);lv=lv){
    str.push(countstrs;str.fromi32(str.get(bucketcounts;ci)));
    ci=ci+1
  };
  <$result{
    op:"distribution";
    column:q.column;
    value:"";
    rows:@();
    labels:bucketlabels;
    values:countstrs
  }
};

f=opcorrelate(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let xidx=colindex(working;q.column);
  let yidx=colindex(working;q.groupby);
  let xs=mut.@();
  let ys=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let xv=getcol(row;xidx);
    let yv=getcol(row;yidx);
    if(str.len(str.trim(xv))>0 && str.len(str.trim(yv))>0){
      str.push(xs;parsefloat(xv));
      str.push(ys;parsefloat(yv))
    };
    rowidx=rowidx+1
  };
  let n=str.len(xs);
  if(n<2){
    <$result{
      op:"correlate";
      column:q.column;
      value:"0.0";
      rows:@();
      labels:@();
      values:@()
    }
  };
  let sumx=mut.0.0;
  let sumy=mut.0.0;
  let i=mut.0;
  lp(let lv=0;i<n;lv=lv){
    sumx=sumx+str.get(xs;i);
    sumy=sumy+str.get(ys;i);
    i=i+1
  };
  let nf=str.tof32(n);
  let meanx=sumx/nf;
  let meany=sumy/nf;
  let cov=mut.0.0;
  let varx=mut.0.0;
  let vary=mut.0.0;
  i=0;
  lp(let lv=0;i<n;lv=lv){
    let dx=str.get(xs;i)-meanx;
    let dy=str.get(ys;i)-meany;
    cov=cov+dx*dy;
    varx=varx+dx*dx;
    vary=vary+dy*dy;
    i=i+1
  };
  let denom=str.sqrt(varx)*str.sqrt(vary);
  let r=0.0;
  if(denom>0.0){ r=cov/denom };
  <$result{
    op:"correlate";
    column:q.column;
    value:str.formatf32(r;4);
    rows:@();
    labels:@();
    values:@()
  }
};

f=oppercentile(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let nums=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      str.push(nums;parsefloat(v))
    };
    rowidx=rowidx+1
  };
  let sorted=str.sortf32(nums);
  let n=str.len(sorted);
  let percentileat=mut.0.0;
  let outrows=mut.@();
  let percs=@(25;50;75;90;99);
  let pnames=@("p25";"p50";"p75";"p90";"p99");
  let pidx=mut.0;
  lp(let lv=0;pidx<5;lv=lv){
    let pct=str.get(percs;pidx);
    let pname=str.get(pnames;pidx);
    let pos=mut.str.toi32(str.tof32(pct)*str.tof32(n)/100.0);
    if(pos>n){ pos=n-1 };
    if(pos<0){ pos=0 };
    if(n>0){
      percentileat=str.get(sorted;pos)
    }el{
      percentileat=0.0
    };
    let pair=@(pname;str.formatf32(percentileat;2));
    str.push(outrows;pair);
    pidx=pidx+1
  };
  <$result{
    op:"percentile";
    column:q.column;
    value:"";
    rows:outrows;
    labels:@();
    values:@()
  }
};

f=opcountby(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let keys=mut.@();
  let counts=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let key=getcol(row;cidx);
    let found=mut.false;
    let kidx=mut.0;
    lp(let lv2=0;kidx<str.len(keys);lv2=lv2){
      if(str.eq(str.get(keys;kidx);key)){
        let old=str.get(counts;kidx);
        str.set(counts;kidx;old+1);
        found=true
      };
      kidx=kidx+1
    };
    if(found=false){
      str.push(keys;key);
      str.push(counts;1)
    };
    rowidx=rowidx+1
  };
  let sortn=str.len(keys);
  let i=mut.0;
  lp(let lv=0;i<sortn-1;lv=lv){
    let j=mut.i+1;
    lp(let lv2=0;j<sortn;lv2=lv2){
      if(str.get(counts;j)>str.get(counts;i)){
        let tmpk=str.get(keys;i);
        let tmpc=str.get(counts;i);
        str.set(keys;i;str.get(keys;j));
        str.set(counts;i;str.get(counts;j));
        str.set(keys;j;tmpk);
        str.set(counts;j;tmpc)
      };
      j=j+1
    };
    i=i+1
  };
  let countstrs=mut.@();
  let ci=mut.0;
  lp(let lv=0;ci<str.len(counts);lv=lv){
    str.push(countstrs;str.fromi32(str.get(counts;ci)));
    ci=ci+1
  };
  <$result{
    op:"count_by";
    column:q.column;
    value:"";
    rows:@();
    labels:keys;
    values:countstrs
  }
};

f=oplatest(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let didx=colindex(working;q.column);
  let nlimit=mut.q.topn;
  if(!(nlimit>0)){ nlimit=10 };
  let sortedrows=mut.@();
  let sorteddates=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let d=getcol(row;didx);
    let insertpos=mut.str.len(sorteddates);
    let checkidx=mut.0;
    lp(let lv2=0;checkidx<str.len(sorteddates);lv2=lv2){
      if(str.compare(d;str.get(sorteddates;checkidx))>0){
        insertpos=checkidx;
        checkidx=str.len(sorteddates)
      };
      checkidx=checkidx+1
    };
    str.insert(sortedrows;insertpos;row);
    str.insert(sorteddates;insertpos;d);
    rowidx=rowidx+1
  };
  let latestrows=mut.@();
  let taken=mut.0;
  lp(let lv=0;taken<nlimit && taken<str.len(sortedrows);lv=lv){
    str.push(latestrows;str.get(sortedrows;taken));
    taken=taken+1
  };
  <$result{
    op:"latest";
    column:q.column;
    value:"";
    rows:latestrows;
    labels:@();
    values:@()
  }
};

f=opdistinct(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let seen=mut.@();
  let rowidx=mut.0;
  lp(let lv=0;rowidx<str.len(working.rows);lv=lv){
    let row=str.get(working.rows;rowidx);
    let v=getcol(row;cidx);
    let already=mut.false;
    let sidx=mut.0;
    lp(let lv2=0;sidx<str.len(seen);lv2=lv2){
      if(str.eq(str.get(seen;sidx);v)){
        already=true
      };
      sidx=sidx+1
    };
    if(already=false){ str.push(seen;v) };
    rowidx=rowidx+1
  };
  <$result{
    op:"distinct";
    column:q.column;
    value:"";
    rows:@();
    labels:@();
    values:seen
  }
};

f=opjoin(ds:$dataset;other:$dataset;q:$query):$result{
  let jidxa=colindex(ds;q.joincol);
  let jidxb=colindex(other;q.joincol);
  let joinedrows=mut.@();
  let rowa=mut.0;
  lp(let lv=0;rowa<str.len(ds.rows);lv=lv){
    let arow=str.get(ds.rows;rowa);
    let akey=getcol(arow;jidxa);
    let rowb=mut.0;
    lp(let lv2=0;rowb<str.len(other.rows);lv2=lv2){
      let brow=str.get(other.rows;rowb);
      let bkey=getcol(brow;jidxb);
      if(str.eq(akey;bkey)){
        let merged=mut.@();
        let ca=mut.0;
        lp(let lv3=0;ca<str.len(arow);lv3=lv3){
          str.push(merged;str.get(arow;ca));
          ca=ca+1
        };
        let cb=mut.0;
        lp(let lv3=0;cb<str.len(brow);lv3=lv3){
          if(cb != jidxb){
            str.push(merged;str.get(brow;cb))
          };
          cb=cb+1
        };
        str.push(joinedrows;merged)
      };
      rowb=rowb+1
    };
    rowa=rowa+1
  };
  <$result{
    op:"join";
    column:q.joincol;
    value:"";
    rows:joinedrows;
    labels:@();
    values:@()
  }
};

f=execute(ds:$dataset;q:$query):$result{
  log.info(str.concat("moke.compute: execute op=";q.op));
  if(str.eq(q.op;"count")){ <opcount(ds;q) };
  if(str.eq(q.op;"sum")){ <opsum(ds;q) };
  if(str.eq(q.op;"avg")){ <opavg(ds;q) };
  if(str.eq(q.op;"min")){ <opmin(ds;q) };
  if(str.eq(q.op;"max")){ <opmax(ds;q) };
  if(str.eq(q.op;"group")){ <opgroup(ds;q) };
  if(str.eq(q.op;"timeseries")){ <optimeseries(ds;q) };
  if(str.eq(q.op;"topn")){ <optopn(ds;q) };
  if(str.eq(q.op;"distribution")){ <opdistribution(ds;q) };
  if(str.eq(q.op;"correlate")){ <opcorrelate(ds;q) };
  if(str.eq(q.op;"percentile")){ <oppercentile(ds;q) };
  if(str.eq(q.op;"count_by")){ <opcountby(ds;q) };
  if(str.eq(q.op;"latest")){ <oplatest(ds;q) };
  if(str.eq(q.op;"distinct")){ <opdistinct(ds;q) };
  log.warn(str.concat("moke.compute: unknown op: ";q.op));
  <$result{
    op:q.op;
    column:q.column;
    value:"error:unknown_op";
    rows:@();
    labels:@();
    values:@()
  }
};

f=executejoin(ds:$dataset;other:$dataset;q:$query):$result{
  log.info("moke.compute: execute_join");
  <opjoin(ds;other;q)
};

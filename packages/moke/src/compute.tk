m=moke.compute;
i=str:std.string;
i=log:std.log;

t=$dataset{
  name:str;
  headers:@str;
  rows:@(@(str))
}

t=$query{
  op:str;
  column:str;
  groupby:str;
  filtercol:str;
  filterval:str;
  topn:i32;
  bucketcount:i32;
  joincol:str
}

t=$result{
  op:str;
  column:str;
  value:str;
  rows:@(@(str));
  labels:@str;
  values:@str
}

f=colindex(ds:$dataset;colname:str):i32{
  idx:i32=0;
  if(idx<str.len(ds.headers)){
    if(str.eq(str.trim(str.get(ds.headers;idx));colname)){
      <idx
    }{};
    idx=idx+1
  }{};
  <-1
}

f=getcol(row:@str;idx:i32):str{
  if(idx<0||idx>str.len(row)){
    <""
  }{};
  <str.get(row;idx)
}

f=parsefloat(s:str):f32{
  trimmed:str=str.trim(s);
  if(str.len(trimmed)=0){ <0.0 }{};
  if(str.isnumeric(trimmed)){
    <str.parsef32(trimmed)
  }{};
  <0.0
}

f=applyfilter(ds:$dataset;filtercol:str;filterval:str):$dataset{
  if(str.len(filtercol)=0||str.len(filterval)=0){
    <ds
  }{};
  fcidx:i32=colindex(ds;filtercol);
  if(fcidx<0){ <ds }{};
  filtered:@(@(str))=@();
  rowidx:i32=0;
  if(rowidx<str.len(ds.rows)){
    row:@str=str.get(ds.rows;rowidx);
    cell:str=getcol(row;fcidx);
    if(str.eq(cell;filterval)){
      str.push(filtered;row)
    }{};
    rowidx=rowidx+1
  }{};
  <$dataset{
    name=ds.name;
    headers=ds.headers;
    rows=filtered
  }
}

f=opcount(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cnt:i32=str.len(working.rows);
  <$result{
    op="count";
    column=q.column;
    value=str.fromi32(cnt);
    rows=@();
    labels=@();
    values=@()
  }
}

f=opsum(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  total:f32=0.0;
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    total=total+parsefloat(v);
    rowidx=rowidx+1
  }{};
  <$result{
    op="sum";
    column=q.column;
    value=str.fromf32(total);
    rows=@();
    labels=@();
    values=@()
  }
}

f=opavg(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  total:f32=0.0;
  count:i32=0;
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      total=total+parsefloat(v);
      count=count+1
    }{};
    rowidx=rowidx+1
  }{};
  avgval:f32=0.0;
  if(count>0){ avgval=total/str.tof32(count) }{};
  <$result{
    op="avg";
    column=q.column;
    value=str.formatf32(avgval;2);
    rows=@();
    labels=@();
    values=@()
  }
}

f=opmin(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  minval:f32=0.0;
  found:bool=false;
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      n:f32=parsefloat(v);
      if(found=false){
        minval=n;
        found=true
      }{
        if(n<minval){ minval=n }{}
      }
    }{};
    rowidx=rowidx+1
  }{};
  <$result{
    op="min";
    column=q.column;
    value=str.fromf32(minval);
    rows=@();
    labels=@();
    values=@()
  }
}

f=opmax(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  maxval:f32=0.0;
  found:bool=false;
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      n:f32=parsefloat(v);
      if(found=false){
        maxval=n;
        found=true
      }{
        if(n>maxval){ maxval=n }{}
      }
    }{};
    rowidx=rowidx+1
  }{};
  <$result{
    op="max";
    column=q.column;
    value=str.fromf32(maxval);
    rows=@();
    labels=@();
    values=@()
  }
}

f=opgroup(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  gidx:i32=colindex(working;q.groupby);
  groupkeys:@str=@();
  groupcounts:@i32=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    key:str=getcol(row;gidx);
    foundgroup:bool=false;
    gidx:i32=0;
    if(gidx<str.len(groupkeys)){
      if(str.eq(str.get(groupkeys;gidx);key)){
        oldcount:i32=str.get(groupcounts;gidx);
        str.set(groupcounts;gidx;oldcount+1);
        foundgroup=true
      }{};
      gidx=gidx+1
    }{};
    if(foundgroup=false){
      str.push(groupkeys;key);
      str.push(groupcounts;1)
    }{};
    rowidx=rowidx+1
  }{};
  countstrs:@str=@();
  ci:i32=0;
  if(ci<str.len(groupcounts)){
    str.push(countstrs;str.fromi32(str.get(groupcounts;ci)));
    ci=ci+1
  }{};
  <$result{
    op="group";
    column=q.groupby;
    value="";
    rows=@();
    labels=groupkeys;
    values=countstrs
  }
}

f=optimeseries(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  didx:i32=colindex(working;q.groupby);
  vidx:i32=colindex(working;q.column);
  datekeys:@str=@();
  datesums:@f32=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    rawdate:str=getcol(row;didx);
    daykey:str=str.slice(rawdate;0;10);
    valstr:str=getcol(row;vidx);
    n:f32=parsefloat(valstr);
    foundday:bool=false;
    didx:i32=0;
    if(didx<str.len(datekeys)){
      if(str.eq(str.get(datekeys;didx);daykey)){
        oldsum:f32=str.get(datesums;didx);
        str.set(datesums;didx;oldsum+n);
        foundday=true
      }{};
      didx=didx+1
    }{};
    if(foundday=false){
      str.push(datekeys;daykey);
      str.push(datesums;n)
    }{};
    rowidx=rowidx+1
  }{};
  sumstrs:@str=@();
  si:i32=0;
  if(si<str.len(datesums)){
    str.push(sumstrs;str.fromf32(str.get(datesums;si)));
    si=si+1
  }{};
  <$result{
    op="timeseries";
    column=q.column;
    value="";
    rows=@();
    labels=datekeys;
    values=sumstrs
  }
}

f=optopn(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  nlimit:i32=q.topn;
  if(nlimit<=0){ nlimit=10 }{};
  sortedrows:@(@(str))=@();
  sortedvals:@f32=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:f32=parsefloat(getcol(row;cidx));
    insertpos:i32=str.len(sortedvals);
    checkidx:i32=0;
    if(checkidx<str.len(sortedvals)){
      if(v>str.get(sortedvals;checkidx)){
        insertpos=checkidx;
        checkidx=str.len(sortedvals)
      }{};
      checkidx=checkidx+1
    }{};
    str.insert(sortedrows;insertpos;row);
    str.insert(sortedvals;insertpos;v);
    rowidx=rowidx+1
  }{};
  toprows:@(@(str))=@();
  taken:i32=0;
  if(taken<nlimit&&taken<str.len(sortedrows)){
    str.push(toprows;str.get(sortedrows;taken));
    taken=taken+1
  }{};
  <$result{
    op="topn";
    column=q.column;
    value="";
    rows=toprows;
    labels=@();
    values=@()
  }
}

f=opdistribution(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  bucketcount:i32=q.bucketcount;
  if(bucketcount<=0){ bucketcount=10 }{};
  minval:f32=0.0;
  maxval:f32=0.0;
  first:bool=true;
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      n:f32=parsefloat(v);
      if(first){
        minval=n;
        maxval=n;
        first=false
      }{
        if(n<minval){ minval=n }{};
        if(n>maxval){ maxval=n }{}
      }
    }{};
    rowidx=rowidx+1
  }{};
  range:f32=maxval-minval;
  bucketwidth:f32=range/str.tof32(bucketcount);
  if(bucketwidth<=0.0){ bucketwidth=1.0 }{};
  bucketlabels:@str=@();
  bucketcounts:@i32=@();
  bidx:i32=0;
  if(bidx<bucketcount){
    lo:f32=minval+str.tof32(bidx)*bucketwidth;
    hi:f32=lo+bucketwidth;
    label:str=str.concat(str.fromf32(lo);"-");
    label=str.concat(label;str.fromf32(hi));
    str.push(bucketlabels;label);
    str.push(bucketcounts;0);
    bidx=bidx+1
  }{};
  rowidx=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      n:f32=parsefloat(v);
      bucketidx:i32=str.toi32((n-minval)/bucketwidth);
      if(bucketidx>bucketcount){ bucketidx=bucketcount-1 }{};
      if(bucketidx<0){ bucketidx=0 }{};
      old:i32=str.get(bucketcounts;bucketidx);
      str.set(bucketcounts;bucketidx;old+1)
    }{};
    rowidx=rowidx+1
  }{};
  countstrs:@str=@();
  ci:i32=0;
  if(ci<str.len(bucketcounts)){
    str.push(countstrs;str.fromi32(str.get(bucketcounts;ci)));
    ci=ci+1
  }{};
  <$result{
    op="distribution";
    column=q.column;
    value="";
    rows=@();
    labels=bucketlabels;
    values=countstrs
  }
}

f=opcorrelate(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  xidx:i32=colindex(working;q.column);
  yidx:i32=colindex(working;q.groupby);
  xs:@f32=@();
  ys:@f32=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    xv:str=getcol(row;xidx);
    yv:str=getcol(row;yidx);
    if(str.len(str.trim(xv))>0&&str.len(str.trim(yv))>0){
      str.push(xs;parsefloat(xv));
      str.push(ys;parsefloat(yv))
    }{};
    rowidx=rowidx+1
  }{};
  n:i32=str.len(xs);
  if(n<2){
    <$result{
      op="correlate";
      column=q.column;
      value="0.0";
      rows=@();
      labels=@();
      values=@()
    }
  }{};
  sumx:f32=0.0;
  sumy:f32=0.0;
  i:i32=0;
  if(i<n){
    sumx=sumx+str.get(xs;i);
    sumy=sumy+str.get(ys;i);
    i=i+1;
  }{};
  nf:f32=str.tof32(n);
  meanx:f32=sumx/nf;
  meany:f32=sumy/nf;
  cov:f32=0.0;
  varx:f32=0.0;
  vary:f32=0.0;
  i=0;
  if(i<n){
    dx:f32=str.get(xs;i)-meanx;
    dy:f32=str.get(ys;i)-meany;
    cov=cov+dx*dy;
    varx=varx+dx*dx;
    vary=vary+dy*dy;
    i=i+1;
  }{};
  denom:f32=str.sqrt(varx)*str.sqrt(vary);
  r:f32=0.0;
  if(denom>0.0){ r=cov/denom }{};
  <$result{
    op="correlate";
    column=q.column;
    value=str.formatf32(r;4);
    rows=@();
    labels=@();
    values=@()
  }
}

f=oppercentile(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  nums:@f32=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    if(str.len(str.trim(v))>0){
      str.push(nums;parsefloat(v))
    }{};
    rowidx=rowidx+1
  }{};
  sorted:@f32=str.sortf32(nums);
  n:i32=str.len(sorted);
  percentileat:f32=0.0;
  outrows:@(@(str))=@();
  percs:@i32=[25;50;75;90;99];
  pnames:@str=["p25";"p50";"p75";"p90";"p99"];
  pidx:i32=0;
  if(pidx<5){
    pct:i32=str.get(percs;pidx);
    pname:str=str.get(pnames;pidx);
    pos:i32=str.toi32(str.tof32(pct)*str.tof32(n)/100.0);
    if(pos>n){ pos=n-1 }{};
    if(pos<0){ pos=0 }{};
    if(n>0){
      percentileat=str.get(sorted;pos)
    }{
      percentileat=0.0
    };
    pair:@str=[pname;str.formatf32(percentileat;2)];
    str.push(outrows;pair);
    pidx=pidx+1
  }{};
  <$result{
    op="percentile";
    column=q.column;
    value="";
    rows=outrows;
    labels=@();
    values=@()
  }
}

f=opcountby(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  keys:@str=@();
  counts:@i32=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    key:str=getcol(row;cidx);
    found:bool=false;
    kidx:i32=0;
    if(kidx<str.len(keys)){
      if(str.eq(str.get(keys;kidx);key)){
        old:i32=str.get(counts;kidx);
        str.set(counts;kidx;old+1);
        found=true
      }{};
      kidx=kidx+1
    }{};
    if(found=false){
      str.push(keys;key);
      str.push(counts;1)
    }{};
    rowidx=rowidx+1
  }{};
  sortn:i32=str.len(keys);
  i:i32=0;
  if(i<sortn-1){
    j:i32=i+1;
    if(j<sortn){
      if(str.get(counts;j)>str.get(counts;i)){
        tmpk:str=str.get(keys;i);
        tmpc:i32=str.get(counts;i);
        str.set(keys;i;str.get(keys;j));
        str.set(counts;i;str.get(counts;j));
        str.set(keys;j;tmpk);
        str.set(counts;j;tmpc)
      }{};
      j=j+1
    }{};
    i=i+1;
  }{};
  countstrs:@str=@();
  ci:i32=0;
  if(ci<str.len(counts)){
    str.push(countstrs;str.fromi32(str.get(counts;ci)));
    ci=ci+1
  }{};
  <$result{
    op="count_by";
    column=q.column;
    value="";
    rows=@();
    labels=keys;
    values=countstrs
  }
}

f=oplatest(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  didx:i32=colindex(working;q.column);
  nlimit:i32=q.topn;
  if(nlimit<=0){ nlimit=10 }{};
  sortedrows:@(@(str))=@();
  sorteddates:@str=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    d:str=getcol(row;didx);
    insertpos:i32=str.len(sorteddates);
    checkidx:i32=0;
    if(checkidx<str.len(sorteddates)){
      if(str.compare(d;str.get(sorteddates;checkidx))>0){
        insertpos=checkidx;
        checkidx=str.len(sorteddates)
      }{};
      checkidx=checkidx+1
    }{};
    str.insert(sortedrows;insertpos;row);
    str.insert(sorteddates;insertpos;d);
    rowidx=rowidx+1
  }{};
  latestrows:@(@(str))=@();
  taken:i32=0;
  if(taken<nlimit&&taken<str.len(sortedrows)){
    str.push(latestrows;str.get(sortedrows;taken));
    taken=taken+1
  }{};
  <$result{
    op="latest";
    column=q.column;
    value="";
    rows=latestrows;
    labels=@();
    values=@()
  }
}

f=opdistinct(ds:$dataset;q:$query):$result{
  working:$dataset=applyfilter(ds;q.filtercol;q.filterval);
  cidx:i32=colindex(working;q.column);
  seen:@str=@();
  rowidx:i32=0;
  if(rowidx<str.len(working.rows)){
    row:@str=str.get(working.rows;rowidx);
    v:str=getcol(row;cidx);
    already:bool=false;
    sidx:i32=0;
    if(sidx<str.len(seen)){
      if(str.eq(str.get(seen;sidx);v)){
        already=true
      }{};
      sidx=sidx+1
    }{};
    if(already=false){ str.push(seen;v) }{};
    rowidx=rowidx+1
  }{};
  <$result{
    op="distinct";
    column=q.column;
    value="";
    rows=@();
    labels=@();
    values=seen
  }
}

f=opjoin(ds:$dataset;other:$dataset;q:$query):$result{
  jidxa:i32=colindex(ds;q.joincol);
  jidxb:i32=colindex(other;q.joincol);
  joinedrows:@(@(str))=@();
  rowa:i32=0;
  if(rowa<str.len(ds.rows)){
    arow:@str=str.get(ds.rows;rowa);
    akey:str=getcol(arow;jidxa);
    rowb:i32=0;
    if(rowb<str.len(other.rows)){
      brow:@str=str.get(other.rows;rowb);
      bkey:str=getcol(brow;jidxb);
      if(str.eq(akey;bkey)){
        merged:@str=@();
        ca:i32=0;
        if(ca<str.len(arow)){
          str.push(merged;str.get(arow;ca));
          ca=ca+1
        }{};
        cb:i32=0;
        if(cb<str.len(brow)){
          if(cb!=jidxb){
            str.push(merged;str.get(brow;cb))
          }{};
          cb=cb+1
        }{};
        str.push(joinedrows;merged)
      }{};
      rowb=rowb+1
    }{};
    rowa=rowa+1
  }{};
  <$result{
    op="join";
    column=q.joincol;
    value="";
    rows=joinedrows;
    labels=@();
    values=@()
  }
}

f=execute(ds:$dataset;q:$query):$result{
  log.info(str.concat("moke.compute: execute op=";q.op));
  if(str.eq(q.op;"count")){ <opcount(ds;q) }{};
  if(str.eq(q.op;"sum")){ <opsum(ds;q) }{};
  if(str.eq(q.op;"avg")){ <opavg(ds;q) }{};
  if(str.eq(q.op;"min")){ <opmin(ds;q) }{};
  if(str.eq(q.op;"max")){ <opmax(ds;q) }{};
  if(str.eq(q.op;"group")){ <opgroup(ds;q) }{};
  if(str.eq(q.op;"timeseries")){ <optimeseries(ds;q) }{};
  if(str.eq(q.op;"topn")){ <optopn(ds;q) }{};
  if(str.eq(q.op;"distribution")){ <opdistribution(ds;q) }{};
  if(str.eq(q.op;"correlate")){ <opcorrelate(ds;q) }{};
  if(str.eq(q.op;"percentile")){ <oppercentile(ds;q) }{};
  if(str.eq(q.op;"count_by")){ <opcountby(ds;q) }{};
  if(str.eq(q.op;"latest")){ <oplatest(ds;q) }{};
  if(str.eq(q.op;"distinct")){ <opdistinct(ds;q) }{};
  log.warn(str.concat("moke.compute: unknown op: ";q.op));
  <$result{
    op=q.op;
    column=q.column;
    value="error:unknown_op";
    rows=@();
    labels=@();
    values=@()
  }
}

f=executejoin(ds:$dataset;other:$dataset;q:$query):$result{
  log.info("moke.compute: execute_join");
  <opjoin(ds;other;q)
}

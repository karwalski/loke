   SPDX-License-Identifier: Apache-2.0 *)

m=moke.compute;
i=str:std.str;
i=math:std.math;
i=fmt:std.fmt;
i=log:std.log;
i=u8:shared.utf8;

(* ── This module was written against a std.str that never existed ──────────────────
   Every arithmetic and array call here used to go through `std.str`: str.sqrt, str.parsef32,
   str.formatf32, str.sortf32, str.insert, str.get, str.set, str.push, str.tof32, str.toi32,
   str.fromf32, str.fromi32, str.compare, and str.len applied to an array. Only three of those
   names exist at the pinned toke commit, and the ones that do exist are the `gen:"abi"` block
   at the bottom of stdlib/str.tki, declared (i64,...) -> i64. Because every parameter there is
   i64, the type checker accepts ANY argument for them and reports nothing — so of the 17 bogus
   call sites in this file only 5 distinct names raised E4027 and the other 12 type-checked
   silently. That is the reason the whole tree's interface pass was blind here.

   Three consequences were worse than the compile failure. Read against toke's own
   `src/stdlib/str_glue.c` at the pinned commit:

   1. `str.len` is `tk_str_len_w`, which is `strlen()` on a `char *`. Applied to an ARRAY — 31
      sites here, every loop bound in the file — it walks the element buffer as a NUL-terminated
      string and stops at the first zero byte. An `@str` array's elements are 8-byte heap
      pointers whose high bytes are zero, so `str.len(ds.rows)` returned about 3 for a
      hundred-row dataset. Every loop in this module ran a garbage number of iterations, and
      nothing about it was detectable from the source. `arr.len` is the array length.
   2. `str.push(arr; item)` is `str_array_append`, which ALLOCATES and returns a new array; the
      result was DISCARDED at all 27 append sites. Every op built its output into an array that
      stayed empty. The correct append is `arr = arr.push(item)` — T-24.
   3. `str.compare(a; b)` is `tk_str_eq_w(a,b) ? 0 : 1` — it is inequality, never an ordering,
      and never negative. `oplatest` sorted on `str.compare(d; x) > 0`, which is true whenever
      the two dates DIFFER, so "latest" returned rows in reverse file order regardless of date.
      `str.gt` is the real comparison.

   `str.set(arr; i; v)` does write `ptr[idx]` in place at the ABI level, so unlike the above it
   was not itself a no-op — but it only ever ran against the empty arrays that (2) produced.
   It is replaced by `seti64`/`setf64` rebuilds anyway, because writing a raw word into a typed
   array through an (i64,i64,i64) hole is not something to leave in place.

   Arithmetic is now f64 throughout, because that is what the real stdlib speaks: str.tofloat,
   math.* and fmt.f64 are all f64, and the f32 this file used had nothing behind it. The two ABI
   holes it fell through were `str.tof32`, which is an alias for `tk_str_tofloat_w` and so
   PARSES A STRING — it was being handed an i64 row count, which it dereferenced as a char * —
   and `str.fromf32`, an alias for `tk_str_fromfloat_w`, which reads its argument as f64 bits
   and was being handed an f32. No bare float crosses a module boundary out of here: every op
   reports its number as a string in `$result.value`, so T-20 does not apply to `execute`. *)

t=$dataset{
  name:str;
  headers:@str;
  rows:@(@str)
};

t=$query{
  op:str;
  column:str;
  groupby:str;
  filtercol:str;
  filterval:str;
  topn:i32;
  bucketcount:i32;
  joincol:str
};

t=$result{
  op:str;
  column:str;
  value:str;
  rows:@(@str);
  labels:@str;
  values:@str
};

(* ── Array rebuild helpers ────────────────────────────────────────────────────────
   There is no `arr.get(i) = v` in toke and E2002 advises writing `==` instead, which compiles
   to a discarded comparison and does nothing (T-26). These rebuild instead. O(n) per write, so
   the counting loops below are O(n squared); the demo datasets this module serves are tens to
   low hundreds of rows, which is why that is left alone rather than reached for a map. *)
f=seti64(arr:@i64;pos:i64;v:i64):@i64{
  let out=mut.@();
  lp(let i=0;i<arr.len;i=i+1){
    if(i==pos){
      out=out.push(v)
    }el{
      out=out.push(arr.get(i))
    }
  };
  <out
};

f=setf64(arr:@f64;pos:i64;v:f64):@f64{
  let out=mut.@();
  lp(let i=0;i<arr.len;i=i+1){
    if(i==pos){
      out=out.push(v)
    }el{
      out=out.push(arr.get(i))
    }
  };
  <out
};

f=setstr(arr:@str;pos:i64;v:str):@str{
  let out=mut.@();
  lp(let i=0;i<arr.len;i=i+1){
    if(i==pos){
      out=out.push(v)
    }el{
      out=out.push(arr.get(i))
    }
  };
  <out
};

f=insertf64(arr:@f64;pos:i64;v:f64):@f64{
  let out=mut.@();
  lp(let i=0;i<pos;i=i+1){
    out=out.push(arr.get(i))
  };
  out=out.push(v);
  lp(let j=pos;j<arr.len;j=j+1){
    out=out.push(arr.get(j))
  };
  <out
};

f=insertstr(arr:@str;pos:i64;v:str):@str{
  let out=mut.@();
  lp(let i=0;i<pos;i=i+1){
    out=out.push(arr.get(i))
  };
  out=out.push(v);
  lp(let j=pos;j<arr.len;j=j+1){
    out=out.push(arr.get(j))
  };
  <out
};

f=insertrow(arr:@(@str);pos:i64;v:@str):@(@str){
  let out=mut.@();
  lp(let i=0;i<pos;i=i+1){
    out=out.push(arr.get(i))
  };
  out=out.push(v);
  lp(let j=pos;j<arr.len;j=j+1){
    out=out.push(arr.get(j))
  };
  <out
};

f=findstr(arr:@str;v:str):i64{
  lp(let i=0;i<arr.len;i=i+1){
    if(str.eq(arr.get(i);v)){
      <i
    }
  };
  <(0-1)
};

(* Indices are i64 here, not the i32 this file used. An i32 array index is widened with
   `zext i1` (T-23's neighbour, T-3), which turns any index above 1 into 0 or 1. The struct
   fields `$query.topn` and `$query.bucketcount` stay i32 because other modules construct
   them; they are cast at the point of use. *)
f=colindex(ds:$dataset;colname:str):i64{
  lp(let i=0;i<ds.headers.len;i=i+1){
    if(str.eq(str.trim(ds.headers.get(i));colname)){
      <i
    }
  };
  <(0-1)
};

(* The bound was `idx>row.len`, one past the end: reading the last+1 cell of a short row
   indexed out of bounds instead of returning blank. A ragged CSV is the normal case here. *)
f=getcol(row:@str;idx:i64):str{
  if(idx<0 || idx>=row.len){
    <""
  };
  <row.get(idx)
};

(* `str.tofloat` is a result, so a cell that is not a number is distinguishable from one that
   parses to zero — which the old `str.isnumeric` guard plus `str.parsef32` could not do,
   neither name existing. $ok is written first: `mt` binds a result's arms by POSITION and
   writing the error arm first inverts the match (T-31).

   Same-module callers only. A bare f64 return is corrupted across a module boundary (T-20);
   nothing outside this module calls it, and `execute` is the only exported entry point. *)
f=parsefloat(s:str):f64{
  <mt str.tofloat(str.trim(s)) {
    $ok:v v;
    $parseerr:e 0.0
  }
};

f=isnumericcell(s:str):bool{
  let t=str.trim(s);
  if(str.len(t)==0){
    <false
  };
  <mt str.tofloat(t) {
    $ok:v true;
    $parseerr:e false
  }
};

f=applyfilter(ds:$dataset;filtercol:str;filterval:str):$dataset{
  if(str.len(filtercol)==0 || str.len(filterval)==0){
    <ds
  };
  let fcidx=colindex(ds;filtercol);
  if(fcidx<0){ <ds };
  let filtered=mut.@();
  lp(let rowidx=0;rowidx<ds.rows.len;rowidx=rowidx+1){
    let row=ds.rows.get(rowidx);
    if(str.eq(getcol(row;fcidx);filterval)){
      filtered=filtered.push(row)
    }
  };
  <$dataset{
    name:ds.name;
    headers:ds.headers;
    rows:filtered
  }
};

(* ── Non-numeric cells are skipped, not counted as zero ───────────────────────────
   The old accumulators tested only `str.len(str.trim(v))>0` and then ran the cell through a
   parse that returned 0.0 for anything unparseable. So a column holding "n/a", "-" or a
   currency-prefixed figure contributed a zero to both the sum and the divisor, which drags an
   average toward zero in proportion to how dirty the column is — silently, and worst on
   exactly the messy real-world CSV this demo is for. A cell that does not parse is not a
   value of zero; it is not a value. *)
f=numericcolumn(ds:$dataset;colname:str):@f64{
  let cidx=colindex(ds;colname);
  let out=mut.@();
  lp(let rowidx=0;rowidx<ds.rows.len;rowidx=rowidx+1){
    let cell=getcol(ds.rows.get(rowidx);cidx);
    if(isnumericcell(cell)){
      out=out.push(parsefloat(cell))
    }
  };
  <out
};

f=emptyresult(op:str;column:str;value:str):$result{
  <$result{
    op:op;
    column:column;
    value:value;
    rows:@();
    labels:@();
    values:@()
  }
};

f=opcount(ds:$dataset;q:$query):$result{
  <emptyresult("count";q.column;str.fromint(applyfilter(ds;q.filtercol;q.filterval).rows.len))
};

f=opsum(ds:$dataset;q:$query):$result{
  let nums=numericcolumn(applyfilter(ds;q.filtercol;q.filterval);q.column);
  if(nums.len==0){
    <emptyresult("sum";q.column;"0")
  };
  <emptyresult("sum";q.column;str.fromfloat(math.sum(nums)))
};

f=opavg(ds:$dataset;q:$query):$result{
  let nums=numericcolumn(applyfilter(ds;q.filtercol;q.filterval);q.column);
  if(nums.len==0){
    <emptyresult("avg";q.column;"0.00")
  };
  <emptyresult("avg";q.column;fmt.f64(math.mean(nums);2))
};

(* min and max over an empty column report the empty string rather than 0. The old code
   returned "0" for a column with no numbers, which is indistinguishable from a column whose
   minimum genuinely is zero. *)
f=opmin(ds:$dataset;q:$query):$result{
  let nums=numericcolumn(applyfilter(ds;q.filtercol;q.filterval);q.column);
  if(nums.len==0){
    <emptyresult("min";q.column;"")
  };
  <emptyresult("min";q.column;str.fromfloat(math.min(nums)))
};

f=opmax(ds:$dataset;q:$query):$result{
  let nums=numericcolumn(applyfilter(ds;q.filtercol;q.filterval);q.column);
  if(nums.len==0){
    <emptyresult("max";q.column;"")
  };
  <emptyresult("max";q.column;str.fromfloat(math.max(nums)))
};

f=opgroup(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let gidx=colindex(working;q.groupby);
  let groupkeys=mut.@();
  let groupcounts=mut.@();
  lp(let rowidx=0;rowidx<working.rows.len;rowidx=rowidx+1){
    let key=getcol(working.rows.get(rowidx);gidx);
    let at=findstr(groupkeys;key);
    if(at<0){
      groupkeys=groupkeys.push(key);
      groupcounts=groupcounts.push(1)
    }el{
      groupcounts=seti64(groupcounts;at;groupcounts.get(at)+1)
    }
  };
  let countstrs=mut.@();
  lp(let ci=0;ci<groupcounts.len;ci=ci+1){
    countstrs=countstrs.push(str.fromint(groupcounts.get(ci)))
  };
  <$result{
    op:"group";
    column:q.groupby;
    value:"";
    rows:@();
    labels:groupkeys;
    values:countstrs
  }
};

(* True when the first ten bytes of `t` are a numeric date: eight ASCII digits and two of the
   separators `-`, `/` or `.`, followed by nothing, a space or a `T`. That covers an ISO date,
   an ISO timestamp and a day-first or month-first date with a time after it. *)
f=isdateprefix(t:str):bool{
  let n=str.len(t) as i64;
  if(n<10){ <false }el{};
  let digits=mut.0;
  let others=mut.0;
  lp(let k=0;k<10;k=k+1){
    let b=str.charat(t;k);
    if(b>=48 && b<=57){ digits=digits+1 }el if(b==45 || b==47 || b==46){}el{ others=others+1 }
  };
  if(digits!=8 || others>0){ <false }el{};
  if(n==10){ <true }el{};
  let next=str.charat(t;10);
  <next==32 || next==84
};

(* The day key. A short or empty date groups under its trimmed self, as it did when
   `str.slice`'s result was first matched here.

   F10.50: the key was the first 10 BYTES of any cell, so a date written as `2026年10月7日`
   was cut inside `月` and the chart label was not valid UTF-8. A boundary cut would fix the
   bytes but not the chart: `2026年10月7日` and `2026年10月8日` would both become `2026年10`
   and be summed as one day. So a cell is cut only when its first ten bytes are a numeric
   date, which is ASCII, and any other cell is kept whole and groups under its own value.
   `u8.prefix` still makes the cut, so it can never split a character even if this check
   is loosened. *)
f=daykey(raw:str):str{
  let t=str.trim(raw);
  if(isdateprefix(t)){ <u8.prefix(t;10) }el{};
  <t
};

(* Time-series sums are accumulated in integer MICRO-units, not f64 (MK21.16). An `@f64`
   accumulator here hit T-37: the array handle was stored through the scalar-f64 path, the
   module's IR would not assemble, and so moke could not link at all. Integers also add
   exactly, which a running f64 sum does not. Formatted as a decimal with integer
   arithmetic only, so no f64 crosses a module boundary (T-20). *)
f=microof(n:f64):i64{
  if(n<0.0){ <0-(((0.0-n)*1000000.0+0.5) as i64) }el{};
  <(n*1000000.0+0.5) as i64
};

f=fmtmicro(x:i64):str{
  let neg=x<0;
  let a=mut.x;
  if(neg){ a=0-x }el{};
  let whole=a/1000000;
  let frac=mut.a%1000000;
  let digits=mut.6;
  lp(let z=0;z<6 && frac>0 && frac%10==0;z=z+1){
    frac=frac/10;
    digits=digits-1
  };
  let wholes:str=str.fromi64(whole);
  let body=mut.wholes;
  if(frac>0){
    let fracs:str=str.fromi64(frac);
    let padded=mut.fracs;
    lp(let w=str.len(fracs) as i64;w<digits;w=w+1){ padded=str.concat("0";padded) };
    body="\(wholes).\(padded)"
  }el{};
  if(neg){ <str.concat("-";body) }el{};
  <body
};

f=optimeseries(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let didx=colindex(working;q.groupby);
  let vidx=colindex(working;q.column);
  let datekeys=mut.@();
  let datesums=mut.@();
  lp(let rowidx=0;rowidx<working.rows.len;rowidx=rowidx+1){
    let row=working.rows.get(rowidx);
    let key=daykey(getcol(row;didx));
    let n=microof(parsefloat(getcol(row;vidx)));
    let at=findstr(datekeys;key);
    if(at<0){
      datekeys=datekeys.push(key);
      datesums=datesums.push(n)
    }el{
      datesums=seti64(datesums;at;datesums.get(at)+n)
    }
  };
  let sumstrs=mut.@();
  lp(let si=0;si<datesums.len;si=si+1){
    sumstrs=sumstrs.push(fmtmicro(datesums.get(si)))
  };
  <$result{
    op:"timeseries";
    column:q.column;
    value:"";
    rows:@();
    labels:datekeys;
    values:sumstrs
  }
};

f=optopn(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let nlimit=mut.(q.topn as i64);
  if(nlimit>0){}el{ nlimit=10 };
  let sortedrows=mut.@();
  let sortedvals=mut.@();
  lp(let rowidx=0;rowidx<working.rows.len;rowidx=rowidx+1){
    let row=working.rows.get(rowidx);
    let v=parsefloat(getcol(row;cidx));
    let insertpos=mut.sortedvals.len;
    let placed=mut.false;
    lp(let c=0;c<sortedvals.len && !placed;c=c+1){
      if(v>sortedvals.get(c)){
        insertpos=c;
        placed=true
      }
    };
    sortedrows=insertrow(sortedrows;insertpos;row);
    sortedvals=insertf64(sortedvals;insertpos;v)
  };
  let toprows=mut.@();
  lp(let taken=0;taken<nlimit && taken<sortedrows.len;taken=taken+1){
    toprows=toprows.push(sortedrows.get(taken))
  };
  <$result{
    op:"topn";
    column:q.column;
    value:"";
    rows:toprows;
    labels:@();
    values:@()
  }
};

(* The bucket clamp was `if(bucketidx>bucketcount)`, which misses the two indices that are
   actually out of range: the maximum value of the column lands exactly on `bucketcount` and a
   value one bucket-width above the minimum of a single-bucket histogram lands on 1. Both then
   indexed past the end of the counts array. It is `>=` against bucketcount now. *)
f=opdistribution(ds:$dataset;q:$query):$result{
  let nums=numericcolumn(applyfilter(ds;q.filtercol;q.filterval);q.column);
  let bucketcount=mut.(q.bucketcount as i64);
  if(bucketcount>0){}el{ bucketcount=10 };
  if(nums.len==0){
    <emptyresult("distribution";q.column;"")
  };
  let minval=math.min(nums);
  let bucketwidth=mut.(math.max(nums)-minval)/(bucketcount as f64);
  if(bucketwidth>0.0){}el{ bucketwidth=1.0 };
  let bucketlabels=mut.@();
  let bucketcounts=mut.@();
  lp(let bidx=0;bidx<bucketcount;bidx=bidx+1){
    let lo=minval+(bidx as f64)*bucketwidth;
    bucketlabels=bucketlabels.push("\(fmt.f64(lo;2))-\(fmt.f64(lo+bucketwidth;2))");
    bucketcounts=bucketcounts.push(0)
  };
  lp(let ni=0;ni<nums.len;ni=ni+1){
    let raw=((nums.get(ni)-minval)/bucketwidth) as i64;
    let bucketidx=mut.raw;
    if(bucketidx>=bucketcount){ bucketidx=bucketcount-1 };
    if(bucketidx<0){ bucketidx=0 };
    bucketcounts=seti64(bucketcounts;bucketidx;bucketcounts.get(bucketidx)+1)
  };
  let countstrs=mut.@();
  lp(let ci=0;ci<bucketcounts.len;ci=ci+1){
    countstrs=countstrs.push(str.fromint(bucketcounts.get(ci)))
  };
  <$result{
    op:"distribution";
    column:q.column;
    value:"";
    rows:@();
    labels:bucketlabels;
    values:countstrs
  }
};

(* Pearson r is computed rather than taken from `math.linreg`, which reports r squared and so
   loses the sign — the direction of a correlation is the half a user reads first. Only rows
   where BOTH cells parse are paired, so a blank in one column cannot shift the other column's
   values onto the wrong partner. *)
(* One side of the rows where BOTH columns are numeric, so xs and ys stay paired. Built in
   its own function because an `@f64` accumulated inline in opcorrelate hit T-37 and the
   module would not assemble (MK21.16). numericcolumn has the same shape and assembles. *)
f=pairedside(ds:$dataset;xidx:i64;yidx:i64;side:i64):@f64{
  let out=mut.@();
  lp(let rowidx=0;rowidx<ds.rows.len;rowidx=rowidx+1){
    let row=ds.rows.get(rowidx);
    if(isnumericcell(getcol(row;xidx)) && isnumericcell(getcol(row;yidx))){
      out=out.push(parsefloat(getcol(row;side)))
    }el{}
  };
  <out
};

f=opcorrelate(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let xidx=colindex(working;q.column);
  let yidx=colindex(working;q.groupby);
  let xs=pairedside(working;xidx;yidx;xidx);
  let ys=pairedside(working;xidx;yidx;yidx);
  let n=xs.len;
  if(n<2){
    <emptyresult("correlate";q.column;"0.0000")
  };
  let meanx=math.mean(xs);
  let meany=math.mean(ys);
  let cov=mut.0.0;
  let varx=mut.0.0;
  let vary=mut.0.0;
  lp(let i=0;i<n;i=i+1){
    let dx=xs.get(i)-meanx;
    let dy=ys.get(i)-meany;
    cov=cov+dx*dy;
    varx=varx+dx*dx;
    vary=vary+dy*dy
  };
  let denom=math.sqrt(varx)*math.sqrt(vary);
  let r=mut.0.0;
  if(denom>0.0){ r=cov/denom };
  <emptyresult("correlate";q.column;fmt.f64(r;4))
};

(* `math.percentile` replaces a hand-rolled sort-and-index. The sort it needed was
   `str.sortf32`, which does not exist; the index it computed was `pct*n/100` clamped with
   `if(pos>n){pos=n-1}`, so p99 and p100 on any column indexed one past the last element. *)
f=oppercentile(ds:$dataset;q:$query):$result{
  let nums=numericcolumn(applyfilter(ds;q.filtercol;q.filterval);q.column);
  let pcts=@(25.0;50.0;75.0;90.0;99.0);
  let pnames=@("p25";"p50";"p75";"p90";"p99");
  let outrows=mut.@();
  lp(let pidx=0;pidx<pcts.len;pidx=pidx+1){
    let label=pnames.get(pidx);
    if(nums.len==0){
      outrows=outrows.push(@(label;""))
    }el{
      outrows=outrows.push(@(label;fmt.f64(math.percentile(nums;pcts.get(pidx));2)))
    }
  };
  <$result{
    op:"percentile";
    column:q.column;
    value:"";
    rows:outrows;
    labels:@();
    values:@()
  }
};

f=opcountby(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let keys=mut.@();
  let counts=mut.@();
  lp(let rowidx=0;rowidx<working.rows.len;rowidx=rowidx+1){
    let key=getcol(working.rows.get(rowidx);cidx);
    let at=findstr(keys;key);
    if(at<0){
      keys=keys.push(key);
      counts=counts.push(1)
    }el{
      counts=seti64(counts;at;counts.get(at)+1)
    }
  };
  (* Selection sort, descending by count, keys carried along. The swap used to be four
     `str.set` calls, none of which assigned anything, so this loop read its own unsorted
     input every pass and count_by came back in insertion order while claiming to rank. *)
  let sortn=keys.len;
  lp(let i=0;i<sortn;i=i+1){
    lp(let j=i+1;j<sortn;j=j+1){
      if(counts.get(j)>counts.get(i)){
        let tmpk=keys.get(i);
        let tmpc=counts.get(i);
        keys=setstr(keys;i;keys.get(j));
        counts=seti64(counts;i;counts.get(j));
        keys=setstr(keys;j;tmpk);
        counts=seti64(counts;j;tmpc)
      }
    }
  };
  let countstrs=mut.@();
  lp(let ci=0;ci<counts.len;ci=ci+1){
    countstrs=countstrs.push(str.fromint(counts.get(ci)))
  };
  <$result{
    op:"count_by";
    column:q.column;
    value:"";
    rows:@();
    labels:keys;
    values:countstrs
  }
};

(* Dates are compared as strings, which is only an ordering for a fixed-width leading-zero
   format such as ISO 8601. `str.gt` replaces `str.compare(...)>0`, which resolved to the
   (i64,i64) -> i64 ABI entry and so compared two string HANDLES, not their contents. *)
f=oplatest(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let didx=colindex(working;q.column);
  let nlimit=mut.(q.topn as i64);
  if(nlimit>0){}el{ nlimit=10 };
  let sortedrows=mut.@();
  let sorteddates=mut.@();
  lp(let rowidx=0;rowidx<working.rows.len;rowidx=rowidx+1){
    let row=working.rows.get(rowidx);
    let d=getcol(row;didx);
    let insertpos=mut.sorteddates.len;
    let placed=mut.false;
    lp(let c=0;c<sorteddates.len && !placed;c=c+1){
      if(str.gt(d;sorteddates.get(c))){
        insertpos=c;
        placed=true
      }
    };
    sortedrows=insertrow(sortedrows;insertpos;row);
    sorteddates=insertstr(sorteddates;insertpos;d)
  };
  let latestrows=mut.@();
  lp(let taken=0;taken<nlimit && taken<sortedrows.len;taken=taken+1){
    latestrows=latestrows.push(sortedrows.get(taken))
  };
  <$result{
    op:"latest";
    column:q.column;
    value:"";
    rows:latestrows;
    labels:@();
    values:@()
  }
};

f=opdistinct(ds:$dataset;q:$query):$result{
  let working=applyfilter(ds;q.filtercol;q.filterval);
  let cidx=colindex(working;q.column);
  let seen=mut.@();
  lp(let rowidx=0;rowidx<working.rows.len;rowidx=rowidx+1){
    let v=getcol(working.rows.get(rowidx);cidx);
    if(findstr(seen;v)<0){
      seen=seen.push(v)
    }
  };
  <$result{
    op:"distinct";
    column:q.column;
    value:"";
    rows:@();
    labels:@();
    values:seen
  }
};

f=opjoin(ds:$dataset;other:$dataset;q:$query):$result{
  let jidxa=colindex(ds;q.joincol);
  let jidxb=colindex(other;q.joincol);
  let joinedrows=mut.@();
  lp(let rowa=0;rowa<ds.rows.len;rowa=rowa+1){
    let arow=ds.rows.get(rowa);
    let akey=getcol(arow;jidxa);
    lp(let rowb=0;rowb<other.rows.len;rowb=rowb+1){
      let brow=other.rows.get(rowb);
      if(str.eq(akey;getcol(brow;jidxb))){
        let merged=mut.@();
        lp(let ca=0;ca<arow.len;ca=ca+1){
          merged=merged.push(arow.get(ca))
        };
        lp(let cb=0;cb<brow.len;cb=cb+1){
          if(cb==jidxb){}el{
            merged=merged.push(brow.get(cb))
          }
        };
        joinedrows=joinedrows.push(merged)
      }
    }
  };
  <$result{
    op:"join";
    column:q.joincol;
    value:"";
    rows:joinedrows;
    labels:@();
    values:@()
  }
};

(* std.log.info and std.log.warn take a message and a field table, `[[str]]`; the one-argument
   calls this file made were E4026. `@()` is an empty field table. *)
f=execute(ds:$dataset;q:$query):$result{
  log.info(str.concat("moke.compute: execute op=";q.op);@());
  if(str.eq(q.op;"count")){ <opcount(ds;q) };
  if(str.eq(q.op;"sum")){ <opsum(ds;q) };
  if(str.eq(q.op;"avg")){ <opavg(ds;q) };
  if(str.eq(q.op;"min")){ <opmin(ds;q) };
  if(str.eq(q.op;"max")){ <opmax(ds;q) };
  if(str.eq(q.op;"group")){ <opgroup(ds;q) };
  if(str.eq(q.op;"timeseries")){ <optimeseries(ds;q) };
  if(str.eq(q.op;"topn")){ <optopn(ds;q) };
  if(str.eq(q.op;"distribution")){ <opdistribution(ds;q) };
  if(str.eq(q.op;"correlate")){ <opcorrelate(ds;q) };
  if(str.eq(q.op;"percentile")){ <oppercentile(ds;q) };
  if(str.eq(q.op;"count_by")){ <opcountby(ds;q) };
  if(str.eq(q.op;"latest")){ <oplatest(ds;q) };
  if(str.eq(q.op;"distinct")){ <opdistinct(ds;q) };
  log.warn(str.concat("moke.compute: unknown op: ";q.op);@());
  <emptyresult(q.op;q.column;"error:unknown_op")
};

f=executejoin(ds:$dataset;other:$dataset;q:$query):$result{
  log.info("moke.compute: execute_join";@());
  <opjoin(ds;other;q)
};

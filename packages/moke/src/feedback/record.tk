m=moke.feedbackrecord;
i=str:std.str;
i=os:std.os;
i=sdb:core.storage.db;
i=fs:core.feedback.store;
i=ft:core.feedback.types;

(* LS1.4a. Where moke's /api/feedback stores a rating: loke's own feedback store,
   core.feedback.store, in the `feedback` table of $HOME/.loke/loke.db. There is no second
   store. moke has no database of its own (see moke.panellog), and core.memory.palace
   already shares loke.db, so this is the same file loke and the memory palace open.

   The row is what X5.1 and the table allow and nothing more: rating, feature area, request
   id, model id, use case and comment. moke's `dataset` is the demo's use case (a fixture
   name such as it_platform), so it goes in `use_case`; the table has no dataset column and
   one is not added. `risk_level` is left empty, because moke's feedback widget does not
   send one. The comment is stored as typed, as core.feedback.store.save stores every
   comment: nothing in this repository scans feedback text, so neither does this (LS1.4c).

   This module does not import moke.feedback: both declare a $feedbackentry, and the one
   written here is core.feedback.types'. *)

f=datadir():str{
  <str.concat(os.getenv("HOME");"/.loke")
};

f=ratingfor(rating:str):$feedbackrating{
  if(str.eq(rating;"thumbs_up")){ <$feedbackrating{$thumbsup:0} }el{};
  if(str.eq(rating;"thumbs_down")){ <$feedbackrating{$thumbsdown:0} }el{};
  <$feedbackrating{$neutral:0}
};

(* The wire names moke's pages send, onto the store's areas. Anything else is kept as
   `Other: <name>`, which is how core.feedback.store reads a free-form area back. *)
f=areafor(area:str):$featurearea{
  if(str.eq(area;"chat_response")){ <$featurearea{$chatresponse:0} }el{};
  if(str.eq(area;"privacy_detection")){ <$featurearea{$privacydetection:0} }el{};
  if(str.eq(area;"routing_decision")){ <$featurearea{$routingdecision:0} }el{};
  if(str.eq(area;"governance_warning")){ <$featurearea{$governancewarning:0} }el{};
  if(str.eq(area;"agent_output")){ <$featurearea{$agentoutput:0} }el{};
  if(str.eq(area;"compression")){ <$featurearea{$compression:0} }el{};
  if(str.eq(area;"dashboard")){ <$featurearea{$dashboard:0} }el{};
  <$featurearea{$other:area}
};

f=entryfor(rating:str;area:str;requestid:str;modelid:str;dataset:str;comment:str):$feedbackentry{
  let base=ft.newentry(ratingfor(rating);areafor(area);requestid;modelid;comment);
  <$feedbackentry{
    id:base.id;
    rating:base.rating;
    featurearea:base.featurearea;
    requestid:base.requestid;
    modelid:base.modelid;
    usecase:dataset;
    risklevel:"";
    comment:base.comment;
    createdat:base.createdat
  }
};

(* Stores one rating and answers its id, or "" when the store could not be opened or the
   row could not be written. A caller must not report a rating as stored on "". *)
f=save(rating:str;area:str;requestid:str;modelid:str;dataset:str;comment:str):str{
  <mt sdb.openstore(datadir()) {
    $ok:s intable(entryfor(rating;area;requestid;modelid;dataset;comment));
    $err:e ""
  }
};

f=intable(entry:$feedbackentry):str{
  <mt fs.ensuretable(1) {
    $ok:v saverow(entry);
    $err:e ""
  }
};

f=saverow(entry:$feedbackentry):str{
  <mt fs.save(1;entry) {
    $ok:v entry.id;
    $err:e ""
  }
};

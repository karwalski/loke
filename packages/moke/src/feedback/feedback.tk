m=moke.feedback;
i=str:std.str;
i=time:std.time;

(* `time.nowms`, not `std.nowms` through a bare `i=std:std;` import: toke mangled that call to
   `_tk_std_nowms_w`, which no module defines, so moke did not link (F10.34). *)

t=$feedbackentry{
  id:str;
  rating:str;
  featurearea:str;
  requestid:str;
  modelid:str;
  dataset:str;
  comment:str;
  createdat:str
};

t=$feedbacksummary{
  total:u32;
  thumbsup:u32;
  thumbsdown:u32;
  thumbsuppct:f64;
  bymodel:@$modelsummary;
  bydataset:@$datasetsummary
};

t=$modelsummary{
  modelid:str;
  total:u32;
  thumbsup:u32;
  thumbsuppct:f64
};

t=$datasetsummary{
  dataset:str;
  total:u32;
  thumbsup:u32;
  thumbsuppct:f64
};

f=genid():str{
  let chars="0123456789abcdef";
  let id="fb_";
  let i=0;
  <str.concat(id;str.fromint(time.nowms()))
};

f=newentry(rating:str;area:str;requestid:str;modelid:str;dataset:str;comment:str):$feedbackentry{
  <$feedbackentry{
    id:genid();
    rating:rating;
    featurearea:area;
    requestid:requestid;
    modelid:modelid;
    dataset:dataset;
    comment:comment;
    createdat:str.fromint(time.nowms())
  };
};

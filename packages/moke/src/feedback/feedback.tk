
m=moke.feedback;
i=str:std.string;

t=$feedbackentry{
  id:$str;
  rating:$str;
  featurearea:$str;
  requestid:$str;
  modelid:$str;
  dataset:$str;
  comment:$str;
  createdat:$str
};

t=$feedbacksummary{
  total:u32;
  thumbsup:u32;
  thumbsdown:u32;
  thumbsuppct:f64;
  bymodel:@$modelsummary;
  bydataset:@$datasetsummary
};

t=$modelsummary{
  modelid:$str;
  total:u32;
  thumbsup:u32;
  thumbsuppct:f64
};

t=$datasetsummary{
  dataset:$str;
  total:u32;
  thumbsup:u32;
  thumbsuppct:f64
};

f=genid():$str{
  let chars="0123456789abcdef";
  let id="fb_";
  let i=0;
  <str.concat(id;str.fromi64(std.nowms()))
};

f=newentry(rating:$str;area:$str;requestid:$str;modelid:$str;dataset:$str;comment:$str):$feedbackentry{
  <$feedbackentry{
    id:$genid();
    rating:$rating;
    featurearea:$area;
    requestid:$requestid;
    modelid:$modelid;
    dataset:$dataset;
    comment:$comment;
    createdat:i64(std.nowms())
  };
};

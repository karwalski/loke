m=moke.main;
i=log:shared.log;

(* The three-argument `log.info(message; module; actor)` this file calls is `shared.log`, not
   `std.log` — std.log.info takes a message and a `[[str]]` field table. The import was
   `std.log`, so both calls were E4026 the moment the E2030 above them stopped masking them. *)

f=start():i64{
  log.info("moke starting on port 11432";"moke.main";"system");
  log.info("moke ready";"moke.main";"system");
  <0
};

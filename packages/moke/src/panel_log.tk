m=moke.panellog;
i=str:std.str;
i=file:std.file;
i=os:std.os;

(* MK6.6 — the MCP and agents panels' history, kept where every worker can see it.

   moke serves from several pre-forked worker processes (std.http's http_serve_workers), and the
   panels kept their logs in module-level `let` state, so each worker had its own copy: after six
   invocations, eight reads of /api/mcp/tools reported 0, 0, 0, 1, 0, 0, 1, 1. moke has no
   database of its own, and std.db's one process-wide connection (T-30) belongs to the memory
   palace when the memory panel runs. So the history is a file per panel, one line per event,
   appended and read back whole.

   file.append opens with O_APPEND and writes each line in one call, so two workers appending
   at once each add a whole line. A line must therefore carry no newline: every caller writes
   JSON built with shared.jsonobj.escape, or tab-separated fields it has checked.

   The files live under $HOME/.loke/moke, beside the memory panel's palace, and they outlive a
   restart. Nothing trims them: a panel reads the last hundred lines, and the total is the line
   count. *)

f=dir():str{
  <str.concat(os.getenv("HOME");"/.loke/moke")
};

f=path(name:str):str{
  <str.concat(dir();str.concat("/";str.concat(name;".log")))
};

f=append(name:str;line:str):bool{
  file.mkdir(dir());
  <mt file.append(path(name);str.concat(line;"\n")) {
    $ok:v true;
    $err:e false
  }
};

(* Every non-empty line, oldest first. A file that does not exist yet is an empty history. *)
f=lines(name:str):@str{
  let text=mt file.read(path(name)) {
    $ok:v v;
    $err:e ""
  };
  let parts=str.split(text;"\n");
  let out=mut.@();
  lp(let i=0;i<parts.len;i=i+1){
    let p:str=parts.get(i);
    if(str.len(p) > 0){ out=out.push(p) }el{}
  };
  <out
};

(* The last n of them, oldest first. *)
f=last(all:@str;n:i64):@str{
  let start=mut.0;
  if(all.len > n){ start=all.len - n }el{};
  let out=mut.@();
  lp(let i=start;i<all.len;i=i+1){
    out=out.push(all.get(i))
  };
  <out
};

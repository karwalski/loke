m=moke.provider;
i=str:std.str;
i=json:std.json;
i=http:std.http;
i=log:std.log;
i=providers:core.extensions.providerregistry;
i=compute:moke.compute;

(* --- Every field read here was against a type the compiler was not checking -------
   `$localcomputeresponse.result` was declared `i64` while `handlecompute` put a `$result` in it
   and `formatresultastext` read `.op`, `.value`, `.labels`, `.values` and `.rows` off an `i64`
   parameter. Member access on an integer is not checked, so the whole formatter walked a raw
   word as a struct. Both are `$result` now. `makeprovider` was declared `:i64` and returned a
   `$customprovider`, which E4031 did catch.

   The missing std.str members were `pushcopy`, `jsonstring`, `isnumeric` and `parsei32` -- none
   of them in the interface or the runtime. Behind them: `str.len` applied to an ARRAY (it is
   `strlen()` on a `char *`, so it returned a small constant, and `register` therefore scanned
   about three of the existing registrations when de-duplicating an id), `str.get` and
   `str.push` on arrays with the result discarded (T-24). The eleven `.len()` spellings were
   harmless: measured in the emitted IR, `arr.len()` and `arr.len` produce the identical
   `getelementptr i64, i64* %p, i32 -1` and the compiler even labels it `; .len()`. They read as
   property here for consistency, not as a fix.

   `row.len() > 2` in the percentile branch needed `>= 2`: `moke.compute.oppercentile` emits
   two-element rows, so that branch printed a header and no percentiles. *)

t=$providercapability{
  streaming:bool;
  toolcalling:bool;
  embedding:bool
};

t=$providerregistration{
  id:str;
  name:str;
  description:str;
  capabilities:$providercapability
};

t=$providerstore{
  registrations:@$providerregistration
};

t=$localcomputerequest{
  op:str;
  column:str;
  groupby:str;
  filtercol:str;
  filterval:str;
  topn:i32
};

t=$localcomputeresponse{
  ok:bool;
  result:$result;
  error:str
};

f=register(reg:$providerregistration;store:$providerstore):$providerstore{
  let filtered=mut.@();
  lp(let idx=0;idx<store.registrations.len;idx=idx+1){
    let entry:$providerregistration=store.registrations.get(idx);
    if(str.eq(entry.id;reg.id)){}el{
      filtered=filtered.push(entry)
    }
  };
  <$providerstore{ registrations:filtered.push(reg) }
};

f=listregistered(store:$providerstore):@$providerregistration{
  <store.registrations
};

f=noregistration():$providerregistration{
  <$providerregistration{
    id:"";
    name:"";
    description:"";
    capabilities:$providercapability{streaming:false;toolcalling:false;embedding:false}
  }
};

f=get(id:str;store:$providerstore):$providerregistration{
  lp(let idx=0;idx<store.registrations.len;idx=idx+1){
    let entry:$providerregistration=store.registrations.get(idx);
    if(str.eq(entry.id;id)){
      <entry
    }
  };
  <noregistration()
};

(* `moke.provider`'s `$providerstore` shares its name with
   `core.extensions.providerregistry`'s `providerstore`, and `moke/extensions/core.tk` imports
   both — so a `$providerstore{ registrations:@() }` literal written there resolves to the core
   type and fails with E4025. A constructor is unambiguous because the call carries the module
   alias. See moke.hooks.newruleregistry for the same fix, and MK21.15 for the collision. *)
f=newstore():$providerstore{
  <$providerstore{ registrations:@() }
};

f=registerschemafirstprovider(store:$providerstore):$providerstore{
  let reg=$providerregistration{
    id:"moke.schema_first";
    name:"moke Schema-First Interceptor";
    description:"Intercepts cloud-bound requests, replaces raw tabular data with a TOON-compressed schema profile, and logs the substitution. Raw row data never leaves the device.";
    capabilities:$providercapability{
      streaming:false;
      toolcalling:false;
      embedding:false
    }
  };
  let result=register(reg;store);
  log.info("moke.provider: schema-first provider registered";@());
  <result
};

f=makeprovider():$customprovider{
  <$customprovider{
    id:"moke.local_compute";
    name:"moke Local Compute";
    baseurl:"http://127.0.0.1:11432/internal/compute";
    caps:$providercaps{
      streaming:false;
      toolcalling:false;
      embedding:false;
      maxcontext:0
    };
    priority:100
  }
};

(* `str.jsonstring` does not exist. `json.str` does, over a `Json` from `json.dec`, and it is a
   result -- a missing key is distinguishable from an empty one. $ok is written first because
   `mt` binds a result's arms by POSITION and the error arm first inverts the match (T-31). *)
f=fieldstr(body:str;key:str):str{
  <mt json.dec(body) {
    $ok:o mt json.str(o;key) {
      $ok:v v;
      $jsonerr:e ""
    };
    $jsonerr:e ""
  }
};

(* Every numeric std.json accessor reports an error for a FALSY value, so `json.i64` on a
   top_n of 0 lands in the error arm (T-33). Zero is also the fallback, so the two agree. *)
f=fieldint(body:str;key:str;fallback:i64):i64{
  <mt json.dec(body) {
    $ok:o mt json.i64(o;key) {
      $ok:v v;
      $jsonerr:e fallback
    };
    $jsonerr:e fallback
  }
};

f=emptycomputeresult():$result{
  <$result{
    op:"";
    column:"";
    value:"";
    rows:@();
    labels:@();
    values:@()
  }
};

f=handlecompute(reqbody:str;ds:$dataset):$localcomputeresponse{
  let op=fieldstr(reqbody;"op");
  if(str.len(op) == 0){
    <$localcomputeresponse{
      ok:false;
      result:emptycomputeresult();
      error:"missing required field: op"
    }
  };
  let q=$query{
    op:op;
    column:fieldstr(reqbody;"column");
    groupby:fieldstr(reqbody;"group_by");
    filtercol:fieldstr(reqbody;"filter_col");
    filterval:fieldstr(reqbody;"filter_val");
    topn:fieldint(reqbody;"top_n";0) as i32;
    bucketcount:10;
    joincol:""
  };
  log.info("moke.provider: dispatching local compute op=\(op)";@());
  <$localcomputeresponse{
    ok:true;
    result:compute.execute(ds;q);
    error:""
  }
};

f=countof(v:str):i64{
  <mt str.tofloat(str.trim(v)) {
    $ok:n n as i64;
    $parseerr:e 0
  }
};

f=isnumericstr(v:str):bool{
  let t=str.trim(v);
  if(str.len(t)==0){
    <false
  };
  <mt str.tofloat(t) {
    $ok:n true;
    $parseerr:e false
  }
};

f=labelledsummary(result:$result):str{
  let n=result.labels.len;
  let totalcount=mut.0;
  lp(let ci=0;ci<n && ci<result.values.len;ci=ci+1){
    totalcount=totalcount+countof(result.values.get(ci))
  };
  let limit=mut.5;
  if(limit>n){ limit=n };
  let parts=mut.@();
  lp(let li=0;li<limit;li=li+1){
    let val=mut."";
    if(li<result.values.len){ val=result.values.get(li) };
    let pctstr=mut."";
    if(totalcount>0 && isnumericstr(val)){
      pctstr=" (\(str.fromint(countof(val)*100/totalcount))%)"
    };
    parts=parts.push("\(result.labels.get(li))\(pctstr)")
  };
  let out=mut."top values: \(str.join(", ";parts))";
  if(n>limit){
    out=str.concat(out;" + \(str.fromint(n-limit)) more")
  };
  <out
};

f=percentilesummary(result:$result):str{
  let parts=mut.@();
  lp(let ri=0;ri<result.rows.len;ri=ri+1){
    let row=result.rows.get(ri);
    if(row.len>=2){
      parts=parts.push("\(row.get(0))=\(row.get(1))")
    }
  };
  <"percentile(\(result.column)): \(str.join(", ";parts))"
};

f=formatresultastext(result:$result):str{
  if(str.eq(result.op;"count")){
    <"count=\(result.value)"
  };
  if(str.eq(result.op;"sum")){
    <"sum(\(result.column))=\(result.value)"
  };
  if(str.eq(result.op;"avg")){
    <"avg(\(result.column))=\(result.value)"
  };
  if(str.eq(result.op;"min")){
    <"min(\(result.column))=\(result.value)"
  };
  if(str.eq(result.op;"max")){
    <"max(\(result.column))=\(result.value)"
  };
  if(str.eq(result.op;"correlate")){
    <"pearson_r(\(result.column))=\(result.value)"
  };
  if(str.eq(result.op;"group") || str.eq(result.op;"count_by") ||
     str.eq(result.op;"distribution") || str.eq(result.op;"timeseries")){
    <labelledsummary(result)
  };
  if(str.eq(result.op;"distinct")){
    <"distinct(\(result.column)): \(str.fromint(result.values.len))"
  };
  if(str.eq(result.op;"percentile")){
    <percentilesummary(result)
  };
  if(str.eq(result.op;"topn") || str.eq(result.op;"latest")){
    <"\(result.op)(\(result.column)): \(str.fromint(result.rows.len)) rows"
  };
  if(str.eq(result.op;"join")){
    <"join result: \(str.fromint(result.rows.len)) rows"
  };
  if(str.len(result.value) > 0){
    <"\(result.op)=\(result.value)"
  };
  <"\(result.op) result: no scalar value"
};

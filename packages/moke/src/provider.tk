m=moke.provider;
i=str:std.string;
i=http:std.http;
i=log:std.log;
i=providers:core.extensions.providerregistry;
i=compute:moke.compute;

t=$providercapability{
  streaming:bool;
  toolcalling:bool;
  embedding:bool
};

t=$providerregistration{
  id:str;
  name:str;
  description:str;
  capabilities:$providercapability
};

t=$providerstore{
  registrations:@$providerregistration
};

t=$localcomputerequest{
  op:str;
  column:str;
  groupby:str;
  filtercol:str;
  filterval:str;
  topn:i32
};

t=$localcomputeresponse{
  ok:bool;
  result:i64;
  error:str
};

f=register(reg:$providerregistration;store:$providerstore):$providerstore{
  let existing=store.registrations;
  let filtered=mut.@();
  let idx=mut.0;
  lp(let lv=0;idx<str.len(existing);lv=lv){
    let entry=str.get(existing;idx);
    if(str.eq(entry.id;reg.id)=false){
      str.push(filtered;entry)
    };
    idx=idx+1
  };
  let updated=str.pushcopy(filtered;reg);
  <$providerstore{ registrations:updated }
};

f=listregistered(store:$providerstore):@$providerregistration{
  <store.registrations
};

f=get(id:str;store:$providerstore):$providerregistration{
  let idx=mut.0;
  lp(let lv=0;idx<str.len(store.registrations);lv=lv){
    let entry=str.get(store.registrations;idx);
    if(str.eq(entry.id;id)){
      <entry
    };
    idx=idx+1
  };
  <$providerregistration{
    id:"";
    name:"";
    description:"";
    capabilities:$providercapability{streaming:false;toolcalling:false;embedding:false}
  }
};

f=registerschemafirstprovider(store:$providerstore):$providerstore{
  let caps=$providercapability{
    streaming:false;
    toolcalling:false;
    embedding:false
  };
  let reg=$providerregistration{
    id:"moke.schema_first";
    name:"moke Schema-First Interceptor";
    description:"Intercepts cloud-bound requests, replaces raw tabular data with a TOON-compressed schema profile, and logs the substitution. Raw row data never leaves the device.";
    capabilities:caps
  };
  let result=register(reg;store);
  log.info("moke.provider: schema-first provider registered");
  <result
};

f=makeprovider():i64{
  let caps=providers.$providercaps{
    streaming:false;
    toolcalling:false;
    embedding:false;
    maxcontext:0
  };
  <providers.$customprovider{
    id:"moke.local_compute";
    name:"moke Local Compute";
    baseurl:"http://127.0.0.1:11432/internal/compute";
    caps:caps;
    priority:100
  }
};

f=handlecompute(reqbody:str;ds:i64):$localcomputeresponse{
  let op=str.jsonstring(reqbody;"op");
  let column=str.jsonstring(reqbody;"column");
  let groupby=str.jsonstring(reqbody;"group_by");
  let filtercol=str.jsonstring(reqbody;"filter_col");
  let filterval=str.jsonstring(reqbody;"filter_val");
  let topnstr=str.jsonstring(reqbody;"top_n");
  let topn=mut.0;
  if(str.len(topnstr) > 0){
    if(str.isnumeric(topnstr)){ topn=str.parsei32(topnstr) }
  };
  if(str.len(op) = 0){
    let emptyresult=compute.$result{
      op:"";
      column:"";
      value:"";
      rows:@();
      labels:@();
      values:@()
    };
    <$localcomputeresponse{
      ok:false;
      result:emptyresult;
      error:"missing required field: op"
    }
  };
  let q=compute.$query{
    op:op;
    column:column;
    groupby:groupby;
    filtercol:filtercol;
    filterval:filterval;
    topn:topn;
    bucketcount:10;
    joincol:""
  };
  log.info(str.concat("moke.provider: dispatching local compute op=";op));
  let result=compute.execute(ds;q);
  <$localcomputeresponse{
    ok:true;
    result:result;
    error:""
  }
};

f=formatresultastext(result:i64):str{
  if(str.eq(result.op;"count")){
    <str.concat("count=";result.value)
  };
  if(str.eq(result.op;"sum")){
    <str.concat(str.concat("sum(";result.column);str.concat(")=";result.value))
  };
  if(str.eq(result.op;"avg")){
    <str.concat(str.concat("avg(";result.column);str.concat(")=";result.value))
  };
  if(str.eq(result.op;"min")){
    <str.concat(str.concat("min(";result.column);str.concat(")=";result.value))
  };
  if(str.eq(result.op;"max")){
    <str.concat(str.concat("max(";result.column);str.concat(")=";result.value))
  };
  if(str.eq(result.op;"correlate")){
    <str.concat(str.concat("pearson_r(";result.column);str.concat(")=";result.value))
  };

  if(str.eq(result.op;"group") || str.eq(result.op;"count_by") ||
     str.eq(result.op;"distribution") || str.eq(result.op;"timeseries")){
    let n=result.labels.len();
    let totalcount=mut.0;
    let ci=mut.0;
    lp(let lv=0;ci < n;lv=lv){
      let v=result.values.get(ci);
      if(str.isnumeric(v)){ totalcount=totalcount + str.parsei32(v) };
      ci=ci + 1
    };
    let out=mut."top values: ";
    let limit=mut.5;
    if(limit > n){ limit=n };
    let li=mut.0;
    lp(let lv=0;li < limit;lv=lv){
      if(li > 0){ out=str.concat(out;", ") };
      let label=result.labels.get(li);
      let val=result.values.get(li);
      let pctstr="";
      if(totalcount > 0 && str.isnumeric(val)){
        let pct=str.parsei32(val) * 100 / totalcount;
        pctstr=str.concat(" (";str.concat(str.fromi32(pct);"%)"))
      };
      out=str.concat(out;str.concat(label;pctstr));
      li=li + 1
    };
    if(n > limit){
      out=str.concat(out;str.concat(" + ";str.concat(str.fromi32(n - limit);" more")))
    };
    <out
  };

  if(str.eq(result.op;"distinct")){
    <str.concat(str.concat("distinct(";result.column);
      str.concat("): ";str.fromi32(result.values.len())))
  };

  if(str.eq(result.op;"percentile")){
    let out=mut.str.concat("percentile(";str.concat(result.column;"): "));
    let ri=mut.0;
    lp(let lv=0;ri < result.rows.len();lv=lv){
      if(ri > 0){ out=str.concat(out;", ") };
      let row=result.rows.get(ri);
      if(row.len() > 2){
        out=str.concat(out;str.concat(row.get(0);str.concat("=";row.get(1))))
      };
      ri=ri + 1
    };
    <out
  };

  if(str.eq(result.op;"topn") || str.eq(result.op;"latest")){
    <str.concat(str.concat(result.op;"(");str.concat(result.column;
      str.concat("): ";str.concat(str.fromi32(result.rows.len());" rows"))))
  };

  if(str.eq(result.op;"join")){
    <str.concat("join result: ";str.concat(str.fromi32(result.rows.len());" rows"))
  };

  if(str.len(result.value) > 0){
    <str.concat(str.concat(result.op;"=");result.value)
  };
  <str.concat(result.op;" result: no scalar value")
};

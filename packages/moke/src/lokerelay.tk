m=moke.lokerelay;
i=http:std.http;
i=str:std.str;
i=reach:shared.reachability;

(* BG1.4. moke's same-origin routes to loke. base.tkt sets window.LOKE_URL to '' when moke's
   own /api/health answers for loke, and the pages then send loke's requests to moke's own
   origin. moke relays them here, unchanged, to loke on loopback, and answers with loke's own
   status and body: a 403 refusal, a 409 or a 429 reaches the page as loke wrote it, not as a
   generic upstream error. Nothing is filtered or decided here. loke's /api/pipeline runs the
   privacy pipeline on the request it receives, exactly as it would for the browser.

   http.postheaders and http.clientget, not shared.reachability.localpost/localget: those
   answer the body alone, and localpost answers "" for a non-2xx status, so a refusal would
   have lost both its code and its reason. Both carry the status at toke 3.1.0.

   The base must be a loopback URL. moke relays only to loke on this machine. *)

t=$relayed{
  status:i64;
  body:str
};

f=lokebase():str{
  <"http://127.0.0.1:11430"
};

(* No usable answer: nothing listening, a transport failure, a body that is not UTF-8, or a
   base that is not this machine. 502, because moke is the gateway that failed. *)
f=noanswer():$relayed{
  <$relayed{status:502;body:"{\"ok\":false,\"error\":\"moke could not reach loke on this machine\",\"relayed_by\":\"moke\"}"}
};

f=postto(base:str;path:str;body:str):$relayed{
  if(!reach.isloopbackurl(base)){ <noanswer() }el{};
  if(!reach.localserviceup(base)){ <noanswer() }el{};
  <mt http.postheaders("\(base)\(path)";body;@(@("content-type";"application/json"))) {
    $ok:r mt str.frombytes(r.body) {
      $ok:s $relayed{status:r.status as i64;body:s};
      $err:e noanswer()
    };
    $err:e noanswer()
  }
};

f=getfrom(base:str;path:str):$relayed{
  if(!reach.isloopbackurl(base)){ <noanswer() }el{};
  if(!reach.localserviceup(base)){ <noanswer() }el{};
  <mt http.clientget(http.client(base);path) {
    $ok:r mt str.frombytes(r.body) {
      $ok:s $relayed{status:r.status as i64;body:s};
      $err:e noanswer()
    };
    $err:e noanswer()
  }
};

m=moke.dashboard_flow;








m=moke.dashboardflow;
i=str:std.string;
i=http:std.http;
i=ddl:moke.ddl;



t=$flowphase{ $schemasent; $ddlreceived; $queriesresolved; $rendered };

t=$flowstate{
  phase:str;
  schematoon:str;
  dashboard:$ddl.dashboard;
  requestid:str;
  error:str
};





f=extractjson(text:str):str{
  
  let fencestart=str.indexof(text;"```json");
  if fencestart >= 0{
    let afterfence=str.slice(text;fencestart + 7;str.len(text));
    let fenceend=str.indexof(afterfence;"```");
    if fenceend >= 0{
      <str.trim(str.slice(afterfence;0;fenceend))
    };
  };
  
  let braceopen=str.indexof(text;"{");
  if braceopen < 0{ <"" };
  let depth=0;
  let i=braceopen;
  let foundend=-1;
  if(i < str.len(text)){
    let ch=str.charat(text;i);
    if(str.eq(ch;"{")){ depth=depth+1 }{};
    if(str.eq(ch;"}")){ depth=depth-1 }{};
    if(depth == 0){
      foundend=i;
      i=str.len(text)
    }{
      i=i+1
    };
  }{};
  if foundend < 0{ <"" };
  <str.trim(str.slice(text;braceopen;foundend+1))
};


f=buildphase1prompt(schematoon:str;userquestion:str):str{
  let p="You have access to this dataset. User asks: ";
  p=str.concat(p;userquestion);
  p=str.concat(p;"

Design a dashboard as a JSON DDL object with the following top-level fields:
");
  p=str.concat(p;"  title (string), summary (string), cards (array).

");
  p=str.concat(p;"Each card must have:
");
  p=str.concat(p;"  id (unique string), kind (one of: metric, chart, table, text, list),
");
  p=str.concat(p;"  title (string), col_span (integer 1-3).

");
  p=str.concat(p;"For metric cards include a 'metric' object with: label, query_op, query_col, unit.
");
  p=str.concat(p;"For chart cards include a 'chart' object with: chart_type (line/bar/pie/area/scatter), x_col, y_col, query_op.
");
  p=str.concat(p;"For table cards include a 'table' object with: columns (string array), query_op, sort_col, limit.

");
  p=str.concat(p;"Respond with ONLY the JSON object, no explanation.

");
  p=str.concat(p;"Dataset schema:
");
  p=str.concat(p;schematoon);
  <p
};





f=parseddlfromjson(json:str):$ddl.dashboard{
  let titlestart=str.indexof(json;"\"title\"");
  let title="Untitled Dashboard";
  if titlestart >= 0{
    let afterkey=str.slice(json;titlestart+7;str.len(json));
    let colon=str.indexof(afterkey;":");
    if colon >= 0{
      let aftercolon=str.trim(str.slice(afterkey;colon+1;str.len(afterkey)));
      if str.charat(aftercolon;0) == "\""{
        let close=str.indexof(str.slice(aftercolon;1;str.len(aftercolon));"\"");
        if close >= 0{
          title=str.slice(aftercolon;1;close+1)
        };
      };
    };
  };
  let summarystart=str.indexof(json;"\"summary\"");
  let summary="";
  if summarystart >= 0{
    let afterkey=str.slice(json;summarystart+9;str.len(json));
    let colon=str.indexof(afterkey;":");
    if colon >= 0{
      let aftercolon=str.trim(str.slice(afterkey;colon+1;str.len(afterkey)));
      if str.charat(aftercolon;0) == "\""{
        let close=str.indexof(str.slice(aftercolon;1;str.len(aftercolon));"\"");
        if close >= 0{
          summary=str.slice(aftercolon;1;close+1)
        };
      };
    };
  };
  
  
  
  let dash=ddl.newdashboard(title;summary);
  <dash
};



f=phase1request(schematoon:str;userquestion:str;requestid:str):$flowstate{
  let prompt=buildphase1prompt(schematoon;userquestion);
  let body="{\"text\":" + "\"" + str.replace(prompt;"\"";"\\"") + "\""
    + ",\"system_prompt\":\"You are a dashboard design assistant. Output only valid JSON.\""
    + ",\"tolerance\":\"patient\""
    + ",\"mode\":\"dashboard\""
    + ",\"request_id\":\"" + requestid + "\""
    + "}";
  let emptydash=ddl.newdashboard("";"");
  let errstate=$flowstate{
    phase="ddl_received";
    schematoon=schematoon;
    dashboard=emptydash;
    requestid=requestid;
    error="pipeline unreachable"
  };
  let res=http.post("http://127.0.0.1:11430/api/pipeline";body;"application/json");
  if !$res.ok{
    <errstate
  };
  let rawjson=extractjson(res.body);
  if str.len(rawjson) == 0{
    let badstate=$flowstate{
      phase="ddl_received";
      schematoon=schematoon;
      dashboard=emptydash;
      requestid=requestid;
      error="no JSON found in LLM response"
    };
    <badstate
  };
  let dash=parseddlfromjson(rawjson);
  
  
  if str.len(dash.title) == 0 || dash.title == "Untitled Dashboard"{
    dash.summary=rawjson
  };
  <$flowstate{
    phase="ddl_received";
    schematoon=schematoon;
    dashboard=dash;
    requestid=requestid;
    error=""
  };
};





f=phase2resolve(state:$flowstate;computeresults:@(str)):$flowstate{
  let i=0;
  state.dashboard.cards.each(card{
    if i < computeresults.len(){
      let result=computeresults.get(i);
      
      
      if str.len(result) > 0 && card.kind == "metric"{
        card.metric.label=card.metric.label + " [" + result + "]"
      };
    };
    i=i+1;
  });
  <$flowstate{
    phase="queries_resolved";
    schematoon=state.schematoon;
    dashboard=state.dashboard;
    requestid=state.requestid;
    error=""
  };
};



f=phase3render(state:$flowstate):str{
  let json=ddl.tojson(state.dashboard);
  <json
};



f=refine(state:$flowstate;instruction:str):$flowstate{
  let currentjson=ddl.tojson(state.dashboard);
  let prompt="Refine this dashboard: ";
  prompt=str.concat(prompt;currentjson);
  prompt=str.concat(prompt;"

Instruction: ");
  prompt=str.concat(prompt;instruction);
  prompt=str.concat(prompt;"

Respond with ONLY the updated JSON object, no explanation.");
  let body="{\"text\":" + "\"" + str.replace(prompt;"\"";"\\"") + "\""
    + ",\"system_prompt\":\"You are a dashboard design assistant. Output only valid JSON.\""
    + ",\"tolerance\":\"patient\""
    + ",\"mode\":\"dashboard\""
    + ",\"request_id\":\"" + state.requestid + "-refine\""
    + "}";
  let res=http.post("http://127.0.0.1:11430/api/pipeline";body;"application/json");
  if !$res.ok{
    <$flowstate{
      phase=state.phase;
      schematoon=state.schematoon;
      dashboard=state.dashboard;
      requestid=state.requestid;
      error="refine: pipeline unreachable"
    };
  };
  let rawjson=extractjson(res.body);
  if str.len(rawjson) == 0{
    <$flowstate{
      phase=state.phase;
      schematoon=state.schematoon;
      dashboard=state.dashboard;
      requestid=state.requestid;
      error="refine: no JSON in LLM response"
    };
  };
  let dash=parseddlfromjson(rawjson);
  if str.len(dash.title) == 0 || dash.title == "Untitled Dashboard"{
    dash.summary=rawjson
  };
  <$flowstate{
    phase="ddl_received";
    schematoon=state.schematoon;
    dashboard=dash;
    requestid=state.requestid;
    error=""
  };
};

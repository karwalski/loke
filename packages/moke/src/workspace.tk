m=moke.workspace;
i=str:std.str;
i=time:std.time;
i=compute:moke.compute;

(* ── Nothing in this module did what it said ───────────────────────────────────────
   Four diagnostics were reported and they were the least of it; E3011 on `some` and `unwrap`
   aborted name resolution, which is why the E4027s behind them never printed. Measured against
   toke's stdlib glue at the pinned commit:

   1. `str.len` is `strlen()` on a `char *` (`tk_str_len_w`). Every loop bound and every
      emptiness test here applied it to an ARRAY, so it walked the element buffer to its first
      zero byte and returned a small constant — about 3 for an array of heap pointers —
      regardless of how many projects or datasets there were. `arr.len` is the length.
   2. `str.push(arr; item)` allocates and RETURNS a new array; every one of the eleven calls
      discarded the result (T-24). `addproject`, `adddataset` and `switchdataset` therefore
      returned the workspace unchanged. No project could ever be added.
   3. `datasets:@i64` held `$dataset` values from moke.compute, and `combinedschema` and
      `findjoinkey` read `.name`, `.headers` and `.rows` off an `i64`. Member access on an
      integer is not checked (the same hole as T-7), so the schema builder dereferenced a raw
      word as a struct. The field is `@$dataset` now — an imported struct type is in scope
      unqualified, which is how moke.upload already uses it.
   4. `str.uuid` and `str.unixnow` exist in neither the interface nor the runtime. `uuid` lives
      on `std.string`, not `std.str`; `str.randhex` is in std.str and is what a demo project id
      needs. The timestamp is `time.nowms`, matching moke.consolelog.

   Every bound test was also `idx > n` where it needed `idx >= n`, one past the end.

   `activeproject` and `activedataset` returned `$project!$none` and reached for `some`,
   `none` and `unwrap`, none of which this language has. A result whose error side is a
   user-declared sum cannot be discriminated at all — `mt` always takes arm 0 (T-18) — so
   even a spelling that compiled would have reported "present" for an empty workspace. They
   return a plain value plus a predicate instead: ask `hasactiveproject` first. The sentinel
   an absent project resolves to is `emptyproject`, whose id is "" and which is therefore
   distinguishable from any real project. *)

t=$project{
  id:str;
  name:str;
  description:str;
  datasets:@$dataset;
  activedatasetidx:i32;
  createdat:i64
};

t=$workspace{
  projects:@$project;
  activeprojectidx:i32
};

f=newworkspace():$workspace{
  <$workspace{
    projects:@();
    activeprojectidx:0
  }
};

f=emptyproject():$project{
  <$project{
    id:"";
    name:"";
    description:"";
    datasets:@();
    activedatasetidx:0;
    createdat:0
  }
};

f=isproject(p:$project):bool{
  <str.len(p.id)>0
};

f=newproject(name:str;desc:str):$project{
  <$project{
    id:"p-\(str.randhex(8))";
    name:name;
    description:desc;
    datasets:@();
    activedatasetidx:0;
    createdat:time.nowms()
  }
};

f=addproject(ws:$workspace;p:$project):$workspace{
  <$workspace{
    projects:ws.projects.push(p);
    activeprojectidx:ws.activeprojectidx
  }
};

f=withdatasets(p:$project;datasets:@$dataset):$project{
  <$project{
    id:p.id;
    name:p.name;
    description:p.description;
    datasets:datasets;
    activedatasetidx:p.activedatasetidx;
    createdat:p.createdat
  }
};

f=withactivedataset(p:$project;idx:i32):$project{
  <$project{
    id:p.id;
    name:p.name;
    description:p.description;
    datasets:p.datasets;
    activedatasetidx:idx;
    createdat:p.createdat
  }
};

(* There is no assignment to an array element (T-26), so replacing one project means rebuilding
   the project list around it. *)
f=replaceproject(ws:$workspace;at:i64;p:$project):$workspace{
  let out=mut.@();
  lp(let pi=0;pi<ws.projects.len;pi=pi+1){
    if(pi==at){
      out=out.push(p)
    }el{
      out=out.push(ws.projects.get(pi))
    }
  };
  <$workspace{
    projects:out;
    activeprojectidx:ws.activeprojectidx
  }
};

f=adddataset(ws:$workspace;projectidx:i32;ds:$dataset):$workspace{
  let at=projectidx as i64;
  if(at<0 || at>=ws.projects.len){
    <ws
  };
  let p:$project=ws.projects.get(at);
  <replaceproject(ws;at;withdatasets(p;p.datasets.push(ds)))
};

f=hasactiveproject(ws:$workspace):bool{
  let idx=ws.activeprojectidx as i64;
  if(ws.projects.len==0){ <false };
  if(idx<0 || idx>=ws.projects.len){ <false };
  <true
};

f=activeproject(ws:$workspace):$project{
  if(hasactiveproject(ws)){
    <ws.projects.get(ws.activeprojectidx as i64)
  };
  <emptyproject()
};

(* An out-of-range index is clamped rather than rejected, because the caller is a UI control and
   an empty workspace has no valid index to clamp to — index 0 of an empty project list is what
   `hasactiveproject` then reports as absent. *)
f=switchproject(ws:$workspace;idx:i32):$workspace{
  let n=ws.projects.len;
  let safeidx=mut.(idx as i64);
  if(safeidx<0){ safeidx=0 };
  if(safeidx>=n){ safeidx=n-1 };
  if(safeidx<0){ safeidx=0 };
  <$workspace{
    projects:ws.projects;
    activeprojectidx:safeidx as i32
  }
};

f=switchdataset(ws:$workspace;dsidx:i32):$workspace{
  if(hasactiveproject(ws)){}el{ <ws };
  let at=ws.activeprojectidx as i64;
  let p:$project=ws.projects.get(at);
  let nds=p.datasets.len;
  let safedsidx=mut.(dsidx as i64);
  if(safedsidx<0){ safedsidx=0 };
  if(safedsidx>=nds){ safedsidx=nds-1 };
  if(safedsidx<0){ safedsidx=0 };
  <replaceproject(ws;at;withactivedataset(p;safedsidx as i32))
};

f=hasactivedataset(ws:$workspace):bool{
  if(hasactiveproject(ws)){}el{ <false };
  let p:$project=ws.projects.get(ws.activeprojectidx as i64);
  let idx=p.activedatasetidx as i64;
  if(p.datasets.len==0){ <false };
  if(idx<0 || idx>=p.datasets.len){ <false };
  <true
};

(* The absent case is an empty dataset: no name, no headers, no rows. A caller that skipped
   `hasactivedataset` gets something inert rather than a dereferenced integer. *)
f=activedataset(ws:$workspace):$dataset{
  if(hasactivedataset(ws)){
    let p:$project=ws.projects.get(ws.activeprojectidx as i64);
    <p.datasets.get(p.activedatasetidx as i64)
  };
  <$dataset{
    name:"";
    headers:@();
    rows:@()
  }
};

f=combinedschema(p:$project):str{
  if(p.datasets.len==0){
    <"(no datasets in project)"
  };
  let schema=mut."";
  lp(let di=0;di<p.datasets.len;di=di+1){
    let ds:$dataset=p.datasets.get(di);
    let section=mut."## Dataset: \(ds.name)\n";
    lp(let ci=0;ci<ds.headers.len;ci=ci+1){
      section=str.concat(section;"  * \(ds.headers.get(ci))\n")
    };
    section=str.concat(section;"  rows: \(str.fromint(ds.rows.len))\n\n");
    schema=str.concat(schema;section)
  };
  <schema
};

(* First shared column name wins. Trimmed on both sides because a CSV header row commonly
   carries a leading space after the delimiter. *)
f=findjoinkey(a:$dataset;b:$dataset):str{
  lp(let ai=0;ai<a.headers.len;ai=ai+1){
    let acol=str.trim(a.headers.get(ai));
    lp(let bi=0;bi<b.headers.len;bi=bi+1){
      if(str.eq(acol;str.trim(b.headers.get(bi)))){
        <acol
      }
    }
  };
  <""
};

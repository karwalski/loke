m=moke.workspace;
i=str:std.string;
i=compute:moke.compute;



t=$project{
  id:str;
  name:str;
  description:str;
  datasets:@(compute.$dataset);
  activedatasetidx:i32;
  createdat:i64
};

t=$workspace{
  projects:@$project;
  activeprojectidx:i32
};

f=newworkspace():$workspace{
  <$workspace{
    projects=@();
    activeprojectidx=0
  };
};

f=newproject(name:str;desc:str):$project{
  <$project{
    id=str.uuid();
    name=name;
    description=desc;
    datasets=@();
    activedatasetidx=0;
    createdat=str.unixnow()
  };
};

f=addproject(ws:$workspace;p:$project):$workspace{
  updated:@$project=ws.projects;
  str.push(updated;p);
  <$workspace{
    projects=updated;
    activeprojectidx=ws.activeprojectidx
  };
};

f=adddataset(ws:$workspace;projectidx:i32;ds:compute.$dataset):$workspace{
  nprojects:i32=str.len(ws.projects);
  if(projectidx<0||projectidx>=nprojects){
    <ws
  }{};
  updatedprojects:@$project=@();
  pi:i32=0;
  if(pi<nprojects){
    p:$project=str.get(ws.projects;pi);
    if(pi==projectidx){
      newdatasets:@(compute.$dataset)=p.datasets;
      str.push(newdatasets;ds);
      updatedp:$project=$project{
        id=p.id;
        name=p.name;
        description=p.description;
        datasets=newdatasets;
        activedatasetidx=p.activedatasetidx;
        createdat=p.createdat
      };
      str.push(updatedprojects;updatedp)
    }{
      str.push(updatedprojects;p)
    };
    pi=pi+1
  }{};
  <$workspace{
    projects=updatedprojects;
    activeprojectidx=ws.activeprojectidx
  };
};

f=activeproject(ws:$workspace):($project){
  n:i32=str.len(ws.projects);
  if(n==0){ <none }{};
  idx:i32=ws.activeprojectidx;
  if(idx<0||idx>=n){ <none }{};
  <some(str.get(ws.projects;idx))
};

f=switchproject(ws:$workspace;idx:i32):$workspace{
  n:i32=str.len(ws.projects);
  safeidx:i32=idx;
  if(safeidx<0){ safeidx=0 }{};
  if(safeidx>=n){ safeidx=n-1 }{};
  <$workspace{
    projects=ws.projects;
    activeprojectidx=safeidx
  };
};

f=switchdataset(ws:$workspace;dsidx:i32):$workspace{
  nprojects:i32=str.len(ws.projects);
  if(nprojects==0){ <ws }{};
  pidx:i32=ws.activeprojectidx;
  if(pidx<0||pidx>=nprojects){ <ws }{};
  p:$project=str.get(ws.projects;pidx);
  nds:i32=str.len(p.datasets);
  safedsidx:i32=dsidx;
  if(safedsidx<0){ safedsidx=0 }{};
  if(safedsidx>=nds){ safedsidx=nds-1 }{};
  updatedp:$project=$project{
    id=p.id;
    name=p.name;
    description=p.description;
    datasets=p.datasets;
    activedatasetidx=safedsidx;
    createdat=p.createdat
  };
  updatedprojects:@$project=@();
  pi:i32=0;
  if(pi<nprojects){
    if(pi==pidx){
      str.push(updatedprojects;updatedp)
    }{
      str.push(updatedprojects;str.get(ws.projects;pi))
    };
    pi=pi+1
  }{};
  <$workspace{
    projects=updatedprojects;
    activeprojectidx=ws.activeprojectidx
  };
};

f=activedataset(ws:$workspace):(compute.$dataset){
  ap:($project)=activeproject(ws);
  if(ap==none){ <none }{};
  p:$project=unwrap(ap);
  nds:i32=str.len(p.datasets);
  if(nds==0){ <none }{};
  dsidx:i32=p.activedatasetidx;
  if(dsidx<0||dsidx>=nds){ <none }{};
  <some(str.get(p.datasets;dsidx))
};

f=combinedschema(p:$project):str{
  nds:i32=str.len(p.datasets);
  if(nds==0){
    <"(no datasets in project)"
  }{};
  schema:str="";
  di:i32=0;
  if(di<nds){
    ds:compute.$dataset=str.get(p.datasets;di);
    section:str=str.concat("## Dataset: ";ds.name);
    section=str.concat(section;"
");
    ncols:i32=str.len(ds.headers);
    ci:i32=0;
    if(ci<ncols){
      col:str=str.get(ds.headers;ci);
      line:str=str.concat("  • ";col);
      section=str.concat(section;line);
      section=str.concat(section;"
");
      ci=ci+1
    }{};
    rowcount:i32=str.len(ds.rows);
    section=str.concat(section;"  rows: ");
    section=str.concat(section;str.fromi32(rowcount));
    section=str.concat(section;"

");
    schema=str.concat(schema;section);
    di=di+1
  }{};
  <schema
};

f=findjoinkey(a:compute.$dataset;b:compute.$dataset):str{
  ai:i32=0;
  if(ai<str.len(a.headers)){
    acol:str=str.trim(str.get(a.headers;ai));
    bi:i32=0;
    if(bi<str.len(b.headers)){
      bcol:str=str.trim(str.get(b.headers;bi));
      if(str.eq(acol;bcol)){
        <acol
      }{};
      bi=bi+1
    }{};
    ai=ai+1
  }{};
  <""
};

m=moke.workspace;
i=str:std.string;
i=compute:moke.compute;



t=$project{
  id:str;
  name:str;
  description:str;
  datasets:@i64;
  activedatasetidx:i32;
  createdat:i64
};

t=$workspace{
  projects:@$project;
  activeprojectidx:i32
};

f=newworkspace():$workspace{
  <$workspace{
    projects:@();
    activeprojectidx:0
  }
};

f=newproject(name:str;desc:str):$project{
  <$project{
    id:str.uuid();
    name:name;
    description:desc;
    datasets:@();
    activedatasetidx:0;
    createdat:str.unixnow()
  }
};

f=addproject(ws:$workspace;p:$project):$workspace{
  let updated=ws.projects;
  str.push(updated;p);
  <$workspace{
    projects:updated;
    activeprojectidx:ws.activeprojectidx
  }
};

f=adddataset(ws:$workspace;projectidx:i32;ds:i64):$workspace{
  let nprojects=str.len(ws.projects);
  if(projectidx<0||projectidx>nprojects){
    <ws
  }el{};
  let updatedprojects=@();
  let pi=mut.0;
  lp(let lv=0;pi<nprojects;lv=lv){
    let p=str.get(ws.projects;pi);
    if(pi=projectidx){
      let newdatasets=p.datasets;
      str.push(newdatasets;ds);
      let updatedp=$project{
        id:p.id;
        name:p.name;
        description:p.description;
        datasets:newdatasets;
        activedatasetidx:p.activedatasetidx;
        createdat:p.createdat
      };
      str.push(updatedprojects;updatedp)
    }el{
      str.push(updatedprojects;p)
    };
    pi=pi+1
  };
  <$workspace{
    projects:updatedprojects;
    activeprojectidx:ws.activeprojectidx
  }
};

f=activeproject(ws:$workspace):$project!$none{
  let n=str.len(ws.projects);
  if(n=0){ <none }el{};
  let idx=ws.activeprojectidx;
  if(idx<0||idx>n){ <none }el{};
  <some(str.get(ws.projects;idx))
};

f=switchproject(ws:$workspace;idx:i32):$workspace{
  let n=str.len(ws.projects);
  let safeidx=mut.idx;
  if(safeidx<0){ safeidx=0 }el{};
  if(safeidx>n){ safeidx=n-1 }el{};
  <$workspace{
    projects:ws.projects;
    activeprojectidx:safeidx
  }
};

f=switchdataset(ws:$workspace;dsidx:i32):$workspace{
  let nprojects=str.len(ws.projects);
  if(nprojects=0){ <ws }el{};
  let pidx=ws.activeprojectidx;
  if(pidx<0||pidx>nprojects){ <ws }el{};
  let p=str.get(ws.projects;pidx);
  let nds=str.len(p.datasets);
  let safedsidx=mut.dsidx;
  if(safedsidx<0){ safedsidx=0 }el{};
  if(safedsidx>nds){ safedsidx=nds-1 }el{};
  let updatedp=$project{
    id:p.id;
    name:p.name;
    description:p.description;
    datasets:p.datasets;
    activedatasetidx:safedsidx;
    createdat:p.createdat
  };
  let updatedprojects=@();
  let pi=mut.0;
  lp(let lv=0;pi<nprojects;lv=lv){
    if(pi=pidx){
      str.push(updatedprojects;updatedp)
    }el{
      str.push(updatedprojects;str.get(ws.projects;pi))
    };
    pi=pi+1
  };
  <$workspace{
    projects:updatedprojects;
    activeprojectidx:ws.activeprojectidx
  }
};

f=activedataset(ws:$workspace):(i64):void{
  let ap=activeproject(ws);
  if(ap=none){ <none }el{};
  let p=unwrap(ap);
  let nds=str.len(p.datasets);
  if(nds=0){ <none }el{};
  let dsidx=p.activedatasetidx;
  if(dsidx<0||dsidx>nds){ <none }el{};
  <some(str.get(p.datasets;dsidx))
};

f=combinedschema(p:$project):str{
  let nds=str.len(p.datasets);
  if(nds=0){
    <"(no datasets in project)"
  }el{};
  let schema=mut."";
  let di=mut.0;
  lp(let lv=0;di<nds;lv=lv){
    let ds=str.get(p.datasets;di);
    let section=mut.str.concat("## Dataset: ";ds.name);
    section=str.concat(section;"
");
    let ncols=str.len(ds.headers);
    let ci=mut.0;
    lp(let lv2=0;ci<ncols;lv2=lv2){
      let col=str.get(ds.headers;ci);
      let line=str.concat("  * ";col);
      section=str.concat(section;line);
      section=str.concat(section;"
");
      ci=ci+1
    };
    let rowcount=str.len(ds.rows);
    section=str.concat(section;"  rows: ");
    section=str.concat(section;str.fromi32(rowcount));
    section=str.concat(section;"

");
    schema=str.concat(schema;section);
    di=di+1
  };
  <schema
};

f=findjoinkey(a:i64;b:i64):str{
  let ai=mut.0;
  lp(let lv=0;ai<str.len(a.headers);lv=lv){
    let acol=str.trim(str.get(a.headers;ai));
    let bi=mut.0;
    lp(let lv2=0;bi<str.len(b.headers);lv2=lv2){
      let bcol=str.trim(str.get(b.headers;bi));
      if(str.eq(acol;bcol)){
        <acol
      }el{};
      bi=bi+1
    };
    ai=ai+1
  };
  <""
};

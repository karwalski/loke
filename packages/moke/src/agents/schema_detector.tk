
m=moke.agents.schemadetector;
i=str:std.string;
i=hooks:moke.hooks;


m=$columnchange{
  column:$str;
  changetype:$str;   
  oldvalue:$str;
  newvalue:$str;
  severity:$str       
};

m=$schemadiff{
  datasetid:$str;
  timestamp:$str;
  oldrowcount:i32;
  newrowcount:i32;
  oldcolcount:i32;
  newcolcount:i32;
  changes:@$columnchange;
  hasbreakingchanges:bool;
  summary:$str
};


f=compareschemas(datasetid:$str;oldschema:i64:i64;newschema:i64:i64;timestamp:$str):$schemadiff{
  let changes=@();
  let hasbreaking=mut.false;

  let oldcols=oldschema.columns;
  let newcols=newschema.columns;

  let oi=mut.0;
  if(oi < oldcols.len()){
    let oldcol=oldcols.get(oi);
    let found=false;
    let ni=mut.0;
    if(ni < newcols.len()){
      if(str.eq(newcols.get(ni).name;oldcol.name)){ found=true };
      ni=ni + 1
    }el{};
    if(!$found){
      changes.push($columnchange{
        column:oldcol.name;
        changetype:"removed";
        oldvalue:oldcol.coltype;
        newvalue:"";
        severity:"breaking"
      });
      hasbreaking=true
    };
    oi=oi + 1
  }el{};

  let ni=0;
  if(ni < newcols.len()){
    let newcol=newcols.get(ni);
    let found=false;
    let oi2=mut.0;
    if(oi2 < oldcols.len()){
      if(str.eq(oldcols.get(oi2).name;newcol.name)){ found=true };
      oi2=oi2 + 1
    }el{};
    if(!$found){
      changes.push($columnchange{
        column:newcol.name;
        changetype:"added";
        oldvalue:"";
        newvalue:newcol.coltype;
        severity:"info"
      })
    };
    ni=ni + 1
  }el{};

  let ci=mut.0;
  if(ci < oldcols.len()){
    let oldcol=oldcols.get(ci);
    let mi=mut.0;
    if(mi < newcols.len()){
      let newcol=newcols.get(mi);
      if(str.eq(oldcol.name;newcol.name)){
        if(!str.eq(oldcol.coltype;newcol.coltype)){
          changes.push($columnchange{
            column:oldcol.name;
            changetype:"type_changed";
            oldvalue:oldcol.coltype;
            newvalue:newcol.coltype;
            severity:"warning"
          })
        };
      };
      mi=mi + 1
    }el{};
    ci=ci + 1
  }el{};

  let added=0;
  let removed=0;
  let typechanged=0;
  let si=mut.0;
  if(si < changes.len()){
    let c=changes.get(si);
    if(str.eq(c.changetype;"added")){ added=added + 1 };
    if(str.eq(c.changetype;"removed")){ removed=removed + 1 };
    if(str.eq(c.changetype;"type_changed")){ typechanged=typechanged + 1 };
    si=si + 1
  }el{};

  let summarytext=mut.str.concat(str.fromi32(changes.len());" changes: ");
  summarytext=str.concat(summarytext;str.concat(str.fromi32(added);" added, "));
  summarytext=str.concat(summarytext;str.concat(str.fromi32(removed);" removed, "));
  summarytext=str.concat(summarytext;str.concat(str.fromi32(typechanged);" type changed"));
  let rowdelta=newschema.rowcount - oldschema.rowcount;
  summarytext=str.concat(summarytext;str.concat(". Rows: ";str.concat(
    str.fromi32(oldschema.rowcount);str.concat(" -> ";str.fromi32(newschema.rowcount)))));

  <$schemadiff{
    datasetid:datasetid;
    timestamp:timestamp;
    oldrowcount:oldschema.rowcount;
    newrowcount:newschema.rowcount;
    oldcolcount:oldschema.colcount;
    newcolcount:newschema.colcount;
    changes:changes;
    hasbreakingchanges:hasbreaking;
    summary:summarytext
  };
};


f=difftojson(diff:$schemadiff):$str{
  let changeparts=@();
  let ci=0;
  if(ci < diff.changes.len()){
    let c=diff.changes.get(ci);
    let part=str.concat("{\"column\":";
      str.concat(str.jsonencode(c.column);
      str.concat(",\"change_type\":";
      str.concat(str.jsonencode(c.changetype);
      str.concat(",\"old_value\":";
      str.concat(str.jsonencode(c.oldvalue);
      str.concat(",\"new_value\":";
      str.concat(str.jsonencode(c.newvalue);
      str.concat(",\"severity\":";
      str.concat(str.jsonencode(c.severity);
      "}"))))))))));
    changeparts.push(part);
    ci=ci + 1
  }el{};
  let breakingstr="false";
  if(diff.hasbreakingchanges){ breakingstr="true" };
  <str.concat("{\"dataset_id\":";
    str.concat(str.jsonencode(diff.datasetid);
    str.concat(",\"timestamp\":";
    str.concat(str.jsonencode(diff.timestamp);
    str.concat(",\"old_row_count\":";
    str.concat(str.fromi32(diff.oldrowcount);
    str.concat(",\"new_row_count\":";
    str.concat(str.fromi32(diff.newrowcount);
    str.concat(",\"old_col_count\":";
    str.concat(str.fromi32(diff.oldcolcount);
    str.concat(",\"new_col_count\":";
    str.concat(str.fromi32(diff.newcolcount);
    str.concat(",\"has_breaking_changes\":";
    str.concat(breakingstr;
    str.concat(",\"summary\":";
    str.concat(str.jsonencode(diff.summary);
    str.concat(",\"changes\":[";
    str.concat(str.join(changeparts;",");
    "]}")))))))))))))))))))
};


f=difftodiary(diff:$schemadiff):$str{
  let header=str.concat("Schema Change Detected -- ";diff.datasetid);
  let body=mut.str.concat("
";diff.summary);
  if(diff.hasbreakingchanges){
    body=str.concat(body;"
*** BREAKING CHANGES DETECTED ***")
  };
  body=str.concat(body;"

Details:
");
  let ci=0;
  if(ci < diff.changes.len()){
    let c=diff.changes.get(ci);
    let marker="[+]";
    if(str.eq(c.changetype;"removed")){ marker="[-]" };
    if(str.eq(c.changetype;"type_changed")){ marker="[~]" };
    body=str.concat(body;str.concat(marker;" ";str.concat(c.column;
      str.concat(": ";str.concat(c.oldvalue;str.concat(" -> ";str.concat(c.newvalue;"
")))))));
    ci=ci + 1
  }el{};
  <str.concat(header;body)
};

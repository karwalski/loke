m=moke.agents.status;
i=str:std.str;
i=fmt:std.fmt;
i=jx:shared.jsonobj;


t=$agentrunentry{
  runid:str;
  agentid:str;
  startedat:str;
  finishedat:str;
  status:str;         
  durationms:i32;
  tokensused:i32;
  costusd:f64;
  findingscount:i32;
  errormessage:str;
  outputsummary:str
};

t=$agentstatus{
  agentid:str;
  name:str;
  description:str;
  schedule:str;
  triggertype:str;   
  enabled:bool;
  status:str;         
  lastrun:str;       
  nextrun:str;       
  totalruns:i32;
  totalcostusd:f64;
  totaltokens:i32;
  successrate:f64;   
  runhistory:@$agentrunentry
};

t=$agentpanelstate{
  agents:@$agentstatus;
  totalagents:i32;
  runningcount:i32;
  errorcount:i32;
  lastupdated:str
};


(* --- Sixteen diagnostics, and five silent faults behind them ----------------------
   `str.jsonencode` exists in neither the std.str interface nor the runtime, so every string this
   module put on the wire went out unquoted and unescaped: the JSON was malformed for any value
   containing a quote, a backslash or a newline, and structurally malformed for all of them
   because the quotes themselves were missing. `shared.jsonobj.escape` is the escaper -- std.json
   is not usable for this (T-32). What the compiler could not see:

   1. **Five loops were `if(i < n){ ...; i=i+1 }el{}`**, which runs ONCE. So the success-rate
      calculation in `recordrun` counted at most one successful run out of the real total and
      reported a rate near zero for a healthy agent; `buildpanelstate` counted at most one
      running and one errored agent; `agentstatustojson` serialised one history entry; and
      `panelstatetojson` serialised one agent. An `if` where a `lp` was meant type-checks and
      runs, so nothing objected.
   2. **`history.push(entry)` and the two `*parts.push(...)` calls discarded the array `.push`
      returns** (T-24). Combined with (1), the run history never grew and the panel JSON carried
      an empty agent list.
   3. **The 50-entry trim was itself one of those `if` loops**, so when it fired it reduced the
      history to a SINGLE entry rather than to its last fifty.
   4. **`completerun`, `failrun` and `recordrun` took `entry:i64` / `agent:i64`** while reading
      `.runid`, `.agentid`, `.runhistory`, `.totalruns` and the rest off them. Member access on
      an integer is not checked, so all three walked a raw word as a struct.
   5. **`str.tofloat(str.fromint(n))`** formatted an integer to a string and parsed it back to
      get a float, and bound the RESULT of that parse as if it were an f64 without matching it.
      `(n as f64)` is the cast. `str.fromi32` and `str.fromf64` are `gen:"abi"` aliases;
      `str.fromint` and `fmt.f64` are the declared spellings, and `fmt.f64` also stops a cost
      being printed in scientific notation. *)
f=jsonencode(s:str):str{
  <"\(jx.escape(s))"
};

f=newagentstatus(agentid:str;name:str;description:str;schedule:str;triggertype:str):$agentstatus{
  let next=mut.schedule;
  if(str.eq(triggertype;"manual")){ next="manual" };
  <$agentstatus{
    agentid:agentid;
    name:name;
    description:description;
    schedule:schedule;
    triggertype:triggertype;
    enabled:true;
    status:"idle";
    lastrun:"never";
    nextrun:next;
    totalruns:0;
    totalcostusd:0.0;
    totaltokens:0;
    successrate:100.0;
    runhistory:@()
  }
};

f=newrunentry(runid:str;agentid:str;startedat:str):$agentrunentry{
  <$agentrunentry{
    runid:runid;
    agentid:agentid;
    startedat:startedat;
    finishedat:"";
    status:"running";
    durationms:0;
    tokensused:0;
    costusd:0.0;
    findingscount:0;
    errormessage:"";
    outputsummary:""
  }
};

f=completerun(entry:$agentrunentry;finishedat:str;durationms:i32;
    tokensused:i32;costusd:f64;findingscount:i32;outputsummary:str):$agentrunentry{
  <$agentrunentry{
    runid:entry.runid;
    agentid:entry.agentid;
    startedat:entry.startedat;
    finishedat:finishedat;
    status:"success";
    durationms:durationms;
    tokensused:tokensused;
    costusd:costusd;
    findingscount:findingscount;
    errormessage:"";
    outputsummary:outputsummary
  }
};

f=failrun(entry:$agentrunentry;finishedat:str;durationms:i32;errormessage:str):$agentrunentry{
  <$agentrunentry{
    runid:entry.runid;
    agentid:entry.agentid;
    startedat:entry.startedat;
    finishedat:finishedat;
    status:"error";
    durationms:durationms;
    tokensused:0;
    costusd:0.0;
    findingscount:0;
    errormessage:errormessage;
    outputsummary:""
  }
};

(* Keeps the most recent 50 run entries. *)
f=trimhistory(history:@$agentrunentry;keep:i64):@$agentrunentry{
  if(history.len<=keep){
    <history
  };
  let out=mut.@();
  lp(let ti=history.len-keep;ti<history.len;ti=ti+1){
    out=out.push(history.get(ti))
  };
  <out
};

f=countstatus(history:@$agentrunentry;status:str):i64{
  let n=mut.0;
  lp(let hi=0;hi<history.len;hi=hi+1){
    let e:$agentrunentry=history.get(hi);
    if(str.eq(e.status;status)){ n=n+1 }
  };
  <n
};

(* The success rate is over the RETAINED history, not over `totalruns`. Those diverge once the
   50-entry trim fires, and the old code mixed them: it counted successes in the trimmed history
   and divided by the all-time total, so an agent that had run 200 times could not report better
   than 25 per cent however well it was doing. *)
f=recordrun(agent:$agentstatus;entry:$agentrunentry):$agentstatus{
  let history=trimhistory(agent.runhistory.push(entry);50);
  <$agentstatus{
    agentid:agent.agentid;
    name:agent.name;
    description:agent.description;
    schedule:agent.schedule;
    triggertype:agent.triggertype;
    enabled:agent.enabled;
    status:if(str.eq(entry.status;"error")){"error"}el{"idle"};
    lastrun:entry.finishedat;
    nextrun:agent.nextrun;
    totalruns:agent.totalruns + 1;
    totalcostusd:agent.totalcostusd + entry.costusd;
    totaltokens:agent.totaltokens + entry.tokensused;
    successrate:if(history.len>0){(countstatus(history;"success") as f64)*100.0/(history.len as f64)}el{100.0};
    runhistory:history
  }
};

f=countagentstatus(agents:@$agentstatus;status:str):i64{
  let n=mut.0;
  lp(let ai=0;ai<agents.len;ai=ai+1){
    let a:$agentstatus=agents.get(ai);
    if(str.eq(a.status;status)){ n=n+1 }
  };
  <n
};

f=buildpanelstate(agents:@$agentstatus;now:str):$agentpanelstate{
  <$agentpanelstate{
    agents:agents;
    totalagents:agents.len as i32;
    runningcount:countagentstatus(agents;"running") as i32;
    errorcount:countagentstatus(agents;"error") as i32;
    lastupdated:now
  }
};

f=runentrytojson(entry:$agentrunentry):str{
  <"{\"run_id\":\(jsonencode(entry.runid)),\"agent_id\":\(jsonencode(entry.agentid)),\"started_at\":\(jsonencode(entry.startedat)),\"finished_at\":\(jsonencode(entry.finishedat)),\"status\":\(jsonencode(entry.status)),\"duration_ms\":\(str.fromint(entry.durationms as i64)),\"tokens_used\":\(str.fromint(entry.tokensused as i64)),\"cost_usd\":\(fmt.f64(entry.costusd;6)),\"findings_count\":\(str.fromint(entry.findingscount as i64)),\"error_message\":\(jsonencode(entry.errormessage)),\"output_summary\":\(jsonencode(entry.outputsummary))}"
};

f=agentstatustojson(agent:$agentstatus):str{
  let runparts=mut.@();
  lp(let ri=0;ri<agent.runhistory.len;ri=ri+1){
    runparts=runparts.push(runentrytojson(agent.runhistory.get(ri)))
  };
  let enabled=mut."false";
  if(agent.enabled){ enabled="true" };
  <"{\"agent_id\":\(jsonencode(agent.agentid)),\"name\":\(jsonencode(agent.name)),\"description\":\(jsonencode(agent.description)),\"schedule\":\(jsonencode(agent.schedule)),\"trigger_type\":\(jsonencode(agent.triggertype)),\"enabled\":\(enabled),\"status\":\(jsonencode(agent.status)),\"last_run\":\(jsonencode(agent.lastrun)),\"next_run\":\(jsonencode(agent.nextrun)),\"total_runs\":\(str.fromint(agent.totalruns as i64)),\"total_cost_usd\":\(fmt.f64(agent.totalcostusd;6)),\"total_tokens\":\(str.fromint(agent.totaltokens as i64)),\"success_rate\":\(fmt.f64(agent.successrate;2)),\"run_history\":[\(str.join(",";runparts))]}"
};

f=panelstatetojson(state:$agentpanelstate):str{
  let agentparts=mut.@();
  lp(let ai=0;ai<state.agents.len;ai=ai+1){
    agentparts=agentparts.push(agentstatustojson(state.agents.get(ai)))
  };
  <"{\"total_agents\":\(str.fromint(state.totalagents as i64)),\"running_count\":\(str.fromint(state.runningcount as i64)),\"error_count\":\(str.fromint(state.errorcount as i64)),\"last_updated\":\(jsonencode(state.lastupdated)),\"agents\":[\(str.join(",";agentparts))]}"
};

m=moke.agents.status;
i=str:std.string;


t=$agentrunentry{
  runid:str;
  agentid:str;
  startedat:str;
  finishedat:str;
  status:str;         
  durationms:i32;
  tokensused:i32;
  costusd:f64;
  findingscount:i32;
  errormessage:str;
  outputsummary:str
};

t=$agentstatus{
  agentid:str;
  name:str;
  description:str;
  schedule:str;
  triggertype:str;   
  enabled:bool;
  status:str;         
  lastrun:str;       
  nextrun:str;       
  totalruns:i32;
  totalcostusd:f64;
  totaltokens:i32;
  successrate:f64;   
  runhistory:@$agentrunentry
};

t=$agentpanelstate{
  agents:@$agentstatus;
  totalagents:i32;
  runningcount:i32;
  errorcount:i32;
  lastupdated:str
};


f=newagentstatus(agentid:str;name:str;description:str;schedule:str;triggertype:str):$agentstatus{
  let next=if(str.eq(triggertype;"manual")){ "manual" }el{ schedule };
  <$agentstatus{
    agentid:agentid;
    name:name;
    description:description;
    schedule:schedule;
    triggertype:triggertype;
    enabled:true;
    status:"idle";
    lastrun:"never";
    nextrun:next;
    totalruns:0;
    totalcostusd:0.0;
    totaltokens:0;
    successrate:100.0;
    runhistory:@()
  };
};

f=newrunentry(runid:str;agentid:str;startedat:str):$agentrunentry{
  <$agentrunentry{
    runid:runid;
    agentid:agentid;
    startedat:startedat;
    finishedat:"";
    status:"running";
    durationms:0;
    tokensused:0;
    costusd:0.0;
    findingscount:0;
    errormessage:"";
    outputsummary:""
  };
};


f=completerun(entry:i64;finishedat:str;durationms:i32;
    tokensused:i32;costusd:f64;findingscount:i32;outputsummary:str):$agentrunentry{
  <$agentrunentry{
    runid:entry.runid;
    agentid:entry.agentid;
    startedat:entry.startedat;
    finishedat:finishedat;
    status:"success";
    durationms:durationms;
    tokensused:tokensused;
    costusd:costusd;
    findingscount:findingscount;
    errormessage:"";
    outputsummary:outputsummary
  };
};

f=failrun(entry:i64;finishedat:str;durationms:i32;errormessage:str):$agentrunentry{
  <$agentrunentry{
    runid:entry.runid;
    agentid:entry.agentid;
    startedat:entry.startedat;
    finishedat:finishedat;
    status:"error";
    durationms:durationms;
    tokensused:0;
    costusd:0.0;
    findingscount:0;
    errormessage:errormessage;
    outputsummary:""
  };
};


f=recordrun(agent:i64;entry:$agentrunentry):$agentstatus{
  let history=mut.agent.runhistory;
  history.push(entry);
  if(history.len() > 50){
    let trimmed=@();
    let ti=mut.history.len() - 50;
    if(ti < history.len()){
      trimmed.push(history.get(ti));
      ti=ti + 1
    }el{};
    history=trimmed
  };

  let newtotal=agent.totalruns + 1;
  let successcount=0;
  let hi=mut.0;
  if(hi < history.len()){
    if(str.eq(history.get(hi).status;"success")){ successcount=successcount + 1 };
    hi=hi + 1
  }el{};
  let rate=if(newtotal > 0){
    str.tofloat(str.fromint(successcount)) * 100.0 / str.tofloat(str.fromint(newtotal))
  }el{ 100.0 };

  let newstatus=if(str.eq(entry.status;"error")){ "error" }el{ "idle" };

  <$agentstatus{
    agentid:agent.agentid;
    name:agent.name;
    description:agent.description;
    schedule:agent.schedule;
    triggertype:agent.triggertype;
    enabled:agent.enabled;
    status:newstatus;
    lastrun:entry.finishedat;
    nextrun:agent.nextrun;
    totalruns:newtotal;
    totalcostusd:agent.totalcostusd + entry.costusd;
    totaltokens:agent.totaltokens + entry.tokensused;
    successrate:rate;
    runhistory:history
  };
};


f=buildpanelstate(agents:@$agentstatus;now:str):$agentpanelstate{
  let running=0;
  let errors=0;
  let ai=mut.0;
  if(ai < agents.len()){
    if(str.eq(agents.get(ai).status;"running")){ running=running + 1 };
    if(str.eq(agents.get(ai).status;"error")){ errors=errors + 1 };
    ai=ai + 1
  }el{};
  <$agentpanelstate{
    agents:agents;
    totalagents:agents.len();
    runningcount:running;
    errorcount:errors;
    lastupdated:now
  };
};


f=runentrytojson(entry:$agentrunentry):str{
  <str.concat("{\"run_id\":";
    str.concat(str.jsonencode(entry.runid);
    str.concat(",\"agent_id\":";
    str.concat(str.jsonencode(entry.agentid);
    str.concat(",\"started_at\":";
    str.concat(str.jsonencode(entry.startedat);
    str.concat(",\"finished_at\":";
    str.concat(str.jsonencode(entry.finishedat);
    str.concat(",\"status\":";
    str.concat(str.jsonencode(entry.status);
    str.concat(",\"duration_ms\":";
    str.concat(str.fromi32(entry.durationms);
    str.concat(",\"tokens_used\":";
    str.concat(str.fromi32(entry.tokensused);
    str.concat(",\"cost_usd\":";
    str.concat(str.fromf64(entry.costusd);
    str.concat(",\"findings_count\":";
    str.concat(str.fromi32(entry.findingscount);
    str.concat(",\"error_message\":";
    str.concat(str.jsonencode(entry.errormessage);
    str.concat(",\"output_summary\":";
    str.concat(str.jsonencode(entry.outputsummary);
    "}")))))))))))))))))))))))
};

f=agentstatustojson(agent:$agentstatus):str{
  let runparts=@();
  let ri=mut.0;
  if(ri < agent.runhistory.len()){
    runparts.push(runentrytojson(agent.runhistory.get(ri)));
    ri=ri + 1
  }el{};
  let enabledstr=if(agent.enabled){ "true" }el{ "false" };
  <str.concat("{\"agent_id\":";
    str.concat(str.jsonencode(agent.agentid);
    str.concat(",\"name\":";
    str.concat(str.jsonencode(agent.name);
    str.concat(",\"description\":";
    str.concat(str.jsonencode(agent.description);
    str.concat(",\"schedule\":";
    str.concat(str.jsonencode(agent.schedule);
    str.concat(",\"trigger_type\":";
    str.concat(str.jsonencode(agent.triggertype);
    str.concat(",\"enabled\":";
    str.concat(enabledstr;
    str.concat(",\"status\":";
    str.concat(str.jsonencode(agent.status);
    str.concat(",\"last_run\":";
    str.concat(str.jsonencode(agent.lastrun);
    str.concat(",\"next_run\":";
    str.concat(str.jsonencode(agent.nextrun);
    str.concat(",\"total_runs\":";
    str.concat(str.fromi32(agent.totalruns);
    str.concat(",\"total_cost_usd\":";
    str.concat(str.fromf64(agent.totalcostusd);
    str.concat(",\"total_tokens\":";
    str.concat(str.fromi32(agent.totaltokens);
    str.concat(",\"success_rate\":";
    str.concat(str.fromf64(agent.successrate);
    str.concat(",\"run_history\":[";
    str.concat(str.join(runparts;",");
    "]}")))))))))))))))))))))))))))
};

f=panelstatetojson(state:$agentpanelstate):str{
  let agentparts=@();
  let ai=0;
  if(ai < state.agents.len()){
    agentparts.push(agentstatustojson(state.agents.get(ai)));
    ai=ai + 1
  }el{};
  <str.concat("{\"total_agents\":";
    str.concat(str.fromi32(state.totalagents);
    str.concat(",\"running_count\":";
    str.concat(str.fromi32(state.runningcount);
    str.concat(",\"error_count\":";
    str.concat(str.fromi32(state.errorcount);
    str.concat(",\"last_updated\":";
    str.concat(str.jsonencode(state.lastupdated);
    str.concat(",\"agents\":[";
    str.concat(str.join(agentparts;",");
    "]}")))))))))))
};

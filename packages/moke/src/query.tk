m=moke.query;

i=str:std.str;
i=enc:std.encoding;

(* A query-string value from a raw request target, percent-decoded, or "" when absent.

   MK6.5 and MK6.6 each kept a copy of this beside its page (page.moke.api.agents for the diary's
   agent_id, page.moke.api.upload for the upload's name). Neither decoded: at toke 0b0bc4e the
   typed entry point of std.encoding.urldecode, tk_encoding_urldecode_w, returned its argument
   unchanged, so an upload sent as `?name=sales%20q3.csv` was named `sales%20q3.csv` (MK6.9).

   Re-measured on toke 3.1.0 (86c432da), 2026-10-01: urldecode("sales%20q3.csv") is
   "sales q3.csv", and urldecode("a+b%2Bc%C3%A9") is "a b+c" followed by e-acute, the two bytes
   C3 A9 decoded as one UTF-8 character. So '+' is a space, as a query string means it, an
   encoded '+' stays a plus, and a multi-byte character survives. The page copies are replaced
   by this one, and tests/unit/moke/test_query.tk asserts it.

   A value that does not decode (the stdlib raises for a null input) is used as sent rather
   than dropped: the caller already treats "" as absent, and a name that arrives is better
   kept than lost. The LAST occurrence of a repeated key wins, as the page copies did. *)
f=rawvalue(target:str;key:str):str{
  let qi=str.indexof(target;"?");
  if(qi < 0){ <"" }el{};
  let query=mt str.slice(target;(qi + 1) as u64;str.len(target)) {
    $ok:v v;
    $sliceerr:e ""
  };
  let pairs=str.split(query;"&");
  let prefix="\(key)=";
  let found=mut."";
  lp(let pi=0;pi < pairs.len();pi=pi + 1){
    if(str.startswith(pairs.get(pi);prefix)){ found=str.trimprefix(pairs.get(pi);prefix) }el{}
  };
  <found
};

f=value(target:str;key:str):str{
  let raw=rawvalue(target;key);
  if(str.len(raw)==0){ <"" }el{};
  <mt enc.urldecode(raw) {
    $ok:s s;
    $err:e raw
  }
};


m=moke.tokenoptimisation;
i=str:std.string;
i=json:std.json;


t=$tooncomparison{
  originaljson:str;
  toonoutput:str;
  originaltokens:i32;
  toontokens:i32;
  savingspct:f64
};

t=$llmlinguainfo{
  active:bool;
  compressionratio:f64;
  originallen:i32;
  compressedlen:i32
};

t=$cacheindicator{
  hit:bool;
  savedtokens:i32;
  savedcostusd:f64;
  similarityscore:f64
};

t=$cumulativesavings{
  totaltokenssaved:i64;
  totalcostsavedusd:f64;
  cachehits:i32;
  cachemisses:i32;
  localcomputecount:i32;
  totalrequests:i32
};

t=$tokenbudget{
  limit:i64;
  used:i64;
  remaining:i64;
  pctused:f64
};


f=estimatetokens(text:str):i32{
  let len=str.len(text);
  let tokens=len / 4;
  if(tokens < 1){ <1 as i32 };
  <tokens as i32
};


f=makecomparison(originaljson:str;toonoutput:str):$tooncomparison{
  let origtokens=estimatetokens(originaljson);
  let toontokens=estimatetokens(toonoutput);
  let savings=mut.0.0; if(origtokens > 0){
    savings=(1.0 - (toontokens as f64 / origtokens as f64)) * 100.0
  }el{};
  <$tooncomparison{
    originaljson:originaljson;
    toonoutput:toonoutput;
    originaltokens:origtokens;
    toontokens:toontokens;
    savingspct:savings
  };
};


f=makellmlinguainfo(active:bool;originallen:i32;compressedlen:i32):$llmlinguainfo{
  let ratio=mut.1.0; if(originallen > (0 as i32)){
    ratio=compressedlen as f64 / originallen as f64
  }el{};
  <$llmlinguainfo{
    active:active;
    compressionratio:ratio;
    originallen:originallen;
    compressedlen:compressedlen
  };
};


f=makecachehit(savedtokens:i32;savedcostusd:f64;similarityscore:f64):$cacheindicator{
  <$cacheindicator{
    hit:true;
    savedtokens:savedtokens;
    savedcostusd:savedcostusd;
    similarityscore:similarityscore
  };
};

f=makecachemiss():$cacheindicator{
  <$cacheindicator{
    hit:false;
    savedtokens:0;
    savedcostusd:0.0;
    similarityscore:0.0
  };
};


f=newsavings():$cumulativesavings{
  <$cumulativesavings{
    totaltokenssaved:0;
    totalcostsavedusd:0.0;
    cachehits:0;
    cachemisses:0;
    localcomputecount:0;
    totalrequests:0
  };
};

f=addrequest(s:$cumulativesavings;tokenssaved:i32;costsaved:f64;cachehit:bool;localcompute:bool):$cumulativesavings{
  let newhits=mut.s.cachehits; if(cachehit){ newhits=s.cachehits + (1 as i32) }el{};
  let newmisses=mut.s.cachemisses; if(cachehit){}el{ newmisses=s.cachemisses + (1 as i32) };
  let newlocal=mut.s.localcomputecount; if(localcompute){ newlocal=s.localcomputecount + (1 as i32) }el{};
  <$cumulativesavings{
    totaltokenssaved:s.totaltokenssaved + tokenssaved as i64;
    totalcostsavedusd:s.totalcostsavedusd + costsaved;
    cachehits:newhits;
    cachemisses:newmisses;
    localcomputecount:newlocal;
    totalrequests:s.totalrequests + (1 as i32)
  };
};

f=cachehitrate(s:$cumulativesavings):f64{
  let total=s.cachehits + s.cachemisses;
  if(total = 0){ <0.0 };
  <(s.cachehits as f64 / total as f64) * 100.0
};

f=localcomputeratio(s:$cumulativesavings):f64{
  if(s.totalrequests = (0 as i32)){ <0.0 };
  <(s.localcomputecount as f64 / s.totalrequests as f64) * 100.0
};


f=newbudget(limit:i64):$tokenbudget{
  <$tokenbudget{
    limit:limit;
    used:0;
    remaining:limit;
    pctused:0.0
  };
};

f=usetokens(b:$tokenbudget;tokens:i64):$tokenbudget{
  let newused=b.used + tokens;
  let newremaining=mut.b.limit - newused;
  if(newremaining < 0){ newremaining=0 };
  let pct=mut.100.0; if(b.limit > 0){
    pct=(newused as f64 / b.limit as f64) * 100.0
  }el{};
  <$tokenbudget{
    limit:b.limit;
    used:newused;
    remaining:newremaining;
    pctused:pct
  };
};

f=budgetexceeded(b:$tokenbudget):bool{
  <b.used > b.limit
};


f=formatsavings(s:$cumulativesavings):str{
  str.concat(
    str.concat(
      str.concat(
        str.concat("Tokens saved: ";str.fromint64(s.totaltokenssaved));
        str.concat(" | Cost saved: $";str.fromfloat(s.totalcostsavedusd)));
      str.concat(" | Cache rate: ";str.concat(str.fromfloat(cachehitrate(s));"%")));
    str.concat(" | Local ratio: ";str.concat(str.fromfloat(localcomputeratio(s));"%")))
};

f=formatbudget(b:$tokenbudget):str{
  str.concat(
    str.concat(
      str.concat("Budget: ";str.fromint64(b.used));
      str.concat(" / ";str.fromint64(b.limit)));
    str.concat(" tokens (";str.concat(str.fromfloat(b.pctused);"%)")))
};

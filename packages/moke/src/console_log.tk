m=moke.consolelog;
i=str:std.str;
i=time:std.time;
i=jx:shared.jsonobj;

(* ── Strings do not concatenate with `+` ───────────────────────────────────────────
   Every line of the two formatters here built its output with `a + b`, which is arithmetic:
   23 of this file's 26 diagnostics were E4031 on that operator. Interpolation is the form
   that works and is what the rest of the tree uses. Three further faults were hiding behind
   those, none of which the compiler reports:

     - `log.entries.pushcopy(entry)` in `append`. There is no `pushcopy` method, and an unknown
       method call is not type-checked at all (T-7). Measured in the emitted IR it lowers to a
       call to a BARE GLOBAL named after the method with the RECEIVER DROPPED --
       `declare i64 @pushcopy(i64)` -- so `append` had no implementation behind it and the module
       could not link. The append that works is `entries.push(entry)`, and the result must be
       used: a bare `arr.push(x)` lowers to `tk_array_append_w`, which allocates a fresh array and
       leaves the original alone, while `x = x.push(e)` lowers to `tk_array_append_inplace_w`.
     - `lines.push(...)` and `parts.push(obj)` discarded their result (T-24) on top of that,
       and `let lines=@()` was not `mut.`, so neither formatter could have accumulated a line
       even if `append` had worked.
     - `str.jsonescape` does not exist. It resolved to nothing in `tojson`, which means an
       unescaped quote or backslash in a stage detail would have produced invalid JSON on the
       wire. `shared.jsonobj.escape` is the real one, and `std.json` is not usable here
       anyway (T-32). *)

t=$logstage{
  $schemaextract:i64;
  $profile:i64;
  $sensitivity:i64;
  $anonymise:i64;
  $querydispatch:i64;
  $localcompute:i64;
  $llmcall:i64;
  $response:i64;
  $restore:i64
};

(* DA1.4 - the typed disclosure fields of docs/specifications/disclosure-accounting.md §6.2 S1.

   `detail` is prose for a person, and nothing could compute on it. These fields sit beside it
   and are emitted by `tojson` as JSON numbers, booleans and null, never as strings (S3).

   toke has no null, so "not known at this stage" is a sentinel that `tojson` renders as
   `null` (S5): -1 for a count, "" for a string, and -1 for the one tri-state flag, where 0 is
   false and 1 is true. The distinction matters. A zero means "measured as none" and a null
   means "not measured", and if the two were conflated a missing measurement would read as a
   favourable one. `nodisclosure()` is all-null, and every plain `append` uses it. A stage sets
   only what it actually measured. *)
t=$disclosure{
  custody:str;
  bytesbody:i64;
  bytesschemaprofile:i64;
  tokensestimated:i64;
  tokeniserid:str;
  fieldsdisclosedcount:i64;
  entitiestotal:i64;
  realvaluesincluded:i64;
  resultsreturnedcells:i64;
  artifactverdict:str
};

t=$logentry{
  stage:str;
  status:str;
  detail:str;
  durationms:i32;
  ts:i64;
  disclosure:$disclosure
};

t=$sessionlog{
  entries:@$logentry;
  requestid:str
};

f=nodisclosure():$disclosure{
  <$disclosure{
    custody:"";
    bytesbody:0-1;
    bytesschemaprofile:0-1;
    tokensestimated:0-1;
    tokeniserid:"";
    fieldsdisclosedcount:0-1;
    entitiestotal:0-1;
    realvaluesincluded:0-1;
    resultsreturnedcells:0-1;
    artifactverdict:""
  }
};

(* Two helpers for the fields a stage in this tree can measure today. The others need
   no-custody (NC1) or disclosure_log (DA1.7) to exist. *)
f=withfieldcount(d:$disclosure;n:i64):$disclosure{
  <$disclosure{
    custody:d.custody;
    bytesbody:d.bytesbody;
    bytesschemaprofile:d.bytesschemaprofile;
    tokensestimated:d.tokensestimated;
    tokeniserid:d.tokeniserid;
    fieldsdisclosedcount:n;
    entitiestotal:d.entitiestotal;
    realvaluesincluded:d.realvaluesincluded;
    resultsreturnedcells:d.resultsreturnedcells;
    artifactverdict:d.artifactverdict
  }
};

f=withentities(d:$disclosure;n:i64):$disclosure{
  <$disclosure{
    custody:d.custody;
    bytesbody:d.bytesbody;
    bytesschemaprofile:d.bytesschemaprofile;
    tokensestimated:d.tokensestimated;
    tokeniserid:d.tokeniserid;
    fieldsdisclosedcount:d.fieldsdisclosedcount;
    entitiestotal:n;
    realvaluesincluded:d.realvaluesincluded;
    resultsreturnedcells:d.resultsreturnedcells;
    artifactverdict:d.artifactverdict
  }
};

f=newsession(requestid:str):$sessionlog{
  <$sessionlog{
    entries:@();
    requestid:requestid
  }
};

f=append(log:$sessionlog;stage:str;status:str;detail:str;durationms:i32):$sessionlog{
  <appendwith(log;stage;status;detail;durationms;nodisclosure())
};

f=appendwith(log:$sessionlog;stage:str;status:str;detail:str;durationms:i32;d:$disclosure):$sessionlog{
  let entry=$logentry{
    stage:stage;
    status:status;
    detail:detail;
    durationms:durationms;
    ts:time.nowms();
    disclosure:d
  };
  <$sessionlog{
    entries:log.entries.push(entry);
    requestid:log.requestid
  }
};

f=stagename(stage:str):str{
  if(stage == "schema_extract"){ <"Schema Extract" };
  if(stage == "profile"){ <"Data Profile" };
  if(stage == "sensitivity"){ <"Sensitivity Classification" };
  if(stage == "anonymise"){ <"Anonymisation" };
  if(stage == "query_dispatch"){ <"Query Dispatch" };
  if(stage == "local_compute"){ <"Local Compute" };
  if(stage == "optimise"){ <"Token Optimisation" };
  if(stage == "llm_call"){ <"LLM Call" };
  if(stage == "response"){ <"Response" };
  if(stage == "restore"){ <"Entity Restore" };
  <stage
};

(* `str.padleft` is one of the `gen:"abi"` entries in stdlib/str.tki, declared
   (i64,i64,i64) -> i64, so nothing checks its third argument. Its runtime wrapper is
   `char ch = (char)(pad ? pad : ' ')`: the pad is a CHARACTER CODE, and the `"0"` passed here
   is a pointer, so the pad character was the low byte of a heap address. Two digits of a clock
   do not need it. *)
f=pad2(n:i64):str{
  let s=str.fromint(n);
  if(str.len(s)<2){
    <"0\(s)"
  };
  <s
};

f=statustag(status:str):str{
  if(status == "ok"){ <"OK" };
  if(status == "skip"){ <"--" };
  if(status == "error"){ <"ERROR" };
  <status
};

f=formatentry(entry:$logentry):str{
  let secs=entry.ts / 1000;
  let clock="\(pad2((secs / 3600) % 24)):\(pad2((secs / 60) % 60)):\(pad2(secs % 60))";
  <"[\(clock)] \(statustag(entry.status)) \(stagename(entry.stage)) -- \(entry.detail) (\(str.fromint(entry.durationms as i64))ms)"
};

f=formatlog(log:$sessionlog):str{
  let lines=mut.@();
  lp(let ii=0;ii<log.entries.len;ii=ii+1){
    let e:$logentry=log.entries.get(ii);
    lines=lines.push(formatentry(e))
  };
  <str.join("\n";lines)
};

f=jsonint(n:i64):str{
  if(n<0){ <"null" }el{};
  let s:str=str.fromint(n);
  <s
};

f=jsonstrornull(s:str):str{
  if(str.len(s)==0){ <"null" }el{};
  <jx.escape(s)
};

f=jsontri(n:i64):str{
  if(n<0){ <"null" }el{};
  if(n==0){ <"false" }el{};
  <"true"
};

f=disclosurejson(d:$disclosure):str{
  let parts=@(
    str.concat("\"custody\":";jsonstrornull(d.custody));
    str.concat("\"bytes_body\":";jsonint(d.bytesbody));
    str.concat("\"bytes_schema_profile\":";jsonint(d.bytesschemaprofile));
    str.concat("\"tokens_estimated\":";jsonint(d.tokensestimated));
    str.concat("\"tokeniser_id\":";jsonstrornull(d.tokeniserid));
    str.concat("\"fields_disclosed_count\":";jsonint(d.fieldsdisclosedcount));
    str.concat("\"entities_total\":";jsonint(d.entitiestotal));
    str.concat("\"real_values_included\":";jsontri(d.realvaluesincluded));
    str.concat("\"results_returned_cells\":";jsonint(d.resultsreturnedcells));
    str.concat("\"artifact_verdict\":";jsonstrornull(d.artifactverdict))
  );
  <str.concat("{";str.concat(str.join(",";parts);"}"))
};

(* shared.jsonobj.escape returns the string WITH its surrounding quotes. This function used to
   wrap it in a second pair, so every stage, status and detail went on the wire as
   `"stage":""schema_extract""`: invalid JSON in every pipeline response that carried a
   console log. Found by DA1.4's test and filed as DA1.8. *)
f=tojson(log:$sessionlog):str{
  let parts=mut.@();
  lp(let ii=0;ii<log.entries.len;ii=ii+1){
    let e:$logentry=log.entries.get(ii);
    parts=parts.push("{\"stage\":\(jx.escape(e.stage)),\"status\":\(jx.escape(e.status)),\"detail\":\(jx.escape(e.detail)),\"duration_ms\":\(str.fromint(e.durationms as i64)),\"ts\":\(str.fromint(e.ts)),\"disclosure\":\(disclosurejson(e.disclosure))}")
  };
  <"[\(str.join(",";parts))]"
};

m=moke.consolelog;
i=str:std.string;

t=$logstage{
  $schemaextract:i64;
  $profile:i64;
  $sensitivity:i64;
  $anonymise:i64;
  $querydispatch:i64;
  $localcompute:i64;
  $llmcall:i64;
  $response:i64;
  $restore
};

t=$logentry{
  stage:str;
  status:str;
  detail:str;
  durationms:i32;
  ts:i64
};

t=$sessionlog{
  entries:@$logentry;
  requestid:str
};

f=newsession(requestid:str):$sessionlog{
  <$sessionlog{
    entries=@();
    requestid=requestid
  };
};

f=append(log:$sessionlog;stage:str;status:str;detail:str;durationms:i32):$sessionlog{
  let entry=$logentry{
    stage=stage;
    status=status;
    detail=detail;
    durationms=durationms;
    ts=std.nowms()
  };
  let updatedentries=log.entries.pushcopy(entry);
  <$sessionlog{
    entries=updatedentries;
    requestid=log.requestid
  };
};

f=stagename(stage:str):str{
  if(stage = "schema_extract"){ <"Schema Extract" };
  if(stage = "profile"){ <"Data Profile" };
  if(stage = "sensitivity"){ <"Sensitivity Classification" };
  if(stage = "anonymise"){ <"Anonymisation" };
  if(stage = "query_dispatch"){ <"Query Dispatch" };
  if(stage = "local_compute"){ <"Local Compute" };
  if(stage = "llm_call"){ <"LLM Call" };
  if(stage = "response"){ <"Response" };
  if(stage = "restore"){ <"Entity Restore" };
  <stage
};

f=formatentry(entry:$logentry):str{
  let secs=entry.ts / 1000;
  let hh=str.padleft(str.fromint((secs / 3600) % 24); 2; "0");
  let mm=str.padleft(str.fromint((secs / 60) % 60); 2; "0");
  let ss=str.padleft(str.fromint(secs % 60); 2; "0");
  let timestr="[" + hh + ":" + mm + ":" + ss + "]";
  let label=stagename(entry.stage);
  let dur=" (" + str.fromint(entry.durationms) + "ms)";
  let statustag=if entry.status = "ok"   { " OK"
  }el if(entry.status = "skip"){ " --"
  }el if(entry.status = "error"){ " ERROR"
  }el                                   { " " + entry.status };
  <timestr + statustag + " " + label + " — " + entry.detail + dur
};

f=formatlog(log:$sessionlog):str{
  let lines=log.entries.map(e{ <formatentry(e) });
  <str.join(lines; "
")
};

f=tojson(log:$sessionlog):str{
  let parts=@();
  log.entries.each(e{
    let obj="{";
    obj=obj + "\"stage\":\"" + str.jsonescape(e.stage) + "\",";
    obj=obj + "\"status\":\"" + str.jsonescape(e.status) + "\",";
    obj=obj + "\"detail\":\"" + str.jsonescape(e.detail) + "\",";
    obj=obj + "\"duration_ms\":" + str.fromint(e.durationms) + ",";
    obj=obj + "\"ts\":" + str.fromint64(e.ts);
    obj=obj + "}";
    parts.push(obj);
  });
  <"[" + str.join(parts; ",") + "]"
};

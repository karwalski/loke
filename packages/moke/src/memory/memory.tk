m=moke.memory;
i=str:std.str;
i=time:std.time;

(* `time.nowms`, not `std.nowms` through a bare `i=std:std;` import: toke mangled that call to
   `_tk_std_nowms_w`, which no module defines, so moke did not link (F10.34). *)

t=$drawer{
  id:str;
  wing:str;
  hall:str;
  room:str;
  content:str;
  source:str;
  createdat:str
};

t=$searchresult{
  drawerid:str;
  wing:str;
  hall:str;
  room:str;
  contentexcerpt:str;
  relevancescore:f64;
  source:str;
  createdat:str
};

t=$palacestatus{
  totaldrawers:u32;
  totalwings:u32;
  totalhalls:u32;
  totalrooms:u32;
  storagebytes:u32
};

t=$aaakcontext{
  compressed:str;
  expanded:str;
  compressionratio:f64;
  sourcelen:u32;
  aaaklen:u32
};

f=gendrawerid():str{
  <str.concat("drw_";str.fromint(time.nowms()))
};

f=newdrawer(wing:str;hall:str;room:str;content:str;source:str):$drawer{
  <$drawer{
    id:gendrawerid();
    wing:wing;
    hall:hall;
    room:room;
    content:content;
    source:source;
    createdat:str.fromint(time.nowms())
  };
};

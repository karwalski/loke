
m=moke.memory;
i=str:std.string;

t=$drawer{
  id:$str;
  wing:$str;
  hall:$str;
  room:$str;
  content:$str;
  source:$str;
  createdat:$str
};

t=$searchresult{
  drawerid:$str;
  wing:$str;
  hall:$str;
  room:$str;
  contentexcerpt:$str;
  relevancescore:f64;
  source:$str;
  createdat:$str
};

t=$palacestatus{
  totaldrawers:u32;
  totalwings:u32;
  totalhalls:u32;
  totalrooms:u32;
  storagebytes:u32
};

t=$aaakcontext{
  compressed:$str;
  expanded:$str;
  compressionratio:f64;
  sourcelen:u32;
  aaaklen:u32
};

f=gendrawerid():$str{
  <str.concat("drw_";str.fromi64(std.nowms()))
};

f=newdrawer(wing:$str;hall:$str;room:$str;content:$str;source:$str):$drawer{
  <$drawer{
    id:$gendrawerid();
    wing:$wing;
    hall:$hall;
    room:$room;
    content:$content;
    source:$source;
    createdat:$str.fromi64(std.nowms())
  };
};

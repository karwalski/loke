m=moke.hooks;
i=str:std.str;
i=t:shared.types;
i=log:std.log;
i=math:std.math;
i=fmt:std.fmt;

(* --- Two whole classes of fault, and a missing upstream entry point --------------
   Diagnostics: `str.pushcopy` (three sites) and `str.count` (three sites) exist in neither
   the std.str interface nor the runtime, `str.isnumeric` and `str.parsef32` likewise, and
   `core.extensions.pipelinehooks` has no `dispatch` or `dispatchrule`. Behind them:

   `str.len` is `strlen()` on a `char *`, and it was applied to an ARRAY as the bound of every
   loop in this file. It walks the element buffer to its first zero byte, so `str.len(headers)`
   returned about 3 for any header row and `extractschema` profiled the first three columns of
   every dataset regardless of width. `str.push` allocates and returns a new array and its
   result was discarded at all seven sites, so `columns`, `values`, `uniqueset` and
   `samplevals` were all permanently empty -- which means every column came back as
   `unknown` with zero nulls, zero uniques and no samples, and the TOON profile this module
   exists to produce was a header line and nothing else.

   `core.extensions.pipelinehooks` exports `newregistry`/`register`/`hooksfor`/`applytext`
   over its own `hookregistry` and `hookfn` types. It has no way to invoke a hook by key, which
   is the model moke.hooks' own `$mokepipelineregistry` uses and which pages/ and
   moke.agents.schemadetector consume. Rather than reshape an exported type, the two hooks this
   module defines are resolved here by key. That keeps the registry honest about what it can
   actually run: a key with no hook behind it is a no-op, not a silent pass-through of an
   unrelated hook's result. *)

t=$coltype{ $numeric:i64; $categorical:i64; $datetime:i64; $boolean:i64; $text:i64; $unknown:i64};

t=$colprofile{
  name:str;
  coltype:str;
  nullcount:i32;
  uniquecount:i32;
  samplevalues:@str;
  minval:str;
  maxval:str;
  meanval:str
};

t=$schemaprofile{
  datasetname:str;
  rowcount:i32;
  colcount:i32;
  columns:@$colprofile
};

t=$hookresult{
  transformed:str;
  profile:$schemaprofile;
  rawdatadetected:bool
};

t=$pipelinestate{
  original:str;
  anonymised:str;
  schemaprofile:str;
  entitycount:i32;
  sensitivity:str;
  datasetname:str;
  isschemafirst:bool
};

t=$pipelinehookresult{
  state:$pipelinestate;
  modified:bool
};

t=$pipelinehookentry{
  id:str;
  hookkey:str;
  slot:str
};

t=$mokepipelineregistry{
  entries:@$pipelinehookentry
};

t=$evalcontext{
  requestid:str;
  usecaseid:str;
  text:str;
  modelid:str;
  sensitivity:str;
  estimatedcost:f32
};

t=$rulehookresult{
  blocked:bool;
  reason:str;
  hookid:str
};

t=$rulehookentry{
  id:str;
  hookkey:str
};

t=$mokeruleregistry{
  entries:@$rulehookentry
};

(* ── Constructors ───────────────────────────────────────────────────────────────
   MK21.15 — `$mokeruleregistry` was `$rulehookregistry` until 2026-09-24, the same name as
   `core.extensions.gatewayhooks`' type with different fields, and `moke/extensions/core.tk`
   imports both. A `$rulehookregistry{ entries:@() }` literal written there resolved to the
   CORE type and failed `E4025 struct 'rulehookregistry' has no field 'entries'` — measured
   when the registries were first threaded. `$mokepipelineregistry` (was
   `$pipelinehookregistry`) did not collide and was renamed with it so the three moke
   registries read alike. These constructors predate the rename and stay because callers use
   them. *)
f=newpipelineregistry():$mokepipelineregistry{
  <$mokepipelineregistry{ entries:@() }
};

f=newruleregistry():$mokeruleregistry{
  <$mokeruleregistry{ entries:@() }
};

f=registerbeforeanonymise(id:str;hookkey:str;registry:$mokepipelineregistry):$mokepipelineregistry{
  let entry=$pipelinehookentry{
    id:id;
    hookkey:hookkey;
    slot:"before_anonymise"
  };
  let updated=registry.entries.push(entry);
  <$mokepipelineregistry{ entries:updated }
};

f=registerafteranonymise(id:str;hookkey:str;registry:$mokepipelineregistry):$mokepipelineregistry{
  let entry=$pipelinehookentry{
    id:id;
    hookkey:hookkey;
    slot:"after_anonymise"
  };
  let updated=registry.entries.push(entry);
  <$mokepipelineregistry{ entries:updated }
};

(* A hook key with nothing behind it leaves the state alone and reports `modified:false`, so a
   registry entry for a hook this build does not carry cannot be mistaken for one that ran. *)
f=dispatch(hookkey:str;state:$pipelinestate):$pipelinehookresult{
  if(str.eq(hookkey;"moke.schema_first")){
    <schemafirsthook(state)
  };
  <$pipelinehookresult{
    state:state;
    modified:false
  }
};

f=runhooks(slot:str;state:$pipelinestate;beforeregistry:$mokepipelineregistry;afterregistry:$mokepipelineregistry):$pipelinestate{
  let registry=mut.beforeregistry;
  if(str.eq(slot;"after_anonymise")){
    registry=afterregistry
  };
  let current=mut.state;
  lp(let idx=0;idx<registry.entries.len;idx=idx+1){
    let entry:$pipelinehookentry=registry.entries.get(idx);
    let result=dispatch(entry.hookkey;current);
    if(result.modified){
      current=result.state
    }
  };
  <current
};

f=schemafirsthook(state:$pipelinestate):$pipelinehookresult{
  if(str.len(state.schemaprofile)==0){
    <$pipelinehookresult{
      state:state;
      modified:false
    }
  };
  let newtext="Dataset: \(state.datasetname) Schema: \(state.schemaprofile)\n\n\(state.original)";
  let newstate=$pipelinestate{
    original:newtext;
    anonymised:state.anonymised;
    schemaprofile:state.schemaprofile;
    entitycount:state.entitycount;
    sensitivity:state.sensitivity;
    datasetname:state.datasetname;
    isschemafirst:true
  };
  <$pipelinehookresult{
    state:newstate;
    modified:true
  }
};

f=registerrulehook(id:str;hookkey:str;registry:$mokeruleregistry):$mokeruleregistry{
  let entry=$rulehookentry{
    id:id;
    hookkey:hookkey
  };
  let updated=registry.entries.push(entry);
  <$mokeruleregistry{ entries:updated }
};

f=dispatchrule(hookkey:str;ctx:$evalcontext):$rulehookresult{
  if(str.eq(hookkey;"moke.raw_data_guard")){
    <rawdataguardhook(ctx)
  };
  <$rulehookresult{
    blocked:false;
    reason:"";
    hookid:hookkey
  }
};

f=evaluaterules(ctx:$evalcontext;registry:$mokeruleregistry):$rulehookresult{
  lp(let idx=0;idx<registry.entries.len;idx=idx+1){
    let entry:$rulehookentry=registry.entries.get(idx);
    let result=dispatchrule(entry.hookkey;ctx);
    if(result.blocked){
      <result
    }
  };
  <$rulehookresult{
    blocked:false;
    reason:"";
    hookid:""
  }
};

(* `str.count` does not exist. Splitting on the needle and taking one off the part count is
   the occurrence count, and it is exact: n occurrences of a separator always yield n+1 parts. *)
f=occurrences(s:str;needle:str):i64{
  <str.split(s;needle).len-1
};

f=rawdataguardhook(ctx:$evalcontext):$rulehookresult{
  let lines=str.split(ctx.text;"\n");
  let heavylines=mut.0;
  lp(let idx=0;idx<lines.len;idx=idx+1){
    let line=lines.get(idx);
    if(occurrences(line;";")>5 || occurrences(line;",")>5){
      heavylines=heavylines+1
    }
  };
  if(heavylines>3){
    <$rulehookresult{
      blocked:true;
      reason:"Raw tabular data detected -- use schema-first protocol";
      hookid:"moke.raw_data_guard"
    }
  };
  <$rulehookresult{
    blocked:false;
    reason:"";
    hookid:"moke.raw_data_guard"
  }
};

(* The pipe-table scan used to be gated on `str.contains(text;"|\n")`, a pipe immediately
   before a newline. A markdown table's rows end `| ` or `|` with trailing space far more often
   than not, so the gate was usually false and `pipelines` stayed 0. Both counts are taken in
   one pass over the lines instead. *)
f=detectrawdata(text:str):bool{
  let lines=str.split(text;"\n");
  let pipelines=mut.0;
  let csvlines=mut.0;
  lp(let idx=0;idx<lines.len;idx=idx+1){
    let line=lines.get(idx);
    if(str.contains(line;"|")){
      pipelines=pipelines+1
    };
    if(occurrences(line;",")>3){
      csvlines=csvlines+1
    }
  };
  if(pipelines>5){
    <true
  };
  if(csvlines>5){
    <true
  };
  <false
};

(* ── Column profiling ─────────────────────────────────────────────────────────────
   `str.isnumeric` and `str.parsef32` do not exist. `str.tofloat` is a result, which makes the
   two one call: a cell that parses is numeric, and the parse gives the value. That is also
   stricter than the old pair would have been, because `str.parsef32` would have returned 0.0
   for a cell that is not a number and the sum would have counted it.

   The min, max and mean are f64 here and leave as strings in `$colprofile`, so T-20 does not
   apply. `str.fromf32` was an alias for the f64 formatter being handed an f32, which would have
   printed the wrong number even once the arrays held anything. *)
(* Four decimal places, the same contract moke.profiler.numericstats prints. Formatting is
   local because shared.types does not import std.fmt. *)
f=microstr(n:i64):str{
  <fmt.f64(t.micro2f64(n);4)
};

f=cellvalue(cell:str):f64{
  <mt str.tofloat(str.trim(cell)) {
    $ok:v v;
    $parseerr:e 0.0
  }
};

f=cellisnumeric(cell:str):bool{
  let t=str.trim(cell);
  if(str.len(t)==0){
    <false
  };
  <mt str.tofloat(t) {
    $ok:v true;
    $parseerr:e false
  }
};

f=containsval(arr:@str;v:str):bool{
  lp(let i=0;i<arr.len;i=i+1){
    if(str.eq(arr.get(i);v)){
      <true
    }
  };
  <false
};

f=isbooleanish(v:str):bool{
  let l=str.lower(v);
  if(str.eq(l;"yes")){ <true };
  if(str.eq(l;"no")){ <true };
  if(str.eq(l;"true")){ <true };
  if(str.eq(l;"false")){ <true };
  if(str.eq(l;"1")){ <true };
  if(str.eq(l;"0")){ <true };
  <false
};

(* Column cells for one column index, over at most `samplelimit` data rows. A short row yields
   an empty cell rather than an out-of-range read. *)
f=columncells(lines:@str;colidx:i64;samplelimit:i64):@str{
  let values=mut.@();
  lp(let rowidx=1;rowidx<=samplelimit;rowidx=rowidx+1){
    let cells=str.split(lines.get(rowidx);",");
    if(colidx<cells.len){
      values=values.push(str.trim(cells.get(colidx)))
    }el{
      values=values.push("")
    }
  };
  <values
};

f=inferredtype(nonnull:i64;numericcount:i64;boolcount:i64;datecount:i64;uniquecount:i64):str{
  if(nonnull==0){ <"unknown" };
  if(numericcount==nonnull){ <"numeric" };
  if(boolcount==nonnull){ <"boolean" };
  if(datecount>nonnull/2){ <"datetime" };
  if(uniquecount<20){ <"categorical" };
  <"text"
};

f=profilecolumn(colname:str;values:@str):$colprofile{
  let nullcount=mut.0;
  let uniqueset=mut.@();
  let samplevals=mut.@();
  let numericcount=mut.0;
  let boolcount=mut.0;
  let datecount=mut.0;
  let nums=mut.@();
  lp(let vidx=0;vidx<values.len;vidx=vidx+1){
    let v=values.get(vidx);
    if(str.len(v)==0){
      nullcount=nullcount+1
    }el{
      if(containsval(uniqueset;v)){}el{
        uniqueset=uniqueset.push(v)
      };
      if(samplevals.len<3){
        samplevals=samplevals.push(v)
      };
      if(cellisnumeric(v)){
        numericcount=numericcount+1;
        (* Micro-units, not f64: an `@f64` accumulator does not assemble (T-37 — toke applies
           the scalar f64 conversion to the array handle). Integer summation is also more
           accurate for the mean than accumulating over f64. *)
        nums=nums.push(t.f64micro(cellvalue(v)))
      };
      if(isbooleanish(v)){
        boolcount=boolcount+1
      };
      (* A hyphen and eight or more characters is the ISO-8601-shaped test this demo uses; it is
         deliberately loose because the demo datasets carry several date formats. *)
      if(str.contains(v;"-") && str.len(v)>8){
        datecount=datecount+1
      }
    }
  };
  let nonnull=values.len-nullcount;
  let coltype=inferredtype(nonnull;numericcount;boolcount;datecount;uniqueset.len);
  let minout=mut."";
  let maxout=mut."";
  let meanout=mut."";
  if(str.eq(coltype;"numeric") && nums.len>0){
    minout=microstr(t.i64min(nums));
    maxout=microstr(t.i64max(nums));
    meanout=microstr(t.i64mean(nums))
  };
  <$colprofile{
    name:colname;
    coltype:coltype;
    nullcount:nullcount as i32;
    uniquecount:uniqueset.len as i32;
    samplevalues:samplevals;
    minval:minout;
    maxval:maxout;
    meanval:meanout
  }
};

f=extractschema(csvtext:str;datasetname:str):$schemaprofile{
  let lines=str.split(csvtext;"\n");
  let headers=str.split(lines.get(0);",");
  let rowcount=lines.len-1;
  let samplelimit=mut.100;
  if(samplelimit>rowcount){ samplelimit=rowcount };
  let columns=mut.@();
  lp(let colidx=0;colidx<headers.len;colidx=colidx+1){
    let colname=str.trim(headers.get(colidx));
    columns=columns.push(profilecolumn(colname;columncells(lines;colidx;samplelimit)))
  };
  <$schemaprofile{
    datasetname:datasetname;
    rowcount:rowcount as i32;
    colcount:headers.len as i32;
    columns:columns
  }
};

f=coltoon(col:$colprofile):str{
  <"\(col.name)(\(col.coltype),nulls=\(str.fromint(col.nullcount as i64)),unique=\(str.fromint(col.uniquecount as i64)),sample=[\(str.join(";";col.samplevalues))])"
};

f=profiletotoon(profile:$schemaprofile):str{
  let colparts=mut.@();
  let statparts=mut.@();
  lp(let idx=0;idx<profile.columns.len;idx=idx+1){
    let col:$colprofile=profile.columns.get(idx);
    colparts=colparts.push(coltoon(col));
    if(str.eq(col.coltype;"numeric")){
      statparts=statparts.push("\(col.name)=\(col.minval)/\(col.maxval)/\(col.meanval)")
    }
  };
  let stats=mut."(none)";
  if(statparts.len>0){ stats=str.join(" ";statparts) };
  <"DATASET: \(profile.datasetname) | ROWS: \(str.fromint(profile.rowcount as i64)) | COLS: \(str.fromint(profile.colcount as i64))\nCOLS: \(str.join(" ";colparts))\nSTATS: \(stats)"
};

f=applyschemafirst(text:str;datasetname:str):$hookresult{
  let israw=detectrawdata(text);
  if(israw){
    log.info("moke.hooks: raw data detected, extracting schema";@());
    let profile=extractschema(text;datasetname);
    let toon=profiletotoon(profile);
    let notice="[moke: raw data replaced by schema profile]
";
    let transformed=str.concat(notice;toon);
    <$hookresult{
      transformed:transformed;
      profile:profile;
      rawdatadetected:true
    }
  }el{
    let emptyprofile=$schemaprofile{
      datasetname:"";
      rowcount:0;
      colcount:0;
      columns:@()
    };
    <$hookresult{
      transformed:text;
      profile:emptyprofile;
      rawdatadetected:false
    }
  }
};

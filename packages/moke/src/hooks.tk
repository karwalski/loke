m=moke.hooks;
i=str:std.string;
i=log:std.log;
i=hooks:core.extensions.pipelinehooks;

t=$coltype{ $numeric:i64; $categorical:i64; $datetime:i64; $boolean:i64; $text:i64; $unknown:i64};

t=$colprofile{
  name:str;
  coltype:str;
  nullcount:i32;
  uniquecount:i32;
  samplevalues:@str;
  minval:str;
  maxval:str;
  meanval:str
};

t=$schemaprofile{
  datasetname:str;
  rowcount:i32;
  colcount:i32;
  columns:@$colprofile
};

t=$hookresult{
  transformed:str;
  profile:$schemaprofile;
  rawdatadetected:bool
};

t=$pipelinestate{
  original:str;
  anonymised:str;
  schemaprofile:str;
  entitycount:i32;
  sensitivity:str;
  datasetname:str;
  isschemafirst:bool
};

t=$pipelinehookresult{
  state:$pipelinestate;
  modified:bool
};

t=$pipelinehookentry{
  id:str;
  hookkey:str;
  slot:str
};

t=$pipelinehookregistry{
  entries:@$pipelinehookentry
};

t=$evalcontext{
  requestid:str;
  usecaseid:str;
  text:str;
  modelid:str;
  sensitivity:str;
  estimatedcost:f32
};

t=$rulehookresult{
  blocked:bool;
  reason:str;
  hookid:str
};

t=$rulehookentry{
  id:str;
  hookkey:str
};

t=$rulehookregistry{
  entries:@$rulehookentry
};

f=registerbeforeanonymise(id:str;hookkey:str;registry:$pipelinehookregistry):$pipelinehookregistry{
  let entry=$pipelinehookentry{
    id:id;
    hookkey:hookkey;
    slot:"before_anonymise"
  };
  let updated=str.pushcopy(registry.entries;entry);
  <$pipelinehookregistry{ entries:updated }
};

f=registerafteranonymise(id:str;hookkey:str;registry:$pipelinehookregistry):$pipelinehookregistry{
  let entry=$pipelinehookentry{
    id:id;
    hookkey:hookkey;
    slot:"after_anonymise"
  };
  let updated=str.pushcopy(registry.entries;entry);
  <$pipelinehookregistry{ entries:updated }
};

f=runhooks(slot:str;state:$pipelinestate;beforeregistry:$pipelinehookregistry;afterregistry:$pipelinehookregistry):$pipelinestate{
  let registry=beforeregistry;
  if(str.eq(slot;"after_anonymise")){
    registry=afterregistry
  };
  let current=mut.state;
  let idx=mut.0;
  lp(let lv=0;idx<str.len(registry.entries);lv=lv){
    let entry=str.get(registry.entries;idx);
    let result=hooks.dispatch(entry.hookkey;current);
    if(result.modified){
      current=result.state
    };
    idx=idx+1
  };
  <current
};

f=schemafirsthook(state:$pipelinestate):$pipelinehookresult{
  if(str.len(state.schemaprofile)=0){
    <$pipelinehookresult{
      state:state;
      modified:false
    }
  };
  let prefix="Dataset: ";
  prefix=str.concat(prefix;state.datasetname);
  prefix=str.concat(prefix;" Schema: ");
  prefix=str.concat(prefix;state.schemaprofile);
  prefix=str.concat(prefix;"

");
  let newtext=str.concat(prefix;state.original);
  let newstate=$pipelinestate{
    original:newtext;
    anonymised:state.anonymised;
    schemaprofile:state.schemaprofile;
    entitycount:state.entitycount;
    sensitivity:state.sensitivity;
    datasetname:state.datasetname;
    isschemafirst:true
  };
  <$pipelinehookresult{
    state:newstate;
    modified:true
  }
};

f=registerrulehook(id:str;hookkey:str;registry:$rulehookregistry):$rulehookregistry{
  let entry=$rulehookentry{
    id:id;
    hookkey:hookkey
  };
  let updated=str.pushcopy(registry.entries;entry);
  <$rulehookregistry{ entries:updated }
};

f=evaluaterules(ctx:$evalcontext;registry:$rulehookregistry):$rulehookresult{
  let idx=mut.0;
  lp(let lv=0;idx<str.len(registry.entries);lv=lv){
    let entry=str.get(registry.entries;idx);
    let result=hooks.dispatchrule(entry.hookkey;ctx);
    if(result.blocked){
      <result
    };
    idx=idx+1
  };
  <$rulehookresult{
    blocked:false;
    reason:"";
    hookid:""
  }
};

f=rawdataguardhook(ctx:$evalcontext):$rulehookresult{
  let lines=str.split(ctx.text;"
");
  let heavylines=mut.0;
  let idx=mut.0;
  lp(let lv=0;idx<str.len(lines);lv=lv){
    let line=str.get(lines;idx);
    let semicount=str.count(line;";");
    let commacount=str.count(line;",");
    if(semicount>5 || commacount>5){
      heavylines=heavylines+1
    };
    idx=idx+1
  };
  if(heavylines>3){
    <$rulehookresult{
      blocked:true;
      reason:"Raw tabular data detected -- use schema-first protocol";
      hookid:"moke.raw_data_guard"
    }
  };
  <$rulehookresult{
    blocked:false;
    reason:"";
    hookid:"moke.raw_data_guard"
  }
};

f=detectrawdata(text:str):bool{
  let pipelines=mut.0;
  let csvlines=mut.0;
  let lines=str.split(text;"
");
  let idx=mut.0;
  if(str.contains(text;"|
")){
    idx=0;
    lp(let lv=0;idx<str.len(lines);lv=lv){
      let line=str.get(lines;idx);
      if(str.contains(line;"|")){
        pipelines=pipelines+1
      };
      idx=idx+1
    }
  };
  if(pipelines>5){
    <true
  };
  idx=0;
  lp(let lv=0;idx<str.len(lines);lv=lv){
    let line=str.get(lines;idx);
    let commacount=str.count(line;",");
    if(commacount>3){
      csvlines=csvlines+1
    };
    idx=idx+1
  };
  if(csvlines>5){
    <true
  };
  <false
};

f=extractschema(csvtext:str;datasetname:str):$schemaprofile{
  let lines=str.split(csvtext;"
");
  let totallines=str.len(lines);
  let headerline=str.get(lines;0);
  let headers=str.split(headerline;",");
  let colcount=str.len(headers);
  let rowcount=totallines-1;
  let samplelimit=mut.100;
  if(samplelimit>rowcount){ samplelimit=rowcount };
  let columns=mut.@();
  let colidx=mut.0;
  lp(let lv=0;colidx<colcount;lv=lv){
    let colname=str.trim(str.get(headers;colidx));
    let values=mut.@();
    let rowidx=mut.1;
    lp(let lv2=0;!(rowidx>samplelimit);lv2=lv2){
      let rowline=str.get(lines;rowidx);
      let cells=str.split(rowline;",");
      let cell=str.trim(str.get(cells;colidx));
      str.push(values;cell);
      rowidx=rowidx+1
    };
    let nullcount=mut.0;
    let uniqueset=mut.@();
    let samplevals=mut.@();
    let samplecollected=mut.0;
    let numericcount=mut.0;
    let boolcount=mut.0;
    let datecount=mut.0;
    let sumval=mut.0.0;
    let minstr="";
    let maxstr="";
    let minnum=mut.0.0;
    let maxnum=mut.0.0;
    let firstnumeric=mut.true;
    let vidx=mut.0;
    lp(let lv2=0;vidx<str.len(values);lv2=lv2){
      let v=str.get(values;vidx);
      if(str.len(v)=0){
        nullcount=nullcount+1
      }el{
        let already=mut.false;
        let uidx=mut.0;
        lp(let lv3=0;uidx<str.len(uniqueset);lv3=lv3){
          if(str.eq(str.get(uniqueset;uidx);v)){
            already=true
          };
          uidx=uidx+1
        };
        if(already=false){ str.push(uniqueset;v) };
        if(samplecollected<3){
          str.push(samplevals;v);
          samplecollected=samplecollected+1
        };
        let isnum=str.isnumeric(v);
        if(isnum){
          numericcount=numericcount+1;
          let n=str.parsef32(v);
          sumval=sumval+n;
          if(firstnumeric){
            minnum=n;
            maxnum=n;
            firstnumeric=false
          }el{
            if(n<minnum){ minnum=n };
            if(n>maxnum){ maxnum=n }
          }
        };
        let vlower=str.lower(v);
        if(str.eq(vlower;"yes") || str.eq(vlower;"no") || str.eq(vlower;"true") || str.eq(vlower;"false") || str.eq(vlower;"1") || str.eq(vlower;"0")){
          boolcount=boolcount+1
        };
        if(str.contains(v;"-") && str.len(v)>8){
          datecount=datecount+1
        }
      };
      vidx=vidx+1
    };
    let uniquecount=str.len(uniqueset);
    let nonnull=str.len(values)-nullcount;
    let inferredtype=mut."unknown";
    if(nonnull>0 && numericcount=nonnull){
      inferredtype="numeric"
    }el{
      if(nonnull>0 && boolcount=nonnull){
        inferredtype="boolean"
      }el{
        if(nonnull>0 && datecount>nonnull/2){
          inferredtype="datetime"
        }el{
          if(uniquecount<20){
            inferredtype="categorical"
          }el{
            inferredtype="text"
          }
        }
      }
    };
    let minout="";
    let maxout="";
    let meanout="";
    if(str.eq(inferredtype;"numeric")){
      minout=str.fromf32(minnum);
      maxout=str.fromf32(maxnum);
      if(nonnull>0){
        meanout=str.fromf32(sumval/str.tof32(nonnull))
      }
    };
    let profile=$colprofile{
      name:colname;
      coltype:inferredtype;
      nullcount:nullcount;
      uniquecount:uniquecount;
      samplevalues:samplevals;
      minval:minout;
      maxval:maxout;
      meanval:meanout
    };
    str.push(columns;profile);
    colidx=colidx+1
  };
  <$schemaprofile{
    datasetname:datasetname;
    rowcount:rowcount;
    colcount:colcount;
    columns:columns
  }
};

f=profiletotoon(profile:$schemaprofile):str{
  let out=mut."";
  out=str.concat(out;"DATASET: ");
  out=str.concat(out;profile.datasetname);
  out=str.concat(out;" | ROWS: ");
  out=str.concat(out;str.fromi32(profile.rowcount));
  out=str.concat(out;" | COLS: ");
  out=str.concat(out;str.fromi32(profile.colcount));
  out=str.concat(out;"
");
  out=str.concat(out;"COLS: ");
  let idx=mut.0;
  lp(let lv=0;idx<str.len(profile.columns);lv=lv){
    let col=str.get(profile.columns;idx);
    out=str.concat(out;col.name);
    out=str.concat(out;"(");
    out=str.concat(out;col.coltype);
    out=str.concat(out;",nulls=");
    out=str.concat(out;str.fromi32(col.nullcount));
    out=str.concat(out;",unique=");
    out=str.concat(out;str.fromi32(col.uniquecount));
    out=str.concat(out;",sample=[");
    let sidx=mut.0;
    lp(let lv2=0;sidx<str.len(col.samplevalues);lv2=lv2){
      if(sidx>0){ out=str.concat(out;";") };
      out=str.concat(out;str.get(col.samplevalues;sidx));
      sidx=sidx+1
    };
    out=str.concat(out;"])");
    if(idx<profile.colcount-1){ out=str.concat(out;" ") };
    idx=idx+1
  };
  out=str.concat(out;"
");
  out=str.concat(out;"STATS: ");
  let hasstats=mut.false;
  let sidx=mut.0;
  lp(let lv=0;sidx<str.len(profile.columns);lv=lv){
    let col=str.get(profile.columns;sidx);
    if(str.eq(col.coltype;"numeric")){
      if(hasstats){ out=str.concat(out;" ") };
      out=str.concat(out;col.name);
      out=str.concat(out;"=");
      out=str.concat(out;col.minval);
      out=str.concat(out;"/");
      out=str.concat(out;col.maxval);
      out=str.concat(out;"/");
      out=str.concat(out;col.meanval);
      hasstats=true
    };
    sidx=sidx+1
  };
  if(hasstats=false){ out=str.concat(out;"(none)") };
  <out
};

f=applyschemafirst(text:str;datasetname:str):$hookresult{
  let israw=detectrawdata(text);
  if(israw){
    log.info("moke.hooks: raw data detected, extracting schema");
    let profile=extractschema(text;datasetname);
    let toon=profiletotoon(profile);
    let notice="[moke: raw data replaced by schema profile]
";
    let transformed=str.concat(notice;toon);
    <$hookresult{
      transformed:transformed;
      profile:profile;
      rawdatadetected:true
    }
  }el{
    let emptyprofile=$schemaprofile{
      datasetname:"";
      rowcount:0;
      colcount:0;
      columns:@()
    };
    <$hookresult{
      transformed:text;
      profile:emptyprofile;
      rawdatadetected:false
    }
  }
};

m=moke.hooks;
i=str:std.string;
i=log:std.log;
i=hooks:core.extensions.pipelinehooks;

t=$coltype{ $numeric; $categorical; $datetime; $boolean; $text; $unknown };

t=$colprofile{
  name:str;
  coltype:str;
  nullcount:i32;
  uniquecount:i32;
  samplevalues:@(str);
  minval:str;
  maxval:str;
  meanval:str
};

t=$schemaprofile{
  datasetname:str;
  rowcount:i32;
  colcount:i32;
  columns:@$colprofile
};

t=$hookresult{
  transformed:str;
  profile:$schemaprofile;
  rawdatadetected:bool
};




t=$pipelinestate{
  original:str;
  anonymised:str;
  schemaprofile:str;
  entitycount:i32;
  sensitivity:str;
  datasetname:str;
  isschemafirst:bool
};


t=$pipelinehookresult{
  state:$pipelinestate;
  modified:bool
};




t=$pipelinehookentry{
  id:str;
  hookkey:str;
  slot:str
};


t=$pipelinehookregistry{
  entries:@$pipelinehookentry
};


let gbeforeanonregistry=$pipelinehookregistry{ entries=@() };
let gafteranonregistry=$pipelinehookregistry{ entries=@() };




f=registerbeforeanonymise(id:str; hookkey:str){
  entry:$pipelinehookentry={
    id=id;
    hookkey=hookkey;
    slot="before_anonymise"
  };
  updated:@$pipelinehookentry=str.pushcopy(gbeforeanonregistry.entries;entry);
  gbeforeanonregistry=$pipelinehookregistry{ entries=updated };
};


f=registerafteranonymise(id:str; hookkey:str){
  entry:$pipelinehookentry={
    id=id;
    hookkey=hookkey;
    slot="after_anonymise"
  };
  updated:@$pipelinehookentry=str.pushcopy(gafteranonregistry.entries;entry);
  gafteranonregistry=$pipelinehookregistry{ entries=updated };
};





f=runhooks(slot:str; state:$pipelinestate):$pipelinestate{
  registry:$pipelinehookregistry=gbeforeanonregistry;
  if(str.eq(slot;"after_anonymise")){
    registry=gafteranonregistry
  }{};
  current:$pipelinestate=state;
  idx:i32=0;
  if(idx<str.len(registry.entries)){
    entry:$pipelinehookentry=str.get(registry.entries;idx);
    result:$pipelinehookresult=hooks.dispatch(entry.hookkey;current);
    if(result.modified){
      current=result.state
    }{};
    idx=idx+1
  }{};
  <current
};




f=schemafirsthook(state:$pipelinestate):$pipelinehookresult{
  if(str.len(state.schemaprofile)==0){
    <$pipelinehookresult{
      state=state;
      modified=false
    };
  }{};
  prefix:str="Dataset: ";
  prefix=str.concat(prefix;state.datasetname);
  prefix=str.concat(prefix;" Schema: ");
  prefix=str.concat(prefix;state.schemaprofile);
  prefix=str.concat(prefix;"

");
  newtext:str=str.concat(prefix;state.original);
  newstate:$pipelinestate={
    original=newtext;
    anonymised=state.anonymised;
    schemaprofile=state.schemaprofile;
    entitycount=state.entitycount;
    sensitivity=state.sensitivity;
    datasetname=state.datasetname;
    isschemafirst=true
  };
  <$pipelinehookresult{
    state=newstate;
    modified=true
  };
};




t=$evalcontext{
  requestid:str;
  usecaseid:str;
  text:str;
  modelid:str;
  sensitivity:str;
  estimatedcost:f32
};


t=$rulehookresult{
  blocked:bool;
  reason:str;
  hookid:str
};



t=$rulehookentry{
  id:str;
  hookkey:str
};


t=$rulehookregistry{
  entries:@$rulehookentry
};


let gruleregistry=$rulehookregistry{ entries=@() };


f=registerrulehook(id:str; hookkey:str){
  entry:$rulehookentry={
    id=id;
    hookkey=hookkey
  };
  updated:@$rulehookentry=str.pushcopy(gruleregistry.entries;entry);
  gruleregistry=$rulehookregistry{ entries=updated };
};




f=evaluaterules(ctx:$evalcontext):$rulehookresult{
  idx:i32=0;
  if(idx<str.len(gruleregistry.entries)){
    entry:$rulehookentry=str.get(gruleregistry.entries;idx);
    result:$rulehookresult=hooks.dispatchrule(entry.hookkey;ctx);
    if(result.blocked){
      <result
    }{};
    idx=idx+1
  }{};
  <$rulehookresult{
    blocked=false;
    reason="";
    hookid=""
  };
};






f=rawdataguardhook(ctx:$evalcontext):$rulehookresult{
  lines:@(str)=str.split(ctx.text;"
");
  heavylines:i32=0;
  idx:i32=0;
  if(idx<str.len(lines)){
    line:str=str.get(lines;idx);
    semicount:i32=str.count(line;";");
    commacount:i32=str.count(line;",");
    if(semicount>5||commacount>5){
      heavylines=heavylines+1
    }{};
    idx=idx+1
  }{};
  if(heavylines>3){
    <$rulehookresult{
      blocked=true;
      reason="Raw tabular data detected — use schema-first protocol";
      hookid="moke.raw_data_guard"
    };
  }{};
  <$rulehookresult{
    blocked=false;
    reason="";
    hookid="moke.raw_data_guard"
  };
};

f=detectrawdata(text:str):bool{
  pipelines:i32=0;
  csvlines:i32=0;
  lines:@(str)=str.split(text;"
");
  idx:i32=0;
  if(str.contains(text;"|
")){
    idx=0;
    if(idx<str.len(lines)){
      line:str=str.get(lines;idx);
      if(str.contains(line;"|")){
        pipelines=pipelines+1
      }{};
      idx=idx+1
    }{};
  }{};
  if(pipelines>5){
    <true
  }{};
  idx=0;
  if(idx<str.len(lines)){
    line:str=str.get(lines;idx);
    commacount:i32=str.count(line;",");
    if(commacount>3){
      csvlines=csvlines+1
    }{};
    idx=idx+1
  }{};
  if(csvlines>5){
    <true
  }{};
  <false
};

f=extractschema(csvtext:str;datasetname:str):$schemaprofile{
  lines:@(str)=str.split(csvtext;"
");
  totallines:i32=str.len(lines);
  headerline:str=str.get(lines;0);
  headers:@(str)=str.split(headerline;",");
  colcount:i32=str.len(headers);
  rowcount:i32=totallines-1;
  samplelimit:i32=100;
  if(samplelimit>rowcount){ samplelimit=rowcount }{};
  columns:@$colprofile=@();
  colidx:i32=0;
  if(colidx<colcount){
    colname:str=str.trim(str.get(headers;colidx));
    values:@(str)=@();
    rowidx:i32=1;
    if(rowidx<=samplelimit){
      rowline:str=str.get(lines;rowidx);
      cells:@(str)=str.split(rowline;",");
      cell:str=str.trim(str.get(cells;colidx));
      str.push(values;cell);
      rowidx=rowidx+1
    }{};
    nullcount:i32=0;
    uniqueset:@(str)=@();
    samplevals:@(str)=@();
    samplecollected:i32=0;
    numericcount:i32=0;
    boolcount:i32=0;
    datecount:i32=0;
    sumval:f32=0.0;
    minstr:str="";
    maxstr:str="";
    minnum:f32=0.0;
    maxnum:f32=0.0;
    firstnumeric:bool=true;
    vidx:i32=0;
    if(vidx<str.len(values)){
      v:str=str.get(values;vidx);
      if(str.len(v)==0){
        nullcount=nullcount+1
      }{
        already:bool=false;
        uidx:i32=0;
        if(uidx<str.len(uniqueset)){
          if(str.eq(str.get(uniqueset;uidx);v)){
            already=true
          }{};
          uidx=uidx+1
        }{};
        if(already==false){ str.push(uniqueset;v) }{};
        if(samplecollected<3){
          str.push(samplevals;v);
          samplecollected=samplecollected+1
        }{};
        isnum:bool=str.isnumeric(v);
        if(isnum){
          numericcount=numericcount+1;
          n:f32=str.parsef32(v);
          sumval=sumval+n;
          if(firstnumeric){
            minnum=n;
            maxnum=n;
            firstnumeric=false
          }{
            if(n<minnum){ minnum=n }{};
            if(n>maxnum){ maxnum=n }{};
          };
        }{};
        vlower:str=str.lower(v);
        if(str.eq(vlower;"yes")||str.eq(vlower;"no")||str.eq(vlower;"true")||str.eq(vlower;"false")||str.eq(vlower;"1")||str.eq(vlower;"0")){
          boolcount=boolcount+1
        }{};
        if(str.contains(v;"-")&&str.len(v)>=8){
          datecount=datecount+1
        }{};
      };
      vidx=vidx+1
    }{};
    uniquecount:i32=str.len(uniqueset);
    nonnull:i32=str.len(values)-nullcount;
    inferredtype:str="unknown";
    if(nonnull>0&&numericcount==nonnull){
      inferredtype="numeric"
    }{
      if(nonnull>0&&boolcount==nonnull){
        inferredtype="boolean"
      }{
        if(nonnull>0&&datecount>nonnull/2){
          inferredtype="datetime"
        }{
          if(uniquecount<20){
            inferredtype="categorical"
          }{
            inferredtype="text"
          };
        };
      };
    };
    minout:str="";
    maxout:str="";
    meanout:str="";
    if(str.eq(inferredtype;"numeric")){
      minout=str.fromf32(minnum);
      maxout=str.fromf32(maxnum);
      if(nonnull>0){
        meanout=str.fromf32(sumval/str.tof32(nonnull))
      }{};
    }{};
    profile:$colprofile={
      name=colname;
      coltype=inferredtype;
      nullcount=nullcount;
      uniquecount=uniquecount;
      samplevalues=samplevals;
      minval=minout;
      maxval=maxout;
      meanval=meanout
    };
    str.push(columns;profile);
    colidx=colidx+1
  }{};
  <$schemaprofile{
    datasetname=datasetname;
    rowcount=rowcount;
    colcount=colcount;
    columns=columns
  };
};

f=profiletotoon(profile:$schemaprofile):str{
  out:str="";
  out=str.concat(out;"DATASET: ");
  out=str.concat(out;profile.datasetname);
  out=str.concat(out;" | ROWS: ");
  out=str.concat(out;str.fromi32(profile.rowcount));
  out=str.concat(out;" | COLS: ");
  out=str.concat(out;str.fromi32(profile.colcount));
  out=str.concat(out;"
");
  out=str.concat(out;"COLS: ");
  idx:i32=0;
  if(idx<str.len(profile.columns)){
    col:$colprofile=str.get(profile.columns;idx);
    out=str.concat(out;col.name);
    out=str.concat(out;"(");
    out=str.concat(out;col.coltype);
    out=str.concat(out;",nulls=");
    out=str.concat(out;str.fromi32(col.nullcount));
    out=str.concat(out;",unique=");
    out=str.concat(out;str.fromi32(col.uniquecount));
    out=str.concat(out;",sample=[");
    sidx:i32=0;
    if(sidx<str.len(col.samplevalues)){
      if(sidx>0){ out=str.concat(out;";") }{};
      out=str.concat(out;str.get(col.samplevalues;sidx));
      sidx=sidx+1
    }{};
    out=str.concat(out;"])");
    if(idx<profile.colcount-1){ out=str.concat(out;" ") }{};
    idx=idx+1
  }{};
  out=str.concat(out;"
");
  out=str.concat(out;"STATS: ");
  hasstats:bool=false;
  sidx:i32=0;
  if(sidx<str.len(profile.columns)){
    col:$colprofile=str.get(profile.columns;sidx);
    if(str.eq(col.coltype;"numeric")){
      if(hasstats){ out=str.concat(out;" ") }{};
      out=str.concat(out;col.name);
      out=str.concat(out;"=");
      out=str.concat(out;col.minval);
      out=str.concat(out;"/");
      out=str.concat(out;col.maxval);
      out=str.concat(out;"/");
      out=str.concat(out;col.meanval);
      hasstats=true
    }{};
    sidx=sidx+1
  }{};
  if(hasstats==false){ out=str.concat(out;"(none)") }{};
  <out
};

f=applyschemafirst(text:str;datasetname:str):$hookresult{
  israw:bool=detectrawdata(text);
  if(israw){
    log.info("moke.hooks: raw data detected, extracting schema");
    profile:$schemaprofile=extractschema(text;datasetname);
    toon:str=profiletotoon(profile);
    notice:str="[moke: raw data replaced by schema profile]
";
    transformed:str=str.concat(notice;toon);
    <$hookresult{
      transformed=transformed;
      profile=profile;
      rawdatadetected=true
    };
  }{
    emptyprofile:$schemaprofile={
      datasetname="";
      rowcount=0;
      colcount=0;
      columns=@()
    };
    <$hookresult{
      transformed=text;
      profile=emptyprofile;
      rawdatadetected=false
    };
  };
};

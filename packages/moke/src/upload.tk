m=moke.upload;
i=str:std.str;
i=csv:std.csv;
(* Imported for the $dataset TYPE, not for any function — `grep 'compute\.'` finds nothing.
   Removing it fails the build, because a type from an import is referred to unqualified. *)
i=compute:moke.compute;

(* ── The CSV parser could not parse CSV, and nothing said so ───────────────────────
   This file raised no diagnostics at all. Every fault below is silent, and measured against
   toke's `src/stdlib/str_glue.c` at the pinned commit:

   1. **`str.charat` returns a BYTE CODE** — an `i64`, not a one-character string. It was fed
      to `str.eq(ch;",")`, which takes two `char *`, and to `str.concat(current;ch)`, which
      builds the field. So the delimiter test compared a small integer against a string pointer
      and the field accumulator dereferenced a character code as a `char *`. That is the whole
      parser, and it is the same shape as the T-28 segfault. Single characters are taken with
      `str.slice` now, which is a result and is matched.

   2. **`str.len` is `tk_str_len_w`, which is `strlen()` on a `char *`.** Applied to an ARRAY —
      `lines`, `fields`, `rows`, `headers`, `samplefields`, `words`, twelve sites — it walks the
      element buffer to its first zero byte. An array of 8-byte heap pointers has zero bytes in
      every element's high half, so it returned about 3 regardless of length. `parsecsv`
      therefore believed every file had about three lines, `gencolheaders` generated about three
      columns, and the field-padding loop padded to a fictional width.

   3. **`str.push` allocates and RETURNS a new array; all seven calls discarded the result**
      (T-24). So `splitcsvline` returned an empty field list, `gencolheaders` an empty header
      list, `parsecsv` an empty row list and an empty preview, and `guessname` an empty word
      list. A successful parse reported `ok:true` with no data in it.

   4. **`str.slice` is a result** and its value was bound as a plain string at three sites, and
      **`str.toupper(str.charat(w;0))`** passed a character code to a function that expects a
      string.

   5. **`$parseresult.dataset` was `i64`** while a `$dataset` was stored in it. Member access on
      an integer is not checked, so any reader was walking a raw word as a struct.

   6. `str.fromi32`, `str.toupper`, `str.replaceall` and `str.lastindexof` are `gen:"abi"`
      aliases in stdlib/str.tki rather than declared members. The declared spellings are
      `str.fromint`, `str.upper`, `str.replace` and `str.lastindex`. *)

t=$parseopts{
  delimiter:str;
  hasheader:bool;
  maxrows:i32
};

t=$parseresult{
  ok:bool;
  dataset:$dataset;
  error:str;
  rowcount:i32;
  colcount:i32;
  previewrows:@(@str)
};

(* One character as a string. `str.slice` is a result; an out-of-range index yields "" rather
   than a bound error, which is what every caller here wants. *)
f=charat(s:str;i:i64):str{
  <mt str.slice(s;i;i+1) {
    $ok:v v;
    $sliceerr:e ""
  }
};

f=sliceor(s:str;from:i64;to:i64;fallback:str):str{
  <mt str.slice(s;from;to) {
    $ok:v v;
    $sliceerr:e fallback
  }
};

f=occurrences(s:str;needle:str):i64{
  <str.split(s;needle).len-1
};

f=firstline(text:str):str{
  let nlidx=str.indexof(text;"\n");
  if(nlidx<0){
    <text
  };
  <sliceor(text;0;nlidx;text)
};

(* Tab wins only on a strict majority, so a comma-delimited file with a stray tab in a field
   still parses as CSV. The old version walked the line with `str.charat` and compared character
   codes against strings; counting split parts needs neither. *)
f=detectdelimiter(text:str):str{
  let head=firstline(text);
  if(occurrences(head;"\t")>occurrences(head;",")){
    <"\t"
  };
  <","
};

(* RFC 4180 quoting: a field may be quoted, and a doubled quote inside a quoted field is one
   literal quote. *)
f=splitcsvline(line:str;delimiter:str):@str{
  let fields=mut.@();
  let current=mut."";
  let inquotes=mut.false;
  let linelen=str.len(line) as i64;
  let i=mut.0;
  lp(let lv=0;i<linelen;lv=lv){
    let ch=charat(line;i);
    if(str.eq(ch;"\"") && inquotes){
      if(i+1<linelen && str.eq(charat(line;i+1);"\"")){
        current=str.concat(current;"\"");
        i=i+2
      }el{
        inquotes=false;
        i=i+1
      }
    }el if(str.eq(ch;"\"")){
      inquotes=true;
      i=i+1
    }el if(str.eq(ch;delimiter) && !inquotes){
      fields=fields.push(str.trim(current));
      current="";
      i=i+1
    }el{
      current=str.concat(current;ch);
      i=i+1
    }
  };
  <fields.push(str.trim(current))
};

f=gencolheaders(count:i64):@str{
  let headers=mut.@();
  lp(let i=0;i<count;i=i+1){
    headers=headers.push("col_\(str.fromint(i))")
  };
  <headers
};

f=emptydataset():$dataset{
  <$dataset{
    name:"";
    headers:@();
    rows:@()
  }
};

f=padfields(fields:@str;colcount:i64):@str{
  let out=mut.fields;
  lp(let i=fields.len;i<colcount;i=i+1){
    out=out.push("")
  };
  <out
};

(* A trailing newline leaves one empty final element in the split, which is not a row. *)
f=datalines(text:str):@str{
  let lines=str.split(text;"\n");
  if(lines.len>1 && str.len(str.trim(lines.get(lines.len-1)))==0){
    let out=mut.@();
    lp(let i=0;i<lines.len-1;i=i+1){
      out=out.push(lines.get(i))
    };
    <out
  };
  <lines
};

(* ── CSV parsing, on std.csv rather than on line splitting ────────────────────────
   This used to split the text on newlines first (`datalines`) and then split each line on the
   delimiter. `splitcsvline` is careful and correct about quotes — it tracks `inquotes` and
   handles the doubled-quote escape — but by the time it ran, the damage was done: a newline
   INSIDE a quoted field had already ended a "line".

   Measured on a three-row file whose second record holds a two-line address:

     name,address,city
     Alice,"1 High St",Sydney
     Bob,"12 Smith St
     Unit 4",Melbourne
     Carol,"9 Park Rd",Perth

   the old parser reported **4 data rows**, and not merely shifted:

     row1  Bob   | 12 Smith St |            <- Melbourne LOST
     row2  Unit 4,Melbourne |  |            <- a PHANTOM record

   So one person's record became two, one of which is fabricated, and a field that was present
   in the file was silently dropped. For this epic that is worse than a parse error: the column
   the sensitivity classifier reads is no longer the column the value came from, so a PII field
   can be classified from a header that describes something else — and a multi-line address is
   ordinary data in the kind of spreadsheet this demo loads.

   `std.csv` arrived with toke's Epic 135 and is at the pinned commit. Measured on the same
   input it returns 3 data rows with `12 Smith St\nUnit 4` intact and Melbourne in place.

   Read ITERATIVELY, not recursively: `csv.next` is a stateful reader and the obvious recursive
   drain would put one frame per row on the stack, which a real upload would exhaust. The loop
   is bounded by `maxrows` AND by an explicit iteration count, so a reader that neither
   advances nor reports `atend` cannot spin.

   `$ok` first in every match, because arms bind by position (T-31) and an error arm written
   first would make a well-formed row take the failure path. *)
f=delimbyte(text:str;opts:$parseopts):u8{
  (* An explicit option wins. Otherwise ask std.csv to sniff, and fall back to the
     count-the-occurrences heuristic this module already had if sniffing cannot tell. *)
  if(str.len(opts.delimiter)>0){
    <str.charat(opts.delimiter;0) as u8
  }el{};
  <mt csv.sniff(str.bytes(text)) {
    $ok:d firstbyteor(d.delim;text);
    $csverr:e firstbyteor(detectdelimiter(text);text)
  }
};

f=firstbyteor(delim:str;text:str):u8{
  if(str.len(delim)>0){
    <str.charat(delim;0) as u8
  }el{
    <str.charat(detectdelimiter(text);0) as u8
  }
};

f=readallrows(text:str;sep:u8;limit:i64):@(@str){
  let rd=csv.reader(str.bytes(text);sep);
  let rows=mut.@();
  lp(let it=0;it<limit;it=it+1){
    if(csv.atend(rd)){}el{
      rows=mt csv.next(rd) {
        $ok:row rows.push(row.fields);
        $csverr:e rows
      }
    }
  };
  <rows
};

f=tailrows(rows:@(@str)):@(@str){
  let out=mut.@();
  lp(let i=1;i<rows.len;i=i+1){
    out=out.push(rows.get(i))
  };
  <out
};

f=noparse(reason:str):$parseresult{
  <$parseresult{
    ok:false;
    dataset:emptydataset();
    error:reason;
    rowcount:0;
    colcount:0;
    previewrows:@()
  }
};

f=parsecsv(text:str;opts:$parseopts):$parseresult{
  let maxrows=opts.maxrows as i64;
  (* +1 so a header does not cost the caller a data row. *)
  let allrows=readallrows(text;delimbyte(text;opts);maxrows+1);
  if(allrows.len==0){
    <noparse("no data")
  }el{};

  let headers=mut.@();
  let datarows=mut.@();
  if(opts.hasheader){
    headers=allrows.get(0);
    datarows=tailrows(allrows)
  }el{
    headers=gencolheaders(allrows.get(0).len);
    datarows=allrows
  };
  let colcount=headers.len;

  (* padfields is kept: std.csv reports a ragged row through csv.raggedreport rather than
     padding it, and every consumer here indexes by column. *)
  let rows=mut.@();
  lp(let ri=0;ri<datarows.len && rows.len<maxrows;ri=ri+1){
    rows=rows.push(padfields(datarows.get(ri);colcount))
  };
  if(rows.len==0){
    <noparse("no data")
  }el{};

  let preview=mut.@();
  lp(let pi=0;pi<5 && pi<rows.len;pi=pi+1){
    preview=preview.push(rows.get(pi))
  };
  <$parseresult{
    ok:true;
    dataset:$dataset{
      name:"";
      headers:headers;
      rows:rows
    };
    error:"";
    rowcount:rows.len as i32;
    colcount:colcount as i32;
    previewrows:preview
  }
};

f=defaultopts():$parseopts{
  <$parseopts{
    delimiter:"";
    hasheader:true;
    maxrows:10000
  }
};

f=capitalise(w:str):str{
  let n=str.len(w) as i64;
  if(n==0){ <"" };
  if(n==1){ <str.upper(w) };
  <"\(str.upper(charat(w;0)))\(sliceor(w;1;n;""))"
};

f=guessname(filename:str):str{
  let dotidx=str.lastindex(filename;".");
  let base=mut.filename;
  if(dotidx>0){
    base=sliceor(filename;0;dotidx;filename)
  };
  base=str.replace(str.replace(base;"_";" ");"-";" ");
  let words=str.split(base;" ");
  let resultwords=mut.@();
  lp(let wi=0;wi<words.len;wi=wi+1){
    let w=words.get(wi);
    if(str.len(w)>0){
      resultwords=resultwords.push(capitalise(w))
    }
  };
  <str.join(" ";resultwords)
};

f=validate(result:$parseresult):bool{
  if(result.ok){}el{ <false };
  if(result.colcount>0){}el{ <false };
  if(result.rowcount>0){}el{ <false };
  <true
};

m=moke.upload;
i=str:std.string;
i=compute:moke.compute;



t=$parseopts{
  delimiter:str;
  hasheader:bool;
  maxrows:i32
};

t=$parseresult{
  ok:bool;
  dataset:i64;
  error:str;
  rowcount:i32;
  colcount:i32;
  previewrows:@(@(str))
};

f=detectdelimiter(text:str):str{
  firstline:str="";
  nlidx:i32=str.indexof(text;"
");
  if(nlidx>0){
    firstline=str.slice(text;0;nlidx)
  }el{
    firstline=text
  };
  commacount:i32=0;
  tabcount:i32=0;
  ci:i32=0;
  if(ci<str.len(firstline)){
    ch:str=str.charat(firstline;ci);
    if(str.eq(ch;",")){ commacount=commacount+1 }el{};
    if(str.eq(ch;"	")){ tabcount=tabcount+1 }el{};
    ci=ci+1
  }el{};
  if(tabcount>commacount){
    <"	"
  }el{};
  <","
};

f=splitcsvline(line:str;delimiter:str):@str{
  fields:@str=@();
  current:str="";
  inquotes:bool=false;
  i:i32=0;
  linelen:i32=str.len(line);
  if(i<linelen){
    ch:str=str.charat(line;i);
    if(str.eq(ch;"\"")&&inquotes=false){
      inquotes=true;
      i=i+1;
    }el{
      if(str.eq(ch;"\"")&&inquotes){
        
        if(i+1<linelen&&str.eq(str.charat(line;i+1);"\"" )){
          current=str.concat(current;"\"");
          i=i+2;
        }el{
          inquotes=false;
          i=i+1;
        }
      }el{
        if(str.eq(ch;delimiter)&&inquotes=false){
          str.push(fields;str.trim(current));
          current="";
          i=i+1;
        }el{
          current=str.concat(current;ch);
          i=i+1;
        }
      }
    }
  }el{};
  str.push(fields;str.trim(current));
  <fields
};

f=gencolheaders(count:i32):@str{
  headers:@str=@();
  i:i32=0;
  if(i<count){
    h:str=str.concat("col_";str.fromi32(i));
    str.push(headers;h);
    i=i+1;
  }el{};
  <headers
};

f=parsecsv(text:str;opts:$parseopts):$parseresult{
  delim:str=opts.delimiter;
  if(str.len(delim)=0){
    delim=detectdelimiter(text)
  }el{};
  lines:@str=str.split(text;"
");
  totallines:i32=str.len(lines);
  if(totallines=0){
    emptyds:i64=$$dataset{
      name="";
      headers=@();
      rows=@()
    };
    <$parseresult{
      ok=false;
      dataset=emptyds;
      error="no data";
      rowcount=0;
      colcount=0;
      previewrows=@()
    }
  }el{};
  
  lastidx:i32=totallines-1;
  if(lastidx>0&&str.len(str.trim(str.get(lines;lastidx)))=0){
    totallines=totallines-1;
    lastidx=lastidx-1
  }el{};
  headers:@str=@();
  startrow:i32=0;
  if(opts.hasheader&&totallines>0){
    firstline:str=str.trim(str.get(lines;0));
    headers=splitcsvline(firstline;delim);
    startrow=1
  }el{
    if(totallines>0){
      firstdata:str=str.trim(str.get(lines;0));
      samplefields:@str=splitcsvline(firstdata;delim);
      headers=gencolheaders(str.len(samplefields))
    }el{}
  };
  colcount:i32=str.len(headers);
  rows:@(@(str))=@();
  rowidx:i32=startrow;
  if(rowidx<totallines&&str.len(rows)<opts.maxrows){
    rawline:str=str.trim(str.get(lines;rowidx));
    if(str.len(rawline)>0){
      fields:@str=splitcsvline(rawline;delim);
      
      if(str.len(fields)<colcount){
        if(str.len(fields)<colcount){
          str.push(fields;"")
        }el{}
      }el{};
      str.push(rows;fields)
    }el{};
    rowidx=rowidx+1
  }el{};
  rowcount:i32=str.len(rows);
  ds:i64=$$dataset{
    name="";
    headers=headers;
    rows=rows
  };
  preview:@(@(str))=@();
  pi:i32=0;
  if(pi<5&&pi<rowcount){
    str.push(preview;str.get(rows;pi));
    pi=pi+1
  }el{};
  <$parseresult{
    ok=true;
    dataset=ds;
    error="";
    rowcount=rowcount;
    colcount=colcount;
    previewrows=preview
  }
};

f=defaultopts():$parseopts{
  <$parseopts{
    delimiter="";
    hasheader=true;
    maxrows=10000
  }
};

f=guessname(filename:str):str{
  
  dotidx:i32=str.lastindexof(filename;".");
  base:str=filename;
  if(dotidx>0){
    base=str.slice(filename;0;dotidx)
  }el{};
  
  base=str.replaceall(base;"_";" ");
  base=str.replaceall(base;"-";" ");
  
  words:@str=str.split(base;" ");
  resultwords:@str=@();
  wi:i32=0;
  if(wi<str.len(words)){
    w:str=str.get(words;wi);
    if(str.len(w)>0){
      firstch:str=str.toupper(str.charat(w;0));
      rest:str="";
      if(str.len(w)>1){
        rest=str.slice(w;1;str.len(w))
      }el{};
      str.push(resultwords;str.concat(firstch;rest))
    }el{};
    wi=wi+1
  }el{};
  <str.join(resultwords;" ")
};

f=validate(result:$parseresult):bool{
  if(result.ok=false){ <false }el{};
  if(result.colcount<=0){ <false }el{};
  if(result.rowcount<=0){ <false }el{};
  <true
};

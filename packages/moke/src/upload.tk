m=moke.upload;
i=str:std.string;
i=compute:moke.compute;



t=$parseopts{
  delimiter:str;
  hasheader:bool;
  maxrows:i32
};

t=$parseresult{
  ok:bool;
  dataset:i64;
  error:str;
  rowcount:i32;
  colcount:i32;
  previewrows:@(@str)
};

f=detectdelimiter(text:str):str{
  let firstline=mut."";
  let nlidx=str.indexof(text;"
");
  if(nlidx>0){
    firstline=str.slice(text;0;nlidx)
  }el{
    firstline=text
  };
  let commacount=mut.0;
  let tabcount=mut.0;
  let ci=mut.0;
  lp(let lv=0;ci<str.len(firstline);lv=lv){
    let ch=str.charat(firstline;ci);
    if(str.eq(ch;",")){ commacount=commacount+1 }el{};
    if(str.eq(ch;"	")){ tabcount=tabcount+1 }el{};
    ci=ci+1
  };
  if(tabcount>commacount){
    <"	"
  }el{};
  <","
};

f=splitcsvline(line:str;delimiter:str):@str{
  let fields=@();
  let current=mut."";
  let inquotes=mut.false;
  let i=mut.0;
  let linelen=str.len(line);
  lp(let lv=0;i<linelen;lv=lv){
    let ch=str.charat(line;i);
    if(str.eq(ch;"\"")&&inquotes=false){
      inquotes=true;
      i=i+1
    }el{
      if(str.eq(ch;"\"")&&inquotes){
        if(i+1<linelen&&str.eq(str.charat(line;i+1);"\"")){
          current=str.concat(current;"\"");
          i=i+2
        }el{
          inquotes=false;
          i=i+1
        }
      }el{
        if(str.eq(ch;delimiter)&&inquotes=false){
          str.push(fields;str.trim(current));
          current="";
          i=i+1
        }el{
          current=str.concat(current;ch);
          i=i+1
        }
      }
    }
  };
  str.push(fields;str.trim(current));
  <fields
};

f=gencolheaders(count:i32):@str{
  let headers=@();
  let i=mut.0;
  lp(let lv=0;i<count;lv=lv){
    let h=str.concat("col_";str.fromi32(i));
    str.push(headers;h);
    i=i+1
  };
  <headers
};

f=parsecsv(text:str;opts:$parseopts):$parseresult{
  let delim=mut.opts.delimiter;
  if(str.len(delim)=0){
    delim=detectdelimiter(text)
  }el{};
  let lines=str.split(text;"
");
  let totallines=mut.str.len(lines);
  if(totallines=0){
    let emptyds=$dataset{
      name:"";
      headers:@();
      rows:@()
    };
    <$parseresult{
      ok:false;
      dataset:emptyds;
      error:"no data";
      rowcount:0;
      colcount:0;
      previewrows:@()
    }
  }el{};

  let lastidx=mut.totallines-1;
  if(lastidx>0&&str.len(str.trim(str.get(lines;lastidx)))=0){
    totallines=totallines-1;
    lastidx=lastidx-1
  }el{};
  let headers=mut.@();
  let startrow=mut.0;
  if(opts.hasheader&&totallines>0){
    let firstline=str.trim(str.get(lines;0));
    headers=splitcsvline(firstline;delim);
    startrow=1
  }el{
    if(totallines>0){
      let firstdata=str.trim(str.get(lines;0));
      let samplefields=splitcsvline(firstdata;delim);
      headers=gencolheaders(str.len(samplefields))
    }el{}
  };
  let colcount=str.len(headers);
  let rows=@();
  let rowidx=mut.startrow;
  lp(let lv=0;rowidx<totallines&&str.len(rows)<opts.maxrows;lv=lv){
    let rawline=str.trim(str.get(lines;rowidx));
    if(str.len(rawline)>0){
      let fields=mut.splitcsvline(rawline;delim);
      lp(let lv2=0;str.len(fields)<colcount;lv2=lv2){
        str.push(fields;"")
      };
      str.push(rows;fields)
    }el{};
    rowidx=rowidx+1
  };
  let rowcount=str.len(rows);
  let ds=$dataset{
    name:"";
    headers:headers;
    rows:rows
  };
  let preview=@();
  let pi=mut.0;
  lp(let lv=0;pi<5&&pi<rowcount;lv=lv){
    str.push(preview;str.get(rows;pi));
    pi=pi+1
  };
  <$parseresult{
    ok:true;
    dataset:ds;
    error:"";
    rowcount:rowcount;
    colcount:colcount;
    previewrows:preview
  }
};

f=defaultopts():$parseopts{
  <$parseopts{
    delimiter:"";
    hasheader:true;
    maxrows:10000
  }
};

f=guessname(filename:str):str{
  let dotidx=str.lastindexof(filename;".");
  let base=mut.filename;
  if(dotidx>0){
    base=str.slice(filename;0;dotidx)
  }el{};
  base=str.replaceall(base;"_";" ");
  base=str.replaceall(base;"-";" ");
  let words=str.split(base;" ");
  let resultwords=@();
  let wi=mut.0;
  lp(let lv=0;wi<str.len(words);lv=lv){
    let w=str.get(words;wi);
    if(str.len(w)>0){
      let firstch=str.toupper(str.charat(w;0));
      let rest=mut."";
      if(str.len(w)>1){
        rest=str.slice(w;1;str.len(w))
      }el{};
      str.push(resultwords;str.concat(firstch;rest))
    }el{};
    wi=wi+1
  };
  <str.join(resultwords;" ")
};

f=validate(result:$parseresult):bool{
  if(result.ok=false){ <false }el{};
  if(result.colcount<=0){ <false }el{};
  if(result.rowcount<=0){ <false }el{};
  <true
};

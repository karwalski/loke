
m=moke.routingexplainer;
i=str:std.string;

t=$routingdecision{
  requestid:$str;
  intent:$str;
  intentconfidence:f64;
  intentmethod:$str;
  sensitivity:$str;
  sensitivityrouting:$str;
  costestimateusd:f64;
  latencytolerance:$str;
  modelid:$str;
  provider:$str;
  islocal:bool;
  tier:$str;
  reason:$str
};

f=newdecision(requestid:$str):$routingdecision{
  <$routingdecision{
    requestid:$requestid;
    intent:"chat";
    intentconfidence:0.60;
    intentmethod:"keyword";
    sensitivity:"PUBLIC";
    sensitivityrouting:"any";
    costestimateusd:0.0;
    latencytolerance:"instant";
    modelid:"";
    provider:"";
    islocal:false;
    tier:"interactive";
    reason:""
  };
};

f=withintent(d:i64;intent:$str;confidence:f64;method:$str):$routingdecision{
  <$routingdecision{
    requestid:i64;
    intent:$intent;
    intentconfidence:$confidence;
    intentmethod:$method;
    sensitivity:i64;
    sensitivityrouting:i64;
    costestimateusd:i64;
    latencytolerance:i64;
    modelid:i64;
    provider:i64;
    islocal:i64;
    tier:i64;
    reason:i64
  };
};

f=withsensitivity(d:i64;level:$str;routing:$str):$routingdecision{
  <$routingdecision{
    requestid:i64;
    intent:i64;
    intentconfidence:i64;
    intentmethod:i64;
    sensitivity:$level;
    sensitivityrouting:$routing;
    costestimateusd:i64;
    latencytolerance:i64;
    modelid:i64;
    provider:i64;
    islocal:i64;
    tier:i64;
    reason:i64
  };
};

f=withselection(d:i64;modelid:$str;provider:$str;islocal:bool;tier:$str;reason:$str;cost:f64):$routingdecision{
  <$routingdecision{
    requestid:i64;
    intent:i64;
    intentconfidence:i64;
    intentmethod:i64;
    sensitivity:i64;
    sensitivityrouting:i64;
    costestimateusd:$cost;
    latencytolerance:i64;
    modelid:$modelid;
    provider:$provider;
    islocal:$islocal;
    tier:$tier;
    reason:$reason
  };
};

f=tojson(d:$routingdecision):$str{
  let j=mut."{";
  j=str.concat(j;"\"request_id\":\"" + str.jsonescape(d.requestid) + "\"");
  j=str.concat(j;",\"intent\":\"" + str.jsonescape(d.intent) + "\"");
  j=str.concat(j;",\"intent_confidence\":" + str.fromfloat(d.intentconfidence));
  j=str.concat(j;",\"intent_method\":\"" + str.jsonescape(d.intentmethod) + "\"");
  j=str.concat(j;",\"sensitivity\":\"" + str.jsonescape(d.sensitivity) + "\"");
  j=str.concat(j;",\"sensitivity_routing\":\"" + str.jsonescape(d.sensitivityrouting) + "\"");
  j=str.concat(j;",\"cost_estimate_usd\":" + str.fromfloat(d.costestimateusd));
  j=str.concat(j;",\"latency_tolerance\":\"" + str.jsonescape(d.latencytolerance) + "\"");
  j=str.concat(j;",\"model_id\":\"" + str.jsonescape(d.modelid) + "\"");
  j=str.concat(j;",\"provider\":\"" + str.jsonescape(d.provider) + "\"");
  j=str.concat(j;",\"is_local\":" + if(d.islocal){ "true" }el{ "false" });
  j=str.concat(j;",\"tier\":\"" + str.jsonescape(d.tier) + "\"");
  j=str.concat(j;",\"reason\":\"" + str.jsonescape(d.reason) + "\"");
  j=str.concat(j;"}");
  <j
};

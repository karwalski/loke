m=moke.routingexplainer;
i=str:std.string;

t=$routingdecision{
  requestid:str;
  intent:str;
  intentconfidence:f64;
  intentmethod:str;
  sensitivity:str;
  sensitivityrouting:str;
  costestimateusd:f64;
  latencytolerance:str;
  modelid:str;
  provider:str;
  islocal:bool;
  tier:str;
  reason:str
};

f=newdecision(requestid:str):$routingdecision{
  <$routingdecision{
    requestid:requestid;
    intent:"chat";
    intentconfidence:0.60;
    intentmethod:"keyword";
    sensitivity:"PUBLIC";
    sensitivityrouting:"any";
    costestimateusd:0.0;
    latencytolerance:"instant";
    modelid:"";
    provider:"";
    islocal:false;
    tier:"interactive";
    reason:""
  }
};

f=withintent(d:$routingdecision;intent:str;confidence:f64;method:str):$routingdecision{
  <$routingdecision{
    requestid:d.requestid;
    intent:intent;
    intentconfidence:confidence;
    intentmethod:method;
    sensitivity:d.sensitivity;
    sensitivityrouting:d.sensitivityrouting;
    costestimateusd:d.costestimateusd;
    latencytolerance:d.latencytolerance;
    modelid:d.modelid;
    provider:d.provider;
    islocal:d.islocal;
    tier:d.tier;
    reason:d.reason
  }
};

f=withsensitivity(d:$routingdecision;level:str;routing:str):$routingdecision{
  <$routingdecision{
    requestid:d.requestid;
    intent:d.intent;
    intentconfidence:d.intentconfidence;
    intentmethod:d.intentmethod;
    sensitivity:level;
    sensitivityrouting:routing;
    costestimateusd:d.costestimateusd;
    latencytolerance:d.latencytolerance;
    modelid:d.modelid;
    provider:d.provider;
    islocal:d.islocal;
    tier:d.tier;
    reason:d.reason
  }
};

f=withselection(d:$routingdecision;modelid:str;provider:str;islocal:bool;tier:str;reason:str;cost:f64):$routingdecision{
  <$routingdecision{
    requestid:d.requestid;
    intent:d.intent;
    intentconfidence:d.intentconfidence;
    intentmethod:d.intentmethod;
    sensitivity:d.sensitivity;
    sensitivityrouting:d.sensitivityrouting;
    costestimateusd:cost;
    latencytolerance:d.latencytolerance;
    modelid:modelid;
    provider:provider;
    islocal:islocal;
    tier:tier;
    reason:reason
  }
};

f=tojson(d:$routingdecision):str{
  let j=mut."{";
  j=str.concat(j;"\"request_id\":\"" + str.jsonescape(d.requestid) + "\"");
  j=str.concat(j;",\"intent\":\"" + str.jsonescape(d.intent) + "\"");
  j=str.concat(j;",\"intent_confidence\":" + str.fromfloat(d.intentconfidence));
  j=str.concat(j;",\"intent_method\":\"" + str.jsonescape(d.intentmethod) + "\"");
  j=str.concat(j;",\"sensitivity\":\"" + str.jsonescape(d.sensitivity) + "\"");
  j=str.concat(j;",\"sensitivity_routing\":\"" + str.jsonescape(d.sensitivityrouting) + "\"");
  j=str.concat(j;",\"cost_estimate_usd\":" + str.fromfloat(d.costestimateusd));
  j=str.concat(j;",\"latency_tolerance\":\"" + str.jsonescape(d.latencytolerance) + "\"");
  j=str.concat(j;",\"model_id\":\"" + str.jsonescape(d.modelid) + "\"");
  j=str.concat(j;",\"provider\":\"" + str.jsonescape(d.provider) + "\"");
  let islocalbool=mut."false";
  if(d.islocal){ islocalbool="true" };
  j=str.concat(j;",\"is_local\":" + islocalbool);
  j=str.concat(j;",\"tier\":\"" + str.jsonescape(d.tier) + "\"");
  j=str.concat(j;",\"reason\":\"" + str.jsonescape(d.reason) + "\"");
  j=str.concat(j;"}");
  <j
};

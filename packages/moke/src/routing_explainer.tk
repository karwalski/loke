m=moke.routingexplainer;
i=str:std.str;
i=jx:shared.jsonobj;

t=$routingdecision{
  requestid:str;
  intent:str;
  intentconfidence:f64;
  intentmethod:str;
  sensitivity:str;
  sensitivityrouting:str;
  costestimateusd:f64;
  latencytolerance:str;
  modelid:str;
  provider:str;
  islocal:bool;
  tier:str;
  reason:str
};

f=newdecision(requestid:str):$routingdecision{
  <$routingdecision{
    requestid:requestid;
    intent:"chat";
    intentconfidence:0.60;
    intentmethod:"keyword";
    sensitivity:"PUBLIC";
    sensitivityrouting:"any";
    costestimateusd:0.0;
    latencytolerance:"instant";
    modelid:"";
    provider:"";
    islocal:false;
    tier:"interactive";
    reason:""
  }
};

f=withintent(d:$routingdecision;intent:str;confidence:f64;method:str):$routingdecision{
  <$routingdecision{
    requestid:d.requestid;
    intent:intent;
    intentconfidence:confidence;
    intentmethod:method;
    sensitivity:d.sensitivity;
    sensitivityrouting:d.sensitivityrouting;
    costestimateusd:d.costestimateusd;
    latencytolerance:d.latencytolerance;
    modelid:d.modelid;
    provider:d.provider;
    islocal:d.islocal;
    tier:d.tier;
    reason:d.reason
  }
};

f=withsensitivity(d:$routingdecision;level:str;routing:str):$routingdecision{
  <$routingdecision{
    requestid:d.requestid;
    intent:d.intent;
    intentconfidence:d.intentconfidence;
    intentmethod:d.intentmethod;
    sensitivity:level;
    sensitivityrouting:routing;
    costestimateusd:d.costestimateusd;
    latencytolerance:d.latencytolerance;
    modelid:d.modelid;
    provider:d.provider;
    islocal:d.islocal;
    tier:d.tier;
    reason:d.reason
  }
};

f=withselection(d:$routingdecision;modelid:str;provider:str;islocal:bool;tier:str;reason:str;cost:f64):$routingdecision{
  <$routingdecision{
    requestid:d.requestid;
    intent:d.intent;
    intentconfidence:d.intentconfidence;
    intentmethod:d.intentmethod;
    sensitivity:d.sensitivity;
    sensitivityrouting:d.sensitivityrouting;
    costestimateusd:cost;
    latencytolerance:d.latencytolerance;
    modelid:modelid;
    provider:provider;
    islocal:islocal;
    tier:tier;
    reason:reason
  }
};

(* Strings do not concatenate with `+`; the whole body was `str.concat(j;"..." + x + "...")`
   and all 20 of this file's diagnostics were E4031 on that operator. One interpolated literal
   replaces the eleven-step accumulation. `jx.escape` replaces `str.jsonescape`, which does not
   exist in the interface OR the runtime, so every string here went into the JSON unescaped:
   a reason or model id containing a quote produced a malformed routing explanation. *)
f=tojson(d:$routingdecision):str{
  let islocal=mut."false";
  if(d.islocal){ islocal="true" };
  <"{\"request_id\":\(jx.escape(d.requestid)),\"intent\":\(jx.escape(d.intent)),\"intent_confidence\":\(str.fromfloat(d.intentconfidence)),\"intent_method\":\(jx.escape(d.intentmethod)),\"sensitivity\":\(jx.escape(d.sensitivity)),\"sensitivity_routing\":\(jx.escape(d.sensitivityrouting)),\"cost_estimate_usd\":\(str.fromfloat(d.costestimateusd)),\"latency_tolerance\":\(jx.escape(d.latencytolerance)),\"model_id\":\(jx.escape(d.modelid)),\"provider\":\(jx.escape(d.provider)),\"is_local\":\(islocal),\"tier\":\(jx.escape(d.tier)),\"reason\":\(jx.escape(d.reason))}"
};

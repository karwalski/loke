
m=moke.streaming;
i=str:std.string;
i=consolelog:moke.consolelog;

t=$streamstate{
  $idle:i64;
  $connecting:i64;
  $streaming:i64;
  $complete:i64;
  $error:i64
};

t=$streamevent{
  eventtype:$str;
  data:$str;
  timestamp:i64
};

t=$streamsession{
  state:i64;
  requestid:$str;
  modelid:$str;
  tokensreceived:i32;
  activestage:$str;
  events:@$streamevent;
  consolelog:$consolelog.$sessionlog:i64
};

f=newsession(requestid:$str;modelid:$str):$streamsession{
  <$streamsession{
    state:$streamstate.$idle:i64;
    requestid:$requestid;
    modelid:$modelid;
    tokensreceived:0;
    activestage:"";
    events:@();
    consolelog:$consolelog.newsession(requestid)
  };
};

f=setstate(s:i64;state:$streamstate):$streamsession{
  <$streamsession{
    state:$state;
    requestid:$s.requestid;
    modelid:$s.modelid;
    tokensreceived:$s.tokensreceived;
    activestage:$s.activestage;
    events:$s.events;
    consolelog:$s.consolelog
  };
};

f=addtoken(s:i64;token:$str):$streamsession{
  let evt=$streamevent{
    eventtype:"token";
    data:$token;
    timestamp:$std.nowms()
  };
  <$streamsession{
    state:$streamstate.$streaming:i64;
    requestid:$s.requestid;
    modelid:$s.modelid;
    tokensreceived:$s.tokensreceived + 1;
    activestage:"llm_call";
    events:$s.events.pushcopy(evt);
    consolelog:$s.consolelog
  };
};

f=setstage(s:i64;stage:$str):$streamsession{
  let evt=$streamevent{
    eventtype:"stage";
    data:$stage;
    timestamp:$std.nowms()
  };
  <$streamsession{
    state:$s.state;
    requestid:$s.requestid;
    modelid:$s.modelid;
    tokensreceived:$s.tokensreceived;
    activestage:$stage;
    events:$s.events.pushcopy(evt);
    consolelog:$consolelog.append(s.consolelog;stage;"ok";"Stage active";0)
  };
};

f=statelabel(state:$streamstate):$str{
  mt state {
    idle        "idle";
    connecting  "connecting";
    streaming   "streaming";
    complete    "complete";
    error       "error"
  };
};

f=eventtojson(e:$streamevent):$str{
  let j=mut."{";
  j=str.concat(j;"\"event_type\":\"" + str.jsonescape(e.eventtype) + "\"");
  j=str.concat(j;",\"data\":\"" + str.jsonescape(e.data) + "\"");
  j=str.concat(j;",\"timestamp\":" + str.fromint64(e.timestamp));
  j=str.concat(j;"}");
  <j
};

f=tosse(e:$streamevent):$str{
  <"event: " + e.eventtype + "
data: " + str.jsonescape(e.data) + "

"
};

f=sessiontojson(s:$streamsession):$str{
  let eventsjson=str.join(s.events.map(e{ <eventtojson(e) }); ",");
  let j="{";
  j=str.concat(j;"\"state\":\"" + statelabel(s.state) + "\"");
  j=str.concat(j;",\"request_id\":\"" + str.jsonescape(s.requestid) + "\"");
  j=str.concat(j;",\"model_id\":\"" + str.jsonescape(s.modelid) + "\"");
  j=str.concat(j;",\"tokens_received\":" + str.fromint(s.tokensreceived));
  j=str.concat(j;",\"active_stage\":\"" + str.jsonescape(s.activestage) + "\"");
  j=str.concat(j;",\"events\":[" + eventsjson + "]");
  j=str.concat(j;",\"console_log\":" + consolelog.tojson(s.consolelog));
  j=str.concat(j;"}");
  <j
};

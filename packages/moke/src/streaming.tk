m=moke.streaming;
i=str:std.string;
i=consolelog:moke.consolelog;

t=$streamstate{
  $idle:i64;
  $connecting:i64;
  $streaming:i64;
  $complete:i64;
  $error:i64
};

t=$streamevent{
  eventtype:str;
  data:str;
  timestamp:i64
};

t=$streamsession{
  state:i64;
  requestid:str;
  modelid:str;
  tokensreceived:i32;
  activestage:str;
  events:@$streamevent;
  sessionlog:i64
};

f=newsession(requestid:str;modelid:str):$streamsession{
  <$streamsession{
    state:0;
    requestid:requestid;
    modelid:modelid;
    tokensreceived:0;
    activestage:"";
    events:@();
    sessionlog:consolelog.newsession(requestid)
  };
};

f=setstate(s:$streamsession;state:i64):$streamsession{
  <$streamsession{
    state:state;
    requestid:s.requestid;
    modelid:s.modelid;
    tokensreceived:s.tokensreceived;
    activestage:s.activestage;
    events:s.events;
    sessionlog:s.sessionlog
  };
};

f=addtoken(s:$streamsession;token:str):$streamsession{
  let evt=$streamevent{
    eventtype:"token";
    data:token;
    timestamp:str.unixnow()
  };
  <$streamsession{
    state:2;
    requestid:s.requestid;
    modelid:s.modelid;
    tokensreceived:s.tokensreceived + 1;
    activestage:"llm_call";
    events:s.events.pushcopy(evt);
    sessionlog:s.sessionlog
  };
};

f=setstage(s:$streamsession;stage:str):$streamsession{
  let evt=$streamevent{
    eventtype:"stage";
    data:stage;
    timestamp:str.unixnow()
  };
  <$streamsession{
    state:s.state;
    requestid:s.requestid;
    modelid:s.modelid;
    tokensreceived:s.tokensreceived;
    activestage:stage;
    events:s.events.pushcopy(evt);
    sessionlog:consolelog.log(s.sessionlog;stage;"ok";"Stage active";0)
  };
};

f=statelabel(state:i64):str{
  if(state = 0){ <"idle" };
  if(state = 1){ <"connecting" };
  if(state = 2){ <"streaming" };
  if(state = 3){ <"complete" };
  <"error"
};

f=eventtojson(e:$streamevent):str{
  let j=mut."{";
  j=str.concat(j;"\"event_type\":\"" + str.jsonescape(e.eventtype) + "\"");
  j=str.concat(j;",\"data\":\"" + str.jsonescape(e.data) + "\"");
  j=str.concat(j;",\"timestamp\":" + str.fromint64(e.timestamp));
  j=str.concat(j;"}");
  <j
};

f=tosse(e:$streamevent):str{
  <"event: " + e.eventtype + "
data: " + str.jsonescape(e.data) + "

"
};

f=sessiontojson(s:$streamsession):str{
  let eventparts=mut.@();
  lp(let ii=0;ii<s.events.len;ii=ii+1){
    let e=s.events.get(ii);
    eventparts=eventparts.push(eventtojson(e))
  };
  let eventsjson=str.join(eventparts;",");
  let j="{";
  j=str.concat(j;"\"state\":\"" + statelabel(s.state) + "\"");
  j=str.concat(j;",\"request_id\":\"" + str.jsonescape(s.requestid) + "\"");
  j=str.concat(j;",\"model_id\":\"" + str.jsonescape(s.modelid) + "\"");
  j=str.concat(j;",\"tokens_received\":" + str.fromint(s.tokensreceived));
  j=str.concat(j;",\"active_stage\":\"" + str.jsonescape(s.activestage) + "\"");
  j=str.concat(j;",\"events\":[" + eventsjson + "]");
  j=str.concat(j;",\"console_log\":" + consolelog.tojson(s.sessionlog));
  j=str.concat(j;"}");
  <j
};

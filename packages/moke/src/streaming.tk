m=moke.streaming;
i=str:std.str;
i=consolelog:moke.consolelog;
i=time:std.time;
i=jx:shared.jsonobj;

(* ── Four faults, only some of which the compiler could see ────────────────────────
   `str.unixnow` exists in neither the std.str interface nor the runtime (E4027). The clock
   used beside these events is `time.nowms`, which is what moke.consolelog stamps its entries
   with, so the two timelines line up.

   The append was `s.events.pushcopy(evt)`, and there is no `pushcopy` method. An unknown method
   call is not type-checked at all (T-7), and measured in the emitted IR it lowers to a call to a
   BARE GLOBAL named after the method with the RECEIVER DROPPED -- `declare i64 @pushcopy(i64)`.
   So neither `addtoken` nor `setstage` had an append behind it and the module could not link.
   `s.events.push(evt)` is the append, and its result is used: a bare `arr.push(x)` lowers to
   `tk_array_append_w`, which allocates a fresh array and leaves the original alone.

   `consolelog.log` does not exist either; the function is `append`. That one did raise E4027,
   which is the only reason the event-list bug above was ever going to be found.

   And the JSON builders concatenated with `+`, which is arithmetic, not string concatenation.
   Interpolation replaces it, and `shared.jsonobj.escape` replaces `str.jsonescape`, which exists
   in neither the std.str interface nor the runtime -- so every event's data went onto the SSE
   wire and into the session JSON unescaped. *)

t=$streamstate{
  $idle:i64;
  $connecting:i64;
  $streaming:i64;
  $complete:i64;
  $error:i64
};

t=$streamevent{
  eventtype:str;
  data:str;
  timestamp:i64
};

t=$streamsession{
  state:i64;
  requestid:str;
  modelid:str;
  tokensreceived:i32;
  activestage:str;
  events:@$streamevent;
  sessionlog:$sessionlog
};

f=newsession(requestid:str;modelid:str):$streamsession{
  <$streamsession{
    state:0;
    requestid:requestid;
    modelid:modelid;
    tokensreceived:0;
    activestage:"";
    events:@();
    sessionlog:consolelog.newsession(requestid)
  };
};

f=setstate(s:$streamsession;state:i64):$streamsession{
  <$streamsession{
    state:state;
    requestid:s.requestid;
    modelid:s.modelid;
    tokensreceived:s.tokensreceived;
    activestage:s.activestage;
    events:s.events;
    sessionlog:s.sessionlog
  };
};

f=addtoken(s:$streamsession;token:str):$streamsession{
  let evt=$streamevent{
    eventtype:"token";
    data:token;
    timestamp:time.nowms()
  };
  <$streamsession{
    state:2;
    requestid:s.requestid;
    modelid:s.modelid;
    tokensreceived:s.tokensreceived + 1;
    activestage:"llm_call";
    events:s.events.push(evt);
    sessionlog:s.sessionlog
  };
};

f=setstage(s:$streamsession;stage:str):$streamsession{
  let evt=$streamevent{
    eventtype:"stage";
    data:stage;
    timestamp:time.nowms()
  };
  <$streamsession{
    state:s.state;
    requestid:s.requestid;
    modelid:s.modelid;
    tokensreceived:s.tokensreceived;
    activestage:stage;
    events:s.events.push(evt);
    sessionlog:consolelog.append(s.sessionlog;stage;"ok";"Stage active";0 as i32)
  };
};

f=statelabel(state:i64):str{
  if(state == 0){ <"idle" };
  if(state == 1){ <"connecting" };
  if(state == 2){ <"streaming" };
  if(state == 3){ <"complete" };
  <"error"
};

f=eventtojson(e:$streamevent):str{
  <"{\"event_type\":\(jx.escape(e.eventtype)),\"data\":\(jx.escape(e.data)),\"timestamp\":\(str.fromint(e.timestamp))}"
};

(* An SSE frame is `event:`, `data:`, then a BLANK line; the event type is a field name, not
   payload, so it is not escaped, while the data is. *)
f=tosse(e:$streamevent):str{
  <"event: \(e.eventtype)\ndata: \(jx.escape(e.data))\n\n"
};

f=sessiontojson(s:$streamsession):str{
  let eventparts=mut.@();
  lp(let ii=0;ii<s.events.len;ii=ii+1){
    let e=s.events.get(ii);
    eventparts=eventparts.push(eventtojson(e))
  };
  let eventsjson=str.join(",";eventparts);
  <"{\"state\":\"\(statelabel(s.state))\",\"request_id\":\(jx.escape(s.requestid)),\"model_id\":\(jx.escape(s.modelid)),\"tokens_received\":\(str.fromint(s.tokensreceived as i64)),\"active_stage\":\(jx.escape(s.activestage)),\"events\":[\(eventsjson)],\"console_log\":\(consolelog.tojson(s.sessionlog))}"
};

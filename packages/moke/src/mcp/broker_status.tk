
m=moke.mcp.brokerstatus;
i=str:std.string;


m=$serverstatus{
  name:$str;
  transport:$str;      
  url:$str;
  healthy:bool;
  tools:@$str;
  permissions:@$str;
  lastcheck:$str
};

m=$brokerpanelstate{
  initialized:bool;
  servercount:i32;
  healthycount:i32;
  totaltools:i32;
  requestsserved:i64;
  servers:@$serverstatus;
  lastupdated:$str
};


f=newpanelstate():$brokerpanelstate{
  <$brokerpanelstate{
    initialized:false;
    servercount:0;
    healthycount:0;
    totaltools:0;
    requestsserved:0;
    servers:@();
    lastupdated:""
  };
};

f=addserver(state:i64;server:$serverstatus):$brokerpanelstate{
  let servers=state.servers;
  servers.push(server);
  let healthy=state.healthycount;
  if(server.healthy){ healthy=healthy + 1 };
  <$brokerpanelstate{
    initialized:state.initialized;
    servercount:state.servercount + 1;
    healthycount:healthy;
    totaltools:state.totaltools + server.tools.len();
    requestsserved:state.requestsserved;
    servers:servers;
    lastupdated:state.lastupdated
  };
};


f=demoservers():@$serverstatus{
  <@(
    $serverstatus{
      name:"loke-mcp-toke";
      transport:"http";
      url:"http://127.0.0.1:11435";
      healthy:true;
      tools:@("anonymise";"compress";"decompress";"profile";"analyse");
      permissions:@("read";"execute");
      lastcheck:"now"
    };
    $serverstatus{
      name:"loke-memory";
      transport:"http";
      url:"http://127.0.0.1:11436";
      healthy:true;
      tools:@("memory.search";"memory.store";"memory.context";"memory.status";"memory.facts";"memory.diary_write");
      permissions:@("read";"write";"execute");
      lastcheck:"now"
    };
  )
};


f=permissionbadgeclass(permission:$str):$str{
  if(str.eq(permission;"read")){ <"badge-public" };
  if(str.eq(permission;"write")){ <"badge-internal" };
  if(str.eq(permission;"execute")){ <"badge-confidential" };
  <"badge-muted"
};


f=serverstatustojson(s:$serverstatus):$str{
  let healthystr=if(s.healthy):i64{ "true" }el{ "false" };
  let toolsjson=str.concat("[";str.concat(
    str.joinmap(s.tools;|t| str.jsonencode(t));",");"]"));
  let permsjson=str.concat("[";str.concat(
    str.joinmap(s.permissions;|p| str.jsonencode(p));",");"]"));
  <str.concat("{\"name\":";
    str.concat(str.jsonencode(s.name);
    str.concat(",\"transport\":";
    str.concat(str.jsonencode(s.transport);
    str.concat(",\"url\":";
    str.concat(str.jsonencode(s.url);
    str.concat(",\"healthy\":";
    str.concat(healthystr;
    str.concat(",\"tools\":";
    str.concat(toolsjson;
    str.concat(",\"permissions\":";
    str.concat(permsjson;
    str.concat(",\"last_check\":";
    str.concat(str.jsonencode(s.lastcheck);
    "}")))))))))))))))
};

f=panelstatetojson(state:$brokerpanelstate):$str{
  let serverparts=@();
  let si=mut.0;
  if(si < state.servers.len()){
    serverparts.push(serverstatustojson(state.servers.get(si)));
    si=si + 1
  }el{};
  let initstr=if(state.initialized):i64{ "true" }el{ "false" };
  <str.concat("{\"initialized\":";
    str.concat(initstr;
    str.concat(",\"server_count\":";
    str.concat(str.fromi32(state.servercount);
    str.concat(",\"healthy_count\":";
    str.concat(str.fromi32(state.healthycount);
    str.concat(",\"total_tools\":";
    str.concat(str.fromi32(state.totaltools);
    str.concat(",\"requests_served\":";
    str.concat(str.fromi64(state.requestsserved);
    str.concat(",\"last_updated\":";
    str.concat(str.jsonencode(state.lastupdated);
    str.concat(",\"servers\":[";
    str.concat(str.join(serverparts;",");
    "]}")))))))))))))))
};

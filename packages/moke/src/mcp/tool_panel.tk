m=moke.mcp.toolpanel;
i=str:std.str;
i=tools:mcptoke.tools;
i=proto:core.mcp.protocol;
i=jx:shared.jsonobj;


t=$tooldisplay{
  name:str;
  description:str;
  inputschema:str;
  category:str;       
  icon:str
};

t=$toolinvocation{
  toolname:str;
  argsjson:str;
  timestamp:str;
  durationms:i32;
  success:bool;
  resultjson:str;
  error:str
};

t=$toolpanelstate{
  tools:@$tooldisplay;
  invocations:@$toolinvocation;
  totalinvocations:i32
};


(* --- Three faults, one of them a loop that was written as an `if` -----------------
   `str.jsonencode` exists in neither the std.str interface nor the runtime, so every string this
   module put on the wire went out unquoted and unescaped: the JSON was malformed for any value
   containing a quote, a backslash or a newline, and structurally malformed for all of them
   because the quotes themselves were missing. `shared.jsonobj.escape` is the escaper -- std.json
   is not usable for this (T-32).

   `panelstatetojson` and the trim in `addinvocation` used `if(i < arr.len()){ ...; i=i+1 }el{}`
   where a `lp` was meant. Each therefore handled exactly ONE element: the panel JSON listed one
   tool and one invocation however many there were, and the 100-entry trim reduced the history to
   a single entry rather than to its last hundred. Neither raised a diagnostic: a discarded
   `.push` result is legal (T-24), and the `.len()` spelling was not itself a fault -- measured in
   the emitted IR it produces the identical `getelementptr i64, i64* %p, i32 -1` as `.len`.

   `addinvocation(state:i64;...)` read `.invocations`, `.tools` and `.totalinvocations` off an
   integer; it takes a `$toolpanelstate`. *)
f=jsonencode(s:str):str{
  <"\(jx.escape(s))"
};

f=categoryfor(name:str):str{
  if(str.eq(name;"anonymise")){ <"privacy" };
  if(str.eq(name;"analyse")){ <"privacy" };
  if(str.eq(name;"profile")){ <"analysis" };
  <"transform"
};

f=iconfor(name:str):str{
  if(str.eq(name;"compress")){ <"minimize" };
  if(str.eq(name;"decompress")){ <"maximize" };
  if(str.eq(name;"profile")){ <"bar-chart" };
  if(str.eq(name;"analyse")){ <"shield" };
  if(str.eq(name;"anonymise")){ <"eye-off" };
  <"wrench"
};

f=gettooldisplays():@$tooldisplay{
  let mcptools=tools.alltools();
  let displays=mut.@();
  lp(let ti=0;ti<mcptools.len;ti=ti+1){
    let t=mcptools.get(ti);
    displays=displays.push($tooldisplay{
      name:t.name;
      description:t.description;
      inputschema:t.inputschema;
      category:categoryfor(t.name);
      icon:iconfor(t.name)
    })
  };
  <displays
};

f=invoketool(name:str;argsjson:str;presidiourl:str;ollamaurl:str;timestamp:str):$toolinvocation{
  let result=tools.handletool(name;argsjson;presidiourl;ollamaurl);
  if(result.iserror){
    <$toolinvocation{
      toolname:name;
      argsjson:argsjson;
      timestamp:timestamp;
      durationms:0;
      success:false;
      resultjson:"";
      error:result.text
    };
  }el{
    <$toolinvocation{
      toolname:name;
      argsjson:argsjson;
      timestamp:timestamp;
      durationms:0;
      success:true;
      resultjson:result.text;
      error:""
    };
  };
};


f=newpanelstate():$toolpanelstate{
  <$toolpanelstate{
    tools:gettooldisplays();
    invocations:@();
    totalinvocations:0
  };
};

(* Keeps the most recent 100 invocations. *)
f=addinvocation(state:$toolpanelstate;inv:$toolinvocation):$toolpanelstate{
  let invocations=mut.state.invocations.push(inv);
  if(invocations.len > 100){
    let trimmed=mut.@();
    lp(let ti=invocations.len-100;ti<invocations.len;ti=ti+1){
      trimmed=trimmed.push(invocations.get(ti))
    };
    invocations=trimmed
  };
  <$toolpanelstate{
    tools:state.tools;
    invocations:invocations;
    totalinvocations:state.totalinvocations + 1
  };
};


f=tooldisplaytojson(t:$tooldisplay):str{
  <str.concat("{\"name\":";
    str.concat(jsonencode(t.name);
    str.concat(",\"description\":";
    str.concat(jsonencode(t.description);
    str.concat(",\"input_schema\":";
    str.concat(t.inputschema;
    str.concat(",\"category\":";
    str.concat(jsonencode(t.category);
    str.concat(",\"icon\":";
    str.concat(jsonencode(t.icon);
    "}"))))))))))
};

f=invocationtojson(inv:$toolinvocation):str{
  let successstr=mut."false";
  if(inv.success){ successstr="true" }el{};
  <str.concat("{\"tool_name\":";
    str.concat(jsonencode(inv.toolname);
    str.concat(",\"args_json\":";
    str.concat(jsonencode(inv.argsjson);
    str.concat(",\"timestamp\":";
    str.concat(jsonencode(inv.timestamp);
    str.concat(",\"duration_ms\":";
    str.concat(str.fromint(inv.durationms as i64);
    str.concat(",\"success\":";
    str.concat(successstr;
    str.concat(",\"result_json\":";
    str.concat(jsonencode(inv.resultjson);
    str.concat(",\"error\":";
    str.concat(jsonencode(inv.error);
    "}"))))))))))))))
};

f=panelstatetojson(state:$toolpanelstate):str{
  let invparts=mut.@();
  lp(let ii=0;ii<state.invocations.len;ii=ii+1){
    invparts=invparts.push(invocationtojson(state.invocations.get(ii)))
  };
  <panelstatejsonwith(state;invparts;state.totalinvocations as i64)
};

(* MK6.6. The record of an invocation that the shared history keeps: which tool, when, how long
   and whether it succeeded, and NOT its arguments, result or error. The history is now a file
   (moke.panellog) that outlives the request, and a tool such as `anonymise` is handed exactly
   the text a user wants kept private; a panel log is not a reason to write that to disk. The
   caller of POST /api/mcp/invoke still receives the whole invocation. *)
f=historyjson(inv:$toolinvocation):str{
  let successstr=mut."false";
  if(inv.success){ successstr="true" }el{};
  <"{\"tool_name\":\(jsonencode(inv.toolname)),\"args_json\":\"\",\"timestamp\":\(jsonencode(inv.timestamp)),\"duration_ms\":\(inv.durationms as i64),\"success\":\(successstr),\"result_json\":\"\",\"error\":\"\"}"
};

(* MK6.6. The panel's tools, with an invocation history the caller supplies as JSON objects
   already rendered by invocationtojson. page.moke.api.mcp reads that history from
   moke.panellog, which every worker shares, rather than from this process's own state. *)
f=panelstatejsonwith(state:$toolpanelstate;invparts:@str;total:i64):str{
  let toolparts=mut.@();
  lp(let ti=0;ti<state.tools.len;ti=ti+1){
    toolparts=toolparts.push(tooldisplaytojson(state.tools.get(ti)))
  };
  <"{\"tools\":[\(str.join(",";toolparts))],\"invocations\":[\(str.join(",";invparts))],\"total_invocations\":\(total)}"
};

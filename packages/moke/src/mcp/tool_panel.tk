m=moke.mcp.toolpanel;
i=str:std.string;
i=tools:mcptoke.tools;
i=proto:core.mcp.protocol;


t=$tooldisplay{
  name:str;
  description:str;
  inputschema:str;
  category:str;       
  icon:str
};

t=$toolinvocation{
  toolname:str;
  argsjson:str;
  timestamp:str;
  durationms:i32;
  success:bool;
  resultjson:str;
  error:str
};

t=$toolpanelstate{
  tools:@$tooldisplay;
  invocations:@$toolinvocation;
  totalinvocations:i32
};


f=gettooldisplays():@$tooldisplay{
  let mcptools=tools.alltools();
  let displays=@();
  let ti=mut.0;
  lp(let lv=0;ti < mcptools.len();lv=lv){
    let t=mcptools.get(ti);
    let category="transform";
    if(str.eq(t.name;"anonymise")){ category="privacy" };
    if(str.eq(t.name;"analyse")){ category="privacy" };
    if(str.eq(t.name;"profile")){ category="analysis" };
    let icon="wrench";
    if(str.eq(t.name;"compress")){ icon="minimize" };
    if(str.eq(t.name;"decompress")){ icon="maximize" };
    if(str.eq(t.name;"profile")){ icon="bar-chart" };
    if(str.eq(t.name;"analyse")){ icon="shield" };
    if(str.eq(t.name;"anonymise")){ icon="eye-off" };
    displays.push($tooldisplay{
      name:t.name;
      description:t.description;
      inputschema:t.inputschema;
      category:category;
      icon:icon
    });
    ti=ti + 1
  };
  <displays
};

f=invoketool(name:str;argsjson:str;presidiourl:str;ollamaurl:str;timestamp:str):$toolinvocation{
  let result=tools.handletool(name;argsjson;presidiourl;ollamaurl);
  if(result.iserror){
    <$toolinvocation{
      toolname:name;
      argsjson:argsjson;
      timestamp:timestamp;
      durationms:0;
      success:false;
      resultjson:"";
      error:result.text
    };
  }el{
    <$toolinvocation{
      toolname:name;
      argsjson:argsjson;
      timestamp:timestamp;
      durationms:0;
      success:true;
      resultjson:result.text;
      error:""
    };
  };
};


f=newpanelstate():$toolpanelstate{
  <$toolpanelstate{
    tools:gettooldisplays();
    invocations:@();
    totalinvocations:0
  };
};

f=addinvocation(state:i64;inv:$toolinvocation):$toolpanelstate{
  let invocations=mut.state.invocations;
  invocations.push(inv);
  if(invocations.len() > 100){
    let trimmed=@();
    let ti=invocations.len() - 100;
    if(ti < invocations.len()){
      trimmed.push(invocations.get(ti));
      ti=ti + 1
    }el{};
    invocations=trimmed
  };
  <$toolpanelstate{
    tools:state.tools;
    invocations:invocations;
    totalinvocations:state.totalinvocations + 1
  };
};


f=tooldisplaytojson(t:$tooldisplay):str{
  <str.concat("{\"name\":";
    str.concat(str.jsonencode(t.name);
    str.concat(",\"description\":";
    str.concat(str.jsonencode(t.description);
    str.concat(",\"input_schema\":";
    str.concat(t.inputschema;
    str.concat(",\"category\":";
    str.concat(str.jsonencode(t.category);
    str.concat(",\"icon\":";
    str.concat(str.jsonencode(t.icon);
    "}"))))))))))
};

f=invocationtojson(inv:$toolinvocation):str{
  let successstr=mut."false";
  if(inv.success){ successstr="true" }el{};
  <str.concat("{\"tool_name\":";
    str.concat(str.jsonencode(inv.toolname);
    str.concat(",\"args_json\":";
    str.concat(str.jsonencode(inv.argsjson);
    str.concat(",\"timestamp\":";
    str.concat(str.jsonencode(inv.timestamp);
    str.concat(",\"duration_ms\":";
    str.concat(str.fromi32(inv.durationms);
    str.concat(",\"success\":";
    str.concat(successstr;
    str.concat(",\"result_json\":";
    str.concat(str.jsonencode(inv.resultjson);
    str.concat(",\"error\":";
    str.concat(str.jsonencode(inv.error);
    "}"))))))))))))))
};

f=panelstatetojson(state:$toolpanelstate):str{
  let toolparts=@();
  let ti=0;
  if(ti < state.tools.len()){
    toolparts.push(tooldisplaytojson(state.tools.get(ti)));
    ti=ti + 1
  }el{};
  let invparts=@();
  let ii=mut.0;
  if(ii < state.invocations.len()){
    invparts.push(invocationtojson(state.invocations.get(ii)));
    ii=ii + 1
  }el{};
  <str.concat("{\"tools\":[";
    str.concat(str.join(toolparts;",");
    str.concat("],\"invocations\":[";
    str.concat(str.join(invparts;",");
    str.concat("],\"total_invocations\":";
    str.concat(str.fromi32(state.totalinvocations);
    "}"))))))
};

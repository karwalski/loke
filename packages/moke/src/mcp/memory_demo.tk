
m=moke.mcp.memorydemo;
i=str:std.string;
i=mcpmem:core.memory.mcpserver;
i=proto:core.mcp.protocol;


t=$memoryinvocation{
  toolname:$str;
  argsjson:$str;
  timestamp:$str;
  success:bool;
  resultpreview:$str;
  durationms:i32
};

t=$memorydemostate{
  availabletools:@$str;
  invocations:@$memoryinvocation;
  totalinvocations:i32;
  datadir:$str
};


f=newstate(datadir:$str):$memorydemostate{
  <$memorydemostate{
    availabletools:@("memory.search";"memory.store";"memory.status";"memory.facts";"memory.context";"memory.diary_write");
    invocations:@();
    totalinvocations:0;
    datadir:datadir
  };
};


f=invoke(state:i64;toolname:$str;argsjson:$str;timestamp:$str):$memoryinvocation{
  let result=mcpmem.handlememorytool(toolname;argsjson;state.datadir);
  let preview=mut.result.text;
  if(str.len(preview) > 200){
    preview=str.concat(str.slice(preview;0;200);"...")
  };
  <$memoryinvocation{
    toolname:toolname;
    argsjson:argsjson;
    timestamp:timestamp;
    success:!i64;
    resultpreview:preview;
    durationms:0
  };
};


f=recordinvocation(state:i64;inv:$memoryinvocation):$memorydemostate{
  let invocations=mut.state.invocations;
  invocations.push(inv);
  if(invocations.len() > 50){
    let trimmed=@();
    let ti=mut.invocations.len() - 50;
    if(ti < invocations.len()){
      trimmed.push(invocations.get(ti));
      ti=ti + 1
    }el{};
    invocations=trimmed
  };
  <$memorydemostate{
    availabletools:state.availabletools;
    invocations:invocations;
    totalinvocations:state.totalinvocations + 1;
    datadir:state.datadir
  };
};


f=invocationtojson(inv:$memoryinvocation):$str{
  let successstr=if(inv.success){ "true" }el{ "false" };
  <str.concat("{\"tool_name\":";
    str.concat(str.jsonencode(inv.toolname);
    str.concat(",\"args_json\":";
    str.concat(str.jsonencode(inv.argsjson);
    str.concat(",\"timestamp\":";
    str.concat(str.jsonencode(inv.timestamp);
    str.concat(",\"success\":";
    str.concat(successstr;
    str.concat(",\"result_preview\":";
    str.concat(str.jsonencode(inv.resultpreview);
    str.concat(",\"duration_ms\":";
    str.concat(str.fromi32(inv.durationms);
    "}"))))))))))))
};

f=statetojson(state:$memorydemostate):$str{
  let toolparts=@();
  let ti=0;
  if(ti < state.availabletools.len()){
    toolparts.push(str.jsonencode(state.availabletools.get(ti)));
    ti=ti + 1
  }el{};
  let invparts=@();
  let ii=mut.0;
  if(ii < state.invocations.len()){
    invparts.push(invocationtojson(state.invocations.get(ii)));
    ii=ii + 1
  }el{};
  <str.concat("{\"available_tools\":[";
    str.concat(str.join(toolparts;",");
    str.concat("],\"invocations\":[";
    str.concat(str.join(invparts;",");
    str.concat("],\"total_invocations\":";
    str.concat(str.fromi32(state.totalinvocations);
    "}"))))))
};

m=moke.mcp.memorydemo;
i=str:std.str;
i=file:std.file;
i=mcpmem:core.memory.mcpserver;
i=proto:core.mcp.protocol;
i=jx:shared.jsonobj;
i=u8:shared.utf8;


t=$memoryinvocation{
  toolname:str;
  argsjson:str;
  timestamp:str;
  success:bool;
  resultpreview:str;
  durationms:i32
};

t=$memorydemostate{
  availabletools:@str;
  invocations:@$memoryinvocation;
  totalinvocations:i32;
  datadir:str
};


(* --- Four faults, one diagnostic between them -------------------------------------
   `str.jsonencode` exists in neither the std.str interface nor the runtime, so every string this
   module put on the wire went out unquoted and unescaped: the JSON was malformed for any value
   containing a quote, a backslash or a newline, and structurally malformed for all of them
   because the quotes themselves were missing. `shared.jsonobj.escape` is the escaper -- std.json
   is not usable for this (T-32).

   `statetojson` and the trim in `recordinvocation` wrote `if(i < arr.len()){ ...; i=i+1 }el{}`
   where a `lp` was meant, so each handled exactly ONE element: the state JSON listed one of the
   six available tools and one invocation, and the 50-entry trim cut the history to a single
   entry. The `.push` results were discarded (T-24), which raises nothing; the `.len()` spelling
   was harmless -- measured in the emitted IR it produces the identical
   `getelementptr i64, i64* %p, i32 -1` as `.len` -- and reads as property here for consistency.

   `invoke` and `recordinvocation` took `state:i64` and read `.datadir`, `.invocations`,
   `.availabletools` and `.totalinvocations` off it. Both take a `$memorydemostate`.

   `str.slice` is a result, and its value was bound in `invoke` as if it were a plain string. *)
f=jsonencode(s:str):str{
  <"\(jx.escape(s))"
};

f=newstate(datadir:str):$memorydemostate{
  <$memorydemostate{
    availabletools:@("memory.search";"memory.store";"memory.status";"memory.facts";"memory.context";"memory.diary_write");
    invocations:@();
    totalinvocations:0;
    datadir:datadir
  };
};


(* The first 200 BYTES of a reply, marked `...` when cut. The cut is `u8.prefix`, so it stops
   at the last whole character at or before byte 200 and never splits a 2-, 3- or 4-byte
   character (F10.50): a plain `str.slice` left a memory in Japanese or one holding an emoji
   as invalid UTF-8 in the demo's history and its JSON. *)
f=preview200(text:str):str{
  if(str.len(text)<=200){
    <text
  };
  <"\(u8.prefix(text;200))..."
};

(* MK6.6. memory.store, memory.status and memory.context used to kill the worker serving the
   request, and MK6.5 refused them here. Two of the three deaths began in this module's data
   directory: under a fresh HOME `~/.loke/memory` did not exist, the palace's database could not
   open, and core.memory.mcpserver ran on as if it had (T-18). The server now reports a palace
   that does not open, and the directory is created before each call, as loke creates its own.
   file.mkdir makes the parents too; its result is not needed, since the palace's own open is
   what reports a directory that still cannot be used. *)
f=invoke(state:$memorydemostate;toolname:str;argsjson:str;timestamp:str):$memoryinvocation{
  file.mkdir(state.datadir);
  let result=mcpmem.handlememorytool(toolname;argsjson;state.datadir);
  <$memoryinvocation{
    toolname:toolname;
    argsjson:argsjson;
    timestamp:timestamp;
    success:result.iserror == false;
    resultpreview:preview200(result.text);
    durationms:0
  };
};


(* Keeps the most recent 50 invocations. *)
f=recordinvocation(state:$memorydemostate;inv:$memoryinvocation):$memorydemostate{
  let invocations=mut.state.invocations.push(inv);
  if(invocations.len > 50){
    let trimmed=mut.@();
    lp(let ti=invocations.len-50;ti<invocations.len;ti=ti+1){
      trimmed=trimmed.push(invocations.get(ti))
    };
    invocations=trimmed
  };
  <$memorydemostate{
    availabletools:state.availabletools;
    invocations:invocations;
    totalinvocations:state.totalinvocations + 1;
    datadir:state.datadir
  };
};


f=invocationtojson(inv:$memoryinvocation):str{
  let successstr=mut."false"; if(inv.success){ successstr="true" }el{};
  <"{\"tool_name\":\(jsonencode(inv.toolname)),\"args_json\":\(jsonencode(inv.argsjson)),\"timestamp\":\(jsonencode(inv.timestamp)),\"success\":\(successstr),\"result_preview\":\(jsonencode(inv.resultpreview)),\"duration_ms\":\(str.fromint(inv.durationms as i64))}"
};

f=statetojson(state:$memorydemostate):str{
  let invparts=mut.@();
  lp(let ii=0;ii<state.invocations.len;ii=ii+1){
    invparts=invparts.push(invocationtojson(state.invocations.get(ii)))
  };
  <statejsonwith(state;invparts;state.totalinvocations as i64)
};

(* MK6.6. As moke.mcp.toolpanel.historyjson: the shared history keeps which tool ran, when and
   whether it succeeded, never the arguments or the result -- memory.store's argument is the
   memory itself. *)
f=historyjson(inv:$memoryinvocation):str{
  let successstr=mut."false";
  if(inv.success){ successstr="true" }el{};
  <"{\"tool_name\":\(jsonencode(inv.toolname)),\"args_json\":\"\",\"timestamp\":\(jsonencode(inv.timestamp)),\"success\":\(successstr),\"result_preview\":\"\",\"duration_ms\":\(inv.durationms as i64)}"
};

(* MK6.6. As moke.mcp.toolpanel.panelstatejsonwith: the history is supplied, already rendered,
   from moke.panellog, which every worker shares. *)
f=statejsonwith(state:$memorydemostate;invparts:@str;total:i64):str{
  let toolparts=mut.@();
  lp(let ti=0;ti<state.availabletools.len;ti=ti+1){
    toolparts=toolparts.push(jsonencode(state.availabletools.get(ti)))
  };
  <"{\"available_tools\":[\(str.join(",";toolparts))],\"invocations\":[\(str.join(",";invparts))],\"total_invocations\":\(total)}"
};

m=test.moke.feedbackrecord;
i=t:std.test;
i=str:std.str;
i=file:std.file;
i=os:std.os;
i=rec:moke.feedbackrecord;
i=ft:core.feedback.types;
i=fs:core.feedback.store;

(* LS1.4a. moke's /api/feedback read feature_area, model_id, dataset and comment and then
   dropped them, so nothing was stored although X4a.4 says it stores feedback. The handler now
   calls moke.feedbackrecord.save, which writes the row through core.feedback.store into
   loke.db under $HOME/.loke (a throwaway HOME under run_tests). This posts two ratings through
   the production module and reads them back through core.feedback.store, the store's own
   reader, by the id save answered. *)

f=findentry(entries:@$feedbackentry;id:str):i64{
  let at=mut.0-1;
  lp(let i=0;i<entries.len;i=i+1){
    let e:$feedbackentry=entries.get(i);
    if(str.eq(e.id;id)){ at=i }el{}
  };
  <at
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* A fresh database, so the counts below are exact. *)
  file.delete(str.concat(os.getenv("HOME");"/.loke/loke.db"));

  let id1=rec.save("thumbs_down";"chat_response";"req-w93-1";"llama3.2:3b";"it_platform";"the answer missed the second column");
  if(t.assert(str.len(id1)>0;"save answers the id of the row it stored")){pass=pass+1}el{fail=fail+1};
  let id2=rec.save("thumbs_up";"widget_x";"req-w93-2";"qwen2.5:7b";"retail_sales";"");
  if(t.assert(str.len(id2)>0 && !str.eq(id1;id2);"a second rating gets its own id")){pass=pass+1}el{fail=fail+1};

  let all=fs.listall(1);
  if(t.assert(all.len==2;"both ratings are in loke's feedback store")){pass=pass+1}el{fail=fail+1};

  let at1=findentry(all;id1);
  if(t.assert(at1>=0;"the first rating is retrievable by the id save answered")){pass=pass+1}el{fail=fail+1};
  if(at1>=0){
    let e:$feedbackentry=all.get(at1);
    if(t.asserteq(ft.ratinglabel(e.rating);"thumbs_down";"its rating was stored")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(ft.arealabel(e.featurearea);"Chat response";"its feature area was stored, as the store's label")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(e.requestid;"req-w93-1";"its request id was stored")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(e.modelid;"llama3.2:3b";"its model id was stored")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(e.usecase;"it_platform";"its dataset was stored as the use case")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(e.comment;"the answer missed the second column";"its comment was stored")){pass=pass+1}el{fail=fail+1};
  }el{};

  let at2=findentry(all;id2);
  if(t.assert(at2>=0;"the second rating is retrievable too")){pass=pass+1}el{fail=fail+1};
  if(at2>=0){
    let e2:$feedbackentry=all.get(at2);
    if(t.asserteq(ft.ratinglabel(e2.rating);"thumbs_up";"its rating was stored")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(ft.arealabel(e2.featurearea);"Other: widget_x";"an area the store does not name is kept as Other")){pass=pass+1}el{fail=fail+1};
  }el{};

  let downs=fs.thumbsdown(1);
  if(t.assert(downs.len==1;"the store's thumbs-down reader sees exactly the one thumbs-down")){pass=pass+1}el{fail=fail+1};

  <fail
};

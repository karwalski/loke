m=test.moke.routingrequest;
i=t:std.test;
i=str:std.str;
i=rq:moke.routingrequest;

(* LS1.4a. moke's /api/routing read `prompt` and `tolerance` and dropped them: every answer
   said data_analysis at 0.85 and the interactive tier. The handler now takes both through
   moke.routingrequest.inputs, which uses loke's router modules. These assert that a different
   prompt, or a different tolerance, changes the answer. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── The prompt changes the intent ─────────────────────────────────────────── *)
  let hello=rq.inputs("hello there";"PUBLIC";"instant");
  let summ=rq.inputs("please summarise this report";"PUBLIC";"instant");
  let codegen=rq.inputs("implement a parser";"PUBLIC";"instant");
  if(t.asserteq(hello.intent;"chat";"a greeting is classified as chat")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(summ.intent;"summarisation";"a request to summarise is classified as summarisation")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(codegen.intent;"code_generation";"a request to implement is classified as code generation")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.eq(hello.intent;summ.intent);"a different prompt gives a different intent")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(hello.method;"keyword";"the method is keyword: no model is consulted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hello.confidence<summ.confidence;"and the confidence is the classifier's, not a constant")){pass=pass+1}el{fail=fail+1};

  (* ── The prompt can raise the sensitivity, never lower it ──────────────────────── *)
  let secret=rq.inputs("my password is hunter2";"PUBLIC";"instant");
  if(t.asserteq(secret.sensitivity;"RESTRICTED";"a prompt naming a password raises PUBLIC to RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(secret.sensitivityrouting;"local-only";"and a RESTRICTED request is local-only")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(hello.sensitivity;"PUBLIC";"a plain prompt stays at the caller's PUBLIC")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(hello.sensitivityrouting;"prefer-local";"and PUBLIC may use the cloud, preferring local")){pass=pass+1}el{fail=fail+1};
  let floor=rq.inputs("hello there";"CONFIDENTIAL";"instant");
  if(t.asserteq(floor.sensitivity;"CONFIDENTIAL";"the caller's level is a floor the prompt does not lower")){pass=pass+1}el{fail=fail+1};

  (* ── The tolerance changes the tier ───────────────────────────────────────── *)
  let patient=rq.inputs("hello there";"PUBLIC";"patient");
  let background=rq.inputs("hello there";"PUBLIC";"background");
  if(t.asserteq(hello.tier;"interactive";"instant is the interactive tier")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(patient.tier;"considered";"patient is the considered tier")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(background.tier;"background";"background is the background tier")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(patient.tolerance;"patient";"the tolerance asked for is reported back")){pass=pass+1}el{fail=fail+1};

  (* ── Unknown values are recognised as unknown, so the handler can refuse them ─── *)
  if(t.assert(rq.toleranceknown("instant") && rq.toleranceknown("patient") && rq.toleranceknown("background");"the three tolerances are known")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!rq.toleranceknown("whenever");"an unknown tolerance is not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(rq.sensitivityknown("RESTRICTED") && !rq.sensitivityknown("secret");"sensitivity levels are the four names, nothing else")){pass=pass+1}el{fail=fail+1};

  <fail
};

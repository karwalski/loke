m=packages.moke.tests.testtiervisualiser;
i=t:std.test;
i=str:std.str;
i=io:std.io;

(* Local types for self-contained testing *)
t=$tierstats{
  name:str;
  requestcount:i64;
  requestpct:f64;
  modelsused:@str;
  isactive:bool
};

t=$tierreport{
  interactive:$tierstats;
  considered:$tierstats;
  background:$tierstats;
  totalrequests:i64
};

f=newtierstats(name:str):$tierstats{
  <$tierstats{
    name:name;
    requestcount:0;
    requestpct:0.0;
    modelsused:@();
    isactive:false
  }
};

f=newreport():$tierreport{
  <$tierreport{
    interactive:newtierstats("interactive");
    considered:newtierstats("considered");
    background:newtierstats("background");
    totalrequests:0
  }
};

f=addmodel(stats:$tierstats;model:str):$tierstats{
  <$tierstats{
    name:stats.name;
    requestcount:stats.requestcount;
    requestpct:stats.requestpct;
    modelsused:str.arraypush(stats.modelsused;model);
    isactive:stats.isactive
  }
};

f=incrementtier(stats:$tierstats):$tierstats{
  <$tierstats{
    name:stats.name;
    requestcount:stats.requestcount + 1;
    requestpct:stats.requestpct;
    modelsused:stats.modelsused;
    isactive:stats.isactive
  }
};

f=recalculatepct(stats:$tierstats;total:i64):$tierstats{
  let pct=mut.0.0;
  if(total > 0){ pct=((stats.requestcount as f64) / (total as f64)) * 100.0 }el{};
  <$tierstats{
    name:stats.name;
    requestcount:stats.requestcount;
    requestpct:pct;
    modelsused:stats.modelsused;
    isactive:stats.isactive
  }
};

f=tiertojson(stats:$tierstats):str{
  let activestr=mut."false";
  if(stats.isactive){ activestr="true" }el{};
  let json=str.concat("{\"name\":\"";str.concat(stats.name;str.concat("\",\"request_count\":";str.concat(str.fromi64(stats.requestcount);str.concat(",\"request_pct\":";str.concat(str.fromf64(stats.requestpct);str.concat(",\"is_active\":";str.concat(activestr;"}"))))))));

  <json
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: new tier stats has correct name *)
  let ts=newtierstats("interactive");
  if(str.eq(ts.name;"interactive")){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 1")};

  (* test: new tier stats starts at zero requests *)
  if(ts.requestcount = 0){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 2")};

  (* test: new tier stats starts at zero pct *)
  if(ts.requestpct = 0.0){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 3")};

  (* test: report creates three tiers *)
  let r=newreport();
  if(str.eq(r.interactive.name;"interactive")){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 4")};
  if(str.eq(r.considered.name;"considered")){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 5")};
  if(str.eq(r.background.name;"background")){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 6")};

  (* test: percentage calculation with one tier *)
  let ts2=incrementtier(ts);
  let ts3=recalculatepct(ts2;1);
  if(ts3.requestpct = 100.0){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 7")};

  (* test: percentage calculation with multiple *)
  let ts4=recalculatepct(ts2;4);
  if(ts4.requestpct = 25.0){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 8")};

  (* test: add model builds array *)
  let ts5=addmodel(ts;"llama3.2:3b");
  let ts6=addmodel(ts5;"mistral:7b");
  if((ts6.modelsused.len as i64) = 2){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 9")};

  (* test: JSON serialisation produces valid output *)
  let json=tiertojson(ts3);
  if(str.contains(json;"\"name\":\"interactive\"")){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 10")};
  if(str.contains(json;"\"request_count\":1")){pass=pass+1}el{fail=fail+1;io.println("FAIL assertion 11")};

  <fail
};

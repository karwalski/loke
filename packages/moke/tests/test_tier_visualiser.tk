m=packages.moke.tests.testtiervisualiser;

i=t:std.test;
i=str:std.str;
i=tv:moke.tiervisualiser;

(* X7.2 - the three latency tiers, through the real moke.tiervisualiser. The file used to
   declare its own tier type and assert it against itself. Against the real module, tiertojson
   put every string on the wire doubly quoted, so this checks the JSON exactly. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let v:$tiervisual=tv.buildvisual("considered";"M2 Pro, 16 GB");
  let i1:$tierinfo=v.interactive;
  let c1:$tierinfo=v.considered;
  let b1:$tierinfo=v.background;
  if(t.assert(c1.isactive && !i1.isactive && !b1.isactive;"exactly the named tier is active")){pass=pass+1}el{fail=fail+1};
  if(t.assert(i1.estimatedtoks>c1.estimatedtoks && c1.estimatedtoks>b1.estimatedtoks;"the tiers get slower in order")){pass=pass+1}el{fail=fail+1};
  if(t.assert(i1.recommendedmodels.len==3 && b1.recommendedmodels.len==3;"each recommends three models")){pass=pass+1}el{fail=fail+1};
  let none:$tiervisual=tv.buildvisual("warp";"x");
  let ni:$tierinfo=none.interactive;
  let nc:$tierinfo=none.considered;
  let nb:$tierinfo=none.background;
  if(t.assert(!ni.isactive && !nc.isactive && !nb.isactive;"an unknown tier name activates none")){pass=pass+1}el{fail=fail+1};

  let tj=tv.tiertojson(i1);
  if(t.assert(str.startswith(tj;"{\"name\":\"interactive\",\"label\":\"Interactive (instant)\"");"a tier serialises each string quoted once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(tj;"[\"llama3.2:3b\",\"qwen2.5:0.5b\",\"phi-3:mini\"]");"with its models as a string array")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(tj;"\"\"");"and no doubled quote anywhere")){pass=pass+1}el{fail=fail+1};
  let vj=tv.tojson(v);
  if(t.assert(str.contains(vj;"\"active_tier\":\"considered\"") && str.contains(vj;"\"hardware_summary\":\"M2 Pro, 16 GB\"");"the visual names the active tier and the hardware")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(vj;"\"\"");"with no doubled quote")){pass=pass+1}el{fail=fail+1};

  <fail
}

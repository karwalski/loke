m=packages.moke.tests.testcostcomparison;

i=t:std.test;
i=str:std.str;
i=cc:moke.costcomparison;

(* X7.2 - what a request would have cost in the cloud, through the real moke.costcomparison.
   The file used to declare its own cost type and arithmetic. Costs are read from compute's
   struct fields, never from estimatecloudcost's bare f64 return, which T-20 corrupts across a
   module boundary. *)

f=near(a:f64;b:f64):bool{
  let d=a-b;
  <d<0.0000001 && d>(0.0-0.0000001)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let s:$costcomparison=cc.compute("claude-3-5-sonnet-20241022";1000 as i32;1000 as i32;true);
  if(t.assert(near(s.cloudcostusd;0.018);"1 000 tokens each way on Sonnet is $0.003 + $0.015")){pass=pass+1}el{fail=fail+1};
  if(t.assert(near(s.localcostusd;0.0);"a local run costs nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(near(s.savedusd;0.018);"so running it locally saves the cloud cost")){pass=pass+1}el{fail=fail+1};
  let r:$costcomparison=cc.compute("claude-3-5-sonnet-20241022";1000 as i32;1000 as i32;false);
  if(t.assert(near(r.savedusd;0.0);"a cloud run saves nothing")){pass=pass+1}el{fail=fail+1};
  let small:$costcomparison=cc.compute("gpt-4o";999 as i32;0 as i32;false);
  if(t.assert(small.cloudcostusd>0.0049 && small.cloudcostusd<0.0050;"999 tokens is costed, not rounded to zero by an integer divide")){pass=pass+1}el{fail=fail+1};
  let mini:$costcomparison=cc.compute("gpt-4o-mini";1000 as i32;1000 as i32;false);
  if(t.assert(near(mini.cloudcostusd;0.00075);"gpt-4o-mini is priced as itself, not as gpt-4o")){pass=pass+1}el{fail=fail+1};

  let acc=cc.accumulate(cc.accumulate(cc.newsessionsavings();s);r);
  if(t.assert(acc.requestcount==(2 as i32) && acc.localrequestcount==(1 as i32);"the session counts requests, and local ones")){pass=pass+1}el{fail=fail+1};
  if(t.assert(near(acc.totalsaved;0.018) && near(acc.totalcloudcost;0.036);"and sums what was saved and what the cloud would have cost")){pass=pass+1}el{fail=fail+1};

  let j=cc.comparisontojson(s);
  if(t.assert(str.contains(j;"\"model_id\":\"claude-3-5-sonnet-20241022\"") && !str.contains(j;"\"\"");"the comparison serialises its model quoted once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"is_local\":true") && str.contains(j;"\"tokens_in\":1000");"with its locality and token counts")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cc.savingstojson(acc);"\"request_count\":2");"and the session totals serialise")){pass=pass+1}el{fail=fail+1};

  <fail
}

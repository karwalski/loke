m=packages.moke.tests.testapiuploadhandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.upload handler structure.
   The handler imports std.http, std.json, std.string, and moke.upload,
   exposes a post function that parses CSV uploads with validation. *)

t=$handlerinfo{
  modulename:str;
  haspost:bool;
  importshttp:bool;
  importsjson:bool;
  importsupload:bool
};

f=describeuploadapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.upload";
    haspost:true;
    importshttp:true;
    importsjson:true;
    importsupload:true
  }
};

f=validatebody(body:str):str{
  if(str.len(str.trim(body)) = 0){
    <"error:empty"
  };
  <"ok"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describeuploadapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.upload")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes POST function *)
  if(info.haspost){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.json *)
  if(info.importsjson){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.upload *)
  if(info.importsupload){pass=pass+1}el{fail=fail+1};

  (* test: empty body is rejected *)
  let r1=validatebody("");
  if(str.eq(r1;"error:empty")){pass=pass+1}el{fail=fail+1};

  (* test: whitespace-only body is rejected *)
  let r2=validatebody("   ");
  if(str.eq(r2;"error:empty")){pass=pass+1}el{fail=fail+1};

  (* test: non-empty body is accepted *)
  let r3=validatebody("name,age\nAlice,30");
  if(str.eq(r3;"ok")){pass=pass+1}el{fail=fail+1};

  <fail
};

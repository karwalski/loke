m=packages.moke.tests.testroutingexplainer;
i=t:std.test;
i=str:std.str;

(* Stub types for routing decision explanation *)
t=$routingdecision{
  model:str;
  provider:str;
  reason:str;
  sensitivity:str;
  islocal:bool
};

(* Sensitivity levels *)
f=sensitivitylabel(level:i64):str{
  if(level = 0){<"public"}el{
  if(level = 1){<"internal"}el{
  if(level = 2){<"confidential"}el{
  if(level = 3){<"restricted"}el{
  <"unknown"
  }}}}
};

(* Stub: format routing decision as human-readable string *)
f=formatdecision(d:$routingdecision):str{
  let locality=mut."remote";
  if(d.islocal){ locality="local" }el{};
  <str.concat("Routed to ";str.concat(d.model;str.concat(" (";str.concat(d.provider;str.concat(", ";str.concat(locality;str.concat(") — ";str.concat(d.reason;str.concat(" [";str.concat(d.sensitivity;"]"))))))))))
};

(* Stub: build a routing decision *)
f=builddecision(model:str;provider:str;reason:str;sensitivitylevel:i64;islocal:bool):$routingdecision{
  <$routingdecision{
    model:model;
    provider:provider;
    reason:reason;
    sensitivity:sensitivitylabel(sensitivitylevel);
    islocal:islocal
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: sensitivity label public *)
  if(t.assert(str.eq(sensitivitylabel(0);"public");"level 0 is public")){pass=pass+1}el{fail=fail+1};

  (* test: sensitivity label internal *)
  if(t.assert(str.eq(sensitivitylabel(1);"internal");"level 1 is internal")){pass=pass+1}el{fail=fail+1};

  (* test: sensitivity label confidential *)
  if(t.assert(str.eq(sensitivitylabel(2);"confidential");"level 2 is confidential")){pass=pass+1}el{fail=fail+1};

  (* test: sensitivity label restricted *)
  if(t.assert(str.eq(sensitivitylabel(3);"restricted");"level 3 is restricted")){pass=pass+1}el{fail=fail+1};

  (* test: sensitivity label unknown for out-of-range *)
  if(t.assert(str.eq(sensitivitylabel(99);"unknown");"level 99 is unknown")){pass=pass+1}el{fail=fail+1};

  (* test: routing decision formatting contains model *)
  let d=builddecision("llama3";"ollama";"PII detected";2;true);
  let formatted=formatdecision(d);
  if(t.assert(str.contains(formatted;"llama3");"formatted contains model")){pass=pass+1}el{fail=fail+1};

  (* test: routing decision formatting contains provider *)
  if(t.assert(str.contains(formatted;"ollama");"formatted contains provider")){pass=pass+1}el{fail=fail+1};

  (* test: routing decision formatting contains reason *)
  if(t.assert(str.contains(formatted;"PII detected");"formatted contains reason")){pass=pass+1}el{fail=fail+1};

  (* test: routing decision formatting contains sensitivity *)
  if(t.assert(str.contains(formatted;"confidential");"formatted contains sensitivity")){pass=pass+1}el{fail=fail+1};

  (* test: routing decision formatting shows local *)
  if(t.assert(str.contains(formatted;"local");"formatted shows local")){pass=pass+1}el{fail=fail+1};

  (* test: remote decision formatting *)
  let d2=builddecision("gpt-4o";"openai";"low sensitivity";0;false);
  let formatted2=formatdecision(d2);
  if(t.assert(str.contains(formatted2;"remote");"remote decision shows remote")){pass=pass+1}el{fail=fail+1};

  (* test: decision preserves sensitivity from level *)
  if(t.assert(str.eq(d.sensitivity;"confidential");"decision has confidential sensitivity")){pass=pass+1}el{fail=fail+1};

  <fail
};

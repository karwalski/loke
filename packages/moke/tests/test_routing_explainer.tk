m=packages.moke.tests.testroutingexplainer;

i=t:std.test;
i=str:std.str;
i=re:moke.routingexplainer;

(* X4b.14 / X7.2 - the routing decision trace, through the real moke.routingexplainer.

   This file used to declare its own $routingdecision and format function and assert them
   against themselves. Against the real module, the first thing the JSON check caught was
   that every string in tojson's output was doubly quoted ("request_id":""req-1""), so the
   /api/routing response was not JSON. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let d0=re.newdecision("req-7");
  let d1=re.withintent(d0;"summarisation";0.85;"keyword");
  let d2=re.withsensitivity(d1;"CONFIDENTIAL";"local-only");
  let d3=re.withselection(d2;"qwen2.5:7b";"ollama";true;"interactive";"local-only because of an email address";0.0);

  if(t.asserteq(d3.requestid;"req-7";"the decision keeps its request id")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(d3.intent;"summarisation";"the intent it was given")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(d3.sensitivity;"CONFIDENTIAL";"the sensitivity")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(d3.modelid;"qwen2.5:7b";"and the selection")){pass=pass+1}el{fail=fail+1};
  if(t.assert(d3.islocal;"marked local")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(d0.modelid;"";"each step returns a new decision and leaves the old one as it was")){pass=pass+1}el{fail=fail+1};

  let j=re.tojson(d3);
  if(t.assert(str.contains(j;"\"request_id\":\"req-7\"");"tojson puts each string on the wire quoted once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(j;"\"\"");"with no doubled quote anywhere")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"model_id\":\"qwen2.5:7b\"") && str.contains(j;"\"is_local\":true");"the selection and its locality")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"sensitivity_routing\":\"local-only\"");"and the routing rule the sensitivity applied")){pass=pass+1}el{fail=fail+1};
  let q=re.tojson(re.withselection(d2;"m";"p";false;"t";"said \"no\"";0.0));
  if(t.assert(str.contains(q;"\"reason\":\"said \\\"no\\\"\"");"a quote inside a value is escaped")){pass=pass+1}el{fail=fail+1};

  <fail
}

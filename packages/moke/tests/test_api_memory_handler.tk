m=packages.moke.tests.testapimemoryhandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.memory handler structure.
   The handler imports std.http, std.json, std.string, and std,
   exposes get and post functions. POST supports store and aaak actions,
   with validation for required content field. *)

t=$handlerinfo{
  modulename:str;
  hasget:bool;
  haspost:bool;
  importshttp:bool;
  importsjson:bool
};

t=$actionresult{
  valid:bool;
  reason:str
};

f=describememoryapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.memory";
    hasget:true;
    haspost:true;
    importshttp:true;
    importsjson:true
  }
};

f=validateaction(action:str;content:str):$actionresult{
  if(str.eq(action;"store")){
    if(str.eq(content;"")){
      <$actionresult{valid:false;reason:"missing content"}
    };
    <$actionresult{valid:true;reason:"ok"}
  };
  if(str.eq(action;"aaak")){
    <$actionresult{valid:true;reason:"ok"}
  };
  <$actionresult{valid:false;reason:"unknown action"}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describememoryapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.memory")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes GET function *)
  if(info.hasget){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes POST function *)
  if(info.haspost){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.json *)
  if(info.importsjson){pass=pass+1}el{fail=fail+1};

  (* test: store action with content is valid *)
  let r1=validateaction("store";"some memory content");
  if(r1.valid){pass=pass+1}el{fail=fail+1};

  (* test: store action without content is rejected *)
  let r2=validateaction("store";"");
  if(!r2.valid){pass=pass+1}el{fail=fail+1};
  if(str.eq(r2.reason;"missing content")){pass=pass+1}el{fail=fail+1};

  (* test: aaak action is valid *)
  let r3=validateaction("aaak";"");
  if(r3.valid){pass=pass+1}el{fail=fail+1};

  (* test: unknown action is rejected *)
  let r4=validateaction("delete";"");
  if(!r4.valid){pass=pass+1}el{fail=fail+1};
  if(str.eq(r4.reason;"unknown action")){pass=pass+1}el{fail=fail+1};

  <fail
};

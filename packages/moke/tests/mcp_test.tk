m=test.moke.mcptest;
i=toolpanel:moke.mcp.toolpanel;
i=broker:moke.mcp.brokerstatus;
i=memory:moke.mcp.memorydemo;
i=assert:std.assert;


f=testgettooldisplays():i64{
  let displays=toolpanel.gettooldisplays();
  assert.true(displays.len() > 5;"should have at least 5 tools (anonymise, compress, decompress, profile, analyse)")
};

f=testtooldisplaycategories():i64{
  let displays=toolpanel.gettooldisplays();
  let hasprivacy=false;
  let hastransform=false;
  let hasanalysis=false;
  lp(let di=0;di < displays.len();di=di + 1){
    let d=displays.get(di);
    if(str.eq(d.category;"privacy")){ hasprivacy=true }el{};
    if(str.eq(d.category;"transform")){ hastransform=true }el{};
    if(str.eq(d.category;"analysis")){ hasanalysis=true }el{}
  };
  assert.true(hasprivacy;"should have privacy category tools");
  assert.true(hastransform;"should have transform category tools");
  assert.true(hasanalysis;"should have analysis category tools")
};

f=testnewpanelstate():i64{
  let state=mut.toolpanel.newpanelstate();
  assert.true(state.tools.len() > 5;"panel should have tools");
  assert.eq(state.totalinvocations;0;"should start with 0 invocations");
  assert.eq(state.invocations.len();0;"invocation list should be empty")
};

f=testaddinvocation():i64{
  let state=toolpanel.newpanelstate();
  let inv=toolpanel.$toolinvocation{
    toolname:"compress";
    argsjson:"{\"json\":\"{}\"}";
    timestamp:"now";
    durationms:50;
    success:true;
    resultjson:"{\"toon\":\"...\"}";
    error:""
  };
  let state=toolpanel.addinvocation(state;inv);
  assert.eq(state.totalinvocations;1;"should have 1 invocation");
  assert.eq(state.invocations.len();1;"invocation list should have 1 entry")
};

f=testtooldisplaytojson():i64{
  let display=toolpanel.$tooldisplay{
    name:"compress";
    description:"Convert JSON to TOON";
    inputschema:"{\"type\":\"object\"}";
    category:"transform";
    icon:"minimize"
  };
  let json=toolpanel.tooldisplaytojson(display);
  assert.contains(json;"\"name\"";"JSON should contain name");
  assert.contains(json;"\"compress\"";"JSON should contain tool name");
  assert.contains(json;"\"category\"";"JSON should contain category")
};

f=testinvocationtojson():i64{
  let inv=toolpanel.$toolinvocation{
    toolname:"analyse";argsjson:"{}";timestamp:"now";
    durationms:10;success:true;resultjson:"{\"ok\":true}";error:""
  };
  let json=toolpanel.invocationtojson(inv);
  assert.contains(json;"\"tool_name\"";"JSON should contain tool_name");
  assert.contains(json;"\"success\":true";"JSON should show success true")
};

f=testpanelstatetojson():i64{
  let state=toolpanel.newpanelstate();
  let json=toolpanel.panelstatetojson(state);
  assert.contains(json;"\"tools\"";"JSON should contain tools array");
  assert.contains(json;"\"invocations\"";"JSON should contain invocations array");
  assert.contains(json;"\"total_invocations\"";"JSON should contain total count")
};


f=testnewbrokerpanel():i64{
  let state=broker.newpanelstate();
  assert.eq(state.servercount;0;"should start with 0 servers");
  assert.eq(state.healthycount;0;"should start with 0 healthy");
  assert.false(state.initialized;"should start uninitialised")
};

f=testaddserver():i64{
  let state=broker.newpanelstate();
  let server=broker.$serverstatus{
    name:"test-server";transport:"http";url:"http://localhost:8080";
    healthy:true;tools:@("tool1";"tool2");permissions:@("read";"execute");
    lastcheck:"now"
  };
  let state=broker.addserver(state;server);
  assert.eq(state.servercount;1;"should have 1 server");
  assert.eq(state.healthycount;1;"should have 1 healthy");
  assert.eq(state.totaltools;2;"should have 2 tools")
};

f=testaddunhealthyserver():i64{
  let state=broker.newpanelstate();
  let server=broker.$serverstatus{
    name:"down-server";transport:"stdio";url:"";
    healthy:false;tools:@("tool1");permissions:@("read");
    lastcheck:"now"
  };
  let state=broker.addserver(state;server);
  assert.eq(state.servercount;1;"should have 1 server");
  assert.eq(state.healthycount;0;"unhealthy server should not count")
};

f=testdemoservers():i64{
  let servers=broker.demoservers();
  assert.eq(servers.len();2;"should have 2 demo servers");
  assert.eq(servers.get(0).name;"loke-mcp-toke";"first should be loke-mcp-toke");
  assert.eq(servers.get(1).name;"loke-memory";"second should be loke-memory")
};

f=testpermissionbadgeclass():i64{
  assert.eq(broker.permissionbadgeclass("read");"badge-public";"read should be public badge");
  assert.eq(broker.permissionbadgeclass("write");"badge-internal";"write should be internal badge");
  assert.eq(broker.permissionbadgeclass("execute");"badge-confidential";"execute should be confidential badge");
  assert.eq(broker.permissionbadgeclass("unknown");"badge-muted";"unknown should be muted badge")
};

f=testbrokerpaneltojson():i64{
  let state=broker.newpanelstate();
  let server=broker.$serverstatus{
    name:"test";transport:"http";url:"http://localhost";
    healthy:true;tools:@("t1");permissions:@("read");lastcheck:"now"
  };
  let state=broker.addserver(state;server);
  let json=broker.panelstatetojson(state);
  assert.contains(json;"\"server_count\"";"JSON should contain server_count");
  assert.contains(json;"\"servers\"";"JSON should contain servers array");
  assert.contains(json;"\"healthy_count\"";"JSON should contain healthy_count")
};


f=testnewmemorystate():i64{
  let state=memory.newstate("/tmp/test-memory");
  assert.eq(state.availabletools.len();6;"should have 6 memory tools");
  assert.eq(state.totalinvocations;0;"should start at 0 invocations");
  assert.eq(state.datadir;"/tmp/test-memory";"data_dir should match")
};

f=testrecordmemoryinvocation():i64{
  let state=memory.newstate("/tmp/test");
  let inv=memory.$memoryinvocation{
    toolname:"memory.status";argsjson:"{}";timestamp:"now";
    success:true;resultpreview:"{\"total_drawers\":5}";durationms:10
  };
  let state=memory.recordinvocation(state;inv);
  assert.eq(state.totalinvocations;1;"should have 1 invocation");
  assert.eq(state.invocations.len();1;"invocation list should have 1")
};

f=testmemoryinvocationtojson():i64{
  let inv=memory.$memoryinvocation{
    toolname:"memory.search";argsjson:"{\"query\":\"test\",\"limit\":5}";
    timestamp:"now";success:true;resultpreview:"[{\"drawer_id\":\"abc\"}]";durationms:25
  };
  let json=memory.invocationtojson(inv);
  assert.contains(json;"\"tool_name\"";"JSON should contain tool_name");
  assert.contains(json;"\"memory.search\"";"JSON should contain tool name");
  assert.contains(json;"\"success\":true";"JSON should show success")
};

f=testmemorystatetojson():i64{
  let state=memory.newstate("/tmp/test");
  let json=memory.statetojson(state);
  assert.contains(json;"\"available_tools\"";"JSON should contain available_tools");
  assert.contains(json;"\"invocations\"";"JSON should contain invocations");
  assert.contains(json;"\"total_invocations\"";"JSON should contain total count")
};

f=testmemoryinvocationlistlimit():i64{
  let state=memory.newstate("/tmp/test");
  lp(let i=0;i < 60;i=i + 1){
    let inv=memory.$memoryinvocation{
      toolname:"memory.status";argsjson:"{}";timestamp:"now";
      success:true;resultpreview:"ok";durationms:1
    };
    state=memory.recordinvocation(state;inv)
  };
  assert.eq(state.totalinvocations;60;"total should be 60");
  assert.true(state.invocations.len() <= 50;"should trim to max 50 entries")
};

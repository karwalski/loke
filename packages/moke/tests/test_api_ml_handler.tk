m=packages.moke.tests.testapimlhandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.ml handler structure.
   The handler imports std.http, std.json, std.string, moke.ml.engine,
   and moke.ml.proposal. Exposes postrun and postpropose functions.
   Supports kinds: kmeans, zscore, iqr, correlation. *)

t=$handlerinfo{
  modulename:str;
  haspostrun:bool;
  haspostpropose:bool;
  importshttp:bool;
  importsjson:bool;
  importsengine:bool;
  importsproposal:bool
};

f=describemlapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.ml";
    haspostrun:true;
    haspostpropose:true;
    importshttp:true;
    importsjson:true;
    importsengine:true;
    importsproposal:true
  }
};

f=validatekind(kind:str):str{
  if(str.eq(kind;"")){
    <"error:missing"
  };
  if(str.eq(kind;"kmeans")){<"ok"};
  if(str.eq(kind;"zscore")){<"ok"};
  if(str.eq(kind;"iqr")){<"ok"};
  if(str.eq(kind;"correlation")){<"ok"};
  <"error:unknown"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describemlapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.ml")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes postrun function *)
  if(info.haspostrun){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes postpropose function *)
  if(info.haspostpropose){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.ml.engine *)
  if(info.importsengine){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.ml.proposal *)
  if(info.importsproposal){pass=pass+1}el{fail=fail+1};

  (* test: empty kind is rejected *)
  let r1=validatekind("");
  if(str.eq(r1;"error:missing")){pass=pass+1}el{fail=fail+1};

  (* test: kmeans kind is accepted *)
  let r2=validatekind("kmeans");
  if(str.eq(r2;"ok")){pass=pass+1}el{fail=fail+1};

  (* test: zscore kind is accepted *)
  let r3=validatekind("zscore");
  if(str.eq(r3;"ok")){pass=pass+1}el{fail=fail+1};

  (* test: iqr kind is accepted *)
  let r4=validatekind("iqr");
  if(str.eq(r4;"ok")){pass=pass+1}el{fail=fail+1};

  (* test: correlation kind is accepted *)
  let r5=validatekind("correlation");
  if(str.eq(r5;"ok")){pass=pass+1}el{fail=fail+1};

  (* test: unknown kind is rejected *)
  let r6=validatekind("pca");
  if(str.eq(r6;"error:unknown")){pass=pass+1}el{fail=fail+1};

  <fail
};

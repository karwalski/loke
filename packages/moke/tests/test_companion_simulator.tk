m=packages.moke.tests.testcompanionsimulator;

i=t:std.test;
i=str:std.str;
i=cs:moke.companionsimulator;

(* X4b.14 - the companion simulator the moke demo shows while F8 is unbuilt.

   The row names "cluster status, model list". The simulator has neither: it models one
   device, a scan-discover-pair-offload state machine, and the model offloaded to it. Those
   are what it reports, so they are what this asserts: the device's status, each transition,
   the offloaded model, and the JSON it puts on the wire, including escaping. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let s0=cs.newsession();
  if(t.asserteq(cs.statelabel(s0.state);"Idle";"a new session is idle")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s0.events.len==1;"with one event")){pass=pass+1}el{fail=fail+1};
  let d:$simulateddevice=s0.device;
  if(t.asserteq(d.name;"Mac Studio (Office)";"the simulated device has a name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(d.gpuvramgb>0.0 && d.estimatedtoks>0.0;"and a capacity")){pass=pass+1}el{fail=fail+1};

  let s1=cs.startscan(s0);
  if(t.asserteq(cs.statelabel(s1.state);"Scanning...";"scanning")){pass=pass+1}el{fail=fail+1};
  let s2=cs.discover(s1);
  if(t.asserteq(cs.statelabel(s2.state);"Device Found";"then the device is found")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(s2.events.get(2);"Mac Studio (Office)");"and the discovery event names it")){pass=pass+1}el{fail=fail+1};
  let s3=cs.completepairing(cs.startpairing(s2));
  if(t.asserteq(cs.statelabel(s3.state);"Paired";"then it pairs")){pass=pass+1}el{fail=fail+1};
  let s4=cs.startoffload(s3;"qwen2.5:72b");
  if(t.asserteq(cs.statelabel(s4.state);"Offloading...";"then offloads")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(s4.offloadmodel;"qwen2.5:72b";"the model being offloaded is recorded")){pass=pass+1}el{fail=fail+1};
  let s5=cs.completeoffload(s4;512 as i32;2400);
  if(t.asserteq(cs.statelabel(s5.state);"Complete";"and it completes")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s5.offloadtokens==(512 as i32) && s5.offloaddurationms==2400;"with its tokens and duration")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s5.events.len==7;"one event per transition, none lost")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(s5.events.get(6);"512 tokens in 2400ms");"and the last event reports the result")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cs.statelabel(s0.state);"Idle";"each transition returns a new session and leaves the old one as it was")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cs.statelabel(7);"Error";"the error state has a label")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cs.statelabel(99);"Unknown";"and an out-of-range state is Unknown, not a crash")){pass=pass+1}el{fail=fail+1};

  let j=cs.tojson(s5);
  if(t.assert(str.startswith(j;"{\"state\":\"Complete\"");"tojson leads with the state label")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"offload_model\":\"qwen2.5:72b\"");"carries the offloaded model")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"offload_tokens\":512") && str.contains(j;"\"offload_duration_ms\":2400");"its figures as numbers")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"name\":\"Mac Studio (Office)\"");"and the device")){pass=pass+1}el{fail=fail+1};
  let q=cs.startoffload(s3;"odd\"model");
  let qj=cs.tojson(q);
  if(t.assert(str.contains(qj;"\"offload_model\":\"odd\\\"model\"");"a quote in a model id is escaped, so the JSON stays well formed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(qj;"]}");"and the object closes after the events")){pass=pass+1}el{fail=fail+1};

  <fail
}

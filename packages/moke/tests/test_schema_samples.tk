m=packages.moke.tests.testschemasamples;

i=t:std.test;
i=str:std.str;
i=hooks:moke.hooks;

(* MK21.18: what the schema-first profile sent to the model may reveal. Six rows. `who`
   holds six different names, so it counts as "categorical" (under 20 unique) while every
   value identifies someone. `notes` is free text that names a person in its cells, and its
   column name looks harmless. `state` genuinely repeats. `amount` is numeric. Only the last
   two may show samples. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let csv="id,who,notes,state,amount\n1,Alice Nguyen,called Priya about the refund,NSW,12.50\n2,Bob Okafor,left voicemail for Tom,VIC,8.00\n3,Carla Russo,met Mohammed at branch,NSW,30.25\n4,Dev Patel,emailed Sarah the form,NSW,4.75\n5,Erin Walsh,no answer,VIC,19.99\n6,Farid Khan,sent to Jim for review,NSW,7.10";
  let r=hooks.applyschemafirst(csv;"contacts");
  let out=r.transformed;
  if(t.assert(r.rawdatadetected;"the CSV is recognised as raw data and replaced by a schema profile")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(out;"Alice") && !str.contains(out;"Okafor") && !str.contains(out;"Farid");"no name from the categorical-but-unique column reaches the model")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(out;"Priya") && !str.contains(out;"voicemail") && !str.contains(out;"Mohammed");"no free-text cell reaches the model, whatever the column is called")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"NSW");"a genuinely repeating category still shows its values")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"12.5") || str.contains(out;"8.0") || str.contains(out;"30.25");"and a numeric column still shows samples")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"who(") && str.contains(out;"notes(");"the suppressed columns are still described: name, type and cardinality")){pass=pass+1}el{fail=fail+1};
  <fail
};

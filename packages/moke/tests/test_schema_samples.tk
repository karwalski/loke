m=packages.moke.tests.testschemasamples;

i=t:std.test;
i=str:std.str;
i=hooks:moke.hooks;

(* NC1.2 (was MK21.18): the schema-first profile sent to the model carries no value from the
   data. MK21.18 suppressed samples for names and free text but still sent a repeating
   category's values and a numeric column's samples and min/max/mean. NC1.2's acceptance is
   the sentinel: `SENTINEL-7Q` occurs once in the dataset and zero times in the profile. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let r=hooks.applyschemafirst("id,who,notes,state,amount\n1,Alice Nguyen,called Priya about the refund,NSW,12.50\n2,Bob Okafor,left voicemail for Tom,VIC,8.00\n3,Carla Russo,met Mohammed at branch,SENTINEL-7Q,30.25\n4,Dev Patel,emailed Sarah the form,NSW,4.75\n5,Erin Walsh,no answer,VIC,19.99\n6,Farid Khan,sent to Jim for review,NSW,7.10";"contacts");
  let out=r.transformed;
  if(t.assert(r.rawdatadetected;"the CSV is recognised as raw data and replaced by a schema profile")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(out;"Alice") && !str.contains(out;"Okafor") && !str.contains(out;"Farid");"no name from the categorical-but-unique column reaches the model")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(out;"Priya") && !str.contains(out;"voicemail") && !str.contains(out;"Mohammed");"no free-text cell reaches the model, whatever the column is called")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(out;"SENTINEL-7Q");"NC1.2: a value unique in the dataset appears zero times in the profile")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(out;"NSW") && !str.contains(out;"VIC");"a repeating category's values are not sent either")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(out;"12.5") && !str.contains(out;"30.25") && !str.contains(out;"7.1");"nor any numeric value, sample or min/max/mean")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"ROWS: 6") && str.contains(out;"amount(numeric,nulls=0%,distinct=6,unique)");"the profile keeps the row count and each column's type, null rate and cardinality")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"who(") && str.contains(out;"notes(");"the suppressed columns are still described: name, type and cardinality")){pass=pass+1}el{fail=fail+1};
  <fail
};

m=packages.moke.tests.testapiroutinghandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.routing handler structure.
   The handler imports std.http, std.json, std.string,
   moke.routingexplainer, moke.tiervisualiser,
   moke.companionsimulator, std, and moke.costcomparison.
   Exposes a post function for routing decisions. *)

t=$handlerinfo{
  modulename:str;
  haspost:bool;
  importshttp:bool;
  importsjson:bool;
  importsrouting:bool;
  importstiers:bool;
  importscost:bool
};

f=describeroutingapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.routing";
    haspost:true;
    importshttp:true;
    importsjson:true;
    importsrouting:true;
    importstiers:true;
    importscost:true
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describeroutingapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.routing")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes POST function *)
  if(info.haspost){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.json *)
  if(info.importsjson){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.routingexplainer *)
  if(info.importsrouting){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.tiervisualiser *)
  if(info.importstiers){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.costcomparison *)
  if(info.importscost){pass=pass+1}el{fail=fail+1};

  <fail
};

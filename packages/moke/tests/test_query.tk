m=packages.moke.tests.testquery;

i=t:std.test;
i=str:std.str;
i=q:moke.query;

(* MK6.9 — moke.query.value, the query-string reader behind the upload's `?name=` and the agent
   diary's `?agent_id=`, against the REAL module.

   Before this, both pages kept their own copy and neither percent-decoded, so an upload sent as
   `?name=sales%20q3.csv` was stored as `sales%20q3.csv`. A copy that does not decode fails the
   first three assertions below. The rest pin what decoding must not break: an absent key, a key
   that is a prefix of another, and an agent id that has nothing to decode. *)

f=main():i64{
  let fails=mut.0;
  let a=t.assert(str.eq(q.value("/api/upload?name=sales%20q3.csv";"name");"sales q3.csv");
    "%20 decodes to a space");
  if(a){}el{fails=fails+1};
  let b=t.assert(str.eq(q.value("/api/upload?x=1&name=a+b%2Bc.csv";"name");"a b+c.csv");
    "'+' is a space in a query string, and an encoded %2B stays a plus");
  if(b){}el{fails=fails+1};
  let c=t.assert(str.eq(q.value("/api/upload?name=caf%C3%A9.csv";"name");"café.csv");
    "a two-byte UTF-8 sequence decodes to one character");
  if(c){}el{fails=fails+1};
  let d=t.assert(str.len(q.value("/api/upload?other=1";"name"))==0;
    "an absent key is the empty string");
  if(d){}el{fails=fails+1};
  let e1=t.assert(str.len(q.value("/api/upload";"name"))==0;
    "a target with no query string is the empty string");
  if(e1){}el{fails=fails+1};
  let f1=t.assert(str.eq(q.value("/api/agents/diary?agent_idx=no&agent_id=privacy-auditor";"agent_id");"privacy-auditor");
    "a key that is a prefix of another is matched exactly, and a plain value is unchanged");
  if(f1){}el{fails=fails+1};
  <fails
};

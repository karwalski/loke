m=packages.moke.tests.testapipipelinehandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.pipeline handler structure.
   The handler imports std.http, std.json, std.string, moke.hooks,
   moke.compute, and moke.consolelog.
   Exposes a post function that requires a prompt field and forwards
   to the loke pipeline at http://127.0.0.1:11430/api/pipeline. *)

t=$handlerinfo{
  modulename:str;
  haspost:bool;
  importshttp:bool;
  importsjson:bool;
  importshooks:bool;
  importsconsolelog:bool;
  upstreamurl:str
};

f=describepipelineapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.pipeline";
    haspost:true;
    importshttp:true;
    importsjson:true;
    importshooks:true;
    importsconsolelog:true;
    upstreamurl:"http://127.0.0.1:11430/api/pipeline"
  }
};

f=validateprompt(prompt:str):str{
  if(str.eq(prompt;"")){
    <"error:missing"
  };
  <"ok"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describepipelineapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.pipeline")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes POST function *)
  if(info.haspost){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.hooks *)
  if(info.importshooks){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.consolelog *)
  if(info.importsconsolelog){pass=pass+1}el{fail=fail+1};

  (* test: upstream url is correct *)
  if(str.eq(info.upstreamurl;"http://127.0.0.1:11430/api/pipeline")){pass=pass+1}el{fail=fail+1};

  (* test: empty prompt is rejected *)
  let r1=validateprompt("");
  if(str.eq(r1;"error:missing")){pass=pass+1}el{fail=fail+1};

  (* test: valid prompt is accepted *)
  let r2=validateprompt("Analyse this dataset");
  if(str.eq(r2;"ok")){pass=pass+1}el{fail=fail+1};

  <fail
};

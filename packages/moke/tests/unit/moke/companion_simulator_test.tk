m=test.moke.companionsimulatortest;
i=cs:moke.companionsimulator;
i=str:std.string;
i=test:std.test;

f=newsessionstartsinidlestate():void{
  let s = cs.newsession();
  test.asserteq(cs.statelabel(s.state); "Idle");
  test.asserteq(s.offloadmodel; "");
  test.asserteq(s.offloadtokens; 0);
};

f=defaultdevicereturnsmacstudio():void{
  let d = cs.defaultdevice();
  test.asserteq(d.name; "Mac Studio (Office)");
  test.asserteq(d.devicetype; "mac_studio");
  test.asserteq(d.gpuvramgb; 192.0);
};

f=scantransitionsthroughstates():void{
  let s = cs.newsession();
  s = cs.startscan(s);
  test.asserteq(cs.statelabel(s.state); "Scanning...");

  s = cs.discover(s);
  test.asserteq(cs.statelabel(s.state); "Device Found");
};

f=pairingtransitionsthroughstates():void{
  let s = cs.newsession();
  s = cs.startscan(s);
  s = cs.discover(s);
  s = cs.startpairing(s);
  test.asserteq(cs.statelabel(s.state); "Pairing...");

  s = cs.completepairing(s);
  test.asserteq(cs.statelabel(s.state); "Paired");
};

f=offloadrecordstokensandduration():void{
  let s = cs.newsession();
  s = cs.completepairing(s);
  s = cs.startoffload(s; "llama3.1:70b");
  test.asserteq(cs.statelabel(s.state); "Offloading...");
  test.asserteq(s.offloadmodel; "llama3.1:70b");

  s = cs.completeoffload(s; 847; 3200);
  test.asserteq(cs.statelabel(s.state); "Complete");
  test.asserteq(s.offloadtokens; 847);
  test.asserteq(s.offloaddurationms; 3200);
};

f=eventsaccumulatethroughtransitions():void{
  let s = cs.newsession();
  s = cs.startscan(s);
  s = cs.discover(s);
  test.asserteq(s.events.len(); 3);
};

f=tojsonproducesvalidjson():void{
  let s = cs.newsession();
  s = cs.startscan(s);
  let j = cs.tojson(s);
  test.assert(str.contains(j; "\"state\":\"Scanning...\""));
  test.assert(str.contains(j; "\"device\""));
  test.assert(str.contains(j; "\"events\""));
};

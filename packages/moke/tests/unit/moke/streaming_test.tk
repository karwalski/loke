m=test.moke.streamingtest;
i=st:moke.streaming;
i=str:std.string;
i=test:std.test;

f=newsessionstartsinidlestate():void{
  let s = st.newsession("req-001"; "llama3.2:3b");
  test.asserteq(st.statelabel(s.state); "idle");
  test.asserteq(s.requestid; "req-001");
  test.asserteq(s.modelid; "llama3.2:3b");
  test.asserteq(s.tokensreceived; 0);
};

f=setstatetransitionscorrectly():void{
  let s = st.newsession("req-002"; "test");
  s = st.setstate(s; st.$streamstate.$connecting);
  test.asserteq(st.statelabel(s.state); "connecting");
  s = st.setstate(s; st.$streamstate.$streaming);
  test.asserteq(st.statelabel(s.state); "streaming");
};

f=addtokenincrementscountandtransitionstostreaming():void{
  let s = st.newsession("req-003"; "test");
  s = st.addtoken(s; "Hello");
  test.asserteq(s.tokensreceived; 1);
  test.asserteq(st.statelabel(s.state); "streaming");
  test.asserteq(s.activestage; "llm_call");

  s = st.addtoken(s; " world");
  test.asserteq(s.tokensreceived; 2);
};

f=setstageupdatesactivestageandaddsevent():void{
  let s = st.newsession("req-004"; "test");
  s = st.setstage(s; "schema_extract");
  test.asserteq(s.activestage; "schema_extract");
  test.assert(s.events.len() > 0);
};

f=multiplestagesaccumulateevents():void{
  let s = st.newsession("req-005"; "test");
  s = st.setstage(s; "schema_extract");
  s = st.setstage(s; "anonymise");
  s = st.setstage(s; "llm_call");
  test.asserteq(s.events.len(); 3);
  test.asserteq(s.activestage; "llm_call");
};

f=eventtojsonproducesvalidjson():void{
  let e = st.$streamevent{
    eventtype:"token";
    data:"Hello";
    timestamp:1234567890
  };
  let j = st.eventtojson(e);
  test.assert(str.contains(j; "\"event_type\":\"token\""));
  test.assert(str.contains(j; "\"data\":\"Hello\""));
};

f=tosseformatsasserversentevent():void{
  let e = st.$streamevent{
    eventtype:"token";
    data:"Hello";
    timestamp:1234567890
  };
  let sse = st.tosse(e);
  test.assert(str.startswith(sse; "event: token"));
  test.assert(str.contains(sse; "data: Hello"));
};

f=sessiontojsonincludesallfields():void{
  let s = st.newsession("req-006"; "llama3.2:3b");
  s = st.setstage(s; "llm_call");
  s = st.addtoken(s; "Hi");
  s = st.setstate(s; st.$streamstate.$complete);
  let j = st.sessiontojson(s);
  test.assert(str.contains(j; "\"state\":\"complete\""));
  test.assert(str.contains(j; "\"request_id\":\"req-006\""));
  test.assert(str.contains(j; "\"model_id\":\"llama3.2:3b\""));
  test.assert(str.contains(j; "\"tokens_received\":1"));
  test.assert(str.contains(j; "\"events\""));
  test.assert(str.contains(j; "\"console_log\""));
};

f=statelabelsmapcorrectly():void{
  test.asserteq(st.statelabel(st.$streamstate.$idle); "idle");
  test.asserteq(st.statelabel(st.$streamstate.$connecting); "connecting");
  test.asserteq(st.statelabel(st.$streamstate.$streaming); "streaming");
  test.asserteq(st.statelabel(st.$streamstate.$complete); "complete");
  test.asserteq(st.statelabel(st.$streamstate.$error); "error");
};

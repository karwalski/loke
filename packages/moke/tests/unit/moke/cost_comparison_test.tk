m=test.moke.costcomparisontest;
i=cc:moke.costcomparison;
i=str:std.string;
i=test:std.test;

f=estimatecloudcostreturnspositiveforcloudmodels():void{
  let cost = cc.estimatecloudcost("claude-3-5-sonnet"; 1000; 500);
  test.assert(cost > 0.0);
};

f=estimatecloudcosthandlesllamapricing():void{
  let cost = cc.estimatecloudcost("llama3.2:3b"; 1000; 500);
  test.assert(cost > 0.0);
};

f=computereturnszerolocalcost():void{
  let c = cc.compute("llama3.2:3b"; 500; 200; true);
  test.asserteq(c.localcostusd; 0.0);
  test.asserteq(c.islocal; true);
  test.assert(c.cloudcostusd > 0.0);
};

f=computecalculatessavedamountforlocalinference():void{
  let c = cc.compute("claude-3-5-sonnet"; 1000; 500; true);
  test.assert(c.savedusd > 0.0);
  test.asserteq(c.savedusd; c.cloudcostusd);
};

f=computereturnszerosavedforcloudinference():void{
  let c = cc.compute("claude-3-5-sonnet"; 1000; 500; false);
  test.asserteq(c.savedusd; 0.0);
};

f=newsessionsavingsstartsatzero():void{
  let s = cc.newsessionsavings();
  test.asserteq(s.totalcloudcost; 0.0);
  test.asserteq(s.totalsaved; 0.0);
  test.asserteq(s.requestcount; 0);
};

f=accumulateaggregatescostscorrectly():void{
  let s = cc.newsessionsavings();
  let c1 = cc.compute("llama3.2:3b"; 500; 200; true);
  s = cc.accumulate(s; c1);
  test.asserteq(s.requestcount; 1);
  test.asserteq(s.localrequestcount; 1);
  test.assert(s.totalcloudcost > 0.0);

  let c2 = cc.compute("claude-3-5-sonnet"; 1000; 500; false);
  s = cc.accumulate(s; c2);
  test.asserteq(s.requestcount; 2);
  test.asserteq(s.localrequestcount; 1);
};

f=comparisontojsonproducesvalidjson():void{
  let c = cc.compute("llama3.2:3b"; 500; 200; true);
  let j = cc.comparisontojson(c);
  test.assert(str.contains(j; "\"cloud_cost_usd\""));
  test.assert(str.contains(j; "\"local_cost_usd\""));
  test.assert(str.contains(j; "\"saved_usd\""));
  test.assert(str.contains(j; "\"is_local\":true"));
};

f=savingstojsonproducesvalidjson():void{
  let s = cc.newsessionsavings();
  let j = cc.savingstojson(s);
  test.assert(str.contains(j; "\"total_cloud_cost\""));
  test.assert(str.contains(j; "\"request_count\":0"));
};

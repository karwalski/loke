
m=test.moke.pipelinepanel;
i=t:std.test;
i=str:std.string;
i=pt:core.pipeline.types;
i=emitter:core.pipeline.emitter;
i=history:core.pipeline.history;




  t.test("all 9 stages are defined in types"){
    let stages=pt.allstages();
    t.eq(stages.len;9;"expected 9 pipeline stages");
    t.eq(stages.get(0);"input";"first stage is input");
    t.eq(stages.get(8);"output";"last stage is output");
  };

  t.test("emitter new creates empty emitter"){
    let em=mut.emitter.new("run-1";"req-1");
    t.eq(em.runid;"run-1";"run_id set");
    t.eq(em.requestid;"req-1";"request_id set");
    t.eq(em.events.len;0;"events empty on init");
  };

  t.test("start_stage emits active event"){
    let em=emitter.new("run-2";"req-2");
    em=emitter.startstage(em;"input");
    t.eq(em.events.len;1;"one event after start_stage");
    t.eq(em.events.get(0).stage;"input";"stage is input");
    t.eq(em.events.get(0).status;"active";"status is active");
  };

  t.test("complete_stage emits complete event with details"){
    let em=emitter.new("run-3";"req-3");
    em=emitter.startstage(em;"privacy_scan");
    em=emitter.completestage(em;"privacy_scan";42;
      @(pt.$stagedetail{key:"entities_detected";value:"5"}));
    t.eq(em.events.len;2;"two events: active + complete");
    t.eq(em.events.get(1).status;"complete";"second event is complete");
    t.eq(em.events.get(1).durationms;42;"duration_ms is 42");
    t.eq(em.events.get(1).details.len;1;"one detail record");
    t.eq(em.events.get(1).details.get(0).key;"entities_detected";"detail key");
    t.eq(em.events.get(1).details.get(0).value;"5";"detail value");
  };

  t.test("skip_stage emits skipped event with reason"){
    let em=emitter.new("run-4";"req-4");
    em=emitter.skipstage(em;"anonymisation";"no raw data");
    t.eq(em.events.len;1;"one event");
    t.eq(em.events.get(0).status;"skipped";"status is skipped");
    t.eq(em.events.get(0).details.get(0).key;"reason";"detail key is reason");
    t.eq(em.events.get(0).details.get(0).value;"no raw data";"reason value");
  };

  t.test("error_stage emits error event with message"){
    let em=emitter.new("run-5";"req-5");
    em=emitter.errorstage(em;"llm_call";"upstream timeout");
    t.eq(em.events.len;1;"one event");
    t.eq(em.events.get(0).status;"error";"status is error");
    t.eq(em.events.get(0).errormessage;"upstream timeout";"error message set");
  };

  t.test("full 9-stage pipeline emits correct event count"){
    let em=emitter.new("run-6";"req-6");
    let stages=pt.allstages();
    stages.each|s{
      em=emitter.startstage(em;s);
      em=emitter.completestage(em;s;10;@());
    };
    t.eq(em.events.len;18;"18 events for 9 stages (active+complete each)");
  };

  t.test("finalise produces pipeline_run with correct totals"){
    let em=emitter.new("run-7";"req-7");
    em=emitter.completestage(em;"input";5;@());
    em=emitter.completestage(em;"privacy_scan";10;@());
    em=emitter.completestage(em;"anonymisation";15;@());
    em=emitter.completestage(em;"token_optimisation";2;@());
    em=emitter.completestage(em;"routing";3;@());
    em=emitter.completestage(em;"llm_call";200;@());
    em=emitter.completestage(em;"response_scan";8;@());
    em=emitter.completestage(em;"deanonymisation";4;@());
    em=emitter.completestage(em;"output";1;@());
    let run=emitter.finalise(em);
    t.eq(run.id;"run-7";"run id preserved");
    t.eq(run.overallstatus;"complete";"overall status is complete");
    t.eq(run.totaldurationms;248;"total duration sums correctly (5+10+15+2+3+200+8+4+1=248)");
  };

  t.test("finalise marks overall error when any stage errors"){
    let em=emitter.new("run-8";"req-8");
    em=emitter.completestage(em;"input";5;@());
    em=emitter.errorstage(em;"llm_call";"timeout");
    em=emitter.skipstage(em;"output";"upstream error");
    let run=emitter.finalise(em);
    t.eq(run.overallstatus;"error";"overall status is error when any stage errors");
  };

};




  t.test("multiple details per stage"){
    let em=emitter.new("run-d1";"req-d1");
    em=emitter.completestage(em;"token_optimisation";12;
      @(pt.$stagedetail{key:"tokens_before";value:"1500"};
        pt.$stagedetail{key:"tokens_after";value:"1200"};
        pt.$stagedetail{key:"reduction_pct";value:"20"}));
    t.eq(em.events.get(0).details.len;3;"three detail records");
    t.eq(em.events.get(0).details.get(0).key;"tokens_before";"first detail key");
    t.eq(em.events.get(0).details.get(1).value;"1200";"second detail value");
    t.eq(em.events.get(0).details.get(2).value;"20";"third detail value");
  };

  t.test("stage_label returns human-readable names for all stages"){
    t.eq(pt.stagelabel("input");"Input";"input label");
    t.eq(pt.stagelabel("privacy_scan");"Privacy Scan";"privacy_scan label");
    t.eq(pt.stagelabel("anonymisation");"Anonymisation";"anonymisation label");
    t.eq(pt.stagelabel("token_optimisation");"Token Optimisation";"token_optimisation label");
    t.eq(pt.stagelabel("routing");"Routing";"routing label");
    t.eq(pt.stagelabel("llm_call");"LLM Call";"llm_call label");
    t.eq(pt.stagelabel("response_scan");"Response Scan";"response_scan label");
    t.eq(pt.stagelabel("deanonymisation");"De-anonymisation";"deanonymisation label");
    t.eq(pt.stagelabel("output");"Output";"output label");
  };

  t.test("status_symbol returns correct symbols"){
    t.eq(pt.statussymbol("pending");"[ ]";"pending symbol");
    t.eq(pt.statussymbol("active");"[>]";"active symbol");
    t.eq(pt.statussymbol("complete");"[ok]";"complete symbol");
    t.eq(pt.statussymbol("skipped");"[--]";"skipped symbol");
    t.eq(pt.statussymbol("error");"[!!]";"error symbol");
  };

};




  t.test("new history is empty"){
    let h=mut.history.new(10);
    t.eq(h.runs.len;0;"no runs initially");
  };

  t.test("add stores a run"){
    let h=history.new(10);
    let em=emitter.new("run-h1";"req-h1");
    em=emitter.completestage(em;"input";5;@());
    let run=emitter.finalise(em);
    h=history.add(h;run);
    t.eq(h.runs.len;1;"one run stored");
    t.eq(h.runs.get(0).id;"run-h1";"run id matches");
  };

  t.test("recent returns last N runs"){
    let h=history.new(10);
    let i=0;
    while i < 5{
      let em=emitter.new(str.concat("run-";str.fromi32(i));str.concat("req-";str.fromi32(i)));
      em=emitter.completestage(em;"input";i;@());
      let run=emitter.finalise(em);
      h=history.add(h;run);
      i=i+1;
    };
    let last3=history.recent(h;3);
    t.eq(last3.len;3;"returns 3 runs");
    t.eq(last3.get(0).id;"run-2";"first of last 3 is run-2");
    t.eq(last3.get(2).id;"run-4";"last of last 3 is run-4");
  };

  t.test("history evicts oldest when at capacity"){
    let h=history.new(3);
    let i=0;
    while i < 5{
      let em=emitter.new(str.concat("run-";str.fromi32(i));str.concat("req-";str.fromi32(i)));
      em=emitter.completestage(em;"input";i;@());
      let run=emitter.finalise(em);
      h=history.add(h;run);
      i=i+1;
    };
    t.eq(h.runs.len;3;"capped at 3 runs");
    t.eq(h.runs.get(0).id;"run-2";"oldest remaining is run-2");
    t.eq(h.runs.get(2).id;"run-4";"newest is run-4");
  };

  t.test("last returns most recent run"){
    let h=history.new(10);
    let em=emitter.new("run-last";"req-last");
    em=emitter.completestage(em;"output";1;@());
    let run=emitter.finalise(em);
    h=history.add(h;run);
    let result=mt history.last(h);
    result {
      $ok:r t.eq(r.id;"run-last";"last returns the correct run");
      $err:e t.fail("last should not error when history has runs")
    };
  };

  t.test("last returns error on empty history"){
    let h=history.new(10);
    let result=mt history.last(h);
    result {
      $$ok:v t.fail("last should error on empty history");
      $$err:e t.pass("last correctly errors on empty history")
    };
  };

};

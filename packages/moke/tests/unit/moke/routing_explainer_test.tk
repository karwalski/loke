m=test.moke.routingexplainertest;
i=re:moke.routingexplainer;
i=str:std.string;
i=test:std.test;

f=newdecisioncreatesdefaultroutingdecision():void{
  let d = re.newdecision("req-001");
  test.asserteq(d.requestid; "req-001");
  test.asserteq(d.intent; "chat");
  test.asserteq(d.intentconfidence; 0.60);
  test.asserteq(d.intentmethod; "keyword");
  test.asserteq(d.sensitivity; "PUBLIC");
  test.asserteq(d.latencytolerance; "instant");
  test.asserteq(d.islocal; false);
};

f=withintentupdatesintentfields():void{
  let d = re.newdecision("req-002");
  let d2 = re.withintent(d; "data_analysis"; 0.85; "keyword");
  test.asserteq(d2.intent; "data_analysis");
  test.asserteq(d2.intentconfidence; 0.85);
  test.asserteq(d2.intentmethod; "keyword");
  test.asserteq(d2.requestid; "req-002");
};

f=withsensitivityupdatessensitivityfields():void{
  let d = re.newdecision("req-003");
  let d2 = re.withsensitivity(d; "CONFIDENTIAL"; "local-only");
  test.asserteq(d2.sensitivity; "CONFIDENTIAL");
  test.asserteq(d2.sensitivityrouting; "local-only");
};

f=withselectionupdatesmodelselectionfields():void{
  let d = re.newdecision("req-004");
  let d2 = re.withselection(d; "llama3.2:3b"; "ollama"; true; "interactive"; "local model selected"; 0.0);
  test.asserteq(d2.modelid; "llama3.2:3b");
  test.asserteq(d2.provider; "ollama");
  test.asserteq(d2.islocal; true);
  test.asserteq(d2.tier; "interactive");
  test.asserteq(d2.costestimateusd; 0.0);
};

f=tojsonproducesvalidjsonstructure():void{
  let d = re.newdecision("req-005");
  d = re.withintent(d; "summarisation"; 0.85; "keyword");
  d = re.withsensitivity(d; "INTERNAL"; "prefer-local");
  d = re.withselection(d; "qwen2.5:7b"; "ollama"; true; "considered"; "prefer-local model"; 0.0);
  let j = re.tojson(d);
  test.assert(str.contains(j; "\"request_id\":\"req-005\""));
  test.assert(str.contains(j; "\"intent\":\"summarisation\""));
  test.assert(str.contains(j; "\"sensitivity\":\"INTERNAL\""));
  test.assert(str.contains(j; "\"model_id\":\"qwen2.5:7b\""));
  test.assert(str.contains(j; "\"is_local\":true"));
};


m=test.moke.mk18i18na11y;

i=str:std.str;
i=log:std.log;
i=testing:loke.platform.a11y.testing;
i=translator:loke.platform.i18n.translator;


f=testmokekeysexistinenjson():bool{
  let loaded=translator.loadlocalejson("locales/en.json");
  if(!$loaded){
    log.error("MK18.1: Failed to load locales/en.json");
    <false
  }el{};

  translator.setlocale("en");

  let keys=@str.get(
    "moke.app.name";
    "moke.app.subtitle";
    "moke.nav.workspace";
    "moke.nav.datasets";
    "moke.nav.analysis";
    "moke.nav.dashboard";
    "moke.nav.tools";
    "moke.nav.insight_lab";
    "moke.nav.upload";
    "moke.nav.system";
    "moke.nav.settings";
    "moke.datasets.heading";
    "moke.datasets.sub";
    "moke.datasets.privacy_banner";
    "moke.chat.title";
    "moke.chat.active_dataset";
    "moke.chat.pipeline_console";
    "moke.chat.suggested_prompts";
    "moke.chat.placeholder";
    "moke.upload.title";
    "moke.upload.tab_file";
    "moke.upload.tab_paste";
    "moke.upload.tab_builtin";
    "moke.dashboard.title";
    "moke.dashboard.generate";
    "moke.dashboard.export_ddl";
    "moke.dashboard.export_png";
    "moke.insight.title";
    "moke.insight.analysis_type";
    "moke.insight.kmeans";
    "moke.insight.zscore";
    "moke.insight.iqr";
    "moke.insight.correlation";
    "moke.insight.results";
    "moke.settings.title";
    "moke.settings.session";
    "moke.settings.llm";
    "moke.settings.about";
    "moke.settings.language";
    "moke.settings.language_hint";
    "moke.settings.language_en_au";
    "moke.settings.language_en_us";
    "moke.pipeline.console";
    "moke.pipeline.anonymise";
    "moke.ml.cluster";
    "moke.ml.anomalies";
    "moke.btn.analyse";
    "moke.btn.send";
    "moke.btn.cancel";
    "moke.err.no_dataset";
    "moke.err.loke_offline";
    "moke.confirm.title";
    "moke.confirm.stays_local";
    "moke.confirm.goes_to_llm";
    "moke.presentation.wordmark";
    "moke.presentation.keyboard_shortcuts";
    "moke.status.privacy";
    "moke.status.dataset";
    "moke.a11y.skip_to_content";
    "moke.a11y.main_nav"
  );

  let allpass=mut.true;
  let i=0;
  let count=keys.len();
  if(i<count){
    let key=keys.get(i);
    let val=translator.t(key);
    if(str.eq(val;key)){
      let msg=str.concat("MK18.1 FAIL: Missing key in en.json: ";key);
      log.error(msg);
      allpass=false
    }el{};
    i=i+1;
  }el{};

  if(allpass){
    log.info("MK18.1 PASS: All moke.* keys present in en.json")
  }el{
    log.error("MK18.1 FAIL: Some moke.* keys missing from en.json")
  };
  <allpass
};


f=basehtml():$str{
  let html=mut."<!DOCTYPE html><html lang=\"en\"><head><title>moke</title></head><body>";
  html=str.concat(html;"<a href=\"#main-content\" class=\"skip-link\">Skip to main content</a>");
  html=str.concat(html;"<div id=\"aria-live-polite\" aria-live=\"polite\" class=\"sr-only\"></div>");
  html=str.concat(html;"<header role=\"banner\"><h1>moke</h1></header>");
  html=str.concat(html;"<nav aria-label=\"Main navigation\"><a href=\"/\">Datasets</a><a href=\"/chat\">Analysis</a></nav>");
  html=str.concat(html;"<main id=\"main-content\" role=\"main\"><h2>Content</h2><p>Page content here.</p></main>");
  html=str.concat(html;"</body></html>");
  <html
};

f=testbaselayoutlandmarks():bool{
  let html=basehtml();
  let result=testing.checkhtml(html;"moke://base");
  if(!i64){
    let count=result.violations.len();
    let i=0;
    if(i<count){
      let v=result.violations.get(i);
      let msg=str.concat("MK18.2 base violation: ";str.concat(v.rule;str.concat(" - ";v.description)));
      log.error(msg);
      i=i+1;
    }el{};
  }el{};
  let pass=testing.assertnoviolations(result);
  if(pass){
    log.info("MK18.2 PASS: Base layout passes a11y audit")
  }el{
    log.error("MK18.2 FAIL: Base layout has a11y violations")
  };
  <pass
};

f=testindexpagea11y():bool{
  let html="<!DOCTYPE html><html lang=\"en\"><head><title>Datasets - moke</title></head><body>";
  html=str.concat(html;"<a href=\"#main-content\" class=\"skip-link\">Skip to main content</a>");
  html=str.concat(html;"<header role=\"banner\"><h1>moke</h1></header>");
  html=str.concat(html;"<nav aria-label=\"Main navigation\"><a href=\"/\">Datasets</a></nav>");
  html=str.concat(html;"<main id=\"main-content\" role=\"main\">");
  html=str.concat(html;"<h2>Choose a dataset to analyse</h2>");
  html=str.concat(html;"<button type=\"button\" aria-label=\"Load Medicare Benefits Schedule\">Load</button>");
  html=str.concat(html;"</main></body></html>");
  let result=testing.checkhtml(html;"moke://index");
  let pass=testing.assertnoviolations(result);
  if(pass){ log.info("MK18.2 PASS: Index page a11y audit") }el{ log.error("MK18.2 FAIL: Index page a11y violations") };
  <pass
};


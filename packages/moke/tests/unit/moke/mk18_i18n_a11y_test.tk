f=testenaulocalehasmokekeys():bool{
  let loaded=translator.loadlocalejson("locales/en-AU.json");
  if(!$loaded){
    log.error("MK18.3: Failed to load locales/en-AU.json");
    <false
  }el{};

  translator.setlocale("en-AU");
  let val=translator.t("moke.datasets.heading");
  let pass=!str.eq(val;"moke.datasets.heading");
  if(pass){ log.info("MK18.3 PASS: en-AU locale has moke.datasets.heading") };
  else{ log.error("MK18.3 FAIL: en-AU locale missing moke.datasets.heading") };
  <pass
};

f=testenuslocalehasmokekeys():bool{
  let loaded=translator.loadlocalejson("locales/en-US.json");
  if(!$loaded){
    log.error("MK18.3: Failed to load locales/en-US.json");
    <false
  }el{};

  translator.setlocale("en-US");
  let val=translator.t("moke.datasets.heading");
  let hasz=str.indexof(val;"analyze";0)>0;
  let pass=hasz;
  if(pass){ log.info("MK18.3 PASS: en-US locale uses US spelling (analyze)") };
  else{ log.error("MK18.3 FAIL: en-US locale does not use US spelling  got: " + val) };
  <pass
};

f=testenusanalysebutton():bool{
  translator.setlocale("en-US");
  let val=translator.t("moke.btn.analyse");
  let pass=str.eq(val;"Analyze");
  if(pass){ log.info("MK18.3 PASS: en-US moke.btn.analyse = Analyze") };
  else{ log.error("MK18.3 FAIL: en-US moke.btn.analyse expected Analyze, got: " + val) };
  <pass
};

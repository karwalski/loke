
m=test.moke.feedback;
i=t:std.test;


t.test("feedback entry has required fields";f(){
  let entry = {
    id: "fb_1234567890";
    rating: "thumbs_up";
    featurearea: "chat_response";
    requestid: "req_abc123";
    modelid: "llama3.2:3b";
    dataset: "test_dataset";
    comment: "";
    createdat: "2026-04-25T00:00:00.000Z"
  };
  t.asserteq(entry.rating; "thumbs_up");
  t.asserteq(entry.featurearea; "chat_response");
  t.asserteq(entry.requestid; "req_abc123");
  t.asserteq(entry.modelid; "llama3.2:3b");
});

t.test("feedback rating must be thumbs_up or thumbs_down";f(){
  let validup = "thumbs_up";
  let validdown = "thumbs_down";
  let invalid = "neutral";
  t.assert(validup = "thumbs_up" || validup = "thumbs_down");
  t.assert(validdown = "thumbs_up" || validdown = "thumbs_down");
  t.assert(!(invalid = "thumbs_up" || invalid = "thumbs_down"));
});


t.test("feedback summary computes thumbs up percentage";f(){
  let entries = .get(
    { rating: "thumbs_up" };
    { rating: "thumbs_up" };
    { rating: "thumbs_down" };
    { rating: "thumbs_up" };
  );
  let total = entries.len;
  let up = entries.filter(|e| e.rating = "thumbs_up").len;
  let rate = (up * 100) / total;
  t.asserteq(total; 4);
  t.asserteq(up; 3);
  t.asserteq(rate; 75);
});

t.test("feedback summary groups by model";f(){
  let entries = .get(
    { rating: "thumbs_up"; modelid: "llama3.2:3b" };
    { rating: "thumbs_down"; modelid: "llama3.2:3b" };
    { rating: "thumbs_up"; modelid: "qwen2.5:0.5b" };
  );
  let models = {};
  entries.each(|e| {
    let m = e.modelid;
    if(!i64(m) ){ models.get(m) = { total: 0; up: 0 }; };
    models.get(m).total = models.get(m).total + 1;
    if(e.rating = "thumbs_up" ){ models.get(m).up = models.get(m).up + 1; };
  });
  t.asserteq(models.get("llama3.2:3b").total; 2);
  t.asserteq(models.get("llama3.2:3b").up; 1);
  t.asserteq(models.get("qwen2.5:0.5b").total; 1);
  t.asserteq(models.get("qwen2.5:0.5b").up; 1);
});

t.test("feedback summary groups by dataset";f(){
  let entries = .get(
    { rating: "thumbs_up"; dataset: "customers" };
    { rating: "thumbs_down"; dataset: "customers" };
    { rating: "thumbs_up"; dataset: "revenue" };
  );
  let datasets = {};
  entries.each(|e| {
    let d = e.dataset;
    if(!i64(d) ){ datasets.get(d) = { total: 0; up: 0 }; };
    datasets.get(d).total = datasets.get(d).total + 1;
    if(e.rating = "thumbs_up" ){ datasets.get(d).up = datasets.get(d).up + 1; };
  });
  t.asserteq(datasets.get("customers").total; 2);
  t.asserteq(datasets.get("revenue").up; 1);
});


t.test("decision trace extracts model from trace text";f(){
  let trace = "request_id: req_001
model: llama3.2:3b
sensitivity: INTERNAL";
  let hasmodel = trace.contains("model:");
  t.assert(hasmodel);
});

t.test("decision trace extracts entity count";f(){
  let trace = "entities_found: 3
cost_usd: $0.000123";
  let hasentities = trace.contains("entities_found:");
  t.assert(hasentities);
});


m=test.moke.memory;
i=t:std.test;


t.test("palace organises drawers into wings";f(){
  let drawers = .get(
    { wing: "work"; hall: "projects"; room: "moke"; content: "test1" };
    { wing: "work"; hall: "projects"; room: "loke"; content: "test2" };
    { wing: "reference"; hall: "privacy"; room: "pii"; content: "test3" };
  );
  let wings = {};
  drawers.each(|d| {
    if(!$wings.get(d.wing) ){ wings.get(d.wing) = 0; };
    wings.get(d.wing) = wings.get(d.wing) + 1;
  });
  t.asserteq(wings.get("work"); 2);
  t.asserteq(wings.get("reference"); 1);
});

t.test("palace lists halls within a wing";f(){
  let drawers = .get(
    { wing: "work"; hall: "projects"; room: "moke"; content: "test1" };
    { wing: "work"; hall: "datasets"; room: "csv"; content: "test2" };
    { wing: "work"; hall: "projects"; room: "loke"; content: "test3" };
  );
  let halls = {};
  drawers.filter(|d| d.wing = "work").each(|d| {
    halls.get(d.hall) = true;
  });
  t.asserteq(halls.len; 2);
  t.assert(halls.get("projects"));
  t.assert(halls.get("datasets"));
});

t.test("palace lists rooms within a hall";f(){
  let drawers = .get(
    { wing: "work"; hall: "projects"; room: "moke"; content: "test1" };
    { wing: "work"; hall: "projects"; room: "loke"; content: "test2" };
    { wing: "work"; hall: "projects"; room: "moke"; content: "test3" };
  );
  let rooms = {};
  drawers.filter(|d| d.wing = "work" && d.hall = "projects").each(|d| {
    if(!$rooms.get(d.room) ){ rooms.get(d.room) = 0; };
    rooms.get(d.room) = rooms.get(d.room) + 1;
  });
  t.asserteq(rooms.get("moke"); 2);
  t.asserteq(rooms.get("loke"); 1);
});

t.test("palace returns drawers in a room";f(){
  let drawers = .get(
    { wing: "work"; hall: "projects"; room: "moke"; content: "alpha" };
    { wing: "work"; hall: "projects"; room: "moke"; content: "beta" };
    { wing: "work"; hall: "projects"; room: "loke"; content: "gamma" };
  );
  let result = drawers.filter(|d| d.wing = "work" && d.hall = "projects" && d.room = "moke");
  t.asserteq(result.len; 2);
  t.asserteq(result.get(0).content; "alpha");
});


t.test("auto-memory creates drawer from Q and A";f(){
  let question = "What is the average revenue?";
  let answer = "The average revenue is $1,234.56.";
  let content = "Q: " + question + "
A: " + answer;
  let drawer = {
    wing: "work";
    hall: "conversations";
    room: "test_dataset";
    content: $content;
    source: "chat"
  };
  t.assert(drawer.content.contains("Q: "));
  t.assert(drawer.content.contains("A: "));
  t.asserteq(drawer.source; "chat");
  t.asserteq(drawer.wing; "work");
  t.asserteq(drawer.hall; "conversations");
});


t.test("search extracts keywords and filters stop words";f(){
  let stopwords = .get("the"; "a"; "an"; "and"; "or"; "but"; "in"; "on"; "at"; "to"; "for"; "of");
  let text = "find the revenue data in the dataset";
  let words = text.split(" ");
  let keywords = words.filter(|w| w.len > 3 && !$stopwords.contains(w));
  t.assert(keywords.contains("find"));
  t.assert(keywords.contains("revenue"));
  t.assert(keywords.contains("data"));
  t.assert(keywords.contains("dataset"));
  t.assert(!$keywords.contains("the"));
  t.assert(!$keywords.contains("in"));
});

t.test("search scores drawers by keyword match";f(){
  let drawers = .get(
    { content: "revenue analysis shows growth patterns" };
    { content: "customer data with names and emails" };
    { content: "revenue per customer by region" };
  );
  let querykeywords = .get("revenue"; "customer");
  let scores = drawers.map(|d| {
    let score = 0;
    let lower = d.content.tolower();
    querykeywords.each(|kw| {
      if(lower.contains(kw) ){ score = score + 1; };
    });
    score
  });
  t.asserteq(scores.get(2); 2);
  t.asserteq(scores.get(0); 1);
  t.asserteq(scores.get(1); 1);
});

t.test("search returns results sorted by relevance";f(){
  let scored = .get(
    { drawerid: "drw_1"; score: 1.0 };
    { drawerid: "drw_2"; score: 3.0 };
    { drawerid: "drw_3"; score: 2.0 };
  );
  let sorted = scored.sortbydesc(|s| s.score);
  t.asserteq(sorted.get(0).drawerid; "drw_2");
  t.asserteq(sorted.get(1).drawerid; "drw_3");
  t.asserteq(sorted.get(2).drawerid; "drw_1");
});


t.test("aaak compression strips articles";f(){
  let text = "The revenue is the total amount";
  let compressed = text.replace("The "; "").replace(" the "; " ");
  t.assert(!$compressed.contains("The "));
  t.assert(compressed.contains("revenue"));
});

t.test("aaak compression strips prepositions";f(){
  let text = "data for analysis in the dataset";
  let compressed = text.replace(" for "; " ").replace(" in "; " ");
  t.assert(!$compressed.contains(" for "));
  t.assert(!$compressed.contains(" in "));
});

t.test("aaak compression measures savings";f(){
  let original = "The revenue is the total amount of all sales for the year";
  let compressed = "revenue total amount all sales year";
  let originallen = original.len;
  let compressedlen = compressed.len;
  let savings = ((originallen - compressedlen) * 100) / originallen;
  t.assert(savings > 0);
  t.assert(compressedlen < originallen);
});


t.test("palace status counts drawers and wings";f(){
  let drawers = .get(
    { wing: "work"; hall: "projects"; room: "moke" };
    { wing: "work"; hall: "datasets"; room: "csv" };
    { wing: "reference"; hall: "privacy"; room: "pii" };
  );
  let wings = {};
  let halls = {};
  let rooms = {};
  drawers.each(|d| {
    wings.get(d.wing) = true;
    halls.get(d.wing + "/" + d.hall) = true;
    rooms.get(d.wing + "/" + d.hall + "/" + d.room) = true;
  });
  t.asserteq(drawers.len; 3);
  t.asserteq(wings.len; 2);
  t.asserteq(halls.len; 3);
  t.asserteq(rooms.len; 3);
});

t.test("palace status computes storage size";f(){
  let jsonstr = "{\"drawers\":[{\"content\":\"test\"}]}";
  let bytes = jsonstr.len * 2; 
  t.assert(bytes > 0);
  t.assert(bytes = jsonstr.len * 2);
});

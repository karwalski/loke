m=packages.moke.tests.testpipelinestages;
i=t:std.test;
i=str:std.str;

(* Stub types for pipeline stages *)
t=$pipelinestage{
  name:str;
  label:str;
  status:str;
  errormsg:str
};

(* Stub: construct a pipeline stage *)
f=buildstage(name:str;label:str):$pipelinestage{
  <$pipelinestage{
    name:name;
    label:label;
    status:"pending";
    errormsg:""
  }
};

(* Stub: advance stage to running *)
f=startstage(s:$pipelinestage):$pipelinestage{
  <$pipelinestage{
    name:s.name;
    label:s.label;
    status:"running";
    errormsg:""
  }
};

(* Stub: advance stage to done *)
f=completestage(s:$pipelinestage):$pipelinestage{
  <$pipelinestage{
    name:s.name;
    label:s.label;
    status:"done";
    errormsg:""
  }
};

(* Stub: set stage to error *)
f=failstage(s:$pipelinestage;msg:str):$pipelinestage{
  <$pipelinestage{
    name:s.name;
    label:s.label;
    status:"error";
    errormsg:msg
  }
};

(* Stub: check if stage is terminal *)
f=isterminal(s:$pipelinestage):bool{
  if(str.eq(s.status;"done")){<true}el{
  if(str.eq(s.status;"error")){<true}el{
  <false
  }}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: stage labels — privacy filter *)
  let s1=buildstage("privacy";"Privacy Filter");
  if(t.assert(str.eq(s1.label;"Privacy Filter");"privacy stage label correct")){pass=pass+1}el{fail=fail+1};

  (* test: stage labels — token optimiser *)
  let s2=buildstage("optimiser";"Token Optimiser");
  if(t.assert(str.eq(s2.label;"Token Optimiser");"optimiser stage label correct")){pass=pass+1}el{fail=fail+1};

  (* test: stage labels — router *)
  let s3=buildstage("router";"Router");
  if(t.assert(str.eq(s3.label;"Router");"router stage label correct")){pass=pass+1}el{fail=fail+1};

  (* test: new stage starts as pending *)
  if(t.assert(str.eq(s1.status;"pending");"new stage is pending")){pass=pass+1}el{fail=fail+1};

  (* test: pending stage has empty error *)
  if(t.assert(str.eq(s1.errormsg;"");"pending stage no error")){pass=pass+1}el{fail=fail+1};

  (* test: status progression pending to running *)
  let running=startstage(s1);
  if(t.assert(str.eq(running.status;"running");"started stage is running")){pass=pass+1}el{fail=fail+1};

  (* test: status progression running to done *)
  let done=completestage(running);
  if(t.assert(str.eq(done.status;"done");"completed stage is done")){pass=pass+1}el{fail=fail+1};

  (* test: done stage preserves name *)
  if(t.assert(str.eq(done.name;"privacy");"done stage preserves name")){pass=pass+1}el{fail=fail+1};

  (* test: done stage preserves label *)
  if(t.assert(str.eq(done.label;"Privacy Filter");"done stage preserves label")){pass=pass+1}el{fail=fail+1};

  (* test: error stage has error status *)
  let errored=failstage(running;"timeout exceeded");
  if(t.assert(str.eq(errored.status;"error");"failed stage is error")){pass=pass+1}el{fail=fail+1};

  (* test: error stage has error message *)
  if(t.assert(str.eq(errored.errormsg;"timeout exceeded");"error stage has message")){pass=pass+1}el{fail=fail+1};

  (* test: error stage preserves name *)
  if(t.assert(str.eq(errored.name;"privacy");"error stage preserves name")){pass=pass+1}el{fail=fail+1};

  (* test: done is terminal *)
  if(t.assert(isterminal(done);"done is terminal")){pass=pass+1}el{fail=fail+1};

  (* test: error is terminal *)
  if(t.assert(isterminal(errored);"error is terminal")){pass=pass+1}el{fail=fail+1};

  (* test: pending is not terminal *)
  if(t.assert(isterminal(s1) = false;"pending is not terminal")){pass=pass+1}el{fail=fail+1};

  (* test: running is not terminal *)
  if(t.assert(isterminal(running) = false;"running is not terminal")){pass=pass+1}el{fail=fail+1};

  <fail
};

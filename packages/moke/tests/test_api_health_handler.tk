m=packages.moke.tests.testapihealthhandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.health handler structure.
   The handler imports std.http, std.str, and std.log,
   exposes a get function that proxies to loke health endpoint
   and returns a fallback 503 JSON when loke is unreachable. *)

t=$handlerinfo{
  modulename:str;
  lokeurl:str;
  hasget:bool;
  importshttp:bool;
  importslog:bool
};

t=$fallbackresponse{
  statuscode:i64;
  containsmokeversion:bool;
  containslokestatus:bool;
  containsollamastatus:bool
};

f=describehealthhandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.health";
    lokeurl:"http://127.0.0.1:11430/api/health";
    hasget:true;
    importshttp:true;
    importslog:true
  }
};

f=buildfallback():$fallbackresponse{
  let body=str.concat("{\"ok\":false,\"moke\":\"0.2.0\",\"loke\":\"unreachable\",\"ollama\":\"unknown\",\"error\":\"loke unreachable at ";"http://127.0.0.1:11430/api/health\"}");
  <$fallbackresponse{
    statuscode:503;
    containsmokeversion:str.contains(body;"\"moke\":\"0.2.0\"");
    containslokestatus:str.contains(body;"\"loke\":\"unreachable\"");
    containsollamastatus:str.contains(body;"\"ollama\":\"unknown\"")
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describehealthhandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.health")){pass=pass+1}el{fail=fail+1};

  (* test: loke health url is correct *)
  if(str.eq(info.lokeurl;"http://127.0.0.1:11430/api/health")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes GET function *)
  if(info.hasget){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.log *)
  if(info.importslog){pass=pass+1}el{fail=fail+1};

  (* test: fallback response returns 503 *)
  let fb=buildfallback();
  if(fb.statuscode = 503){pass=pass+1}el{fail=fail+1};

  (* test: fallback contains moke version *)
  if(fb.containsmokeversion){pass=pass+1}el{fail=fail+1};

  (* test: fallback contains loke unreachable status *)
  if(fb.containslokestatus){pass=pass+1}el{fail=fail+1};

  (* test: fallback contains ollama unknown status *)
  if(fb.containsollamastatus){pass=pass+1}el{fail=fail+1};

  <fail
};

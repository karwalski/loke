m=packages.moke.tests.testddl;

i=t:std.test;
i=str:std.str;
i=ddl:moke.ddl;

(* X7.2 - the dashboard description language, through the real moke.ddl: building a
   dashboard from cards, validating it, and its JSON. The file used to declare its own card
   types and serialiser. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let d0=ddl.newdashboard("Sales";"Revenue by region");
  if(t.assert(!ddl.validate(d0);"a dashboard with no cards is not valid")){pass=pass+1}el{fail=fail+1};
  let d1=ddl.addcard(d0;ddl.newmetric("m1";"Orders";1 as i32;"count";"order_id"));
  let d2=ddl.addcard(d1;ddl.newchart("c1";"By region";2 as i32;"bar";"region";"spend";"sum"));
  let d3=ddl.addcard(d2;ddl.newtable("t1";"Top";2 as i32;@("region";"spend");"top";"spend";5 as i32));
  let d4=ddl.addcard(d3;ddl.newtext("x1";"Notes: \"quarter\" to date"));
  if(t.assert(d4.cards.len==4;"cards are added")){pass=pass+1}el{fail=fail+1};
  if(t.assert(d0.cards.len==0;"to a new dashboard, leaving the old one as it was")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ddl.validate(d4);"a titled dashboard with identified cards is valid")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ddl.validate(ddl.addcard(ddl.newdashboard("  ";"s");ddl.newtext("x";"y")));"a blank title is not")){pass=pass+1}el{fail=fail+1};

  let j=ddl.tojson(d4);
  if(t.assert(str.startswith(j;"{\"title\":\"Sales\",\"summary\":\"Revenue by region\",\"cards\":[");"the dashboard serialises its title and summary")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"kind\":\"metric\"") && str.contains(j;"\"metric\":{\"label\":\"Orders\"");"a metric card carries its metric block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"chart_type\":\"bar\"") && str.contains(j;"\"x_col\":\"region\"");"a chart card its chart")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"columns\":[\"region\",\"spend\"]") && str.contains(j;"\"limit\":5");"a table card its columns and limit")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"Notes: \\\"quarter\\\" to date");"and text is escaped")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(j;"]}");"closing the card list and the object")){pass=pass+1}el{fail=fail+1};
  let demo=ddl.demodashboard();
  if(t.assert(ddl.validate(demo) && demo.cards.len>3;"the demo dashboard is valid and has cards")){pass=pass+1}el{fail=fail+1};

  <fail
}

m=packages.moke.tests.testddl;
i=t:std.test;
i=str:std.str;

(* Stub types for dashboard definition language *)
t=$dashboardcard{
  id:str;
  title:str;
  charttype:str;
  datasource:str;
  width:i64
};

(* Valid chart types *)
f=isvalidcharttype(ct:str):bool{
  if(str.eq(ct;"bar")){<true}el{
  if(str.eq(ct;"line")){<true}el{
  if(str.eq(ct;"pie")){<true}el{
  if(str.eq(ct;"table")){<true}el{
  if(str.eq(ct;"metric")){<true}el{
  <false
  }}}}}
};

(* Stub: construct a dashboard card *)
f=buildcard(id:str;title:str;charttype:str;datasource:str;width:i64):$dashboardcard{
  <$dashboardcard{
    id:id;
    title:title;
    charttype:charttype;
    datasource:datasource;
    width:width
  }
};

(* Stub: serialise card to JSON *)
f=cardtojson(c:$dashboardcard):str{
  <str.concat("{\"id\":\"";str.concat(c.id;str.concat("\",\"title\":\"";str.concat(c.title;str.concat("\",\"chartType\":\"";str.concat(c.charttype;str.concat("\",\"dataSource\":\"";str.concat(c.datasource;str.concat("\",\"width\":";str.concat(str.i64tostr(c.width);"}"))))))))))
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: card construction preserves id *)
  let card=buildcard("card-01";"Revenue";"bar";"sales_data";6);
  if(t.assert(str.eq(card.id;"card-01");"card id preserved")){pass=pass+1}el{fail=fail+1};

  (* test: card construction preserves title *)
  if(t.assert(str.eq(card.title;"Revenue");"card title preserved")){pass=pass+1}el{fail=fail+1};

  (* test: card construction preserves chart type *)
  if(t.assert(str.eq(card.charttype;"bar");"card charttype preserved")){pass=pass+1}el{fail=fail+1};

  (* test: card JSON contains all fields *)
  let json=cardtojson(card);
  if(t.assert(str.contains(json;"\"id\":\"card-01\"");"card JSON has id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"title\":\"Revenue\"");"card JSON has title")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"chartType\":\"bar\"");"card JSON has chartType")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"dataSource\":\"sales_data\"");"card JSON has dataSource")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"width\":6");"card JSON has width")){pass=pass+1}el{fail=fail+1};

  (* test: bar is valid chart type *)
  if(t.assert(isvalidcharttype("bar");"bar is valid")){pass=pass+1}el{fail=fail+1};

  (* test: line is valid chart type *)
  if(t.assert(isvalidcharttype("line");"line is valid")){pass=pass+1}el{fail=fail+1};

  (* test: pie is valid chart type *)
  if(t.assert(isvalidcharttype("pie");"pie is valid")){pass=pass+1}el{fail=fail+1};

  (* test: table is valid chart type *)
  if(t.assert(isvalidcharttype("table");"table is valid")){pass=pass+1}el{fail=fail+1};

  (* test: metric is valid chart type *)
  if(t.assert(isvalidcharttype("metric");"metric is valid")){pass=pass+1}el{fail=fail+1};

  (* test: scatter is not a valid chart type *)
  if(t.assert(isvalidcharttype("scatter") = false;"scatter is invalid")){pass=pass+1}el{fail=fail+1};

  (* test: empty string is not a valid chart type *)
  if(t.assert(isvalidcharttype("") = false;"empty is invalid")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testpipelinepanel;
i=t:std.test;
i=str:std.str;

(* Local types for self-contained testing *)
t=$pipelinestage{
  id:str;
  label:str;
  order:i64
};

t=$stagestatus{
  stageid:str;
  symbol:str;
  state:str
};

f=stages():@$pipelinestage{
  <@(
    $pipelinestage{id:"schema_extract";label:"Schema Extract";order:1};
    $pipelinestage{id:"consent_check";label:"Consent Check";order:2};
    $pipelinestage{id:"anonymise";label:"Anonymise";order:3};
    $pipelinestage{id:"token_optimise";label:"Token Optimise";order:4};
    $pipelinestage{id:"route";label:"Route";order:5};
    $pipelinestage{id:"llm_call";label:"LLM Call";order:6};
    $pipelinestage{id:"restore";label:"Restore";order:7};
    $pipelinestage{id:"audit_log";label:"Audit Log";order:8};
    $pipelinestage{id:"respond";label:"Respond";order:9}
  )
};

f=statussymbol(state:str):str{
  if(str.eq(state;"pending")){<"[ ]"}el{
  if(str.eq(state;"active")){<"X"}el{
  if(str.eq(state;"complete")){<"[ok]"}el{
  if(str.eq(state;"skipped")){<"[--]"}el{
  if(str.eq(state;"error")){<"[!!]"}el{
  <"?"
  }}}}}
};

f=stagelabel(id:str):str{
  if(str.eq(id;"schema_extract")){<"Schema Extract"}el{
  if(str.eq(id;"consent_check")){<"Consent Check"}el{
  if(str.eq(id;"anonymise")){<"Anonymise"}el{
  if(str.eq(id;"token_optimise")){<"Token Optimise"}el{
  if(str.eq(id;"route")){<"Route"}el{
  if(str.eq(id;"llm_call")){<"LLM Call"}el{
  if(str.eq(id;"restore")){<"Restore"}el{
  if(str.eq(id;"audit_log")){<"Audit Log"}el{
  if(str.eq(id;"respond")){<"Respond"}el{
  <"Unknown"
  }}}}}}}}};
};

f=makestatus(stageid:str;state:str):$stagestatus{
  <$stagestatus{
    stageid:stageid;
    symbol:statussymbol(state);
    state:state
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: all 9 pipeline stages exist *)
  let allstages=stages();
  if(str.arraylen(allstages) = 9){pass=pass+1}el{fail=fail+1};

  (* test: first stage is schema_extract *)
  let s1=str.arrayget(allstages;0);
  if(str.eq(s1.id;"schema_extract")){pass=pass+1}el{fail=fail+1};

  (* test: last stage is respond *)
  let s9=str.arrayget(allstages;8);
  if(str.eq(s9.id;"respond")){pass=pass+1}el{fail=fail+1};

  (* test: stage labels are human-readable *)
  if(str.eq(stagelabel("schema_extract");"Schema Extract")){pass=pass+1}el{fail=fail+1};
  if(str.eq(stagelabel("consent_check");"Consent Check")){pass=pass+1}el{fail=fail+1};
  if(str.eq(stagelabel("anonymise");"Anonymise")){pass=pass+1}el{fail=fail+1};
  if(str.eq(stagelabel("llm_call");"LLM Call")){pass=pass+1}el{fail=fail+1};

  (* test: pending symbol is circle *)
  let pending=statussymbol("pending");
  if(str.eq(pending;"[ ]")){pass=pass+1}el{fail=fail+1};

  (* test: active symbol is filled circle *)
  let active=statussymbol("active");
  if(str.eq(active;"X")){pass=pass+1}el{fail=fail+1};

  (* test: complete symbol is checkmark *)
  let complete=statussymbol("complete");
  if(str.eq(complete;"[ok]")){pass=pass+1}el{fail=fail+1};

  (* test: skipped symbol is dash *)
  let skipped=statussymbol("skipped");
  if(str.eq(skipped;"[--]")){pass=pass+1}el{fail=fail+1};

  (* test: error symbol is cross *)
  let errorsym=statussymbol("error");
  if(str.eq(errorsym;"[!!]")){pass=pass+1}el{fail=fail+1};

  (* test: make status builds correct struct *)
  let st=makestatus("anonymise";"active");
  if(str.eq(st.stageid;"anonymise")){pass=pass+1}el{fail=fail+1};
  if(str.eq(st.state;"active")){pass=pass+1}el{fail=fail+1};

  <fail
};

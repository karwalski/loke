m=packages.moke.tests.testdatasetstore;

i=t:std.test;
i=str:std.str;
i=reg:moke.data.registry;
i=compute:moke.compute;

(* MK19.1 — `moke.data.registry.getdataset`, the server's half of the one dataset store.

   The server used to read data/csv through four modules and a hand-written dispatch, and
   the pages read a different object inline in templates/index.tkt. Six ids named a
   different table on each side: au.medicare was 30 rows and 26 columns from /api/datasets
   and 500 and 28 on the landing page. Both now come from packages/moke/static/data, which
   this module reads through manifest.json.

   So the assertions are that the SERVER sees the same table as the page for an id both
   use, that a table only the old backend held is still reachable under its id, that the
   old backend's variant of a shared id survived under its compact. id, and that an id the
   manifest does not name loads nothing — including one shaped like a path, because the id
   comes from a request body.

   Run from the repository root (as scripts/run_tests.sh does): the store is found at
   packages/moke/static/data. *)

f=ds(id:str):$dataset{
  <reg.getdataset(id)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* The table the landing page lists under au.medicare, not the backend's 30-row one. *)
  let med:$dataset=ds("au.medicare");
  if(t.assert(med.rows.len==500;"au.medicare is the 500-row table the page loads, not the 30-row backend copy")){pass=pass+1}el{fail=fail+1};
  if(t.assert(med.headers.len==28;"with the page's 28 columns")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(med.name;"Medicare Benefits Schedule";"and the manifest's name")){pass=pass+1}el{fail=fail+1};

  (* The backend's variant kept its rows under its own id. *)
  let cmed:$dataset=ds("compact.au.medicare");
  if(t.assert(cmed.rows.len==30;"compact.au.medicare is the backend's 30-row table, kept rather than lost")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cmed.headers.len==26;"with its own 26 columns")){pass=pass+1}el{fail=fail+1};

  (* A table only the old backend held, still under its old id. *)
  let traffic:$dataset=ds("it_platform.wc_traffic");
  if(t.assert(traffic.rows.len==30;"it_platform.wc_traffic, which only the backend held, still loads under its id")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(traffic.headers.get(0);"date";"and its first column is the file's")){pass=pass+1}el{fail=fail+1};

  (* The generated one: 10,000 rows used to be produced in the browser by generate(). *)
  let perf:$dataset=ds("it_hardware.performance_metrics");
  if(t.assert(perf.rows.len==10000;"the 10,000-row metrics table, once generated in the browser, loads whole")){pass=pass+1}el{fail=fail+1};
  if(t.assert(perf.headers.len==12;"with 12 columns")){pass=pass+1}el{fail=fail+1};

  (* A real snapshot is in the same store. *)
  let road:$dataset=ds("bitre.road_fatalities");
  if(t.assert(road.rows.len==4000;"the BITRE snapshot loads its 4,000 rows from the same store")){pass=pass+1}el{fail=fail+1};

  (* Ids the manifest does not name. The first was the backend's file name; the second is
     a path, which must not be read even though the file exists. *)
  let gone:$dataset=ds("au_datasets_medicare");
  if(t.assert(gone.rows.len==0;"an id the manifest does not name loads nothing")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(gone.name;"";"and answers no name, which /api/datasets turns into a 404")){pass=pass+1}el{fail=fail+1};
  let path:$dataset=ds("../static/data/fixtures/au.opal");
  if(t.assert(path.rows.len==0;"an id shaped like a path is not turned into one")){pass=pass+1}el{fail=fail+1};

  <fail
};

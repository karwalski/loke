m=packages.moke.tests.testagentsstatus;
i=t:std.test;
i=str:std.str;

(* Stub types for agent status *)
t=$agentstatus{
  id:str;
  name:str;
  state:str;
  taskcount:i64;
  errorcount:i64
};

(* Stub: construct an agent status *)
f=buildstatus(id:str;name:str;state:str;taskcount:i64;errorcount:i64):$agentstatus{
  <$agentstatus{
    id:id;
    name:name;
    state:state;
    taskcount:taskcount;
    errorcount:errorcount
  }
};

(* Stub: check if agent is healthy *)
f=ishealthy(s:$agentstatus):bool{
  if(str.eq(s.state;"running")){
    if(s.errorcount = 0){<true}el{<false}
  }el{<false}
};

(* Stub: format agent status summary *)
f=formatsummary(s:$agentstatus):str{
  <str.concat(s.name;str.concat(" [";str.concat(s.state;str.concat("] tasks:";str.concat(str.i64tostr(s.taskcount);str.concat(" errors:";str.i64tostr(s.errorcount)))))))
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: agent status construction preserves id *)
  let a=buildstatus("agent-01";"privacy-filter";"running";42;0);
  if(t.assert(str.eq(a.id;"agent-01");"agent id preserved")){pass=pass+1}el{fail=fail+1};

  (* test: agent status construction preserves name *)
  if(t.assert(str.eq(a.name;"privacy-filter");"agent name preserved")){pass=pass+1}el{fail=fail+1};

  (* test: agent status construction preserves state *)
  if(t.assert(str.eq(a.state;"running");"agent state preserved")){pass=pass+1}el{fail=fail+1};

  (* test: agent status construction preserves taskcount *)
  if(t.assert(a.taskcount = 42;"agent taskcount preserved")){pass=pass+1}el{fail=fail+1};

  (* test: running agent with no errors is healthy *)
  if(t.assert(ishealthy(a);"running no-error agent is healthy")){pass=pass+1}el{fail=fail+1};

  (* test: running agent with errors is not healthy *)
  let a2=buildstatus("agent-02";"router";"running";10;3);
  if(t.assert(ishealthy(a2) = false;"running with errors is not healthy")){pass=pass+1}el{fail=fail+1};

  (* test: stopped agent is not healthy *)
  let a3=buildstatus("agent-03";"optimizer";"stopped";5;0);
  if(t.assert(ishealthy(a3) = false;"stopped agent is not healthy")){pass=pass+1}el{fail=fail+1};

  (* test: summary contains agent name *)
  let summary=formatsummary(a);
  if(t.assert(str.contains(summary;"privacy-filter");"summary has name")){pass=pass+1}el{fail=fail+1};

  (* test: summary contains state *)
  if(t.assert(str.contains(summary;"running");"summary has state")){pass=pass+1}el{fail=fail+1};

  (* test: summary contains task count *)
  if(t.assert(str.contains(summary;"42");"summary has task count")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testagentsstatus;

i=t:std.test;
i=str:std.str;
i=ast:moke.agents.status;

(* X4b.14 / X7.2 - agent status construction and panel state, through the real
   moke.agents.status. The file used to declare its own status type. *)

f=ok(entry:$agentrunentry):$agentrunentry{
  <ast.completerun(entry;"2026-09-27T01:00:05Z";5000 as i32;120 as i32;0.002;3 as i32;"3 findings")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let a0:$agentstatus=ast.newagentstatus("scanner";"Data Quality Scanner";"scans datasets";"0 2 * * *";"schedule");
  if(t.asserteq(a0.status;"idle";"a new agent is idle")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(a0.lastrun;"never";"has never run")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(a0.nextrun;"0 2 * * *";"and a scheduled agent's next run is its schedule")){pass=pass+1}el{fail=fail+1};
  let m0:$agentstatus=ast.newagentstatus("m";"Manual";"d";"";"manual");
  if(t.asserteq(m0.nextrun;"manual";"a manual agent's next run says manual")){pass=pass+1}el{fail=fail+1};

  let r1=ok(ast.newrunentry("run-1";"scanner";"2026-09-27T01:00:00Z"));
  if(t.asserteq(r1.status;"success";"a completed run is a success")){pass=pass+1}el{fail=fail+1};
  let a1=ast.recordrun(a0;r1);
  if(t.assert(a1.totalruns==(1 as i32) && a1.totaltokens==(120 as i32);"recording it counts the run and its tokens")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(a1.lastrun;"2026-09-27T01:00:05Z";"and sets the last run")){pass=pass+1}el{fail=fail+1};
  let r2=ast.failrun(ast.newrunentry("run-2";"scanner";"2026-09-27T02:00:00Z");"2026-09-27T02:00:01Z";1000 as i32;"dataset missing");
  let a2=ast.recordrun(a1;r2);
  if(t.asserteq(a2.status;"error";"a failed run puts the agent in error")){pass=pass+1}el{fail=fail+1};
  if(t.assert(a2.successrate>49.9 && a2.successrate<50.1;"one success in two is 50%")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ast.countstatus(a2.runhistory;"error")==1;"the history holds the failure")){pass=pass+1}el{fail=fail+1};

  let many=mut.a2;
  lp(let i=0;i<60;i=i+1){
    many=ast.recordrun(many;ok(ast.newrunentry(str.concat("r";str.fromint(i));"scanner";"t")))
  };
  let mh:$agentstatus=many;
  if(t.assert(mh.runhistory.len==50;"the run history is trimmed to the last 50")){pass=pass+1}el{fail=fail+1};
  if(t.assert(mh.totalruns==(62 as i32);"while the all-time run count keeps counting")){pass=pass+1}el{fail=fail+1};
  if(t.assert(mh.successrate>99.9;"and the success rate is over the retained history, so an agent that recovered reads 100%")){pass=pass+1}el{fail=fail+1};

  let panel=ast.buildpanelstate(@(a2;a0);"2026-09-27T03:00:00Z");
  if(t.assert(panel.totalagents==(2 as i32) && panel.errorcount==(1 as i32) && panel.runningcount==(0 as i32);"the panel counts agents, errors and running ones")){pass=pass+1}el{fail=fail+1};
  let j=ast.panelstatetojson(panel);
  if(t.assert(str.contains(j;"\"agent_id\":\"scanner\"") && str.contains(j;"\"last_updated\":\"2026-09-27T03:00:00Z\"");"the panel serialises each agent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(j;"\"\"scanner") && !str.contains(j;"\"\"2026");"with no value doubly quoted")){pass=pass+1}el{fail=fail+1};

  <fail
}

m=test.moke.agentstest;
i=scanner:moke.agents.qualityscanner;
i=detector:moke.agents.schemadetector;
i=status:moke.agents.status;
i=hooks:moke.hooks;
i=assert:std.assert;


f=testdefaultconfig():i64{
  let config=scanner.defaultconfig();
  assert.eqf32(config.zscorethreshold;3.0;0.01;"default zscore threshold should be 3.0");
  assert.true(config.iqrenabled;"IQR should be enabled by default");
  assert.eqf32(config.correlationthreshold;0.9;0.01;"default correlation threshold should be 0.9")
};

f=testnewreport():i64{
  let report=scanner.newreport("test-scan-1";"2026-04-25T00:00:00Z");
  assert.eq(report.scanid;"test-scan-1";"scan_id should match");
  assert.eq(report.datasetsscanned;0;"should start at 0 datasets");
  assert.eq(report.totalfindings;0;"should start at 0 findings");
  assert.eq(report.status;"complete";"initial status should be complete")
};

f=testclassifyseveritycritical():i64{
  let finding=scanner.$scanfinding{
    datasetid:"test";
    column:"col1";
    kind:"zscore";
    severity:$scanner.classifyseverity(10;5.5);
    detail:"test";
    anomalycount:10;
    score:5.5
  };
  assert.eq(finding.severity;"critical";"10+ anomalies should be critical")
};

f=testaddfindings():i64{
  let report=scanner.newreport("scan-1";"now");
  let findings=@(
    scanner.$scanfinding{
      datasetid:"ds1";column="col1";kind="zscore";severity="critical";
      detail:"test";anomalycount=10;score=4.0
    };
    scanner.$scanfinding{
      datasetid:"ds1";column="col2";kind="iqr";severity="warning";
      detail:"test";anomalycount=5;score=2.0
    };
    scanner.$scanfinding{
      datasetid:"ds1";column="col3";kind="correlation";severity="info";
      detail:"test";anomalycount=1;score=0.95
    };
  );
  let report=scanner.addfindings(report;findings);
  assert.eq(report.totalfindings;3;"should have 3 findings");
  assert.eq(report.criticalcount;1;"should have 1 critical");
  assert.eq(report.warningcount;1;"should have 1 warning");
  assert.eq(report.infocount;1;"should have 1 info");
  assert.eq(report.datasetsscanned;1;"should have scanned 1 dataset")
};

f=testreporttojson():i64{
  let report=scanner.newreport("scan-json";"now");
  let json=scanner.reporttojson(report);
  assert.contains(json;"\"scan_id\"";"JSON should contain scan_id");
  assert.contains(json;"\"findings\"";"JSON should contain findings");
  assert.contains(json;"\"status\"";"JSON should contain status")
};

f=testreporttodiary():i64{
  let report=scanner.newreport("scan-diary";"2026-04-25");
  let findings=@(
    scanner.$scanfinding{
      datasetid:"ds1";column="price";kind="zscore";severity="warning";
      detail:"3 outliers detected";anomalycount=3;score=3.5
    };
  );
  let report=scanner.addfindings(report;findings);
  let diary=scanner.reporttodiary(report);
  assert.contains(diary;"Data Quality Scan";"diary should contain header");
  assert.contains(diary;"[WARN]";"diary should contain warning marker");
  assert.contains(diary;"3 outliers";"diary should contain finding detail")
};


f=testcompareschemasnochanges():i64{
  let oldschema=hooks.$schemaprofile{
    datasetname:"test";
    rowcount:100;
    colcount:2;
    columns:@(
      hooks.$colprofile{name="id";coltype="numeric";nullcount=0;uniquecount=100;samplevalues=@();minval="1";maxval="100";meanval="50"};
      hooks.$colprofile{name="name";coltype="text";nullcount=0;uniquecount=90;samplevalues=@();minval="";maxval="";meanval=""};
    )
  };
  let diff=detector.compareschemas("test";oldschema;oldschema;"now");
  assert.eq(diff.changes.len();0;"identical schemas should have 0 changes");
  assert.false(diff.hasbreakingchanges;"should have no breaking changes")
};

f=testcompareschemasaddedcolumn():i64{
  let oldschema=hooks.$schemaprofile{
    datasetname:"test";rowcount=100;colcount=1;
    columns:@i64;minval="";maxval="";meanval=""})
  };
  let newschema=hooks.$schemaprofile{
    datasetname:"test";rowcount=100;colcount=2;
    columns:@(
      hooks.$colprofile{name="id";coltype="numeric";nullcount=0;uniquecount=100;samplevalues=@();minval="";maxval="";meanval=""};
      hooks.$colprofile{name="email";coltype="text";nullcount=0;uniquecount=90;samplevalues=@();minval="";maxval="";meanval=""};
    )
  };
  let diff=detector.compareschemas("test";oldschema;newschema;"now");
  assert.eq(diff.changes.len();1;"should have 1 change");
  assert.eq(diff.changes.get(0).changetype;"added";"change type should be added");
  assert.eq(diff.changes.get(0).column;"email";"changed column should be email")
};

f=testcompareschemasremovedcolumn():i64{
  let oldschema=hooks.$schemaprofile{
    datasetname:"test";rowcount=100;colcount=2;
    columns:@(
      hooks.$colprofile{name="id";coltype="numeric";nullcount=0;uniquecount=100;samplevalues=@();minval="";maxval="";meanval=""};
      hooks.$colprofile{name="phone";coltype="text";nullcount=0;uniquecount=90;samplevalues=@();minval="";maxval="";meanval=""};
    )
  };
  let newschema=hooks.$schemaprofile{
    datasetname:"test";rowcount=100;colcount=1;
    columns:@i64;minval="";maxval="";meanval=""})
  };
  let diff=detector.compareschemas("test";oldschema;newschema;"now");
  assert.eq(diff.changes.len();1;"should have 1 change");
  assert.eq(diff.changes.get(0).changetype;"removed";"change type should be removed");
  assert.true(diff.hasbreakingchanges;"removed column should be breaking")
};

f=testcompareschemastypechanged():i64{
  let oldschema=hooks.$schemaprofile{
    datasetname:"test";rowcount=100;colcount=1;
    columns:@i64;minval="";maxval="";meanval=""})
  };
  let newschema=hooks.$schemaprofile{
    datasetname:"test";rowcount=100;colcount=1;
    columns:@i64;minval="";maxval="";meanval=""})
  };
  let diff=detector.compareschemas("test";oldschema;newschema;"now");
  assert.eq(diff.changes.len();1;"should have 1 change");
  assert.eq(diff.changes.get(0).changetype;"type_changed";"should detect type change");
  assert.eq(diff.changes.get(0).oldvalue;"text";"old type should be text");
  assert.eq(diff.changes.get(0).newvalue;"numeric";"new type should be numeric")
};

f=testdifftojson():i64{
  let diff=detector.$schemadiff{
    datasetid:"test";timestamp="now";
    oldrowcount:100;newrowcount=150;
    oldcolcount:3;newcolcount=4;
    changes:@();hasbreakingchanges=false;summary="no changes"
  };
  let json=detector.difftojson(diff);
  assert.contains(json;"\"dataset_id\"";"JSON should contain dataset_id");
  assert.contains(json;"\"changes\"";"JSON should contain changes")
};

f=testdifftodiary():i64{
  let diff=detector.$schemadiff{
    datasetid:"customers";timestamp="now";
    oldrowcount:100;newrowcount=200;
    oldcolcount:3;newcolcount=4;
    changes:@i64;
    hasbreakingchanges=false;summary="1 changes: 1 added, 0 removed, 0 type changed"
  };
  let diary=detector.difftodiary(diff);
  assert.contains(diary;"Schema Change Detected";"diary should contain header");
  assert.contains(diary;"[+]";"diary should contain add marker");
  assert.contains(diary;"email";"diary should mention email column")
};


f=testnewagentstatus():i64{
  let agent=status.newagentstatus("test-agent";"Test Agent";"A test agent";"0 2 * * *";"schedule");
  assert.eq(agent.agentid;"test-agent";"agent_id should match");
  assert.eq(agent.status;"idle";"initial status should be idle");
  assert.eq(agent.totalruns;0;"initial runs should be 0");
  assert.eqf64(agent.successrate;100.0;0.01;"initial success rate should be 100%")
};

f=testrecordrun():i64{
  let agent=status.newagentstatus("test";"Test";"desc";"daily";"schedule");
  let entry=status.newrunentry("run-1";"test";"2026-04-25T02:00:00Z");
  let entry=status.completerun(entry;"2026-04-25T02:01:00Z";60000;500;0.01;3;"3 findings");
  let agent=status.recordrun(agent;entry);
  assert.eq(agent.totalruns;1;"should have 1 run");
  assert.eq(agent.totaltokens;500;"should have 500 tokens");
  assert.eq(agent.runhistory.len();1;"history should have 1 entry");
  assert.eqf64(agent.successrate;100.0;0.01;"1 success should be 100%")
};

f=testrecordfailedrun():i64{
  let agent=status.newagentstatus("test";"Test";"desc";"daily";"schedule");
  let entry=status.newrunentry("run-1";"test";"now");
  let entry=status.failrun(entry;"now";100;"timeout");
  let agent=status.recordrun(agent;entry);
  assert.eq(agent.status;"error";"status should be error after failed run");
  assert.eqf64(agent.successrate;0.0;0.01;"0 successes from 1 run should be 0%")
};

f=testbuildpanelstate():i64{
  let agents=@(
    status.newagentstatus("a1";"Agent 1";"desc";"daily";"schedule");
    status.newagentstatus("a2";"Agent 2";"desc";"";"manual")
  );
  let panel=status.buildpanelstate(agents;"now");
  assert.eq(panel.totalagents;2;"should have 2 agents");
  assert.eq(panel.runningcount;0;"should have 0 running");
  assert.eq(panel.errorcount;0;"should have 0 errors")
};


f=testrunentrytojson():i64{
  let entry=status.newrunentry("run-json";"test";"now");
  let json=status.runentrytojson(entry);
  assert.contains(json;"\"run_id\"";"JSON should contain run_id");
  assert.contains(json;"\"status\"";"JSON should contain status");
  assert.contains(json;"\"running\"";"should show running status")
};

f=testagentstatustojson():i64{
  let agent=status.newagentstatus("test";"Test";"desc";"daily";"schedule");
  let json=status.agentstatustojson(agent);
  assert.contains(json;"\"agent_id\"";"JSON should contain agent_id");
  assert.contains(json;"\"run_history\"";"JSON should contain run_history");
  assert.contains(json;"\"success_rate\"";"JSON should contain success_rate")
};

f=testpanelstatetojson():i64{
  let agents=@(status.newagentstatus("a1";"Agent 1";"desc";"daily";"schedule"));
  let panel=status.buildpanelstate(agents;"now");
  let json=status.panelstatetojson(panel);
  assert.contains(json;"\"total_agents\"";"JSON should contain total_agents");
  assert.contains(json;"\"agents\"";"JSON should contain agents array")
};

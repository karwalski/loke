m=packages.moke.tests.testapistreamhandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.stream handler structure.
   The handler imports std.http, std.json, std.string, moke.hooks,
   moke.streaming, moke.routingexplainer, moke.costcomparison,
   and moke.consolelog. Exposes a post function that requires a prompt
   and forwards to loke pipeline with stream:true. *)

t=$handlerinfo{
  modulename:str;
  haspost:bool;
  importshttp:bool;
  importsjson:bool;
  importshooks:bool;
  importsstreaming:bool;
  upstreamurl:str
};

f=describestreamapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.stream";
    haspost:true;
    importshttp:true;
    importsjson:true;
    importshooks:true;
    importsstreaming:true;
    upstreamurl:"http://127.0.0.1:11430/api/pipeline"
  }
};

f=validateprompt(prompt:str):str{
  if(str.eq(prompt;"")){
    <"error:missing"
  };
  <"ok"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describestreamapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.stream")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes POST function *)
  if(info.haspost){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.hooks *)
  if(info.importshooks){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.streaming *)
  if(info.importsstreaming){pass=pass+1}el{fail=fail+1};

  (* test: upstream url is correct *)
  if(str.eq(info.upstreamurl;"http://127.0.0.1:11430/api/pipeline")){pass=pass+1}el{fail=fail+1};

  (* test: empty prompt is rejected *)
  let r1=validateprompt("");
  if(str.eq(r1;"error:missing")){pass=pass+1}el{fail=fail+1};

  (* test: valid prompt is accepted *)
  let r2=validateprompt("Summarise this data");
  if(str.eq(r2;"ok")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testapiagentshandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.agents handler structure.
   The handler imports std.http, std.json, std.string, and several moke agent modules,
   exposes get, postscan, postschema, and getdiary functions. *)

t=$handlerinfo{
  modulename:str;
  hasget:bool;
  haspostscan:bool;
  haspostschema:bool;
  hasgetdiary:bool;
  importshttp:bool;
  importsjson:bool;
  importsscanner:bool;
  importsdetector:bool;
  importsstatus:bool
};

f=describeagentsapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.agents";
    hasget:true;
    haspostscan:true;
    haspostschema:true;
    hasgetdiary:true;
    importshttp:true;
    importsjson:true;
    importsscanner:true;
    importsdetector:true;
    importsstatus:true
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describeagentsapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.agents")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes GET function *)
  if(info.hasget){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes postscan function *)
  if(info.haspostscan){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes postschema function *)
  if(info.haspostschema){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes getdiary function *)
  if(info.hasgetdiary){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.json *)
  if(info.importsjson){pass=pass+1}el{fail=fail+1};

  (* test: handler imports quality scanner *)
  if(info.importsscanner){pass=pass+1}el{fail=fail+1};

  (* test: handler imports schema detector *)
  if(info.importsdetector){pass=pass+1}el{fail=fail+1};

  (* test: handler imports agent status *)
  if(info.importsstatus){pass=pass+1}el{fail=fail+1};

  <fail
};

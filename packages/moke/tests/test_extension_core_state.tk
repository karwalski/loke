m=packages.moke.tests.testextensioncorestate;
i=t:std.test;
i=str:std.str;
i=ext:moke.extension.core;
i=mokehooks:moke.hooks;
i=mokeprovider:moke.provider;
i=gwhooks:core.extensions.gatewayhooks;
i=corehooks:core.extensions.pipelinehooks;
i=providers:core.extensions.providerregistry;

(* MK21.15 — the moke registry types no longer share names with core's, so `$corestate` can
   declare its six fields as what they are, and a literal of either side's type means one
   thing in a module that imports both.

   Until 2026-09-24 moke declared `$providerstore` and `$rulehookregistry`, the names of types
   in `core.extensions.providerregistry` and `core.extensions.gatewayhooks` with different
   fields. This file imports all four modules, as `moke/extensions/core.tk` does. A
   `$rulehookregistry{entries:@()}` literal here resolved to the CORE type (E4025), and every
   `$corestate` field was `i64`, so reading `.entries` through one was E4034.

   Built from literals, not `ext.init`: `init` reaches `moke.provider`, whose object needs
   `moke.compute`, which does not assemble (MK21.16), so a test that calls it cannot link. *)

f=mkstate():$corestate{
  <$corestate{
    hookregistry:$hookregistry{ hooks:@($hookfn{id:"core.pipe";slot:"after_anonymise"}) };
    gwregistry:$rulehookregistry{ hooks:@($rulehook{id:"core.guard";description:"d";severity:"block"}) };
    providerstore:$providerstore{ providers:@() };
    mokehookregistry:$mokepipelineregistry{ entries:@($pipelinehookentry{id:"moke.pipe";hookkey:"k1";slot:"after_anonymise"}) };
    mokeruleregistry:$mokeruleregistry{ entries:@($rulehookentry{id:"moke.rule";hookkey:"k2"}) };
    mokeproviderstore:$mokeproviderstore{ registrations:@() }
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let st:$corestate=mkstate();

  let rules:$mokeruleregistry=st.mokeruleregistry;
  if(t.assert(rules.entries.len==1;"moke's rule registry is read through its own type")){pass=pass+1}el{fail=fail+1};
  let re:$rulehookentry=rules.entries.get(0);
  if(t.assert(str.eq(re.id;"moke.rule");"and its entry comes back intact")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(re.hookkey;"k2");"including the field core's type does not have")){pass=pass+1}el{fail=fail+1};

  let gw:$rulehookregistry=st.gwregistry;
  if(t.assert(gw.hooks.len==1;"core's rule registry, in the same module, is still core's type")){pass=pass+1}el{fail=fail+1};
  let gh:$rulehook=gw.hooks.get(0);
  if(t.assert(str.eq(gh.severity;"block");"and reads at core's offsets")){pass=pass+1}el{fail=fail+1};

  let pipe:$mokepipelineregistry=st.mokehookregistry;
  let pe:$pipelinehookentry=pipe.entries.get(0);
  if(t.assert(str.eq(pe.slot;"after_anonymise");"moke's pipeline registry reads back its entry")){pass=pass+1}el{fail=fail+1};

  let ps:$mokeproviderstore=st.mokeproviderstore;
  if(t.assert(ps.registrations.len==0;"moke's provider store is its own type")){pass=pass+1}el{fail=fail+1};
  let cs:$providerstore=st.providerstore;
  if(t.assert(cs.providers.len==0;"and core's provider store is core's")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testconsolelog;

i=t:std.test;
i=str:std.str;
i=cl:moke.consolelog;

(* X4b.13: moke's per-stage console log, which rides in every pipeline response, tested
   against the real module. The typed disclosure fields must serialise as numbers when
   known and null when not, since a 0 would claim a measurement nobody made. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let s0=cl.newsession("req-1");
  if(t.assert(s0.entries.len==0;"a new session log is empty")){pass=pass+1}el{fail=fail+1};
  let s1=cl.append(s0;"schema_extract";"skip";"no raw data";0 as i32);
  let s2=cl.appendwith(s1;"llm_call";"ok";"forwarded";12 as i32;cl.withentities(cl.withfieldcount(cl.nodisclosure();4);2));
  if(t.assert(s2.entries.len==2;"append and appendwith each add an entry")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s1.entries.len==1;"and the log they were given is unchanged")){pass=pass+1}el{fail=fail+1};

  let j=cl.tojson(s2);
  if(t.assert(str.contains(j;"\"stage\":\"llm_call\"");"stages are serialised as strings, quoted once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"fields_disclosed_count\":4");"a known field count is a number")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"entities_total\":2");"and so is a known entity count")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"custody\":null");"an unknown custody is null, not an empty string")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"bytes_body\":null");"an unmeasured byte count is null, not 0")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(cl.jsontri(0-1);"null";"a three-valued flag that is unknown is null")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cl.jsontri(0);"false";"zero is false")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cl.jsontri(1);"true";"and one is true")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(cl.stagename("llm_call");"LLM Call";"a known stage has a display name")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cl.stagename("restore");"Entity Restore";"including restoration")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cl.stagename("mystery");"mystery";"an unknown stage is shown as given")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(cl.formatlog(s2);"LLM Call -- forwarded (12ms)");"the formatted log names the stage, the detail and the duration")){pass=pass+1}el{fail=fail+1};
  <fail
};

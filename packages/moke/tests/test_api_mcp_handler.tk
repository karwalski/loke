m=packages.moke.tests.testapimcphandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.mcp handler structure.
   The handler imports std.http, std.json, std.string, moke.mcp.toolpanel,
   moke.mcp.brokerstatus, and moke.mcp.memorydemo.
   Exposes gettools, postinvoke, getbroker, getmemory, and postmemory. *)

t=$handlerinfo{
  modulename:str;
  hasgettools:bool;
  haspostinvoke:bool;
  hasgetbroker:bool;
  hasgetmemory:bool;
  haspostmemory:bool;
  importshttp:bool;
  importsjson:bool;
  importstoolpanel:bool;
  importsbroker:bool;
  importsmemory:bool
};

f=describemcpapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.mcp";
    hasgettools:true;
    haspostinvoke:true;
    hasgetbroker:true;
    hasgetmemory:true;
    haspostmemory:true;
    importshttp:true;
    importsjson:true;
    importstoolpanel:true;
    importsbroker:true;
    importsmemory:true
  }
};

f=validatetoolname(name:str):str{
  if(str.len(name) = 0){
    <"error:required"
  };
  <"ok"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describemcpapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.mcp")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes gettools function *)
  if(info.hasgettools){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes postinvoke function *)
  if(info.haspostinvoke){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes getbroker function *)
  if(info.hasgetbroker){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes getmemory function *)
  if(info.hasgetmemory){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes postmemory function *)
  if(info.haspostmemory){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.json *)
  if(info.importsjson){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.mcp.toolpanel *)
  if(info.importstoolpanel){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.mcp.brokerstatus *)
  if(info.importsbroker){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.mcp.memorydemo *)
  if(info.importsmemory){pass=pass+1}el{fail=fail+1};

  (* test: empty tool name is rejected *)
  let r1=validatetoolname("");
  if(str.eq(r1;"error:required")){pass=pass+1}el{fail=fail+1};

  (* test: valid tool name is accepted *)
  let r2=validatetoolname("memory_store");
  if(str.eq(r2;"ok")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testprofiler;
i=t:std.test;
i=str:std.str;

(* Stub types for column profiling *)
t=$columnprofile{
  name:str;
  coltype:str;
  nullcount:i64;
  distinctcount:i64;
  ispii:bool
};

(* Stub: detect if a value looks numeric *)
f=isnumeric(val:str):bool{
  if(str.len(val) = 0){<false}el{
  if(str.contains(val;"0")){<true}el{
  if(str.contains(val;"1")){<true}el{
  if(str.contains(val;"2")){<true}el{
  if(str.contains(val;"3")){<true}el{
  if(str.contains(val;".")){<true}el{
  <false
  }}}}}}
};

(* Stub: detect if a column name suggests PII name pattern *)
f=ispiiname(colname:str):bool{
  if(str.contains(colname;"name")){<true}el{
  if(str.contains(colname;"email")){<true}el{
  if(str.contains(colname;"phone")){<true}el{
  if(str.contains(colname;"ssn")){<true}el{
  if(str.contains(colname;"address")){<true}el{
  <false
  }}}}}
};

(* Stub: infer column type from sample values *)
f=infertype(sampleval:str;distinctcount:i64;totalcount:i64):str{
  if(isnumeric(sampleval)){<"numeric"}el{
  if(distinctcount < 10){<"categorical"}el{
  <"text"
  }}
};

(* Stub: build column profile *)
f=profilecolumn(name:str;sampleval:str;nullcount:i64;distinctcount:i64;totalcount:i64):$columnprofile{
  <$columnprofile{
    name:name;
    coltype:infertype(sampleval;distinctcount;totalcount);
    nullcount:nullcount;
    distinctcount:distinctcount;
    ispii:ispiiname(name)
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: numeric detection for integer string *)
  if(t.assert(isnumeric("42");"42 is numeric")){pass=pass+1}el{fail=fail+1};

  (* test: numeric detection for decimal string *)
  if(t.assert(isnumeric("3.14");"3.14 is numeric")){pass=pass+1}el{fail=fail+1};

  (* test: non-numeric detection *)
  if(t.assert(isnumeric("hello") = false;"hello is not numeric")){pass=pass+1}el{fail=fail+1};

  (* test: empty string is not numeric *)
  if(t.assert(isnumeric("") = false;"empty is not numeric")){pass=pass+1}el{fail=fail+1};

  (* test: categorical detection for low cardinality *)
  if(t.assert(str.eq(infertype("red";5;100);"categorical");"low cardinality is categorical")){pass=pass+1}el{fail=fail+1};

  (* test: numeric type inference *)
  if(t.assert(str.eq(infertype("123";50;100);"numeric");"numeric value inferred as numeric")){pass=pass+1}el{fail=fail+1};

  (* test: text type for high cardinality non-numeric *)
  if(t.assert(str.eq(infertype("hello world";50;100);"text");"high cardinality text is text")){pass=pass+1}el{fail=fail+1};

  (* test: PII name pattern detects name column *)
  if(t.assert(ispiiname("first_name");"first_name is PII")){pass=pass+1}el{fail=fail+1};

  (* test: PII name pattern detects email column *)
  if(t.assert(ispiiname("email_address");"email_address is PII")){pass=pass+1}el{fail=fail+1};

  (* test: PII name pattern detects phone column *)
  if(t.assert(ispiiname("phone_number");"phone_number is PII")){pass=pass+1}el{fail=fail+1};

  (* test: non-PII column name *)
  if(t.assert(ispiiname("created_at") = false;"created_at is not PII")){pass=pass+1}el{fail=fail+1};

  (* test: profile column integrates type and PII *)
  let prof=profilecolumn("customer_name";"Alice";2;80;100);
  if(t.assert(str.eq(prof.coltype;"text");"profile infers text type")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispii;"profile detects PII name")){pass=pass+1}el{fail=fail+1};

  (* test: profile numeric column *)
  let numprof=profilecolumn("revenue";"10250";0;95;100);
  if(t.assert(str.eq(numprof.coltype;"numeric");"profile infers numeric")){pass=pass+1}el{fail=fail+1};
  if(t.assert(numprof.ispii = false;"revenue is not PII")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testprofiler;

i=t:std.test;
i=str:std.str;
i=pf:moke.profiler;

(* X7.2 - column profiling, through the real moke.profiler: type inference, the PII-name
   check, and the profile of a small table. The file used to declare its own versions of the
   three and assert them against themselves. *)

f=statfor(r:$profileresult;name:str):$colstats{
  let found=mut.r.stats.get(0);
  lp(let i=0;i<r.stats.len;i=i+1){
    let c:$colstats=r.stats.get(i);
    if(str.eq(c.name;name)){ found=c }el{}
  };
  <found
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.assert(pf.isnumericstr("42") && pf.isnumericstr("-3.5");"integers and decimals are numeric")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pf.isnumericstr("4a") && !pf.isnumericstr("");"text and the empty string are not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(pf.ispiiname("email") && pf.ispiiname("full_name");"email and full_name look like PII columns")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pf.ispiiname("spend");"spend does not")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(pf.infertype(@("1";"2";"30"));"numeric";"a column of numbers is numeric")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(pf.infertype(@("true";"false";"true"));"boolean";"true and false are boolean")){pass=pass+1}el{fail=fail+1};

  let headers=@("id";"email";"region";"spend");
  let rows=@(@("1";"a@x.io";"north";"120");@("2";"b@x.io";"south";"80");@("3";"c@x.io";"north";"95"));
  let r:$profileresult=pf.profile(headers;rows;"customers");
  if(t.assert(r.rowcount==(3 as i32) && r.colcount==(4 as i32);"the profile counts rows and columns")){pass=pass+1}el{fail=fail+1};
  if(t.assert(r.stats.len==4;"with a statistic per column")){pass=pass+1}el{fail=fail+1};
  let em:$colstats=statfor(r;"email");
  if(t.assert(em.ispiicandidate;"the email column is flagged as a PII candidate")){pass=pass+1}el{fail=fail+1};
  if(t.assert(r.piicolcount>=(1 as i32);"and counted")){pass=pass+1}el{fail=fail+1};
  let sp:$colstats=statfor(r;"spend");
  if(t.asserteq(sp.inferredtype;"numeric";"spend is numeric")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sp.ispiicandidate;"and not PII")){pass=pass+1}el{fail=fail+1};
  let rg:$colstats=statfor(r;"region");
  if(t.assert(rg.uniquecount==(2 as i32);"region has two distinct values")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pf.formatprofile(r);"customers");"the formatted profile names the dataset")){pass=pass+1}el{fail=fail+1};

  <fail
}

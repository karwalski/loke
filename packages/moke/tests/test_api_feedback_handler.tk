m=packages.moke.tests.testapifeedbackhandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.feedback handler structure.
   The handler imports std.http, std.json, std.string, and std,
   exposes a post function that validates rating field
   and accepts only thumbs_up or thumbs_down. *)

t=$handlerinfo{
  modulename:str;
  haspost:bool;
  importshttp:bool;
  importsjson:bool
};

t=$validationresult{
  emptyrejected:bool;
  invalidrejected:bool;
  thumbsupaccepted:bool;
  thumbsdownaccepted:bool
};

f=describefeedbackhandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.feedback";
    haspost:true;
    importshttp:true;
    importsjson:true
  }
};

f=validaterating(rating:str):str{
  if(str.eq(rating;"")){
    <"error:missing"
  };
  if(!str.eq(rating;"thumbs_up") && !str.eq(rating;"thumbs_down")){
    <"error:invalid"
  };
  <"ok"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describefeedbackhandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.feedback")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes POST function *)
  if(info.haspost){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.json *)
  if(info.importsjson){pass=pass+1}el{fail=fail+1};

  (* test: empty rating is rejected *)
  let r1=validaterating("");
  if(str.eq(r1;"error:missing")){pass=pass+1}el{fail=fail+1};

  (* test: invalid rating is rejected *)
  let r2=validaterating("stars_5");
  if(str.eq(r2;"error:invalid")){pass=pass+1}el{fail=fail+1};

  (* test: thumbs_up is accepted *)
  let r3=validaterating("thumbs_up");
  if(str.eq(r3;"ok")){pass=pass+1}el{fail=fail+1};

  (* test: thumbs_down is accepted *)
  let r4=validaterating("thumbs_down");
  if(str.eq(r4;"ok")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testmcphandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.mcp handler structure.
   The handler imports std.http and ooke.template,
   and exposes a get function that renders templates/mcp.tkt. *)

t=$handlerinfo{
  modulename:str;
  templatepath:str;
  hasget:bool;
  importshttp:bool;
  importstemplate:bool
};

f=describemcphandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.mcp";
    templatepath:"templates/mcp.tkt";
    hasget:true;
    importshttp:true;
    importstemplate:true
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describemcphandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.mcp")){pass=pass+1}el{fail=fail+1};

  (* test: template path matches expected *)
  if(str.eq(info.templatepath;"templates/mcp.tkt")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes GET function *)
  if(info.hasget){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports ooke.template *)
  if(info.importstemplate){pass=pass+1}el{fail=fail+1};

  <fail
};

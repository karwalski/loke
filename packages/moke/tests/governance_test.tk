m=test.moke.governancetest;
i=g:moke.governance;
i=assert:std.assert;


f=testgetpresetsreturnsseven():i64{
  let presets=g.getpresets();
  assert.eq(presets.len;7;"should have 7 regulatory presets")
};

f=testpresetids():i64{
  let presets=g.getpresets();
  assert.eq(presets.get(0).id;"eu-gdpr";"first preset is EU GDPR");
  assert.eq(presets.get(1).id;"au-privacy";"second preset is AU Privacy Act");
  assert.eq(presets.get(2).id;"hipaa";"third preset is US HIPAA");
  assert.eq(presets.get(3).id;"ccpa";"fourth preset is US CCPA/CPRA");
  assert.eq(presets.get(4).id;"uk-gdpr";"fifth preset is UK GDPR");
  assert.eq(presets.get(5).id;"sg-pdpa";"sixth preset is Singapore PDPA");
  assert.eq(presets.get(6).id;"minimal";"seventh preset is Minimal")
};

f=testfindpresetvalid():i64{
  let result=g.findpreset("hipaa");
  let p=mt result {
    $ok:p p;
    $err:e <assert.fail("find_preset should succeed for hipaa")
  };
  assert.eq(p.name;"US HIPAA";"found HIPAA preset");
  assert.eq(p.classificationdefault;"restricted";"HIPAA default is restricted");
  assert.eq(p.anonymisationstrength;"full";"HIPAA strength is full");
  assert.false(p.crossborderallowed;"HIPAA disallows cross-border")
};

f=testfindpresetinvalid():i64{
  let result=g.findpreset("nonexistent");
  mt result {
    $ok:v assert.fail("find_preset should fail for nonexistent");
    $err:e assert.contains(e;"not found";"error should mention not found")
  };
};

f=testgdprblockedentities():i64{
  let result=g.findpreset("eu-gdpr");
  let p=mt result {
    $ok:p p;
    $err:e <assert.fail("should find eu-gdpr")
  };
  assert.eq(p.blockedentitytypes.len;7;"GDPR blocks 7 entity types");
  assert.eq(p.blockedentitytypes.get(0);"health";"first blocked is health")
};

f=testminimalpreset():i64{
  let result=g.findpreset("minimal");
  let p=mt result {
    $ok:p p;
    $err:e <assert.fail("should find minimal")
  };
  assert.eq(p.classificationdefault;"public";"minimal default is public");
  assert.true(p.crossborderallowed;"minimal allows cross-border");
  assert.eq(p.blockedentitytypes.len;0;"minimal blocks nothing");
  assert.eq(p.anonymisationstrength;"placeholder";"minimal strength is placeholder")
};

f=testccpaallowscrossborder():i64{
  let result=g.findpreset("ccpa");
  mt result {
    $ok:p assert.true(p.crossborderallowed;"CCPA allows cross-border");
    $err:e assert.fail("should find ccpa")
  };
};




f=testgeneratereportempty():i64{
  let report=g.generatereport("EU GDPR";@());
  assert.eq(report.totalrequests;0;"no requests");
  assert.eq(report.violations;0;"no violations");
  assert.eq(report.privacypct;100;"100% privacy with no requests")
};

f=testgeneratereportwithevents():i64{
  let events=@(
    g.$complianceevent{timestamp:"10:00:01";eventtype:"llm_call";detail:"test query";severity:"info";risktier:"Low"};
    g.$complianceevent{timestamp:"10:00:02";eventtype:"anonymise";detail:"redacted PII";severity:"info";risktier:"Medium"};
    g.$complianceevent{timestamp:"10:00:03";eventtype:"llm_call";detail:"blocked query";severity:"violation";risktier:"High"};
  );
  let report=g.generatereport("US HIPAA";events);
  assert.eq(report.totalrequests;3;"3 requests");
  assert.eq(report.violations;1;"1 violation");
  assert.eq(report.riskbreakdownlow;1;"1 low risk");
  assert.eq(report.riskbreakdownmedium;1;"1 medium risk");
  assert.eq(report.riskbreakdownhigh;1;"1 high risk");
  assert.eq(report.presetname;"US HIPAA";"preset name matches")
};

f=testgeneratereportprivacypct():i64{
  let events=@(
    g.$complianceevent{timestamp:"10:00:01";eventtype:"llm_call";detail:"ok";severity:"info";risktier:"Low"};
    g.$complianceevent{timestamp:"10:00:02";eventtype:"llm_call";detail:"ok";severity:"info";risktier:"Low"};
    g.$complianceevent{timestamp:"10:00:03";eventtype:"llm_call";detail:"bad";severity:"violation";risktier:"High"};
    g.$complianceevent{timestamp:"10:00:04";eventtype:"llm_call";detail:"ok";severity:"info";risktier:"Medium"};
  );
  let report=g.generatereport("EU GDPR";events);
  assert.eq(report.privacypct;75;"privacy should be 75%")
};

f=testreporttocsv():i64{
  let events=@(
    g.$complianceevent{timestamp:"10:00:01";eventtype:"llm_call";detail:"test";severity:"info";risktier:"Low"};
  );
  let report=g.generatereport("EU GDPR";events);
  let csv=g.reporttocsv(report);
  assert.contains(csv;"timestamp,event_type,detail,severity,risk_tier";"CSV has header");
  assert.contains(csv;"10:00:01";"CSV has timestamp");
  assert.contains(csv;"llm_call";"CSV has event type")
};

f=testreporttojson():i64{
  let events=@(
    g.$complianceevent{timestamp:"10:00:01";eventtype:"llm_call";detail:"test";severity:"info";risktier:"Low"};
  );
  let report=g.generatereport("AU Privacy Act";events);
  let json=g.reporttojson(report);
  assert.contains(json;"AU Privacy Act";"JSON contains preset name");
  assert.contains(json;"total_requests";"JSON contains total_requests");
  assert.contains(json;"risk_breakdown";"JSON contains risk_breakdown")
};


f=testclassifyrisklow():i64{
  let risk=g.classifyrisk("PUBLIC";0;false;false);
  assert.eq(risk.tier;"Low";"PUBLIC with no entities should be Low risk");
  assert.true(risk.score < 25;"score should be below 25")
};

f=testclassifyriskmedium():i64{
  let risk=g.classifyrisk("CONFIDENTIAL";5;false;false);
  assert.eq(risk.tier;"Medium";"CONFIDENTIAL with moderate entities should be Medium");
  assert.true(risk.score > 25;"score should be >= 25");
  assert.true(risk.score < 50;"score should be < 50")
};

f=testclassifyriskhigh():i64{
  let risk=g.classifyrisk("RESTRICTED";12;true;true);
  assert.eq(risk.tier;"High";"RESTRICTED with many entities and cross-border should be High");
  assert.true(risk.score > 50;"score should be >= 50")
};

f=testclassifyriskreasons():i64{
  let risk=g.classifyrisk("CONFIDENTIAL";8;true;false);
  assert.true(risk.reasons.len > 2;"should have at least 2 reasons");
  assert.contains(risk.reasons.get(0);"CONFIDENTIAL";"first reason mentions CONFIDENTIAL")
};

f=testclassifyriskblockedentitiesaddsscore():i64{
  let without=g.classifyrisk("PUBLIC";0;false;false);
  let withblocked=g.classifyrisk("PUBLIC";0;false;true);
  assert.true(withblocked.score > without.score;"blocked entities should increase score")
};

f=testclassifyriskcrossborderaddsscore():i64{
  let domestic=g.classifyrisk("INTERNAL";2;false;false);
  let cross=g.classifyrisk("INTERNAL";2;true;false);
  assert.true(cross.score > domestic.score;"cross-border should increase score")
};

f=testclassifyriskentitycounttiers():i64{
  let zero=g.classifyrisk("PUBLIC";0;false;false);
  let low=g.classifyrisk("PUBLIC";2;false;false);
  let mid=g.classifyrisk("PUBLIC";5;false;false);
  let high=g.classifyrisk("PUBLIC";15;false;false);
  assert.true(low.score > zero.score;"1-3 entities > 0 entities");
  assert.true(mid.score > low.score;"4-10 entities > 1-3 entities");
  assert.true(high.score > mid.score;"11+ entities > 4-10 entities")
};

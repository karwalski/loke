m=packages.moke.tests.testconsolelogdisclosure;
i=t:std.test;
i=str:std.str;
i=cl:moke.consolelog;

(* DA1.4 - typed disclosure fields on the per-stage record, against the real moke.consolelog.

   What is asserted is the wire form, because that is what a consumer reads: the fields are
   JSON numbers and booleans rather than strings (spec S3), and a field a stage did not measure
   is null rather than 0 (S5). Before DA1.4 the record had no disclosure fields at all, so the
   only place a column count existed was inside the prose of `detail`. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let log=cl.newsession("req-da14");
  let log2=cl.appendwith(log;"schema_extract";"ok";"raw data replaced with schema profile";3;cl.withfieldcount(cl.nodisclosure();12));
  let log3=cl.appendwith(log2;"response";"ok";"loke pipeline response received";40;cl.withentities(cl.nodisclosure();0));
  let log4=cl.append(log3;"llm_call";"ok";"forwarding";0);
  let js=cl.tojson(log4);

  if(t.assert(str.contains(js;"\"stage\":\"schema_extract\",\"status\":\"ok\"");"strings are quoted once, so the record is valid JSON (DA1.8)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(js;"\"\"");"no doubled quote anywhere in the record")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"fields_disclosed_count\":12");"the column count is a JSON number, not prose")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(js;"\"fields_disclosed_count\":\"12\"");"and not a quoted string")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"entities_total\":0");"a measured zero is emitted as 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"entities_total\":null");"an unmeasured count is null, not 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"custody\":null");"custody is null where nothing observed it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"real_values_included\":null");"the real-value gate is null, not false, when unmeasured")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"bytes_body\":null");"bytes are null where not measured")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"artifact_verdict\":null");"every S1 field is present")){pass=pass+1}el{fail=fail+1};

  (* The tri-state and string encodings, on a record with every field set. *)
  let full=$disclosure{
    custody:"redacted-data";
    bytesbody:512;
    bytesschemaprofile:200;
    tokensestimated:130;
    tokeniserid:"cl100k_base";
    fieldsdisclosedcount:4;
    entitiestotal:2;
    realvaluesincluded:1;
    resultsreturnedcells:0;
    artifactverdict:"accepted"
  };
  let js2=cl.tojson(cl.appendwith(cl.newsession("r2");"llm_call";"ok";"x";1;full));
  if(t.assert(str.contains(js2;"\"custody\":\"redacted-data\"");"custody is a JSON string when known")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js2;"\"real_values_included\":true");"the gate is a JSON boolean")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js2;"\"bytes_body\":512");"bytes are a JSON number")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js2;"\"results_returned_cells\":0");"a measured zero result count is 0")){pass=pass+1}el{fail=fail+1};

  <fail
};

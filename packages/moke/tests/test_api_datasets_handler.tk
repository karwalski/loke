m=packages.moke.tests.testapidatasetshandler;
i=t:std.test;
i=str:std.str;

(* Verify page.moke.api.datasets handler structure.
   The handler imports std.http, std.json, std.string, moke.data.registry,
   and moke.profiler. Exposes a post function that requires an id field. *)

t=$handlerinfo{
  modulename:str;
  haspost:bool;
  importshttp:bool;
  importsjson:bool;
  importsregistry:bool;
  importsprofiler:bool
};

f=describedatasetsapihandler():$handlerinfo{
  <$handlerinfo{
    modulename:"page.moke.api.datasets";
    haspost:true;
    importshttp:true;
    importsjson:true;
    importsregistry:true;
    importsprofiler:true
  }
};

f=validateid(id:str):str{
  if(str.len(str.trim(id)) = 0){
    <"error:missing id"
  };
  <"ok"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let info=describedatasetsapihandler();

  (* test: module name is correct *)
  if(str.eq(info.modulename;"page.moke.api.datasets")){pass=pass+1}el{fail=fail+1};

  (* test: handler exposes POST function *)
  if(info.haspost){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.http *)
  if(info.importshttp){pass=pass+1}el{fail=fail+1};

  (* test: handler imports std.json *)
  if(info.importsjson){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.data.registry *)
  if(info.importsregistry){pass=pass+1}el{fail=fail+1};

  (* test: handler imports moke.profiler *)
  if(info.importsprofiler){pass=pass+1}el{fail=fail+1};

  (* test: empty id is rejected *)
  let r1=validateid("");
  if(str.eq(r1;"error:missing id")){pass=pass+1}el{fail=fail+1};

  (* test: whitespace id is rejected *)
  let r2=validateid("   ");
  if(str.eq(r2;"error:missing id")){pass=pass+1}el{fail=fail+1};

  (* test: valid id is accepted *)
  let r3=validateid("ds-001");
  if(str.eq(r3;"ok")){pass=pass+1}el{fail=fail+1};

  <fail
};

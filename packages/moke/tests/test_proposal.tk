m=packages.moke.tests.testproposal;

i=t:std.test;
i=str:std.str;
i=pr:moke.ml.proposal;

(* NC1.3 - the Insight Lab's proposal path: what is asked of the model, and how its answer is
   read. The prompt carries column names and a schema profile, never a row. The reply is the
   loke pipeline's JSON with the model's text in `response`, and that text is a JSON array. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let prompt=pr.buildprompt("DATASET: sales | ROWS: 3";@("revenue";"orders");@("region"));
  if(t.assert(str.contains(prompt;"Numeric columns: revenue, orders") && str.contains(prompt;"Categorical columns: region");"the prompt names the columns by type")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(prompt;"SCHEMA PROFILE (no raw data)");"and says it carries a profile, not data")){pass=pass+1}el{fail=fail+1};

  let sugs=pr.parsellmsuggestions("{\"ok\":true,\"response\":\"[{\\\"kind\\\":\\\"kmeans\\\",\\\"title\\\":\\\"Segments\\\",\\\"description\\\":\\\"cluster\\\",\\\"columns\\\":[\\\"revenue\\\",\\\"orders\\\"],\\\"params\\\":\\\"{}\\\",\\\"rationale\\\":\\\"schema\\\"}]\"}");
  if(t.assert(sugs.len==1;"a model's reply wrapped by the loke pipeline yields its suggestion")){pass=pass+1}el{fail=fail+1};
  if(sugs.len==1){
    let s:$mlsuggestion=sugs.get(0);
    if(t.asserteq(s.kind;"kmeans";"with its kind")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(s.title;"Segments";"and title")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+2 };
  if(t.assert(pr.parsellmsuggestions("{\"ok\":false,\"error\":\"refused\"}").len==0;"a refusal yields no suggestions, so the caller falls back")){pass=pass+1}el{fail=fail+1};

  if(t.assert(pr.heuristicproposals(@("revenue";"orders";"ltv");@("region";"plan")).len==4;"three numeric and two categorical columns give four heuristic proposals")){pass=pass+1}el{fail=fail+1};
  let fb:$proposalresult=pr.fromschema("";@("revenue";"orders";"ltv");@("region";"plan"));
  if(t.asserteq(fb.source;"heuristic";"with no pipeline reachable, the result says it is heuristic")){pass=pass+1}el{fail=fail+1};

  <fail
}

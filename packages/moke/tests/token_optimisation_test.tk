m=test.moke.tokenoptimisationtest;
i=t:moke.tokenoptimisation;
i=assert:std.assert;


f=testestimatetokens():i64{
  let tokens=t.estimatetokens("hello world abcdef");
  assert.true(tokens >= 3;"should estimate at least 3 tokens for 18 chars");
  assert.true(tokens <= 6;"should estimate at most 6 tokens for 18 chars")
};

f=testestimatetokensempty():i64{
  let tokens=t.estimatetokens("");
  assert.eq(tokens;0;"empty string should be 0 tokens")
};

f=testmakecomparison():i64{
  let jsonstr="{\"name\":\"Alice\",\"age\":30,\"city\":\"Sydney\"}";
  let toonstr="name:Alice|age:30|city:Sydney";
  let cmp=t.makecomparison(jsonstr;toonstr);
  assert.true(cmp.originaltokens > cmp.toontokens;"TOON should use fewer tokens than JSON");
  assert.true(cmp.savingspct > 0.0;"savings percentage should be positive");
  assert.true(cmp.savingspct < 100.0;"savings percentage should be under 100")
};

f=testmakecomparisonequal():i64{
  let same="abc";
  let cmp=t.makecomparison(same;same);
  assert.eqf64(cmp.savingspct;0.0;0.01;"identical strings should yield 0% savings")
};


f=testllmlinguaactive():i64{
  let info=t.makellmlinguainfo(true;1000;400);
  assert.true(info.active;"should be active");
  assert.eqf64(info.compressionratio;0.4;0.01;"compression ratio should be 0.4")
};

f=testllmlinguainactive():i64{
  let info=t.makellmlinguainfo(false;0;0);
  assert.false(info.active;"should be inactive");
  assert.eqf64(info.compressionratio;1.0;0.01;"inactive should have ratio 1.0")
};


f=testcachehit():i64{
  let hit=t.makecachehit(500;0.0025;0.95);
  assert.true(hit.hit;"should be a hit");
  assert.eq(hit.savedtokens;500;"should save 500 tokens");
  assert.eqf64(hit.similarityscore;0.95;0.001;"similarity should be 0.95")
};

f=testcachemiss():i64{
  let miss=t.makecachemiss();
  assert.false(miss.hit;"should be a miss");
  assert.eq(miss.savedtokens;0;"miss should save 0 tokens")
};


f=testnewsavings():i64{
  let s=t.newsavings();
  assert.eqi64(s.totaltokenssaved;0;"new savings should start at 0");
  assert.eq(s.totalrequests;0;"new savings should have 0 requests")
};

f=testaddrequestwithcachehit():i64{
  let s=t.newsavings();
  let s=t.addrequest(s;100;0.001;true;false);
  assert.eqi64(s.totaltokenssaved;100;"should have 100 tokens saved");
  assert.eq(s.cachehits;1;"should have 1 cache hit");
  assert.eq(s.cachemisses;0;"should have 0 cache misses");
  assert.eq(s.totalrequests;1;"should have 1 request")
};

f=testaddrequestwithlocalcompute():i64{
  let s=t.newsavings();
  let s=t.addrequest(s;50;0.0;false;true);
  assert.eq(s.localcomputecount;1;"should have 1 local compute");
  assert.eq(s.cachemisses;1;"should have 1 cache miss")
};

f=testcachehitrate():i64{
  let s=t.newsavings();
  let s=t.addrequest(s;100;0.001;true;false);
  let s=t.addrequest(s;0;0.0;false;false);
  let s=t.addrequest(s;200;0.002;true;false);
  let rate=t.cachehitrate(s);
  assert.true(rate > 66.0;"cache hit rate should be > 66%");
  assert.true(rate < 67.0;"cache hit rate should be < 67%")
};

f=testcachehitrateempty():i64{
  let s=t.newsavings();
  let rate=t.cachehitrate(s);
  assert.eqf64(rate;0.0;0.01;"empty should be 0%")
};

f=testlocalcomputeratio():i64{
  let s=t.newsavings();
  let s=t.addrequest(s;0;0.0;false;true);
  let s=t.addrequest(s;0;0.0;false;false);
  let ratio=t.localcomputeratio(s);
  assert.eqf64(ratio;50.0;0.01;"should be 50% local compute")
};

f=testcumulativemultirequests():i64{
  let s=t.newsavings();
  let s=t.addrequest(s;100;0.001;true;false);
  let s=t.addrequest(s;200;0.002;false;true);
  let s=t.addrequest(s;50;0.0005;true;false);
  assert.eqi64(s.totaltokenssaved;350;"should have 350 total tokens saved");
  assert.eqf64(s.totalcostsavedusd;0.0035;0.0001;"cost should be 0.0035");
  assert.eq(s.totalrequests;3;"should have 3 requests")
};


f=testnewbudget():i64{
  let b=t.newbudget(10000);
  assert.eqi64(b.limit;10000;"limit should be 10000");
  assert.eqi64(b.used;0;"used should be 0");
  assert.eqi64(b.remaining;10000;"remaining should be 10000");
  assert.eqf64(b.pctused;0.0;0.01;"pct_used should be 0")
};

f=testusetokens():i64{
  let b=t.newbudget(1000);
  let b=t.usetokens(b;250);
  assert.eqi64(b.used;250;"used should be 250");
  assert.eqi64(b.remaining;750;"remaining should be 750");
  assert.eqf64(b.pctused;25.0;0.01;"pct_used should be 25%")
};

f=testbudgetexceeded():i64{
  let b=t.newbudget(100);
  assert.false(t.budgetexceeded(b);"should not be exceeded at start");
  let b=t.usetokens(b;100);
  assert.true(t.budgetexceeded(b);"should be exceeded at limit");
  let b=t.usetokens(b;1);
  assert.true(t.budgetexceeded(b);"should be exceeded over limit")
};

f=testusetokensincremental():i64{
  let b=t.newbudget(1000);
  let b=t.usetokens(b;300);
  let b=t.usetokens(b;200);
  assert.eqi64(b.used;500;"should accumulate to 500");
  assert.eqf64(b.pctused;50.0;0.01;"should be 50%")
};


f=testformatsavings():i64{
  let s=t.newsavings();
  let s=t.addrequest(s;1000;0.005;true;true);
  let formatted=t.formatsavings(s);
  assert.contains(formatted;"1000";"should contain tokens saved");
  assert.contains(formatted;"$";"should contain dollar sign");
  assert.contains(formatted;"Cache rate";"should contain cache rate label")
};

f=testformatbudget():i64{
  let b=t.newbudget(10000);
  let b=t.usetokens(b;2500);
  let formatted=t.formatbudget(b);
  assert.contains(formatted;"2500";"should contain used tokens");
  assert.contains(formatted;"10000";"should contain limit");
  assert.contains(formatted;"%";"should contain percentage")
};

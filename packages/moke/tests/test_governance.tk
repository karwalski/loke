m=packages.moke.tests.testgovernance;
i=t:std.test;
i=str:std.str;

(* Local types for self-contained testing *)
t=$regulatorypreset{
  id:str;
  name:str;
  jurisdiction:str;
  dataresidency:str;
  retentiondays:i64;
  requiresconsent:bool;
  allowscrossboarder:bool
};

t=$riskclassification{
  level:str;
  score:i64;
  reason:str
};

f=makepreset(id:str;name:str;jurisdiction:str;residency:str;retention:i64;consent:bool;crossborder:bool):$regulatorypreset{
  <$regulatorypreset{
    id:id;
    name:name;
    jurisdiction:jurisdiction;
    dataresidency:residency;
    retentiondays:retention;
    requiresconsent:consent;
    allowscrossboarder:crossborder
  }
};

f=findpresetbyid(id:str):$regulatorypreset{
  if(str.eq(id;"gdpr")){
    <makepreset("gdpr";"GDPR (EU)";"EU";"EU";30;true;false)
  }el{
  if(str.eq(id;"hipaa")){
    <makepreset("hipaa";"HIPAA (US)";"US";"US";365;true;false)
  }el{
  if(str.eq(id;"apra")){
    <makepreset("apra";"APRA CPS 234 (AU)";"AU";"AU";90;false;true)
  }el{
    <makepreset("unknown";"Unknown";"";"";0;false;false)
  }}}
};

f=classifyrisk(sensitivity:str;haspi:bool;crossborder:bool):$riskclassification{
  if(str.eq(sensitivity;"critical")){
    <$riskclassification{level:"high";score:90;reason:"critical sensitivity data"}
  }el{
  if(haspi){
    if(crossborder){
      <$riskclassification{level:"high";score:80;reason:"PI with cross-border transfer"}
    }el{
      <$riskclassification{level:"medium";score:50;reason:"contains personal information"}
    }
  }el{
    <$riskclassification{level:"low";score:10;reason:"no sensitive data detected"}
  }}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: find gdpr preset by id *)
  let gdpr=findpresetbyid("gdpr");
  if(str.eq(gdpr.id;"gdpr")){pass=pass+1}el{fail=fail+1};
  if(str.eq(gdpr.name;"GDPR (EU)")){pass=pass+1}el{fail=fail+1};
  if(str.eq(gdpr.jurisdiction;"EU")){pass=pass+1}el{fail=fail+1};
  if(gdpr.requiresconsent){pass=pass+1}el{fail=fail+1};

  (* test: find hipaa preset by id *)
  let hipaa=findpresetbyid("hipaa");
  if(str.eq(hipaa.id;"hipaa")){pass=pass+1}el{fail=fail+1};
  if(hipaa.retentiondays = 365){pass=pass+1}el{fail=fail+1};

  (* test: unknown preset returns error marker *)
  let unknown=findpresetbyid("nonexistent");
  if(str.eq(unknown.id;"unknown")){pass=pass+1}el{fail=fail+1};

  (* test: risk classification - critical is high *)
  let r1=classifyrisk("critical";false;false);
  if(str.eq(r1.level;"high")){pass=pass+1}el{fail=fail+1};
  if(r1.score = 90){pass=pass+1}el{fail=fail+1};

  (* test: risk classification - PI with crossborder is high *)
  let r2=classifyrisk("normal";true;true);
  if(str.eq(r2.level;"high")){pass=pass+1}el{fail=fail+1};
  if(r2.score = 80){pass=pass+1}el{fail=fail+1};

  (* test: risk classification - PI without crossborder is medium *)
  let r3=classifyrisk("normal";true;false);
  if(str.eq(r3.level;"medium")){pass=pass+1}el{fail=fail+1};

  (* test: risk classification - no sensitive data is low *)
  let r4=classifyrisk("normal";false;false);
  if(str.eq(r4.level;"low")){pass=pass+1}el{fail=fail+1};
  if(r4.score = 10){pass=pass+1}el{fail=fail+1};

  <fail
};

m=packages.moke.tests.testgovernance;

i=t:std.test;
i=str:std.str;
i=gv:moke.governance;

(* X4b.14 / X7.2 - regulatory preset lookup and risk classification, through the real
   moke.governance. The file used to declare its own presets and classifier. The ids and
   sensitivities below are built at run time as well as written as literals, so a lookup that
   compares string handles rather than contents cannot pass by accident. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.assert(gv.getpresets().len>=2;"there are regulatory presets")){pass=pass+1}el{fail=fail+1};
  let gdpr:$regulatorypreset=gv.findpreset("eu-gdpr");
  if(t.asserteq(gdpr.name;"EU GDPR";"a preset is found by its id")){pass=pass+1}el{fail=fail+1};
  let au:$regulatorypreset=gv.findpreset(str.concat("au-";"privacy"));
  if(t.asserteq(au.name;"AU Privacy Act";"including by an id built at run time")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!gdpr.crossborderallowed;"GDPR does not allow cross-border transfer by default")){pass=pass+1}el{fail=fail+1};
  if(t.assert(gv.haspreset("eu-gdpr") && !gv.haspreset("mars-code");"haspreset answers for known and unknown ids")){pass=pass+1}el{fail=fail+1};
  let none:$regulatorypreset=gv.findpreset("mars-code");
  if(t.asserteq(none.classificationdefault;"restricted";"an unknown preset falls back to the strictest classification")){pass=pass+1}el{fail=fail+1};

  let low:$riskassessment=gv.classifyrisk("PUBLIC";0 as i32;false;false);
  if(t.asserteq(low.tier;"Low";"public data with no entities is low risk")){pass=pass+1}el{fail=fail+1};
  if(t.assert(low.score==(0 as i32);"with a score of zero")){pass=pass+1}el{fail=fail+1};
  let high:$riskassessment=gv.classifyrisk(str.concat("RESTR";"ICTED");12 as i32;true;true);
  if(t.asserteq(high.tier;"High";"restricted data, many entities, cross-border and blocked types is high risk")){pass=pass+1}el{fail=fail+1};
  if(t.assert(high.score==(105 as i32);"scored 40 + 30 + 15 + 20")){pass=pass+1}el{fail=fail+1};
  if(t.assert(high.reasons.len==4;"with a reason for each")){pass=pass+1}el{fail=fail+1};
  let med:$riskassessment=gv.classifyrisk("CONFIDENTIAL";2 as i32;false;false);
  if(t.asserteq(med.tier;"Medium";"confidential with a few entities is medium")){pass=pass+1}el{fail=fail+1};

  <fail
}

m=packages.moke.tests.teststreaming;

i=t:std.test;
i=str:std.str;
i=ms:moke.streaming;

(* X4b.14 / X7.2 - session event tracking and JSON output, through the real moke.streaming.
   The file used to declare its own session type and assert it against itself. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let s0=ms.newsession("req-9";"qwen2.5:7b");
  if(t.asserteq(ms.statelabel(s0.state);"idle";"a new stream session is idle")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s0.events.len==0 && s0.tokensreceived==(0 as i32);"with no events and no tokens")){pass=pass+1}el{fail=fail+1};

  let s1=ms.setstate(s0;1);
  if(t.asserteq(ms.statelabel(s1.state);"connecting";"then connecting")){pass=pass+1}el{fail=fail+1};
  let s2=ms.setstage(s1;"privacy_scan");
  if(t.asserteq(s2.activestage;"privacy_scan";"a stage becomes the active stage")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s2.events.len==1;"and is recorded as an event")){pass=pass+1}el{fail=fail+1};
  let s3=ms.addtoken(ms.addtoken(s2;"Hello");" world");
  if(t.asserteq(ms.statelabel(s3.state);"streaming";"a token moves the session to streaming")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s3.tokensreceived==(2 as i32);"tokens are counted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s3.events.len==3;"and each is an event")){pass=pass+1}el{fail=fail+1};
  let e1:$streamevent=s3.events.get(1);
  if(t.asserteq(e1.eventtype;"token";"a token event is typed token")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(e1.data;"Hello";"and carries the token")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ms.statelabel(ms.setstate(s3;3).state);"complete";"the session can complete")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ms.statelabel(9);"error";"and an unknown state reads as error")){pass=pass+1}el{fail=fail+1};

  let quoted=$streamevent{eventtype:"token";data:"say \"hi\"";timestamp:5};
  if(t.asserteq(ms.eventtojson(quoted);"{\"event_type\":\"token\",\"data\":\"say \\\"hi\\\"\",\"timestamp\":5}";"an event serialises with its data escaped")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ms.tosse(quoted);"event: token\ndata: \"say \\\"hi\\\"\"\n\n";"and as an SSE frame ending in a blank line")){pass=pass+1}el{fail=fail+1};

  let j=ms.sessiontojson(s3);
  if(t.assert(str.startswith(j;"{\"state\":\"streaming\",\"request_id\":\"req-9\"");"the session serialises its state and request id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(j;"\"tokens_received\":2") && str.contains(j;"\"active_stage\":\"llm_call\"");"its token count and active stage")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(j;"\"\"req-9") && !str.contains(j;"\"\"qwen");"with no value doubly quoted")){pass=pass+1}el{fail=fail+1};

  <fail
}

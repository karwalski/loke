m=packages.moke.tests.teststreaming;
i=t:std.test;
i=str:std.str;

(* Local types for self-contained testing *)
t=$streamevent{
  eventtype:str;
  data:str;
  timestamp:i64
};

t=$streamstate{
  label:str;
  code:i64
};

t=$streamsession{
  requestid:str;
  modelid:str;
  state:$streamstate;
  tokensreceived:i64;
  events:@$streamevent;
  activestage:str
};

f=statenew(label:str;code:i64):$streamstate{
  <$streamstate{label:label;code:code}
};

f=stateidle():$streamstate{<statenew("idle";0)};
f=stateconnecting():$streamstate{<statenew("connecting";1)};
f=statestreaming():$streamstate{<statenew("streaming";2)};
f=statecomplete():$streamstate{<statenew("complete";3)};
f=stateerror():$streamstate{<statenew("error";4)};

f=newsession(reqid:str;model:str):$streamsession{
  <$streamsession{
    requestid:reqid;
    modelid:model;
    state:stateidle();
    tokensreceived:0;
    events:@();
    activestage:""
  }
};

f=appendevent(s:$streamsession;e:$streamevent):$streamsession{
  <$streamsession{
    requestid:s.requestid;
    modelid:s.modelid;
    state:s.state;
    tokensreceived:s.tokensreceived;
    events:str.arraypush(s.events;e);
    activestage:s.activestage
  }
};

f=setstate(s:$streamsession;st:$streamstate):$streamsession{
  <$streamsession{
    requestid:s.requestid;
    modelid:s.modelid;
    state:st;
    tokensreceived:s.tokensreceived;
    events:s.events;
    activestage:s.activestage
  }
};

f=addtoken(s:$streamsession;token:str):$streamsession{
  let e=$streamevent{eventtype:"token";data:token;timestamp:0};
  <$streamsession{
    requestid:s.requestid;
    modelid:s.modelid;
    state:statestreaming();
    tokensreceived:s.tokensreceived + 1;
    events:str.arraypush(s.events;e);
    activestage:s.activestage
  }
};

f=sessiontojson(s:$streamsession):str{
  let json=str.concat("{\"request_id\":\"";str.concat(s.requestid;str.concat("\",\"model_id\":\"";str.concat(s.modelid;str.concat("\",\"state\":\"";str.concat(s.state.label;str.concat("\",\"tokens_received\":";str.concat(str.fromi64(s.tokensreceived);str.concat(",\"events_count\":";str.concat(str.fromi64(str.arraylen(s.events));"}"))))))))));
  <json
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: new session has zero events *)
  let s=newsession("req-001";"llama3.2:3b");
  if(str.arraylen(s.events) = 0){pass=pass+1}el{fail=fail+1};

  (* test: new session starts idle *)
  if(str.eq(s.state.label;"idle")){pass=pass+1}el{fail=fail+1};

  (* test: new session has correct request id *)
  if(str.eq(s.requestid;"req-001")){pass=pass+1}el{fail=fail+1};

  (* test: new session has correct model *)
  if(str.eq(s.modelid;"llama3.2:3b")){pass=pass+1}el{fail=fail+1};

  (* test: append event increases count *)
  let e1=$streamevent{eventtype:"stage";data:"anonymise";timestamp:100};
  let s2=appendevent(s;e1);
  if(str.arraylen(s2.events) = 1){pass=pass+1}el{fail=fail+1};

  (* test: append multiple events *)
  let e2=$streamevent{eventtype:"stage";data:"llm_call";timestamp:200};
  let s3=appendevent(s2;e2);
  if(str.arraylen(s3.events) = 2){pass=pass+1}el{fail=fail+1};

  (* test: add token increments count *)
  let s4=addtoken(s;"Hello");
  if(s4.tokensreceived = 1){pass=pass+1}el{fail=fail+1};

  (* test: add token transitions to streaming *)
  if(str.eq(s4.state.label;"streaming")){pass=pass+1}el{fail=fail+1};

  (* test: set state changes state label *)
  let s5=setstate(s;statecomplete());
  if(str.eq(s5.state.label;"complete")){pass=pass+1}el{fail=fail+1};

  (* test: session JSON serialisation contains request_id *)
  let json=sessiontojson(s4);
  if(str.contains(json;"\"request_id\":\"req-001\"")){pass=pass+1}el{fail=fail+1};

  (* test: session JSON contains tokens_received *)
  if(str.contains(json;"\"tokens_received\":1")){pass=pass+1}el{fail=fail+1};

  (* test: session JSON contains state *)
  if(str.contains(json;"\"state\":\"streaming\"")){pass=pass+1}el{fail=fail+1};

  <fail
};


m=moke.tests.approvaltest;
i=test:std.test;
i=approval:moke.approval;
i=sens:moke.sensitivity;
i=clog:moke.consolelog;


f=requiresreviewreturnstrueforconfidential():void{
  test.asserttrue(approval.requiresreview("CONFIDENTIAL"))
};

f=requiresreviewreturnstrueforrestricted():void{
  test.asserttrue(approval.requiresreview("RESTRICTED"))
};

f=requiresreviewreturnsfalseforpublic():void{
  test.assertfalse(approval.requiresreview("PUBLIC"))
};

f=requiresreviewreturnsfalseforinternal():void{
  test.assertfalse(approval.requiresreview("INTERNAL"))
};

f=requiresreviewiscaseinsensitive():void{
  test.asserttrue(approval.requiresreview("confidential"));
  test.asserttrue(approval.requiresreview("Restricted"));
  test.assertfalse(approval.requiresreview("public"));
  test.assertfalse(approval.requiresreview("internal"))
};

f=requiresreviewreturnsfalseforemptystring():void{
  test.assertfalse(approval.requiresreview(""))
};


f=builddiffproducesunchangedtokensforidenticaltext():void{
  let tokens = approval.builddiff("hello world"; "hello world"; @());
  test.asserteq(tokens.len; 2);
  let t0 = tokens.get(0);
  test.asserteq(t0.text; "hello");
  test.asserteq(t0.kind; "unchanged");
  let t1 = tokens.get(1);
  test.asserteq(t1.text; "world");
  test.asserteq(t1.kind; "unchanged")
};

f=builddiffmarkspiientitywordsasremovedpii():void{
  let original = "Name is Margaret Kowalski";
  let transformed = "Name is PERSON_1";
  let entities = @("Margaret"; "Kowalski");
  let tokens = approval.builddiff(original; transformed; entities);
  let hasremoved = false;
  let hasanon = false;
  tokens.each|t{
    if(t.kind = "removed_pii" ){ hasremoved = true }el{};
    if(t.kind = "anonymised"  ){ hasanon = true }el{};
  };
  test.asserttrue(hasremoved);
  test.asserttrue(hasanon)
};

f=builddiffmarksextraoriginalwordsascompressedwhennopii():void{
  let original = "The quick brown fox jumps over the lazy dog";
  let transformed = "The quick brown fox";
  let tokens = approval.builddiff(original; transformed; @());
  let hascompressed = false;
  tokens.each|t{
    if(t.kind = "compressed" ){ hascompressed = true }el{};
  };
  test.asserttrue(hascompressed)
};


f=logdecisionappendsapprovalentrytosessionlog():void{
  let log = clog.newsession("test-req-001");
  let updated = approval.logdecision(log; "test-req-001"; "approved"; "CONFIDENTIAL");
  test.asserteq(updated.entries.len; 1);
  let entry = updated.entries.get(0);
  test.asserteq(entry.stage; "approval");
  test.asserteq(entry.status; "approved")
};

f=logdecisionappendscancelledentrytosessionlog():void{
  let log = clog.newsession("test-req-002");
  let updated = approval.logdecision(log; "test-req-002"; "cancelled"; "RESTRICTED");
  test.asserteq(updated.entries.len; 1);
  let entry = updated.entries.get(0);
  test.asserteq(entry.stage; "approval");
  test.asserteq(entry.status; "cancelled")
};

f=logdecisionincludesrequestidandsensitivityindetail():void{
  let log = clog.newsession("test-req-003");
  let updated = approval.logdecision(log; "test-req-003"; "approved"; "CONFIDENTIAL");
  let entry = updated.entries.get(0);
  test.asserttrue(str.contains(entry.detail; "test-req-003"));
  test.asserttrue(str.contains(entry.detail; "CONFIDENTIAL"))
};

f=multipledecisionsappendtosamelog():void{
  let log = clog.newsession("test-req-004");
  let log2 = approval.logdecision(log; "test-req-004"; "cancelled"; "RESTRICTED");
  let log3 = approval.logdecision(log2; "test-req-004"; "approved"; "RESTRICTED");
  test.asserteq(log3.entries.len; 2);
  test.asserteq(log3.entries.get(0).status; "cancelled");
  test.asserteq(log3.entries.get(1).status; "approved")
};


f=sensitivityfromstringnormaliseslevelscorrectly():void{
  test.asserteq(sens.fromstring("public"); "PUBLIC");
  test.asserteq(sens.fromstring("CONFIDENTIAL"); "CONFIDENTIAL");
  test.asserteq(sens.fromstring("restricted"); "RESTRICTED");
  test.asserteq(sens.fromstring("internal"); "INTERNAL");
  test.asserteq(sens.fromstring("unknown"); "INTERNAL")
};

f=sensitivityallowscloudmatchesgatelogic():void{
  test.asserttrue(sens.allowscloud("PUBLIC"));
  test.asserttrue(sens.allowscloud("INTERNAL"));
  test.assertfalse(sens.allowscloud("CONFIDENTIAL"));
  test.assertfalse(sens.allowscloud("RESTRICTED"))
};

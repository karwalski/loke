m=packages.moke.tests.testtimestampids;

i=t:std.test;
i=str:std.str;
i=fb:moke.feedback;
i=mem:moke.memory;

(* F10.34 — against the REAL modules.

   `moke.feedback` and `moke.memory` stamped ids and `createdat` with `std.nowms()` through a
   bare `i=std:std;` import. toke mangles that call to `_tk_std_nowms_w`, a symbol no module
   defines — the real one is `time.nowms` from `std.time`. Nothing complains at compile time
   (T-7): the failure is at LINK, so before the fix this test does not build, and neither did
   the moke binary. The assertions below are what the call was for: a real millisecond
   timestamp, not zero and not text. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let e:$feedbackentry=fb.newentry("up";"chat";"req1";"m1";"ds1";"");
  let fid:str=e.id;
  let fat:str=e.createdat;
  if(t.assert(str.startswith(fid;"fb_");"a feedback id keeps its prefix")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(fat)>=13;"a feedback createdat is a millisecond epoch (13 digits), not zero")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.startswith(fat;"1");"and it is a real current timestamp")){pass=pass+1}el{fail=fail+1};

  let d:$drawer=mem.newdrawer("w";"h";"r";"content";"test");
  let did:str=d.id;
  let dat:str=d.createdat;
  if(t.assert(str.startswith(did;"drw_");"a drawer id keeps its prefix")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(did)>=17;"and carries the timestamp, not an empty suffix")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(dat)>=13;"a drawer createdat is a millisecond epoch, not zero")){pass=pass+1}el{fail=fail+1};

  <fail
};

{! layout("base") !}
{! block("title") !}moke — connections{! end !}
{! block("content") !}
<style>
  /* ── teal accent override ── */
  :root {
    --accent: #0d9488;
    --accent-muted: rgba(13,148,136,.15);
    --accent-border: rgba(13,148,136,.35);
  }

  /* ── page layout ── */
  .conn-page { display: flex; gap: 20px; min-height: calc(100vh - 120px); }

  /* ── left panel: saved connections ── */
  .conn-sidebar {
    width: 240px; flex-shrink: 0;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 0; overflow: hidden;
    display: flex; flex-direction: column;
  }
  .conn-sidebar-head {
    padding: 14px 16px; border-bottom: 1px solid var(--border);
    font-size: 0.78em; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--muted);
    display: flex; align-items: center; justify-content: space-between;
  }
  .conn-sidebar-head .conn-count {
    background: rgba(139,148,158,.15); color: var(--muted);
    font-size: 0.85em; padding: 1px 8px; border-radius: 10px;
  }
  .conn-list {
    flex: 1; overflow-y: auto; padding: 8px 0;
  }
  .conn-list-empty {
    padding: 20px 16px; text-align: center;
    font-size: 0.82em; color: var(--muted); font-style: italic;
  }
  .conn-list-item {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 16px; cursor: pointer;
    font-size: 0.85em; color: var(--muted);
    border-left: 3px solid transparent;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .conn-list-item:hover { background: rgba(255,255,255,.04); color: var(--text); }
  .conn-list-item.active {
    color: var(--accent); background: var(--accent-muted);
    border-left-color: var(--accent);
  }
  .conn-list-item .conn-method {
    font-size: 0.72em; font-weight: 700; padding: 1px 6px;
    border-radius: 3px; text-transform: uppercase; flex-shrink: 0;
  }
  .conn-method-get    { background: rgba(63,185,80,.15);  color: var(--green); }
  .conn-method-post   { background: rgba(59,130,246,.15); color: #93c5fd; }
  .conn-method-put    { background: rgba(210,153,34,.15); color: var(--amber); }
  .conn-method-delete { background: rgba(248,81,73,.15);  color: var(--red); }
  .conn-list-item .conn-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .conn-list-item .conn-delete {
    background: none; border: none; color: var(--muted); cursor: pointer;
    font-size: 0.9em; padding: 0 2px; opacity: 0; transition: opacity 0.15s, color 0.15s;
  }
  .conn-list-item:hover .conn-delete { opacity: 1; }
  .conn-list-item .conn-delete:hover { color: var(--red); }
  .btn-new-conn {
    margin: 8px 12px 12px; padding: 7px 12px; border-radius: 7px;
    background: var(--accent-muted); border: 1px solid var(--accent-border);
    color: var(--accent); font-size: 0.82em; font-weight: 600;
    cursor: pointer; text-align: center;
    transition: background 0.15s;
  }
  .btn-new-conn:hover { background: rgba(13,148,136,.28); }

  /* ── main panel ── */
  .conn-main {
    flex: 1; min-width: 0;
  }
  .conn-heading { font-size: 1.25em; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 6px; }
  .conn-sub { font-size: 0.88em; color: var(--muted); margin-bottom: 24px; }

  /* ── form sections ── */
  .conn-section {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden; margin-bottom: 20px;
  }
  .conn-section-head {
    padding: 14px 20px; border-bottom: 1px solid var(--border);
    font-size: 0.78em; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--muted);
  }
  .conn-section-body { padding: 18px 20px; display: flex; flex-direction: column; gap: 16px; }

  /* ── form fields ── */
  .conn-field { display: flex; flex-direction: column; gap: 5px; }
  .conn-field-row { display: flex; gap: 12px; align-items: flex-end; }
  .conn-field-row .conn-field { flex: 1; }
  .conn-label {
    font-size: 0.82em; font-weight: 600; color: var(--text);
  }
  .conn-input {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); font-size: 0.88em; border-radius: 6px;
    padding: 8px 12px; outline: none; width: 100%;
    transition: border-color 0.15s;
  }
  .conn-input:focus { border-color: var(--accent); }
  .conn-input::placeholder { color: var(--muted); }
  .conn-select {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); font-size: 0.88em; border-radius: 6px;
    padding: 8px 10px; outline: none; width: 100%;
    transition: border-color 0.15s; cursor: pointer;
  }
  .conn-select:focus { border-color: var(--accent); }
  .conn-textarea {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); font-size: 0.85em; border-radius: 6px;
    padding: 10px 12px; outline: none; width: 100%;
    font-family: 'SF Mono', 'Fira Code', monospace;
    min-height: 120px; resize: vertical; line-height: 1.6;
    transition: border-color 0.15s;
  }
  .conn-textarea:focus { border-color: var(--accent); }
  .conn-textarea::placeholder { color: var(--muted); font-family: system-ui, sans-serif; }

  /* ── key-value table ── */
  .kv-table { width: 100%; border-collapse: collapse; }
  .kv-table th {
    text-align: left; font-size: 0.75em; font-weight: 600;
    color: var(--muted); padding: 4px 8px 6px; text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .kv-table td { padding: 3px 4px; }
  .kv-table input {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); font-size: 0.84em; border-radius: 5px;
    padding: 6px 8px; outline: none; width: 100%;
    transition: border-color 0.15s;
  }
  .kv-table input:focus { border-color: var(--accent); }
  .kv-table input::placeholder { color: var(--muted); }
  .kv-row-actions { display: flex; gap: 4px; }
  .kv-btn {
    background: none; border: none; cursor: pointer;
    color: var(--muted); font-size: 1em; padding: 2px 4px;
    transition: color 0.15s;
  }
  .kv-btn:hover { color: var(--red); }
  .kv-add-btn {
    background: none; border: 1px dashed var(--border);
    color: var(--muted); font-size: 0.8em; padding: 5px 12px;
    border-radius: 5px; cursor: pointer; margin-top: 8px;
    transition: border-color 0.15s, color 0.15s;
  }
  .kv-add-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* ── action buttons ── */
  .conn-actions {
    display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .conn-btn {
    padding: 9px 20px; border-radius: 8px; border: none; cursor: pointer;
    font-size: 0.88em; font-weight: 600; transition: opacity 0.15s;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .conn-btn:hover { opacity: 0.88; }
  .conn-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .conn-btn-primary { background: var(--accent); color: #fff; }
  .conn-btn-secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .conn-btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .conn-btn-tertiary { background: var(--accent-muted); color: var(--accent); border: 1px solid var(--accent-border); }

  /* ── response preview ── */
  .conn-response {
    display: none; margin-bottom: 20px;
  }
  .conn-response.visible { display: block; }
  .conn-response-head {
    display: flex; align-items: center; gap: 12px; margin-bottom: 10px;
  }
  .conn-status-badge {
    font-size: 0.82em; font-weight: 700; padding: 3px 10px;
    border-radius: 5px;
  }
  .status-ok { background: rgba(63,185,80,.15); color: var(--green); }
  .status-redirect { background: rgba(210,153,34,.15); color: var(--amber); }
  .status-client-err { background: rgba(248,81,73,.15); color: var(--red); }
  .status-server-err { background: rgba(248,81,73,.25); color: var(--red); }
  .status-unknown { background: rgba(139,148,158,.15); color: var(--muted); }
  .conn-response-time { font-size: 0.8em; color: var(--muted); }
  .conn-response-section {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; margin-bottom: 10px; overflow: hidden;
  }
  .conn-response-section-head {
    padding: 8px 14px; font-size: 0.75em; font-weight: 700;
    color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;
    border-bottom: 1px solid var(--border); cursor: pointer;
    display: flex; align-items: center; gap: 6px;
  }
  .conn-response-section-head:hover { color: var(--text); }
  .conn-response-section-body {
    padding: 10px 14px; font-size: 0.82em; font-family: 'SF Mono', 'Fira Code', monospace;
    color: var(--text); line-height: 1.6; white-space: pre-wrap; word-break: break-all;
    max-height: 300px; overflow-y: auto;
  }

  /* ── error message ── */
  .conn-error {
    display: none; font-size: 0.84em; color: var(--red); margin-top: 8px;
  }
  .conn-error.visible { display: block; }

  /* ── mobile responsive ── */
  @media (max-width: 768px) {
    .conn-page { flex-direction: column; }
    .conn-sidebar { width: 100%; max-height: 200px; }
    .conn-field-row { flex-direction: column; gap: 12px; }
  }
</style>

<div class="conn-page">

  <!-- ── Left panel: saved connections ── -->
  <aside class="conn-sidebar">
    <div class="conn-sidebar-head">
      Saved connections
      <span class="conn-count" id="conn-count">0</span>
    </div>
    <div class="conn-list" id="conn-list">
      <div class="conn-list-empty" id="conn-list-empty">No saved connections</div>
    </div>
    <button class="btn-new-conn" id="btn-new-conn">+ New connection</button>
    <!-- MK9.8: Connection manager panel -->
  </aside>

  <!-- ── Main panel: connection form ── -->
  <div class="conn-main">
    <div class="conn-heading">Connect to API</div>
    <div class="conn-sub">Configure an API endpoint, test the connection, and save it as a named data source.</div>

    <!-- ── Connection details ── -->
    <div class="conn-section">
      <div class="conn-section-head">Connection details</div>
      <div class="conn-section-body">
        <div class="conn-field">
          <label class="conn-label" for="conn-name">Connection name</label>
          <input class="conn-input" id="conn-name" type="text" placeholder="e.g. GitHub API, Weather Service" autocomplete="off">
        </div>
        <div class="conn-field-row">
          <div class="conn-field" style="flex:0 0 140px;">
            <label class="conn-label" for="conn-method">Method</label>
            <select class="conn-select" id="conn-method">
              <option value="GET" selected>GET</option>
              <option value="POST">POST</option>
              <option value="PUT">PUT</option>
              <option value="DELETE">DELETE</option>
            </select>
          </div>
          <div class="conn-field">
            <label class="conn-label" for="conn-url">URL</label>
            <input class="conn-input" id="conn-url" type="url" placeholder="https://api.example.com/v1/resource" autocomplete="off">
          </div>
        </div>
        <div class="conn-field" style="max-width:280px;">
          <label class="conn-label" for="conn-auth">Authentication</label>
          <select class="conn-select" id="conn-auth">
            <option value="none" selected>None</option>
            <option value="api-key">API Key</option>
            <option value="bearer">Bearer Token</option>
            <option value="basic">Basic Auth</option>
            <option value="oauth2">OAuth 2.0</option>
          </select>
        </div>
        <!-- MK9.5: Auth configuration details -->
      </div>
    </div>

    <!-- ── Headers ── -->
    <div class="conn-section">
      <div class="conn-section-head">Headers</div>
      <div class="conn-section-body">
        <table class="kv-table" id="headers-table">
          <thead>
            <tr><th style="width:38%;">Key</th><th style="width:50%;">Value</th><th style="width:12%;"></th></tr>
          </thead>
          <tbody id="headers-tbody">
            <tr>
              <td><input type="text" placeholder="Content-Type" data-kv="headers-key"></td>
              <td><input type="text" placeholder="application/json" data-kv="headers-val"></td>
              <td><div class="kv-row-actions"><button class="kv-btn" onclick="removeKvRow(this)" title="Remove">&#10005;</button></div></td>
            </tr>
          </tbody>
        </table>
        <button class="kv-add-btn" onclick="addKvRow('headers-tbody')">+ Add header</button>
      </div>
    </div>

    <!-- ── Query parameters ── -->
    <div class="conn-section">
      <div class="conn-section-head">Query parameters</div>
      <div class="conn-section-body">
        <table class="kv-table" id="params-table">
          <thead>
            <tr><th style="width:38%;">Key</th><th style="width:50%;">Value</th><th style="width:12%;"></th></tr>
          </thead>
          <tbody id="params-tbody"></tbody>
        </table>
        <button class="kv-add-btn" onclick="addKvRow('params-tbody')">+ Add parameter</button>
      </div>
    </div>

    <!-- ── Request body (POST/PUT only) ── -->
    <div class="conn-section" id="body-section" style="display:none;">
      <div class="conn-section-head">Request body</div>
      <div class="conn-section-body">
        <div class="conn-field">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
            <label class="conn-label" for="conn-body">JSON body</label>
            <button class="kv-add-btn" style="margin:0;padding:3px 10px;font-size:0.75em;" onclick="formatJsonBody()">Format JSON</button>
          </div>
          <textarea class="conn-textarea" id="conn-body" placeholder='{"key": "value"}'></textarea>
        </div>
      </div>
    </div>

    <!-- MK9.3: GraphQL editor section -->

    <!-- MK9.4: OpenAPI discovery section -->

    <!-- ── Action buttons ── -->
    <div class="conn-actions">
      <button class="conn-btn conn-btn-primary" id="btn-test">Test Connection</button>
      <button class="conn-btn conn-btn-secondary" id="btn-save">Save Connection</button>
      <button class="conn-btn conn-btn-tertiary" id="btn-load-dataset" disabled>Load as Dataset</button>
      <!-- MK9.2: REST/JSON parser section -->
    </div>

    <div class="conn-error" id="conn-error" role="alert" aria-live="assertive"></div>

    <!-- ── Response preview ── -->
    <div class="conn-response" id="conn-response">
      <div class="conn-section-head" style="border:none;padding:0 0 8px;">Response</div>
      <div class="conn-response-head">
        <span class="conn-status-badge" id="resp-status">—</span>
        <span class="conn-response-time" id="resp-time"></span>
      </div>
      <div class="conn-response-section">
        <div class="conn-response-section-head" onclick="toggleResponseSection('resp-headers-body')" role="button" aria-expanded="false" aria-controls="resp-headers-body" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleResponseSection('resp-headers-body');}">
          &#9654; Response headers
        </div>
        <div class="conn-response-section-body" id="resp-headers-body" style="display:none;"></div>
      </div>
      <div class="conn-response-section">
        <div class="conn-response-section-head" onclick="toggleResponseSection('resp-body-body')" role="button" aria-expanded="true" aria-controls="resp-body-body" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleResponseSection('resp-body-body');}">
          &#9660; Response body <span style="font-weight:400;color:var(--muted);">(first 500 chars)</span>
        </div>
        <div class="conn-response-section-body" id="resp-body-body"></div>
      </div>
    </div>

    <!-- MK9.6: data.gov.au browser section -->
    <!-- MK9.9: Cache status display -->
    <!-- MK9.10: Rate limit status display -->

  </div>
</div>

<script>
(function () {
  'use strict';

  var STORAGE_KEY = 'moke_api_connections';

  // ── state ──
  var state = {
    connections: [],
    activeId: null,
    lastResponse: null,
  };

  // ── DOM refs ──
  var nameInput   = document.getElementById('conn-name');
  var methodSel   = document.getElementById('conn-method');
  var urlInput    = document.getElementById('conn-url');
  var authSel     = document.getElementById('conn-auth');
  var bodySection = document.getElementById('body-section');
  var bodyInput   = document.getElementById('conn-body');
  var errorEl     = document.getElementById('conn-error');
  var responseEl  = document.getElementById('conn-response');
  var btnTest     = document.getElementById('btn-test');
  var btnSave     = document.getElementById('btn-save');
  var btnLoad     = document.getElementById('btn-load-dataset');
  var connListEl  = document.getElementById('conn-list');
  var connCountEl = document.getElementById('conn-count');

  // ── utility ──
  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.toggle('visible', !!msg);
  }

  function genId() {
    return 'conn_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
  }

  // ── show/hide body section based on method ──
  methodSel.addEventListener('change', function () {
    var m = methodSel.value;
    bodySection.style.display = (m === 'POST' || m === 'PUT') ? '' : 'none';
  });

  // ── key-value row helpers (global) ──
  window.addKvRow = function (tbodyId) {
    var tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    var prefix = tbodyId.replace('-tbody', '');
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input type="text" placeholder="Key" data-kv="' + prefix + '-key"></td>' +
      '<td><input type="text" placeholder="Value" data-kv="' + prefix + '-val"></td>' +
      '<td><div class="kv-row-actions"><button class="kv-btn" onclick="removeKvRow(this)" title="Remove">&#10005;</button></div></td>';
    tbody.appendChild(tr);
  };

  window.removeKvRow = function (btn) {
    var tr = btn.closest('tr');
    if (tr) tr.remove();
  };

  // ── read key-value pairs from a table ──
  function readKvPairs(tbodyId) {
    var tbody = document.getElementById(tbodyId);
    if (!tbody) return [];
    var pairs = [];
    tbody.querySelectorAll('tr').forEach(function (tr) {
      var inputs = tr.querySelectorAll('input');
      if (inputs.length >= 2) {
        var k = inputs[0].value.trim();
        var v = inputs[1].value.trim();
        if (k) pairs.push({ key: k, value: v });
      }
    });
    return pairs;
  }

  // ── write key-value pairs to a table ──
  function writeKvPairs(tbodyId, pairs) {
    var tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    tbody.innerHTML = '';
    var prefix = tbodyId.replace('-tbody', '');
    if (!pairs || pairs.length === 0) return;
    pairs.forEach(function (p) {
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td><input type="text" placeholder="Key" data-kv="' + prefix + '-key" value="' + escHtml(p.key) + '"></td>' +
        '<td><input type="text" placeholder="Value" data-kv="' + prefix + '-val" value="' + escHtml(p.value) + '"></td>' +
        '<td><div class="kv-row-actions"><button class="kv-btn" onclick="removeKvRow(this)" title="Remove">&#10005;</button></div></td>';
      tbody.appendChild(tr);
    });
  }

  // ── format JSON body ──
  window.formatJsonBody = function () {
    var val = bodyInput.value.trim();
    if (!val) return;
    try {
      bodyInput.value = JSON.stringify(JSON.parse(val), null, 2);
      showError('');
    } catch (e) {
      showError('Invalid JSON: ' + e.message);
    }
  };

  // ── toggle response section ──
  window.toggleResponseSection = function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    var visible = el.style.display !== 'none';
    el.style.display = visible ? 'none' : '';
    // toggle the arrow and aria-expanded
    var head = el.previousElementSibling;
    if (head) {
      head.innerHTML = head.innerHTML.replace(/&#9654;|&#9660;|▶|▼/, visible ? '&#9654;' : '&#9660;');
      head.setAttribute('aria-expanded', !visible);
    }
  };

  // ── gather current form data ──
  function gatherFormData() {
    return {
      name:    nameInput.value.trim(),
      method:  methodSel.value,
      url:     urlInput.value.trim(),
      auth:    authSel.value,
      headers: readKvPairs('headers-tbody'),
      params:  readKvPairs('params-tbody'),
      body:    bodyInput.value.trim(),
    };
  }

  // ── populate form from a connection object ──
  function populateForm(conn) {
    nameInput.value  = conn.name || '';
    methodSel.value  = conn.method || 'GET';
    urlInput.value   = conn.url || '';
    authSel.value    = conn.auth || 'none';
    bodyInput.value  = conn.body || '';
    bodySection.style.display = (conn.method === 'POST' || conn.method === 'PUT') ? '' : 'none';
    writeKvPairs('headers-tbody', conn.headers || []);
    writeKvPairs('params-tbody', conn.params || []);
    responseEl.classList.remove('visible');
    state.lastResponse = null;
    btnLoad.disabled = true;
    showError('');
  }

  // ── clear form ──
  function clearForm() {
    state.activeId = null;
    populateForm({ name: '', method: 'GET', url: '', auth: 'none', headers: [], params: [], body: '' });
    renderConnList();
  }

  // ── localStorage persistence ──
  function loadConnections() {
    try {
      state.connections = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch (e) {
      state.connections = [];
    }
  }

  function saveConnections() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state.connections));
  }

  // ── render saved connections list ──
  function renderConnList() {
    loadConnections();
    connCountEl.textContent = state.connections.length;
    var emptyEl = document.getElementById('conn-list-empty');

    if (state.connections.length === 0) {
      if (emptyEl) emptyEl.style.display = '';
      // remove all items
      connListEl.querySelectorAll('.conn-list-item').forEach(function (el) { el.remove(); });
      return;
    }
    if (emptyEl) emptyEl.style.display = 'none';

    // rebuild list
    connListEl.querySelectorAll('.conn-list-item').forEach(function (el) { el.remove(); });
    state.connections.forEach(function (conn) {
      var div = document.createElement('div');
      div.className = 'conn-list-item' + (conn.id === state.activeId ? ' active' : '');
      var methodCls = 'conn-method-' + (conn.method || 'get').toLowerCase();
      div.innerHTML =
        '<span class="conn-method ' + methodCls + '">' + escHtml(conn.method || 'GET') + '</span>' +
        '<span class="conn-name">' + escHtml(conn.name || 'Untitled') + '</span>' +
        '<button class="conn-delete" data-id="' + escHtml(conn.id) + '" title="Delete">&#10005;</button>';
      div.addEventListener('click', function (e) {
        if (e.target.classList.contains('conn-delete')) return;
        state.activeId = conn.id;
        populateForm(conn);
        renderConnList();
      });
      div.querySelector('.conn-delete').addEventListener('click', function (e) {
        e.stopPropagation();
        if (!confirm('Delete "' + (conn.name || 'Untitled') + '"?')) return;
        state.connections = state.connections.filter(function (c) { return c.id !== conn.id; });
        saveConnections();
        if (state.activeId === conn.id) clearForm();
        else renderConnList();
      });
      connListEl.appendChild(div);
    });
  }

  // ── new connection button ──
  document.getElementById('btn-new-conn').addEventListener('click', clearForm);

  // ── save connection ──
  btnSave.addEventListener('click', function () {
    var data = gatherFormData();
    if (!data.name) { showError('Please enter a connection name.'); return; }
    if (!data.url) { showError('Please enter a URL.'); return; }
    showError('');

    if (state.activeId) {
      // update existing
      state.connections = state.connections.map(function (c) {
        if (c.id === state.activeId) {
          return Object.assign({}, c, data, { updatedAt: Date.now() });
        }
        return c;
      });
    } else {
      // new
      var conn = Object.assign({ id: genId(), createdAt: Date.now() }, data);
      state.connections.push(conn);
      state.activeId = conn.id;
    }
    saveConnections();
    renderConnList();
  });

  // ── test connection ──
  btnTest.addEventListener('click', function () {
    var data = gatherFormData();
    if (!data.url) { showError('Please enter a URL.'); return; }
    showError('');
    responseEl.classList.remove('visible');
    btnTest.disabled = true;
    btnTest.textContent = 'Testing...';

    var startTime = performance.now();

    // Build the proxy request
    var proxyPayload = {
      url:     data.url,
      method:  data.method,
      headers: {},
      params:  {},
      body:    null,
    };

    data.headers.forEach(function (h) { proxyPayload.headers[h.key] = h.value; });
    data.params.forEach(function (p) { proxyPayload.params[p.key] = p.value; });
    if ((data.method === 'POST' || data.method === 'PUT') && data.body) {
      try {
        proxyPayload.body = JSON.parse(data.body);
      } catch (e) {
        proxyPayload.body = data.body;
      }
    }

    var lokeUrl = (window.LOKE_URL || '') + '/api/proxy';

    fetch(lokeUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(proxyPayload),
    })
    .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
    .then(function (result) {
      var elapsed = Math.round(performance.now() - startTime);
      state.lastResponse = result.data;
      renderResponse(result.data, elapsed);
      btnLoad.disabled = false;
    })
    .catch(function (err) {
      var elapsed = Math.round(performance.now() - startTime);
      renderResponse({
        status: 0,
        statusText: 'Network Error',
        headers: {},
        body: 'Failed to reach loke proxy: ' + err.message
      }, elapsed);
      btnLoad.disabled = true;
    })
    .finally(function () {
      btnTest.disabled = false;
      btnTest.textContent = 'Test Connection';
    });
  });

  // ── render response preview ──
  function renderResponse(resp, elapsedMs) {
    responseEl.classList.add('visible');

    var status = resp.status || 0;
    var statusText = resp.statusText || '';
    var statusEl = document.getElementById('resp-status');
    statusEl.textContent = status + ' ' + statusText;

    // colour the badge
    var cls = 'status-unknown';
    if (status >= 200 && status < 300) cls = 'status-ok';
    else if (status >= 300 && status < 400) cls = 'status-redirect';
    else if (status >= 400 && status < 500) cls = 'status-client-err';
    else if (status >= 500) cls = 'status-server-err';
    statusEl.className = 'conn-status-badge ' + cls;

    document.getElementById('resp-time').textContent = elapsedMs + ' ms';

    // headers
    var headersBody = document.getElementById('resp-headers-body');
    var headers = resp.headers || {};
    var headerLines = Object.keys(headers).map(function (k) {
      return escHtml(k) + ': ' + escHtml(headers[k]);
    }).join('\n');
    headersBody.textContent = headerLines || '(no headers)';

    // body (first 500 chars)
    var bodyBody = document.getElementById('resp-body-body');
    var bodyStr = typeof resp.body === 'string' ? resp.body : JSON.stringify(resp.body, null, 2);
    if (bodyStr && bodyStr.length > 500) bodyStr = bodyStr.slice(0, 500) + '\n... (truncated)';
    bodyBody.textContent = bodyStr || '(empty body)';
  }

  // ── load as dataset ──
  btnLoad.addEventListener('click', function () {
    if (!state.lastResponse) return;
    // MK9.2 will handle the actual JSON-to-tabular parsing.
    // For now, store the raw response and navigate to upload for further processing.
    var data = gatherFormData();
    sessionStorage.setItem('moke_api_response', JSON.stringify({
      connectionName: data.name || 'API Dataset',
      url: data.url,
      method: data.method,
      response: state.lastResponse,
      loadedAt: Date.now(),
    }));
    showError('Dataset loading will be available when MK9.2 (REST/JSON parser) is implemented.');
  });

  // ── init ──
  renderConnList();

})();
</script>
{! end !}

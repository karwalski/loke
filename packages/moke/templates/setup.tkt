{! layout("base") !}
{! block("title") !}moke — setup{! end !}
{! block("content") !}
<style>
  /* ── teal accent override ── */
  :root {
    --accent: #0d9488;
    --accent-muted: rgba(13,148,136,.15);
    --accent-border: rgba(13,148,136,.35);
  }

  /* ── wizard layout ── */
  .setup-wrap { max-width: 580px; margin: 0 auto; }
  .setup-heading { font-size: 1.4em; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 4px; color: var(--teal); }
  .setup-sub { font-size: 0.88em; color: var(--muted); margin-bottom: 28px; }

  /* ── step container ── */
  .setup-step { display: none; }
  .setup-step.active { display: block; }

  /* ── progress bar ── */
  .setup-progress { display: flex; align-items: center; gap: 0; margin-bottom: 32px; }
  .setup-progress-segment {
    flex: 1; height: 4px; background: var(--border); border-radius: 2px;
    margin: 0 2px; transition: background 0.3s;
  }
  .setup-progress-segment.done { background: var(--teal); }
  .setup-progress-segment.current { background: var(--accent); }
  .setup-progress-labels {
    display: flex; justify-content: space-between; margin-bottom: 6px;
    font-size: 0.72em; color: var(--muted); letter-spacing: 0.02em;
  }
  .setup-progress-labels span.current-label { color: var(--teal); font-weight: 600; }
  .setup-progress-labels span.done-label { color: var(--accent); }

  /* ── section styling (reuse settings patterns) ── */
  .setup-section {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden; margin-bottom: 20px;
  }
  .setup-section-head {
    padding: 14px 20px; border-bottom: 1px solid var(--border);
    font-size: 0.78em; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--muted);
  }
  .setup-section-body { padding: 18px 20px; }

  /* ── status indicators ── */
  .status-check {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0; border-bottom: 1px solid var(--border);
  }
  .status-check:last-child { border-bottom: none; }
  .status-dot {
    width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
    background: var(--muted); transition: background 0.3s, box-shadow 0.3s;
  }
  .status-dot.ok { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .status-dot.fail { background: var(--red); box-shadow: 0 0 6px var(--red); }
  .status-dot.checking { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
  .status-info { flex: 1; }
  .status-label { font-size: 0.9em; font-weight: 600; color: var(--text); }
  .status-detail { font-size: 0.78em; color: var(--muted); margin-top: 2px; }
  .status-help { font-size: 0.78em; color: var(--muted); margin-top: 6px; line-height: 1.5; }
  .status-help a { color: var(--teal); }

  /* ── field row (from settings) ── */
  .field-row {
    display: flex; align-items: flex-start; gap: 20px; margin-bottom: 16px;
  }
  .field-label-col { flex: 0 0 160px; padding-top: 2px; }
  .field-label { font-size: 0.88em; font-weight: 600; color: var(--text); display: block; margin-bottom: 3px; }
  .field-hint  { font-size: 0.78em; color: var(--muted); line-height: 1.4; }
  .field-control { flex: 1; }

  .field-select {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); font-size: 0.88em; border-radius: 6px;
    padding: 8px 10px; outline: none; width: 100%;
    transition: border-color 0.15s; cursor: pointer;
  }
  .field-select:focus { border-color: var(--accent); }

  .field-input {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); font-size: 0.88em; border-radius: 6px;
    padding: 8px 10px; outline: none; width: 100%;
    transition: border-color 0.15s;
  }
  .field-input:focus { border-color: var(--accent); }

  /* ── privacy radio cards ── */
  .privacy-cards { display: flex; flex-direction: column; gap: 10px; }
  .privacy-card {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 14px 16px; border: 1px solid var(--border);
    border-radius: 8px; cursor: pointer; transition: border-color 0.15s, background 0.15s;
  }
  .privacy-card:hover { border-color: var(--accent-border); }
  .privacy-card.selected { border-color: var(--teal); background: var(--accent-muted); }
  .privacy-card input[type="radio"] { margin-top: 3px; accent-color: var(--teal); flex-shrink: 0; }
  .privacy-card-content { flex: 1; }
  .privacy-card-title { font-size: 0.9em; font-weight: 600; color: var(--text); margin-bottom: 3px; }
  .privacy-card-desc { font-size: 0.78em; color: var(--muted); line-height: 1.4; }

  /* ── buttons ── */
  .setup-actions { display: flex; justify-content: space-between; align-items: center; padding-top: 20px; }
  .btn-setup {
    background: var(--teal); color: #0d1117;
    padding: 10px 28px; border-radius: 8px; border: none;
    font-size: 0.9em; font-weight: 700; cursor: pointer;
    transition: opacity 0.15s;
  }
  .btn-setup:hover { opacity: 0.88; }
  .btn-setup:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-setup-secondary {
    background: transparent; color: var(--text); border: 1px solid var(--border);
    padding: 10px 24px; border-radius: 8px; font-size: 0.9em; font-weight: 600;
    cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .btn-setup-secondary:hover { border-color: var(--teal); color: var(--teal); }
  .btn-setup-ghost {
    background: none; border: none; color: var(--muted); font-size: 0.82em;
    cursor: pointer; text-decoration: underline;
  }
  .btn-setup-ghost:hover { color: var(--text); }

  /* ── welcome illustration ── */
  .welcome-hero {
    text-align: center; padding: 20px 0 10px;
  }
  .welcome-icon { font-size: 3em; margin-bottom: 10px; }
  .welcome-title { font-size: 1.5em; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .welcome-desc { font-size: 0.92em; color: var(--muted); line-height: 1.6; max-width: 440px; margin: 0 auto 20px; }

  /* ── test result ── */
  .test-result {
    font-size: 0.82em; margin-top: 8px; padding: 8px 12px;
    border-radius: 6px; display: none;
  }
  .test-result.visible { display: block; }
  .test-result.ok { background: rgba(63,185,80,.1); color: var(--green); }
  .test-result.fail { background: rgba(248,81,73,.1); color: var(--red); }

  /* ── summary ── */
  .summary-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.88em;
  }
  .summary-row:last-child { border-bottom: none; }
  .summary-key { color: var(--muted); }
  .summary-val { color: var(--text); font-weight: 500; }
  .summary-val.ok { color: var(--green); }
  .summary-val.warn { color: var(--amber); }

  /* ── skip link ── */
  .setup-skip { text-align: center; margin-top: 16px; }
</style>

<div class="setup-wrap">

  <!-- ── Progress bar ── -->
  <div class="setup-progress-labels" id="progress-labels">
    <span>Welcome</span>
    <span>Connectivity</span>
    <span>LLM Config</span>
    <span>Privacy</span>
    <span>Complete</span>
  </div>
  <div class="setup-progress" id="progress-bar">
    <div class="setup-progress-segment current" data-step="0"></div>
    <div class="setup-progress-segment" data-step="1"></div>
    <div class="setup-progress-segment" data-step="2"></div>
    <div class="setup-progress-segment" data-step="3"></div>
    <div class="setup-progress-segment" data-step="4"></div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!-- STEP 1 — WELCOME                                                    -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <div class="setup-step active" data-step="0" id="step-welcome">
    <div class="welcome-hero">
      <div class="welcome-icon">&#128737;</div>
      <div class="welcome-title">Welcome to moke</div>
      <div class="welcome-desc">
        moke is a privacy-first data analysis interface built on loke. It lets you explore datasets,
        run queries through local and cloud LLMs, and keep sensitive data on your machine.
        This wizard will check your environment and configure a few essentials.
      </div>
    </div>
    <div class="setup-actions" style="justify-content:center;">
      <button class="btn-setup" onclick="goToStep(1)">Get Started</button>
    </div>
    <div class="setup-skip">
      <button class="btn-setup-ghost" onclick="skipSetup()">Skip setup — I know what I am doing</button>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!-- STEP 2 — CONNECTIVITY CHECK                                         -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <div class="setup-step" data-step="1" id="step-connectivity">
    <div class="setup-heading">Connectivity Check</div>
    <div class="setup-sub">Verifying that loke and Ollama are reachable.</div>

    <div class="setup-section">
      <div class="setup-section-head">Services</div>
      <div class="setup-section-body">

        <div class="status-check">
          <div class="status-dot checking" id="dot-loke"></div>
          <div class="status-info">
            <div class="status-label">loke privacy proxy</div>
            <div class="status-detail" id="detail-loke">Checking...</div>
            <div class="status-help" id="help-loke" style="display:none;"></div>
          </div>
        </div>

        <div class="status-check">
          <div class="status-dot checking" id="dot-ollama"></div>
          <div class="status-info">
            <div class="status-label">Ollama (local LLM runtime)</div>
            <div class="status-detail" id="detail-ollama">Checking...</div>
            <div class="status-help" id="help-ollama" style="display:none;"></div>
          </div>
        </div>

      </div>
    </div>

    <div style="text-align:center;margin-bottom:12px;">
      <button class="btn-setup-secondary" onclick="runConnectivityCheck()" style="font-size:0.82em;padding:7px 18px;">Re-check</button>
    </div>

    <div class="setup-actions">
      <button class="btn-setup-secondary" onclick="goToStep(0)">Back</button>
      <button class="btn-setup" onclick="goToStep(2)">Continue</button>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!-- STEP 3 — LLM CONFIGURATION                                         -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <div class="setup-step" data-step="2" id="step-llm">
    <div class="setup-heading">LLM Configuration</div>
    <div class="setup-sub">Choose a default model and optionally configure cloud API keys.</div>

    <div class="setup-section">
      <div class="setup-section-head">Model</div>
      <div class="setup-section-body">

        <div class="field-row">
          <div class="field-label-col">
            <span class="field-label">Preferred model</span>
            <span class="field-hint">Default model for new chat sessions.</span>
          </div>
          <div class="field-control">
            <select class="field-select" id="setup-model">
              <option value="loke-router">loke router (auto)</option>
              <option value="llama3.2:3b" selected>llama3.2:3b</option>
              <option value="qwen2.5:0.5b">qwen2.5:0.5b</option>
            </select>
          </div>
        </div>

      </div>
    </div>

    <div class="setup-section">
      <div class="setup-section-head">Cloud providers (optional)</div>
      <div class="setup-section-body">

        <div class="field-row">
          <div class="field-label-col">
            <span class="field-label">Anthropic API key</span>
            <span class="field-hint">For Claude models via loke.</span>
          </div>
          <div class="field-control">
            <input type="password" class="field-input" id="setup-anthropic-key" placeholder="sk-ant-..." autocomplete="off">
          </div>
        </div>

        <div class="field-row">
          <div class="field-label-col">
            <span class="field-label">OpenAI API key</span>
            <span class="field-hint">For GPT models via loke.</span>
          </div>
          <div class="field-control">
            <input type="password" class="field-input" id="setup-openai-key" placeholder="sk-..." autocomplete="off">
          </div>
        </div>

        <div style="text-align:center;">
          <button class="btn-setup-secondary" onclick="testSetupConnection()" style="font-size:0.82em;padding:7px 18px;">Test Connection</button>
        </div>
        <div class="test-result" id="setup-test-result"></div>

      </div>
    </div>

    <div class="setup-actions">
      <button class="btn-setup-secondary" onclick="goToStep(1)">Back</button>
      <button class="btn-setup" onclick="goToStep(3)">Continue</button>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!-- STEP 4 — PRIVACY PRESET                                            -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <div class="setup-step" data-step="3" id="step-privacy">
    <div class="setup-heading">Privacy Preset</div>
    <div class="setup-sub">Choose how aggressively moke protects sensitive data.</div>

    <div class="privacy-cards">

      <label class="privacy-card selected" onclick="selectPrivacy(this, 'maximum')">
        <input type="radio" name="privacy-preset" value="maximum" checked>
        <div class="privacy-card-content">
          <div class="privacy-card-title">Maximum Privacy</div>
          <div class="privacy-card-desc">
            All detection layers active (regex, NER, SLM). Most-restrictive conflict resolution
            — if any layer flags an entity, it is anonymised. Best for regulated industries and
            sensitive datasets.
          </div>
        </div>
      </label>

      <label class="privacy-card" onclick="selectPrivacy(this, 'balanced')">
        <input type="radio" name="privacy-preset" value="balanced">
        <div class="privacy-card-content">
          <div class="privacy-card-title">Balanced</div>
          <div class="privacy-card-desc">
            Regex and NER layers active with most-restrictive resolution. SLM contextual analysis
            disabled for faster processing. Good default for most use cases.
          </div>
        </div>
      </label>

      <label class="privacy-card" onclick="selectPrivacy(this, 'performance')">
        <input type="radio" name="privacy-preset" value="performance">
        <div class="privacy-card-content">
          <div class="privacy-card-title">Performance</div>
          <div class="privacy-card-desc">
            Regex-only detection with first-match resolution. Fastest processing — suitable when
            data is already de-identified or contains no PII.
          </div>
        </div>
      </label>

    </div>

    <div class="setup-actions">
      <button class="btn-setup-secondary" onclick="goToStep(2)">Back</button>
      <button class="btn-setup" onclick="goToStep(4)">Continue</button>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!-- STEP 5 — COMPLETE                                                   -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <div class="setup-step" data-step="4" id="step-complete">
    <div class="setup-heading">Setup Complete</div>
    <div class="setup-sub">Here is a summary of your configuration.</div>

    <div class="setup-section">
      <div class="setup-section-head">Summary</div>
      <div class="setup-section-body" style="padding-top:6px;padding-bottom:6px;">
        <div class="summary-row">
          <span class="summary-key">loke connection</span>
          <span class="summary-val" id="summary-loke">--</span>
        </div>
        <div class="summary-row">
          <span class="summary-key">Ollama</span>
          <span class="summary-val" id="summary-ollama">--</span>
        </div>
        <div class="summary-row">
          <span class="summary-key">Preferred model</span>
          <span class="summary-val" id="summary-model">--</span>
        </div>
        <div class="summary-row">
          <span class="summary-key">Anthropic key</span>
          <span class="summary-val" id="summary-anthropic">--</span>
        </div>
        <div class="summary-row">
          <span class="summary-key">OpenAI key</span>
          <span class="summary-val" id="summary-openai">--</span>
        </div>
        <div class="summary-row">
          <span class="summary-key">Privacy preset</span>
          <span class="summary-val" id="summary-privacy">--</span>
        </div>
      </div>
    </div>

    <div class="setup-actions" style="justify-content:center;">
      <button class="btn-setup" onclick="completeSetup()" style="padding:12px 36px;font-size:1em;">Start Using moke</button>
    </div>
  </div>

</div>

<script>
(function() {
  'use strict';

  var LOKE = window.LOKE_URL || 'http://127.0.0.1:11430';
  var currentStep = 0;
  var lokeOk = false;
  var ollamaOk = false;
  var selectedPrivacy = 'maximum';

  // ── Step navigation ─────────────────────────────────────────────────
  window.goToStep = function(step) {
    // Save LLM config when leaving step 2
    if (currentStep === 2) {
      saveLlmConfig();
    }
    // Populate summary when entering step 4
    if (step === 4) {
      populateSummary();
    }
    // Run connectivity check when entering step 1
    if (step === 1) {
      setTimeout(runConnectivityCheck, 100);
    }
    // Populate model selector when entering step 2
    if (step === 2) {
      setTimeout(populateModels, 100);
    }

    currentStep = step;
    var steps = document.querySelectorAll('.setup-step');
    for (var i = 0; i < steps.length; i++) {
      steps[i].classList.toggle('active', parseInt(steps[i].getAttribute('data-step'), 10) === step);
    }
    updateProgress(step);
  };

  function updateProgress(step) {
    var segments = document.querySelectorAll('.setup-progress-segment');
    for (var i = 0; i < segments.length; i++) {
      var s = parseInt(segments[i].getAttribute('data-step'), 10);
      segments[i].classList.toggle('done', s < step);
      segments[i].classList.toggle('current', s === step);
    }
    var labels = document.getElementById('progress-labels');
    if (labels) {
      var spans = labels.querySelectorAll('span');
      for (var j = 0; j < spans.length; j++) {
        spans[j].className = '';
        if (j < step) spans[j].className = 'done-label';
        if (j === step) spans[j].className = 'current-label';
      }
    }
  }

  // ── Connectivity check ──────────────────────────────────────────────
  window.runConnectivityCheck = function() {
    var dotLoke = document.getElementById('dot-loke');
    var detailLoke = document.getElementById('detail-loke');
    var helpLoke = document.getElementById('help-loke');
    var dotOllama = document.getElementById('dot-ollama');
    var detailOllama = document.getElementById('detail-ollama');
    var helpOllama = document.getElementById('help-ollama');

    // Reset
    dotLoke.className = 'status-dot checking';
    detailLoke.textContent = 'Checking...';
    helpLoke.style.display = 'none';
    dotOllama.className = 'status-dot checking';
    detailOllama.textContent = 'Checking...';
    helpOllama.style.display = 'none';

    // Wait for LOKE_URL to resolve (base.tkt does probe)
    var url = window.LOKE_URL || 'http://127.0.0.1:11430';
    LOKE = url;

    fetch(url + '/api/health', { cache: 'no-store' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d && (d.ok || d.status === 'ok')) {
          lokeOk = true;
          dotLoke.className = 'status-dot ok';
          detailLoke.textContent = 'loke v' + (d.loke || '?') + ' connected';

          // Ollama status from health response
          if (d.ollama === 'running') {
            ollamaOk = true;
            dotOllama.className = 'status-dot ok';
            detailOllama.textContent = 'Ollama running';
          } else {
            ollamaOk = false;
            dotOllama.className = 'status-dot fail';
            detailOllama.textContent = 'Ollama not detected';
            helpOllama.innerHTML = 'Install Ollama from <a href="https://ollama.ai" target="_blank" rel="noopener">ollama.ai</a>, then run <code>ollama serve</code>. moke can work without Ollama using cloud providers.';
            helpOllama.style.display = 'block';
          }
        } else {
          throw new Error('unexpected response');
        }
      })
      .catch(function() {
        lokeOk = false;
        ollamaOk = false;
        dotLoke.className = 'status-dot fail';
        detailLoke.textContent = 'loke offline';
        helpLoke.innerHTML = 'Start loke on port 11430. Check that the loke binary is running and accessible at <code>http://127.0.0.1:11430</code>.';
        helpLoke.style.display = 'block';

        dotOllama.className = 'status-dot fail';
        detailOllama.textContent = 'Cannot check (loke offline)';
      });
  };

  // ── Populate model selector from /api/models ──────────────────────
  function populateModels() {
    var url = window.LOKE_URL || 'http://127.0.0.1:11430';
    fetch(url + '/api/models', { cache: 'no-store' })
      .then(function(r) { return r.json(); })
      .then(function(models) {
        if (!Array.isArray(models) || models.length === 0) return;
        var sel = document.getElementById('setup-model');
        if (!sel) return;
        sel.innerHTML = '<option value="loke-router">loke router (auto)</option>';
        models.forEach(function(m) {
          var opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = m.id + (m.running ? ' \u25cf' : '');
          sel.appendChild(opt);
        });
        // Restore saved preference
        var saved = null;
        try { saved = JSON.parse(localStorage.getItem('moke_settings') || '{}').preferred_model; } catch(_) {}
        if (saved) sel.value = saved;
      })
      .catch(function() { /* keep static fallback */ });
  }

  // ── Save LLM config ──────────────────────────────────────────────
  function saveLlmConfig() {
    var model = (document.getElementById('setup-model') || {}).value || 'llama3.2:3b';
    var cfg = {};
    try { cfg = JSON.parse(localStorage.getItem('moke_settings') || '{}'); } catch(_) {}
    cfg.preferred_model = model;
    localStorage.setItem('moke_settings', JSON.stringify(cfg));

    // Save API keys to loke if provided
    var url = window.LOKE_URL || 'http://127.0.0.1:11430';
    var antKey = (document.getElementById('setup-anthropic-key') || {}).value || '';
    var oaiKey = (document.getElementById('setup-openai-key') || {}).value || '';

    if (antKey.trim()) {
      fetch(url + '/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'anthropic_api_key', value: antKey.trim() })
      }).catch(function() {});
    }
    if (oaiKey.trim()) {
      fetch(url + '/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'openai_api_key', value: oaiKey.trim() })
      }).catch(function() {});
    }
  }

  // ── Test connection ─────────────────────────────────────────────────
  window.testSetupConnection = function() {
    var resultEl = document.getElementById('setup-test-result');
    if (!resultEl) return;
    resultEl.className = 'test-result visible';
    resultEl.style.display = 'block';
    resultEl.style.background = 'rgba(210,153,34,.1)';
    resultEl.style.color = 'var(--amber)';
    resultEl.textContent = 'Testing connection...';

    var url = window.LOKE_URL || 'http://127.0.0.1:11430';
    fetch(url + '/api/pipeline', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: 'test',
        system_prompt: 'say ok',
        mode: 'test'
      })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d && (d.response || d.ok)) {
        resultEl.className = 'test-result visible ok';
        resultEl.textContent = '\u2713 Connected' + (d.model ? ' (' + d.model + ')' : '');
      } else {
        resultEl.className = 'test-result visible fail';
        resultEl.textContent = '\u2717 Failed: ' + (d.error || 'unknown error');
      }
    })
    .catch(function(err) {
      resultEl.className = 'test-result visible fail';
      resultEl.textContent = '\u2717 Failed: ' + err.message;
    });
  };

  // ── Privacy preset selection ────────────────────────────────────────
  window.selectPrivacy = function(el, value) {
    selectedPrivacy = value;
    var cards = document.querySelectorAll('.privacy-card');
    for (var i = 0; i < cards.length; i++) {
      cards[i].classList.remove('selected');
    }
    el.classList.add('selected');
  };

  // ── Summary ─────────────────────────────────────────────────────────
  function populateSummary() {
    var sumLoke = document.getElementById('summary-loke');
    var sumOllama = document.getElementById('summary-ollama');
    var sumModel = document.getElementById('summary-model');
    var sumAnth = document.getElementById('summary-anthropic');
    var sumOai = document.getElementById('summary-openai');
    var sumPriv = document.getElementById('summary-privacy');

    if (sumLoke) {
      sumLoke.textContent = lokeOk ? 'Connected' : 'Offline';
      sumLoke.className = 'summary-val ' + (lokeOk ? 'ok' : 'warn');
    }
    if (sumOllama) {
      sumOllama.textContent = ollamaOk ? 'Running' : 'Offline';
      sumOllama.className = 'summary-val ' + (ollamaOk ? 'ok' : 'warn');
    }
    if (sumModel) {
      sumModel.textContent = (document.getElementById('setup-model') || {}).value || 'llama3.2:3b';
    }
    if (sumAnth) {
      var ak = (document.getElementById('setup-anthropic-key') || {}).value || '';
      sumAnth.textContent = ak ? 'Configured' : 'Not set';
      sumAnth.className = 'summary-val ' + (ak ? 'ok' : '');
    }
    if (sumOai) {
      var ok = (document.getElementById('setup-openai-key') || {}).value || '';
      sumOai.textContent = ok ? 'Configured' : 'Not set';
      sumOai.className = 'summary-val ' + (ok ? 'ok' : '');
    }
    if (sumPriv) {
      var labels = { maximum: 'Maximum Privacy', balanced: 'Balanced', performance: 'Performance' };
      sumPriv.textContent = labels[selectedPrivacy] || selectedPrivacy;
    }
  }

  // ── Complete setup ──────────────────────────────────────────────────
  window.completeSetup = function() {
    // Save LLM config
    saveLlmConfig();

    // Save privacy preset
    var cfg = {};
    try { cfg = JSON.parse(localStorage.getItem('moke_settings') || '{}'); } catch(_) {}
    cfg.privacy_preset = selectedPrivacy;
    localStorage.setItem('moke_settings', JSON.stringify(cfg));

    // Mark setup complete
    localStorage.setItem('moke_setup_complete', 'true');

    // Redirect to home
    window.location.href = '/';
  };

  // ── Skip setup ──────────────────────────────────────────────────────
  window.skipSetup = function() {
    localStorage.setItem('moke_setup_complete', 'true');
    window.location.href = '/';
  };

})();
</script>
{! end !}

{! layout("base") !}
{! block("title") !}moke — Agents{! end !}
{! block("content") !}

<style>
  /* ── Agent panel styles ──────────────────────────────────────────────────── */
  .agent-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; flex-wrap: wrap; }
  .agent-header h1 { font-size: 1.4em; font-weight: 700; letter-spacing: -0.02em; flex: 1; }
  .agent-summary { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .agent-stat {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 16px 20px; min-width: 140px; flex: 1;
  }
  .agent-stat .stat-label { font-size: 0.72em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 6px; }
  .agent-stat .stat-value { font-size: 1.8em; font-weight: 700; letter-spacing: -0.02em; }
  .agent-stat .stat-value.green { color: var(--green); }
  .agent-stat .stat-value.amber { color: var(--amber); }
  .agent-stat .stat-value.red { color: var(--red); }

  .agent-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
  @media (max-width: 900px) { .agent-grid { grid-template-columns: 1fr; } }
  .agent-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 18px 20px; cursor: pointer; transition: border-color 0.15s;
  }
  .agent-card:hover { border-color: var(--teal); }
  .agent-card .card-top { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .agent-card .agent-name { font-weight: 600; font-size: 0.95em; flex: 1; }
  .agent-card .agent-desc { font-size: 0.82em; color: var(--muted); margin-bottom: 12px; }
  .agent-card .agent-meta { display: flex; gap: 12px; flex-wrap: wrap; font-size: 0.78em; color: var(--muted); }
  .agent-card .agent-meta span { display: flex; align-items: center; gap: 4px; }

  .status-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .status-dot.idle { background: var(--green); box-shadow: 0 0 5px var(--green); }
  .status-dot.running { background: var(--accent); box-shadow: 0 0 5px var(--accent); animation: ph-pulse 0.9s infinite; }
  .status-dot.error { background: var(--red); box-shadow: 0 0 5px var(--red); }
  .status-dot.disabled { background: var(--muted); }
  @keyframes ph-pulse { 0%,100%{opacity:1} 50%{opacity:0.25} }

  /* ── Diary panel ─────────────────────────────────────────────────────────── */
  .diary-panel {
    display: none; background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 20px 24px; margin-bottom: 20px;
  }
  .diary-panel.visible { display: block; }
  .diary-panel h2 { font-size: 1em; font-weight: 700; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
  .diary-close { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1.2em; margin-left: auto; }
  .diary-close:hover { color: var(--text); }

  .run-list { list-style: none; padding: 0; }
  .run-item {
    display: flex; align-items: flex-start; gap: 12px; padding: 10px 0;
    border-bottom: 1px solid var(--border); font-size: 0.85em;
  }
  .run-item:last-child { border-bottom: none; }
  .run-status { font-weight: 600; min-width: 60px; }
  .run-status.success { color: var(--green); }
  .run-status.error { color: var(--red); }
  .run-detail { flex: 1; color: var(--muted); }
  .run-detail strong { color: var(--text); }
  .run-meta { font-size: 0.78em; color: var(--muted); white-space: nowrap; }

  .btn {
    font-size: 0.8em; font-weight: 600; padding: 6px 14px; border-radius: 6px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text);
    cursor: pointer; transition: border-color 0.15s, background 0.15s;
  }
  .btn:hover { border-color: var(--teal); }
  .btn-primary { background: var(--teal); border-color: var(--teal); color: #0d1117; }
  .btn-primary:hover { background: #0fa899; }
</style>

<div class="agent-header">
  <h1>Agent Framework</h1>
  <button class="btn btn-primary" onclick="runScan()">Run Quality Scan</button>
  <button class="btn" onclick="refreshAgents()">Refresh</button>
</div>

<div class="agent-summary" id="agent-summary">
  <div class="agent-stat">
    <div class="stat-label">Total Agents</div>
    <div class="stat-value" id="stat-total">2</div>
  </div>
  <div class="agent-stat">
    <div class="stat-label">Running</div>
    <div class="stat-value green" id="stat-running">0</div>
  </div>
  <div class="agent-stat">
    <div class="stat-label">Errors</div>
    <div class="stat-value red" id="stat-errors">0</div>
  </div>
  <div class="agent-stat">
    <div class="stat-label">Last Updated</div>
    <div class="stat-value" id="stat-updated" style="font-size:0.9em">—</div>
  </div>
</div>

<div class="diary-panel" id="diary-panel">
  <h2>
    <span id="diary-agent-name">Agent Diary</span>
    <button class="diary-close" onclick="closeDiary()">&times;</button>
  </h2>
  <ul class="run-list" id="diary-runs"></ul>
</div>

<div class="agent-grid" id="agent-grid"></div>

<script>
(function() {
'use strict';

function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function renderAgents(data) {
  document.getElementById('stat-total').textContent = data.total_agents || 0;
  document.getElementById('stat-running').textContent = data.running_count || 0;
  document.getElementById('stat-errors').textContent = data.error_count || 0;
  document.getElementById('stat-updated').textContent = data.last_updated || 'now';

  var grid = document.getElementById('agent-grid');
  grid.innerHTML = '';
  (data.agents || []).forEach(function(a) {
    var statusCls = a.status || 'idle';
    var card = document.createElement('div');
    card.className = 'agent-card';
    card.onclick = function() { showDiary(a.agent_id); };
    card.innerHTML =
      '<div class="card-top">' +
        '<span class="status-dot ' + esc(statusCls) + '"></span>' +
        '<span class="agent-name">' + esc(a.name) + '</span>' +
        '<span class="badge badge-' + (a.enabled ? 'public' : 'muted') + '">' + (a.enabled ? 'enabled' : 'disabled') + '</span>' +
      '</div>' +
      '<div class="agent-desc">' + esc(a.description) + '</div>' +
      '<div class="agent-meta">' +
        '<span>Trigger: ' + esc(a.trigger_type) + '</span>' +
        '<span>Runs: ' + esc(a.total_runs) + '</span>' +
        '<span>Last: ' + esc(a.last_run) + '</span>' +
        '<span>Cost: $' + esc(Number(a.total_cost_usd || 0).toFixed(4)) + '</span>' +
        '<span>Success: ' + esc(Number(a.success_rate || 0).toFixed(0)) + '%</span>' +
      '</div>';
    grid.appendChild(card);
  });
}

window.refreshAgents = function() {
  fetch('http://127.0.0.1:11432/api/moke/agents', { mode: 'cors' })
    .then(function(r) { return r.json(); })
    .then(renderAgents)
    .catch(function(e) { console.error('[moke] agents fetch error:', e); });
};

window.runScan = function() {
  var ds = null;
  try { ds = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch(_) {}
  if (!ds || !ds.headers || !ds.rows) {
    alert('Load a dataset first to run the quality scan.');
    return;
  }
  fetch('http://127.0.0.1:11432/api/moke/agents/scan', {
    method: 'POST', mode: 'cors',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      dataset_id: ds.id || ds.name || 'unknown',
      headers: ds.headers,
      rows_json: JSON.stringify(ds.rows)
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(report) {
    alert('Scan complete: ' + (report.total_findings || 0) + ' findings (' +
      (report.critical_count || 0) + ' critical, ' +
      (report.warning_count || 0) + ' warning)');
    refreshAgents();
  })
  .catch(function(e) { console.error('[moke] scan error:', e); });
};

window.showDiary = function(agentId) {
  fetch('http://127.0.0.1:11432/api/moke/agents/diary?agent_id=' + encodeURIComponent(agentId), { mode: 'cors' })
    .then(function(r) { return r.json(); })
    .then(function(agent) {
      document.getElementById('diary-agent-name').textContent = (agent.name || agentId) + ' — Diary';
      var list = document.getElementById('diary-runs');
      list.innerHTML = '';
      var runs = agent.run_history || [];
      if (runs.length === 0) {
        list.innerHTML = '<li class="run-item"><span class="run-detail">No runs recorded yet.</span></li>';
      } else {
        runs.slice().reverse().forEach(function(r) {
          var li = document.createElement('li');
          li.className = 'run-item';
          li.innerHTML =
            '<span class="run-status ' + esc(r.status) + '">' + esc(r.status) + '</span>' +
            '<span class="run-detail">' +
              '<strong>' + esc(r.output_summary || r.error_message || '—') + '</strong><br>' +
              'Tokens: ' + esc(r.tokens_used) + ' | Cost: $' + esc(Number(r.cost_usd || 0).toFixed(4)) +
              ' | Findings: ' + esc(r.findings_count) +
            '</span>' +
            '<span class="run-meta">' +
              esc(r.started_at) + '<br>' +
              esc(r.duration_ms) + 'ms' +
            '</span>';
          list.appendChild(li);
        });
      }
      document.getElementById('diary-panel').classList.add('visible');
    })
    .catch(function(e) { console.error('[moke] diary fetch error:', e); });
};

window.closeDiary = function() {
  document.getElementById('diary-panel').classList.remove('visible');
};

// Auto-load on page visit
refreshAgents();

})();
</script>

{! end !}

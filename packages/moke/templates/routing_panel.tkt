<!-- MK16.2: Tiered Inference Visualiser -->
<div class="tier-card" id="tier-card">
  <div class="tier-header">
    Inference Tiers
    <span id="tier-hw-summary" style="font-weight:400;text-transform:none;letter-spacing:0;">detecting...</span>
  </div>
  <div class="tier-body" id="tier-body">
    <div class="tier-row" id="tier-interactive">
      <div class="tier-indicator active" id="tier-dot-interactive"></div>
      <div style="flex:1;">
        <div class="tier-name">Interactive (instant)</div>
        <div class="tier-models">llama3.2:3b, qwen2.5:0.5b, phi-3:mini</div>
      </div>
      <div class="tier-speed">~45 tok/s</div>
    </div>
    <div class="tier-row" id="tier-considered">
      <div class="tier-indicator" id="tier-dot-considered"></div>
      <div style="flex:1;">
        <div class="tier-name">Considered (~30s)</div>
        <div class="tier-models">llama3.1:8b, qwen2.5:7b, mistral:7b</div>
      </div>
      <div class="tier-speed">~18 tok/s</div>
    </div>
    <div class="tier-row" id="tier-background">
      <div class="tier-indicator" id="tier-dot-background"></div>
      <div style="flex:1;">
        <div class="tier-name">Background (minutes)</div>
        <div class="tier-models">llama3.1:70b, qwen2.5:72b, mixtral:8x7b</div>
      </div>
      <div class="tier-speed">~4 tok/s</div>
    </div>
  </div>
</div>

<!-- MK16.3: Companion Device Simulator -->
<div class="companion-card" id="companion-card">
  <div class="companion-header">
    Companion Devices
    <span id="companion-count" style="font-weight:400;text-transform:none;letter-spacing:0;">0 paired</span>
  </div>
  <div class="companion-body">
    <div class="companion-state">
      <div class="companion-dot" id="companion-dot"></div>
      <span id="companion-status">Idle</span>
    </div>
    <div class="companion-events" id="companion-events">
      <div>Session created -- idle</div>
    </div>
    <button class="companion-btn" id="companion-scan-btn" onclick="companionScan()">Scan Network</button>
  </div>
</div>

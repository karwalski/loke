{! layout("base") !}
{! block("title") !}moke — Dashboard{! end !}
{! block("content") !}

<style>
  /* ── Dashboard page overrides ───────────────────────────────────────────── */
  main { max-width: 1280px; }

  /* ── Page header ────────────────────────────────────────────────────────── */
  .dash-header {
    display: flex; align-items: center; gap: 14px;
    margin-bottom: 24px; flex-wrap: wrap;
  }
  .dash-header h1 { font-size: 1.4em; font-weight: 700; letter-spacing: -0.02em; flex: 1; }
  .dash-header .dash-meta { font-size: 0.8em; color: var(--muted); }
  .btn {
    font-size: 0.8em; font-weight: 600; padding: 6px 14px; border-radius: 6px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text);
    cursor: pointer; transition: border-color 0.15s, background 0.15s;
    white-space: nowrap;
  }
  .btn:hover { border-color: var(--accent); background: rgba(99,102,241,0.08); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: #4f52d8; border-color: #4f52d8; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ── Prompt bar ─────────────────────────────────────────────────────────── */
  .prompt-bar {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 18px 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 12px;
  }
  .prompt-row { display: flex; gap: 10px; align-items: flex-end; }
  .prompt-bar input[type="text"] {
    flex: 1; background: var(--bg); border: 1px solid var(--border); border-radius: 7px;
    color: var(--text); font-size: 14px; padding: 9px 13px; outline: none;
    transition: border-color 0.15s;
  }
  .prompt-bar input[type="text"]:focus { border-color: var(--accent); }
  .prompt-bar input[type="text"]::placeholder { color: var(--muted); }
  .refine-row { display: none; }
  .refine-row.visible { display: flex; }

  /* ── Prompt suggestion chips ───────────────────────────────────────────── */
  .dash-chips {
    display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 0 0;
  }
  .dash-chips-label {
    width: 100%; font-size: 0.72em; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--muted); margin-bottom: 2px;
  }
  .dash-chip {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 20px; padding: 6px 14px;
    font-size: 0.8em; color: var(--muted);
    cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .dash-chip:hover { border-color: var(--accent); color: var(--accent); }

  /* ── Phase loading indicator ────────────────────────────────────────────── */
  .phase-bar {
    display: none; align-items: center; gap: 0; padding: 12px 0; margin-bottom: 16px;
  }
  .phase-bar.visible { display: flex; }
  .phase-step {
    display: flex; align-items: center; gap: 7px; font-size: 0.8em;
    color: var(--muted); padding: 5px 10px; border-radius: 6px; transition: color 0.2s;
  }
  .phase-step .ph-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--border);
    transition: background 0.3s; flex-shrink: 0;
  }
  .phase-step.ph-running { color: var(--accent); }
  .phase-step.ph-running .ph-dot { background: var(--accent); animation: ph-pulse 0.9s infinite; }
  .phase-step.ph-done { color: var(--green); }
  .phase-step.ph-done .ph-dot { background: var(--green); }
  /* NC1.6: a phase that did not do its work is shown as not done, not as done. */
  .phase-step.ph-skipped { color: var(--amber); }
  .phase-step.ph-skipped .ph-dot { background: var(--amber); animation: none; }
  .phase-sep { color: var(--border); font-size: 0.75em; padding: 0 2px; }
  @keyframes ph-pulse { 0%,100%{opacity:1} 50%{opacity:0.25} }

  /* ── Template bar (MK3.4) ────────────────────────────────────────────────── */
  .template-bar {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 16px; margin-bottom: 14px;
  }
  .template-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .template-label {
    font-size: 0.72em; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--muted); white-space: nowrap;
  }
  .template-select {
    background: var(--bg); border: 1px solid var(--border); color: var(--text);
    border-radius: 6px; padding: 4px 10px; font-size: 0.8em; outline: none;
    cursor: pointer; flex: 1; max-width: 260px; transition: border-color 0.15s;
  }
  .template-select:focus { border-color: var(--teal); }
  .template-sep { color: var(--border); margin: 0 2px; }

  /* ── Empty / no-data state ──────────────────────────────────────────────── */
  .empty-dash {
    text-align: center; padding: 64px 32px; color: var(--muted); display: none;
  }
  .empty-dash.visible { display: block; }
  .empty-dash .empty-icon { font-size: 3em; margin-bottom: 14px; opacity: 0.3; }
  .empty-dash p { font-size: 0.9em; max-width: 340px; margin: 0 auto; }

  /* ── Dashboard grid ─────────────────────────────────────────────────────── */
  .dash-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .dash-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 18px 20px; overflow: hidden;
    transition: border-color 0.15s;
  }
  .dash-card:hover { border-color: rgba(99,102,241,0.35); }
  .dash-card.col-1 { grid-column: span 1; }
  .dash-card.col-2 { grid-column: span 2; }
  .dash-card.col-3 { grid-column: span 3; }
  .card-label {
    font-size: 0.72em; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--muted); margin-bottom: 10px;
  }

  /* ── Metric card ────────────────────────────────────────────────────────── */
  .metric-value {
    font-size: 2.4em; font-weight: 700; letter-spacing: -0.03em;
    line-height: 1.1; color: var(--text); margin-bottom: 4px;
  }
  .metric-unit { font-size: 0.65em; font-weight: 400; color: var(--muted); margin-left: 2px; }
  .metric-delta {
    font-size: 0.8em; font-weight: 600; display: inline-flex;
    align-items: center; gap: 3px; margin-top: 6px;
  }
  .metric-delta.up { color: var(--green); }
  .metric-delta.down { color: var(--red); }
  .metric-delta.flat { color: var(--muted); }

  /* ── Chart card ─────────────────────────────────────────────────────────── */
  .chart-wrap { position: relative; height: 220px; margin-top: 8px; }
  .chart-wrap canvas { width: 100% !important; height: 100% !important; }

  /* ── Table card ─────────────────────────────────────────────────────────── */
  .dash-table { width: 100%; border-collapse: collapse; font-size: 0.82em; margin-top: 8px; }
  .dash-table th {
    text-align: left; padding: 6px 10px; font-size: 0.75em; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);
    border-bottom: 1px solid var(--border); cursor: pointer; user-select: none;
    white-space: nowrap;
  }
  .dash-table th:hover { color: var(--text); }
  .dash-table th .sort-arrow { margin-left: 4px; opacity: 0.4; }
  .dash-table th.sorted-asc .sort-arrow::after { content: "↑"; opacity: 1; }
  .dash-table th.sorted-desc .sort-arrow::after { content: "↓"; opacity: 1; }
  .dash-table th .sort-arrow::after { content: "↕"; }
  .dash-table td {
    padding: 7px 10px; border-bottom: 1px solid rgba(42,45,58,0.6);
    color: var(--text);
  }
  .dash-table tr:last-child td { border-bottom: none; }
  .dash-table tr:hover td { background: rgba(99,102,241,0.04); }

  /* ── Text card (markdown) ───────────────────────────────────────────────── */
  .text-content { font-size: 0.88em; line-height: 1.7; color: var(--text); }
  .text-content strong { font-weight: 600; }
  .text-content em { font-style: italic; color: var(--muted); }
  .text-content ul { padding-left: 18px; margin: 6px 0; }
  .text-content li { margin: 3px 0; }

  /* ── List card ──────────────────────────────────────────────────────────── */
  .list-items { list-style: none; padding: 0; margin: 6px 0 0; }
  .list-items li {
    padding: 5px 0; border-bottom: 1px solid var(--border);
    font-size: 0.88em; display: flex; align-items: center; gap: 8px;
  }
  .list-items li:last-child { border-bottom: none; }
  .list-bullet {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); flex-shrink: 0;
  }

  /* ── Error banner ───────────────────────────────────────────────────────── */
  .error-banner {
    display: none; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3);
    border-radius: 8px; padding: 12px 16px; font-size: 0.85em; color: var(--red);
    margin-bottom: 16px;
  }
  .error-banner.visible { display: block; }

  /* ── NC1.6 Card provenance states ───────────────────────────────────────── */
  /* Amber for "look at this", muted grey for "nothing is loaded" — the same two
     roles the badge classes in base.tkt already use. Text and borders come from
     the theme tokens; the tints are the same rgba literals base.tkt uses. */
  .dash-card.state-unresolved {
    border-color: var(--amber); background: rgba(210,153,34,0.07);
    box-shadow: inset 3px 0 0 var(--amber);
  }
  .dash-card.state-unresolved:hover { border-color: var(--amber); }
  .dash-card.state-no-data {
    border-color: var(--muted); background: rgba(139,148,158,0.07);
    box-shadow: inset 3px 0 0 var(--muted);
  }
  .dash-card.state-no-data:hover { border-color: var(--muted); }
  .card-state {
    display: inline-block; font-size: 0.68em; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.09em;
    padding: 3px 9px; border-radius: 10px; margin-bottom: 8px;
  }
  .card-state.unresolved { background: rgba(210,153,34,.18); color: var(--amber); }
  .card-state.no-data    { background: rgba(139,148,158,.18); color: var(--muted); }
  .card-state-reason { font-size: 0.82em; line-height: 1.55; color: var(--text); }
  .card-state-note   { font-size: 0.78em; line-height: 1.5; color: var(--muted); margin-top: 6px; }
  .metric-value.unresolved { color: var(--muted); }
</style>

<!-- ── Page header ──────────────────────────────────────────────────────────── -->
<div class="dash-header">
  <h1>Dashboard</h1>
  <span class="dash-meta" id="dash-generated-at"></span>
  <button class="btn" id="btn-export-ddl" onclick="exportDDL()" disabled>Export DDL</button>
  <button class="btn" id="btn-export-png" onclick="exportPNG()" disabled>Export PNG</button>
  <button class="btn" id="btn-present" onclick="presentDashboard()" disabled style="margin-left:8px">&#9654; Present</button>
</div>

<!-- ── Prompt bar ───────────────────────────────────────────────────────────── -->
<div class="prompt-bar">
  <div class="prompt-row">
    <input type="text" id="dash-prompt"
      aria-label="Dashboard prompt"
      placeholder="Ask a question about your data to generate a dashboard…"
      onkeydown="if(event.key==='Enter')generateDashboard()" />
    <button class="btn btn-primary" id="btn-generate" onclick="generateDashboard()">
      Generate dashboard
    </button>
  </div>
  <div class="prompt-row refine-row" id="refine-row">
    <input type="text" id="refine-prompt"
      aria-label="Refine dashboard prompt"
      placeholder="Refine: e.g. 'add a pie chart for revenue by region', 'remove the table'…"
      onkeydown="if(event.key==='Enter')refineDashboard()" />
    <button class="btn" id="btn-refine" onclick="refineDashboard()">Refine</button>
  </div>
  <div class="dash-chips" id="dash-chips" style="display:none">
    <div class="dash-chips-label">Suggested prompts</div>
  </div>
</div>

<!-- ── Template bar (MK4.8.6) ─────────────────────────────────────────────────── -->
<div class="template-bar" id="template-bar">
  <div class="template-row">
    <span class="template-label">Templates</span>
    <select class="template-select" id="template-select" aria-label="Dashboard templates">
      <option value="">— load saved template —</option>
    </select>
    <button class="btn" onclick="loadTemplate()">Load</button>
    <button class="btn" onclick="deleteTemplate()">Delete</button>
    <span class="template-sep">|</span>
    <button class="btn btn-primary" onclick="saveTemplate()">Save current</button>
  </div>
</div>

<!-- ── Phase loading bar ─────────────────────────────────────────────────────── -->
<div class="phase-bar" id="phase-bar" aria-live="polite" role="status">
  <div class="phase-step" id="ph1">
    <span class="ph-dot"></span><span class="ph-text">Phase 1: Asking LLM to design dashboard…</span>
  </div>
  <span class="phase-sep">›</span>
  <div class="phase-step" id="ph2">
    <span class="ph-dot"></span><span class="ph-text">Phase 2: Running local computations…</span>
  </div>
  <span class="phase-sep">›</span>
  <div class="phase-step" id="ph3">
    <span class="ph-dot"></span><span class="ph-text">Phase 3: Rendering…</span>
  </div>
</div>

<!-- ── Error banner ──────────────────────────────────────────────────────────── -->
<div class="error-banner" id="error-banner" role="alert" aria-live="assertive"></div>

<!-- ── Empty state ───────────────────────────────────────────────────────────── -->
<div class="empty-dash visible" id="empty-dash">
  <div class="empty-icon">&#x1F4CA;</div>
  <p>Load a dataset first to generate a dashboard, or use the demo below.</p>
  <br>
  <button class="btn" onclick="loadDemo()">Load Customer Intelligence demo</button>
</div>

<!-- ── MK4.8.5 Export bar ────────────────────────────────────────────────────── -->
<div id="export-bar" style="display:none; padding:8px 0; gap:8px; justify-content:flex-end;">
  <button class="btn btn-ghost" onclick="exportPNG()">Export PNG</button>
  <button class="btn btn-ghost" onclick="exportJSON()">Export JSON</button>
</div>

<!-- ── Dashboard grid ────────────────────────────────────────────────────────── -->
<div class="dash-grid" id="dash-grid"></div>

<script>
(function () {
'use strict';

// ── Cluster colour palette ─────────────────────────────────────────────────
const PALETTE = [
  'rgba(99,102,241,0.8)','rgba(34,197,94,0.8)','rgba(245,158,11,0.8)',
  'rgba(239,68,68,0.8)','rgba(59,130,246,0.8)','rgba(168,85,247,0.8)',
  'rgba(20,184,166,0.8)','rgba(251,146,60,0.8)','rgba(236,72,153,0.8)',
  'rgba(132,204,22,0.8)'
];
const PALETTE_BORDER = PALETTE.map(c => c.replace('0.8','1'));

// ── MK4.8.7: Semantic colour coding for chart values ──────────────────────
var SEMANTIC_COLOURS = {
  negative: ['failed','critical','expired','breach','overdue','rejected','blocked','offline','down','high-risk','p1','restricted','error','alert','violated','unhealthy','degraded','severe','fatal','emergency'],
  positive: ['passed','healthy','active','approved','resolved','online','up','compliant','low-risk','public','ok','success','normal','good','operational','available','running','connected'],
  neutral:  ['unknown','null','n/a','other','pending','none','unclassified','undefined','empty','missing','not set','tbd'],
  warning:  ['warning','caution','medium-risk','degrading','expiring','approaching','internal','moderate','partial','intermittent']
};

var SEMANTIC_RGBA = {
  negative: 'rgba(248,81,73,0.7)',
  positive: 'rgba(63,185,80,0.7)',
  neutral:  'rgba(139,148,158,0.5)',
  warning:  'rgba(210,153,34,0.7)'
};

// Map DDL colour names to rgba values
var DDL_COLOUR_MAP = {
  red:    'rgba(248,81,73,0.7)',
  green:  'rgba(63,185,80,0.7)',
  grey:   'rgba(139,148,158,0.5)',
  gray:   'rgba(139,148,158,0.5)',
  amber:  'rgba(210,153,34,0.7)'
};

function semanticColour(value) {
  if (value === null || value === undefined) return null;
  var lower = String(value).toLowerCase().trim();
  if (!lower) return null;

  // Dictionary lookup
  var cats = Object.keys(SEMANTIC_COLOURS);
  for (var i = 0; i < cats.length; i++) {
    if (SEMANTIC_COLOURS[cats[i]].indexOf(lower) !== -1) {
      return SEMANTIC_RGBA[cats[i]];
    }
  }

  // Boolean pattern
  if (lower === 'true' || lower === 'yes') return SEMANTIC_RGBA.positive;
  if (lower === 'false' || lower === 'no') return SEMANTIC_RGBA.negative;

  // Percentage pattern (e.g. "92%", "15%")
  var pctMatch = lower.match(/^(\d+(?:\.\d+)?)\s*%$/);
  if (pctMatch) {
    var pct = parseFloat(pctMatch[1]);
    if (pct >= 80) return SEMANTIC_RGBA.positive;
    if (pct <= 20) return SEMANTIC_RGBA.negative;
    if (pct <= 40) return SEMANTIC_RGBA.warning;
  }

  return null;
}

// ── Dataset-specific prompt suggestions ────────────────────────────────────
var DASH_PROMPTS = {
  'au.medicare': ['Claims by specialty and month', 'Cost distribution by state', 'Top providers by total benefit', 'Bulk billing rate over time'],
  'au.water': ['pH trends by location', 'Turbidity alerts by suburb', 'Chemical levels comparison', 'Sensor reading frequency'],
  'au.opal': ['Tap-on volume by station and hour', 'Journey time distribution', 'Fare revenue by route type', 'Peak vs off-peak usage'],
  'it_hardware.server_inventory': ['Server count by manufacturer', 'CPU utilisation distribution', 'Warranty expiry timeline', 'Storage capacity by data centre'],
  'customer_intelligence': ['Customer segments by spend', 'Churn risk distribution', 'LTV by acquisition channel', 'NPS score trends']
};

// ── State ──────────────────────────────────────────────────────────────────
let currentDDL = null;      // parsed DDL object (JS)
let chartInstances = {};    // id → Chart.js instance
let sortState = {};         // table-id → { col, asc }

// ── Phase bar helpers ──────────────────────────────────────────────────────
const PHASE_LABELS = {
  ph1: 'Phase 1: Asking LLM to design dashboard…',
  ph2: 'Phase 2: Running local computations…',
  ph3: 'Phase 3: Rendering…'
};
function phaseText(id, text) {
  const el = document.getElementById(id);
  if (!el) return;
  const t = el.querySelector('.ph-text');
  if (t) t.textContent = text;
}
function phaseReset() {
  ['ph1','ph2','ph3'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.className = 'phase-step';
    phaseText(id, PHASE_LABELS[id]);
  });
  document.getElementById('phase-bar').classList.remove('visible');
}
function phaseStart() {
  phaseReset();
  document.getElementById('phase-bar').classList.add('visible');
}
function phaseRun(id) {
  document.getElementById(id).classList.add('ph-running');
}
function phaseDone(id, text) {
  const el = document.getElementById(id);
  el.classList.remove('ph-running','ph-skipped');
  el.classList.add('ph-done');
  if (text) phaseText(id, text);
}
// NC1.6 — a phase that did not do its work says so, and is never marked done.
function phaseSkipped(id, text) {
  const el = document.getElementById(id);
  el.classList.remove('ph-running','ph-done');
  el.classList.add('ph-skipped');
  if (text) phaseText(id, text);
}

// ── Error helpers ──────────────────────────────────────────────────────────
function showError(msg) {
  const el = document.getElementById('error-banner');
  el.textContent = msg;
  el.classList.add('visible');
}
function clearError() {
  document.getElementById('error-banner').classList.remove('visible');
}

// ── Escape HTML ────────────────────────────────────────────────────────────
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Simple markdown renderer (bold, italic, lists) ─────────────────────────
function renderMarkdown(md) {
  let html = esc(md);
  // Bold
  html = html.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
  // Italic
  html = html.replace(/\*(.+?)\*/g,'<em>$1</em>');
  // Bullet lists: lines starting with - or *
  const lines = html.split('\n');
  let out = '';
  let inList = false;
  lines.forEach(line => {
    const m = line.match(/^[-*]\s+(.+)/);
    if (m) {
      if (!inList) { out += '<ul>'; inList = true; }
      out += '<li>' + m[1] + '</li>';
    } else {
      if (inList) { out += '</ul>'; inList = false; }
      out += line + (line.length ? '<br>' : '');
    }
  });
  if (inList) out += '</ul>';
  return out;
}

// ── Extract JSON from LLM response text ───────────────────────────────────
function extractJSON(text) {
  // Try ```json block
  const fenceMatch = text.match(/```json\s*([\s\S]*?)```/);
  if (fenceMatch) {
    try { return JSON.parse(fenceMatch[1].trim()); } catch(_) {}
  }
  // Try bare JSON object
  const start = text.indexOf('{');
  if (start === -1) return null;
  // Walk to find matching brace
  let depth = 0, end = -1;
  for (let i = start; i < text.length; i++) {
    if (text[i] === '{') depth++;
    else if (text[i] === '}') { depth--; if (depth === 0) { end = i; break; } }
  }
  if (end === -1) return null;
  try { return JSON.parse(text.slice(start, end+1)); } catch(_) { return null; }
}

// ── Normalise LLM response to internal DDL format ─────────────────────────
// The prompt asks for { cards: [...] }. Some models answer with the older
// { charts: [...] } shape instead, so that shape is still accepted and mapped.
// NC1.5: no value carried by the model survives this function. Only column
// references, the chart type and the operation are kept — any 'data' array the
// model attached is dropped, because the model was never given the data and so
// cannot have computed anything.
function normaliseDDL(obj) {
  // If it already has cards, keep it (DDL format or refined DDL)
  if (obj.cards && Array.isArray(obj.cards) && obj.cards.length > 0) return obj;

  // Convert { charts: [...] } to { cards: [...] }
  if (obj.charts && Array.isArray(obj.charts)) {
    var cards = obj.charts.map(function(ch, i) {
      var chartType = (ch.type || ch.chart_type || 'bar').toLowerCase();
      var xKey = ch.xKey || ch.x_key || ch.x_col || '';
      var yKey = ch.yKey || ch.y_key || ch.y_col || '';
      // The legacy shape carries no operation, so one is derived here from the
      // column references: count rows per group when no measure was named, sum
      // the named measure otherwise. A local decision, not a model-supplied one.
      var op = (ch.query_op || ch.queryOp || '').toLowerCase();
      if (!op) op = (!yKey || /^count$/i.test(String(yKey))) ? 'count_by_group' : 'sum_by_group';

      return {
        id: ch.id || ('chart-' + i),
        kind: 'chart',
        title: ch.title || ('Chart ' + (i + 1)),
        col_span: ch.col_span || (i < 2 ? 2 : 1),
        chart: {
          chart_type: chartType,
          x_col: xKey,
          y_col: yKey,
          query_op: op
        }
      };
    });

    return {
      title: obj.title || 'Dashboard',
      summary: obj.summary || '',
      cards: cards
    };
  }

  // Fallback: return as-is
  return obj;
}

// ── NC1.5: model-supplied values are inadmissible ──────────────────────────
// The model receives a schema profile and no rows, so any value-shaped field in
// its reply is invented. Each is deleted here, before anything can read it, so
// no model-supplied number can reach a render slot. This also runs over saved
// templates, whose stored values were computed in some earlier session against
// possibly some other dataset and cannot be attested to now.
function stripUnverifiedValues(ddlObj) {
  ((ddlObj && ddlObj.cards) || []).forEach(function(card) {
    if (!card) return;
    delete card.provenance;
    var m = card.metric, c = card.chart, t = card.table;
    if (m) {
      delete m.resolved_value; delete m.resolved_label;
      delete m.value; delete m.data; delete m.delta; delete m.resolved_delta;
      // A label of the form 'Total customers [12,483]' smuggles a number through
      // the display channel, so the bracketed part goes too.
      if (typeof m.label === 'string') m.label = m.label.replace(/\s*\[.*?\]\s*$/, '');
    }
    if (c) {
      delete c.resolved_data; delete c.data;
      delete c.labels; delete c.values; delete c.datasets;
    }
    if (t) {
      delete t.resolved_rows; delete t.resolved_columns;
      delete t.rows; delete t.data;
    }
  });
  return ddlObj;
}

// ── NC1.6: provenance state on every card ──────────────────────────────────
//   resolved   — computed here from the loaded rows. The only state that may
//                carry a number, and the only one that may say it was computed.
//   unresolved — the artifact referenced a column or an operation that could not
//                be matched against the loaded data. The reason names it.
//   no-data    — no dataset is loaded, so nothing could be computed at all.
function setProvenance(card, state, reason, note) {
  card.provenance = { state: state, reason: reason || '', note: note || '' };
  return card;
}
function cardState(card) {
  var p = card && card.provenance;
  if (p && (p.state === 'resolved' || p.state === 'unresolved' || p.state === 'no-data')) {
    return p.state;
  }
  // Unknown provenance is never treated as resolved.
  return 'unresolved';
}
function cardReason(card) {
  var p = card && card.provenance;
  if (p && p.reason) return p.reason;
  return 'This card was not resolved against the loaded data in this session, so no value is shown.';
}
function cardNote(card) {
  var p = card && card.provenance;
  return (p && p.note) ? p.note : '';
}
function markAllCards(ddlObj, state, reason) {
  ((ddlObj && ddlObj.cards) || []).forEach(function(card) { setProvenance(card, state, reason); });
  return ddlObj;
}

// Does this chart carry a series that was computed on this device?
function chartHasLocalData(c) {
  if (!c) return false;
  if (c.resolved_data && Array.isArray(c.resolved_data.labels) && c.resolved_data.labels.length) return true;
  // Scatter cards from the Insight Lab handoff carry locally computed points.
  if (String(c.chart_type || '').toLowerCase() === 'scatter'
      && Array.isArray(c.data) && c.data.length) return true;
  return false;
}

// ── NC1.6: the block a card shows when it carries no local value ───────────
function renderStateBlock(card) {
  const state = cardState(card);
  const cls   = (state === 'no-data') ? 'no-data' : 'unresolved';
  const label = (state === 'no-data') ? 'No data loaded' : 'Not computed';
  return `<div class="card-state ${cls}">${esc(label)}</div>
    <div class="card-state-reason">${esc(cardReason(card))}</div>`;
}

// ── NC1.4: schema profile ──────────────────────────────────────────────────
// What is built here, and sent: column names, an inferred type, a distinct-value
// count, a null rate, and the row count. Nothing else. No sample values, no
// minimum, no maximum, no mean, no modal category — those are real data.
// Values are read only in order to be counted; none is stored on the result.
var PROFILE_PII_RE      = /_name$|_email$|phone|dob$|ssn|tfn|medicare|card_no|pii_/i;
var PROFILE_DT_NAME_RE  = /date|time|created|updated|timestamp|period|expiry/i;
var PROFILE_NUM_NAME_RE = /amount|price|cost|total|count|qty|quantity|revenue|salary|wage|rate|score|age|size|weight|height|lat|lon|pct|percent/i;
var PROFILE_DT_VALUE_RE = /^\d{4}-\d{2}-\d{2}|^\d{2}[\/\-]\d{2}[\/\-]\d{4}|^\d{1,2}\/\d{1,2}\/\d{2,4}/;
var PROFILE_BOOL_RE     = /^(true|false|yes|no|y|n)$/i;

// Type detector. Same cascade as inferColTypes() in upload.tkt — column-name
// patterns first, then a vote over value shapes — reusing parseNumeric() below
// for the numeric test and the date shapes bucketDates() already accepts.
// Returns a type name, or null meaning 'decide from cardinality'. Never a value.
function inferColumnType(header, rows, idx) {
  var name = String(header || '');
  var limit = Math.min(rows.length, 200);
  var nonNull = 0, numeric = 0, datey = 0, booly = 0;
  for (var i = 0; i < limit; i++) {
    var v = rows[i] ? rows[i][idx] : null;
    if (v === null || v === undefined || v === '') continue;
    nonNull++;
    var s = String(v).trim();
    if (!isNaN(parseNumeric(s))) numeric++;
    if (PROFILE_DT_VALUE_RE.test(s)) datey++;
    if (PROFILE_BOOL_RE.test(s)) booly++;
  }
  if (nonNull === 0) {
    // No rows on the device — the column name is all there is to go on.
    if (PROFILE_DT_NAME_RE.test(name)) return 'datetime';
    if (PROFILE_NUM_NAME_RE.test(name)) return 'numeric';
    return 'unknown';
  }
  if (booly / nonNull > 0.9) return 'boolean';
  if (datey / nonNull > 0.6) return 'datetime';
  if (numeric / nonNull > 0.8) return 'numeric';
  return null;
}

function readActiveDataset() {
  var ds = null;
  try { ds = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch (_) {}
  return ds;
}

// Rows here are arrays indexed by header position, which is the shape the
// dataset loaders write and the shape resolveQueries() reads.
function buildSchemaProfile(dataset) {
  if (!dataset || !Array.isArray(dataset.headers) || !dataset.headers.length) return null;
  var headers = dataset.headers;
  var rows = Array.isArray(dataset.rows) ? dataset.rows : [];
  var piiNamed = [];
  var columns = headers.map(function(h, idx) {
    var nonNull = 0, distinct = 0;
    // 'seen' never leaves this function; only its size is reported.
    var seen = Object.create(null);
    for (var i = 0; i < rows.length; i++) {
      var v = rows[i] ? rows[i][idx] : null;
      if (v === null || v === undefined || v === '') continue;
      nonNull++;
      var k = String(v);
      if (seen[k] === undefined) { seen[k] = 1; distinct++; }
    }
    var type = inferColumnType(h, rows, idx);
    if (type === null) {
      type = (distinct <= 25 || distinct / nonNull < 0.4) ? 'categorical' : 'text';
    }
    if (PROFILE_PII_RE.test(String(h))) piiNamed.push(h);
    return {
      name: h,
      type: type,
      distinct_count: rows.length > 0 ? distinct : null,
      null_rate: rows.length > 0 ? (rows.length - nonNull) / rows.length : null
    };
  });
  return {
    name: dataset.name || dataset.id || 'dataset',
    row_count: rows.length,
    rows_loaded: rows.length > 0,
    columns: columns,
    pii_named_columns: piiNamed
  };
}

// Render the profile for the prompt. It can only print the fields built above,
// so it cannot print a data value.
function formatSchemaProfile(profile) {
  if (!profile) return '';
  var lines = [];
  lines.push('Dataset name: ' + profile.name);
  lines.push(profile.rows_loaded
    ? 'Row count: ' + profile.row_count
    : 'Row count: unknown — only the column list is loaded on this device.');
  lines.push('Columns, as "name | inferred type | distinct values | null rate":');
  profile.columns.forEach(function(c) {
    var card = (c.distinct_count === null) ? 'unknown' : String(c.distinct_count);
    var nr   = (c.null_rate === null) ? 'unknown' : (c.null_rate * 100).toFixed(1) + '%';
    lines.push('  ' + c.name + ' | ' + c.type + ' | ' + card + ' | ' + nr);
  });
  if (profile.pii_named_columns.length) {
    lines.push('Columns whose names suggest personal data — do not ask for their contents: '
      + profile.pii_named_columns.join(', '));
  }
  return lines.join('\n');
}

// ── Phase 2, in one place ──────────────────────────────────────────────────
// Strips anything this browser did not compute, resolves what it can against the
// loaded rows, and leaves every card carrying the state it actually reached.
// Returns a report the caller uses to label the phase indicator truthfully.
function applyLocalResolution(ddlObj) {
  stripUnverifiedValues(ddlObj);
  var total = ((ddlObj && ddlObj.cards) || []).length;
  var dataset = readActiveDataset();
  var rows = (dataset && Array.isArray(dataset.rows)) ? dataset.rows : [];
  if (!rows.length) {
    markAllCards(ddlObj, 'no-data',
      'No dataset is loaded on this device, so nothing was computed. Load a dataset, then generate again.');
    return { ddl: ddlObj, ran: false, resolved: 0, total: total, rowCount: 0 };
  }
  try {
    resolveQueries(ddlObj, dataset);
  } catch (err) {
    console.warn('[moke] Phase 2 resolveQueries failed', err);
    markAllCards(ddlObj, 'unresolved',
      'The local resolver failed on this dashboard (' + (err && err.message ? err.message : 'unknown error')
      + '), so no values were computed.');
    return { ddl: ddlObj, ran: false, resolved: 0, total: total, rowCount: rows.length };
  }
  var resolved = ((ddlObj && ddlObj.cards) || []).filter(function(c) {
    return cardState(c) === 'resolved';
  }).length;
  return { ddl: ddlObj, ran: true, resolved: resolved, total: total, rowCount: rows.length };
}

// Phase indicator text for a resolution report. A phase that computed nothing is
// marked skipped, never done.
function reportPhase2(report) {
  if (!report.ran && report.rowCount === 0) {
    phaseSkipped('ph2', 'Phase 2: no local computation — no dataset loaded');
  } else if (!report.ran) {
    phaseSkipped('ph2', 'Phase 2: local computation failed — no values computed');
  } else if (report.resolved === 0) {
    phaseSkipped('ph2', 'Phase 2: 0 of ' + report.total + ' cards resolved against the loaded data');
  } else {
    phaseDone('ph2', 'Phase 2: ' + report.resolved + ' of ' + report.total
      + ' cards computed locally from ' + report.rowCount + ' rows');
  }
}

// The Insight Lab handoff carries values this browser computed (k-means,
// z-score, correlation), so those cards are genuinely resolved. A card that
// arrived with no computed value is not.
function markLocalHandoff(ddlObj) {
  ((ddlObj && ddlObj.cards) || []).forEach(function(card) {
    var hasLocal = false;
    if (card.kind === 'metric') {
      var m = card.metric || {};
      hasLocal = (typeof m.resolved_value === 'number' && !isNaN(m.resolved_value))
        || /\[.+\]\s*$/.test(String(m.label || ''));
    } else if (card.kind === 'chart') {
      hasLocal = chartHasLocalData(card.chart);
    } else if (card.kind === 'table') {
      var t = card.table || {};
      hasLocal = !!(t.resolved_rows && t.resolved_rows.length) || !!(t.rows && t.rows.length);
    }
    if (hasLocal) setProvenance(card, 'resolved', '', 'computed in this browser by Insight Lab');
    else setProvenance(card, 'unresolved', 'The Insight Lab handoff carried no computed value for this card.');
  });
  return ddlObj;
}

// ── Phase 2: local query resolution ───────────────────────────────────────

// Find column index by name — case-insensitive, falls back to substring match
function getColIndex(headers, colName) {
  if (!colName || !headers) return -1;
  const needle = colName.toLowerCase().trim();
  // Exact match first
  let idx = headers.findIndex(h => h.toLowerCase().trim() === needle);
  if (idx !== -1) return idx;
  // Substring match
  idx = headers.findIndex(h => h.toLowerCase().includes(needle) || needle.includes(h.toLowerCase().trim()));
  return idx;
}

// Parse a value to float; returns NaN for non-numeric
function parseNumeric(val) {
  if (val === null || val === undefined || val === '') return NaN;
  const s = String(val).replace(/[$,\s%]/g, '');
  return parseFloat(s);
}

// Group rows by keyIdx, compute op (count/mean/sum) on valueIdx per group
// Returns { labels: string[], values: number[] }
function groupBy(rows, keyIdx, valueIdx, op) {
  const groups = new Map();
  for (const row of rows) {
    const key = String(row[keyIdx] ?? '(blank)');
    if (!groups.has(key)) groups.set(key, { sum: 0, count: 0 });
    const g = groups.get(key);
    if (op === 'count') {
      if (row[valueIdx] !== null && row[valueIdx] !== undefined && row[valueIdx] !== '') g.count++;
    } else {
      const n = parseNumeric(row[valueIdx]);
      if (!isNaN(n)) { g.sum += n; g.count++; }
    }
  }
  const labels = [], values = [];
  for (const [k, g] of groups) {
    labels.push(k);
    if (op === 'count') values.push(g.count);
    else if (op === 'sum') values.push(g.sum);
    else values.push(g.count > 0 ? g.sum / g.count : 0); // mean
  }
  return { labels, values };
}

// Group rows by year-month bucket of the date column at dateIdx
// Returns { labels: string[], values: number[] }
function bucketDates(rows, dateIdx, valueIdx, op) {
  const buckets = new Map();
  for (const row of rows) {
    const raw = String(row[dateIdx] ?? '');
    // Accept ISO dates or any string beginning with YYYY-MM
    const m = raw.match(/^(\d{4}-\d{2})/);
    const key = m ? m[1] : raw.slice(0, 7) || '(unknown)';
    if (!buckets.has(key)) buckets.set(key, { sum: 0, count: 0 });
    const b = buckets.get(key);
    if (op === 'count') {
      b.count++;
    } else {
      const n = parseNumeric(row[valueIdx]);
      if (!isNaN(n)) { b.sum += n; b.count++; }
    }
  }
  // Sort buckets chronologically
  const sorted = [...buckets.entries()].sort((a, b) => a[0].localeCompare(b[0]));
  const labels = [], values = [];
  for (const [k, b] of sorted) {
    labels.push(k);
    if (op === 'count' || op === 'count_by_day') values.push(b.count);
    else values.push(b.count > 0 ? b.sum / b.count : 0);
  }
  return { labels, values };
}

// Format a number for display in a metric label
function fmtMetricValue(n, unit) {
  if (isNaN(n)) return '—';
  const prefix = (unit === '$') ? '$' : '';
  const suffix = (unit === '%') ? '%' : '';
  let s;
  if (Math.abs(n) >= 1_000_000) s = (n / 1_000_000).toFixed(1) + 'M';
  else if (Math.abs(n) >= 1_000) s = n.toLocaleString(undefined, { maximumFractionDigits: 0 });
  else s = n.toLocaleString(undefined, { maximumFractionDigits: 2 });
  return prefix + s + suffix;
}

// The operations the local resolver actually implements. Anything else is
// reported as unsupported rather than silently ignored.
const METRIC_OPS = ['count','sum','mean','min','max'];
const CHART_OPS  = ['count_by_group','mean_by_group','sum_by_group','count_by_day','timeseries','top_n'];
const TABLE_OPS  = ['top_n','filter'];

function missingColumnReason(name) {
  return name
    ? 'Column "' + name + '" is not in the loaded data, so nothing was computed.'
    : 'The artifact named no column, so nothing was computed.';
}
function unsupportedOpReason(op, supported) {
  return op
    ? 'Operation "' + op + '" is not one the local resolver implements. It knows: ' + supported.join(', ') + '.'
    : 'The artifact named no operation, so nothing was computed.';
}

// Main Phase 2 resolver — mutates ddlObj in-place, returns it.
// NC1.6: every card leaves this function carrying a provenance state, and every
// early exit records why it fired, so the renderer can name the column or the
// operation that failed instead of quietly showing something else.
function resolveQueries(ddlObj, dataset) {
  const rows    = dataset.rows || [];
  const headers = dataset.headers || [];
  if (!rows.length) {
    return markAllCards(ddlObj, 'no-data',
      'No rows are loaded on this device, so nothing was computed.');
  }

  for (const card of (ddlObj.cards || [])) {
    // Default: not resolved. A card becomes resolved only by reaching the end of
    // its branch with a locally computed result.
    setProvenance(card, 'unresolved',
      'Nothing on this card could be matched against the loaded data.');
    try {
      if (card.kind === 'metric') {
        const m = card.metric || {};
        const op  = (m.query_op || '').toLowerCase();
        const col = m.query_col || '';
        if (METRIC_OPS.indexOf(op) === -1) {
          setProvenance(card, 'unresolved', unsupportedOpReason(op, METRIC_OPS)); continue;
        }
        const idx = getColIndex(headers, col);
        if (idx === -1) { setProvenance(card, 'unresolved', missingColumnReason(col)); continue; }

        let result = NaN;
        const nums = rows.map(r => parseNumeric(r[idx])).filter(n => !isNaN(n));
        if (op === 'count') {
          result = rows.filter(r => r[idx] !== null && r[idx] !== undefined && r[idx] !== '').length;
        } else {
          if (!nums.length) {
            setProvenance(card, 'unresolved',
              'Column "' + headers[idx] + '" holds no numeric values, so "' + op + '" could not be computed.');
            continue;
          }
          if (op === 'sum')       result = nums.reduce((a, b) => a + b, 0);
          else if (op === 'mean') result = nums.reduce((a, b) => a + b, 0) / nums.length;
          else if (op === 'min')  result = Math.min(...nums);
          else if (op === 'max')  result = Math.max(...nums);
        }
        if (typeof result !== 'number' || isNaN(result)) {
          setProvenance(card, 'unresolved',
            '"' + op + '" over column "' + headers[idx] + '" produced no value.');
          continue;
        }

        m.resolved_value = result;
        m.resolved_label = String(m.label || card.title || '').replace(/\s*\[.*?\]\s*$/, '');
        setProvenance(card, 'resolved', '',
          op + '(' + headers[idx] + ') over ' + rows.length + ' rows');

      } else if (card.kind === 'chart') {
        const c  = card.chart || {};
        const op = (c.query_op || '').toLowerCase();
        if (CHART_OPS.indexOf(op) === -1) {
          setProvenance(card, 'unresolved', unsupportedOpReason(op, CHART_OPS)); continue;
        }
        const xIdx = getColIndex(headers, c.x_col);
        const yIdx = getColIndex(headers, c.y_col);
        const topN = parseInt(c.top_n) || 10;
        let resolved = null;

        if (op === 'count_by_group') {
          if (xIdx === -1) { setProvenance(card, 'unresolved', missingColumnReason(c.x_col)); continue; }
          resolved = groupBy(rows, xIdx, xIdx, 'count');
        } else if (op === 'mean_by_group' || op === 'sum_by_group') {
          if (xIdx === -1) { setProvenance(card, 'unresolved', missingColumnReason(c.x_col)); continue; }
          if (yIdx === -1) { setProvenance(card, 'unresolved', missingColumnReason(c.y_col)); continue; }
          resolved = groupBy(rows, xIdx, yIdx, op === 'sum_by_group' ? 'sum' : 'mean');
        } else if (op === 'count_by_day' || op === 'timeseries') {
          if (xIdx === -1) { setProvenance(card, 'unresolved', missingColumnReason(c.x_col)); continue; }
          resolved = bucketDates(rows, xIdx, yIdx !== -1 ? yIdx : xIdx, 'count');
        } else if (op === 'top_n') {
          if (yIdx === -1) { setProvenance(card, 'unresolved', missingColumnReason(c.y_col)); continue; }
          const sorted = [...rows]
            .filter(r => !isNaN(parseNumeric(r[yIdx])))
            .sort((a, b) => parseNumeric(b[yIdx]) - parseNumeric(a[yIdx]))
            .slice(0, topN);
          resolved = {
            labels: sorted.map(r => String(xIdx !== -1 ? r[xIdx] : r[yIdx])),
            values: sorted.map(r => parseNumeric(r[yIdx])),
          };
        }

        if (!resolved || !resolved.labels || !resolved.labels.length) {
          setProvenance(card, 'unresolved',
            '"' + op + '" over the loaded rows produced no series, so there is nothing to plot.');
          continue;
        }
        // Trim to top_n / 10 entries
        const limit = topN || 10;
        const groupCount = resolved.labels.length;
        c.resolved_data = {
          labels: resolved.labels.slice(0, limit),
          values: resolved.values.slice(0, limit),
        };
        setProvenance(card, 'resolved', '',
          op + ' over ' + rows.length + ' rows'
          + (groupCount > limit ? ', showing the first ' + limit + ' of ' + groupCount + ' groups' : ''));

      } else if (card.kind === 'table') {
        const t  = card.table || {};
        const op = (t.query_op || 'top_n').toLowerCase();
        const cols = t.columns || [];
        if (!cols.length) {
          setProvenance(card, 'unresolved', 'The artifact named no columns for this table.'); continue;
        }
        if (TABLE_OPS.indexOf(op) === -1) {
          setProvenance(card, 'unresolved', unsupportedOpReason(op, TABLE_OPS)); continue;
        }
        // Match the requested columns against the loaded headers. An unmatched
        // column is dropped rather than rendered as a column of empty cells,
        // and is named in the note.
        const matched = [], missing = [];
        cols.forEach(function(name) {
          const i = getColIndex(headers, name);
          if (i === -1) missing.push(name); else matched.push({ name: headers[i], idx: i });
        });
        if (!matched.length) {
          setProvenance(card, 'unresolved',
            'None of the requested columns (' + cols.join(', ') + ') are in the loaded data.');
          continue;
        }
        const limit = parseInt(t.limit) || 10;
        const notes = [];
        if (missing.length) notes.push('columns not in the loaded data were dropped: ' + missing.join(', '));

        let filtered = rows;
        if (op === 'filter') {
          const fIdx = getColIndex(headers, t.filter_col);
          if (fIdx === -1) {
            setProvenance(card, 'unresolved',
              'Filter column "' + (t.filter_col || '') + '" is not in the loaded data, so no rows were selected.');
            continue;
          }
          const fVal = String(t.filter_val || '').toLowerCase();
          if (!fVal) {
            setProvenance(card, 'unresolved',
              'No filter value was supplied for column "' + headers[fIdx] + '", so no rows were selected.');
            continue;
          }
          filtered = rows.filter(r => String(r[fIdx] ?? '').toLowerCase().includes(fVal));
          notes.push(filtered.length + ' of ' + rows.length + ' rows matched the filter');
          filtered = filtered.slice(0, limit);
        } else {
          // top_n: sort by sort_col descending
          const sIdx = getColIndex(headers, t.sort_col);
          if (sIdx === -1) {
            notes.push('sort column "' + (t.sort_col || '') + '" is not in the loaded data, so rows are in file order');
          } else {
            filtered = [...rows].sort((a, b) => {
              const na = parseNumeric(a[sIdx]), nb = parseNumeric(b[sIdx]);
              if (!isNaN(na) && !isNaN(nb)) return nb - na;
              return String(b[sIdx] ?? '').localeCompare(String(a[sIdx] ?? ''));
            });
          }
          filtered = filtered.slice(0, limit);
        }

        t.resolved_columns = matched.map(mc => mc.name);
        t.resolved_rows = filtered.map(row => matched.map(mc => String(row[mc.idx] ?? '')));
        setProvenance(card, 'resolved', '',
          filtered.length + ' rows read locally from ' + rows.length
          + (notes.length ? ' — ' + notes.join('; ') : ''));

      } else if (card.kind === 'text' || card.kind === 'list') {
        // Model-authored prose. The model was given the schema and never the
        // rows, so nothing here was computed and it must not claim to be.
        setProvenance(card, 'unresolved',
          'Model-authored text. The model was given the schema only, never your data, so nothing here is computed from your rows.');

      } else {
        setProvenance(card, 'unresolved',
          'Card kind "' + String(card.kind) + '" has no local resolver, so nothing was computed.');
      }
    } catch (e) {
      // Never break the whole dashboard — and never present the card as computed.
      console.warn('[moke] resolveQueries error on card', card.id, e);
      setProvenance(card, 'unresolved',
        'The local resolver threw an error on this card: ' + (e && e.message ? e.message : 'unknown error') + '.');
    }
  }
  return ddlObj;
}

// ── Destroy Chart.js instances to avoid canvas reuse errors ───────────────
function destroyCharts() {
  Object.values(chartInstances).forEach(c => { try { c.destroy(); } catch(_) {} });
  chartInstances = {};
}

// ── Render a single metric card ────────────────────────────────────────────
// NC1.5/NC1.6: a number is rendered only for a card whose provenance says it was
// resolved locally, and '→ computed locally' is printed only on that same path.
function renderMetricCard(card) {
  const m = card.metric || {};
  const unit = m.unit || '';
  const displayLabel = String(m.resolved_label || m.label || card.title || '')
    .replace(/\s*\[.*?\]\s*$/, '');

  let shown = null;
  if (cardState(card) === 'resolved') {
    if (typeof m.resolved_value === 'number' && !isNaN(m.resolved_value)) {
      // Computed by resolveQueries from the loaded rows.
      shown = fmtMetricValue(m.resolved_value, unit);
    } else {
      // A locally computed handoff (Insight Lab) injects its value as 'label [v]'.
      const injected = String(m.label || '').match(/^(.*?)\s*\[(.+?)\]\s*$/);
      if (injected) shown = injected[2];
    }
  }

  if (shown === null) {
    // Covers a card marked resolved that carries no value: it is downgraded here
    // rather than rendered with a placeholder that reads as a computed result.
    if (cardState(card) === 'resolved') {
      setProvenance(card, 'unresolved',
        'This card carries no locally computed value, so no number is shown.');
    }
    return `<div class="card-label">${esc(displayLabel)}</div>
      <div class="metric-value unresolved">—</div>
      ${renderStateBlock(card)}`;
  }

  const note = cardNote(card);
  return `<div class="card-label">${esc(displayLabel)}</div>
    <div class="metric-value">${esc(shown)}<span class="metric-unit">${esc(unit)}</span></div>
    <div class="metric-delta flat">&#x2192; computed locally${note ? ' · ' + esc(note) : ''}</div>`;
}

// ── Render a chart card (Chart.js) ─────────────────────────────────────────
// NC1.5: no canvas is emitted unless there is a locally computed series to plot,
// so there is nothing for a fabricated series to be drawn into.
function renderChartCard(card) {
  const c = card.chart || {};
  if (cardState(card) !== 'resolved' || !chartHasLocalData(c)) {
    if (cardState(card) === 'resolved') {
      setProvenance(card, 'unresolved',
        'No locally computed series is attached to this chart, so nothing is plotted.');
    }
    return `<div class="card-label">${esc(card.title)}</div>
      ${renderStateBlock(card)}`;
  }
  const cid = 'canvas-' + card.id;
  const note = cardNote(card);
  return `<div class="card-label">${esc(card.title)}</div>
    <div class="chart-wrap"><canvas id="${esc(cid)}"></canvas></div>
    <div class="card-state-note">&#x2192; computed locally${note ? ' · ' + esc(note) : ''}</div>`;
}

// Mount Chart.js after DOM insertion
function mountChart(card) {
  const c = card.chart || {};
  // NC1.5/NC1.6: only a locally resolved card is ever plotted.
  if (cardState(card) !== 'resolved' || !chartHasLocalData(c)) return;
  const cid = 'canvas-' + card.id;
  const canvas = document.getElementById(cid);
  if (!canvas || typeof Chart === 'undefined') return;

  const chartType = c.chart_type || 'bar';
  const jsType = chartType === 'area' ? 'line' : chartType;

  const xLabel = c.x_col || 'Category';
  const yLabel = c.y_col || 'Value';

  // ── Scatter chart with cluster data (from ML handoff) ──────────────────
  if (jsType === 'scatter' && c.data && c.data.length) {
    const k = c.k || 4;
    // Partition points by cluster
    const byCluster = {};
    c.data.forEach(pt => {
      const cl = pt.cluster !== undefined ? pt.cluster : 0;
      if (!byCluster[cl]) byCluster[cl] = [];
      byCluster[cl].push({ x: pt.x, y: pt.y });
    });
    const datasets = Object.keys(byCluster).map(cl => ({
      label: 'Cluster ' + (parseInt(cl) + 1),
      data: byCluster[cl],
      backgroundColor: PALETTE[parseInt(cl) % PALETTE.length],
      borderColor:     PALETTE_BORDER[parseInt(cl) % PALETTE_BORDER.length],
      pointRadius: 4,
      pointHoverRadius: 6,
    }));
    chartInstances[card.id] = new Chart(canvas, {
      type: 'scatter',
      data: { datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 400 },
        plugins: {
          legend: { display: true, labels: { color: '#6b7280', font: { size: 11 } } },
          tooltip: { callbacks: {
            label: ctx => `Cluster ${ctx.datasetIndex + 1}: (${ctx.parsed.x.toFixed(1)}, ${ctx.parsed.y.toFixed(1)})`
          }},
        },
        scales: {
          x: {
            ticks: { color: '#6b7280', font: { size: 11 } },
            grid:  { color: 'rgba(42,45,58,0.6)' },
            title: { display: true, text: xLabel, color: '#6b7280', font: { size: 11 } },
          },
          y: {
            ticks: { color: '#6b7280', font: { size: 11 } },
            grid:  { color: 'rgba(42,45,58,0.6)' },
            title: { display: true, text: yLabel, color: '#6b7280', font: { size: 11 } },
          },
        },
      },
    });
    return;
  }

  // NC1.5: the only series that can be plotted is the one Phase 2 computed here.
  // There is no fabricated fallback, and an unresolved card never reaches this point.
  if (!c.resolved_data || !c.resolved_data.labels || !c.resolved_data.labels.length) return;
  const chartLabels = c.resolved_data.labels;
  const chartData   = c.resolved_data.values;

  const isPie = jsType === 'pie' || jsType === 'doughnut';
  const isBar = jsType === 'bar';
  const useSemanticColours = isPie || isBar;

  // MK4.8.7: Build per-label colour arrays for bar and pie charts
  var bgColours, borderColours;
  if (useSemanticColours) {
    // Check for DDL-nominated colours per series
    var ddlColours = (c.colours || c.colors || null);  // { "failed": "red", ... } or array
    bgColours = chartLabels.map(function(label, idx) {
      // Priority 1: DDL colour field
      if (ddlColours) {
        var ddlVal = null;
        if (Array.isArray(ddlColours) && ddlColours[idx]) {
          ddlVal = ddlColours[idx];
        } else if (typeof ddlColours === 'object' && ddlColours[label]) {
          ddlVal = ddlColours[label];
        }
        if (ddlVal && DDL_COLOUR_MAP[ddlVal.toLowerCase()]) {
          return DDL_COLOUR_MAP[ddlVal.toLowerCase()];
        }
        if (ddlVal && ddlVal.match(/^rgba?\(/)) return ddlVal;
      }
      // Priority 2: semantic colour from label
      var sc = semanticColour(label);
      if (sc) return sc;
      // Priority 3: default palette
      return PALETTE[idx % PALETTE.length];
    });
    borderColours = bgColours.map(function(c) { return c.replace(/[\d.]+\)$/, '1)'); });
  } else {
    bgColours = PALETTE[0];
    borderColours = PALETTE_BORDER[0];
  }

  const dataset = {
    label: yLabel,
    data: chartData,
    backgroundColor: bgColours,
    borderColor:     borderColours,
    borderWidth: 1,
    fill: chartType === 'area',
    tension: 0.35,
    pointRadius: jsType === 'line' ? 3 : 0,
  };

  chartInstances[card.id] = new Chart(canvas, {
    type: jsType,
    data: { labels: chartLabels, datasets: [dataset] },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 400 },
      plugins: {
        legend: { display: isPie, labels: { color: '#6b7280', font: { size: 11 } } },
        tooltip: { mode: 'index', intersect: false },
      },
      scales: isPie ? {} : {
        x: {
          ticks: { color: '#6b7280', font: { size: 11 } },
          grid:  { color: 'rgba(42,45,58,0.6)' },
          title: { display: true, text: xLabel, color: '#6b7280', font: { size: 11 } },
        },
        y: {
          ticks: { color: '#6b7280', font: { size: 11 } },
          grid:  { color: 'rgba(42,45,58,0.6)' },
          title: { display: true, text: yLabel, color: '#6b7280', font: { size: 11 } },
        },
      },
    },
  });
}

// ── Render a table card ────────────────────────────────────────────────────
function renderTableCard(card) {
  const t = card.table || {};
  const state = cardState(card);
  // Only the columns actually matched against the loaded data are shown, so an
  // unmatched column cannot appear as a column of blank cells.
  const cols = (state === 'resolved' && t.resolved_columns && t.resolved_columns.length)
    ? t.resolved_columns
    : (t.columns || []);
  sortState[card.id] = sortState[card.id] || { col: t.sort_col || cols[0] || '', asc: false };
  const heatmapCol = t.heatmap_col || null;  // column name to colour-code by value

  let th = cols.map(col => {
    const sorted = sortState[card.id].col === col;
    const cls = sorted ? (sortState[card.id].asc ? 'sorted-asc' : 'sorted-desc') : '';
    return `<th class="${esc(cls)}" onclick="tableSort('${esc(card.id)}','${esc(col)}')">${esc(col)}<span class="sort-arrow"></span></th>`;
  }).join('');

  // NC1.5/NC1.6: an unresolved or no-data table shows its requested columns and
  // the reason, and no rows at all. The old em-dash placeholder rows are gone —
  // they read as 'the data is here and empty', which was not true.
  if (state !== 'resolved') {
    return `<div class="card-label">${esc(card.title)}</div>
      ${renderStateBlock(card)}
      <table class="dash-table" id="table-${esc(card.id)}">
        <thead><tr>${th}</tr></thead>
        <tbody id="tbody-${esc(card.id)}"></tbody>
      </table>`;
  }

  // Resolved: rows came either from Phase 2 (arrays) or from the locally
  // computed Insight Lab handoff (objects).
  let tbody;
  if (t.resolved_rows && t.resolved_rows.length) {
    // Array of arrays from Phase 2 resolveQueries
    tbody = t.resolved_rows.map(row => {
      const cells = row.map(cell => `<td>${esc(cell)}</td>`).join('');
      return `<tr>${cells}</tr>`;
    }).join('');
  } else if (t.rows && t.rows.length) {
    // Array of objects from ML DDL handoff — apply heatmap colouring if requested
    tbody = t.rows.map(rowObj => {
      const cells = cols.map(col => {
        const val = rowObj[col] !== undefined ? rowObj[col] : '';
        if (heatmapCol && col === heatmapCol) {
          const num = parseFloat(val);
          if (!isNaN(num)) {
            const abs = Math.abs(num);
            const hue = num >= 0 ? Math.round(120 * Math.min(abs, 1)) : 0;
            const alpha = (abs * 0.5 + 0.08).toFixed(2);
            const bg = `hsla(${hue},60%,40%,${alpha})`;
            return `<td style="background:${bg};font-family:monospace;text-align:right">${esc(String(val))}</td>`;
          }
        }
        return `<td>${esc(String(val))}</td>`;
      }).join('');
      return `<tr>${cells}</tr>`;
    }).join('');
  } else {
    // Marked resolved but carrying nothing to show — downgrade rather than
    // invent placeholder rows.
    setProvenance(card, 'unresolved',
      'This table carries no locally computed rows, so none are shown.');
    return `<div class="card-label">${esc(card.title)}</div>
      ${renderStateBlock(card)}
      <table class="dash-table" id="table-${esc(card.id)}">
        <thead><tr>${th}</tr></thead>
        <tbody id="tbody-${esc(card.id)}"></tbody>
      </table>`;
  }

  const note = cardNote(card);
  return `<div class="card-label">${esc(card.title)}</div>
    <table class="dash-table" id="table-${esc(card.id)}">
      <thead><tr>${th}</tr></thead>
      <tbody id="tbody-${esc(card.id)}">${tbody}</tbody>
    </table>
    <div class="card-state-note">&#x2192; computed locally${note ? ' · ' + esc(note) : ''}</div>`;
}

function tableSort(cardId, col) {
  const st = sortState[cardId] || { col, asc: false };
  if (st.col === col) { st.asc = !st.asc; } else { st.col = col; st.asc = true; }
  sortState[cardId] = st;
  // Re-render header indicators only (row data comes from phase2 in full impl)
  const table = document.getElementById('table-' + cardId);
  if (!table) return;
  table.querySelectorAll('th').forEach(th => {
    th.classList.remove('sorted-asc','sorted-desc');
    if (th.textContent.trim().startsWith(col)) {
      th.classList.add(st.asc ? 'sorted-asc' : 'sorted-desc');
    }
  });
}

// ── Render a text card ─────────────────────────────────────────────────────
// NC1.6: prose is model-authored, never locally computed, and is labelled so.
function renderTextCard(card) {
  const md = (card.text && card.text.markdown) ? card.text.markdown : '';
  return `${renderStateBlock(card)}
    <div class="text-content">${renderMarkdown(md)}</div>`;
}

// ── Render a list card ─────────────────────────────────────────────────────
// NC1.6: list items are model-authored, never locally computed.
function renderListCard(card) {
  const li = (card.list && card.list.items) ? card.list.items : [];
  const title = (card.list && card.list.title) ? card.list.title : card.title;
  const items = li.map(item => `<li><span class="list-bullet"></span>${esc(item)}</li>`).join('');
  return `<div class="card-label">${esc(title)}</div>
    ${renderStateBlock(card)}
    <ul class="list-items">${items}</ul>`;
}

// ── Render full dashboard DDL into DOM ─────────────────────────────────────
function renderDashboard(ddlObj) {
  currentDDL = ddlObj;
  destroyCharts();

  const grid = document.getElementById('dash-grid');
  grid.innerHTML = '';
  document.getElementById('empty-dash').classList.remove('visible');

  const cards = ddlObj.cards || [];
  const chartCards = [];

  cards.forEach(card => {
    const colSpan = Math.min(Math.max(parseInt(card.col_span) || 1, 1), 3);
    const el = document.createElement('div');
    el.className = `dash-card col-${colSpan}`;
    el.id = 'dc-' + card.id;

    let html;
    switch (card.kind) {
      case 'metric': html = renderMetricCard(card); break;
      case 'chart':  html = renderChartCard(card);  break;
      case 'table':  html = renderTableCard(card);  break;
      case 'text':   html = renderTextCard(card);   break;
      case 'list':   html = renderListCard(card);   break;
      default:
        html = `<div class="card-label">${esc(card.kind)}</div>
          <p style="font-size:0.85em;color:var(--muted)">${esc(card.title)}</p>
          ${renderStateBlock(card)}`;
    }
    el.innerHTML = html;
    // A renderer may downgrade a card's state, so the class is applied afterwards.
    const state = cardState(card);
    if (state !== 'resolved') el.classList.add('state-' + state);
    // Mount a chart only where a canvas was actually emitted.
    if (card.kind === 'chart' && el.querySelector('canvas')) chartCards.push(card);
    grid.appendChild(el);
  });

  // Mount Chart.js after all DOM nodes exist
  chartCards.forEach(card => mountChart(card));

  // Update UI state
  const tsEl = document.getElementById('dash-generated-at');
  tsEl.textContent = 'Generated ' + new Date().toLocaleTimeString();
  document.getElementById('btn-export-ddl').disabled = false;
  document.getElementById('btn-export-png').disabled = false;
  document.getElementById('btn-present').disabled = false;
  document.getElementById('refine-row').classList.add('visible');
  // MK4.8.5 — Show export bar
  var exportBar = document.getElementById('export-bar');
  if (exportBar) exportBar.style.display = 'flex';
}

// ── Generate dashboard (phase 1 → 2 → 3) ─────────────────────────────────
async function generateDashboard() {
  const question = document.getElementById('dash-prompt').value.trim();
  if (!question) return;

  clearError();
  phaseStart();
  phaseRun('ph1');
  setBusy(true);

  let ddlObj = null;

  try {
    // Phase 1 — ask the model to design the dashboard. NC1.4: it is given a
    // schema profile (names, types, cardinality, null rate, row count) and no
    // data values, so it can reference real columns instead of guessing them.
    const schemaProfileText = formatSchemaProfile(buildSchemaProfile(readActiveDataset()));
    const rid = 'dash-' + Date.now();
    var LOKE_URL = window.LOKE_URL || 'http://127.0.0.1:11430';
    const res = await fetch(LOKE_URL + '/api/pipeline', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: buildPhase1Prompt(question, schemaProfileText),
        system_prompt: DASHBOARD_SYSTEM_PROMPT,
        tolerance: 'patient',
        mode: 'dashboard',
        request_id: rid,
      }),
    });
    const data = await res.json();
    phaseDone('ph1');

    if (!data.ok) { showError('Phase 1 error: ' + (data.error || 'unknown')); phaseReset(); setBusy(false); return; }

    // Extract response text — handle Anthropic raw format
    var llmText = data.response || '';
    if (data.anthropic_raw && data.anthropic_raw.content) {
      llmText = data.anthropic_raw.content.map(function(c) { return c.text || ''; }).join('');
    }

    // Extract DDL from LLM response text
    ddlObj = extractJSON(llmText);
    if (!ddlObj) {
      showError('Phase 1: LLM did not return a valid JSON dashboard. Try rephrasing your question.');
      phaseReset(); setBusy(false); return;
    }

    // Normalise: if the model returned { charts: [...] } convert to { cards: [...] }
    ddlObj = normaliseDDL(ddlObj);

    // Phase 2 — local compute. Anything the model may have invented is stripped
    // first, and the phase indicator reports what actually ran.
    phaseRun('ph2');
    const report = applyLocalResolution(ddlObj);
    ddlObj = report.ddl;
    reportPhase2(report);

    // Phase 3 — render
    phaseRun('ph3');
    await new Promise(r => setTimeout(r, 200));
    renderDashboard(ddlObj);
    phaseDone('ph3');

  } catch (err) {
    showError('Dashboard generation failed: ' + err.message);
    phaseReset();
  }

  setBusy(false);
}

// ── Refine dashboard ───────────────────────────────────────────────────────
async function refineDashboard() {
  if (!currentDDL) return;
  const instruction = document.getElementById('refine-prompt').value.trim();
  if (!instruction) return;

  clearError();
  phaseStart();
  phaseRun('ph1');
  setBusy(true);

  try {
    // The current DDL carries locally computed values — including, for table
    // cards, whole rows of the loaded data. None of that may go to a provider,
    // so the artifact is stripped back to its column references and operations
    // before it leaves the device.
    const skeleton = stripUnverifiedValues(JSON.parse(JSON.stringify(currentDDL)));
    const currentJSON = JSON.stringify(skeleton);
    const schemaProfileText = formatSchemaProfile(buildSchemaProfile(readActiveDataset()));
    const prompt = `Refine this dashboard specification: ${currentJSON}\n\nInstruction: ${instruction}\n\n`
      + (schemaProfileText
          ? `The dataset stays on the user's device. This is its schema profile, which contains no data values:\n${schemaProfileText}\n\n`
          : `No dataset is loaded on the user's device, so no schema profile is available.\n\n`)
      + `Return ONLY the updated JSON object. Reference columns and operations only, never values, because every value is computed locally.`;
    var LOKE_URL = window.LOKE_URL || 'http://127.0.0.1:11430';
    const res = await fetch(LOKE_URL + '/api/pipeline', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: prompt,
        system_prompt: DASHBOARD_SYSTEM_PROMPT,
        tolerance: 'patient',
        mode: 'dashboard',
      }),
    });
    const data = await res.json();
    phaseDone('ph1');
    if (!data.ok) { showError('Refine error: ' + (data.error || 'unknown')); phaseReset(); setBusy(false); return; }

    // Extract response text — handle Anthropic raw format
    var refineLlmText = data.response || '';
    if (data.anthropic_raw && data.anthropic_raw.content) {
      refineLlmText = data.anthropic_raw.content.map(function(c) { return c.text || ''; }).join('');
    }

    let ddlObj = extractJSON(refineLlmText);
    if (!ddlObj) { showError('Refine: LLM did not return valid JSON. Try a different instruction.'); phaseReset(); setBusy(false); return; }

    // Normalise: if LLM returned { charts: [...] } convert to { cards: [...] }
    ddlObj = normaliseDDL(ddlObj);

    phaseRun('ph2');
    const refineReport = applyLocalResolution(ddlObj);
    ddlObj = refineReport.ddl;
    reportPhase2(refineReport);

    phaseRun('ph3');
    await new Promise(r => setTimeout(r, 150));
    renderDashboard(ddlObj);
    phaseDone('ph3');
    document.getElementById('refine-prompt').value = '';

  } catch (err) {
    showError('Refine failed: ' + err.message);
    phaseReset();
  }

  setBusy(false);
}

// ── Build prompt (mirrors server-side build_phase1_prompt) ─────────────────
// NC1.4b: the instruction to invent sample values is gone. The model is told
// what it is actually being given, and that values are not its job.
const DASHBOARD_SYSTEM_PROMPT = 'You are a dashboard design assistant. '
  + 'You are given a schema profile of a dataset that stays on the user\'s device: column names, '
  + 'inferred types, distinct-value counts, null rates and a row count. You are not given any data '
  + 'value, and you must not invent one. '
  + 'Return ONLY a valid JSON object (no markdown fences, no explanation) describing which columns to '
  + 'read and which operation to apply to them. Every card must reference columns by their exact names '
  + 'from the schema profile. Do not include a data array, sample rows, example figures, or any number '
  + 'presented as a result: every value is computed locally from the data on the device, and any value '
  + 'you supply is discarded before rendering.';

// NC1.4: the schema profile is passed in and described for what it is. The old
// 'You have access to this dataset' framing is gone — it was not true, and it
// left the model guessing column names.
function buildPhase1Prompt(question, schemaProfileText) {
  const given = schemaProfileText
    ? `The dataset itself stays on the user's device. You are given only its schema profile, which contains no data values:

${schemaProfileText}
`
    : `No dataset is loaded on the user's device, so there is no schema profile and no column names to work from. Design the cards from the question alone; every card will be shown to the user as "no data loaded" until a dataset is loaded.
`;

  return `${given}
User asks: ${question}

Design a dashboard as a JSON DDL object with the following top-level fields:
  title (string), summary (string), cards (array).

Each card must have:
  id (unique string), kind (one of: metric, chart, table, text, list),
  title (string), col_span (integer 1-3).

For metric cards include a 'metric' object with: label, query_op, query_col, unit.
  query_op must be one of: count, sum, mean, min, max.
For chart cards include a 'chart' object with: chart_type (line/bar/pie/area/scatter), x_col, y_col, query_op, top_n.
  query_op must be one of: count_by_group, sum_by_group, mean_by_group, count_by_day, timeseries, top_n.
For table cards include a 'table' object with: columns (string array), query_op, sort_col, limit.
  query_op must be one of: top_n, filter. For filter also give filter_col and filter_val.

Every column you name must appear verbatim in the schema profile above. A name that
does not match is reported to the user as unresolved, and that card shows no value.
Return only column references and operations. Never return values, sample rows or
example figures: every value is computed locally from the data on the device.

Respond with ONLY the JSON object, no explanation.`;
}

// ── Disable/enable controls during async ops ───────────────────────────────
function setBusy(busy) {
  ['btn-generate','btn-refine','btn-export-ddl','btn-export-png'].forEach(id => {
    const el = document.getElementById(id);
    if (el && id !== 'btn-export-ddl' && id !== 'btn-export-png') el.disabled = busy;
  });
}

// ── Export DDL as JSON file ────────────────────────────────────────────────
function exportDDL() {
  if (!currentDDL) return;
  const blob = new Blob([JSON.stringify(currentDDL, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'dashboard-' + Date.now() + '.ddl.json';
  a.click();
}

// ── Export PNG via html2canvas (falls back to alert if unavailable) ────────
function exportPNG() {
  var grid = document.getElementById('dash-grid');
  if (!grid || typeof html2canvas === 'undefined') { alert('Dashboard not rendered or html2canvas not loaded'); return; }
  html2canvas(grid, { backgroundColor: '#0d1117' }).then(function(canvas) {
    var a = document.createElement('a');
    a.download = 'moke-dashboard-' + Date.now() + '.png';
    a.href = canvas.toDataURL('image/png');
    a.click();
  });
}

// ── MK4.8.5 Export JSON ────────────────────────────────────────────────────
function exportJSON() {
  if (!currentDDL) { alert('No dashboard to export'); return; }
  var blob = new Blob([JSON.stringify(currentDDL, null, 2)], { type: 'application/json' });
  var a = document.createElement('a');
  a.download = 'moke-dashboard-' + Date.now() + '.json';
  a.href = URL.createObjectURL(blob);
  a.click();
}

// ── Launch presentation mode ───────────────────────────────────────────────
function presentDashboard() {
  if (!currentDDL) return;
  try {
    sessionStorage.setItem('moke_dashboard_ddl', JSON.stringify(currentDDL));
  } catch (e) {
    alert('Could not save dashboard to sessionStorage: ' + e.message);
    return;
  }
  window.location.href = '/presentation';
}

// ── Load Customer Intelligence demo dashboard ──────────────────────────────
function loadDemo() {
  const demo = {
    title: "Customer Intelligence",
    summary: "Key customer metrics, lifetime value distribution, order trends, and top-performer ranking",
    cards: [
      {
        id: "m-total-customers", kind: "metric", title: "Total Customers", col_span: 1,
        metric: { label: "Total Customers", query_op: "count", query_col: "customer_id", unit: "", delta_query_op: "count_prev_period" }
      },
      {
        id: "m-avg-ltv", kind: "metric", title: "Avg LTV", col_span: 1,
        metric: { label: "Avg LTV", query_op: "mean", query_col: "lifetime_value", unit: "$", delta_query_op: "mean_prev_period" }
      },
      {
        id: "m-churn", kind: "metric", title: "Churn Rate", col_span: 1,
        metric: { label: "Churn Rate", query_op: "mean", query_col: "churned", unit: "%", delta_query_op: "mean_prev_period" }
      },
      {
        id: "m-avg-order", kind: "metric", title: "Avg Order Value", col_span: 1,
        metric: { label: "Avg Order Value", query_op: "mean", query_col: "order_value", unit: "$", delta_query_op: "mean_prev_period" }
      },
      {
        id: "c-ltv-cluster", kind: "chart", title: "LTV by Cluster", col_span: 2,
        chart: { title: "LTV by Cluster", chart_type: "bar", x_col: "cluster", y_col: "lifetime_value", query_op: "mean_by_group", filter_col: "", filter_val: "", top_n: 10 }
      },
      {
        id: "c-orders-time", kind: "chart", title: "Orders over Time", col_span: 2,
        chart: { title: "Orders over Time", chart_type: "line", x_col: "order_date", y_col: "order_count", query_op: "count_by_day", filter_col: "", filter_val: "", top_n: 0 }
      },
      {
        id: "t-top-customers", kind: "table", title: "Top 10 Customers by LTV", col_span: 3,
        table: { title: "Top 10 Customers by LTV", columns: ["customer_id","name","cluster","lifetime_value","order_count","last_order_date"], query_op: "top_n", sort_col: "lifetime_value", limit: 10 }
      }
    ]
  };
  // The demo is a specification of cards, not a set of figures: it carries no
  // values, and resolves against whatever dataset is loaded — or reports
  // no-data on every card when there is none.
  renderDashboard(applyLocalResolution(demo).ddl);
}

// ── MK2.4: Auto-load ML result from Insight Lab handoff ────────────────────
(function autoLoadMLResult() {
  let raw = null;
  try { raw = sessionStorage.getItem('moke_dashboard_ddl'); } catch(_) {}
  if (!raw) return;
  let ddl = null;
  try { ddl = JSON.parse(raw); } catch(_) { return; }
  // Consume the key so refresh doesn't re-load stale ML data
  try { sessionStorage.removeItem('moke_dashboard_ddl'); } catch(_) {}
  // NC1.6: this handoff was computed in this browser, so its cards are marked
  // resolved — and any card that arrived without a computed value is not.
  markLocalHandoff(ddl);
  // Defer rendering so the DOM (including Chart.js script) is ready
  setTimeout(function() {
    renderDashboard(ddl);
  }, 0);
})();

// ── MK4.8.6: Dashboard template persistence (save/load configurations) ────
// Templates stored as JSON array in localStorage:
//   [{name, ddl, datasetId, createdAt, updatedAt?}, ...]

function populateTemplateSelect() {
  var sel = document.getElementById('template-select');
  if (!sel) return;
  var templates = JSON.parse(localStorage.getItem('moke_dashboard_templates') || '[]');
  sel.innerHTML = '<option value="">— load saved template —</option>';
  templates.forEach(function(t) {
    var opt = document.createElement('option');
    opt.value = t.name;
    opt.textContent = t.name + (t.datasetId ? ' (' + t.datasetId + ')' : '');
    sel.appendChild(opt);
  });
}

window.saveTemplate = function() {
  if (!currentDDL) { alert('No dashboard to save'); return; }
  var name = prompt('Template name:');
  if (!name || !name.trim()) return;
  name = name.trim();
  var templates = JSON.parse(localStorage.getItem('moke_dashboard_templates') || '[]');
  // Check for duplicate name
  var existing = templates.findIndex(function(t) { return t.name === name; });
  if (existing >= 0) {
    if (!confirm('Template "' + name + '" exists. Overwrite?')) return;
    templates[existing].ddl = JSON.parse(JSON.stringify(currentDDL));
    templates[existing].updatedAt = Date.now();
  } else {
    var dataset = null;
    try { dataset = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch(_) {}
    templates.push({
      name: name,
      ddl: JSON.parse(JSON.stringify(currentDDL)),
      datasetId: dataset ? (dataset.id || null) : null,
      createdAt: Date.now()
    });
  }
  localStorage.setItem('moke_dashboard_templates', JSON.stringify(templates));
  populateTemplateSelect();
  alert('Template saved: ' + name);
};

window.loadTemplate = function() {
  var sel = document.getElementById('template-select');
  if (!sel || !sel.value) return;
  var templates = JSON.parse(localStorage.getItem('moke_dashboard_templates') || '[]');
  var tmpl = templates.find(function(t) { return t.name === sel.value; });
  if (!tmpl) return;
  // A saved template's stored values were computed in an earlier session, possibly
  // against a different dataset, so they are stripped and recomputed here. A
  // template can never show a figure this session did not compute.
  currentDDL = applyLocalResolution(JSON.parse(JSON.stringify(tmpl.ddl))).ddl;
  renderDashboard(currentDDL);
};

window.deleteTemplate = function() {
  var sel = document.getElementById('template-select');
  if (!sel || !sel.value) return;
  if (!confirm('Delete template "' + sel.value + '"?')) return;
  var templates = JSON.parse(localStorage.getItem('moke_dashboard_templates') || '[]');
  templates = templates.filter(function(t) { return t.name !== sel.value; });
  localStorage.setItem('moke_dashboard_templates', JSON.stringify(templates));
  populateTemplateSelect();
};

// ── Populate dataset-specific prompt chips ──────────────────────────────────
function populateDashChips() {
  var chipsContainer = document.getElementById('dash-chips');
  if (!chipsContainer) return;
  var dataset = null;
  try { dataset = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch(_) {}
  var dsId = dataset ? (dataset.id || '') : '';
  var prompts = DASH_PROMPTS[dsId];
  if (!prompts) {
    // Try partial match on dataset id
    var keys = Object.keys(DASH_PROMPTS);
    for (var i = 0; i < keys.length; i++) {
      if (dsId.indexOf(keys[i]) !== -1 || keys[i].indexOf(dsId) !== -1) {
        prompts = DASH_PROMPTS[keys[i]]; break;
      }
    }
  }
  if (!prompts || !prompts.length) { chipsContainer.style.display = 'none'; return; }
  // Remove old chip buttons
  var old = chipsContainer.querySelectorAll('.dash-chip');
  for (var j = 0; j < old.length; j++) old[j].remove();
  // Add new chips
  prompts.forEach(function(text) {
    var btn = document.createElement('button');
    btn.className = 'dash-chip';
    btn.textContent = text;
    btn.onclick = function() { useDashPrompt(text); };
    chipsContainer.appendChild(btn);
  });
  chipsContainer.style.display = 'flex';
}

function useDashPrompt(text) {
  var input = document.getElementById('dash-prompt');
  if (input) { input.value = text; input.focus(); }
}
window.useDashPrompt = useDashPrompt;

// Init — populate template selector and prompt chips on load
populateTemplateSelect();
populateDashChips();

// ── Expose to global scope for inline onkeydown/onclick handlers ──────────
window.generateDashboard = generateDashboard;
window.refineDashboard   = refineDashboard;
window.exportDDL         = exportDDL;
window.exportPNG         = exportPNG;
window.exportJSON        = exportJSON;
window.presentDashboard  = presentDashboard;
window.loadDemo          = loadDemo;
window.tableSort         = tableSort;

})();
</script>

{! end !}

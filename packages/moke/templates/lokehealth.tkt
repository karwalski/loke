<script>
(function(){
  var result = {ok:false, version:"0.3.0", ollama:"offline"};

  Promise.all([
    fetch("http://127.0.0.1:11430/", {mode:"cors",cache:"no-store"}).then(function(){result.ok=true}).catch(function(){}),
    fetch("http://localhost:11434/api/version", {cache:"no-store"}).then(function(r){return r.json()}).then(function(){result.ollama="running"}).catch(function(){})
  ]).then(function(){
    document.body.textContent = JSON.stringify(result);
  });
})();
</script>
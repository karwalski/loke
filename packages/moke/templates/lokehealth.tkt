<script>
(function(){
  // BG1.4: '' is a real value, moke's own origin, so it is read with ??, not ||. This page has
  // no base layout, so it is normally undefined and loke's own address is used. It asks
  // /api/health and judges the status, not "/": on moke's own origin "/" is moke's home page,
  // which answers whether loke is up or not, while moke's /api/health answers 503 without loke.
  var LOKE_URL = window.LOKE_URL ?? 'http://127.0.0.1:11430';
  var result = {ok:false, version:"0.2.0", ollama:"offline"};

  Promise.all([
    fetch(LOKE_URL + "/api/health", {cache:"no-store"}).then(function(r){result.ok=r.ok}).catch(function(){}),
    fetch("http://localhost:11434/api/version", {cache:"no-store"}).then(function(r){return r.json()}).then(function(){result.ollama="running"}).catch(function(){})
  ]).then(function(){
    document.body.textContent = JSON.stringify(result);
  });
})();
</script>
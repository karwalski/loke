{! layout("base") !}
{! block("title") !}moke — MCP Integration{! end !}
{! block("content") !}

<style>
  /* ── MCP page styles ─────────────────────────────────────────────────────── */
  .mcp-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; flex-wrap: wrap; }
  .mcp-header h1 { font-size: 1.4em; font-weight: 700; letter-spacing: -0.02em; flex: 1; }

  .mcp-tabs { display: flex; gap: 2px; margin-bottom: 20px; border-bottom: 1px solid var(--border); }
  .mcp-tab {
    padding: 10px 18px; font-size: 0.85em; font-weight: 600; color: var(--muted);
    cursor: pointer; border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s;
    background: none; border-top: none; border-left: none; border-right: none;
  }
  .mcp-tab:hover { color: var(--text); }
  .mcp-tab.active { color: var(--teal); border-bottom-color: var(--teal); }

  .mcp-panel { display: none; }
  .mcp-panel.active { display: block; }

  /* ── Tool cards ──────────────────────────────────────────────────────────── */
  .tool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; margin-bottom: 20px; }
  .tool-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 16px 20px; transition: border-color 0.15s;
  }
  .tool-card:hover { border-color: var(--teal); }
  .tool-card .tool-top { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .tool-card .tool-name { font-weight: 600; font-size: 0.95em; }
  .tool-card .tool-desc { font-size: 0.82em; color: var(--muted); margin-bottom: 12px; }
  .tool-card .tool-actions { display: flex; gap: 8px; }

  /* ── Broker servers ──────────────────────────────────────────────────────── */
  .server-list { list-style: none; padding: 0; }
  .server-item {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 16px 20px; margin-bottom: 12px;
  }
  .server-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .server-name { font-weight: 600; font-size: 0.95em; flex: 1; }
  .server-meta { font-size: 0.82em; color: var(--muted); display: flex; gap: 12px; flex-wrap: wrap; }
  .server-tools { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }

  /* ── Invocation console ──────────────────────────────────────────────────── */
  .console-box {
    background: #0a0c10; border: 1px solid var(--border); border-radius: 8px;
    padding: 14px 16px; max-height: 400px; overflow-y: auto; font-family: monospace;
    font-size: 0.82em; line-height: 1.7;
  }
  .console-entry { padding: 4px 0; border-bottom: 1px solid rgba(48,54,61,0.5); }
  .console-entry:last-child { border-bottom: none; }
  .console-tool { color: var(--teal); font-weight: 600; }
  .console-ok { color: var(--green); }
  .console-err { color: var(--red); }
  .console-time { color: var(--muted); }

  /* ── Invoke modal ────────────────────────────────────────────────────────── */
  .invoke-modal {
    display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.6); z-index: 300; align-items: center; justify-content: center;
  }
  .invoke-modal.visible { display: flex; }
  .invoke-modal-inner {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    padding: 24px; width: 500px; max-width: 90vw; max-height: 80vh; overflow-y: auto;
  }
  .invoke-modal h3 { font-size: 1.1em; font-weight: 700; margin-bottom: 14px; }
  .invoke-modal textarea {
    width: 100%; height: 120px; background: var(--bg); border: 1px solid var(--border);
    border-radius: 7px; color: var(--text); font-family: monospace; font-size: 0.85em;
    padding: 10px; resize: vertical;
  }
  .invoke-modal .modal-actions { display: flex; gap: 8px; margin-top: 14px; justify-content: flex-end; }

  .btn {
    font-size: 0.8em; font-weight: 600; padding: 6px 14px; border-radius: 6px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text);
    cursor: pointer; transition: border-color 0.15s, background 0.15s;
  }
  .btn:hover { border-color: var(--teal); }
  .btn-primary { background: var(--teal); border-color: var(--teal); color: #0d1117; }
  .btn-sm { font-size: 0.75em; padding: 4px 10px; }

  .broker-summary { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .broker-stat {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 14px 18px; min-width: 120px; flex: 1;
  }
  .broker-stat .stat-label { font-size: 0.72em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 4px; }
  .broker-stat .stat-value { font-size: 1.6em; font-weight: 700; }
</style>

<div class="mcp-header">
  <h1>MCP Integration</h1>
</div>

<div class="mcp-tabs">
  <button class="mcp-tab active" data-tab="tools" onclick="switchTab('tools')">Tools</button>
  <button class="mcp-tab" data-tab="broker" onclick="switchTab('broker')">Broker Status</button>
  <button class="mcp-tab" data-tab="memory" onclick="switchTab('memory')">Memory MCP</button>
</div>

<!-- ── Tools Panel ─────────────────────────────────────────────────────────── -->
<div class="mcp-panel active" id="panel-tools">
  <div class="tool-grid" id="tool-grid"></div>
  <h3 style="font-size:0.9em;margin-bottom:10px;color:var(--muted)">Invocation Console</h3>
  <div class="console-box" id="tool-console">
    <div class="console-entry" style="color:var(--muted)">No invocations yet. Click "Invoke" on a tool to try it.</div>
  </div>
</div>

<!-- ── Broker Panel ────────────────────────────────────────────────────────── -->
<div class="mcp-panel" id="panel-broker">
  <div class="broker-summary" id="broker-summary">
    <div class="broker-stat"><div class="stat-label">Servers</div><div class="stat-value" id="broker-servers">0</div></div>
    <div class="broker-stat"><div class="stat-label">Healthy</div><div class="stat-value" id="broker-healthy" style="color:var(--green)">0</div></div>
    <div class="broker-stat"><div class="stat-label">Tools</div><div class="stat-value" id="broker-tools">0</div></div>
    <div class="broker-stat"><div class="stat-label">Requests</div><div class="stat-value" id="broker-requests">0</div></div>
  </div>
  <ul class="server-list" id="server-list"></ul>
</div>

<!-- ── Memory Panel ────────────────────────────────────────────────────────── -->
<div class="mcp-panel" id="panel-memory">
  <p style="font-size:0.88em;color:var(--muted);margin-bottom:16px">
    Invoke memory.search, memory.store, or memory.status via MCP. Results appear in the console below.
  </p>
  <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap">
    <button class="btn" onclick="invokeMemory('memory.status','{}')">memory.status</button>
    <button class="btn" onclick="promptMemorySearch()">memory.search</button>
    <button class="btn" onclick="promptMemoryStore()">memory.store</button>
  </div>
  <h3 style="font-size:0.9em;margin-bottom:10px;color:var(--muted)">Memory MCP Console</h3>
  <div class="console-box" id="memory-console">
    <div class="console-entry" style="color:var(--muted)">No memory invocations yet.</div>
  </div>
</div>

<!-- ── Invoke Modal ────────────────────────────────────────────────────────── -->
<div class="invoke-modal" id="invoke-modal">
  <div class="invoke-modal-inner">
    <h3 id="invoke-modal-title">Invoke Tool</h3>
    <label style="font-size:0.82em;color:var(--muted);display:block;margin-bottom:6px">Arguments (JSON)</label>
    <textarea id="invoke-args">{}</textarea>
    <div class="modal-actions">
      <button class="btn" onclick="closeInvokeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="submitInvoke()">Invoke</button>
    </div>
  </div>
</div>

<script>
(function() {
'use strict';

var currentInvokeTool = '';

function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ── Tab switching ─────────────────────────────────────────────────────────
window.switchTab = function(tab) {
  document.querySelectorAll('.mcp-tab').forEach(function(t) { t.classList.toggle('active', t.dataset.tab === tab); });
  document.querySelectorAll('.mcp-panel').forEach(function(p) { p.classList.toggle('active', p.id === 'panel-' + tab); });
  if (tab === 'broker') loadBroker();
  if (tab === 'memory') loadMemory();
};

// ── Tool panel ────────────────────────────────────────────────────────────
function loadTools() {
  fetch('http://127.0.0.1:11432/api/moke/mcp/tools', { mode: 'cors' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var grid = document.getElementById('tool-grid');
      grid.innerHTML = '';
      (data.tools || []).forEach(function(t) {
        var card = document.createElement('div');
        card.className = 'tool-card';
        card.innerHTML =
          '<div class="tool-top">' +
            '<span class="badge badge-teal">' + esc(t.category) + '</span>' +
            '<span class="tool-name">' + esc(t.name) + '</span>' +
          '</div>' +
          '<div class="tool-desc">' + esc(t.description) + '</div>' +
          '<div class="tool-actions">' +
            '<button class="btn btn-sm btn-primary" onclick="openInvoke(\'' + esc(t.name) + '\')">Invoke</button>' +
          '</div>';
        grid.appendChild(card);
      });
      // Render invocation console
      renderToolConsole(data.invocations || []);
    })
    .catch(function(e) { console.error('[moke] tools fetch error:', e); });
}

function renderToolConsole(invocations) {
  var box = document.getElementById('tool-console');
  if (invocations.length === 0) return;
  box.innerHTML = '';
  invocations.slice().reverse().forEach(function(inv) {
    var el = document.createElement('div');
    el.className = 'console-entry';
    var statusCls = inv.success ? 'console-ok' : 'console-err';
    var statusText = inv.success ? 'OK' : 'ERR';
    el.innerHTML =
      '<span class="console-time">[' + esc(inv.timestamp) + ']</span> ' +
      '<span class="console-tool">' + esc(inv.tool_name) + '</span> ' +
      '<span class="' + statusCls + '">' + statusText + '</span> ' +
      '<span style="color:var(--muted)">' + esc((inv.result_json || inv.error || '').slice(0, 120)) + '</span>';
    box.appendChild(el);
  });
}

window.openInvoke = function(toolName) {
  currentInvokeTool = toolName;
  document.getElementById('invoke-modal-title').textContent = 'Invoke: ' + toolName;
  document.getElementById('invoke-args').value = '{}';
  document.getElementById('invoke-modal').classList.add('visible');
};

window.closeInvokeModal = function() {
  document.getElementById('invoke-modal').classList.remove('visible');
};

window.submitInvoke = function() {
  var args = document.getElementById('invoke-args').value;
  closeInvokeModal();
  fetch('http://127.0.0.1:11432/api/moke/mcp/invoke', {
    method: 'POST', mode: 'cors',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ tool_name: currentInvokeTool, args: JSON.parse(args || '{}') })
  })
  .then(function(r) { return r.json(); })
  .then(function() { loadTools(); })
  .catch(function(e) { console.error('[moke] invoke error:', e); });
};

// ── Broker panel ──────────────────────────────────────────────────────────
function loadBroker() {
  fetch('http://127.0.0.1:11432/api/moke/mcp/broker', { mode: 'cors' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      document.getElementById('broker-servers').textContent = data.server_count || 0;
      document.getElementById('broker-healthy').textContent = data.healthy_count || 0;
      document.getElementById('broker-tools').textContent = data.total_tools || 0;
      document.getElementById('broker-requests').textContent = data.requests_served || 0;

      var list = document.getElementById('server-list');
      list.innerHTML = '';
      (data.servers || []).forEach(function(s) {
        var li = document.createElement('li');
        li.className = 'server-item';
        var healthDot = s.healthy ? '<span class="status-dot idle"></span>' : '<span class="status-dot error"></span>';
        var toolBadges = (s.tools || []).map(function(t) { return '<span class="badge badge-teal">' + esc(t) + '</span>'; }).join(' ');
        var permBadges = (s.permissions || []).map(function(p) {
          var cls = p === 'read' ? 'badge-public' : p === 'write' ? 'badge-internal' : 'badge-confidential';
          return '<span class="badge ' + cls + '">' + esc(p) + '</span>';
        }).join(' ');
        li.innerHTML =
          '<div class="server-top">' + healthDot +
            '<span class="server-name">' + esc(s.name) + '</span>' +
            permBadges +
          '</div>' +
          '<div class="server-meta">' +
            '<span>Transport: ' + esc(s.transport) + '</span>' +
            '<span>URL: ' + esc(s.url) + '</span>' +
          '</div>' +
          '<div class="server-tools">' + toolBadges + '</div>';
        list.appendChild(li);
      });
    })
    .catch(function(e) { console.error('[moke] broker fetch error:', e); });
}

// ── Memory panel ──────────────────────────────────────────────────────────
function loadMemory() {
  fetch('http://127.0.0.1:11432/api/moke/mcp/memory', { mode: 'cors' })
    .then(function(r) { return r.json(); })
    .then(function(data) { renderMemoryConsole(data.invocations || []); })
    .catch(function(e) { console.error('[moke] memory fetch error:', e); });
}

function renderMemoryConsole(invocations) {
  var box = document.getElementById('memory-console');
  if (invocations.length === 0) return;
  box.innerHTML = '';
  invocations.slice().reverse().forEach(function(inv) {
    var el = document.createElement('div');
    el.className = 'console-entry';
    var statusCls = inv.success ? 'console-ok' : 'console-err';
    el.innerHTML =
      '<span class="console-time">[' + esc(inv.timestamp) + ']</span> ' +
      '<span class="console-tool">' + esc(inv.tool_name) + '</span> ' +
      '<span class="' + statusCls + '">' + (inv.success ? 'OK' : 'ERR') + '</span> ' +
      '<span style="color:var(--muted)">' + esc((inv.result_preview || '').slice(0, 150)) + '</span>';
    box.appendChild(el);
  });
}

window.invokeMemory = function(toolName, argsJson) {
  fetch('http://127.0.0.1:11432/api/moke/mcp/memory', {
    method: 'POST', mode: 'cors',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ tool_name: toolName, args: JSON.parse(argsJson || '{}') })
  })
  .then(function() { loadMemory(); })
  .catch(function(e) { console.error('[moke] memory invoke error:', e); });
};

window.promptMemorySearch = function() {
  var query = prompt('Search query:');
  if (!query) return;
  invokeMemory('memory.search', JSON.stringify({ query: query, limit: 5 }));
};

window.promptMemoryStore = function() {
  var content = prompt('Content to store:');
  if (!content) return;
  invokeMemory('memory.store', JSON.stringify({ content: content, role: 'user' }));
};

// Auto-load tools on page visit
loadTools();

})();
</script>

{! end !}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{! yield("title") !}</title>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0d1117; --surface: #161b22; --border: #30363d;
      --text: #e6edf3; --muted: #8b949e; --accent: #14b8a6;
      --green: #3fb950; --amber: #d29922; --red: #f85149;
      --teal: #14b8a6; --teal-dim: rgba(20,184,166,.15);
    }
    body {
      background: var(--bg); color: var(--text);
      font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.6;
      display: flex; flex-direction: column; min-height: 100vh;
    }

    /* ── Header ── */
    .app-header {
      border-bottom: 1px solid var(--border);
      padding: 12px 24px;
      display: flex; align-items: center; gap: 12px;
      flex-shrink: 0; z-index: 100; background: var(--bg);
    }
    .app-header .brand { display: flex; align-items: baseline; gap: 10px; }
    .app-header h1 { font-size: 1.25em; font-weight: 700; letter-spacing: -0.02em; color: var(--teal); }
    .app-header .subtitle { color: var(--muted); font-size: 0.82em; }
    .app-header .spacer { flex: 1; }
    .conn-badge {
      display: flex; align-items: center; gap: 6px;
      font-size: 0.78em; color: var(--muted);
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 20px; padding: 4px 12px;
      text-decoration: none; transition: border-color 0.15s;
    }
    .conn-badge:hover { border-color: var(--teal); color: var(--text); }
    .conn-badge .dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green); flex-shrink: 0;
      box-shadow: 0 0 6px var(--green);
    }

    /* ── App body: sidebar + main ── */
    .app-body { display: flex; flex: 1; overflow: hidden; }

    /* ── Sidebar ── */
    .sidebar {
      width: 220px; flex-shrink: 0;
      background: var(--surface); border-right: 1px solid var(--border);
      display: flex; flex-direction: column;
      overflow-y: auto;
    }
    .sidebar-nav { flex: 1; padding: 12px 0; }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 16px; color: var(--muted);
      text-decoration: none; font-size: 0.9em; font-weight: 500;
      border-left: 3px solid transparent;
      transition: color 0.15s, background 0.15s, border-color 0.15s;
    }
    .sidebar-nav a:hover { color: var(--text); background: rgba(255,255,255,.04); }
    .sidebar-nav a.active {
      color: var(--teal); background: var(--teal-dim);
      border-left-color: var(--teal);
    }
    .sidebar-nav .nav-icon { font-size: 1.1em; width: 20px; text-align: center; flex-shrink: 0; }
    .sidebar-section-label {
      font-size: 0.7em; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--muted);
      padding: 14px 16px 4px;
    }

    /* ── Sidebar status bar ── */
    .sidebar-status {
      border-top: 1px solid var(--border);
      padding: 12px 16px; font-size: 0.78em;
    }
    .sidebar-status .status-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 3px 0;
    }
    .sidebar-status .label { color: var(--muted); }
    .sidebar-status .value { color: var(--text); font-weight: 500; }
    .privacy-row { display: flex; align-items: center; gap: 5px; }
    .privacy-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--green); box-shadow: 0 0 5px var(--green);
    }
    .badge {
      font-size: 0.72em; font-weight: 600; padding: 1px 7px;
      border-radius: 4px; white-space: nowrap;
    }
    .badge-confidential { background: rgba(248,81,73,.15); color: var(--red); }
    .badge-internal     { background: rgba(210,153,34,.15); color: var(--amber); }
    .badge-public       { background: rgba(63,185,80,.15);  color: var(--green); }
    .badge-teal         { background: var(--teal-dim);      color: var(--teal); }
    .badge-muted        { background: rgba(139,148,158,.12); color: var(--muted); }

    /* GA3.7 — Sensitivity tooltip */
    .sensitivity-tooltip { position: relative; cursor: help; }
    .sensitivity-tooltip:hover::after { content: attr(data-tooltip); position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 6px 10px; font-size: 0.75em; color: var(--muted); white-space: nowrap; z-index: 100; }

    /* ── Main content ── */
    .app-main {
      flex: 1; overflow-y: auto;
      padding: 24px;
    }

    /* ── Mobile sidebar toggle ── */
    .sidebar-toggle {
      display: none; background: none; border: none;
      color: var(--muted); cursor: pointer; padding: 4px; font-size: 1.2em;
    }

    /* ── Utilities ── */
    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; padding: 20px 24px; margin-bottom: 20px;
    }
    .card-teal { border-color: var(--teal); background: var(--teal-dim); }
    .card h2 {
      font-size: 0.78em; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.09em; color: var(--muted); margin-bottom: 14px;
    }
    code {
      font-family: monospace; background: rgba(255,255,255,.06);
      padding: 1px 5px; border-radius: 3px; font-size: 0.9em;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.85em; font-weight: 600; padding: 7px 16px;
      border-radius: 7px; border: none; cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
    }
    .btn:active { transform: scale(0.97); }
    .btn-teal  { background: var(--teal); color: #0d1117; }
    .btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text); }
    .btn-ghost:hover { border-color: var(--teal); color: var(--teal); }

    .tree-section { padding: 2px 0; }
    .tree-label {
      display: flex; align-items: center; gap: 6px;
      padding: 3px 4px; color: var(--muted); cursor: pointer;
      font-size: 0.85em; border-radius: 4px;
    }
    .tree-label:hover { background: rgba(255,255,255,.04); color: var(--text); }
    .tree-count {
      background: rgba(139,148,158,.15); color: var(--muted);
      font-size: 0.75em; padding: 1px 6px; border-radius: 10px; margin-left: auto;
    }
    .tree-list { padding-left: 20px; display: none; }
    .tree-list.open { display: block; }
    .tree-item {
      padding: 2px 4px; color: var(--muted); font-size: 0.8em;
      cursor: pointer; border-radius: 3px; white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
    }
    .tree-item:hover { color: var(--text); background: rgba(255,255,255,.04); }
    .tree-item.active { color: var(--teal); }
    .tree-add { margin-left:auto; color:var(--teal); cursor:pointer; font-size:1.1em; padding:0 4px; opacity:0.6; }
    .tree-add:hover { opacity:1; }

    /* ── Focus management (GA3.1) ── */
    :focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
    .skip-link {
      position: absolute; top: -40px; left: 0;
      background: var(--teal); color: #0d1117;
      padding: 8px 16px; font-size: 0.88em; font-weight: 600;
      z-index: 1000; text-decoration: none;
      transition: top 0.2s;
    }
    .skip-link:focus { top: 0; }

    @media (max-width: 768px) {
      .sidebar-toggle { display: block; }
      .sidebar {
        position: fixed; left: -220px; top: 0; bottom: 0;
        z-index: 200; transition: left 0.2s;
      }
      .sidebar.open { left: 0; }
      .app-main { padding: 16px; }
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/static/html2canvas.min.js"></script>
  <script src="/static/js/moke-flow.js"></script>
  <script>
    // ── A4.1 First-run setup redirect ──
    (function() {
      if (!localStorage.getItem('moke_setup_complete') && window.location.pathname === '/') {
        window.location.href = '/setup';
      }
    })();

    // ── Verbose error logging ──
    window.addEventListener('error', function(e) {
      console.error('[moke] Uncaught error:', e.message, '\n  File:', e.filename, 'Line:', e.lineno, 'Col:', e.colno, '\n  Stack:', e.error && e.error.stack);
    });
    window.addEventListener('unhandledrejection', function(e) {
      console.error('[moke] Unhandled promise rejection:', e.reason);
    });
    window.addEventListener('load', function() {
      if (typeof Chart === 'undefined') {
        console.error('[moke] Chart.js did not load from CDN — charts will not render. Check network/CSP.');
      } else {
        console.log('[moke] Chart.js ' + Chart.version + ' ready');
      }
    });
  </script>
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="app-header">
    <button class="sidebar-toggle" aria-label="Toggle navigation" onclick="toggleSidebar()">☰</button>
    <div class="brand">
      <h1>moke</h1>
      <span class="subtitle">data analysis on loke · moke 0.2.0</span>
    </div>
    <div class="spacer"></div>
    <a href="http://127.0.0.1:11430" target="_blank" rel="noopener" class="conn-badge" id="loke-conn-badge" data-loke-link aria-label="loke connection status">
      <span class="dot" id="loke-conn-dot" style="background:var(--muted);box-shadow:none;" aria-hidden="true"></span>
      <span id="loke-conn-label">loke checking…</span>
    </a>
  </header>

  <div class="app-body">

    <nav class="sidebar" id="sidebar" aria-label="Main navigation">
      <div class="sidebar-nav" role="navigation">
        <div class="sidebar-section-label">Workspace</div>
        <a href="/"          class="nav-link" data-path="/">
          <span class="nav-icon">🗂️</span> Datasets
        </a>
        <a href="/chat"      class="nav-link" data-path="/chat">
          <span class="nav-icon">💬</span> Analysis
        </a>
        <a href="/dashboard" class="nav-link" data-path="/dashboard">
          <span class="nav-icon">📊</span> Dashboard
        </a>
        <div class="sidebar-section-label">Tools</div>
        <a href="/insight"   class="nav-link" data-path="/insight">
          <span class="nav-icon">🔬</span> Insight Lab
        </a>
        <a href="/upload"    class="nav-link" data-path="/upload">
          <span class="nav-icon">⬆️</span> Upload
        </a>
        <a href="/connections" class="nav-link" data-path="/connections">
          <span class="nav-icon">🔌</span> Connections
        </a>
        <div class="sidebar-section-label">System</div>
        <a href="/settings"  class="nav-link" data-path="/settings">
          <span class="nav-icon">⚙️</span> Settings
        </a>
      </div>

      <div class="sidebar-section-label">Project</div>
      <div id="project-tree" style="padding:4px 12px;font-size:0.82em;">
        <div id="project-name" style="color:var(--teal);font-weight:600;padding:4px 0;cursor:pointer;" onclick="renameProject()">
          Default Project
        </div>
        <div class="tree-section" id="tree-datasets">
          <button class="tree-label" onclick="toggleTree('tree-datasets-list')" aria-expanded="false" aria-controls="tree-datasets-list">📁 Datasets <span class="tree-count" id="tree-datasets-count">0</span></button>
          <div id="tree-datasets-list" class="tree-list"></div>
        </div>
        <div class="tree-section" id="tree-chats">
          <button class="tree-label" onclick="toggleTree('tree-chats-list')" aria-expanded="false" aria-controls="tree-chats-list">💬 Conversations <span class="tree-count" id="tree-chats-count">0</span><span class="tree-add" onclick="event.stopPropagation();sessionStorage.removeItem('moke_chat_history');window.location.href='/chat';" title="New conversation" aria-label="New conversation">+</span></button>
          <div id="tree-chats-list" class="tree-list"></div>
        </div>
        <div class="tree-section" id="tree-dashboards">
          <button class="tree-label" onclick="toggleTree('tree-dashboards-list')" aria-expanded="false" aria-controls="tree-dashboards-list">📊 Dashboards <span class="tree-count" id="tree-dashboards-count">0</span><span class="tree-add" onclick="event.stopPropagation();window.location.href='/dashboard';" title="New dashboard" aria-label="New dashboard">+</span></button>
          <div id="tree-dashboards-list" class="tree-list"></div>
        </div>
        <div class="tree-section" id="tree-insights">
          <button class="tree-label" onclick="toggleTree('tree-insights-list')" aria-expanded="false" aria-controls="tree-insights-list">🔬 Insights <span class="tree-count" id="tree-insights-count">0</span><span class="tree-add" onclick="event.stopPropagation();window.location.href='/insight';" title="New insight" aria-label="New insight">+</span></button>
          <div id="tree-insights-list" class="tree-list"></div>
        </div>
      </div>

      <!-- A5.1 — Report Issue button in sidebar footer -->
      <div style="padding:8px 12px;">
        <button class="btn btn-ghost" style="width:100%;font-size:0.78em;gap:6px;" onclick="openIssueModal()" aria-label="Report an issue">
          <span style="font-size:1.1em;">&#9888;</span> Report Issue
        </button>
      </div>

      <div class="sidebar-status">
        <div class="status-row">
          <span class="label">Privacy</span>
          <span class="value">
            <span class="privacy-row">
              <span class="privacy-dot" id="privacy-dot" style="background:var(--muted);box-shadow:none;"></span>
              <span id="privacy-label">checking…</span>
            </span>
          </span>
        </div>
        <div class="status-row">
          <span class="label">Dataset</span>
          <span class="value" id="sidebar-dataset-name">No dataset loaded</span>
        </div>
        <div class="status-row">
          <span class="label">Sensitivity</span>
          <span id="sidebar-sensitivity" class="badge badge-muted sensitivity-tooltip" data-tooltip="No dataset loaded">—</span>
        </div>
      </div>
    </nav>

    <main class="app-main" id="main-content">
      {! yield("content") !}
    </main>

  </div>

  <script>
    // ── Active nav link ──
    (function() {
      var path = window.location.pathname;
      document.querySelectorAll('.nav-link').forEach(function(a) {
        var dp = a.getAttribute('data-path');
        if (dp === '/' ? path === '/' : path.startsWith(dp)) {
          a.classList.add('active');
        }
      });
    })();

    // ── Sidebar dataset status bar ──
    (function() {
      var ds = sessionStorage.getItem('moke_dataset');
      if (ds) {
        try {
          var d = JSON.parse(ds);
          var nameEl = document.getElementById('sidebar-dataset-name');
          var sensEl = document.getElementById('sidebar-sensitivity');
          if (nameEl && d.name) nameEl.textContent = d.name;
          if (sensEl && d.sensitivity) {
            sensEl.textContent = d.sensitivity;
            var cls = {
              'CONFIDENTIAL': 'badge-confidential',
              'INTERNAL':     'badge-internal',
              'PUBLIC':       'badge-public'
            }[d.sensitivity] || 'badge-muted';
            sensEl.className = 'badge sensitivity-tooltip ' + cls;
            // GA3.7 — Sensitivity tooltip
            var piiCols = d.pii || [];
            if (piiCols.length === 0 && d.headers) {
              var PII_RE = /_name$|_email$|phone|medicare|dob$|ssn|tfn|card_no|pii_/i;
              piiCols = d.headers.filter(function(h) { return PII_RE.test(h); });
            }
            var tooltip = 'No PII detected in dataset';
            if (d.sensitivity === 'CONFIDENTIAL') tooltip = 'Contains PII columns: ' + (piiCols.length > 0 ? piiCols.join(', ') : 'detected');
            else if (d.sensitivity === 'RESTRICTED') tooltip = 'Contains >3 PII entity types \u2014 requires review';
            else if (d.sensitivity === 'INTERNAL') tooltip = 'Internal use \u2014 contains organisational data';
            sensEl.setAttribute('data-tooltip', tooltip);
          }
        } catch(e) {}
      }
    })();

    // ── loke connection — auto-detect same-origin or cross-origin ──
    (function() {
      var CROSS_ORIGIN_URL = 'http://127.0.0.1:11430';
      window.LOKE_URL = CROSS_ORIGIN_URL;
      var dot   = document.getElementById('loke-conn-dot');
      var label = document.getElementById('loke-conn-label');
      var pdot  = document.getElementById('privacy-dot');
      var plbl  = document.getElementById('privacy-label');
      var resolved = false;

      function setConnected(h) {
        if (dot)  { dot.style.background = 'var(--green)'; dot.style.boxShadow = '0 0 6px var(--green)'; }
        if (label) label.textContent = 'loke ' + (h.loke || '0.2.0') + ' · moke 0.2.0' + (h.ollama === 'running' ? ' · Ollama ready' : ' · Ollama offline');
        if (pdot) { pdot.style.background = 'var(--green)'; pdot.style.boxShadow = '0 0 5px var(--green)'; }
        if (plbl) plbl.textContent = 'ON';
      }
      function setDisconnected() {
        if (dot)  { dot.style.background = 'var(--red)'; dot.style.boxShadow = '0 0 6px var(--red)'; }
        if (label) label.textContent = 'loke offline';
        if (pdot) { pdot.style.background = 'var(--muted)'; pdot.style.boxShadow = 'none'; }
        if (plbl) plbl.textContent = 'OFF';
      }

      // Try same-origin first (works when behind reverse proxy or single-port)
      // Fall back to cross-origin URL for dev (moke:11432 → loke:11430)
      function probeAndResolve() {
        fetch('/api/health', { cache: 'no-store' })
          .then(function(r) { return r.json(); })
          .then(function(d) {
            if (d && (d.ok || d.status === 'ok') && d.loke) {
              // Same-origin loke detected — use relative paths (no CORS needed)
              window.LOKE_URL = '';
              resolved = true;
              setConnected(d);
            } else { throw new Error('not loke'); }
          })
          .catch(function() {
            // Same-origin not available — use cross-origin URL
            window.LOKE_URL = CROSS_ORIGIN_URL;
            resolved = true;
            check();
          });
      }

      function check() {
        fetch(window.LOKE_URL + '/api/health', { cache: 'no-store' })
          .then(function(r) { return r.json(); })
          .then(function(d) { if (d && (d.ok || d.status === 'ok')) { setConnected(d); } else { setDisconnected(); } })
          .catch(function() { setDisconnected(); });
      }

      probeAndResolve();
      setInterval(function() { if (resolved) check(); }, 15000);
    })();

    // ── Project workspace ──
    function toggleTree(id) {
      var el = document.getElementById(id);
      if (el) {
        el.classList.toggle('open');
        var toggle = document.querySelector('[aria-controls="' + id + '"]');
        if (toggle) toggle.setAttribute('aria-expanded', el.classList.contains('open'));
      }
    }

    function renameProject() {
      var name = prompt('Project name:', document.getElementById('project-name').textContent);
      if (name && name.trim()) {
        document.getElementById('project-name').textContent = name.trim();
        localStorage.setItem('moke_project_name', name.trim());
      }
    }

    function refreshProjectTree() {
      // Project name
      var pname = localStorage.getItem('moke_project_name') || 'Default Project';
      var pnameEl = document.getElementById('project-name');
      if (pnameEl) pnameEl.textContent = pname;

      // Datasets
      var dsListEl = document.getElementById('tree-datasets-list');
      var dsCountEl = document.getElementById('tree-datasets-count');
      if (dsListEl) {
        var datasets = JSON.parse(localStorage.getItem('moke_project_datasets') || '[]');
        // Also check current session dataset
        var current = null;
        try { current = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch(_) {}
        if (current && !datasets.find(function(d) { return d.id === current.id; })) {
          datasets.push({ id: current.id, name: current.name, rows: current.rows ? current.rows.length : 0 });
          localStorage.setItem('moke_project_datasets', JSON.stringify(datasets));
        }
        dsListEl.innerHTML = '';
        datasets.forEach(function(d) {
          var item = document.createElement('div');
          item.className = 'tree-item' + (current && current.id === d.id ? ' active' : '');
          item.textContent = d.name + ' (' + (d.rows || 0) + ' rows)';
          item.onclick = function() { /* switch dataset */ };
          dsListEl.appendChild(item);
        });
        if (dsCountEl) dsCountEl.textContent = datasets.length;
      }

      // Conversations (from chat history)
      var chatListEl = document.getElementById('tree-chats-list');
      var chatCountEl = document.getElementById('tree-chats-count');
      if (chatListEl) {
        var history = JSON.parse(sessionStorage.getItem('moke_chat_history') || '[]');
        var msgCount = history.filter(function(h) { return h.role === 'user'; }).length;
        chatListEl.innerHTML = msgCount > 0
          ? '<div class="tree-item active">Current chat (' + msgCount + ' messages)</div>'
          : '<div class="tree-item" style="color:var(--muted);font-style:italic;">No conversations yet</div>';
        if (chatCountEl) chatCountEl.textContent = msgCount > 0 ? 1 : 0;
      }

      // Dashboards (from templates)
      var dashListEl = document.getElementById('tree-dashboards-list');
      var dashCountEl = document.getElementById('tree-dashboards-count');
      if (dashListEl) {
        var templates = JSON.parse(localStorage.getItem('moke_dashboard_templates') || '[]');
        dashListEl.innerHTML = '';
        templates.forEach(function(t) {
          var item = document.createElement('div');
          item.className = 'tree-item';
          item.textContent = t.name;
          item.onclick = function() { window.location.href = '/dashboard'; };
          dashListEl.appendChild(item);
        });
        if (dashCountEl) dashCountEl.textContent = templates.length;
        if (templates.length === 0) dashListEl.innerHTML = '<div class="tree-item" style="color:var(--muted);font-style:italic;">No dashboards yet</div>';
      }

      // Insights
      var insListEl = document.getElementById('tree-insights-list');
      var insCountEl = document.getElementById('tree-insights-count');
      if (insListEl) {
        var insights = JSON.parse(localStorage.getItem('moke_insight_results') || '[]');
        insListEl.innerHTML = '';
        insights.forEach(function(ins) {
          var item = document.createElement('div');
          item.className = 'tree-item';
          item.textContent = ins.name || ins.type || 'Analysis';
          insListEl.appendChild(item);
        });
        if (insCountEl) insCountEl.textContent = insights.length;
        if (insights.length === 0) insListEl.innerHTML = '<div class="tree-item" style="color:var(--muted);font-style:italic;">No insights yet</div>';
      }
    }

    refreshProjectTree();

    // ── Mobile sidebar toggle ──
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('open');
    }
    document.addEventListener('click', function(e) {
      var sb = document.getElementById('sidebar');
      if (sb.classList.contains('open') && !sb.contains(e.target) && !e.target.classList.contains('sidebar-toggle')) {
        sb.classList.remove('open');
      }
    });
  </script>

  <!-- MK8.8 — Guided demo walkthrough overlay -->
  <div id="demo-walkthrough" style="display:none;">
    <div class="demo-overlay">
      <div class="demo-header">
        <span class="demo-step-indicator" id="demo-step-indicator">Step 1 of 8</span>
        <span class="demo-title">Guided Demo</span>
        <button class="demo-close" onclick="closeDemoWalkthrough()" title="Close walkthrough" aria-label="Close walkthrough">&times;</button>
      </div>
      <div class="demo-body">
        <div class="demo-step-title" id="demo-step-title"></div>
        <div class="demo-step-desc" id="demo-step-desc"></div>
        <div class="demo-prompt-chip" id="demo-prompt-chip" style="display:none;" onclick="executeDemoAction()"></div>
      </div>
      <div class="demo-footer">
        <div class="demo-progress">
          <div class="demo-progress-bar" id="demo-progress-bar" style="width:12.5%;"></div>
        </div>
        <div class="demo-actions">
          <button class="btn btn-ghost demo-btn" onclick="skipDemoStep()">Skip</button>
          <button class="btn btn-teal demo-btn" id="demo-action-btn" onclick="executeDemoAction()">Do this step</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* ── Demo walkthrough panel ── */
    #demo-walkthrough {
      position: fixed; bottom: 24px; right: 24px; z-index: 9999;
      width: 360px; max-width: calc(100vw - 48px);
    }
    .demo-overlay {
      background: var(--surface); border: 1px solid var(--teal);
      border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.45);
      overflow: hidden;
    }
    .demo-header {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 14px; background: var(--teal-dim);
      border-bottom: 1px solid var(--border);
    }
    .demo-step-indicator {
      font-size: 0.72em; font-weight: 700; color: var(--teal);
      background: rgba(20,184,166,.15); padding: 2px 8px; border-radius: 10px;
    }
    .demo-title {
      font-size: 0.82em; font-weight: 700; color: var(--text); flex: 1;
    }
    .demo-close {
      background: none; border: none; color: var(--muted); font-size: 1.3em;
      cursor: pointer; padding: 0 2px; line-height: 1;
    }
    .demo-close:hover { color: var(--text); }
    .demo-body { padding: 14px 16px; }
    .demo-step-title {
      font-size: 0.95em; font-weight: 700; color: var(--text);
      margin-bottom: 6px;
    }
    .demo-step-desc {
      font-size: 0.82em; color: var(--muted); line-height: 1.5;
      margin-bottom: 10px;
    }
    .demo-prompt-chip {
      display: inline-block; font-size: 0.8em; font-weight: 500;
      color: var(--teal); background: var(--teal-dim);
      border: 1px solid rgba(20,184,166,.3); border-radius: 16px;
      padding: 5px 14px; cursor: pointer; transition: background 0.15s;
      max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .demo-prompt-chip:hover { background: rgba(20,184,166,.25); }
    .demo-footer { padding: 0 14px 12px; }
    .demo-progress {
      height: 3px; background: var(--border); border-radius: 2px;
      margin-bottom: 10px; overflow: hidden;
    }
    .demo-progress-bar {
      height: 100%; background: var(--teal); border-radius: 2px;
      transition: width 0.3s ease;
    }
    .demo-actions {
      display: flex; justify-content: flex-end; gap: 8px;
    }
    .demo-btn { font-size: 0.78em; padding: 5px 14px; }
    @media (max-width: 600px) {
      #demo-walkthrough { bottom: 12px; right: 12px; width: calc(100vw - 24px); }
    }
  </style>

  <!-- ══════════════════════════════════════════════════════════════════ -->
  <!-- A5.1 — Issue Reporting Modal                                      -->
  <!-- ══════════════════════════════════════════════════════════════════ -->
  <div id="issue-modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="issue-modal-title">
    <div class="issue-modal">
      <div class="issue-modal-header">
        <span id="issue-modal-title" style="font-weight:700;font-size:0.95em;">Report an Issue</span>
        <button class="issue-modal-close" onclick="closeIssueModal()" aria-label="Close issue form">&times;</button>
      </div>
      <div class="issue-modal-body">
        <div class="issue-field">
          <label for="issue-type" class="issue-label">Type</label>
          <select id="issue-type" class="issue-select">
            <option value="bug">Bug</option>
            <option value="feature">Feature Request</option>
            <option value="privacy">Privacy Concern</option>
            <option value="performance">Performance</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="issue-field">
          <label for="issue-title" class="issue-label">Title <span style="color:var(--red);">*</span></label>
          <input type="text" id="issue-title" class="issue-input" placeholder="Short summary of the issue" required>
        </div>
        <div class="issue-field">
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <label for="issue-description" class="issue-label">Description</label>
            <!-- A5.2 — AI-assisted drafting button -->
            <button class="issue-ai-btn" id="issue-ai-btn" onclick="aiDraftDescription()" title="Use AI to help refine your description">
              <span style="font-size:0.9em;">&#10024;</span> Help me describe this
            </button>
          </div>
          <textarea id="issue-description" class="issue-textarea" rows="4" placeholder="What happened? What were you trying to do?"></textarea>
          <!-- A5.2 — AI suggestion preview -->
          <div id="issue-ai-preview" style="display:none;">
            <div class="issue-ai-preview-header">
              <span style="font-size:0.78em;font-weight:600;color:var(--teal);">AI Suggestion</span>
              <div style="display:flex;gap:6px;">
                <button class="issue-ai-use-btn" onclick="useAiDraft()">Use this</button>
                <button class="issue-ai-dismiss-btn" onclick="dismissAiDraft()">Dismiss</button>
              </div>
            </div>
            <div id="issue-ai-text" class="issue-ai-text"></div>
          </div>
        </div>
        <div class="issue-field">
          <label for="issue-steps" class="issue-label">Steps to reproduce <span style="color:var(--muted);font-weight:400;">(optional)</span></label>
          <textarea id="issue-steps" class="issue-textarea" rows="3" placeholder="1. Go to...&#10;2. Click on...&#10;3. Observe..."></textarea>
        </div>
        <div class="issue-field">
          <label for="issue-expected" class="issue-label">Expected behaviour <span style="color:var(--muted);font-weight:400;">(optional)</span></label>
          <textarea id="issue-expected" class="issue-textarea" rows="2" placeholder="What should have happened instead?"></textarea>
        </div>
        <div class="issue-field">
          <label class="issue-label">Screenshot <span style="color:var(--muted);font-weight:400;">(optional)</span></label>
          <input type="file" id="issue-screenshot" accept="image/*" class="issue-file-input">
          <div id="issue-screenshot-preview" style="display:none;margin-top:6px;">
            <img id="issue-screenshot-img" style="max-width:100%;max-height:160px;border-radius:6px;border:1px solid var(--border);" alt="Screenshot preview">
          </div>
        </div>
        <div class="issue-meta" id="issue-meta">
          <span style="font-size:0.75em;color:var(--muted);">Page: <span id="issue-meta-page"></span> | Browser auto-detected</span>
        </div>
      </div>
      <div class="issue-modal-footer">
        <button class="btn btn-ghost" onclick="closeIssueModal()">Cancel</button>
        <button class="btn btn-teal" id="issue-submit-btn" onclick="submitIssue()">Submit</button>
      </div>
    </div>
  </div>

  <!-- A5.1 — Issue toast -->
  <div id="issue-toast" class="issue-toast" style="display:none;" role="status" aria-live="polite"></div>

  <style>
    /* ── A5.1 Issue Modal ── */
    #issue-modal-overlay {
      position: fixed; inset: 0; z-index: 10000;
      background: rgba(0,0,0,.55); display: flex;
      align-items: center; justify-content: center;
      backdrop-filter: blur(2px);
    }
    .issue-modal {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; width: 520px; max-width: calc(100vw - 32px);
      max-height: calc(100vh - 48px); display: flex; flex-direction: column;
      box-shadow: 0 12px 40px rgba(0,0,0,.5);
    }
    .issue-modal-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 20px; border-bottom: 1px solid var(--border);
    }
    .issue-modal-close {
      background: none; border: none; color: var(--muted); font-size: 1.4em;
      cursor: pointer; padding: 0 2px; line-height: 1;
    }
    .issue-modal-close:hover { color: var(--text); }
    .issue-modal-body {
      padding: 16px 20px; overflow-y: auto; display: flex;
      flex-direction: column; gap: 14px;
    }
    .issue-modal-footer {
      padding: 12px 20px; border-top: 1px solid var(--border);
      display: flex; justify-content: flex-end; gap: 10px;
    }
    .issue-field { display: flex; flex-direction: column; gap: 4px; }
    .issue-label { font-size: 0.82em; font-weight: 600; color: var(--text); }
    .issue-select, .issue-input, .issue-textarea {
      background: var(--bg); border: 1px solid var(--border);
      color: var(--text); font-size: 0.88em; border-radius: 6px;
      padding: 8px 10px; outline: none; font-family: inherit;
      transition: border-color 0.15s;
    }
    .issue-select:focus, .issue-input:focus, .issue-textarea:focus {
      border-color: var(--teal);
    }
    .issue-textarea { resize: vertical; min-height: 40px; }
    .issue-file-input {
      font-size: 0.82em; color: var(--muted);
    }
    .issue-file-input::file-selector-button {
      background: var(--bg); border: 1px solid var(--border);
      color: var(--text); padding: 4px 12px; border-radius: 5px;
      cursor: pointer; font-size: 0.9em; margin-right: 8px;
    }
    .issue-meta {
      padding: 6px 0; border-top: 1px solid var(--border);
    }

    /* A5.2 — AI draft button */
    .issue-ai-btn {
      background: var(--teal-dim); border: 1px solid rgba(20,184,166,.3);
      color: var(--teal); font-size: 0.75em; font-weight: 600;
      padding: 3px 10px; border-radius: 12px; cursor: pointer;
      transition: background 0.15s;
    }
    .issue-ai-btn:hover { background: rgba(20,184,166,.25); }
    .issue-ai-btn:disabled { opacity: 0.5; cursor: wait; }
    #issue-ai-preview {
      background: var(--teal-dim); border: 1px solid rgba(20,184,166,.25);
      border-radius: 6px; padding: 10px 12px; margin-top: 6px;
    }
    .issue-ai-preview-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 6px;
    }
    .issue-ai-text {
      font-size: 0.85em; color: var(--text); line-height: 1.5;
      white-space: pre-wrap;
    }
    .issue-ai-use-btn {
      background: var(--teal); color: #0d1117; border: none;
      font-size: 0.75em; font-weight: 700; padding: 3px 10px;
      border-radius: 5px; cursor: pointer;
    }
    .issue-ai-dismiss-btn {
      background: transparent; border: 1px solid var(--border);
      color: var(--muted); font-size: 0.75em; padding: 3px 10px;
      border-radius: 5px; cursor: pointer;
    }

    /* A5.1 — Toast */
    .issue-toast {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
      z-index: 10001; background: var(--green); color: #0d1117;
      font-size: 0.88em; font-weight: 600; padding: 10px 24px;
      border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,.3);
      animation: issue-toast-in 0.3s ease;
    }
    @keyframes issue-toast-in {
      from { opacity: 0; transform: translateX(-50%) translateY(12px); }
      to   { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
  </style>

  <script>
    // ── A5.1 Issue Reporting ──
    function openIssueModal() {
      document.getElementById('issue-modal-overlay').style.display = 'flex';
      document.getElementById('issue-meta-page').textContent = window.location.pathname;
      document.getElementById('issue-title').focus();
    }

    function closeIssueModal() {
      document.getElementById('issue-modal-overlay').style.display = 'none';
      // Reset form
      document.getElementById('issue-type').value = 'bug';
      document.getElementById('issue-title').value = '';
      document.getElementById('issue-description').value = '';
      document.getElementById('issue-steps').value = '';
      document.getElementById('issue-expected').value = '';
      document.getElementById('issue-screenshot').value = '';
      document.getElementById('issue-screenshot-preview').style.display = 'none';
      document.getElementById('issue-ai-preview').style.display = 'none';
    }

    // Close on overlay click
    document.getElementById('issue-modal-overlay').addEventListener('click', function(e) {
      if (e.target === this) closeIssueModal();
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && document.getElementById('issue-modal-overlay').style.display === 'flex') {
        closeIssueModal();
      }
    });

    // Screenshot preview
    document.getElementById('issue-screenshot').addEventListener('change', function(e) {
      var file = e.target.files[0];
      if (file && file.type.startsWith('image/')) {
        var reader = new FileReader();
        reader.onload = function(ev) {
          document.getElementById('issue-screenshot-img').src = ev.target.result;
          document.getElementById('issue-screenshot-preview').style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });

    function submitIssue() {
      var title = document.getElementById('issue-title').value.trim();
      if (!title) {
        document.getElementById('issue-title').style.borderColor = 'var(--red)';
        document.getElementById('issue-title').focus();
        setTimeout(function() { document.getElementById('issue-title').style.borderColor = ''; }, 2000);
        return;
      }

      var issue = {
        id: 'issue-' + Date.now(),
        type: document.getElementById('issue-type').value,
        title: title,
        description: document.getElementById('issue-description').value.trim(),
        steps: document.getElementById('issue-steps').value.trim(),
        expected: document.getElementById('issue-expected').value.trim(),
        page: window.location.pathname,
        browser: navigator.userAgent,
        timestamp: new Date().toISOString(),
        moke_version: '0.2.0',
        screenshot: document.getElementById('issue-screenshot-img').src || null
      };

      // Save to localStorage
      var issues = [];
      try { issues = JSON.parse(localStorage.getItem('moke_issues') || '[]'); } catch(_) {}
      issues.push(issue);
      localStorage.setItem('moke_issues', JSON.stringify(issues));

      closeIssueModal();
      showIssueToast('Issue reported successfully — saved locally.');
    }

    function showIssueToast(msg) {
      var toast = document.getElementById('issue-toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(function() { toast.style.display = 'none'; }, 3000);
    }

    // ── A5.2 AI-assisted drafting ──
    function aiDraftDescription() {
      var title = document.getElementById('issue-title').value.trim();
      var desc = document.getElementById('issue-description').value.trim();
      if (!title && !desc) {
        document.getElementById('issue-title').focus();
        return;
      }

      var btn = document.getElementById('issue-ai-btn');
      btn.disabled = true;
      btn.innerHTML = '<span style="font-size:0.9em;">&#8987;</span> Drafting...';

      var lokeUrl = window.LOKE_URL || 'http://127.0.0.1:11430';
      var userText = 'Issue title: ' + title;
      if (desc) userText += '\nPartial description: ' + desc;

      fetch(lokeUrl + '/api/pipeline', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text: userText,
          system_prompt: 'Help the user write a clear bug report. Improve their description to be more specific and actionable. Keep it concise. Return only the improved description text, no preamble.',
          mode: 'chat'
        })
      })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        btn.disabled = false;
        btn.innerHTML = '<span style="font-size:0.9em;">&#10024;</span> Help me describe this';
        if (d && d.response) {
          document.getElementById('issue-ai-text').textContent = d.response;
          document.getElementById('issue-ai-preview').style.display = 'block';
        } else {
          showIssueToast('AI drafting unavailable — loke may be offline.');
        }
      })
      .catch(function() {
        btn.disabled = false;
        btn.innerHTML = '<span style="font-size:0.9em;">&#10024;</span> Help me describe this';
        showIssueToast('AI drafting unavailable — loke may be offline.');
      });
    }

    function useAiDraft() {
      var text = document.getElementById('issue-ai-text').textContent;
      document.getElementById('issue-description').value = text;
      document.getElementById('issue-ai-preview').style.display = 'none';
    }

    function dismissAiDraft() {
      document.getElementById('issue-ai-preview').style.display = 'none';
    }
  </script>

  <script>
    // ── MK20.1/MK20.2 Guided demo walkthrough, driven by static/data/flows.json ──
    //
    // This was eight imperative closures, each writing its own next step index.
    // Three of them wrote it BEFORE navigating, so arriving at /dashboard showed
    // the Insight Lab instruction, /insight showed the next load step, and the
    // final step set index 8 against a length-8 flow and completed the moment it
    // was reached. Three of eight steps never displayed their own text.
    //
    // The interpreter in static/js/moke-flow.js cannot express that: navigation
    // and advancement are separate outcomes of planStep(), and a step advances
    // only once the browser is already on its page. Everything here is plumbing.
    var FLOW = null;
    var FLOW_KEY = 'moke_demo_flow';

    function demoStepIndex() {
      return parseInt(sessionStorage.getItem('moke_demo_step') || '0', 10);
    }
    function setDemoStepIndex(i) {
      sessionStorage.setItem('moke_demo_step', String(i));
    }

    // Context for narration placeholders. For a step that names a dataset the
    // catalogue entry is the right source, because the step has not loaded it yet;
    // otherwise the active dataset is. A value that cannot be found is reported by
    // the interpreter and rendered as a visible gap — never as a default, which is
    // how "48 servers" outlived a fourfold growth in the data.
    function demoContext(step) {
      var d = null;
      if (step && step.dataset && typeof DATASETS !== 'undefined' && DATASETS[step.dataset]) {
        d = DATASETS[step.dataset];
      } else {
        try { d = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch (e) { d = null; }
      }
      if (!d) return {};
      var rows = d.rows;
      return {
        dataset: {
          name: d.name,
          sensitivity: d.sensitivity,
          rowcount: (rows && rows.length) || null,
          columncount: (d.headers && d.headers.length) || null
        }
      };
    }

    function loadFlow() {
      return fetch('/static/data/flows.json', { cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (doc) {
          var wanted = sessionStorage.getItem(FLOW_KEY);
          var flows = (doc && doc.flows) || [];
          var picked = null;
          for (var i = 0; i < flows.length; i++) {
            if (!wanted || flows[i].id === wanted) { picked = flows[i]; break; }
          }
          if (!picked) picked = flows[0] || null;
          if (picked) {
            var problems = MokeFlow.validateFlow(picked);
            if (problems.length) {
              console.error('[moke] flow ' + picked.id + ' is invalid: ' + problems.join('; '));
              return null;
            }
          }
          FLOW = picked;
          return picked;
        })
        .catch(function (e) {
          console.error('[moke] could not load flows.json: ' + e);
          return null;
        });
    }

    function renderDemoStep() {
      if (!FLOW) return;
      var idx = demoStepIndex();
      if (idx >= FLOW.steps.length) { completeDemoWalkthrough(); return; }
      var panel = document.getElementById('demo-walkthrough');
      if (!panel) return;

      var step = FLOW.steps[idx];
      var n = MokeFlow.stepNarration(FLOW, idx, demoContext(step));
      if (n.missing.length) {
        // Not silent: a placeholder that cannot be filled is a copy/data mismatch
        // and someone should see it rather than read a stale number.
        console.warn('[moke] flow ' + FLOW.id + ' step ' + idx
                     + ': unresolved narration values: ' + n.missing.join(', '));
      }

      panel.style.display = 'block';
      document.getElementById('demo-step-indicator').textContent = n.indicator;
      document.getElementById('demo-step-title').textContent = n.title;
      document.getElementById('demo-step-desc').textContent = n.text;
      document.getElementById('demo-action-btn').textContent = n.actionLabel;

      var chipEl = document.getElementById('demo-prompt-chip');
      if (n.prompt) {
        chipEl.style.display = 'inline-block';
        chipEl.textContent = n.prompt;
      } else {
        chipEl.style.display = 'none';
      }
      document.getElementById('demo-progress-bar').style.width = (n.progress * 100) + '%';
    }

    function advanceDemoStep() {
      setDemoStepIndex(demoStepIndex() + 1);
      renderDemoStep();
    }

    function skipDemoStep() { advanceDemoStep(); }

    // The only place that acts. Every branch comes from planStep, so the step
    // index moves in exactly one way per outcome and navigation never advances.
    function executeDemoAction() {
      if (!FLOW) return;
      var idx = demoStepIndex();
      var plan = MokeFlow.planStep(FLOW, idx, window.location.pathname, function (sel) {
        return !!document.querySelector(sel);
      });

      switch (plan.action) {
        case MokeFlow.NAVIGATE:
          // Index deliberately unchanged: the step is shown again, on its own page.
          setDemoStepIndex(idx);
          window.location.href = plan.to;
          return;

        case MokeFlow.WAIT:
          console.warn('[moke] waiting for ' + plan.selector);
          return;

        case MokeFlow.LOAD:
          if (typeof loadDataset === 'function') {
            advanceDemoStep();
            loadDataset(plan.dataset);
          } else {
            console.warn('[moke] no loadDataset on this page');
          }
          return;

        case MokeFlow.FILL:
          var input = document.getElementById('chat-input');
          if (input) {
            input.value = plan.prompt;
            input.focus();
            if (typeof onInputChange === 'function') onInputChange();
          }
          advanceDemoStep();
          return;

        case MokeFlow.GENERATE:
          if (typeof generateDashboard === 'function') generateDashboard();
          advanceDemoStep();
          return;

        case MokeFlow.DONE:
          completeDemoWalkthrough();
          return;

        default:
          advanceDemoStep();
          return;
      }
    }

    function startDemoWalkthrough(flowId) {
      if (flowId) sessionStorage.setItem(FLOW_KEY, flowId);
      sessionStorage.setItem('moke_demo_active', '1');
      setDemoStepIndex(0);
      (FLOW ? Promise.resolve(FLOW) : loadFlow()).then(function () { renderDemoStep(); });
    }

    function closeDemoWalkthrough() {
      var panel = document.getElementById('demo-walkthrough');
      if (panel) panel.style.display = 'none';
      // Keep state so it can be resumed — do not clear moke_demo_active
    }

    function completeDemoWalkthrough() {
      var panel = document.getElementById('demo-walkthrough');
      if (panel) panel.style.display = 'none';
      sessionStorage.removeItem('moke_demo_active');
      sessionStorage.removeItem('moke_demo_step');
    }

    // Resume if active. The flow is fetched first, so the button label and the
    // panel both reflect a real step count rather than a hardcoded one.
    (function () {
      var active = sessionStorage.getItem('moke_demo_active') === '1';
      var btn = document.getElementById('start-demo-btn');
      if (!active) return;
      loadFlow().then(function (flow) {
        if (!flow) return;
        renderDemoStep();
        var step = demoStepIndex();
        if (btn && step > 0 && step < flow.steps.length) {
          btn.innerHTML = '<span style="font-size:1.1em;">&#9654;</span> Resume Demo';
        }
      });
    })();
  </script>

</body>
</html>

    'customer_intel': {
      name: 'Customer Behaviour Analysis',
      description: '1,000 synthetic customers, 4 sharpened clusters (Whales / At-risk / Growth / Dormant), 30 deliberate anomalies — perfect for k-means clustering demo',
      sensitivity: 'CONFIDENTIAL',
      category: 'Customer Intelligence',
      headers: ['customer_id','pii_name','pii_email','pii_phone','age','region','tenure_days','ltv','orders_ytd','avg_order_value','category_affinity','nps_score','churn_risk','last_purchase_days','support_tickets','email_domain','payment_method','referral_source','acquisition_date','last_login_days','email_open_rate','cart_abandonment_rate','preferred_channel','lifetime_orders','returns_count','social_sentiment'],
      descriptions: {
        customer_id: 'Unique customer identifier',
        pii_name: 'Customer full name (PII)',
        pii_email: 'Customer email address (PII)',
        pii_phone: 'Customer phone number (PII)',
        age: 'Customer age in years',
        region: 'Australian state/territory',
        tenure_days: 'Days since first purchase',
        ltv: 'Customer lifetime value ($)',
        orders_ytd: 'Orders placed year-to-date',
        avg_order_value: 'Average order value ($)',
        category_affinity: 'Preferred product category',
        nps_score: 'Net Promoter Score (0-10)',
        churn_risk: 'Churn risk level (low/med/high)',
        last_purchase_days: 'Days since last purchase',
        support_tickets: 'Support tickets opened YTD',
        email_domain: 'Email provider domain',
        payment_method: 'Preferred payment method',
        referral_source: 'Acquisition channel',
        acquisition_date: 'Date customer was acquired (YYYY-MM-DD)',
        last_login_days: 'Days since last platform login',
        email_open_rate: 'Email open rate (0.0-1.0)',
        cart_abandonment_rate: 'Cart abandonment rate (0.0-1.0)',
        preferred_channel: 'Preferred shopping channel (web/app/store)',
        lifetime_orders: 'Total orders placed lifetime',
        returns_count: 'Total items returned lifetime',
        social_sentiment: 'Social media sentiment score (-1.0 to 1.0)'
      },
      pii: ['pii_name','pii_email','pii_phone'],
      rows: (function() {
        // MK8.10 — Generate 1,000 customers with 4 sharpened clusters
        // Seeded PRNG for deterministic generation
        var seed = 20260520;
        function rng() { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; }
        function randInt(lo, hi) { return lo + Math.floor(rng() * (hi - lo + 1)); }
        function randFloat(lo, hi, dp) { var v = lo + rng() * (hi - lo); return parseFloat(v.toFixed(dp !== undefined ? dp : 2)); }
        function pick(arr) { return arr[Math.floor(rng() * arr.length)]; }

        var firstNames = ['Oliver','Jack','Noah','William','James','Liam','Ethan','Lucas','Mason','Logan','Alexander','Henry','Sebastian','Benjamin','Thomas','Leo','Mateo','Daniel','Owen','Samuel','Charlotte','Amelia','Olivia','Isla','Mia','Ava','Grace','Chloe','Ella','Sophie','Zoe','Lily','Harper','Ruby','Willow','Ivy','Sienna','Aria','Luna','Evelyn','Lachlan','Cooper','Riley','Harrison','Hunter','Kai','Archie','Charlie','Max','Oscar','Jasper','Hudson','Angus','Hugo','Finn','Hamish','Callum','Declan','Toby','Felix','Georgie','Phoebe','Matilda','Poppy','Frankie','Scarlett','Harriet','Eloise','Imogen','Penelope','Celeste','Vivienne','Margot','Adelaide','Clementine','Genevieve','Rosalind','Cordelia','Arabella','Beatrice'];
        var lastNames = ['Smith','Jones','Williams','Brown','Wilson','Taylor','Johnson','White','Martin','Anderson','Thompson','Nguyen','Walker','Harris','Lee','Robinson','Clark','Lewis','Young','Hall','Chen','Patel','Kim','Tran','O\'Brien','Murphy','Kelly','Sullivan','Walsh','Burke','Scott','Adams','Mitchell','Carter','Phillips','Evans','Turner','Collins','Stewart','Morgan','Ryan','Campbell','Murray','King','Hughes','Bennett','Foster','Grant','Mason','Palmer','Brennan','Drummond','Fitzgerald','Kowalski','Papadopoulos','Santos','Mendez','Al-Hassan','Russo','Okafor'];
        var suburbs = [
          {s:'Surry Hills',pc:'2010',st:'NSW'},{s:'Newtown',pc:'2042',st:'NSW'},{s:'Bondi',pc:'2026',st:'NSW'},
          {s:'Parramatta',pc:'2150',st:'NSW'},{s:'Manly',pc:'2095',st:'NSW'},{s:'Chatswood',pc:'2067',st:'NSW'},
          {s:'Penrith',pc:'2750',st:'NSW'},{s:'Liverpool',pc:'2170',st:'NSW'},{s:'Randwick',pc:'2031',st:'NSW'},
          {s:'Redfern',pc:'2016',st:'NSW'},{s:'Castle Hill',pc:'2154',st:'NSW'},{s:'Mosman',pc:'2088',st:'NSW'},
          {s:'Fitzroy',pc:'3065',st:'VIC'},{s:'St Kilda',pc:'3182',st:'VIC'},{s:'Richmond',pc:'3121',st:'VIC'},
          {s:'South Yarra',pc:'3141',st:'VIC'},{s:'Carlton',pc:'3053',st:'VIC'},{s:'Brunswick',pc:'3056',st:'VIC'},
          {s:'Footscray',pc:'3011',st:'VIC'},{s:'Doncaster',pc:'3108',st:'VIC'},{s:'Brighton',pc:'3186',st:'VIC'},
          {s:'West End',pc:'4101',st:'QLD'},{s:'Paddington',pc:'4064',st:'QLD'},{s:'Fortitude Valley',pc:'4006',st:'QLD'},
          {s:'Toowoomba',pc:'4350',st:'QLD'},{s:'Cairns City',pc:'4870',st:'QLD'},{s:'Southport',pc:'4215',st:'QLD'},
          {s:'Norwood',pc:'5067',st:'SA'},{s:'Glenelg',pc:'5045',st:'SA'},{s:'Adelaide CBD',pc:'5000',st:'SA'},
          {s:'Fremantle',pc:'6160',st:'WA'},{s:'Subiaco',pc:'6008',st:'WA'},{s:'Cottesloe',pc:'6011',st:'WA'},
          {s:'Braddon',pc:'2612',st:'ACT'},{s:'Kingston',pc:'2604',st:'ACT'},
          {s:'Sandy Bay',pc:'7005',st:'TAS'},{s:'Battery Point',pc:'7004',st:'TAS'},
          {s:'Parap',pc:'0820',st:'NT'},{s:'Stuart Park',pc:'0820',st:'NT'}
        ];
        var domains = ['gmail.com','outlook.com','hotmail.com','yahoo.com','icloud.com'];
        var categories = ['electronics','fashion','homeware','beauty','sports','books','appliances','general'];
        var luxuryCategories = ['electronics','fashion','homeware','appliances','luxury'];
        var payments = ['card','afterpay','paypal'];
        var sources = ['organic','social','referral','email','paid','direct'];
        var channels = ['web','app','store'];

        function dateFromDaysAgo(days) {
          var d = new Date(2026, 4, 20);
          d.setDate(d.getDate() - days);
          var mm = ('0' + (d.getMonth() + 1)).slice(-2);
          var dd = ('0' + d.getDate()).slice(-2);
          return d.getFullYear() + '-' + mm + '-' + dd;
        }

        function pad4(n) { return ('0000' + n).slice(-4); }

        var rows = [];

        // ── Cluster 1: Growth (40% = 400, CUST-0001..0400) ──
        // Increasing spend trajectory, moderate tenure, rising orders, high engagement
        for (var i = 1; i <= 400; i++) {
          var fn = pick(firstNames), ln = pick(lastNames);
          var name = fn + ' ' + ln;
          var emailLocal = fn.toLowerCase() + '.' + ln.toLowerCase().replace(/'/g, '');
          var dom = pick(domains);
          var email = emailLocal + '@' + dom;
          var phone = '+61 4' + randInt(10,29) + ' ' + randInt(100,999) + ' ' + randInt(100,999);
          var loc = pick(suburbs);
          var age = randInt(20, 38);
          var tenure = randInt(60, 540);
          var ordersYtd = randInt(6, 20);
          var avgOV = randFloat(8, 65, 2);
          var ltv = parseFloat((ordersYtd * avgOV * randFloat(0.8, 1.6, 2)).toFixed(2));
          var nps = randInt(6, 9);
          var lastPurch = randInt(1, 30);
          var tickets = randInt(0, 2);
          var cat = pick(categories);
          var pay = pick(payments);
          var src = pick(sources);
          var acqDate = dateFromDaysAgo(tenure);
          var lastLogin = randInt(0, 5);
          var openRate = randFloat(0.35, 0.72, 2);
          var cartAband = randFloat(0.10, 0.35, 2);
          var channel = pick(channels);
          var lifetimeOrders = ordersYtd + randInt(2, 15);
          var returns = randInt(0, 3);
          var sentiment = randFloat(0.1, 0.8, 2);
          rows.push(['CUST-' + pad4(i), name, email, phone, String(age), loc.st, String(tenure), String(ltv), String(ordersYtd), String(avgOV), cat, String(nps), 'low', String(lastPurch), String(tickets), dom, pay, src, acqDate, String(lastLogin), String(openRate), String(cartAband), channel, String(lifetimeOrders), String(returns), String(sentiment)]);
        }

        // ── Cluster 2: At-risk (20% = 200, CUST-0401..0600) ──
        // High historical spend but declining frequency
        for (var i = 401; i <= 600; i++) {
          var fn = pick(firstNames), ln = pick(lastNames);
          var name = fn + ' ' + ln;
          var emailLocal = fn.charAt(0).toLowerCase() + '.' + ln.toLowerCase().replace(/'/g, '');
          var dom = pick(domains);
          var email = emailLocal + '@' + dom;
          var phone = '+61 4' + randInt(30,49) + ' ' + randInt(100,999) + ' ' + randInt(100,999);
          var loc = pick(suburbs);
          var age = randInt(30, 58);
          var tenure = randInt(400, 1800);
          var ordersYtd = randInt(0, 3);
          var avgOV = randFloat(60, 180, 2);
          var ltv = parseFloat((randFloat(400, 2800, 2)).toFixed(2));
          var nps = randInt(3, 6);
          var lastPurch = randInt(60, 170);
          var tickets = randInt(2, 7);
          var cat = pick(categories);
          var pay = pick(payments);
          var src = pick(sources);
          var acqDate = dateFromDaysAgo(tenure);
          var lastLogin = randInt(30, 120);
          var openRate = randFloat(0.05, 0.25, 2);
          var cartAband = randFloat(0.45, 0.80, 2);
          var channel = pick(channels);
          var lifetimeOrders = randInt(15, 60);
          var returns = randInt(3, 12);
          var sentiment = randFloat(-0.5, 0.15, 2);
          rows.push(['CUST-' + pad4(i), name, email, phone, String(age), loc.st, String(tenure), String(ltv), String(ordersYtd), String(avgOV), cat, String(nps), 'high', String(lastPurch), String(tickets), dom, pay, src, acqDate, String(lastLogin), String(openRate), String(cartAband), channel, String(lifetimeOrders), String(returns), String(sentiment)]);
        }

        // ── Cluster 3: Dormant (18% = 180, CUST-0601..0780) ──
        // >180 days inactive, zero recent orders, low engagement
        for (var i = 601; i <= 780; i++) {
          var fn = pick(firstNames), ln = pick(lastNames);
          var name = fn + ' ' + ln;
          var emailLocal = fn.toLowerCase() + '.' + ln.toLowerCase().replace(/'/g, '');
          var dom = pick(domains);
          var email = emailLocal + '@' + dom;
          var phone = '+61 4' + randInt(50,69) + ' ' + randInt(100,999) + ' ' + randInt(100,999);
          var loc = pick(suburbs);
          var age = randInt(25, 65);
          var tenure = randInt(600, 3200);
          var ordersYtd = 0;
          var avgOV = 0;
          var ltv = parseFloat((randFloat(0, 1200, 2)).toFixed(2));
          var nps = randInt(0, 4);
          var lastPurch = randInt(181, 900);
          var tickets = randInt(0, 2);
          var cat = 'none';
          var pay = pick(payments);
          var src = pick(sources);
          var acqDate = dateFromDaysAgo(tenure);
          var lastLogin = randInt(180, 800);
          var openRate = randFloat(0.0, 0.08, 2);
          var cartAband = randFloat(0.0, 0.10, 2);
          var channel = pick(channels);
          var lifetimeOrders = randInt(1, 12);
          var returns = randInt(0, 4);
          var sentiment = randFloat(-0.3, 0.05, 2);
          rows.push(['CUST-' + pad4(i), name, email, phone, String(age), loc.st, String(tenure), String(ltv), String(ordersYtd), String(avgOV), cat, String(nps), 'high', String(lastPurch), String(tickets), dom, pay, src, acqDate, String(lastLogin), String(openRate), String(cartAband), channel, String(lifetimeOrders), String(returns), String(sentiment)]);
        }

        // ── Cluster 4: Whales (top 2% = 20, CUST-0781..0800) ──
        // Extremely high LTV, frequent orders, high engagement
        var whaleFirsts = ['Rupert','Vivienne','Archibald','Cordelia','Montgomery','Anastasia','Sebastian','Celeste','Leopold','Octavia','Thaddeus','Beatrix','Constantine','Gwendoline','Percival','Rosalind','Maximilian','Evangeline','Bartholomew','Isadora'];
        var whaleLasts = ['Ashworth','Blackwood','Forsythe','Hartley','Slade','Pemberton','Whitmore','Drummond','Fairfax','Sinclair','Vane','Cavendish','Worthington','Beaumont','Stirling','Montague','Kensington','Aldridge','Thornton','Waverly'];
        for (var i = 0; i < 20; i++) {
          var idx = 781 + i;
          var fn = whaleFirsts[i], ln = whaleLasts[i];
          var name = fn + ' ' + ln;
          var emailLocal = fn.toLowerCase() + '.' + ln.toLowerCase();
          var dom = pick(['icloud.com','gmail.com','icloud.com']);
          var email = emailLocal + '@' + dom;
          var phone = '+61 4' + randInt(90,99) + ' ' + randInt(100,999) + ' ' + randInt(100,999);
          var loc = pick([suburbs[4], suburbs[5], suburbs[11], suburbs[15], suburbs[20], suburbs[32]]);
          var age = randInt(38, 68);
          var tenure = randInt(1800, 4000);
          var ordersYtd = randInt(12, 36);
          var avgOV = randFloat(800, 2200, 2);
          var ltv = parseFloat((randFloat(15000, 58000, 2)).toFixed(2));
          var nps = randInt(8, 10);
          var lastPurch = randInt(1, 14);
          var tickets = randInt(0, 1);
          var cat = pick(luxuryCategories);
          var pay = 'card';
          var src = pick(['direct','referral']);
          var acqDate = dateFromDaysAgo(tenure);
          var lastLogin = randInt(0, 3);
          var openRate = randFloat(0.70, 0.95, 2);
          var cartAband = randFloat(0.02, 0.12, 2);
          var channel = pick(['app','store']);
          var lifetimeOrders = ordersYtd + randInt(30, 120);
          var returns = randInt(0, 3);
          var sentiment = randFloat(0.6, 1.0, 2);
          rows.push(['CUST-' + pad4(idx), name, email, phone, String(age), loc.st, String(tenure), String(ltv), String(ordersYtd), String(avgOV), cat, String(nps), 'low', String(lastPurch), String(tickets), dom, pay, src, acqDate, String(lastLogin), String(openRate), String(cartAband), channel, String(lifetimeOrders), String(returns), String(sentiment)]);
        }

        // ── Remaining regular (170, CUST-0801..0970) ──
        // Mid-tier, moderate everything
        for (var i = 801; i <= 970; i++) {
          var fn = pick(firstNames), ln = pick(lastNames);
          var name = fn + ' ' + ln;
          var emailLocal = fn.toLowerCase() + '.' + ln.toLowerCase().replace(/'/g, '');
          var dom = pick(domains);
          var email = emailLocal + '@' + dom;
          var phone = '+61 4' + randInt(10,89) + ' ' + randInt(100,999) + ' ' + randInt(100,999);
          var loc = pick(suburbs);
          var age = randInt(22, 60);
          var tenure = randInt(100, 1400);
          var ordersYtd = randInt(2, 10);
          var avgOV = randFloat(25, 140, 2);
          var ltv = parseFloat((ordersYtd * avgOV * randFloat(0.6, 1.4, 2)).toFixed(2));
          var nps = randInt(5, 8);
          var lastPurch = randInt(5, 60);
          var tickets = randInt(0, 3);
          var cat = pick(categories);
          var pay = pick(payments);
          var src = pick(sources);
          var acqDate = dateFromDaysAgo(tenure);
          var lastLogin = randInt(1, 30);
          var openRate = randFloat(0.20, 0.55, 2);
          var cartAband = randFloat(0.15, 0.50, 2);
          var channel = pick(channels);
          var lifetimeOrders = ordersYtd + randInt(3, 25);
          var returns = randInt(0, 5);
          var sentiment = randFloat(-0.1, 0.5, 2);
          rows.push(['CUST-' + pad4(i), name, email, phone, String(age), loc.st, String(tenure), String(ltv), String(ordersYtd), String(avgOV), cat, String(nps), 'medium', String(lastPurch), String(tickets), dom, pay, src, acqDate, String(lastLogin), String(openRate), String(cartAband), channel, String(lifetimeOrders), String(returns), String(sentiment)]);
        }

        // ── Anomalies (30, CUST-0971..1000) ──
        // Suspicious patterns: disposable emails, high velocity
        var anomalyDomains = ['proton.me','tempmail.net','mailinator.com','yopmail.com','throwam.com','guerrillamail.com','fakeinbox.com','trashmail.org','sharklasers.com','grr.la'];
        for (var i = 971; i <= 1000; i++) {
          var fn = pick(firstNames), ln = pick(lastNames);
          var name = fn + ' ' + ln;
          var emailLocal = fn.toLowerCase() + randInt(10,99);
          var dom = pick(anomalyDomains);
          var email = emailLocal + '@' + dom;
          var phone = '+61 4' + randInt(0,9) + randInt(0,9) + ' ' + randInt(100,999) + ' ' + randInt(100,999);
          var loc = pick(suburbs);
          var age = randInt(22, 40);
          var tenure = randInt(3, 45);
          var ordersYtd = randInt(8, 24);
          var avgOV = randFloat(30, 55, 2);
          var ltv = parseFloat((ordersYtd * avgOV).toFixed(2));
          var nps = randInt(3, 6);
          var lastPurch = randInt(0, 3);
          var tickets = randInt(6, 16);
          var cat = pick(['electronics','general']);
          var pay = pick(['prepaid','card']);
          var src = 'direct';
          var acqDate = dateFromDaysAgo(tenure);
          var lastLogin = randInt(0, 1);
          var openRate = randFloat(0.0, 0.10, 2);
          var cartAband = randFloat(0.60, 0.95, 2);
          var channel = 'web';
          var lifetimeOrders = ordersYtd;
          var returns = randInt(4, 12);
          var sentiment = randFloat(-0.8, -0.2, 2);
          rows.push(['CUST-' + pad4(i), name, email, phone, String(age), loc.st, String(tenure), String(ltv), String(ordersYtd), String(avgOV), cat, String(nps), 'high', String(lastPurch), String(tickets), dom, pay, src, acqDate, String(lastLogin), String(openRate), String(cartAband), channel, String(lifetimeOrders), String(returns), String(sentiment)]);
        }

        return rows;
      })()
    }
  };

  // MK8.7 — Cross-dataset relationships registry
  var DATASET_RELATIONSHIPS = {
    'it_hardware.server_inventory': {
      primary_key: 'server_id',
      relationships: [
        { target: 'it_hardware.performance_metrics', foreign_key: 'server_id', type: 'one_to_many', label: 'Performance metrics' }
      ]
    },
    'it_hardware.performance_metrics': {
      primary_key: ['server_id', 'timestamp'],
      relationships: [
        { target: 'it_hardware.server_inventory', foreign_key: 'server_id', type: 'many_to_one', label: 'Server hardware' }
      ]
    },
    'it_platform.wc_users': {
      primary_key: 'user_id',
      relationships: [
        { target: 'it_platform.wc_orders', foreign_key: 'user_id', type: 'one_to_many', label: 'Customer orders' }
      ]
    },
    'it_platform.wc_orders': {
      primary_key: 'order_id',
      relationships: [
        { target: 'it_platform.wc_users', foreign_key: 'user_id', type: 'many_to_one', label: 'Customer profile' }
      ]
    }
  };

  function getRelatedDatasets(datasetKey) {
    var entry = DATASET_RELATIONSHIPS[datasetKey];
    if (!entry) return [];
    return entry.relationships.map(function(rel) {
      var targetDs = DATASETS[rel.target];
      return {
        dataset: rel.target,
        name: targetDs ? targetDs.name : rel.target,
        foreign_key: rel.foreign_key,
        type: rel.type,
        label: rel.label
      };
    });
  }

  function suggestCrossQueries(datasetKey) {
    var suggestions = {
      'it_hardware.server_inventory': [
        'Show servers with critical CPU or RAM alerts in the latest metrics',
        'List servers where warranty has expired and performance is degraded',
        'Compare average CPU utilisation between SYD and MEL data centres',
        'Which servers have the highest load average in the most recent readings?',
        'Show all servers with warning or critical alert levels and their hardware specs'
      ],
      'it_hardware.performance_metrics': [
        'Show the 09:00 CPU spike pattern — which servers are most affected?',
        'Identify servers with gradual memory leaks over the 7-day window',
        'Plot disk latency trend for SRV-037 — is there degradation before failure?',
        'Which servers show correlated network throughput and error rate spikes?',
        'Compare average response times between SYD and MEL data centre servers'
      ],
      'it_platform.wc_users': [
        'Show total order value by customer segment',
        'Which VIP customers have placed orders in the last 30 days?',
        'List users with high lifetime value but no recent orders',
        'Compare average order size between new and loyal customers',
        'Show inactive users who have outstanding orders'
      ],
      'it_platform.wc_orders': [
        'Show customer details for orders over $500',
        'Which customer segment generates the most revenue?',
        'List orders from VIP customers with coupon codes applied',
        'Compare order frequency between states for loyal customers',
        'Show orders from customers who joined in the last 6 months'
      ]
    };
    return suggestions[datasetKey] || [];
  }

  function loadDataset(id, selectorId) {
    var d = DATASETS[id];
    if (!d) return;
    var sensitivity = d.sensitivity;
    if (selectorId) {
      var selEl = document.getElementById(selectorId);
      if (selEl && selEl.value) sensitivity = selEl.value;
    }
    // MK8.2 — Resolve generated rows on first load (lazy generation)
    var rows = d.rows;
    if (!rows && typeof d.generate === 'function') {
      rows = d.generate();
      d.rows = rows; // Cache so we only generate once
    }
    var ds = {
      id: id, name: d.name, sensitivity: sensitivity,
      category: d.category, headers: d.headers, pii: d.pii,
      rows: rows, loadedAt: Date.now()
    };

    // Add to project dataset list
    var projectDs = JSON.parse(localStorage.getItem('moke_project_datasets') || '[]');
    var existing = projectDs.findIndex(function(p) { return p.id === id; });
    if (existing >= 0) {
      projectDs[existing] = { id: id, name: d.name, rows: rows.length, sensitivity: sensitivity, loadedAt: Date.now() };
    } else {
      projectDs.push({ id: id, name: d.name, rows: rows.length, sensitivity: sensitivity, loadedAt: Date.now() });
    }
    localStorage.setItem('moke_project_datasets', JSON.stringify(projectDs));

    // Set as active dataset
    sessionStorage.setItem('moke_dataset', JSON.stringify(ds));
    window.location.href = '/chat';
  }

  // MK4.9.3 — Multi-dataset project support
  function refreshLoadedDatasets() {
    var bar = document.getElementById('project-datasets-bar');
    var list = document.getElementById('project-datasets-list');
    if (!bar || !list) return;
    var projectDs = JSON.parse(localStorage.getItem('moke_project_datasets') || '[]');
    if (projectDs.length === 0) { bar.style.display = 'none'; return; }
    bar.style.display = 'block';
    list.innerHTML = '';
    var activeDs = null;
    try { activeDs = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch(_) {}
    projectDs.forEach(function(d) {
      var chip = document.createElement('div');
      var isActive = activeDs && activeDs.id === d.id;
      chip.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:20px;font-size:0.82em;cursor:pointer;border:1px solid ' + (isActive ? 'var(--teal)' : 'var(--border)') + ';color:' + (isActive ? 'var(--teal)' : 'var(--text)') + ';background:' + (isActive ? 'var(--teal-dim)' : 'transparent');
      chip.innerHTML = d.name + ' <span style="color:var(--muted);font-size:0.85em;">' + d.rows + ' rows</span>';
      chip.onclick = function() { switchToDataset(d.id); };
      list.appendChild(chip);
    });
  }

  function switchToDataset(id) {
    var d = DATASETS[id];
    if (!d) return;
    var ds = { id: id, name: d.name, sensitivity: d.sensitivity, category: d.category, headers: d.headers, pii: d.pii, rows: d.rows, loadedAt: Date.now() };
    sessionStorage.setItem('moke_dataset', JSON.stringify(ds));
    window.location.href = '/chat';
  }

  function clearProject() {
    localStorage.removeItem('moke_project_datasets');
    sessionStorage.removeItem('moke_dataset');
    refreshLoadedDatasets();
  }

  refreshLoadedDatasets();

  // MK4.9.4 — Inject column description info into dataset cards
  (function() {
    document.querySelectorAll('.load-btn').forEach(function(btn) {
      var oc = btn.getAttribute('onclick') || '';
      var m = oc.match(/loadDataset\('([^']+)'/);
      if (!m) return;
      var id = m[1];
      var d = DATASETS[id];
      if (!d || !d.descriptions) return;
      var count = Object.keys(d.descriptions).length;
      if (count === 0) return;
      var meta = btn.closest('.ds-card').querySelector('.ds-meta');
      if (!meta) return;
      var sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = '\u00b7';
      var info = document.createElement('span');
      info.style.cssText = 'cursor:help;';
      info.title = Object.keys(d.descriptions).map(function(k) { return k + ': ' + d.descriptions[k]; }).join('\n');
      info.textContent = '\u2139\ufe0f ' + count + ' cols described';
      meta.appendChild(sep);
      meta.appendChild(info);
    });
  })();

  // MK1.6 — Inject sensitivity selectors into all dataset cards at page load
  (function() {
    document.querySelectorAll('.load-btn').forEach(function(btn) {
      var oc = btn.getAttribute('onclick') || '';
      var m = oc.match(/loadDataset\('([^']+)'\)/);
      if (!m) return;
      var id = m[1];
      var d = DATASETS[id];
      if (!d) return;
      var defaultSens = d.sensitivity || 'INTERNAL';
      var selId = 'sens-' + id.replace(/[.\/_]/g, '-');
      var sel = document.createElement('select');
      sel.className = 'sens-select' + (defaultSens === 'RESTRICTED' ? ' restricted' : '');
      sel.id = selId;
      sel.title = 'Override sensitivity classification before loading';
      ['PUBLIC', 'INTERNAL', 'CONFIDENTIAL', 'RESTRICTED'].forEach(function(s) {
        var opt = document.createElement('option');
        opt.value = s;
        opt.textContent = s;
        if (s === defaultSens) opt.selected = true;
        sel.appendChild(opt);
      });
      sel.addEventListener('change', function() {
        sel.className = 'sens-select' + (sel.value === 'RESTRICTED' ? ' restricted' : '');
      });
      // Update onclick to pass the selector id so loadDataset can read the override
      btn.setAttribute('onclick', "loadDataset('" + id + "', '" + selId + "')");
      btn.parentNode.insertBefore(sel, btn);
    });
  })();
</script>
{! end !}

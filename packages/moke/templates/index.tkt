<script>
  var DATASETS = {
    'au.medicare': (function() {
      var firstNames = ['John','Sarah','Mohammed','Emma','Nguyen Thi','David','Olivia','Liam','Amelia','Ethan','Isabelle','William','Chloe','Noah','Charlotte','Mason','Ava','Jack','Mia','Henry','Grace','Lucas','Sophia','James','Lily','Oliver','Ella','Ryan','Zoe','Emily','Daniel','Hannah','Ben','Sophie','Thomas','Jessica','Alexander','Priya','Samuel','Fatima','Chen Wei','Aisha','Marcus','Rachel','Patrick','Mei-Ling','Kenji','Ananya','Carlos','Rebecca'];
      var lastNames = ['Smith','Chen','Al-Rashid','Thompson','Lan','Nguyen','Patel','O\'Brien','Johnson','Clarke','Martin','Scott','Williams','Davis','Taylor','Robinson','Anderson','Wilson','Brown','Lee','Martinez','Brennan','Kim','Zhang','Harris','White','Murphy','Adams','Park','Santos','Kowalski','Walsh','Russo','Mendez','Nair','Okafor','Al-Hassan','Sharma','Fitzgerald','Papadopoulos'];
      var providerFirsts = ['Angela','Michael','Priya','James','Rebecca','Fatima','Thomas','Sandra','Carlos','David','Jennifer','Andrew','Lisa','Peter','Maria'];
      var providerLasts = ['Russo','Okafor','Nair','Kowalski','Walsh','Al-Hassan','Brennan','Kim','Mendez','Liu','Stavros','Morrison','Tran','Chen','Santos'];
      var specialties = ['GP','GP','GP','GP','GP','Specialist','Radiology','Cardiology','Orthopaedics','Ophthalmology','Psychiatry','Dermatology','Gastroenterology','ENT','Obstetrics'];
      var facilityTypes = ['Private Rooms','Private Rooms','Private Rooms','Community Health','Telehealth','Private Hospital','Radiology Centre','Day Surgery','Day Hospital','Aged Care Facility'];
      var mStates = ['NSW','VIC','QLD','SA','WA','TAS','NT','ACT'];
      var statePostcodes = {NSW:['2000','2010','2035','2040','2042','2044','2067'],VIC:['3000','3002','3010','3058','3066','3101','3141'],QLD:['4000','4010','4051','4064','4101'],SA:['5000','5001','5067'],WA:['6000','6005','6010'],TAS:['7000','7004'],NT:['0800','0810'],ACT:['2600','2601']};
      var diagCodes = ['Z00.0','J06.9','I10','M54.5','R51','Z23','R00.0','E11.9','Z12.1','F32.1','J18.9','Z34.0','I25.1','M79.3','F20.0','J30.1','N39.0','H26.9','Z71.1','K21.0','J00','E78.5','M51.1','I50.0','L20.9','I48.0','F41.1','J11.1','K29.7','G43.9','M17.1','E03.9','D50.9','J45.9','N40.0'];
      var procCodes = ['10900','10991','10997','11000','12000','14224','39000','42738','49519','55844','55862'];
      var paymentMethods = ['EFT','EFT','EFT','EFT','Credit Card'];
      var itemsBySpecialty = {
        GP: [{item:'3',fee:18.55},{item:'23',fee:37.05},{item:'36',fee:72.75},{item:'44',fee:105.60},{item:'51',fee:55.20},{item:'57',fee:75.00},{item:'104',fee:88.00},{item:'105',fee:90.40},{item:'6',fee:37.05}],
        Specialist: [{item:'110',fee:185.00},{item:'116',fee:150.80},{item:'104',fee:88.00}],
        Radiology: [{item:'5020',fee:310.00},{item:'5028',fee:280.00},{item:'5049',fee:420.00}],
        Cardiology: [{item:'289',fee:143.25},{item:'292',fee:165.00},{item:'11700',fee:210.00}],
        Orthopaedics: [{item:'116',fee:680.00},{item:'49519',fee:820.00},{item:'47804',fee:540.00}],
        Ophthalmology: [{item:'5000',fee:820.00},{item:'42702',fee:620.00}],
        Psychiatry: [{item:'721',fee:420.00},{item:'296',fee:280.00}],
        Dermatology: [{item:'110',fee:160.00},{item:'116',fee:185.00}],
        Gastroenterology: [{item:'30473',fee:380.00},{item:'30478',fee:440.00}],
        ENT: [{item:'41764',fee:310.00},{item:'41632',fee:260.00}],
        Obstetrics: [{item:'16500',fee:280.00},{item:'16519',fee:340.00}]
      };
      var gapRanges = {
        GP: [0,0,0,0,0,0,0,0,15,25],
        Specialist: [0,0,79.40,120.00,150.00,250.00],
        Radiology: [0,0,0,45.00,80.00],
        Cardiology: [0,0,0,65.00,110.00],
        Orthopaedics: [0,180.00,350.00,529.20,680.00],
        Ophthalmology: [0,240.00,540.00,680.00],
        Psychiatry: [0,0,0,120.00],
        Dermatology: [0,0,85.00,120.00],
        Gastroenterology: [0,0,150.00,280.00],
        ENT: [0,0,110.00,180.00],
        Obstetrics: [0,0,80.00,160.00]
      };
      var bulkBillRate = {NSW:0.72,VIC:0.78,QLD:0.80,SA:0.82,WA:0.68,TAS:0.85,NT:0.88,ACT:0.70};
      var noteTemplates = {
        GP: ['Routine health assessment.','Extended consult for respiratory symptoms.','Review of hypertension management plan.','Short consultation for influenza vaccination.','Diabetes review and medication script renewal.','Youth health check, screening referral issued.','Mental health care plan initiated.','Afterhours consultation for acute presentation.','Urinary tract infection — antibiotic prescribed.','Dietary counselling session.','GORD and medication review.','Common cold — symptomatic advice.','Lipid panel ordered for hyperlipidaemia review.','Generalised anxiety disorder review.','Atopic dermatitis flare — topical treatment.','Annual health assessment.','Chronic disease management review.','Flu-like symptoms — seasonal influenza suspected.'],
        Specialist: ['Specialist consultation for lower back pain.','Specialist review and treatment plan.','Follow-up specialist assessment.'],
        Radiology: ['MRI brain without contrast for chronic headache.','Lumbar spine MRI — disc prolapse suspected.','CT abdomen and pelvis with contrast.'],
        Cardiology: ['Echocardiogram and cardiology review.','Stress ECG performed.','Cardiology review for rhythm abnormality.'],
        Orthopaedics: ['Knee arthroscopy — large gap due to specialist fee.','Shoulder reconstruction follow-up.','Hip replacement pre-assessment.'],
        Ophthalmology: ['Cataract extraction — large gap above MBS schedule.','Retinal assessment for diabetic eye disease.'],
        Psychiatry: ['Inpatient psychiatric admission.','Outpatient psychiatry review.'],
        Dermatology: ['Skin lesion assessment and biopsy.','Dermatology review for chronic eczema.'],
        Gastroenterology: ['Colonoscopy — routine screening.','Upper endoscopy for dyspepsia.'],
        ENT: ['Tonsillectomy assessment.','Hearing assessment and ENT review.'],
        Obstetrics: ['Antenatal consultation.','Obstetric ultrasound review.']
      };
      var seed = 101;
      function rand() { seed = (seed * 16807 + 0) % 2147483647; return (seed - 1) / 2147483646; }
      function pick(arr) { return arr[Math.floor(rand() * arr.length)]; }
      function pad2(n) { return n < 10 ? '0' + n : '' + n; }
      function fmtDate(d) { return d.getFullYear() + '-' + pad2(d.getMonth()+1) + '-' + pad2(d.getDate()); }
      function money(v) { return (Math.round(v * 100) / 100).toFixed(2); }
      var rows = [];
      var startMs = new Date('2024-01-01').getTime();
      var endMs = new Date('2024-12-31').getTime();
      var rangeMs = endMs - startMs;
      var patientIds = [];
      for (var p = 0; p < 200; p++) patientIds.push('PAT-' + String(10000 + Math.floor(rand() * 90000)));
      var providers = [];
      for (var pv = 0; pv < 30; pv++) {
        var pFirst = pick(providerFirsts); var pLast = pick(providerLasts);
        providers.push({id:'PROV-' + String(1000 + Math.floor(rand() * 9000)), name:'Dr ' + pFirst + ' ' + pLast, specialty: pick(specialties)});
      }
      var dupIndices = {};
      for (var di = 0; di < 10; di++) {
        var didx; do { didx = Math.floor(rand() * 500); } while (didx < 2 || dupIndices[didx]);
        dupIndices[didx] = Math.floor(rand() * didx);
      }
      for (var i = 0; i < 500; i++) {
        var claimId = 'MBS-2024-' + String(i + 1).padStart(6, '0');
        var isDup = dupIndices[i] !== undefined;
        var patIdx, patId, patName, dob, medNum, provider, specialty, mState, postcode, serviceDate, itemInfo, scheduleFee, gapAmount, benefitPaid, bulkBilled, exceptional, mStatus, note, followUp, rebatePct;
        if (isDup && rows.length > dupIndices[i]) {
          var orig = rows[dupIndices[i]];
          patId = orig[1]; patName = orig[2]; dob = orig[3]; medNum = orig[4];
          provider = {id: orig[5], name: orig[6]};
          specialty = orig[12]; mState = orig[14]; postcode = orig[15];
          serviceDate = orig[8]; scheduleFee = parseFloat(orig[10]); gapAmount = 0; benefitPaid = scheduleFee;
          bulkBilled = orig[22]; exceptional = 'false'; mStatus = 'DUPLICATE';
          note = 'DUPLICATE \u2014 resubmission of claim ' + orig[0] + '.';
          followUp = 'false'; rebatePct = orig[27];
          rows.push([claimId, patId, patName, dob, medNum, provider.id, provider.name, orig[7], serviceDate, money(benefitPaid), money(scheduleFee), money(gapAmount), specialty, orig[13], mState, postcode, orig[16], orig[17], orig[18], orig[19], orig[20], orig[21], bulkBilled, exceptional, note, mStatus, followUp, rebatePct]);
          continue;
        }
        patIdx = Math.floor(rand() * 200);
        patId = patientIds[patIdx];
        patName = pick(firstNames) + ' ' + pick(lastNames);
        var dobYear = 1940 + Math.floor(rand() * 65);
        var dobMonth = Math.floor(rand() * 12) + 1;
        var dobDay = Math.floor(rand() * 28) + 1;
        dob = dobYear + '-' + pad2(dobMonth) + '-' + pad2(dobDay);
        medNum = String(1000 + Math.floor(rand() * 9000)) + '-' + String(10000 + Math.floor(rand() * 90000)) + '-' + String(Math.floor(rand() * 10));
        provider = pick(providers); specialty = provider.specialty;
        var svcMs;
        if (rand() < 0.15) {
          // Pattern: seasonal flu spike in July
          var julyDay = Math.floor(rand() * 31) + 1;
          svcMs = new Date(2024, 6, julyDay).getTime();
        } else {
          svcMs = startMs + Math.floor(rand() * rangeMs);
        }
        var svcDate = new Date(svcMs);
        serviceDate = fmtDate(svcDate);
        var specItems = itemsBySpecialty[specialty] || itemsBySpecialty['GP'];
        itemInfo = pick(specItems); scheduleFee = itemInfo.fee;
        mState = pick(mStates); postcode = pick(statePostcodes[mState]);
        // Pattern: bulk billing rate varies by state
        var bbRate = bulkBillRate[mState] || 0.75;
        if (specialty !== 'GP') bbRate *= 0.4;
        bulkBilled = rand() < bbRate ? 'true' : 'false';
        if (bulkBilled === 'true') {
          gapAmount = 0; benefitPaid = scheduleFee;
        } else {
          // Pattern: gap amounts cluster by specialty
          var gapOptions = gapRanges[specialty] || gapRanges['GP'];
          gapAmount = pick(gapOptions);
          if (gapAmount > 0) gapAmount = gapAmount + Math.floor(rand() * 30);
          benefitPaid = scheduleFee;
        }
        var diagCode = pick(diagCodes);
        if (svcDate.getMonth() === 6 && rand() < 0.4) {
          diagCode = pick(['J06.9','J11.1','J00','J18.9','J45.9','J30.1']);
        }
        var procCode = pick(procCodes);
        var refId = specialty !== 'GP' ? 'REF-' + String(Math.floor(rand() * 9999)).padStart(4, '0') : 'REF-0000';
        var claimDate = new Date(svcMs + (Math.floor(rand() * 3) + 1) * 86400000);
        var procDate = new Date(claimDate.getTime() + (Math.floor(rand() * 4) + 1) * 86400000);
        var payMethod = bulkBilled === 'true' ? 'EFT' : pick(paymentMethods);
        exceptional = rand() < 0.03 ? 'true' : 'false';
        var statusRoll = rand();
        mStatus = statusRoll < 0.92 ? 'PAID' : statusRoll < 0.96 ? 'PENDING' : statusRoll < 0.99 ? 'REJECTED' : 'DUPLICATE';
        var specNotes = noteTemplates[specialty] || noteTemplates['GP'];
        note = pick(specNotes);
        if (exceptional === 'true') note = 'Exceptional claim \u2014 ' + note.charAt(0).toLowerCase() + note.slice(1);
        followUp = rand() < (specialty === 'GP' ? 0.15 : 0.35) ? 'true' : 'false';
        if (bulkBilled === 'true') {
          rebatePct = '100.0';
        } else {
          var totalCharge = benefitPaid + gapAmount;
          rebatePct = totalCharge > 0 ? (benefitPaid / totalCharge * 100).toFixed(1) : '100.0';
        }
        var facilityType = pick(facilityTypes);
        if (specialty === 'Radiology') facilityType = 'Radiology Centre';
        else if (specialty === 'Psychiatry' && rand() < 0.5) facilityType = 'Private Hospital';
        else if (specialty === 'Orthopaedics') facilityType = pick(['Day Surgery','Private Hospital']);
        rows.push([claimId, patId, patName, dob, medNum, provider.id, provider.name, itemInfo.item, serviceDate, money(benefitPaid), money(scheduleFee), money(gapAmount), specialty, facilityType, mState, postcode, diagCode, procCode, refId, fmtDate(claimDate), fmtDate(procDate), payMethod, bulkBilled, exceptional, note, mStatus, followUp, rebatePct]);
      }
      return {
        name: 'Medicare Benefits Schedule',
        description: '500 MBS claims \u2014 seasonal flu spike in July, bulk billing rate varies by state, gap amounts cluster by specialty',
        sensitivity: 'CONFIDENTIAL',
        category: 'Government Open Data',
        headers: ['claim_id','patient_id','patient_name','dob','medicare_number','provider_id','provider_name','item_number','service_date','benefit_paid','schedule_fee','gap_amount','specialty','facility_type','state','postcode','diagnosis_code','procedure_code','referral_id','claim_date','processed_date','payment_method','bulk_billed','exceptional_claim','notes','status','follow_up_required','rebate_percentage'],
        descriptions: {
          claim_id: 'Unique claim identifier',
          patient_id: 'Patient identifier (PII)',
          patient_name: 'Patient full name (PII)',
          dob: 'Date of birth (PII)',
          medicare_number: 'Medicare card number (PII)',
          provider_id: 'Healthcare provider ID',
          provider_name: 'Provider full name (PII)',
          item_number: 'MBS item number for the service',
          service_date: 'Date service was provided',
          benefit_paid: 'Amount reimbursed by Medicare ($)',
          schedule_fee: 'MBS schedule fee for the item ($)',
          gap_amount: 'Out-of-pocket cost to patient ($)',
          specialty: 'Medical specialty of provider',
          facility_type: 'Type of facility (hospital/clinic/etc)',
          state: 'Australian state/territory',
          postcode: 'Postcode of facility',
          diagnosis_code: 'ICD-10 diagnosis code',
          procedure_code: 'MBS procedure code',
          referral_id: 'Referring doctor referral ID',
          claim_date: 'Date claim was submitted',
          processed_date: 'Date claim was processed',
          payment_method: 'Payment method (EFT/card/etc)',
          bulk_billed: 'Whether bulk-billed (true/false)',
          exceptional_claim: 'Flagged as exceptional claim',
          notes: 'Free-text clinical notes (PII)',
          status: 'Claim processing status',
          follow_up_required: 'Whether follow-up appointment is required (true/false)',
          rebate_percentage: 'Medicare rebate as percentage of total charge'
        },
        pii: ['patient_id','patient_name','dob','medicare_number','provider_name'],
        rows: rows
      };
    })(),

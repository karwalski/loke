    'au.water': (function() {
      var sensors = [
        {id:'SNS-NP-001',name:'Nepean River Intake A',loc:'Nepean River Intake',sub:'Penrith',pc:'2750'},
        {id:'SNS-NP-002',name:'Nepean River Intake B',loc:'Nepean River Intake',sub:'Penrith',pc:'2750'},
        {id:'SNS-WP-003',name:'Warragamba WTP Outlet',loc:'Warragamba Water Treatment Plant',sub:'Warragamba',pc:'2752'},
        {id:'SNS-WP-004',name:'Warragamba WTP Raw',loc:'Warragamba Water Treatment Plant',sub:'Warragamba',pc:'2752'},
        {id:'SNS-RH-008',name:'Ryde High Zone Reservoir',loc:'Ryde Distribution Network',sub:'Ryde',pc:'2112'},
        {id:'SNS-RH-009',name:'Ryde Low Zone Pump',loc:'Ryde Distribution Network',sub:'Ryde',pc:'2112'},
        {id:'SNS-MH-021',name:'Manly Hydraulic Lab',loc:'Manly Hydraulic Laboratory',sub:'Manly',pc:'2095'},
        {id:'SNS-MH-022',name:'Manly Hydraulic Lab B',loc:'Manly Hydraulic Laboratory',sub:'Manly',pc:'2095'},
        {id:'SNS-CB-012',name:'Cronulla Beach Outfall',loc:'Cronulla Beach Monitor',sub:'Cronulla',pc:'2230'},
        {id:'SNS-CB-013',name:'Cronulla Beach Outfall B',loc:'Cronulla Beach Monitor',sub:'Cronulla',pc:'2230'},
        {id:'SNS-PP-006',name:'Prospect WTP Outlet',loc:'Prospect Water Filtration Plant',sub:'Prospect',pc:'2148'},
        {id:'SNS-PP-007',name:'Prospect WTP Raw',loc:'Prospect Water Filtration Plant',sub:'Prospect',pc:'2148'},
        {id:'SNS-BH-017',name:'Bondi Headland Monitor',loc:'Bondi Beach Water Quality',sub:'Bondi Beach',pc:'2026'},
        {id:'SNS-SY-031',name:'Sydney CBD Loop',loc:'CBD Distribution Loop',sub:'Sydney',pc:'2000'},
        {id:'SNS-SY-032',name:'Sydney Olympic Park',loc:'Olympic Park Distribution',sub:'Olympic Park',pc:'2127'}
      ];
      var operators = [
        {id:'OPR-441',name:'David Kowalski'},{id:'OPR-228',name:'Christine Bellamy'},{id:'OPR-117',name:'James Papadopoulos'},
        {id:'OPR-335',name:'Angela Wu'},{id:'OPR-509',name:'Rebecca Nguyen'},{id:'OPR-663',name:'Samuel Harris'},
        {id:'OPR-774',name:'Nicole Russo'},{id:'OPR-881',name:'Tony Fitzpatrick'}
      ];
      var sampleTypes = ['Continuous','Continuous','Continuous','Grab','Grab'];
      var weatherConditions = ['Clear','Clear','Partly Cloudy','Overcast','Light Rain','Moderate Rain','Heavy Rain','Storm'];
      var normalNotes = ['All parameters within ADWG guidelines.','Routine sample \u2014 no concerns.','Distribution point normal.','Post-treatment quality within all parameters.','Filtration plant at full capacity.','Pump station telemetry normal.','CBD loop running normally.','Reservoir inspection completed \u2014 no defects found.','Weekend monitoring \u2014 all clear.','Pre-event water quality check.','Beach conditions excellent.','River returned to pre-storm baseline.'];
      // 3 sensors with deteriorating pH trend
      var phDegradeSensors = ['SNS-MH-021','SNS-MH-022','SNS-RH-009'];
      // 2 sensors that trigger turbidity alerts
      var turbAlertSensors = ['SNS-NP-001','SNS-NP-002'];
      var seed = 202;
      function rand() { seed = (seed * 16807 + 0) % 2147483647; return (seed - 1) / 2147483646; }
      function pick(arr) { return arr[Math.floor(rand() * arr.length)]; }
      function pad2(n) { return n < 10 ? '0' + n : '' + n; }
      function fmtDt(d) { return d.getFullYear() + '-' + pad2(d.getMonth()+1) + '-' + pad2(d.getDate()) + ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':00'; }
      function rnd1(v) { return (Math.round(v * 10) / 10).toFixed(1); }
      function rnd2(v) { return (Math.round(v * 100) / 100).toFixed(2); }
      var rows = [];
      var startMs = new Date('2024-07-01T00:00:00').getTime();
      var endMs = new Date('2024-12-31T23:59:59').getTime();
      var rangeMs = endMs - startMs;
      for (var i = 0; i < 200; i++) {
        var readingId = 'SWR-2024-' + String(i + 1).padStart(4, '0');
        var sensor = pick(sensors);
        var readingMs = startMs + Math.floor(rand() * rangeMs);
        var readingDate = new Date(readingMs);
        var month = readingDate.getMonth(); // 6=Jul .. 11=Dec
        // Seasonal temperature: winter (Jul) ~14-16C, summer (Dec) ~22-25C
        var baseTemp = 14 + (month - 6) * 1.6 + (rand() * 2 - 1);
        var temperature = Math.max(10, Math.min(28, baseTemp));
        // Base pH around 7.2
        var basePH = 7.2 + (rand() * 0.4 - 0.2);
        // Pattern: 3 sensors with deteriorating pH trend
        if (phDegradeSensors.indexOf(sensor.id) !== -1) {
          var daysSinceStart = (readingMs - startMs) / 86400000;
          var phDrift = daysSinceStart * 0.003; // ~0.55 drop over 184 days
          basePH = basePH - phDrift;
          if (basePH < 6.0) basePH = 6.0 + rand() * 0.2;
        }
        var ph = Math.max(5.8, Math.min(8.5, basePH));
        // Turbidity
        var turbidity = 0.05 + rand() * 0.5;
        var alertTriggered = 'false';
        var wStatus = 'NORMAL';
        var note = pick(normalNotes);
        // Pattern: 2 turbidity alert sensors
        if (turbAlertSensors.indexOf(sensor.id) !== -1 && rand() < 0.25) {
          turbidity = 3.0 + rand() * 6.0;
          alertTriggered = 'true';
          wStatus = 'ALERT';
          note = 'ALERT: turbidity spike \u2014 ' + rnd1(turbidity) + ' NTU. Upstream storm event suspected.';
        }
        // pH alert
        if (ph < 6.5) {
          alertTriggered = 'true';
          wStatus = 'ALERT';
          note = 'ALERT: pH below 6.5 threshold (' + rnd1(ph) + '). Acid dosing pump check required.';
        }
        var chlorine = 0.6 + rand() * 0.6;
        if (sensor.name.indexOf('Raw') !== -1) chlorine = 0;
        var fluoride = 0.65 + rand() * 0.15;
        var toc = sensor.name.indexOf('Raw') !== -1 ? 2.5 + rand() * 2.5 : 1.0 + rand() * 1.5;
        var ecoliPresent = 'false';
        var totalColiform = 0;
        // E. coli at beach sensors occasionally
        if (sensor.id.indexOf('CB') !== -1 && rand() < 0.15) {
          ecoliPresent = 'true';
          totalColiform = Math.floor(rand() * 20) + 5;
          alertTriggered = 'true';
          wStatus = 'ALERT';
          note = 'ALERT: E. coli detected. Beach closure advisory issued.';
        } else if (rand() < 0.1) {
          totalColiform = Math.floor(rand() * 3) + 1;
        }
        // Pressure and flow
        var isBeach = sensor.id.indexOf('BH') !== -1;
        var pressure = isBeach ? 0 : 280 + rand() * 450;
        var flowRate = isBeach ? 0 : 20 + rand() * 470;
        var operator = pick(operators);
        var sampleType = pick(sampleTypes);
        // Weather condition
        var weatherRoll = rand();
        var weather;
        if (weatherRoll < 0.35) weather = 'Clear';
        else if (weatherRoll < 0.55) weather = 'Partly Cloudy';
        else if (weatherRoll < 0.70) weather = 'Overcast';
        else if (weatherRoll < 0.82) weather = 'Light Rain';
        else if (weatherRoll < 0.92) weather = 'Moderate Rain';
        else if (weatherRoll < 0.97) weather = 'Heavy Rain';
        else weather = 'Storm';
        // Rainfall — correlates with weather
        var rainfall = 0;
        if (weather === 'Light Rain') rainfall = 1 + rand() * 8;
        else if (weather === 'Moderate Rain') rainfall = 8 + rand() * 20;
        else if (weather === 'Heavy Rain') rainfall = 25 + rand() * 40;
        else if (weather === 'Storm') rainfall = 50 + rand() * 60;
        else if (weather === 'Overcast') rainfall = rand() < 0.3 ? rand() * 2 : 0;
        // Turbidity increases after rain
        if (rainfall > 20 && turbidity < 2) turbidity = turbidity + rainfall * 0.08;
        rows.push([readingId, sensor.id, sensor.name, fmtDt(readingDate), sensor.loc, sensor.sub, sensor.pc, rnd2(turbidity), rnd2(chlorine), rnd1(ph), rnd1(temperature), rnd2(fluoride), rnd1(toc), ecoliPresent, String(totalColiform), rnd1(pressure), rnd1(flowRate), alertTriggered, operator.id, operator.name, sampleType, note, wStatus, weather, rnd1(rainfall)]);
      }
      return {
        name: 'Sydney Water Quality',
        description: '200 sensor readings \u2014 seasonal temperature variation, 3 sensors with deteriorating pH trend, 2 turbidity alert sensors',
        sensitivity: 'PUBLIC',
        category: 'Government Open Data',
        headers: ['reading_id','sensor_id','sensor_name','reading_time','location','suburb','postcode','turbidity_ntu','chlorine_mgl','ph','temperature_c','fluoride_mgl','toc_mgl','ecoli_present','total_coliform','pressure_kpa','flow_rate_ls','alert_triggered','operator_id','operator_name','sample_type','notes','status','weather_condition','rainfall_mm'],
        descriptions: {
          reading_id: 'Unique reading identifier',
          sensor_id: 'Sensor hardware ID',
          sensor_name: 'Human-readable sensor name',
          reading_time: 'Timestamp of reading',
          location: 'Site or intake location',
          suburb: 'Suburb of sensor',
          postcode: 'Postcode of sensor',
          turbidity_ntu: 'Turbidity in NTU',
          chlorine_mgl: 'Residual chlorine (mg/L)',
          ph: 'pH level',
          temperature_c: 'Water temperature (C)',
          fluoride_mgl: 'Fluoride concentration (mg/L)',
          toc_mgl: 'Total organic carbon (mg/L)',
          ecoli_present: 'E. coli detected (true/false)',
          total_coliform: 'Total coliform count',
          pressure_kpa: 'Line pressure (kPa)',
          flow_rate_ls: 'Flow rate (litres/sec)',
          alert_triggered: 'Whether alert was raised',
          operator_id: 'Operator staff ID',
          operator_name: 'Operator full name (PII)',
          sample_type: 'Sample collection method',
          notes: 'Operator notes',
          status: 'Reading status (NORMAL/ALERT)',
          weather_condition: 'Weather at time of reading',
          rainfall_mm: 'Rainfall in last 24 hours (mm)'
        },
        pii: ['operator_name'],
        rows: rows
      };
    })(),

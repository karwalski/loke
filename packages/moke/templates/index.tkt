      ]
    },
    'it_hardware.performance_metrics': {
      name: 'IT Server Performance Metrics (Banksia Digital)',
      description: 'Time-series CPU, RAM, disk, network metrics for 48 servers over 7 days — SYD + MEL data centres. 10,000 readings with deliberate anomaly patterns: daily CPU spikes, memory leaks, disk latency degradation, correlated network/error spikes.',
      sensitivity: 'CONFIDENTIAL',
      category: 'IT Operations',
      headers: ['server_id','timestamp','cpu_percent','ram_percent','disk_iops','disk_latency_ms','network_in_mbps','network_out_mbps','active_connections','error_rate','response_time_ms','gc_pause_ms'],
      descriptions: {
        server_id: 'Server ID linking to IT Server Hardware dataset (SRV-001 to SRV-048)',
        timestamp: 'Reading timestamp (ISO 8601)',
        cpu_percent: 'CPU utilisation percentage (0-100)',
        ram_percent: 'RAM utilisation percentage (0-100)',
        disk_iops: 'Disk I/O operations per second',
        disk_latency_ms: 'Disk latency in milliseconds',
        network_in_mbps: 'Inbound network throughput (Mbps)',
        network_out_mbps: 'Outbound network throughput (Mbps)',
        active_connections: 'Number of active connections',
        error_rate: 'Error rate (errors per 1000 requests)',
        response_time_ms: 'Average response time in milliseconds',
        gc_pause_ms: 'Garbage collection pause time in milliseconds'
      },
      pii: [],
      rows: null,
      // MK8.2 — Procedural generation of 10,000 time-series performance metric rows
      generate: function() {
        // Deterministic PRNG (mulberry32) for reproducible data
        function mulberry32(a) {
          return function() {
            a |= 0; a = a + 0x6D2B79F5 | 0;
            var t = Math.imul(a ^ a >>> 15, 1 | a);
            t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
            return ((t ^ t >>> 14) >>> 0) / 4294967296;
          };
        }
        var rng = mulberry32(20260418);

        // Server pool — all 48 servers from IT Hardware dataset
        var servers = [];
        for (var i = 1; i <= 48; i++) servers.push('SRV-' + String(i).padStart(3, '0'));

        // Server role profiles — baseline metrics vary by server type
        var profiles = {
          web:     { cpu: 35, ram: 50, iops: 800,  lat: 2.5, netIn: 200, netOut: 150, conn: 1200, err: 1.2, resp: 45,  gc: 8 },
          db:      { cpu: 45, ram: 70, iops: 3000, lat: 1.8, netIn: 100, netOut: 80,  conn: 400,  err: 0.3, resp: 12,  gc: 15 },
          app:     { cpu: 40, ram: 55, iops: 600,  lat: 3.0, netIn: 150, netOut: 120, conn: 800,  err: 0.8, resp: 65,  gc: 12 },
          cache:   { cpu: 15, ram: 80, iops: 5000, lat: 0.5, netIn: 300, netOut: 280, conn: 2000, err: 0.1, resp: 2,   gc: 3 },
          backup:  { cpu: 10, ram: 30, iops: 1500, lat: 8.0, netIn: 50,  netOut: 20,  conn: 20,   err: 0.05,resp: 200, gc: 5 },
          vpn:     { cpu: 20, ram: 40, iops: 200,  lat: 3.5, netIn: 250, netOut: 200, conn: 500,  err: 0.4, resp: 30,  gc: 4 },
          lb:      { cpu: 22, ram: 38, iops: 300,  lat: 1.0, netIn: 500, netOut: 480, conn: 3000, err: 0.2, resp: 5,   gc: 2 },
          k8s:     { cpu: 50, ram: 65, iops: 1200, lat: 2.0, netIn: 180, netOut: 160, conn: 600,  err: 0.6, resp: 50,  gc: 10 },
          mon:     { cpu: 30, ram: 45, iops: 400,  lat: 4.0, netIn: 80,  netOut: 60,  conn: 150,  err: 0.2, resp: 80,  gc: 6 },
          mgmt:    { cpu: 18, ram: 42, iops: 250,  lat: 5.0, netIn: 40,  netOut: 30,  conn: 80,   err: 0.1, resp: 100, gc: 5 },
          archive: { cpu: 3,  ram: 12, iops: 50,   lat: 15,  netIn: 5,   netOut: 3,   conn: 5,    err: 0.0, resp: 500, gc: 1 }
        };

        // Map server IDs to roles (matching IT Hardware dataset)
        var serverRole = {};
        var s;
        for (s = 1; s <= 16; s++) serverRole['SRV-' + String(s).padStart(3,'0')] = 'web';
        for (s = 17; s <= 20; s++) serverRole['SRV-' + String(s).padStart(3,'0')] = 'db';
        serverRole['SRV-021'] = 'k8s'; serverRole['SRV-022'] = 'k8s';
        serverRole['SRV-023'] = 'k8s'; serverRole['SRV-024'] = 'k8s';
        for (s = 25; s <= 27; s++) serverRole['SRV-' + String(s).padStart(3,'0')] = 'app';
        serverRole['SRV-028'] = 'cache'; serverRole['SRV-029'] = 'cache';
        serverRole['SRV-030'] = 'backup'; serverRole['SRV-031'] = 'backup';
        serverRole['SRV-032'] = 'mon';
        for (s = 33; s <= 36; s++) serverRole['SRV-' + String(s).padStart(3,'0')] = 'app';
        serverRole['SRV-037'] = 'db'; serverRole['SRV-038'] = 'db';
        for (s = 39; s <= 41; s++) serverRole['SRV-' + String(s).padStart(3,'0')] = 'app';
        serverRole['SRV-042'] = 'cache';
        serverRole['SRV-043'] = 'backup';
        serverRole['SRV-044'] = 'vpn';
        serverRole['SRV-045'] = 'lb'; serverRole['SRV-046'] = 'lb';
        serverRole['SRV-047'] = 'archive';
        serverRole['SRV-048'] = 'mgmt';

        // Pattern flags
        var leakServers = { 'SRV-016': true, 'SRV-038': true, 'SRV-009': true };
        var diskFailServer = 'SRV-037';
        var netSpikeServers = { 'SRV-005': true, 'SRV-021': true, 'SRV-045': true };

        // Time range: 7 days — 2026-04-14 (Mon) to 2026-04-20 (Sun)
        var startMs = Date.UTC(2026, 3, 14, 0, 0, 0); // months are 0-indexed
        var rows = [];
        var totalRows = 10000;
        var totalReadings = Math.ceil(totalRows / servers.length);
        var pad2 = function(n) { return n < 10 ? '0' + n : '' + n; };

        for (var r = 0; r < totalRows; r++) {
          var srvIdx = r % servers.length;
          var srv = servers[srvIdx];
          var role = serverRole[srv] || 'web';
          var base = profiles[role];
          var readingNum = Math.floor(r / servers.length);

          // Spread readings evenly across 7 days (10080 minutes)
          var minuteOffset = Math.floor((readingNum / totalReadings) * 10080);
          var ts = new Date(startMs + minuteOffset * 60000);
          var hour = ts.getUTCHours();
          var dayOfWeek = ts.getUTCDay(); // 0=Sun
          var dayIndex = Math.floor(minuteOffset / 1440); // 0-6

          // --- Pattern 1: Daily CPU spike 09:00-10:00 ---
          var cpuSpike = (hour === 9) ? 25 + rng() * 15 : 0;
          if (hour === 9 && dayOfWeek >= 1 && dayOfWeek <= 5) cpuSpike += 10;

          // --- Pattern 2: Gradual memory leak on 3 servers ---
          var ramLeak = 0;
          if (leakServers[srv]) {
            ramLeak = (dayIndex / 6) * (95 - base.ram) * 0.8;
          }

          // --- Pattern 3: Disk latency degradation before failure (SRV-037) ---
          var diskDeg = 1.0;
          if (srv === diskFailServer) {
            if (dayIndex >= 4) {
              diskDeg = 1.0 + Math.pow((dayIndex - 3), 2.5) * 3;
            } else if (dayIndex === 3) {
              diskDeg = 1.0 + rng() * 0.8;
            }
          }

          // --- Pattern 4: Correlated network + error spikes ---
          var netSpike = 1.0;
          var errSpike = 1.0;
          if (netSpikeServers[srv]) {
            if (hour >= 8 && hour <= 18 && rng() < 0.15) {
              netSpike = 2.5 + rng() * 2.0;
              errSpike = 3.0 + rng() * 5.0;
            }
          }

          // Noise helper
          var noise = function(pct) { return 1.0 + (rng() - 0.5) * 2 * (pct / 100); };

          // Diurnal pattern — higher during business hours
          var diurnal = 1.0;
          if (hour >= 8 && hour <= 18) diurnal = 1.3;
          else if (hour >= 19 && hour <= 22) diurnal = 1.1;
          else if (hour >= 0 && hour <= 5) diurnal = 0.6;
          if (dayOfWeek === 0 || dayOfWeek === 6) diurnal *= 0.65;

          // Compute metrics
          var cpu = Math.min(100, Math.max(0, (base.cpu * diurnal + cpuSpike) * noise(15)));
          var ram = Math.min(100, Math.max(0, (base.ram + ramLeak) * noise(5)));
          var iops = Math.max(0, Math.round(base.iops * diurnal * noise(20)));
          var latency = Math.max(0.1, base.lat * diskDeg * noise(15));
          var netIn = Math.max(0, base.netIn * diurnal * netSpike * noise(15));
          var netOut = Math.max(0, base.netOut * diurnal * netSpike * noise(15));
          var conn = Math.max(0, Math.round(base.conn * diurnal * noise(20)));
          var errRate = Math.max(0, base.err * errSpike * noise(25));
          var resp = Math.max(0.5, base.resp * diurnal * (diskDeg > 1 ? diskDeg * 0.5 : 1) * noise(15));
          var gcPause = Math.max(0, base.gc * (cpu > 80 ? 2.5 : 1) * noise(30));

          // Format timestamp as ISO 8601
          var tsStr = ts.getUTCFullYear() + '-' + pad2(ts.getUTCMonth()+1) + '-' + pad2(ts.getUTCDate()) +
                      'T' + pad2(ts.getUTCHours()) + ':' + pad2(ts.getUTCMinutes()) + ':' + pad2(ts.getUTCSeconds());

          rows.push([
            srv, tsStr,
            cpu.toFixed(1), ram.toFixed(1),
            String(iops), latency.toFixed(2),
            netIn.toFixed(1), netOut.toFixed(1),
            String(conn), errRate.toFixed(3),
            resp.toFixed(1), gcPause.toFixed(1)
          ]);
        }

        return rows;
      }
    },
    'it_ops.incidents': (function() {
      var assignees = ['Sarah Chen','James Patel','Priya Sharma','Marcus O\'Brien','Lena Kowalski','David Tran','Tom Fitzgerald','Aisha Rahman'];
      var serverIds = [];
      for (var s = 1; s <= 48; s++) { serverIds.push('SRV-' + String(s).padStart(3,'0')); }
      var categories = ['hardware','software','network','security'];
      var rootCauses = {
        hardware: ['Disk failure','Memory ECC error','PSU degradation','Fan failure','RAID controller fault','NIC hardware fault','CPU thermal throttle','Chassis intrusion sensor'],
        software: ['Memory leak','Deadlock detected','Config drift','Certificate expiry','Kernel panic','OOM kill','Service crash loop','Dependency timeout'],
        network: ['BGP flap','Switch port error','DNS resolution failure','Firewall rule misconfiguration','VLAN misconfiguration','MTU mismatch','Packet loss on uplink','NIC driver bug'],
        security: ['Brute force attempt','Unauthorised access attempt','Malware signature detected','TLS downgrade attack','Privilege escalation attempt','Anomalous outbound traffic','Failed MFA flood','SSH key compromise']
      };
      var services = ['web-frontend','api-gateway','postgres-primary','postgres-replica','redis-cache','auth-service','payment-service','analytics-pipeline','backup-service','monitoring','dns','vpn','load-balancer','file-storage'];
      var recurringP1Servers = ['SRV-009','SRV-037'];
      var recurringP1Cause = 'NIC driver bug';
      var rows = [];
      var seed = 42;
      function rand() { seed = (seed * 16807 + 0) % 2147483647; return (seed - 1) / 2147483646; }
      function pick(arr) { return arr[Math.floor(rand() * arr.length)]; }
      function pad2(n) { return n < 10 ? '0' + n : '' + n; }
      function fmtDate(d) { return d.getFullYear() + '-' + pad2(d.getMonth()+1) + '-' + pad2(d.getDate()) + 'T' + pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':00'; }
      var startMs = new Date('2026-01-01T00:00:00').getTime();
      var endMs = new Date('2026-04-18T23:59:59').getTime();
      var rangeMs = endMs - startMs;
      // Pattern 1: Recurring P1 on 2 servers — 12 each (24 total), same root cause
      var recurringP1Indices = {};
      for (var rp = 0; rp < 24; rp++) {
        var idx; do { idx = Math.floor(rand() * 500); } while (recurringP1Indices[idx]);
        recurringP1Indices[idx] = true;
      }
      // Pattern 2: P2 cluster during maintenance windows (Sun 02:00-06:00) — 40 incidents
      var maintP2Indices = {};
      for (var mp = 0; mp < 40; mp++) {
        var idx2; do { idx2 = Math.floor(rand() * 500); } while (recurringP1Indices[idx2] || maintP2Indices[idx2]);
        maintP2Indices[idx2] = true;
      }
      for (var i = 0; i < 500; i++) {
        var incId = 'INC-' + String(i + 1).padStart(4, '0');
        var severity, category, status, serverId, openedAt, resolvedAt, mttrMin, assignee, rootCause, affectedSvcs, changeId, relatedInc, slaBreach;
        if (recurringP1Indices[i]) {
          severity = 'P1'; category = 'network';
          serverId = recurringP1Servers[i % 2];
          var ts = startMs + Math.floor(rand() * rangeMs);
          openedAt = new Date(ts);
          mttrMin = Math.floor(rand() * 180) + 60;
          resolvedAt = new Date(ts + mttrMin * 60000);
          status = pick(['resolved','closed']);
          assignee = pick(assignees);
          rootCause = recurringP1Cause;
          var svcCount = Math.floor(rand() * 3) + 2;
          var svcSet = [];
          while (svcSet.length < svcCount) { var sv = pick(services); if (svcSet.indexOf(sv) === -1) svcSet.push(sv); }
          affectedSvcs = svcSet.join('; ');
          changeId = '';
          var pairIdx = i % 2 === 0 ? i + 1 : i - 1;
          relatedInc = recurringP1Indices[pairIdx] ? 'INC-' + String(pairIdx + 1).padStart(4, '0') : '';
          slaBreach = mttrMin > 60 ? 'Y' : 'N';
        } else if (maintP2Indices[i]) {
          severity = 'P2'; category = pick(categories);
          serverId = pick(serverIds);
          var weekOffset = Math.floor(rand() * 16);
          var sunday = new Date('2026-01-04T02:00:00');
          sunday.setDate(sunday.getDate() + weekOffset * 7);
          var maintTs = sunday.getTime() + Math.floor(rand() * 240) * 60000;
          openedAt = new Date(maintTs);
          mttrMin = Math.floor(rand() * 120) + 30;
          resolvedAt = new Date(maintTs + mttrMin * 60000);
          status = pick(['resolved','closed']);
          assignee = pick(assignees);
          rootCause = pick(rootCauses[category]);
          affectedSvcs = pick(services);
          changeId = 'CHG-' + String(Math.floor(rand() * 200) + 1).padStart(4, '0');
          relatedInc = '';
          slaBreach = mttrMin > 120 ? 'Y' : 'N';
        } else {
          var sevRoll = rand();
          severity = sevRoll < 0.05 ? 'P1' : sevRoll < 0.20 ? 'P2' : sevRoll < 0.55 ? 'P3' : 'P4';
          category = pick(categories);
          serverId = pick(serverIds);
          var ts2 = startMs + Math.floor(rand() * rangeMs);
          openedAt = new Date(ts2);
          assignee = pick(assignees);
          rootCause = pick(rootCauses[category]);
          var svcCount2 = severity === 'P1' ? Math.floor(rand() * 3) + 2 : Math.floor(rand() * 2) + 1;
          var svcSet2 = [];
          while (svcSet2.length < svcCount2) { var sv2 = pick(services); if (svcSet2.indexOf(sv2) === -1) svcSet2.push(sv2); }
          affectedSvcs = svcSet2.join('; ');
          changeId = rand() < 0.2 ? 'CHG-' + String(Math.floor(rand() * 200) + 1).padStart(4, '0') : '';
          relatedInc = rand() < 0.1 ? 'INC-' + String(Math.floor(rand() * 500) + 1).padStart(4, '0') : '';
          var slaLimit = severity === 'P1' ? 60 : severity === 'P2' ? 120 : severity === 'P3' ? 480 : 1440;
          var statusRoll = rand();
          if (statusRoll < 0.08) {
            status = 'open'; mttrMin = ''; resolvedAt = ''; slaBreach = '';
          } else if (statusRoll < 0.15) {
            status = 'investigating'; mttrMin = ''; resolvedAt = ''; slaBreach = '';
          } else {
            status = rand() < 0.6 ? 'resolved' : 'closed';
            if (category === 'network') {
              mttrMin = rand() < 0.22 ? slaLimit + Math.floor(rand() * slaLimit) + 1 : Math.floor(rand() * slaLimit * 0.9) + 5;
            } else {
              mttrMin = rand() < 0.08 ? slaLimit + Math.floor(rand() * slaLimit) + 1 : Math.floor(rand() * slaLimit * 0.9) + 5;
            }
            resolvedAt = new Date(ts2 + mttrMin * 60000);
            slaBreach = mttrMin > slaLimit ? 'Y' : 'N';
          }
        }
        rows.push([incId, serverId, severity, category, status, fmtDate(openedAt), resolvedAt ? fmtDate(resolvedAt) : '', String(mttrMin), assignee, rootCause, affectedSvcs, changeId, relatedInc, slaBreach]);
      }
      return {
        name: 'IT Incidents & Alerts (Banksia Digital)',
        description: '500 incident records — recurring P1s on 2 servers, P2 clusters during maintenance windows, >15% network SLA breach rate',
        sensitivity: 'CONFIDENTIAL',
        category: 'IT Operations',
        headers: ['incident_id','server_id','severity','category','status','opened_at','resolved_at','mttr_minutes','assignee','root_cause','affected_services','change_id','related_incidents','sla_breached'],
        descriptions: {
          incident_id: 'Unique incident identifier',
          server_id: 'Affected server identifier',
          severity: 'Incident severity (P1-P4)',
          category: 'Incident category (hardware/software/network/security)',
          status: 'Current status (open/investigating/resolved/closed)',
          opened_at: 'Timestamp when incident was opened (ISO 8601)',
          resolved_at: 'Timestamp when incident was resolved (ISO 8601)',
          mttr_minutes: 'Mean time to resolve in minutes',
          assignee: 'Assigned engineer name (PII)',
          root_cause: 'Identified root cause',
          affected_services: 'Services impacted by the incident',
          change_id: 'Related change request ID (if any)',
          related_incidents: 'Linked incident IDs',
          sla_breached: 'Whether SLA target was breached (Y/N)'
        },
        pii: ['assignee'],
        rows: rows
      };
    })(),
    'it_ops.change_management': (function() {
      var requesters = ['James Nguyen','Aisha Patel','Lena Kowalski','Marcus Chen','Sarah O\'Brien','David Tran','Priya Sharma','Tom Fitzgerald'];
      var approvers = ['Rachel Thornton','Andrew McLeod','Simone Vella','Kiran Desai'];
      var serverIds = [];
      for (var s = 1; s <= 48; s++) serverIds.push('SRV-' + String(s).padStart(3, '0'));
      var rollbackReasons = ['performance degradation','config conflict','service outage','dependency failure','data corruption detected','SSL cert mismatch','memory leak introduced','DNS resolution broke','queue backlog exceeded threshold'];
      var rows = [];
      for (var i = 0; i < 300; i++) {
        var cid = 'CHG-' + String(i + 1).padStart(4, '0');
        var dayOffset = Math.floor(i * 0.6);
        var d = new Date(2025, 8, 1);
        d.setDate(d.getDate() + dayOffset);
        var dow = d.getDay();
        var isFriday = (dow === 5);
        var isEmergency = (i % 20 === 0 || (i > 40 && i < 55));
        var type = isEmergency ? 'emergency' : (i % 5 === 0 ? 'standard' : 'normal');
        var reqBy = requesters[i % requesters.length];
        var appBy = isEmergency ? approvers[0] : approvers[i % approvers.length];
        var affectedCount = isEmergency ? Math.floor(((Math.sin(i * 2.1) + 1) / 2) * 4) + 3 : Math.floor(((Math.sin(i * 3.7) + 1) / 2) * 3) + 1;
        var affected = [];
        for (var a = 0; a < affectedCount; a++) affected.push(serverIds[(i * 3 + a) % serverIds.length]);
        var risk = isEmergency ? 'high' : (isFriday ? 'medium' : (['low','low','medium','low','low'])[i % 5]);
        var rollbackChance = isFriday ? 0.3 : 0.1;
        if (isEmergency) rollbackChance = 0.25;
        var rolledBack = (Math.sin(i * 7.3) + 1) / 2 < rollbackChance;
        var failed = !rolledBack && (Math.sin(i * 13.1) + 1) / 2 < 0.03;
        var status = rolledBack ? 'rolled_back' : (failed ? 'failed' : ((Math.sin(i * 2.9) + 1) / 2 < 0.1 ? 'approved' : 'implemented'));
        var success = (status === 'implemented') ? 'true' : 'false';
        var rbReason = rolledBack ? rollbackReasons[Math.floor(((Math.sin(i * 5.7) + 1) / 2) * rollbackReasons.length)] : '';
        var downtime = isEmergency ? Math.floor(((Math.sin(i * 3.3) + 1) / 2) * 180 + 30) : (rolledBack ? Math.floor(((Math.sin(i * 4.1) + 1) / 2) * 60 + 15) : Math.floor(((Math.sin(i * 6.7) + 1) / 2) * 20));
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd2 = String(d.getDate()).padStart(2, '0');
        var dateStr = d.getFullYear() + '-' + mm + '-' + dd2;
        rows.push([cid, type, status, reqBy, appBy, dateStr, affected.join(';'), risk, success, rbReason, String(downtime)]);
      }
      return {
        name: 'IT Change Management (Banksia Digital)',
        description: '300 change records — emergency changes correlate with P1 incidents, Friday deployments have 3x rollback rate',
        sensitivity: 'CONFIDENTIAL',
        category: 'IT Operations',
        headers: ['change_id','type','status','requested_by','approved_by','implement_date','affected_servers','risk_level','success','rollback_reason','downtime_minutes'],
        descriptions: {
          change_id: 'Unique change request identifier',
          type: 'Change type (standard/normal/emergency)',
          status: 'Current status (approved/implemented/rolled_back/failed)',
          requested_by: 'Person who requested the change',
          approved_by: 'Person who approved the change',
          implement_date: 'Scheduled or actual implementation date',
          affected_servers: 'Server IDs affected (semicolon-separated)',
          risk_level: 'Risk assessment (low/medium/high)',
          success: 'Whether the change was successful (true/false)',
          rollback_reason: 'Reason for rollback if applicable',
          downtime_minutes: 'Downtime incurred in minutes'
        },
        pii: [],
        rows: rows
      };
    })(),
    'it_ops.app_performance': (function() {
      var apps = [
        {id: 'APP-001', name: 'Banksia Portal', endpoints: ['/api/auth/login','/api/auth/refresh','/api/users/profile','/api/users/settings','/api/dashboard','/api/reports/generate','/api/reports/export','/api/search','/api/notifications','/api/upload']},
        {id: 'APP-002', name: 'Banksia Mobile API', endpoints: ['/mobile/v2/feed','/mobile/v2/sync','/mobile/v2/push','/mobile/v2/checkout','/mobile/v2/catalogue']},
        {id: 'APP-003', name: 'Banksia Admin', endpoints: ['/admin/users','/admin/audit','/admin/config','/admin/metrics','/admin/deploy']},
        {id: 'APP-004', name: 'Banksia Payments', endpoints: ['/pay/process','/pay/refund','/pay/webhook','/pay/reconcile']}
      ];
      var methods = ['GET','GET','GET','POST','PUT','DELETE'];
      var versions = ['2.2.0','2.2.1','2.3.0','2.3.1','2.3.1','2.3.1','2.3.2'];
      var errorMessages = ['timeout exceeded','connection refused','null pointer exception','rate limit exceeded','invalid token','service unavailable','database connection pool exhausted'];
      var rows = [];
      for (var i = 0; i < 2000; i++) {
        var rid = 'APM-' + String(i + 1).padStart(5, '0');
        var app = apps[i % apps.length];
        var ep = app.endpoints[i % app.endpoints.length];
        var method = methods[i % methods.length];
        var hourOffset = Math.floor(i / 84);
        var ts = new Date(2026, 3, 1);
        ts.setHours(ts.getHours() + hourOffset);
        ts.setMinutes(Math.floor(((Math.sin(i * 2.3) + 1) / 2) * 59));
        var hour = ts.getHours();
        var isPeak = (hour >= 9 && hour <= 17);
        var versionIdx = Math.floor(i / 300);
        if (versionIdx >= versions.length) versionIdx = versions.length - 1;
        var version = versions[versionIdx];
        var isLatencyVersion = (version === '2.3.1');
        var isBadEndpoint = (ep === '/api/reports/generate');
        var baseRT = 45 + Math.floor(((Math.sin(i * 1.7) + 1) / 2) * 80);
        if (isLatencyVersion) baseRT = Math.floor(baseRT * 2.4);
        if (isPeak) baseRT = Math.floor(baseRT * 1.5);
        if (isBadEndpoint) baseRT = Math.floor(baseRT * 1.8);
        var statusCode = '200';
        var errMsg = '';
        var errorChance = isBadEndpoint ? 0.25 : 0.05;
        if ((Math.sin(i * 9.1) + 1) / 2 < errorChance) {
          var errCodes = ['400','401','403','404','500','502','503','504'];
          statusCode = errCodes[Math.floor(((Math.sin(i * 11.3) + 1) / 2) * errCodes.length)];
          errMsg = errorMessages[Math.floor(((Math.sin(i * 7.7) + 1) / 2) * errorMessages.length)];
        }
        var userCount = isPeak ? Math.floor(800 + ((Math.sin(i * 0.9) + 1) / 2) * 1200) : Math.floor(100 + ((Math.sin(i * 0.7) + 1) / 2) * 400);
        var reqCount = Math.floor(userCount * (2 + ((Math.sin(i * 1.1) + 1) / 2) * 6));
        var apdex = 0.94 - (isLatencyVersion ? 0.18 : 0) - (isPeak ? 0.08 : 0) - (isBadEndpoint ? 0.12 : 0);
        apdex = Math.max(0.32, Math.min(1.0, apdex + ((Math.sin(i * 3.3) + 1) / 2) * 0.06 - 0.03));
        var pad2 = function(n) { return String(n).padStart(2, '0'); };
        var tsStr = ts.getFullYear() + '-' + pad2(ts.getMonth() + 1) + '-' + pad2(ts.getDate()) + 'T' + pad2(ts.getHours()) + ':' + pad2(ts.getMinutes()) + ':00';
        rows.push([rid, app.id, app.name, ep, method, tsStr, String(baseRT), statusCode, errMsg, String(userCount), String(reqCount), apdex.toFixed(2), version]);
      }
      return {
        name: 'IT Application Performance (Banksia Digital)',
        description: '2,000 APM readings — v2.3.1 latency regression, one endpoint with 5x error rate, apdex drops at peak hours',
        sensitivity: 'CONFIDENTIAL',
        category: 'IT Operations',
        headers: ['reading_id','app_id','app_name','endpoint','method','timestamp','response_time_ms','status_code','error_message','user_count','request_count','apdex_score','deployment_version'],
        descriptions: {
          reading_id: 'Unique APM reading identifier',
          app_id: 'Application identifier',
          app_name: 'Application name',
          endpoint: 'API endpoint path',
          method: 'HTTP method (GET/POST/PUT/DELETE)',
          timestamp: 'Reading timestamp (ISO 8601)',
          response_time_ms: 'Response time in milliseconds',
          status_code: 'HTTP status code',
          error_message: 'Error message if applicable',
          user_count: 'Active users at time of reading',
          request_count: 'Total requests in sampling window',
          apdex_score: 'Application Performance Index (0-1)',
          deployment_version: 'Deployed application version'
        },
        pii: [],
        rows: rows
      };
    })(),

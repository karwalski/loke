<!-- ── Real, attributed open data (MK19) ──────────────────────────────
     Rendered from static/data/manifest.json rather than hand-written, so a new
     dataset arrives complete instead of needing edits in four files. Appended
     after the synthetic cards above rather than replacing them: both stores
     coexist during the migration (MK19.1). -->
<div id="real-datasets-section" hidden>
  <div class="section-heading">
    <h2>Real open data</h2>
    <p class="section-note">
      Attributed snapshots of government open data, committed so the demo works
      offline. These are <strong>not synthetic</strong> — which is the point of
      separating them. On a genuine public aggregate the privacy filter finds
      nothing, and that is the honest half of the contrast against the
      fabricated fixtures above, where it finds everything.
    </p>
  </div>
  <div class="ds-grid" id="real-datasets-grid"></div>
</div>

<!-- ── Upload ── -->
<div class="upload-section">
  <p>Have your own data? Upload a CSV or JSON file for local analysis.</p>
  <a href="/upload">⬆️ Upload your own data</a>
</div>

<script>

  // MK8.7 / MK20.5 — the relationships registry and cross-query suggestions moved
  // to static/js/moke-relationships.js. Both were defined here and called from
  // nowhere, so MK8.7 was marked Done for code that could not run: the chat page
  // cannot call a function defined in the landing page. The chips it feeds are now
  // built on /chat, and the joins are verified against the real column lists by
  // node packages/moke/static/js/tests/test-moke-relationships.js.

  /* ── Datasets come from the one store, static/data (MK19.1) ─────────────
   * This page used to carry every row of every dataset in a 230KB `var DATASETS`
   * object, while the server read different tables under the same ids from
   * data/csv. Both now live in static/data: manifest.json names each dataset and
   * points at its CSV, and MokeData fetches the rows when a dataset is loaded.
   *
   * The active dataset is still stored WITH its rows, as it was, because the
   * other pages read rows straight from sessionStorage. That is the active
   * dataset, not a store of them: nothing reads a dataset's rows from anywhere
   * but static/data. */
  var CATALOGUE = {};
  var catalogueReady = MokeData.catalogue().then(function (list) {
    list.forEach(function (d) { CATALOGUE[d.id] = d; });
    return CATALOGUE;
  });

  function activate(id, sensitivity) {
    return MokeActive.load(id, sensitivity);
  }

  function loadFailed(id, e) {
    console.error('[moke] could not load ' + id + ':', e);
    alert('Could not load that dataset: ' + e.message);
  }

  function loadDataset(id, selectorId) {
    var sensitivity = null;
    if (selectorId) {
      var selEl = document.getElementById(selectorId);
      if (selEl && selEl.value) sensitivity = selEl.value;
    }
    activate(id, sensitivity).then(function (ds) {
      // Add to project dataset list
      var projectDs = JSON.parse(localStorage.getItem('moke_project_datasets') || '[]');
      var entry = { id: id, name: ds.name, rows: ds.rows.length, sensitivity: ds.sensitivity, loadedAt: Date.now() };
      var existing = projectDs.findIndex(function(p) { return p.id === id; });
      if (existing >= 0) projectDs[existing] = entry; else projectDs.push(entry);
      localStorage.setItem('moke_project_datasets', JSON.stringify(projectDs));
      window.location.href = '/chat';
    }).catch(function (e) { loadFailed(id, e); });
  }

  // MK4.9.3 — Multi-dataset project support
  function refreshLoadedDatasets() {
    var bar = document.getElementById('project-datasets-bar');
    var list = document.getElementById('project-datasets-list');
    if (!bar || !list) return;
    var projectDs = JSON.parse(localStorage.getItem('moke_project_datasets') || '[]');
    if (projectDs.length === 0) { bar.style.display = 'none'; return; }
    bar.style.display = 'block';
    list.innerHTML = '';
    var activeDs = null;
    try { activeDs = JSON.parse(sessionStorage.getItem('moke_dataset')); } catch(_) {}
    projectDs.forEach(function(d) {
      var chip = document.createElement('div');
      var isActive = activeDs && activeDs.id === d.id;
      chip.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:20px;font-size:0.82em;cursor:pointer;border:1px solid ' + (isActive ? 'var(--teal)' : 'var(--border)') + ';color:' + (isActive ? 'var(--teal)' : 'var(--text)') + ';background:' + (isActive ? 'var(--teal-dim)' : 'transparent');
      chip.innerHTML = d.name + ' <span style="color:var(--muted);font-size:0.85em;">' + d.rows + ' rows</span>';
      chip.onclick = function() { switchToDataset(d.id, d.sensitivity); };
      list.appendChild(chip);
    });
  }

  function switchToDataset(id, sensitivity) {
    activate(id, sensitivity).then(function () {
      window.location.href = '/chat';
    }).catch(function (e) { loadFailed(id, e); });
  }

  function clearProject() {
    localStorage.removeItem('moke_project_datasets');
    sessionStorage.removeItem('moke_dataset');
    refreshLoadedDatasets();
  }

  refreshLoadedDatasets();

  // MK4.9.4 — Inject column description info into dataset cards
  // MK1.6 — Inject sensitivity selectors into all dataset cards at page load
  // Both read the manifest entry, which is where a dataset's descriptions and
  // default sensitivity now live.
  catalogueReady.then(function () {
    document.querySelectorAll('.load-btn').forEach(function(btn) {
      var oc = btn.getAttribute('onclick') || '';
      var m = oc.match(/loadDataset\('([^']+)'\)/);
      if (!m) return;
      var id = m[1];
      var d = CATALOGUE[id];
      if (!d) {
        // A card for a dataset the store does not hold. Disabled rather than left
        // to fail on click, and logged so it is noticed.
        console.error('[moke] card for ' + id + ' has no manifest entry');
        btn.disabled = true;
        return;
      }

      var count = d.descriptions ? Object.keys(d.descriptions).length : 0;
      var meta = btn.closest('.ds-card').querySelector('.ds-meta');
      if (count > 0 && meta) {
        var sep = document.createElement('span');
        sep.className = 'sep';
        sep.textContent = '·';
        var info = document.createElement('span');
        info.style.cssText = 'cursor:help;';
        info.title = Object.keys(d.descriptions).map(function(k) { return k + ': ' + d.descriptions[k]; }).join('\n');
        info.textContent = 'ℹ️ ' + count + ' cols described';
        meta.appendChild(sep);
        meta.appendChild(info);
      }

      var defaultSens = d.sensitivity || 'INTERNAL';
      var selId = 'sens-' + id.replace(/[.\/_]/g, '-');
      var sel = document.createElement('select');
      sel.className = 'sens-select' + (defaultSens === 'RESTRICTED' ? ' restricted' : '');
      sel.id = selId;
      sel.title = 'Override sensitivity classification before loading';
      ['PUBLIC', 'INTERNAL', 'CONFIDENTIAL', 'RESTRICTED'].forEach(function(s) {
        var opt = document.createElement('option');
        opt.value = s;
        opt.textContent = s;
        if (s === defaultSens) opt.selected = true;
        sel.appendChild(opt);
      });
      sel.addEventListener('change', function() {
        sel.className = 'sens-select' + (sel.value === 'RESTRICTED' ? ' restricted' : '');
      });
      // Update onclick to pass the selector id so loadDataset can read the override
      btn.setAttribute('onclick', "loadDataset('" + id + "', '" + selId + "')");
      btn.parentNode.insertBefore(sel, btn);
    });
  }).catch(function (e) {
    console.error('[moke] manifest unavailable; the dataset cards cannot load:', e);
  });
  /* ── Manifest-driven dataset cards (MK19.1, MK19.6) ──────────────────
   * Renders the real, attributed snapshots from static/data/manifest.json.
   * Fails quietly by leaving its section hidden: a missing manifest should not
   * break the page, but it must not silently look like there are no datasets
   * either, so the failure is logged and the section stays out of the way.
   */
  function renderManifestDatasets() {
    if (!window.MokeData) return;
    MokeData.catalogue().then(function (datasets) {
      var real = datasets.filter(function (d) { return d.kind === 'snapshot'; });
      if (!real.length) return;
      var grid = document.getElementById('real-datasets-grid');
      var section = document.getElementById('real-datasets-section');
      if (!grid || !section) return;

      grid.innerHTML = real.map(function (d) {
        var p = d.provenance || {};
        var rows = (d.data && d.data.rowcount) || 0;
        var cols = (d.data && d.data.colcount) || 0;
        var sens = (d.sensitivity || 'PUBLIC').toLowerCase();
        return '' +
          '<div class="ds-card" data-dataset-id="' + esc(d.id) + '">' +
            '<div class="ds-card-header">' +
              '<span class="ds-icon">\u{1F4C4}</span>' +
              '<span class="ds-name">' + esc(d.short_name || d.name) + '</span>' +
            '</div>' +
            '<p class="ds-desc">' + esc(d.description || '') + '</p>' +
            '<div class="ds-meta">' +
              '<span>' + rows.toLocaleString() + ' rows</span><span class="sep">\u00B7</span>' +
              '<span>' + cols + ' cols</span><span class="sep">\u00B7</span>' +
              '<span class="badge badge-' + esc(sens) + '">' + esc(d.sensitivity || 'PUBLIC') + '</span>' +
              '<span class="sep">\u00B7</span>' +
              '<span class="badge badge-real" title="Real government open data, not synthetic">real</span>' +
            '</div>' +
            '<p class="ds-provenance">' +
              esc(p.attribution || '') +
              (p.licence ? ' Licence: ' + esc(p.licence) + '.' : '') +
              (p.transformations && p.transformations.length
                ? ' This is a derived snapshot: ' + p.transformations.length +
                  ' transformation(s) recorded in the manifest.'
                : '') +
            '</p>' +
            '<div class="ds-footer">' +
              '<button class="load-btn" data-load-manifest="' + esc(d.id) + '">Load dataset</button>' +
            '</div>' +
          '</div>';
      }).join('');

      grid.querySelectorAll('[data-load-manifest]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          loadManifestDataset(btn.getAttribute('data-load-manifest'), btn);
        });
      });
      section.hidden = false;
    }).catch(function (e) {
      // Logged rather than surfaced: the synthetic datasets above still work, so
      // a manifest failure degrades the page rather than breaking it.
      console.warn('[moke] manifest unavailable, real datasets not shown:', e);
    });
  }

  /* MK19.1: loaded WITH its rows, as every other dataset is. This used to store a
   * handle with no rows (MokeActive.setFromManifest) to spare sessionStorage, but
   * no page resolves a handle: chat, dashboard and insight read rows straight from
   * sessionStorage, so the real snapshot reached /chat with nothing in it. 4,000
   * rows is well inside the quota; the 10,000-row metrics table was already stored
   * this way. */
  function loadManifestDataset(id, btn) {
    if (btn) { btn.disabled = true; btn.textContent = 'Loading\u2026'; }
    MokeActive.load(id).then(function () {
      window.location.href = '/chat';
    }).catch(function (e) {
      if (btn) { btn.disabled = false; btn.textContent = 'Load dataset'; }
      loadFailed(id, e);
    });
  }

  /* Escape for the innerHTML above. A dataset description comes from a manifest
   * in this repository rather than from a user, but escaping is the correct
   * default and costs nothing. */
  function esc(v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  document.addEventListener('DOMContentLoaded', renderManifestDatasets);

</script>
{! end !}

{! comment("MK9 — Pipeline Visibility Panel. Dockable panel showing real-time stage
    progression, detail expansion, and history sidebar. Included by chat.tkt.") !}

<!-- MK9: Pipeline Visibility Panel -->
<style>
  /* ── MK9.1: Pipeline stage panel ── */
  .pipeline-panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden; flex-shrink: 0;
    transition: max-height 0.3s ease;
  }
  .pipeline-panel.collapsed .pipeline-panel-body {
    display: none;
  }
  .pipeline-panel-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 14px; border-bottom: 1px solid var(--border);
    font-size: 0.72em; font-weight: 700; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--muted); cursor: pointer;
    user-select: none;
  }
  .pipeline-panel-header:hover { color: var(--text); }
  .pipeline-panel-header .toggle-icon {
    transition: transform 0.2s;
    font-size: 0.9em;
  }
  .pipeline-panel.collapsed .toggle-icon {
    transform: rotate(-90deg);
  }
  .pipeline-panel-body {
    padding: 12px 14px;
  }

  /* Stage list */
  .pipeline-stages {
    display: flex; flex-direction: column; gap: 2px;
  }
  .pipeline-stage {
    display: flex; align-items: center; gap: 10px;
    padding: 6px 8px; border-radius: 6px;
    font-size: 0.82em; cursor: pointer;
    transition: background 0.15s;
  }
  .pipeline-stage:hover {
    background: rgba(255,255,255,.04);
  }
  .pipeline-stage.expanded {
    background: rgba(255,255,255,.04);
  }

  /* Status indicator dot */
  .stage-indicator {
    width: 10px; height: 10px; border-radius: 50%;
    flex-shrink: 0;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .stage-indicator.status-pending {
    background: var(--border);
  }
  .stage-indicator.status-active {
    background: var(--teal);
    box-shadow: 0 0 8px var(--teal);
    animation: pulse-active 1.2s infinite;
  }
  .stage-indicator.status-complete {
    background: var(--green);
    box-shadow: 0 0 4px var(--green);
  }
  .stage-indicator.status-skipped {
    background: var(--muted);
    opacity: 0.5;
  }
  .stage-indicator.status-error {
    background: var(--red);
    box-shadow: 0 0 6px var(--red);
  }

  @keyframes pulse-active {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Stage label and timing */
  .stage-label {
    flex: 1; color: var(--text); font-weight: 500;
  }
  .stage-label.status-skipped {
    color: var(--muted); text-decoration: line-through; opacity: 0.6;
  }
  .stage-label.status-error {
    color: var(--red);
  }
  .stage-timing {
    font-family: monospace; font-size: 0.85em; color: var(--muted);
    min-width: 48px; text-align: right;
  }

  /* Connector lines between stages */
  .stage-connector {
    width: 1px; height: 6px; margin-left: 12px;
    background: var(--border);
  }
  .stage-connector.status-complete {
    background: var(--green);
  }
  .stage-connector.status-active {
    background: var(--teal);
  }

  /* ── MK9.2: Stage detail expansion ── */
  .stage-detail {
    display: none; margin-left: 28px; margin-top: 4px; margin-bottom: 6px;
    padding: 8px 12px;
    background: #0a0e13; border: 1px solid var(--border);
    border-radius: 6px; font-family: monospace; font-size: 0.78em;
    line-height: 1.7;
  }
  .stage-detail.open {
    display: block;
  }
  .detail-row {
    display: flex; gap: 8px;
  }
  .detail-key {
    color: var(--muted); min-width: 120px;
  }
  .detail-value {
    color: var(--text);
  }
  .detail-value.violation {
    color: var(--red); font-weight: 600;
  }
  .detail-value.cache-hit {
    color: var(--green);
  }

  /* Total duration bar */
  .pipeline-total {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 8px 0; margin-top: 8px;
    border-top: 1px solid var(--border);
    font-size: 0.78em; color: var(--muted);
  }
  .pipeline-total .total-label { font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .pipeline-total .total-value { font-family: monospace; color: var(--text); font-weight: 600; }
  .pipeline-status-badge {
    font-size: 0.72em; font-weight: 600; padding: 1px 7px;
    border-radius: 4px; margin-left: 8px;
  }
  .pipeline-status-badge.status-complete { background: rgba(63,185,80,.15); color: var(--green); }
  .pipeline-status-badge.status-error { background: rgba(248,81,73,.15); color: var(--red); }
  .pipeline-status-badge.status-active { background: var(--teal-dim); color: var(--teal); }

  /* ── MK9.3: Pipeline history sidebar ── */
  .pipeline-history {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden; flex-shrink: 0;
    margin-top: 14px;
  }
  .pipeline-history-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 14px; border-bottom: 1px solid var(--border);
    font-size: 0.72em; font-weight: 700; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--muted); cursor: pointer;
    user-select: none;
  }
  .pipeline-history-header:hover { color: var(--text); }
  .pipeline-history-body {
    max-height: 240px; overflow-y: auto;
  }
  .pipeline-history.collapsed .pipeline-history-body {
    display: none;
  }
  .history-item {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-bottom: 1px solid var(--border);
    font-size: 0.8em; cursor: pointer;
    transition: background 0.15s;
  }
  .history-item:last-child { border-bottom: none; }
  .history-item:hover { background: rgba(255,255,255,.04); }
  .history-item.active { background: var(--teal-dim); }
  .history-status-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  }
  .history-status-dot.complete { background: var(--green); }
  .history-status-dot.error { background: var(--red); }
  .history-id { flex: 1; font-family: monospace; color: var(--text); font-size: 0.9em; }
  .history-time { color: var(--muted); font-size: 0.85em; }
  .history-duration { font-family: monospace; color: var(--muted); font-size: 0.85em; }
  .history-empty {
    padding: 16px 14px; text-align: center;
    font-size: 0.82em; color: var(--muted);
  }
</style>

<!-- Pipeline Visibility Panel -->
<div class="pipeline-panel" id="pipeline-panel">
  <div class="pipeline-panel-header" onclick="window.mokePipeline.togglePanel()">
    <span>Pipeline Stages</span>
    <span class="toggle-icon">&#9660;</span>
  </div>
  <div class="pipeline-panel-body" id="pipeline-panel-body">
    <div class="pipeline-stages" id="pipeline-stages">
      <!-- Stages rendered by JS -->
    </div>
    <div class="pipeline-total" id="pipeline-total" style="display:none;">
      <span class="total-label">Total</span>
      <span>
        <span class="total-value" id="pipeline-total-ms">0ms</span>
        <span class="pipeline-status-badge status-complete" id="pipeline-overall-badge">complete</span>
      </span>
    </div>
  </div>
</div>

<!-- Pipeline History Sidebar (MK9.3) -->
<div class="pipeline-history" id="pipeline-history">
  <div class="pipeline-history-header" onclick="window.mokePipeline.toggleHistory()">
    <span>Pipeline History</span>
    <span class="toggle-icon">&#9660;</span>
  </div>
  <div class="pipeline-history-body" id="pipeline-history-body">
    <div class="history-empty" id="history-empty">No pipeline runs yet</div>
  </div>
</div>

<script>
(function() {
  'use strict';

  // ── Pipeline stage definitions (matches core/pipeline/types.tk) ──
  var STAGES = [
    { id: 'input',              label: 'Input' },
    { id: 'privacy_scan',       label: 'Privacy Scan' },
    { id: 'anonymisation',      label: 'Anonymisation' },
    { id: 'token_optimisation', label: 'Token Optimisation' },
    { id: 'routing',            label: 'Routing' },
    { id: 'llm_call',          label: 'LLM Call' },
    { id: 'response_scan',     label: 'Response Scan' },
    { id: 'deanonymisation',   label: 'De-anonymisation' },
    { id: 'output',            label: 'Output' }
  ];

  var stagesEl = document.getElementById('pipeline-stages');
  var totalEl = document.getElementById('pipeline-total');
  var totalMsEl = document.getElementById('pipeline-total-ms');
  var overallBadge = document.getElementById('pipeline-overall-badge');
  var historyBody = document.getElementById('pipeline-history-body');
  var historyEmpty = document.getElementById('history-empty');

  // Current stage state for the active pipeline run
  var currentStages = {};
  var pipelineHistory = [];
  var expandedStage = null;

  // ── Initialise all stages as pending ──
  function resetStages() {
    currentStages = {};
    expandedStage = null;
    STAGES.forEach(function(s) {
      currentStages[s.id] = { status: 'pending', duration_ms: 0, details: [], error_message: '' };
    });
    renderStages();
    totalEl.style.display = 'none';
  }

  // ── Render the stage list ──
  function renderStages() {
    var html = '';
    STAGES.forEach(function(s, idx) {
      var state = currentStages[s.id] || { status: 'pending', duration_ms: 0, details: [], error_message: '' };
      var isExpanded = expandedStage === s.id;
      var statusCls = 'status-' + state.status;
      var labelCls = (state.status === 'skipped' || state.status === 'error') ? ' ' + statusCls : '';
      var timing = state.duration_ms > 0 ? state.duration_ms + 'ms' : (state.status === 'pending' ? '' : '0ms');

      html += '<div class="pipeline-stage' + (isExpanded ? ' expanded' : '') + '" data-stage="' + s.id + '" onclick="window.mokePipeline.toggleStageDetail(\'' + s.id + '\')">';
      html += '<div class="stage-indicator ' + statusCls + '"></div>';
      html += '<span class="stage-label' + labelCls + '">' + s.label + '</span>';
      html += '<span class="stage-timing">' + timing + '</span>';
      html += '</div>';

      // Detail expansion panel (MK9.2)
      html += '<div class="stage-detail' + (isExpanded ? ' open' : '') + '" id="stage-detail-' + s.id + '">';
      if (state.details && state.details.length > 0) {
        state.details.forEach(function(d) {
          var valueCls = '';
          if (d.key === 'violations_found' && parseInt(d.value) > 0) valueCls = ' violation';
          if (d.key === 'cache_hit' && d.value === 'true') valueCls = ' cache-hit';
          html += '<div class="detail-row">';
          html += '<span class="detail-key">' + escHtml(d.key) + '</span>';
          html += '<span class="detail-value' + valueCls + '">' + escHtml(d.value) + '</span>';
          html += '</div>';
        });
      } else if (state.error_message) {
        html += '<div class="detail-row">';
        html += '<span class="detail-key">error</span>';
        html += '<span class="detail-value violation">' + escHtml(state.error_message) + '</span>';
        html += '</div>';
      } else {
        html += '<div class="detail-row"><span class="detail-key" style="color:var(--muted);font-style:italic;">No detail data</span></div>';
      }
      html += '</div>';

      // Connector line between stages
      if (idx < STAGES.length - 1) {
        var nextState = currentStages[STAGES[idx + 1].id] || { status: 'pending' };
        var connCls = state.status === 'complete' ? ' status-complete' : (state.status === 'active' ? ' status-active' : '');
        html += '<div class="stage-connector' + connCls + '"></div>';
      }
    });
    stagesEl.innerHTML = html;
  }

  // ── Update stages from pipeline response data ──
  function updateFromResponse(pipelineStages, runId) {
    if (!pipelineStages || !Array.isArray(pipelineStages)) return;

    // Build a lookup from the flat event list. Events come in pairs
    // (active then complete/skipped/error) so take the last event per stage.
    var stageMap = {};
    pipelineStages.forEach(function(evt) {
      stageMap[evt.stage] = evt;
    });

    STAGES.forEach(function(s) {
      var evt = stageMap[s.id];
      if (evt) {
        currentStages[s.id] = {
          status: evt.status,
          duration_ms: evt.duration_ms || 0,
          details: evt.details || [],
          error_message: evt.error_message || ''
        };
      }
    });

    renderStages();

    // Show total
    var totalMs = 0;
    var overallStatus = 'complete';
    STAGES.forEach(function(s) {
      var st = currentStages[s.id];
      if (st) {
        totalMs += st.duration_ms || 0;
        if (st.status === 'error') overallStatus = 'error';
      }
    });
    totalMsEl.textContent = totalMs + 'ms';
    overallBadge.textContent = overallStatus;
    overallBadge.className = 'pipeline-status-badge status-' + overallStatus;
    totalEl.style.display = 'flex';

    // Add to history (MK9.3)
    addToHistory({
      id: runId || 'run-' + Date.now(),
      overall_status: overallStatus,
      total_duration_ms: totalMs,
      started_at: Date.now(),
      events: pipelineStages
    });
  }

  // ── Simulate stage progression while waiting for response ──
  var progressionTimer = null;

  function simulateProgression() {
    resetStages();
    var stageIdx = 0;
    function nextStage() {
      if (stageIdx >= STAGES.length) return;
      var s = STAGES[stageIdx];
      currentStages[s.id].status = 'active';
      renderStages();
      stageIdx++;
      // Vary timing: LLM call gets extra time
      var delay = s.id === 'llm_call' ? 1500 : (200 + Math.random() * 300);
      progressionTimer = setTimeout(function() {
        currentStages[s.id].status = 'complete';
        renderStages();
        nextStage();
      }, delay);
    }
    nextStage();
  }

  function stopProgression() {
    if (progressionTimer) {
      clearTimeout(progressionTimer);
      progressionTimer = null;
    }
  }

  // ── MK9.2: Toggle stage detail expansion ──
  function toggleStageDetail(stageId) {
    expandedStage = (expandedStage === stageId) ? null : stageId;
    renderStages();
  }

  // ── MK9.3: Pipeline history ──
  function addToHistory(run) {
    pipelineHistory.unshift(run);
    if (pipelineHistory.length > 50) pipelineHistory.pop();
    renderHistory();
  }

  function renderHistory() {
    if (pipelineHistory.length === 0) {
      historyEmpty.style.display = 'block';
      return;
    }
    historyEmpty.style.display = 'none';

    var html = '';
    pipelineHistory.forEach(function(run, idx) {
      var dotCls = run.overall_status === 'error' ? 'error' : 'complete';
      var ts = new Date(run.started_at);
      var timeStr = String(ts.getHours()).padStart(2, '0') + ':' + String(ts.getMinutes()).padStart(2, '0') + ':' + String(ts.getSeconds()).padStart(2, '0');
      var shortId = run.id.length > 16 ? run.id.substring(0, 16) + '...' : run.id;

      html += '<div class="history-item" data-idx="' + idx + '" onclick="window.mokePipeline.replayRun(' + idx + ')">';
      html += '<div class="history-status-dot ' + dotCls + '"></div>';
      html += '<span class="history-id">' + escHtml(shortId) + '</span>';
      html += '<span class="history-time">' + timeStr + '</span>';
      html += '<span class="history-duration">' + run.total_duration_ms + 'ms</span>';
      html += '</div>';
    });
    historyBody.innerHTML = html;
  }

  // ── MK9.3: Replay a historical pipeline run ──
  function replayRun(idx) {
    var run = pipelineHistory[idx];
    if (!run) return;

    // Mark the active history item
    var items = historyBody.querySelectorAll('.history-item');
    items.forEach(function(el) { el.classList.remove('active'); });
    if (items[idx]) items[idx].classList.add('active');

    // Reset and replay stage progression with timing
    resetStages();
    var events = run.events || [];
    var stageMap = {};
    events.forEach(function(evt) {
      stageMap[evt.stage] = evt;
    });

    var stageIdx = 0;
    function replayNext() {
      if (stageIdx >= STAGES.length) {
        // Show totals
        totalMsEl.textContent = run.total_duration_ms + 'ms';
        overallBadge.textContent = run.overall_status;
        overallBadge.className = 'pipeline-status-badge status-' + run.overall_status;
        totalEl.style.display = 'flex';
        return;
      }
      var s = STAGES[stageIdx];
      var evt = stageMap[s.id];
      stageIdx++;

      if (evt) {
        // Show active briefly, then resolved state
        currentStages[s.id].status = 'active';
        renderStages();
        setTimeout(function() {
          currentStages[s.id] = {
            status: evt.status,
            duration_ms: evt.duration_ms || 0,
            details: evt.details || [],
            error_message: evt.error_message || ''
          };
          renderStages();
          replayNext();
        }, Math.min(evt.duration_ms || 100, 400));
      } else {
        replayNext();
      }
    }
    replayNext();
  }

  // ── Panel toggle ──
  function togglePanel() {
    document.getElementById('pipeline-panel').classList.toggle('collapsed');
  }

  function toggleHistory() {
    document.getElementById('pipeline-history').classList.toggle('collapsed');
  }

  // ── Fetch history from server on load ──
  function fetchHistory() {
    fetch('/api/pipeline?count=20', { method: 'GET', cache: 'no-store' })
      .then(function(r) { return r.json(); })
      .then(function(runs) {
        if (Array.isArray(runs)) {
          runs.forEach(function(run) {
            pipelineHistory.push(run);
          });
          renderHistory();
        }
      })
      .catch(function() { /* history not available yet */ });
  }

  // ── Utilities ──
  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ── Initialise ──
  resetStages();
  fetchHistory();

  // ── Public API ──
  window.mokePipeline = {
    resetStages: resetStages,
    updateFromResponse: updateFromResponse,
    simulateProgression: simulateProgression,
    stopProgression: stopProgression,
    toggleStageDetail: toggleStageDetail,
    togglePanel: togglePanel,
    toggleHistory: toggleHistory,
    replayRun: replayRun,
    getHistory: function() { return pipelineHistory; }
  };
})();
</script>

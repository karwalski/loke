{! layout("base") !}
{! block("title") !}moke — Memory Palace{! end !}
{! block("content") !}

<style>
  /* ── Memory Palace styles ── */
  .palace-header {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 20px;
  }
  .palace-header h2 {
    font-size: 1.05em; font-weight: 600; color: var(--text);
  }
  .palace-header .palace-badge {
    font-size: 0.75em; color: var(--teal); font-weight: 600;
    letter-spacing: 0.04em; display: flex; align-items: center; gap: 5px;
  }
  .palace-header .palace-badge::before {
    content: ''; display: inline-block; width: 7px; height: 7px;
    border-radius: 50%; background: var(--teal);
  }

  /* ── Breadcrumb nav ── */
  .palace-breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.82em; color: var(--muted); margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .palace-breadcrumb a {
    color: var(--teal); text-decoration: none; cursor: pointer;
  }
  .palace-breadcrumb a:hover { text-decoration: underline; }
  .palace-breadcrumb .sep { color: var(--border); }

  /* ── Search bar ── */
  .palace-search {
    display: flex; gap: 8px; margin-bottom: 20px;
  }
  .palace-search-input {
    flex: 1; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 14px; color: var(--text);
    font-family: inherit; font-size: 0.9em; outline: none;
    transition: border-color 0.15s;
  }
  .palace-search-input:focus { border-color: var(--teal); }
  .palace-search-btn {
    padding: 10px 18px; background: var(--teal); color: #0d1117;
    border: none; border-radius: 8px; cursor: pointer; font-weight: 700;
    font-size: 0.88em; white-space: nowrap; transition: opacity 0.15s;
  }
  .palace-search-btn:hover { opacity: 0.88; }

  /* ── Search results ── */
  .search-results { display: none; margin-bottom: 20px; }
  .search-results.visible { display: block; }
  .search-result-item {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 14px 16px; margin-bottom: 10px;
    cursor: pointer; transition: border-color 0.15s;
  }
  .search-result-item:hover { border-color: var(--teal); }
  .sr-header { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .sr-location { font-size: 0.78em; color: var(--teal); font-family: monospace; }
  .sr-score {
    font-size: 0.7em; padding: 2px 7px; border-radius: 4px;
    background: var(--teal-dim); color: var(--teal); font-weight: 600;
  }
  .sr-source {
    font-size: 0.7em; padding: 2px 7px; border-radius: 4px;
    background: rgba(139,148,158,.12); color: var(--muted); font-weight: 600;
  }
  .sr-excerpt { font-size: 0.85em; color: var(--muted); line-height: 1.5; }
  .sr-timestamp { font-size: 0.72em; color: var(--border); margin-top: 6px; }

  /* ── Palace grid ── */
  .palace-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .palace-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 18px 20px; cursor: pointer;
    transition: border-color 0.15s, transform 0.1s;
  }
  .palace-card:hover { border-color: var(--teal); transform: translateY(-2px); }
  .palace-card .pc-icon { font-size: 1.6em; margin-bottom: 10px; }
  .palace-card .pc-name {
    font-size: 0.95em; font-weight: 600; color: var(--text); margin-bottom: 4px;
  }
  .palace-card .pc-count {
    font-size: 0.78em; color: var(--muted);
  }
  .palace-card .pc-meta {
    display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;
  }
  .palace-card .pc-badge {
    font-size: 0.68em; padding: 2px 7px; border-radius: 4px;
    font-weight: 600;
  }
  .pc-badge-wing { background: rgba(20,184,166,.15); color: var(--teal); }
  .pc-badge-hall { background: rgba(59,130,246,.12); color: #60a5fa; }
  .pc-badge-room { background: rgba(63,185,80,.12); color: var(--green); }

  /* ── Drawer list ── */
  .drawer-list { display: flex; flex-direction: column; gap: 10px; }
  .drawer-item {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 14px 16px;
    transition: border-color 0.15s;
  }
  .drawer-item:hover { border-color: var(--teal); }
  .drawer-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 8px;
  }
  .drawer-id { font-size: 0.72em; font-family: monospace; color: var(--muted); }
  .drawer-source {
    font-size: 0.68em; padding: 2px 7px; border-radius: 4px;
    background: rgba(139,148,158,.12); color: var(--muted); font-weight: 600;
  }
  .drawer-content {
    font-size: 0.85em; color: var(--text); line-height: 1.6;
    word-break: break-word;
  }
  .drawer-footer {
    display: flex; align-items: center; gap: 12px; margin-top: 8px;
    font-size: 0.72em; color: var(--muted);
  }

  /* ── AAAK toggle ── */
  .aaak-toggle {
    display: flex; align-items: center; gap: 8px;
    margin-bottom: 16px;
  }
  .aaak-toggle label { font-size: 0.85em; color: var(--muted); cursor: pointer; }
  .aaak-toggle input[type="checkbox"] { accent-color: var(--teal); }
  .aaak-panel {
    background: #0a0e13; border: 1px solid var(--border);
    border-radius: 8px; padding: 14px 16px; margin-bottom: 16px;
    font-family: monospace; font-size: 0.78em; line-height: 1.7;
    display: none;
  }
  .aaak-panel.visible { display: block; }
  .aaak-compressed { color: var(--teal); }
  .aaak-expanded { color: var(--muted); }
  .aaak-ratio {
    font-size: 0.72em; color: var(--amber); margin-top: 8px;
  }

  /* ── Empty state ── */
  .palace-empty {
    text-align: center; padding: 48px 20px; color: var(--muted);
  }
  .palace-empty .pe-icon { font-size: 3em; opacity: 0.3; margin-bottom: 12px; }
  .palace-empty .pe-text { font-size: 0.9em; }

  @media (max-width: 600px) {
    .palace-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="palace-header">
  <h2>Memory Palace</h2>
  <span class="palace-badge">Local memory &mdash; zero egress</span>
</div>

<!-- Breadcrumb -->
<div class="palace-breadcrumb" id="palace-breadcrumb">
  <a onclick="navigateTo('root')">Palace</a>
</div>

<!-- MK13.3: Search bar -->
<div class="palace-search">
  <input class="palace-search-input" id="palace-search-input"
    placeholder="Search memories semantically..." onkeydown="if(event.key==='Enter')searchPalace()">
  <button class="palace-search-btn" onclick="searchPalace()">Search</button>
</div>

<!-- Search results -->
<div class="search-results" id="search-results"></div>

<!-- MK13.4: AAAK context toggle -->
<div class="aaak-toggle">
  <input type="checkbox" id="aaak-toggle-cb" onchange="toggleAAAK()">
  <label for="aaak-toggle-cb">Show AAAK compressed context</label>
</div>
<div class="aaak-panel" id="aaak-panel">
  <div><strong>Compressed (AAAK):</strong></div>
  <div class="aaak-compressed" id="aaak-compressed">No context loaded</div>
  <div style="margin-top:10px"><strong>Expanded:</strong></div>
  <div class="aaak-expanded" id="aaak-expanded">No context loaded</div>
  <div class="aaak-ratio" id="aaak-ratio"></div>
</div>

<!-- Palace content area -->
<div id="palace-content">
  <div class="palace-grid" id="palace-grid"></div>
  <div class="drawer-list" id="drawer-list" style="display:none"></div>
</div>

<script>
(function() {
  'use strict';

  var LS_KEY = 'moke_memory_palace';
  var palace = loadPalace();
  var currentView = { level: 'wings', wing: null, hall: null, room: null };

  // ── Palace data structure ──
  // Stored in localStorage as: { drawers: [ { id, wing, hall, room, content, source, created_at } ] }

  function loadPalace() {
    try {
      var raw = localStorage.getItem(LS_KEY);
      if (raw) return JSON.parse(raw);
    } catch(e) {}
    return { drawers: getDefaultDrawers() };
  }

  function savePalace() {
    try { localStorage.setItem(LS_KEY, JSON.stringify(palace)); } catch(e) {}
  }

  function getDefaultDrawers() {
    return [
      { id: 'drw_demo_1', wing: 'work', hall: 'projects', room: 'moke', content: 'moke is a data analysis demo built on the loke privacy proxy. It demonstrates schema-first analysis, local ML, and privacy-preserving LLM integration.', source: 'system', created_at: new Date().toISOString() },
      { id: 'drw_demo_2', wing: 'work', hall: 'projects', room: 'loke', content: 'loke is a locally-run intelligence layer between users and external LLMs. It intercepts, anonymises, optimises, and routes LLM traffic.', source: 'system', created_at: new Date().toISOString() },
      { id: 'drw_demo_3', wing: 'work', hall: 'datasets', room: 'general', content: 'Common dataset patterns include customer data with PII columns (name, email, phone), financial data with revenue and cost metrics, and time-series data with date columns.', source: 'system', created_at: new Date().toISOString() },
      { id: 'drw_demo_4', wing: 'reference', hall: 'privacy', room: 'pii', content: 'PII detection covers names, emails, phone numbers, Medicare/SSN/TFN identifiers, dates of birth, and credit card numbers. Detection uses regex, NLP, and SLM layers.', source: 'system', created_at: new Date().toISOString() },
      { id: 'drw_demo_5', wing: 'reference', hall: 'models', room: 'local', content: 'Local models available via Ollama: llama3.2:3b (general purpose), qwen2.5:0.5b (fast, lightweight). MLX models available on Apple Silicon.', source: 'system', created_at: new Date().toISOString() }
    ];
  }

  // ── MK13.1: Navigate palace hierarchy ──

  function getWings() {
    var wings = {};
    palace.drawers.forEach(function(d) {
      if (!wings[d.wing]) wings[d.wing] = { count: 0, halls: {} };
      wings[d.wing].count++;
      if (!wings[d.wing].halls[d.hall]) wings[d.wing].halls[d.hall] = 0;
      wings[d.wing].halls[d.hall]++;
    });
    return wings;
  }

  function getHalls(wing) {
    var halls = {};
    palace.drawers.filter(function(d) { return d.wing === wing; }).forEach(function(d) {
      if (!halls[d.hall]) halls[d.hall] = { count: 0, rooms: {} };
      halls[d.hall].count++;
      if (!halls[d.hall].rooms[d.room]) halls[d.hall].rooms[d.room] = 0;
      halls[d.hall].rooms[d.room]++;
    });
    return halls;
  }

  function getRooms(wing, hall) {
    var rooms = {};
    palace.drawers.filter(function(d) {
      return d.wing === wing && d.hall === hall;
    }).forEach(function(d) {
      if (!rooms[d.room]) rooms[d.room] = 0;
      rooms[d.room]++;
    });
    return rooms;
  }

  function getDrawers(wing, hall, room) {
    return palace.drawers.filter(function(d) {
      return d.wing === wing && d.hall === hall && d.room === room;
    }).sort(function(a, b) {
      return new Date(b.created_at) - new Date(a.created_at);
    });
  }

  var WING_ICONS = { work: '&#x1F3E2;', reference: '&#x1F4DA;', personal: '&#x1F3E0;', learning: '&#x1F393;' };
  var HALL_ICONS = { projects: '&#x1F4C2;', datasets: '&#x1F4CA;', privacy: '&#x1F512;', models: '&#x1F916;' };

  function renderWings() {
    var wings = getWings();
    var grid = document.getElementById('palace-grid');
    var drawerList = document.getElementById('drawer-list');
    grid.style.display = 'grid';
    drawerList.style.display = 'none';

    if (Object.keys(wings).length === 0) {
      grid.innerHTML = '<div class="palace-empty"><div class="pe-icon">&#x1F3DB;</div><div class="pe-text">No memories yet. Start a chat to auto-populate the palace.</div></div>';
      return;
    }

    var html = '';
    Object.keys(wings).sort().forEach(function(wing) {
      var w = wings[wing];
      var hallCount = Object.keys(w.halls).length;
      var icon = WING_ICONS[wing] || '&#x1F3DB;';
      html += '<div class="palace-card" onclick="navigateTo(\'wing\',\'' + esc(wing) + '\')">'
        + '<div class="pc-icon">' + icon + '</div>'
        + '<div class="pc-name">' + esc(wing) + '</div>'
        + '<div class="pc-count">' + w.count + ' drawers &middot; ' + hallCount + ' halls</div>'
        + '<div class="pc-meta"><span class="pc-badge pc-badge-wing">wing</span></div>'
        + '</div>';
    });
    grid.innerHTML = html;
  }

  function renderHalls(wing) {
    var halls = getHalls(wing);
    var grid = document.getElementById('palace-grid');
    var drawerList = document.getElementById('drawer-list');
    grid.style.display = 'grid';
    drawerList.style.display = 'none';

    var html = '';
    Object.keys(halls).sort().forEach(function(hall) {
      var h = halls[hall];
      var roomCount = Object.keys(h.rooms).length;
      var icon = HALL_ICONS[hall] || '&#x1F4C1;';
      html += '<div class="palace-card" onclick="navigateTo(\'hall\',\'' + esc(wing) + '\',\'' + esc(hall) + '\')">'
        + '<div class="pc-icon">' + icon + '</div>'
        + '<div class="pc-name">' + esc(hall) + '</div>'
        + '<div class="pc-count">' + h.count + ' drawers &middot; ' + roomCount + ' rooms</div>'
        + '<div class="pc-meta"><span class="pc-badge pc-badge-hall">hall</span></div>'
        + '</div>';
    });
    if (!html) html = '<div class="palace-empty"><div class="pe-icon">&#x1F4C2;</div><div class="pe-text">No halls in this wing.</div></div>';
    grid.innerHTML = html;
  }

  function renderRooms(wing, hall) {
    var rooms = getRooms(wing, hall);
    var grid = document.getElementById('palace-grid');
    var drawerList = document.getElementById('drawer-list');
    grid.style.display = 'grid';
    drawerList.style.display = 'none';

    var html = '';
    Object.keys(rooms).sort().forEach(function(room) {
      html += '<div class="palace-card" onclick="navigateTo(\'room\',\'' + esc(wing) + '\',\'' + esc(hall) + '\',\'' + esc(room) + '\')">'
        + '<div class="pc-icon">&#x1F5C4;</div>'
        + '<div class="pc-name">' + esc(room) + '</div>'
        + '<div class="pc-count">' + rooms[room] + ' drawers</div>'
        + '<div class="pc-meta"><span class="pc-badge pc-badge-room">room</span></div>'
        + '</div>';
    });
    if (!html) html = '<div class="palace-empty"><div class="pe-icon">&#x1F5C4;</div><div class="pe-text">No rooms in this hall.</div></div>';
    grid.innerHTML = html;
  }

  function renderDrawers(wing, hall, room) {
    var drawers = getDrawers(wing, hall, room);
    var grid = document.getElementById('palace-grid');
    var drawerList = document.getElementById('drawer-list');
    grid.style.display = 'none';
    drawerList.style.display = 'flex';

    if (drawers.length === 0) {
      drawerList.innerHTML = '<div class="palace-empty"><div class="pe-icon">&#x1F4E6;</div><div class="pe-text">No drawers in this room.</div></div>';
      return;
    }

    var html = '';
    drawers.forEach(function(d) {
      var ts = d.created_at ? new Date(d.created_at).toLocaleString() : 'unknown';
      html += '<div class="drawer-item">'
        + '<div class="drawer-header">'
        +   '<span class="drawer-id">' + esc(d.id) + '</span>'
        +   '<span class="drawer-source">' + esc(d.source || 'unknown') + '</span>'
        + '</div>'
        + '<div class="drawer-content">' + esc(d.content) + '</div>'
        + '<div class="drawer-footer"><span>' + esc(ts) + '</span></div>'
        + '</div>';
    });
    drawerList.innerHTML = html;
  }

  function updateBreadcrumb() {
    var el = document.getElementById('palace-breadcrumb');
    var html = '<a onclick="navigateTo(\'root\')">Palace</a>';
    if (currentView.wing) {
      html += '<span class="sep">&rsaquo;</span>';
      html += '<a onclick="navigateTo(\'wing\',\'' + esc(currentView.wing) + '\')">' + esc(currentView.wing) + '</a>';
    }
    if (currentView.hall) {
      html += '<span class="sep">&rsaquo;</span>';
      html += '<a onclick="navigateTo(\'hall\',\'' + esc(currentView.wing) + '\',\'' + esc(currentView.hall) + '\')">' + esc(currentView.hall) + '</a>';
    }
    if (currentView.room) {
      html += '<span class="sep">&rsaquo;</span>';
      html += '<span>' + esc(currentView.room) + '</span>';
    }
    el.innerHTML = html;
  }

  window.navigateTo = function(level, wing, hall, room) {
    document.getElementById('search-results').classList.remove('visible');
    if (level === 'root') {
      currentView = { level: 'wings', wing: null, hall: null, room: null };
      renderWings();
    } else if (level === 'wing') {
      currentView = { level: 'halls', wing: wing, hall: null, room: null };
      renderHalls(wing);
    } else if (level === 'hall') {
      currentView = { level: 'rooms', wing: wing, hall: hall, room: null };
      renderRooms(wing, hall);
    } else if (level === 'room') {
      currentView = { level: 'drawers', wing: wing, hall: hall, room: room };
      renderDrawers(wing, hall, room);
    }
    updateBreadcrumb();
    updateAAAK();
  };

  // ── MK13.3: Semantic search ──

  var STOP_WORDS = ['the','a','an','and','or','but','in','on','at','to','for','of','with','by','is','was','are','be','been','have','has','had','do','does','did','will','would','could','should','may','might','not','no','it','its','this','that','i','you','we','they','he','she'];

  function extractKeywords(text) {
    return text.toLowerCase().split(/\s+/).filter(function(w) {
      return w.length > 3 && STOP_WORDS.indexOf(w) === -1;
    });
  }

  function searchDrawers(query) {
    var keywords = extractKeywords(query);
    if (keywords.length === 0) return [];

    var scored = [];
    palace.drawers.forEach(function(d) {
      var contentLower = d.content.toLowerCase();
      var score = 0;
      keywords.forEach(function(kw) {
        if (contentLower.indexOf(kw) !== -1) score += 1.0;
        // Partial match bonus
        var words = contentLower.split(/\s+/);
        words.forEach(function(w) {
          if (w.indexOf(kw) === 0 && w !== kw) score += 0.3;
        });
      });
      if (score > 0) {
        scored.push({
          drawer: d,
          score: Math.round(score * 100) / 100
        });
      }
    });

    scored.sort(function(a, b) { return b.score - a.score; });
    return scored.slice(0, 20);
  }

  window.searchPalace = function() {
    var input = document.getElementById('palace-search-input');
    var query = input.value.trim();
    if (!query) return;

    var results = searchDrawers(query);
    var el = document.getElementById('search-results');

    if (results.length === 0) {
      el.innerHTML = '<div class="palace-empty" style="padding:20px"><div class="pe-text">No memories match "' + esc(query) + '"</div></div>';
      el.classList.add('visible');
      return;
    }

    var html = '<div style="font-size:0.78em;color:var(--muted);margin-bottom:10px;">' + results.length + ' results for "' + esc(query) + '"</div>';
    results.forEach(function(r) {
      var d = r.drawer;
      var ts = d.created_at ? new Date(d.created_at).toLocaleString() : '';
      var excerpt = d.content.length > 200 ? d.content.substring(0, 200) + '...' : d.content;
      html += '<div class="search-result-item" onclick="navigateTo(\'room\',\'' + esc(d.wing) + '\',\'' + esc(d.hall) + '\',\'' + esc(d.room) + '\')">'
        + '<div class="sr-header">'
        +   '<span class="sr-location">' + esc(d.wing) + ' / ' + esc(d.hall) + ' / ' + esc(d.room) + '</span>'
        +   '<span class="sr-score">' + r.score.toFixed(1) + '</span>'
        +   '<span class="sr-source">' + esc(d.source || 'unknown') + '</span>'
        + '</div>'
        + '<div class="sr-excerpt">' + esc(excerpt) + '</div>'
        + '<div class="sr-timestamp">' + esc(ts) + '</div>'
        + '</div>';
    });
    el.innerHTML = html;
    el.classList.add('visible');
  };

  // ── MK13.4: AAAK context display ──

  // Simple AAAK compression (client-side version of core.memory.aaak)
  function aaakCompress(text) {
    var s = text;
    // Strip articles
    s = s.replace(/\bthe\b/gi, '').replace(/\ba\b/gi, '').replace(/\ban\b/gi, '');
    // Strip prepositions
    s = s.replace(/\bof\b/gi, '').replace(/\bfor\b/gi, '').replace(/\bin\b/gi, '');
    s = s.replace(/\bon\b/gi, '').replace(/\bat\b/gi, '').replace(/\bto\b/gi, '');
    s = s.replace(/\bby\b/gi, '').replace(/\bwith\b/gi, '');
    // Copula patterns: "X is Y" -> "X: Y"
    s = s.replace(/\b(\w+)\s+is\s+/gi, '$1: ');
    s = s.replace(/\b(\w+)\s+are\s+/gi, '$1: ');
    // Clean up whitespace
    s = s.replace(/\s+/g, ' ').trim();
    return s;
  }

  function aaakExpand(compressed) {
    // Approximate reverse: expand ": " to " is "
    var s = compressed;
    // Expand X: Y where X is a single word
    s = s.replace(/(\w+):\s+/g, '$1 is ');
    return s;
  }

  function updateAAAK() {
    var compressed = document.getElementById('aaak-compressed');
    var expanded = document.getElementById('aaak-expanded');
    var ratio = document.getElementById('aaak-ratio');

    // Gather current context from visible drawers
    var contextDrawers;
    if (currentView.room) {
      contextDrawers = getDrawers(currentView.wing, currentView.hall, currentView.room);
    } else if (currentView.hall) {
      contextDrawers = palace.drawers.filter(function(d) {
        return d.wing === currentView.wing && d.hall === currentView.hall;
      });
    } else if (currentView.wing) {
      contextDrawers = palace.drawers.filter(function(d) { return d.wing === currentView.wing; });
    } else {
      contextDrawers = palace.drawers.slice(0, 10);
    }

    if (contextDrawers.length === 0) {
      compressed.textContent = 'No context loaded';
      expanded.textContent = 'No context loaded';
      ratio.textContent = '';
      return;
    }

    var fullText = contextDrawers.map(function(d) { return d.content; }).join('. ');
    var aaak = aaakCompress(fullText);
    var expandedText = aaakExpand(aaak);

    compressed.textContent = aaak;
    expanded.textContent = expandedText;

    var savings = fullText.length > 0 ? Math.round((1 - aaak.length / fullText.length) * 100) : 0;
    ratio.textContent = 'Compression: ' + fullText.length + ' chars -> ' + aaak.length + ' chars (' + savings + '% saved)';
  }

  window.toggleAAAK = function() {
    var panel = document.getElementById('aaak-panel');
    var cb = document.getElementById('aaak-toggle-cb');
    if (cb.checked) {
      panel.classList.add('visible');
      updateAAAK();
    } else {
      panel.classList.remove('visible');
    }
  };

  // ── Public API for auto-memory (MK13.2) ──
  // Called from chat.tkt after each interaction
  window.mokePalaceStore = function(wing, hall, room, content, source) {
    palace.drawers.push({
      id: 'drw_' + Date.now(),
      wing: wing || 'work',
      hall: hall || 'conversations',
      room: room || 'general',
      content: content,
      source: source || 'chat',
      created_at: new Date().toISOString()
    });
    savePalace();
  };

  // Palace status API for settings widget (MK13.5)
  window.mokePalaceStatus = function() {
    var wings = {};
    var halls = {};
    var rooms = {};
    palace.drawers.forEach(function(d) {
      wings[d.wing] = true;
      halls[d.wing + '/' + d.hall] = true;
      rooms[d.wing + '/' + d.hall + '/' + d.room] = true;
    });
    var storageBytes = 0;
    try { storageBytes = (localStorage.getItem(LS_KEY) || '').length * 2; } catch(e) {}
    return {
      total_drawers: palace.drawers.length,
      total_wings: Object.keys(wings).length,
      total_halls: Object.keys(halls).length,
      total_rooms: Object.keys(rooms).length,
      storage_bytes: storageBytes
    };
  };

  // ── Utilities ──
  function esc(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  // ── Init ──
  renderWings();
  updateBreadcrumb();

})();
</script>
{! end !}

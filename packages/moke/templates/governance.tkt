{! layout("base") !}
{! block("title") !}moke — Governance{! end !}
{! block("content") !}
<style>
  /* ── teal accent override ── */
  :root {
    --accent: #0d9488;
    --accent-muted: rgba(13,148,136,.15);
    --accent-border: rgba(13,148,136,.35);
  }

  /* ── page layout ── */
  .gov-wrap { max-width: 960px; margin: 0 auto; }
  .gov-heading { font-size: 1.25em; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 6px; }
  .gov-sub { font-size: 0.88em; color: var(--muted); margin-bottom: 24px; }

  /* ── kill switch banner ── */
  .kill-banner {
    display: none; background: rgba(248,81,73,.12); border: 2px solid var(--red);
    border-radius: 10px; padding: 18px 24px; margin-bottom: 20px;
    text-align: center; animation: kill-pulse 1.5s infinite;
  }
  .kill-banner.engaged { display: block; }
  .kill-banner .kill-title { font-size: 1.4em; font-weight: 800; color: var(--red); letter-spacing: 0.1em; margin-bottom: 6px; }
  .kill-banner .kill-detail { font-size: 0.88em; color: var(--muted); margin-bottom: 12px; }
  @keyframes kill-pulse { 0%,100%{border-color:var(--red)} 50%{border-color:rgba(248,81,73,.4)} }

  /* ── stats grid ── */
  .gov-stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 14px; margin-bottom: 20px;
  }
  .stat-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 16px 18px; text-align: center;
  }
  .stat-label { font-size: 0.72em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 6px; }
  .stat-value { font-size: 2em; font-weight: 700; line-height: 1.1; }
  .stat-value.green { color: var(--green); }
  .stat-value.amber { color: var(--amber); }
  .stat-value.red { color: var(--red); }
  .stat-sub { font-size: 0.78em; color: var(--muted); margin-top: 4px; }

  /* ── section card ── */
  .gov-section {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden; margin-bottom: 20px;
  }
  .gov-section-head {
    padding: 14px 20px; border-bottom: 1px solid var(--border);
    font-size: 0.78em; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--muted);
    display: flex; align-items: center; justify-content: space-between;
  }
  .gov-section-body { padding: 18px 20px; }

  /* ── risk breakdown bar ── */
  .risk-bar { display: flex; height: 28px; border-radius: 6px; overflow: hidden; margin: 10px 0; }
  .risk-bar .seg-low { background: var(--green); }
  .risk-bar .seg-med { background: var(--amber); }
  .risk-bar .seg-high { background: var(--red); }
  .risk-legend { display: flex; gap: 18px; font-size: 0.82em; color: var(--muted); margin-top: 8px; }
  .risk-legend .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }

  /* ── kill switch controls ── */
  .kill-section { display: flex; align-items: center; gap: 16px; }
  .btn-kill {
    background: var(--red); color: #fff; font-weight: 700;
    padding: 10px 28px; border-radius: 8px; border: none;
    font-size: 0.95em; cursor: pointer; transition: opacity 0.15s;
  }
  .btn-kill:hover { opacity: 0.85; }
  .btn-kill.resume { background: var(--green); }
  .kill-status { font-size: 0.88em; color: var(--muted); }

  /* ── request log table ── */
  .req-table { width: 100%; border-collapse: collapse; font-size: 0.82em; margin-top: 10px; }
  .req-table th {
    text-align: left; padding: 7px 10px; font-size: 0.72em; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .req-table td { padding: 7px 10px; border-bottom: 1px solid rgba(42,45,58,0.5); color: var(--text); }
  .req-table tr:last-child td { border-bottom: none; }

  /* ── risk badges ── */
  .risk-badge {
    display: inline-block; font-size: 0.72em; font-weight: 700; padding: 2px 8px;
    border-radius: 4px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .risk-badge.low { background: rgba(63,185,80,.15); color: var(--green); }
  .risk-badge.medium { background: rgba(210,153,34,.15); color: var(--amber); }
  .risk-badge.high { background: rgba(248,81,73,.15); color: var(--red); }

  /* ── risk tooltip ── */
  .risk-tooltip {
    display: none; position: absolute; background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 16px; font-size: 0.82em; color: var(--text);
    max-width: 320px; z-index: 500; box-shadow: 0 4px 16px rgba(0,0,0,.4);
  }
  .risk-tooltip.visible { display: block; }
  .risk-tooltip .tt-title { font-weight: 700; margin-bottom: 6px; }
  .risk-tooltip ul { padding-left: 16px; margin: 0; color: var(--muted); }
  .risk-tooltip li { margin: 2px 0; }

  /* ── report output ── */
  .report-output {
    display: none; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 14px 18px; margin-top: 14px;
    font-family: monospace; font-size: 0.82em; color: var(--text);
    max-height: 320px; overflow-y: auto; white-space: pre-wrap;
  }
  .report-output.visible { display: block; }

  /* ── preset info ── */
  .preset-info {
    background: var(--accent-muted); border: 1px solid var(--accent-border);
    border-radius: 8px; padding: 12px 16px; margin-top: 12px;
    font-size: 0.85em; color: var(--text); line-height: 1.6;
  }
  .preset-info .pi-label { font-weight: 600; color: var(--muted); margin-right: 6px; }
  .preset-info .pi-tag {
    display: inline-block; background: rgba(139,148,158,.12); border-radius: 4px;
    padding: 1px 7px; font-size: 0.82em; margin: 2px 3px; color: var(--text);
  }

  /* ── button styles ── */
  .btn-gov {
    background: var(--accent); color: #fff; padding: 8px 20px; border-radius: 7px;
    border: none; font-size: 0.85em; font-weight: 600; cursor: pointer;
    transition: opacity 0.15s;
  }
  .btn-gov:hover { opacity: 0.88; }
  .btn-ghost-gov {
    background: transparent; border: 1px solid var(--border); color: var(--text);
    padding: 8px 20px; border-radius: 7px; font-size: 0.85em; font-weight: 600;
    cursor: pointer; transition: border-color 0.15s;
  }
  .btn-ghost-gov:hover { border-color: var(--accent); color: var(--accent); }

  /* ── integration cards (G5.3) ── */
  .int-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .int-card {
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
    padding: 14px 16px; position: relative;
  }
  .int-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .int-card-name { font-weight: 700; font-size: 0.92em; }
  .int-card-type { font-size: 0.72em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 4px; }
  .int-card-url { font-size: 0.78em; color: var(--muted); word-break: break-all; margin-bottom: 8px; }
  .int-card-actions { display: flex; align-items: center; gap: 8px; }
  .health-dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px;
  }
  .health-dot.unknown { background: var(--muted); }
  .health-dot.ok { background: var(--green); }
  .health-dot.fail { background: var(--red); }

  /* ── toggle switch ── */
  .toggle-switch { position: relative; width: 36px; height: 20px; display: inline-block; }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(139,148,158,.25); border-radius: 20px; transition: background 0.2s;
  }
  .toggle-slider:before {
    content: ''; position: absolute; height: 14px; width: 14px; left: 3px; bottom: 3px;
    background: #fff; border-radius: 50%; transition: transform 0.2s;
  }
  .toggle-switch input:checked + .toggle-slider { background: var(--accent); }
  .toggle-switch input:checked + .toggle-slider:before { transform: translateX(16px); }

  /* ── integration form ── */
  .int-form { margin-top: 14px; }
  .int-form-row { display: flex; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .int-form-row label { font-size: 0.78em; font-weight: 600; color: var(--muted); display: block; margin-bottom: 3px; }
  .int-form-row .field { flex: 1; min-width: 180px; }
  .int-form-row input, .int-form-row select {
    width: 100%; padding: 7px 10px; background: var(--bg); border: 1px solid var(--border);
    border-radius: 6px; color: var(--text); font-size: 0.85em; font-family: inherit;
  }
  .int-form-row input:focus, .int-form-row select:focus { border-color: var(--accent); outline: none; }

  /* ── event checkboxes ── */
  .int-events { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .int-events label {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 0.78em; color: var(--text); cursor: pointer;
    background: rgba(139,148,158,.08); padding: 3px 8px; border-radius: 4px;
  }
  .int-events input[type="checkbox"] { width: auto; margin: 0; accent-color: var(--accent); }

  /* ── test result ── */
  .test-result {
    display: inline-block; font-size: 0.78em; font-weight: 600; padding: 2px 8px;
    border-radius: 4px; margin-left: 8px; animation: test-fade 0.3s;
  }
  .test-result.pass { background: rgba(63,185,80,.15); color: var(--green); }
  .test-result.fail { background: rgba(248,81,73,.15); color: var(--red); }
  @keyframes test-fade { from { opacity: 0; } to { opacity: 1; } }

  /* ── dispatch history table ── */
  .dispatch-table { width: 100%; border-collapse: collapse; font-size: 0.82em; margin-top: 10px; }
  .dispatch-table th {
    text-align: left; padding: 7px 10px; font-size: 0.72em; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .dispatch-table td { padding: 7px 10px; border-bottom: 1px solid rgba(42,45,58,0.5); color: var(--text); }
  .dispatch-table tr:last-child td { border-bottom: none; }
  .status-pill {
    display: inline-block; font-size: 0.72em; font-weight: 700; padding: 2px 8px;
    border-radius: 4px; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .status-pill.success { background: rgba(63,185,80,.15); color: var(--green); }
  .status-pill.failure { background: rgba(248,81,73,.15); color: var(--red); }

  /* ── empty state ── */
  .int-empty { font-size: 0.85em; color: var(--muted); text-align: center; padding: 16px 0; }

  /* ── delete button ── */
  .btn-delete {
    background: transparent; border: 1px solid rgba(248,81,73,.3); color: var(--red);
    padding: 4px 10px; border-radius: 5px; font-size: 0.78em; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-delete:hover { background: rgba(248,81,73,.12); }

  .btn-test {
    background: transparent; border: 1px solid var(--accent-border); color: var(--accent);
    padding: 4px 10px; border-radius: 5px; font-size: 0.78em; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-test:hover { background: var(--accent-muted); }

  @media (max-width: 768px) {
    .gov-stats { grid-template-columns: repeat(2, 1fr); }
    .int-cards { grid-template-columns: 1fr; }
  }
</style>

<div class="gov-wrap">
  <div class="gov-heading">Governance</div>
  <div class="gov-sub">Regulatory compliance, risk monitoring, and kill switch control for the loke privacy pipeline.</div>

  <!-- ── Kill switch banner ──────────────────────────────────────────────── -->
  <div class="kill-banner" id="kill-banner">
    <div class="kill-title">ALL LLM TRAFFIC BLOCKED</div>
    <div class="kill-detail">Kill switch engaged — no requests will reach external providers.</div>
    <button class="btn-kill resume" onclick="releaseKillSwitch()">Resume LLM Traffic</button>
  </div>

  <!-- ── Stats overview (MK15.2) ─────────────────────────────────────────── -->
  <div class="gov-stats">
    <div class="stat-card">
      <div class="stat-label">Privacy Score</div>
      <div class="stat-value green" id="stat-privacy">100%</div>
      <div class="stat-sub">PII intercepted / total</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Violations</div>
      <div class="stat-value" id="stat-violations" style="color:var(--text)">0</div>
      <div class="stat-sub">compliance violations</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Requests</div>
      <div class="stat-value" id="stat-requests" style="color:var(--text)">0</div>
      <div class="stat-sub">this session</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Kill Switch</div>
      <div class="stat-value green" id="stat-kill">OFF</div>
      <div class="stat-sub" id="stat-kill-sub">traffic flowing</div>
    </div>
  </div>

  <!-- ── MK4.9.5 Session metrics ───────────────────────────────────────────── -->
  <div class="gov-stats" style="margin-bottom:20px;">
    <div class="stat-card">
      <div class="stat-label">Session Cost</div>
      <div class="stat-value" id="gov-cost" style="color:var(--text)">$0.00</div>
      <div class="stat-sub">total spend this session</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">PII Entities</div>
      <div class="stat-value amber" id="gov-pii-count">0</div>
      <div class="stat-sub">detected across requests</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Tokens Used</div>
      <div class="stat-value" id="gov-tokens" style="color:var(--text)">0</div>
      <div class="stat-sub">in + out combined</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Feedback Score</div>
      <div class="stat-value green" id="gov-feedback">—</div>
      <div class="stat-sub" id="gov-feedback-sub">no feedback yet</div>
    </div>
  </div>

  <!-- ── MK4.9.5 Local vs Cloud ratio chart ────────────────────────────────── -->
  <div class="gov-section">
    <div class="gov-section-head">
      <span>Local vs Cloud Ratio</span>
      <span style="font-size:0.85em;color:var(--muted);font-weight:400;text-transform:none;letter-spacing:0;" id="gov-refresh-indicator">Auto-refreshing</span>
    </div>
    <div class="gov-section-body" style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;">
      <div style="width:200px;height:200px;flex-shrink:0;">
        <canvas id="gov-ratio-chart" width="200" height="200"></canvas>
      </div>
      <div style="flex:1;min-width:180px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#14b8a6;"></span>
          <span style="font-size:0.88em;color:var(--text);">Local (Ollama)</span>
          <strong style="margin-left:auto;font-size:1em;color:var(--text);" id="gov-local-count">0</strong>
        </div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#58a6ff;"></span>
          <span style="font-size:0.88em;color:var(--text);">Cloud (API)</span>
          <strong style="margin-left:auto;font-size:1em;color:var(--text);" id="gov-cloud-count">0</strong>
        </div>
        <div style="font-size:0.82em;color:var(--muted);margin-top:8px;" id="gov-ratio-pct">—</div>
      </div>
    </div>
  </div>

  <!-- ── Risk tier breakdown (MK15.2, MK15.5) ───────────────────────────── -->
  <div class="gov-section">
    <div class="gov-section-head">Risk Tier Breakdown</div>
    <div class="gov-section-body">
      <div class="risk-bar" id="risk-bar">
        <div class="seg-low" id="seg-low" style="width:100%"></div>
        <div class="seg-med" id="seg-med" style="width:0%"></div>
        <div class="seg-high" id="seg-high" style="width:0%"></div>
      </div>
      <div class="risk-legend">
        <span><span class="dot" style="background:var(--green)"></span> Low: <strong id="count-low">0</strong></span>
        <span><span class="dot" style="background:var(--amber)"></span> Medium: <strong id="count-med">0</strong></span>
        <span><span class="dot" style="background:var(--red)"></span> High: <strong id="count-high">0</strong></span>
      </div>
    </div>
  </div>

  <!-- ── Kill switch control (MK15.3) ────────────────────────────────────── -->
  <div class="gov-section">
    <div class="gov-section-head">Kill Switch</div>
    <div class="gov-section-body">
      <div class="kill-section">
        <button class="btn-kill" id="btn-kill" onclick="engageKillSwitch()">Engage Kill Switch</button>
        <span class="kill-status" id="kill-status-text">All external LLM traffic will be immediately stopped.</span>
      </div>
    </div>
  </div>

  <!-- ── Compliance report generator (MK15.4) ────────────────────────────── -->
  <div class="gov-section">
    <div class="gov-section-head">
      <span>Compliance Report</span>
      <span>
        <button class="btn-ghost-gov" onclick="generateReport('inline')">View Inline</button>
        <button class="btn-ghost-gov" onclick="generateReport('csv')" style="margin-left:6px;">Download CSV</button>
        <button class="btn-ghost-gov" onclick="generateReport('json')" style="margin-left:6px;">Download JSON</button>
      </span>
    </div>
    <div class="gov-section-body">
      <p style="font-size:0.85em;color:var(--muted);margin-bottom:0;">
        Generate a compliance summary for the current session. Includes all requests, risk classifications, and violations.
      </p>
      <div class="report-output" id="report-output"></div>
    </div>
  </div>

  <!-- ── External integrations (G5.3) ───────────────────────────────────── -->
  <div class="gov-section">
    <div class="gov-section-head">
      <span>External Integrations</span>
      <span>
        <select id="int-preset-select" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:4px 8px;font-size:0.82em;font-family:inherit;margin-right:6px;">
          <option value="">Add Integration...</option>
          <option value="pagerduty">PagerDuty</option>
          <option value="datadog">Datadog</option>
          <option value="grafana">Grafana</option>
          <option value="splunk">Splunk</option>
          <option value="elastic">Elastic</option>
          <option value="slack">Slack</option>
          <option value="teams">Microsoft Teams</option>
          <option value="opsgenie">Opsgenie</option>
          <option value="servicenow">ServiceNow</option>
          <option value="webhook">Custom Webhook</option>
        </select>
      </span>
    </div>
    <div class="gov-section-body">
      <!-- Add integration form (hidden until preset selected) -->
      <div id="int-add-form" style="display:none;">
        <div class="int-form">
          <div class="int-form-row">
            <div class="field">
              <label>Name</label>
              <input type="text" id="int-name" placeholder="Integration name" />
            </div>
            <div class="field">
              <label>URL</label>
              <input type="text" id="int-url" placeholder="https://..." />
            </div>
          </div>
          <div class="int-form-row">
            <div class="field">
              <label>API Key Env Var</label>
              <input type="text" id="int-auth-env" placeholder="e.g. PAGERDUTY_KEY" />
            </div>
            <div class="field">
              <label>Auth Method</label>
              <select id="int-auth-method">
                <option value="none">None</option>
                <option value="bearer_token">Bearer Token</option>
                <option value="api_key_header">API Key Header</option>
                <option value="basic_auth">Basic Auth</option>
              </select>
            </div>
          </div>
          <div class="int-form-row">
            <div class="field" style="flex:2;">
              <label>Subscribe to Events</label>
              <div class="int-events" id="int-events-checkboxes"></div>
            </div>
          </div>
          <div style="margin-top:10px;">
            <button class="btn-gov" onclick="saveIntegration()">Add Integration</button>
            <button class="btn-ghost-gov" onclick="cancelIntegration()" style="margin-left:6px;">Cancel</button>
          </div>
        </div>
      </div>
      <!-- Configured endpoint cards -->
      <div class="int-cards" id="int-cards"></div>
      <p class="int-empty" id="int-empty">No integrations configured. Select a preset above to add one.</p>
    </div>
  </div>

  <!-- ── Dispatch history (G5.3) ───────────────────────────────────────────── -->
  <div class="gov-section">
    <div class="gov-section-head">
      <span>Dispatch History</span>
      <button class="btn-ghost-gov" onclick="clearDispatchHistory()">Clear</button>
    </div>
    <div class="gov-section-body">
      <table class="dispatch-table" id="dispatch-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Endpoint</th>
            <th>Event Type</th>
            <th>Status</th>
            <th>Latency</th>
          </tr>
        </thead>
        <tbody id="dispatch-tbody"></tbody>
      </table>
      <p class="int-empty" id="dispatch-empty">No dispatch events yet. Test an integration or trigger a governance event.</p>
    </div>
  </div>

  <!-- ── Request log with risk badges (MK15.5) ──────────────────────────── -->
  <div class="gov-section">
    <div class="gov-section-head">
      <span>Request Log</span>
      <button class="btn-ghost-gov" onclick="addDemoRequest()">+ Add Demo Request</button>
    </div>
    <div class="gov-section-body">
      <table class="req-table" id="req-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Type</th>
            <th>Detail</th>
            <th>Risk</th>
          </tr>
        </thead>
        <tbody id="req-tbody"></tbody>
      </table>
      <p id="req-empty" style="font-size:0.85em;color:var(--muted);text-align:center;padding:16px 0;">
        No requests yet. Use the chat or add a demo request.
      </p>
    </div>
  </div>
</div>

<!-- ── Risk tooltip (floating) ────────────────────────────────────────────── -->
<div class="risk-tooltip" id="risk-tooltip">
  <div class="tt-title" id="tt-title"></div>
  <div id="tt-score" style="font-size:0.85em;color:var(--muted);margin-bottom:6px;"></div>
  <ul id="tt-reasons"></ul>
</div>

<script>
(function () {
  'use strict';

  const LS_GOV_KEY = 'moke_governance';

  // ── Preset definitions (mirrors governance.tk) ────────────────────────────
  const PRESETS = {
    'eu-gdpr':     { name: 'EU GDPR', desc: 'General Data Protection Regulation (EU) 2016/679', default_class: 'confidential', blocked: ['health','biometric','political','religion','sexual_orientation','trade_union','genetic'], cross_border: false, strength: 'full', rules: ['dpa_required_for_providers','art9_special_categories_blocked','right_to_erasure_supported'] },
    'au-privacy':  { name: 'AU Privacy Act', desc: 'Australian Privacy Act 1988 and Australian Privacy Principles', default_class: 'confidential', blocked: ['tfn','medicare'], cross_border: false, strength: 'reasonable', rules: ['app8_comparable_protections','eligible_data_breach_30_days','oaic_notification_required'] },
    'hipaa':       { name: 'US HIPAA', desc: 'Health Insurance Portability and Accountability Act', default_class: 'restricted', blocked: ['health','ssn','medical_record','insurance','dob'], cross_border: false, strength: 'full', rules: ['baa_required','safe_harbor_deidentification','60_day_breach_notification','minimum_necessary_standard'] },
    'ccpa':        { name: 'US CCPA/CPRA', desc: 'California Consumer Privacy Act and California Privacy Rights Act', default_class: 'confidential', blocked: [], cross_border: true, strength: 'reasonable', rules: ['service_provider_contract_required','45_day_consumer_response','opt_out_of_sale_supported'] },
    'uk-gdpr':     { name: 'UK GDPR', desc: 'UK General Data Protection Regulation', default_class: 'confidential', blocked: ['health','biometric','political','religion'], cross_border: false, strength: 'full', rules: ['uk_idta_required','72_hour_ico_notification','dpa_required'] },
    'sg-pdpa':     { name: 'Singapore PDPA', desc: 'Personal Data Protection Act 2012', default_class: 'confidential', blocked: ['nric'], cross_border: false, strength: 'reasonable', rules: ['transfer_limitation','3_day_pdpc_notification','data_intermediary_obligations'] },
    'minimal':     { name: 'Minimal', desc: 'Minimal restrictions for testing and development', default_class: 'public', blocked: [], cross_border: true, strength: 'placeholder', rules: [] },
  };

  // ── State ─────────────────────────────────────────────────────────────────
  let state = loadState();

  function defaultState() {
    return {
      preset: 'eu-gdpr',
      kill_switch: false,
      kill_engaged_at: null,
      requests: [],
    };
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(LS_GOV_KEY);
      if (raw) return Object.assign(defaultState(), JSON.parse(raw));
    } catch (_) {}
    return defaultState();
  }

  function saveState() {
    try { localStorage.setItem(LS_GOV_KEY, JSON.stringify(state)); } catch (_) {}
  }

  // ── Risk classification ───────────────────────────────────────────────────
  function classifyRisk(sensitivity, entityCount, crossBorder, hasBlocked) {
    let score = 0;
    const reasons = [];

    if (sensitivity === 'RESTRICTED') { score += 40; reasons.push('RESTRICTED classification'); }
    else if (sensitivity === 'CONFIDENTIAL') { score += 25; reasons.push('CONFIDENTIAL classification'); }
    else if (sensitivity === 'INTERNAL') { score += 10; reasons.push('INTERNAL classification'); }

    if (entityCount > 10) { score += 30; reasons.push('High PII entity count (' + entityCount + ')'); }
    else if (entityCount > 3) { score += 15; reasons.push('Moderate PII entity count (' + entityCount + ')'); }
    else if (entityCount > 0) { score += 5; reasons.push('Low PII entity count (' + entityCount + ')'); }

    if (crossBorder) { score += 15; reasons.push('Cross-border data transfer'); }
    if (hasBlocked) { score += 20; reasons.push('Contains blocked entity types'); }

    const tier = score >= 50 ? 'High' : score >= 25 ? 'Medium' : 'Low';
    return { tier, score, reasons };
  }

  // ── Render stats ──────────────────────────────────────────────────────────
  function renderStats() {
    const reqs = state.requests;
    const total = reqs.length;
    const violations = reqs.filter(r => r.severity === 'violation').length;
    const privacy = total > 0 ? Math.round(((total - violations) / total) * 100) : 100;
    const low = reqs.filter(r => r.risk === 'Low').length;
    const med = reqs.filter(r => r.risk === 'Medium').length;
    const high = reqs.filter(r => r.risk === 'High').length;

    // Stats cards
    const privacyEl = document.getElementById('stat-privacy');
    privacyEl.textContent = privacy + '%';
    privacyEl.className = 'stat-value ' + (privacy >= 90 ? 'green' : privacy >= 70 ? 'amber' : 'red');

    const violEl = document.getElementById('stat-violations');
    violEl.textContent = violations;
    violEl.style.color = violations > 0 ? 'var(--red)' : 'var(--text)';

    document.getElementById('stat-requests').textContent = total;

    // Kill switch
    const killEl = document.getElementById('stat-kill');
    const killSub = document.getElementById('stat-kill-sub');
    if (state.kill_switch) {
      killEl.textContent = 'ON';
      killEl.className = 'stat-value red';
      killSub.textContent = 'traffic blocked';
    } else {
      killEl.textContent = 'OFF';
      killEl.className = 'stat-value green';
      killSub.textContent = 'traffic flowing';
    }

    // Risk bar
    if (total > 0) {
      document.getElementById('seg-low').style.width = ((low / total) * 100) + '%';
      document.getElementById('seg-med').style.width = ((med / total) * 100) + '%';
      document.getElementById('seg-high').style.width = ((high / total) * 100) + '%';
    } else {
      document.getElementById('seg-low').style.width = '100%';
      document.getElementById('seg-med').style.width = '0%';
      document.getElementById('seg-high').style.width = '0%';
    }
    document.getElementById('count-low').textContent = low;
    document.getElementById('count-med').textContent = med;
    document.getElementById('count-high').textContent = high;

    // Kill banner
    const banner = document.getElementById('kill-banner');
    const killBtn = document.getElementById('btn-kill');
    const killStatusText = document.getElementById('kill-status-text');
    if (state.kill_switch) {
      banner.classList.add('engaged');
      killBtn.textContent = 'Release Kill Switch';
      killBtn.className = 'btn-kill resume';
      killBtn.onclick = releaseKillSwitch;
      killStatusText.textContent = 'Kill switch is ENGAGED. All external LLM traffic is blocked.';
    } else {
      banner.classList.remove('engaged');
      killBtn.textContent = 'Engage Kill Switch';
      killBtn.className = 'btn-kill';
      killBtn.onclick = engageKillSwitch;
      killStatusText.textContent = 'All external LLM traffic will be immediately stopped.';
    }

    // Request table
    renderRequestTable();
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderRequestTable() {
    const tbody = document.getElementById('req-tbody');
    const emptyEl = document.getElementById('req-empty');

    if (state.requests.length === 0) {
      tbody.innerHTML = '';
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    const rows = state.requests.slice().reverse().map((r, i) => {
      const idx = state.requests.length - 1 - i;
      const tierClass = r.risk.toLowerCase();
      return '<tr>' +
        '<td>' + esc(r.timestamp) + '</td>' +
        '<td>' + esc(r.event_type) + '</td>' +
        '<td>' + esc(r.detail) + '</td>' +
        '<td><span class="risk-badge ' + tierClass + '" data-idx="' + idx + '" onclick="showRiskTooltip(event,' + idx + ')">' + esc(r.risk) + '</span></td>' +
        '</tr>';
    }).join('');
    tbody.innerHTML = rows;
  }

  // ── Kill switch (MK15.3) ──────────────────────────────────────────────────
  window.engageKillSwitch = function() {
    state.kill_switch = true;
    state.kill_engaged_at = new Date().toISOString();
    // Add event
    addRequest('kill_switch', 'Kill switch ENGAGED — all external LLM traffic blocked', 'violation', 'High', 100, ['Kill switch engaged by operator']);
    saveState();
    renderStats();
    // Notify loke if running
    var LOKE_URL = window.LOKE_URL || 'http://127.0.0.1:11430';
    fetch(LOKE_URL + '/api/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: 'governance.kill_switch.engaged', value: true })
    }).catch(function() {});
  };

  window.releaseKillSwitch = function() {
    state.kill_switch = false;
    state.kill_engaged_at = null;
    addRequest('kill_switch', 'Kill switch released — LLM traffic resumed', 'info', 'Low', 0, ['Kill switch disengaged']);
    saveState();
    renderStats();
    var LOKE_URL = window.LOKE_URL || 'http://127.0.0.1:11430';
    fetch(LOKE_URL + '/api/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: 'governance.kill_switch.engaged', value: false })
    }).catch(function() {});
  };

  // ── Add request event ─────────────────────────────────────────────────────
  function addRequest(eventType, detail, severity, riskTier, riskScore, reasons) {
    const now = new Date();
    const ts = now.toLocaleTimeString();
    state.requests.push({
      timestamp: ts,
      event_type: eventType,
      detail: detail,
      severity: severity,
      risk: riskTier,
      risk_score: riskScore,
      risk_reasons: reasons || []
    });
  }

  // ── Demo request (MK15.5) ─────────────────────────────────────────────────
  window.addDemoRequest = function() {
    const preset = PRESETS[state.preset] || PRESETS['eu-gdpr'];
    const demos = [
      { type: 'llm_call', sens: 'CONFIDENTIAL', entities: 5, detail: 'Analyse customer churn by segment' },
      { type: 'llm_call', sens: 'PUBLIC', entities: 0, detail: 'Summarise quarterly revenue trends' },
      { type: 'llm_call', sens: 'RESTRICTED', entities: 12, detail: 'Patient record cross-reference query' },
      { type: 'anonymise', sens: 'INTERNAL', entities: 3, detail: 'Redacted 3 PII entities (name, email, phone)' },
      { type: 'llm_call', sens: 'CONFIDENTIAL', entities: 8, detail: 'Employee salary benchmarking analysis', hasBlocked: true },
      { type: 'compliance_check', sens: 'PUBLIC', entities: 0, detail: 'Routine compliance scan passed' },
      { type: 'llm_call', sens: 'CONFIDENTIAL', entities: 2, detail: 'Market segment analysis with anonymised data' },
    ];
    const demo = demos[Math.floor(Math.random() * demos.length)];
    const risk = classifyRisk(demo.sens, demo.entities, !preset.cross_border && demo.sens !== 'PUBLIC', demo.hasBlocked || false);
    const severity = risk.tier === 'High' ? 'violation' : 'info';
    addRequest(demo.type, demo.detail, severity, risk.tier, risk.score, risk.reasons);
    saveState();
    renderStats();
  };

  // ── Risk tooltip (MK15.5) ─────────────────────────────────────────────────
  window.showRiskTooltip = function(event, idx) {
    event.stopPropagation();
    const req = state.requests[idx];
    if (!req) return;

    const tt = document.getElementById('risk-tooltip');
    document.getElementById('tt-title').textContent = req.risk + ' Risk';
    document.getElementById('tt-score').textContent = 'Score: ' + (req.risk_score || 0) + ' / 100';

    const ul = document.getElementById('tt-reasons');
    ul.innerHTML = '';
    (req.risk_reasons || []).forEach(function(r) {
      const li = document.createElement('li');
      li.textContent = r;
      ul.appendChild(li);
    });

    // Position near the badge
    const rect = event.target.getBoundingClientRect();
    tt.style.top = (rect.bottom + window.scrollY + 6) + 'px';
    tt.style.left = Math.max(8, rect.left + window.scrollX - 100) + 'px';
    tt.classList.add('visible');
  };

  document.addEventListener('click', function() {
    document.getElementById('risk-tooltip').classList.remove('visible');
  });

  // ── Compliance report (MK15.4) ────────────────────────────────────────────
  window.generateReport = function(format) {
    const preset = PRESETS[state.preset] || PRESETS['eu-gdpr'];
    const reqs = state.requests;
    const total = reqs.length;
    const violations = reqs.filter(r => r.severity === 'violation').length;
    const privacy = total > 0 ? Math.round(((total - violations) / total) * 100) : 100;
    const low = reqs.filter(r => r.risk === 'Low').length;
    const med = reqs.filter(r => r.risk === 'Medium').length;
    const high = reqs.filter(r => r.risk === 'High').length;

    if (format === 'csv') {
      let csv = 'timestamp,event_type,detail,severity,risk_tier\n';
      reqs.forEach(function(r) {
        csv += r.timestamp + ',' + r.event_type + ',"' + r.detail + '",' + r.severity + ',' + r.risk + '\n';
      });
      downloadFile(csv, 'compliance-report.csv', 'text/csv');
      return;
    }

    if (format === 'json') {
      const report = {
        generated_at: new Date().toISOString(),
        preset: preset.name,
        total_requests: total,
        violations: violations,
        privacy_pct: privacy,
        risk_breakdown: { low: low, medium: med, high: high },
        events: reqs,
      };
      downloadFile(JSON.stringify(report, null, 2), 'compliance-report.json', 'application/json');
      return;
    }

    // Inline display
    const el = document.getElementById('report-output');
    let text = '=== Compliance Summary Report ===\n';
    text += 'Generated: ' + new Date().toLocaleString() + '\n';
    text += 'Regulatory Preset: ' + preset.name + '\n\n';
    text += 'Privacy Score:    ' + privacy + '%\n';
    text += 'Total Requests:   ' + total + '\n';
    text += 'Violations:       ' + violations + '\n\n';
    text += 'Risk Breakdown:\n';
    text += '  Low:    ' + low + '\n';
    text += '  Medium: ' + med + '\n';
    text += '  High:   ' + high + '\n\n';
    text += '--- Event Log ---\n';
    reqs.forEach(function(r) {
      text += '[' + r.risk + '] ' + r.timestamp + ' | ' + r.event_type + ': ' + r.detail + '\n';
    });
    if (reqs.length === 0) text += '(no events recorded)\n';

    el.textContent = text;
    el.classList.add('visible');
  };

  function downloadFile(content, filename, mimeType) {
    const blob = new Blob([content], { type: mimeType });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  // ── External integrations (G5.3) ──────────────────────────────────────────

  const LS_INT_KEY = 'moke_integrations';
  const LS_DISPATCH_KEY = 'moke_dispatch_history';

  const ALL_EVENTS = [
    'incident.created','incident.resolved',
    'violation.block','violation.warn',
    'kill_switch.engaged','kill_switch.released',
    'compliance.report','compliance.violation',
    'metrics.pipeline','metrics.tokens','metrics.cost','metrics.pii','metrics.cache',
    'audit.all'
  ];

  const INT_PRESETS = {
    pagerduty: {
      name: 'PagerDuty', type: 'incident_management',
      url: 'https://events.pagerduty.com/v2/enqueue',
      auth_method: 'none', auth_env: 'PAGERDUTY_ROUTING_KEY', auth_header: '',
      events: ['incident.created','incident.resolved','violation.block','kill_switch.engaged']
    },
    datadog: {
      name: 'Datadog', type: 'monitoring',
      url: 'https://api.datadoghq.com/api/v2/series',
      auth_method: 'api_key_header', auth_env: 'DD_API_KEY', auth_header: 'DD-API-KEY',
      events: ['metrics.pipeline','metrics.tokens','metrics.cost','metrics.pii','metrics.cache']
    },
    grafana: {
      name: 'Grafana', type: 'monitoring',
      url: '', auth_method: 'bearer_token', auth_env: 'GRAFANA_TOKEN', auth_header: '',
      events: ['metrics.pipeline','metrics.tokens','metrics.cost','metrics.pii']
    },
    splunk: {
      name: 'Splunk HEC', type: 'siem',
      url: '', auth_method: 'bearer_token', auth_env: 'SPLUNK_HEC_TOKEN', auth_header: '',
      events: ['audit.all','incident.created','incident.resolved','violation.block','compliance.report']
    },
    elastic: {
      name: 'Elastic', type: 'siem',
      url: '', auth_method: 'api_key_header', auth_env: 'ELASTIC_API_KEY', auth_header: 'Authorization',
      events: ['audit.all','incident.created','incident.resolved','violation.block']
    },
    slack: {
      name: 'Slack', type: 'alerting',
      url: '', auth_method: 'none', auth_env: '', auth_header: '',
      events: ['incident.created','violation.block','kill_switch.engaged','compliance.violation']
    },
    teams: {
      name: 'Microsoft Teams', type: 'alerting',
      url: '', auth_method: 'none', auth_env: '', auth_header: '',
      events: ['incident.created','violation.block','kill_switch.engaged']
    },
    opsgenie: {
      name: 'Opsgenie', type: 'incident_management',
      url: 'https://api.opsgenie.com/v2/alerts',
      auth_method: 'api_key_header', auth_env: 'OPSGENIE_API_KEY', auth_header: 'Authorization',
      events: ['incident.created','incident.resolved','violation.block']
    },
    servicenow: {
      name: 'ServiceNow', type: 'incident_management',
      url: '', auth_method: 'bearer_token', auth_env: 'SERVICENOW_TOKEN', auth_header: '',
      events: ['incident.created','incident.resolved','compliance.report']
    },
    webhook: {
      name: 'Custom Webhook', type: 'monitoring',
      url: '', auth_method: 'none', auth_env: '', auth_header: '',
      events: []
    }
  };

  let integrations = loadIntegrations();
  let dispatchHistory = loadDispatchHistory();
  let editingPresetId = null;

  function loadIntegrations() {
    try {
      const raw = localStorage.getItem(LS_INT_KEY);
      if (raw) return JSON.parse(raw);
    } catch (_) {}
    return [];
  }

  function saveIntegrations() {
    try { localStorage.setItem(LS_INT_KEY, JSON.stringify(integrations)); } catch (_) {}
  }

  function loadDispatchHistory() {
    try {
      const raw = localStorage.getItem(LS_DISPATCH_KEY);
      if (raw) return JSON.parse(raw);
    } catch (_) {}
    return [];
  }

  function saveDispatchHistory() {
    try { localStorage.setItem(LS_DISPATCH_KEY, JSON.stringify(dispatchHistory)); } catch (_) {}
  }

  function addDispatchEntry(endpointName, eventType, success, latencyMs) {
    const entry = {
      timestamp: new Date().toLocaleTimeString(),
      endpoint: endpointName,
      event_type: eventType,
      success: success,
      latency_ms: latencyMs
    };
    dispatchHistory.unshift(entry);
    if (dispatchHistory.length > 20) dispatchHistory = dispatchHistory.slice(0, 20);
    saveDispatchHistory();
    renderDispatchHistory();
  }

  // ── Preset selection ───────────────────────────────────────────────────────
  document.getElementById('int-preset-select').addEventListener('change', function() {
    const val = this.value;
    if (!val) {
      document.getElementById('int-add-form').style.display = 'none';
      editingPresetId = null;
      return;
    }
    editingPresetId = val;
    const preset = INT_PRESETS[val];
    document.getElementById('int-name').value = preset.name;
    document.getElementById('int-url').value = preset.url;
    document.getElementById('int-auth-env').value = preset.auth_env;
    document.getElementById('int-auth-method').value = preset.auth_method;

    // Build event checkboxes
    const container = document.getElementById('int-events-checkboxes');
    container.innerHTML = '';
    ALL_EVENTS.forEach(function(evt) {
      const checked = preset.events.indexOf(evt) >= 0 ? ' checked' : '';
      container.innerHTML += '<label><input type="checkbox" value="' + esc(evt) + '"' + checked + ' /> ' + esc(evt) + '</label>';
    });

    document.getElementById('int-add-form').style.display = 'block';
  });

  window.cancelIntegration = function() {
    document.getElementById('int-add-form').style.display = 'none';
    document.getElementById('int-preset-select').value = '';
    editingPresetId = null;
  };

  window.saveIntegration = function() {
    const name = document.getElementById('int-name').value.trim();
    const url = document.getElementById('int-url').value.trim();
    const authEnv = document.getElementById('int-auth-env').value.trim();
    const authMethod = document.getElementById('int-auth-method').value;

    if (!name) { alert('Name is required.'); return; }
    if (!url) { alert('URL is required.'); return; }

    const selectedEvents = [];
    document.querySelectorAll('#int-events-checkboxes input[type="checkbox"]:checked').forEach(function(cb) {
      selectedEvents.push(cb.value);
    });

    const presetDef = editingPresetId ? INT_PRESETS[editingPresetId] : INT_PRESETS['webhook'];
    const endpoint = {
      id: editingPresetId || 'webhook_' + Date.now(),
      name: name,
      integration_type: presetDef.type,
      url: url,
      auth_method: authMethod,
      auth_token_env: authEnv,
      auth_header_name: presetDef.auth_header || '',
      enabled: true,
      retry_count: 2,
      timeout_ms: 5000,
      events: selectedEvents,
      health: 'unknown'
    };

    // Replace if same id exists, else append
    const existingIdx = integrations.findIndex(function(e) { return e.id === endpoint.id; });
    if (existingIdx >= 0) {
      integrations[existingIdx] = endpoint;
    } else {
      integrations.push(endpoint);
    }

    saveIntegrations();
    renderIntegrations();
    cancelIntegration();
  };

  // ── Render integration cards ───────────────────────────────────────────────
  function renderIntegrations() {
    const container = document.getElementById('int-cards');
    const emptyEl = document.getElementById('int-empty');

    if (integrations.length === 0) {
      container.innerHTML = '';
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    container.innerHTML = integrations.map(function(ep, i) {
      const healthClass = ep.health || 'unknown';
      const checkedAttr = ep.enabled ? ' checked' : '';
      return '<div class="int-card">' +
        '<div class="int-card-type">' + esc(ep.integration_type) + '</div>' +
        '<div class="int-card-head">' +
          '<span class="int-card-name"><span class="health-dot ' + healthClass + '"></span>' + esc(ep.name) + '</span>' +
          '<label class="toggle-switch">' +
            '<input type="checkbox"' + checkedAttr + ' onchange="toggleIntegration(' + i + ', this.checked)" />' +
            '<span class="toggle-slider"></span>' +
          '</label>' +
        '</div>' +
        '<div class="int-card-url">' + esc(ep.url) + '</div>' +
        '<div class="int-card-actions">' +
          '<button class="btn-test" onclick="testIntegration(' + i + ')">Test</button>' +
          '<button class="btn-delete" onclick="deleteIntegration(' + i + ')">Remove</button>' +
          '<span id="test-result-' + i + '"></span>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  window.toggleIntegration = function(idx, enabled) {
    if (integrations[idx]) {
      integrations[idx].enabled = enabled;
      saveIntegrations();
    }
  };

  window.deleteIntegration = function(idx) {
    if (integrations[idx]) {
      integrations.splice(idx, 1);
      saveIntegrations();
      renderIntegrations();
    }
  };

  window.testIntegration = function(idx) {
    const ep = integrations[idx];
    if (!ep) return;

    var resultEl = document.getElementById('test-result-' + idx);
    resultEl.innerHTML = '<span class="test-result" style="background:rgba(139,148,158,.12);color:var(--muted);">Testing...</span>';

    const testEvent = {
      event_type: 'test.ping',
      timestamp: new Date().toISOString(),
      severity: 'P3',
      title: 'loke integration test',
      description: 'Test event from loke governance dashboard',
      source: 'moke.governance',
      request_id: 'test_' + Date.now(),
      metadata: '{}'
    };

    const startTime = Date.now();

    // Send test event to the endpoint URL
    fetch(ep.url, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(testEvent),
      signal: AbortSignal.timeout(ep.timeout_ms || 5000)
    }).then(function() {
      const latency = Date.now() - startTime;
      ep.health = 'ok';
      saveIntegrations();
      renderIntegrations();
      var el = document.getElementById('test-result-' + idx);
      if (el) el.innerHTML = '<span class="test-result pass">OK (' + latency + 'ms)</span>';
      addDispatchEntry(ep.name, 'test.ping', true, latency);
    }).catch(function(err) {
      const latency = Date.now() - startTime;
      ep.health = 'fail';
      saveIntegrations();
      renderIntegrations();
      var el = document.getElementById('test-result-' + idx);
      if (el) el.innerHTML = '<span class="test-result fail">Failed</span>';
      addDispatchEntry(ep.name, 'test.ping', false, latency);
    });
  };

  // ── Render dispatch history ────────────────────────────────────────────────
  function renderDispatchHistory() {
    const tbody = document.getElementById('dispatch-tbody');
    const emptyEl = document.getElementById('dispatch-empty');

    if (dispatchHistory.length === 0) {
      tbody.innerHTML = '';
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    tbody.innerHTML = dispatchHistory.map(function(d) {
      const statusClass = d.success ? 'success' : 'failure';
      const statusLabel = d.success ? 'OK' : 'FAIL';
      return '<tr>' +
        '<td>' + esc(d.timestamp) + '</td>' +
        '<td>' + esc(d.endpoint) + '</td>' +
        '<td>' + esc(d.event_type) + '</td>' +
        '<td><span class="status-pill ' + statusClass + '">' + statusLabel + '</span></td>' +
        '<td>' + d.latency_ms + 'ms</td>' +
      '</tr>';
    }).join('');
  }

  window.clearDispatchHistory = function() {
    dispatchHistory = [];
    saveDispatchHistory();
    renderDispatchHistory();
  };

  // ── MK4.9.5 Session metrics from sessionStorage ────────────────────────
  var govRatioChart = null;

  function refreshSessionMetrics() {
    // Read session stats
    var ss = {};
    try { ss = JSON.parse(sessionStorage.getItem('moke_session_stats') || '{}'); } catch(_) {}
    var requests = ss.requests || 0;
    var tokensIn = ss.tokensIn || 0;
    var tokensOut = ss.tokensOut || 0;
    var cost = ss.cost || 0;
    var localCount = ss.localCount || 0;
    var cloudCount = ss.cloudCount || 0;

    // Read PII cumulative count
    var piiCount = parseInt(sessionStorage.getItem('moke_pii_cumulative') || '0', 10);

    // Read feedback
    var feedback = [];
    try { feedback = JSON.parse(localStorage.getItem('moke_feedback') || '[]'); } catch(_) {}
    var thumbsUp = feedback.filter(function(f) { return f.direction === 'up'; }).length;
    var thumbsDown = feedback.filter(function(f) { return f.direction === 'down'; }).length;
    var totalFeedback = thumbsUp + thumbsDown;

    // Update DOM
    var costEl = document.getElementById('gov-cost');
    if (costEl) costEl.textContent = '$' + cost.toFixed(4);

    var piiEl = document.getElementById('gov-pii-count');
    if (piiEl) {
      piiEl.textContent = piiCount;
      piiEl.className = 'stat-value ' + (piiCount > 0 ? 'amber' : 'green');
    }

    var tokensEl = document.getElementById('gov-tokens');
    if (tokensEl) tokensEl.textContent = (tokensIn + tokensOut).toLocaleString();

    var fbEl = document.getElementById('gov-feedback');
    var fbSubEl = document.getElementById('gov-feedback-sub');
    if (fbEl && fbSubEl) {
      if (totalFeedback > 0) {
        var pct = Math.round((thumbsUp / totalFeedback) * 100);
        fbEl.textContent = pct + '%';
        fbEl.className = 'stat-value ' + (pct >= 70 ? 'green' : pct >= 40 ? 'amber' : 'red');
        fbSubEl.textContent = thumbsUp + ' up / ' + thumbsDown + ' down';
      } else {
        fbEl.textContent = '\u2014';
        fbEl.className = 'stat-value';
        fbSubEl.textContent = 'no feedback yet';
      }
    }

    // Local vs cloud
    var localEl = document.getElementById('gov-local-count');
    var cloudEl = document.getElementById('gov-cloud-count');
    var ratioEl = document.getElementById('gov-ratio-pct');
    if (localEl) localEl.textContent = localCount;
    if (cloudEl) cloudEl.textContent = cloudCount;
    var total = localCount + cloudCount;
    if (ratioEl) ratioEl.textContent = total > 0 ? Math.round((localCount / total) * 100) + '% local' : 'No requests yet';

    // Pie chart
    var canvas = document.getElementById('gov-ratio-chart');
    if (canvas && typeof Chart !== 'undefined') {
      if (govRatioChart) govRatioChart.destroy();
      govRatioChart = new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: ['Local', 'Cloud'],
          datasets: [{
            data: [localCount || 0, cloudCount || 0],
            backgroundColor: ['#14b8a6', '#58a6ff'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          cutout: '60%',
          plugins: {
            legend: { display: false }
          }
        }
      });
    }
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  renderStats();
  renderIntegrations();
  renderDispatchHistory();
  refreshSessionMetrics();

  // MK4.9.5 — Auto-refresh every 10 seconds
  setInterval(function() {
    refreshSessionMetrics();
    renderStats();
  }, 10000);

})();
</script>
{! end !}

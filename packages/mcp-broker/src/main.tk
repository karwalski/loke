m=mcpbroker.main;
i=s:mcpbroker.server;
i=t:shared.types;
i=cfg:shared.config;
i=log:shared.log;

(* The registry seeding moved into mcpbroker.server.seedregistry, which is where it
   belongs: the copy here built a registry, assigned to a non-mut binding, and then
   threw it away — s.start() built its own. It also used std.str.arraylen/arrayget over
   a typed array and never imported std.str at all. *)
(* VM1.6b. Was `main(args:@str)`, which reads garbage (see mcptoke.main); never read here.
   Read argv through std.args, as cli.main does. *)
f=main():i32{
  let config=mt cfg.loadconfig(t.configpath()) {
    $ok:v v;
    $err:e cfg.defaultconfig()
  };
  let brokercfg=$brokerconfig{ port:s.defaultport(); datadir:config.datadir };
  log.info("mcp broker starting on port 11436";"broker";"system");
  if(s.start(brokercfg;config.presidiourl;config.ollamaurl)){
    <(0 as i32)
  }el{
    <(1 as i32)
  }
};

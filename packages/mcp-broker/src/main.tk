m=mcpbroker.main;
i=s:mcpbroker.server;
i=reg:mcpbroker.registry;
i=log:shared.log;

f=main(args:@str):i32{
  let cfg=s.$brokerconfig{ port:s.defaultport(); datadir:"./data" };
  log.info("mcp broker starting on port 11436";"broker";"system");
  let registry=reg.newregistry();
  let defaults=reg.defaultservers();
  let registry=defaults.each|srv{ reg.register(registry;srv) };
  let ok=s.start(cfg);
  if(ok){ <0 }el{ <1 }
};

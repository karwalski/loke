m=mcpbroker.main;
i=s:mcpbroker.server;
i=reg:mcpbroker.registry;
i=log:shared.log;

f=main(args:@str):i32{
  let cfg=$brokerconfig{ port:s.defaultport(); datadir:"./data" };
  log.info("mcp broker starting on port 11436";"broker";"system");
  let registry=reg.newregistry();
  let defaults=reg.defaultservers();
  lp(let i=0;i<str.arraylen(defaults);i=i+1){ let srv=str.arrayget(defaults;i);
    registry=reg.register(registry;srv)
  };
  let ok=s.start(cfg);
  if(ok){ <0 }el{ <1 }
};

m=mcpbroker.registry;
i=t:shared.types;
i=log:shared.log;
i=http:std.http;
i=str:std.str;

t=$serverentry{ name:str; host:str; port:i32; toolprefix:str; healthy:bool; lastchecked:i64; tools:@str };
t=$brokerregistry{ servers:@$serverentry };

f=newregistry():$brokerregistry{
  <$brokerregistry{ servers:@() }
};

(* `.push` and the result assigned, not `.append`: arrays have no append, and push
   returns the new array rather than mutating in place (T-24). *)
f=register(reg:$brokerregistry;entry:$serverentry):$brokerregistry{
  let updated=reg.servers.push(entry);
  <$brokerregistry{ servers:updated }
};

(* Returns an entry with an empty name when no server claims the tool prefix.
   isfound() below is the predicate to test that with — comparing the returned struct
   against a freshly built empty one compares handles, not contents. *)
f=findfortool(reg:$brokerregistry;toolname:str):$serverentry{
  let result=mut.noserver();
  lp(let i=0;i<reg.servers.len;i=i+1){
    let s=reg.servers.get(i);
    if(str.startswith(toolname;s.toolprefix)){result=s}el{}
  };
  <result
};

f=noserver():$serverentry{
  <$serverentry{name:"";host:"";port:0;toolprefix:"";healthy:false;lastchecked:0;tools:@()}
};

f=isfound(entry:$serverentry):bool{
  <str.len(entry.name)>0
};

(* ── T11.2: lookup by name, status and tool lists ───────────────────────────────
   Each update returns a new registry: toke cannot mutate the caller's value (T-24). An
   unknown name leaves the registry unchanged, and getserver answers noserver(). *)
f=getserver(reg:$brokerregistry;name:str):$serverentry{
  let result=mut.noserver();
  lp(let i=0;i<reg.servers.len;i=i+1){
    let s=reg.servers.get(i);
    if(str.eq(s.name;name)){result=s}el{}
  };
  <result
};

f=servercount(reg:$brokerregistry):i64{
  <reg.servers.len as i64
};

f=withstatus(s:$serverentry;healthy:bool;checkedat:i64):$serverentry{
  <$serverentry{name:s.name;host:s.host;port:s.port;toolprefix:s.toolprefix;healthy:healthy;lastchecked:checkedat;tools:s.tools}
};

f=withtools(s:$serverentry;tools:@str):$serverentry{
  <$serverentry{name:s.name;host:s.host;port:s.port;toolprefix:s.toolprefix;healthy:s.healthy;lastchecked:s.lastchecked;tools:tools}
};

f=setstatus(reg:$brokerregistry;name:str;healthy:bool;checkedat:i64):$brokerregistry{
  let out=mut.@();
  lp(let i=0;i<reg.servers.len;i=i+1){
    let s=reg.servers.get(i);
    if(str.eq(s.name;name)){ out=out.push(withstatus(s;healthy;checkedat)) }el{ out=out.push(s) }
  };
  <$brokerregistry{ servers:out }
};

(* Tool names are stored as the server reports them, without the prefix. *)
f=settools(reg:$brokerregistry;name:str;tools:@str):$brokerregistry{
  let out=mut.@();
  lp(let i=0;i<reg.servers.len;i=i+1){
    let s=reg.servers.get(i);
    if(str.eq(s.name;name)){ out=out.push(withtools(s;tools)) }el{ out=out.push(s) }
  };
  <$brokerregistry{ servers:out }
};

(* Every tool as a client calls it: the server's routing prefix, then the tool name. That
   is the name findfortool routes, so every name listed here routes back to its server. *)
f=listtools(reg:$brokerregistry):@str{
  let out=mut.@();
  lp(let i=0;i<reg.servers.len;i=i+1){
    let s=reg.servers.get(i);
    lp(let j=0;j<s.tools.len;j=j+1){
      let tool:str=s.tools.get(j);
      out=out.push(str.concat(s.toolprefix;tool))
    }
  };
  <out
};

f=defaultservers():@$serverentry{
  let toke=$serverentry{ name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke."; healthy:true; lastchecked:0; tools:@() };
  let memory=$serverentry{ name:"mcp-memory"; host:"localhost"; port:11437; toolprefix:"memory."; healthy:true; lastchecked:0; tools:@() };
  <@(toke;memory)
};

f=healthcheckok(r:i64):bool{
  let healthy=r.status==200;
  <healthy
};

f=healthcheckerr(name:str;e:str):bool{
  log.warn(str.concat("health check failed for ";str.concat(name;str.concat(": ";e)));"registry";"health_check");
  <false
};

f=healthcheck(entry:$serverentry):bool{
  let url=str.concat("http://";str.concat(entry.host;str.concat(":";str.concat(str.fromint(entry.port);"/health"))));
  let resp=http.get(url);
  <mt resp {
    $ok:r healthcheckok(r);
    $err:e healthcheckerr(entry.name;e)
  }
};

f=formatregistry(reg:$brokerregistry):str{
  let header="Name            | Host:Port            | Prefix    | Status\n";
  let sep="----------------+----------------------+-----------+--------\n";
  let rows=mut."";
  lp(let i=0;i<reg.servers.len;i=i+1){
    let s=reg.servers.get(i);
    let status=mut."unhealthy";
    if(s.healthy){ status="healthy" }el{};
    let hostport=str.concat(s.host;str.concat(":";str.fromint(s.port)));
    let row=str.concat(s.name;str.concat(" | ";str.concat(hostport;str.concat(" | ";str.concat(s.toolprefix;str.concat(" | ";str.concat(status;"\n")))))));
    rows=str.concat(rows;row)
  };
  <str.concat(header;str.concat(sep;rows))
};

m=mcpbroker.registry;
i=t:shared.types;
i=log:shared.log;
i=http:std.http;
i=str:std.str;

t=$serverentry{ name:str; host:str; port:i32; toolprefix:str; healthy:bool; lastchecked:i64 };
t=$brokerregistry{ servers:@$serverentry };

f=newregistry():$brokerregistry{
  <$brokerregistry{ servers:@() }
};

f=register(reg:$brokerregistry;entry:$serverentry):$brokerregistry{
  let updated=reg.servers.append(entry);
  <$brokerregistry{ servers:updated }
};

f=findfortool(reg:$brokerregistry;toolname:str):$serverentry{
  let result=reg.servers.find|s{ toolname.startswith(s.toolprefix) };
  <result
};

f=defaultservers():@$serverentry{
  let toke=$serverentry{ name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke."; healthy:true; lastchecked:0 };
  let memory=$serverentry{ name:"mcp-memory"; host:"localhost"; port:11437; toolprefix:"memory."; healthy:true; lastchecked:0 };
  <@(toke;memory)
};

f=healthcheck(entry:$serverentry):bool{
  let url=str.concat("http://";str.concat(entry.host;str.concat(":";str.concat(str.fromint(entry.port);"/health"))));
  let resp=http.get(url);
  mt resp {
    $ok:r {
      let healthy=r.status=200;
      <healthy
    };
    $err:e {
      log.warn(str.concat("health check failed for ";str.concat(entry.name;str.concat(": ";e)));"registry";"health_check");
      <false
    }
  }
};

f=formatregistry(reg:$brokerregistry):str{
  let header="Name            | Host:Port            | Prefix    | Status\n";
  let sep="----------------+----------------------+-----------+--------\n";
  let rows=reg.servers.map|s{
    let status=if(s.healthy){"healthy"}el{"unhealthy"};
    str.concat(s.name.padright(16);str.concat(" | ";str.concat(s.host;str.concat(":";str.concat(str.fromint(s.port).padright(20);str.concat(" | ";str.concat(s.toolprefix.padright(9);str.concat(" | ";str.concat(status;"\n")))))))))
  };
  <str.concat(header;str.concat(sep;rows.join("")))
};

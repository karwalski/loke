m=mcpbroker.registry;
i=t:shared.types;
i=log:shared.log;
i=http:std.http;
i=str:std.str;

t=$serverentry{ name:str; host:str; port:i32; toolprefix:str; healthy:bool; lastchecked:i64 };
t=$brokerregistry{ servers:@$serverentry };

f=newregistry():$brokerregistry{
  <$brokerregistry{ servers:@() }
};

f=register(reg:$brokerregistry;entry:$serverentry):$brokerregistry{
  let updated=reg.servers.append(entry);
  <$brokerregistry{ servers:updated }
};

f=findfortool(reg:$brokerregistry;toolname:str):$serverentry{
  let result=$serverentry{name:"";host:"";port:0;toolprefix:"";healthy:false;lastchecked:0};
  lp(let i=0;i<str.arraylen(reg.servers);i=i+1){ let s=str.arrayget(reg.servers;i); if(toolname.startswith(s.toolprefix)){result=s} };
  <result
};

f=defaultservers():@$serverentry{
  let toke=$serverentry{ name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke."; healthy:true; lastchecked:0 };
  let memory=$serverentry{ name:"mcp-memory"; host:"localhost"; port:11437; toolprefix:"memory."; healthy:true; lastchecked:0 };
  <@(toke;memory)
};

f=healthcheckok(r:i64):bool{
  let healthy=r.status=200;
  <healthy
};

f=healthcheckerr(name:str;e:str):bool{
  log.warn(str.concat("health check failed for ";str.concat(name;str.concat(": ";e)));"registry";"health_check");
  <false
};

f=healthcheck(entry:$serverentry):bool{
  let url=str.concat("http://";str.concat(entry.host;str.concat(":";str.concat(str.fromint(entry.port);"/health"))));
  let resp=http.get(url);
  mt resp {
    $ok:r healthcheckok(r);
    $err:e healthcheckerr(entry.name;e)
  }
};

f=formatregistry(reg:$brokerregistry):str{
  let header="Name            | Host:Port            | Prefix    | Status\n";
  let sep="----------------+----------------------+-----------+--------\n";
  let rows=mut."";
  lp(let i=0;i<reg.servers.len;i=i+1){
    let s=reg.servers.get(i);
    let status=mut."unhealthy";
    if(s.healthy){ status="healthy" }el{};
    let hostport=str.concat(s.host;str.concat(":";str.fromint(s.port)));
    let row=str.concat(s.name;str.concat(" | ";str.concat(hostport;str.concat(" | ";str.concat(s.toolprefix;str.concat(" | ";str.concat(status;"\n")))))));
    rows=str.concat(rows;row)
  };
  <str.concat(header;str.concat(sep;rows))
};

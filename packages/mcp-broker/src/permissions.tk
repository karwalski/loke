m=mcpbroker.permissions;

i=t:shared.types;
i=reg:mcpbroker.registry;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=fs:std.fs;


t=$serverpermission{
  servername:str;
  allowedtools:@str;
  deniedtools:@str;
  maxrequestspermin:i32;
  privacyrequired:bool
};

t=$permissionconfig{
  permissions:@$serverpermission;
  servercount:i32
};


f=permschecktoolentry(entry:i64;toolname:str):bool{
  if(entry.permissionsset){
    <checkpermission(entry.permission;toolname;entry.toolprefix)
  }el{
    <true
  }
};

f=checktoolpermission(registry:i64;toolname:str):bool{
  let found=reg.findfortool(registry;toolname);
  mt found {
    $none:v false;
    $some:entry permschecktoolentry(entry;toolname)
  }
};

f=checkpermission(perm:i64;toolname:str;prefix:str):bool{
  let barename=mut.toolname;
  if(str.startswith(toolname;prefix)){
    barename=str.slice(toolname;str.len(prefix);str.len(toolname))
  }el{};

  let denied=arraycontains(perm.deniedtools;barename);
  if(denied){ <false }el{};

  let allowedcount=perm.allowedtools.len;
  if(allowedcount=0){ <true }el{};

  <arraycontains(perm.allowedtools;barename)
};

f=arraycontains(arr:@str;val:str):bool{
  let i=0;
  let n=arr.len;
  lp(let lv=0;i<n;lv=lv){
    let item=str.arrayget(arr;i);
    if(str.eq(item;val)){ <true }el{};
    i=i+1
  };
  <false
};


f=permsloadok(config:i64;path:str;cid:str):$permissionconfig!$lokeerr{
  log.info(str.concat("loaded ";str.concat(str.fromint(config.servercount);str.concat(" server permissions from ";path)));"permissions";cid);
  <$ok(config)
};

f=loadfromtoml(path:str):$permissionconfig!$lokeerr{
  let cid=log.newcorrelationid();
  let content=fs.readfile(path);
  mt content {
    $fserr:e $err($configerr(str.concat("could not read config: ";path)));
    $ok:raw permsparseraw(raw;path;cid)
  }
};

f=permsparseraw(raw:str;path:str;cid:str):$permissionconfig!$lokeerr{
  let parsed=parsetomlpermissions(raw);
  mt parsed {
    $lokeerr:e $err(e);
    $ok:config permsloadok(config;path;cid)
  }
};

f=parsetomlpermissions(raw:str):$permissionconfig!$lokeerr{
  let permissions=mut.@();
  let lines=str.split(raw;"\n");
  let currentserver=mut."";
  let currentallowed=mut.@();
  let currentdenied=mut.@();
  let currentmaxrpm=mut.0;
  let currentprivacy=mut.false;
  let inserversection=mut.false;

  let i=0;
  let n=lines.len;
  lp(let lv=0;i<n;lv=lv){
    let line=str.trim(str.arrayget(lines;i));

    if(str.startswith(line;"[mcp.servers.")){
      if(inserversection){
        let perm=$serverpermission{
          servername:currentserver;
          allowedtools:currentallowed;
          deniedtools:currentdenied;
          maxrequestspermin:currentmaxrpm;
          privacyrequired:currentprivacy
        };
        permissions=permissions.push(perm)
      }el{};
      let endbracket=str.indexof(line;"]");
      if(endbracket > 13){
        currentserver=str.slice(line;13;endbracket);
        currentallowed=@();
        currentdenied=@();
        currentmaxrpm=0;
        currentprivacy=false;
        inserversection=true
      }el{
        inserversection=false
      }
    }el{
      if(inserversection){
        if(str.startswith(line;"allowed_tools")){
          currentallowed=parsestringarray(line)
        }el{
          if(str.startswith(line;"denied_tools")){
            currentdenied=parsestringarray(line)
          }el{
            if(str.startswith(line;"max_requests_per_min")){
              currentmaxrpm=parseintvalue(line)
            }el{
              if(str.startswith(line;"privacy_required")){
                currentprivacy=parseboolvalue(line)
              }el{}
            }
          }
        }
      }el{
      }
    };
    i=i+1
  };

  if(inserversection){
    let perm=$serverpermission{
      servername:currentserver;
      allowedtools:currentallowed;
      deniedtools:currentdenied;
      maxrequestspermin:currentmaxrpm;
      privacyrequired:currentprivacy
    };
    permissions=permissions.push(perm)
  }el{};

  <$ok($permissionconfig{
    permissions:permissions;
    servercount:permissions.len
  })
};

f=parsestringarray(line:str):@str{
  let result=mut.@();
  let bracketstart=str.indexof(line;"[");
  let bracketend=str.lastindexof(line;"]");
  if(bracketstart < 0){ <result }el{};
  if(!(bracketend>bracketstart)){ <result }el{};
  let inner=str.slice(line;bracketstart+1;bracketend);
  let items=str.split(inner;",");
  lp(let ii174=0;ii174<items.len;ii174=ii174+1){
    let item=items.get(ii174);
    let trimmed=str.trim(item);
    if(str.startswith(trimmed;"\"")){
      let unquoted=str.slice(trimmed;1;str.len(trimmed)-1);
      if(str.len(unquoted) > 0){
        result=result.push(unquoted)
      }el{}
    }el{}

  };
  <result
};

f=parseintvalue(line:str):i32{
  let eqpos=str.indexof(line;"=");
  if(eqpos < 0){ <0 }el{
    let val=str.trim(str.slice(line;eqpos+1;str.len(line)));
    <str.toint(val)
  }
};

f=parseboolvalue(line:str):bool{
  let eqpos=str.indexof(line;"=");
  if(eqpos < 0){ <false }el{
    let val=str.trim(str.slice(line;eqpos+1;str.len(line)));
    <str.eq(val;"true")
  }
};


f=applypermissions(registry:i64;config:$permissionconfig):i64{
  let updatedservers=mut.@();
  lp(let ii1=0;ii1<registry.servers.len;ii1=ii1+1){
    let server=registry.servers.get(ii1);
    let perm=findpermission(config;server.name);
    let updated=mt perm {
      $none:v server;
      $some:p $serverentry{
          name:server.name;
          host:server.host;
          port:server.port;
          toolprefix:server.toolprefix;
          healthy:server.healthy;
          lastchecked:server.lastchecked;
          permissionsset:true;
          permission:p
        }
    };
    updatedservers=updatedservers.push(updated)
  };
  <$brokerregistry{ servers:updatedservers }
};

f=findpermission(config:i64;name:str):$serverpermission!$lokeerr{
  let i=0;
  let n=config.permissions.len;
  lp(let lv=0;i<n;lv=lv){
    let perm=str.arrayget(config.permissions;i);
    if(str.eq(perm.servername;name)){
      <$ok(perm)
    }el{};
    i=i+1
  };
  <$err($lokeerr{msg:"not found"})
};


f=formatpermissions(config:$permissionconfig):str{
  let header="Server          | Allowed               | Denied          | RPM  | Privacy\n";
  let sep="----------------+-----------------------+-----------------+------+---------\n";
  let rows=mut."";
  let i=0;
  let n=config.permissions.len;
  lp(let lv=0;i<n;lv=lv){
    let p=str.arrayget(config.permissions;i);
    let allowedstr=mut."*";
    if(p.allowedtools.len=0){}el{allowedstr=str.join(p.allowedtools;",")};
    let deniedstr=mut."-";
    if(p.deniedtools.len=0){}el{deniedstr=str.join(p.deniedtools;",")};
    let rpmstr=mut."none";
    if(p.maxrequestspermin=0){}el{rpmstr=str.fromint(p.maxrequestspermin)};
    let privacystr=mut."no";
    if(p.privacyrequired){privacystr="yes"}el{};
    let row=str.concat(p.servername;str.concat(" | ";str.concat(allowedstr;str.concat(" | ";str.concat(deniedstr;str.concat(" | ";str.concat(rpmstr;str.concat(" | ";str.concat(privacystr;"\n")))))))));
    rows=str.concat(rows;row);
    i=i+1
  };
  <str.concat(header;str.concat(sep;rows))
};

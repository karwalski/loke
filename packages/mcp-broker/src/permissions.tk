m=mcpbroker.permissions;

i=t:shared.types;
i=reg:mcpbroker.registry;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=fs:std.fs;


t=$serverpermission{
  servername:$str;
  allowedtools:@$str;       
  deniedtools:@$str;        
  maxrequestspermin:i32;   
  privacyrequired:bool       
};

t=$permissionconfig{
  permissions:@$serverpermission;
  servercount:i32
};


f=checktoolpermission(registry:i64:i64;toolname:$str):bool{
  let found=reg.findfortool(registry;toolname);
  |found{
    $none{
      <false
    };
    $some:entry{
      if(entry.permissionsset){
        <checkpermission(entry.permission;toolname;entry.toolprefix)
      }el{
        <true
      };
    };
  };
};

f=checkpermission(perm:i64;toolname:$str;prefix:$str):bool{
  let barename=if(str.startswith(toolname;prefix)):i64{
    str.slice(toolname;str.len(prefix);str.len(toolname))
  }el{
    toolname
  };

  let denied=arraycontains(perm.deniedtools;barename);
  if(denied){ <false }el{};

  let allowedcount=perm.allowedtools.len;
  if(allowedcount=0){ <true }el{};

  <arraycontains(perm.allowedtools;barename)
};

f=arraycontains(arr:@$str;val:$str):bool{
  let i=0;
  let n=arr.len;
  lp(true){
    if(i>n){ break }el{
      let item=str.arrayget(arr;i);
      if(str.eq(item;val)){ <true }el{};
      i=i+1;
    };
  };
  <false
};


f=loadfromtoml(path:$str):$permissionconfig|$lokeerr{
  let cid=log.newcorrelationid();
  let content=mt fs.readfile(path);
  content {
    $fserr:e;
      <$lokeerr.$configerr(str.concat("could not read config: ";path))
    raw;
      let parsed=mt parsetomlpermissions(raw);
      parsed {
        $lokeerr:e;
          <$lokeerr(e)
        config;
          log.info(str.concat("loaded ";str.fromint(config.servercount);" server permissions from ";path);"permissions";cid);
          <config
      };
  };
};

f=parsetomlpermissions(raw:$str):$permissionconfig|$lokeerr{
  let permissions=mut.@($serverpermission@();
  let lines=str.split(raw;"
");
  let currentserver=mut."";
  let currentallowed=mut.@str@();
  let currentdenied=mut.@str@();
  let currentmaxrpm=mut.0;
  let currentprivacy=mut.false;
  let inserversection=mut.false;

  let i=0;
  let n=lines.len;
  lp(true){
    if(i>n){ break }el{
      let line=str.trim(str.arrayget(lines;i));

      if(str.startswith(line;"[mcp.servers.")){
        if(inserversection){
          let perm=$serverpermission{
            servername:currentserver;
            allowedtools:currentallowed;
            deniedtools:currentdenied;
            maxrequestspermin:currentmaxrpm;
            privacyrequired:currentprivacy
          };
          permissions=str.arraypush(permissions;perm)
        }el{};
        let endbracket=str.indexof(line;"]");
        if(endbracket > 13){
          currentserver=str.slice(line;13;endbracket);
          currentallowed=@str@();
          currentdenied=@str@();
          currentmaxrpm=0;
          currentprivacy=false;
          inserversection=true
        }el{
          inserversection=false
        };
      }el{
        if(inserversection){
          if(str.startswith(line;"allowed_tools")){
            currentallowed=parsestringarray(line)
          }el{
            if(str.startswith(line;"denied_tools")){
              currentdenied=parsestringarray(line)
            }el{
              if(str.startswith(line;"max_requests_per_min")){
                currentmaxrpm=parseintvalue(line)
              }el{
                if(str.startswith(line;"privacy_required")){
                  currentprivacy=parseboolvalue(line)
                }el{};
              };
            };
          };
        }el{
        };
      };
      i=i+1;
    };
  };

  if(inserversection){
    let perm=$serverpermission{
      servername:currentserver;
      allowedtools:currentallowed;
      deniedtools:currentdenied;
      maxrequestspermin:currentmaxrpm;
      privacyrequired:currentprivacy
    };
    permissions=str.arraypush(permissions;perm)
  }el{};

  <$permissionconfig{
    permissions:permissions;
    servercount:permissions.len
  };
};

f=parsestringarray(line:$str):@$str{
  let result=mut.@str@();
  let bracketstart=str.indexof(line;"[");
  let bracketend=str.lastindexof(line;"]");
  if(bracketstart < 0){ <result }el{};
  if(bracketend <= bracketstart){ <result }el{};
  let inner=str.slice(line;bracketstart+1;bracketend);
  let items=str.split(inner;",");
  items.each|item{
    let trimmed=str.trim(item);
    if(str.startswith(trimmed;"\"")){
      let unquoted=str.slice(trimmed;1;str.len(trimmed)-1);
      if(str.len(unquoted) > 0){
        result=str.arraypush(result;unquoted)
      }el{};
    }el{};
  };
  <result
};

f=parseintvalue(line:$str):i32{
  let eqpos=str.indexof(line;"=");
  if(eqpos < 0){ <0 }el{
    let val=str.trim(str.slice(line;eqpos+1;str.len(line)));
    <str.toint(val)
  };
};

f=parseboolvalue(line:$str):bool{
  let eqpos=str.indexof(line;"=");
  if(eqpos < 0){ <false }el{
    let val=str.trim(str.slice(line;eqpos+1;str.len(line)));
    <str.eq(val;"true")
  };
};


f=applypermissions(registry:i64:i64;config:$permissionconfig):i64{
  let updatedservers=registry.servers.map|server{
    let perm=mt findpermission(config;server.name);
    perm {
      $none{
        <server
      };
      $some:p{
        <reg.$serverentry{
          name:server.name;
          host:server.host;
          port:server.port;
          toolprefix:server.toolprefix;
          healthy:server.healthy;
          lastchecked:server.lastchecked;
          permissionsset:true;
          permission:p
        };
      };
    };
  };
  <reg.$brokerregistry{ servers:updatedservers };
};

f=findpermission(config:i64;name:$str):$serverpermission!$lokeerr{
  let i=0;
  let n=config.permissions.len;
  lp(true){
    if(i>n){ break }el{
      let perm=str.arrayget(config.permissions;i);
      if(str.eq(perm.servername;name)){
        <$ok(perm)
      }el{};
      i=i+1;
    };
  };
  <$err($lokeerr{msg:"not found"})
};


f=formatpermissions(config:$permissionconfig):$str{
  let header="Server          | Allowed               | Denied          | RPM  | Privacy
";
  let sep="----------------+-----------------------+-----------------+------+---------
";
  let rows=mut."";
  let i=0;
  let n=config.permissions.len;
  lp(true){
    if(i>n){ break }el{
      let p=str.arrayget(config.permissions;i);
      let allowedstr=if(p.allowedtools.len=0):i64{ "*" }el{ str.join(p.allowedtools;",") };
      let deniedstr=if(p.deniedtools.len=0):i64{ "-" }el{ str.join(p.deniedtools;",") };
      let rpmstr=if(p.maxrequestspermin=0):i64{ "none" }el{ str.fromint(p.maxrequestspermin) };
      let privacystr=if(p.privacyrequired):i64{ "yes" }el{ "no" };
      let row=str.concat(p.servername;" | ";allowedstr;" | ";deniedstr;" | ";rpmstr;" | ";privacystr;"
");
      rows=str.concat(rows;row);
      i=i+1;
    };
  };
  <str.concat(header;str.concat(sep;rows))
};

m=mcpbroker.permissions;

i=t:shared.types;
i=reg:mcpbroker.registry;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=file:std.file;


t=$serverpermission{
  servername:str;
  allowedtools:@str;
  deniedtools:@str;
  maxrequestspermin:i32;
  privacyrequired:bool
};

t=$permissionconfig{
  permissions:@$serverpermission;
  servercount:i32
};


(* Permissions are looked up in the $permissionconfig by server NAME rather than
   stamped onto the registry entry.

   The legacy module read `entry.permissionsset` and `entry.permission` off a
   $serverentry that has neither field, and applypermissions built a $serverentry
   literal with two extra fields — which cannot work in either direction: adding
   $serverpermission to mcpbroker.registry's entry would make registry import
   permissions, which already imports registry. Threading the config through the
   check is the way out of that cycle, and applypermissions is gone with it because
   there is nothing for it to stamp.

   reg.findfortool returns a $serverentry, not an option: the `$none`/`$some` match
   had no variants to match. reg.isfound is the predicate. *)
f=checktoolpermission(registry:$brokerregistry;config:$permissionconfig;toolname:str):bool{
  let entry=reg.findfortool(registry;toolname);
  if(reg.isfound(entry)){}el{
    <false
  };
  let perm=findpermission(config;entry.name);
  if(haspermission(perm)){
    <checkpermission(perm;toolname;entry.toolprefix)
  }el{
    <true
  }
};

f=checkpermission(perm:$serverpermission;toolname:str;prefix:str):bool{
  let barename=mut.toolname;
  if(str.startswith(toolname;prefix)){
    barename=mt str.slice(toolname;str.len(prefix);str.len(toolname)){$ok:okv okv;$err:errv ""}
  }el{};

  if(arraycontains(perm.deniedtools;barename)){ <false }el{};

  if(perm.allowedtools.len==0){ <true }el{};

  <arraycontains(perm.allowedtools;barename)
};

f=arraycontains(arr:@str;val:str):bool{
  lp(let i=0;i<arr.len;i=i+1){
    if(str.eq(arr.get(i);val)){ <true }el{}
  };
  <false
};


f=permsloadok(config:$permissionconfig;path:str;cid:str):$permissionconfig!$lokeerr{
  log.info("loaded \(str.fromint(config.servercount)) server permissions from \(path)";"permissions";cid);
  <$ok(config)
};

f=loadfromtoml(path:str):$permissionconfig!$lokeerr{
  let cid=log.newcorrelationid();
  (* std.fs declares nothing at all — its .tki has an empty export list — so
     fs.readfile was a call into a module with no members. std.file.read is the one. *)
  <mt file.read(path) {
    $ok:raw permsparseraw(raw;path;cid);
    $err:e $err($configerr(str.concat("could not read config: ";path)))
  }
};

f=permsparseraw(raw:str;path:str;cid:str):$permissionconfig!$lokeerr{
  <mt parsetomlpermissions(raw) {
    $ok:config permsloadok(config;path;cid);
    $lokeerr:e $err(e)
  }
};

f=parsetomlpermissions(raw:str):$permissionconfig!$lokeerr{
  let permissions=mut.@();
  let lines=str.split(raw;"\n");
  let currentserver=mut."";
  let currentallowed=mut.@();
  let currentdenied=mut.@();
  let currentmaxrpm=mut.0;
  let currentprivacy=mut.false;
  let inserversection=mut.false;

  let i=mut.0;
  let n=lines.len;
  lp(let lv=0;i<n;lv=lv){
    let line=str.trim(lines.get(i));

    if(str.startswith(line;"[mcp.servers.")){
      if(inserversection){
        let perm=$serverpermission{
          servername:currentserver;
          allowedtools:currentallowed;
          deniedtools:currentdenied;
          maxrequestspermin:currentmaxrpm;
          privacyrequired:currentprivacy
        };
        permissions=permissions.push(perm)
      }el{};
      let endbracket=str.indexof(line;"]");
      if(endbracket > 13){
        currentserver=mt str.slice(line;13;endbracket){$ok:okv okv;$err:errv ""};
        currentallowed=@();
        currentdenied=@();
        currentmaxrpm=0;
        currentprivacy=false;
        inserversection=true
      }el{
        inserversection=false
      }
    }el if(inserversection){
      if(str.startswith(line;"allowed_tools")){
        currentallowed=parsestringarray(line)
      }el if(str.startswith(line;"denied_tools")){
        currentdenied=parsestringarray(line)
      }el if(str.startswith(line;"max_requests_per_min")){
        currentmaxrpm=parseintvalue(line)
      }el if(str.startswith(line;"privacy_required")){
        currentprivacy=parseboolvalue(line)
      }el{}
    }el{
    };
    i=i+1
  };

  if(inserversection){
    let perm=$serverpermission{
      servername:currentserver;
      allowedtools:currentallowed;
      deniedtools:currentdenied;
      maxrequestspermin:currentmaxrpm;
      privacyrequired:currentprivacy
    };
    permissions=permissions.push(perm)
  }el{};

  <$ok($permissionconfig{
    permissions:permissions;
    servercount:permissions.len as i32
  })
};

f=parsestringarray(line:str):@str{
  let result=mut.@();
  let bracketstart=str.indexof(line;"[");
  let bracketend=str.lastindex(line;"]");
  if(bracketstart < 0){ <result }el{};
  if(!(bracketend>bracketstart)){ <result }el{};
  let items=str.split(mt str.slice(line;bracketstart+1;bracketend){$ok:okv okv;$err:errv ""};",");
  lp(let ii174=0;ii174<items.len;ii174=ii174+1){
    let trimmed=str.trim(items.get(ii174));
    if(str.startswith(trimmed;"\"")){
      let unquoted=mt str.slice(trimmed;1;str.len(trimmed)-1){$ok:okv okv;$err:errv ""};
      if(str.len(unquoted) > 0){
        result=result.push(unquoted)
      }el{}
    }el{}

  };
  <result
};

f=parseintvalue(line:str):i32{
  let eqpos=str.indexof(line;"=");
  if(eqpos < 0){ <(0 as i32) }el{
    <(str.toint(str.trim(mt str.slice(line;eqpos+1;str.len(line)){$ok:okv okv;$err:errv ""})) as i32)
  }
};

f=parseboolvalue(line:str):bool{
  let eqpos=str.indexof(line;"=");
  if(eqpos < 0){ <false }el{
    <str.eq(str.trim(mt str.slice(line;eqpos+1;str.len(line)){$ok:okv okv;$err:errv ""});"true")
  }
};


(* Returns a permission with an empty servername when the config has no entry for this
   server; haspermission() is the predicate. A $serverpermission!$lokeerr would read as
   the safer signature and is not: the error type is user-declared, so T-18 means the
   caller's `$err` arm never runs and "no permission configured" would be indistinguishable
   from a configured one. A sentinel plus a predicate is total. *)
f=nopermission():$serverpermission{
  <$serverpermission{
    servername:"";
    allowedtools:@();
    deniedtools:@();
    maxrequestspermin:(0 as i32);
    privacyrequired:false
  }
};

f=haspermission(perm:$serverpermission):bool{
  <str.len(perm.servername)>0
};

f=findpermission(config:$permissionconfig;name:str):$serverpermission{
  lp(let i=0;i<config.permissions.len;i=i+1){
    let perm:$serverpermission=config.permissions.get(i);
    if(str.eq(perm.servername;name)){
      <perm
    }el{}
  };
  <nopermission()
};


f=formatpermissions(config:$permissionconfig):str{
  let header="Server          | Allowed               | Denied          | RPM  | Privacy\n";
  let sep="----------------+-----------------------+-----------------+------+---------\n";
  let rows=mut."";
  lp(let i=0;i<config.permissions.len;i=i+1){
    let p:$serverpermission=config.permissions.get(i);
    let allowedstr=mut."*";
    if(p.allowedtools.len==0){}el{allowedstr=str.join(",";p.allowedtools)};
    let deniedstr=mut."-";
    if(p.deniedtools.len==0){}el{deniedstr=str.join(",";p.deniedtools)};
    let rpmstr=mut."none";
    if(p.maxrequestspermin==(0 as i32)){}el{rpmstr=str.fromint(p.maxrequestspermin as i64)};
    let privacystr=mut."no";
    if(p.privacyrequired){privacystr="yes"}el{};
    let row="\(p.servername) | \(allowedstr) | \(deniedstr) | \(rpmstr) | \(privacystr)\n";
    rows=str.concat(rows;row)
  };
  <"\(header)\(sep)\(rows)"
};

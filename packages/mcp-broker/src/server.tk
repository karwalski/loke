m=mcpbroker.server;
i=t:shared.types;
i=net:std.net;
i=proto:core.mcp.protocol;
i=json:std.json;
i=jx:shared.jsonobj;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=agg:mcpbroker.aggregator;
i=proxy:mcpbroker.proxy;
i=pipe:core.privacy.pipeline;
i=str:std.str;
i=sdb:core.storage.db;

(* The broker's JSON-RPC front end (F10.23d).

   Rewritten against what the toolchain provides. The legacy body called
   `doc.getstr(...)`, `params.getraw(...)`, `sock.accept()`, `conn.readbody()` and
   `conn.writeresponse(...)` — method-call forms on i64 handles that resolve to nothing
   and would have become undefined symbols at link — matched `net.listen` as an
   $ok/$err result when std.net returns a bare i64, and called proto.errorresponse
   with (code, message, detail) when it takes (id, code, message).

   The one that would have bitten hardest at runtime: `reg.register(registry;srv)`
   with the result discarded. register returns a NEW registry; the old line left the
   registry empty, so tools/list would have aggregated nothing and every tools/call
   would have reported "Tool not found" — with no diagnostic anywhere.

   json.decode, not json.parse: json.parse mangles to tk_json_parse_w, which does not
   exist, and the linker binds it to an unrelated runtime helper that returns an int64
   rather than a Json (T-17). *)

t=$brokerconfig{ port:i32; datadir:str };

f=defaultport():i32{ <(11436 as i32) };

(* MK6.15. The arguments were `json.enc(json.getval(params;"arguments"))`. At toke 3.1.0
   json.getval answers the value's raw JSON text, and json.enc quoted that text: measured
   against scripts/lib/http_recorder.py, every tools/call reached the upstream as
   `"arguments":"{\"path\":...}"`, a JSON string where MCP requires an object, so no
   upstream tool could read its arguments. They are forwarded as the raw JSON text of the
   value, read with the typed accessors; a call without arguments sends an empty object, as
   MCP allows them to be omitted. A request that is not JSON answers "", which the proxy
   refuses rather than forwarding anything in its place. *)
f=argumentsof(reqbody:str):str{
  <mt json.dec(reqbody) { $ok:d argsin(jx.rawvalue(d;"params")); $jsonerr:e "" }
};

f=argsin(params:str):str{
  <mt json.dec(params) { $ok:p argsorempty(p); $jsonerr:e "" }
};

f=argsorempty(p:$json):str{
  let a=jx.rawvalue(p;"arguments");
  if(str.len(a)==0){ <"{}" }el{};
  <a
};

f=handlerequest(reqbody:str;registry:$brokerregistry;pipecfg:$pipelineconfig):str{
  <handlerequestwith(reqbody;registry;pipecfg;0)
};

(* store: the opened store (1) the organisation policy's audit rows go to, or 0 (F3b.8 (4)). *)
f=handlerequestwith(reqbody:str;registry:$brokerregistry;pipecfg:$pipelineconfig;store:i64):str{
  let doc=json.decode(reqbody);
  let method=json.getstr(doc;"method");
  if(str.len(method)>0){}el{
    <proto.errorresponse(0;(0-32600) as i32;"Invalid request: no method")
  };
  if(str.eq(method;"initialize")){
    <proto.okresponse(1;proto.initresponse("loke-mcp-broker";"1.0.0"))
  }el{};
  if(str.eq(method;"tools/list")){
    <agg.toolslistresponse(agg.aggregateall(registry))
  }el{};
  if(str.eq(method;"tools/call")){
    let toolname=json.getstr(json.getobj(doc;"params");"name");
    if(str.len(toolname)>0){}el{
      <proto.errorresponse(1;(0-32602) as i32;"Missing tool name")
    };
    <proxy.proxycallwith(toolname;argumentsof(reqbody);registry;pipecfg;store).responsebody
  }el{};
  <proto.errorresponse(1;(0-32601) as i32;str.concat("Method not found: ";method))
};

(* std.net writes bytes, not HTTP, so the response line and headers are built here. *)
f=httpjson(body:str):str{
  <str.concat(
    "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: ";
    str.concat(
      str.fromint(str.len(body) as i64);
      str.concat("\r\nConnection: close\r\n\r\n";body)
    )
  )
};

(* The body of an HTTP request, which is whatever follows the blank line. *)
f=httpbody(raw:str):str{
  let at=str.indexof(raw;"\r\n\r\n");
  if(at<0){
    <raw
  }el{
    <str.slice(raw;at+4;str.len(raw))
  }
};

f=seedregistry():$brokerregistry{
  let registry=mut.reg.newregistry();
  let defaults=reg.defaultservers();
  lp(let i=0;i<defaults.len;i=i+1){
    registry=reg.register(registry;defaults.get(i))
  };
  <registry
};

f=start(cfg:$brokerconfig;presidiourl:str;ollamaurl:str):bool{
  log.info(str.concat("mcp-broker listening on port ";str.fromint(cfg.port as i64));"server";"start");
  log.info(str.concat("data dir: ";cfg.datadir);"server";"start");
  (* F10.39: std.net.listen takes an address string, "host:port". Handed the port as an
     integer it segfaulted at toke 0b0bc4e (T-49), and toke 3.1.0 rejects it (E4031). The
     host is loopback: every loke listener is local-only. *)
  let sock=net.listen("127.0.0.1:\(cfg.port as i64)");
  if(sock>0){}el{
    log.error(str.concat("mcp-broker: failed to bind port ";str.fromint(cfg.port as i64));"server";"start");
    <false
  };
  let registry=seedregistry();
  let pipecfg=pipe.newconfig(presidiourl;ollamaurl);
  (* F3b.8 (4). The store the organisation policy's audit rows are written to; 0 when it cannot
     be opened, and then a refused call is still refused, with no row. *)
  let store=mt sdb.openstore(cfg.datadir) { $ok:st 1; $err:e 0 };
  let running=mut.true;
  lp(let lv=0;running;lv=lv){
    let conn=net.accept(sock);
    if(conn>0){
      let raw=net.read(conn);
      if(str.len(raw)>0){
        net.write(conn;httpjson(handlerequestwith(httpbody(raw);registry;pipecfg;store)))
      }el{};
      net.close(conn)
    }el{
      log.warn("mcp-broker: accept error";"server";"start");
      running=false
    }
  };
  net.close(sock);
  <true
};

m=mcpbroker.server;
i=t:shared.types;
i=net:std.net;
i=proto:mcp.protocol;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=agg:mcpbroker.aggregator;
i=proxy:mcpbroker.proxy;
i=str:std.str;

t=$brokerconfig{ port:i32; datadir:str };

f=defaultport():i32{ <11436 };

f=handlerequest(reqbody:str;registry:i64):str{
  let parsed=json.parse(reqbody);
  mt parsed {
    $err:e {
      <proto.errorresponse(-32700;"Parse error";e)
    };
    $ok:doc {
      let methodres=doc.getstr("method");
      mt methodres {
        $err:e {
          <proto.errorresponse(-32600;"Invalid request";e)
        };
        $ok:method {
          if(str.eq(method;"initialize")){
            <proto.initresponse("moke-mcp-broker";"1.0.0")
          }el{};
          if(str.eq(method;"tools/list")){
            let tools=agg.aggregateall(registry);
            <agg.toolslistresponse(tools)
          }el{};
          if(str.eq(method;"tools/call")){
            let paramsres=doc.getobj("params");
            mt paramsres {
              $err:e {
                <proto.errorresponse(-32602;"Invalid params";e)
              };
              $ok:params {
                let nameres=params.getstr("name");
                let argsres=params.getraw("arguments");
                mt nameres {
                  $err:e {
                    <proto.errorresponse(-32602;"Missing tool name";e)
                  };
                  $ok:toolname {
                    let argsjson=mt argsres {
                      $ok:a a;
                      $err: "{}"
                    };
                    let result=proxy.proxycall(toolname;argsjson;registry);
                    <result.responsebody
                  }
                }
              }
            }
          }el{};
          <proto.errorresponse(-32601;"Method not found";"")
        }
      }
    }
  }
};

f=start(cfg:$brokerconfig):bool{
  log.info(str.concat("mcp-broker listening on port ";str.fromint(cfg.port));"server";"start");
  log.info(str.concat("data dir: ";cfg.datadir);"server";"start");
  let listener=net.listen(cfg.port);
  mt listener {
    $err:e {
      log.error(str.concat("failed to bind port ";str.concat(str.fromint(cfg.port);str.concat(": ";e)));"server";"start");
      <false
    };
    $ok:sock {
      let registry=reg.newregistry();
      let defaults=reg.defaultservers();
      let registry=defaults.each|srv{ reg.register(registry;srv) };
      sock.lp(let lv=0;true;lv=lv)|conn{
        let body=conn.readbody();
        let resp=handlerequest(body;registry);
        conn.writeresponse(200;"application/json";resp)
      };
      <true
    }
  }
};

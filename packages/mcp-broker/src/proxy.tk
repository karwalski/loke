m=mcpbroker.proxy;
i=t:shared.types;
i=proto:core.mcp.protocol;
i=reach:shared.reachability;
i=jx:shared.jsonobj;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=pipe:core.privacy.pipeline;
i=ph:core.privacy.placeholder;
i=str:std.str;
i=hr:core.audit.hoprecord;

(* Privacy-preserving proxy for an upstream MCP tool call (F10.23d, GA1.2).

   Nothing in this module had ever compiled and the shape it was reaching for could not
   have worked. `core.privacy.pipeline` exports neither anonymise nor restore: the
   anonymising entry point is pipe.run, which returns a plain $pipelinerun, and
   restoration lives in core.privacy.placeholder.restore and needs the placeholder MAP
   built from the entities that run found. The legacy code called
   `privacy.restore(r.body)` with no map at all — there was no way for it to put
   anything back, and the $proxyresult it returned would have reported
   privacyapplied:true for a response it had not touched.

   So the map is threaded through: anonymise the arguments, send the anonymised form
   upstream, restore the response against the same map. That is the whole point of the
   broker, and this call site plus cli.proxy are the only two callers of
   placeholder.restore in the repository.

   Also fixed: reg.findfortool returns a $serverentry, not an option, so the
   `$none`/`$some` match had no variants to match (its predicate is reg.isfound);
   std.http.post is not callable at all because http.tki double-declares it as a route
   (F10.16), so this used http.postheaders, later measured to send nothing in that shape
   (T-48) and replaced by reach.localpost (VM1.6f); proto.errorresponse takes
   (id, code, message) and was being called with (code, message, detail); and every
   entry parameter was a bare i64 where it meant $serverentry. *)

t=$proxyresult{ ok:bool; responsebody:str; upstreamserver:str; privacyapplied:bool };

f=stripprefix(toolname:str;prefix:str):str{
  if(str.startswith(toolname;prefix)){
    <mt str.slice(toolname;str.len(prefix);str.len(toolname)){$ok:okv okv;$err:errv ""}
  }el{
    <toolname
  }
};

f=serverurl(entry:$serverentry):str{
  <"http://\(entry.host):\(str.fromint(entry.port as i64))"
};

f=proxyupstreamfail(toolname:str;entry:$serverentry):$proxyresult{
  log.warn(str.concat("upstream call failed for ";toolname);"proxy";"proxy_call");
  <$proxyresult{
    ok:false;
    responsebody:proto.errorresponse(1;(0-32603) as i32;str.concat("Upstream error for ";toolname));
    upstreamserver:entry.name;
    privacyapplied:false
  }
};

(* ── MK6.14: anonymise and restore VALUES, not JSON text ─────────────────────────
   The broker ran the privacy pipeline over the arguments' JSON text and forwarded the
   anonymised text. Measured through mcpbroker.server.handlerequest to a recorder: in
   `"Call\njane.citizen@example.com today"` the regex layer matched `njane.citizen@...`,
   taking the letter of the `\n` escape, and the upstream received `Call\[EMAIL_..._1]
   today`, a backslash before `[`, which is not a JSON escape, so the whole tools/call was
   invalid JSON. The same after `\t` and after `→`, and for any detector that matches
   word characters.

   So the text is split into its tokens (jx.segments) and the detectors scan the decoded
   values, every string (keys too, as the text scan did) and every bare value (a phone
   number sent as a JSON number), one blank line between them, in ONE pipeline run, so one
   request id salts every placeholder and an address that occurs in two values gets one
   placeholder. Each value the entities change is written back with jx.escape; every other
   token is forwarded exactly as the client sent it.

   An entity the scan found that lies in no single value spans two of them, and no
   replacement inside a value can remove it, so the call is refused rather than forwarded
   with half of it in the clear. Arguments that cannot be tokenised are refused too.

   The answer is restored the same way: each string token decoded, its placeholders
   replaced, and written back with jx.escape if that changed it. The originals are decoded
   text now, so putting them into the JSON text as they are (what ph.restore on the answer
   did) would break it for a value holding a quote or a backslash. An answer that cannot
   be tokenised is restored as text, as before: it was not JSON to begin with. *)
f=isstringtok(seg:str):bool{
  <str.charat(seg;0)==34
};

f=isvaluetok(seg:str):bool{
  let c=str.charat(seg;0);
  <c==34 || !jx.isstructural(c)
};

(* A string token's decoded text; a bare value as written. *)
f=tokvalue(seg:str):str{
  if(isstringtok(seg)){ <jx.decodestr(jx.sliceor(seg;1;(str.len(seg) as i64)-1)) }el{};
  <seg
};

f=scantext(segs:@str):str{
  let b=str.buf();
  lp(let i=0;i<segs.len;i=i+1){
    let seg:str=segs.get(i);
    if(isvaluetok(seg)){
      str.add(b;tokvalue(seg));
      str.add(b;"\n\n")
    }el{}
  };
  <str.done(b)
};

f=inanyvalue(segs:@str;value:str):bool{
  let found=mut.false;
  lp(let i=0;i<segs.len && !found;i=i+1){
    let seg:str=segs.get(i);
    if(isvaluetok(seg)){
      if(str.contains(tokvalue(seg);value)){ found=true }el{}
    }el{}
  };
  <found
};

f=spansvalues(segs:@str;entities:@$piientity):bool{
  let spans=mut.false;
  lp(let j=0;j<entities.len && !spans;j=j+1){
    let e:$piientity=entities.get(j);
    if(!inanyvalue(segs;e.value)){ spans=true }el{}
  };
  <spans
};

f=anonymiseargs(segs:@str;entities:@$piientity):str{
  let b=str.buf();
  lp(let i=0;i<segs.len;i=i+1){
    let seg:str=segs.get(i);
    if(isvaluetok(seg)){
      let v=tokvalue(seg);
      let a=ph.applytotext(v;entities);
      if(str.eq(a;v)){ str.add(b;seg) }el{ str.add(b;jx.escape(a)) }
    }el{
      str.add(b;seg)
    }
  };
  <str.done(b)
};

f=restoreanswer(raw:str;map:$placeholdermap):str{
  let segs=jx.segments(raw);
  if(segs.len==0){ <ph.restore(raw;map) }el{};
  let b=str.buf();
  lp(let i=0;i<segs.len;i=i+1){
    let seg:str=segs.get(i);
    if(isstringtok(seg)){
      let v=tokvalue(seg);
      let r=ph.restore(v;map);
      if(str.eq(r;v)){ str.add(b;seg) }el{ str.add(b;jx.escape(r)) }
    }el{
      str.add(b;seg)
    }
  };
  <str.done(b)
};

f=proxyhandleresponse(raw:str;toolname:str;entry:$serverentry;map:$placeholdermap):$proxyresult{
  log.info("proxied \(toolname) via \(entry.name)";"proxy";"proxy_call");
  <$proxyresult{
    ok:true;
    responsebody:restoreanswer(raw;map);
    upstreamserver:entry.name;
    privacyapplied:true
  }
};

(* VM1.6f. The tools/call request was `http.postheaders(http.client(url);"/mcp";...)`, and
   the runtime reads postheaders' first argument as a URL string, so it was never sent (T-48):
   every proxied call failed upstream. An upstream on this machine is called through
   reach.localpost, which arrives. No client call at this toolchain is measured to reach
   another host (T-48), so an upstream elsewhere fails here, before anything is attempted. *)
f=proxysendrequest(cleanargs:str;toolname:str;entry:$serverentry;map:$placeholdermap):$proxyresult{
  if(!reach.isloopbackurl(serverurl(entry))){ <proxyupstreamfail(toolname;entry) }el{};
  let rpcbody="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\(jx.escape(stripprefix(toolname;entry.toolprefix))),\"arguments\":\(cleanargs)}}";
  let raw=reach.localpost(serverurl(entry);"/mcp";rpcbody);
  if(str.len(raw)==0){ <proxyupstreamfail(toolname;entry) }el{};
  <proxyhandleresponse(raw;toolname;entry;map)
};

f=proxyblocked(toolname:str;entry:$serverentry):$proxyresult{
  log.warn(str.concat("blocked by sensitivity policy: ";toolname);"proxy";"proxy_call");
  <$proxyresult{
    ok:false;
    responsebody:proto.errorresponse(1;(0-32603) as i32;"Blocked: argument sensitivity exceeds forwarding policy");
    upstreamserver:entry.name;
    privacyapplied:true
  }
};

f=proxyrefused(toolname:str;entry:$serverentry;why:str):$proxyresult{
  log.warn("refused: \(toolname): \(why)";"proxy";"proxy_call");
  <$proxyresult{
    ok:false;
    responsebody:proto.errorresponse(1;(0-32602) as i32;"Blocked: \(why)");
    upstreamserver:entry.name;
    privacyapplied:true
  }
};

f=proxyhandleentry(entry:$serverentry;toolname:str;argsjson:str;pipecfg:$pipelineconfig):$proxyresult{
  <proxyhandleentrywith(entry;toolname;argsjson;pipecfg;0)
};

(* store is the opened store (1), or 0 for none: the run's per-layer metrics (F3b.18), the
   org_policy_* rows (F3b.8 (4)) and a refusal's privacy_refused row (F3b.18) are written to
   it, as /api/pipeline writes them. *)
f=proxyhandleentrywith(entry:$serverentry;toolname:str;argsjson:str;pipecfg:$pipelineconfig;store:i64):$proxyresult{
  let segs=jx.segments(argsjson);
  if(segs.len==0){ <proxyrefused(toolname;entry;"the arguments are not readable JSON") }el{};
  let run=pipe.run(scantext(segs);"";pipecfg);
  let detected=run.result;
  let facts=hr.factsof(run;"mcp-broker";"none";"none");
  (* F3b.18. The run's per-layer metrics first, on its request id, so every audit row below
     binds them (F3b.10), as /api/pipeline and `loke ask` record them. *)
  hr.recordlayers(store;run);
  hr.orgpolicyaudit(store;facts;run);
  (* Fail closed: what the policy will not forward does not go upstream. The organisation
     policy's refusal names its reason (layer ids and policy values, never an argument).
     F3b.18: every refusal of a scanned call, including an entity spanning two values, is
     audited as privacy_refused on the request id; the row carries no argument. *)
  if(pipe.issafetoforward(run)){}el{
    hr.privacyrefused(store;facts);
    if(str.len(run.policyerror)>0){ <proxyrefused(toolname;entry;run.policyerror) }el{};
    <proxyblocked(toolname;entry)
  };
  if(spansvalues(segs;detected.entities)){
    hr.privacyrefused(store;facts);
    <proxyrefused(toolname;entry;"a detected entity spans two argument values")
  }el{};
  <proxysendrequest(anonymiseargs(segs;detected.entities);toolname;entry;ph.mapfromentities(detected.entities))
};

f=proxynotfound(toolname:str):$proxyresult{
  log.warn(str.concat("no upstream server for tool: ";toolname);"proxy";"proxy_call");
  <$proxyresult{
    ok:false;
    responsebody:proto.errorresponse(1;(0-32601) as i32;str.concat("Tool not found: ";toolname));
    upstreamserver:"";
    privacyapplied:false
  }
};

f=proxycall(toolname:str;argsjson:str;registry:$brokerregistry;pipecfg:$pipelineconfig):$proxyresult{
  <proxycallwith(toolname;argsjson;registry;pipecfg;0)
};

f=proxycallwith(toolname:str;argsjson:str;registry:$brokerregistry;pipecfg:$pipelineconfig;store:i64):$proxyresult{
  let found=reg.findfortool(registry;toolname);
  if(reg.isfound(found)){
    <proxyhandleentrywith(found;toolname;argsjson;pipecfg;store)
  }el{
    <proxynotfound(toolname)
  }
};

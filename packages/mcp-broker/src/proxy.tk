m=mcpbroker.proxy;
i=t:shared.types;
i=proto:mcp.protocol;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=privacy:core.privacy.pipeline;
i=str:std.str;

t=$proxyresult{ ok:bool; responsebody:str; upstreamserver:str; privacyapplied:bool };

f=stripprefix(toolname:str;prefix:str):str{
  let has=toolname.startswith(prefix);
  if(has){
    <toolname.slice(prefix.len();toolname.len())
  }el{
    <toolname
  }
};

f=proxycall(toolname:str;argsjson:str;registry:i64):$proxyresult{
  let found=reg.findfortool(registry;toolname);
  mt found {
    $none {
      log.warn(str.concat("no upstream server for tool: ";toolname);"proxy";"proxy_call");
      <$proxyresult{ ok:false; responsebody:proto.errorresponse(-32601;"Tool not found";toolname); upstreamserver:""; privacyapplied:false }
    };
    $some:entry {
      let sanitised=privacy.anonymise(argsjson);
      mt sanitised {
        $ok:cleanargs {
          let upstreamtool=stripprefix(toolname;entry.toolprefix);
          let rpcbody=str.concat("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"";str.concat(upstreamtool;str.concat("\",\"arguments\":";str.concat(cleanargs;"}}"))));
          let url=str.concat("http://";str.concat(entry.host;str.concat(":";str.concat(str.fromint(entry.port);"/mcp"))));
          let resp=http.post(url;rpcbody;"application/json");
          mt resp {
            $ok:r {
              let restored=privacy.restore(r.body);
              mt restored {
                $ok:cleanresp {
                  log.info(str.concat("proxied ";str.concat(toolname;str.concat(" via ";entry.name)));"proxy";"proxy_call");
                  <$proxyresult{ ok:true; responsebody:cleanresp; upstreamserver:entry.name; privacyapplied:true }
                };
                $err:e {
                  log.warn(str.concat("privacy restore failed for ";str.concat(toolname;str.concat(": ";e)));"proxy";"proxy_call");
                  <$proxyresult{ ok:true; responsebody:r.body; upstreamserver:entry.name; privacyapplied:false }
                }
              }
            };
            $err:e {
              log.warn(str.concat("upstream call failed for ";str.concat(toolname;str.concat(": ";e)));"proxy";"proxy_call");
              <$proxyresult{ ok:false; responsebody:proto.errorresponse(-32603;"Upstream error";e); upstreamserver:entry.name; privacyapplied:false }
            }
          }
        };
        $err:e {
          log.warn(str.concat("privacy anonymise failed for ";str.concat(toolname;str.concat(": ";e)));"proxy";"proxy_call");
          <$proxyresult{ ok:false; responsebody:proto.errorresponse(-32603;"Privacy pipeline error";e); upstreamserver:""; privacyapplied:false }
        }
      }
    }
  }
};

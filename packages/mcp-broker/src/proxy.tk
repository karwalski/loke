m=mcpbroker.proxy;
i=t:shared.types;
i=proto:core.mcp.protocol;
i=reach:shared.reachability;
i=jx:shared.jsonobj;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=pipe:core.privacy.pipeline;
i=ph:core.privacy.placeholder;
i=str:std.str;

(* Privacy-preserving proxy for an upstream MCP tool call (F10.23d, GA1.2).

   Nothing in this module had ever compiled and the shape it was reaching for could not
   have worked. `core.privacy.pipeline` exports neither anonymise nor restore: the
   anonymising entry point is pipe.run, which returns a plain $pipelinerun, and
   restoration lives in core.privacy.placeholder.restore and needs the placeholder MAP
   built from the entities that run found. The legacy code called
   `privacy.restore(r.body)` with no map at all — there was no way for it to put
   anything back, and the $proxyresult it returned would have reported
   privacyapplied:true for a response it had not touched.

   So the map is threaded through: anonymise the arguments, send the anonymised form
   upstream, restore the response against the same map. That is the whole point of the
   broker, and this call site plus cli.proxy are the only two callers of
   placeholder.restore in the repository.

   Also fixed: reg.findfortool returns a $serverentry, not an option, so the
   `$none`/`$some` match had no variants to match (its predicate is reg.isfound);
   std.http.post is not callable at all because http.tki double-declares it as a route
   (F10.16), so this used http.postheaders, later measured to send nothing in that shape
   (T-48) and replaced by reach.localpost (VM1.6f); proto.errorresponse takes
   (id, code, message) and was being called with (code, message, detail); and every
   entry parameter was a bare i64 where it meant $serverentry. *)

t=$proxyresult{ ok:bool; responsebody:str; upstreamserver:str; privacyapplied:bool };

f=stripprefix(toolname:str;prefix:str):str{
  if(str.startswith(toolname;prefix)){
    <str.slice(toolname;str.len(prefix);str.len(toolname))
  }el{
    <toolname
  }
};

f=serverurl(entry:$serverentry):str{
  <str.concat("http://";str.concat(entry.host;str.concat(":";str.fromint(entry.port as i64))))
};

f=proxyupstreamfail(toolname:str;entry:$serverentry):$proxyresult{
  log.warn(str.concat("upstream call failed for ";toolname);"proxy";"proxy_call");
  <$proxyresult{
    ok:false;
    responsebody:proto.errorresponse(1;(0-32603) as i32;str.concat("Upstream error for ";toolname));
    upstreamserver:entry.name;
    privacyapplied:false
  }
};

f=proxyhandleresponse(raw:str;toolname:str;entry:$serverentry;map:$placeholdermap):$proxyresult{
  log.info(str.concat("proxied ";str.concat(toolname;str.concat(" via ";entry.name)));"proxy";"proxy_call");
  <$proxyresult{
    ok:true;
    responsebody:ph.restore(raw;map);
    upstreamserver:entry.name;
    privacyapplied:true
  }
};

(* VM1.6f. The tools/call request was `http.postheaders(http.client(url);"/mcp";...)`, and
   the runtime reads postheaders' first argument as a URL string, so it was never sent (T-48):
   every proxied call failed upstream. An upstream on this machine is called through
   reach.localpost, which arrives. No client call at this toolchain is measured to reach
   another host (T-48), so an upstream elsewhere fails here, before anything is attempted. *)
f=proxysendrequest(cleanargs:str;toolname:str;entry:$serverentry;map:$placeholdermap):$proxyresult{
  if(!reach.isloopbackurl(serverurl(entry))){ <proxyupstreamfail(toolname;entry) }el{};
  let upstreamtool=stripprefix(toolname;entry.toolprefix);
  let rpcbody="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\(jx.escape(upstreamtool)),\"arguments\":\(cleanargs)}}";
  let raw=reach.localpost(serverurl(entry);"/mcp";rpcbody);
  if(str.len(raw)==0){ <proxyupstreamfail(toolname;entry) }el{};
  <proxyhandleresponse(raw;toolname;entry;map)
};

f=proxyblocked(toolname:str;entry:$serverentry):$proxyresult{
  log.warn(str.concat("blocked by sensitivity policy: ";toolname);"proxy";"proxy_call");
  <$proxyresult{
    ok:false;
    responsebody:proto.errorresponse(1;(0-32603) as i32;"Blocked: argument sensitivity exceeds forwarding policy");
    upstreamserver:entry.name;
    privacyapplied:true
  }
};

f=proxyhandleentry(entry:$serverentry;toolname:str;argsjson:str;pipecfg:$pipelineconfig):$proxyresult{
  let run=pipe.run(argsjson;"";pipecfg);
  let detected=run.result;
  (* Fail closed: what the policy will not forward does not go upstream. *)
  if(pipe.issafetoforward(run)){}el{
    <proxyblocked(toolname;entry)
  };
  <proxysendrequest(detected.anonymised;toolname;entry;ph.mapfromentities(detected.entities))
};

f=proxynotfound(toolname:str):$proxyresult{
  log.warn(str.concat("no upstream server for tool: ";toolname);"proxy";"proxy_call");
  <$proxyresult{
    ok:false;
    responsebody:proto.errorresponse(1;(0-32601) as i32;str.concat("Tool not found: ";toolname));
    upstreamserver:"";
    privacyapplied:false
  }
};

f=proxycall(toolname:str;argsjson:str;registry:$brokerregistry;pipecfg:$pipelineconfig):$proxyresult{
  let found=reg.findfortool(registry;toolname);
  if(reg.isfound(found)){
    <proxyhandleentry(found;toolname;argsjson;pipecfg)
  }el{
    <proxynotfound(toolname)
  }
};

m=mcpbroker.aggregator;
i=t:shared.types;
i=proto:mcp.protocol;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;

f=fetchtools(entry:i64):@i64{
  let url="http://"+entry.host+":"+entry.port.tostr()+"/mcp";
  let body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}";
  let resp=http.post(url;body;"application/json");
  |resp{
    $ok:r{
      let parsed=json.parse(r.body);
      |parsed{
        $ok:doc{
          let rawtools=doc.getpath("result.tools");
          |rawtools{
            $ok:toolsval{
              let tools=proto.decodetoollist(toolsval);
              let prefixed=tools.map|tool{
                let already=tool.name.startswith(entry.toolprefix);
                if(already){
                  <tool
                }el{
                  <proto.$mcptool{ name:entry.toolprefix+tool.name; description:tool.description; inputschema:tool.inputschema };
                };
              };
              <prefixed
            };
            $err:e{
              log.warn("no tools field in response from "+entry.name+": "+e;"aggregator";"fetch_tools");
              <@()
            };
          };
        };
        $err:e{
          log.warn("failed to parse tools response from "+entry.name+": "+e;"aggregator";"fetch_tools");
          <@()
        };
      };
    };
    $err:e{
      log.warn("failed to fetch tools from "+entry.name+": "+e;"aggregator";"fetch_tools");
      <@()
    };
  };
};

f=aggregateall(registry:i64):@i64{
  let healthy=registry.servers.filter|s{ s.healthy };
  let alltools=healthy.flatmap|s{ fetchtools(s) };
  <alltools
};

f=toolslistresponse(tools:@i64):str{
  let encoded=proto.encodetoollist(tools);
  <"{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"tools\":"+encoded+"}}"
};

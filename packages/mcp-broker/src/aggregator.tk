m=mcpbroker.aggregator;
i=t:shared.types;
i=proto:mcp.protocol;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=str:std.str;

f=fetchtoolserrtransport(name:str;e:str):@i64{
  log.warn(str.concat("failed to fetch tools from ";str.concat(name;str.concat(": ";e)));"aggregator";"fetch_tools");
  <@()
};

f=fetchtoolserrparse(name:str;e:str):@i64{
  log.warn(str.concat("failed to parse tools response from ";str.concat(name;str.concat(": ";e)));"aggregator";"fetch_tools");
  <@()
};

f=fetchtoolserrnotools(name:str;e:str):@i64{
  log.warn(str.concat("no tools field in response from ";str.concat(name;str.concat(": ";e)));"aggregator";"fetch_tools");
  <@()
};

f=fetchtools(entry:i64):@i64{
  let url=str.concat("http://";str.concat(entry.host;str.concat(":";str.concat(str.fromint(entry.port);"/mcp"))));
  let body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}";
  let resp=http.post(url;body;"application/json");
  let r=mt resp {
    $ok:r r;
    $err:e fetchtoolserrtransport(entry.name;e)
  };
  let parsed=json.parse(r.body);
  let doc=mt parsed {
    $ok:doc doc;
    $err:e fetchtoolserrparse(entry.name;e)
  };
  let rawtools=doc.getpath("result.tools");
  let toolsval=mt rawtools {
    $ok:toolsval toolsval;
    $err:e fetchtoolserrnotools(entry.name;e)
  };
  let tools=proto.decodetoollist(toolsval);
  let prefixed=mut.@();
  lp(let ii1=0;ii1<tools.len;ii1=ii1+1){
    let tool=tools.get(ii1);
    let already=tool.name.startswith(entry.toolprefix);
    if(already){
    prefixed=prefixed.push(tool)
    }el{
    prefixed=prefixed.push($mcptool{ name:str.concat(entry.toolprefix;tool.name); description:tool.description; inputschema:tool.inputschema })
    };
  };
  <prefixed
};

f=aggregateall(registry:i64):@i64{
  let healthy=mut.@();
  lp(let ii2=0;ii2<registry.servers.len;ii2=ii2+1){
    let s=registry.servers.get(ii2);
    if(s.healthy){
      healthy=healthy.push(s)
    }
  };
  let alltools=mut.@();
  lp(let ii3=0;ii3<healthy.len;ii3=ii3+1){
    let s=healthy.get(ii3);
    let stools=fetchtools(s);
    lp(let ii4=0;ii4<stools.len;ii4=ii4+1){
      alltools=alltools.push(stools.get(ii4))
    }
  };
  <alltools
};

f=toolslistresponse(tools:@i64):str{
  let encoded=proto.encodetoollist(tools);
  <str.concat("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"tools\":";str.concat(encoded;"}}"))
};

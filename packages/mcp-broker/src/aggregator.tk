m=mcpbroker.aggregator;
i=t:shared.types;
i=proto:mcp.protocol;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=str:std.str;

f=fetchtools(entry:i64):@i64{
  let url=str.concat("http://";str.concat(entry.host;str.concat(":";str.concat(str.fromint(entry.port);"/mcp"))));
  let body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}";
  let resp=http.post(url;body;"application/json");
  let r=mt resp {
    $ok:r r;
    $err:e {
      log.warn(str.concat("failed to fetch tools from ";str.concat(entry.name;str.concat(": ";e)));"aggregator";"fetch_tools");
      <@()
    }
  };
  let parsed=json.parse(r.body);
  let doc=mt parsed {
    $ok:doc doc;
    $err:e {
      log.warn(str.concat("failed to parse tools response from ";str.concat(entry.name;str.concat(": ";e)));"aggregator";"fetch_tools");
      <@()
    }
  };
  let rawtools=doc.getpath("result.tools");
  let toolsval=mt rawtools {
    $ok:toolsval toolsval;
    $err:e {
      log.warn(str.concat("no tools field in response from ";str.concat(entry.name;str.concat(": ";e)));"aggregator";"fetch_tools");
      <@()
    }
  };
  let tools=proto.decodetoollist(toolsval);
  let prefixed=tools.map|tool{
    let already=tool.name.startswith(entry.toolprefix);
    if(already){
      <tool
    }el{
      <proto.$mcptool{ name:str.concat(entry.toolprefix;tool.name); description:tool.description; inputschema:tool.inputschema }
    }
  };
  <prefixed
};

f=aggregateall(registry:i64):@i64{
  let healthy=registry.servers.filter|s{ s.healthy };
  let alltools=healthy.flatmap|s{ fetchtools(s) };
  <alltools
};

f=toolslistresponse(tools:@i64):str{
  let encoded=proto.encodetoollist(tools);
  <str.concat("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"tools\":";str.concat(encoded;"}}"))
};

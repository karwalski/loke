m=mcpbroker.aggregator;
i=t:shared.types;
i=proto:core.mcp.protocol;
i=http:std.http;
i=json:std.json;
i=log:shared.log;
i=reg:mcpbroker.registry;
i=str:std.str;

(* Tool aggregation across the registered upstream MCP servers (F10.23d).

   Four things in the legacy module did not exist. `core.mcp.protocol` exports neither
   decodetoollist nor encodetoollist — the list encoder it does export is
   toolslistresult, and there was never a decoder, so one is written here. `std.http.post`
   is not callable at all: http.tki declares it twice, once as a route taking
   (str, funcdecl), and toke resolves the route, so no argument list satisfies it
   (F10.16); http.postheaders is the one that works. `doc.getpath("result.tools")` is not
   a member of anything. And every signature here took or returned a bare i64 where it
   meant $serverentry, $mcptool or @$mcptool, which is the LS1.1e class — an untyped
   handle plus a field read is how you get the wrong offset silently.

   json.decode, not json.parse: `json.parse` mangles to tk_json_parse_w, which does not
   exist, and the linker binds it to tk_json_parse — an unrelated runtime helper that
   returns an int64, not a Json. Filed as T-17 in docs/upstream/toke-issues.md. *)

f=notools(name:str;reason:str):@$mcptool{
  log.warn(str.concat("no tools from ";str.concat(name;str.concat(": ";reason)));"aggregator";"fetch_tools");
  <@()
};

f=serverurl(entry:$serverentry):str{
  <str.concat("http://";str.concat(entry.host;str.concat(":";str.fromint(entry.port as i64))))
};

(* Reads the tools array out of a tools/list response body. Returns an empty list when
   the document has no result.tools, which is the same outcome as a transport failure
   and is logged by the caller. *)
f=decodetoollist(body:str):@$mcptool{
  let doc=json.decode(body);
  let result=json.getobj(doc;"result");
  let raw=json.getarray(result;"tools");
  let tools=mut.@();
  lp(let i=0;i<raw.len;i=i+1){
    let item=raw.get(i);
    tools=tools.push($mcptool{
      name:json.getstr(item;"name");
      description:json.getstr(item;"description");
      inputschema:json.enc(json.getval(item;"inputSchema"))
    })
  };
  <tools
};

f=prefixtools(entry:$serverentry;tools:@$mcptool):@$mcptool{
  let prefixed=mut.@();
  lp(let i=0;i<tools.len;i=i+1){
    let tool:$mcptool=tools.get(i);
    if(str.startswith(tool.name;entry.toolprefix)){
      prefixed=prefixed.push(tool)
    }el{
      prefixed=prefixed.push($mcptool{
        name:str.concat(entry.toolprefix;tool.name);
        description:tool.description;
        inputschema:tool.inputschema
      })
    }
  };
  <prefixed
};

f=fetchtools(entry:$serverentry):@$mcptool{
  let body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}";
  let resp=http.postheaders(
    http.client(serverurl(entry));
    "/mcp";
    str.tobytes(body);
    "{\"content-type\":\"application/json\"}"
  );
  <mt resp {
    $ok:r toolsfromresp(entry;r);
    $err:e notools(entry.name;"upstream call failed")
  }
};

(* `body` sits at a different offset in $httpresp than in other structs this module
   sees, so the response is bound with its declared type before the field is read. *)
f=toolsfromresp(entry:$serverentry;r:$httpresp):@$mcptool{
  <prefixtools(entry;decodetoollist(r.body))
};

f=aggregateall(registry:$brokerregistry):@$mcptool{
  let alltools=mut.@();
  lp(let i=0;i<registry.servers.len;i=i+1){
    let s:$serverentry=registry.servers.get(i);
    if(s.healthy){
      let stools=fetchtools(s);
      lp(let j=0;j<stools.len;j=j+1){
        alltools=alltools.push(stools.get(j))
      }
    }el{}
  };
  <alltools
};

f=toolslistresponse(tools:@$mcptool):str{
  <proto.okresponse(1;proto.toolslistresult(tools))
};

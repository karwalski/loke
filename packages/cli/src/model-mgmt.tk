m=cli.modelmgmt;

i=t:shared.types;
i=str:std.str;
i=out:cli.output;
i=log:shared.log;
i=db:storage.db;
i=updater:core.installer.updater;
i=uninstall:core.installer.uninstall;

f=runupdate(args:@str;store:i64):i64{
  let modelid=if(str.len(args) > 0){
    args.get(0)
  }el{
    mt db.getstr(store;"installer.default_model") {
      $ok:v v;
      $err:e "qwen2.5:7b"
    }
  };
  out.print(str.concat("Checking for updates to ";str.concat(modelid;"...")));
  let check=updater.checkmodelupdate(modelid);
  if(check.isnewer=false){
    out.print(str.concat(modelid;" is already up to date."));
    <0
  }el{};
  out.print(str.concat("Update available for ";modelid));
  if(str.len(check.releasenotes) > 0){
    out.print(str.concat("  Notes: ";check.releasenotes))
  }el{};
  out.print(str.concat("Updating ";str.concat(modelid;"...")));
  let success=updater.updatemodel(modelid);
  if(success){
    out.print(str.concat("Updated ";str.concat(modelid;" successfully.")))
  }el{
    out.print(str.concat("Update failed for ";str.concat(modelid;". Try manually: ollama pull ";str.concat(modelid;""))))
  };
  <0
};

f=rununinstallmodel(args:@str):i64{
  let hasarg=str.len(args) > 0;
  if(hasarg=false){
    let models=uninstall.listremovable();
    if(str.len(models)=0){
      out.print("No models installed.");
      <0
    }el{};
    out.print("Installed models:");
    let i=mut.0;
    lp(let lv=0;i<str.len(models);lv=lv){
      out.print(str.concat(
        str.concat("  ";models.get(i).name);
        str.concat("  (";str.concat(models.get(i).size;")"))
      ));
      i=i+1
    };
    out.print("Usage: loke uninstall-model <model-name>");
    <0
  }el{};
  let modelid=args.get(0);
  let confirm=out.prompt(str.concat(
    str.concat("Remove ";modelid);
    "? [y/N] "
  ));
  if(str.eq(str.tolower(str.trim(confirm));"y")=false){
    out.print("Cancelled.");
    <0
  }el{};
  out.print(str.concat("Removing ";str.concat(modelid;"...")));
  let result=uninstall.uninstallmodel(modelid);
  if(result.success){
    if(str.len(result.freedspace) > 0){
      out.print(str.concat("Removed. Freed ";result.freedspace))
    }el{
      out.print(result.message)
    }
  }el{
    out.print(str.concat("Error: ";result.message))
  };
  <0
};

f=rununinstallollama(args:@str):i64{
  let confirm=out.prompt("Remove Ollama from ~/.loke/bin? [y/N] ");
  if(str.eq(str.tolower(str.trim(confirm));"y")=false){
    out.print("Cancelled.");
    <0
  }el{};
  out.print("Removing Ollama...");
  let result=uninstall.uninstallollama();
  if(result.success){
    out.print(result.message)
  }el{
    out.print(str.concat("Error: ";result.message))
  };
  <0
};

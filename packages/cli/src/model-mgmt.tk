m=cli.modelmgmt;

i=t:shared.types;
i=str:std.str;
i=out:cli.output;
i=log:shared.log;
i=db:core.storage.db;
i=updater:core.installer.updater;
i=uninstall:core.installer.uninstall;

(* cli.output exports printline, not print — and `print` cannot be added to it under
   that name: toke's lexer warns W1020 on the identifier as a Python keyword. *)
f=runupdate(args:@str;store:$store):i64{
  let modelid=mut.mt db.getstr(store;"installer.default_model") {
      $ok:v v;
      $err:e "qwen2.5:7b"
    }; if(args.len > 0){
    modelid=args.get(0)
  }el{};
  out.printline("Checking for updates to \(modelid)...");
  let check=updater.checkmodelupdate(modelid);
  (* $updatecheck's field is `updateavailable`; there is no `isnewer`. *)
  if(check.updateavailable==false){
    out.printline(str.concat(modelid;" is already up to date."));
    <0
  }el{};
  out.printline(str.concat("Update available for ";modelid));
  if(str.len(check.releasenotes) > 0){
    out.printline(str.concat("  Notes: ";check.releasenotes))
  }el{};
  out.printline("Updating \(modelid)...");
  if(updater.updatemodel(modelid)){
    out.printline("Updated \(modelid) successfully.")
  }el{
    out.printline("Update failed for \(modelid). Try manually: ollama pull \(modelid)")
  };
  <0
};

f=rununinstallmodel(args:@str):i64{
  if((args.len > 0)==false){
    let models=uninstall.listremovable();
    if(models.len==0){
      out.printline("No models installed.");
      <0
    }el{};
    out.printline("Installed models:");
    let i=mut.0;
    lp(let lv=0;i<models.len;lv=lv){
      let m:$removablemodel=models.get(i);
      out.printline("  \(m.name)  (\(m.size))");
      i=i+1
    };
    out.printline("Usage: loke uninstall-model <model-name>");
    <0
  }el{};
  let modelid=args.get(0);
  let confirm=out.prompt("Remove \(modelid)? [y/N] ");
  if(str.eq(str.lower(str.trim(confirm));"y")==false){
    out.printline("Cancelled.");
    <0
  }el{};
  out.printline("Removing \(modelid)...");
  let result=uninstall.uninstallmodel(modelid);
  if(result.success){
    if(str.len(result.freedspace) > 0){
      out.printline(str.concat("Removed. Freed ";result.freedspace))
    }el{
      out.printline(result.message)
    }
  }el{
    out.printline(str.concat("Error: ";result.message))
  };
  <0
};

f=rununinstallollama(args:@str):i64{
  if(str.eq(str.lower(str.trim(out.prompt("Remove Ollama from ~/.loke/bin? [y/N] ")));"y")==false){
    out.printline("Cancelled.");
    <0
  }el{};
  out.printline("Removing Ollama...");
  let result=uninstall.uninstallollama();
  if(result.success){
    out.printline(result.message)
  }el{
    out.printline(str.concat("Error: ";result.message))
  };
  <0
};

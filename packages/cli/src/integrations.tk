m=cli.integrations;
i=str:std.str;
i=log:shared.log;
i=out:cli.output;
i=ext:core.governance.external;
i=cfg:shared.config;
i=tr:loke.platform.i18n.translator;
i=http:std.http;
i=time:std.time;

f=presetnames():@$str{
  <@("pagerduty";"datadog";"grafana";"splunk";"elastic";"slack";"teams";"opsgenie";"servicenow";"webhook")
};

f=isvalidpreset(name:str):bool{
  let presets=presetnames();
  let i=0;
  if(i<presets.len){
    if(str.eq(presets.get(i);name)){<true}el{};
    i=i+1;
  }el{};
  <false
};

f=run(args:@str):i64{
  if(args.len<1){
    printusage();
    <0
  }el{
    let sub=args.get(0);
    if(str.eq(sub;"list")){
      <runlist()
    }el{
      if(str.eq(sub;"add")){
        <runadd(args)
      }el{
        if(str.eq(sub;"test")){
          <runtest(args)
        }el{
          log.info(str.concat("unknown integrations subcommand: ";sub);"cli.integrations";"system");
          printusage();
          <1
        };
      };
    };
  };
};

f=printusage():void{
  out.printline("Usage:");
  out.printline("  loke integrations list                show configured endpoints");
  out.printline("  loke integrations add <preset>        add a preset endpoint");
  out.printline("  loke integrations test <id>           send a test event to an endpoint");
  out.printline("");
  out.printline("Available presets:");
  out.printline("  pagerduty, datadog, grafana, splunk, elastic,");
  out.printline("  slack, teams, opsgenie, servicenow, webhook")
};

f=runlist():i64{
  let config=loadexternalconfig();
  let endpoints=config.endpoints;

  if(endpoints.len=0){
    out.printline("No integrations configured.");
    out.printline("Use 'loke integrations add <preset>' to add one.");
    <0
  }el{
    out.printline(str.concat("Configured integrations (";str.concat(str.fromint(endpoints.len);"):")));
    out.printline("");
    out.printline(str.concat(
      str.padright("NAME";16;" ");
      str.concat(
        str.padright("TYPE";22;" ");
        str.concat(
          str.padright("URL";40;" ");
          str.concat(
            str.padright("ENABLED";10;" ");
            "EVENTS"
          )
        )
      )
    ));
    out.printline(str.repeat("-";96));

    let i=0;
    if(i<endpoints.len){
      let ep=endpoints.get(i);
      let enabledstr=mut."no"; if(ep.enabled){enabledstr="yes"}el{};
      let eventsstr=str.fromint(ep.events.len);
      out.printline(str.concat(
        str.padright(ep.name;16;" ");
        str.concat(
          str.padright(ep.integrationtype;22;" ");
          str.concat(
            str.padright(str.truncate(ep.url;38);40;" ");
            str.concat(
              str.padright(enabledstr;10;" ");
              eventsstr
            )
          )
        )
      ));
      i=i+1;
    }el{};
    <0
  };
};

f=runadd(args:@str):i64{
  if(args.len<2){
    out.printerror("usage: loke integrations add <preset>");
    out.printline("");
    out.printline("Available presets:");
    let presets=presetnames();
    let i=0;
    if(i<presets.len){
      out.printline(str.concat("  ";presets.get(i)));
      i=i+1;
    }el{};
    <1
  }el{
    let preset=args.get(1);
    if(isvalidpreset(preset)=false){
      out.printerror(str.concat("unknown preset: ";preset));
      out.printline("Run 'loke integrations add' to see available presets.");
      <1
    }el{
      let ep=buildpresetendpoint(preset);
      let isok=mt ep {
        $ok:endpoint true;
        $err:msg false
      };
      if(isok=false){
        out.printerror("Failed to build preset endpoint");
        <1
      }el{};
      let endpoint=mt ep {
        $ok:endpoint endpoint;
        $err:msg endpoint
      };
      out.printline(str.concat("Added integration: ";endpoint.name));
      out.printline(str.concat("  ID:     ";endpoint.id));
      out.printline(str.concat("  Type:   ";endpoint.integrationtype));
      out.printline(str.concat("  URL:    ";endpoint.url));
      out.printline(str.concat("  Events: ";str.fromint(endpoint.events.len)));
      out.printline("");
      out.printline("Integration added to configuration.");
      if(str.len(endpoint.authtokenenv)>0){
        out.printline(str.concat("Set the environment variable '";str.concat(endpoint.authtokenenv;"' with your API key/token.")))
      }el{};
      log.info(str.concat("added integration: ";endpoint.id);"cli.integrations";"system");
      <0
    };
  };
};

f=buildpresetendpoint(preset:str):$externalendpoint!$err{
  if(str.eq(preset;"pagerduty")){
    <ext.pagerduty("PAGERDUTY_ROUTING_KEY")
  }el{
    if(str.eq(preset;"datadog")){
      <ext.datadog("DATADOG_API_KEY")
    }el{
      if(str.eq(preset;"grafana")){
        <ext.grafana("https://prometheus-push.example.com/api/v1/push";"GRAFANA_AUTH_TOKEN")
      }el{
        if(str.eq(preset;"splunk")){
          <ext.splunk("https://splunk-hec.example.com:8088/services/collector";"SPLUNK_HEC_TOKEN")
        }el{
          if(str.eq(preset;"elastic")){
            <ext.elastic("https://elastic.example.com:9200/_bulk";"ELASTIC_API_KEY")
          }el{
            if(str.eq(preset;"slack")){
              <ext.slack("https://hooks.slack.com/services/PLACEHOLDER")
            }el{
              if(str.eq(preset;"teams")){
                <ext.teams("https://outlook.office.com/webhook/PLACEHOLDER")
              }el{
                if(str.eq(preset;"opsgenie")){
                  <ext.opsgenie("OPSGENIE_API_KEY")
                }el{
                  if(str.eq(preset;"servicenow")){
                    <ext.servicenow("https://instance.service-now.com";"SERVICENOW_AUTH_TOKEN")
                  }el{
                    if(str.eq(preset;"webhook")){
                      <ext.webhook("custom-webhook";"Custom Webhook";"https://example.com/webhook";"bearer_token";"WEBHOOK_AUTH_TOKEN";@("incident.created";"violation.block"))
                    }el{
                      <$$err(str.concat("unknown preset: ";preset))
                    };
                  };
                };
              };
            };
          };
        };
      };
    };
  };
};

f=runtest(args:@str):i64{
  if(args.len<2){
    out.printerror("usage: loke integrations test <id>");
    <1
  }el{
    let targetid=args.get(1);
    let config=loadexternalconfig();
    let found=mut.false;
    let targetep=mut.$externalendpoint{
      id:"";name:"";integrationtype:"";url:"";authmethod:"";
      authtokenenv:"";authheadername:"";enabled:true;
      retrycount:1;timeoutms:5000;events:@()
    };

    config.endpoints.each|ep{
      if(str.eq(ep.id;targetid)){
        found=true;
        targetep=ep
      }el{};
    };

    if(found=false){
      out.printerror(str.concat("no endpoint found with id: ";targetid));
      out.printline("Run 'loke integrations list' to see configured endpoints.");
      <1
    }el{
      out.printline(str.concat("Testing endpoint: ";str.concat(targetep.name;" ...")));

      let testevent=$governanceevent{
        eventtype:"incident.created";
        timestamp:time.nowiso8601();
        severity:"P3";
        title:"loke integration test";
        description:"This is a test event sent from 'loke integrations test'.";
        source:"cli.integrations.test";
        requestid:"test-0000";
        metadata:"{}"
      };

      let startms=time.nowms();
      let testconfig=$externalconfig{
        endpoints:@(targetep);
        batchintervalms:0;
        maxbatchsize:1;
        failopen:true
      };
      let results=ext.dispatch(testconfig;testevent);
      let endms=time.nowms();
      let latency=endms-startms;

      if(results.len>0){
        let r=results.get(0);
        if(r.success){
          out.printline(str.concat("  Result:  SUCCESS (";str.concat(str.fromint(latency);str.concat("ms";")
"))));
          log.info(str.concat("test event dispatched to ";targetep.name);"cli.integrations";"system");
          <0
        }el{
          out.printline(str.concat("  Result:  FAILED (";str.concat(str.fromint(latency);"ms)")));
          out.printline(str.concat("  Error:   ";r.error));
          log.warn(str.concat("test event failed for ";targetep.name);"cli.integrations";"system");
          <1
        };
      }el{
        out.printline("  Result:  NO RESPONSE (endpoint may not subscribe to test event type)");
        <1
      };
    };
  };
};

f=loadexternalconfig():i64{
  let config=mt cfg.loadconfig("~/.loke/config.toml") {
    $ok:v v;
    $err:e cfg.defaultconfig()
  };
  <mt cfg.getexternalconfig(config) {
    $ok:v v;
    $err:e ext.defaultconfig()
  }
};

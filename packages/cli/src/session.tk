m=cli.session;


i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=db:storage.db;
i=str:std.str;

t=$session{
  id:str;
  name:str;
  createdat:i64;
  lastactive:i64;
  requestcount:i32;
  active:bool
};

f=ensuretable(store:i64):bool{
  let sql="CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, name TEXT, created_at INT, last_active INT, request_count INT DEFAULT 0, active INT DEFAULT 1)";
  let result=mt db.exec(store;sql) {
    $ok:v true;
    $err:e false
  };
  <result
};

f=newsession(store:i64;name:str):$session{
  let id=str.hexid();
  let now=db.nowunix();
  let sql=str.concat(
    "INSERT INTO sessions (id, name, created_at, last_active, request_count, active) VALUES ('";
    str.concat(
      id;
      str.concat(
        "', '";
        str.concat(
          name;
          str.concat(
            "', ";
            str.concat(
              str.fromint64(now);
              str.concat(
                ", ";
                str.concat(
                  str.fromint64(now);
                  ", 0, 1)"
                )
              )
            )
          )
        )
      )
    )
  );
  mt db.exec(store;sql) {
    $ok:v ();
    $err:e ()
  };
  <$session{
    id=id;
    name=name;
    createdat=now;
    lastactive=now;
    requestcount=0;
    active=true
  };
};

f=listsessions(store:i64):@$session{
  let sql="SELECT id, name, created_at, last_active, request_count, active FROM sessions ORDER BY last_active DESC";
  let rows=mt db.query(store;sql) {
    $ok:v v;
    $err:e <@()
  };
  let sessions=@();
  let i=0;
  lp(true) i<str.len(rows){
    let row=rows.get(i);
    let s=$session{
      id=db.rowstr(row;"id");
      name=db.rowstr(row;"name");
      createdat=db.rowint64(row;"created_at");
      lastactive=db.rowint64(row;"last_active");
      requestcount=db.rowint(row;"request_count");
      active=db.rowbool(row;"active")
    };
    let sessions=str.arrappend(sessions;s);
    let i=i+1
  };
  <sessions
};

f=getactive(store:i64):($session){
  let sql="SELECT id, name, created_at, last_active, request_count, active FROM sessions WHERE active=1 ORDER BY last_active DESC LIMIT 1";
  let rows=mt db.query(store;sql) {
    $ok:v v;
    $err:e <()
  };
  if(str.len(rows)<1){
    <()
  }el{
    let row=rows.get(0);
    <($session{
      id=db.rowstr(row;"id");
      name=db.rowstr(row;"name");
      createdat=db.rowint64(row;"created_at");
      lastactive=db.rowint64(row;"last_active");
      requestcount=db.rowint(row;"request_count");
      active=db.rowbool(row;"active")
    })
  };
};

f=switchto(store:i64;name:str):bool{
  let now=db.nowunix();
  let sqldeactivate="UPDATE sessions SET active=0";
  mt db.exec(store;sqldeactivate) {
    $ok:v ();
    $err:e <false
  };
  let sqlactivate=str.concat(
    "UPDATE sessions SET active=1, last_active=";
    str.concat(
      str.fromint64(now);
      str.concat(" WHERE name='";str.concat(name;"'"))
    )
  );
  let result=mt db.exec(store;sqlactivate) {
    $ok:v true;
    $err:e false
  };
  <result
};

f=closesession(store:i64;name:str):bool{
  let sql=str.concat(
    "UPDATE sessions SET active=0 WHERE name='";
    str.concat(name;"'")
  );
  let result=mt db.exec(store;sql) {
    $ok:v true;
    $err:e false
  };
  <result
};

f=recordrequest(store:i64;sessionid:str):bool{
  let now=db.nowunix();
  let sql=str.concat(
    "UPDATE sessions SET request_count=request_count+1, last_active=";
    str.concat(
      str.fromint64(now);
      str.concat(" WHERE id='";str.concat(sessionid;"'"))
    )
  );
  let result=mt db.exec(store;sql) {
    $ok:v true;
    $err:e false
  };
  <result
};

f=formatsessions(sessions:@$session):str{
  let header="Name             | ID               | Requests | Last Active          | Status";
  let sep  ="-----------------|------------------|----------|----------------------|--------";
  let body=str.concat(header;str.concat("
";sep));
  let i=0;
  lp(true) i<str.len(sessions){
    let s=sessions.get(i);
    let status=if s.active{"● active"}el{"  idle"};
    let last=str.formatunix(s.lastactive);
    let line=str.concat(
      "
";
      str.concat(
        str.padright(s.name;16);
        str.concat(
          " | ";
          str.concat(
            str.padright(s.id;16);
            str.concat(
              " | ";
              str.concat(
                str.padleft(str.fromint(s.requestcount);8);
                str.concat(
                  " | ";
                  str.concat(
                    str.padright(last;20);
                    str.concat(" | ";status)
                  )
                )
              )
            )
          )
        )
      )
    );
    let body=str.concat(body;line);
    let i=i+1
  };
  <body
};

f=run(subcommand:str;args:@str;store:i64):i32{
  let ok=ensuretable(store);
  if(str.eq(subcommand;"list")){
    let sessions=listsessions(store);
    out.printline(formatsessions(sessions));
    <0
  }el{
    if(str.eq(subcommand;"new")){
      if(str.len(args)<1){
        out.printerror("usage: loke session new <name>");
        <1
      }el{
        let name=args.get(0);
        let s=newsession(store;name);
        out.printline(str.concat("Created session: ";s.name));
        <0
      };
    }el{
      if(str.eq(subcommand;"switch")){
        if(str.len(args)<1){
          out.printerror("usage: loke session switch <name>");
          <1
        }el{
          let name=args.get(0);
          let switched=switchto(store;name);
          if(switched){
            out.printline(str.concat("Switched to session: ";name));
            <0
          }el{
            out.printerror(str.concat("session not found: ";name));
            <1
          };
        };
      }el{
        if(str.eq(subcommand;"close")){
          if(str.len(args)<1){
            out.printerror("usage: loke session close <name>");
            <1
          }el{
            let name=args.get(0);
            let closed=closesession(store;name);
            if(closed){
              out.printline(str.concat("Closed session: ";name));
              <0
            }el{
              out.printerror(str.concat("session not found: ";name));
              <1
            };
          };
        }el{
          out.printline("usage: loke session <subcommand> [args]

subcommands:
  list           list all sessions
  new <name>     create a new named session
  switch <name>  switch to a named session
  close <name>   close a named session");
          <1
        };
      };
    };
  };
};

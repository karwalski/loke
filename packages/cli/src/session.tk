m=cli.session;

i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=db:core.storage.db;
i=str:std.str;
i=time:std.time;

t=$session{
  id:str;
  name:str;
  createdat:i64;
  lastactive:i64;
  requestcount:i32;
  active:bool
};

f=ensuretable(store:i64):bool{
  let sql="CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, name TEXT, created_at INT, last_active INT, request_count INT DEFAULT 0, active INT DEFAULT 1)";
  let result=mt db.exec(store;sql) {
    $ok:v true;
    $err:e false
  };
  <result
};

f=newsession(store:i64;name:str):$session{
  (* std.str.hexid takes an argument and this called it with none; shared.log already
     mints ids for correlation and is what the rest of the CLI uses. *)
  let id=log.newcorrelationid();
  let now=db.nowms();
  let sql=str.concat(
    "INSERT INTO sessions (id, name, created_at, last_active, request_count, active) VALUES ('";
    str.concat(
      id;
      str.concat(
        "', '";
        str.concat(
          name;
          str.concat(
            "', ";
            str.concat(
              str.fromint64(now);
              str.concat(
                ", ";
                str.concat(
                  str.fromint64(now);
                  ", 0, 1)"
                )
              )
            )
          )
        )
      )
    )
  );
  mt db.exec(store;sql) {
    $ok:v 0;
    $err:e 0
  };
  <$session{
    id:id;
    name:name;
    createdat:now;
    lastactive:now;
    requestcount:0;
    active:true
  }
};

f=listsessions(store:i64):@$session{
  let sql="SELECT id, name, created_at, last_active, request_count, active FROM sessions ORDER BY last_active DESC";
  let rows=mt db.query(store;sql) {
    $ok:v v;
    $err:e @()
  };
  (* `let sessions=...` and `let i=i+1` inside the loop declared new bindings each
     pass, so this listed nothing and never terminated. *)
  let sessions=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row=rows.get(i);
    sessions=sessions.push($session{
      id:db.rowstr(row;"id");
      name:db.rowstr(row;"name");
      createdat:db.rowi64(row;"created_at");
      lastactive:db.rowi64(row;"last_active");
      requestcount:db.rowi32(row;"request_count");
      active:db.rowbool(row;"active")
    })
  };
  <sessions
};

f=getactive(store:i64):$session{
  let sql="SELECT id, name, created_at, last_active, request_count, active FROM sessions WHERE active=1 ORDER BY last_active DESC LIMIT 1";
  let rows=mt db.query(store;sql) {
    $ok:v v;
    $err:e @()
  };
  if(rows.len<1){
    <$session{id:"";name:"";createdat:0;lastactive:0;requestcount:0;active:false}
  }el{
    let row=rows.get(0);
    <$session{
      id:db.rowstr(row;"id");
      name:db.rowstr(row;"name");
      createdat:db.rowi64(row;"created_at");
      lastactive:db.rowi64(row;"last_active");
      requestcount:db.rowi32(row;"request_count");
      active:db.rowbool(row;"active")
    }
  }
};

f=switchto(store:i64;name:str):bool{
  let now=db.nowms();
  let sqldeactivate="UPDATE sessions SET active=0";
  mt db.exec(store;sqldeactivate) {
    $ok:v 0;
    $err:e false
  };
  let sqlactivate=str.concat(
    "UPDATE sessions SET active=1, last_active=";
    str.concat(
      str.fromint64(now);
      str.concat(" WHERE name='";str.concat(name;"'"))
    )
  );
  let result=mt db.exec(store;sqlactivate) {
    $ok:v true;
    $err:e false
  };
  <result
};

f=closesession(store:i64;name:str):bool{
  let sql=str.concat(
    "UPDATE sessions SET active=0 WHERE name='";
    str.concat(name;"'")
  );
  let result=mt db.exec(store;sql) {
    $ok:v true;
    $err:e false
  };
  <result
};

f=recordrequest(store:i64;sessionid:str):bool{
  let now=db.nowms();
  let sql=str.concat(
    "UPDATE sessions SET request_count=request_count+1, last_active=";
    str.concat(
      str.fromint64(now);
      str.concat(" WHERE id='";str.concat(sessionid;"'"))
    )
  );
  let result=mt db.exec(store;sql) {
    $ok:v true;
    $err:e false
  };
  <result
};

(* Same two defects as listsessions, plus str.padright's third argument: it takes the
   pad character. shared.types.strpad wraps the space-padding case. *)
(* std.str has no formatunix, and the timestamps in this table are epoch MILLIseconds
   (db.nowms) — the legacy code called the nonexistent str.formatunix on a value it had
   obtained from the equally nonexistent db.nowunix. *)
f=isofromms(ms:i64):str{
  <time.format((ms/1000) as u64;"%Y-%m-%d %H:%M:%S")
};

f=formatsessions(sessions:@$session):str{
  let rows=mut.@("Name             | ID               | Requests | Last Active          | Status";
                 "-----------------|------------------|----------|----------------------|--------");
  lp(let i=0;i<sessions.len;i=i+1){
    let s:$session=sessions.get(i);
    let status=mut."idle";
    if(s.active){status="active"}el{};
    rows=rows.push("\(t.strpad(s.name;16)) | \(t.strpad(s.id;16)) | \(t.strpad(str.fromint(s.requestcount);8)) | \(t.strpad(isofromms(s.lastactive);20)) | \(status)")
  };
  <str.join("
";rows)
};


f=run(subcommand:str;args:@str;store:i64):i64{
  let ok=ensuretable(store);
  if(str.eq(subcommand;"list")){
    let sessions=listsessions(store);
    out.printline(formatsessions(sessions));
    <0
  }el{
    if(str.eq(subcommand;"new")){
      if(args.len<1){
        out.printerror("usage: loke session new <name>");
        <1
      }el{
        let name=args.get(0);
        let s=newsession(store;name);
        out.printline(str.concat("Created session: ";s.name));
        <0
      }
    }el{
      if(str.eq(subcommand;"switch")){
        if(args.len<1){
          out.printerror("usage: loke session switch <name>");
          <1
        }el{
          let name=args.get(0);
          let switched=switchto(store;name);
          if(switched){
            out.printline(str.concat("Switched to session: ";name));
            <0
          }el{
            out.printerror(str.concat("session not found: ";name));
            <1
          }
        }
      }el{
        if(str.eq(subcommand;"close")){
          if(args.len<1){
            out.printerror("usage: loke session close <name>");
            <1
          }el{
            let name=args.get(0);
            let closed=closesession(store;name);
            if(closed){
              out.printline(str.concat("Closed session: ";name));
              <0
            }el{
              out.printerror(str.concat("session not found: ";name));
              <1
            }
          }
        }el{
          out.printline("usage: loke session <subcommand> [args]

subcommands:
  list           list all sessions
  new <name>     create a new named session
  switch <name>  switch to a named session
  close <name>   close a named session");
          <1
        }
      }
    }
  }
};

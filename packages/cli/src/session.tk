m=cli.session;

i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=db:core.storage.db;
i=rawdb:std.db;
i=str:std.str;
i=time:std.time;

t=$session{
  id:str;
  name:str;
  createdat:i64;
  lastactive:i64;
  requestcount:i32;
  active:bool
};

(* X4b.10. Every statement here was wrong in the same two ways. It wrote to `sessions`, which
   migration 5 had already created with a different shape (mode NOT NULL, last_active_at),
   so CREATE TABLE IF NOT EXISTS did nothing and every insert and update named columns that
   do not exist. And it built each statement by concatenating the session name into the SQL,
   so a name with a quote broke the statement or became part of it. The failures were hidden:
   core.storage.db.exec returns a user-sum result, whose arms no caller can tell apart (T-18).
   The CLI's sessions now have their own table, `cli_sessions` (migration 33), every value is
   a bound parameter, and every result is a bool from std.db. *)
f=ensuretable(store:i64):bool{
  <mt rawdb.exec("CREATE TABLE IF NOT EXISTS cli_sessions (id TEXT PRIMARY KEY, name TEXT NOT NULL UNIQUE, created_at INT NOT NULL, last_active INT NOT NULL, request_count INT NOT NULL DEFAULT 0, active INT NOT NULL DEFAULT 0)";@()) {
    $ok:v true;
    $err:e false
  }
};

f=execok(sql:str;params:@str):bool{
  <mt rawdb.exec(sql;params) {
    $ok:v true;
    $err:e false
  }
};

f=changed():i64{
  <mt rawdb.one("SELECT changes() AS n";@()) {
    $ok:r rawdb.rowi64(r;"n");
    $err:e 0
  }
};

f=nosession():$session{
  <$session{id:"";name:"";createdat:0;lastactive:0;requestcount:0;active:false}
};

f=sessionfromrow(row:$row):$session{
  <$session{
    id:rawdb.rowstr(row;"id");
    name:rawdb.rowstr(row;"name");
    createdat:rawdb.rowi64(row;"created_at");
    lastactive:rawdb.rowi64(row;"last_active");
    requestcount:rawdb.rowi64(row;"request_count") as i32;
    active:rawdb.rowi64(row;"active")==1
  }
};

f=sessionsfrom(sql:str;params:@str):@$session{
  let rows=mt rawdb.many(sql;params) {
    $ok:v v;
    $err:e @()
  };
  let out2=mut.@();
  lp(let i=0;i<rows.len;i=i+1){
    let row:$row=rows.get(i);
    out2=out2.push(sessionfromrow(row))
  };
  <out2
};

(* A new session, not yet active. An empty id means it was not created: a name that is
   empty or already taken. *)
f=newsession(store:i64;name:str):$session{
  if(str.len(name)==0 || !ensuretable(store)){ <nosession() }el{};
  let id=log.newcorrelationid();
  let now=db.nowms();
  let nows=str.fromint(now);
  if(!execok("INSERT INTO cli_sessions (id, name, created_at, last_active, request_count, active) VALUES (?, ?, ?, ?, 0, 0)";@(id;name;nows;nows))){
    <nosession()
  }el{};
  <$session{id:id;name:name;createdat:now;lastactive:now;requestcount:0;active:false}
};

f=listsessions(store:i64):@$session{
  if(!ensuretable(store)){ <@() }el{};
  <sessionsfrom("SELECT id, name, created_at, last_active, request_count, active FROM cli_sessions WHERE id<>? ORDER BY last_active DESC, rowid DESC";@(""))
};

f=findsession(store:i64;name:str):$session{
  if(!ensuretable(store)){ <nosession() }el{};
  let found=sessionsfrom("SELECT id, name, created_at, last_active, request_count, active FROM cli_sessions WHERE name=?";@(name));
  if(found.len==0){ <nosession() }el{};
  <found.get(0)
};

f=getactive(store:i64):$session{
  if(!ensuretable(store)){ <nosession() }el{};
  let found=sessionsfrom("SELECT id, name, created_at, last_active, request_count, active FROM cli_sessions WHERE active=? ORDER BY last_active DESC LIMIT 1";@("1"));
  if(found.len==0){ <nosession() }el{};
  <found.get(0)
};

(* Exactly one session is active afterwards, or none changes: an unknown name is refused
   BEFORE the current session is deactivated. *)
f=switchto(store:i64;name:str):bool{
  let target=findsession(store;name);
  if(str.len(target.id)==0){ <false }el{};
  let now=str.fromint(db.nowms());
  if(!execok("UPDATE cli_sessions SET active=0 WHERE id<>?";@(target.id))){ <false }el{};
  if(!execok("UPDATE cli_sessions SET active=1, last_active=? WHERE id=?";@(now;target.id))){ <false }el{};
  <changed()==1
};

f=closesession(store:i64;name:str):bool{
  if(!ensuretable(store)){ <false }el{};
  if(!execok("UPDATE cli_sessions SET active=0 WHERE name=?";@(name))){ <false }el{};
  <changed()==1
};

f=recordrequest(store:i64;sessionid:str):bool{
  if(!ensuretable(store)){ <false }el{};
  if(!execok("UPDATE cli_sessions SET request_count=request_count+1, last_active=? WHERE id=?";@(str.fromint(db.nowms());sessionid))){ <false }el{};
  <changed()==1
};

(* Same two defects as listsessions, plus str.padright's third argument: it takes the
   pad character. shared.types.strpad wraps the space-padding case. *)
(* std.str has no formatunix, and the timestamps in this table are epoch MILLIseconds
   (db.nowms) — the legacy code called the nonexistent str.formatunix on a value it had
   obtained from the equally nonexistent db.nowunix. *)
f=isofromms(ms:i64):str{
  <time.format((ms/1000) as u64;"%Y-%m-%d %H:%M:%S")
};

f=formatsessions(sessions:@$session):str{
  let rows=mut.@("Name             | ID               | Requests | Last Active          | Status";
                 "-----------------|------------------|----------|----------------------|--------");
  lp(let i=0;i<sessions.len;i=i+1){
    let s:$session=sessions.get(i);
    let status=mut."idle";
    if(s.active){status="active"}el{};
    rows=rows.push("\(t.strpad(s.name;16)) | \(t.strpad(s.id;16)) | \(t.strpad(str.fromint(s.requestcount);8)) | \(t.strpad(isofromms(s.lastactive);20)) | \(status)")
  };
  <str.join("
";rows)
};


f=run(subcommand:str;args:@str;store:i64):i64{
  ensuretable(store);
  if(str.eq(subcommand;"list")){
    out.printline(formatsessions(listsessions(store)));
    <0
  }el{
    if(str.eq(subcommand;"new")){
      if(args.len<1){
        out.printerror("usage: loke session new <name>");
        <1
      }el{
        let name=args.get(0);
        let s=newsession(store;name);
        if(str.len(s.id)==0){
          out.printerror(str.concat("could not create session (empty or already taken): ";name));
          <1
        }el{};
        out.printline(str.concat("Created session: ";s.name));
        <0
      }
    }el{
      if(str.eq(subcommand;"switch")){
        if(args.len<1){
          out.printerror("usage: loke session switch <name>");
          <1
        }el{
          let name=args.get(0);
          if(switchto(store;name)){
            out.printline(str.concat("Switched to session: ";name));
            <0
          }el{
            out.printerror(str.concat("session not found: ";name));
            <1
          }
        }
      }el{
        if(str.eq(subcommand;"close")){
          if(args.len<1){
            out.printerror("usage: loke session close <name>");
            <1
          }el{
            let name=args.get(0);
            if(closesession(store;name)){
              out.printline(str.concat("Closed session: ";name));
              <0
            }el{
              out.printerror(str.concat("session not found: ";name));
              <1
            }
          }
        }el{
          out.printline("usage: loke session <subcommand> [args]

subcommands:
  list           list all sessions
  new <name>     create a new named session
  switch <name>  switch to a named session
  close <name>   close a named session");
          <1
        }
      }
    }
  }
};

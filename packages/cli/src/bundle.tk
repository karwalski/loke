m=cli.bundle;

i=str:std.string;



t=$buildtarget{
  name:str;
  os:str;
  arch:str;
  outputname:str;
  stripdebug:bool
};

t=$bundleconfig{
  appname:str;
  version:str;
  bundleid:str;
  targets:@$buildtarget;
  includemodels:bool;
  modelpaths:@str
};

t=$dmgconfig{
  volumename:str;
  background:str;
  iconsize:i32;
  windowwidth:i32;
  windowheight:i32
};

t=$nsisconfig{
  installername:str;
  installdir:str;
  createdesktopicon:bool;
  createstartmenu:bool
};

version = "0.1.0";
bundleid = "dev.loke.app";

f=defaultconfig():$bundleconfig{
  let tmacarm = $buildtarget{
    name: "macos-arm64";
    os: "macos";
    arch: "arm64";
    outputname: "loke";
    stripdebug: true
  };
  let tmacx86 = $buildtarget{
    name: "macos-x86_64";
    os: "macos";
    arch: "x86_64";
    outputname: "loke-x86";
    stripdebug: true
  };
  let twin = $buildtarget{
    name: "windows-x86_64";
    os: "windows";
    arch: "x86_64";
    outputname: "loke.exe";
    stripdebug: true
  };
  <$bundleconfig{
    appname: "loke";
    version: version;
    bundleid: bundleid;
    targets: @(tmacarm; tmacx86; twin);
    includemodels: false;
    modelpaths: @()
  }
};

f=dmgconfig():$dmgconfig{
  <$dmgconfig{
    volumename: "loke";
    background: "static/dmg-bg.png";
    iconsize: 128;
    windowwidth: 600;
    windowheight: 400
  }
};

f=nsisconfig():$nsisconfig{
  <$nsisconfig{
    installername: "loke-setup.exe";
    installdir: "$PROGRAMFILES\loke";
    createdesktopicon: true;
    createstartmenu: true
  }
};

f=buildinfo():str{
  let cfg = defaultconfig();
  let line1 = "app:     " + cfg.appname + " v" + cfg.version;
  let line2 = "bundle:  " + cfg.bundleid;
  let line3 = "targets: macos-arm64  macos-x86_64  windows-x86_64";
  <line1 + "
" + line2 + "
" + line3
};

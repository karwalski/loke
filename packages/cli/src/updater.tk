m=cli.updater;

i=str:std.str;
i=t:shared.types;
i=file:std.file;
i=http:std.http;
i=json:std.json;
i=process:std.process;
i=log:shared.log;

(* Self-update for the loke binary (F10.23e).

   This module had never parsed. All twenty of its diagnostics came from three lines
   of one shape — `if(res.exitcode==0=false)`, and `=0=false` four more times — where
   `!=0` was meant. The parser gave up at the first and reported the rest of the file
   as unexpected tokens, which is why the error count looked like fifteen separate
   defects and was one.

   What the parse errors were hiding was most of the module. It imported `std.shell`,
   which does not exist, and called `sh.run(str)`, `fs.readtext`, `fs.writetext`,
   `http.getjson`, `http.download`, `str.getjsonstr`, `str.getjsonarr`,
   `str.splitfirst` and `str.trimprefix(a;b)` — of those, only str.trimprefix is real.
   Commands now go through std.process (spawn an argv, wait, read the pipes), which is
   what core.installer.install and core.monitoring.sysmon already do; files go through
   std.file; JSON through std.json.

   Overlap worth a decision, not resolved here: core.update.checker already polls the
   same GitHub releases endpoint, caches the answer in settings, and has its own
   version comparison. cli.updater adds download, checksum verification, binary
   replacement with rollback, and snooze. It has no callers. Collapsing the two is a
   backlog item; this module is left standing and compiling rather than half-merged. *)

t=$updateinfo{
  current:str;
  latest:str;
  downloadurl:str;
  releasenotes:str;
  isnewer:bool
};

t=$updateresult{
  ok:bool;
  message:str
};

t=$cmdresult{
  exitcode:i64;
  stdout:str;
  stderr:str
};

f=snoozekey():str{
  <"loke.updater.snooze_until"
};

f=snoozepath():str{
  <t.lokefile("updater_snooze")
};

f=releasesurl():str{
  <"https://api.github.com/repos/karwalski/loke/releases/latest"
};

f=snoozedurationsecs():i64{
  <86400
};

(* An argv, not a shell string: nothing here needs a shell, and spawning one would put
   a version tag and a file path through word splitting. *)
f=runcmd(argv:@str):$cmdresult{
  let h=mt process.spawn(argv) {
    $ok:handle handle;
    $err:e @()
  };
  if(!(h == @())){}el{
    <$cmdresult{ exitcode:127; stdout:""; stderr:"could not spawn command" }
  };
  let code=mt process.wait(h) {
    $ok:c (c as i64);
    $err:e 127
  };
  let out=mt process.stdout(h) {
    $ok:s s;
    $err:e ""
  };
  let err=mt process.stderr(h) {
    $ok:s s;
    $err:e ""
  };
  <$cmdresult{ exitcode:code; stdout:out; stderr:err }
};

f=uname(flag:str):str{
  <str.trim(runcmd(@("uname";flag)).stdout)
};

(* The release asset this platform wants. Named without a leading "as" because toke
   warns that an identifier starting with a keyword may have been meant as `as ...`. *)
f=platformasset():str{
  let osname=uname("-s");
  if(str.contains(osname;"Darwin")){
    if(str.contains(uname("-m");"arm64")){
      <"loke-macos-arm64"
    }el{
      <"loke-macos-x86_64"
    }
  }el{
    <"loke-windows-x86_64.exe"
  }
};

f=noupdate(currentversion:str):$updateinfo{
  <$updateinfo{
    current:currentversion;
    latest:currentversion;
    downloadurl:"";
    releasenotes:"";
    isnewer:false
  }
};

f=parserelease(currentversion:str;r:$httpresp):$updateinfo{
  if(!(r.status>199)){ <noupdate(currentversion) }el{};
  if(!(r.status<300)){ <noupdate(currentversion) }el{};
  let parsed=json.decode(r.body);
  let tag=json.str(parsed;"tag_name");
  let latest=str.trimprefix(tag;"v");
  let releasenotes=json.str(parsed;"body");
  let assets=json.getarray(parsed;"assets");
  let wanted=platformasset();
  let downloadurl=mut."";
  lp(let i=0;i<assets.len;i=i+1){
    let asset=str.arrayget(assets;i);
    if(str.contains(json.str(asset;"name");wanted)){
      downloadurl=json.str(asset;"browser_download_url")
    }el{}
  };
  <$updateinfo{
    current:currentversion;
    latest:latest;
    downloadurl:downloadurl;
    releasenotes:releasenotes;
    isnewer:versiongt(latest;currentversion)
  }
};

f=check(currentversion:str):$updateinfo{
  let resp=http.get(releasesurl();@(
    http.header("User-Agent";"loke-cli");
    http.header("Accept";"application/vnd.github+json")
  ));
  <mt resp {
    $ok:r parserelease(currentversion;r);
    $err:e noupdate(currentversion)
  }
};

(* Returns "" when there is nothing to download or the download failed. *)
f=download(info:$updateinfo;destdir:str):str{
  if(str.len(info.downloadurl)>0){}el{
    <""
  };
  let filename=str.concat("loke-";str.concat(info.latest;"-update"));
  let destpath=str.concat(destdir;str.concat("/";filename));
  let client=http.client(info.downloadurl);
  if(http.downloadfile(client;info.downloadurl;destpath)==0){
    <destpath
  }el{
    log.error(str.concat("update download failed: ";info.downloadurl);"cli.updater";"system");
    <""
  }
};

f=verifychecksum(binpath:str;expectedsha256:str):bool{
  let osname=uname("-s");
  let res=mut.runcmd(@("sha256sum";binpath));
  if(str.contains(osname;"Darwin")){
    res=runcmd(@("shasum";"-a";"256";binpath))
  }el{};
  if(!(res.exitcode==0)){
    log.error(str.concat("checksum command failed: ";res.stderr);"cli.updater";"system");
    <false
  }el{};
  let fields=str.fields(res.stdout);
  if(fields.len>0){}el{
    <false
  };
  <str.eq(fields.get(0);expectedsha256)
};

f=failed(message:str):$updateresult{
  log.error(message;"cli.updater";"system");
  <$updateresult{ ok:false; message:message }
};

f=apply(newbinpath:str;currentbinpath:str):$updateresult{
  let bakpath=str.concat(currentbinpath;".bak");
  let cpbak=runcmd(@("cp";currentbinpath;bakpath));
  if(!(cpbak.exitcode==0)){
    <failed(str.concat("backup failed: ";cpbak.stderr))
  }el{};
  let mvres=runcmd(@("mv";newbinpath;currentbinpath));
  if(!(mvres.exitcode==0)){
    let rollback=runcmd(@("mv";bakpath;currentbinpath));
    log.warn(str.concat("rollback exit code ";str.fromint(rollback.exitcode));"cli.updater";"system");
    <failed(str.concat("replace failed: ";mvres.stderr))
  }el{};
  let chmodres=runcmd(@("chmod";"+x";currentbinpath));
  if(!(chmodres.exitcode==0)){
    <failed(str.concat("chmod failed: ";chmodres.stderr))
  }el{};
  let smoke=runcmd(@(currentbinpath;"--version"));
  if(!(smoke.exitcode==0)){
    let rollback=runcmd(@("mv";bakpath;currentbinpath));
    log.warn(str.concat("rollback exit code ";str.fromint(rollback.exitcode));"cli.updater";"system");
    <failed("new binary failed smoke test — restored previous version")
  }el{};
  <$updateresult{
    ok:true;
    message:str.concat("updated successfully — backup at ";bakpath)
  }
};

f=nowsecs():i64{
  let out=str.trim(runcmd(@("date";"+%s")).stdout);
  if(str.len(out)>0){
    <str.toint(out)
  }el{
    <0
  }
};

(* True when the user should be shown the update prompt: there is a newer version and
   the snooze window has expired. Writing the next snooze deadline is a side effect of
   showing the prompt, so it only happens on the true path. *)
f=promptupdate(info:$updateinfo):bool{
  if(info.isnewer){}el{
    <false
  };
  let now=nowsecs();
  let snoozeraw=mt file.read(snoozepath()) {
    $ok:v v;
    $err:e ""
  };
  if(str.len(snoozeraw)>0){
    if(now<str.toint(str.trim(snoozeraw))){
      <false
    }el{}
  }el{};
  let nextsnooze=str.fromint(now+snoozedurationsecs());
  let wrote=mt file.write(snoozepath();nextsnooze) {
    $ok:v true;
    $err:e false
  };
  if(wrote){}el{
    log.warn(str.concat("could not record update snooze at ";snoozepath());"cli.updater";"system")
  };
  <true
};

(* a is strictly newer than b, comparing major.minor.patch. partor keeps a two-part
   version from reading off the end of the array. *)
f=versiongt(a:str;b:str):bool{
  let aparts=str.split(a;".");
  let bparts=str.split(b;".");
  let amajor=str.toint(partor(aparts;0;"0"));
  let bmajor=str.toint(partor(bparts;0;"0"));
  if(amajor>bmajor){ <true }el{};
  if(amajor<bmajor){ <false }el{};
  let aminor=str.toint(partor(aparts;1;"0"));
  let bminor=str.toint(partor(bparts;1;"0"));
  if(aminor>bminor){ <true }el{};
  if(aminor<bminor){ <false }el{};
  let apatch=str.toint(partor(aparts;2;"0"));
  let bpatch=str.toint(partor(bparts;2;"0"));
  <apatch>bpatch
};

f=partor(parts:@str;idx:i64;fallback:str):str{
  if(idx<parts.len){
    <parts.get(idx)
  }el{
    <fallback
  }
};

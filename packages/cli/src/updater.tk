



m=cli.updater;

i=fs:std.fs;
i=str:std.string;
i=http:std.http;
i=sh:std.shell;

t=$updateinfo{
  current:str;
  latest:str;
  downloadurl:str;
  releasenotes:str;
  isnewer:bool
};

t=$updateresult{
  ok:bool;
  message:str
};


let snoozekey="loke.updater.snooze_until";
let snoozepath="~/.loke/updater_snooze";
let releasesurl="https://api.github.com/repos/karwalski/loke/releases/latest";
let snoozedurationsecs=86400;

f=check(currentversion:str):$updateinfo{
  let resp=mt http.getjson(releasesurl) {
    $ok:v v;
    $err:e;
      <$updateinfo{
        current=currentversion;
        latest=currentversion;
        downloadurl="";
        releasenotes="";
        isnewer=false
      }
  };

  let latest=str.trimprefix(
    str.getjsonstr(resp;"tag_name");
    "v"
  );

  let releasenotes=str.getjsonstr(resp;"body");

  
  let osname=sh.run("uname -s").stdout;
  let archname=sh.run("uname -m").stdout;

  let assetsuffix=if(str.contains(osname;"Darwin")){
    if(str.contains(archname;"arm64")){
      "loke-macos-arm64"
    }el{
      "loke-macos-x86_64"
    }
  }el{
    "loke-windows-x86_64.exe"
  };

  let assets=str.getjsonarr(resp;"assets");
  let downloadurl="";
  let i=0;
  lp(let lv=0;true;lv=lv) i<str.len(assets){
    let asset=assets.get(i);
    let assetname=str.getjsonstr(asset;"name");
    if(str.contains(assetname;assetsuffix)){
      let downloadurl=str.getjsonstr(asset;"browser_download_url")
    };
    let i=i+1
  };

  let isnewer=versiongt(latest;currentversion);

  <$updateinfo{
    current=currentversion;
    latest=latest;
    downloadurl=downloadurl;
    releasenotes=releasenotes;
    isnewer=isnewer
  }
};

f=download(info:$updateinfo;destdir:str):str{
  let filename=str.concat("loke-";str.concat(info.latest;"-update"));
  let destpath=str.concat(destdir;str.concat("/";filename));

  mt http.download(info.downloadurl;destpath) {
    $ok: destpath;
    $err:e ""
  }
};

f=verifychecksum(binpath:str;expectedsha256:str):bool{
  
  let osname=sh.run("uname -s").stdout;
  let cmd=if(str.contains(osname;"Darwin")){
    str.concat("shasum -a 256 ";binpath)
  }el{
    str.concat("sha256sum ";binpath)
  };

  let res=sh.run(cmd);
  if(res.exitcode!=0){
    <false
  };

  
  let computed=str.splitfirst(str.trim(res.stdout);" ");
  <str.eq(computed;expectedsha256)
};

f=apply(newbinpath:str;currentbinpath:str):$updateresult{
  
  let bakpath=str.concat(currentbinpath;".bak");
  let cpbak=sh.run(str.concat("cp ";str.concat(currentbinpath;str.concat(" ";bakpath))));
  if(cpbak.exitcode!=0){
    <$updateresult{
      ok=false;
      message=str.concat("backup failed: ";cpbak.stderr)
    }
  };

  
  let mvres=sh.run(str.concat("mv ";str.concat(newbinpath;str.concat(" ";currentbinpath))));
  if(mvres.exitcode!=0){
    
    sh.run(str.concat("mv ";str.concat(bakpath;str.concat(" ";currentbinpath))));
    <$updateresult{
      ok=false;
      message=str.concat("replace failed: ";mvres.stderr)
    }
  };

  
  let chmodres=sh.run(str.concat("chmod +x ";currentbinpath));
  if(chmodres.exitcode!=0){
    <$updateresult{
      ok=false;
      message=str.concat("chmod failed: ";chmodres.stderr)
    }
  };

  
  let smoke=sh.run(str.concat(currentbinpath;" --version"));
  if(smoke.exitcode!=0){
    
    sh.run(str.concat("mv ";str.concat(bakpath;str.concat(" ";currentbinpath))));
    <$updateresult{
      ok=false;
      message="new binary failed smoke test — restored previous version"
    }
  };

  <$updateresult{
    ok=true;
    message=str.concat("updated successfully — backup at ";bakpath)
  }
};

f=promptupdate(info:$updateinfo):bool{
  if(!$info.isnewer){
    <false
  };

  
  let nowsecs=str.toint(sh.run("date +%s").stdout);
  let snoozeraw=mt fs.readtext(snoozepath) {
    $ok:v v;
    $err:e ""
  };
  if(str.len(snoozeraw)>0){
    let snoozeuntil=str.toint(str.trim(snoozeraw));
    if(nowsecs<snoozeuntil){
      <false
    }
  };

  
  let nextsnooze=str.fromint(nowsecs+snoozedurationsecs);
  fs.writetext(snoozepath;nextsnooze);

  <true
};





f=versiongt(a:str;b:str):bool{
  let aparts=str.split(a;".");
  let bparts=str.split(b;".");

  let amajor=str.toint(partor(aparts;0;"0"));
  let bmajor=str.toint(partor(bparts;0;"0"));
  if(amajor>bmajor){ <true };
  if(amajor<bmajor){ <false };

  let aminor=str.toint(partor(aparts;1;"0"));
  let bminor=str.toint(partor(bparts;1;"0"));
  if(aminor>bminor){ <true };
  if(aminor<bminor){ <false };

  let apatch=str.toint(partor(aparts;2;"0"));
  let bpatch=str.toint(partor(bparts;2;"0"));
  <apatch>bpatch
};

f=partor(parts:@str;idx:i32;fallback:str):str{
  if(idx<str.len(parts)){
    parts.get(idx)
  }el{
    fallback
  }
};

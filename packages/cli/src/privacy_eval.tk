m=cli.privacyeval;

i=str:std.str;
i=file:std.file;
i=out:cli.output;
(* For $lokeconfig, a type only. *)
i=cfg:shared.config;
i=pl:core.privacy.pipeline;
i=cmp:core.privacy.comparison;

(* F3b.9. `loke privacy evaluate`. The layers are the ones `loke ask` filters with: the
   registry at the user's Presidio and Ollama URLs, with the privacy-filter, consensus and
   [[privacy.layers]] settings of config.toml (core.privacy.pipeline.withlokeconfig). What is
   compared and how is core.privacy.comparison's; this only reads the file and prints.

   Exit 0 when at least one layer scanned and the layer config applies; 1 otherwise, after
   printing the report, so a script cannot take "nothing scanned" for "nothing found". *)

f=pipelinefor(config:$lokeconfig):$pipelineconfig{
  <pl.withlokeconfig(pl.newconfig(config.presidiourl;config.ollamaurl);config)
};

f=evaluatetext(text:str;showvalues:bool;config:$lokeconfig):i64{
  let c=cmp.compare(text;pipelinefor(config));
  out.printline(str.join("\n";cmp.reportlines(text;c;showvalues)));
  if(cmp.evaluated(c)){ <0 }el{};
  <1
};

f=evaluatefile(path:str;config:$lokeconfig):i64{
  let raw=mt file.read(path) { $ok:s s; $err:e "" };
  if(str.len(raw)==0){
    out.printerror("loke privacy evaluate: could not read \(path), or it is empty");
    <1
  }el{};
  let r=cmp.labelledreport(raw;pipelinefor(config));
  if(str.len(r.error)>0){
    out.printerror(r.error);
    <1
  }el{};
  out.printline(r.text);
  if(r.ok){ <0 }el{};
  <1
};

f=handle(kind:str;arg:str;showvalues:bool;config:$lokeconfig):i64{
  if(str.eq(kind;"privacyevaluatefile")){ <evaluatefile(arg;config) }el{};
  <evaluatetext(arg;showvalues;config)
};

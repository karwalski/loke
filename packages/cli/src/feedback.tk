m=cli.feedback;
i=rep:core.feedback.reporter;
i=str:std.str;
i=log:shared.log;
i=tr:loke.platform.i18n.translator;

f=run(args:@$str):i64{
  if(str.arraylen(args)<1){
    printusage();
    <0
  }el{
    let sub=args.get(0);
    if(str.eq(sub;"report")){
      <runreport()
    }el{
      if(str.eq(sub;"version")){
        <runversioncheck()
      }el{
        printusage();
        <1
      }
    }
  }
};

f=printusage():i64{
  log.info(tr.t("loke.cli.feedback.usage");"cli.feedback";"system");
  log.info(tr.t("loke.cli.feedback.usage_report");"cli.feedback";"system");
  log.info(tr.t("loke.cli.feedback.usage_version");"cli.feedback";"system");
  <0
};

f=runreport():i64{
  log.info(tr.t("loke.cli.feedback.issue_report");"cli.feedback";"system");
  log.info(tr.t("loke.cli.feedback.issue_type");"cli.feedback";"system");
  let report=rep.create("bug";"Issue title";"Description of the issue";"Steps to reproduce";"Expected behaviour";"Actual behaviour");
  let report=rep.markscanned(report);
  let json=rep.tojson(report);
  log.info(str.concat(tr.t("loke.cli.feedback.report_created");json);"cli.feedback";"system");
  <0
};

f=runversioncheck():i64{
  log.info(tr.t("loke.cli.feedback.checking_updates");"cli.feedback";"system");
  log.info(tr.t("loke.cli.feedback.current_version");"cli.feedback";"system");
  log.info(tr.t("loke.cli.feedback.channel");"cli.feedback";"system");
  log.info(tr.t("loke.cli.feedback.up_to_date");"cli.feedback";"system");
  <0
};

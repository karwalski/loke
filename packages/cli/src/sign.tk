



m=cli.sign;

i=fs:std.fs;
i=str:std.string;
i=sh:std.shell;

t=$signconfig{
  identity:str;
  teamid:str;
  entitlementspath:str;
  notarize:bool;
  appleid:str;
  apppassword:str
};

t=$signresult{
  ok:bool;
  stdout:str;
  stderr:str;
  notarizationid:str
};

f=signmacos(binpath:str;cfg:$signconfig):$signresult{
  let cmd=str.concat(
    "codesign --deep --force --options runtime --entitlements ";
    str.concat(
      cfg.entitlementspath;
      str.concat(
        " --sign ";
        str.concat(cfg.identity;str.concat(" ";binpath))
      )
    )
  );
  let res=sh.run(cmd);
  let ok=res.exitcode=0;
  <$signresult{
    ok=ok;
    stdout=res.stdout;
    stderr=res.stderr;
    notarizationid=""
  }
};

f=notarizemacos(binpath:str;cfg:$signconfig):$signresult{
  
  let zippath=str.concat(binpath;".zip");
  let zipcmd=str.concat(
    "ditto -c -k --keepParent ";
    str.concat(binpath;str.concat(" ";zippath))
  );
  let zipres=sh.run(zipcmd);
  if(zipres.exitcode!=0){
    <$signresult{
      ok=false;
      stdout=zipres.stdout;
      stderr=zipres.stderr;
      notarizationid=""
    }
  };

  
  let submitcmd=str.concat(
    "xcrun notarytool submit ";
    str.concat(
      zippath;
      str.concat(
        " --apple-id ";
        str.concat(
          cfg.appleid;
          str.concat(
            " --password ";
            str.concat(
              cfg.apppassword;
              str.concat(
                " --team-id ";
                str.concat(cfg.teamid;" --wait --output-format json")
              )
            )
          )
        )
      )
    )
  );
  let subres=sh.run(submitcmd);
  if(subres.exitcode!=0){
    <$signresult{
      ok=false;
      stdout=subres.stdout;
      stderr=subres.stderr;
      notarizationid=""
    }
  };

  
  let notarizationid=str.extractbetween(subres.stdout;"\"id\":\"";"\",");

  
  let approved=str.contains(subres.stdout;"\"status\":\"Accepted\"");
  if(!$approved){
    <$signresult{
      ok=false;
      stdout=subres.stdout;
      stderr=subres.stderr;
      notarizationid=notarizationid
    }
  };

  
  let staplecmd=str.concat("xcrun stapler staple ";binpath);
  let stapleres=sh.run(staplecmd);
  <$signresult{
    ok=stapleres.exitcode=0;
    stdout=stapleres.stdout;
    stderr=stapleres.stderr;
    notarizationid=notarizationid
  }
};

f=verifymacos(binpath:str):bool{
  let cmd=str.concat("codesign --verify --deep --strict ";binpath);
  let res=sh.run(cmd);
  <res.exitcode=0
};

f=signwindows(binpath:str;certpath:str;certpass:str):$signresult{
  let cmd=str.concat(
    "signtool sign /f ";
    str.concat(
      certpath;
      str.concat(
        " /p ";
        str.concat(
          certpass;
          str.concat(
            " /fd sha256 /tr http://timestamp.digicert.com /td sha256 ";
            binpath
          )
        )
      )
    )
  );
  let res=sh.run(cmd);
  <$signresult{
    ok=res.exitcode=0;
    stdout=res.stdout;
    stderr=res.stderr;
    notarizationid=""
  }
};

f=defaultentitlements():str{
  <"<?xml version=\"1.0\" encoding=\"UTF-8\"?>
" +
   "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
" +
   "<plist version=\"1.0\">
" +
   "<dict>
" +
   "  <key>com.apple.security.cs.allow-jit</key>
" +
   "  <false/>
" +
   "  <key>com.apple.security.network.client</key>
" +
   "  <true/>
" +
   "</dict>
" +
   "</plist>
"
};

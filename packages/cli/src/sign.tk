m=cli.sign;

i=str:std.str;
i=process:std.process;
i=ty:shared.types;
i=log:shared.log;

(* std.shell does not exist, and neither does str.extractbetween. Commands run as an
   argv through std.process — which also removes the shell quoting problem this module
   had by construction: an Apple ID, an app password and a signing identity were being
   pasted into one command string, so any space or quote in a credential would have
   split the command. The notarisation id comes out of shared.types.strbetween.

   The unused std.fs import went with them: std.fs declares nothing at all. *)
t=$signconfig{
  identity:str;
  teamid:str;
  entitlementspath:str;
  notarize:bool;
  appleid:str;
  apppassword:str
};

t=$signresult{
  ok:bool;
  stdout:str;
  stderr:str;
  notarizationid:str
};

t=$cmdresult{
  exitcode:i64;
  stdout:str;
  stderr:str
};

f=runcmd(argv:@str):$cmdresult{
  (* 0 is the NULL handle: a spawn that fails is seen here. The check was `h == @()`, which
     an array == (an address compare) never satisfies (F10.44). *)
  let h=mt process.spawn(argv) {
    $ok:handle handle;
    $err:e 0
  };
  if(h==0){
    log.error("could not spawn signing tool";"cli.sign";"system");
    <$cmdresult{ exitcode:127; stdout:""; stderr:"could not spawn command" }
  }el{};
  let out=mt process.stdout(h) {
    $ok:o o;
    $err:e ""
  };
  let err=mt process.stderr(h) {
    $ok:o o;
    $err:e ""
  };
  let code=process.wait(h) as i64;
  <$cmdresult{ exitcode:code; stdout:out; stderr:err }
};

f=signmacos(binpath:str;cfg:$signconfig):$signresult{
  let res=runcmd(@(
    "codesign";"--deep";"--force";"--options";"runtime";
    "--entitlements";cfg.entitlementspath;
    "--sign";cfg.identity;binpath
  ));
  <$signresult{
    ok:res.exitcode==0;
    stdout:res.stdout;
    stderr:res.stderr;
    notarizationid:""
  }
};

f=notarizemacos(binpath:str;cfg:$signconfig):$signresult{
  let zippath=str.concat(binpath;".zip");
  let zipres=runcmd(@("ditto";"-c";"-k";"--keepParent";binpath;zippath));
  if(!(zipres.exitcode==0)){
    <$signresult{
      ok:false;
      stdout:zipres.stdout;
      stderr:zipres.stderr;
      notarizationid:""
    }
  }el{};
  let subres=runcmd(@(
    "xcrun";"notarytool";"submit";zippath;
    "--apple-id";cfg.appleid;
    "--password";cfg.apppassword;
    "--team-id";cfg.teamid;
    "--wait";"--output-format";"json"
  ));
  if(!(subres.exitcode==0)){
    <$signresult{
      ok:false;
      stdout:subres.stdout;
      stderr:subres.stderr;
      notarizationid:""
    }
  }el{};
  let notarizationid=ty.strbetween(subres.stdout;"\"id\":\"";"\",");
  if(str.contains(subres.stdout;"\"status\":\"Accepted\"")){}el{
    <$signresult{
      ok:false;
      stdout:subres.stdout;
      stderr:subres.stderr;
      notarizationid:notarizationid
    }
  };
  let stapleres=runcmd(@("xcrun";"stapler";"staple";binpath));
  <$signresult{
    ok:stapleres.exitcode==0;
    stdout:stapleres.stdout;
    stderr:stapleres.stderr;
    notarizationid:notarizationid
  }
};

f=verifymacos(binpath:str):bool{
  <runcmd(@("codesign";"--verify";"--deep";"--strict";binpath)).exitcode==0
};

f=signwindows(binpath:str;certpath:str;certpass:str):$signresult{
  let res=runcmd(@(
    "signtool";"sign";"/f";certpath;"/p";certpass;
    "/fd";"sha256";"/tr";"http://timestamp.digicert.com";"/td";"sha256";binpath
  ));
  <$signresult{
    ok:res.exitcode==0;
    stdout:res.stdout;
    stderr:res.stderr;
    notarizationid:""
  }
};

f=defaultentitlements():str{
  let s=mut."<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
  s=str.concat(s;"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n");
  s=str.concat(s;"<plist version=\"1.0\">\n");
  s=str.concat(s;"<dict>\n");
  s=str.concat(s;"  <key>com.apple.security.cs.allow-jit</key>\n");
  s=str.concat(s;"  <false/>\n");
  s=str.concat(s;"  <key>com.apple.security.network.client</key>\n");
  s=str.concat(s;"  <true/>\n");
  s=str.concat(s;"</dict>\n");
  s=str.concat(s;"</plist>\n");
  <s
};

m=cli.doctor;

i=t:shared.types;
i=out:cli.output;
i=reach:shared.reachability;
i=str:std.str;
i=file:std.file;

t=$check{
  name:str;
  ok:bool;
  detail:str;
  fix:str
};

(* VM1.6h. Each check matched the one-argument `http.get`, which answers the response BODY,
   and read `.status` off it as if it were a response struct. Measured against
   scripts/lib/http_recorder.py: the GET arrived, and an answering Ollama was reported as
   "unexpected status: 8317134093887021691", which is the bytes `{"models` read as an
   integer. So every service that answered was reported as failing. No status is visible
   through that call, so a check reads the body: something must answer, and where the
   service's answer has a known shape (`expect`), it must be that shape.

   The probe comes first (shared.reachability), so "nothing listening" and "answered
   nothing" are reported apart. A URL off this machine is not checked: these are local
   sidecars, and toke's https client verifies no certificate (T-58). *)
f=checkservice(name:str;baseurl:str;path:str;expect:str;fix:str):$check{
  if(!reach.isloopbackurl(baseurl)){
    <$check{ name:name; ok:false; detail:"not checked: \(baseurl) is not on this machine"; fix:fix }
  }el{};
  if(!reach.localserviceup(baseurl)){
    <$check{ name:name; ok:false; detail:"not reachable at \(baseurl)"; fix:fix }
  }el{};
  let body=reach.localget(baseurl;path);
  if(str.len(body)==0){
    <$check{ name:name; ok:false; detail:"no answer from \(baseurl)\(path)"; fix:fix }
  }el{};
  if(str.len(expect)>0 && !str.contains(body;expect)){
    <$check{ name:name; ok:false; detail:"\(baseurl)\(path) answered, but not as \(name) does"; fix:fix }
  }el{};
  <$check{ name:name; ok:true; detail:"running at \(baseurl)"; fix:"" }
};

f=checkollamaat(baseurl:str):$check{
  <checkservice("Ollama";baseurl;"/api/tags";"\"models\"";"Run: ollama serve")
};

f=checkollama():$check{
  <checkollamaat("http://localhost:11434")
};

f=checkpresidioat(baseurl:str):$check{
  <checkservice("Presidio";baseurl;"/health";"";"Run: docker run -p 5001:3000 mcr.microsoft.com/presidio-analyzer")
};

f=checkpresidio():$check{
  <checkpresidioat("http://localhost:5001")
};

f=checkllmlinguaat(baseurl:str):$check{
  <checkservice("LLMLingua";baseurl;"/health";"";"Run: pip install llmlingua && python -m llmlingua.server")
};

f=checkllmlingua():$check{
  <checkllmlinguaat("http://localhost:8000")
};

f=checkdatadir():$check{
  let exists=mt file.exists(t.lokedir()) {
    $ok:v v;
    $err:e false
  };
  if(exists){
    <$check{ name:"Data dir"; ok:true; detail:"~/.loke/ exists"; fix:"" }
  }el{
    <$check{ name:"Data dir"; ok:false; detail:"~/.loke/ not found"; fix:"Run: loke init" }
  }
};

f=checkconfig():$check{
  let exists=mt file.exists(t.configpath()) {
    $ok:v v;
    $err:e false
  };
  if(exists){
    <$check{ name:"Config"; ok:true; detail:"~/.loke/config.toml exists"; fix:"" }
  }el{
    <$check{ name:"Config"; ok:false; detail:"~/.loke/config.toml not found"; fix:"Run: loke init" }
  }
};

f=runall():@$check{
  let ollama=checkollama();
  let presidio=checkpresidio();
  let llmlingua=checkllmlingua();
  let datadir=checkdatadir();
  let config=checkconfig();
  <@(ollama;presidio;llmlingua;datadir;config)
};

f=formatreport(checks:@$check):str{
  (* The array's length. `str.len(checks)` measured the array's address as a C string
     (E4031 in toke 3.1.0), so the count was whatever that came to. F10.39. *)
  let total=checks.len as i64;
  let passed=mut.0;
  let i=mut.0;
  let report=mut."";
  lp(let lv=0;true;lv=lv){
    if(!(i<total)){ br }el{
      let c=checks.get(i);
      let icon=mut."x";
      if(c.ok){ icon="+" }el{};
      let line="\(icon) \(c.name): \(c.detail)
";
      report=str.concat(report;line);
      if(c.ok){
        passed=passed+1
      }el{};
      if(!c.ok){
        if(str.len(c.fix)>0){
          let fixline="    fix: \(c.fix)
";
          report=str.concat(report;fixline)
        }el{}
      }el{};
      i=i+1
    };
  };
  let summary="\(str.fromint(passed))/\(str.fromint(total)) checks passed
";
  <str.concat(report;summary)
};

f=run():i64{
  let checks=runall();
  let report=formatreport(checks);
  out.printline(report);
  (* The array's length. `str.len(checks)` measured the array's address as a C string
     (E4031 in toke 3.1.0), so the count was whatever that came to. F10.39. *)
  let total=checks.len as i64;
  let passed=mut.0;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(i<total)){ br }el{
      let c=checks.get(i);
      if(c.ok){
        passed=passed+1
      }el{};
      i=i+1
    };
  };
  if(passed==total){
    <0
  }el{
    <1
  }
};

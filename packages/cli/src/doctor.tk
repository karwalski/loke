m=cli.doctor;

i=t:shared.types;
i=out:cli.output;
i=http:std.http;
i=str:std.str;
i=log:shared.log;
i=file:std.file;

t=$check{
  name:str;
  ok:bool;
  detail:str;
  fix:str
};

f=checkollama():$check{
  let result=mt http.get("http://localhost:11434/api/tags") {
    $ok:resp mt resp.status { 200 $check{ name:"Ollama"; ok:true; detail:"running at http://localhost:11434"; fix:"" }; $default $check{ name:"Ollama"; ok:false; detail:str.concat("unexpected status: ";str.inttostr(resp.status)); fix:"Run: ollama serve" } };
    $err:e $check{ name:"Ollama"; ok:false; detail:"not reachable"; fix:"Run: ollama serve" }
  };
  <result
};

f=checkpresidio():$check{
  let result=mt http.get("http://localhost:5001/health") {
    $ok:resp mt resp.status { 200 $check{ name:"Presidio"; ok:true; detail:"running at http://localhost:5001"; fix:"" }; $default $check{ name:"Presidio"; ok:false; detail:str.concat("unexpected status: ";str.inttostr(resp.status)); fix:"Run: docker run -p 5001:3000 mcr.microsoft.com/presidio-analyzer" } };
    $err:e $check{ name:"Presidio"; ok:false; detail:"not reachable"; fix:"Run: docker run -p 5001:3000 mcr.microsoft.com/presidio-analyzer" }
  };
  <result
};

f=checkllmlingua():$check{
  let result=mt http.get("http://localhost:8000/health") {
    $ok:resp mt resp.status { 200 $check{ name:"LLMLingua"; ok:true; detail:"running at http://localhost:8000"; fix:"" }; $default $check{ name:"LLMLingua"; ok:false; detail:str.concat("unexpected status: ";str.inttostr(resp.status)); fix:"Run: pip install llmlingua && python -m llmlingua.server" } };
    $err:e $check{ name:"LLMLingua"; ok:false; detail:"not reachable"; fix:"Run: pip install llmlingua && python -m llmlingua.server" }
  };
  <result
};

f=checkdatadir():$check{
  let exists=mt file.exists("~/.loke") {
    $ok:v v;
    $err:e false
  };
  if(exists){
    <$check{ name:"Data dir"; ok:true; detail:"~/.loke/ exists"; fix:"" }
  }el{
    <$check{ name:"Data dir"; ok:false; detail:"~/.loke/ not found"; fix:"Run: loke init" }
  }
};

f=checkconfig():$check{
  let exists=mt file.exists("~/.loke/config.toml") {
    $ok:v v;
    $err:e false
  };
  if(exists){
    <$check{ name:"Config"; ok:true; detail:"~/.loke/config.toml exists"; fix:"" }
  }el{
    <$check{ name:"Config"; ok:false; detail:"~/.loke/config.toml not found"; fix:"Run: loke init" }
  }
};

f=runall():@$check{
  let ollama=checkollama();
  let presidio=checkpresidio();
  let llmlingua=checkllmlingua();
  let datadir=checkdatadir();
  let config=checkconfig();
  <@(ollama;presidio;llmlingua;datadir;config)
};

f=formatreport(checks:@$check):str{
  let total=str.len(checks);
  let passed=mut.0;
  let i=mut.0;
  let report=mut."";
  lp(let lv=0;true;lv=lv){
    if(i>=total){ break }el{
      let c=checks.get(i);
      let icon=if(c.ok){ "+" }el{ "x" };
      let line=str.concat(
        icon;
        str.concat(
          " ";
          str.concat(
            c.name;
            str.concat(
              ": ";
              str.concat(c.detail;"
")
            )
          )
        )
      );
      report=str.concat(report;line);
      if(c.ok){
        passed=passed+1
      }el{};
      if(!c.ok){
        if(str.len(c.fix)>0){
          let fixline=str.concat("    fix: ";str.concat(c.fix;"
"));
          report=str.concat(report;fixline)
        }el{}
      }el{};
      i=i+1
    };
  };
  let summary=str.concat(
    str.inttostr(passed);
    str.concat(
      "/";
      str.concat(
        str.inttostr(total);
        " checks passed
"
      )
    )
  );
  <str.concat(report;summary)
};

f=run():i32{
  let checks=runall();
  let report=formatreport(checks);
  out.printline(report);
  let total=str.len(checks);
  let passed=mut.0;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i>=total){ break }el{
      let c=checks.get(i);
      if(c.ok){
        passed=passed+1
      }el{};
      i=i+1
    };
  };
  if(passed=total){
    <0
  }el{
    <1
  }
};

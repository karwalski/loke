m=cli.commands;


i=str:std.str;

t=$command{
  $ask(str);
  $pipeline(str);
  $queuelist:i64;
  $queuecancel(str);
  $modelslist:i64;
  $modelsrecommend:i64;
  $memorysearch(str);
  $agentslist:i64;
  $overnightstatus:i64;
  $doctor:i64;
  $version:i64;
  $help:i64;
  $unknown(str)
};

f=parse(args:@str):$command{
  let argc=str.len(args);
  if(argc<2){
    <$$help
  };
  let sub=args.get(1);
  if(str.eq(sub;"--version")){
    <$$version
  };
  if(str.eq(sub;"help")){
    <$$help
  };
  if(str.eq(sub;"doctor")){
    <$$doctor
  };
  if(str.eq(sub;"ask")){
    if(argc<3){
      <$$unknown("usage: loke ask \"<prompt>\"")
    };
    <$$ask(args.get(2))
  };
  if(str.eq(sub;"pipeline")){
    if(argc<3){
      <$$unknown("usage: loke pipeline \"<prompt>\"")
    };
    <$$pipeline(args.get(2))
  };
  if(str.eq(sub;"queue")){
    if(argc<3){
      <$$unknown("usage: loke queue <list|cancel <id>>")
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$$queuelist
    };
    if(str.eq(action;"cancel")){
      if(argc<4){
        <$$unknown("usage: loke queue cancel <id>")
      };
      <$$queuecancel(args.get(3))
    };
    <$$unknown(str.concat("unknown queue action: ";action))
  };
  if(str.eq(sub;"models")){
    if(argc<3){
      <$$unknown("usage: loke models <list|recommend>")
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$$modelslist
    };
    if(str.eq(action;"recommend")){
      <$$modelsrecommend
    };
    <$$unknown(str.concat("unknown models action: ";action))
  };
  if(str.eq(sub;"memory")){
    if(argc<3){
      <$$unknown("usage: loke memory search \"<query>\"")
    };
    let action=args.get(2);
    if(str.eq(action;"search")){
      if(argc<4){
        <$$unknown("usage: loke memory search \"<query>\"")
      };
      <$$memorysearch(args.get(3))
    };
    <$$unknown(str.concat("unknown memory action: ";action))
  };
  if(str.eq(sub;"agents")){
    if(argc<3){
      <$$unknown("usage: loke agents <list>")
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$$agentslist
    };
    <$$unknown(str.concat("unknown agents action: ";action))
  };
  if(str.eq(sub;"overnight")){
    if(argc<3){
      <$$unknown("usage: loke overnight <status>")
    };
    let action=args.get(2);
    if(str.eq(action;"status")){
      <$$overnightstatus
    };
    <$$unknown(str.concat("unknown overnight action: ";action))
  };
  <$$unknown(str.concat("unknown command: ";sub))
};

f=usage():str{
  <str.concat(
    "loke — local-first privacy proxy for LLM traffic
";
    str.concat(
      "
";
      str.concat(
        "Usage:
";
        str.concat(
          "  loke ask \"<prompt>\"           send a prompt through the privacy pipeline
";
          str.concat(
            "  loke pipeline \"<prompt>\"      show pipeline stages for a prompt
";
            str.concat(
              "  loke queue list                list queued background jobs
";
              str.concat(
                "  loke queue cancel <id>         cancel a queued job by id
";
                str.concat(
                  "  loke models list               list available local models
";
                  str.concat(
                    "  loke models recommend          recommend models for your hardware
";
                    str.concat(
                      "  loke memory search \"<query>\"   search memory palace
";
                      str.concat(
                        "  loke agents list               list registered agents
";
                        str.concat(
                          "  loke overnight status          show overnight job status
";
                          str.concat(
                            "  loke doctor                    run health check on all subsystems
";
                            str.concat(
                              "  loke --version                 print version
";
                              "  loke help                      show this help
"
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
};

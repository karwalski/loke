m=cli.commands;


i=str:std.str;

t=$command{
  kind:str;
  arg:str
};

f=parse(args:@str):$command{
  let argc=args.len;
  if(argc<2){
    <$command{kind:"help";arg:""}
  };
  let sub=args.get(1);
  if(str.eq(sub;"--version")){
    <$command{kind:"version";arg:""}
  };
  if(str.eq(sub;"help")){
    <$command{kind:"help";arg:""}
  };
  if(str.eq(sub;"doctor")){
    <$command{kind:"doctor";arg:""}
  };
  if(str.eq(sub;"ask")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke ask \"<prompt>\""}
    };
    <$command{kind:"ask";arg:args.get(2)}
  };
  if(str.eq(sub;"pipeline")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke pipeline \"<prompt>\""}
    };
    <$command{kind:"pipeline";arg:args.get(2)}
  };
  if(str.eq(sub;"queue")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke queue <list|cancel <id>>"}
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$command{kind:"queuelist";arg:""}
    };
    if(str.eq(action;"cancel")){
      if(argc<4){
        <$command{kind:"unknown";arg:"usage: loke queue cancel <id>"}
      };
      <$command{kind:"queuecancel";arg:args.get(3)}
    };
    <$command{kind:"unknown";arg:str.concat("unknown queue action: ";action)}
  };
  if(str.eq(sub;"models")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke models <list|recommend>"}
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$command{kind:"modelslist";arg:""}
    };
    if(str.eq(action;"recommend")){
      <$command{kind:"modelsrecommend";arg:""}
    };
    <$command{kind:"unknown";arg:str.concat("unknown models action: ";action)}
  };
  if(str.eq(sub;"memory")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke memory search \"<query>\""}
    };
    let action=args.get(2);
    if(str.eq(action;"search")){
      if(argc<4){
        <$command{kind:"unknown";arg:"usage: loke memory search \"<query>\""}
      };
      <$command{kind:"memorysearch";arg:args.get(3)}
    };
    <$command{kind:"unknown";arg:str.concat("unknown memory action: ";action)}
  };
  if(str.eq(sub;"agents")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke agents <list>"}
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$command{kind:"agentslist";arg:""}
    };
    <$command{kind:"unknown";arg:str.concat("unknown agents action: ";action)}
  };
  if(str.eq(sub;"overnight")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke overnight <status>"}
    };
    let action=args.get(2);
    if(str.eq(action;"status")){
      <$command{kind:"overnightstatus";arg:""}
    };
    <$command{kind:"unknown";arg:str.concat("unknown overnight action: ";action)}
  };
  <$command{kind:"unknown";arg:str.concat("unknown command: ";sub)}
};

f=usage():str{
  let u=mut."loke — local-first privacy proxy for LLM traffic\n";
  u=str.concat(u;"\nUsage:\n");
  u=str.concat(u;"  loke ask \"<prompt>\"           send a prompt through the privacy pipeline\n");
  u=str.concat(u;"  loke pipeline \"<prompt>\"      show pipeline stages for a prompt\n");
  u=str.concat(u;"  loke queue list                list queued background jobs\n");
  u=str.concat(u;"  loke queue cancel <id>         cancel a queued job by id\n");
  u=str.concat(u;"  loke models list               list available local models\n");
  u=str.concat(u;"  loke models recommend          recommend models for your hardware\n");
  u=str.concat(u;"  loke memory search \"<query>\"   search memory palace\n");
  u=str.concat(u;"  loke agents list               list registered agents\n");
  u=str.concat(u;"  loke overnight status          show overnight job status\n");
  u=str.concat(u;"  loke doctor                    run health check on all subsystems\n");
  u=str.concat(u;"  loke --version                 print version\n");
  u=str.concat(u;"  loke help                      show this help\n");
  <u
};

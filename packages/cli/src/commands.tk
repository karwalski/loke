m=cli.commands;


i=str:std.str;

t=$command{
  kind:str;
  arg:str
};

f=parse(args:@str):$command{
  let argc=args.len;
  if(argc<2){
    <$command{kind:"help";arg:""}
  };
  let sub=args.get(1);
  if(str.eq(sub;"--version")){
    <$command{kind:"version";arg:""}
  };
  if(str.eq(sub;"help")){
    <$command{kind:"help";arg:""}
  };
  if(str.eq(sub;"doctor")){
    <$command{kind:"doctor";arg:""}
  };
  if(str.eq(sub;"ask")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke ask \"<prompt>\""}
    };
    <$command{kind:"ask";arg:args.get(2)}
  };
  if(str.eq(sub;"pipeline")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke pipeline \"<prompt>\""}
    };
    <$command{kind:"pipeline";arg:args.get(2)}
  };
  if(str.eq(sub;"queue")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke queue <list|cancel <id>>"}
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$command{kind:"queuelist";arg:""}
    };
    if(str.eq(action;"cancel")){
      if(argc<4){
        <$command{kind:"unknown";arg:"usage: loke queue cancel <id>"}
      };
      <$command{kind:"queuecancel";arg:args.get(3)}
    };
    <$command{kind:"unknown";arg:str.concat("unknown queue action: ";action)}
  };
  if(str.eq(sub;"models")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke models <list|recommend>"}
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$command{kind:"modelslist";arg:""}
    };
    if(str.eq(action;"recommend")){
      <$command{kind:"modelsrecommend";arg:""}
    };
    <$command{kind:"unknown";arg:str.concat("unknown models action: ";action)}
  };
  if(str.eq(sub;"memory")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke memory search \"<query>\""}
    };
    let action=args.get(2);
    if(str.eq(action;"search")){
      if(argc<4){
        <$command{kind:"unknown";arg:"usage: loke memory search \"<query>\""}
      };
      <$command{kind:"memorysearch";arg:args.get(3)}
    };
    <$command{kind:"unknown";arg:str.concat("unknown memory action: ";action)}
  };
  if(str.eq(sub;"agents")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke agents <list>"}
    };
    let action=args.get(2);
    if(str.eq(action;"list")){
      <$command{kind:"agentslist";arg:""}
    };
    <$command{kind:"unknown";arg:str.concat("unknown agents action: ";action)}
  };
  if(str.eq(sub;"overnight")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke overnight <status>"}
    };
    let action=args.get(2);
    if(str.eq(action;"status")){
      <$command{kind:"overnightstatus";arg:""}
    };
    <$command{kind:"unknown";arg:str.concat("unknown overnight action: ";action)}
  };
  (* X8.4. Irreversible, so it takes two words that cannot be typed by accident: without
     --yes the command only says what it would erase. *)
  if(str.eq(sub;"erase")){
    if(argc<3){
      <$command{kind:"unknown";arg:"usage: loke erase --everything [--yes]"}
    };
    if(!str.eq(args.get(2);"--everything") || argc>4){
      <$command{kind:"unknown";arg:"usage: loke erase --everything [--yes]"}
    };
    if(argc==4){
      if(str.eq(args.get(3);"--yes")){
        <$command{kind:"erase";arg:""}
      };
      <$command{kind:"unknown";arg:"usage: loke erase --everything [--yes]"}
    };
    <$command{kind:"erasepreview";arg:""}
  };
  if(str.eq(sub;"kill-switch")){
    <parsekillswitch(args)
  };
  (* DA1.10. Verifies the audit hash chain, which now covers the disclosure record, and
     reconciles disclosure_log against the llm_dispatch audit rows both ways (spec G2). *)
  if(str.eq(sub;"audit")){
    if(argc==3 && str.eq(args.get(2);"verify")){
      <$command{kind:"auditverify";arg:""}
    };
    <$command{kind:"unknown";arg:"usage: loke audit verify"}
  };
  if(str.eq(sub;"benchmark")){
    <parsebenchmark(args)
  };
  if(str.eq(sub;"privacy")){
    <parseprivacy(args)
  };
  <$command{kind:"unknown";arg:str.concat("unknown command: ";sub)}
};

(* G1.6. `loke kill-switch <on|off> [--use-case <id> | --agent <id> | --provider <name>]`
   and `loke kill-switch status`. The kind carries the action and the scope
   ("killswitch.on.use_case") and arg the target, "" for the global switch. The scope's
   target is validated by core.governance.killswitch when the switch is changed, not here. *)
f=killswitchusage():str{
  <"usage: loke kill-switch <on|off> [--use-case <id> | --agent <id> | --provider <name>] | loke kill-switch status"
};

f=killswitchscope(flag:str):str{
  if(str.eq(flag;"--use-case")){ <"use_case" };
  if(str.eq(flag;"--agent")){ <"agent" };
  if(str.eq(flag;"--provider")){ <"provider" };
  <""
};

f=parsekillswitch(args:@str):$command{
  let argc=args.len;
  if(argc<3){
    <$command{kind:"unknown";arg:killswitchusage()}
  };
  let action=args.get(2);
  if(str.eq(action;"status")){
    if(argc!=3){
      <$command{kind:"unknown";arg:killswitchusage()}
    };
    <$command{kind:"killswitch.status";arg:""}
  };
  if(!str.eq(action;"on") && !str.eq(action;"off")){
    <$command{kind:"unknown";arg:killswitchusage()}
  };
  if(argc==3){
    <$command{kind:"killswitch.\(action).global";arg:""}
  };
  if(argc!=5){
    <$command{kind:"unknown";arg:killswitchusage()}
  };
  let scope=killswitchscope(args.get(3));
  if(str.len(scope)==0 || str.len(args.get(4))==0){
    <$command{kind:"unknown";arg:killswitchusage()}
  };
  <$command{kind:"killswitch.\(action).\(scope)";arg:args.get(4)}
};

(* VM1.6, VM1.3. `loke benchmark <local-model> [--runs <n>] [--out <path>]`, the two flags
   in either order and each at most once. --runs must be a plain positive integer here; its
   range (three to eight) is core.eval.bench's to enforce, which says why. *)
f=benchmarkusage():str{
  <"usage: loke benchmark <local-model> [--runs <3-8>] [--out <path>]"
};

f=isplaincount(v:str):bool{
  let n=str.toint(v);
  <n>0 && str.eq(str.fromint(n);v)
};

f=parsebenchmark(args:@str):$command{
  let argc=args.len;
  let bad=$command{kind:"unknown";arg:benchmarkusage()};
  if(argc<3 || argc>7 || (argc-3)%2!=0){ <bad }el{};
  let seenout=mut.false;
  let seenruns=mut.false;
  lp(let k=3;k<argc;k=k+2){
    let flag=args.get(k);
    if(str.eq(flag;"--out")){
      if(seenout || str.len(args.get(k+1))==0){ <bad }el{};
      seenout=true
    }el{
      if(str.eq(flag;"--runs")){
        if(seenruns || !isplaincount(args.get(k+1))){ <bad }el{};
        seenruns=true
      }el{
        <bad
      }
    }
  };
  <$command{kind:"benchmark";arg:args.get(2)}
};

(* The value after `flag`, or "". $command carries one argument, and parsebenchmark has
   already refused every malformed form, so these only read. *)
f=benchmarkflag(args:@str;flag:str):str{
  let found=mut."";
  lp(let k=3;k+1<args.len;k=k+2){
    if(str.eq(args.get(k);flag)){ found=args.get(k+1) }el{}
  };
  <found
};

(* The --out path, or "" for the default. *)
f=benchmarkout(args:@str):str{
  <benchmarkflag(args;"--out")
};

(* The --runs count, or 0 for core.eval.bench's default. *)
f=benchmarkruns(args:@str):i64{
  let v=benchmarkflag(args;"--runs");
  if(str.len(v)==0){ <0 }el{};
  <str.toint(v)
};

(* F3b.9. `loke privacy evaluate "<text>" [--show-values]` and `loke privacy evaluate --file
   <labelled.jsonl>`. --show-values may come before or after the text; without it no detected
   value is printed. The labelled report never prints a value, so it takes no flag. *)
f=privacyusage():str{
  <"usage: loke privacy evaluate \"<text>\" [--show-values] | loke privacy evaluate --file <labelled.jsonl>"
};

f=parseprivacy(args:@str):$command{
  let argc=args.len;
  let bad=$command{kind:"unknown";arg:privacyusage()};
  if(argc<4 || !str.eq(args.get(2);"evaluate")){ <bad }el{};
  if(str.eq(args.get(3);"--file")){
    if(argc!=5 || str.len(args.get(4))==0){ <bad }el{};
    <$command{kind:"privacyevaluatefile";arg:args.get(4)}
  }el{};
  if(argc>5){ <bad }el{};
  let text=mut."";
  let seen=mut.0;
  lp(let k=3;k<argc;k=k+1){
    let a=args.get(k);
    if(str.eq(a;"--show-values")){}el{
      text=a;
      seen=seen+1
    }
  };
  if(seen!=1 || argc-3-seen>1 || str.len(text)==0 || str.eq(text;"--file")){ <bad }el{};
  <$command{kind:"privacyevaluate";arg:text}
};

(* Whether --show-values was given to `loke privacy evaluate`. *)
f=showvalues(args:@str):bool{
  let found=mut.false;
  lp(let k=3;k<args.len;k=k+1){
    if(str.eq(args.get(k);"--show-values")){ found=true }el{}
  };
  <found
};

f=usage():str{
  let u=mut."loke — local-first privacy proxy for LLM traffic\n";
  u=str.concat(u;"\nUsage:\n");
  u=str.concat(u;"  loke ask \"<prompt>\"           send a prompt through the privacy pipeline\n");
  u=str.concat(u;"  loke pipeline \"<prompt>\"      show pipeline stages for a prompt\n");
  u=str.concat(u;"  loke queue list                list queued background jobs\n");
  u=str.concat(u;"  loke queue cancel <id>         cancel a queued job by id\n");
  u=str.concat(u;"  loke models list               list available local models\n");
  u=str.concat(u;"  loke models recommend          recommend models for your hardware\n");
  u=str.concat(u;"  loke memory search \"<query>\"   search memory palace\n");
  u=str.concat(u;"  loke agents list               list registered agents\n");
  u=str.concat(u;"  loke overnight status          show overnight job status\n");
  u=str.concat(u;"  loke benchmark <local-model>   score a local Ollama model and record the result\n");
  u=str.concat(u;"                 [--runs <3-8>]  runs, the first discarded as warm-up (default 5)\n");
  u=str.concat(u;"                 [--out <path>]  (default ~/.loke/benchmarks/<date>.jsonl)\n");
  u=str.concat(u;"  loke doctor                    run health check on all subsystems\n");
  u=str.concat(u;"  loke privacy evaluate \"<text>\" every privacy layer side by side on a text\n");
  u=str.concat(u;"                 [--show-values] print detected values (hidden by default)\n");
  u=str.concat(u;"  loke privacy evaluate --file <labelled.jsonl>  per-layer tp/fp/fn on labelled texts\n");
  u=str.concat(u;"  loke kill-switch <on|off>      stop, or allow again, every AI call\n");
  u=str.concat(u;"      [--use-case <id> | --agent <id> | --provider <name>]  for one scope only\n");
  u=str.concat(u;"  loke kill-switch status        list every switch that is on\n");
  u=str.concat(u;"  loke erase --everything        say what erasing all loke data would remove\n");
  u=str.concat(u;"                 [--yes]         and do it: every table, the log, the cache, exports\n");
  u=str.concat(u;"  loke audit verify              verify the audit chain and reconcile the disclosure record\n");
  u=str.concat(u;"  loke --version                 print version\n");
  u=str.concat(u;"  loke help                      show this help\n");
  <u
};

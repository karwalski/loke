m=cli.codeprofile;

i=str:std.str;
i=arr:std.arr;

t=$codefinding{
  kind:str;
  line:i32;
  redacted:str;
  originallen:i32
};

t=$profileresult{
  findings:@$codefinding;
  redactedsource:str;
  findingcount:i32;
  hassecrets:bool
};

f=checkpem(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"PRIVATE KEY")){
    let finding=$codefinding{
      kind:"pemkey";
      line:lineno;
      redacted:"[REDACTED:pem_key]";
      originallen:str.len(line)
    };
    <arr.push(findings;finding)
  }el if(str.contains(line;"BEGIN RSA")){
    let finding=$codefinding{
      kind:"pemkey";
      line:lineno;
      redacted:"[REDACTED:pem_key]";
      originallen:str.len(line)
    };
    <arr.push(findings;finding)
  }el{
    <findings
  }
};

f=checkapikey(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"sk-")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <arr.push(findings;finding)
  }el if(str.contains(line;"ghp_")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <arr.push(findings;finding)
  }el if(str.contains(line;"xoxb-")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <arr.push(findings;finding)
  }el if(str.contains(line;"AKIA")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <arr.push(findings;finding)
  }el{
    <findings
  }
};

f=checkenvsecret(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"=")){
    let eqpos=str.indexof(line;"=");
    let lhs=str.slice(line;0;eqpos);
    let rhs=str.slice(line;eqpos+1;str.len(line));
    if(str.len(lhs)>0){
      if(str.len(rhs)>16){
        if(!str.contains(lhs;" ")){
          if(str.isuppersnake(lhs)){
            let finding=$codefinding{
              kind:"envsecret";
              line:lineno;
              redacted:"[REDACTED:env_secret]";
              originallen:str.len(line)
            };
            <arr.push(findings;finding)
          }el{
            <findings
          }
        }el{
          <findings
        }
      }el{
        <findings
      }
    }el{
      <findings
    }
  }el{
    <findings
  }
};

f=checkconnstring(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"://")){
    if(str.contains(line;"@")){
      let afterscheme=str.sliceafter(line;"://");
      if(str.contains(afterscheme;"@")){
        if(str.contains(afterscheme;":")){
          let atpos=str.indexof(afterscheme;"@");
          let credentials=str.slice(afterscheme;0;atpos);
          if(str.contains(credentials;":")){
            let colonpos=str.indexof(credentials;":");
            let password=str.slice(credentials;colonpos+1;str.len(credentials));
            if(str.len(password)>0){
              let finding=$codefinding{
                kind:"connstring";
                line:lineno;
                redacted:"[REDACTED:conn_string]";
                originallen:str.len(line)
              };
              <arr.push(findings;finding)
            }el{
              <findings
            }
          }el{
            <findings
          }
        }el{
          <findings
        }
      }el{
        <findings
      }
    }el{
      <findings
    }
  }el{
    <findings
  }
};

f=redactline(line:str;lineno:i32;findings:@$codefinding):str{
  let i=mut.0;
  let len=arr.len(findings);
  let result=mut.line;
  lp(let lv=0;true;lv=lv){
    if(!(i<len)){ <result }el{
      let f=findings.get(i);
      if(f.line=lineno){
        result=f.redacted
      }el{};
      i=i+1
    };
  };
  <result
};

f=profile(source:str;filename:str):$profileresult{
  let lines=str.split(source;"
");
  let linecount=arr.len(lines);
  let findings=mut.@($codefinding)();
  let i=mut.0;

  lp(let lv=0;true;lv=lv){
    if(!(i<linecount)){ break }el{
      let line=lines.get(i);
      let lineno=i+1;
      findings=checkpem(line;lineno;findings);
      findings=checkapikey(line;lineno;findings);
      findings=checkenvsecret(line;lineno;findings);
      findings=checkconnstring(line;lineno;findings);
      i=i+1
    };
  };

  let redactedlines=mut.@(str)();
  let j=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(j<linecount)){ break }el{
      let line=lines.get(j);
      let lineno=j+1;
      let outline=redactline(line;lineno;findings);
      redactedlines=arr.push(redactedlines;outline);
      j=j+1
    };
  };

  let redactedsource=str.join(redactedlines;"
");
  let findingcount=arr.len(findings);
  let hassecrets=findingcount>0;

  <$profileresult{
    findings:findings;
    redactedsource:redactedsource;
    findingcount:findingcount;
    hassecrets:hassecrets
  }
};

f=collectkinds(findings:@$codefinding):str{
  let i=mut.0;
  let len=arr.len(findings);
  let kinds=mut."";
  lp(let lv=0;true;lv=lv){
    if(!(i<len)){ <kinds }el{
      let f=findings.get(i);
      if(!str.contains(kinds;f.kind)){
        if(str.len(kinds)>0){
          kinds=str.concat(kinds;str.concat(", ";f.kind))
        }el{
          kinds=f.kind
        }
      }el{};
      i=i+1
    };
  };
  <kinds
};

f=summarise(result:$profileresult):str{
  if(result.hassecrets){
    let kinds=collectkinds(result.findings);
    let countstr=str.fromint(result.findingcount);
    let label=mut."secrets found"; if(result.findingcount=1){ label="secret found" }el{};
    <str.concat(
      countstr;
      str.concat(
        " ";
        str.concat(
          label;
          str.concat(
            " (";
            str.concat(kinds;")")
          )
        )
      )
    )
  }el{
    <"no secrets found"
  }
};

f=issafe(result:$profileresult):bool{
  <result.hassecrets=false
};

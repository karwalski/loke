m=cli.codeprofile;

i=str:std.str;

(* There is no std.arr — the stdlib module is std.array, and its members are abi-gen
   (i64, i64) entry points that erase the element type. The typed method forms below
   keep $codefinding and str, which is what every loop here reads back. *)

(* Two str members this file called do not exist: str.isuppersnake and
   str.sliceafter. Both are local now. isuppersnake compares byte values rather than
   calling str.isdigit, which segfaults on a str.charat result (T-28). *)
t=$codefinding{
  kind:str;
  line:i32;
  redacted:str;
  originallen:i32
};

t=$profileresult{
  findings:@$codefinding;
  redactedsource:str;
  findingcount:i32;
  hassecrets:bool
};

f=isuppersnake(s:str):bool{
  let n=str.len(s);
  if(n>0){}el{
    <false
  };
  let hasletter=mut.false;
  lp(let i=0;i<n;i=i+1){
    let c=str.charat(s;i);
    if(c>=65){
      if(c<=90){
        hasletter=true
      }el{
        if(c==95){}el{
          if(c>=48){
            if(c<=57){}el{
              <false
            }
          }el{
            <false
          }
        }
      }
    }el{
      if(c>=48){
        if(c<=57){}el{
          <false
        }
      }el{
        <false
      }
    }
  };
  <hasletter
};

f=sliceafter(s:str;marker:str):str{
  let at=str.indexof(s;marker);
  if(at<0){
    <""
  }el{
    <str.slice(s;at+str.len(marker);str.len(s))
  }
};

f=checkpem(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"PRIVATE KEY")){
    let finding=$codefinding{
      kind:"pemkey";
      line:lineno;
      redacted:"[REDACTED:pem_key]";
      originallen:str.len(line)
    };
    <findings.push(finding)
  }el{ if(str.contains(line;"BEGIN RSA")){
    let finding=$codefinding{
      kind:"pemkey";
      line:lineno;
      redacted:"[REDACTED:pem_key]";
      originallen:str.len(line)
    };
    <findings.push(finding)
  }el{
    <findings
  }}
};

f=checkapikey(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"sk-")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <findings.push(finding)
  }el{ if(str.contains(line;"ghp_")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <findings.push(finding)
  }el{ if(str.contains(line;"xoxb-")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <findings.push(finding)
  }el{ if(str.contains(line;"AKIA")){
    let finding=$codefinding{
      kind:"apikey";
      line:lineno;
      redacted:"[REDACTED:api_key]";
      originallen:str.len(line)
    };
    <findings.push(finding)
  }el{
    <findings
  }}}}
};

f=checkenvsecret(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"=")){
    let eqpos=str.indexof(line;"=");
    let lhs=str.slice(line;0;eqpos);
    let rhs=str.slice(line;eqpos+1;str.len(line));
    if(str.len(lhs)>0){
      if(str.len(rhs)>16){
        if(!str.contains(lhs;" ")){
          if(isuppersnake(lhs)){
            let finding=$codefinding{
              kind:"envsecret";
              line:lineno;
              redacted:"[REDACTED:env_secret]";
              originallen:str.len(line)
            };
            <findings.push(finding)
          }el{
            <findings
          }
        }el{
          <findings
        }
      }el{
        <findings
      }
    }el{
      <findings
    }
  }el{
    <findings
  }
};

f=checkconnstring(line:str;lineno:i32;findings:@$codefinding):@$codefinding{
  if(str.contains(line;"://")){
    if(str.contains(line;"@")){
      let afterscheme=sliceafter(line;"://");
      if(str.contains(afterscheme;"@")){
        if(str.contains(afterscheme;":")){
          let credentials=str.slice(afterscheme;0;str.indexof(afterscheme;"@"));
          if(str.contains(credentials;":")){
            if(str.len(str.slice(credentials;str.indexof(credentials;":")+1;str.len(credentials)))>0){
              let finding=$codefinding{
                kind:"connstring";
                line:lineno;
                redacted:"[REDACTED:conn_string]";
                originallen:str.len(line)
              };
              <findings.push(finding)
            }el{
              <findings
            }
          }el{
            <findings
          }
        }el{
          <findings
        }
      }el{
        <findings
      }
    }el{
      <findings
    }
  }el{
    <findings
  }
};

f=redactline(line:str;lineno:i32;findings:@$codefinding):str{
  let i=mut.0;
  let len=findings.len;
  let result=mut.line;
  lp(let lv=0;true;lv=lv){
    if(!(i<len)){ <result }el{
      let f=findings.get(i);
      if(f.line==lineno){
        result=f.redacted
      }el{};
      i=i+1
    };
  };
  <result
};

f=profile(source:str;filename:str):$profileresult{
  let lines=str.split(source;"
");
  let linecount=lines.len;
  (* `@($codefinding)()` — a typed empty-array literal with a trailing call — passes the
     type checker and emits `call i64 @@()`, which is not valid LLVM IR, so this module
     type-checked and then failed to assemble. There is no diagnostic for it; the only
     symptom is a missing object file at link time. *)
  let findings=mut.@();
  let i=mut.0;

  lp(let lv=0;true;lv=lv){
    if(!(i<linecount)){ br }el{
      let line=lines.get(i);
      let lineno=i+1;
      findings=checkpem(line;lineno;findings);
      findings=checkapikey(line;lineno;findings);
      findings=checkenvsecret(line;lineno;findings);
      findings=checkconnstring(line;lineno;findings);
      i=i+1
    };
  };

  let redactedlines=mut.@();
  let j=mut.0;
  lp(let lv2=0;true;lv2=lv2){
    if(!(j<linecount)){ br }el{
      let line=lines.get(j);
      let lineno=j+1;
      redactedlines=redactedlines.push(redactline(line;lineno;findings));
      j=j+1
    };
  };

  let redactedsource=str.join("
";redactedlines);
  let findingcount=findings.len;

  <$profileresult{
    findings:findings;
    redactedsource:redactedsource;
    findingcount:findingcount;
    hassecrets:findingcount>0
  }
};

f=collectkinds(findings:@$codefinding):str{
  let i=mut.0;
  let len=findings.len;
  let kinds=mut."";
  lp(let lv=0;true;lv=lv){
    if(!(i<len)){ <kinds }el{
      let f=findings.get(i);
      if(!str.contains(kinds;f.kind)){
        if(str.len(kinds)>0){
          kinds="\(kinds), \(f.kind)"
        }el{
          kinds=f.kind
        }
      }el{};
      i=i+1
    };
  };
  <kinds
};

f=summarise(result:$profileresult):str{
  if(result.hassecrets){
    let kinds=collectkinds(result.findings);
    let countstr=str.fromint(result.findingcount);
    let label=mut."secrets found"; if(result.findingcount==(1 as i32)){ label="secret found" }el{};
    <"\(countstr) \(label) (\(kinds))"
  }el{
    <"no secrets found"
  }
};

f=issafe(result:$profileresult):bool{
  <result.hassecrets==false
};

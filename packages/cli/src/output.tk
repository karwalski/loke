m=cli.output;


i=str:std.str;

t=$outputstyle{
  $plain;
  $json;
  $verbose
};

f=printline(s:str):void{
  std.println(s);
  <()
};

f=printerror(s:str):void{
  std.println(str.concat("error: ";s));
  <()
};

f=printsection(title:str;body:str):void{
  let tlen=str.len(title);
  let dashes=str.repeat("-";tlen);
  std.println(title);
  std.println(dashes);
  std.println(body);
  <()
};

f=printpipelinestage(stage:str;status:str;detail:str):void{
  let line=str.concat(
    "  [";
    str.concat(
      stage;
      str.concat(
        "] ";
        str.concat(
          status;
          str.concat(" — ";detail)
        )
      )
    )
  );
  std.println(line);
  <()
};

f=printtable(headers:@str;rows:@(@str)):void{
  let ncols=str.len(headers);
  let col=0;
  let widths=@();
  loop col<ncols{
    let w=str.len(headers.get(col));
    let row=0;
    loop row<str.len(rows){
      let cell=rows.get(row).get(col);
      let cw=str.len(cell);
      if(cw>w){
        let w=cw
      };
      let row=row+1
    };
    let widths=@(widths;w);
    let col=col+1
  };
  let headerline="";
  let sepline="";
  let c=0;
  loop c<ncols{
    let h=str.padright(headers.get(c);widths.get(c));
    if(c>0){
      let headerline=str.concat(headerline;"  ")
    };
    let headerline=str.concat(headerline;h);
    let dashes=str.repeat("-";widths.get(c));
    if(c>0){
      let sepline=str.concat(sepline;"  ")
    };
    let sepline=str.concat(sepline;dashes);
    let c=c+1
  };
  std.println(headerline);
  std.println(sepline);
  let r=0;
  loop r<str.len(rows){
    let rowline="";
    let c=0;
    loop c<ncols{
      let cell=str.padright(rows.get(r).get(c);widths.get(c));
      if(c>0){
        let rowline=str.concat(rowline;"  ")
      };
      let rowline=str.concat(rowline;cell);
      let c=c+1
    };
    std.println(rowline);
    let r=r+1
  };
  <()
};

f=sensitivitybadge(level:str):str{
  if(str.eq(level;"public")){
    <"PUBLIC"
  };
  if(str.eq(level;"internal")){
    <"INTERNAL"
  };
  if(str.eq(level;"confidential")){
    <"CONFIDENTIAL [!]"
  };
  if(str.eq(level;"restricted")){
    <"RESTRICTED [!!]"
  };
  <"UNKNOWN"
};

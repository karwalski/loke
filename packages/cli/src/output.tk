m=cli.output;


i=str:std.str;
i=io:std.io;

t=$outputstyle{
  $plain:i64;
  $json:i64;
  $verbose:i64};

f=printline(s:str):i64{
  io.println(s);
  <0
};

(* Writes the question and reads one line back. Its own function here because
   cli.modelmgmt asked cli.output for a prompt and cli.output had never had one, and
   because a confirmation prompt that cannot read stdin silently confirms. *)
f=prompt(question:str):str{
  io.print(question);
  <io.readln()
};

f=printerror(s:str):i64{
  io.println(str.concat("error: ";s));
  <0
};

f=printsection(title:str;body:str):i64{
  let tlen=str.len(title);
  let dashes=str.repeat("-";tlen);
  io.println(title);
  io.println(dashes);
  io.println(body);
  <0
};

f=printpipelinestage(stage:str;status:str;detail:str):i64{
  let line=str.concat(
    "  [";
    str.concat(
      stage;
      str.concat(
        "] ";
        str.concat(
          status;
          str.concat(" — ";detail)
        )
      )
    )
  );
  io.println(line);
  <0
};

(* `rows` was declared `@i64` and then indexed twice — `rows.get(row).get(col)` — so
   every cell read was an index into an i64. `@@str` is what the body has always
   wanted. str.padright takes (s, width, padchar): the two-argument calls below were
   latent, and this module has no callers of printtable yet, so neither had ever been
   observed. *)
f=printtable(headers:@str;rows:@@str):i64{
  let ncols=headers.len;
  let col=mut.0;
  let widths=mut.@();
  lp(let lv=0;col<ncols;lv=lv){
    let w=mut.str.len(headers.get(col));
    let row=mut.0;
    lp(let lv2=0;row<rows.len;lv2=lv2){
      (* The inner array is bound with its declared type before it is subscripted.
         `rows.get(row).get(col)` on an @@str emits
         `%t = inttoptr i64 %v to i8*` followed by `store i64 %t, i64* %cell`, which is
         invalid IR — clang rejects it with "defined with type 'ptr' but expected
         'i64'" — so this module type-checked and then produced no object file at all,
         and the only symptom was five undefined cli.output symbols at link time. *)
      let rowcells:@str=rows.get(row);
      let cell=rowcells.get(col);
      let cw=str.len(cell);
      if(cw>w){
        w=cw
      }el{};
      row=row+1
    };
    widths=widths.push(w);
    col=col+1
  };
  let headerline=mut."";
  let sepline=mut."";
  let c=mut.0;
  lp(let lv3=0;c<ncols;lv3=lv3){
    let h=str.padright(headers.get(c);widths.get(c);" ");
    if(c>0){
      headerline=str.concat(headerline;"  ")
    }el{};
    headerline=str.concat(headerline;h);
    let dashes=str.repeat("-";widths.get(c));
    if(c>0){
      sepline=str.concat(sepline;"  ")
    }el{};
    sepline=str.concat(sepline;dashes);
    c=c+1
  };
  io.println(headerline);
  io.println(sepline);
  let r=mut.0;
  lp(let lv4=0;r<rows.len;lv4=lv4){
    let rowline=mut."";
    let c2=mut.0;
    lp(let lv5=0;c2<ncols;lv5=lv5){
      let rowcells:@str=rows.get(r);
      let cell=str.padright(rowcells.get(c2);widths.get(c2);" ");
      if(c2>0){
        rowline=str.concat(rowline;"  ")
      }el{};
      rowline=str.concat(rowline;cell);
      c2=c2+1
    };
    io.println(rowline);
    r=r+1
  };
  <0
};

f=sensitivitybadge(level:str):str{
  if(str.eq(level;"public")){
    <"PUBLIC"
  };
  if(str.eq(level;"internal")){
    <"INTERNAL"
  };
  if(str.eq(level;"confidential")){
    <"CONFIDENTIAL [!]"
  };
  if(str.eq(level;"restricted")){
    <"RESTRICTED [!!]"
  };
  <"UNKNOWN"
};

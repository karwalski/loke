m=cli.output;


i=str:std.str;

t=$outputstyle{
  $plain:i64;
  $json:i64;
  $verbose:i64};

f=printline(s:str):void{
  std.println(s);
  <()
};

f=printerror(s:str):void{
  std.println(str.concat("error: ";s));
  <()
};

f=printsection(title:str;body:str):void{
  let tlen=str.len(title);
  let dashes=str.repeat("-";tlen);
  std.println(title);
  std.println(dashes);
  std.println(body);
  <()
};

f=printpipelinestage(stage:str;status:str;detail:str):void{
  let line=str.concat(
    "  [";
    str.concat(
      stage;
      str.concat(
        "] ";
        str.concat(
          status;
          str.concat(" — ";detail)
        )
      )
    )
  );
  std.println(line);
  <()
};

f=printtable(headers:@str;rows:@i64):void{
  let ncols=headers.len;
  let col=mut.0;
  let widths=@();
  lp(let lv=0;col<ncols;lv=lv){
    let w=mut.str.len(headers.get(col));
    let row=mut.0;
    lp(let lv2=0;row<rows.len;lv2=lv2){
      let cell=rows.get(row).get(col);
      let cw=str.len(cell);
      if(cw>w){
        w=cw
      }el{};
      row=row+1
    };
    widths=@(widths;w);
    col=col+1
  };
  let headerline=mut."";
  let sepline=mut."";
  let c=mut.0;
  lp(let lv=0;c<ncols;lv=lv){
    let h=str.padright(headers.get(c);widths.get(c));
    if(c>0){
      headerline=str.concat(headerline;"  ")
    }el{};
    headerline=str.concat(headerline;h);
    let dashes=str.repeat("-";widths.get(c));
    if(c>0){
      sepline=str.concat(sepline;"  ")
    }el{};
    sepline=str.concat(sepline;dashes);
    c=c+1
  };
  std.println(headerline);
  std.println(sepline);
  let r=mut.0;
  lp(let lv=0;r<rows.len;lv=lv){
    let rowline=mut."";
    let c2=mut.0;
    lp(let lv2=0;c2<ncols;lv2=lv2){
      let cell=str.padright(rows.get(r).get(c2);widths.get(c2));
      if(c2>0){
        rowline=str.concat(rowline;"  ")
      }el{};
      rowline=str.concat(rowline;cell);
      c2=c2+1
    };
    std.println(rowline);
    r=r+1
  };
  <()
};

f=sensitivitybadge(level:str):str{
  if(str.eq(level;"public")){
    <"PUBLIC"
  };
  if(str.eq(level;"internal")){
    <"INTERNAL"
  };
  if(str.eq(level;"confidential")){
    <"CONFIDENTIAL [!]"
  };
  if(str.eq(level;"restricted")){
    <"RESTRICTED [!!]"
  };
  <"UNKNOWN"
};

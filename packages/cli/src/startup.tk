m=cli.startup;


i=t:shared.types;
i=cfg:shared.config;
i=log:shared.log;
i=str:std.str;

t=$bootstage{
  $config;
  $logger;
  $database;
  $migrations;
  $settings;
  $healthcheck;
  $ready
};

t=$bootresult{
  stage:$bootstage;
  ok:bool;
  error:str
};

f=bootsequence(configpath:str):$lokeconfig|$lokeerr{
  let cid=log.newcorrelationid();

  log.info("boot: loading config";"startup";cid);
  let config=mt cfg.loadconfig(configpath) {
    $ok:v v;
    $err:e;
      log.error(str.concat("boot: config load failed — ";e);"startup";cid);
      <$lokeerr.$configerr(str.concat("config stage failed: ";e))
  };

  log.info("boot: validating config";"startup";cid);
  if(str.len(config.ollamaurl)<1{
    log.error("boot: ollama_url is required";"startup";cid);
    <$lokeerr.$configerr("config stage failed: ollama_url must not be empty")
  };
  if(str.len(config.datadir)<1{
    log.error("boot: data_dir is required";"startup";cid);
    <$lokeerr.$configerr("config stage failed: data_dir must not be empty")
  };

  log.info("boot: config valid";"startup";cid);
  logbootsummary(config;cid);
  log.info("boot: ready";"startup";cid);

  <config
};

f=shutdownsequence(cid:str):void{
  log.info("shutdown: draining in-flight requests";"startup";cid);
  log.info("shutdown: closing database";"startup";cid);
  log.info("shutdown: cleanup done";"startup";cid);
  <()
};

f=logbootsummary(config:$lokeconfig;cid:str):void{
  log.info(str.concat("boot summary — port: ";str.fromint(config.port));"startup";cid);
  log.info(str.concat("boot summary — data_dir: ";config.datadir);"startup";cid);
  log.info(str.concat("boot summary — ollama_url: ";config.ollamaurl);"startup";cid);
  log.info(str.concat("boot summary — default_provider: ";config.defaultprovider);"startup";cid);
  <()
};

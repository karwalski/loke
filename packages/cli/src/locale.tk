m=cli.locale;
i=tr:core.i18n.translator;
i=loc:core.i18n.locales;
i=str:std.str;
i=log:shared.log;

f=run(args:@str):i64{
  if(args.len<1){
    printusage();
    <0
  }el{
    let sub=args.get(0);
    if(str.eq(sub;"list")){
      <runlist()
    }el if(str.eq(sub;"validate")){
      <runvalidate()
    }el{
      log.info(str.concat("unknown locale subcommand: ";sub);"cli.locale";"system");
      printusage();
      <1
    };
  };
};

f=printusage():i64{
  log.info(tr.t("loke.cli.locale.usage");"cli.locale";"system");
  log.info(tr.t("loke.cli.locale.usage_list");"cli.locale";"system");
  log.info(tr.t("loke.cli.locale.usage_validate");"cli.locale";"system");
  <0
};

(* Every loop in this file was written as a bare `if`, so `runlist` listed only the
   first locale and `runvalidate` compared only the first baseline key against only
   the first en-US entry. Worse, both bodies called `.push` and discarded the result
   (T-24), so `baselinekeys` and `missing` were always empty and `missing.len==0` was
   always true: `loke locale validate` could only ever print "validation passed",
   whatever the tables held. `lp` and assigned pushes, and the codes come from
   core.i18n.locales rather than being restated here. *)
f=runlist():i64{
  log.info(tr.t("loke.cli.locale.available");"cli.locale";"system");
  let active=tr.getlocale();
  let codes=loc.codes();
  lp(let i=0;i<codes.len;i=i+1){
    let code=codes.get(i);
    let marker=mut."";
    if(str.eq(code;active)){marker=tr.t("loke.cli.locale.active_marker")}el{};
    log.info("  \(code)\(marker)";"cli.locale";"system")
  };
  <0
};

f=haskey(l:$locale;key:str):bool{
  lp(let i=0;i<l.entries.len;i=i+1){
    if(str.eq(l.entries.get(i).key;key)){
      <true
    }el{}
  };
  <false
};

f=runvalidate():i64{
  let baseline=loc.enau();
  let target=loc.enus();
  let missing=mut.@();
  lp(let bi=0;bi<baseline.entries.len;bi=bi+1){
    let key=baseline.entries.get(bi).key;
    if(haskey(target;key)){}el{
      missing=missing.push(key)
    }
  };
  if(missing.len==0){
    log.info(tr.t("loke.cli.locale.validation_ok");"cli.locale";"system");
    log.info(tr.t("loke.cli.locale.validation_passed");"cli.locale";"system");
    <0
  }el{
    log.info(str.concat("en-US:";str.concat(str.concat(" ";str.fromint(missing.len));tr.t("loke.cli.locale.missing_keys")));"cli.locale";"system");
    lp(let mi=0;mi<missing.len;mi=mi+1){
      log.info(str.concat("  - ";missing.get(mi));"cli.locale";"system")
    };
    log.error(tr.t("loke.cli.locale.validation_failed");"cli.locale";"system");
    <1
  };
};

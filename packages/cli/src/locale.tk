m=cli.locale;
i=tr:loke.platform.i18n.translator;
i=loc:loke.platform.i18n.locales;
i=str:std.str;
i=log:shared.log;

f=run(args:@str):i64{
  if(args.len<1){
    printusage();
    <0
  }el{
    let sub=args.get(0);
    if(str.eq(sub;"list")){
      <runlist()
    }el{
      if(str.eq(sub;"validate")){
        <runvalidate()
      }el{
        log.info(str.concat("unknown locale subcommand: ";sub);"cli.locale";"system");
        printusage();
        <1
      };
    };
  };
};

f=printusage():void{
  log.info(tr.t("loke.cli.locale.usage");"cli.locale";"system");
  log.info(tr.t("loke.cli.locale.usage_list");"cli.locale";"system");
  log.info(tr.t("loke.cli.locale.usage_validate");"cli.locale";"system")
};

f=runlist():i64{
  log.info(tr.t("loke.cli.locale.available");"cli.locale";"system");
  let active=tr.getlocale();

  let codes=@("en-AU";"en-US");
  let i=0;
  if(i<codes.len){
    let code=codes.get(i);
    let marker=if(str.eq(code;active)){tr.t("loke.cli.locale.active_marker")}el{""};
    log.info(str.concat("  ";str.concat(code;marker));"cli.locale";"system");
    i=i+1;
  }el{};
  <0
};

f=runvalidate():i64{
  let baseline=loc.enau();
  let baselinekeys=@str@();
  let bi=mut.0;
  if(bi<baseline.entries.len){
    baselinekeys.push(baseline.entries.get(bi).key);
    bi=bi+1
  }el{};

  let enus=loc.enus();
  let missing=@str@();
  let ki=mut.0;
  if(ki<baselinekeys.len){
    let key=baselinekeys.get(ki);
    let found=mut.false;
    let ei=mut.0;
    if(ei<enus.entries.len){
      if(str.eq(enus.entries.get(ei).key;key)){
        found=true
      }el{};
      ei=ei+1
    }el{};
    if(found=false){
      missing.push(key)
    }el{};
    ki=ki+1
  }el{};

  if(missing.len=0){
    log.info(tr.t("loke.cli.locale.validation_ok");"cli.locale";"system");
    log.info(tr.t("loke.cli.locale.validation_passed");"cli.locale";"system");
    <0
  }el{
    log.info(str.concat("en-US:";str.concat(str.concat(" ";str.fromint(missing.len));tr.t("loke.cli.locale.missing_keys")));"cli.locale";"system");
    let mi=mut.0;
    if(mi<missing.len){
      log.info(str.concat("  - ";missing.get(mi));"cli.locale";"system");
      mi=mi+1
    }el{};
    log.error(tr.t("loke.cli.locale.validation_failed");"cli.locale";"system");
    <1
  };
};

m=cli.proxy;


i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=net:std.net;
i=http:std.http;
i=json:std.json;
i=pipe:core.privacy.pipeline;
i=disp:providers.dispatcher;
i=cfg:shared.config;
i=str:std.str;

t=$proxyconfig{
  port:i32;
  targettool:str;
  verbose:bool;
  dryrun:bool
};

t=$proxysession{
  id:str;
  tool:str;
  requestsintercepted:i32;
  entitiesredacted:i32;
  tokenssaved:i32;
  startedat:i64
};

let defaultport = 11431;

f=defaultconfig(tool:str):$proxyconfig{
  <$proxyconfig{
    port=11431;
    targettool=tool;
    verbose=false;
    dryrun=false
  };
};

f=parseopts(args:@(str)):$proxyconfig{
  let port=11431;
  let tool="";
  let verbose=false;
  let dryrun=false;
  let i=0;
  loop i<str.len(args){
    let arg=args.get(i);
    if str.eq(arg;"--port"){
      let i=i+1;
      if i<str.len(args){
        let port=str.toint(args.get(i))
      };
    }else{
      if str.eq(arg;"--verbose"){
        let verbose=true
      }else{
        if str.eq(arg;"--dry-run"){
          let dryrun=true
        }else{
          if str.len(tool)<1{
            let tool=arg
          };
        };
      };
    };
    let i=i+1
  };
  <$proxyconfig{
    port=port;
    targettool=tool;
    verbose=verbose;
    dryrun=dryrun
  };
};

f=handlerequest(reqbody:str;session:$proxysession;cfg:$proxyconfig;pipecfg:pipe.$pipelineconfig):str{
  let cid=log.newcorrelationid();

  let parsed=mt json.parse(reqbody) {
    $ok:v v;
    $err:e;
      log.error(str.concat("proxy: failed to parse request body — ";e);"proxy";cid);
      <"{\"error\":\"invalid request body\"}"
  };

  let text=json.getstr(parsed;mt "prompt") {
    $ok:v v;
    $err:e;
      let messages=json.getarr(parsed;mt "messages") {
        $ok:v json.arrtostr(v);
        $err:e ""
      };
  };

  let piperesult=pipe.run(text;mt pipecfg) {
    $ok:v v;
    $err:e;
      log.error(str.concat("proxy: pipeline error — ";e);"proxy";cid);
      <"{\"error\":\"pipeline failure\"}"
  };

  if cfg.verbose{
    log.info(
      str.concat(
        "proxy: redacted ";
        str.concat(str.fromint(piperesult.entitycount);" entities")
      );
      "proxy";
      cid
    )
  };

  if cfg.dryrun{
    <"{\"content\":\"[dry-run: would send to LLM]\"}"
  };

  let anonbody=json.setstr(parsed;"prompt";piperesult.anonymised);
  let anonreq=json.tostr(anonbody);

  let rawresponse=disp.forward(anonreq;mt cfg.targettool) {
    $ok:v v;
    $err:e;
      log.error(str.concat("proxy: dispatch error — ";e);"proxy";cid);
      <"{\"error\":\"upstream failure\"}"
  };

  let restored=pipe.restore(rawresponse;mt piperesult.mapping) {
    $ok:v v;
    $err:e;
      log.error(str.concat("proxy: restore error — ";e);"proxy";cid);
      rawresponse
  };

  <restored
};

f=start(cfg:$proxyconfig;lokecfg:cfg.$lokeconfig):i32{
  let cid=log.newcorrelationid();

  out.printline(
    str.concat(
      "loke proxy listening on localhost:";
      str.concat(
        str.fromint(cfg.port);
        str.concat(" → intercepting ";cfg.targettool)
      )
    )
  );
  out.printline(
    str.concat(
      "Set your tool to use proxy: export ANTHROPIC_BASE_URL=http://localhost:";
      str.fromint(cfg.port)
    )
  );

  let pipecfg=pipe.defaultconfig();

  let session=$proxysession{
    id=log.newcorrelationid();
    tool=cfg.targettool;
    requestsintercepted=0;
    entitiesredacted=0;
    tokenssaved=0;
    startedat=net.nowunix()
  };

  let listener=mt net.listen(cfg.port) {
    $ok:v v;
    $err:e;
      out.printerror(str.concat("proxy: failed to bind port — ";e));
      <1
  };

  log.info(
    str.concat("proxy: listening on port ";str.fromint(cfg.port));
    "proxy";
    cid
  );

  let running=true;
  loop running{
    let conn=mt net.accept(listener) {
      $ok:v v;
      $err:e;
        log.error(str.concat("proxy: accept error — ";e);"proxy";cid);
        let running=false;
        net.close(listener);
        <0
    };
    let reqbody=mt net.readbody(conn) {
      $ok:v v;
      $err:e;
        log.error(str.concat("proxy: read error — ";e);"proxy";cid);
        net.closeconn(conn);
        ""
    };
    if str.len(reqbody)>0{
      let response=handlerequest(reqbody;session;cfg;pipecfg);
      net.write(conn;mt response) {
        $ok:v ();
        $err:e log.error(str.concat("proxy: write error — ";e);"proxy";cid)
      };
      let session=$proxysession{
        id=session.id;
        tool=session.tool;
        requestsintercepted=session.requestsintercepted+1;
        entitiesredacted=session.entitiesredacted;
        tokenssaved=session.tokenssaved;
        startedat=session.startedat
      };
    };
    net.closeconn(conn)
  };

  out.printline("loke proxy shutdown");
  out.printline(
    str.concat(
      "session stats — requests intercepted: ";
      str.fromint(session.requestsintercepted)
    )
  );
  out.printline(
    str.concat(
      "session stats — entities redacted: ";
      str.fromint(session.entitiesredacted)
    )
  );
  out.printline(
    str.concat(
      "session stats — tokens saved: ";
      str.fromint(session.tokenssaved)
    )
  );

  <0
};

f=usage():str{
  <"usage: loke proxy <tool> [options]

tools:
  claude-code    intercept Claude Code traffic
  codex          intercept OpenAI Codex traffic
  gemini-cli     intercept Gemini CLI traffic

options:
  --port N       listen port (default: 11431)
  --verbose      log redacted entity counts per request
  --dry-run      intercept and anonymise but do not forward to LLM

example:
  loke proxy claude-code --verbose
  export ANTHROPIC_BASE_URL=http://localhost:11431"
};

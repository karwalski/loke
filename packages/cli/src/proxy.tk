m=cli.proxy;

i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=net:std.net;
i=http:std.http;
i=json:std.json;
i=jx:shared.jsonobj;
i=pipe:core.privacy.pipeline;
i=ph:core.privacy.placeholder;
i=ptypes:core.providers.types;
i=router:core.router.router;
i=disp:core.providers.dispatcher;
i=cfg:shared.config;
i=ks:core.governance.killswitch;
i=sdb:core.storage.db;
i=str:std.str;
i=hr:core.audit.hoprecord;

t=$proxyconfig{
  port:i32;
  targettool:str;
  verbose:bool;
  dryrun:bool
};

t=$proxysession{
  id:str;
  tool:str;
  requestsintercepted:i32;
  entitiesredacted:i32;
  tokenssaved:i32;
  startedat:i64
};

(* json.decode, not json.parse. `json.parse` mangles to tk_json_parse_w, which does
   not exist; the linker binds it to tk_json_parse — an unrelated runtime helper that
   parses an int array, a boolean or a number and returns an int64, not a Json*. So
   every json.parse in this repository returned garbage that json.getopt and json.str
   then read as a document, silently. Filed as T-17 in docs/upstream/toke-issues.md. *)
f=defaultconfig(tool:str):$proxyconfig{
  <$proxyconfig{
    port:11431;
    targettool:tool;
    verbose:false;
    dryrun:false
  }
};

(* Every option assignment here was a `let` inside a branch, which declares a new
   branch-local binding rather than assigning — so `loke proxy --port 9000 --verbose`
   returned the defaults for all four fields. `let i=i+1` did the same to the cursor,
   so the loop never advanced and never terminated either. toke also emits invalid IR
   for a shadowing let, so this would have broken the link the moment packages/cli
   entered the build (F10.23). See docs/upstream/toke-issues.md T-6. *)
f=parseopts(args:@str):$proxyconfig{
  let port=mut.11431;
  let tool=mut."";
  let verbose=mut.false;
  let dryrun=mut.false;
  let i=mut.0;
  lp(let lv=0;i<args.len;lv=lv){
    let arg=args.get(i);
    if(str.eq(arg;"--port")){
      i=i+1;
      if(i<args.len){
        port=str.toint(args.get(i))
      }el{}
    }el if(str.eq(arg;"--verbose")){
      verbose=true
    }el if(str.eq(arg;"--dry-run")){
      dryrun=true
    }el if(str.len(tool)<1){
      tool=arg
    }el{};
    i=i+1
  };
  <$proxyconfig{
    port:port;
    targettool:tool;
    verbose:verbose;
    dryrun:dryrun
  }
};


(* Rewritten against the interfaces the core modules export (F10.23d/GA1.2).

   This function is the redact-and-forward path in its shortest honest form, and
   nothing here had ever compiled. The legacy body called pipe.run with two arguments
   when it takes three, matched its plain $pipelinerun return as if it were a result,
   read piperesult.entitycount / .anonymised / .mapping (the real fields are
   totalentities and result.{anonymised,entities}), called the nonexistent
   pipe.defaultconfig, pipe.restore, disp.forward, json.setstr, json.tostr and
   json.arrtostr, and matched json.decode twice with the second match's $err arm
   reading the first arm's binding.

   Restoration is core.privacy.placeholder.restore over a map built from the entities
   the filter found — this call site and mcpbroker.proxy are the only two in the
   repository, and both were in never-compiled trees. *)
f=handlerequest(reqbody:str;cfg:$proxyconfig;pipecfg:$pipelineconfig;store:i64):str{
  <handlerequestwith(reqbody;cfg;pipecfg;store;disp.new(disp.getapikeys();""))
};

(* G1.6. The kill switch is asked first, before the request is read or scanned, as the
   browser path asks it: the global switch, the target's provider and the "cli-proxy" use
   case each refuse, and so does a store of 0 (ks.isblocked fails closed). `d` is the
   dispatcher, a recorder's in tests. *)
f=refusedbyswitch(store:i64;provider:str):str{
  let why=ks.refusalmessage(store;provider;"cli-proxy");
  <"{\"error\":\"kill_switch\",\"message\":\(jx.escape(why))}"
};

f=handlerequestwith(reqbody:str;cfg:$proxyconfig;pipecfg:$pipelineconfig;store:i64;d:$dispatcher):str{
  let cid=log.newcorrelationid();
  let provider:$provider=router.providerfromstr(cfg.targettool);
  let pname=router.providerstr(provider);
  if(ks.isblocked(store;pname;"cli-proxy")){
    log.warn("proxy: refused by the kill switch, nothing sent";"proxy";cid);
    <refusedbyswitch(store;pname)
  }el{};
  let parsed=mt json.dec(reqbody) {
    $ok:j j;
    $jsonerr:e jx.emptyobj()
  };
  let text=promptfrom(parsed);
  if(str.len(text)>0){}el{
    log.error("proxy: request body carried no prompt";"proxy";cid);
    <"{\"error\":\"invalid request body\"}"
  };

  let piperun=pipe.run(text;"";pipecfg);
  let detected=piperun.result;
  let facts=hr.factsof(piperun;"cli-proxy";"none";"none");
  (* F3b.18. The run's per-layer metrics, on its request id, before any audit row, so every
     row below binds them (F3b.10), as /api/pipeline and `loke ask` record them. *)
  hr.recordlayers(store;piperun);
  (* F3b.8 (4). The organisation policy's refusal or override, on the run's request id, as
     /api/pipeline audits it. *)
  hr.orgpolicyaudit(store;facts;piperun);

  if(cfg.verbose){
    log.info(
      "proxy: redacted \(str.fromint(piperun.totalentities as i64)) entities";
      "proxy";
      cid
    )
  }el{};

  if(cfg.dryrun){
    <"{\"content\":\"[dry-run: would send to LLM]\"}"
  }el{};

  (* Fail closed. The gate is the only thing between a confidential prompt and a
     provider, and CLAUDE.md is explicit that the filter must not fail open. *)
  if(pipe.issafetoforward(piperun)){}el{
    log.warn("proxy: blocked by sensitivity policy";"proxy";cid);
    (* F3b.18. The refusal is audited as privacy_refused on the request id, as /api/pipeline
       and `loke ask` audit it: no layer scanned, an unplaced span, a veto, a layer error or
       the policy's refusal. The row carries labels and counts, never text. *)
    hr.privacyrefused(store;facts);
    (* F3b.8 (4). The organisation policy's refusal names its reason: layer ids and policy
       values, never text. *)
    if(str.len(piperun.policyerror)>0){
      let why="blocked: \(piperun.policyerror)";
      <"{\"error\":\(jx.escape(why))}"
    }el{};
    <"{\"error\":\"blocked: sensitivity exceeds forwarding policy\"}"
  };

  let request=$completionrequest{
    modelid:cfg.targettool;
    messages:@(ptypes.usermsg(detected.anonymised));
    systemprompt:piperun.finalsystemprompt;
    maxtokens:(2048 as u32);
    temperature:0.0;
    stream:false
  };
  (* LS1.1j — trydispatch and isdispatched. The old `mt disp.dispatch(...)` could not see a
     failure (T-18): its $ok arm ran on a failed dispatch and read .content off the error
     payload, which segfaults. *)
  let response=disp.trydispatch(d;request;provider);
  if(disp.isdispatched(response)){}el{
    log.error("proxy: dispatch failed — \(disp.dispatcherror(response))";"proxy";cid);
    <"{\"error\":\"upstream failure\"}"
  };
  let raw=response.content;
  if(str.len(raw)>0){}el{
    log.error("proxy: dispatch returned no content";"proxy";cid);
    <"{\"error\":\"upstream failure\"}"
  };

  <ph.restore(raw;ph.mapfromentities(detected.entities))
};

(* LS1.1w: jx.strvalue and json.arr over a typed $jsonval, where json.getstr and json.getarray
   (std.json's untyped ABI helpers) read an i64 handle. jx.strvalue decodes the escapes, so a
   prompt reaches the privacy filter as the text the user wrote. *)
f=promptfrom(parsed:$jsonval):str{
  let direct=jx.strvalue(parsed;"prompt";"");
  if(str.len(direct)>0){
    <direct
  }el{};
  let messages=mt json.arr(parsed;"messages") {
    $ok:a a;
    $jsonerr:e @()
  };
  let joined=mut."";
  lp(let i=0;i<messages.len;i=i+1){
    let m:$jsonval=messages.get(i);
    let content=jx.strvalue(m;"content";"");
    if(str.len(content)>0){
      if(str.len(joined)>0){
        joined="\(joined)\n\(content)"
      }el{
        joined=content
      }
    }el{}
  };
  <joined
};

(* std.net is five abi entry points — listen, accept, read, write, close — each taking
   and returning a bare i64, not a result. The legacy body matched six of them as
   `$ok`/`$err` results and, in three of those matches, its `$err` arm read the `$ok`
   arm's binding. It also called net.nowunix, net.readbody and net.closeconn, none of
   which exist, and reassigned a non-mut `session`.

   Kept as an accept loop over the real primitives. net.read returns the request bytes
   as a str handle and 0 on failure, which is the only failure signal available. *)
f=start(cfg:$proxyconfig;lokecfg:$lokeconfig):i64{
  let cid=log.newcorrelationid();

  out.printline(
    "loke proxy listening on localhost:\(str.fromint(cfg.port as i64)) → intercepting \(cfg.targettool)"
  );
  out.printline(
    str.concat(
      "Set your tool to use proxy: export ANTHROPIC_BASE_URL=http://localhost:";
      str.fromint(cfg.port as i64)
    )
  );

  let pipecfg=pipe.withlokeconfig(pipe.newconfig(lokecfg.presidiourl;lokecfg.ollamaurl);lokecfg);
  (* G1.6. The store the kill switch is read from, once; 0 refuses every request. *)
  let store=mt sdb.openstore(lokecfg.datadir) { $ok:st 1; $err:e 0 };

  (* F10.39: std.net.listen takes an address string, "host:port". Handed the port as an
     integer it segfaulted at toke 0b0bc4e (T-49), and toke 3.1.0 rejects it (E4031). The
     host is loopback: every loke listener is local-only. *)
  let listener=net.listen("127.0.0.1:\(cfg.port as i64)");
  if(listener>0){}el{
    out.printerror("proxy: failed to bind port");
    <1
  };
  log.info(
    str.concat("proxy: listening on port ";str.fromint(cfg.port as i64));
    "proxy";
    cid
  );

  let intercepted=mut.0;
  let running=mut.true;
  lp(let lv=0;running;lv=lv){
    let conn=net.accept(listener);
    if(conn>0){
      let reqbody=net.read(conn);
      if(str.len(reqbody)>0){
        net.write(conn;handlerequest(reqbody;cfg;pipecfg;store));
        intercepted=intercepted+1
      }el{};
      net.close(conn)
    }el{
      log.error("proxy: accept error";"proxy";cid);
      running=false;
      net.close(listener)
    }
  };

  out.printline("loke proxy shutdown");
  out.printline(
    str.concat(
      "session stats — requests intercepted: ";
      str.fromint(intercepted)
    )
  );

  <0
};

f=usage():str{
  <"usage: loke proxy <tool> [options]

tools:
  claude-code    intercept Claude Code traffic
  codex          intercept OpenAI Codex traffic
  gemini-cli     intercept Gemini CLI traffic

options:
  --port N       listen port (default: 11431)
  --verbose      log redacted entity counts per request
  --dry-run      intercept and anonymise but do not forward to LLM

example:
  loke proxy claude-code --verbose
  export ANTHROPIC_BASE_URL=http://localhost:11431"
};

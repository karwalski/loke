m=cli.proxy;

i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=net:std.net;
i=http:std.http;
i=json:std.json;
i=pipe:core.privacy.pipeline;
i=disp:providers.dispatcher;
i=cfg:shared.config;
i=str:std.str;

t=$proxyconfig{
  port:i32;
  targettool:str;
  verbose:bool;
  dryrun:bool
};

t=$proxysession{
  id:str;
  tool:str;
  requestsintercepted:i32;
  entitiesredacted:i32;
  tokenssaved:i32;
  startedat:i64
};

f=defaultconfig(tool:str):$proxyconfig{
  <$proxyconfig{
    port:11431;
    targettool:tool;
    verbose:false;
    dryrun:false
  }
};

f=parseopts(args:@str):$proxyconfig{
  let port=11431;
  let tool="";
  let verbose=false;
  let dryrun=false;
  let i=0;
  lp(let lv=0;i<str.len(args);lv=lv){
    let arg=args.get(i);
    if(str.eq(arg;"--port")){
      let i=i+1;
      if(i<str.len(args)){
        let port=str.toint(args.get(i))
      }
    }el{
      if(str.eq(arg;"--verbose")){
        let verbose=true
      }el{
        if(str.eq(arg;"--dry-run")){
          let dryrun=true
        }el{
          if(str.len(tool)<1){
            let tool=arg
          }
        }
      }
    };
    let i=i+1
  };
  <$proxyconfig{
    port:port;
    targettool:tool;
    verbose:verbose;
    dryrun:dryrun
  }
};

f=handlerequest(reqbody:str;session:$proxysession;cfg:$proxyconfig;pipecfg:i64):str{
  let cid=log.newcorrelationid();
  let parseresult=json.parse(reqbody);
  let parseok=mt parseresult {
    $ok:v true;
    $err:e false
  };
  if(parseok=false){
    log.error("proxy: failed to parse request body";"proxy";cid);
    <"{\"error\":\"invalid request body\"}"
  }el{};
  let parsed=mt parseresult {
    $ok:v v;
    $err:e v
  };
  let text=mt json.getstr(parsed;"prompt") {
    $ok:v v;
    $err:e mt json.getarr(parsed;"messages") {
      $ok:v2 json.arrtostr(v2);
      $err:e2 ""
    }
  };
  let piperun=pipe.run(text;pipecfg);
  let pipeok=mt piperun {
    $ok:v true;
    $err:e false
  };
  if(pipeok=false){
    log.error("proxy: pipeline error";"proxy";cid);
    <"{\"error\":\"pipeline failure\"}"
  }el{};
  let piperesult=mt piperun {
    $ok:v v;
    $err:e v
  };
  if(cfg.verbose){
    log.info(
      str.concat(
        "proxy: redacted ";
        str.concat(str.fromint(piperesult.entitycount);" entities")
      );
      "proxy";
      cid
    )
  }el{};
  if(cfg.dryrun){
    <"{\"content\":\"[dry-run: would send to LLM]\"}"
  }el{};
  let anonbody=json.setstr(parsed;"prompt";piperesult.anonymised);
  let anonreq=json.tostr(anonbody);
  let dispresult=disp.forward(anonreq;cfg.targettool);
  let dispok=mt dispresult {
    $ok:v true;
    $err:e false
  };
  if(dispok=false){
    log.error("proxy: dispatch error";"proxy";cid);
    <"{\"error\":\"upstream failure\"}"
  }el{};
  let rawresponse=mt dispresult {
    $ok:v v;
    $err:e v
  };
  let restored=mt pipe.restore(rawresponse;piperesult.mapping) {
    $ok:v v;
    $err:e rawresponse
  };
  <restored
};

f=start(cfg:$proxyconfig;lokecfg:i64):i32{
  let cid=log.newcorrelationid();

  out.printline(
    str.concat(
      "loke proxy listening on localhost:";
      str.concat(
        str.fromint(cfg.port);
        str.concat(" → intercepting ";cfg.targettool)
      )
    )
  );
  out.printline(
    str.concat(
      "Set your tool to use proxy: export ANTHROPIC_BASE_URL=http://localhost:";
      str.fromint(cfg.port)
    )
  );

  let pipecfg=pipe.defaultconfig();

  let session=$proxysession{
    id:log.newcorrelationid();
    tool:cfg.targettool;
    requestsintercepted:0;
    entitiesredacted:0;
    tokenssaved:0;
    startedat:net.nowunix()
  };

  let listenresult=net.listen(cfg.port);
  let listenok=mt listenresult {
    $ok:v true;
    $err:e false
  };
  if(listenok=false){
    out.printerror("proxy: failed to bind port");
    <1
  }el{};
  let listener=mt listenresult {
    $ok:v v;
    $err:e v
  };
  log.info(
    str.concat("proxy: listening on port ";str.fromint(cfg.port));
    "proxy";
    cid
  );
  let running=mut.true;
  lp(let lv=0;running;lv=lv){
    let acceptresult=net.accept(listener);
    let acceptok=mt acceptresult {
      $ok:v true;
      $err:e false
    };
    if(acceptok=false){
      log.error("proxy: accept error";"proxy";cid);
      running=false;
      net.close(listener)
    }el{
      let conn=mt acceptresult {
        $ok:v v;
        $err:e v
      };
      let reqbody=mt net.readbody(conn) {
        $ok:v v;
        $err:e ""
      };
      if(str.len(reqbody)>0){
        let response=handlerequest(reqbody;session;cfg;pipecfg);
        mt net.write(conn;response) {
          $ok:v 0;
          $err:e log.error(str.concat("proxy: write error — ";e);"proxy";cid)
        };
        session=$proxysession{
          id:session.id;
          tool:session.tool;
          requestsintercepted:session.requestsintercepted+1;
          entitiesredacted:session.entitiesredacted;
          tokenssaved:session.tokenssaved;
          startedat:session.startedat
        }
      }el{};
      net.closeconn(conn)
    }
  };

  out.printline("loke proxy shutdown");
  out.printline(
    str.concat(
      "session stats — requests intercepted: ";
      str.fromint(session.requestsintercepted)
    )
  );
  out.printline(
    str.concat(
      "session stats — entities redacted: ";
      str.fromint(session.entitiesredacted)
    )
  );
  out.printline(
    str.concat(
      "session stats — tokens saved: ";
      str.fromint(session.tokenssaved)
    )
  );

  <0
};

f=usage():str{
  <"usage: loke proxy <tool> [options]

tools:
  claude-code    intercept Claude Code traffic
  codex          intercept OpenAI Codex traffic
  gemini-cli     intercept Gemini CLI traffic

options:
  --port N       listen port (default: 11431)
  --verbose      log redacted entity counts per request
  --dry-run      intercept and anonymise but do not forward to LLM

example:
  loke proxy claude-code --verbose
  export ANTHROPIC_BASE_URL=http://localhost:11431"
};

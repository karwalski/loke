m=cli.report;
i=cfg:shared.config;
i=re:core.governance.reportengine;
i=ex:core.governance.reportexport;
i=sdb:core.storage.db;
i=cmd:cli.commands;
i=out:cli.output;
i=str:std.str;

(* GA5.31. `loke report generate` and `loke report templates`, dispatched from cli.main.
   This module was imported by nothing, so `loke report` did not exist although G4.4 named
   it. It printed through log.info, which writes ~/.loke/loke.log, so even reached it would
   have shown nothing; and its usage lines were translator keys that no locale defines. It
   now prints to stdout through cli.output, in plain text like every other command.

   The flags are parsed and checked by cli.commands.parsereport; this module checks the
   template against the engine, opens the store and prints the export. A report reads
   audit_log only, through core.governance.reportengine, and audit_log is designed to hold
   no raw value: what a report can print is event type, use case, model, provider,
   sensitivity, risk tier, cost and time. *)

f=handle(kind:str;args:@str;config:$lokeconfig):i64{
  if(str.eq(kind;"reporttemplates")){ <runtemplates() }el{};
  <rungenerate(args;config)
};

f=notbuilt():str{
  <"Not built: the regulatory templates G4.4 names (EU AI Act, Australian Privacy Act, HIPAA, GDPR, enterprise audit), PDF output, scheduling and the review workflow."
};

f=runtemplates():i64{
  out.printline("Report templates: \(re.templatelist())");
  out.printline(notbuilt());
  <0
};

(* The engine carries a report it could not produce inside a $report, by title or by
   summary, so a refusal is not mistaken for an empty period. *)
f=generated(r:$report):bool{
  <!str.eq(r.title;"Report not generated") && !str.contains(r.summary;"could not be queried")
};

f=notgenerated():$report{
  <$report{
    title:"Report not generated";
    reporttype:"";
    generatedat:"";
    periodstart:"";
    periodend:"";
    rows:@();
    summary:"";
    format:""
  }
};

f=rungenerate(args:@str;config:$lokeconfig):i64{
  let template=cmd.reporttemplate(args);
  if(re.knowntemplate(template)){}el{
    out.printerror("unknown report template: \(template). Available: \(re.templatelist())");
    out.printerror(notbuilt());
    <1
  };
  mt sdb.openstore(config.datadir) {
    $ok:st st;
    $err:e $store{conn:$dbconn{handle:0};datadir:""}
  };
  if(sdb.connectionlive()){}el{
    out.printerror("report not generated: the database at \(config.datadir) could not be opened");
    <1
  };
  let filter=$reportfilter{
    startdate:cmd.reportstart(args);
    enddate:cmd.reportend(args);
    reporttype:template;
    format:cmd.reportformat(args)
  };
  let report=mt re.generate(1;filter) {
    $ok:r r;
    $err:e notgenerated()
  };
  out.printline(ex.export(report));
  if(generated(report)){ <0 }el{};
  <1
};

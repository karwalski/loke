
m=cli.report;
i=re:core.governance.reportengine;
i=ex:core.governance.reportexport;
i=str:std.str;
i=log:shared.log;
i=tr:loke.platform.i18n.translator;

f=run(conn:i64;args:@$str{
  if(args.len<1){
    printusage();
    <0
  }el{
    let sub=args.get(0);
    if(str.eq(sub;"generate")){
      <rungenerate(conn;args)
    }el{
      if(str.eq(sub;"templates")){
        <runtemplates()
      }el{
        printusage();
        <1
      };
    };
  };
};

f=printusage():void{
  log.info(tr.t("loke.cli.report.usage");"cli.report";"system");
  log.info(tr.t("loke.cli.report.usage_generate");"cli.report";"system");
  log.info(tr.t("loke.cli.report.usage_templates");"cli.report";"system")
};

f=rungenerate(conn:i64;args:@$str{
  let template="compliance_summary";
  let start="2026-01-01";
  let end="2026-12-31";
  let format="text";
  let i=1;
  loop{
    if(i>=args.len){break}el{
      let flag=args.get(i);
      if(str.eq(flag;"--template")){
        if(i+1<args.len){template=args.get(i+1);i=i+2}el{i=i+1};
      }el{
        if(str.eq(flag;"--start")){
          if(i+1<args.len){start=args.get(i+1);i=i+2}el{i=i+1};
        }el{
          if(str.eq(flag;"--end")){
            if(i+1<args.len){end=args.get(i+1);i=i+2}el{i=i+1};
          }el{
            if(str.eq(flag;"--format")){
              if(i+1<args.len){format=args.get(i+1);i=i+2}el{i=i+1};
            }el{i=i+1};
          };
        };
      };
    };
  };
  let filter=$re.reportfilter{startdate:$start;enddate:$end;reporttype:$template;format:$format};
  let report=mt re.generate(conn;filter) {
    $ok:r r;
    $err:e {
      log.error(tr.t("loke.cli.report.generate_failed");"cli.report";"system");
      <1
    };
  };
  let output=ex.export(report);
  log.info(output;"cli.report";"system");
  <0
};

f=runtemplates():i64{
  log.info(tr.t("loke.cli.report.available");"cli.report";"system");
  log.info(tr.t("loke.cli.report.compliance_summary");"cli.report";"system");
  log.info(tr.t("loke.cli.report.pii_detection_log");"cli.report";"system");
  log.info(tr.t("loke.cli.report.routing_decisions");"cli.report";"system");
  log.info(tr.t("loke.cli.report.policy_changes");"cli.report";"system");
  log.info(tr.t("loke.cli.report.cost_savings");"cli.report";"system");
  <0
};

m=cli.init;


i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=file:std.file;
i=str:std.str;
i=http:std.http;
i=env:std.env;

t=$initresult{
  shellprofileupdated:bool;
  configdircreated:bool;
  ollamafound:bool;
  errors:@(str)
};

f=detectshell():str{
  let shellenv=mt env.get("SHELL") {
    $ok:v v;
    $err:e ""
  };
  if str.endswith(shellenv;"zsh"){
    <"zsh"
  };
  if str.endswith(shellenv;"bash"){
    <"bash"
  };
  <"unknown"
};

f=profilepath(shell:str):str{
  if str.eq(shell;"zsh"){
    <"~/.zshrc"
  };
  if str.eq(shell;"bash"){
    <"~/.bashrc"
  };
  <"~/.profile"
};

f=lokeshellsnippet():str{
  <str.concat(
    "
# loke — local intelligence layer
";
    str.concat(
      "export LOKE_HOME=\"$HOME/.loke\"
";
      str.concat(
        "export PATH=\"$LOKE_HOME/bin:$PATH\"
";
        "alias loke-proxy='loke proxy'
"
      )
    )
  )
};

f=run(datadir:str):$initresult{
  let errors=@();
  let configdircreated=false;
  let shellprofileupdated=false;
  let ollamafound=false;

  let lokedir="~/.loke";
  let lokebindir="~/.loke/bin";

  let mkdirresult=mt file.mkdir(lokedir) {
    $ok:v{
      let configdircreated=true
    };
    $err:e{
      let errors=@(errors;str.concat("could not create config dir: ";e))
    };
  };

  let mkdirbinresult=mt file.mkdir(lokebindir) {
    $ok:v ();
    $err:e{
      let errors=@(errors;str.concat("could not create bin dir: ";e))
    };
  };

  let shell=detectshell();
  let prof=profilepath(shell);
  let snippet=lokeshellsnippet();

  let profileresult=mt file.read(prof) {
    $ok:existing{
      if str.contains(existing;"LOKE_HOME"){
        let shellprofileupdated=false
      };
      if str.eq(str.containstostr(existing;"LOKE_HOME");"false"){
        let writeresult=file.append(prof;mt snippet) {
          $ok:v{
            let shellprofileupdated=true
          };
          $err:e{
            let errors=@(errors;str.concat("could not update shell profile: ";e))
          };
        };
      };
    };
    $err:e{
      let errors=@(errors;str.concat("could not read shell profile: ";e))
    };
  };

  let ollamaresult=mt http.get("http://localhost:11434/api/tags") {
    $ok:resp{
      if resp.status==200{
        let ollamafound=true
      };
    };
    $err:e{
      let ollamafound=false
    };
  };

  let tick="✓";
  let cross="✗";

  let diricon=if configdircreated{ tick } else { cross };
  out.printline(str.concat(diricon;" Config dir: ~/.loke/"));

  let proficon=if shellprofileupdated{ tick } else { cross };
  out.printline(
    str.concat(
      proficon;
      str.concat(" Shell profile: ";prof)
    )
  );

  let olicon=if ollamafound{ tick } else { cross };
  out.printline(str.concat(olicon;" Ollama: "));

  if ollamafound{
    out.printline("    Ollama is running at http://localhost:11434")
  };

  if str.eq(olicon;cross){
    out.printline("    Ollama not found — run: ollama serve")
  };

  <$initresult{
    shellprofileupdated:shellprofileupdated;
    configdircreated:configdircreated;
    ollamafound:ollamafound;
    errors:errors
  };
};

f=usage():str{
  <str.concat(
    "Usage: loke init
";
    str.concat(
      "
";
      str.concat(
        "Sets up loke for the current shell:
";
        str.concat(
          "  - Creates ~/.loke/ and ~/.loke/bin/
";
          str.concat(
            "  - Adds LOKE_HOME and PATH entry to your shell profile
";
            "  - Checks that Ollama is running
"
          )
        )
      )
    )
  )
};

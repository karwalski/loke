m=cli.init;

i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=file:std.file;
i=str:std.str;
i=http:std.http;
i=env:std.env;

t=$initresult{
  shellprofileupdated:bool;
  configdircreated:bool;
  ollamafound:bool;
  errors:@str
};

f=detectshell():str{
  let shellenv=mt env.get("SHELL") {
    $ok:v v;
    $err:e ""
  };
  if(str.endswith(shellenv;"zsh")){
    <"zsh"
  }el if(str.endswith(shellenv;"bash")){
    <"bash"
  }el{
    <"unknown"
  }
};

f=profilepath(shell:str):str{
  if(str.eq(shell;"zsh")){
    <"~/.zshrc"
  }el if(str.eq(shell;"bash")){
    <"~/.bashrc"
  }el{
    <"~/.profile"
  }
};

f=lokeshellsnippet():str{
  <str.concat(
    "
# loke — local intelligence layer
";
    str.concat(
      "export LOKE_HOME=\"$HOME/.loke\"
";
      str.concat(
        "export PATH=\"$LOKE_HOME/bin:$PATH\"
";
        "alias loke-proxy='loke proxy'
"
      )
    )
  )
};

f=run(datadir:str):$initresult{
  let errors=mut.@();
  let configdircreated=mut.false;
  let shellprofileupdated=mut.false;
  let ollamafound=mut.false;

  let lokedir="~/.loke";
  let lokebindir="~/.loke/bin";

  mt file.mkdir(lokedir) {
    $ok:v configdircreated=true;
    $err:e errors=str.arraypush(errors;str.concat("could not create config dir: ";e))
  };

  mt file.mkdir(lokebindir) {
    $ok:v 0;
    $err:e errors=str.arraypush(errors;str.concat("could not create bin dir: ";e))
  };

  let shell=detectshell();
  let prof=profilepath(shell);
  let snippet=lokeshellsnippet();

  mt file.read(prof) {
    $ok:existing if(str.contains(existing;"LOKE_HOME")){ 0 }el{
      mt file.append(prof;snippet) {
        $ok:v shellprofileupdated=true;
        $err:e errors=str.arraypush(errors;str.concat("could not update shell profile: ";e))
      }
    };
    $err:e errors=str.arraypush(errors;str.concat("could not read shell profile: ";e))
  };

  mt http.get("http://localhost:11434/api/tags") {
    $ok:resp if(resp.status=200){ ollamafound=true }el{ 0 };
    $err:e 0
  };

  let tick="+";
  let cross="x";

  let diricon=if(configdircreated){ tick }el{ cross };
  out.printline(str.concat(diricon;" Config dir: ~/.loke/"));

  let proficon=if(shellprofileupdated){ tick }el{ cross };
  out.printline(
    str.concat(
      proficon;
      str.concat(" Shell profile: ";prof)
    )
  );

  let olicon=if(ollamafound){ tick }el{ cross };
  out.printline(str.concat(olicon;" Ollama: "));

  if(ollamafound){
    out.printline("    Ollama is running at http://localhost:11434")
  }el{};

  if(!ollamafound){
    out.printline("    Ollama not found — run: ollama serve")
  }el{};

  <$initresult{
    shellprofileupdated:shellprofileupdated;
    configdircreated:configdircreated;
    ollamafound:ollamafound;
    errors:errors
  }
};

f=usage():str{
  <str.concat(
    "Usage: loke init
";
    str.concat(
      "
";
      str.concat(
        "Sets up loke for the current shell:
";
        str.concat(
          "  - Creates ~/.loke/ and ~/.loke/bin/
";
          str.concat(
            "  - Adds LOKE_HOME and PATH entry to your shell profile
";
            "  - Checks that Ollama is running
"
          )
        )
      )
    )
  )
};

m=cli.init;

i=t:shared.types;
i=out:cli.output;
i=file:std.file;
i=str:std.str;
i=env:std.env;
i=reach:shared.reachability;

t=$initresult{
  shellprofileupdated:bool;
  configdircreated:bool;
  ollamafound:bool;
  errors:@str
};

f=detectshell():str{
  let shellenv=mt env.get("SHELL") {
    $ok:v v;
    $err:e ""
  };
  if(str.endswith(shellenv;"zsh")){
    <"zsh"
  }el{ if(str.endswith(shellenv;"bash")){
    <"bash"
  }el{
    <"unknown"
  }}
};

f=profilepath(shell:str):str{
  if(str.eq(shell;"zsh")){
    <t.homepath("/.zshrc")
  }el{ if(str.eq(shell;"bash")){
    <t.homepath("/.bashrc")
  }el{
    <t.homepath("/.profile")
  }}
};

f=lokeshellsnippet():str{
  <str.concat(
    "
# loke — local intelligence layer
";
    str.concat(
      "export LOKE_HOME=\"$HOME/.loke\"
";
      str.concat(
        "export PATH=\"$LOKE_HOME/bin:$PATH\"
";
        "alias loke-proxy='loke proxy'
"
      )
    )
  )
};

(* X4b.10. The snippet is added to a profile that exists and does not already set up loke.
   An empty or missing profile is left alone, as before: init does not create one. *)
f=needssnippet(existing:str):bool{
  <str.len(existing)>0 && !str.contains(existing;"LOKE_HOME")
};

(* VM1.6h. This matched the one-argument `http.get`, which answers the response BODY, and read
   `.status` off it as if it were a response struct. Measured against
   scripts/lib/http_recorder.py: the GET arrived, the "status" was the first eight bytes of
   `{"models` read as an integer, and an answering Ollama was reported as not found. No status
   is visible through that call; the body is, and Ollama's /api/tags always carries a
   `models` array. *)
f=ollamarunning(baseurl:str):bool{
  <str.contains(reach.localget(baseurl;"/api/tags");"\"models\"")
};

f=run(datadir:str):$initresult{
  let errors=mut.@();
  let configdircreated=mut.false;
  let shellprofileupdated=mut.false;
  let ollamafound=mut.false;

  let lokedir=t.lokedir();
  let lokebindir=t.lokefile("bin");

  (* X4b.10. Both results were matched and dropped, and the errors were pushed inside the
     arms and thrown away (T-24), so configdircreated was false on every run and no error
     was ever reported. *)
  configdircreated=mt file.mkdir(lokedir) {
    $ok:v true;
    $err:e false
  };
  if(configdircreated){}el{ errors=errors.push("could not create config dir") };
  let bindirok=mt file.mkdir(lokebindir) {
    $ok:v true;
    $err:e false
  };
  if(bindirok){}el{ errors=errors.push("could not create bin dir") };

  let shell=detectshell();
  let prof=profilepath(shell);
  let snippet=lokeshellsnippet();

  let existing=mt file.read(prof) {
    $ok:text text;
    $err:e ""
  };
  if(needssnippet(existing)){
    let appendok=mt file.append(prof;snippet) {
      $ok:v true;
      $err:e false
    };
    if(appendok){
      shellprofileupdated=true
    }el{
      errors=errors.push("could not update shell profile")
    }
  }el{};

  (* http.get against a closed port returns $ok with a nil response (T-15), and the
     status read that followed dereferenced it whenever Ollama was not running. *)
  ollamafound=ollamarunning("http://localhost:11434");

  let tick="+";
  let cross="x";

  let diricon=mut.cross; if(configdircreated){ diricon=tick }el{};
  out.printline(str.concat(diricon;" Config dir: ~/.loke/"));

  let proficon=mut.cross; if(shellprofileupdated){ proficon=tick }el{};
  out.printline(
    str.concat(
      proficon;
      str.concat(" Shell profile: ";prof)
    )
  );

  let olicon=mut.cross; if(ollamafound){ olicon=tick }el{};
  out.printline(str.concat(olicon;" Ollama: "));

  if(ollamafound){
    out.printline("    Ollama is running at http://localhost:11434")
  }el{};

  if(!ollamafound){
    out.printline("    Ollama not found — run: ollama serve")
  }el{};

  <$initresult{
    shellprofileupdated:shellprofileupdated;
    configdircreated:configdircreated;
    ollamafound:ollamafound;
    errors:errors
  }
};

f=usage():str{
  <str.concat(
    "Usage: loke init
";
    str.concat(
      "
";
      str.concat(
        "Sets up loke for the current shell:
";
        str.concat(
          "  - Creates ~/.loke/ and ~/.loke/bin/
";
          str.concat(
            "  - Adds LOKE_HOME and PATH entry to your shell profile
";
            "  - Checks that Ollama is running
"
          )
        )
      )
    )
  )
};

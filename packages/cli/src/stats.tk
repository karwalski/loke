
m=cli.stats;
i=mc:core.metrics.collector;
i=str:std.str;
i=log:shared.log;
i=tr:loke.platform.i18n.translator;

f=run(conn:$dbconn):i64{
  log.info(tr.t("loke.cli.stats.dashboard");"cli.stats";"system");
  log.info(tr.t("loke.cli.stats.separator");"cli.stats";"system");
  let summary=mt mc.summarise(conn) {
    $ok:s s;
    $err:e {
      log.error(tr.t("loke.cli.stats.load_failed");"cli.stats";"system");
      <1
    };
  };
  log.info("";"cli.stats";"system");
  log.info(str.concat(tr.t("loke.cli.stats.total_requests");str.fromint(summary.totalrequests));"cli.stats";"system");
  log.info(str.concat(tr.t("loke.cli.stats.tokens_saved");str.fromint(summary.totaltokenssaved));"cli.stats";"system");
  log.info(str.concat(tr.t("loke.cli.stats.cost_saved");str.fromfloat(summary.totalcostsavedusd));"cli.stats";"system");
  log.info(str.concat(tr.t("loke.cli.stats.pii_intercepted");str.fromint(summary.totalpiiintercepted));"cli.stats";"system");
  log.info("";"cli.stats";"system");
  log.info(str.concat(tr.t("loke.cli.stats.local_requests");str.concat(str.fromint(summary.localrequests);str.concat(" (";str.concat(str.fromfloat(summary.localratio);"%)"))));"cli.stats";"system");
  log.info(str.concat(tr.t("loke.cli.stats.cloud_requests");str.fromint(summary.cloudrequests));"cli.stats";"system");
  log.info(str.concat(tr.t("loke.cli.stats.cache_hit_rate");str.concat(str.fromfloat(summary.cachehitrate);"%"));"cli.stats";"system");
  log.info("";"cli.stats";"system");
  <0
};

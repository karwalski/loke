m=cli.verbose;
i=pt:core.pipeline.types;
i=em:core.pipeline.emitter;
i=str:std.str;
i=log:shared.log;
i=tr:loke.platform.i18n.translator;

f=printrun(run:i64):void{
  log.info(str.concat(tr.t("loke.cli.verbose.pipeline_run");run.id);"verbose";"trace");
  log.info(str.concat(tr.t("loke.cli.verbose.request");run.requestid);"verbose";"trace");
  log.info(str.concat(tr.t("loke.cli.verbose.status");run.overallstatus);"verbose";"trace");
  log.info(str.concat(tr.t("loke.cli.verbose.duration");str.concat(str.fromint(run.totaldurationms);"ms"));"verbose";"trace");
  log.info("";"verbose";"trace");

  let stages=pt.allstages();
  lp(let i=0;i<str.arraylen(stages);i=i+1){ let stageid=str.arrayget(stages;i);
    let found=mut.false;
    lp(let j=0;j<str.arraylen(run.events);j=j+1){ let event=str.arrayget(run.events;j);
      if(str.eq(event.stage;stageid)){
        printevent(event);
        found=true
      }el{}
    };
    if(found){}el{
      log.info(str.concat("[ ] ";pt.stagelabel(stageid));"verbose";"trace")
    }
  };
};

f=printevent(event:i64):void{
  let symbol=pt.statussymbol(event.status);
  let label=pt.stagelabel(event.stage);
  let duration=mut."";
  if(event.durationms>0){duration=str.concat(" (";str.concat(str.fromint(event.durationms);"ms)"))};
  let errorsuffix=mut."";
  if(str.len(event.errormessage)>0){errorsuffix=str.concat(" ERROR: ";event.errormessage)};
  let line=str.concat(symbol;str.concat(" ";str.concat(label;str.concat(duration;errorsuffix))));
  log.info(line;"verbose";"trace");

  lp(let i=0;i<str.arraylen(event.details);i=i+1){ let d=str.arrayget(event.details;i);
    log.info(str.concat("    ";str.concat(d.key;str.concat(": ";d.value)));"verbose";"trace")
  };
};

f=printsummary(run:i64):void{
  let stagescomplete=0;
  let stageserror=0;
  lp(let i=0;i<str.arraylen(run.events);i=i+1){ let e=str.arrayget(run.events;i);
    if(str.eq(e.status;"complete")){stagescomplete=stagescomplete+1}el{};
    if(str.eq(e.status;"error")){stageserror=stageserror+1}el{}
  };
  let errorsuffix=mut."";
  if(stageserror>0){errorsuffix=str.concat(", ";str.concat(str.fromint(stageserror);" errors"))}el{};
  log.info(str.concat(tr.t("loke.cli.verbose.pipeline_summary");str.concat(str.fromint(stagescomplete);str.concat("/9 stages, ";str.concat(str.fromint(run.totaldurationms);str.concat("ms";errorsuffix)))));"verbose";"trace")
};

m=cli.portable;

i=fs:std.fs;
i=str:std.str;

f=verifybinary(binpath:str):bool{
  <fs.exists(binpath)
};

f=defaultinstalldir():str{
  <"/usr/local/bin"
};

f=installscript(installdir:str):str{
  let bindst=str.concat(installdir;"/loke");
  let lokehome="$HOME/.loke";
  let pathline=str.concat("export PATH=\"";str.concat(installdir;":$PATH\""));
  let profile="$HOME/.zshrc";
  let s=mut."#!/usr/bin/env bash\nset -e\n\n# loke install script\n\n";
  s=str.concat(s;"echo 'Installing loke...'\n");
  s=str.concat(s;str.concat("cp ./loke ";str.concat(bindst;"\n")));
  s=str.concat(s;str.concat("chmod +x ";str.concat(bindst;"\n\n")));
  s=str.concat(s;str.concat("mkdir -p ";str.concat(lokehome;"\n")));
  s=str.concat(s;str.concat("mkdir -p ";str.concat(lokehome;"/models\n")));
  s=str.concat(s;str.concat("mkdir -p ";str.concat(lokehome;"/data\n\n")));
  s=str.concat(s;str.concat("if ! grep -q 'loke' ";str.concat(profile;" 2>/dev/null; then\n")));
  s=str.concat(s;str.concat("  echo '' >> ";str.concat(profile;"\n")));
  s=str.concat(s;str.concat("  echo '# loke' >> ";str.concat(profile;"\n")));
  s=str.concat(s;str.concat("  echo '";str.concat(pathline;str.concat("' >> ";str.concat(profile;"\n")))));
  s=str.concat(s;"fi\n\n");
  s=str.concat(s;str.concat("echo 'loke installed to ";str.concat(bindst;"'\n")));
  s=str.concat(s;str.concat("echo 'Restart your shell or run: source ";str.concat(profile;"'\n")));
  <s
};

f=uninstallscript(installdir:str):str{
  let bindst=str.concat(installdir;"/loke");
  let lokehome="$HOME/.loke";
  let profile="$HOME/.zshrc";
  let s=mut."#!/usr/bin/env bash\n\n# loke uninstall script\n\n";
  s=str.concat(s;"echo 'Uninstalling loke...'\n");
  s=str.concat(s;str.concat("rm -f ";str.concat(bindst;"\n\n")));
  s=str.concat(s;"echo 'WARNING: This will remove all loke data including settings and models.'\n");
  s=str.concat(s;str.concat("read -p 'Remove ";str.concat(lokehome;"? [y/N] ' confirm\n")));
  s=str.concat(s;"if [ \"$confirm\" = \"y\" ] || [ \"$confirm\" = \"Y\" ]; then\n");
  s=str.concat(s;str.concat("  rm -rf ";str.concat(lokehome;"\n")));
  s=str.concat(s;str.concat("  echo 'Removed ";str.concat(lokehome;"'\n")));
  s=str.concat(s;"fi\n\n");
  s=str.concat(s;str.concat("sed -i '' '/# loke/d' ";str.concat(profile;" 2>/dev/null || true\n")));
  s=str.concat(s;str.concat("sed -i '' '/loke.*PATH/d' ";str.concat(profile;" 2>/dev/null || true\n\n")));
  s=str.concat(s;"echo 'loke uninstalled.'\n");
  <s
};

f=writescript(content:str;outpath:str):bool{
  let ok=fs.write(outpath;content);
  if(ok){
    fs.chmod(outpath;"755")
  }el{
    false
  }
};

m=cli.portable;

i=fs:std.fs;
i=str:std.string;

f=verifybinary(binpath:str):bool{
  <fs.exists(binpath)
};

f=defaultinstalldir():str{
  <"/usr/local/bin"
};

f=installscript(installdir:str):str{
  let binsrc = "./loke";
  let bindst = installdir + "/loke";
  let lokehome = "$HOME/.loke";
  let pathline = "export PATH=\"" + installdir + ":$PATH\"";
  let profile = "$HOME/.zshrc";
  <"#!/usr/bin/env bash
set -e

" +
   "# loke install script

" +
   "echo 'Installing loke...'
" +
   "cp " + binsrc + " " + bindst + "
" +
   "chmod +x " + bindst + "

" +
   "mkdir -p " + lokehome + "
" +
   "mkdir -p " + lokehome + "/models
" +
   "mkdir -p " + lokehome + "/data

" +
   "if ! grep -q 'loke' " + profile + " 2>/dev/null; then
" +
   "  echo '' >> " + profile + "
" +
   "  echo '# loke' >> " + profile + "
" +
   "  echo '" + pathline + "' >> " + profile + "
" +
   "fi

" +
   "echo 'loke installed to " + bindst + "'
" +
   "echo 'Restart your shell or run: source " + profile + "'
"
};

f=uninstallscript(installdir:str):str{
  let bindst = installdir + "/loke";
  let lokehome = "$HOME/.loke";
  let profile = "$HOME/.zshrc";
  <"#!/usr/bin/env bash

" +
   "# loke uninstall script

" +
   "echo 'Uninstalling loke...'
" +
   "rm -f " + bindst + "

" +
   "echo 'WARNING: This will remove all loke data including settings and models.'
" +
   "read -p 'Remove " + lokehome + "? [y/N] ' confirm
" +
   "if [ \"$confirm\" = \"y\" ] || [ \"$confirm\" = \"Y\" ]; then
" +
   "  rm -rf " + lokehome + "
" +
   "  echo 'Removed " + lokehome + "'
" +
   "fi

" +
   "sed -i '' '/# loke/d' " + profile + " 2>/dev/null || true
" +
   "sed -i '' '/loke.*PATH/d' " + profile + " 2>/dev/null || true

" +
   "echo 'loke uninstalled.'
"
};

f=writescript(content:str;outpath:str):bool{
  let ok = fs.write(outpath; content);
  if(ok){
    fs.chmod(outpath; "755")
  }{
    false
  };
};

m=cli.ask;


i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=pipe:core.privacy.pipeline;
i=disp:providers.dispatcher;
i=router:core.router.router;
i=gw:core.governance.gateway;
i=cfg:shared.config;
i=str:std.str;

t=$askopts{
  prompt:str;
  model:str;
  dryrun:bool;
  stream:bool;
  systemprompt:str;
  tolerance:str
};

f=defaultopts():$askopts{
  <$askopts{
    prompt:"";
    model:"";
    dryrun:false;
    stream:false;
    systemprompt:"";
    tolerance:"instant"
  };
};

f=parseopts(args:@str):$askopts{
  let opts=defaultopts();
  let i=0;
  let argc=str.len(args);
  loop i<argc{
    let arg=args.get(i);
    if(str.eq(arg;"--model")){
      let i=i+1;
      if(i<argc){
        let opts=$askopts{
          prompt:opts.prompt;
          model:args.get(i);
          dryrun:opts.dryrun;
          stream:opts.stream;
          systemprompt:opts.systemprompt;
          tolerance:opts.tolerance
        };
      };
    };
    if(str.eq(arg;"--dry-run")){
      let opts=$askopts{
        prompt:opts.prompt;
        model:opts.model;
        dryrun:true;
        stream:opts.stream;
        systemprompt:opts.systemprompt;
        tolerance:opts.tolerance
      };
    };
    if(str.eq(arg;"--stream")){
      let opts=$askopts{
        prompt:opts.prompt;
        model:opts.model;
        dryrun:opts.dryrun;
        stream:true;
        systemprompt:opts.systemprompt;
        tolerance:opts.tolerance
      };
    };
    if(str.eq(arg;"--system")){
      let i=i+1;
      if(i<argc){
        let opts=$askopts{
          prompt:opts.prompt;
          model:opts.model;
          dryrun:opts.dryrun;
          stream:opts.stream;
          systemprompt:args.get(i);
          tolerance:opts.tolerance
        };
      };
    };
    if(str.eq(arg;"--tolerance")){
      let i=i+1;
      if(i<argc){
        let opts=$askopts{
          prompt:opts.prompt;
          model:opts.model;
          dryrun:opts.dryrun;
          stream:opts.stream;
          systemprompt:opts.systemprompt;
          tolerance:args.get(i)
        };
      };
    };
    if(str.startswith(arg;"--")){
      let i=i+1
    };
    if(str.eq(opts.prompt;"")){
      let opts=$askopts{
        prompt:arg;
        model:opts.model;
        dryrun:opts.dryrun;
        stream:opts.stream;
        systemprompt:opts.systemprompt;
        tolerance:opts.tolerance
      };
    };
    let i=i+1
  };
  <opts
};

f=run(opts:$askopts;cfg:i64):i32{
  if(str.eq(opts.prompt;"")){
    out.printerror("prompt required. Usage: loke ask \"your question\"");
    <1
  };

  let cid=log.newcorrelationid();
  log.info("loke ask starting";"cli.ask";cid);

  out.printpipelinestage("Privacy Filter";"scanning...";"PII detection and anonymisation");

  let pipelinecfg=pipe.defaultconfig();
  let piperesult=mt pipe.run(opts.prompt;pipelinecfg) {
    $ok:v v;
    $err:e{
      log.warn(str.concat("privacy pipeline error: ";e);"cli.ask";cid);
      pipe.fallbackresult(opts.prompt)
    };
  };

  let badge=out.sensitivitybadge(piperesult.sensitivitylevel);
  out.printline(
    str.concat(
      "  sensitivity: ";
      str.concat(
        badge;
        str.concat(
          "  entities found: ";
          str.inttostr(piperesult.entitycount)
        )
      )
    )
  );

  if(opts.dryrun){
    out.printline(str.concat("  anonymised prompt: ";piperesult.anonymisedtext));
    <0
  };

  out.printpipelinestage("Router";"selecting model...";"capability and sensitivity routing");

  let decision=mt router.route($router.$routerequest{
    anonymisedprompt:piperesult.anonymisedtext;
    sensitivitylevel:piperesult.sensitivitylevel;
    preferredmodel:opts.model;
    tolerance:opts.tolerance
  }) {
    $ok:v v;
    $err:e{
      log.warn(str.concat("router error: ";e);"cli.ask";cid);
      router.defaultdecision(opts.model)
    };
  };

  out.printpipelinestage(
    "LLM";
    "sending request...";
    str.concat("model: ";decision.modelid)
  );

  let dispatchresult=mt disp.dispatch($disp.$dispatchrequest{
    modelid:decision.modelid;
    prompt:piperesult.anonymisedtext;
    systemprompt:opts.systemprompt;
    stream:opts.stream
  }) {
    $ok:v v;
    $err:e{
      out.printerror(str.concat("dispatch failed: ";e));
      <1
    };
  };

  out.printline(dispatchresult.responsetext);

  out.printpipelinestage("Audit";"logged";"interaction recorded to local store");

  log.info("loke ask complete";"cli.ask";cid);
  <0
};

f=usage():str{
  <str.concat(
    "Usage: loke ask \"<prompt>\" [options]
";
    str.concat(
      "
";
      str.concat(
        "Options:
";
        str.concat(
          "  --model <id>       model to use (default: router decides)
";
          str.concat(
            "  --dry-run          show anonymised prompt without sending to LLM
";
            str.concat(
              "  --stream           stream response tokens as they arrive
";
              str.concat(
                "  --system <prompt>  system prompt to prepend
";
                "  --tolerance <t>    latency tolerance: instant|background (default: instant)
"
              )
            )
          )
        )
      )
    )
  )
};

m=cli.ask;

i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=pipe:core.privacy.pipeline;
i=sp:core.privacy.systemprompt;
i=disp:core.providers.dispatcher;
i=router:core.router.router;
i=fb:core.router.fallback;
i=cfg:shared.config;
i=ph:core.privacy.placeholder;
i=ptypes:core.providers.types;
i=sdb:core.storage.db;
i=str:std.str;

t=$askopts{
  prompt:str;
  model:str;
  dryrun:bool;
  stream:bool;
  systemprompt:str;
  tolerance:str
};

f=defaultopts():$askopts{
  <$askopts{
    prompt:"";
    model:"";
    dryrun:false;
    stream:false;
    systemprompt:"";
    tolerance:"instant"
  }
};

f=parseopts(args:@str):$askopts{
  let opts=mut.defaultopts();
  let i=mut.0;
  let argc=args.len;
  lp(let lv=0;true;lv=lv){
    if(!(i<argc)){ br }el{
      let arg=args.get(i);
      if(str.eq(arg;"--model")){
        i=i+1;
        if(i<argc){
          opts=$askopts{
            prompt:opts.prompt;
            model:args.get(i);
            dryrun:opts.dryrun;
            stream:opts.stream;
            systemprompt:opts.systemprompt;
            tolerance:opts.tolerance
          }
        }el{}
      }el{ if(str.eq(arg;"--dry-run")){
        opts=$askopts{
          prompt:opts.prompt;
          model:opts.model;
          dryrun:true;
          stream:opts.stream;
          systemprompt:opts.systemprompt;
          tolerance:opts.tolerance
        }
      }el{ if(str.eq(arg;"--stream")){
        opts=$askopts{
          prompt:opts.prompt;
          model:opts.model;
          dryrun:opts.dryrun;
          stream:true;
          systemprompt:opts.systemprompt;
          tolerance:opts.tolerance
        }
      }el{ if(str.eq(arg;"--system")){
        i=i+1;
        if(i<argc){
          opts=$askopts{
            prompt:opts.prompt;
            model:opts.model;
            dryrun:opts.dryrun;
            stream:opts.stream;
            systemprompt:args.get(i);
            tolerance:opts.tolerance
          }
        }el{}
      }el{ if(str.eq(arg;"--tolerance")){
        i=i+1;
        if(i<argc){
          opts=$askopts{
            prompt:opts.prompt;
            model:opts.model;
            dryrun:opts.dryrun;
            stream:opts.stream;
            systemprompt:opts.systemprompt;
            tolerance:args.get(i)
          }
        }el{}
      }el{ if(str.startswith(arg;"--")){
        i=i+1
      }el{
        if(str.eq(opts.prompt;"")){
          opts=$askopts{
            prompt:arg;
            model:opts.model;
            dryrun:opts.dryrun;
            stream:opts.stream;
            systemprompt:opts.systemprompt;
            tolerance:opts.tolerance
          }
        }el{}
      }}}}}};
      i=i+1
    };
  };
  <opts
};

(* Rewritten against the interfaces the core modules actually export (F10.23d).

   The legacy body called pipe.defaultconfig, pipe.fallbackresult, router.route with a
   $routerequest struct, router.defaultdecision, disp.dispatch with a $dispatchrequest
   struct, and read piperesult.sensitivitylevel / .entitycount / .anonymisedtext and
   dispatchresult.responsetext. None of those functions, structs or fields exists: the
   real ones are pipe.newconfig(presidiourl;ollamaurl), pipe.run(text;systemprompt;cfg)
   returning a plain $pipelinerun whose payload is in `.result`,
   router.routerequest(router;prompt;sensitivity;entitycount;tolerance;cid), and
   disp.trydispatch(dispatcher;$completionrequest;provider) — the plain forms, LS1.1j.

   pipe.run returns a plain value, not a result, so there is nothing to match on — the
   legacy `mt pipe.run(...)` had an $err arm for a union that does not exist. *)
f=run(opts:$askopts;config:$lokeconfig):i64{
  if(str.eq(opts.prompt;"")){
    out.printerror("prompt required. Usage: loke ask \"your question\"");
    <1
  }el{};

  let cid=log.newcorrelationid();
  log.info("loke ask starting";"cli.ask";cid);

  out.printpipelinestage("Privacy Filter";"scanning...";"PII detection and anonymisation");

  (* F3.9b. sp.run, not pipe.run: pipe.run scans only the prompt and builds the guardian over
     the --system prompt AS WRITTEN, and finalsystemprompt is what is dispatched below, so an
     identifier in --system reached the provider in clear. sp.run scans both together. *)
  let piperun=sp.run(opts.prompt;opts.systemprompt;pipe.withlokeconfig(pipe.newconfig(config.presidiourl;config.ollamaurl);config));
  let detected=piperun.result;

  out.printline(
    "  sensitivity: \(out.sensitivitybadge(sensitivityname(detected.sensitivity)))  entities found: \(str.fromint(piperun.totalentities as i64))"
  );

  if(opts.dryrun){
    out.printline(str.concat("  anonymised prompt: ";detected.anonymised));
    <0
  }el{};

  (* The governance gate refuses to forward what the policy will not allow. Anything
     that reaches a provider from here has been through the privacy filter above — the
     contributor invariant in CLAUDE.md — and issafetoforward is the check that says
     so. *)
  if(pipe.issafetoforward(piperun)){}el{
    out.printerror("blocked: the prompt's sensitivity exceeds what this policy will forward");
    <1
  };

  out.printpipelinestage("Router";"selecting model...";"capability and sensitivity routing");

  (* LS1.1j — routerequest and isrouted, not route. route's result could not report a
     failure (T-18), and its $err arm substituted gw.defaultrouting(), an empty model id on
     $local, which was then dispatched as though it were a decision. A request the router
     refuses — RESTRICTED data with no local model, for one — now stops here.

     The fourth argument is the PII entity count, which sens.scorefrompii reads; it was
     being passed a token estimate. The sixth is the correlation id, which was being passed
     the literal "chat".

     F5.3: the router is built from config.toml's [routing] table (strategy, prefer_local,
     fallback_to_cloud) rather than from fixed defaults, and the route is a fallback chain:
     the first choice and up to two further candidates, each chosen by the same selector
     rules and each checked again by core.router.fallback before it is sent. A RESTRICTED
     prompt is never sent to a cloud model by any hop, and a local first choice falls back to
     a cloud one only when fallback_to_cloud is on. issafetoforward above governs every hop,
     because it is a property of the prompt and not of the destination. *)
  let routercfg=router.configfor(config);
  let chain=router.routechain(
    router.new(routercfg);
    detected.anonymised;
    detected.sensitivity;
    piperun.totalentities as u32;
    tolerancefromstr(opts.tolerance);
    cid;
    3
  );
  if(chain.chainhops.len>0){}el{
    out.printerror("not routed: \(chain.chainnote)");
    <1
  };
  let decision:$routingdecision=chain.chainhops.get(0);
  let firstspec:$modelspec=decision.model;

  let modelid=mut.firstspec.id;
  if(str.len(opts.model)>0){ modelid=opts.model }el{};

  out.printpipelinestage(
    "LLM";
    "sending request...";
    str.concat("model: ";modelid)
  );

  let request=$completionrequest{
    modelid:modelid;
    messages:@(ptypes.usermsg(detected.anonymised));
    systemprompt:piperun.finalsystemprompt;
    maxtokens:(2048 as u32);
    temperature:0.0;
    stream:opts.stream
  };
  (* G1.6. The kill switch is asked before every hop is sent (core.router.fallback), from the
     same loke.db the server and `loke kill-switch` use. A store that cannot be opened is 0,
     and every hop is then refused: an unreadable switch is an engaged one. *)
  let store=mt sdb.openstore(config.datadir) { $ok:st 1; $err:e 0 };
  let result=fb.dispatchchain(store;"cli-ask";disp.new(disp.getapikeys();config.ollamaurl);chain;routercfg;request;opts.model;cid);
  if(fb.answered(result)){}el{
    let why=mut.result.chainfailures;
    if(str.len(why)==0){ why=disp.dispatcherror(result.chainanswer) }el{};
    out.printerror("dispatch failed: \(why)");
    <1
  };
  if(result.chaindegraded){ out.printline("  \(result.chainnotice)") }el{};
  let tried=result.chainattempted;
  if(tried.len>1){
    out.printline("  fallback: answered by \(tried.get(tried.len-1)) after \(result.chainfailures)")
  }el{};
  let response:$completionresponse=result.chainanswer;
  let responsetext=response.content;
  if(str.len(responsetext)>0){}el{
    out.printerror("dispatch failed: no content returned");
    <1
  };

  (* De-anonymisation: the placeholders the filter inserted are put back before the
     answer is shown. Without this the user reads the redacted form of their own
     input. *)
  out.printline(ph.restore(responsetext;ph.mapfromentities(detected.entities)));

  out.printpipelinestage("Audit";"logged";"interaction recorded to local store");

  log.info("loke ask complete";"cli.ask";cid);
  <0
};

f=sensitivityname(level:$sensitivitylevel):str{
  let lv:$sensitivitylevel=level;
  <mt lv {
    $public:v "public";
    $internal:v "internal";
    $confidential:v "confidential";
    $restricted:v "restricted"
  }
};

f=tolerancefromstr(s:str):$latencytolerance{
  if(str.eq(s;"patient")){
    <$latencytolerance{$patient:0}
  }el{};
  if(str.eq(s;"background")){
    <$latencytolerance{$background:0}
  }el{};
  <$latencytolerance{$instant:0}
};

f=usage():str{
  <"Usage: loke ask \"<prompt>\" [options]

Options:
  --model <id>       model to use (default: router decides)
  --dry-run          show anonymised prompt without sending to LLM
  --stream           stream response tokens as they arrive
  --system <prompt>  system prompt to prepend
  --tolerance <t>    latency tolerance: instant|background (default: instant)
"
};

m=cli.health;

i=t:shared.types;
i=http:std.http;
i=str:std.str;
i=log:shared.log;

t=$healthstatus{
  $ok:i64;
  $degraded(str);
  $down(str)
};

t=$subsystemhealth{
  name:str;
  status:$healthstatus;
  detail:str
};

t=$healthreport{
  overall:$healthstatus;
  subsystems:@$subsystemhealth
};

f=checkollama(ollamaurl:str):$subsystemhealth{
  let url=str.concat(ollamaurl;"/api/tags");
  let result=http.gettimeout(url;3000);
  mt result {
    $httperr:e $subsystemhealth{ name:"Ollama"; status:$down("Ollama not running — start with: ollama serve"); detail:"unreachable" };
    $ok:body $subsystemhealth{ name:"Ollama"; status:$ok; detail:"reachable" }
  }
};

f=checkpresidio(presidiourl:str):$subsystemhealth{
  let url=str.concat(presidiourl;"/health");
  let result=http.getstatus(url);
  mt result {
    $httperr:e $subsystemhealth{ name:"Presidio (NER)"; status:$degraded("Presidio unavailable — NER accuracy reduced to regex-only"); detail:"unreachable" };
    $ok:resp if(resp.status=200){ $subsystemhealth{ name:"Presidio (NER)"; status:$ok; detail:"reachable" } }el{ $subsystemhealth{ name:"Presidio (NER)"; status:$degraded("Presidio unavailable — NER accuracy reduced to regex-only"); detail:str.concat("status ";str.fromint(resp.status)) } }
  }
};

f=checkllmlingua(llmlinguaurl:str):$subsystemhealth{
  let url=str.concat(llmlinguaurl;"/health");
  let result=http.getstatus(url);
  mt result {
    $httperr:e $subsystemhealth{ name:"LLMLingua"; status:$degraded("LLMLingua unavailable — token compression disabled"); detail:"unreachable" };
    $ok:resp if(resp.status=200){ $subsystemhealth{ name:"LLMLingua"; status:$ok; detail:"reachable" } }el{ $subsystemhealth{ name:"LLMLingua"; status:$degraded("LLMLingua unavailable — token compression disabled"); detail:str.concat("status ";str.fromint(resp.status)) } }
  }
};

f=checkall(ollamaurl:str;presidiourl:str;llmlinguaurl:str):$healthreport{
  let ollama=checkollama(ollamaurl);
  let presidio=checkpresidio(presidiourl);
  let llmlingua=checkllmlingua(llmlinguaurl);
  let subsystems=@(ollama;presidio;llmlingua);
  let hasdegraded=mut.false;
  let ollamadown=mt ollama.status {
    $ok:v false;
    $degraded:d true;
    $down:d true
  };
  if(!ollamadown){
    mt presidio.status {
      $ok:v false;
      $degraded:d true;
      $down:d true
    };
    mt llmlingua.status {
      $ok:v false;
      $degraded:d true;
      $down:d true
    }
  }el{};
  let overall=if(ollamadown){ $down("Ollama is not running") }
    el if(hasdegraded){ $degraded("one or more optional subsystems unavailable") }
    el{ $ok };
  <$healthreport{
    overall:overall;
    subsystems:subsystems
  }
};

f=formatreport(report:$healthreport):str{
  let overallstr=mt report.overall {
    $ok:v "ok";
    $degraded:d str.concat("degraded: ";d);
    $down:d str.concat("down: ";d)
  };
  let header=str.concat("loke doctor — overall: ";overallstr);
  let sep="----------------------------------------";
  let body=mut.str.concat(header;str.concat("
";sep));
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(i<str.len(report.subsystems))){ break }el{
      let sub=report.subsystems.get(i);
      let statusstr=mt sub.status {
        $ok:v "  ok";
        $degraded:d str.concat("  degraded — ";d);
        $down:d str.concat("  down — ";d)
      };
      let line=str.concat(
        "
";
        str.concat(
          sub.name;
          str.concat("
";statusstr)
        )
      );
      body=str.concat(body;line);
      i=i+1
    };
  };
  <body
};

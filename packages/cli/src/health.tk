m=cli.health;

i=reach:shared.reachability;
i=str:std.str;

t=$healthstatus{
  $ok:i64;
  $degraded:str;
  $down:str
};

t=$subsystemhealth{
  name:str;
  status:$healthstatus;
  detail:str
};

t=$healthreport{
  overall:$healthstatus;
  subsystems:@$subsystemhealth
};

(* Reachability first, response second, and that order is the whole point.

   These three are local sidecars, and `http.get` cannot tell "the service replied"
   from "nothing is listening": against a closed port it returns $ok carrying a nil
   response, so the $err arm never runs (T-15). The legacy bodies here called
   `http.gettimeout(url;3000)` and `http.getstatus(url)` — neither of which exists in
   std.http: gettimeout takes one argument and getstatus is not declared at all — and
   then read `.status` off an i64. So `loke doctor` had never compiled, and the shape
   it was reaching for would have reported every dead sidecar as reachable.

   shared.reachability.localserviceup BINDS the port to find out, which is honest for
   a localhost service and is what core.privacy.ner and core.privacy.presidio already
   use for exactly these endpoints. *)
(* VM1.6e. The GET after the probe was `http.get(http.client(url);path)`, and toke compiles
   a TWO-argument http.get as server ROUTE REGISTRATION (T-57). It sent nothing and the
   match took its error arm, so `loke doctor` reported every answering service as down,
   Ollama included: measured 2026-09-27 against a stand-in answering /api/tags on the
   configured URL. shared.reachability.localget is a real GET. *)
f=checkollama(ollamaurl:str):$subsystemhealth{
  if(reach.localserviceup(ollamaurl)){}el{
    <$subsystemhealth{ name:"Ollama"; status:$down("Ollama not running — start with: ollama serve"); detail:"unreachable" }
  };
  if(reach.localanswers(ollamaurl;"/api/tags")){
    <$subsystemhealth{ name:"Ollama"; status:$healthstatus{$ok:0}; detail:"reachable" }
  }el{};
  <$subsystemhealth{ name:"Ollama"; status:$down("Ollama not responding to /api/tags"); detail:"error" }
};

f=checkpresidio(presidiourl:str):$subsystemhealth{
  if(reach.localserviceup(presidiourl)){}el{
    <$subsystemhealth{ name:"Presidio (NER)"; status:$degraded("Presidio unavailable — NER accuracy reduced to regex-only"); detail:"unreachable" }
  };
  if(reach.localanswers(presidiourl;"/health")){
    <$subsystemhealth{ name:"Presidio (NER)"; status:$healthstatus{$ok:0}; detail:"reachable" }
  }el{};
  <$subsystemhealth{ name:"Presidio (NER)"; status:$degraded("Presidio unavailable — NER accuracy reduced to regex-only"); detail:"error" }
};

f=checkllmlingua(llmlinguaurl:str):$subsystemhealth{
  if(reach.localserviceup(llmlinguaurl)){}el{
    <$subsystemhealth{ name:"LLMLingua"; status:$degraded("LLMLingua unavailable — token compression disabled"); detail:"unreachable" }
  };
  if(reach.localanswers(llmlinguaurl;"/health")){
    <$subsystemhealth{ name:"LLMLingua"; status:$healthstatus{$ok:0}; detail:"reachable" }
  }el{};
  <$subsystemhealth{ name:"LLMLingua"; status:$degraded("LLMLingua unavailable — token compression disabled"); detail:"error" }
};

(* True when the status is anything other than ok. Its own function because toke
   emits duplicate basic-block labels for an inline `mt` of three or more arms, and
   because the legacy checkall discarded three of these matches: it wrote
   `mt statusv { … }` as a bare statement and never assigned the result, so
   `hasdegraded` was read as false however degraded the system was. *)
f=notok(st:$healthstatus):bool{
  let stv:$healthstatus=st;
  <mt stv {
    $ok:v false;
    $degraded:d true;
    $down:d true
  }
};

f=checkall(ollamaurl:str;presidiourl:str;llmlinguaurl:str):$healthreport{
  let ollama=checkollama(ollamaurl);
  let presidio=checkpresidio(presidiourl);
  let llmlingua=checkllmlingua(llmlinguaurl);
  let subsystems=@(ollama;presidio;llmlingua);
  let ollamadown=notok(ollama.status);
  let hasdegraded=notok(presidio.status)||notok(llmlingua.status);
  let overall=mut.$healthstatus{$ok:0};
  if(ollamadown){ overall=$down("Ollama is not running") }
    el if(hasdegraded){ overall=$degraded("one or more optional subsystems unavailable") }
    el{};
  <$healthreport{
    overall:overall;
    subsystems:subsystems
  }
};

(* The match is in its own function, not inline in the loop above. toke emits
   duplicate basic-block labels for an inline `mt` of three or more arms inside a
   loop body, and clang rejects the module with "Terminator found in the middle of a
   basic block!". Two arms is fine, which is why $ok/$err matches are unaffected.
   Filed in docs/upstream/toke-issues.md as T-2. *)
f=statusline(st:$healthstatus):str{
  <mt st {
    $ok:v "  ok";
    $degraded:d str.concat("  degraded — ";d);
    $down:d str.concat("  down — ";d)
  }
};

f=formatreport(report:$healthreport):str{
  let overallv:$healthstatus=report.overall;
  let overallstr=mt overallv {
    $ok:v "ok";
    $degraded:d str.concat("degraded: ";d);
    $down:d str.concat("down: ";d)
  };
  let header=str.concat("loke doctor — overall: ";overallstr);
  let sep="----------------------------------------";
  let body=mut."\(header)
\(sep)";
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(i<report.subsystems.len)){ br }el{
      let sub=report.subsystems.get(i);
      let line="
\(sub.name)
\(statusline(sub.status))";
      body=str.concat(body;line);
      i=i+1
    };
  };
  <body
};

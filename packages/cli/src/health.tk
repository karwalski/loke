m=cli.health;


i=t:shared.types;
i=http:std.http;
i=str:std.str;
i=log:shared.log;

t=$healthstatus{
  $ok;
  $degraded(str);
  $down(str)
};

t=$subsystemhealth{
  name:str;
  status:$healthstatus;
  detail:str
};

t=$healthreport{
  overall:$healthstatus;
  subsystems:@$subsystemhealth
};

f=checkollama(ollamaurl:str):$subsystemhealth{
  let url=str.concat(ollamaurl;"/api/tags");
  let result=http.gettimeout(url;3000);
  mt result {
    $httperr e;
      <$subsystemhealth{
        name="Ollama";
        status=$healthstatus.$down("Ollama not running — start with: ollama serve");
        detail="unreachable"
      };
    body;
      <$subsystemhealth{
        name="Ollama";
        status=$healthstatus.$ok;
        detail="reachable"
      };
  };
};

f=checkpresidio(presidiourl:str):$subsystemhealth{
  let url=str.concat(presidiourl;"/health");
  let result=http.getstatus(url);
  mt result {
    $httperr e;
      <$subsystemhealth{
        name="Presidio (NER)";
        status=$healthstatus.$degraded("Presidio unavailable — NER accuracy reduced to regex-only");
        detail="unreachable"
      };
    resp;
      if(resp.status==200){
        <$subsystemhealth{
          name="Presidio (NER)";
          status=$healthstatus.$ok;
          detail="reachable"
        };
      }else{
        <$subsystemhealth{
          name="Presidio (NER)";
          status=$healthstatus.$degraded("Presidio unavailable — NER accuracy reduced to regex-only");
          detail=str.concat("status ";str.fromint(resp.status))
        };
      };
  };
};

f=checkllmlingua(llmlinguaurl:str):$subsystemhealth{
  let url=str.concat(llmlinguaurl;"/health");
  let result=http.getstatus(url);
  mt result {
    $httperr e;
      <$subsystemhealth{
        name="LLMLingua";
        status=$healthstatus.$degraded("LLMLingua unavailable — token compression disabled");
        detail="unreachable"
      };
    resp;
      if(resp.status==200){
        <$subsystemhealth{
          name="LLMLingua";
          status=$healthstatus.$ok;
          detail="reachable"
        };
      }else{
        <$subsystemhealth{
          name="LLMLingua";
          status=$healthstatus.$degraded("LLMLingua unavailable — token compression disabled");
          detail=str.concat("status ";str.fromint(resp.status))
        };
      };
  };
};

f=checkall(ollamaurl:str;presidiourl:str;llmlinguaurl:str):$healthreport{
  let ollama=checkollama(ollamaurl);
  let presidio=checkpresidio(presidiourl);
  let llmlingua=checkllmlingua(llmlinguaurl);
  let subsystems=@(ollama;presidio;llmlingua);
  let overall=mt ollama.status {
    $ok;
      let hasdegraded=false;
      mt presidio.status {
        $ok ();
        $degraded d let hasdegraded=true;
        $down d let hasdegraded=true
      };
      mt llmlingua.status {
        $ok ();
        $degraded d let hasdegraded=true;
        $down d let hasdegraded=true
      };
      if(hasdegraded){
        <$healthstatus.$degraded("one or more optional subsystems unavailable")
      }else{
        <$healthstatus.$ok
      };
    $degraded d;
      <$healthstatus.$down("Ollama is not running")
    $down d;
      <$healthstatus.$down("Ollama is not running")
  };
  <$healthreport{
    overall=overall;
    subsystems=subsystems
  };
};

f=formatreport(report:$healthreport):str{
  let overallstr=mt report.overall {
    $ok "ok";
    $degraded d str.concat("degraded: ";d);
    $down d str.concat("down: ";d)
  };
  let header=str.concat("loke doctor — overall: ";overallstr);
  let sep="----------------------------------------";
  let body=str.concat(header;str.concat("
";sep));
  let i=0;
  loop i<str.len(report.subsystems){
    let sub=report.subsystems.get(i);
    let statusstr=mt sub.status {
      $ok "  ok";
      $degraded d str.concat("  degraded — ";d);
      $down d str.concat("  down — ";d)
    };
    let line=str.concat(
      "
";
      str.concat(
        sub.name;
        str.concat("
";statusstr)
      )
    );
    let body=str.concat(body;line);
    let i=i+1
  };
  <body
};

m=cli.health;

i=t:shared.types;
i=http:std.http;
i=str:std.str;
i=log:shared.log;

t=$healthstatus{
  $ok:i64;
  $degraded:str;
  $down:str
};

t=$subsystemhealth{
  name:str;
  status:$healthstatus;
  detail:str
};

t=$healthreport{
  overall:$healthstatus;
  subsystems:@$subsystemhealth
};

f=checkollama(ollamaurl:str):$subsystemhealth{
  let url=str.concat(ollamaurl;"/api/tags");
  let result=http.gettimeout(url;3000);
  mt result {
    $httperr:e $subsystemhealth{ name:"Ollama"; status:$down("Ollama not running — start with: ollama serve"); detail:"unreachable" };
    $ok:body $subsystemhealth{ name:"Ollama"; status:$healthstatus{$ok:0}; detail:"reachable" }
  }
};

f=checkpresidio(presidiourl:str):$subsystemhealth{
  let url=str.concat(presidiourl;"/health");
  let result=http.getstatus(url);
  mt result {
    $httperr:e $subsystemhealth{ name:"Presidio (NER)"; status:$degraded("Presidio unavailable — NER accuracy reduced to regex-only"); detail:"unreachable" };
    $ok:resp checkpresidioresp(resp)
  }
};

f=checkpresidioresp(resp:i64):$subsystemhealth{
  let r=mut.$subsystemhealth{ name:"Presidio (NER)"; status:$degraded("Presidio unavailable — NER accuracy reduced to regex-only"); detail:str.concat("status ";str.fromint(resp.status)) };
  if(resp.status==200){ r=$subsystemhealth{ name:"Presidio (NER)"; status:$healthstatus{$ok:0}; detail:"reachable" } }el{};
  <r
};

f=checkllmlingua(llmlinguaurl:str):$subsystemhealth{
  let url=str.concat(llmlinguaurl;"/health");
  let result=http.getstatus(url);
  mt result {
    $httperr:e $subsystemhealth{ name:"LLMLingua"; status:$degraded("LLMLingua unavailable — token compression disabled"); detail:"unreachable" };
    $ok:resp checkllmlinguaresp(resp)
  }
};

f=checkllmlinguaresp(resp:i64):$subsystemhealth{
  let r=mut.$subsystemhealth{ name:"LLMLingua"; status:$degraded("LLMLingua unavailable — token compression disabled"); detail:str.concat("status ";str.fromint(resp.status)) };
  if(resp.status==200){ r=$subsystemhealth{ name:"LLMLingua"; status:$healthstatus{$ok:0}; detail:"reachable" } }el{};
  <r
};

f=checkall(ollamaurl:str;presidiourl:str;llmlinguaurl:str):$healthreport{
  let ollama=checkollama(ollamaurl);
  let presidio=checkpresidio(presidiourl);
  let llmlingua=checkllmlingua(llmlinguaurl);
  let subsystems=@(ollama;presidio;llmlingua);
  let hasdegraded=mut.false;
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let statusv:$healthstatus=ollama.status;
  let ollamadown=mt statusv {
    $ok:v false;
    $degraded:d true;
    $down:d true
  };
  if(!ollamadown){
    let statusv:$healthstatus=presidio.status;
    mt statusv {
      $ok:v false;
      $degraded:d true;
      $down:d true
    };
    let statusv:$healthstatus=llmlingua.status;
    mt statusv {
      $ok:v false;
      $degraded:d true;
      $down:d true
    }
  }el{};
  let overall=mut.$healthstatus{$ok:0};
  if(ollamadown){ overall=$down("Ollama is not running") }
    el{ if(hasdegraded){ overall=$degraded("one or more optional subsystems unavailable") }
    el{} };
  <$healthreport{
    overall:overall;
    subsystems:subsystems
  }
};

(* The match is in its own function, not inline in the loop above. toke emits
   duplicate basic-block labels for an inline `mt` of three or more arms inside a
   loop body, and clang rejects the module with "Terminator found in the middle of a
   basic block!". Two arms is fine, which is why $ok/$err matches are unaffected.
   Filed in docs/upstream/toke-issues.md as T-2. *)
f=statusline(st:$healthstatus):str{
  mt st {
    $ok:v "  ok";
    $degraded:d str.concat("  degraded — ";d);
    $down:d str.concat("  down — ";d)
  }
};

f=formatreport(report:$healthreport):str{
  let overallv:$healthstatus=report.overall;
  let overallstr=mt overallv {
    $ok:v "ok";
    $degraded:d str.concat("degraded: ";d);
    $down:d str.concat("down: ";d)
  };
  let header=str.concat("loke doctor — overall: ";overallstr);
  let sep="----------------------------------------";
  let body=mut.str.concat(header;str.concat("
";sep));
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(!(i<str.len(report.subsystems))){ br }el{
      let sub=report.subsystems.get(i);
      let statusstr=statusline(sub.status);
      let line=str.concat(
        "
";
        str.concat(
          sub.name;
          str.concat("
";statusstr)
        )
      );
      body=str.concat(body;line);
      i=i+1
    };
  };
  <body
};

m=cli.main;

i=t:shared.types;
i=cfg:shared.config;
i=log:shared.log;
i=cmd:cli.commands;
i=out:cli.output;
i=health:cli.health;
i=bench:core.eval.bench;
i=disp:core.providers.dispatcher;
i=sdb:core.storage.db;
i=er:core.storage.erase;
i=ks:core.governance.killswitch;
i=audit:core.storage.audit;
i=rec:core.audit.reconcile;
i=str:std.str;
i=argv:std.args;
i=file:std.file;
i=pev:cli.privacyeval;
i=pmod:cli.privacymodels;
i=rpt:cli.report;

f=handleask(prompt:str):i64{
  out.printline(str.concat("Ask: ";prompt));
  out.printline("Pipeline not yet connected — use browser mode for full pipeline");
  <0
};
f=handlepipeline(prompt:str):i64{
  out.printline(str.concat("Pipeline stages for: ";prompt));
  out.printpipelinestage("1 privacy filter";"pending";"PII detection and anonymisation");
  out.printpipelinestage("2 token optimiser";"pending";"prompt compression via LLMLingua");
  out.printpipelinestage("3 router";"pending";"model selection by tier and sensitivity");
  out.printpipelinestage("4 LLM";"pending";"inference via Ollama or remote provider");
  out.printpipelinestage("5 response restoration";"pending";"placeholder substitution and de-anonymisation");
  out.printpipelinestage("6 audit";"pending";"logging redacted interaction to local store");
  out.printpipelinestage("7 feedback";"pending";"thumbs up/down capture");
  <0
};
f=handlequeuelist():i64{
  out.printline("No jobs in queue");
  <0
};
f=handlequeuecancel(id:str):i64{
  out.printline(str.concat("Queue cancel not yet implemented — job id: ";id));
  <0
};
f=handlemodelslist():i64{
  out.printline("Run: ollama list to see local models");
  <0
};
f=handlemodelsrecommend():i64{
  out.printline("Run loke doctor first to profile your hardware");
  <0
};
f=handlememorysearch(query:str):i64{
  out.printline(str.concat("Memory search not yet implemented — query: ";query));
  <0
};
f=handleagentslist():i64{
  out.printline("No agents registered");
  <0
};
f=handleovernightstatus():i64{
  out.printline("No overnight jobs scheduled");
  <0
};
f=handledoctor(config:$lokeconfig):i64{
  let report=health.checkall(config.ollamaurl;config.presidiourl;config.llmlinguaurl);
  out.printline(health.formatreport(report));
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let overallv:$healthstatus=report.overall;
  <mt overallv {
    $ok:v 0;
    $degraded:d 0;
    $down:d 1
  }
};
(* VM1.6. Scores a LOCAL model on bench.defaultcases and records the summary through the
   VM1.1 sink. A cloud model id is refused before anything is dispatched, and the dispatcher
   is built with empty API keys, so a benchmark cannot spend money either way. The table is
   printed whether or not the result is recorded; the exit status says whether it was.

   VM1.3: the case set runs `runs` times (default five), the first discarded as warm-up,
   and each figure is recorded as the mean of the kept runs with its BCa interval. A count
   outside three to eight is refused before anything is dispatched. *)
f=handlebenchmark(model:str;outpath:str;askedruns:i64;config:$lokeconfig):i64{
  if(bench.iscloudmodel(model)){
    out.printerror("loke benchmark runs against a local Ollama model only; \(model) is a hosted model and would cost money");
    <1
  }el{};
  let runs=mut.askedruns;
  if(askedruns==0){ runs=bench.defaultruns() }el{};
  if(runs<bench.minruns() || runs>bench.maxruns()){
    out.printerror("--runs must be from \(bench.minruns()) to \(bench.maxruns()): the first run is discarded as warm-up, an interval needs two more, and the interval is enumerated exactly up to \(bench.maxruns()-1) kept runs");
    <1
  }el{};
  out.printline("Ollama at \(config.ollamaurl)");
  let d=disp.new($apikeys{anthropic:"";openai:""};config.ollamaurl);
  let all=bench.runrepeated(model;bench.defaultcases();d;runs);
  lp(let i=0;i<all.len;i=i+1){
    let label=mut."run \(i+1) of \(runs)";
    if(i==0){ label="\(label) (warm-up, discarded)" }el{};
    out.printline(label);
    out.printline(bench.formatrun(all.get(i)))
  };
  let version=bench.modelversion(config.ollamaurl;model);
  if(str.len(version)==0){
    out.printerror("not recorded: Ollama lists no digest for \(model), and a result without a pinned model version cannot be reproduced");
    <1
  }el{};
  let path=mut.outpath;
  if(str.len(outpath)==0){ path=bench.defaultresultspath() }el{};
  let reason=bench.record(all;version;bench.defaultworkload();path);
  if(str.len(reason)>0){
    out.printerror("not recorded: \(reason)");
    <1
  }el{};
  out.printline("recorded keyword_score and latency_mean over \(runs-1) kept runs, with BCa intervals, to \(path)");
  <0
};
(* X8.4 found this. `cfg.loadconfig` returns `$lokeconfig!$lokeerr`, whose error side is a
   user sum, so the match always takes its first arm (T-18): with no config.toml, `config`
   was the error payload read as a config, and `config.datadir` printed as "could not read
   or parse …/config.toml". Every command that read a field of it read garbage. The guard is
   the one packages/browser/extensions/core.tk uses: call loadconfig only when the file
   exists, where its first arm is the right one. A file that exists but does not parse is
   still undetectable here, which is the residue of T-18. *)
f=loadedconfig():$lokeconfig{
  let path=t.configpath();
  if(file.exists(path)){
    <mt cfg.loadconfig(path) {
      $ok:v v;
      $err:e cfg.defaultconfig()
    }
  }el{
    <cfg.defaultconfig()
  }
};
(* X8.4. What `loke erase --everything --yes` removes, stated before it is done. *)
f=erasesummary(datadir:str):str{
  <"Erasing everything under \(datadir): every table in loke.db (settings, the audit trail, disclosure records, memory, mappings), the log, the semantic cache, exports and benchmark results. config.toml and bin/ are kept. This cannot be undone. Stop the loke server first."
};
f=handleerasepreview(config:$lokeconfig):i64{
  out.printline(erasesummary(config.datadir));
  out.printline("Nothing has been erased. Run: loke erase --everything --yes");
  <0
};
f=handleerase(config:$lokeconfig):i64{
  out.printline(erasesummary(config.datadir));
  let opened=mt sdb.openstore(config.datadir) {
    $ok:st st;
    $err:e $store{conn:$dbconn{handle:0};datadir:""}
  };
  (* T-18: the match above takes its first arm whatever openstore returned, so whether the
     database is really open is asked of the connection. *)
  if(sdb.connectionlive()){}el{
    out.printerror("not erased: the database at \(config.datadir) could not be opened");
    <1
  };
  let result=er.eraseeverything(opened);
  if(result.erased){
    out.printline("Erased: \(result.tablesdropped) tables dropped and the schema rebuilt empty, \(result.filesdeleted) files deleted, no free pages left in loke.db.");
    <0
  }el{};
  out.printerror("NOT fully erased: \(result.reason)");
  <1
};
(* G1.6. The switch is written to the settings table of the loke.db a running server reads
   on every request, so it takes effect on the next request without a restart. Each change
   is audited by core.governance.killswitch; a refused target (an unknown use case or
   provider, a malformed agent id) changes nothing and exits 1. *)
f=killswitchchange(store:i64;kind:str;target:str):bool{
  let reason="set from the command line";
  if(str.eq(kind;"killswitch.on.global")){ <ks.engage(store;reason;0 as i32) }el{};
  if(str.eq(kind;"killswitch.off.global")){ <ks.release(store) }el{};
  if(str.eq(kind;"killswitch.on.use_case")){ <ks.engageusecase(store;target;reason) }el{};
  if(str.eq(kind;"killswitch.off.use_case")){ <ks.releaseusecase(store;target) }el{};
  if(str.eq(kind;"killswitch.on.agent")){ <ks.engageagent(store;target;reason) }el{};
  if(str.eq(kind;"killswitch.off.agent")){ <ks.releaseagent(store;target) }el{};
  if(str.eq(kind;"killswitch.on.provider")){ <ks.engageprovider(store;target;reason) }el{};
  if(str.eq(kind;"killswitch.off.provider")){ <ks.releaseprovider(store;target) }el{};
  <false
};
f=handlekillswitch(kind:str;target:str;config:$lokeconfig):i64{
  let opened=mt sdb.openstore(config.datadir) {
    $ok:st st;
    $err:e $store{conn:$dbconn{handle:0};datadir:""}
  };
  (* T-18, as handleerase: whether the database is open is asked of the connection. *)
  if(sdb.connectionlive()){}el{
    out.printerror("kill switch not changed: the database at \(config.datadir) could not be opened");
    <1
  };
  let store=1;
  if(str.eq(kind;"killswitch.status")){
    let active=ks.listactive(store);
    if(active.len==0){
      out.printline("Kill switch: nothing is switched off")
    }el{
      lp(let i=0;i<active.len;i=i+1){
        out.printline(str.concat("Kill switch ON: ";active.get(i)))
      }
    };
    <0
  }el{};
  if(killswitchchange(store;kind;target)){
    out.printline("Kill switch: \(kind) \(target) done, and recorded in the audit trail");
    <0
  }el{};
  out.printerror("kill switch not changed: \(kind) refused \(target)");
  <1
};
(* DA1.10. `loke audit verify`: the hash chain, which covers each disclosure record through
   its audit rows (spec 6.3), and the G2 reconciliation both ways. Exits 0 only when the
   chain is intact and nothing is orphaned; a store that cannot be opened or read is a
   failure, never a clean result. It writes no row; opening the store applies any pending
   migration, as every command that opens it does. *)
f=handleauditverify(config:$lokeconfig):i64{
  let opened=mt sdb.openstore(config.datadir) {
    $ok:st st;
    $err:e $store{conn:$dbconn{handle:0};datadir:""}
  };
  (* T-18, as handleerase: whether the database is open is asked of the connection. *)
  if(sdb.connectionlive()){}el{
    out.printerror("audit not verified: the database at \(config.datadir) could not be opened");
    <1
  };
  let chain=audit.verifychain(1);
  let recon=rec.reconcile();
  out.printline(audit.formatchainresult(chain));
  out.printline(rec.formatreconciliation(recon));
  if(chain.ok && rec.reconciled(recon)){ <0 }el{};
  <1
};
f=handleversion():i64{
  out.printline("loke 0.1.0");
  <0
};
f=handlehelp():i64{
  out.printline(cmd.usage());
  <0
};
f=handleunknown(msg:str):i64{
  out.printerror(msg);
  <1
};

(* cli.commands.parse returns a $command STRUCT — {kind:str; arg:str} — not a sum, so
   the legacy `mt command { $ask:prompt …; $doctor:v …; … }` was matching thirteen sum
   variants against a two-field struct. toke reported it as a non-exhaustive match
   missing the variants 'kind' and 'arg', which is the diagnostic for exactly this
   mistake. Dispatch is on the kind string.

   Every handler returns i64 and only this function narrows to the i32 the entry point
   declares; the legacy handlers declared i32 and returned an i64 literal at twelve
   sites.

   VM1.6: argv comes from std.args. This was `main(args:@str)`, and toke's generated C main
   calls tk_main with NO arguments, so `args` was whatever the register held: every
   invocation, `loke --version` included, segfaulted in cli.commands.parse reading its
   length. The binary linked in F10.23g and had never been run. *)
f=main():i32{
  let args:@str=argv.all();
  let cid=log.newcorrelationid();

  let config=loadedconfig();

  log.info("loke cli starting";"cli";cid);

  let command=cmd.parse(args);
  if(str.eq(command.kind;"benchmark")){
    <(handlebenchmark(command.arg;cmd.benchmarkout(args);cmd.benchmarkruns(args);config) as i32)
  }el{};
  if(str.startswith(command.kind;"privacyevaluate")){
    <(pev.handle(command.kind;command.arg;cmd.showvalues(args);config) as i32)
  }el{};
  (* F3b.7. The model registrations read their flags from argv. *)
  if(str.startswith(command.kind;"privacymodel")){
    <(pmod.handle(command.kind;args) as i32)
  }el{};
  (* GA5.31. The report flags are read from argv by cli.report, as benchmark's are. *)
  if(str.startswith(command.kind;"report")){
    <(rpt.handle(command.kind;args;config) as i32)
  }el{};
  <(dispatch(command;config) as i32)
};

f=dispatch(command:$command;config:$lokeconfig):i64{
  let kind=command.kind;
  if(str.eq(kind;"ask")){ <handleask(command.arg) }el{};
  if(str.eq(kind;"pipeline")){ <handlepipeline(command.arg) }el{};
  if(str.eq(kind;"queuelist")){ <handlequeuelist() }el{};
  if(str.eq(kind;"queuecancel")){ <handlequeuecancel(command.arg) }el{};
  if(str.eq(kind;"modelslist")){ <handlemodelslist() }el{};
  if(str.eq(kind;"modelsrecommend")){ <handlemodelsrecommend() }el{};
  if(str.eq(kind;"memorysearch")){ <handlememorysearch(command.arg) }el{};
  if(str.eq(kind;"agentslist")){ <handleagentslist() }el{};
  if(str.eq(kind;"overnightstatus")){ <handleovernightstatus() }el{};
  if(str.eq(kind;"doctor")){ <handledoctor(config) }el{};
  if(str.eq(kind;"erasepreview")){ <handleerasepreview(config) }el{};
  if(str.eq(kind;"erase")){ <handleerase(config) }el{};
  if(str.startswith(kind;"killswitch.")){ <handlekillswitch(kind;command.arg;config) }el{};
  if(str.eq(kind;"auditverify")){ <handleauditverify(config) }el{};
  if(str.eq(kind;"version")){ <handleversion() }el{};
  if(str.eq(kind;"help")){ <handlehelp() }el{};
  <handleunknown(command.arg)
};

m=cli.main;

i=t:shared.types;
i=cfg:shared.config;
i=log:shared.log;
i=cmd:cli.commands;
i=out:cli.output;
i=health:cli.health;
i=str:std.str;

f=handleask(prompt:str):i64{
  out.printline(str.concat("Ask: ";prompt));
  out.printline("Pipeline not yet connected — use browser mode for full pipeline");
  <0
};
f=handlepipeline(prompt:str):i64{
  out.printline(str.concat("Pipeline stages for: ";prompt));
  out.printpipelinestage("1 privacy filter";"pending";"PII detection and anonymisation");
  out.printpipelinestage("2 token optimiser";"pending";"prompt compression via LLMLingua");
  out.printpipelinestage("3 router";"pending";"model selection by tier and sensitivity");
  out.printpipelinestage("4 LLM";"pending";"inference via Ollama or remote provider");
  out.printpipelinestage("5 response restoration";"pending";"placeholder substitution and de-anonymisation");
  out.printpipelinestage("6 audit";"pending";"logging redacted interaction to local store");
  out.printpipelinestage("7 feedback";"pending";"thumbs up/down capture");
  <0
};
f=handlequeuelist():i64{
  out.printline("No jobs in queue");
  <0
};
f=handlequeuecancel(id:str):i64{
  out.printline(str.concat("Queue cancel not yet implemented — job id: ";id));
  <0
};
f=handlemodelslist():i64{
  out.printline("Run: ollama list to see local models");
  <0
};
f=handlemodelsrecommend():i64{
  out.printline("Run loke doctor first to profile your hardware");
  <0
};
f=handlememorysearch(query:str):i64{
  out.printline(str.concat("Memory search not yet implemented — query: ";query));
  <0
};
f=handleagentslist():i64{
  out.printline("No agents registered");
  <0
};
f=handleovernightstatus():i64{
  out.printline("No overnight jobs scheduled");
  <0
};
f=handledoctor(config:$lokeconfig):i64{
  let report=health.checkall(config.ollamaurl;config.presidiourl;config.llmlinguaurl);
  out.printline(health.formatreport(report));
  (* The subject is bound with a declared type before the match. toke emits duplicate
     basic-block labels for a 3+-arm `mt` on a struct field and clang then rejects the
     whole module; the annotation is what makes it link. See docs/upstream/toke-issues.md T-2. *)
  let overallv:$healthstatus=report.overall;
  <mt overallv {
    $ok:v 0;
    $degraded:d 0;
    $down:d 1
  }
};
f=handleversion():i64{
  out.printline("loke 0.1.0");
  <0
};
f=handlehelp():i64{
  out.printline(cmd.usage());
  <0
};
f=handleunknown(msg:str):i64{
  out.printerror(msg);
  <1
};

(* cli.commands.parse returns a $command STRUCT — {kind:str; arg:str} — not a sum, so
   the legacy `mt command { $ask:prompt …; $doctor:v …; … }` was matching thirteen sum
   variants against a two-field struct. toke reported it as a non-exhaustive match
   missing the variants 'kind' and 'arg', which is the diagnostic for exactly this
   mistake. Dispatch is on the kind string.

   Every handler returns i64 and only this function narrows to the i32 the entry point
   declares; the legacy handlers declared i32 and returned an i64 literal at twelve
   sites. *)
f=main(args:@str):i32{
  let cid=log.newcorrelationid();

  let config=mt cfg.loadconfig(t.configpath()) {
    $ok:v v;
    $err:e cfg.defaultconfig()
  };

  log.info("loke cli starting";"cli";cid);

  let command=cmd.parse(args);
  <(dispatch(command;config) as i32)
};

f=dispatch(command:$command;config:$lokeconfig):i64{
  let kind=command.kind;
  if(str.eq(kind;"ask")){ <handleask(command.arg) }el{};
  if(str.eq(kind;"pipeline")){ <handlepipeline(command.arg) }el{};
  if(str.eq(kind;"queuelist")){ <handlequeuelist() }el{};
  if(str.eq(kind;"queuecancel")){ <handlequeuecancel(command.arg) }el{};
  if(str.eq(kind;"modelslist")){ <handlemodelslist() }el{};
  if(str.eq(kind;"modelsrecommend")){ <handlemodelsrecommend() }el{};
  if(str.eq(kind;"memorysearch")){ <handlememorysearch(command.arg) }el{};
  if(str.eq(kind;"agentslist")){ <handleagentslist() }el{};
  if(str.eq(kind;"overnightstatus")){ <handleovernightstatus() }el{};
  if(str.eq(kind;"doctor")){ <handledoctor(config) }el{};
  if(str.eq(kind;"version")){ <handleversion() }el{};
  if(str.eq(kind;"help")){ <handlehelp() }el{};
  <handleunknown(command.arg)
};

m=cli.main;

i=t:shared.types;
i=cfg:shared.config;
i=log:shared.log;
i=cmd:cli.commands;
i=out:cli.output;
i=health:cli.health;
i=str:std.str;

f=handleask(prompt:str):i32{
  out.printline(str.concat("Ask: ";prompt));
  out.printline("Pipeline not yet connected — use browser mode for full pipeline");
  <0
};
f=handlepipeline(prompt:str):i32{
  out.printline(str.concat("Pipeline stages for: ";prompt));
  out.printpipelinestage("1 privacy filter";"pending";"PII detection and anonymisation");
  out.printpipelinestage("2 token optimiser";"pending";"prompt compression via LLMLingua");
  out.printpipelinestage("3 router";"pending";"model selection by tier and sensitivity");
  out.printpipelinestage("4 LLM";"pending";"inference via Ollama or remote provider");
  out.printpipelinestage("5 response restoration";"pending";"placeholder substitution and de-anonymisation");
  out.printpipelinestage("6 audit";"pending";"logging redacted interaction to local store");
  out.printpipelinestage("7 feedback";"pending";"thumbs up/down capture");
  <0
};
f=handlequeuelist():i32{
  out.printline("No jobs in queue");
  <0
};
f=handlequeuecancel(id:str):i32{
  out.printline(str.concat("Queue cancel not yet implemented — job id: ";id));
  <0
};
f=handlemodelslist():i32{
  out.printline("Run: ollama list to see local models");
  <0
};
f=handlemodelsrecommend():i32{
  out.printline("Run loke doctor first to profile your hardware");
  <0
};
f=handlememorysearch(query:str):i32{
  out.printline(str.concat("Memory search not yet implemented — query: ";query));
  <0
};
f=handleagentslist():i32{
  out.printline("No agents registered");
  <0
};
f=handleovernightstatus():i32{
  out.printline("No overnight jobs scheduled");
  <0
};
f=handledoctor(config:i64):i32{
  let report=health.checkall(config.ollamaurl;config.presidiourl;config.llmlinguaurl);
  out.printline(health.formatreport(report));
  mt report.overall {
    $ok:v 0;
    $degraded:d 0;
    $down:d 1
  }
};
f=handleversion():i32{
  out.printline("loke 0.1.0");
  <0
};
f=handlehelp():i32{
  out.printline(cmd.usage());
  <0
};
f=handleunknown(msg:str):i32{
  out.printerror(msg);
  <1
};

f=main(args:@str):i32{
  let cid=log.newcorrelationid();

  let config=mt cfg.loadconfig("~/.loke/config.toml") {
    $ok:v v;
    $err:e cfg.defaultconfig()
  };

  log.info("loke cli starting";"cli";cid);

  let command=cmd.parse(args);

  mt command {
    $ask:prompt handleask(prompt);
    $pipeline:prompt handlepipeline(prompt);
    $queuelist:v handlequeuelist();
    $queuecancel:id handlequeuecancel(id);
    $modelslist:v handlemodelslist();
    $modelsrecommend:v handlemodelsrecommend();
    $memorysearch:query handlememorysearch(query);
    $agentslist:v handleagentslist();
    $overnightstatus:v handleovernightstatus();
    $doctor:v handledoctor(config);
    $version:v handleversion();
    $help:v handlehelp();
    $unknown:msg handleunknown(msg)
  }
};

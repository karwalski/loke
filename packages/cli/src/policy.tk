m=cli.policy;
i=s:core.policy.schema;
i=loader:core.policy.loader;
i=validate:core.policy.validate;
i=str:std.str;
i=log:shared.log;
i=tr:loke.platform.i18n.translator;

f=run(args:@str):i64{
  if(args.len<1){
    printusage();
    <0
  }el{
    let sub=args.get(0);
    if(str.eq(sub;"list")){
      <runlist()
    }el{
      if(str.eq(sub;"validate")){
        if(args.len<2){
          log.info(tr.t("loke.cli.policy.validate_usage");"cli.policy";"system");
          <1
        }el{
          <runvalidate(args.get(1))
        };
      }el{
        if(str.eq(sub;"show")){
          if(args.len<2){
            log.info(tr.t("loke.cli.policy.show_usage");"cli.policy";"system");
            <1
          }el{
            <runshow(args.get(1))
          };
        }el{
          log.info(str.concat(tr.t("loke.cli.policy.unknown_sub");sub);"cli.policy";"system");
          printusage();
          <1
        };
      };
    };
  };
};

f=printusage():void{
  log.info(tr.t("loke.cli.policy.usage");"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.usage_list");"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.usage_validate");"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.usage_show");"cli.policy";"system")
};

f=runlist():i64{
  log.info(tr.t("loke.cli.policy.active_sources");"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.source_enterprise");"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.source_team");"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.source_user");"cli.policy";"system");
  log.info("";"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.merge_order");"cli.policy";"system");
  log.info(tr.t("loke.cli.policy.enterprise_blocks");"cli.policy";"system");
  <0
};

f=runvalidate(path:str):i64{
  log.info(str.concat(tr.t("loke.cli.policy.validating");path);"cli.policy";"system");
  let loadresult=loader.loadfile(path);
  let loadok=mt loadresult {
    $ok:p true;
    $err:e false
  };
  if(loadok=false){
    log.error(str.concat(tr.t("loke.cli.policy.load_failed");path);"cli.policy";"system");
    <1
  }el{};
  let policy=mt loadresult {
    $ok:p p;
    $err:e p
  };
  let result=validate.validate(policy);
  if(result.valid){
    log.info(tr.t("loke.cli.policy.valid");"cli.policy";"system")
  }el{
    log.error(tr.t("loke.cli.policy.validation_failed");"cli.policy";"system")
  };
  lp(let i=0;i<str.arraylen(result.errors);i=i+1){ let e=str.arrayget(result.errors;i);
    log.error(str.concat("  ERROR: ";e);"cli.policy";"system")
  };
  lp(let i=0;i<str.arraylen(result.warnings);i=i+1){ let w=str.arrayget(result.warnings;i);
    log.warn(str.concat("  WARN: ";w);"cli.policy";"system")
  };
  if(result.valid){<0}el{<1};
};

f=runshow(path:str):i64{
  let showresult=loader.loadfile(path);
  let showok=mt showresult {
    $ok:p true;
    $err:e false
  };
  if(showok=false){
    log.error(str.concat(tr.t("loke.cli.policy.load_failed");path);"cli.policy";"system");
    <1
  }el{};
  let policy=mt showresult {
    $ok:p p;
    $err:e p
  };
  log.info(str.concat("name: ";policy.name);"cli.policy";"system");
  log.info(str.concat("version: ";policy.version);"cli.policy";"system");
  log.info(str.concat("source: ";policy.source);"cli.policy";"system");
  log.info(str.concat("classification: ";policy.classificationdefault);"cli.policy";"system");
  log.info(str.concat("providers: ";str.fromint(policy.providers.len));"cli.policy";"system");
  log.info(str.concat("anonymisation rules: ";str.fromint(policy.anonymisation.len));"cli.policy";"system");
  log.info(str.concat("cross-border: ";if(policy.crossborderallowed){"allowed"}el{"blocked"});"cli.policy";"system");
  <0
};

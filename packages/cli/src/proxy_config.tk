m=cli.proxyconfig;


i=log:shared.log;
i=out:cli.output;
i=file:std.file;
i=str:std.str;

t=$proxyenv{
  varname:str;
  value:str;
  tool:str
};



f=envvarsfortool(tool:str;proxyport:i32):@$proxyenv{
  let ports=str.fromint(proxyport);
  let base=str.concat("http://localhost:";ports);
  let claudevar=$proxyenv{
    varname:"ANTHROPIC_BASE_URL";
    value:base;
    tool:"claude-code"
  };
  let openaivar=$proxyenv{
    varname:"OPENAI_BASE_URL";
    value:base;
    tool:"openai"
  };
  let cursorvar=$proxyenv{
    varname:"OPENAI_API_BASE";
    value:base;
    tool:"cursor"
  };
  if(str.eq(tool;"claude-code")){
    <@(claudevar)
  };
  if(str.eq(tool;"openai")){
    <@(openaivar)
  };
  if(str.eq(tool;"cursor")){
    <@(cursorvar)
  };
  
  <@(claudevar;openaivar;cursorvar)
};



f=injecttoprofile(vars:@$proxyenv;profilepath:str):bool{
  let existing=mt file.read(profilepath) {
    $ok:v v;
    $err:e ""
  };
  (* `let updated=str.concat(updated;...)` inside the branch declared a new binding, so
     nothing was ever appended and the profile was rewritten with its original
     contents. *)
  let updated=mut.existing;
  lp(let i=0;i<vars.len;i=i+1){
    let v=vars.get(i);
    if(str.contains(existing;v.varname)){}el{
      updated="\(updated)
export \(v.varname)=\(v.value)"
    }
  };
  let writeresult=file.write(profilepath;updated);
  let writeok=mt writeresult {
    $ok:v true;
    $err:e false
  };
  if(writeok==false){
    log.warn(
      str.concat("failed to write profile: ";profilepath);
      "proxyconfig";
      "system"
    )
  }el{};
  <writeok
};



f=run(tool:str;proxyport:i32;profilepath:str):i64{
  let vars=envvarsfortool(tool;proxyport);
  let ok=injecttoprofile(vars;profilepath);
  if(ok){
    lp(let i=0;i<str.arraylen(vars);i=i+1){ let v=vars.get(i);
      out.printline(str.concat(
        str.concat("  set ";v.varname);
        str.concat("=";v.value)
      ))
    };
    out.printline(str.concat(
      "Restart your terminal or run: source ";
      profilepath
    ))
  }el{
    out.printerror(str.concat("could not write to profile: ";profilepath))
  };
  <0
};

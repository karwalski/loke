m=cli.proxy_config;




i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=file:std.file;
i=str:std.str;

t=$proxyenv{
  varname:str;
  value:str;
  tool:str
};



f=envvarsfortool(tool:str;proxyport:i32):@$proxyenv{
  let ports=str.fromint(proxyport);
  let base=str.concat("http://localhost:";ports);
  let claudevar=$proxyenv{
    varname:"ANTHROPIC_BASE_URL";
    value:base;
    tool:"claude-code"
  };
  let openaivar=$proxyenv{
    varname:"OPENAI_BASE_URL";
    value:base;
    tool:"openai"
  };
  let cursorvar=$proxyenv{
    varname:"OPENAI_API_BASE";
    value:base;
    tool:"cursor"
  };
  if(str.eq(tool;"claude-code")){
    <@$claudevar
  };
  if(str.eq(tool;"openai")){
    <@$openaivar
  };
  if(str.eq(tool;"cursor")){
    <@$cursorvar
  };
  
  <@(claudevar;openaivar;cursorvar)
};



f=injecttoprofile(vars:@$proxyenv;profilepath:str):bool{
  let existing=mt file.read(profilepath) {
    $ok:v v;
    $err: ""
  };
  let updated=existing;
  vars.each|v{
    let exportline=str.concat(
      str.concat("export ";v.varname);
      str.concat("=";v.value)
    );
    if(str.contains(existing;v.varname)){
      
      ()
    }el{
      let updated=str.concat(updated;str.concat("
";exportline))
    };
  };
  mt file.write(profilepath;updated) {
    $ok: <true;
    $err:e {
      log.warn(
        str.concat("failed to write profile: ";profilepath);
        "proxy_config";
        "system"
      );
      <false
    };
  };
};



f=run(tool:str;proxyport:i32;profilepath:str):i32{
  let vars=envvarsfortool(tool;proxyport);
  let ok=injecttoprofile(vars;profilepath);
  if(ok){
    vars.each|v{
      out.printline(str.concat(
        str.concat("  set ";v.varname);
        str.concat("=";v.value)
      ))
    };
    out.printline(str.concat(
      "Restart your terminal or run: source ";
      profilepath
    ))
  }el{
    out.printerror(str.concat("could not write to profile: ";profilepath))
  };
  <0
};

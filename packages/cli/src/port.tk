m=cli.port;

i=log:shared.log;
i=net:std.net;
i=db:core.storage.db;
i=str:std.str;



f=defaultport():i32{
  <(11430 as i32)
};
f=portrangestart():i32{
  <(11430 as i32)
};
f=portrangeend():i32{
  <(11450 as i32)
};

(* net.portavailable, not net.listen. std.net.listen is an abi entry point returning a
   bare i64, not a result, so the two `mt` matches over it were matching a plain
   integer — and the second one's `$err` arm read `listener`, the first arm's binding,
   which is not in scope there. Worse in intent: opening a real listener to test a port
   and then closing it races anything else binding in between. portavailable BINDS and
   releases, and returns 0 when the bind failed, which is the same primitive
   shared.reachability.localserviceup uses. *)
f=isportfree(port:i32):bool{
  <!(net.portavailable(port)==0)
};



(* -1 as an i32, via a named function: a bare `0-1` is an i64 literal expression and
   does not narrow on its own. *)
f=noport():i32{
  <((0-1) as i32)
};

f=findfreeport():i32{
  let port=mut.portrangestart();
  lp(let lv=0;!(port>portrangeend());lv=lv){
    if(isportfree(port)){
      <port
    }el{};
    port=port+1
  };
  <noport()
};



f=getconfiguredport(store:i64):i32{
  <mt db.getstr(store;"server.port") {
    $ok:v str.toint(v);
    $err:e defaultport()
  }
};


f=saveport(store:i64;port:i32):bool{
  <mt db.setstr(store;"server.port";str.fromint(port);"server") {
    $ok:v true;
    $err:e false
  }
};





f=resolveport(store:i64):i32{
  let configured=getconfiguredport(store);
  if(isportfree(configured)){
    <configured
  }el{};
  let port=findfreeport();
  if(port==noport()){
    log.warn(
      "no free port found in range — falling back to configured port";
      "port";
      "system"
    );
    <configured
  }el{};
  log.warn(
    "port conflict: using \(str.fromint(port)) instead of \(str.fromint(configured))";
    "port";
    "system"
  );
  saveport(store;port);
  <port
};

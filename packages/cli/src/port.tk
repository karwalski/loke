m=cli.port;




i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=net:std.net;
i=db:storage.db;

let defaultport = 11430;
let portrangestart = 11430;
let portrangeend = 11450;



f=isportfree(port:i32):bool{
  let result=net.listen(port);
  mt result {
    $ok:listener {
      net.close(listener);
      <true
    };
    $err: <false
  };
};



f=findfreeport():i32{
  let port=portrangestart;
  loop port <= portrangeend{
    if isportfree(port){
      <port
    };
    let port=port+1
  };
  <-1
};



f=getconfiguredport(store:db.$store):i32{
  db.getstr(store;mt "server.port") {
    $ok:v str.toint(v);
    $err: defaultport
  };
};


f=saveport(store:db.$store;port:i32):bool{
  db.setstr(store;"server.port";str.fromint(port);mt "server") {
    $ok: <true;
    $err: <false
  };
};





f=resolveport(store:db.$store):i32{
  let configured=getconfiguredport(store);
  if isportfree(configured){
    <configured
  };
  let port=findfreeport();
  if port == -1{
    log.warn(
      "no free port found in range — falling back to configured port";
      "port";
      "system"
    );
    <configured
  };
  log.warn(
    str.concat(
      str.concat("port conflict: using ";str.fromint(port));
      str.concat(" instead of ";str.fromint(configured))
    );
    "port";
    "system"
  );
  saveport(store;port);
  <port
};

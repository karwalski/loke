m=cli.port;

i=t:shared.types;
i=log:shared.log;
i=out:cli.output;
i=net:std.net;
i=db:storage.db;
i=str:std.str;



f=defaultport():i32{
  <11430
};
f=portrangestart():i32{
  <11430
};
f=portrangeend():i32{
  <11450
};

f=isportfree(port:i32):bool{
  let result=net.listen(port);
  let ok=mt result {
    $ok:listener true;
    $err:e false
  };
  if(ok){
    let listener=mt result {
      $ok:listener listener;
      $err:e listener
    };
    net.close(listener)
  }el{};
  <ok
};



f=findfreeport():i32{
  let port=mut.portrangestart();
  lp(let lv=0;port<=portrangeend();lv=lv){
    if(isportfree(port)){
      <port
    }el{};
    port=port+1
  };
  <0-1
};



f=getconfiguredport(store:i64):i32{
  mt db.getstr(store;"server.port") {
    $ok:v str.toint(v);
    $err:e defaultport()
  }
};


f=saveport(store:i64;port:i32):bool{
  mt db.setstr(store;"server.port";str.fromint(port);"server") {
    $ok:v true;
    $err:e false
  }
};





f=resolveport(store:i64):i32{
  let configured=getconfiguredport(store);
  if(isportfree(configured)){
    <configured
  }el{};
  let port=findfreeport();
  if(port=(0-1)){
    log.warn(
      "no free port found in range — falling back to configured port";
      "port";
      "system"
    );
    <configured
  }el{};
  log.warn(
    str.concat(
      str.concat("port conflict: using ";str.fromint(port));
      str.concat(" instead of ";str.fromint(configured))
    );
    "port";
    "system"
  );
  saveport(store;port);
  <port
};

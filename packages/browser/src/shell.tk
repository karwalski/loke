m=browser.shell;
i=wv:std.webview;
i=log:shared.log;
i=net:std.net;

t=$shellconfig{ port:i32; title:str; width:i32; height:i32; devmode:bool };

let defaultconfig=$shellconfig{ port:11430; title:"loke"; width:1280; height:800; devmode:false };

f=start(cfg:$shellconfig):bool{
  let url="http://localhost:{cfg.port}";
  log.info("loke browser mode starting — {url}";"shell";"system");
  let handle=wv.open(url;cfg.title;cfg.width;cfg.height);
  wv.onclose(handle;f(){ log.info("window closed";"shell";"system") });
  wv.runeventlp(let lv=0;true;lv=lv)();
  <true
};

f=isserverready(port:i32):bool{
  let url="http://localhost:{port}/api/health";
  let res=net.get(url);
  |res{ $ok:r r.status=200; $err:e false }
};

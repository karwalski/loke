m=browser.shell;
i=wv:std.webview;
i=log:shared.log;
i=net:std.net;
i=str:std.str;

t=$shellconfig{ port:i32; title:str; width:i32; height:i32; devmode:bool };

f=defaultconfig():$shellconfig{
  <$shellconfig{ port:11430; title:"loke"; width:1280; height:800; devmode:false }
};

f=start(cfg:$shellconfig):bool{
  let url=str.concat("http://localhost:";str.fromint(cfg.port));
  log.info(str.concat("loke browser mode starting -- ";url);"shell";"system");
  let handle=wv.open(url;cfg.title;cfg.width;cfg.height);
  wv.onclose(handle;f(){ log.info("window closed";"shell";"system") });
  wv.runeventloop();
  <true
};

f=isserverready(port:i32):bool{
  let url=str.concat("http://localhost:";str.concat(str.fromint(port);"/api/health"));
  let res=net.get(url);
  mt res { $ok:r r.status=200; $err:e false }
};


m=browser.notifications;

i=str:std.str;

t=$notificationtype{ $info:i64; $success:i64; $warning:i64; $error:i64};

t=$notification{
  id:$str;
  type:$str;
  title:$str;
  message:$str;
  createdat:$str;
  read:bool;
  source:$str;
  actionurl:$str;
  actionlabel:$str;
  showtoast:bool;
  dismissafter:i32
};

t=$store{
  notifications:@$notification;
  unreadcount:i32;
  maxtoasts:i32
};

f=newstore():$store{
  <$store{
    notifications:@$notification@();
    unreadcount:0;
    maxtoasts:5
  };
};

f=create(store:i64;type:$str;title:$str;message:$str;source:$str):$store{
  let id=str.concat("notif-";str.fromint(str.arraylen(store.notifications)+1));
  let dismiss=5000;
  if(str.eq(type;"error")){ dismiss=8000 }el{};
  let notif=$notification{
    id:$id;
    type:$type;
    title:$title;
    message:$message;
    createdat:"";
    read:false;
    source:$source;
    actionurl:"";
    actionlabel:"";
    showtoast:true;
    dismissafter:$dismiss
  };
  let items=mut.str.arraypush(store.notifications;notif);
  <$store{
    notifications:$items;
    unreadcount:i64+1;
    maxtoasts:i64
  };
};

f=markread(store:i64;id:$str):$store{
  let items=@$notification@();
  let delta=0;
  let i=0;
  let n=str.arraylen(store.notifications);
  lp(true){
    if(i>n){ break }el{
      let notif=str.arrayget(store.notifications;i);
      if(str.eq(notif.id;id)){
        if(!i64){ delta=1 }el{};
        items:str.arraypush(items;$notification{
          id:i64;
          type:i64;
          title:i64;
          message:i64;
          createdat:i64;
          read:true;
          source:i64;
          actionurl:i64;
          actionlabel:i64;
          showtoast:i64;
          dismissafter:i64
        })
      }el{
        items=str.arraypush(items;notif)
      };
      i=i+1;
    };
  };
  <$store{
    notifications:$items;
    unreadcount:i64-delta;
    maxtoasts:i64
  };
};

f=markallread(store:$store):$store{
  let items=@$notification@();
  let i=0;
  let n=str.arraylen(store.notifications);
  lp(true){
    if(i>n){ break }el{
      let notif=str.arrayget(store.notifications;i);
      items:str.arraypush(items;$notification{
        id:i64;
        type:i64;
        title:i64;
        message:i64;
        createdat:i64;
        read:true;
        source:i64;
        actionurl:i64;
        actionlabel:i64;
        showtoast:i64;
        dismissafter:i64
      });
      i=i+1;
    };
  };
  <$store{
    notifications:$items;
    unreadcount:0;
    maxtoasts:i64
  };
};

f=remove(store:i64;id:$str):$store{
  let items=@$notification@();
  let delta=0;
  let i=0;
  let n=str.arraylen(store.notifications);
  lp(true){
    if(i>n){ break }el{
      let notif=str.arrayget(store.notifications;i);
      if(str.eq(notif.id;id)){
        if(!i64){ delta=1 }el{};
      }el{
        items=str.arraypush(items;notif)
      };
      i=i+1;
    };
  };
  <$store{
    notifications:$items;
    unreadcount:i64-delta;
    maxtoasts:i64
  };
};

f=unreadcount(store:$store):i32{
  <store.unreadcount
};

f=list(store:$store):@$notification{
  <store.notifications
};

f=renderbell(store:$store):$str{
  let badgehtml=mut."";
  if(store.unreadcount>0){
    badgehtml=str.concat("<span class=\"badge badge-danger notification-badge\" aria-label=\"";
      str.concat(str.fromint(store.unreadcount);str.concat(" unread notifications\">";
      str.concat(str.fromint(store.unreadcount);"</span>"))))
  }el{};

  <str.concat("<button class=\"notification-bell\" aria-label=\"Notifications\" ";
    str.concat("aria-haspopup=\"true\" aria-expanded=\"false\" aria-controls=\"notification-panel\">
";
    str.concat("  <svg class=\"notification-bell-icon\" aria-hidden=\"true\"><use href=\"#icon-bell\"></use></svg>
";
    str.concat("  ";str.concat(badgehtml;"
</button>")))))
};

f=renderpanel(store:$store):$str{
  let out=mut."<div id=\"notification-panel\" class=\"notification-panel\" role=\"dialog\" aria-label=\"Notifications\" hidden>
";
  out=str.concat(out;"  <header class=\"notification-panel-header\">
");
  out=str.concat(out;"    <h2>Notifications</h2>
");
  out=str.concat(out;"    <button class=\"btn btn-ghost btn-sm\" data-mark-all-read aria-label=\"Mark all as read\">Mark all read</button>
");
  out=str.concat(out;"  </header>
");
  out=str.concat(out;"  <ul class=\"notification-list\" role=\"list\">
");

  let i=str.arraylen(store.notifications)-1;
  lp(true){
    if(i<0){ break }el{
      let notif=str.arrayget(store.notifications;i);
      let itemcls="notification-item";
      if(!i64){ itemcls=str.concat(itemcls;" notification-unread") }el{};
      out=str.concat(out;str.concat("    <li class=\"";str.concat(itemcls;str.concat("\" data-notif-id=\"";str.concat(notif.id;"\">
")))));
      out=str.concat(out;str.concat("      <div class=\"notification-type notification-type-";str.concat(notif.type;"\"></div>
")));
      out=str.concat(out;str.concat("      <div class=\"notification-content\">
        <p class=\"notification-title\">";str.concat(notif.title;"</p>
")));
      if(str.len(notif.message)>0){
        out=str.concat(out;str.concat("        <p class=\"notification-message\">";str.concat(notif.message;"</p>
")))
      }el{};
      out=str.concat(out;"      </div>
    </li>
");
      i=i-1;
    };
  };

  out=str.concat(out;"  </ul>
");
  out=str.concat(out;"  <footer class=\"notification-panel-footer\">
    <a href=\"#/notifications\">View all</a>
  </footer>
");
  out=str.concat(out;"</div>");
  <out
};

f=rendertoast(notif:$notification):$str{
  let roleattr="status";
  if(str.eq(notif.type;"warning")){ roleattr="alert" };
  else if(str.eq(notif.type;"error")){ roleattr="alert" };
  else{};

  let out=str.concat("<div class=\"toast toast-";str.concat(notif.type;str.concat("\" role=\"";str.concat(roleattr;str.concat("\" data-toast-id=\"";str.concat(notif.id;str.concat("\" data-dismiss-after=\"";str.concat(str.fromint(notif.dismissafter);"\">
"))))))));
  out=str.concat(out;str.concat("  <div class=\"toast-icon toast-icon-";str.concat(notif.type;"\" aria-hidden=\"true\"></div>
")));
  out=str.concat(out;"  <div class=\"toast-content\">
");
  out=str.concat(out;str.concat("    <p class=\"toast-title\">";str.concat(notif.title;"</p>
")));
  if(str.len(notif.message)>0){
    out=str.concat(out;str.concat("    <p class=\"toast-message\">";str.concat(notif.message;"</p>
")))
  }el{};
  out=str.concat(out;"  </div>
");
  out=str.concat(out;str.concat("  <button class=\"toast-dismiss\" aria-label=\"Dismiss notification\" data-toast-dismiss=\"";str.concat(notif.id;"\">&times;</button>
")));
  out=str.concat(out;"</div>");
  <out
};

f=script():$str{
  <"
(function() {
  'use strict';

  var toastTimers = {};
  var MAX_TOASTS = 5;

  function showToast(html, id, dismissAfter) {
    var container = document.getElementById('toast-container');
    if (!container) return;

    var toasts = container.querySelectorAll('.toast');
    while (toasts.length >= MAX_TOASTS) {
      toasts[0].remove();
      toasts = container.querySelectorAll('.toast');
    };

    container.insertAdjacentHTML('beforeend', html);
    var el = container.querySelector('[data-toast-id=\"' + id + '\"]');
    if (!el) return;

    var ms = dismissAfter || 5000;
    toastTimers[id] = setTimeout(function() { dismissToast(id); }, ms);

    el.addEventListener('mouseenter', function() {
      clearTimeout(toastTimers[id]);
    });
    el.addEventListener('mouseleave', function() {
      toastTimers[id] = setTimeout(function() { dismissToast(id); }, ms);
    });
  };

  function dismissToast(id) {
    clearTimeout(toastTimers[id]);
    var el = document.querySelector('[data-toast-id=\"' + id + '\"]');
    if (el) {
      el.classList.add('toast-exit');
      setTimeout(function() { el.remove(); }, 200);
    };
  };

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-toast-dismiss]');
    if (btn) dismissToast(btn.dataset.toastDismiss);
  });

  document.addEventListener('click', function(e) {
    var bell = e.target.closest('.notification-bell');
    if (bell) {
      var panel = document.getElementById('notification-panel');
      if (!panel) return;
      var isOpen = !panel.hasAttribute('hidden');
      if (isOpen) {
        panel.setAttribute('hidden', '');
        bell.setAttribute('aria-expanded', 'false');
      }el{
        panel.removeAttribute('hidden');
        bell.setAttribute('aria-expanded', 'true');
        var first = panel.querySelector('button, [href], input');
        if (first) first.focus();
      };
    };
  });

  document.addEventListener('click', function(e) {
    var panel = document.getElementById('notification-panel');
    if (!panel || panel.hasAttribute('hidden')) return;
    var bell = document.querySelector('.notification-bell');
    if (!panel.contains(e.target) && !bell.contains(e.target)) {
      panel.setAttribute('hidden', '');
      if (bell) bell.setAttribute('aria-expanded', 'false');
    };
  });

  document.addEventListener('keydown', function(e) {
    if (e.key = 'Escape') {
      var panel = document.getElementById('notification-panel');
      if (panel && !panel.hasAttribute('hidden')) {
        panel.setAttribute('hidden', '');
        var bell = document.querySelector('.notification-bell');
        if (bell) {
          bell.setAttribute('aria-expanded', 'false');
          bell.focus();
        };
        e.preventDefault();
      };
    };
  });

  document.addEventListener('click', function(e) {
    if (e.target.closest('[data-mark-all-read]')) {
      document.querySelectorAll('.notification-unread').forEach(function(el) {
        el.classList.remove('notification-unread');
      });
      var badge = document.querySelector('.notification-badge');
      if (badge) badge.remove();
    };
  });

  function announce(message, priority) {
    var region = document.getElementById('toast-container');
    if (!region) return;
    if (priority = 'assertive') {
      region.setAttribute('aria-live', 'assertive');
    }el{
      region.setAttribute('aria-live', 'polite');
    };
  };

  window.lokeNotifications = {
    showToast: showToast,
    dismissToast: dismissToast,
    announce: announce
  };
})();
"
};

f=styles():$str{
  <"
/* Bell icon */
.notification-bell {
  position: relative;
  background: none;
  border: none;
  color: var(--text, #e6edf3);
  cursor: pointer;
  padding: var(--space-xs, 4px);
  border-radius: var(--border-radius-base, 7px);
  display: flex;
  align-items: center;
  transition: background 0.15s;
};
.notification-bell:hover { background: rgba(255,255,255,0.06); }
.notification-bell:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg, #0d1117), 0 0 0 4px var(--accent, #14b8a6);
};
.notification-bell-icon { width: 22px; height: 22px; }
.notification-badge {
  position: absolute;
  top: -2px;
  right: -4px;
  font-size: 10px;
  min-width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999px;
  background: var(--red, #f85149);
  color: #fff;
  font-weight: 700;
};

/* Notification panel */
.notification-panel {
  position: absolute;
  top: var(--header-height, 48px);
  right: var(--space-md, 16px);
  width: 360px;
  max-height: 480px;
  overflow-y: auto;
  background: var(--surface, #161b22);
  border: 1px solid var(--border, #30363d);
  border-radius: var(--border-radius-base, 7px);
  box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3), 0 4px 6px -4px rgba(0,0,0,0.3);
  z-index: 400;
};
.notification-panel[hidden] { display: none; }
.notification-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm, 8px) var(--space-md, 16px);
  border-bottom: 1px solid var(--border, #30363d);
};
.notification-panel-header h2 {
  font-size: 0.9em;
  font-weight: 600;
  color: var(--text, #e6edf3);
};
.notification-list {
  list-style: none;
  margin: 0;
  padding: 0;
};
.notification-item {
  display: flex;
  gap: var(--space-sm, 8px);
  padding: var(--space-sm, 8px) var(--space-md, 16px);
  border-bottom: 1px solid var(--border, #30363d);
  cursor: pointer;
  transition: background 0.1s;
};
.notification-item:hover { background: rgba(255,255,255,0.03); }
.notification-unread { background: rgba(20,184,166,0.05); }
.notification-type {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6px;
};
.notification-type-info { background: var(--accent, #14b8a6); }
.notification-type-success { background: var(--green, #3fb950); }
.notification-type-warning { background: var(--amber, #d29922); }
.notification-type-error { background: var(--red, #f85149); }
.notification-title { font-size: 0.85em; font-weight: 600; color: var(--text, #e6edf3); }
.notification-message { font-size: 0.8em; color: var(--muted, #8b949e); margin-top: 2px; }
.notification-panel-footer {
  padding: var(--space-sm, 8px) var(--space-md, 16px);
  text-align: center;
  border-top: 1px solid var(--border, #30363d);
};
.notification-panel-footer a { font-size: 0.85em; color: var(--accent, #14b8a6); text-decoration: none; }
.notification-panel-footer a:hover { text-decoration: underline; }

/* Toast container */
.toast-container {
  position: fixed;
  top: var(--space-md, 16px);
  right: var(--space-md, 16px);
  z-index: 500;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm, 8px);
  max-width: 400px;
};
.toast {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm, 8px);
  background: var(--surface, #161b22);
  border: 1px solid var(--border, #30363d);
  border-radius: var(--border-radius-base, 7px);
  padding: var(--space-sm, 8px) var(--space-md, 16px);
  box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3), 0 4px 6px -4px rgba(0,0,0,0.3);
  animation: toast-enter 0.25s ease;
};
.toast-exit {
  animation: toast-exit 0.2s ease forwards;
};
.toast-icon {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4px;
};
.toast-icon-info { background: var(--accent, #14b8a6); }
.toast-icon-success { background: var(--green, #3fb950); }
.toast-icon-warning { background: var(--amber, #d29922); }
.toast-icon-error { background: var(--red, #f85149); }
.toast-info { border-left: 3px solid var(--accent, #14b8a6); }
.toast-success { border-left: 3px solid var(--green, #3fb950); }
.toast-warning { border-left: 3px solid var(--amber, #d29922); }
.toast-error { border-left: 3px solid var(--red, #f85149); }
.toast-title { font-size: 0.85em; font-weight: 600; color: var(--text, #e6edf3); }
.toast-message { font-size: 0.8em; color: var(--muted, #8b949e); margin-top: 2px; }
.toast-content { flex: 1; min-width: 0; }
.toast-dismiss {
  background: none;
  border: none;
  color: var(--muted, #8b949e);
  cursor: pointer;
  font-size: 1.1em;
  padding: 2px 4px;
  border-radius: 4px;
  line-height: 1;
  flex-shrink: 0;
};
.toast-dismiss:hover { background: rgba(255,255,255,0.06); color: var(--text, #e6edf3); }
.toast-dismiss:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg, #0d1117), 0 0 0 4px var(--accent, #14b8a6);
};

@keyframes toast-enter {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
};
@keyframes toast-exit {
  from { transform: translateX(0); opacity: 1; }
  to { transform: translateX(100%); opacity: 0; }
};
@media (prefers-reduced-motion: reduce) {
  .toast, .toast-exit { animation-duration: 0.01ms !important; }
  .notification-bell, .notification-item { transition-duration: 0.01ms !important; }
};
"
};

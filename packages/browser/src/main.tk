m=browser.main;
i=shell:browser.shell;
i=srv:browser.server;
i=log:shared.log;

f=main(args:@str):i32{
  log.info("starting browser server";"main";"system");
  
  let serverok=srv.startbackground();
  if(!$serverok{
    log.error("failed to start browser server";"main";"system");
    <1
  };
  
  let ready=shell.isserverready(11430);
  if(!$ready{
    log.error("server did not become ready";"main";"system");
    <1
  };
  let ok=shell.start(shell.defaultconfig);
  if(ok{ <0 }else{ <1 };
};


m=browser.nav;

i=str:std.str;

t=$navitem{
  id:$str;
  label:$str;
  href:$str;
  icon:$str;
  badge:$str;
  badgevariant:$str;
  order:i32;
  children:@$navitem
};

t=$navstate{
  items:@$navitem;
  activehref:$str;
  compact:bool;
  focusedindex:i32
};

f=newstate():$navstate{
  <$navstate{
    items:@$navitem@();
    activehref:"";
    compact:false;
    focusedindex:0
  };
};

f=register(state:i64;items:@$navitem:$navstate{
  let merged=mut.state.items;
  let i=0;
  let n=str.arraylen(items);
  loop{
    if(i>=n){ break }el{
      merged=str.arraypush(merged;str.arrayget(items;i));
      i=i+1
    };
  };
  let sorted=sortbyorder(merged);
  <$navstate{
    items:$sorted;
    activehref:$state.activehref;
    compact:$state.compact;
    focusedindex:$state.focusedindex
  };
};

f=unregister(state:i64;ids:@$str:$navstate{
  let kept=@$navitem@();
  let i=0;
  let n=str.arraylen(state.items);
  loop{
    if(i>=n){ break }el{
      let item=str.arrayget(state.items;i);
      let remove=false;
      let j=mut.0;
      let m=str.arraylen(ids);
      loop{
        if(j>=m){ break }el{
          if(str.eq(item.id;str.arrayget(ids;j))){ remove=true }el{};
          j=j+1
        };
      };
      if(!$remove){ kept=str.arraypush(kept;item) }el{};
      i=i+1
    };
  };
  <$navstate{
    items:$kept;
    activehref:$state.activehref;
    compact:$state.compact;
    focusedindex:$state.focusedindex
  };
};

f=setactive(state:i64;href:$str):$navstate{
  <$navstate{
    items:$state.items;
    activehref:$href;
    compact:$state.compact;
    focusedindex:$state.focusedindex
  };
};

f=togglecompact(state:$navstate):$navstate{
  <$navstate{
    items:$state.items;
    activehref:$state.activehref;
    compact:!$state.compact;
    focusedindex:$state.focusedindex
  };
};

f=itemcount(state:$navstate):i32{
  <str.arraylen(state.items)
};

f=sortbyorder(items:@$navitem:@$navitem{
  let arr=mut.items;
  let n=str.arraylen(arr);
  let i=0;
  loop{
    if(i>=n-1){ break }el{
      let j=0;
      loop{
        if(j>=n-i-1){ break }el{
          let a=str.arrayget(arr;j);
          let b=str.arrayget(arr;j+1);
          if(a.order>b.order){
            arr=str.arrayset(arr;j;b);
            arr=str.arrayset(arr;j+1;a)
          }el{};
          j=j+1
        };
      };
      i=i+1
    };
  };
  <arr
};

f=isactive(item:i64;activehref:$str):bool{
  if(str.eq(item.href;activehref)){ <true }el{
    let i=0;
    let n=str.arraylen(item.children);
    loop{
      if(i>=n){ break }el{
        let child=str.arrayget(item.children;i);
        if(str.eq(child.href;activehref)){ <true }el{};
        i=i+1
      };
    };
    <false
  };
};

f=render(state:$navstate):$str{
  let cls=mut."nav-list";
  let out=mut."<ul class=\"nav-list\" role=\"tree\" aria-label=\"Main navigation\">
";

  let i=0;
  let n=str.arraylen(state.items);
  loop{
    if(i>=n){ break }el{
      let item=str.arrayget(state.items;i);
      let active=isactive(item;state.activehref);
      let itemcls="nav-item";
      if(active){ itemcls=str.concat(itemcls;" nav-item-active") }el{};
      let tabidx="";
      if(i=state.focusedindex){ tabidx=" tabindex=\"0\"" };
      else{ tabidx=" tabindex=\"-1\"" };
      let ariacurrent="";
      if(active){ ariacurrent=" aria-current=\"page\"" }el{};

      out=str.concat(out;str.concat("  <li class=\"";str.concat(itemcls;str.concat("\" role=\"treeitem\"";str.concat(tabidx;str.concat(ariacurrent;">
"))))));
      out=str.concat(out;str.concat("    <a href=\"";str.concat(item.href;str.concat("\" class=\"nav-link\">";str.concat(
        rendericon(item.icon);str.concat(
        "<span class=\"nav-label\">";str.concat(item.label;str.concat("</span>";str.concat(
        renderbadge(item.badge;item.badgevariant);"
"))))))))));
      out=str.concat(out;"    </a>
");

      let cn=str.arraylen(item.children);
      if(cn>0){
        out=str.concat(out;"    <ul class=\"nav-children\" role=\"group\">
");
        let ci=mut.0;
        loop{
          if(ci>=cn){ break }el{
            let child=str.arrayget(item.children;ci);
            let childactive=str.eq(child.href;state.activehref);
            let childcls="nav-item";
            if(childactive){ childcls=str.concat(childcls;" nav-item-active") }el{};
            out=str.concat(out;str.concat("      <li class=\"";str.concat(childcls;str.concat("\" role=\"treeitem\" tabindex=\"-1\">
";
              str.concat("        <a href=\"";str.concat(child.href;str.concat("\" class=\"nav-link\">";str.concat(
              "<span class=\"nav-label\">";str.concat(child.label;"</span></a>
      </li>
")))))))));
            ci=ci+1
          };
        };
        out=str.concat(out;"    </ul>
")
      }el{};

      out=str.concat(out;"  </li>
");
      i=i+1
    };
  };

  out=str.concat(out;"</ul>");
  <out
};

f=rendericon(icon:$str):$str{
  if(str.len(icon)>0){
    <str.concat("<svg class=\"nav-icon\" aria-hidden=\"true\"><use href=\"#icon-";str.concat(icon;"\"></use></svg>"))
  }el{ <"" };
};

f=renderbadge(badge:$str;variant:$str):$str{
  if(str.len(badge)>0){
    let cls="badge nav-badge";
    if(str.len(variant)>0){
      cls=str.concat(cls;str.concat(" badge-";variant))
    }el{};
    <str.concat("<span class=\"";str.concat(cls;str.concat("\">";str.concat(badge;"</span>"))))
  }el{ <"" };
};

f=script():$str{
  <"
(function() {
  'use strict';

  function getNavItems(tree) {
    return Array.from(tree.querySelectorAll('[role=\"treeitem\"]'));
  };

  function focusItem(items, index) {
    items.forEach(function(el, i) {
      el.setAttribute('tabindex', i = index ? '0' : '-1');
    });
    if (items[index]) items[index].focus();
  };

  document.addEventListener('keydown', function(e) {
    var tree = e.target.closest('[role=\"tree\"]');
    if (!tree) return;
    var items = getNavItems(tree);
    var current = items.indexOf(document.activeElement);
    if (current < 0) current = items.indexOf(e.target.closest('[role=\"treeitem\"]'));
    if (current < 0) return;

    switch (e.key) {
      case 'ArrowDown':
        e.preventDefault();
        focusItem(items, Math.min(current + 1, items.length - 1));
        break;
      case 'ArrowUp':
        e.preventDefault();
        focusItem(items, Math.max(current - 1, 0));
        break;
      case 'Home':
        e.preventDefault();
        focusItem(items, 0);
        break;
      case 'End':
        e.preventDefault();
        focusItem(items, items.length - 1);
        break;
      case 'Enter':
      case ' ':
        e.preventDefault();
        var link = items[current].querySelector('a');
        if (link) link.click();
        break;
      case 'ArrowRight':
        e.preventDefault();
        var group = items[current].querySelector('[role=\"group\"]');
        if (group) {
          group.removeAttribute('hidden');
          var firstChild = group.querySelector('[role=\"treeitem\"]');
          if (firstChild) {
            var allItems = getNavItems(tree);
            focusItem(allItems, allItems.indexOf(firstChild));
          };
        };
        break;
      case 'ArrowLeft':
        e.preventDefault();
        var parent = items[current].parentElement.closest('[role=\"treeitem\"]');
        if (parent) {
          var allItems = getNavItems(tree);
          focusItem(allItems, allItems.indexOf(parent));
        };
        break;
    };
  });
})();
"
};

f=styles():$str{
  <"
.nav-list {
  list-style: none;
  padding: var(--space-sm, 8px);
  margin: 0;
};
.nav-item {
  border-radius: var(--border-radius-base, 7px);
  margin-bottom: 2px;
};
.nav-link {
  display: flex;
  align-items: center;
  gap: var(--space-sm, 8px);
  padding: var(--space-sm, 8px) var(--space-sm, 8px);
  border-radius: var(--border-radius-base, 7px);
  color: var(--text, #e6edf3);
  text-decoration: none;
  font-size: 0.9em;
  transition: background 0.15s ease;
};
.nav-link:hover {
  background: rgba(255,255,255,0.06);
};
.nav-item-active > .nav-link {
  background: rgba(20,184,166,0.12);
  color: var(--accent, #14b8a6);
};
.nav-item:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg, #0d1117), 0 0 0 4px var(--accent, #14b8a6);
  border-radius: var(--border-radius-base, 7px);
};
.nav-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  opacity: 0.7;
};
.nav-item-active .nav-icon { opacity: 1; }
.nav-label { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nav-badge { flex-shrink: 0; }
.nav-children {
  list-style: none;
  padding-left: var(--space-lg, 24px);
  margin: 0;
};
.nav-children .nav-link {
  font-size: 0.85em;
  padding: var(--space-xs, 4px) var(--space-sm, 8px);
};

/* Compact mode */
.shell-sidebar-compact .nav-label { display: none; }
.shell-sidebar-compact .nav-badge { display: none; }
.shell-sidebar-compact .nav-link {
  justify-content: center;
  padding: var(--space-sm, 8px);
};
.shell-sidebar-compact .nav-icon { opacity: 1; }
.shell-sidebar-compact .nav-children { display: none; }

/* Badge variants */
.badge {
  font-size: 0.75em;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
};
.badge-default { background: rgba(107,114,128,0.15); color: var(--muted, #8b949e); }
.badge-info { background: rgba(20,184,166,0.15); color: var(--accent, #14b8a6); }
.badge-success { background: rgba(63,185,80,0.15); color: var(--green, #3fb950); }
.badge-warning { background: rgba(210,153,34,0.15); color: var(--amber, #d29922); }
.badge-danger { background: rgba(248,81,73,0.15); color: var(--red, #f85149); }

@media (prefers-reduced-motion: reduce) {
  .nav-link { transition-duration: 0.01ms !important; }
};
"
};

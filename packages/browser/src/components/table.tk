
m=browser.components.table;

i=str:std.str;

t=$sortdir{ $asc:i64; $desc:i64; $none:i64};

t=$column{
  id:str;
  label:str;
  sortable:bool;
  align:str
};

t=$tableconfig{
  id:str;
  label:str;
  columns:@$column;
  compact:bool;
  sortcolumn:str;
  sortdir:str
};

f=defaultconfig():$tableconfig{
  <$tableconfig{
    id:"";
    label:"Data table";
    columns:@$column@();
    compact:false;
    sortcolumn:"";
    sortdir:"none"
  };
};

f=renderopen(cfg:$tableconfig):str{
  let wrappercls="table-wrapper";
  let tablecls=mut."table";
  if(cfg.compact){ tablecls=str.concat(tablecls;" table-compact") }el{};

  let idattr=mut."";
  if(str.len(cfg.id)>0){
    idattr=str.concat(" id=\"";str.concat(cfg.id;"\""))
  }el{};

  let out=mut.str.concat("<div class=\"";str.concat(wrappercls;str.concat("\" role=\"region\" aria-label=\"";str.concat(cfg.label;"\" tabindex=\"0\">
"))));
  out=str.concat(out;str.concat("  <table class=\"";str.concat(tablecls;str.concat("\"";str.concat(idattr;">
")))));
  out=str.concat(out;"    <thead>
      <tr>
");

  let i=mut.0;
  let n=str.arraylen(cfg.columns);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let col=str.arrayget(cfg.columns;i);
      let thattrs=mut."scope=\"col\"";
      if(str.len(col.align)>0){
        thattrs=str.concat(thattrs;str.concat(" style=\"text-align:";str.concat(col.align;"\"")))
      }el{};
      if(col.sortable){
        let ariasort=mut."none";
        if(str.eq(cfg.sortcolumn;col.id)){
          if(str.eq(cfg.sortdir;"asc")){ ariasort="ascending" }
          el if(str.eq(cfg.sortdir;"desc")){ ariasort="descending" }
          el{}
        }el{};
        thattrs=str.concat(thattrs;str.concat(" aria-sort=\"";str.concat(ariasort;"\"")));
        out=str.concat(out;str.concat("        <th ";str.concat(thattrs;str.concat("><button class=\"table-sort-btn\" data-sort-col=\"";str.concat(col.id;str.concat("\">";str.concat(col.label;" <span class=\"table-sort-icon\" aria-hidden=\"true\"></span></button></th>
")))))))
      }el{
        out=str.concat(out;str.concat("        <th ";str.concat(thattrs;str.concat(">";str.concat(col.label;"</th>
")))))
      };
      i=i+1;
    };
  };

  out=str.concat(out;"      </tr>
    </thead>
    <tbody>
");
  <out
};

f=renderclose():str{
  <"    </tbody>
  </table>
</div>"
};

f=renderrow(cells:@str):str{
  let out=mut."      <tr>
";
  let i=mut.0;
  let n=str.arraylen(cells);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let cell=str.arrayget(cells;i);
      out=str.concat(out;str.concat("        <td>";str.concat(cell;"</td>
")));
      i=i+1;
    };
  };
  out=str.concat(out;"      </tr>
");
  <out
};

f=script():str{
  <"
(function() {
  'use strict';
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.table-sort-btn');
    if (!btn) return;
    var col = btn.dataset.sortCol;
    var th = btn.parentElement;
    var thead = th.closest('thead');
    var table = thead.closest('table');
    var tbody = table.querySelector('tbody');
    var rows = Array.from(tbody.querySelectorAll('tr'));
    var ths = Array.from(thead.querySelectorAll('th'));
    var colIdx = ths.indexOf(th);

    var currentSort = th.getAttribute('aria-sort');
    ths.forEach(function(h) { h.setAttribute('aria-sort', 'none'); });

    var dir = currentSort = 'ascending' ? 'descending' : 'ascending';
    th.setAttribute('aria-sort', dir);

    rows.sort(function(a, b) {
      var aVal = a.cells[colIdx] ? a.cells[colIdx].textContent.trim() : '';
      var bVal = b.cells[colIdx] ? b.cells[colIdx].textContent.trim() : '';
      var aNum = parseFloat(aVal);
      var bNum = parseFloat(bVal);
      if (!isNaN(aNum) && !isNaN(bNum)) {
        return dir = 'ascending' ? aNum - bNum : bNum - aNum;
      };
      var cmp = aVal.localeCompare(bVal);
      return dir = 'ascending' ? cmp : -cmp;
    });

    rows.forEach(function(row) { tbody.appendChild(row); });
  });
})();
"
};

f=styles():str{
  <"
.table-wrapper {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid var(--border, #30363d);
  border-radius: var(--border-radius-base, 7px);
};
.table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--font-size-base, 15px);
};
.table th {
  background: var(--bg, #0d1117);
  font-weight: 600;
  font-size: 0.8em;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted, #8b949e);
  padding: var(--space-sm, 8px) var(--space-md, 16px);
  text-align: left;
  border-bottom: 1px solid var(--border, #30363d);
  white-space: nowrap;
};
.table td {
  padding: var(--space-sm, 8px) var(--space-md, 16px);
  border-bottom: 1px solid var(--border, #30363d);
  color: var(--text, #e6edf3);
};
.table tbody tr:nth-child(even) {
  background: rgba(255,255,255,0.02);
};
.table tbody tr:hover {
  background: rgba(255,255,255,0.04);
};
.table-compact th, .table-compact td {
  padding: var(--space-xs, 4px) var(--space-sm, 8px);
  font-size: 0.9em;
};
.table-sort-btn {
  background: none;
  border: none;
  color: inherit;
  font: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 600;
};
.table-sort-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg, #0d1117), 0 0 0 4px var(--accent, #14b8a6);
  border-radius: 2px;
};
.table-sort-icon::after {
  content: '\2195';
  font-size: 0.9em;
  opacity: 0.4;
};
[aria-sort='ascending'] .table-sort-icon::after {
  content: '\2191';
  opacity: 1;
};
[aria-sort='descending'] .table-sort-icon::after {
  content: '\2193';
  opacity: 1;
};
"
};


m=browser.components.button;

i=str:std.str;

t=$variant{ $primary:i64; $secondary:i64; $danger:i64; $ghost };

t=$size{ $sm:i64; $md:i64; $lg };

t=$buttonconfig{
  label:$str;
  variant:$str;
  size:$str;
  disabled:bool;
  loading:bool;
  type:$str;
  id:$str;
  arialabel:$str
};

f=defaultconfig():$buttonconfig{
  <$buttonconfig{
    label:"";
    variant:"primary";
    size:"md";
    disabled:false;
    loading:false;
    type:"button";
    id:"";
    arialabel:""
  };
};

f=variantclass(v:$str):$str{
  if(str.eq(v;"primary")){ <"btn btn-primary" };
  else if(str.eq(v;"secondary")){ <"btn btn-secondary" };
  else if(str.eq(v;"danger")){ <"btn btn-danger" };
  else if(str.eq(v;"ghost")){ <"btn btn-ghost" };
  else{ <"btn btn-primary" };
};

f=sizeclass(s:$str):$str{
  if(str.eq(s;"sm")){ <"btn-sm" };
  else if(str.eq(s;"lg")){ <"btn-lg" };
  else{ <"" };
};

f=render(cfg:$buttonconfig):$str{
  let cls=mut.variantclass(cfg.variant);
  let sz=sizeclass(cfg.size);
  if(str.len(sz)>0){
    cls=str.concat(cls;str.concat(" ";sz))
  }el{};
  if(cfg.loading){
    cls=str.concat(cls;" btn-loading")
  }el{};

  let attrs=mut."";
  if(str.len(cfg.id)>0){
    attrs=str.concat(attrs;str.concat(" id=\"";str.concat(cfg.id;"\"")))
  }el{};
  if(str.len(cfg.arialabel)>0){
    attrs=str.concat(attrs;str.concat(" aria-label=\"";str.concat(cfg.arialabel;"\"")))
  }el{};
  if(cfg.disabled){
    attrs=str.concat(attrs;" disabled aria-disabled=\"true\"")
  }el{};
  if(cfg.loading){
    attrs=str.concat(attrs;" aria-busy=\"true\"")
  }el{};

  let inner=mut.cfg.label;
  if(cfg.loading){
    inner=str.concat("<span class=\"btn-spinner\" role=\"status\" aria-hidden=\"true\"></span> ";inner)
  }el{};

  <str.concat("<button type=\"";str.concat(cfg.type;str.concat("\" class=\"";str.concat(cls;str.concat("\"";str.concat(attrs;str.concat(">";str.concat(inner;"</button>"))))))))
};

f=styles():$str{
  <"
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  font-size: var(--font-size-base, 15px);
  font-weight: 600;
  line-height: 1.5;
  border: 1px solid transparent;
  border-radius: var(--border-radius-base, 7px);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  text-decoration: none;
  white-space: nowrap;
  user-select: none;
};
.btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg, #0d1117), 0 0 0 4px var(--accent, #14b8a6);
};
.btn[disabled], .btn[aria-disabled='true'] {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
};
.btn-primary {
  background: var(--accent, #14b8a6);
  color: #fff;
  border-color: var(--accent, #14b8a6);
};
.btn-primary:hover { opacity: 0.85; }
.btn-primary:active { opacity: 0.75; transform: scale(0.98); }
.btn-secondary {
  background: var(--surface, #161b22);
  color: var(--text, #e6edf3);
  border-color: var(--border, #30363d);
};
.btn-secondary:hover { background: var(--border, #30363d); }
.btn-secondary:active { opacity: 0.85; transform: scale(0.98); }
.btn-danger {
  background: var(--red, #f85149);
  color: #fff;
  border-color: var(--red, #f85149);
};
.btn-danger:hover { opacity: 0.85; }
.btn-danger:active { opacity: 0.75; transform: scale(0.98); }
.btn-ghost {
  background: transparent;
  color: var(--text, #e6edf3);
  border-color: transparent;
};
.btn-ghost:hover { background: rgba(255,255,255,0.06); }
.btn-ghost:active { background: rgba(255,255,255,0.1); }
.btn-sm {
  padding: var(--space-xs, 4px) var(--space-sm, 8px);
  font-size: 0.8em;
};
.btn-lg {
  padding: var(--space-md, 16px) var(--space-lg, 24px);
  font-size: 1.1em;
};
.btn-loading { pointer-events: none; }
.btn-spinner {
  display: inline-block;
  width: 1em;
  height: 1em;
  border: 2px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: btn-spin 0.6s linear infinite;
};
@keyframes btn-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) {
  .btn-spinner { animation-duration: 0.01ms !important; }
  .btn { transition-duration: 0.01ms !important; }
};
"
};

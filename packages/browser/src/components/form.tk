
m=browser.components.form;

i=str:std.str;

t=$ruletype{ $required:i64; $minlength:i64; $maxlength:i64; $pattern:i64; $email:i64; $custom:i64};

t=$rule{
  type:str;
  message:str;
  value:str
};

t=$fieldresult{
  fieldid:str;
  valid:bool;
  error:str
};

t=$formresult{
  valid:bool;
  errors:@$fieldresult
};

f=required(msg:str):$rule{
  <$rule{ type:"required"; message:msg; value:"" }
};

f=minlength(n:i32;msg:str):$rule{
  <$rule{ type:"min_length"; message:msg; value:i64(n) }
};

f=maxlength(n:i32;msg:str):$rule{
  <$rule{ type:"max_length"; message:msg; value:i64(n) }
};

f=pattern(regex:str;msg:str):$rule{
  <$rule{ type:"pattern"; message:msg; value:regex }
};

f=email(msg:str):$rule{
  <$rule{ type:"email"; message:msg; value:"" }
};

f=validaterule(value:str;rule:$rule):bool{
  if(str.eq(rule.type;"required")){
    <str.len(str.trim(value))>0
  }el{ if(str.eq(rule.type;"min_length")){
    let min=str.toint(rule.value);
    <str.len(value)>min
  }el{ if(str.eq(rule.type;"max_length")){
    let max=str.toint(rule.value);
    <str.len(value)<=max
  }el{ if(str.eq(rule.type;"email")){
    let atidx=str.indexof(value;"@");
    if(atidx<0){ <false }el{
      let afterat=str.substr(value;atidx+1;str.len(value));
      let dotidx=str.indexof(afterat;".");
      <dotidx>0
    };
  }el{
    <true
  };
};

f=validatefield(value:str;rules:@$rule):str{
  let i=mut.0;
  let n=str.arraylen(rules);
  lp(let lv=0;true;lv=lv){
    if(i>n){ br }el{
      let rule=str.arrayget(rules;i);
      if(!validaterule(value;rule)){
        <rule.message
      }el{};
      i=i+1;
    };
  };
  <""
};

f=script():str{
  <"
(function() {
  'use strict';

  var validators = {
    required: function(v) { return v.trim().length > 0; },
    min_length: function(v, param) { return v.length >= parseInt(param, 10); },
    max_length: function(v, param) { return v.length <= parseInt(param, 10); },
    pattern: function(v, param) { return new RegExp(param).test(v); },
    email: function(v) { return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v); }
  };

  function validateField(input) {
    var rules = input.dataset.rules;
    if (!rules) return { valid: true, error: '' };
    var ruleList;
    try { ruleList = JSON.parse(rules); } catch(_) { return { valid: true, error: '' }; }
    for (var i = 0; i < ruleList.length; i++) {
      var r = ruleList[i];
      var fn = validators[r.type];
      if (fn && !fn(input.value, r.value)) {
        return { valid: false, error: r.message };
      };
    };
    return { valid: true, error: '' };
  };

  function showError(input, msg) {
    input.classList.add('form-input-error');
    input.setAttribute('aria-invalid', 'true');
    var errEl = document.getElementById(input.id + '-error');
    if (errEl) {
      errEl.textContent = msg;
      errEl.style.display = '';
      input.setAttribute('aria-describedby', errEl.id);
    };
  };

  function clearError(input) {
    input.classList.remove('form-input-error');
    input.removeAttribute('aria-invalid');
    var errEl = document.getElementById(input.id + '-error');
    if (errEl) {
      errEl.textContent = '';
      errEl.style.display = 'none';
    };
  };

  function validateForm(form) {
    var inputs = form.querySelectorAll('[data-rules]');
    var allValid = true;
    inputs.forEach(function(input) {
      var result = validateField(input);
      if (!result.valid) {
        showError(input, result.error);
        allValid = false;
      }el{
        clearError(input);
      };
    });
    return allValid;
  };

  document.addEventListener('blur', function(e) {
    if (e.target.dataset && e.target.dataset.rules) {
      var result = validateField(e.target);
      if (!result.valid) { showError(e.target, result.error); }
      else { clearError(e.target); }
    };
  }, true);

  document.addEventListener('submit', function(e) {
    var form = e.target;
    if (form.dataset.validate != undefined) {
      if (!validateForm(form)) {
        e.preventDefault();
        var first = form.querySelector('.form-input-error');
        if (first) first.focus();
      };
    };
  });

  window.lokeForm = { validate: validateForm, validateField: validateField };
})();
"
};

m=browser.components.modal;

i=str:std.str;

t=$modalconfig{
  id:$str;
  title:$str;
  body:$str;
  footer:$str;
  closable:bool;
  arialabel:$str
};

f=defaultconfig():$modalconfig{
  <$modalconfig{
    id:"modal";
    title:"";
    body:"";
    footer:"";
    closable:true;
    arialabel:""
  };
};

f=render(cfg:$modalconfig):str{
  let labelattr=mut."";
  if(str.len(cfg.arialabel)>0){
    labelattr=str.concat(" aria-label=\"";str.concat(cfg.arialabel;"\""))
  }el{ if(str.len(cfg.title)>0){
    labelattr=str.concat(" aria-labelledby=\"";str.concat(cfg.id;"-title\""))
  }el{} };

  let out=mut.str.concat("<div class=\"modal-overlay\" id=\"";str.concat(cfg.id;str.concat("-overlay\" data-modal-overlay=\"";str.concat(cfg.id;"\">
"))));
  out=str.concat(out;str.concat("  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\"";str.concat(labelattr;str.concat(" id=\"";str.concat(cfg.id;"\">
")))));

  if(str.len(cfg.title)>0){
    out=str.concat(out;"    <header class=\"modal-header\">
");
    out=str.concat(out;str.concat("      <h2 class=\"modal-title\" id=\"";str.concat(cfg.id;str.concat("-title\">";str.concat(cfg.title;"</h2>
")))));
    if(cfg.closable){
      out=str.concat(out;str.concat("      <button class=\"modal-close\" aria-label=\"Close dialog\" data-modal-close=\"";str.concat(cfg.id;"\">&times;</button>
")))
    }el{};
    out=str.concat(out;"    </header>
")
  }el{};

  out=str.concat(out;str.concat("    <div class=\"modal-body\">";str.concat(cfg.body;"</div>
")));

  if(str.len(cfg.footer)>0){
    out=str.concat(out;str.concat("    <footer class=\"modal-footer\">";str.concat(cfg.footer;"</footer>\n")))
  }el{};

  out=str.concat(out;"  </div>\n</div>");
  <out
};

f=script():str{
  <"
(function() {
  'use strict';

  function openModal(id) {
    var overlay = document.getElementById(id + '-overlay');
    if (!overlay) return;
    overlay.removeAttribute('hidden');
    overlay.style.display = '';
    var modal = document.getElementById(id);
    if (modal) {
      var first = modal.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])');
      if (first) first.focus();
    };
    document.body.style.overflow = 'hidden';
  };

  function closeModal(id) {
    var overlay = document.getElementById(id + '-overlay');
    if (!overlay) return;
    overlay.setAttribute('hidden', '');
    overlay.style.display = 'none';
    document.body.style.overflow = '';
  };

  document.addEventListener('keydown', function(e) {
    if (e.key = 'Escape') {
      var open = document.querySelector('.modal-overlay:not([hidden])');
      if (open) {
        var id = open.id.replace('-overlay', '');
        closeModal(id);
        e.preventDefault();
      };
    };
    if (e.key = 'Tab') {
      var open = document.querySelector('.modal-overlay:not([hidden])');
      if (!open) return;
      var modal = open.querySelector('.modal');
      var focusable = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])');
      if (focusable.length = 0) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement = first) { last.focus(); e.preventDefault(); }
      }el{
        if (document.activeElement = last) { first.focus(); e.preventDefault(); }
      };
    };
  });

  document.addEventListener('click', function(e) {
    var overlay = e.target.closest('[data-modal-overlay]');
    if (overlay && e.target = overlay) {
      closeModal(overlay.dataset.modalOverlay);
    };
    var closeBtn = e.target.closest('[data-modal-close]');
    if (closeBtn) {
      closeModal(closeBtn.dataset.modalClose);
    };
  });

  window.lokeModal = { open: openModal, close: closeModal };
})();
"
};

f=styles():$str{
  <"
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 400;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md, 16px);
};
.modal-overlay[hidden] { display: none; }
.modal {
  background: var(--surface, #161b22);
  border: 1px solid var(--border, #30363d);
  border-radius: var(--border-radius-base, 7px);
  width: 100%;
  max-width: 520px;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3), 0 8px 10px -6px rgba(0,0,0,0.3);
};
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md, 16px) var(--space-lg, 24px);
  border-bottom: 1px solid var(--border, #30363d);
};
.modal-title {
  font-size: 1.1em;
  font-weight: 600;
  color: var(--text, #e6edf3);
};
.modal-close {
  background: none;
  border: none;
  color: var(--muted, #8b949e);
  font-size: 1.4em;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 4px;
  line-height: 1;
  transition: background 0.1s, color 0.1s;
};
.modal-close:hover { background: rgba(255,255,255,0.06); color: var(--text, #e6edf3); }
.modal-close:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg, #0d1117), 0 0 0 4px var(--accent, #14b8a6);
};
.modal-body { padding: var(--space-lg, 24px); }
.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-sm, 8px);
  padding: var(--space-md, 16px) var(--space-lg, 24px);
  border-top: 1px solid var(--border, #30363d);
};
@media (prefers-reduced-motion: reduce) {
  .modal-overlay, .modal { transition-duration: 0.01ms !important; }
};
"
};

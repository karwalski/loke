m=browser.components.card;

i=str:std.str;

t=$cardconfig{
  id:$str;
  header:$str;
  body:$str;
  footer:$str;
  interactive:bool;
  classname:$str
};

f=defaultconfig():$cardconfig{
  <$cardconfig{
    id:"";
    header:"";
    body:"";
    footer:"";
    interactive:false;
    classname:""
  };
};

f=render(cfg:$cardconfig):$str{
  let cls=mut."card";
  if(cfg.interactive){ cls=str.concat(cls;" card-interactive") }el{};
  if(str.len(cfg.classname)>0){ cls=str.concat(cls;str.concat(" ";cfg.classname)) }el{};

  let tag="article";
  let extraattrs=mut."";
  if(str.len(cfg.id)>0){
    extraattrs=str.concat(" id=\"";str.concat(cfg.id;"\""))
  }el{};
  if(cfg.interactive){
    extraattrs=str.concat(extraattrs;" tabindex=\"0\"")
  }el{};

  let out=mut.str.concat("<";str.concat(tag;str.concat(" class=\"";str.concat(cls;str.concat("\"";str.concat(extraattrs;">
"))))));

  if(str.len(cfg.header)>0){
    out=str.concat(out;str.concat("  <header class=\"card-header\">";str.concat(cfg.header;"</header>
")))
  }el{};

  out=str.concat(out;str.concat("  <div class=\"card-body\">";str.concat(cfg.body;"</div>
")));

  if(str.len(cfg.footer)>0){
    out=str.concat(out;str.concat("  <footer class=\"card-footer\">";str.concat(cfg.footer;"</footer>
")))
  }el{};

  out=str.concat(out;str.concat("</";str.concat(tag;">")));
  <out
};

f=styles():$str{
  <"
.card {
  background: var(--surface, #161b22);
  border: 1px solid var(--border, #30363d);
  border-radius: var(--border-radius-base, 10px);
  overflow: hidden;
  margin-bottom: var(--space-md, 16px);
  box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
};
.card-interactive {
  cursor: pointer;
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
};
.card-interactive:hover {
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.2), 0 2px 4px -2px rgba(0,0,0,0.2);
  border-color: var(--accent, #14b8a6);
};
.card-interactive:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg, #0d1117), 0 0 0 4px var(--accent, #14b8a6);
};
.card-header {
  padding: var(--space-md, 16px) var(--space-lg, 24px);
  border-bottom: 1px solid var(--border, #30363d);
  font-size: 0.8em;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted, #8b949e);
};
.card-body {
  padding: var(--space-md, 16px) var(--space-lg, 24px);
};
.card-footer {
  padding: var(--space-sm, 8px) var(--space-lg, 24px);
  border-top: 1px solid var(--border, #30363d);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-sm, 8px);
};
@media (prefers-reduced-motion: reduce) {
  .card-interactive { transition-duration: 0.01ms !important; }
};
"
};

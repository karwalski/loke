m=browser.extensions.core;

i=cfg:shared.config;
i=log:shared.log;
i=pipeline:core.privacy.pipeline;
i=router:core.router.router;
i=str:std.str;
i=gw:core.governance.gateway;
i=disp:core.providers.dispatcher;

t=$corestate{
  config:i64;
  pipelineconfig:i64;
  router:i64;
  cid:str;
  gateway:i64;
  dispatcher:i64;
  apikeys:i64
};

t=$lokecfgstate{
  ollamaurl:str;
  port:i64;
  datadir:str;
  loglevel:str;
  presidiourl:str;
  defaultprovider:str
};

f=init(ookecfg:i64):$corestate{
  let config=cfg.defaultconfig();
  let pipelineconfig=pipeline.newconfig(config.presidiourl;config.ollamaurl);
  let rtr=router.new(router.newconfig(config.ollamaurl));
  let cid=str.randhex(16);
  let loaded=mt cfg.loadconfig("~/.loke/config.toml") {$ok:v v; $err:e cfg.defaultconfig()};
  let pipelineconfig2=pipeline.newconfig(loaded.presidiourl;loaded.ollamaurl);
  let rtr2=router.new(router.newconfig(loaded.ollamaurl));
  let gateway=gw.new();
  let apikeys=disp.getapikeys("";"");
  let dispatcher=disp.new(apikeys;loaded.ollamaurl);
  log.info("loke core initialised";"core";cid);
  <$corestate{config:loaded;pipelineconfig:pipelineconfig2;router:rtr2;cid:cid;gateway:gateway;dispatcher:dispatcher;apikeys:apikeys}
};


f=getconfig():$lokecfgstate{
  <$lokecfgstate{
    ollamaurl:"http://127.0.0.1:11434";
    port:11430;
    datadir:"~/.loke";
    loglevel:"info";
    presidiourl:"http://127.0.0.1:5002";
    defaultprovider:"ollama"
  }
};

f=getpipelineconfig():i64{ <0 };
f=getrouter():i64{ <0 };
f=getgateway():i64{ <0 };
f=getdispatcher():i64{ <0 };
f=getauditstore():i64{ <0 };
f=getpreference(key:str):str{ <"" };
f=setapikey(provider:str;key:str):i64{ <0 };
f=setpreference(key:str;value:str):i64{ <0 };
f=gettabstore():i64{ <0 };
f=settabstore(store:i64):i64{ <0 };

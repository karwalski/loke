m=browser.extensions.core;

i=cfg:shared.config;
i=log:shared.log;
i=pipeline:core.privacy.pipeline;
i=router:core.router.router;
i=str:std.str;
i=gw:core.governance.gateway;
i=disp:core.providers.dispatcher;

g=gconfig:i64;
g=gpipelineconfig:i64;
g=grouter:i64;
g=gcid:str;
g=ggateway:i64;
g=gdispatcher:i64;
g=gapikeys:i64;

f=init(ookecfg:i64):void{
  gconfig=cfg.defaultconfig();
  gpipelineconfig=pipeline.newconfig(gconfig.presidiourl;gconfig.ollamaurl);
  grouter=router.new(router.newconfig(gconfig.ollamaurl));
  gcid=str.randhex(16);
  let loaded=mt cfg.loadconfig("~/.loke/config.toml") {
    $ok:v v;
    $err:e cfg.defaultconfig()
  };
  gconfig=loaded;
  gpipelineconfig=pipeline.newconfig(gconfig.presidiourl;gconfig.ollamaurl);
  grouter=router.new(router.newconfig(gconfig.ollamaurl));
  ggateway=gw.new();
  gapikeys=disp.apikeys{anthropic:"";openai:""};
  gdispatcher=disp.new(gapikeys;gconfig.ollamaurl);
  log.info("loke core initialised";"core";gcid);
  <()
};

f=onshutdown():void{
  log.info("loke core shutting down";"core";gcid);
  <()
};

f=getconfig():i64{
  <gconfig
};

f=getpipelineconfig():i64{
  <gpipelineconfig
};

f=getrouter():i64{
  <grouter
};

f=getgateway():i64{ <ggateway };
f=getdispatcher():i64{ <gdispatcher };
f=setapikey(provider:str;key:str):void{
  if(str.eq(provider;"anthropic")){
    gapikeys=disp.apikeys{anthropic:key;openai:gapikeys.openai}
  }el{
    if(str.eq(provider;"openai")){
      gapikeys=disp.apikeys{anthropic:gapikeys.anthropic;openai:key}
    }el{()}
  };
  gdispatcher=disp.new(gapikeys;gconfig.ollamaurl)
};

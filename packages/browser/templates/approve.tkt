{! layout("base") !}
{! block("title") !}loke — approve request{! end !}
{! block("content") !}
<style>
  .approve-wrap { max-width: 780px; margin: 32px auto; padding: 0 16px; }
  .approve-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .approve-title { font-size: 1.2em; font-weight: 700; }
  .sensitivity-pill { font-size: 0.75em; font-weight: 700; padding: 3px 10px; border-radius: 20px; background: rgba(239,68,68,.15); color: var(--red); border: 1px solid rgba(239,68,68,.3); text-transform: uppercase; }
  .panel h3 { font-size: 0.8em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 8px; }
  .original { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px; font-size: 0.9em; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; margin-bottom: 16px; }
  .pii-list { margin-bottom: 16px; }
  .pii-chip { display: inline-flex; align-items: center; gap: 6px; background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.25); color: var(--amber); border-radius: 4px; padding: 2px 8px; font-size: 0.8em; margin: 2px; }
  .action-row { display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; }
  .btn { padding: 10px 24px; border-radius: 8px; border: none; cursor: pointer; font-size: 0.95em; font-weight: 600; }
  .btn:disabled { opacity: .5; cursor: default; }
  .btn-approve { background: var(--accent); color: #fff; }
  .btn-cancel { background: transparent; color: var(--red); border: 1px solid rgba(239,68,68,.4); }
  .explainer { font-size: 0.85em; color: var(--muted); margin-bottom: 16px; }
  .status { font-size: 0.85em; margin-top: 12px; min-height: 1.2em; }
</style>

<div class="approve-wrap">
  <div class="approve-header">
    <div class="approve-title">Approve this request?</div>
    <div class="sensitivity-pill" id="sensitivity-pill"></div>
  </div>
  <p class="explainer" id="explainer">Nothing is waiting for approval.</p>
  <div class="pii-list" id="pii-list"></div>
  <div class="panel" id="original-panel" hidden>
    <h3>Your request, as you wrote it</h3>
    <div class="original" id="original-text"></div>
  </div>
  <p class="explainer">Approving lets loke process this one request, once, on the model it routes to. Restricted data is only ever sent to a local model. Detected identifiers are replaced with placeholders first. To change the request, decline it and send it again: an approval covers the request exactly as it was held.</p>
  <div class="action-row">
    <button class="btn btn-cancel" id="decline-btn" onclick="declineSend()" disabled>Decline</button>
    <button class="btn btn-approve" id="approve-btn" onclick="approveSend()" disabled>Approve and send</button>
  </div>
  <div class="status" id="status" role="status" aria-live="polite"></div>
</div>

<script>
// GA5.26. /api/pipeline held a request carrying restricted data and answered with an approval
// id. The chat page put the request here, in this tab's sessionStorage: loke keeps no copy of
// the text. Approving decides the approval on the server, then re-sends the SAME request with
// the id, which the pipeline accepts once.
let pending = null;
try { pending = JSON.parse(sessionStorage.getItem('loke_pending') || 'null'); } catch (_) { pending = null; }

const $ = (id) => document.getElementById(id);
const returnTo = (pending && pending.return_to) || '/chat';

function setStatus(msg) { $('status').textContent = msg; }

function finish(result) {
  sessionStorage.removeItem('loke_pending');
  sessionStorage.setItem('loke_result', JSON.stringify(result));
  window.location = returnTo;
}

if (pending && pending.approval_id && pending.text) {
  $('sensitivity-pill').textContent = pending.sensitivity || 'restricted';
  $('explainer').textContent = pending.message || 'This request contains restricted data and needs your approval before it is processed.';
  $('original-text').textContent = pending.text;
  $('original-panel').hidden = false;
  // Types and counts only ("credit_card:1"), as the server reported them. Never a value.
  (pending.entity_types || '').split(',').filter(Boolean).forEach((t) => {
    const chip = document.createElement('span');
    chip.className = 'pii-chip';
    chip.textContent = t.replace(':', ' × ');
    $('pii-list').appendChild(chip);
  });
  $('approve-btn').disabled = false;
  $('decline-btn').disabled = false;
  if (pending.expires_at && Date.now() > pending.expires_at) {
    setStatus('This approval has expired. Decline it and send the request again.');
    $('approve-btn').disabled = true;
  }
}

async function decide(decision) {
  const r = await fetch('/api/approve', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ approval_id: pending.approval_id, decision })
  });
  return r.json().catch(() => ({ ok: false, error: 'unreadable response' }));
}

async function declineSend() {
  $('approve-btn').disabled = true;
  $('decline-btn').disabled = true;
  try { await decide('decline'); } catch (_) {}
  finish({ text: pending.text, declined: true, result: { ok: false } });
}

async function approveSend() {
  $('approve-btn').disabled = true;
  $('decline-btn').disabled = true;
  setStatus('Approving…');
  try {
    const d = await decide('approve');
    if (!d.ok) {
      setStatus('The approval could not be recorded: ' + (d.error || d.reason || 'unknown') + '. Nothing was sent.');
      $('decline-btn').disabled = false;
      return;
    }
    setStatus('Approved. Sending…');
    // The same request, field for field, with the approval id. fallback_reason and
    // fallback_selected_by are required on every /api/pipeline request (NC1.8).
    const body = {
      text: pending.text,
      fallback_reason: pending.fallback_reason,
      fallback_selected_by: pending.fallback_selected_by,
      approval_id: pending.approval_id
    };
    if (pending.model) body.model = pending.model;
    if (pending.system_prompt) body.system_prompt = pending.system_prompt;
    const r = await fetch('/api/pipeline', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const result = await r.json().catch(() => ({ ok: false, error: 'unreadable response' }));
    finish({ text: pending.text, result });
  } catch (e) {
    setStatus('The request failed: ' + e.message);
    $('decline-btn').disabled = false;
  }
}
</script>
{! end !}

{! layout("base") !}
{! block("title") !}loke — Local Model Installer{! end !}
{! block("content") !}
<style>
  .installer { max-width: 600px; margin: 40px auto; }
  .installer-title { font-size: 1.4em; font-weight: 700; margin-bottom: 8px; }
  .installer-sub { color: var(--muted); margin-bottom: 24px; font-size: 0.95em; line-height: 1.5; }

  /* -- Screens -- */
  .screen { display: none; }
  .screen.active { display: block; }

  /* -- Hardware card -- */
  .hw-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 20px 24px; margin-bottom: 20px;
  }
  .hw-card h3 {
    font-size: 0.95em; font-weight: 700; margin-bottom: 12px;
    color: var(--accent);
  }
  .hw-row {
    display: flex; justify-content: space-between;
    padding: 6px 0; font-size: 0.9em;
    border-bottom: 1px solid var(--border);
  }
  .hw-row:last-child { border-bottom: none; }
  .hw-label { color: var(--muted); }
  .hw-value { color: var(--text); font-weight: 500; }

  /* -- Explanation list -- */
  .install-steps { list-style: none; padding: 0; margin: 16px 0; }
  .install-steps li {
    padding: 8px 0; font-size: 0.9em;
    display: flex; align-items: center; gap: 10px;
  }
  .install-steps .step-num {
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--surface); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.78em; font-weight: 700; color: var(--accent);
    flex-shrink: 0;
  }

  /* -- Model selector dropdown -- */
  .model-select-row { margin: 16px 0; display: flex; align-items: center; gap: 12px; }
  .model-select-row label { font-size: 0.85em; color: var(--muted); }
  .model-select {
    background: var(--surface); color: var(--text);
    border: 1px solid var(--border); border-radius: 6px;
    padding: 7px 12px; font-size: 0.9em; cursor: pointer;
    outline: none;
  }
  .model-select:focus { border-color: var(--accent); }

  /* -- Button row -- */
  .btn-row { display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.9em; font-weight: 600; padding: 10px 24px;
    border-radius: 8px; border: none; cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
  }
  .btn:active { transform: scale(0.97); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-install { background: var(--accent); color: #0d1117; }
  .btn-install:hover:not(:disabled) { opacity: 0.85; }
  .btn-skip { background: transparent; color: var(--muted); border: 1px solid var(--border); }
  .btn-skip:hover { border-color: var(--accent); color: var(--text); }
  .btn-cancel { background: transparent; color: var(--muted); border: 1px solid var(--border); }
  .btn-cancel:hover { border-color: var(--red); color: var(--red); }
  .btn-continue { background: var(--green); color: #0d1117; }
  .btn-continue:hover { opacity: 0.85; }

  /* -- Progress screen -- */
  .progress-step { margin-bottom: 20px; }
  .progress-step-header {
    display: flex; align-items: center; gap: 10px;
    font-size: 0.9em; font-weight: 600; margin-bottom: 8px;
  }
  .progress-step-num {
    width: 22px; height: 22px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.72em; font-weight: 700; flex-shrink: 0;
  }
  .progress-step-num.waiting { background: var(--surface); border: 1px solid var(--border); color: var(--muted); }
  .progress-step-num.active { background: var(--accent); color: #0d1117; }
  .progress-step-num.done { background: var(--green); color: #0d1117; }

  .progress-bar-track {
    height: 8px; background: var(--surface); border: 1px solid var(--border);
    border-radius: 4px; overflow: hidden; margin-bottom: 6px;
  }
  .progress-bar-fill {
    height: 100%; background: var(--accent); border-radius: 4px;
    transition: width 0.3s ease;
    width: 0%;
  }
  .progress-bar-fill.done { background: var(--green); }
  .progress-detail {
    font-size: 0.78em; color: var(--muted);
    display: flex; justify-content: space-between;
  }
  .progress-detail .eta { font-style: italic; }

  /* Spinner for verification */
  @keyframes spin { to { transform: rotate(360deg); } }
  .spinner {
    display: inline-block; width: 16px; height: 16px;
    border: 2px solid var(--border); border-top-color: var(--accent);
    border-radius: 50%; animation: spin 0.8s linear infinite;
    vertical-align: middle; margin-right: 6px;
  }

  /* -- Completion screen -- */
  .completion-icon {
    font-size: 3em; text-align: center; margin-bottom: 16px;
    color: var(--green);
  }
  .completion-title {
    font-size: 1.3em; font-weight: 700; text-align: center;
    margin-bottom: 20px; color: var(--green);
  }
  .completion-stats {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 20px 24px; margin-bottom: 20px;
  }
  .stat-row {
    display: flex; justify-content: space-between;
    padding: 8px 0; font-size: 0.9em;
    border-bottom: 1px solid var(--border);
  }
  .stat-row:last-child { border-bottom: none; }
  .stat-label { color: var(--muted); }
  .stat-value { color: var(--text); font-weight: 600; }
  .privacy-message {
    text-align: center; font-size: 0.9em; color: var(--muted);
    margin: 20px 0; line-height: 1.5;
  }

  /* -- Smooth progress bar animation -- */
  @keyframes progress-pulse {
    0% { opacity: 1; }
    50% { opacity: 0.7; }
    100% { opacity: 1; }
  }
  .progress-bar-fill.animating {
    animation: progress-pulse 1.5s ease-in-out infinite;
  }
</style>

<div class="installer" role="region" aria-label="Local model installer">

  <!-- ============ SCREEN 1: CONSENT ============ -->
  <div class="screen active" id="screen-consent" role="region" aria-label="Install consent">
    <div class="installer-title" id="consent-heading" tabindex="-1">Local Model Setup</div>
    <div class="installer-sub">
      loke needs a local language model for privacy filtering,
      intent classification, and local inference.
    </div>

    <div class="hw-card" aria-label="Hardware summary and recommended model">
      <h3 id="rec-model-heading">
        Recommended: <span id="rec-model-label">loading...</span>
      </h3>
      <div class="hw-row">
        <span class="hw-label">Size</span>
        <span class="hw-value" id="rec-size">--</span>
      </div>
      <div class="hw-row">
        <span class="hw-label">Speed</span>
        <span class="hw-value" id="rec-speed">--</span>
      </div>
      <div class="hw-row">
        <span class="hw-label">Licence</span>
        <span class="hw-value">Apache 2.0 (open)</span>
      </div>
      <div class="hw-row" style="margin-top:8px; border-top:1px solid var(--border); padding-top:10px;">
        <span class="hw-label">Your hardware</span>
        <span class="hw-value" id="hw-chip">detecting...</span>
      </div>
      <div class="hw-row">
        <span class="hw-label">Memory</span>
        <span class="hw-value" id="hw-mem">--</span>
      </div>
      <div class="hw-row">
        <span class="hw-label">Disk available</span>
        <span class="hw-value" id="hw-disk">--</span>
      </div>
    </div>

    <div class="installer-sub" style="margin-bottom:0;">This will:</div>
    <ol class="install-steps" aria-label="Installation steps">
      <li><span class="step-num">1</span><span id="step-desc-1">Download Ollama (~90 MB)</span></li>
      <li><span class="step-num">2</span><span id="step-desc-2">Download <span id="consent-model-name">the recommended model</span> (<span id="consent-model-size">--</span>)</span></li>
      <li><span class="step-num">3</span><span>Start the local model server</span></li>
    </ol>

    <div class="model-select-row">
      <label for="model-dropdown">Change model</label>
      <select class="model-select" id="model-dropdown" aria-label="Select a different model">
        <option value="">Loading models...</option>
      </select>
    </div>

    <div class="btn-row">
      <button class="btn btn-skip" id="btn-skip" onclick="skipInstall()" aria-label="Skip installation">Skip</button>
      <button class="btn btn-install" id="btn-install" onclick="startInstall()" aria-label="Begin installation">Install</button>
    </div>
  </div>

  <!-- ============ SCREEN 2: PROGRESS ============ -->
  <div class="screen" id="screen-progress" role="region" aria-label="Installation progress">
    <div class="installer-title" id="progress-heading" tabindex="-1">Installing Local Model</div>

    <!-- Step 1: Ollama download -->
    <div class="progress-step" id="prog-step-1" aria-label="Step 1: Downloading Ollama">
      <div class="progress-step-header">
        <span class="progress-step-num active" id="prog-num-1">1</span>
        <span>Step 1 of 3: Downloading Ollama</span>
      </div>
      <div class="progress-bar-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" id="prog-bar-1-track">
        <div class="progress-bar-fill" id="prog-bar-1"></div>
      </div>
      <div class="progress-detail">
        <span id="prog-detail-1">waiting...</span>
        <span class="eta" id="prog-eta-1"></span>
      </div>
    </div>

    <!-- Step 2: Model pull -->
    <div class="progress-step" id="prog-step-2" aria-label="Step 2: Downloading model">
      <div class="progress-step-header">
        <span class="progress-step-num waiting" id="prog-num-2">2</span>
        <span>Step 2 of 3: Downloading <span id="prog-model-name">model</span></span>
      </div>
      <div class="progress-bar-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" id="prog-bar-2-track">
        <div class="progress-bar-fill" id="prog-bar-2"></div>
      </div>
      <div class="progress-detail">
        <span id="prog-detail-2">waiting...</span>
        <span class="eta" id="prog-eta-2"></span>
      </div>
    </div>

    <!-- Step 3: Verification -->
    <div class="progress-step" id="prog-step-3" aria-label="Step 3: Verification">
      <div class="progress-step-header">
        <span class="progress-step-num waiting" id="prog-num-3">3</span>
        <span>Step 3 of 3: Verification</span>
      </div>
      <div class="progress-bar-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" id="prog-bar-3-track">
        <div class="progress-bar-fill" id="prog-bar-3"></div>
      </div>
      <div class="progress-detail">
        <span id="prog-detail-3">waiting...</span>
        <span class="eta" id="prog-eta-3"></span>
      </div>
    </div>

    <div class="btn-row">
      <button class="btn btn-cancel" id="btn-cancel" onclick="cancelInstall()" aria-label="Cancel installation">Cancel</button>
    </div>
  </div>

  <!-- ============ SCREEN 3: COMPLETION ============ -->
  <div class="screen" id="screen-complete" role="region" aria-label="Installation complete">
    <div class="completion-icon" aria-hidden="true">&#10003;</div>
    <div class="completion-title" id="complete-heading" tabindex="-1">Local Model Ready</div>

    <div class="completion-stats" aria-label="Model performance statistics">
      <div class="stat-row">
        <span class="stat-label">Ollama</span>
        <span class="stat-value" id="comp-ollama-ver">installed</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Model</span>
        <span class="stat-value" id="comp-model-name">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Response time</span>
        <span class="stat-value" id="comp-latency">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Throughput</span>
        <span class="stat-value" id="comp-throughput">--</span>
      </div>
    </div>

    <div class="privacy-message" aria-live="polite">
      Your data will be processed locally before anything leaves your device.
    </div>

    <div class="btn-row" style="justify-content: center;">
      <button class="btn btn-continue" id="btn-continue" onclick="continueToLoke()" aria-label="Continue to loke">
        Continue to loke &rarr;
      </button>
    </div>
  </div>

</div>

<script>
(function() {
  // ── State ──
  var hwData = null;
  var allModels = [];
  var selectedModel = null;
  var installing = false;
  var cancelled = false;
  var pollTimer = null;

  // ── Parse data from server ──
  try { hwData = JSON.parse('{! raw("hardware_json") !}'); } catch(e) { hwData = {}; }
  try { allModels = JSON.parse('{! raw("models_json") !}'); } catch(e) { allModels = []; }

  // ── Populate consent screen ──
  function populateConsent() {
    if (!hwData) return;
    var el = document.getElementById.bind(document);

    // Hardware info
    el('hw-chip').textContent = hwData.chip || 'Unknown';
    var memStr = '';
    if (hwData.unified_memory_gb > 0) {
      memStr = hwData.unified_memory_gb + ' GB unified';
    } else {
      memStr = hwData.ram_gb + ' GB';
    }
    el('hw-mem').textContent = memStr;
    el('hw-disk').textContent = Math.round(hwData.disk_free_gb || 0) + ' GB';

    // Recommended model
    el('rec-model-label').textContent = hwData.rec_label || 'Qwen 2.5';
    el('rec-size').textContent = (hwData.rec_size_gb || 0) + ' GB download';
    el('rec-speed').textContent = '~' + (hwData.rec_tok_s_low || 0) + '-' + (hwData.rec_tok_s_high || 0) + ' tokens/second on your hardware';
    el('consent-model-name').textContent = hwData.rec_label || 'model';
    el('consent-model-size').textContent = (hwData.rec_size_gb || 0) + ' GB';

    selectedModel = hwData.rec_model || 'qwen2.5:7b';

    // Skip Ollama step if already installed
    if (hwData.ollama_status === 'running' || hwData.ollama_status === 'installed') {
      el('step-desc-1').textContent = 'Ollama already installed (skip)';
    }

    // Populate dropdown
    var dd = el('model-dropdown');
    dd.innerHTML = '';
    for (var i = 0; i < allModels.length; i++) {
      var m = allModels[i];
      var opt = document.createElement('option');
      opt.value = m.name;
      opt.textContent = m.label + ' (' + m.size_gb + ' GB, ' + m.tok_s + ' tok/s, RAM: ' + m.ram + ')';
      if (m.name === selectedModel) opt.selected = true;
      dd.appendChild(opt);
    }
    dd.addEventListener('change', function() {
      selectedModel = dd.value;
      var chosen = allModels.find(function(m) { return m.name === dd.value; });
      if (chosen) {
        el('rec-model-label').textContent = chosen.label;
        el('rec-size').textContent = chosen.size_gb + ' GB download';
        el('consent-model-name').textContent = chosen.label;
        el('consent-model-size').textContent = chosen.size_gb + ' GB';
      }
    });

    // Disk space warning
    if (hwData.disk_free_gb && hwData.rec_size_gb && hwData.disk_free_gb < hwData.rec_size_gb + 2) {
      var warn = document.createElement('div');
      warn.style.cssText = 'color:var(--amber);font-size:0.85em;margin-top:8px;';
      warn.setAttribute('role', 'alert');
      warn.textContent = 'Warning: Low disk space. You have ' + Math.round(hwData.disk_free_gb) + ' GB free but need at least ' + (hwData.rec_size_gb + 2) + ' GB.';
      el('model-dropdown').parentElement.after(warn);
    }
  }

  populateConsent();

  // ── Screen transitions ──
  function showScreen(id) {
    var screens = document.querySelectorAll('.screen');
    for (var i = 0; i < screens.length; i++) screens[i].classList.remove('active');
    document.getElementById(id).classList.add('active');

    // Focus management
    var headingMap = {
      'screen-consent': 'consent-heading',
      'screen-progress': 'progress-heading',
      'screen-complete': 'complete-heading'
    };
    var heading = document.getElementById(headingMap[id]);
    if (heading) {
      setTimeout(function() { heading.focus(); }, 100);
    }

    // Screen reader announcements
    var announceMap = {
      'screen-consent': 'Local model setup. Review hardware and model recommendation.',
      'screen-progress': 'Installation in progress.',
      'screen-complete': 'Installation complete. Local model is ready.'
    };
    if (typeof loke_announce === 'function') {
      loke_announce(announceMap[id] || '', 'polite');
    }
  }

  // ── Skip install ──
  window.skipInstall = function() {
    window.location.href = '/setup';
  };

  // ── Continue to loke ──
  window.continueToLoke = function() {
    window.location.href = '/';
  };

  // ── Cancel install ──
  window.cancelInstall = function() {
    cancelled = true;
    installing = false;
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    fetch('/api/installer/cancel', { method: 'POST' }).catch(function() {});
    showScreen('screen-consent');
    if (typeof loke_announce === 'function') {
      loke_announce('Installation cancelled.', 'assertive');
    }
  };

  // ── Progress helpers ──
  function setStepState(num, state) {
    var el = document.getElementById('prog-num-' + num);
    if (!el) return;
    el.className = 'progress-step-num ' + state;
  }

  function setProgress(num, pct, detail, eta) {
    var bar = document.getElementById('prog-bar-' + num);
    var track = document.getElementById('prog-bar-' + num + '-track');
    var detailEl = document.getElementById('prog-detail-' + num);
    var etaEl = document.getElementById('prog-eta-' + num);
    if (bar) {
      bar.style.width = Math.min(pct, 100) + '%';
      if (pct >= 100) {
        bar.classList.remove('animating');
        bar.classList.add('done');
      } else if (pct > 0) {
        bar.classList.add('animating');
      }
    }
    if (track) {
      track.setAttribute('aria-valuenow', Math.round(pct));
    }
    if (detailEl && detail) detailEl.textContent = detail;
    if (etaEl) etaEl.textContent = eta || '';
  }

  // ── Start install ──
  window.startInstall = function() {
    if (installing) return;
    installing = true;
    cancelled = false;

    var model = selectedModel || 'qwen2.5:7b';
    document.getElementById('prog-model-name').textContent = model;
    showScreen('screen-progress');

    // Reset progress
    for (var s = 1; s <= 3; s++) {
      setStepState(s, 'waiting');
      setProgress(s, 0, 'waiting...', '');
    }
    setStepState(1, 'active');

    // Initiate install on server
    fetch('/api/installer/start', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: model })
    }).catch(function(e) {
      document.getElementById('prog-detail-1').textContent = 'Error: ' + (e.message || 'failed to start');
    });

    // Poll for progress
    pollTimer = setInterval(function() {
      if (cancelled) { clearInterval(pollTimer); return; }
      fetch('/api/installer/status', { cache: 'no-store' })
        .then(function(r) { return r.json(); })
        .then(function(d) { updateProgress(d); })
        .catch(function() {});
    }, 500);
  };

  function updateProgress(d) {
    if (!d) return;

    // Step 1: Ollama download
    if (d.ollama_step) {
      var o = d.ollama_step;
      if (o.status === 'skipped' || o.status === 'done') {
        setStepState(1, 'done');
        setProgress(1, 100, o.status === 'skipped' ? 'Already installed' : 'Complete', '');
      } else if (o.status === 'active') {
        setStepState(1, 'active');
        var pct = o.total > 0 ? (o.downloaded / o.total * 100) : 0;
        var mb = Math.round(o.downloaded / 1048576);
        var totalMb = Math.round(o.total / 1048576);
        setProgress(1, pct, mb + ' MB / ' + totalMb + ' MB', o.eta || '');
      } else if (o.status === 'error') {
        setProgress(1, 0, 'Error: ' + (o.message || 'download failed'), '');
      }
    }

    // Step 2: Model pull
    if (d.model_step) {
      var m = d.model_step;
      if (m.status === 'done') {
        setStepState(2, 'done');
        setProgress(2, 100, 'Complete', '');
      } else if (m.status === 'active') {
        setStepState(2, 'active');
        var pct2 = m.total > 0 ? (m.downloaded / m.total * 100) : 0;
        var gb = (m.downloaded / 1073741824).toFixed(1);
        var totalGb = (m.total / 1073741824).toFixed(1);
        setProgress(2, pct2, gb + ' GB / ' + totalGb + ' GB', m.eta || '');
      } else if (m.status === 'error') {
        setProgress(2, 0, 'Error: ' + (m.message || 'pull failed'), '');
      }
    }

    // Step 3: Verification
    if (d.verify_step) {
      var v = d.verify_step;
      if (v.status === 'done') {
        setStepState(3, 'done');
        setProgress(3, 100, 'Verified', '');
        // Move to completion
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
        installing = false;
        showCompletion(d);
      } else if (v.status === 'active') {
        setStepState(3, 'active');
        document.getElementById('prog-detail-3').innerHTML = '<span class="spinner" aria-hidden="true"></span> Verifying model response...';
      } else if (v.status === 'error') {
        setProgress(3, 0, 'Verification failed: ' + (v.message || 'no response'), '');
      }
    }

    // Announce step transitions
    if (typeof loke_announce === 'function') {
      if (d.announce) {
        loke_announce(d.announce, 'polite');
      }
    }
  }

  function showCompletion(d) {
    var el = document.getElementById.bind(document);
    el('comp-ollama-ver').textContent = d.ollama_version || 'installed';
    el('comp-model-name').textContent = (d.model_name || selectedModel) + ' loaded and responding';
    el('comp-latency').textContent = (d.latency_ms || '--') + 'ms (first token)';
    el('comp-throughput').textContent = '~' + (d.throughput_tok_s || '--') + ' tokens/second';
    showScreen('screen-complete');
  }

})();
</script>
{! end !}

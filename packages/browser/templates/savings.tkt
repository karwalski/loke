{! layout("base") !}
{! block("title") !}loke — savings{! end !}
{! block("content") !}

<style>
  .savings-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .savings-header h2 {
    font-size: 1.05em;
    font-weight: 600;
    color: var(--text);
  }
  .period-selector {
    display: flex;
    gap: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px;
  }
  .period-selector button {
    background: none;
    border: none;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 0.8em;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .period-selector button.active {
    background: var(--accent);
    color: #fff;
  }
  .period-selector button:not(.active):hover {
    background: rgba(255,255,255,0.05);
    color: var(--text);
  }
  .stat-grid-4 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 14px;
    margin-bottom: 20px;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-card .s-label {
    font-size: 0.75em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
  .stat-card .s-value {
    font-size: 2em;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
  }
  .stat-card .s-sub {
    font-size: 0.78em;
    color: var(--muted);
    margin-top: 2px;
  }
  .chart-placeholder {
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: 8px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 0.85em;
    margin-top: 4px;
  }
  .provider-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85em;
  }
  .provider-table th {
    text-align: left;
    font-size: 0.75em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
  }
  .provider-table td {
    padding: 10px 10px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .provider-table tr:last-child td { border-bottom: none; }
  .provider-table tr:hover td { background: rgba(255,255,255,0.02); }
  /* DA1.5: a figure nobody computed does not render as a figure.
     This page previously showed thirteen hardcoded numbers under the heading
     "Cost & token savings / Today" — $1.47 saved, 38% cache hit rate, 1.31x
     compression, 142 optimised requests — with no data source of any kind.
     metrics-baseline.md states plainly that no cost, cache or token-reduction
     figure has been measured, so the page contradicted the project's own record. */
  .s-value.unmeasured, .status-row code.unmeasured {
    color: var(--muted);
    font-weight: 500;
  }
  .unmeasured-why {
    font-size: 0.72em;
    color: var(--muted);
    line-height: 1.5;
    margin-top: 4px;
  }
  .page-notice {
    border: 1px solid var(--border);
    border-left: 3px solid var(--muted);
    border-radius: 6px;
    padding: 12px 14px;
    margin-bottom: 16px;
    font-size: 0.85em;
    line-height: 1.6;
    color: var(--muted);
  }
  .page-notice strong { color: var(--text); }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 640px) { .two-col { grid-template-columns: 1fr; } }
</style>

<div class="savings-header">
  <h2>Cost &amp; token savings</h2>
  <div class="period-selector">
    <button class="active">Today</button>
    <button>7 days</button>
    <button>30 days</button>
    <button>All time</button>
  </div>
</div>

<div class="page-notice">
  <strong>These figures are read from what loke has recorded</strong>: one metrics row per
  request and one disclosure record per dispatch
  (<code>docs/specifications/disclosure-accounting.md</code>). Tokens and cost
  <em>saved</em> stay unmeasured, because nothing on the request path optimises yet
  (GA1.5): a saving is shown when one has been measured, not estimated. Figures cover all
  recorded time; the period selector does not filter them yet.
  <br><br>
  The one token figure this project has measured is a serialisation
  <em>baseline</em>, not a saving loke achieves: deleting whitespace from JSON is
  worth 1.35x to 1.80x on its own. See <code>docs/metrics-baseline.md</code>.
</div>

<div class="stat-grid-4">
  <div class="stat-card">
    <div class="s-label">Tokens saved</div>
    <div class="s-value unmeasured">&mdash;</div>
    <div class="s-sub">via cache + optimiser</div>
    <div class="unmeasured-why">Requires the privacy stage to write what it replaced (DA1.1).</div>
    <div class="unmeasured-why">Requires cache hits and misses to be recorded (DA1.3).</div>
    <div class="unmeasured-why">Requires per-request token counts and dated provider pricing (DA1.2, and pricing.yaml is not written).</div>
    <div class="unmeasured-why">Counted from the token field of each request record (DA1.2).</div>
  </div>
  <div class="stat-card">
    <div class="s-label">Cost saved</div>
    <div class="s-value unmeasured">&mdash;</div>
    <div class="s-sub">USD today</div>
  </div>
  <div class="stat-card">
    <div class="s-label">Cache hit rate</div>
    <div class="s-value unmeasured" id="sv-cache">&mdash;</div>
    <div class="s-sub" id="sv-cache-sub">semantic cache</div>
  </div>
  <div class="stat-card">
    <div class="s-label">Privacy actions</div>
    <div class="s-value unmeasured" id="sv-entities">&mdash;</div>
    <div class="s-sub">entities redacted, all time</div>
  </div>
</div>

<div class="card">
  <h2>What was disclosed</h2>
  <div class="status-row"><span>Dispatches</span><code class="unmeasured" id="sv-dispatches">not measured</code></div>
  <div class="status-row"><span>Sent to a cloud provider</span><code class="unmeasured" id="sv-cloud">not measured</code></div>
  <div class="status-row"><span>Answered locally</span><code class="unmeasured" id="sv-local">not measured</code></div>
  <div class="status-row"><span>Abandoned (no answer recorded)</span><code class="unmeasured" id="sv-abandoned">not measured</code></div>
</div>

<div class="card">
  <h2>Token savings over time</h2>
  <div class="chart-placeholder">No series to plot. A point is added per recorded request once DA1.2 writes them.</div>
</div>

<div class="card">
  <h2>Breakdown by provider</h2>
  <table class="provider-table">
    <thead>
      <tr>
        <th>Provider</th>
        <th>Requests</th>
        <th>Tokens in</th>
        <th>Tokens out</th>
        <th>Est. cost</th>
      </tr>
    </thead>
    <tbody id="sv-providers">
      <tr>
        <td colspan="5" style="color:var(--muted);font-size:0.85em;line-height:1.6;padding:16px 10px;">
          No requests have been recorded yet.
        </td>
      </tr>
    </tbody>
  </table>
</div>

<div class="two-col">

  <div class="card">
    <h2>Semantic cache</h2>
    <div class="status-row">
      <span>Total entries</span>
      <code class="unmeasured">not measured</code>
    </div>
    <div class="status-row">
      <span>Hits</span>
      <code class="unmeasured">not measured</code>
    </div>
    <div class="status-row">
      <span>Misses</span>
      <code class="unmeasured">not measured</code>
    </div>
    <div class="status-row">
      <span>Avg similarity score</span>
      <code class="unmeasured">not measured</code>
    </div>
  </div>

  <div class="card">
    <h2>Token optimiser</h2>
    <div class="status-row">
      <span>Compression ratio</span>
      <code class="unmeasured">not measured</code>
    </div>
    <div class="status-row">
      <span>Chars removed</span>
      <code class="unmeasured">not measured</code>
    </div>
    <div class="status-row">
      <span>Avg prompt reduction</span>
      <code class="unmeasured">not measured</code>
    </div>
    <div class="status-row">
      <span>Optimised requests</span>
      <code class="unmeasured">not measured</code>
    </div>
  </div>

</div>

<script>
(function () {
  function set(id, text) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = text;
    el.classList.remove('unmeasured');
  }
  function bytes(n) {
    if (n >= 1e6) return (n / 1e6).toFixed(2) + ' MB';
    if (n >= 1e3) return (n / 1e3).toFixed(1) + ' kB';
    return n + ' B';
  }
  fetch('/api/savings').then(function (r) { return r.json(); }).then(function (d) {
    if (!d || !d.measured) return;
    var looked = d.cache_hits + d.cache_misses;
    if (looked > 0) {
      set('sv-cache', Math.round(100 * d.cache_hits / looked) + '%');
      set('sv-cache-sub', d.cache_hits + ' of ' + looked + ' requests');
    }
    set('sv-entities', String(d.entities_redacted));
    var x = d.disclosure || {};
    set('sv-dispatches', String(x.dispatches));
    set('sv-cloud', x.cloud_dispatches + ' (' + bytes(x.bytes_sent_cloud) + ')');
    set('sv-local', x.local_dispatches + ' (' + bytes(x.bytes_sent_local) + ')');
    set('sv-abandoned', String(x.abandoned));
    var body = document.getElementById('sv-providers');
    if (body && d.providers && d.providers.length) {
      body.textContent = '';
      d.providers.forEach(function (p) {
        var tr = document.createElement('tr');
        [p.provider, p.requests, p.tokens_in, p.tokens_out, '$' + Number(p.cost_usd).toFixed(4)].forEach(function (v) {
          var td = document.createElement('td');
          td.textContent = String(v);
          tr.appendChild(td);
        });
        body.appendChild(tr);
      });
    }
  }).catch(function () { /* the figures stay unmeasured */ });
})();
</script>

{! end !}

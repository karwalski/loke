m=ooke.handlers;
i=http:std.http;
i=apiapprove:page.api.approve;
i=apihealth:browser.pages.api.health;
i=apimodels:browser.pages.api.models;
i=apipipeline:browser.pages.api.pipeline;
i=apiprivacy:page.api.privacy;
i=apisavings:page.api.savings;
i=apisettings:browser.pages.api.settings;
i=apitabs:page.api.tabs;
i=approve:page.approve;
i=chat:page.chat;
i=index:page.index;
i=installer:page.installer;
i=pipeline:page.pipeline;
i=privacy:page.privacy;
i=savings:page.savings;
i=setup:page.setup;
i=sysmon:page.sysmon;
i=tabs:page.tabs;

f=hapiapprovepost(req:i64):i64{
  <apiapprove.post(req)
};

f=hapihealthget(req:i64):i64{
  <apihealth.get(req)
};

f=hapimodelsget(req:i64):i64{
  <apimodels.get(req)
};

f=hapipipelineget(req:i64):i64{
  <apipipeline.get(req)
};

f=hapipipelinepost(req:i64):i64{
  <apipipeline.post(req)
};

f=hapiprivacyget(req:i64):i64{
  <apiprivacy.get(req)
};

f=hapiprivacypost(req:i64):i64{
  <apiprivacy.post(req)
};

f=hapisavingsget(req:i64):i64{
  <apisavings.get(req)
};

f=hapisavingspost(req:i64):i64{
  <apisavings.post(req)
};

f=hapisettingsget(req:i64):i64{
  <apisettings.get(req)
};

f=hapisettingspost(req:i64):i64{
  <apisettings.post(req)
};

f=hapitabsget(req:i64):i64{
  <apitabs.get(req)
};

f=hapitabspost(req:i64):i64{
  <apitabs.post(req)
};

f=happroveget(req:i64):i64{
  <approve.get(req)
};

f=hchatget(req:i64):i64{
  <chat.get(req)
};

f=hindexget(req:i64):i64{
  <index.get(req)
};

f=hinstallerget(req:i64):i64{
  <installer.get(req)
};

f=hpipelineget(req:i64):i64{
  <pipeline.get(req)
};

f=hprivacyget(req:i64):i64{
  <privacy.get(req)
};

f=hsavingsget(req:i64):i64{
  <savings.get(req)
};

f=hsetupget(req:i64):i64{
  <setup.get(req)
};

f=hsysmonget(req:i64):i64{
  <sysmon.get(req)
};

f=htabsget(req:i64):i64{
  <tabs.get(req)
};

f=registerall():@$str{
  let paths=mut.@($str);
  (http.post("/api/approve";&hapiapprovepost));
  (http.get("/api/health";&hapihealthget));
  paths=paths.append("/api/health");
  (http.get("/api/models";&hapimodelsget));
  paths=paths.append("/api/models");
  (http.get("/api/pipeline";&hapipipelineget));
  paths=paths.append("/api/pipeline");
  (http.post("/api/pipeline";&hapipipelinepost));
  (http.get("/api/privacy";&hapiprivacyget));
  paths=paths.append("/api/privacy");
  (http.post("/api/privacy";&hapiprivacypost));
  (http.get("/api/savings";&hapisavingsget));
  paths=paths.append("/api/savings");
  (http.post("/api/savings";&hapisavingspost));
  (http.get("/api/settings";&hapisettingsget));
  paths=paths.append("/api/settings");
  (http.post("/api/settings";&hapisettingspost));
  (http.get("/api/tabs";&hapitabsget));
  paths=paths.append("/api/tabs");
  (http.post("/api/tabs";&hapitabspost));
  (http.get("/approve";&happroveget));
  paths=paths.append("/approve");
  (http.get("/chat";&hchatget));
  paths=paths.append("/chat");
  (http.get("/";&hindexget));
  paths=paths.append("/");
  (http.get("/installer";&hinstallerget));
  paths=paths.append("/installer");
  (http.get("/pipeline";&hpipelineget));
  paths=paths.append("/pipeline");
  (http.get("/privacy";&hprivacyget));
  paths=paths.append("/privacy");
  (http.get("/savings";&hsavingsget));
  paths=paths.append("/savings");
  (http.get("/setup";&hsetupget));
  paths=paths.append("/setup");
  (http.get("/sysmon";&hsysmonget));
  paths=paths.append("/sysmon");
  (http.get("/tabs";&htabsget));
  paths=paths.append("/tabs");
  <paths
};

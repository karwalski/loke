# Generated by ooke — per-app serve binary build
# Regenerate with: /Users/matthew.watt/tk/toke-ooke/scripts/gen_app_makefile.sh .

TKC         := /Users/matthew.watt/tk/toke/toke
TKC_IFLAGS  :=  -I /Users/matthew.watt/loke/loke/packages/browser/../../build/interfaces -I /Users/matthew.watt/loke/loke/packages/browser/build/interfaces
TOKE_STDLIB := /Users/matthew.watt/tk/toke/src/stdlib
TOKE_VENDOR := /Users/matthew.watt/tk/toke/stdlib/vendor
OOKE_DIR    := /Users/matthew.watt/tk/toke-ooke
PROJECT     := .

BIN := build/loke

# Exclude files with duplicate symbols
STDLIB_SRCS := $(filter-out $(TOKE_STDLIB)/llm_tool.c $(TOKE_STDLIB)/infer_stream.c, $(wildcard $(TOKE_STDLIB)/*.c))

CMARK_SRCS := $(filter-out $(TOKE_VENDOR)/cmark/src/main.c, $(wildcard $(TOKE_VENDOR)/cmark/src/*.c))
TOML_SRCS  := $(TOKE_VENDOR)/tomlc99/toml.c
VENDOR_SRCS := $(CMARK_SRCS) $(TOML_SRCS)

CFLAGS := -std=c99 -D_GNU_SOURCE -O1 -iquote $(TOKE_STDLIB) \
          -I$(TOKE_VENDOR)/cmark/src -I$(TOKE_VENDOR)/tomlc99 \
          -Wno-pedantic -DTK_HAVE_OPENSSL
LIBS := -lssl -lcrypto -lz -lm -lsqlite3
LDFLAGS += -Wl,-no_warn_duplicate_libraries,-force_load_swift_libs

UNAME := $(shell uname -s)
ifeq ($(UNAME), Darwin)
  CFLAGS  += -I/opt/homebrew/include
  LDFLAGS += -L/opt/homebrew/lib
  LIBS    += -framework Security -framework CoreFoundation -lobjc
endif

# ooke library modules (pre-compiled)
OOKE_LL :=  /Users/matthew.watt/tk/toke-ooke/src/ooke/config /Users/matthew.watt/tk/toke-ooke/src/ooke/store /Users/matthew.watt/tk/toke-ooke/src/ooke/router /Users/matthew.watt/tk/toke-ooke/src/ooke/template /Users/matthew.watt/tk/toke-ooke/src/ooke/validate /Users/matthew.watt/tk/toke-ooke/src/ooke/repair /Users/matthew.watt/tk/toke-ooke/src/ooke/serve

# App page handler modules
PAGE_LL :=  build/ooke/approve build/ooke/health build/ooke/models build/ooke/pipeline build/ooke/privacy build/ooke/savings build/ooke/settings build/ooke/tabs build/ooke/page_approve build/ooke/chat build/ooke/index build/ooke/installer build/ooke/page_pipeline build/ooke/page_privacy build/ooke/page_savings build/ooke/setup build/ooke/sysmon build/ooke/page_tabs
PAGE_TKI :=  build/ooke/page.api.approve.tki build/ooke/browser.pages.api.health.tki build/ooke/browser.pages.api.models.tki build/ooke/browser.pages.api.pipeline.tki build/ooke/page.api.privacy.tki build/ooke/page.api.savings.tki build/ooke/browser.pages.api.settings.tki build/ooke/page.api.tabs.tki build/ooke/page.approve.tki build/ooke/page.chat.tki build/ooke/page.index.tki build/ooke/page.installer.tki build/ooke/page.pipeline.tki build/ooke/page.privacy.tki build/ooke/page.savings.tki build/ooke/page.setup.tki build/ooke/page.sysmon.tki build/ooke/page.tabs.tki


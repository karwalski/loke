TKC         := /Users/matthew.watt/tk/toke/toke
TOKE_STDLIB := /Users/matthew.watt/tk/toke/src/stdlib
TOKE_VENDOR := /Users/matthew.watt/tk/toke/stdlib/vendor
OOKE_DIR    := /Users/matthew.watt/tk/toke-ooke
PROJECT     := .

BIN := build/loke

STDLIB_SRCS := \
  $(TOKE_STDLIB)/str.c \
  $(TOKE_STDLIB)/file.c \

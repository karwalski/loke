# Generated handlers module
build/ooke/handlers.tki build/ooke/handlers: _handlers.tk $(addsuffix .tki,$(PAGE_LL)) | build/ooke
	cd $(PROJECT) && $(TKC) $(TKC_IFLAGS) --emit-interface --emit-llvm --out build/ooke/handlers _handlers.tk

# Main entry point
build/main.ll: _serve_main.tk build/ooke/handlers.tki | build/ooke
	cd $(PROJECT) && $(TKC) $(TKC_IFLAGS) --emit-llvm --out build/main.ll _serve_main.tk

# Final binary — compile .ll to .o individually then link
$(BIN): build/main.ll build/ooke/handlers $(PAGE_LL) $(CORE_LL) | build/ooke
	@echo "Compiling IR to object files..."
	@for f in build/main.ll $$(find build/ooke -type f ! -name '*.tki' ! -name '*.o'); do \
	  clang -c -x ir "$$f" -o "$$f.o" 2>/dev/null || true; \
	done
	@for f in $(OOKE_LL); do \
	  clang -c -x ir "$$f" -o "$$f.o" 2>/dev/null || true; \
	done
	@echo "Linking $@..."
	clang $(CFLAGS) $(LDFLAGS) \
	  $$(find build -name '*.o' 2>/dev/null) $$(for f in $(OOKE_LL); do echo "$$f.o"; done) \
	  -x c $(STDLIB_SRCS) $(VENDOR_SRCS) \
	  -o $@ $(LIBS)

clean:
	rm -rf build/

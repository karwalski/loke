m=page.sysmon;
i=http:std.http;
i=tpl:ooke.template;
i=sysmon:core.monitoring.sysmon;

f=get(req:i64):i64{
  let stats=sysmon.snapshot();
  let json=sysmon.tojson(stats);
  <tpl.renderfile("templates/sysmon.tkt";@("stats":json))
};

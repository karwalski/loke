m=page.sysmon;
i=http:std.http;
i=tpl:ooke.template;
i=sysmon:core.monitoring.sysmon;

f=get(req:i64):i64{
  let stats=sysmon.snapshot();
  let json=sysmon.tojson(stats);
  mt tpl.tplrenderfile("templates/sysmon.tkt";@("stats":json);"templates") {
    $ok:h http.res(200;h);
    $err:e http.res(500;"template render failed")
  }
};

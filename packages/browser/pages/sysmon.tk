m=page.sysmon;
i=http:std.http;
i=sysmon:core.monitoring.sysmon;

(* BG1.2: the snapshot is the answer, as JSON. It was handed to templates/sysmon.tkt as a
   variable named "stats", and the template printed {! yield("stats") !}, which yields a BLOCK of
   that name. There is no such block, so measured on 2026-10-08 against the built server, every
   /sysmon answered 200 with the template's two licence comments and no figure at all. *)
f=get(req:i64):i64{
  <http.resjson(200;sysmon.tojson(sysmon.snapshot()))
};

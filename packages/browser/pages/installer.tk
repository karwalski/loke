m=page.installer;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=sys:std.sys;
i=tpl:ooke.template;
i=core:browser.extensions.core;
i=ollama:core.models.ollama;
i=hw:core.models.hardware;
i=log:shared.log;

t=$modelrec{ name:str; sizegb:f64; tokslow:u32; tokshigh:u32; label:str };

f=recommendmodel(ramgb:f64):$modelrec{
  if(ramgb > 64.0){
    <$modelrec{name:"qwen2.5:32b";sizegb:20.0;tokslow:5;tokshigh:15;label:"Qwen 2.5 32B"};
  }el{
    if(ramgb > 32.0){
      <$modelrec{name:"qwen2.5:14b";sizegb:9.0;tokslow:10;tokshigh:25;label:"Qwen 2.5 14B"};
    }el{
      if(ramgb > 16.0){
        <$modelrec{name:"qwen2.5:7b";sizegb:4.5;tokslow:20;tokshigh:40;label:"Qwen 2.5 7B"};
      }el{
        if(ramgb > 8.0){
          <$modelrec{name:"qwen2.5:3b";sizegb:2.0;tokslow:30;tokshigh:50;label:"Qwen 2.5 3B"};
        }el{
          <$modelrec{name:"qwen2.5:1.5b";sizegb:1.0;tokslow:40;tokshigh:60;label:"Qwen 2.5 1.5B"};
        };
      };
    };
  };
};

f=hardwaresummaryjson():str{
  let profile=hw.detectprofile();
  let config=core.getconfig();

  let client=ollama.new(config.ollamaurl);
  let ollamaok=ollama.healthcheck(client);
  let ollamastatus=mut."not_installed";
  mt ollamaok {
    $running:v ollamastatus="running";
    $stopped:v ollamastatus="installed";
    $unreachable:v ollamastatus="not_installed"
  };

  let hasmodel=mut.false;
  let models=mt ollama.listmodels(client) {$ok:v v;
    $err:e @()
  };
  let modelcount=models.len;
  if(modelcount > 0){ hasmodel=true }el{};

  let diskfree=sys.diskfreegb();

  let platform=sys.platform();
  let chip=sys.chipname();
  let isarm=sys.isarm64();

  let ram=profile.ramgb;
  let unified=profile.unifiedmemorygb;

  let effectiveram=mut.ram;
  if(unified > 0.0){ effectiveram=unified }el{};
  let efframs=str.fromf64(effectiveram);
  let effram=str.tof64(efframs);
  let rec=recommendmodel(effram);

  let isarmbool=mut."false";
  if(isarm){isarmbool="true"};
  let hasmodelbool=mut."false";
  if(hasmodel){hasmodelbool="true"};

  <str.concat("{";
    str.concat("\"chip\":";
    str.concat(json.encstr(chip);
    str.concat(",\"platform\":";
    str.concat(json.encstr(platform);
    str.concat(",\"is_arm64\":";
    str.concat(isarmbool;
    str.concat(",\"ram_gb\":";
    str.concat(str.fromf64(ram);
    str.concat(",\"unified_memory_gb\":";
    str.concat(str.fromf64(unified);
    str.concat(",\"disk_free_gb\":";
    str.concat(str.fromf64(diskfree);
    str.concat(",\"ollama_status\":";
    str.concat(json.encstr(ollamastatus);
    str.concat(",\"has_model\":";
    str.concat(hasmodelbool;
    str.concat(",\"model_count\":";
    str.concat(str.fromu32(modelcount);
    str.concat(",\"rec_model\":";
    str.concat(json.encstr(rec.name);
    str.concat(",\"rec_label\":";
    str.concat(json.encstr(rec.label);
    str.concat(",\"rec_size_gb\":";
    str.concat(str.fromf64(rec.sizegb);
    str.concat(",\"rec_tok_s_low\":";
    str.concat(str.fromu32(rec.tokslow);
    str.concat(",\"rec_tok_s_high\":";
    str.concat(str.fromu32(rec.tokshigh);
    "}")))))))))))))))))))))))))))));
};

f=allmodelsjson():str{
  <"[{\"name\":\"qwen2.5:1.5b\",\"label\":\"Qwen 2.5 1.5B\",\"size_gb\":1.0,\"tok_s\":\"40-60\",\"ram\":\"4-7 GB\"},{\"name\":\"qwen2.5:3b\",\"label\":\"Qwen 2.5 3B\",\"size_gb\":2.0,\"tok_s\":\"30-50\",\"ram\":\"8-15 GB\"},{\"name\":\"qwen2.5:7b\",\"label\":\"Qwen 2.5 7B\",\"size_gb\":4.5,\"tok_s\":\"20-40\",\"ram\":\"16-31 GB\"},{\"name\":\"qwen2.5:14b\",\"label\":\"Qwen 2.5 14B\",\"size_gb\":9.0,\"tok_s\":\"10-25\",\"ram\":\"32-63 GB\"},{\"name\":\"qwen2.5:32b\",\"label\":\"Qwen 2.5 32B\",\"size_gb\":20.0,\"tok_s\":\"5-15\",\"ram\":\"64+ GB\"}]"
};

f=get(req:i64):i64{
  let cid=log.newcorrelationid();
  log.info("installer page loaded";"page.installer";cid);

  let hwjson=hardwaresummaryjson();
  let modelsjson=allmodelsjson();

  <tpl.renderfile("templates/installer.tkt"; @(
    "page.title":"loke -- local model installer";
    "hardware_json":hwjson;
    "models_json":modelsjson
  ));
};

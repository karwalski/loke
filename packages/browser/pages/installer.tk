m=page.installer;
i=http:std.http;
i=json:std.json;
i=jx:shared.jsonobj;
i=str:std.str;
i=sys:std.sys;
i=tpl:ooke.template;
i=core:browser.extensions.core;
i=ollama:core.models.ollama;
i=log:shared.log;

t=$modelrec{ name:str; sizegb:f64; tokslow:u32; tokshigh:u32; label:str };

f=recommendmodel(ramgb:f64):$modelrec{
  if(ramgb > 64.0){
    <$modelrec{name:"qwen2.5:32b";sizegb:20.0;tokslow:5;tokshigh:15;label:"Qwen 2.5 32B"};
  }el if(ramgb > 32.0){
    <$modelrec{name:"qwen2.5:14b";sizegb:9.0;tokslow:10;tokshigh:25;label:"Qwen 2.5 14B"};
  }el if(ramgb > 16.0){
    <$modelrec{name:"qwen2.5:7b";sizegb:4.5;tokslow:20;tokshigh:40;label:"Qwen 2.5 7B"};
  }el if(ramgb > 8.0){
    <$modelrec{name:"qwen2.5:3b";sizegb:2.0;tokslow:30;tokshigh:50;label:"Qwen 2.5 3B"};
  }el{
    <$modelrec{name:"qwen2.5:1.5b";sizegb:1.0;tokslow:40;tokshigh:60;label:"Qwen 2.5 1.5B"};
  };
};

f=hardwaresummaryjson():str{

  let client=ollama.new(core.getconfig().ollamaurl);
  (* `ollamastatus=="running"` compared and threw the result away, so this page
     reported "not_installed" however healthy Ollama was. A match arm is an
     expression, so the status is the value of the match rather than an assignment
     inside it — and the subject is annotated, since toke miscompiles a 3+-arm match
     whose subject type it cannot see (docs/upstream/toke-issues.md T-2). *)
  let ollamaok:$ollamastatus=ollama.healthcheck(client);
  let ollamastatus=mt ollamaok {
    $running:v "running";
    $stopped:v "installed";
    $unreachable:v "not_installed"
  };

  let hasmodel=mut.false;
  let models=mt ollama.listmodels(client) {$ok:v v;
    $err:e @()
  };
  let modelcount=models.len;
  if(modelcount > 0){ hasmodel=true }el{};

  (* Measured, not modelled (2026-09-24). This read `hw.detectprofile()`, which is declared
     `:i64` and returns 0, so `profile.ramgb` was a nil dereference: the runtime aborted
     the worker (RT005) on every request to /installer. That was hidden until the page
     returned its value at all (LS1.1m). hw.detect() is no substitute: it returns invented
     Mac defaults (F2.8a), and showing those as the user's hardware would be a fabricated
     figure. std.sys measures RAM and free disk. Both come back as WHOLE gigabytes, as an
     integer, whatever the interface says: `diskfree` used to go through str.fromf64 and
     rendered as 7.9e-323. On Apple Silicon memory is unified, so it is the same figure. *)
  let diskfree=sys.diskfreegb("/");

  let platform=sys.platform();
  let chip=sys.chipname();
  let isarm=sys.isarm64();

  let ram=sys.totalramgb();
  let unified=mut.0;
  if(isarm){ unified=ram }el{};
  let rec=recommendmodel(ram as f64);

  let isarmbool=if(isarm){"true"}el{"false"};
  let hasmodelbool=mut."false";
  if(hasmodel){hasmodelbool="true"};

  <str.concat("{";
    str.concat("\"chip\":";
    str.concat(jx.escape(chip);
    str.concat(",\"platform\":";
    str.concat(jx.escape(platform);
    str.concat(",\"is_arm64\":";
    str.concat(isarmbool;
    str.concat(",\"ram_gb\":";
    str.concat(str.fromint(ram);
    str.concat(",\"unified_memory_gb\":";
    str.concat(str.fromint(unified);
    str.concat(",\"disk_free_gb\":";
    str.concat(str.fromint(diskfree);
    str.concat(",\"ollama_status\":";
    str.concat(jx.escape(ollamastatus);
    str.concat(",\"has_model\":";
    str.concat(hasmodelbool;
    str.concat(",\"model_count\":";
    str.concat(str.fromint(modelcount);
    str.concat(",\"rec_model\":";
    str.concat(jx.escape(rec.name);
    str.concat(",\"rec_label\":";
    str.concat(jx.escape(rec.label);
    str.concat(",\"rec_size_gb\":";
    str.concat(str.fromf64(rec.sizegb);
    str.concat(",\"rec_tok_s_low\":";
    str.concat(str.fromint(rec.tokslow);
    str.concat(",\"rec_tok_s_high\":";
    str.concat(str.fromint(rec.tokshigh);
    "}")))))))))))))))))))))))))))));
};

f=allmodelsjson():str{
  <"[{\"name\":\"qwen2.5:1.5b\",\"label\":\"Qwen 2.5 1.5B\",\"size_gb\":1.0,\"tok_s\":\"40-60\",\"ram\":\"4-7 GB\"},{\"name\":\"qwen2.5:3b\",\"label\":\"Qwen 2.5 3B\",\"size_gb\":2.0,\"tok_s\":\"30-50\",\"ram\":\"8-15 GB\"},{\"name\":\"qwen2.5:7b\",\"label\":\"Qwen 2.5 7B\",\"size_gb\":4.5,\"tok_s\":\"20-40\",\"ram\":\"16-31 GB\"},{\"name\":\"qwen2.5:14b\",\"label\":\"Qwen 2.5 14B\",\"size_gb\":9.0,\"tok_s\":\"10-25\",\"ram\":\"32-63 GB\"},{\"name\":\"qwen2.5:32b\",\"label\":\"Qwen 2.5 32B\",\"size_gb\":20.0,\"tok_s\":\"5-15\",\"ram\":\"64+ GB\"}]"
};

f=get(req:i64):i64{
  log.info("installer page loaded";"page.installer";log.newcorrelationid());


  (* LS1.1m — this match was the function's last statement with no `<`, so the /installer
     route fell off its end: the emitted IR was `ret i64 0 ; implicit return`, and the
     response it built was discarded. *)
  <mt tpl.tplrenderfile("templates/installer.tkt"; @(
    "page.title":"loke -- local model installer";
    "hardware_json":hardwaresummaryjson();
    "models_json":allmodelsjson()
  );"templates") {
    $ok:h http.res(200;h);
    $err:e http.res(500;"template render failed")
  };
};

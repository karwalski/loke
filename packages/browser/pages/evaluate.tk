m=page.evaluate;
i=http:std.http;
i=tpl:ooke.template;

(* F3b.9. The layer comparison panel: POST /api/evaluate on a sample text, each layer's
   result side by side. The page renders what the route answers and holds no result of its
   own. *)
f=get(req:i64):i64{
  <mt tpl.tplrenderfile("templates/evaluate.tkt"; @();"templates") {
    $ok:h http.res(200;h);
    $err:e http.res(500;"template render failed")
  };
};

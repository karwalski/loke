m=page.api.privacylayers;
i=http:std.http;
i=org:shared.origin;
i=lv:core.privacy.layerview;

(* F3b.2 (b). The settings UI's privacy layers: GET shows the [[privacy.layers]] config.toml
   sets, with the organisation policy's floor beside them; POST writes them, keeping every
   other line of config.toml, and refuses what the server would not apply (the regex layer
   turned down, a config the pipeline would refuse, a config below the policy). The bodies
   are core.privacy.layerview's, built without a request so they can be tested. *)

f=get(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;lv.editorjson())
};

f=post(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let r=lv.savelayers(mt http.body(req) {$ok:v v; $err:e ""});
  <http.res(r.status;r.body)
};

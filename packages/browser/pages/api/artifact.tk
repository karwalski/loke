m=page.api.artifact;

i=http:std.http;
i=str:std.str;
i=std:std;
i=org:shared.origin;
i=dbmod:core.storage.db;
i=na:core.nocustody.artifact;
i=nr:core.nocustody.request;

(* NC1.7. POST /api/artifact: run a returned artifact against a dataset the caller holds, on
   this machine. This is the production caller core.nocustody.artifact was written for; before
   it, moke.compute.execute was a complete local engine with no caller at all.

   The store is opened first because the executor loads the dataset into a TEMP table on
   std.db's one process-wide connection and never opens a database itself (see the note at the
   top of core.nocustody.artifact). The rows never reach loke.db's file.

   The body is read with shared.jsonobj's nested reader, which matches `"artifact":` with no
   space after the colon, so send compact JSON. The shape is in core.nocustody.request. *)

f=openstore():i64{
  <mt dbmod.openstore(str.concat(std.homedir();"/.loke")) {
    $ok:s 1;
    $err:e 0
  }
};

f=get(req:i64):i64{
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(405;nr.errorjson("POST an artifact to run it"))
};

f=post(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let r=nr.parse(http.reqbody(req));
  if(str.len(r.err)>0){ <http.res(400;nr.errorjson(r.err)) }el{};
  if(openstore()==0){ <http.res(503;nr.errorjson("the local store could not be opened")) }el{};
  let result=na.run(r.artifact;r.headers;r.rows);
  if(result.ok==false){ <http.res(422;nr.resultjson(result)) }el{};
  <http.res(200;nr.resultjson(result))
};

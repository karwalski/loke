m=page.api.approve;

i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;
i=pipeline:core.privacy.pipeline;
i=router:core.router.router;
i=disp:core.providers.dispatcher;
i=pt:core.providers.types;
i=t:shared.types;
i=log:shared.log;

f=post(req:i64):i64{
  let cid=log.newcorrelationid();
  log.info("approve API called";"api/approve";cid);

  let body=req.body;
  let approved=mt json.getbool(body;"approved") {$ok:v v;
    $err:e false
  };

  if(!approved){
    log.info("prompt rejected by user";"api/approve";cid);
    <http.res.json(200;"{\"ok\":true,\"action\":\"cancelled\"}")
  }el{
    let anonymised=mt json.getstr(body;"anonymised") {$ok:v v;
      $err:e ""
    };
    let systemprompt=mt json.getstr(body;"system_prompt") {$ok:v v;
      $err:e ""
    };
    let dontaskagain=mt json.getbool(body;"dont_ask_again") {$ok:v v;
      $err:e false
    };
    let modelhint=mt json.getstr(body;"model") {$ok:v v;
      $err:e ""
    };

    if(dontaskagain){
      core.setpreference("skip_approval";"true")
    }el{()};

    let sensitivity=t.sensitivitylevel.$confidential:i64;
    let routing=mt router.route(
      core.getrouter();
      anonymised;
      sensitivity;
      0;
      t.latencytolerance.$instant:i64;
      cid
    ) {$ok:v v;
      $err:e http.res.err(500;"router error")
    };

    let completionreq=pt.completionrequest{
      modelid:i64.id;
      messages:@(pt.usermsg(anonymised));
      systemprompt:systemprompt;
      maxtokens:4096;
      temperature:0.7;
      stream:false
    };

    let response=mt disp.dispatch(core.getdispatcher();completionreq;routing.model.provider) {$ok:v v;
      $err:e http.res.err(500;"dispatch error")
    };

    let respbody=str.concat("{";
      str.concat("\"ok\":true,";
      str.concat("\"action\":\"approved\",";
      str.concat("\"response\":";
      str.concat(json.encstr(response.content);
      str.concat(",\"model_id\":";
      str.concat(json.encstr(routing.model.id);
      str.concat(",\"tokens_in\":";
      str.concat(str.fromu32(response.tokensin);
      str.concat(",\"tokens_out\":";
      str.concat(str.fromu32(response.tokensout);
      "}")))))))))));

    log.info("approved prompt dispatched";"api/approve";cid);
    <http.res.json(200;respbody)
  };
};

m=browser.pages.api.models;

i=http:std.http;
i=str:std.str;
i=reach:shared.reachability;
i=org:shared.origin;

(* Two bugs, both of which compiled.

   `http.get("http://…")` passed one argument to a two-parameter function
   (httpclient, str). And the ok arm bound an $httpresp and returned it where a str
   body was expected, so the response body was a struct pointer rendered as text.

   It also could not detect Ollama being down: http.get against a closed port returns
   $ok carrying a nil response, so the $err arm never ran and the fallback
   {"models":[]} was unreachable. reach.localserviceup probes the port instead. *)

f=ollamaurl():str{
  <"http://127.0.0.1:11434"
};

f=emptymodels():str{
  <"{\"models\":[]}"
};

f=modelsjson():str{
  if(reach.localserviceup(ollamaurl())){}el{
    <emptymodels()
  };
  <mt http.get(http.client(ollamaurl());"/api/tags") {
    $ok:r bodyof(r);
    $err:e emptymodels()
  }
};

(* Typed, because a match binding carries no struct type and `body` is declared at
   different offsets by more than one struct. *)
f=bodyof(r:$httpresp):str{
  <str.frombytes(r.body)
};

f=get(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;modelsjson())
};

m=browser.pages.api.models;

i=http:std.http;
i=str:std.str;

f=get(req:i64):i64{
  let result=http.get("http://127.0.0.1:11434/api/tags");
  let body=mt result {
    $ok:v v;
    $err:e "{\"models\":[]}"
  };
  <http.res(200;body)
};

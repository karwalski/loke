m=browser.pages.api.models;



i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;
i=ollama:core.models.ollama;

f=get(req:$http.req):$http.res{
  let config=core.getconfig();
  let client=ollama.new(config.ollamaurl);

  
  let modelsresult=mt ollama.listmodels(client) {
    $ok:v v;
    $err:e{
      <http.res.err(502;"unable to reach Ollama — is it running?")
    };
  };

  
  let runningresult=mt ollama.listrunning(client) {
    $ok:v v;
    $err: @()
  };

  
  let modelcount=modelsresult.len;
  let runningcount=runningresult.len;
  let items="";
  let i=0;
  loop{
    if(i>=modelcount){
      break
    }else{
      let m=str.arrayget(modelsresult;i);

      
      let isrunning=false;
      let ri=0;
      loop{
        if(ri>=runningcount){
          break
        }else{
          let rm=str.arrayget(runningresult;ri);
          if(str.eq(rm.name;m.name)){
            isrunning=true;
            ri=runningcount
          }else{
            ri=ri+1
          };
        };
      };

      let runningstr="false";
      if(isrunning){
        let runningstr="true"
      }else{
        
      };

      let sizestr=str.fromu64(m.size);

      let entry=str.concat("{";
        str.concat("\"id\":";
        str.concat(json.encstr(m.name);
        str.concat(",\"size\":";
        str.concat(sizestr;
        str.concat(",\"running\":";
        str.concat(runningstr;
        "}")))))));

      if(i==0){
        let items=entry
      }else{
        let items=str.concat(items;str.concat(",";entry))
      };
      i=i+1;
    };
  };

  let respbody=str.concat("[";str.concat(items;"]"));
  <http.res.json(200;respbody)
};

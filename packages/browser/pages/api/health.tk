m=page.api.health;
i=http:std.http;
i=str:std.str;
i=reach:shared.reachability;
i=org:shared.origin;
i=pipe:core.privacy.pipeline;
i=lv:core.privacy.layerview;

(* The body is built by a function that takes no request, so it can be tested.
   `get` is the thin HTTP wrapper around it.

   toke exposes no way to construct an http request or read a response body from
   source, so tests/unit/browser/* could not test a handler taking req:i64 — all ten
   of them called str.mockhttpreq and str.httpbody, helpers that exist nowhere, and
   had never compiled. Splitting the body out is the fix that does not need an
   upstream change; the request accessors are asked for separately as T-16. *)

f=ollamastatus():str{
  (* reach.localserviceup, not an http.get whose result is string-matched. The
     previous version called http.get with one argument — the signature is
     (httpclient, str) — and compared the RESULT to "models" with str.contains, so
     hasmodels was false whatever Ollama was doing, and this endpoint reported
     "offline" permanently. *)
  if(reach.localserviceup("http://127.0.0.1:11434")){
    <"running"
  }el{
    <"offline"
  }
};

(* F3b.6. The detection layers the request path runs (core.privacy.pipeline.served), each
   probed through core.privacy.layerhealth, the path the pipeline itself takes:
   {"state":"healthy|degraded|unhealthy","summary":"...","layers":[{"id","enabled","state","reason",...}]}.
   A layer switched off reads "disabled"; one that is on and not answering reads
   "unavailable" with the reason the pipeline would record.

   F3b.8 (3). The layers as a request runs them: config.toml's with the organisation policy
   applied over them, as core.privacy.pipeline.run applies it, and each field the policy
   changed named in the layer's policy_changed (core.privacy.layerview.healthjson). It
   reported config.toml's layers alone, so a layer the policy bans read as enabled. *)
f=privacylayersjson(c:$pipelineconfig):str{
  <lv.healthjson(c)
};

f=healthjson():str{
  let layers=privacylayersjson(pipe.served());
  <"{\"ok\":true,\"loke\":\"0.4.0\",\"ollama\":\"\(ollamastatus())\",\"port\":11430,\"privacy_layers\":\(layers)}"
};

f=get(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;healthjson())
};

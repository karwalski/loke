m=page.api.health;
i=http:std.http;
i=str:std.str;
i=reach:shared.reachability;

(* The body is built by a function that takes no request, so it can be tested.
   `get` is the thin HTTP wrapper around it.

   toke exposes no way to construct an http request or read a response body from
   source, so tests/unit/browser/* could not test a handler taking req:i64 — all ten
   of them called str.mockhttpreq and str.httpbody, helpers that exist nowhere, and
   had never compiled. Splitting the body out is the fix that does not need an
   upstream change; the request accessors are asked for separately as T-16. *)

f=ollamastatus():str{
  (* reach.localserviceup, not an http.get whose result is string-matched. The
     previous version called http.get with one argument — the signature is
     (httpclient, str) — and compared the RESULT to "models" with str.contains, so
     hasmodels was false whatever Ollama was doing, and this endpoint reported
     "offline" permanently. *)
  if(reach.localserviceup("http://127.0.0.1:11434")){
    <"running"
  }el{
    <"offline"
  }
};

f=healthjson():str{
  <"{\"ok\":true,\"loke\":\"0.3.0\",\"ollama\":\"\(ollamastatus())\",\"port\":11430}"
};

f=get(req:i64):i64{
  <http.res(200;healthjson())
};

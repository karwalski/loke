m=browser.pages.api.health;



i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;
i=ollama:core.models.ollama;

f=get(req:i64):i64{
  let config=core.getconfig();
  let ollamaclient=ollama.new(config.ollamaurl);
  let ollamastatus=ollama.healthcheck(ollamaclient);

  let ollamastr="unreachable";
  if(ollamastatus==$running{
    let ollamastr="running"
  }else{
    if(ollamastatus==$stopped{
      let ollamastr="stopped"
    }else{
      
    };
  };

  let portstr=str.fromu16(config.port);

  let respbody=str.concat("{";
    str.concat("\"ok\":true,";
    str.concat("\"version\":\"0.1.0\",";
    str.concat("\"ollama\":";
    str.concat(json.encstr(ollamastr);
    str.concat(",\"port\":";
    str.concat(portstr;
    "}")))))));

  <http.res.json(200;respbody)
};

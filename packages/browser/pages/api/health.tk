m=browser.pages.api.health;

i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;
i=ollama:core.models.ollama;

f=get(req:i64):i64{
  let config=core.getconfig();
  let ollamaclient=ollama.new(config.ollamaurl);
  let ollamastatus=ollama.healthcheck(ollamaclient);

  let ollamastr=mut."unreachable";
  if(ollamastatus=1){
    ollamastr="running"
  }el{
    if(ollamastatus=0){
      ollamastr="stopped"
    }el{}
  };

  let portstr=str.fromu16(config.port);

  let j=mut."{\"ok\":true";
  j=str.concat(j;",\"loke\":\"0.2.0\"");
  j=str.concat(j;",\"ooke\":\"0.1.0\"");
  j=str.concat(j;",\"toke\":\"0.1.0\"");
  j=str.concat(j;str.concat(",\"ollama\":";json.encstr(ollamastr)));
  j=str.concat(j;str.concat(",\"port\":";portstr));
  j=str.concat(j;"}");

  <http.res.json(200;j)
};

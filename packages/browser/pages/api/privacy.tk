m=page.api.privacy;

i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;
i=pipeline:core.privacy.pipeline;
i=log:shared.log;

f=get(req:i64):i64{
  let cid=log.newcorrelationid();
  log.info("privacy config requested";"api/privacy";cid);

  let config=core.getpipelineconfig();

  let entities=config.entitytypes;
  let ecount=entities.len;
  let eitems="";
  let ei=mut.0;
  loop{
    if(ei>=ecount){ break }el{
      let e=str.arrayget(entities;ei);
      let enabledstr="false";
      if(e.enabled){ let enabledstr="true" }el{()};
      let entry=str.concat("{";
        str.concat("\"type\":";
        str.concat(json.encstr(e.entitytype);
        str.concat(",\"label\":";
        str.concat(json.encstr(e.label);
        str.concat(",\"enabled\":";
        str.concat(enabledstr;
        str.concat(",\"sensitivity\":";
        str.concat(json.encstr(e.sensitivity);
        str.concat(",\"description\":";
        str.concat(json.encstr(e.description);
        "}")))))))))));
      if(ei=0){
        let eitems=entry
      }el{
        let eitems=str.concat(eitems;str.concat(",";entry))
      };
      ei=ei+1
    };
  };

  let layers=config.detectionlayers;
  let lcount=layers.len;
  let litems="";
  let li=mut.0;
  loop{
    if(li>=lcount){ break }el{
      let l=str.arrayget(layers;li);
      let enabledstr="false";
      if(l.enabled){ let enabledstr="true" }el{()};
      let entry=str.concat("{";
        str.concat("\"id\":";
        str.concat(json.encstr(l.id);
        str.concat(",\"name\":";
        str.concat(json.encstr(l.name);
        str.concat(",\"enabled\":";
        str.concat(enabledstr;
        str.concat(",\"description\":";
        str.concat(json.encstr(l.description);
        "}"))))))));;
      if(li=0){
        let litems=entry
      }el{
        let litems=str.concat(litems;str.concat(",";entry))
      };
      li=li+1
    };
  };

  let currentpreset=mt core.getpreference("privacy_preset") {ok:$v v;
    $err:e "balanced"
  };

  let respbody=str.concat("{";
    str.concat("\"ok\":true,";
    str.concat("\"entities\":";
    str.concat(str.concat("[";str.concat(eitems;"]"));
    str.concat(",\"layers\":";
    str.concat(str.concat("[";str.concat(litems;"]"));
    str.concat(",\"preset\":";
    str.concat(json.encstr(currentpreset);
    "}"))))))));

  <http.res.json(200;respbody)
};

f=post(req:i64):i64{
  let cid=log.newcorrelationid();
  log.info("privacy config update";"api/privacy";cid);

  let body=req.body;
  let action=mt json.getstr(body;"action") {ok:$v v;
    $err:e ""
  };

  if(str.eq(action;"set_preset")){
    let preset=mt json.getstr(body;"preset") {ok:$v v;
      $err:e "balanced"
    };
    core.setpreference("privacy_preset";preset);
    pipeline.applypreset(core.getpipelineconfig();preset);
    log.info("privacy preset changed";"api/privacy";cid);
    <http.res.json(200;"{\"ok\":true}")
  }el{
    if(str.eq(action;"toggle_entity")){
      let entitytype=mt json.getstr(body;"entity_type") {ok:$v v;
        $err:e ""
      };
      let enabled=mt json.getbool(body;"enabled") {ok:$v v;
        $err:e true
      };
      pipeline.setentityenabled(core.getpipelineconfig();entitytype;enabled);
      log.info("entity toggle changed";"api/privacy";cid);
      <http.res.json(200;"{\"ok\":true}")
    }el{
      if(str.eq(action;"toggle_layer")){
        let layerid=mt json.getstr(body;"layer_id") {ok:$v v;
          $err:e ""
        };
        let enabled=mt json.getbool(body;"enabled") {ok:$v v;
          $err:e true
        };
        pipeline.setlayerenabled(core.getpipelineconfig();layerid;enabled);
        log.info("layer toggle changed";"api/privacy";cid);
        <http.res.json(200;"{\"ok\":true}")
      }el{
        <http.res.err(400;"unknown action")
      };
    };
  };
};

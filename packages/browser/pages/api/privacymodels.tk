m=page.api.privacymodels;
i=http:std.http;
i=org:shared.origin;
i=lv:core.privacy.layerview;

(* F3b.7 (1). The settings UI's registered privacy models: GET lists the registrations in
   ~/.loke/privacy-models.json as the pipeline reads them; POST registers one through
   core.privacy.modelregistry.register, the path `loke privacy add-model` takes, refusing what
   the organisation policy would refuse. *)

f=get(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;lv.modelsjson())
};

f=post(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let r=lv.addmodel(mt http.body(req) {$ok:v v; $err:e ""});
  <http.res(r.status;r.body)
};

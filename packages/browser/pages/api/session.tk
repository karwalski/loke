m=page.api.session;

i=http:std.http;
i=str:std.str;
i=std:std;
i=org:shared.origin;
i=dbmod:core.storage.db;
i=ns:core.nocustody.session;

(* NC1.13. POST /api/session: loke issues the session id that POST /api/artifact bounds against
   and that POST /api/pipeline records. Before this the caller named its own, and a caller that
   named a new one each time started with a fresh budget (disclosure-accounting spec U1).

   The body is ignored: a session carries no caller-supplied field. The answer is
   {"ok":true,"session_id":"nc-...","expires_in_s":86400}. Issuing is not rate-limited here;
   what a caller gains by asking for many sessions is bounded by the installation-wide window in
   core.nocustody.bound, which no new session resets. *)

f=openstore():i64{
  <mt dbmod.openstore(str.concat(std.homedir();"/.loke")) {
    $ok:s 1;
    $err:e 0
  }
};

f=get(req:i64):i64{
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(405;"{\"ok\":false,\"error\":\"POST to be issued a session\"}")
};

f=post(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  if(openstore()==0){ <http.res(503;"{\"ok\":false,\"error\":\"the local store could not be opened\"}") }el{};
  let id=ns.issue();
  if(str.len(id)==0){ <http.res(503;"{\"ok\":false,\"error\":\"the session could not be recorded, so none was issued\"}") }el{};
  <http.res(200;ns.issuedjson(id))
};

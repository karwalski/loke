m=page.api.savings;

i=http:std.http;
i=str:std.str;
i=org:shared.origin;

(* The GET body is a constant. This endpoint is a STUB: it returns fixed JSON and
   reads nothing. Exposing the body as a function lets tests/unit/browser cover the
   response contract — those tests called str.mockhttpreq and str.httpbody, which
   exist in no module, so they had never compiled — but a green test here means the
   SHAPE is right, not that the endpoint does anything. Recorded in the backlog so a
   passing test is not mistaken for a working feature. *)
f=savingsjson():str{
  <"{\"tokens_saved\":0,\"cost_saved_usd\":0.0,\"requests\":0}"
};

f=savingspostjson():str{
  <"{\"ok\":true}"
};

f=get(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;savingsjson())
};

f=post(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;savingspostjson())
};

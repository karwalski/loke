m=page.api.tabs;

i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;
i=tabs:loke.browser.workspace.tabs;
i=log:shared.log;

f=tabjson(t:i64):$str{
  let pinnedstr="false";
  if(t.pinned){ let pinnedstr="true" }el{()};
  <str.concat("{";
    str.concat("\"id\":";
    str.concat(json.encstr(t.id);
    str.concat(",\"url\":";
    str.concat(json.encstr(t.url);
    str.concat(",\"title\":";
    str.concat(json.encstr(t.title);
    str.concat(",\"pinned\":";
    str.concat(pinnedstr;
    str.concat(",\"privacy_score\":";
    str.concat(str.fromu32(t.privacyscore);
    "}")))))))))))
};

f=get(req:i64):i64{
  let cid=log.newcorrelationid();
  let store=core.gettabstore();
  let tablist=tabs.listtabs(store);
  let count=tablist.len;
  let items="";
  let i=0;
  loop{
    if(i>=count){ break }el{
      let t=str.arrayget(tablist;i);
      let entry=tabjson(t);
      if(i=0){
        let items=entry
      }el{
        let items=str.concat(items;str.concat(",";entry))
      };
      i=i+1
    };
  };
  let tabsarr=str.concat("[";str.concat(items;"]"));

  let active=tabs.activetab(store);
  let activestr="null";
  if(active=0){()}el{
    let activestr=tabjson(active)
  };

  let respbody=str.concat("{";
    str.concat("\"tabs\":";
    str.concat(tabsarr;
    str.concat(",\"active\":";
    str.concat(activestr;
    "}")))));

  <http.res.json(200;respbody)
};

f=post(req:i64):i64{
  let cid=log.newcorrelationid();
  let body=req.body;

  let action=mt json.getstr(body;"action") {ok:$v v;
    $err:e "open"
  };

  if(str.eq(action;"switch")){
    let tabid=mt json.getstr(body;"id") {ok:$v v;
      $err:e ""
    };
    let store=core.gettabstore();
    let updated=tabs.activate(store;tabid);
    core.settabstore(updated);
    log.info("tab switched";"api/tabs";cid);
    <http.res.json(200;"{\"ok\":true}")
  }el{
    if(str.eq(action;"pin")){
      let tabid=mt json.getstr(body;"id") {ok:$v v;
        $err:e ""
      };
      let store=core.gettabstore();
      let updated=tabs.pin(store;tabid);
      core.settabstore(updated);
      log.info("tab pin toggled";"api/tabs";cid);
      <http.res.json(200;"{\"ok\":true}")
    }el{
      if(str.eq(action;"reorder")){
        let orderjson=mt json.getstr(body;"order") {ok:$v v;
          $err:e "@()"
        };
        let store=core.gettabstore();
        let updated=tabs.reorder(store;orderjson);
        core.settabstore(updated);
        log.info("tabs reordered";"api/tabs";cid);
        <http.res.json(200;"{\"ok\":true}")
      }el{
        if(str.eq(action;"close")){
          let tabid=mt json.getstr(body;"id") {ok:$v v;
            $err:e ""
          };
          let store=core.gettabstore();
          let updated=tabs.close(store;tabid);
          core.settabstore(updated);
          log.info("tab closed";"api/tabs";cid);
          <http.res.json(200;"{\"ok\":true}")
        }el{
          let url=mt json.getstr(body;"url") {ok:$v v;
            $err:e ""
          };
          let title=mt json.getstr(body;"title") {ok:$v v;
            $err:e ""
          };
          if(str.eq(url;"")){
            <http.res.err(400;"missing required field: url")
          }el{
            let store=core.gettabstore();
            let updated=tabs.open(store;url;title);
            core.settabstore(updated);
            log.info("tab opened";"api/tabs";cid);
            <http.res.json(200;"{\"ok\":true}")
          };
        };
      };
    };
  };
};

f=delete(req:i64):i64{
  let cid=log.newcorrelationid();
  let tabid=mt http.pathparam(req;"id") {ok:$v v;
    $err:e ""
  };
  if(str.eq(tabid;"")){
    <http.res.err(400;"missing tab id")
  }el{
    let store=core.gettabstore();
    let updated=tabs.close(store;tabid);
    core.settabstore(updated);
    log.info("tab closed via DELETE";"api/tabs";cid);
    <http.res.json(200;"{\"ok\":true}")
  };
};

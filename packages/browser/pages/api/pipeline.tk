m=browser.pages.api.pipeline;

i=http:std.http;
i=str:std.str;

f=post(req:i64):i64{
  let body=http.body(req);
  let text=mt body {
    $ok:v v;
    $err:e ""
  };
  <http.res(200;str.concat("{\"ok\":true,\"response\":\"Pipeline stub — text received: ";str.concat(text;"\"}")))
};

f=get(req:i64):i64{
  <http.res(200;"{\"ok\":true,\"status\":\"pipeline ready\"}")
};

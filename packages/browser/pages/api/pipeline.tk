m=browser.pages.api.pipeline;
i=http:std.http;
i=str:std.str;
i=json:std.json;
i=file:std.file;

f=settingspath():str{ <"/Users/matthew.watt/.loke/settings.json" };

f=post(req:i64):i64{
  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  let parsed=json.dec(rawbody);
  let text=json.str(parsed;"text");
  let sysprompt=json.str(parsed;"system_prompt");

  let entities=mut.0;
  let sensitivity=mut."PUBLIC";
  if(str.contains(text;"patient_name")){entities=entities+1; sensitivity="CONFIDENTIAL"}el{};
  if(str.contains(text;"medicare_number")){entities=entities+1; sensitivity="CONFIDENTIAL"}el{};
  if(str.contains(text;"dob")){entities=entities+1}el{};
  if(str.contains(text;"contact_name")){entities=entities+1}el{};
  if(str.contains(text;"@")){entities=entities+1}el{};
  if(entities>3){sensitivity="RESTRICTED"}el{};
  let entstr=str.fromint(entities);
  let piifields=str.concat(",\"entities_found\":";str.concat(entstr;str.concat(",\"sensitivity\":\"";str.concat(sensitivity;"\""))));

  let settings=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  let sparsed=json.dec(settings);
  let anthropickey=json.str(sparsed;"anthropic_api_key");
  let hasanthropic=str.len(anthropickey)>20;

  if(hasanthropic){
    let abody=str.concat("{\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":4096,\"system\":";str.concat(json.enc(sysprompt);str.concat(",\"messages\":[{\"role\":\"user\",\"content\":";str.concat(json.enc(text);"}]}"))));
    let headers=str.concat("{\"x-api-key\":\"";str.concat(anthropickey;"\",\"anthropic-version\":\"2023-06-01\",\"content-type\":\"application/json\"}"));
    let aresp=http.postheaders("https://api.anthropic.com/v1/messages";abody;headers);
    <http.res(200;str.concat("{\"ok\":true,\"anthropic_raw\":";str.concat(aresp;str.concat(",\"model\":\"claude-sonnet-4-20250514\",\"provider\":\"anthropic\"";str.concat(piifields;"}")))))
  }el{
    let payload=str.concat("{\"model\":\"qwen2.5:3b\",\"prompt\":";str.concat(json.enc(text);",\"stream\":false}"));
    let ollamaresp=http.posturl("http://127.0.0.1:11434/api/generate";payload);
    let ollamaparsed=json.dec(ollamaresp);
    let response=json.str(ollamaparsed;"response");
    <http.res(200;str.concat("{\"ok\":true,\"response\":";str.concat(json.enc(response);str.concat(",\"model\":\"qwen2.5:3b\",\"provider\":\"ollama\"";str.concat(piifields;"}")))))
  }
};

f=get(req:i64):i64{ <http.res(200;"{\"ok\":true,\"status\":\"pipeline ready\"}") };

m=browser.pages.api.pipeline;




i=http:std.http;
i=json:std.json;
i=str:std.str;
i=log:shared.log;
i=core:browser.extensions.core;
i=pipeline:core.privacy.pipeline;
i=router:core.router.router;
i=t:shared.types;
i=gt:core.governance.types;
i=gw:core.governance.gateway;
i=pt:core.providers.types;
i=disp:core.providers.dispatcher;


f=parsetolerance(raw:str):$latencytolerance{
  if str.eq(raw;"patient"){
    <$patient
  }else{
    if str.eq(raw;"background"){
      <$background
    }else{
      
      <$instant
    };
  };
};


f=sensitivitylabel(level:$sensitivitylevel):str{
  if level==$restricted{
    <"RESTRICTED"
  }else{
    if level==$confidential{
      <"CONFIDENTIAL"
    }else{
      if level==$internal{
        <"INTERNAL"
      }else{
        <"PUBLIC"
      };
    };
  };
};

f=post(req:$http.req):$http.res{
  let cid=log.newcorrelationid();
  log.info("pipeline request received";"api/pipeline";cid);

  
  let body=req.body;
  let text=json.getstr(body;mt "text") {
    $ok:v v;
    $err: ""
  };
  let systemprompt=json.getstr(body;mt "system_prompt") {
    $ok:v v;
    $err: ""
  };
  let toleranceraw=json.getstr(body;mt "tolerance") {
    $ok:v v;
    $err: "instant"
  };
  let mode=json.getstr(body;mt "mode") {
    $ok:v v;
    $err: "chat"
  };
  let apikeyanthropic=json.getstr(body;mt "api_key_anthropic") {
    $ok:v v;
    $err: ""
  };
  let apikeyopenai=json.getstr(body;mt "api_key_openai") {
    $ok:v v;
    $err: ""
  };

  
  if str.eq(apikeyanthropic;""){
    ()
  }else{
    core.setapikey("anthropic";apikeyanthropic)
  };
  if str.eq(apikeyopenai;""){
    ()
  }else{
    core.setapikey("openai";apikeyopenai)
  };

  
  if str.eq(text;""){
    log.warn("pipeline request missing text field";"api/pipeline";cid);
    <http.res.err(400;"missing required field: text")
  }else{
    let toleranceval=parsetolerance(toleranceraw);

    
    let gwreq=gt.gatewayrequest{
      requestid:cid;
      usecaseid:"chat-completion";
      text:text;
      modelid:"pending";
      provider:t.provider.$ollama;
      sensitivity:t.sensitivitylevel.$public;
      estimatedcost:0.0;
      correlationid:cid
    };
    let gwdecision=gw.submit(core.getgateway();mt gwreq) {
      $ok:v v;
      $err:e{
        log.error("governance gateway error";"api/pipeline";cid);
        <http.res.err(403;"governance gateway error")
      };
    };
    if gwdecision.blocked{
      log.warn("governance gateway blocked request";"api/pipeline";cid);
      <http.res.err(403;gwdecision.reason)
    }else{

      
      let run=pipeline.run(text;systemprompt;core.getpipelineconfig());

      
      let routing=router.route(
        core.getrouter();
        run.result.anonymised;
        run.result.sensitivity;
        run.totalentities;
        toleranceval;
        cid
      mt ) {
        $ok:v v;
        $err:e{
          log.error("router failed";"api/pipeline";cid);
          <http.res.err(500;"router error")
        };
      };

      
      let completionreq=pt.completionrequest{
        modelid:routing.model.id;
        messages:@(pt.usermsg(run.result.anonymised));
        systemprompt:run.finalsystemprompt;
        maxtokens:4096;
        temperature:0.7;
        stream:false
      };

      
      let response=disp.dispatch(core.getdispatcher();completionreq;mt routing.model.provider) {
        $ok:v v;
        $err:e{
          log.error("dispatch failed";"api/pipeline";cid);
          <http.res.err(500;"dispatch error")
        };
      };

      let sensitivitystr=sensitivitylabel(run.result.sensitivity);
      let entitycountstr=str.fromu32(run.totalentities);
      let modelid=routing.model.id;
      let providerstr=json.enc(routing.model.provider);
      let tokensinstr=str.fromu32(response.tokensin);
      let tokensoutstr=str.fromu32(response.tokensout);
      let coststr=str.fromf64(response.costusd);

      
      let respbody=str.concat("{";
        str.concat("\"ok\":true,";
        str.concat("\"response\":";
        str.concat(json.encstr(response.content);
        str.concat(",\"anonymised\":";
        str.concat(json.encstr(run.result.anonymised);
        str.concat(",\"original\":";
        str.concat(json.encstr(run.result.original);
        str.concat(",\"sensitivity\":";
        str.concat(json.encstr(sensitivitystr);
        str.concat(",\"model_id\":";
        str.concat(json.encstr(modelid);
        str.concat(",\"provider\":";
        str.concat(providerstr;
        str.concat(",\"entities_found\":";
        str.concat(entitycountstr;
        str.concat(",\"request_id\":";
        str.concat(json.encstr(run.requestid);
        str.concat(",\"tokens_in\":";
        str.concat(tokensinstr;
        str.concat(",\"tokens_out\":";
        str.concat(tokensoutstr;
        str.concat(",\"cost_usd\":";
        str.concat(coststr;
        "}"))))))))))))))))))));

      log.info("pipeline request complete";"api/pipeline";cid);
      <http.res.json(200;respbody)
    };
  };
};

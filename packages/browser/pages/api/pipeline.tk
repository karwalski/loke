m=browser.pages.api.pipeline;
i=http:std.http;
i=str:std.str;
i=json:std.json;

f=post(req:i64):i64{
  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  let parsed=json.dec(rawbody);
  let text=json.str(parsed;"text");
  let payload=str.concat("{\"model\":\"qwen2.5:3b\",\"prompt\":";str.concat(json.enc(text);",\"stream\":false}"));
  let ollamaresp=http.posturl("http://127.0.0.1:11434/api/generate";payload);
  let ollamaparsed=json.dec(ollamaresp);
  let response=json.str(ollamaparsed;"response");
  <http.res(200;str.concat("{\"ok\":true,\"response\":";str.concat(json.enc(response);"}")))
};

f=get(req:i64):i64{ <http.res(200;"{\"ok\":true,\"status\":\"pipeline ready\"}") };

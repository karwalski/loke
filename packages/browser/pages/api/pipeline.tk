m=page.api.pipeline;
i=http:std.http;
i=str:std.str;
i=json:std.json;
i=jx:shared.jsonobj;
i=file:std.file;
i=std:std;
i=log:shared.log;
i=t:shared.types;
i=pipe:core.privacy.pipeline;
i=sp:core.privacy.systemprompt;
i=ph:core.privacy.placeholder;
i=ks:core.governance.killswitch;
i=policy:core.governance.policy;
i=audit:core.storage.audit;
i=dbmod:core.storage.db;
i=settings:core.storage.settings;
i=rtr:core.router.router;
i=cache:core.optimiser.cache;
i=budget:core.optimiser.budget;
i=bt:core.optimiser.budgettypes;
i=inf:core.models.infer;
i=pt:core.providers.types;
i=kc:core.storage.keychain;
i=ollama:core.models.ollama;
i=org:shared.origin;
i=mc:core.metrics.collector;
i=tr:core.governance.trace;
i=ptypes:core.privacy.pipelinetypes;
i=dl:core.audit.disclosure;
i=ag:core.governance.approvalgate;
i=xport:core.providers.transport;
i=nd:core.nocustody.dispatch;
i=ns:core.nocustody.session;
i=popt:core.optimiser.prompt;

(* NC1.9 — this handler is why that story existed, and this is the fix.

   What it used to do: call a detection sidecar on port 11435, and if the sidecar was
   down, fall back to five hardcoded substring checks —

     if(str.contains(text;"patient_name")){entities=entities+1}
     if(str.contains(text;"medicare_number")){entities=entities+1}
     if(str.contains(text;"dob")){…}  if(str.contains(text;"contact_name")){…}
     if(str.contains(text;"@")){…}

   — and then forward the text to Anthropic regardless. A request carrying a real
   Medicare number, a real name and a real date of birth, none of which contain those
   literal strings, was sent to a provider reported as entities_found:0,
   sensitivity:"PUBLIC". It never called core.privacy.pipeline at all, so none of the
   regex, NER or Presidio layers ran on this path, and the privacy review the UI showed
   the user was computed from substring matching.

   It now goes through pipe.runchecked, which refuses when no detection layer scanned
   the text, and forwards the pipeline's own anonymised output. There is no fallback
   path: "the detector is unavailable" returns 503, because the alternative is
   forwarding unscanned text, and that is the thing this endpoint must never do. *)

(* str.concat, not interpolation. A string returned by std.homedir() is TRUNCATED when
   interpolated — "\(std.homedir())/x" yields 12 characters where str.concat yields the
   correct 21 — so every path built that way pointed at a directory that does not
   exist, and db.open failed on it. Interpolating a local or a parameter is fine; it is
   specifically the value this stdlib call returns. Filed as T-21. *)
f=settingspath():str{ <str.concat(std.homedir();"/.loke/settings.json") };

(* F3b.1. core.privacy.pipeline.served: the same layers page.api.health reports on. *)
f=pipelineconfig():$pipelineconfig{
  <pipe.served()
};

f=refused(reason:str):i64{
  log.error("pipeline endpoint refused a request: \(reason)";"api.pipeline";"");
  <http.res(503;"{\"ok\":false,\"error\":\(jx.escape(reason)),\"refused\":true}")
};

(* X4.7. The keychain is where /api/settings PUTS a key: it calls kc.setapikey and then
   removes the key from settings.json. This file read ONLY settings.json. Its keychain
   import was deleted in d14e0bd along with three others, and GA1.10 restored the other
   three and not this one. So a key saved through the settings screen was invisible to
   the request path, and every cloud route was refused as "no anthropic_api_key is
   configured". settings.json is kept as the fallback, the migration path
   settings.keyfordisplay also reads.

   The keychain read happens here and only when a cloud route has been chosen, which is
   the one place a secret is needed. See core.storage.keychain on why a read anywhere
   more general can block on an authorisation dialog. *)
f=resolvekey(fromkeychain:str;settingsjson:str;field:str):str{
  if(str.len(fromkeychain)>0){
    <fromkeychain
  }el{
    (* json.str answers a NULL string, not "", for a field that is absent. Normalised
       here so that no caller holds a null key. *)
    let fromjson=json.str(json.dec(settingsjson);field);
    if(str.len(fromjson)>0){ <fromjson }el{ <"" }
  }
};

f=settingsjson():str{
  <mt file.read(settingspath()) {$ok:v v; $err:e "{}"}
};

f=anthropickey():str{
  <resolvekey(kc.getapikey("anthropic");settingsjson();"anthropic_api_key")
};

f=openaikey():str{
  <resolvekey(kc.getapikey("openai");settingsjson();"openai_api_key")
};

f=lokehome():str{
  <str.concat(std.homedir();"/.loke")
};

f=privacyfields(run:$pipelinerun):str{
  let res:$piidetectionresult=run.result;
  <",\"entities_found\":\(run.totalentities),\"sensitivity\":\(jx.escape(t.senslabel(res.sensitivity))),\"layers_completed\":\(run.layerscompleted),\"layers_degraded\":\(run.layersdegraded),\"request_id\":\(jx.escape(run.requestid))"
};

(* GA1.10 — restoration, policy and audit, recovered from 2b8942e.

   These three were implemented, committed, and then silently deleted: 09b0a67, a
   mechanical tplrenderfile sweep, cut this file from 240 lines to 79, kept the imports
   and removed every call. Its message does not mention the file and it was the only one
   of 24 to shrink. So GA1.2/GA1.4/GA1.8 were never "unwritten" — they were lost, and
   2b8942e is the reference rather than prose.

   Recovered as intent, not as code: the lost version carried four defect classes that are
   now known and must not come back.

     - sensitivitylabel and risktierstr had a BARE trailing `mt` as their whole body, so
       they discarded it and returned garbage (T-19). Everything here uses `<mt`.
     - parsetolerance returned bare `$patient`/`$instant` variants, which crash in a value
       position (T-13). Sums are constructed.
     - buildplaceholdermap discarded ph.addentry's return, looped `if(i>count)` one past
       the end, and used str.arrayget, which erases the element type. ph.mapfromentities
       replaces it.
     - datadir() hardcoded an absolute path under the original developer's home
       directory (X8.5). std.homedir() via str.concat now. *)
f=openstore():i64{
  (* A sentinel, not a result. `mt` on an X!$lokeerr takes the first arm whatever the
     value is (T-18), so a failed open returned as $err would read as a live handle. 0
     means "no store", and every caller checks it with an `if`. It answered the $store
     itself, read as an i64; toke 3.1.0 refuses that (E4031), and 1 is what the other pages
     answer (F10.39). *)
  <mt dbmod.openstore(str.concat(std.homedir();"/.loke")) {
    $ok:s 1;
    $err:e 0
  }
};

f=risklabel(tier:$risktier):str{
  <mt tier {
    $low:v "low";
    $medium:v "medium";
    $high:v "high";
    $critical:v "critical"
  }
};

f=isdeny(d:$policydecision):bool{
  <mt d {
    $allow:m false;
    $allowwithwarning:m false;
    $requireapproval:m false;
    $deny:m true
  }
};

(* GA5.26. `$requireapproval` is returned by core.governance.policy for exactly one input —
   HIGH risk over RESTRICTED data — which is the most sensitive combination this product
   classifies, and until now NOTHING anywhere reacted to it. `isdeny` answers false for it,
   correctly, and the request was then forwarded with no log line, no audit distinction and
   no approval: a governance control that produced a decision nobody read.

   The exposure is bounded and it is worth being precise about why, because overstating it
   would be its own defect. RESTRICTED data cannot reach a cloud provider — the check
   thirty lines below refuses a cloud route for it, and core.router.router refuses to return
   one — so what proceeded unapproved was LOCAL processing of high-risk restricted data. That
   was a control doing nothing, not a disclosure.

   Done 2026-09-27: the request is now HELD. `post` refuses it with 409 and an approval id
   (heldforapproval), the user approves that id through /api/approve on the /approve page,
   and the same request re-submitted with the id proceeds exactly once. A forged, reused,
   expired, declined or mismatched id is refused (approvalrefused). The gate is
   core.governance.approvalgate; what it stores, and why it stores no text, is explained
   there. *)
f=isrequireapproval(d:$policydecision):bool{
  <mt d {
    $allow:m false;
    $allowwithwarning:m false;
    $requireapproval:m true;
    $deny:m false
  }
};

f=policymessage(d:$policydecision):str{
  <mt d {
    $allow:m "";
    $allowwithwarning:m m;
    $requireapproval:m m;
    $deny:m m
  }
};

(* GA1.8. classifyrisk takes its cost as an f64 PARAMETER. 0.0 is passed. It was passed because
   the real estimate needed core.providers.*.calccost, whose f64 return was corrupted across a
   module boundary (T-20). toke 3.1.0 fixed that (LS1.1h), so the remaining work is wiring an
   estimate in before the request is routed, which is LS1.1y. Recorded rather than guessed at. *)
f=decide(run:$pipelinerun):$policydecision{
  let res:$piidetectionresult=run.result;
  let tier=policy.classifyrisk(res.sensitivity;$risktier{$low:0};0.0);
  <policy.evaluate(tier;res.sensitivity;"";"browser-chat")
};

f=risktierof(run:$pipelinerun):$risktier{
  let res:$piidetectionresult=run.result;
  <policy.classifyrisk(res.sensitivity;$risktier{$low:0};0.0)
};

(* GA1.4. insertevent, not logevent: logevent wraps a correctly-discriminated stdlib
   result in $ok/$err of a user sum, and a caller matching THAT always takes the first arm
   (T-18) — so a failed insert would be read as a success and the hash chain would attest
   to a history with a hole in it. insertevent returns a plain bool. *)
(* GA5.19 - eventtype is a PARAMETER, not the constant "llm_request" it used to be.
   Every outcome was written under one event type: a completed request, a provider that
   returned 502, a route this endpoint refuses, a budget stop and a policy deny were all
   indistinguishable in the trail. So no error rate was derivable, and the scorecard had to
   render NOT RECORDED rather than state 0% - which would have claimed no request has ever
   failed. The five values are eventtypes() below, and two of them are the names
   core.governance.report was already querying for and never finding. *)
f=recordevent(store:i64;run:$pipelinerun;eventtype:str;provider:str;modelid:str;tokensin:i64;tokensout:i64;durationms:i64;decision:$policydecision):bool{
  <recordeventwith(store;run;eventtype;provider;modelid;tokensin;tokensout;durationms;decision;approvaloutcome(decision))
};

f=senslabelof(res:$piidetectionresult):str{
  <t.senslabel(res.sensitivity)
};

f=auditeventfor(run:$pipelinerun;eventtype:str;provider:str;modelid:str;tokensin:i64;tokensout:i64;durationms:i64):$auditevent{
  <$auditevent{
    eventtype:eventtype;
    usecase:"browser-chat";
    modelid:modelid;
    provider:provider;
    sensitivity:senslabelof(run.result);
    risktier:risklabel(risktierof(run));
    tokensin:tokensin as u32;
    tokensout:tokensout as u32;
    costusd:0.0;
    durationms:durationms as u32;
    correlationid:run.requestid
  }
};

f=recordeventwith(store:i64;run:$pipelinerun;eventtype:str;provider:str;modelid:str;tokensin:i64;tokensout:i64;durationms:i64;decision:$policydecision;approval:str):bool{
  if(store==0){
    <false
  }el{
    <tracedafter(store;run;eventtype;provider;modelid;durationms;decision;approval;audit.insertevent(store;auditeventfor(run;eventtype;provider;modelid;tokensin;tokensout;durationms)))
  }
};

(* The decision trace for an audited outcome, whichever way its audit row was written. *)
f=tracedafter(store:i64;run:$pipelinerun;eventtype:str;provider:str;modelid:str;durationms:i64;decision:$policydecision;approval:str;ok:bool):bool{
  if(store==0){
    <false
  }el{
    (* GA5.5 - every audited outcome also persists its decision trace. The kill switch was
       read as disengaged at the top of `post`, because an engaged one returns before any
       event is recorded; killswitchtrace records that case itself. *)
    let traced=persisttrace(store;run;eventtype;provider;modelid;durationms;decisionlabel(decision);approval;"disengaged");
    if(traced){}el{
      log.warn("decision trace was not persisted for this request";"api.pipeline";run.requestid)
    };
    <ok
  }
};

(* ── GA5.5: the decision trace ────────────────────────────────────────────────────
   core.governance.trace had seventeen fields and no caller. These build one per audited
   outcome from what this endpoint already knows, and persist it through trace.persist,
   which stores the decision and never the text (see the comment there). *)
f=decisionlabel(d:$policydecision):str{
  <mt d {
    $allow:m "allow";
    $allowwithwarning:m "allow_with_warning";
    $requireapproval:m "require_approval";
    $deny:m "deny"
  }
};

(* GA5.26. A require-approval decision reaches `forward`, and so every recordevent below it,
   only after ag.consume has spent a valid approval for it, so on those paths it IS approved.
   The two paths where it is not, held and refused, write their own outcome through
   recordeventwith and never call this. *)
f=approvaloutcome(d:$policydecision):str{
  <mt d {
    $allow:m "not_required";
    $allowwithwarning:m "not_required";
    $requireapproval:m "approved";
    $deny:m "not_applicable"
  }
};

f=stagelabel(st:$pipelinestage):str{
  <mt st {
    $regexscan:v "regex";
    $nerscan:v "ner";
    $presidioscan:v "presidio";
    $dedup:v "dedup";
    $anonymise:v "anonymise";
    $guardianinject:v "guardian";
    $privacyfilterscan:v "privacy_filter"
  }
};

f=isdetectionstage(label:str):bool{
  if(str.eq(label;"regex")){ <true }el{};
  if(str.eq(label;"ner")){ <true }el{};
  if(str.eq(label;"presidio")){ <true }el{};
  <str.eq(label;"privacy_filter")
};

(* "scanned=regex;skipped=ner,presidio". A detection stage that ran is scanned, and one that
   was skipped (sidecar down, or disabled) is skipped. Assessors need this: "no entities" means
   something different after one layer than after three. *)
f=detectionlayers(run:$pipelinerun):str{
  let scanned=mut.@();
  let skipped=mut.@();
  lp(let i=0;i<run.stages.len;i=i+1){
    let sr:$stageresult=run.stages.get(i);
    let label=stagelabel(sr.stage);
    if(isdetectionstage(label)){
      if(sr.skipped){ skipped=skipped.push(label) }el{ scanned=scanned.push(label) }
    }el{}
  };
  <str.concat("scanned=";str.concat(str.join(",";scanned);str.concat(";skipped=";str.join(",";skipped))))
};

f=containsstr(xs:@str;x:str):bool{
  let found=mut.false;
  lp(let i=0;i<xs.len;i=i+1){
    if(str.eq(xs.get(i);x)){ found=true }el{}
  };
  <found
};

(* Types and counts, in first-seen order: "email:1,credit_card:2". Never a value. *)
f=entitysummary(run:$pipelinerun):str{
  let res:$piidetectionresult=run.result;
  let types=mut.@();
  lp(let i=0;i<res.entities.len;i=i+1){
    let e:$piientity=res.entities.get(i);
    if(containsstr(types;e.entitytype)){}el{ types=types.push(e.entitytype) }
  };
  if(types.len==0){ <"none" }el{};
  let parts=mut.@();
  lp(let j=0;j<types.len;j=j+1){
    let ty:str=types.get(j);
    let n=mut.0;
    lp(let k=0;k<res.entities.len;k=k+1){
      let e2:$piientity=res.entities.get(k);
      if(str.eq(e2.entitytype;ty)){ n=n+1 }el{}
    };
    let ns:str=str.fromint(n);
    parts=parts.push(str.concat(ty;str.concat(":";ns)))
  };
  <str.join(",";parts)
};

f=persisttrace(store:i64;run:$pipelinerun;outcome:str;provider:str;modelid:str;durationms:i64;policylabel:str;approval:str;killswitch:str):bool{
  if(store==0){ <false }el{};
  (* The original input is NOT put in the trace, even in memory: "" is passed where newtrace
     takes it, so no later change to persist can store it by accident. *)
  let t0=tr.newtrace(run.requestid;run.requestid;"");
  let t1=mut.t0;
  if(run.totalentities>0 as u32){ t1=tr.recordpii(t0;entitysummary(run)) }el{};
  let t2=tr.recordpolicy(t1;policylabel;risklabel(risktierof(run)));
  let t3=tr.recordrouting(t2;modelid;provider);
  let t4=tr.complete(t3;durationms as u32);
  <tr.persist(t4;$assessorfields{outcome:outcome;detectionlayers:detectionlayers(run);approvaloutcome:approval;killswitchstate:killswitch})
};

(* The two refusals that happen before a policy decision exists. Neither was recorded
   anywhere before GA5.5, and both are exactly what an assessor asks about. *)
f=killswitchtrace(store:i64):bool{
  if(store==0){ <false }el{};
  let rid:str=str.randhex(16);
  let t0=tr.newtrace(rid;rid;"");
  let t1=tr.recordpolicy(t0;"not_evaluated";"unknown");
  <tr.persist(t1;$assessorfields{outcome:"kill_switch_refused";detectionlayers:"not_scanned";approvaloutcome:"not_applicable";killswitchstate:"engaged"})
};

f=privacyrefusedtrace(store:i64;run:$pipelinerun;durationms:i64):bool{
  <persisttrace(store;run;"privacy_refused";"none";"none";durationms;"not_evaluated";"not_applicable";"disengaged")
};


(* DA1.3 - one metrics_raw row per dispatch, written by core.metrics.collector.

   Called from exactly two places, `completed` and `providerfailed`, which are the two ends a
   request handed to a provider can reach. A cache hit, a budget stop, a policy deny and a
   refused route are NOT dispatches - nothing left the process - so they write no row, as the
   disclosure-accounting spec requires (§2.1, C7). A failed dispatch writes one, because the
   bytes left whether or not an answer came back.

   What the row carries is what this endpoint actually knows: the request id, the model and
   provider the router chose, whether that provider is local, the provider-reported token
   counts (0 on a failure), the router's cost for them, and the entity count - every entity
   the pipeline detected was replaced by a placeholder before dispatch, so found and blocked
   are the same number here. tokens_saved and cost_saved are 0. Since GA1.5 the prompt may be
   optimised before dispatch, but nothing here counts tokens: no tokeniser is named on this
   path, and writing an estimate there would publish a saving nobody measured. What the
   optimiser did goes in savings_by_stage instead, as MEASURED octets and characters before
   and after (core.optimiser.prompt.stagesline), or why it did nothing.
   It never carries a value: no prompt, no response, no entity. *)
f=metricevent(run:$pipelinerun;provider:str;modelid:str;routedlocal:bool;cachehit:bool;tin:i64;tout:i64;cost:f64;stages:str):$metricevent{
  let ts:str=str.fromint(t.nowi64());
  let n=run.totalentities as i64;
  <$metricevent{
    requestid:run.requestid;
    timestamp:ts;
    tokensbefore:tin;
    tokensafter:tin;
    tokenssaved:0;
    tokensout:tout;
    costbeforeusd:cost;
    costafterusd:cost;
    costsavedusd:0.0;
    piientitiesfound:n;
    piientitiesblocked:n;
    routedlocal:routedlocal;
    cachehit:cachehit;
    modelid:modelid;
    providerid:provider;
    savingsbystage:stages
  }
};

f=islocalprovider(provider:str):bool{
  if(str.eq(provider;"ollama")){ <true }el{};
  <str.eq(provider;"local")
};

f=recordmetric(run:$pipelinerun;provider:str;modelid:str;tin:i64;tout:i64;cost:f64;optrec:str):bool{
  let ok=mc.insert(metricevent(run;provider;modelid;islocalprovider(provider);false;tin;tout;cost;popt.stagesline(optrec;anonymisedof(run.result))));
  if(ok){}el{
    log.warn("metrics row was not written for this dispatch";"api.pipeline";run.requestid)
  };
  <ok
};


(* GA1.2 — restoration. The user sees their own words back, not [PERSON_a3f1_1].

   The map is derived from the deduped entity list the pipeline already carries, via
   ph.mapfromentities. That is deliberate: the parallel $placeholdermap the layers used to
   build was the thing regex.rundetection threw away, and PL1.1 removed it rather than
   plumbing it through. One list, one map, derived where it is needed. *)
f=restoretext(run:$pipelinerun;text:str):str{
  let res:$piidetectionresult=run.result;
  <ph.restore(text;ph.mapfromentities(res.entities))
};


(* A failed provider call is audited too. An audit trail that records only successes
   describes a system that never has an outage, which is worse than no trail. *)
(* DA1.9 - the outcome: the disclosure row is completed and the outcome's audit row inserted
   in one transaction (core.audit.disclosure.completeaudited), then the decision trace is
   written. Returns whether the audit row was written, as recordevent does. *)
f=outcome(store:i64;run:$pipelinerun;eventtype:str;ok:bool;provider:str;modelid:str;responsebytes:i64;tin:i64;tout:i64;elapsed:i64;decision:$policydecision):bool{
  if(store==0){ <false };
  if(dl.completeaudited(run.requestid;ok;responsebytes;tin;tout;elapsed;store;auditeventfor(run;eventtype;provider;modelid;tin;tout;elapsed))){}el{
    log.warn("disclosure record was not completed with its audit row for this dispatch";"api.pipeline";run.requestid)
  };
  <tracedafter(store;run;eventtype;provider;modelid;elapsed;decision;approvaloutcome(decision);auditrowwritten(run.requestid;eventtype))
};

(* Whether the outcome's audit row exists. completeaudited's bool is the disclosure
   completion, which can be false with the audit row committed (a row already abandoned). *)
f=auditrowwritten(cid:str;eventtype:str):bool{
  <dbmod.scalari64("SELECT COUNT() AS n FROM audit_log WHERE correlation_id=? AND event_type=?";@(cid;eventtype);"n";0)>0
};

f=providerfailed(store:i64;run:$pipelinerun;provider:str;modelid:str;startms:i64;decision:$policydecision;optrec:str):i64{
  hopfailed(store;run;provider;modelid;startms;decision;optrec);
  <http.res(502;"{\"ok\":false,\"error\":\"provider request failed\"}")
};

(* A hop that was sent and did not answer. DA1.7 - its reserved disclosure row is completed
   as failed, in one transaction with the outcome's audit row (DA1.9), and its metrics row is
   written: the bytes left whether or not an answer came back. F5.3a: called once per failed
   hop, so every hop that sent has its own completed row. *)
f=hopfailed(store:i64;run:$pipelinerun;provider:str;modelid:str;startms:i64;decision:$policydecision;optrec:str):bool{
  outcome(store;run;"llm_request_failed";false;provider;modelid;0;0;0;t.nowms()-startms;decision);
  <recordmetric(run;provider;modelid;0;0;0.0;optrec)
};


(* GA1.6 — the semantic cache, and it is consulted FIRST.

   A hit must short-circuit before any work is spent encoding, routing or dispatching,
   which is why this sits above the router rather than beside it.

   Everything the cache sees is ANONYMISED. The key is the pipeline's anonymised text and
   the stored value is the provider's anonymised response — never the original and never
   the restored text — so the cache file cannot become a store of the PII the pipeline just
   removed.

   And it is only consulted for requests that carry NO entities at all. That is a
   deliberate, conservative rule, not an oversight. A cached response contains the
   placeholders of the request that produced it; serving it to a DIFFERENT request and
   restoring it with that request's placeholder map is a cross-request substitution, and the
   two failure modes are showing one user another user's value or showing a raw placeholder
   as an answer. Two anonymised prompts can sit above the 0.92 similarity threshold while
   referring to entirely different people — that is what anonymisation does to a prompt. So
   a request with entities is never served from cache and never stored in it. *)
f=cachecfg():$cacheconfig{
  <cache.defaultconfig(str.concat(lokehome();"/cache"))
};

(* nomic-embed-text must be present on disk as a GGUF before inf.load is worth calling.
   inf.load logs a warning when in-process inference is unavailable, and a machine that has
   not pulled the embedding model is in a steady state, not an incident — a warning on every
   request is the definition of crying wolf. With no model the pool is empty, inf.embed
   returns an empty vector, and cache.lookup treats that as a MISS rather than a guess. *)
f=embedpool():$inferpool{
  let pool=inf.newpool(lokehome());
  if(file.exists(inf.modelpath(pool;cache.embedmodel()))){
    <inf.load(pool;cache.embedmodel())
  }el{
    <pool
  }
};

(* F3.9b. Nor is a request with a caller system prompt: the cache is keyed on the text alone,
   so a reply given under one system prompt would be served under another. *)
f=cacheeligible(run:$pipelinerun):bool{
  <run.totalentities==0 as u32 && !sp.hascallersystem(run)
};

f=cachelookup(run:$pipelinerun;prompt:str):$cachehit{
  if(cacheeligible(run)){}el{
    <cache.nohit()
  };
  let cfg=cachecfg();
  let vstore=cache.open(cfg);
  if(vstore==0){
    <cache.nohit()
  }el{};
  let col=cache.collection(vstore);
  if(col==0){
    <cache.nohit()
  }el{};
  <cache.lookup(col;prompt;embedpool();cfg)
};

f=cachestore(run:$pipelinerun;prompt:str;response:str):bool{
  if(cacheeligible(run)){}el{
    <false
  };
  if(str.len(response)==0){
    <false
  }el{};
  let vstore=cache.open(cachecfg());
  if(vstore==0){
    <false
  }el{};
  let col=cache.collection(vstore);
  if(col==0){
    <false
  }el{};
  <cache.store(col;prompt;response;embedpool())
};

(* GA1.5 — the token and cost budget, which had zero importers before this.

   What it checks, precisely, so that nobody reads more into it than is there: the
   ACCUMULATED spend recorded against today, against core.optimiser.budget.defaultlimits.
   The estimate for the request about to be made is ZERO, because this repository has no
   tokeniser — nothing can count the tokens of a prompt before a provider does — and
   inventing an estimate would make the numbers in the audit trail fiction. So a request is
   refused when the budget is ALREADY spent, and the spend is recorded from the token counts
   the provider itself returned. That is a real limit with real numbers; it is not a
   pre-flight estimate and is not described as one.

   The counters are persisted in the settings store, keyed by the day number, because a
   manager built fresh in a request handler and thrown away at the end of it is not a budget
   — every request would start from zero. A day change resets them. *)
(* GA5.28: t.nowi64() is epoch seconds as a number. This read str.nowunix(), which returns
   the time as a STRING declared i64, so the "day" was a heap address divided by 86400. It
   differed from one allocation to the next, and a daily budget keyed on it did not
   accumulate across requests. *)
f=daynumber():i64{
  <t.nowi64()/86400
};

(* GA1.5b — every budget read and write below takes the day as a PARAMETER. The
   clock-reading forms, budgetmanager and persistbudget, are thin wrappers kept for the one
   caller that makes a single read (forward's check) and for tests.

   What it replaced: `completed` built the manager with one daynumber() and persisted with
   another. A request completing across 00:00 read day N-1 for the comparison, so it LOADED
   yesterday's usage, added itself, and wrote the sum stamped with day N — the whole of
   yesterday's spend carried into today, and a user near yesterday's limit was refused for
   the next day. accumulatebudget reads the clock once and uses that one day for both. *)
f=budgetmanager(store:i64):$budgetmanager{
  <budgetmanagerat(store;daynumber())
};

f=budgetmanagerat(store:i64;day:i64):$budgetmanager{
  let base=budget.new(budget.defaultlimits());
  if(store==0){
    <base
  }el{};
  (* getintor, not getint: getint returns i64!$lokeerr and toke takes the FIRST arm of a
     match on a result whose error side is a user sum whatever the value is (T-18). getintor
     answers with the default and cannot mislead. *)
  if(settings.getintor(store;"budget.day";0)==day){}el{
    <base
  };
  <budget.withusage(
    base;
    settings.getintor(store;"budget.tokens";0);
    settings.getintor(store;"budget.microusd";0)
  )
};

(* setint returns i64!$lokeerr, so its own report of success cannot be read (T-18). The write
   is verified by READING IT BACK, which is the only honest confirmation available here: a
   budget that silently fails to persist is a limit that does not exist, and the caller is
   told so rather than assuming. *)
f=persistbudget(store:i64;tokens:i64;costmicrousd:i64):bool{
  <persistbudgetat(store;tokens;costmicrousd;daynumber())
};

f=persistbudgetat(store:i64;tokens:i64;costmicrousd:i64;day:i64):bool{
  if(store==0){
    <false
  }el{};
  settings.setint(store;"budget.day";day;"budget");
  settings.setint(store;"budget.tokens";tokens;"budget");
  settings.setint(store;"budget.microusd";costmicrousd;"budget");
  <settings.getintor(store;"budget.tokens";0-1)==tokens
};

(* Load, add and persist against ONE day, supplied by the caller. *)
f=accumulatebudget(store:i64;tokens:i64;cost:f64;day:i64):bool{
  let bm:$budgetmanager=budgetmanagerat(store;day);
  let spent:$budgetmanager=budget.record(bm;tokens as u32;cost);
  <persistbudgetat(store;budget.rowtokens(spent;0);budget.rowcostmicrousd(spent;0);day)
};

(* GA1.7 — the provider is chosen by core.router.router, not by the length of an API key.

   What this replaced: `if(str.len(anthropickey())>20)` sent the request to Anthropic when a
   key happened to be configured and to a hardcoded qwen2.5:3b otherwise. Sensitivity played
   no part in it, so a RESTRICTED request on a machine with an Anthropic key set went to
   Anthropic. Both model ids were hardcoded and neither matched anything in
   core.models.registry.

   It waited for LS1.1j because selector.select and router.route return results whose error
   side is a user-declared sum, and toke takes the FIRST arm of such a match whatever the
   value is (T-18) — so a failed selection read as a success would have named a garbage
   provider. Worse than misleading, in fact: routerequest's predecessor segfaulted on every
   call. routerequest and isrouted are the plain forms.

   WHY THIS DOES NOT CALL core.providers.dispatcher, which is the obvious thing to do and
   which the trydispatch* family was converted for. Measured this session, with probes:

     json.enc(@$chatmessage)      ->  "[4350999488]"    a POINTER, not the messages
     json.enc($jsonobj{model:"qwen2.5:7b"; ... })  ->  a string containing neither
                                   "qwen2.5:7b" nor "messages" nor the user's content

   $jsonobj is declared in no module in this repository, and json.enc takes a str. So the
   request bodies in core.providers.anthropic.completeplain and openai.completeplain carry
   no model and no messages, and anthropic additionally passes its headers as an
   @$httpheader where http.postheaders wants a JSON string — so the API key never reaches the
   request either. Those three defects are reported, not fixed here: they are in
   packages/core/src/providers, they are not this story, and routing a working endpoint
   through them would replace a request that works with one that cannot. (F5.11, 2026-09-27:
   the bodies are pt.anthropicbody and pt.openaibody now, the headers are a JSON string, and
   both providers and toanthropic below send through core.providers.transport. Neither
   request had in fact worked: the call they shared sent nothing, T-48.)

   So the ROUTING is what changed, which is the whole of GA1.7, and the request bodies stay
   the hand-built ones that are known to work — now with the model id and the destination
   coming from the routing decision rather than from a hardcoded literal. *)
(* F5.3: the strategy comes from the settings store (routing.strategy); unset, or with
   no store, this is the routing it always was. *)
f=routerfor(store:i64):$router{
  <rtr.new(rtr.configfromsettings(store;"http://127.0.0.1:11434"))
};

(* The $completionrequest this endpoint WOULD hand to core.providers.dispatcher, and the one
   place the anonymised text is put into a provider request shape. It is not called yet, and
   the comment above says why: the provider modules' own request bodies carry neither the
   model nor the messages, measured, so routing through them would replace a request that
   works with one that cannot. When those three defects are fixed this is the shape that
   replaces anthropichop and ollamahop, and tests/integration/test_pipeline_api.tk already
   asserts the property that matters about it — that the ORIGINAL text is not reachable
   through it, only the anonymised text. *)
f=completionfor(modelid:str;anonymised:str;sysprompt:str):$completionrequest{
  <$completionrequest{
    modelid:modelid;
    messages:@(pt.usermsg(anonymised));
    systemprompt:sysprompt;
    maxtokens:4096 as u32;
    temperature:0.0;
    stream:false
  }
};

f=providerlabel(p:$provider):str{
  <mt p {
    $anthropic:v "anthropic";
    $openai:v "openai";
    $google:v "google";
    $mistral:v "mistral";
    $openrouter:v "openrouter";
    $ollama:v "ollama";
    $local:v "local"
  }
};

(* Anthropic returns {"content":[{"type":"text","text":...}],"usage":{...}}.

   json.arr is the TYPED accessor and returns a stdlib result, which discriminates correctly
   — provided $ok is written FIRST. A stdlib result's match arms bind BY POSITION, not by
   label: measured this session, `mt json.dec(x) { $jsonerr:e 2; $ok:o 1 }` returns the OK
   arm for invalid JSON and the ERR arm for valid. Every match below puts $ok first. *)
f=anthropictext(raw:str):str{
  let obj=json.dec(raw);
  <mt json.arr(obj;"content") {
    $ok:parts firstpartext(parts);
    $err:e ""
  }
};

f=firstpartext(parts:@$json):str{
  if(parts.len==0){
    <""
  }el{
    let first=parts.get(0);
    <jx.strvalue(first;"text";"")
  }
};

f=usagetokens(raw:str;field:str):i64{
  let obj=json.dec(raw);
  <mt json.i64(obj;field) {
    $ok:n n;
    $err:e 0
  }
};

(* The cost of THIS request, from the cost table core.router.router attached to the decision.
   costper1kinput and costper1koutput are f64 FIELDS of the returned $modelspec, so these are
   the router's own figures rather than a second copy of them. A local model's fields are 0.0, so
   a local request costs nothing, which is the point of routing to one. *)
f=requestcost(spec:$modelspec;tokensin:i64;tokensout:i64):f64{
  <(((tokensin as f64)/1000.0)*spec.costper1kinput)+(((tokensout as f64)/1000.0)*spec.costper1koutput)
};

f=refusedroute(reason:str;piifields:str):i64{
  <http.res(503;refusedroutejson(reason;piifields))
};

f=refusedroutejson(reason:str;piifields:str):str{
  log.warn(str.concat("pipeline: no model could be routed to — ";reason);"api.pipeline";"");
  <"{\"ok\":false,\"error\":\(jx.escape(reason)),\"routed\":false\(piifields)}"
};

f=refusedbudget(reason:str;piifields:str):i64{
  log.warn(str.concat("pipeline: refused, budget exhausted — ";reason);"api.pipeline";"");
  <http.res(429;"{\"ok\":false,\"error\":\(jx.escape(reason)),\"budget_exceeded\":true\(piifields)}")
};

f=cachedreply(run:$pipelinerun;hit:$cachehit;piifields:str):i64{
  log.info("pipeline: served from the semantic cache";"api.pipeline";run.requestid);
  (* DA1.6 - a hit is not a dispatch and writes no disclosure record, but it IS a request the
     savings ledger has to count, or the hit rate is 0% by construction. provider "cache",
     no model, no tokens: nothing was sent and nothing was estimated. *)
  if(mc.insert(metricevent(run;"cache";"";true;true;0;0;0.0;""))){}el{
    log.warn("metrics row was not written for this cache hit";"api.pipeline";run.requestid)
  };
  <http.res(200;"{\"ok\":true,\"response\":\(jx.escape(restoretext(run;hit.response))),\"cached\":true,\"cache_age_seconds\":\(hit.ageseconds),\"audited\":false\(piifields)}")
};

(* One place for everything that happens AFTER a provider has answered: the cache is written
   with the anonymised response, the budget is accumulated and persisted, the audit row is
   inserted, and only then is the text restored for the user. *)
f=completed(store:i64;run:$pipelinerun;route:$routingdecision;anonresponse:str;tin:i64;tout:i64;piifields:str;startms:i64;decision:$policydecision;rawbytes:i64;optrec:str):i64{
  <http.res(200;completedbody(store;run;route;anonresponse;tin;tout;piifields;startms;decision;rawbytes;optrec))
};

(* F5.3a. completed's body, for the chain walk, which answers a status and a body. *)
f=completedbody(store:i64;run:$pipelinerun;route:$routingdecision;anonresponse:str;tin:i64;tout:i64;piifields:str;startms:i64;decision:$policydecision;rawbytes:i64;optrec:str):str{
  let spec:$modelspec=route.model;
  let provstr=providerlabel(spec.provider);
  let elapsed=t.nowms()-startms;
  let res:$piidetectionresult=run.result;

  (* Stored BEFORE restoration, so the cache holds only anonymised text. *)
  cachestore(run;res.anonymised;anonresponse);

  (* One clock read, passed in, for both the load and the write (GA1.5b). *)
  let persisted=accumulatebudget(store;tin+tout;requestcost(spec;tin;tout);daynumber());
  if(persisted){}el{
    log.warn("budget counters were not persisted, so the limit is not accumulating";"api.pipeline";run.requestid)
  };

  (* DA1.7 - the reserved disclosure row is completed with what came back, in one
     transaction with the outcome's audit row (DA1.9). *)
  let logged=outcome(store;run;"llm_request";true;provstr;spec.id;rawbytes;tin;tout;elapsed;decision);
  recordmetric(run;provstr;spec.id;tin;tout;requestcost(spec;tin;tout);optrec);
  if(logged){}el{
    log.warn("audit row was not written for this request";"api.pipeline";run.requestid)
  };

  <"{\"ok\":true,\"response\":\(jx.escape(restoretext(run;anonresponse))),\"model\":\(jx.escape(spec.id)),\"provider\":\(jx.escape(provstr)),\"routing_reason\":\(jx.escape(route.reason)),\"answered_by\":\(jx.escape(rtr.hoplabel(route))),\"tokens_in\":\(tin),\"tokens_out\":\(tout),\"cached\":false,\"audited\":\(logged)\(disclosurefield(run;spec.provider))\(piifields)}"
};

(* DA1.5 - this request's disclosure, as recorded, for the per-request view: the octets sent,
   where, and in what custody. Omitted when there is no record, rather than reported as zero. *)
f=disclosurefield(run:$pipelinerun;p:$provider):str{
  let b=dl.sentbytes(run.requestid);
  if(b<0){ <"" }el{};
  let dest=mut."cloud";
  if(pisolocal(p)){ dest="local" }el{};
  <",\"disclosure\":{\"bytes_body\":\(b),\"destination\":\"\(dest)\",\"custody\":\"redacted-data\"}"
};

f=pisolocal(p:$provider):bool{
  <mt p {
    $anthropic:v false;
    $openai:v false;
    $google:v false;
    $mistral:v false;
    $openrouter:v false;
    $ollama:v true;
    $local:v true
  }
};

(* ── DA1.7: the disclosure record ─────────────────────────────────────────────────
   Reserved immediately before the body is handed to transport, from the body itself:
   bytes_body is str.len of the exact string passed to the transport, which counts octets,
   not characters. bytes_question is the question as it appears in the body, JSON-escaped,
   less its two quotes: since GA1.5 that is the OPTIMISED anonymised text when the optimiser
   applied, because that is what was sent. Custody is redacted-data with the check not run: that is
   what this path sends, and it is passed rather than observed until NC1.2's sentinel check
   exists (spec C1-C3). The correlation id is the request id, which is also audit_log's, so
   the two rows join one-to-one. *)
(* DA1.9 - the reserve and its audit row, `llm_dispatch`, are one transaction (spec P2), so a
   dispatch cannot be recorded in disclosure_log and missing from audit_log, or the reverse.
   The decision trace is not written for this row: the trace records the outcome, once. The
   model version is what was measured before transport, or "" for unknown (see
   core.audit.disclosure). *)
f=reservedispatch(store:i64;run:$pipelinerun;provider:str;providerclass:str;modelid:str;modelversion:str;host:str;sent:str;anonymised:str;fbreason:str;fbby:str;sid:str;decision:$policydecision):bool{
  if(store==0){ <false };
  <dl.reserveaudited(auditeventfor(run;"llm_dispatch";provider;modelid;0;0;0);run.requestid;sid;providerclass;modelversion;host;str.len(sent);str.len(popt.jsonquoted(anonymised))-2;entitysummary(run);run.totalentities as i64;detectionlayers(run);"redacted-data";"not_run";fbreason;fbby;store)
};

(* "" for a missing session_id is `none`; anything else must be a valid id, and "" is the
   answer for one that is not. *)
f=sessionof(given:str):str{
  if(str.len(given)==0){ <dl.nosession() };
  if(dl.sessionidvalid(given)){ <given };
  <""
};

(* NC1.13 - a session id loke did not issue, or one that has expired, is refused before the scan,
   so nothing is sent or recorded under it. 503 when the session store could not be read. *)
f=sessionrefused(code:str):i64{
  if(str.eq(code;"ledger_unavailable")){ <http.res(503;ns.refusaljson(code)) };
  <http.res(400;ns.refusaljson(code))
};

(* The request body, built here so that a test can see exactly what is sent. Only the
   anonymised text goes into it.

   GA1.5: the text and the system prompt are quoted with popt.jsonquoted, which is
   shared.jsonobj.escape, not json.enc. json.enc escapes only the quote and the backslash
   (T-45), so every multi-line prompt was sent to
   Ollama and Anthropic with raw newlines inside a JSON string, which both reject. Found by
   the GA1.5 recorder test: a TOON-encoded prompt is always multi-line, and the recorder's
   Content-Length disagreed with the body it logged. The Ollama body below is the same. *)
f=anthropicbody(modelid:str;sysprompt:str;anonymised:str):str{
  <"{\"model\":\(json.enc(modelid)),\"max_tokens\":4096,\"system\":\(popt.jsonquoted(sysprompt)),\"messages\":[{\"role\":\"user\",\"content\":\(popt.jsonquoted(anonymised))}]}"
};

(* F5.11. The one send. This was
     `mt http.postheaders(http.client("https://api.anthropic.com/v1/messages");"";str.tobytes(abody);headers) {...}`
   and at loke's toolchain pin that call sends NOTHING: the glue reads its arguments as
   (url, body, headers, ignored), so it was handed a client handle for a URL. Measured over
   http against a recorder (T-48); every cloud-routed request through this endpoint took
   the error arm without a byte leaving the machine. core.providers.transport calls it
   URL-first, which is measured to arrive with its headers over http; https is not
   measured (see F5.11). `url` is a parameter for the recorder test only: toanthropic
   passes transport.anthropicurl(), the one production endpoint. "" means nothing came
   back. *)
f=anthropicsend(url:str;key:str;abody:str):str{
  <xport.post(url;abody;xport.anthropicheaders(key))
};

(* F5.12. Whether `id` is one of the models Ollama reports as installed. Ollama names carry a
   tag, and an untagged id means `:latest`. *)
f=isinstalled(id:str;names:@str):bool{
  let found=mut.false;
  lp(let i=0;i<names.len;i=i+1){
    let n=names.get(i);
    if(str.eq(n;id) || str.eq(n;str.concat(id;":latest"))){ found=true }el{}
  };
  <found
};

(* GA1.5: the Ollama base is a parameter so that a test can stand a recorder in for it;
   production passes ollamabase(), the one local endpoint. *)
f=ollamabase():str{
  <"http://127.0.0.1:11434"
};

f=installedmodels():@$ollamamodel{
  <installedmodelsat(ollamabase())
};

f=installedmodelsat(base:str):@$ollamamodel{
  <mt ollama.listmodels(ollama.new(base)) {$ok:v v; $err:e @()}
};

f=installednames():@str{
  <namesof(installedmodels())
};

(* DA1.9 (3) - model_version for a local dispatch: the digest Ollama reports for the model
   it will run, read before transport. "" (recorded as unknown) when the model is not listed
   or Ollama gave no digest. *)
f=digestof(id:str;models:@$ollamamodel):str{
  let d=mut."";
  lp(let i=0;i<models.len;i=i+1){
    let m:$ollamamodel=models.get(i);
    if(str.eq(m.name;id) || str.eq(m.name;str.concat(id;":latest"))){ d=m.digest }el{}
  };
  <d
};

f=namesof(models:@$ollamamodel):@str{
  let names=mut.@();
  lp(let i=0;i<models.len;i=i+1){
    let m:$ollamamodel=models.get(i);
    names=names.push(m.name)
  };
  <names
};

(* ── GA1.5: token optimisation, between the privacy filter and dispatch ─────────────
   The optimiser is handed res.anonymised and the entity list, so the only text it, or the
   LLMLingua sidecar behind it, ever sees is text the privacy filter has already anonymised.
   It runs after routing and the kill switch, which is the last point before a provider is
   called, and only on the path that sends: a cache hit or a refusal spends nothing on it.

   What it may do and what it refuses is in core.optimiser.prompt. It fails OPEN: a refused or
   failed optimisation sends the anonymised text unchanged, because optimisation is not a
   privacy control, and the reason is recorded three ways: in the reply's `optimisation`
   field, in the log line below, and in this dispatch's metrics row (savings_by_stage). The
   figures are measured octets and characters; no token count is reported. The disclosure
   record needs nothing extra: reservedispatch counts the body actually built from the text
   the optimiser chose, so bytes_body is the octets handed to transport (DA1).

   LLMLingua is off until a sidecar is configured: the settings key
   optimiser.llmlingua_url names it (a loopback URL; core.optimiser.llmlingua refuses any
   other), and optimiser.llmlingua_min_chars the length above which prose is compressed, 0
   meaning ll.shouldcompress's default of 2000 characters. TOON needs no sidecar. *)
f=llmlinguaurl(store:i64):str{
  if(store==0){ <"" }el{};
  <settings.getstror(store;"optimiser.llmlingua_url";"")
};

f=llmlinguaminchars(store:i64):i64{
  if(store==0){ <0 }el{};
  <settings.getintor(store;"optimiser.llmlingua_min_chars";0)
};

f=optimisefor(run:$pipelinerun;llurl:str;minchars:i64):str{
  let res:$piidetectionresult=run.result;
  <popt.optimise(res.anonymised;res.entities;llurl;minchars)
};

f=anonymisedof(res:$piidetectionresult):str{
  <res.anonymised
};

f=optimisationfield(run:$pipelinerun;optrec:str):str{
  <",\"optimisation\":\(popt.reportjson(optrec;anonymisedof(run.result)))"
};

(* ── F5.3a: the fallback chain on the browser request path ──────────────────────────
   forward() routes a chain (core.router.router.routechainpreferinstalled) and hands it here.
   The hops are tried in order and the first that answers is the answer, as
   core.router.fallback.dispatchchain does for `loke ask`: the same chain, the same gate
   (rtr.chainhopallowed) asked again immediately before each send. What this path adds is its
   own per-dispatch controls, applied to EVERY hop, which is why it walks the chain itself
   rather than through core.providers.dispatcher (see GA1.7 above on why it sends its own
   bodies).

   What every hop shares, and what it does not:
     - the privacy run. It happened once, in post(), before anything was routed. Every hop
       sends popt.sentof(optrec), the ANONYMISED text as optimised once here, and
       run.finalsystemprompt, the guardian over the anonymised system prompt. Never
       res.original. Restoration uses the run's one placeholder map, whichever hop answered.
     - the destination rules, per hop (hoprefusal): RESTRICTED data never goes to a cloud hop
       (rtr.chainhopallowed against the router's sensitivity, and again against the
       pipeline's own); a cloud hop after a local first choice only when fallback_to_cloud is
       on, which this path keeps off (rtr.configfromsettings).
     - the approval (GA5.26), per hop. See approvalcovers.
     - the kill switch, per hop: a provider switched off is not sent to, and the next hop is
       tried under the same rules.
     - the disclosure record, per hop that sends: reserved immediately before its transport
       and completed with its outcome, failed or answered. Each hop is its own dispatch, so it
       carries its own correlation id (hoprun): the request id for the first hop, and the
       request id with `-h<n>` for hop n, because one id is reserved once.

   The reply says what happened: `answered_by` (in completed, so only a hop that answered is
   ever named there), and hops_attempted, hops_failed and hops_refused (chainfields). *)
f=maxhops():i64{
  <3
};

(* The same run under hop i's correlation id. T-26: a struct field cannot be assigned, so it
   is rebuilt. Everything but the id is the one run: same entities, same placeholders, same
   anonymised text and system prompt. *)
f=hoprun(run:$pipelinerun;i:i64):$pipelinerun{
  if(i==0){ <run }el{};
  <$pipelinerun{
    result:run.result;
    stages:run.stages;
    totalentities:run.totalentities;
    finalsystemprompt:run.finalsystemprompt;
    requestid:str.concat(run.requestid;"-h\(i)");
    layerscompleted:run.layerscompleted;
    layersdegraded:run.layersdegraded;
    unplaced:run.unplaced;
    consensus:run.consensus;
    resolved:run.resolved
  }
};

(* GA5.26 and F5.3a. An approval is bound to the text, the decision and the fallback selection
   (approvalbinding); it records no destination, and the approval page shows none. So the
   reading taken here is the safe one: an approval covers the destination the request was
   first routed to, and nothing else. A fallback hop that would send it somewhere else, from
   this machine to a cloud provider or from one cloud provider to another, is refused rather
   than sent without an approval for that destination. A hop to the same place (another local
   model, or another model at the same provider) is the destination that was approved. A
   request that needed no approval is not limited by this. *)
f=approvalcovers(decision:$policydecision;first:$routingdecision;hop:$routingdecision):bool{
  if(isrequireapproval(decision)){}el{ <true };
  <rtr.samedestination(first;hop)
};

f=hasclient(p:$provider):bool{
  <mt p {
    $anthropic:v true;
    $openai:v false;
    $google:v false;
    $mistral:v false;
    $openrouter:v false;
    $ollama:v true;
    $local:v true
  }
};

(* Why hop i must not be sent, or "" when it may be. Checked in this order, immediately
   before the hop would send, and nothing here sends or reserves anything. *)
f=hoprefusal(store:i64;cfg:$routerconfig;chain:$fallbackchain;i:i64;run:$pipelinerun;decision:$policydecision):str{
  let hop:$routingdecision=chain.chainhops.get(i);
  let res:$piidetectionresult=run.result;
  let cloud=rtr.isclouddecision(hop);
  if(rtr.chainhopallowed(cfg;chain;i)){}el{
    if(cloud && t.senseq(chain.chainsens;t.restricted())){ <"restricted_cloud" }el{};
    <"not_permitted"
  };
  if(cloud && t.senseq(res.sensitivity;t.restricted())){ <"restricted_cloud" }el{};
  if(approvalcovers(decision;chain.chainhops.get(0);hop)){}el{ <"approval_destination" };
  let spec:$modelspec=hop.model;
  if(ks.isblocked(store;providerlabel(spec.provider);"browser-chat")){ <"kill_switch" }el{};
  if(hasclient(spec.provider)){}el{ <"no_client" };
  <""
};

(* A sender's answer that is not a provider's body: the hop was refused before transport. A
   provider body is a JSON document and never begins with this. *)
f=refusedprefix():str{
  <"loke:refused:"
};

f=isrefusal(raw:str):bool{
  <str.startswith(raw;refusedprefix())
};

(* The Anthropic hop: the body, the disclosure reservation, the send. The raw body that came
   back, "" when nothing did, or a refusal. `url` is transport.anthropicurl() in production
   and a recorder in tests; nothing a request or a setting carries reaches it. *)
f=anthropichop(store:i64;hrun:$pipelinerun;hop:$routingdecision;optrec:str;key:str;decision:$policydecision;fbreason:str;fbby:str;sid:str;url:str):str{
  let spec:$modelspec=hop.model;
  let sent=popt.sentof(optrec);
  let abody=anthropicbody(spec.id;hrun.finalsystemprompt;sent);
  if(reservedispatch(store;hrun;"anthropic";"cloud";spec.id;"";"api.anthropic.com";abody;sent;fbreason;fbby;sid;decision)){}el{
    <"\(refusedprefix())unrecorded"
  };
  <anthropicsend(url;key;abody)
};

(* F5.12. The router chooses from a static catalogue, so it can name a model Ollama does not
   have; such a hop is refused before anything is reserved or sent, and the next is tried. *)
f=ollamahop(store:i64;hrun:$pipelinerun;hop:$routingdecision;optrec:str;decision:$policydecision;fbreason:str;fbby:str;sid:str;obase:str):str{
  let spec:$modelspec=hop.model;
  let models=installedmodelsat(obase);
  let installed=namesof(models);
  if(installed.len>0 && !isinstalled(spec.id;installed)){
    <"\(refusedprefix())not_installed"
  }el{};
  let sent=popt.sentof(optrec);
  (* F3.9a. The guardian, over the caller's anonymised system prompt, as /api/generate's
     `system`. *)
  let payload="{\"model\":\(json.enc(spec.id)),\"system\":\(popt.jsonquoted(hrun.finalsystemprompt)),\"prompt\":\(popt.jsonquoted(sent)),\"stream\":false}";
  if(reservedispatch(store;hrun;"ollama";"local";spec.id;digestof(spec.id;models);str.trimprefix(obase;"http://");payload;sent;fbreason;fbby;sid;decision)){}el{
    <"\(refusedprefix())unrecorded"
  };
  <http.posturl("\(obase)/api/generate";payload)
};

f=sendhop(store:i64;hrun:$pipelinerun;hop:$routingdecision;optrec:str;key:str;decision:$policydecision;fbreason:str;fbby:str;sid:str;obase:str;aurl:str):str{
  let spec:$modelspec=hop.model;
  let prov:$provider=spec.provider;
  let none="\(refusedprefix())no_client";
  <mt prov {
    $anthropic:v anthropichop(store;hrun;hop;optrec;key;decision;fbreason;fbby;sid;aurl);
    $openai:v none;
    $google:v none;
    $mistral:v none;
    $openrouter:v none;
    $ollama:v ollamahop(store;hrun;hop;optrec;decision;fbreason;fbby;sid;obase);
    $local:v ollamahop(store;hrun;hop;optrec;decision;fbreason;fbby;sid;obase)
  }
};

(* The completion text in a provider's body, "" when there is none. A body with no text in it
   (Anthropic's error document, for one: the transport does not see the status code; or an
   empty body from a dead Ollama) is a failed hop, not a 200 with an empty answer. *)
f=replytext(p:$provider;raw:str):str{
  if(str.len(raw)==0){ <"" }el{};
  if(pisolocal(p)){
    let robj=mt json.dec(raw) { $ok:o o; $jsonerr:e jx.emptyobj() };
    <jx.strvalue(robj;"response";"")
  }el{};
  <anthropictext(raw)
};

(* Ollama's /api/generate reports prompt_eval_count and eval_count, not Anthropic's names. *)
f=replytokens(p:$provider;raw:str;input:bool):i64{
  if(pisolocal(p)){
    if(input){ <usagetokens(raw;"prompt_eval_count") }el{ <usagetokens(raw;"eval_count") }
  }el{};
  if(input){ <usagetokens(raw;"input_tokens") }el{ <usagetokens(raw;"output_tokens") }
};

f=jsonstrs(xs:@str):str{
  let out=mut."";
  lp(let i=0;i<xs.len;i=i+1){
    if(i>0){ out="\(out)," }el{};
    out="\(out)\(jx.escape(xs.get(i)))"
  };
  <"[\(out)]"
};

(* hops_attempted names every hop that was SENT, in order; hops_failed those of them that did
   not answer; hops_refused every hop not sent, with why. *)
f=chainfields(attempted:@str;failed:@str;refused:@str):str{
  <",\"hops_attempted\":\(jsonstrs(attempted)),\"hops_failed\":\(jsonstrs(failed)),\"hops_refused\":\(jsonstrs(refused))"
};

(* A hop refused before it sent is audited as the single route's refusal was. *)
f=hoprefused(store:i64;hrun:$pipelinerun;hop:$routingdecision;code:str;startms:i64;decision:$policydecision):bool{
  let spec:$modelspec=hop.model;
  let pname=providerlabel(spec.provider);
  log.warn("pipeline: fallback hop \(rtr.hoplabel(hop)) was not sent (\(code))";"api.pipeline";hrun.requestid);
  if(str.eq(code;"kill_switch")){
    <recordevent(store;hrun;"kill_switch_refused";pname;spec.id;0;0;t.nowms()-startms;decision)
  }el{};
  <recordevent(store;hrun;"llm_request_refused";pname;spec.id;0;0;t.nowms()-startms;decision)
};

(* When no hop was sent at all, the reply is the refusal of the first hop, as it was when the
   route was one decision, with the chain's fields after it. A reply here, and from walkchain,
   is the status's three digits followed by the JSON body (respond). *)
f=chainrefusal(store:i64;code:str;hop:$routingdecision;obase:str;fields:str):str{
  let spec:$modelspec=hop.model;
  let pname=providerlabel(spec.provider);
  let uc="browser-chat";
  if(str.eq(code;"kill_switch")){
    <"403{\"ok\":false,\"error\":\(jx.escape(ks.refusalmessage(store;pname;uc))),\"provider_blocked\":true,\"kill_switch_scope\":\(jx.escape(ks.blockedscope(store;pname;uc)))\(fields)}"
  }el{};
  if(str.eq(code;"not_installed")){
    let msg=str.concat("the router chose \(spec.id), which is not installed in Ollama. Installed: ";str.join(", ";namesof(installedmodelsat(obase))));
    <"503{\"ok\":false,\"error\":\(jx.escape(msg)),\"model_not_installed\":true\(fields)}"
  }el{};
  if(str.eq(code;"unrecorded")){
    <"503{\"ok\":false,\"error\":\"the disclosure record could not be written, so the request was not sent\",\"disclosure_unrecorded\":true\(fields)}"
  }el{};
  if(str.eq(code;"approval_destination")){
    <"403{\"ok\":false,\"error\":\"the approval given for this request does not cover sending it to \(pname), so nothing was sent there\",\"approval_destination_refused\":true\(fields)}"
  }el{};
  if(str.eq(code;"no_key")){
    <str.concat("503";refusedroutejson("the router selected an Anthropic model but no anthropic_api_key is configured";fields))
  }el{};
  if(str.eq(code;"no_client")){
    <str.concat("503";refusedroutejson("this endpoint has no client for provider \(pname) (model \(spec.id))";fields))
  }el{};
  if(str.eq(code;"restricted_cloud")){
    <str.concat("503";refusedroutejson("RESTRICTED data must not be sent to a cloud provider";fields))
  }el{};
  <str.concat("503";refusedroutejson("no hop of the route was permitted to be sent";fields))
};

f=respond(r:str):i64{
  let code=str.slice(r;0;3);
  let body=str.slice(r;3;str.len(r));
  if(str.eq(code;"200")){ <http.res(200;body) }el{};
  if(str.eq(code;"403")){ <http.res(403;body) }el{};
  if(str.eq(code;"502")){ <http.res(502;body) }el{};
  <http.res(503;body)
};

(* The walk. `optrec` is the optimiser's record, made once; `fields` the reply's privacy and
   optimisation fields. `akey` is the Anthropic key when the caller has one (a test), or "" to
   read it from the keychain, which happens only when an Anthropic hop is about to send. *)
f=walkchain(store:i64;run:$pipelinerun;chain:$fallbackchain;cfg:$routerconfig;optrec:str;fields:str;startms:i64;decision:$policydecision;fbreason:str;fbby:str;sid:str;obase:str;aurl:str;akey:str):str{
  let hops=chain.chainhops;
  let attempted=mut.@();
  let failed=mut.@();
  let refused=mut.@();
  let firstcode=mut."";
  let firsthop=mut.0-1;
  let key=mut.akey;
  let resp=mut."";
  let done=mut.false;
  lp(let i=0;i<hops.len && !done;i=i+1){
    let ii=i as i64;
    let hop:$routingdecision=hops.get(i);
    let spec:$modelspec=hop.model;
    let label=rtr.hoplabel(hop);
    let hrun=hoprun(run;ii);
    let code=mut.hoprefusal(store;cfg;chain;ii;run;decision);
    if(str.len(code)==0 && str.eq(providerlabel(spec.provider);"anthropic")){
      if(str.len(key)==0){ key=anthropickey() }el{};
      if(str.len(key)>20){}el{ code="no_key" }
    }el{};
    if(str.len(code)==0){
      let raw=sendhop(store;hrun;hop;optrec;key;decision;fbreason;fbby;sid;obase;aurl);
      if(isrefusal(raw)){
        code=str.trimprefix(raw;refusedprefix())
      }el{
        attempted=attempted.push(label);
        let anon=replytext(spec.provider;raw);
        if(str.len(anon)>0){
          done=true;
          resp=completedbody(store;hrun;hop;anon;replytokens(spec.provider;raw;true);replytokens(spec.provider;raw;false);str.concat(fields;chainfields(attempted;failed;refused));startms;decision;str.len(raw);optrec)
        }el{
          log.warn("pipeline: \(label) did not answer, so the next permitted hop is tried";"api.pipeline";hrun.requestid);
          hopfailed(store;hrun;providerlabel(spec.provider);spec.id;startms;decision;optrec);
          failed=failed.push(label)
        }
      }
    }el{};
    if(str.len(code)>0){
      hoprefused(store;hrun;hop;code;startms;decision);
      refused=refused.push("\(label) (\(code))");
      if(firsthop<0){
        firsthop=ii;
        firstcode=code
      }el{}
    }el{}
  };
  if(done){ <"200\(resp)" }el{};
  let all=str.concat(fields;chainfields(attempted;failed;refused));
  if(failed.len>0){
    <"502{\"ok\":false,\"error\":\"provider request failed\"\(all)}"
  }el{};
  if(firsthop<0){
    <str.concat("503";refusedroutejson("the route had no hop to send";all))
  }el{};
  <chainrefusal(store;firstcode;hops.get(firsthop);obase;all)
};

(* The production path from a routed request to a provider: forward() calls sendchainat with
   the configured sidecar, ollamabase() and transport.anthropicurl(). Tests call walkchainat
   with recorders and read the reply it builds. *)
f=walkchainat(store:i64;run:$pipelinerun;chain:$fallbackchain;cfg:$routerconfig;piifields:str;startms:i64;decision:$policydecision;fbreason:str;fbby:str;sid:str;llurl:str;minchars:i64;obase:str;aurl:str;akey:str):str{
  let optrec=optimisefor(run;llurl;minchars);
  log.info("pipeline: \(popt.stagesline(optrec;anonymisedof(run.result)))";"api.pipeline";run.requestid);
  <walkchain(store;run;chain;cfg;optrec;str.concat(piifields;optimisationfield(run;optrec));startms;decision;fbreason;fbby;sid;obase;aurl;akey)
};

f=sendchainat(store:i64;run:$pipelinerun;chain:$fallbackchain;cfg:$routerconfig;piifields:str;startms:i64;decision:$policydecision;fbreason:str;fbby:str;sid:str;llurl:str;minchars:i64;obase:str;aurl:str;akey:str):i64{
  <respond(walkchainat(store;run;chain;cfg;piifields;startms;decision;fbreason;fbby;sid;llurl;minchars;obase;aurl;akey))
};

(* A chain of one hop, judged at the run's own sensitivity, for the callers that hold a single
   route: sendoptimised and toanthropicat below. *)
f=onehop(res:$piidetectionresult;route:$routingdecision):$fallbackchain{
  <$fallbackchain{chainhops:@(route);chainsens:res.sensitivity;chainnote:route.reason}
};

f=routercfg(store:i64):$routerconfig{
  <rtr.configfromsettings(store;ollamabase())
};

(* One route, through the same walk. Tests call it with recorders. *)
f=sendoptimised(store:i64;run:$pipelinerun;route:$routingdecision;piifields:str;startms:i64;decision:$policydecision;fbreason:str;fbby:str;sid:str;llurl:str;minchars:i64;obase:str):i64{
  <sendchainat(store;run;onehop(run.result;route);routercfg(store);piifields;startms;decision;fbreason;fbby;sid;llurl;minchars;obase;xport.anthropicurl();"")
};

(* F3.9a, F3.9b. The system prompt sent is run.finalsystemprompt: the guardian over the caller's
   system prompt as core.privacy.systemprompt anonymised it. `url` and `key` are for the
   recorder test (tests/integration/test_system_prompt_disclosure.tk) only; forward() passes
   transport.anthropicurl(), and nothing a request or a setting carries reaches it. *)
f=toanthropicat(store:i64;run:$pipelinerun;route:$routingdecision;optrec:str;key:str;piifields:str;startms:i64;decision:$policydecision;fbreason:str;fbby:str;sid:str;url:str):i64{
  <respond(walkchain(store;run;onehop(run.result;route);routercfg(store);optrec;piifields;startms;decision;fbreason;fbby;sid;ollamabase();url;key))
};

(* NC1.8 - what every reply on this path says about itself. This endpoint IS the
   redact-and-forward fallback: the text is scanned, detected identifiers are replaced with
   placeholders, and the rest goes to the model as written. The residual risk is stated in the
   reply so the surface showing the answer can show it beside it, at the point of use. It names
   what redaction does not cover rather than claiming what it does. *)
f=residualrisk():str{
  <"Sent by the redact-and-forward fallback. Detected identifiers were replaced with placeholders before sending; anything the detectors did not recognise, and the rest of your text, reached the model as written."
};

f=custodyfields(fbreason:str;fbby:str):str{
  <",\"custody\":\"redacted-data\",\"fallback_reason\":\(jx.escape(fbreason)),\"fallback_selected_by\":\(jx.escape(fbby)),\"residual_risk\":\(jx.escape(residualrisk()))"
};

(* The refusal a caller gets when it did not select the fallback. It says where the primary
   path is, so a caller holding a dataset has somewhere to go. *)
f=fallbackunselected():i64{
  <http.res(400;"{\"ok\":false,\"error\":\"this endpoint is the redact-and-forward fallback and must be selected explicitly: send fallback_reason (task_requires_prose, artifact_inexpressible, user_choice or policy_directed) and fallback_selected_by (user or policy). A request that carries its dataset (headers and rows) is tried as a no-custody dispatch first, and a returned artifact runs at POST /api/artifact\",\"fallback_unselected\":true,\"no_custody\":\"/api/artifact\"}")
};

(* ── NC1.12: no-custody first ───────────────────────────────────────────────────────
   A request that carries its dataset (`headers` and `rows`, which stay on this machine) is
   first tried as a no-custody dispatch, core.nocustody.dispatch. The text sent is the
   anonymised text, the privacy scan, the policy decision and any approval having already run.
   The dispatch checks the exact body it would send against every cell of the dataset (spec C2)
   and records `no-custody` only on a pass; it reaches a local model only (T-58).

   Its correlation id is the request id with `-nc`, so that when it is refused and the
   selected fallback runs, the fallback's own record does not collide with the refusal's. A
   refusal with no fallback selected is returned as it is, marked `fallback_unselected`, so a
   caller learns why the no-custody path refused before it chooses the fallback. *)
f=nocustodyfirst(store:i64;run:$pipelinerun;rawbody:str;sysprompt:str;sid:str):str{
  let res:$piidetectionresult=run.result;
  <nd.attempt(rawbody;res.anonymised;sp.anonymisedsystem(run;sysprompt);store;nd.ollamabase();"\(run.requestid)-nc";run.requestid;sid)
};

f=nocustodyanswer(run:$pipelinerun;reply:str):i64{
  <http.res(200;nd.finish(reply;restoretext(run;nd.responseof(reply));privacyfields(run)))
};

f=nocustodyunselected(reply:str):i64{
  <http.res(nd.statusof(reply);"\(str.trimsuffix(reply;"}")),\"fallback_unselected\":true}")
};

(* Forwards the pipeline's anonymised text, never the original.

   The order is the story: cache, then budget, then route, then dispatch. A hit spends
   nothing; an exhausted budget refuses before a provider is paid; and the route is what
   decides where the text is allowed to go. *)
f=forward(store:i64;run:$pipelinerun;startms:i64;decision:$policydecision;fbreason:str;fbby:str;sid:str):i64{
  let res:$piidetectionresult=run.result;
  let piifields=str.concat(privacyfields(run);custodyfields(fbreason;fbby));

  let hit:$cachehit=cachelookup(run;res.anonymised);
  if(cache.ishit(hit)){
    <cachedreply(run;hit;piifields)
  }el{};

  (* Declared types on every intermediate whose fields are read. Without them toke raises
     E4034 "field 'reason' is declared at different offsets by more than one struct" — the
     name is ambiguous across $budgetcheck, $selectionresult and $routingdecision, and the
     diagnostic lands on the READ rather than on the binding. *)
  let bcheck:$budgetcheck=budget.check(budgetmanager(store);0 as u32;0.0);
  if(bcheck.allowed){}el{
    recordevent(store;run;"quota_exceeded";"none";"none";0;0;t.nowms()-startms;decision);
    <refusedbudget(bcheck.reason;piifields)
  };

  (* F5.3a. A fallback chain, not one decision: core.router.router.routechain's hops in the
     strategy's order, built against what Ollama has installed as the single route was. The
     route-level RESTRICTED check and the kill switch that used to sit here are applied to
     EVERY hop by walkchain, immediately before that hop would send. *)
  let router:$router=routerfor(store);
  let chain:$fallbackchain=rtr.routechainpreferinstalled(
    router;
    installednames();
    res.anonymised;
    res.sensitivity;
    run.totalentities;
    $latencytolerance{$instant:0};
    run.requestid;
    maxhops()
  );
  if(chain.chainhops.len>0){}el{
    recordevent(store;run;"llm_request_refused";"none";"none";0;0;t.nowms()-startms;decision);
    <refusedroute(chain.chainnote;piifields)
  };
  <sendchainat(store;run;chain;router.config;piifields;startms;decision;fbreason;fbby;sid;llmlinguaurl(store);llmlinguaminchars(store);ollamabase();xport.anthropicurl();"")
};

(* ── GA5.26: hold until approved ─────────────────────────────────────────────────
   The binding is computed from the text in its UNSALTED anonymised form: this run's
   placeholders are salted with its request id, which a re-submission does not share, so
   the salted form would never match. See core.governance.approvalgate on why a digest of
   the original text is not used instead. *)
f=unsaltedtext(run:$pipelinerun;text:str):str{
  <unsaltedfrom(run.result;text)
};

f=unsaltedfrom(res:$piidetectionresult;text:str):str{
  <ph.applytotext(text;ph.assignplaceholders(res.entities;""))
};

(* F3.9b. What an approval is bound to: the text, and the caller's system prompt when there is
   one, since both are scanned and both are sent. An approval given for one system prompt does
   not let another through. A request with none binds as it always did. *)
f=boundtext(text:str;sysprompt:str):str{
  if(str.len(sysprompt)==0){ <text };
  <"\(sysprompt)\n\n\(text)"
};

f=approvalbinding(run:$pipelinerun;text:str;decision:$policydecision;fbreason:str;fbby:str):str{
  <ag.binding(unsaltedtext(run;text);decisionlabel(decision);fbreason;fbby)
};

(* 409, not 403: the request is not denied, it is waiting for the user. The body carries
   what the approval page shows, entity TYPES and counts and never a value, and the id the
   re-submission must carry. Nothing was sent and no disclosure record is written. If the
   approval cannot be recorded the request is still refused: it cannot be approved, and it
   must not proceed for want of an approval. *)
f=heldforapproval(store:i64;run:$pipelinerun;decision:$policydecision;bind:str;startms:i64):i64{
  let aid=ag.create(bind;t.nowms());
  if(str.len(aid)==0){
    recordeventwith(store;run;"policy_require_approval";"none";"none";0;0;t.nowms()-startms;decision;"held_unrecorded");
    log.warn("pipeline: a request needing approval was held, and the approval could not be recorded (GA5.26)";"api.pipeline";run.requestid);
    <http.res(503;"{\"ok\":false,\"error\":\"this request needs your approval, and the approval could not be recorded, so nothing was sent\",\"approval_required\":true\(privacyfields(run))}")
  }el{};
  recordeventwith(store;run;"policy_require_approval";"none";"none";0;0;t.nowms()-startms;decision;"held_pending");
  log.info("pipeline: held for approval, high risk over restricted data (GA5.26)";"api.pipeline";run.requestid);
  <http.res(409;"{\"ok\":false,\"error\":\"this request contains restricted data and needs your approval before it is processed. Nothing has been sent.\",\"approval_required\":true,\"approval_id\":\(jx.escape(aid)),\"approval_expires_in_seconds\":\(ag.ttlms()/1000),\"approve_url\":\"/approve\",\"policy_message\":\(jx.escape(policymessage(decision))),\"entity_types\":\(jx.escape(entitysummary(run)))\(privacyfields(run))}")
};

(* An approval id was presented and did not pass. Why is read after the refusal, so it
   explains it and never makes it. The request is not re-held: a new approval is asked for
   by sending the request again without an id. *)
f=approvalrefused(store:i64;run:$pipelinerun;decision:$policydecision;aid:str;bind:str;startms:i64):i64{
  let why=ag.refusal(aid;bind;t.nowms());
  recordeventwith(store;run;"policy_require_approval";"none";"none";0;0;t.nowms()-startms;decision;"refused_\(why)");
  log.warn("pipeline: an approval was presented for a held request and refused: \(why) (GA5.26)";"api.pipeline";run.requestid);
  (* `why` is from approvalgate's closed vocabulary, so it is written into the JSON as is. *)
  <http.res(403;"{\"ok\":false,\"error\":\"the approval presented with this request was refused (\(why)), so nothing was sent. Send the request again without it to ask for a new approval.\",\"approval_required\":true,\"approval_refused\":true,\"approval_refusal\":\(json.enc(why))\(privacyfields(run))}")
};

(* If the store cannot be opened the switch cannot be read, and an unreadable kill switch
   is treated as ENGAGED, not as disengaged. The same reasoning as NC1.9: the unknown state
   is the unsafe one. The store is now opened once per request and threaded, because the
   audit trail needs the same handle. *)
f=killswitchengaged(store:i64):bool{
  if(store==0){
    <true
  }el{
    <ks.isengaged(store)
  }
};

f=post(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  (* GA5.28: t.nowms(), not str.nowunix(). str.nowunix() returns the time as a STRING, and
     its declared type is i64, so arithmetic on it is arithmetic on a heap address: every
     duration this endpoint recorded was the distance between two allocations. *)
  let startms=t.nowms();
  let store=openstore();
  (* DA1.9 - any dispatch still unanswered after five minutes is recorded as abandoned, not
     left looking in flight. *)
  if(store!=0){
    if(dl.sweepabandoned(300)<0){
      log.warn("the abandoned-dispatch sweep could not run";"api.pipeline";"")
    }el{}
  }el{};
  if(killswitchengaged(store)){
    killswitchtrace(store);
    <http.res(403;"{\"ok\":false,\"error\":\"kill switch engaged or unreadable\"}")
  }el{};
  (* G1.6. Every request here is the browser-chat use case, so a switch on it refuses before
     the body is read or scanned: not even the local NER model is asked. forward() checks it
     again with the provider, after routing. *)
  if(ks.isusecaseblocked(store;"browser-chat")){
    killswitchtrace(store);
    ks.recordrefusal(store;"use_case";"browser-chat");
    <http.res(403;"{\"ok\":false,\"error\":\(jx.escape(ks.refusalmessage(store;"none";"browser-chat"))),\"kill_switch_scope\":\"use_case\"}")
  }el{};

  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  let parsed=json.dec(rawbody);
  (* MK6.13. jx.strvalue, not json.str: json.str turns an escaped newline into the letter n
     and a tab into t (T-47), so every multi-line prompt reached the model as one line with
     stray letters in it. *)
  let pobj=mt json.dec(rawbody) { $ok:o o; $jsonerr:e jx.emptyobj() };
  let text=jx.strvalue(pobj;"text";"");
  if(str.len(text)==0){
    <http.res(400;"{\"ok\":false,\"error\":\"text field is required\"}")
  }el{};

  (* NC1.8 - the fallback is never the default. Checked before the scan, so an unselected
     request costs nothing and records nothing. core.audit.disclosure.reserve enforces the same
     rule again at the last point before transport. *)
  let fbreason=json.str(parsed;"fallback_reason");
  let fbby=json.str(parsed;"fallback_selected_by");
  (* NC1.12 - a request that names its dataset is tried as a no-custody dispatch first, so it
     may arrive without a fallback selected. It is refused later, only if that attempt is. *)
  let selected=dl.fallbackreasonvalid(fbreason) && dl.fallbackselectorvalid(fbby);
  let nocustody=nd.applies(rawbody);
  if(selected || nocustody){}el{
    <fallbackunselected()
  };
  (* DA1.9 (4) - the caller's session, recorded on the disclosure row. Optional: a request
     without one is recorded as `none`, because no session is invented for it. One that is
     sent must be a plain identifier (see core.audit.disclosure.sessionidvalid), and is
     refused before the scan otherwise. *)
  let sid=sessionof(json.str(parsed;"session_id"));
  if(str.len(sid)==0){
    <http.res(400;"{\"ok\":false,\"error\":\"session_id, when sent, must be 1 to 64 letters, digits, '-', '_', '.' or ':', and not 'none'\",\"session_invalid\":true}")
  }el{};
  (* NC1.13 - and it must be one loke issued (POST /api/session) that has not expired, so the
     id on the disclosure row is loke's, not the caller's assertion. Still optional: `none` is
     not looked up. *)
  if(str.eq(sid;dl.nosession())==false){
    let issued=ns.check(sid);
    if(str.len(issued)>0){ <sessionrefused(issued) }el{}
  }el{};

  (* The only path to a provider. A refusal here is the point of NC1.9: no detection
     layer scanned this text, so it does not leave the machine. *)
  (* A bool, not a result arm: toke matches the first arm of an X!$lokeerr whatever
     the value is (T-18), so a refusal returned as $err would be read here as success
     and the text forwarded unscanned — the precise failure NC1.9 forbids. *)
  (* F3.9b. The caller's system prompt is scanned WITH the text (core.privacy.systemprompt):
     one entity list, one placeholder map, one sensitivity, so the policy and any approval
     below cover it, and run.finalsystemprompt, the guardian over its anonymised form, is what
     every route sends (F3.9a). The raw value is not passed on past this point except to bind
     an approval and to be anonymised again for the no-custody envelope. *)
  let sysprompt=jx.strvalue(pobj;"system_prompt";"");
  let run=sp.runforward(text;sysprompt;pipelineconfig());
  if(pipe.issafetoforward(run)){
    (* GA1.8 — the governance gate, between detection and dispatch. policy.evaluate returns
       a PLAIN struct, so T-18 cannot touch it, which is why this one could be wired now
       while GA1.5-GA1.7 wait. A deny is audited before the refusal is returned: a blocked
       request is exactly the kind an auditor asks about. *)
    let decision=decide(run);
    if(isdeny(decision)){
      let why=policymessage(decision);
      recordevent(store;run;"policy_deny";"none";"none";0;0;t.nowms()-startms;decision);
      log.warn("pipeline denied by policy: \(why)";"api.pipeline";run.requestid);
      <http.res(403;"{\"ok\":false,\"error\":\(jx.escape(why)),\"policy_denied\":true\(privacyfields(run))}")
    }el{};
    (* GA5.26 - held until approved. With no approval id the request is refused with one;
       with an id, it proceeds only if ag.consume spends a valid approval for THIS request. *)
    if(isrequireapproval(decision)){
      let bind=approvalbinding(run;boundtext(text;sysprompt);decision;fbreason;fbby);
      let aid=json.str(parsed;"approval_id");
      if(str.len(aid)==0){
        <heldforapproval(store;run;decision;bind;startms)
      }el{};
      if(ag.consume(aid;bind;t.nowms())){
        log.info("pipeline: a valid approval was presented and spent, so the held request proceeds (GA5.26)";"api.pipeline";run.requestid)
      }el{
        <approvalrefused(store;run;decision;aid;bind;startms)
      }
    }el{};
    if(nocustody){
      let ncreply=nocustodyfirst(store;run;rawbody;sysprompt;sid);
      if(nd.dispatched(ncreply)){
        <nocustodyanswer(run;ncreply)
      }el{};
      if(selected){
        log.info("pipeline: the no-custody attempt was refused (\(nd.refusalof(ncreply))), so the selected fallback is taken (NC1.12)";"api.pipeline";run.requestid)
      }el{
        <nocustodyunselected(ncreply)
      }
    }el{};
    <forward(store;run;startms;decision;fbreason;fbby;sid)
  }el{
    privacyrefusedtrace(store;run;t.nowms()-startms);
    <refused(pipe.refusalreason(run))
  }
};

f=get(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;"{\"ok\":true,\"status\":\"pipeline ready\"}")
};

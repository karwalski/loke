m=browser.pages.api.pipeline;
i=http:std.http;
i=str:std.str;
i=json:std.json;
i=file:std.file;

f=settingspath():str{
  <"/Users/matthew.watt/.loke/settings.json"
};

f=post(req:i64):i64{
  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  let parsed=json.dec(rawbody);
  let text=json.str(parsed;"text");
  let sysprompt=json.str(parsed;"system_prompt");
  let requestedmodel=json.str(parsed;"model");

  let settings=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  let sparsed=json.dec(settings);
  let anthropickey=json.str(sparsed;"anthropic_api_key");
  let openaikey=json.str(sparsed;"openai_api_key");
  let hasanthropic=str.len(anthropickey)>20;
  let hasopenai=str.len(openaikey)>20;

  if(hasanthropic){
    let abody=str.concat("{\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":4096,\"system\":";str.concat(json.enc(sysprompt);str.concat(",\"messages\":[{\"role\":\"user\",\"content\":";str.concat(json.enc(text);"}]}"))));
    let headers=str.concat("{\"x-api-key\":\"";str.concat(anthropickey;"\",\"anthropic-version\":\"2023-06-01\",\"content-type\":\"application/json\"}"));
    let client=http.client("https://api.anthropic.com");
    let aresp=http.postheaders(client;"/v1/messages";abody;headers);
    let aparsed=json.dec(aresp);
    let contentarr=json.str(aparsed;"content");
    let resptext=mt contentarr {
      $ok:v v;
      $err:e aresp
    };
    <http.res(200;str.concat("{\"ok\":true,\"response\":";str.concat(json.enc(resptext);",\"model\":\"claude-sonnet-4-20250514\",\"provider\":\"anthropic\"}")))
  }el{
    if(hasopenai){
      let obody=str.concat("{\"model\":\"gpt-4o\",\"messages\":[{\"role\":\"system\",\"content\":";str.concat(json.enc(sysprompt);str.concat("},{\"role\":\"user\",\"content\":";str.concat(json.enc(text);"}],\"max_tokens\":4096}"))));
      let oheaders=str.concat("{\"Authorization\":\"Bearer ";str.concat(openaikey;"\",\"content-type\":\"application/json\"}"));
      let oclient=http.client("https://api.openai.com");
      let oresp=http.postheaders(oclient;"/v1/chat/completions";obody;oheaders);
      let oparsed=json.dec(oresp);
      let choices=json.str(oparsed;"choices");
      <http.res(200;str.concat("{\"ok\":true,\"response\":";str.concat(json.enc(choices);",\"model\":\"gpt-4o\",\"provider\":\"openai\"}")))
    }el{
      let payload=str.concat("{\"model\":\"qwen2.5:3b\",\"prompt\":";str.concat(json.enc(text);",\"stream\":false}"));
      let ollamaresp=http.posturl("http://127.0.0.1:11434/api/generate";payload);
      let ollamaparsed=json.dec(ollamaresp);
      let response=json.str(ollamaparsed;"response");
      <http.res(200;str.concat("{\"ok\":true,\"response\":";str.concat(json.enc(response);",\"model\":\"qwen2.5:3b\",\"provider\":\"ollama\"}")))
    }
  }
};

f=get(req:i64):i64{ <http.res(200;"{\"ok\":true,\"status\":\"pipeline ready\"}") };

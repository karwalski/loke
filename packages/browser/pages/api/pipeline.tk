m=browser.pages.api.pipeline;
i=http:std.http;
i=str:std.str;

f=post(req:i64):i64{
  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  <http.res(200;str.concat("{\"ok\":true,\"received\":true,\"note\":\"Ollama integration pending — http.postjson not returning data\",\"body\":";str.concat(rawbody;"}")))
};

f=get(req:i64):i64{ <http.res(200;"{\"ok\":true,\"status\":\"pipeline ready\"}") };

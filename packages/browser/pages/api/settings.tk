m=browser.pages.api.settings;
i=http:std.http;
i=str:std.str;
i=json:std.json;
i=file:std.file;

f=settingspath():str{
  <"/Users/matthew.watt/.loke/settings.json"
};

f=get(req:i64):i64{
  let content=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  <http.res(200;content)
};

f=post(req:i64):i64{
  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  let parsed=json.dec(rawbody);
  let key=json.str(parsed;"key");
  let value=json.str(parsed;"value");

  let existing=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  let updated=str.concat("{\"";str.concat(key;str.concat("\":\"";str.concat(value;str.concat("\",";str.concat(str.slice(existing;1;str.len(existing));""))))));

  mt file.write(settingspath();updated) {$ok:v v; $err:e ""};
  <http.res(200;"{\"ok\":true}")
};

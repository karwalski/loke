m=page.api.settings;
i=http:std.http;
i=str:std.str;
i=json:std.json;
i=jx:shared.jsonobj;
i=file:std.file;
i=std:std;
i=kc:core.storage.keychain;
i=org:shared.origin;

(* Derived from the home directory, not hardcoded. This read
   a literal absolute path under one developer's home directory — so on any
   other account the settings file was never found, every read fell through to "{}",
   and saved settings silently did nothing. *)
(* str.concat, not interpolation. A string returned by std.homedir() is TRUNCATED when
   interpolated — "\(std.homedir())/x" yields 12 characters where str.concat yields the
   correct 21 — so every path built that way pointed at a directory that does not
   exist, and db.open failed on it. Interpolating a local or a parameter is fine; it is
   specifically the value this stdlib call returns. Filed as T-21. *)
f=settingspath():str{
  <str.concat(std.homedir();"/.loke/settings.json")
};

(* mask an API key for display: show first 4 chars then **** *)
f=maskkey(key:str):str{
  if(str.len(key)<5){<""}el{};
  <str.concat(str.slice(key;0;4);"****")
};

(* remove an API key field from the JSON settings file *)
f=removekeyfromjson(field:str):bool{
  let content=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  let parsed=json.dec(content);
  let ak=json.str(parsed;"anthropic_api_key");
  let ok=json.str(parsed;"openai_api_key");
  let port=json.str(parsed;"port");
  let ollamaurl=json.str(parsed;"ollama_url");
  (* rebuild JSON without the specified field *)
  let out=mut."{";
  let needcomma=mut.false;
  if(!str.eq(field;"anthropic_api_key")){
    if(str.len(ak)>0){
      out=str.concat(out;str.concat("\"anthropic_api_key\":";jx.escape(ak)));
      needcomma=true
    }el{}
  }el{};
  if(!str.eq(field;"openai_api_key")){
    if(str.len(ok)>0){
      if(needcomma){out=str.concat(out;",")}el{};
      out=str.concat(out;str.concat("\"openai_api_key\":";jx.escape(ok)));
      needcomma=true
    }el{}
  }el{};
  if(str.len(port)>0){
    if(needcomma){out=str.concat(out;",")}el{};
    out=str.concat(out;str.concat("\"port\":";port));
    needcomma=true
  }el{};
  if(str.len(ollamaurl)>0){
    if(needcomma){out=str.concat(out;",")}el{};
    out=str.concat(out;str.concat("\"ollama_url\":";jx.escape(ollamaurl)))
  }el{};
  out=str.concat(out;"}");
  <mt file.write(settingspath();out) {$ok:v true; $err:e false}
};

(* The body is built without a request so it can be tested. The masking is the part
   worth asserting: a settings endpoint that returned a key in full would be a
   disclosure, and there was no test for it because the test could not compile. *)
f=keyfordisplay(service:str;jsonfield:str):str{
  let fromkeychain=kc.getapikey(service);
  if(str.len(fromkeychain)>0){
    <maskordefault(fromkeychain)
  }el{
    (* Migration path: keys used to live in settings.json. *)
    let content=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
    <maskordefault(json.str(json.dec(content);jsonfield))
  }
};

f=maskordefault(key:str):str{
  if(str.len(key)>4){
    <maskkey(key)
  }el{
    <"not set"
  }
};

f=settingsjson():str{
  <"{\"anthropic\":\"\(keyfordisplay("anthropic";"anthropic_api_key"))\",\"openai\":\"\(keyfordisplay("openai";"openai_api_key"))\",\"port\":11430,\"ollama_url\":\"http://127.0.0.1:11434\"}"
};

f=get(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  <http.res(200;settingsjson())
};

f=post(req:i64):i64{
  (* GA2.6, GA2.7: foreign Origin or non-loopback Host. See shared.origin. *)
  if(org.requestrefused(req)){ <org.refuse() }el{};
  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  let pbody=json.dec(rawbody);
  let key=json.str(pbody;"key");
  let value=json.str(pbody;"value");
  (* store API keys in OS keychain, not in JSON *)
  if(str.eq(key;"anthropic_api_key")){
    kc.setapikey("anthropic";value);
    removekeyfromjson("anthropic_api_key");
    <http.res(200;"{\"ok\":true}")
  }el{};
  if(str.eq(key;"openai_api_key")){
    kc.setapikey("openai";value);
    removekeyfromjson("openai_api_key");
    <http.res(200;"{\"ok\":true}")
  }el{};
  (* non-secret settings still go to JSON *)
  let existing=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  let eparsed=json.dec(existing);
  let out="{\(jx.escape(key)):\(jx.escape(value))}";
  mt file.write(settingspath();out) {$ok:v v; $err:e ""};
  <http.res(200;"{\"ok\":true}")
};

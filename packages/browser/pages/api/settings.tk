m=browser.pages.api.settings;
i=http:std.http;
i=str:std.str;
i=json:std.json;
i=file:std.file;

f=settingspath():str{
  <"/Users/matthew.watt/.loke/settings.json"
};

f=get(req:i64):i64{
  let content=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  let parsed=json.dec(content);
  let ak=mut.json.str(parsed;"anthropic_api_key");
  let ok=mut.json.str(parsed;"openai_api_key");
  let hasak=str.len(ak)>5;
  let hasok=str.len(ok)>5;
  let akstatus=mut."not set";
  if(hasak){ akstatus="configured" }el{};
  let okstatus=mut."not set";
  if(hasok){ okstatus="configured" }el{};
  <http.res(200;str.concat("{\"anthropic\":\"";str.concat(akstatus;str.concat("\",\"openai\":\"";str.concat(okstatus;"\",\"port\":11430,\"ollama_url\":\"http://127.0.0.1:11434\"}")))))
};

f=post(req:i64):i64{
  let rawbody=mt http.body(req) {$ok:v v; $err:e ""};
  let pbody=json.dec(rawbody);
  let key=json.str(pbody;"key");
  let value=json.str(pbody;"value");
  let existing=mt file.read(settingspath()) {$ok:v v; $err:e "{}"};
  let eparsed=json.dec(existing);
  let ak=mut.json.str(eparsed;"anthropic_api_key");
  let ok=mut.json.str(eparsed;"openai_api_key");
  if(str.eq(key;"anthropic_api_key")){ ak=value }el{};
  if(str.eq(key;"openai_api_key")){ ok=value }el{};
  let out=str.concat("{\"anthropic_api_key\":";str.concat(json.enc(ak);str.concat(",\"openai_api_key\":";str.concat(json.enc(ok);"}"))));
  mt file.write(settingspath();out) {$ok:v v; $err:e ""};
  <http.res(200;"{\"ok\":true}")
};

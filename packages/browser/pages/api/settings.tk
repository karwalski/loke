m=browser.pages.api.settings;



i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;

f=get(req:$http.req):$http.res{
  let config=core.getconfig();

  let portstr=str.fromu16(config.port);

  let respbody=str.concat("{";
    str.concat("\"port\":";
    str.concat(portstr;
    str.concat(",\"data_dir\":";
    str.concat(json.encstr(config.datadir);
    str.concat(",\"log_level\":";
    str.concat(json.encstr(config.loglevel);
    str.concat(",\"ollama_url\":";
    str.concat(json.encstr(config.ollamaurl);
    str.concat(",\"presidio_url\":";
    str.concat(json.encstr(config.presidiourl);
    str.concat(",\"llmlingua_url\":";
    str.concat(json.encstr(config.llmlinguaurl);
    str.concat(",\"default_provider\":";
    str.concat(json.encstr(config.defaultprovider);
    "}"))))))))))));

  <http.res.json(200;respbody)
};

f=post(req:$http.req):$http.res{
  let body=req.body;
  let key=json.getstr(body;mt "key") {
    $ok:v v;
    $err: ""
  };
  let value=json.getstr(body;mt "value") {
    $ok:v v;
    $err: ""
  };
  if str.eq(key;"anthropic_api_key"){
    core.setapikey("anthropic";value)
  }else{
    if str.eq(key;"openai_api_key"){
      core.setapikey("openai";value)
    }else{()};
  };
  let respbody=str.concat("{\"ok\":true,\"key\":";
    str.concat(json.encstr(key);
    str.concat(",\"set\":true}";"")));
  <http.res.json(200;respbody)
};

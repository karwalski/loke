m=browser.pages.api.settings;
i=http:std.http;
i=json:std.json;
i=str:std.str;
i=core:browser.extensions.core;
f=get(req:i64):i64{
  let config=core.getconfig();
  let portstr=str.fromu16(config.port);
  let a=str.concat("{\"port\":";portstr);
  let b=str.concat(a;str.concat(",\"data_dir\":";json.encstr(config.datadir)));
  let c=str.concat(b;str.concat(",\"log_level\":";json.encstr(config.loglevel)));
  let d=str.concat(c;str.concat(",\"ollama_url\":";json.encstr(config.ollamaurl)));
  let e=str.concat(d;str.concat(",\"presidio_url\":";json.encstr(config.presidiourl)));
  let ff=str.concat(e;str.concat(",\"llmlingua_url\":";json.encstr(config.llmlinguaurl)));
  let g=str.concat(ff;str.concat(",\"default_provider\":";json.encstr(config.defaultprovider)));
  let respbody=str.concat(g;"}");
  <http.res.json(200;respbody)
};
f=post(req:i64):i64{
  let body=req.body;
  let key=mt json.getstr(body;"key") {$ok:v v; $err:e ""};
  let value=mt json.getstr(body;"value") {$ok:v v; $err:e ""};
  if(str.eq(key;"anthropic_api_key")){
    core.setapikey("anthropic";value)
  }el{
    if(str.eq(key;"openai_api_key")){
      core.setapikey("openai";value)
    }el{}
  };
  let respbody=str.concat("{\"ok\":true,\"key\":";str.concat(json.encstr(key);",\"set\":true}"));
  <http.res.json(200;respbody)
};

m=shared.config;

i=file:std.file;
i=toml:std.toml;
i=t:shared.types;

t=$lokeconfig{
  port:u16;
  datadir:str;
  loglevel:str;
  ollamaurl:str;
  presidiourl:str;
  llmlinguaurl:str;
  defaultprovider:str
};

f=defaultconfig():$lokeconfig{
  <$lokeconfig{
    port:11430;
    datadir:"~/.loke";
    loglevel:"info";
    ollamaurl:"http://localhost:11434";
    presidiourl:"http://localhost:5000";
    llmlinguaurl:"http://localhost:5001";
    defaultprovider:"ollama"
  }
};

(* Reads the file through std.toml. The previous body called `file.parsetoml(raw)` and
   then `parsed.getu16(...)` / `parsed.getstr(...)` — a fluent API that does not exist
   anywhere. toke does not check an unknown METHOD call: it emitted calls to `_getstr`
   and `_getu16` and the only error was "Undefined symbols" at link time, naming no
   loke file. So this never worked and nothing said so. See
   docs/upstream/toke-issues.md T-7.

   Each field falls back to its default when the key is absent, which is what the old
   shape intended. toml.section is not used: dotted keys are passed whole. *)
f=tomlstr(doc:i64;key:str;fallback:str):str{
  <mt toml.str(doc;key) {
    $ok:v v;
    $err:e fallback
  }
};

f=tomlport(doc:i64;fallback:u16):u16{
  <mt toml.i64(doc;"server.port") {
    $ok:v v as u16;
    $err:e fallback
  }
};

f=configfromtoml(doc:i64):$lokeconfig{
  let defaults=defaultconfig();
  <$lokeconfig{
    port:tomlport(doc;defaults.port);
    datadir:tomlstr(doc;"project.data_dir";defaults.datadir);
    loglevel:tomlstr(doc;"dev.log_level";defaults.loglevel);
    ollamaurl:tomlstr(doc;"providers.ollama_url";defaults.ollamaurl);
    presidiourl:tomlstr(doc;"privacy.presidio_url";defaults.presidiourl);
    llmlinguaurl:tomlstr(doc;"privacy.llmlingua_url";defaults.llmlinguaurl);
    defaultprovider:tomlstr(doc;"providers.default";defaults.defaultprovider)
  }
};

f=loadconfig(path:str):$lokeconfig!$lokeerr{
  mt toml.loadfile(path) {
    $ok:doc $ok(configfromtoml(doc));
    $err:e $err($configerr("could not read or parse \(path)"))
  }
};


m=shared.config;


i=file:std.file;
i=t:shared.types;

t=$lokeconfig{
  port:u16;
  datadir:str;
  loglevel:str;
  ollamaurl:str;
  presidiourl:str;
  llmlinguaurl:str;
  defaultprovider:str
};

f=defaultconfig():$lokeconfig{
  <$lokeconfig{
    port=11430;
    datadir="~/.loke";
    loglevel="info";
    ollamaurl="http://localhost:11434";
    presidiourl="http://localhost:5000";
    llmlinguaurl="http://localhost:5001";
    defaultprovider="ollama"
  };
};

f=loadconfig(path:str):$lokeconfig|$lokeerr{
  let raw=mt file.read(path) {
    $ok:v v;
    $err:e <$err($configerr(e))
  };
  let defaults=defaultconfig();
  let parsed=mt file.parsetoml(raw) {
    $ok:v v;
    $err:e <$err($configerr(e))
  };
  <$ok($lokeconfig{
    port=mt parsed.getu16("server.port") {
      $ok:v v;
      $err: defaults.port
    };
    datadir=mt parsed.getstr("project.data_dir") {
      $ok:v v;
      $err: defaults.datadir
    };
    loglevel=mt parsed.getstr("dev.log_level") {
      $ok:v v;
      $err: defaults.loglevel
    };
    ollamaurl=mt parsed.getstr("providers.ollama_url") {
      $ok:v v;
      $err: defaults.ollamaurl
    };
    presidiourl=mt parsed.getstr("privacy.presidio_url") {
      $ok:v v;
      $err: defaults.presidiourl
    };
    llmlinguaurl=mt parsed.getstr("privacy.llmlingua_url") {
      $ok:v v;
      $err: defaults.llmlinguaurl
    };
    defaultprovider=mt parsed.getstr("providers.default") {
      $ok:v v;
      $err: defaults.defaultprovider
    };
  })
};

m=shared.result;


i=t:shared.types;

f=ok(v:str):$ok(str){
  <$ok(v)
};

f=errconfig(msg:str):$lokeerr{
  <$configerr(msg)
};

f=errmodel(msg:str):$lokeerr{
  <$modelerr(msg)
};

f=errprivacy(msg:str):$lokeerr{
  <$privacyerr(msg)
};

f=errnetwork(msg:str):$lokeerr{
  <$networkerr(msg)
};

f=issensitive(level:$sensitivitylevel):bool{
  mt level {
    $confidential <true;
    $restricted <true;
    $public <false;
    $internal <false
  }
};

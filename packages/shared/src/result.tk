m=shared.result;


i=t:shared.types;

f=errconfig(msg:str):$lokeerr{
  <$configerr(msg)
};

f=errmodel(msg:str):$lokeerr{
  <$modelerr(msg)
};

f=errprivacy(msg:str):$lokeerr{
  <$privacyerr(msg)
};

f=errnetwork(msg:str):$lokeerr{
  <$networkerr(msg)
};

f=issensitive(level:$sensitivitylevel):bool{
  mt level {
    $confidential:v true;
    $restricted:v true;
    $public:v false;
    $internal:v false
  }
};

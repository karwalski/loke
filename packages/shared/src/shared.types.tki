{
  "schema_version": "1.0",
  "module": "shared.types",
  "version": "1.0.0",
  "exports": [
    {"kind": "type", "name": "sensitivitylevel", "is_sum": true, "fields": [{"name": "$public", "type": "i64"}, {"name": "$internal", "type": "i64"}, {"name": "$confidential", "type": "i64"}, {"name": "$restricted", "type": "i64"}]},
    {"kind": "type", "name": "provider", "is_sum": true, "fields": [{"name": "$anthropic", "type": "i64"}, {"name": "$openai", "type": "i64"}, {"name": "$google", "type": "i64"}, {"name": "$mistral", "type": "i64"}, {"name": "$openrouter", "type": "i64"}, {"name": "$ollama", "type": "i64"}, {"name": "$local", "type": "i64"}]},
    {"kind": "type", "name": "tasktype", "is_sum": true, "fields": [{"name": "$chat", "type": "i64"}, {"name": "$codegeneration", "type": "i64"}, {"name": "$codereview", "type": "i64"}, {"name": "$summarisation", "type": "i64"}, {"name": "$classification", "type": "i64"}, {"name": "$ner", "type": "i64"}, {"name": "$embedding", "type": "i64"}, {"name": "$dataanalysis", "type": "i64"}]},
    {"kind": "type", "name": "modeltier", "is_sum": true, "fields": [{"name": "$interactive", "type": "i64"}, {"name": "$considered", "type": "i64"}, {"name": "$background", "type": "i64"}]},
    {"kind": "type", "name": "latencytolerance", "is_sum": true, "fields": [{"name": "$instant", "type": "i64"}, {"name": "$patient", "type": "i64"}, {"name": "$background", "type": "i64"}]},
    {"kind": "type", "name": "piientity", "fields": [{"name": "entitytype", "type": "str"}, {"name": "value", "type": "str"}, {"name": "start", "type": "u32"}, {"name": "end", "type": "u32"}, {"name": "confidence", "type": "f64"}, {"name": "placeholder", "type": "str"}]},
    {"kind": "type", "name": "piidetectionresult", "fields": [{"name": "original", "type": "str"}, {"name": "anonymised", "type": "str"}, {"name": "entities", "type": "@"}, {"name": "sensitivity", "type": "sensitivitylevel"}]},
    {"kind": "type", "name": "modelspec", "fields": [{"name": "id", "type": "str"}, {"name": "provider", "type": "provider"}, {"name": "contextwindow", "type": "u32"}, {"name": "costper1kinput", "type": "f64"}, {"name": "costper1koutput", "type": "f64"}, {"name": "tier", "type": "modeltier"}]},
    {"kind": "type", "name": "routingdecision", "fields": [{"name": "model", "type": "modelspec"}, {"name": "reason", "type": "str"}, {"name": "tier", "type": "modeltier"}, {"name": "estimatedcost", "type": "f64"}, {"name": "estimatedlatencyms", "type": "u32"}]},
    {"kind": "type", "name": "pipelineresult", "fields": [{"name": "original", "type": "str"}, {"name": "anonymised", "type": "str"}, {"name": "routing", "type": "routingdecision"}, {"name": "sensitivity", "type": "sensitivitylevel"}, {"name": "requestid", "type": "str"}]},
    {"kind": "type", "name": "risktier", "is_sum": true, "fields": [{"name": "$low", "type": "i64"}, {"name": "$medium", "type": "i64"}, {"name": "$high", "type": "i64"}, {"name": "$critical", "type": "i64"}]},
    {"kind": "type", "name": "policydecision", "is_sum": true, "fields": [{"name": "$allow", "type": "i64"}, {"name": "$allowwithwarning", "type": "str"}, {"name": "$requireapproval", "type": "str"}, {"name": "$deny", "type": "str"}]},
    {"kind": "type", "name": "lokeerr", "is_sum": true, "fields": [{"name": "$configerr", "type": "str"}, {"name": "$modelerr", "type": "str"}, {"name": "$privacyerr", "type": "str"}, {"name": "$storageerr", "type": "str"}, {"name": "$networkerr", "type": "str"}, {"name": "$unknownerr", "type": "str"}]},
    {"kind": "func", "name": "streq", "params": ["str", "str"], "return": "bool"},
    {"kind": "func", "name": "strlen", "params": ["str"], "return": "i64"},
    {"kind": "func", "name": "strconcat", "params": ["str", "str"], "return": "str"},
    {"kind": "func", "name": "strcontains", "params": ["str", "str"], "return": "bool"},
    {"kind": "func", "name": "strisempty", "params": ["str"], "return": "bool"},
    {"kind": "func", "name": "strlower", "params": ["str"], "return": "str"},
    {"kind": "func", "name": "strpad", "params": ["str", "i64"], "return": "str"},
    {"kind": "func", "name": "strslice", "params": ["str", "i64", "i64"], "return": "str"},

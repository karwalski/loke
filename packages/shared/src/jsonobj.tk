m=shared.jsonobj;

i=json:std.json;
i=str:std.str;

f=sliceor(s:str;from:i64;to:i64):str{
  <mt str.slice(s;from as u64;to as u64) {
    $ok:v v;
    $sliceerr:e ""
  }
};

f=objend(s:str;n:i64):i64{
  let depth=mut.0;
  let instr=mut.false;
  let esc=mut.false;
  let end=mut.0-1;
  lp(let k=0;k<n;k=k+1){
    if(end<0){
      let c=str.charat(s;k);
      if(esc){
        esc=false
      }el{
        if(instr){
          if(c==92){ esc=true }el{
            if(c==34){ instr=false }el{}
          }
        }el{
          if(c==34){ instr=true }el{
            if(c==123){ depth=depth+1 }el{
              if(c==125){
                depth=depth-1;
                if(depth==0){ end=k+1 }el{}
              }el{}
            }
          }
        }
      }
    }el{}
  };
  <end
};

f=emptyobj():$jsonval{
  <$jsonval{raw:"{}"}
};

f=nested(o:$jsonval;key:str):$jsonval{
  let needle="\"\(key)\":";
  let at=str.indexof(o.raw;needle);
  if(at<0){ <emptyobj() }el{};
  let rest=sliceor(o.raw;at+(str.len(needle) as i64);str.len(o.raw) as i64);
  let e=objend(rest;str.len(rest) as i64);
  if(e<0){ <emptyobj() }el{};
  <$jsonval{raw:sliceor(rest;0;e)}
};

(* ── A JSON zero is not a missing field, and std.json cannot tell them apart ───────
   Measured at 0b0bc4e: every NUMERIC and BOOLEAN accessor in std.json reports `$jsonerr`
   for a falsy value.

     json.i64  on 0      -> $jsonerr        json.i64  on 5    -> $ok 5
     json.u64  on 0      -> $jsonerr        json.f64  on 1.5  -> $ok 1.5
     json.f64  on 0.0    -> $jsonerr        json.bool on true -> $ok true
     json.bool on false  -> $jsonerr        json.str  on ""   -> $ok ""

   Only `json.str` survives, and it survives because an empty string is still a non-null
   pointer. Filed as T-33. Together with T-31 it points at one representation: `X!E` looks to
   be a single machine word carrying the value, with zero standing for the error — which is
   why arms bind by position, why a user-declared error side always takes arm 0, and why a
   legitimate zero reads as a failure.

   Left alone, that makes `nestedi64` report the caller's fallback for a real zero. For the
   providers it happens not to matter — a zero token count and a fallback of 0 agree — but
   "the provider said zero" and "the provider did not say" are different facts, and an audit
   reader that cannot distinguish them cannot tell a free request from an unrecorded one.

   So the error arm asks the text. `fieldiszero` is exact rather than heuristic: JSON forbids
   leading zeros in numbers, so a value whose first character is `0` is `0`, `0.0` or similar
   — it cannot be `07` or `0x10`. A field that is present but not falsy and still errored is
   a genuine type mismatch, and that gets the fallback. *)

f=fieldtail(n:$jsonval;field:str):str{
  let needle="\"\(field)\":";
  let at=str.indexof(n.raw;needle);
  if(at<0){ <"" }el{};
  <sliceor(n.raw;at+(str.len(needle) as i64);str.len(n.raw) as i64)
};

f=fieldiszero(n:$jsonval;field:str):bool{
  let rest=fieldtail(n;field);
  if(str.len(rest)==0){ <false }el{};
  let c=str.charat(rest;0);
  if(c==48){ <true }el{};
  (* "-0" and "-0.0" are legal JSON and mean zero. *)
  if(c==45){
    if((str.len(rest) as i64)<2){ <false }el{};
    <str.charat(rest;1)==48
  }el{};
  <false
};

f=nestedi64(o:$jsonval;key:str;field:str;fallback:i64):i64{
  <mt json.i64(nested(o;key);field) {
    $ok:v v;
    $jsonerr:e zeroorfallback(nested(o;key);field;fallback)
  }
};

f=zeroorfallback(n:$jsonval;field:str;fallback:i64):i64{
  if(fieldiszero(n;field)){
    <0
  }el{
    <fallback
  }
};

f=nestedstr(o:$jsonval;key:str;field:str;fallback:str):str{
  <mt json.str(nested(o;key);field) {
    $ok:v v;
    $jsonerr:e fallback
  }
};

f=hasnested(o:$jsonval;key:str):bool{
  <str.len(nested(o;key).raw)>2
};

(* ── Array elements ───────────────────────────────────────────────────────────────
   `json.arr` IS typed — `(Json, str) -> [Json]!JsonErr` — and it works: an element comes
   back as a real `$jsonval` whose `.raw` holds that element's text, so `nested` and the typed
   accessors both apply to it. This is the one part of std.json's object model that is
   reachable, and it is why `elem` exists rather than another text scan.

   Bounds are checked here rather than trusted. `a.get(0)` on an empty array is a read past
   the end, and an empty `choices` array is what a provider returns when it refuses a
   request — a refusal is exactly the case a caller is least likely to have tested. *)

f=elemat(a:@$jsonval;idx:i64):$jsonval{
  if(idx<0){ <emptyobj() }el{};
  if(idx>=(a.len as i64)){ <emptyobj() }el{};
  <a.get(idx)
};

f=elem(o:$jsonval;key:str;idx:i64):$jsonval{
  <mt json.arr(o;key) {
    $ok:a elemat(a;idx);
    $jsonerr:e emptyobj()
  }
};

f=elemstr(o:$jsonval;key:str;idx:i64;field:str;fallback:str):str{
  <mt json.str(elem(o;key;idx);field) {
    $ok:v v;
    $jsonerr:e fallback
  }
};


(* ── Escaping a string INTO JSON ──────────────────────────────────────────────────
   `json.enc` does this correctly and is what to reach for first. This exists because two
   modules needed an escaper that demonstrably works on the values they actually hold:
   `core.memory.export` found `json.enc` returning empty for `db.rowstr` values (cause not
   established — see the note in that file), and `core.mcp.protocol` was interpolating an error
   message between two literal quote characters with no escaping at all, so any provider or
   validation message containing a quote broke the JSON-RPC envelope and the client saw a parse
   error instead of the diagnosis.

   Order is load-bearing. BACKSLASH FIRST: escape the quotes first and the backslash you just
   inserted gets escaped a moment later, turning `\"` into `\\"`. Newlines and tabs matter
   because an error message quoting a prompt, or a memory drawer, is multi-line more often than
   not, and a raw newline inside a JSON string is invalid.

   MK6.13: every other control character, U+0001 to U+001F, is written as \u00XX. JSON forbids
   all of them raw, not only the three above, and Ollama's decoder (Go's encoding/json) answers
   400 to a body holding one, measured at Ollama 0.22.0: "invalid character '\t' in string
   literal". A prompt pasted from a terminal carries ESC (0x1B), and text extracted from a PDF
   carries form feeds. NUL is not handled: a toke str cannot hold one. *)
f=escape(s:str):str{
  let n=str.replace(str.replace(str.replace(s;"\\";"\\\\");"\"";"\\\"");"
";"\\n");
  let tb=str.replace(str.replace(n;"\r";"\\r");"\t";"\\t");
  <"\"\(escapecontrols(tb))\""
};

(* The raw control characters escape leaves to this, and their escapes, index for index. *)
f=controlchars():@str{
  <@("\x01";"\x02";"\x03";"\x04";"\x05";"\x06";"\x07";"\x08";"\x0b";"\x0c";"\x0e";"\x0f";"\x10";"\x11";"\x12";"\x13";"\x14";"\x15";"\x16";"\x17";"\x18";"\x19";"\x1a";"\x1b";"\x1c";"\x1d";"\x1e";"\x1f")
};

f=controlescapes():@str{
  <@("\\u0001";"\\u0002";"\\u0003";"\\u0004";"\\u0005";"\\u0006";"\\u0007";"\\u0008";"\\u000b";"\\u000c";"\\u000e";"\\u000f";"\\u0010";"\\u0011";"\\u0012";"\\u0013";"\\u0014";"\\u0015";"\\u0016";"\\u0017";"\\u0018";"\\u0019";"\\u001a";"\\u001b";"\\u001c";"\\u001d";"\\u001e";"\\u001f")
};

f=escapecontrols(s:str):str{
  let raws=controlchars();
  let escs=controlescapes();
  let out=mut.s;
  lp(let i=0;i<raws.len;i=i+1){
    if(str.contains(out;raws.get(i))){ out=str.replace(out;raws.get(i);escs.get(i)) }el{}
  };
  <out
};

(* ── Decoding a string value, because std.json's accessor loses characters (T-47) ────
   `json.str` unescapes by dropping each backslash and keeping the character after it, so
   `\n` comes back as the letter `n`, `\t` as `t`, and a multi-line memory drawer exported by
   `escape` above is imported as one line with stray letters in it. Measured at `fedd48d`
   (LS1.1k): `"he said \"hi\"\nthen"` read back as `he said "hi"nthen`.

   So the RAW value is taken with `json.getval`, which finds the key with std.json's own
   top-level scanner (a key-shaped string inside another value cannot match), and decoded
   here. `unescape` is the inverse of `escape`: an escaped backslash is parked on \x01 first,
   so `\\n` stays a backslash followed by `n` rather than becoming a newline. \x01 cannot
   occur raw inside a JSON string — control characters must be escaped — so parking on it is
   exact. `\uXXXX` is left as written, except the control characters `escape` writes that way
   (MK6.13): U+0002 to U+001F are decoded. U+0001 is not, because it would come back as the
   parked backslash; `\u0001` is left as written. *)
f=unescape(body:str):str{
  <str.replace(unescapecontrols(str.replace(str.replace(body;"\\\\";"\x01");"\\\"";"\""));"\x01";"\\")
};

f=unescapecontrols(s:str):str{
  <unescapeunicode(str.replace(str.replace(str.replace(str.replace(s;"\\n";"\n");"\\r";"\r");"\\t";"\t");"\\/";"/"))
};

f=unescapeunicode(s:str):str{
  if(str.contains(s;"\\u00")==false){ <s }el{};
  let raws=controlchars();
  let escs=controlescapes();
  let out=mut.s;
  lp(let i=1;i<raws.len;i=i+1){
    if(str.contains(out;escs.get(i))){ out=str.replace(out;escs.get(i);raws.get(i)) }el{}
  };
  <out
};

(* The raw JSON text of the value at `key`, or "" when the key is absent. json.getval is typed
   (Json, str) -> str and answers "" for an absent key, measured on toke 3.1.0; the json.has
   guard it used to need is one of std.json's untyped helpers (LS1.1w). *)
f=rawvalue(o:$jsonval;key:str):str{
  <json.getval(o;key)
};

(* A string field, decoded. `fallback` when absent or not a string. *)
f=strvalue(o:$jsonval;key:str;fallback:str):str{
  let raw=rawvalue(o;key);
  let n=str.len(raw) as i64;
  if(n<2){ <fallback }el{};
  if(str.charat(raw;0)==34){
    if(str.charat(raw;n-1)==34){
      <unescape(sliceor(raw;1;n-1))
    }el{}
  }el{};
  <fallback
};

(* A number field as its JSON text — "0.75", "1790000000" — which is what a SQL parameter
   wants, and which does not go through std.json's numeric accessors: those report a JSON
   zero as an error (T-33). `fallback` when absent or not a number. *)
f=numtext(o:$jsonval;key:str;fallback:str):str{
  let raw=rawvalue(o;key);
  if(str.len(raw)==0){ <fallback }el{};
  let c=str.charat(raw;0);
  if(c==45){ <raw }el{};
  if(c>=48){
    if(c<=57){ <raw }el{}
  }el{};
  <fallback
};

(* ── The raw text of ANY value at a key, not just an object ───────────────────────
   `nested` above brace-matches `{...}`, which is right for a `usage` block and wrong for a
   JSON-RPC `params`, which may be an object, an array, or null.

   This is what `core.mcp.protocol` needed. It was doing

       let paramsraw=json.enc(json.getval(obj;"params"));

   and `json.getval` is one of std.json's untyped `(i64,i64)->i64` helpers while `json.enc`
   takes a `str` — so it rendered the HANDLE. Every MCP request arrived at the tool layer with
   its params replaced by a decimal pointer value, which is why no tool call carrying arguments
   could ever have worked.

   Returns "null" when the key is absent, because that is what a JSON-RPC params field means
   when it is missing and because a caller concatenating this into a document needs something
   syntactically valid rather than an empty gap. *)
f=spanend(s:str;n:i64;openc:i64;closec:i64):i64{
  let depth=mut.0;
  let instr=mut.false;
  let esc=mut.false;
  let end=mut.0-1;
  lp(let k=0;k<n;k=k+1){
    if(end<0){
      let c=str.charat(s;k);
      if(esc){
        esc=false
      }el{
        if(instr){
          if(c==92){ esc=true }el{
            if(c==34){ instr=false }el{}
          }
        }el{
          if(c==34){ instr=true }el{
            if(c==openc){ depth=depth+1 }el{
              if(c==closec){
                depth=depth-1;
                if(depth==0){ end=k+1 }el{}
              }el{}
            }
          }
        }
      }
    }el{}
  };
  <end
};

f=strend(s:str;n:i64):i64{
  let esc=mut.false;
  let end=mut.0-1;
  lp(let k=1;k<n;k=k+1){
    if(end<0){
      let c=str.charat(s;k);
      if(esc){
        esc=false
      }el{
        if(c==92){ esc=true }el{
          if(c==34){ end=k+1 }el{}
        }
      }
    }el{}
  };
  <end
};

(* A bare value — number, true, false, null — ends at the first comma or closing bracket that
   is not inside something else. Leading whitespace has already been skipped by the caller. *)
f=bareend(s:str;n:i64):i64{
  let end=mut.n;
  lp(let k=0;k<n;k=k+1){
    if(end==n){
      let c=str.charat(s;k);
      if(c==44){ end=k }el{
        if(c==125){ end=k }el{
          if(c==93){ end=k }el{}
        }
      }
    }el{}
  };
  <end
};

f=skipws(s:str;n:i64):i64{
  let at=mut.n;
  lp(let k=0;k<n;k=k+1){
    if(at==n){
      let c=str.charat(s;k);
      if(c==32){}el{
        if(c==9){}el{
          if(c==10){}el{
            if(c==13){}el{ at=k }
          }
        }
      }
    }el{}
  };
  <at
};

f=valueraw(o:$jsonval;key:str):str{
  let needle="\"\(key)\":";
  let at=str.indexof(o.raw;needle);
  if(at<0){ <"null" }el{};
  let after=sliceor(o.raw;at+(str.len(needle) as i64);str.len(o.raw) as i64);
  let alen=str.len(after) as i64;
  let vs=skipws(after;alen);
  if(vs>=alen){ <"null" }el{};
  let rest=sliceor(after;vs;alen);
  let rlen=str.len(rest) as i64;
  let c=str.charat(rest;0);
  if(c==123){
    let e=spanend(rest;rlen;123;125);
    if(e<0){ <"null" }el{};
    <sliceor(rest;0;e)
  }el{};
  if(c==91){
    let e=spanend(rest;rlen;91;93);
    if(e<0){ <"null" }el{};
    <sliceor(rest;0;e)
  }el{};
  if(c==34){
    let e=strend(rest;rlen);
    if(e<0){ <"null" }el{};
    <sliceor(rest;0;e)
  }el{};
  <sliceor(rest;0;bareend(rest;rlen))
};

(* ── A JSON string decoded completely, and a JSON text as its tokens (MK6.14) ──────
   `unescape` above leaves \uXXXX as written (except the control characters `escape`
   writes), which is right for a value that is only read and wrong for one that is changed
   and written back: `escape` would double the backslash, and `é` would arrive as six
   characters. The MCP broker anonymises each value of a tool call's arguments and writes
   the changed ones back with `escape`, so it needs every escape decoded: \uXXXX to UTF-8,
   a surrogate pair joined, a lone surrogate as U+FFFD (it cannot be UTF-8). \u0000 is left
   as written, because a toke str cannot hold NUL, and so is an escape JSON does not
   define. *)
f=hexdigit(c:i64):i64{
  if(c>=48 && c<=57){ <c-48 }el{};
  if(c>=97 && c<=102){ <c-87 }el{};
  if(c>=65 && c<=70){ <c-55 }el{};
  <0-1
};

f=hex4(s:str;at:i64;n:i64):i64{
  if(at+4>n){ <0-1 }el{};
  let v=mut.0;
  lp(let k=0;k<4;k=k+1){
    let d=hexdigit(str.charat(s;at+k));
    if(d<0){ <0-1 }el{};
    v=v*16+d
  };
  <v
};

f=utf8(cp:i64):str{
  let b=str.buf();
  if(cp<128){
    str.addbyte(b;cp as byte)
  }el{
    if(cp<2048){
      str.addbyte(b;(192+cp/64) as byte);
      str.addbyte(b;(128+cp%64) as byte)
    }el{
      if(cp<65536){
        str.addbyte(b;(224+cp/4096) as byte);
        str.addbyte(b;(128+(cp/64)%64) as byte);
        str.addbyte(b;(128+cp%64) as byte)
      }el{
        str.addbyte(b;(240+cp/262144) as byte);
        str.addbyte(b;(128+(cp/4096)%64) as byte);
        str.addbyte(b;(128+(cp/64)%64) as byte);
        str.addbyte(b;(128+cp%64) as byte)
      }
    }
  };
  <str.done(b)
};

(* The text a one-character escape stands for, or "" when `e` names none (`u` included:
   the caller decodes that). *)
f=simpleescape(e:i64):str{
  if(e==110){ <"\n" }el{};
  if(e==116){ <"\t" }el{};
  if(e==114){ <"\r" }el{};
  if(e==34){ <"\"" }el{};
  if(e==92){ <"\\" }el{};
  if(e==47){ <"/" }el{};
  if(e==98){ <"\x08" }el{};
  if(e==102){ <"\x0c" }el{};
  <""
};

(* The code point of the \u escape whose backslash is at `k`, joined with a following low
   surrogate, times 16, plus the characters it took (6 or 12); -1 when it is not one. *)
f=unicodeat(body:str;k:i64;n:i64):i64{
  let cp=hex4(body;k+2;n);
  if(cp<=0){ <0-1 }el{};
  if(cp<55296 || cp>=57344){ <cp*16+6 }el{};
  if(cp<56320 && str.charat(body;k+6)==92 && str.charat(body;k+7)==117){
    let lo=hex4(body;k+8;n);
    if(lo>=56320 && lo<57344){ <(65536+(cp-55296)*1024+(lo-56320))*16+12 }el{}
  }el{};
  <65533*16+6
};

(* The text of a JSON string's body (the characters between its quotes). *)
f=decodestr(body:str):str{
  if(!str.contains(body;"\\")){ <body }el{};
  let n=str.len(body) as i64;
  let b=str.buf();
  let run=mut.0;
  let k=mut.0;
  lp(let lv=0;k<n;lv=lv){
    if(str.charat(body;k)==92 && k+1<n){
      str.add(b;sliceor(body;run;k));
      let e=str.charat(body;k+1);
      let simple=simpleescape(e);
      let u=mut.0-1;
      if(e==117){ u=unicodeat(body;k;n) }el{};
      if(str.len(simple)>0){
        str.add(b;simple);
        k=k+2
      }el{
        if(u<0){
          str.add(b;sliceor(body;k;k+2));
          k=k+2
        }el{
          str.add(b;utf8(u/16));
          k=k+u%16
        }
      };
      run=k
    }el{
      k=k+1
    }
  };
  str.add(b;sliceor(body;run;n));
  <str.done(b)
};

(* JSON's structural characters and its whitespace: { } [ ] , : space tab LF CR. *)
f=isstructural(c:i64):bool{
  <c==123 || c==125 || c==91 || c==93 || c==44 || c==58 || c==32 || c==9 || c==10 || c==13
};

(* Where the string token whose opening quote is at `from` ends (exclusive), or -1. *)
f=strendat(s:str;from:i64;n:i64):i64{
  let esc=mut.false;
  let end=mut.0-1;
  lp(let k=from+1;k<n && end<0;k=k+1){
    let c=str.charat(s;k);
    if(esc){
      esc=false
    }el{
      if(c==92){ esc=true }el{
        if(c==34){ end=k+1 }el{}
      }
    }
  };
  <end
};

(* Where a run of structure (or, with structural false, a bare value) starting at `from`
   ends: at a quote, or at the first character of the other kind. *)
f=runend(s:str;from:i64;n:i64;structural:bool):i64{
  let end=mut.n;
  lp(let k=from;k<n && end==n;k=k+1){
    let c=str.charat(s;k);
    if(c==34){
      end=k
    }el{
      if(structural){
        if(!isstructural(c)){ end=k }el{}
      }el{
        if(isstructural(c)){ end=k }el{}
      }
    }
  };
  <end
};

(* A JSON text as its tokens, in order and losslessly: each string with its quotes, each
   bare value (number, true, false, null), and each run of structure and whitespace between
   them, so that joining them gives the text back. A string that is never closed answers
   @(): nothing is taken from a text that cannot be read. *)
f=segments(text:str):@str{
  let n=str.len(text) as i64;
  let out=mut.@();
  let k=mut.0;
  lp(let lv=0;k<n;lv=lv){
    let c=str.charat(text;k);
    let e=if(c==34){strendat(text;k;n)}el{runend(text;k;n;isstructural(c))};
    if(e<0){ <@() }el{};
    out=out.push(sliceor(text;k;e));
    k=e
  };
  <out
};

(* ── LS1.1w: typed replacements for std.json's untyped ABI helpers ───────────────
   std.json declares about fifty names in a `gen:"abi"` block: (i64, ...) -> i64, which the
   compiler cannot check, so they accept a str, a handle or a struct alike. The ones below
   have no typed equivalent in std.json at toke 3.1.0 (keys, a top-level array, an array of
   strings, a presence or null test), so they are built here on the typed calls (json.dec,
   json.arr, json.getval) and on the text of `o.raw`. *)

(* Whether `key` is present: json.getval answers "" for an absent key and the value's text,
   never empty, for a present one. *)
f=has(o:$jsonval;key:str):bool{
  <str.len(json.getval(o;key))>0
};

(* Whether `key` is present and holds JSON null. *)
f=isnull(o:$jsonval;key:str):bool{
  <str.eq(json.getval(o;key);"null")
};

(* The elements of a document whose top level is an array, or none when it is not one. *)
f=elemsof(a:$jsonval):@$jsonval{
  <mt json.arr(a;"") {
    $ok:els els;
    $jsonerr:e @()
  }
};

f=arrayof(raw:str):@$jsonval{
  <mt json.dec(raw) {
    $ok:a elemsof(a);
    $jsonerr:e @()
  }
};

(* The string elements of the array at `key`, decoded. An element that is not a string is
   skipped rather than rendered: a caller asking for strings has no use for `3` or `{}`. *)
f=strelems(o:$jsonval;key:str):@str{
  let out=mut.@();
  let els=mt json.arr(o;key) {
    $ok:a a;
    $jsonerr:e @()
  };
  lp(let i=0;i<els.len;i=i+1){
    let item:$jsonval=els.get(i);
    let raw=item.raw;
    let n=str.len(raw) as i64;
    if(n>=2 && str.charat(raw;0)==34 && str.charat(raw;n-1)==34){
      out=out.push(unescape(sliceor(raw;1;n-1)))
    }el{}
  };
  <out
};

(* The top-level keys of an object, decoded, in document order; none when `o` is not an
   object. A key is a string at depth one that follows the opening brace or a comma; a string
   VALUE at depth one follows a colon, so it is never taken for a key. *)
f=keys(o:$jsonval):@str{
  let s=o.raw;
  let n=str.len(s) as i64;
  let out=mut.@();
  let depth=mut.0;
  let instr=mut.false;
  let esc=mut.false;
  let expectkey=mut.false;
  let keystart=mut.0-1;
  lp(let k=0;k<n;k=k+1){
    let c=str.charat(s;k);
    if(esc){ esc=false }el{
      if(instr){
        if(c==92){ esc=true }el{
          if(c==34){
            instr=false;
            if(keystart>=0){
              out=out.push(unescape(sliceor(s;keystart;k)));
              keystart=0-1;
              expectkey=false
            }el{}
          }el{}
        }
      }el{
        if(c==34){
          instr=true;
          if(depth==1 && expectkey){ keystart=k+1 }el{}
        }el{
          if(c==123 || c==91){
            depth=depth+1;
            if(depth==1 && c==123){ expectkey=true }el{}
          }el{
            if(c==125 || c==93){ depth=depth-1 }el{
              if(c==44 && depth==1){ expectkey=true }el{}
            }
          }
        }
      }
    }
  };
  <out
};

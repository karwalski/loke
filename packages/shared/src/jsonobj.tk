m=shared.jsonobj;

i=json:std.json;
i=str:std.str;

f=sliceor(s:str;from:i64;to:i64):str{
  <mt str.slice(s;from as u64;to as u64) {
    $ok:v v;
    $sliceerr:e ""
  }
};

f=objend(s:str;n:i64):i64{
  let depth=mut.0;
  let instr=mut.false;
  let esc=mut.false;
  let end=mut.0-1;
  lp(let k=0;k<n;k=k+1){
    if(end<0){
      let c=str.charat(s;k);
      if(esc){
        esc=false
      }el{
        if(instr){
          if(c==92){ esc=true }el{
            if(c==34){ instr=false }el{}
          }
        }el{
          if(c==34){ instr=true }el{
            if(c==123){ depth=depth+1 }el{
              if(c==125){
                depth=depth-1;
                if(depth==0){ end=k+1 }el{}
              }el{}
            }
          }
        }
      }
    }el{}
  };
  <end
};

f=emptyobj():$json{
  <$json{raw:"{}"}
};

f=nested(o:$json;key:str):$json{
  let needle=str.concat(str.concat("\"";key);"\":");
  let at=str.indexof(o.raw;needle);
  if(at<0){ <emptyobj() }el{};
  let from=at+(str.len(needle) as i64);
  let rest=sliceor(o.raw;from;str.len(o.raw) as i64);
  let e=objend(rest;str.len(rest) as i64);
  if(e<0){ <emptyobj() }el{};
  <$json{raw:sliceor(rest;0;e)}
};

(* ── A JSON zero is not a missing field, and std.json cannot tell them apart ───────
   Measured at 0b0bc4e: every NUMERIC and BOOLEAN accessor in std.json reports `$jsonerr`
   for a falsy value.

     json.i64  on 0      -> $jsonerr        json.i64  on 5    -> $ok 5
     json.u64  on 0      -> $jsonerr        json.f64  on 1.5  -> $ok 1.5
     json.f64  on 0.0    -> $jsonerr        json.bool on true -> $ok true
     json.bool on false  -> $jsonerr        json.str  on ""   -> $ok ""

   Only `json.str` survives, and it survives because an empty string is still a non-null
   pointer. Filed as T-33. Together with T-31 it points at one representation: `X!E` looks to
   be a single machine word carrying the value, with zero standing for the error — which is
   why arms bind by position, why a user-declared error side always takes arm 0, and why a
   legitimate zero reads as a failure.

   Left alone, that makes `nestedi64` report the caller's fallback for a real zero. For the
   providers it happens not to matter — a zero token count and a fallback of 0 agree — but
   "the provider said zero" and "the provider did not say" are different facts, and an audit
   reader that cannot distinguish them cannot tell a free request from an unrecorded one.

   So the error arm asks the text. `fieldiszero` is exact rather than heuristic: JSON forbids
   leading zeros in numbers, so a value whose first character is `0` is `0`, `0.0` or similar
   — it cannot be `07` or `0x10`. A field that is present but not falsy and still errored is
   a genuine type mismatch, and that gets the fallback. *)

f=fieldtail(n:$json;field:str):str{
  let needle=str.concat(str.concat("\"";field);"\":");
  let at=str.indexof(n.raw;needle);
  if(at<0){ <"" }el{};
  let from=at+(str.len(needle) as i64);
  <sliceor(n.raw;from;str.len(n.raw) as i64)
};

f=fieldiszero(n:$json;field:str):bool{
  let rest=fieldtail(n;field);
  if(str.len(rest)==0){ <false }el{};
  let c=str.charat(rest;0);
  if(c==48){ <true }el{};
  (* "-0" and "-0.0" are legal JSON and mean zero. *)
  if(c==45){
    if((str.len(rest) as i64)<2){ <false }el{};
    <str.charat(rest;1)==48
  }el{};
  <false
};

f=nestedi64(o:$json;key:str;field:str;fallback:i64):i64{
  <mt json.i64(nested(o;key);field) {
    $ok:v v;
    $jsonerr:e zeroorfallback(nested(o;key);field;fallback)
  }
};

f=zeroorfallback(n:$json;field:str;fallback:i64):i64{
  if(fieldiszero(n;field)){
    <0
  }el{
    <fallback
  }
};

f=nestedstr(o:$json;key:str;field:str;fallback:str):str{
  <mt json.str(nested(o;key);field) {
    $ok:v v;
    $jsonerr:e fallback
  }
};

f=hasnested(o:$json;key:str):bool{
  <str.len(nested(o;key).raw)>2
};

(* ── Array elements ───────────────────────────────────────────────────────────────
   `json.arr` IS typed — `(Json, str) -> [Json]!JsonErr` — and it works: an element comes
   back as a real `$json` whose `.raw` holds that element's text, so `nested` and the typed
   accessors both apply to it. This is the one part of std.json's object model that is
   reachable, and it is why `elem` exists rather than another text scan.

   Bounds are checked here rather than trusted. `a.get(0)` on an empty array is a read past
   the end, and an empty `choices` array is what a provider returns when it refuses a
   request — a refusal is exactly the case a caller is least likely to have tested. *)

f=elemat(a:@$json;idx:i64):$json{
  if(idx<0){ <emptyobj() }el{};
  if(idx>=(a.len as i64)){ <emptyobj() }el{};
  <a.get(idx)
};

f=elem(o:$json;key:str;idx:i64):$json{
  <mt json.arr(o;key) {
    $ok:a elemat(a;idx);
    $jsonerr:e emptyobj()
  }
};

f=elemstr(o:$json;key:str;idx:i64;field:str;fallback:str):str{
  <mt json.str(elem(o;key;idx);field) {
    $ok:v v;
    $jsonerr:e fallback
  }
};


(* ── Escaping a string INTO JSON ──────────────────────────────────────────────────
   `json.enc` does this correctly and is what to reach for first. This exists because two
   modules needed an escaper that demonstrably works on the values they actually hold:
   `core.memory.export` found `json.enc` returning empty for `db.rowstr` values (cause not
   established — see the note in that file), and `core.mcp.protocol` was interpolating an error
   message between two literal quote characters with no escaping at all, so any provider or
   validation message containing a quote broke the JSON-RPC envelope and the client saw a parse
   error instead of the diagnosis.

   Order is load-bearing. BACKSLASH FIRST: escape the quotes first and the backslash you just
   inserted gets escaped a moment later, turning `\"` into `\\"`. Newlines and tabs matter
   because an error message quoting a prompt, or a memory drawer, is multi-line more often than
   not, and a raw newline inside a JSON string is invalid.

   MK6.13: every other control character, U+0001 to U+001F, is written as \u00XX. JSON forbids
   all of them raw, not only the three above, and Ollama's decoder (Go's encoding/json) answers
   400 to a body holding one, measured at Ollama 0.22.0: "invalid character '\t' in string
   literal". A prompt pasted from a terminal carries ESC (0x1B), and text extracted from a PDF
   carries form feeds. NUL is not handled: a toke str cannot hold one. *)
f=escape(s:str):str{
  let b=str.replace(s;"\\";"\\\\");
  let q=str.replace(b;"\"";"\\\"");
  let n=str.replace(q;"
";"\\n");
  let r=str.replace(n;"\r";"\\r");
  let tb=str.replace(r;"\t";"\\t");
  <"\"\(escapecontrols(tb))\""
};

(* The raw control characters escape leaves to this, and their escapes, index for index. *)
f=controlchars():@str{
  <@("\x01";"\x02";"\x03";"\x04";"\x05";"\x06";"\x07";"\x08";"\x0b";"\x0c";"\x0e";"\x0f";"\x10";"\x11";"\x12";"\x13";"\x14";"\x15";"\x16";"\x17";"\x18";"\x19";"\x1a";"\x1b";"\x1c";"\x1d";"\x1e";"\x1f")
};

f=controlescapes():@str{
  <@("\\u0001";"\\u0002";"\\u0003";"\\u0004";"\\u0005";"\\u0006";"\\u0007";"\\u0008";"\\u000b";"\\u000c";"\\u000e";"\\u000f";"\\u0010";"\\u0011";"\\u0012";"\\u0013";"\\u0014";"\\u0015";"\\u0016";"\\u0017";"\\u0018";"\\u0019";"\\u001a";"\\u001b";"\\u001c";"\\u001d";"\\u001e";"\\u001f")
};

f=escapecontrols(s:str):str{
  let raws=controlchars();
  let escs=controlescapes();
  let out=mut.s;
  lp(let i=0;i<raws.len;i=i+1){
    if(str.contains(out;raws.get(i))){ out=str.replace(out;raws.get(i);escs.get(i)) }el{}
  };
  <out
};

(* ── Decoding a string value, because std.json's accessor loses characters (T-47) ────
   `json.str` unescapes by dropping each backslash and keeping the character after it, so
   `\n` comes back as the letter `n`, `\t` as `t`, and a multi-line memory drawer exported by
   `escape` above is imported as one line with stray letters in it. Measured at `fedd48d`
   (LS1.1k): `"he said \"hi\"\nthen"` read back as `he said "hi"nthen`.

   So the RAW value is taken with `json.getval`, which finds the key with std.json's own
   top-level scanner (a key-shaped string inside another value cannot match), and decoded
   here. `unescape` is the inverse of `escape`: an escaped backslash is parked on \x01 first,
   so `\\n` stays a backslash followed by `n` rather than becoming a newline. \x01 cannot
   occur raw inside a JSON string — control characters must be escaped — so parking on it is
   exact. `\uXXXX` is left as written, except the control characters `escape` writes that way
   (MK6.13): U+0002 to U+001F are decoded. U+0001 is not, because it would come back as the
   parked backslash; `\u0001` is left as written. *)
f=unescape(body:str):str{
  <str.replace(unescapecontrols(str.replace(str.replace(body;"\\\\";"\x01");"\\\"";"\""));"\x01";"\\")
};

f=unescapecontrols(s:str):str{
  <unescapeunicode(str.replace(str.replace(str.replace(str.replace(s;"\\n";"\n");"\\r";"\r");"\\t";"\t");"\\/";"/"))
};

f=unescapeunicode(s:str):str{
  if(str.contains(s;"\\u00")==false){ <s }el{};
  let raws=controlchars();
  let escs=controlescapes();
  let out=mut.s;
  lp(let i=1;i<raws.len;i=i+1){
    if(str.contains(out;escs.get(i))){ out=str.replace(out;escs.get(i);raws.get(i)) }el{}
  };
  <out
};

(* The raw JSON text of the value at `key`, or "" when the key is absent. *)
f=rawvalue(o:$json;key:str):str{
  if(json.has(o;key)==0){ <"" }el{};
  <str.concat("";json.getval(o;key))
};

(* A string field, decoded. `fallback` when absent or not a string. *)
f=strvalue(o:$json;key:str;fallback:str):str{
  let raw=rawvalue(o;key);
  let n=str.len(raw) as i64;
  if(n<2){ <fallback }el{};
  if(str.charat(raw;0)==34){
    if(str.charat(raw;n-1)==34){
      <unescape(sliceor(raw;1;n-1))
    }el{}
  }el{};
  <fallback
};

(* A number field as its JSON text — "0.75", "1790000000" — which is what a SQL parameter
   wants, and which does not go through std.json's numeric accessors: those report a JSON
   zero as an error (T-33). `fallback` when absent or not a number. *)
f=numtext(o:$json;key:str;fallback:str):str{
  let raw=rawvalue(o;key);
  if(str.len(raw)==0){ <fallback }el{};
  let c=str.charat(raw;0);
  if(c==45){ <raw }el{};
  if(c>=48){
    if(c<=57){ <raw }el{}
  }el{};
  <fallback
};

(* ── The raw text of ANY value at a key, not just an object ───────────────────────
   `nested` above brace-matches `{...}`, which is right for a `usage` block and wrong for a
   JSON-RPC `params`, which may be an object, an array, or null.

   This is what `core.mcp.protocol` needed. It was doing

       let paramsraw=json.enc(json.getval(obj;"params"));

   and `json.getval` is one of std.json's untyped `(i64,i64)->i64` helpers while `json.enc`
   takes a `str` — so it rendered the HANDLE. Every MCP request arrived at the tool layer with
   its params replaced by a decimal pointer value, which is why no tool call carrying arguments
   could ever have worked.

   Returns "null" when the key is absent, because that is what a JSON-RPC params field means
   when it is missing and because a caller concatenating this into a document needs something
   syntactically valid rather than an empty gap. *)
f=spanend(s:str;n:i64;openc:i64;closec:i64):i64{
  let depth=mut.0;
  let instr=mut.false;
  let esc=mut.false;
  let end=mut.0-1;
  lp(let k=0;k<n;k=k+1){
    if(end<0){
      let c=str.charat(s;k);
      if(esc){
        esc=false
      }el{
        if(instr){
          if(c==92){ esc=true }el{
            if(c==34){ instr=false }el{}
          }
        }el{
          if(c==34){ instr=true }el{
            if(c==openc){ depth=depth+1 }el{
              if(c==closec){
                depth=depth-1;
                if(depth==0){ end=k+1 }el{}
              }el{}
            }
          }
        }
      }
    }el{}
  };
  <end
};

f=strend(s:str;n:i64):i64{
  let esc=mut.false;
  let end=mut.0-1;
  lp(let k=1;k<n;k=k+1){
    if(end<0){
      let c=str.charat(s;k);
      if(esc){
        esc=false
      }el{
        if(c==92){ esc=true }el{
          if(c==34){ end=k+1 }el{}
        }
      }
    }el{}
  };
  <end
};

(* A bare value — number, true, false, null — ends at the first comma or closing bracket that
   is not inside something else. Leading whitespace has already been skipped by the caller. *)
f=bareend(s:str;n:i64):i64{
  let end=mut.n;
  lp(let k=0;k<n;k=k+1){
    if(end==n){
      let c=str.charat(s;k);
      if(c==44){ end=k }el{
        if(c==125){ end=k }el{
          if(c==93){ end=k }el{}
        }
      }
    }el{}
  };
  <end
};

f=skipws(s:str;n:i64):i64{
  let at=mut.n;
  lp(let k=0;k<n;k=k+1){
    if(at==n){
      let c=str.charat(s;k);
      if(c==32){}el{
        if(c==9){}el{
          if(c==10){}el{
            if(c==13){}el{ at=k }
          }
        }
      }
    }el{}
  };
  <at
};

f=valueraw(o:$json;key:str):str{
  let needle=str.concat(str.concat("\"";key);"\":");
  let at=str.indexof(o.raw;needle);
  if(at<0){ <"null" }el{};
  let from=at+(str.len(needle) as i64);
  let after=sliceor(o.raw;from;str.len(o.raw) as i64);
  let alen=str.len(after) as i64;
  let vs=skipws(after;alen);
  if(vs>=alen){ <"null" }el{};
  let rest=sliceor(after;vs;alen);
  let rlen=str.len(rest) as i64;
  let c=str.charat(rest;0);
  if(c==123){
    let e=spanend(rest;rlen;123;125);
    if(e<0){ <"null" }el{};
    <sliceor(rest;0;e)
  }el{};
  if(c==91){
    let e=spanend(rest;rlen;91;93);
    if(e<0){ <"null" }el{};
    <sliceor(rest;0;e)
  }el{};
  if(c==34){
    let e=strend(rest;rlen);
    if(e<0){ <"null" }el{};
    <sliceor(rest;0;e)
  }el{};
  <sliceor(rest;0;bareend(rest;rlen))
};

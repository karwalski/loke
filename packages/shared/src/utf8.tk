m=shared.utf8;

i=str:std.str;

(* Cutting text to a BYTE limit without splitting a UTF-8 character (F10.48, F10.49).

   loke keeps several byte-limited prefixes of user text: the decision trace's 200 bytes of
   prompt and reply, a memory's 200-byte search excerpt, the queue listing's previews. Each
   was a plain `str.slice(s;0;n)`, and a byte cut can stop inside a 2-, 3- or 4-byte
   character, so a prompt in Japanese or one holding an emoji came out as invalid UTF-8, in
   storage and in JSON. One definition lives here so every cut agrees, and so a fix or a
   regression shows in every caller's test at once.

   The limit stays a byte limit: the result is never longer than it was. The cut moves BACK
   while the byte at it is a continuation byte (10xxxxxx), at most three steps, so it lands
   on the last complete character at or before the limit. A string that is not UTF-8 to
   begin with is cut no worse than before. *)

(* The largest cut at or before `limit` that does not split a character. `limit` past the
   end of `s` gives the length of `s`; a negative one gives 0. *)
f=boundary(s:str;limit:i64):i64{
  let n=str.len(s) as i64;
  if(limit>=n){ <n }el{};
  if(limit<=0){ <0 }el{};
  let cut=mut.limit;
  lp(let k=0;k<3;k=k+1){
    let b=mut.str.charat(s;cut);
    if(b<0){ b=b+256 }el{};
    if(cut>0 && b>=128 && b<192){ cut=cut-1 }el{}
  };
  <cut
};

(* `s` cut to at most `limit` bytes, never inside a character. No marker is added; the
   caller decides whether the cut shows. *)
f=prefix(s:str;limit:i64):str{
  if((str.len(s) as i64)>limit){
    <mt str.slice(s;0;boundary(s;limit)){$ok:okv okv;$err:errv ""}
  }el{
    <s
  }
};

(* True when every lead byte is followed by the right number of continuation bytes and no
   continuation byte stands alone. A STRUCTURAL check, which is what a split character
   breaks; it does not reject overlong 3- and 4-byte forms or surrogates. The callers' tests
   use it to show that a cut output is whole. *)
f=valid(s:str):bool{
  let n=str.len(s) as i64;
  let need=mut.0;
  let ok=mut.true;
  lp(let k=0;k<n;k=k+1){
    let b=mut.str.charat(s;k);
    if(b<0){ b=b+256 }el{};
    if(need>0){
      if(b>=128 && b<192){ need=need-1 }el{ ok=false }
    }el if(b>=128){
      if(b>=194 && b<224){ need=1 }el if(b>=224 && b<240){ need=2 }el if(b>=240 && b<245){ need=3 }el{ ok=false }
    }el{}
  };
  <ok && need==0
};

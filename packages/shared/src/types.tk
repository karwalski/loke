m=shared.types;


t=$sensitivitylevel{
  $public;
  $internal;
  $confidential;
  $restricted
};

t=$provider{
  $anthropic;
  $openai;
  $google;
  $mistral;
  $openrouter;
  $ollama;
  $local
};

t=$modeltier{
  $interactive;
  $considered;
  $background
};

t=$latencytolerance{
  $instant;
  $patient;
  $background
};

t=$piientity{
  entitytype:str;
  value:str;
  start:u32;
  end:u32;
  confidence:f64;
  placeholder:str
};

t=$piidetectionresult{
  original:str;
  anonymised:str;
  entities:@$piientity;
  sensitivity:$sensitivitylevel
};

t=$modelspec{
  id:str;
  provider:$provider;
  contextwindow:u32;
  costper1kinput:f64;
  costper1koutput:f64;
  tier:$modeltier
};

t=$routingdecision{
  model:$modelspec;
  reason:str;
  tier:$modeltier;
  estimatedcost:f64;
  estimatedlatencyms:u32
};

t=$pipelineresult{
  original:str;
  anonymised:str;
  routing:$routingdecision;
  sensitivity:$sensitivitylevel;
  requestid:str
};

t=$lokeerr{
  $configerr(str);
  $modelerr(str);
  $privacyerr(str);
  $storageerr(str);
  $networkerr(str);
  $unknownerr(str)
};

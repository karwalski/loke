m=shared.types;
i=str:std.str;

t=$sensitivitylevel{
  $public:i64;
  $internal:i64;
  $confidential:i64;
  $restricted:i64};

t=$provider{
  $anthropic:i64;
  $openai:i64;
  $google:i64;
  $mistral:i64;
  $openrouter:i64;
  $ollama:i64;
  $local:i64};

t=$tasktype{
  $chat:i64;
  $codegeneration:i64;
  $codereview:i64;
  $summarisation:i64;
  $classification:i64;
  $ner:i64;
  $embedding:i64;
  $dataanalysis:i64};

t=$modeltier{
  $interactive:i64;
  $considered:i64;
  $background:i64};

t=$latencytolerance{
  $instant:i64;
  $patient:i64;
  $background:i64};

t=$piientity{
  entitytype:str;
  value:str;
  start:u32;
  end:u32;
  confidence:f64;
  placeholder:str
};

t=$piidetectionresult{
  original:str;
  anonymised:str;
  entities:@$piientity;
  sensitivity:$sensitivitylevel
};

t=$modelspec{
  id:str;
  provider:$provider;
  contextwindow:u32;
  costper1kinput:f64;
  costper1koutput:f64;
  tier:$modeltier
};

t=$routingdecision{
  model:$modelspec;
  reason:str;
  tier:$modeltier;
  estimatedcost:f64;
  estimatedlatencyms:u32
};

t=$pipelineresult{
  original:str;
  anonymised:str;
  routing:$routingdecision;
  sensitivity:$sensitivitylevel;
  requestid:str
};

t=$risktier{
  $low:i64;
  $medium:i64;
  $high:i64;
  $critical:i64};

t=$policydecision{
  $allow:i64;
  $allowwithwarning:str;
  $requireapproval:str;
  $deny:str
};

t=$lokeerr{
  $configerr:str;
  $modelerr:str;
  $privacyerr:str;
  $storageerr:str;
  $networkerr:str;
  $unknownerr:str
};

f=streq(a:str;b:str):bool{
  str.eq(a;b)
};

f=strlen(s:str):i64{
  str.len(s)
};

f=strconcat(a:str;b:str):str{
  str.concat(a;b)
};

f=strcontains(s:str;sub:str):bool{
  str.contains(s;sub)
};

f=strisempty(s:str):bool{
  str.len(s)=0
};

f=strlower(s:str):str{
  str.lower(s)
};

f=strpad(s:str;width:i64):str{
  str.pad(s;width)
};

f=strslice(s:str;start:i64;end:i64):str{
  str.slice(s;start;end)
};

f=i32tostr(n:i32):str{
  str.fromi32(n)
};

f=f64tostr(n:f64):str{
  str.fromfloat(n)
};

f=f64abs(n:f64):f64{
  if(n<0.0){
    <0.0-n
  }el{
    <n
  }
};

f=nowi64():i64{
  0
};

f=nowms():i64{
  0
};

f=nowunixms():i64{
  0
};

f=arrayget(arr:i64;idx:i64):i64{
  0
};

f=arrayswap(arr:i64;i:i64;j:i64):i64{
  arr
};

f=filtermodels(models:i64;filter:str):i64{
  models
};
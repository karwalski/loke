m=shared.types;
i=str:std.str;
i=time:std.time;
i=std:std;
i=json:std.json;
i=jx:shared.jsonobj;

t=$sensitivitylevel{
  $public:i64;
  $internal:i64;
  $confidential:i64;
  $restricted:i64};

t=$provider{
  $anthropic:i64;
  $openai:i64;
  $google:i64;
  $mistral:i64;
  $openrouter:i64;
  $ollama:i64;
  $local:i64};

t=$tasktype{
  $chat:i64;
  $codegeneration:i64;
  $codereview:i64;
  $summarisation:i64;
  $classification:i64;
  $ner:i64;
  $embedding:i64;
  $dataanalysis:i64};

t=$modeltier{
  $interactive:i64;
  $considered:i64;
  $background:i64};

t=$latencytolerance{
  $instant:i64;
  $patient:i64;
  $background:i64};

t=$piientity{
  entitytype:str;
  value:str;
  start:u32;
  end:u32;
  confidence:f64;
  placeholder:str
};

t=$piidetectionresult{
  original:str;
  anonymised:str;
  entities:@$piientity;
  sensitivity:$sensitivitylevel
};

t=$modelspec{
  id:str;
  provider:$provider;
  contextwindow:u32;
  costper1kinput:f64;
  costper1koutput:f64;
  tier:$modeltier
};

t=$routingdecision{
  model:$modelspec;
  reason:str;
  tier:$modeltier;
  estimatedcost:f64;
  estimatedlatencyms:u32
};

t=$pipelineresult{
  original:str;
  anonymised:str;
  routing:$routingdecision;
  sensitivity:$sensitivitylevel;
  requestid:str
};

t=$risktier{
  $low:i64;
  $medium:i64;
  $high:i64;
  $critical:i64};

(* $allow carries a str like its siblings, not an i64.

   A sum with MIXED payload types crashes when it is matched across a module
   boundary: core.governance.policy.evaluate returns a $policydecision and every
   caller that matched it segfaulted, while the identical match on a locally
   constructed value worked. Making the payloads uniform avoids it. The empty string
   is the "no reason needed" case, which is what allow means. Filed as T-19. *)
t=$policydecision{
  $allow:str;
  $allowwithwarning:str;
  $requireapproval:str;
  $deny:str
};

t=$lokeerr{
  $configerr:str;
  $modelerr:str;
  $privacyerr:str;
  $storageerr:str;
  $networkerr:str;
  $unknownerr:str
};

(* Field names are deliberately unusual. A struct in shared.types is visible to every
   module, and a field called `value` here collided at a different offset with
   core.i18n.translator's own `value`, raising E4034 in a module that has nothing to do
   with floats. Adding a common field name to a widely-imported module is a source-level
   breaking change in toke; `carried` and `hundredths` cannot collide by accident. *)
t=$f64carrier{
  label:str;
  carried:f64;
  hundredths:i64
};


(* These eight wrappers returned NOTHING for as long as they existed.

   Each body was a bare expression with no `<`, so toke evaluated it and discarded the
   result — the same class as T-19's trailing bare `mt`, but with a plain call, which no
   sweep in this repository was looking for. Measured before the fix:

     strlen("abcdef")  -> 0        streq("a";"a")       -> false
     strconcat("ab";"cd") -> ""    strcontains("abc";"b") -> false
     strlower("AB")    -> ""       strslice("abcd";1;3) -> ""
     i32tostr(42)      -> ""       f64tostr(1.5)        -> ""

   `strisempty`, five lines away, has its `<` and always worked — which is why nothing
   looked wrong on a skim.

   What it cost, because these are not decorative: `core/router/escalation.tk` was
   ENTIRELY dead — its ladder never matched, `strlen(x) < 100` was always true since
   strlen returned 0, and its reason string was always empty. `eval/advisor.tk` fell to
   its default on all four branches, `eval/bench.tk` scored every case 0, and
   `latency_router.tk` logged an empty string. Fifteen call sites in five modules, none of
   them doing what they read as doing.

   Keep the `<`. A wrapper in this file is visible to every module in the project, so a
   silent no-op here is a silent no-op everywhere. *)
f=streq(a:str;b:str):bool{
  <str.eq(a;b)
};

f=strlen(s:str):i64{
  <str.len(s)
};

f=strconcat(a:str;b:str):str{
  <str.concat(a;b)
};

f=strcontains(s:str;sub:str):bool{
  <str.contains(s;sub)
};

f=strisempty(s:str):bool{
  <str.len(s)==0
};

f=strlower(s:str):str{
  <str.lower(s)
};

f=strstripregion(s:str;open:str;close:str):str{
  let out=mut."";
  let rest=mut.s;
  lp(let i=0;i<10000;i=i+1){
    let lower=str.lower(rest);
    let a=str.indexof(lower;open);
    if(a<0){
      br
    }el{
      let b=str.indexof(str.slice(lower;a;str.len(lower));close);
      if(b<0){
        br
      }el{
        out=str.concat(out;str.slice(rest;0;a));
        rest=str.slice(rest;a+b+str.len(close);str.len(rest))
      }
    }
  };
  <str.concat(out;rest)
};

f=strbetween(s:str;open:str;close:str):str{
  let a=str.indexof(s;open);
  if(a<0){
    <""
  }el{
    let rest=str.slice(s;a+str.len(open);str.len(s));
    let b=str.indexof(rest;close);
    if(b<0){
      <""
    }el{
      <str.slice(rest;0;b)
    }
  }
};

f=strpad(s:str;width:i64):str{
  let r=mut.s;
  lp(let i=str.len(s);i<width;i=i+1){
    r=str.concat(r;" ")
  };
  <r
};

f=strslice(s:str;start:i64;end:i64):str{
  <str.slice(s;start;end)
};

f=i32tostr(n:i32):str{
  <str.fromint(n)
};

f=f64tostr(n:f64):str{
  <str.fromfloat(n)
};

f=f64abs(n:f64):f64{
  if(n<0.0){
    <0.0-n
  }el{
    <n
  }
};

(* ── The clock ────────────────────────────────────────────────────────────────────
   These three returned a literal **0** for as long as they existed, and 12 call sites across
   8 modules read them. What that cost, measured 2026-09-23:

     eval/bench.tk:158      elapsedms = t.nowms() - startms      -> every benchmark 0 ms
     agents/overnight.tk    finishedat - startedat, printed "Ns"  -> every run "elapsed: 0s"
     agents/pipeline.tk     startedat / finishedat on every run   -> 0
     agents/latency.tk      assignedat                            -> 0
     router/escalation.tk   triggeredat                           -> 0
     feedback/report.tk     createdat                             -> 0
     update/checker.tk      the last-checked stamp                -> 0

   `eval/bench.tk` is the one that matters most, because it is a MEASUREMENT module: any
   latency or throughput figure this project could have published from it was zero by
   construction, not by observation. `docs/metrics-baseline.md` carries no figure from it,
   which is the only reason nothing was published wrongly.

   `std.time.now()` returns **milliseconds** since the epoch — measured, because the stdlib
   interface says only `u64` and the distinction is the whole bug here.

   The units differ between these three and are chosen to match what their callers already
   assume rather than to be tidy:

     nowi64()     SECONDS  — overnight.tk renders `finishedat - startedat` with a literal
                             "s" suffix, so its callers mean seconds. This is also the
                             conventional reading of a bare unix timestamp.
     nowms()      MILLISECONDS — bench.tk names its variable `elapsedms`.
     nowunixms()  MILLISECONDS — a synonym of nowms, kept because escalation.tk calls it.

   A bare `nowi64` says nothing about its unit, which is how this stayed ambiguous; the two
   ms-suffixed names are the ones to prefer in new code. *)
f=nowi64():i64{
  <(time.now() as i64)/1000
};

f=nowms():i64{
  <time.now() as i64
};

f=nowunixms():i64{
  <time.now() as i64
};

f=arrayget(arr:i64;idx:i64):i64{
  <0
};

f=arrayswap(arr:i64;i:i64;j:i64):i64{
  <arr
};

f=filtermodels(models:i64;filter:str):i64{
  <models
};

f=strunquote(s:str):str{
  let n=str.len(s);
  if(n<2){
    <s
  }el{
    if(str.startswith(s;"\"")){
      <str.slice(s;1;n-1)
    }el{
      <s
    }
  }
};

(* The string array at `key`. json.strarr / json.strarray ENCODE a string array; they do not
   read one, and std.json has no typed getter for it. This used json.parsearray, one of
   std.json's untyped ABI helpers, over an i64 handle; it is shared.jsonobj.strelems now, over
   the typed json.arr, which also decodes an escape inside an element (LS1.1w). *)
f=jsonstrarray(obj:$json;key:str):@str{
  <jx.strelems(obj;key)
};

(* $lokeerr is a sum type, so it has no `.message` field — reaching for one is
   what E4034 "no struct in scope declares a field 'message'" was reporting.
   Every variant carries a str, so one match gets it out. *)
f=errmsg(e:$lokeerr):str{
  <mt e {
    $configerr:m m;
    $modelerr:m m;
    $privacyerr:m m;
    $storageerr:m m;
    $networkerr:m m;
    $unknownerr:m m
  }
};

(* Fixed-decimal display formatting. f64tostr gives full precision, which is right
   for data and wrong for a report column. Truncates rather than rounds on purpose:
   a displayed score must not round up past a threshold it did not meet. *)
(* An f64 as an exact integer of hundredths, rounded to nearest.

   It was introduced as the way an f64 crossed a module boundary while T-20 corrupted a bare
   f64 RETURN. toke 3.1.0 fixed that (B5; tests/unit/shared/test_f64_boundary.tk arm B), so a
   function may return its f64 to another module, and f64absfixed, which existed only to keep
   one from crossing, is gone (LS1.1h). This stays for exact integer accounting: the audit
   trail hashes and stores cost as integer cents (core.storage.audit, GA5.15), and hundredths
   of a dollar are cents. *)

(* Rounds, and the half-cent is not a nicety.

   `(n * 100.0) as i64` truncates, and binary floating point means the product is very
   often a hair below the integer it should be: 0.29 becomes 28, 1.15 becomes 114. A
   one-cent error, silently, on a value used to decide whether a spending quota has been
   exceeded (`core/governance/quota.tk` reads limit_cost_usd and used_cost_usd through
   this). Adding half before the cast, with the sign, rounds to nearest instead. *)
(* A struct carrying an f64, returned across a module boundary — the open question.

   T-20 is documented for a bare f64 RETURN: the caller's declaration says i64 while the
   definition says double, so the caller reads the wrong register. What was never
   established is whether an f64 *field inside a returned struct* survives. It matters:
   `core.metrics.collector.summarise` returns a `$metricssummary` whose
   totalcostsavedusd, localratio, cachehitrate and avgsavingpct are all f64 fields, and
   `loke stats` prints all four. If they are corrupted, every figure that command shows is
   wrong.

   A struct crosses as a POINTER, so the f64 is loaded from memory on the far side rather
   than read out of a return register — the mechanism that breaks a bare return does not
   obviously apply. This exists so the answer is measured rather than assumed, and
   tests/unit/shared/test_f64_boundary.tk asserts it. *)
f=makecarrier(v:f64):$f64carrier{
  <$f64carrier{label:"carrier";carried:v;hundredths:f64hundredths(v)}
};

f=f64hundredths(n:f64):i64{
  if(n<0.0){
    <(n * 100.0 - 0.5) as i64
  }el{
    <(n * 100.0 + 0.5) as i64
  }
};

f=f64fixed(n:f64;dp:i64):str{
  let s=str.fromfloat(n);
  let dot=str.indexof(s;".");
  if(dot<0){
    <s
  }el{
    let end=dot+1+dp;
    if(end>str.len(s)){
      <s
    }el{
      <str.slice(s;0;end)
    }
  }
};

(* Sum-type handling, because two toke behaviours make the obvious spellings wrong.

   A bare `$public` in a value position — `let l=mut.$public`, `<$public`,
   `x==$public` — produces a value that crashes when it is matched (SIGTRAP). The
   variant has to be constructed: `$sensitivitylevel{$public:0}`. toke reports
   nothing for the bare form.

   And `==` on two sum values compares the handle, not the variant: a level returned
   from a function does NOT compare equal to an identically-constructed local one, so
   `run.result.sensitivity==$restricted` is false even when the level IS restricted.
   Ranking through a match is total, ordered, and does not depend on where the value
   came from. Both filed as T-13 and T-14 in docs/upstream/toke-issues.md. *)
f=public():$sensitivitylevel{
  <$sensitivitylevel{$public:0}
};

f=internal():$sensitivitylevel{
  <$sensitivitylevel{$internal:0}
};

f=confidential():$sensitivitylevel{
  <$sensitivitylevel{$confidential:0}
};

f=restricted():$sensitivitylevel{
  <$sensitivitylevel{$restricted:0}
};

f=sensrank(s:$sensitivitylevel):i64{
  <mt s {
    $public:v 0;
    $internal:v 1;
    $confidential:v 2;
    $restricted:v 3
  }
};

f=senseq(a:$sensitivitylevel;b:$sensitivitylevel):bool{
  <sensrank(a)==sensrank(b)
};

f=senshigher(a:$sensitivitylevel;b:$sensitivitylevel):bool{
  <sensrank(a)>sensrank(b)
};

f=senslabel(s:$sensitivitylevel):str{
  <mt s {
    $public:v "public";
    $internal:v "internal";
    $confidential:v "confidential";
    $restricted:v "restricted"
  }
};

(* The same ranking for $modeltier, for the same reason (T-14). *)
f=tierrank(m:$modeltier):i64{
  <mt m {
    $interactive:v 0;
    $considered:v 1;
    $background:v 2
  }
};

f=tiereq(a:$modeltier;b:$modeltier):bool{
  <tierrank(a)==tierrank(b)
};

f=interactive():$modeltier{
  <$modeltier{$interactive:0}
};


(* ── Token estimation ─────────────────────────────────────────────────────────────
   Four characters per token. It is a heuristic, it is the standard one, and it is stated
   as an estimate everywhere it is used — a budget guard and a pre-flight cost figure are
   both allowed to be approximate, and the AUDIT row is not: that carries the count the
   provider itself reported (core.providers.*.buildresponse).

   `core.memory.context.estimatetokens` was the same two lines, and a second copy of a
   heuristic is how two parts of a system come to disagree about what a budget means. It
   delegates here now.

   Returns u32. *)
f=esttokens(s:str):u32{
  <str.len(s)/4
};


(* ── Home-relative paths, because `~` is NOT expanded ─────────────────────────────
   Measured at toke fedd48d: `file.exists("~/.loke/x")` is **false** while
   `file.exists("/Users/<me>/.loke/x")` is true for the same file, and
   `file.appendline("~/.loke/x"; ...)` writes NOTHING — it neither reaches $HOME nor creates a
   literal `~` directory in the working directory. The tilde is a shell convention; nothing in
   the path layer expands it.

   29 string literals in this repository began with `~/`, and the two that mattered most:

     shared/log.tk  x4   every log.debug/info/warn/error appended to "~/.loke/loke.log"
                         -> **loke has never written a log file.** Every log line this project
                         has ever emitted was silently discarded, which is why nothing here has
                         ever been diagnosed from logs.
     shared/config.tk     defaultconfig().datadir was "~/.loke", so the default store path was
                         a literal `./~/.loke/loke.db`.

   Also: `cli/doctor.tk` tested `file.exists("~/.loke")` and so reported the data directory and
   the config file MISSING on a correct installation; `agents/templates.tk` granted a sandbox
   permission scoped to `$readfile("~/.loke/")`, which can never match a real path, so the
   permission never granted; and three call sites loaded `"~/.loke/config.toml"`, so a user's
   configuration file was never read at all.

   Use these rather than concatenating `std.homedir()` by hand, so there is one place to change
   if a datadir ever becomes configurable. A literal `~` is still correct in text SHOWN to a
   user — `"~/.loke/ exists"` in a doctor report is the right thing to print. *)
f=homepath(rel:str):str{
  <str.concat(std.homedir();rel)
};

f=lokedir():str{
  <homepath("/.loke")
};

f=lokefile(name:str):str{
  <homepath(str.concat("/.loke/";name))
};

f=configpath():str{
  <lokefile("config.toml")
};


(* ── Micro-units, and integer statistics over them ────────────────────────────────
   1e6, so six decimal places survive exactly in an i64 (±9.2e12 whole units).
   `f64hundredths` above is the same idea at 1e2 for currency; this is the scale to reach for
   when the value is a measurement rather than money.

   Two toke defects first forced them, and both are fixed: T-20 (a bare f64 RETURN corrupted
   across a module boundary; fixed in 3.1.0, LS1.1h) and T-37 (invalid IR for anything
   declared `@f64`; fixed before 3.0.0). They are kept for the reason below, which never
   depended on either.

   The statistics are worth having as integers on their own terms:
   `math.mean` over f64 accumulates error across rows and integer summation does not. *)
f=f64micro(n:f64):i64{
  if(n<0.0){
    <(n*1000000.0-0.5) as i64
  }el{
    <(n*1000000.0+0.5) as i64
  }
};

f=micro2f64(n:i64):f64{
  <(n as f64)/1000000.0
};

(* An empty array has no minimum. Returning 0 would be a value the caller cannot distinguish
   from a real zero, so the caller must check `.len` first — as both current callers do. *)
f=i64min(ns:@i64):i64{
  if(ns.len==0){ <0 }el{};
  let lo=mut.ns.get(0);
  lp(let i=1;i<ns.len;i=i+1){
    if(ns.get(i)<lo){ lo=ns.get(i) }el{}
  };
  <lo
};

f=i64max(ns:@i64):i64{
  if(ns.len==0){ <0 }el{};
  let hi=mut.ns.get(0);
  lp(let i=1;i<ns.len;i=i+1){
    if(ns.get(i)>hi){ hi=ns.get(i) }el{}
  };
  <hi
};

f=i64sum(ns:@i64):i64{
  let total=mut.0;
  lp(let i=0;i<ns.len;i=i+1){
    total=total+ns.get(i)
  };
  <total
};

f=i64mean(ns:@i64):i64{
  if(ns.len==0){ <0 }el{};
  <i64sum(ns)/(ns.len as i64)
};

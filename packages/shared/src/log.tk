m=shared.log;

i=str:std.str;
i=file:std.file;
i=t:shared.types;
i=san:core.privacy.logsanitiser;

t=$loglevel{
  $lvldebug:i64;
  $lvlinfo:i64;
  $lvlwarn:i64;
  $lvlerror:i64};

t=$logentry{
  level:$loglevel;
  msg:str;
  correlationid:str;
  component:str;
  timestamp:str
};

f=newcorrelationid():str{
  let id=str.randhex(16);
  <id
};

(* ── Writing a log line, and the two independent reasons none was ever written ────

   **1. The path.** These four functions appended to the literal `"~/.loke/loke.log"`, and the
   tilde is never expanded by the path layer — measured: `file.appendline("~/.loke/x"; ...)`
   writes nothing, neither to `$HOME` nor to a literal `~` directory. (LS1.1q.)

   **2. The function.** `file.appendline` is declared `(i64, i64) -> i64` — it is one of
   `std.file`'s UNTYPED helpers, the same family as the `json.getval` that segfaults on a typed
   `$json` (T-32). It was being handed two `str` values. The TYPED function is
   `file.append(str, str) -> bool!FileErr`, and that is what this uses.

   Either alone was enough. Together they mean **loke has never written a log file at any
   level**, for its whole existence — every line this project has ever emitted was silently
   discarded, which is why nothing here has ever been diagnosed from a log.

   The directory is created on each write rather than assumed. On a fresh installation
   `~/.loke` does not exist until `loke init` or the first `openstore`, and log lines are
   emitted before and independently of both — a logger that needs someone else to have run
   first is a logger that is silent exactly when it is wanted. `file.mkdir` on an existing
   directory returns an error, which is why its result is matched and dropped rather than
   checked.

   Both results ARE matched rather than discarded, `$ok` first (T-31: arms bind by position).
   Nothing is done with a write failure on purpose: a logger that logs its own failure to log
   is a loop, and one that returns an error upward makes every call site handle something it
   cannot act on. The write is best-effort, and `tests/unit/shared/test_log_writes.tk` is what
   establishes that it works. *)
f=writeline(line:str):void{
  mt file.mkdir(t.lokedir()) {
    $ok:v true;
    $err:e false
  };
  mt file.append(t.lokefile("loke.log");str.concat(line;"
")) {
    $ok:v true;
    $err:e false
  };
  <void
};

f=logpath():str{
  <t.lokefile("loke.log")
};

f=debug(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvldebug:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  writeline("[DEBUG] \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

f=info(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvlinfo:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  writeline("[INFO]  \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

f=warn(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvlwarn:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  writeline("[WARN]  \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

f=error(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvlerror:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  writeline("[ERROR] \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

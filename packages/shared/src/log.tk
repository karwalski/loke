m=shared.log;

i=str:std.str;
i=file:std.file;

t=$loglevel{
  $debug:i64;
  $info:i64;
  $warn:i64;
  $error:i64};

t=$logentry{
  level:$loglevel;
  msg:str;
  correlationid:str;
  component:str;
  timestamp:str
};

f=newcorrelationid():str{
  let id=str.randhex(16);
  <id
};

f=debug(msg:str;component:str;correlationid:str):void{
  let entry=$logentry{
    level:$debug;
    msg:msg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline("~/.loke/loke.log";str.format("[DEBUG] {} {} {}: {}";entry.timestamp;entry.component;entry.correlationid;entry.msg));
  <void
};

f=info(msg:str;component:str;correlationid:str):void{
  let entry=$logentry{
    level:$info;
    msg:msg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline("~/.loke/loke.log";str.format("[INFO]  {} {} {}: {}";entry.timestamp;entry.component;entry.correlationid;entry.msg));
  <void
};

f=warn(msg:str;component:str;correlationid:str):void{
  let entry=$logentry{
    level:$warn;
    msg:msg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline("~/.loke/loke.log";str.format("[WARN]  {} {} {}: {}";entry.timestamp;entry.component;entry.correlationid;entry.msg));
  <void
};

f=error(msg:str;component:str;correlationid:str):void{
  let entry=$logentry{
    level:$error;
    msg:msg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline("~/.loke/loke.log";str.format("[ERROR] {} {} {}: {}";entry.timestamp;entry.component;entry.correlationid;entry.msg));
  <void
};

m=shared.log;

i=str:std.str;
i=file:std.file;
i=t:shared.types;
i=san:core.privacy.logsanitiser;

t=$loglevel{
  $lvldebug:i64;
  $lvlinfo:i64;
  $lvlwarn:i64;
  $lvlerror:i64};

t=$logentry{
  level:$loglevel;
  msg:str;
  correlationid:str;
  component:str;
  timestamp:str
};

f=newcorrelationid():str{
  let id=str.randhex(16);
  <id
};

(* `t.lokefile("loke.log")`, not `"~/.loke/loke.log"`. The tilde is not expanded by the path
   layer — measured: `file.appendline("~/.loke/x"; ...)` writes nothing, neither to $HOME nor to
   a literal `~` directory. So **every log line this project has ever emitted was silently
   discarded**, at all four levels, which is why nothing here has ever been diagnosed from a
   log file. See shared.types.homepath. *)
f=debug(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvldebug:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline(t.lokefile("loke.log");"[DEBUG] \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

f=info(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvlinfo:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline(t.lokefile("loke.log");"[INFO]  \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

f=warn(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvlwarn:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline(t.lokefile("loke.log");"[WARN]  \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

f=error(msg:str;component:str;correlationid:str):void{
  let safemsg=san.sanitise(msg);
  let entry=$logentry{
    level:$loglevel{$lvlerror:0};
    msg:safemsg;
    correlationid:correlationid;
    component:component;
    timestamp:str.nowiso8601()
  };
  file.appendline(t.lokefile("loke.log");"[ERROR] \(entry.timestamp) \(entry.component) \(entry.correlationid): \(entry.msg)");
  <void
};

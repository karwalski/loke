m=shared.errors;

i=str:std.str;
i=t:shared.types;

f=format(err:$lokeerr):str{
  mt err {
    $configerr:v str.concat("config error: ";v);
    $modelerr:v str.concat("model error: ";v);
    $privacyerr:v str.concat("privacy error: ";v);
    $storageerr:v str.concat("storage error: ";v);
    $networkerr:v str.concat("network error: ";v);
    $unknownerr:v str.concat("unknown error: ";v)
  }
};

f=iscritical(err:$lokeerr):bool{
  mt err {
    $privacyerr:v true;
    $storageerr:v true;
    $configerr:v false;
    $modelerr:v false;
    $networkerr:v false;
    $unknownerr:v false
  }
};

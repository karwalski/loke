m=shared.reachability;

i=str:std.str;
i=net:std.net;

(* Local sidecar reachability.

   http.get cannot answer this. Against a closed port it returns $ok carrying a NIL
   response, so the $err arm never runs and reading .status is an unguardable nil
   dereference — a toke program cannot tell "the service replied" from "nothing is
   listening". That is why core.privacy.ner.isavailable and presidio.isavailable both
   returned TRUE against a dead port, which is the fail-open NC1.9 exists to close:
   the pipeline believed both layers were healthy, called them, and crashed. Filed as
   T-15 in docs/upstream/toke-issues.md.

   net.portavailable answers the inverse question honestly: it tries to BIND the port,
   so a successful bind means nothing is listening. That only works for localhost,
   which is all that is needed — Presidio, Ollama and LLMLingua are local sidecars, and
   loke is local-first by design. A remote provider is checked by its response, not by
   a pre-flight probe. *)
f=urlport(url:str):i64{
  let afterscheme=mut.url;
  let schemeat=str.indexof(url;"://");
  if(schemeat<0){}el{
    afterscheme=str.slice(url;schemeat+3;str.len(url))
  };
  let colon=str.lastindex(afterscheme;":");
  if(colon<0){
    (* No explicit port: assume the scheme's default. *)
    if(str.startswith(url;"https")){
      <443
    }el{
      <80
    }
  }el{
    let rest=str.slice(afterscheme;colon+1;str.len(afterscheme));
    let slash=str.indexof(rest;"/");
    let digits=mut.rest;
    if(slash<0){}el{
      digits=str.slice(rest;0;slash)
    };
    <str.toint(digits)
  }
};

f=islocalurl(url:str):bool{
  <str.contains(url;"127.0.0.1") || str.contains(url;"localhost") || str.contains(url;"[::1]")
};

(* True when a local service is listening on the URL's port. For a non-local URL this
   returns true, because binding a remote port is not something we can test and
   pretending otherwise would refuse every hosted provider. *)
f=localserviceup(url:str):bool{
  if(islocalurl(url)){
    <net.portavailable(urlport(url) as i32)==0
  }el{
    <true
  }
};


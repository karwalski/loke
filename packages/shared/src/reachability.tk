m=shared.reachability;

i=str:std.str;
i=net:std.net;
i=http:std.http;
i=process:std.process;
i=io:std.io;

(* Local sidecar reachability.

   http.get cannot answer this. Against a closed port it returns $ok carrying a NIL
   response, so the $err arm never runs and reading .status is an unguardable nil
   dereference — a toke program cannot tell "the service replied" from "nothing is
   listening". That is why core.privacy.ner.isavailable and presidio.isavailable both
   returned TRUE against a dead port, which is the fail-open NC1.9 exists to close:
   the pipeline believed both layers were healthy, called them, and crashed. Filed as
   T-15 in docs/upstream/toke-issues.md.

   net.portavailable answers the inverse question honestly: it tries to BIND the port,
   so a successful bind means nothing is listening. That only works for localhost,
   which is all that is needed — Presidio, Ollama and LLMLingua are local sidecars, and
   loke is local-first by design. A remote provider is checked by its response, not by
   a pre-flight probe. *)
f=urlport(url:str):i64{
  let afterscheme=mut.url;
  let schemeat=str.indexof(url;"://");
  if(schemeat<0){}el{
    afterscheme=mt str.slice(url;schemeat+3;str.len(url)){$ok:okv okv;$err:errv ""}
  };
  let colon=str.lastindex(afterscheme;":");
  if(colon<0){
    (* No explicit port: assume the scheme's default. *)
    if(str.startswith(url;"https")){
      <443
    }el{
      <80
    }
  }el{
    let rest=mt str.slice(afterscheme;colon+1;str.len(afterscheme)){$ok:okv okv;$err:errv ""};
    let slash=str.indexof(rest;"/");
    let digits=mut.rest;
    if(slash<0){}el{
      digits=mt str.slice(rest;0;slash){$ok:okv okv;$err:errv ""}
    };
    <mt str.toint(digits){$ok:okv okv;$err:errv 0}
  }
};

(* True only when the URL's HOST is exactly a loopback name: 127.0.0.1, localhost or [::1].
   islocalurl below is a substring test, so it also accepts `http://localhost.example.com`
   and `http://127.0.0.1.example.net`. That is tolerable for a reachability probe and not for
   deciding where a prompt may be sent in clear, which is what the detection layers use this
   for (VM1.6e). *)
f=isloopbackurl(url:str):bool{
  let rest=mut.url;
  let schemeat=str.indexof(url;"://");
  if(schemeat<0){}el{
    rest=mt str.slice(url;schemeat+3;str.len(url)){$ok:okv okv;$err:errv ""}
  };
  let slash=str.indexof(rest;"/");
  if(slash<0){}el{
    rest=mt str.slice(rest;0;slash){$ok:okv okv;$err:errv ""}
  };
  (* rest is now host[:port]. A bracketed IPv6 host keeps its brackets. *)
  if(str.startswith(rest;"[::1]")){
    <str.len(rest)==5 || str.startswith(rest;"[::1]:")
  }el{};
  let host=mut.rest;
  let colon=str.indexof(rest;":");
  if(colon<0){}el{
    host=mt str.slice(rest;0;colon){$ok:okv okv;$err:errv ""}
  };
  <str.eq(host;"127.0.0.1") || str.eq(host;"localhost")
};

f=islocalurl(url:str):bool{
  <str.contains(url;"127.0.0.1") || str.contains(url;"localhost") || str.contains(url;"[::1]")
};

(* True when a local service is listening on the URL's port. For a non-local URL this
   returns true, because binding a remote port is not something we can test and
   pretending otherwise would refuse every hosted provider. *)
(* A TCP connect, through `nc -z`, which exits 0 when something accepts. std.net has no
   connect call. The bind probe below is not enough on its own. Measured 2026-09-25:
   net.portavailable(11430) answered "free" while loke was LISTENING on 11430, because
   toke's server binds the wildcard address with SO_REUSEPORT, and a second bind on
   loopback succeeds alongside it. Every toke and ooke server does this, loke and moke
   included, so moke believed loke was down and never sent it a request. *)
f=connects(port:i64):bool{
  (* 0 is the NULL handle: a spawn that fails is seen here. The check was `h == @()`, which
     an array == (an address compare) never satisfies (F10.44). *)
  let h=mt process.spawn(@("nc";"-z";"-G";"1";"127.0.0.1";str.fromint(port))) {
    $ok:h h;
    $err:e 0
  };
  if(h==0){ <false }el{};
  <(process.wait(h) as i64)==0
};

f=localserviceup(url:str):bool{
  if(islocalurl(url)){
    let port=urlport(url);
    (* The bind probe answers "in use" reliably, so trust that. Its "free" is confirmed by
       connecting, which also sees SO_REUSEPORT listeners. *)
    if(net.portavailable(port as i32)==0){ <true }el{};
    <connects(port)
  }el{
    <true
  }
};

(* POST a JSON body to a LOCAL service and answer the response text, or "" when there is no
   usable answer.

   This exists because three call sites used `http.post(url;body)` to do this, and in std.http
   `http.post` is not a client call. It REGISTERS A SERVER ROUTE, `(path, handler)`. So moke's
   pipeline and stream handlers registered a route whose "handler" was the JSON request body.
   The worker then crashed in strlen on the body's bytes read as a pointer (0x6f7270223a2272
   is `r":"pro`). moke never reached loke at all. core.router.routellm did the same.

   Reachability is checked first, because against a closed port the HTTP client answers
   as if it had succeeded, with nothing in it (T-15). *)
f=localpost(baseurl:str;path:str;body:str):str{
  if(!localserviceup(baseurl)){ <"" }el{};
  (* http.posturl, the call core's Ollama dispatch uses and the one measured to reach a
     server. http.client + http.postheaders was measured on 2026-09-25 to send NOTHING from
     a test binary or from moke: four targets, including the exact request that works
     through posturl, and none arrived (T-48). *)
  let raw:str=http.posturl(str.concat(baseurl;path);body);
  <raw
};

(* GET a path from a LOCAL service and answer the response body, or "" when there is no
   usable answer. The GET counterpart of localpost. (VM1.6e)

   It exists because seven call sites wrote `http.get(http.client(base);path)`, and toke
   chooses what `http.get` means by its ARGUMENT COUNT: one argument is a client GET
   (tk_http_get_w, answering the body), two arguments REGISTER A SERVER ROUTE
   (tk_http_get_handler), exactly as `http.post` does. Measured 2026-09-27 against
   scripts/lib/http_recorder.py: the two-argument form sent nothing, ever. Registration
   returns 0, which a match reads as $err, so every health check built on it reported an
   answering service as down: `loke doctor` said Ollama was not running while it answered,
   and the privacy pipeline skipped Presidio and NER as unreachable. Worse, the table holds
   256 routes; once it is full registration returns -1, which reads as $ok, and the same
   checks then answer "available" for a service no request has reached. See T-57 in
   docs/upstream/toke-issues.md.

   An empty 200 reads as no answer. Every service loke asks this of answers /health or
   /api/tags with a body, so that is the safe reading. A service answering 500 with a body
   reads as up; callers that need more than "something answered" parse the body.

   toke 3.1.0 (F10.39) retired the one-argument `http.get(url)` (E4026) and made the
   two-argument form a type error when handed a client (E4031). The client GET is
   `http.clientget`, whose `$err` is a transport failure and whose `$ok` carries the status.
   The body is answered whatever the status, as the one-argument form did: `http.geturl`
   would have turned a 4xx/5xx into "", and a caller that reads an error body (Ollama
   answers a missing model with one) would have lost it. A body that is not valid UTF-8 is
   no answer. *)
f=localget(baseurl:str;path:str):str{
  if(!localserviceup(baseurl)){ <"" }el{};
  <mt http.clientget(http.client(baseurl);path) {
    $ok:r mt str.frombytes(r.body) { $ok:s s; $err:e "" };
    $err:e ""
  }
};

(* True when a local service answers a GET on `path` with a body. *)
f=localanswers(baseurl:str;path:str):bool{
  <str.len(localget(baseurl;path))>0
};

(* DELETE with a JSON body to a LOCAL service; true when it answered. (VM1.6d)

   std.http has no client DELETE at this toolchain: posturl is POST only, and
   `http.deletehandler` registers a route. Ollama's /api/delete accepts DELETE and nothing
   else, so a POST there is refused. This uses `curl`, which ships with macOS and every
   mainstream Linux, the same way connects() uses `nc`. The body is passed as one argv
   element, never through a shell. *)
f=localdelete(baseurl:str;path:str;body:str):bool{
  if(!localserviceup(baseurl)){ <false }el{};
  let h=mt process.spawn(@("curl";"-s";"-f";"-m";"10";"-X";"DELETE";"-H";"content-type: application/json";"--data-binary";body;str.concat(baseurl;path))) {
    $ok:h h;
    $err:e 0
  };
  if(h==0){ <false }el{};
  <(process.wait(h) as i64)==0
};

(* A loopback port nothing is listening on, for a test that needs a dead endpoint. (X8.12)

   Tests used fixed ports 59991-59999 as "nothing listening". Those sit in the OS ephemeral
   range, so the kernel may hand one to any program: on a developer Mac an editor language
   server held 127.0.0.1:59996, and tests/integration/test_local_requests.tk failed five
   assertions with nothing in loke changed.

   The clean answer is to bind port 0 and read back the number the OS chose, but std.net at
   toke 3.2.0 cannot: net.listen answers a socket and no call reads its port. So this probes
   candidates instead and answers the first that is free by BOTH tests: the bind probe (an
   exclusive listener answers "in use") and a connect (which also sees the SO_REUSEPORT
   listeners the bind probe misses, see connects above). The candidates, 29400-29499, are
   below both the Linux (32768-60999) and the macOS (49152-65535) ephemeral ranges, so the
   OS never hands one out to a client socket; a server someone starts there is caught by
   the probe. A port found dead may still be taken before the test uses it; that window is
   milliseconds, not the whole life of an unrelated program.

   If no candidate is free the machine cannot run the test honestly. That is a broken
   precondition, not a product failure, so it says so on stderr and exits 77 rather than
   letting the test report an assertion about loke that loke did not fail. *)
f=deadportfrom(start:i64):i64{
  let found=mut.0;
  lp(let p=start;p<29500 && found==0;p=p+1){
    if(net.portavailable(p as i32)!=0 && !connects(p)){ found=p }el{}
  };
  if(found==0){
    io.eprint("PRECONDITION FAILED (X8.12), not a product failure: every loopback port from \(start) to 29499 is in use, so no test can rely on a dead endpoint here\n");
    process.exit(77)
  }el{};
  <found
};

f=deadport():i64{
  <deadportfrom(29400)
};

(* A second dead port, distinct from `after`, for a test that must tell two endpoints apart. *)
f=nextdeadport(after:i64):i64{
  <deadportfrom(after+1)
};

f=deadurl():str{
  <"http://127.0.0.1:\(deadport())"
};

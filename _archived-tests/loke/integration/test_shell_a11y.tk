m=tests.integration.testshella11y;

i=shell:browser.shell;
i=focus:loke.platform.a11y.focus;
i=keyboard:loke.platform.a11y.keyboard;
i=live:loke.platform.a11y.liveregions;
i=colour:loke.platform.a11y.colour;
i=skip:loke.platform.a11y.skiplink;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  let html=shell.a11yhtml();

  results=str.arraypush(results;asserttrue(
    "a11y_html contains skip link";
    str.contains(html;"skip-link")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_html skip link targets main-content";
    str.contains(html;"#main-content")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_html skip link has text";
    str.contains(html;"Skip to main content")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_html contains polite live region";
    str.contains(html;"aria-live-polite")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_html contains assertive live region";
    str.contains(html;"aria-live-assertive")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_html live regions have sr-only class";
    str.contains(html;"sr-only")
  ));

  let skippos=str.indexof(html;"skip-link");
  let livepos=str.indexof(html;"aria-live");
  results=str.arraypush(results;asserttrue(
    "skip link before live regions";
    skippos<livepos
  ));

  let css=shell.a11ycss();

  results=str.arraypush(results;asserttrue(
    "a11y_css contains sr-only";
    str.contains(css;".sr-only")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_css sr-only has clip rect";
    str.contains(css;"clip: rect(0")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_css contains prefers-reduced-motion";
    str.contains(css;"prefers-reduced-motion")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_css motion has animation-duration override";
    str.contains(css;"animation-duration: 0.01ms")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_css contains focus-visible";
    str.contains(css;":focus-visible")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_css focus-visible has outline";
    str.contains(css;"outline: 2px solid")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_css contains skip-link styles";
    str.contains(css;".skip-link")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_css contains prefers-contrast";
    str.contains(css;"prefers-contrast: more")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_css has Canvas system colour";
    str.contains(css;"Canvas")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_css has ButtonFace system colour";
    str.contains(css;"ButtonFace")
  ));

  let js=shell.a11yjs();

  results=str.arraypush(results;asserttrue(
    "a11y_js contains keyboard nav console log";
    str.contains(js;"a11y: keyboard navigation active")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js contains Escape handler";
    str.contains(js;"Escape")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_js contains loke_focus_trap";
    str.contains(js;"loke_focus_trap")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js contains loke_focus_release";
    str.contains(js;"loke_focus_release")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js contains loke_save_focus";
    str.contains(js;"loke_save_focus")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js contains loke_restore_focus";
    str.contains(js;"loke_restore_focus")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js contains loke_route_focus";
    str.contains(js;"loke_route_focus")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_js contains loke_announce";
    str.contains(js;"loke_announce")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_js contains popstate handler";
    str.contains(js;"popstate")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js contains pushState override";
    str.contains(js;"pushState")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js contains replaceState override";
    str.contains(js;"replaceState")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js announces navigation";
    str.contains(js;"Navigated to")
  ));

  results=str.arraypush(results;asserttrue(
    "a11y_js contains skip-to-main handler";
    str.contains(js;"skip-to-main")
  ));
  results=str.arraypush(results;asserttrue(
    "a11y_js skip link sets tabindex";
    str.contains(js;"tabindex")
  ));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i<n){
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed=false){ all=false }el{};
      i=i+1
    }el{
      br
    }
  };
  <all
};

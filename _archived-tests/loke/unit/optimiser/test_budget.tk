m=tests.unit.optimiser.testbudget;

i=budget:optimiser.budget;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let defaults=budget.defaultlimits();
  results=str.arraypush(results;asserttrue("default limits non-empty";str.arraylen(defaults) > 0));

  let firstlim=str.arrayget(defaults;0);
  results=str.arraypush(results;asserttrue("daily max_tokens 100000";firstlim.maxtokens = 100000));

  results=str.arraypush(results;asserttrue("daily max_cost_usd 5.0";firstlim.maxcostusd = 5.0));

  results=str.arraypush(results;asserttrue("daily warn_at_pct 80.0";firstlim.warnatpct = 80.0));

  let mgr=budget.new(defaults);
  results=str.arraypush(results;asserttrue("manager usage count matches limits";str.arraylen(mgr.usage) = str.arraylen(mgr.limits)));

  let firstusg=str.arrayget(mgr.usage;0);
  results=str.arraypush(results;asserttrue("initial tokens_used is 0";firstusg.tokensused = 0));

  results=str.arraypush(results;asserttrue("initial cost_usd is 0.0";firstusg.costusd = 0.0));

  results=str.arraypush(results;asserttrue("initial request_count is 0";firstusg.requestcount = 0));

  let chkzero=budget.check(mgr;0;0.0);
  results=str.arraypush(results;asserttrue("zero tokens allowed";chkzero.allowed));

  let chksmall=budget.check(mgr;1000;0.05);
  results=str.arraypush(results;asserttrue("small request allowed";chksmall.allowed));

  results=str.arraypush(results;asserttrue("tokens remaining 99000";chksmall.tokensremaining = 99000));

  let tightlimit=$budgetlimit{
    period:$daily;
    maxtokens:1000;
    maxcostusd:1.0;
    warnatpct:80.0
  };
  let tightmgr=budget.new(@(tightlimit));
  let chkexceed=budget.check(tightmgr;1001;0.01);
  results=str.arraypush(results;assertfalse("exceeding token limit not allowed";chkexceed.allowed));

  results=str.arraypush(results;asserttrue("tokens_remaining 0 when exceeded";chkexceed.tokensremaining = 0));

  results=str.arraypush(results;asserttrue("reason non-empty on exceed";str.len(chkexceed.reason) > 0));

  results=str.arraypush(results;asserttrue("reason mentions token";str.contains(chkexceed.reason;"token")));

  let chkcost=budget.check(tightmgr;500;1.01);
  results=str.arraypush(results;assertfalse("exceeding cost limit not allowed";chkcost.allowed));

  let chkok=budget.check(tightmgr;500;0.40);
  results=str.arraypush(results;asserttrue("within budget reason";str.eq(chkok.reason;"within budget")));

  let fmt=budget.formatusage(mgr);
  results=str.arraypush(results;asserttrue("format_usage non-empty";str.len(fmt) > 0));

  results=str.arraypush(results;asserttrue("format_usage contains daily";str.contains(fmt;"daily")));

  results=str.arraypush(results;asserttrue("format_usage contains tokens";str.contains(fmt;"tokens")));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i+1 }el{ let all = false; i = i+1 }
    }
  };
  <all
};

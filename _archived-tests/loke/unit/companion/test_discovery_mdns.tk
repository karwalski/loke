
m=tests.unit.companion.testdiscoverymdns;

i=disc:companion.discovery;
i=str:std.str;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{ <fail(name;"want=" + want + " got=" + got) };
};

f=asserttrue(name:$str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;val:bool):$result{
  if(!val){ <pass(name) }el{ <fail(name;"expected false") };
};

f=asserteqi32(name:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{ <fail(name;"want=" + str.fromi32(want) + " got=" + str.fromi32(got)) };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info("PASS " + r.name) }el{ log.error("FAIL " + r.name + ": " + r.message) };
};

f=testnewstate():$result{
  let state=disc.newstate();
  let r1=assertfalse("new_state.browsing";state.browsing);
  if(!r1.passed){ <r1 }el{};
  <asserteqi32("new_state.devices.len";state.devices.len();0)
};

f=testonfound():$result{
  let state=disc.newstate();
  let updated=disc.onfound(state;"dev-001";"My Companion";"192.168.1.50";9443;"macos");
  let r1=asserteqi32("on_found.devices.len";updated.devices.len();1);
  if(!r1.passed){ <r1 }el{};
  let dev=updated.devices.get(0);
  let r2=asserteq("on_found.id";dev.id;"dev-001");
  if(!r2.passed){ <r2 }el{};
  let r3=asserteq("on_found.host";dev.host;"192.168.1.50");
  if(!r3.passed){ <r3 }el{};
  let r4=asserteq("on_found.status";dev.status;"discovered");
  if(!r4.passed){ <r4 }el{};
  <assertfalse("on_found.paired";dev.paired)
};

f=testconfirmationcode():$result{
  let state=disc.newstate();
  let updated=disc.onfound(state;"device-abc";"Test";"10.0.0.1";9443;"linux");
  let code=disc.getconfirmationcode(updated;"device-abc");
  let codestr=mt code { $some:c c; $none:v "" };
  let len=str.len(codestr);
  if(str.eq(codestr;"")){
    <fail("confirmation_code";"expected some, got none")
  }el{
    if(len = 6){
      <pass("confirmation_code.length")
    }el{
      <fail("confirmation_code.length";str.concat("expected 6 digits, got ";str.fromi32(len)))
    }
  }
};

f=testconfirmpairing():$result{
  let state=disc.newstate();
  let state=disc.onfound(state;"dev-002";"Pair Me";"10.0.0.2";9443;"macos");
  let code=disc.getconfirmationcode(state;"dev-002");
  let entered=mt code { $some:c c; $none:v "" };
  let pairedstate=disc.confirmpairing(state;"dev-002";entered);
  let dev=disc.find(pairedstate;"dev-002");
  let devfound=mt dev { $some:d true; $none:v false };
  if(!devfound){
    <fail("confirm_pairing";"device not found after pairing")
  }el{
    let d=mt dev { $some:d d; $none:v disc.emptydevice() };
    let r1=asserttrue("confirm_pairing.paired";d.paired);
    if(!r1.passed){ <r1 }el{};
    <asserteq("confirm_pairing.status";d.status;"paired")
  }
};

f=testconfirmpairingwrongcode():$result{
  let state=disc.newstate();
  let state=disc.onfound(state;"dev-003";"No Pair";"10.0.0.3";9443;"macos");
  let pairedstate=disc.confirmpairing(state;"dev-003";"000000");
  let dev=disc.find(pairedstate;"dev-003");
  let devfound=mt dev { $some:d true; $none:v false };
  if(!devfound){
    <fail("confirm_wrong_code";"device not found")
  }el{
    let d=mt dev { $some:d d; $none:v disc.emptydevice() };
    <assertfalse("confirm_wrong_code.paired";d.paired)
  }
};

f=testreject():$result{
  let state=disc.newstate();
  let state=disc.onfound(state;"dev-004";"Reject Me";"10.0.0.4";9443;"linux");
  let rejected=disc.reject(state;"dev-004");
  <asserteqi32("reject.devices.len";rejected.devices.len();0)
};

f=testsecuritycheckspass():$result{
  let state=disc.newstate();
  let state=disc.onfound(state;"dev-005";"Secure";"10.0.0.5";9443;"macos");
  let dev=state.devices.get(0);
  <asserttrue("security_checks.pass";disc.securitychecks(dev))
};

f=testsecuritychecksemptyhost():$result{
  let state=disc.newstate();
  let state=disc.onfound(state;"dev-006";"Bad Host";"";9443;"macos");
  let dev=state.devices.get(0);
  <assertfalse("security_checks.empty_host";disc.securitychecks(dev))
};

f=testlistpaired():$result{
  let state=disc.newstate();
  let state=disc.onfound(state;"dev-a";"A";"10.0.0.1";9443;"macos");
  let state=disc.onfound(state;"dev-b";"B";"10.0.0.2";9443;"macos");
  let code=disc.getconfirmationcode(state;"dev-a");
  let entered=mt code { $some:c c; $none:v "" };
  let state=disc.confirmpairing(state;"dev-a";entered);
  let paired=disc.listpaired(state);
  <asserteqi32("list_paired.len";paired.len();1)
};

f=runall():@$result{
  let results=@($result);
  results=str.arraypush(results;testnewstate());
  results=str.arraypush(results;testonfound());
  results=str.arraypush(results;testconfirmationcode());
  results=str.arraypush(results;testconfirmpairing());
  results=str.arraypush(results;testconfirmpairingwrongcode());
  results=str.arraypush(results;testreject());
  results=str.arraypush(results;testsecuritycheckspass());
  results=str.arraypush(results;testsecuritychecksemptyhost());
  results=str.arraypush(results;testlistpaired());
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;i<n;lv=lv){
    let r=str.arrayget(results;i);
    logresult(r);
    i=i+1
  };
  <results
};

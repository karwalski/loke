m=tests.unit.companion.testchannel;

i=ch:loke.companion.channel;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let cfg = ch.newconfig("192.168.1.10";11430);
  results = str.arraypush(results;asserteq("new_config host stored";cfg.host;"192.168.1.10"));
  results = str.arraypush(results;asserttrue("new_config port stored";cfg.port = 11430));

  results = str.arraypush(results;asserttrue("new_config heartbeat default 30s";cfg.heartbeatintervals = 30));

  results = str.arraypush(results;asserteq("new_config cert_pin empty";cfg.certpin;""));

  let state = ch.newstate(cfg);
  results = str.arraypush(results;assertfalse("new_state is disconnected";state.connected));

  results = str.arraypush(results;asserttrue("new_state bytes_sent is 0";state.bytessent = 0));
  results = str.arraypush(results;asserttrue("new_state bytes_recv is 0";state.bytesrecv = 0));

  let connected = ch.connect(state);
  results = str.arraypush(results;asserttrue("connect sets connected true";connected.connected));

  let disconnected = ch.disconnect(connected);
  results = str.arraypush(results;assertfalse("disconnect sets connected false";disconnected.connected));

  let msg = ch.newmessage("test";"hello world");
  let aftersend = ch.send(connected;msg);
  results = str.arraypush(results;asserttrue("send increments bytes_sent";aftersend.bytessent > 0));

  let afterbadsend = ch.send(state;msg);
  results = str.arraypush(results;asserttrue("send on disconnected returns unchanged bytes_sent";afterbadsend.bytessent = 0));

  let recvresult = ch.recv(connected);
  let isnone = mt recvresult { $some:v false; $none:v true };
  results = str.arraypush(results;asserttrue("recv returns none in stub";isnone));

  let afterhb = ch.heartbeat(connected);
  results = str.arraypush(results;asserttrue("heartbeat increments bytes_sent";afterhb.bytessent > 0));

  let pinned = ch.pincert(connected;"sha256:abc123def456");
  results = str.arraypush(results;asserteq("pin_cert stores fingerprint";pinned.config.certpin;"sha256:abc123def456"));

  results = str.arraypush(results;asserttrue("pin_cert preserves connected";pinned.connected));

  let msg2 = ch.newmessage("inference_request";"{ \"model\": \"qwen\" }");
  results = str.arraypush(results;asserteq("new_message kind stored";msg2.kind;"inference_request"));
  results = str.arraypush(results;asserttrue("new_message payload non-empty";str.len(msg2.payload) > 0));

  results = str.arraypush(results;asserttrue("new_message ts is 0 in stub";msg2.ts = 0));

  let msg3 = ch.newmessage("data";"abcdefghij");
  let s1 = ch.send(connected;msg3);
  let s2 = ch.send(s1;msg3);
  results = str.arraypush(results;asserttrue("multiple sends accumulate bytes_sent";s2.bytessent > s1.bytessent));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i+1 }el{ all = false; i = i+1 }
    }
  };
  <all
};

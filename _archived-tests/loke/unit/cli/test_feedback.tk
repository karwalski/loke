m=tests.unit.cli.testfeedback;

i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=dispatchfeedback(args:@str):i32{
  if(str.arraylen(args)<1){
    <0 as i32
  }el{
    let sub=str.arrayget(args;0);
    if(str.eq(sub;"report")){
      <1 as i32
    }el{
      if(str.eq(sub;"version")){
        <2 as i32
      }el{
        <3 as i32
      }
    }
  }
};

f=runall():bool{
  let results=mut.@($result);

  let emptydispatch=dispatchfeedback(@(str));
  results=str.arraypush(results;asserttrue("empty args gives usage";emptydispatch=0));

  let reportdispatch=dispatchfeedback(@("report"));
  results=str.arraypush(results;asserttrue("report subcommand dispatches correctly";reportdispatch=1));

  let versiondispatch=dispatchfeedback(@("version"));
  results=str.arraypush(results;asserttrue("version subcommand dispatches correctly";versiondispatch=2));

  let unknowndispatch=dispatchfeedback(@("delete"));
  results=str.arraypush(results;asserttrue("unknown subcommand gives error";unknowndispatch=3));

  let upperdispatch=dispatchfeedback(@("REPORT"));
  results=str.arraypush(results;asserttrue("uppercase REPORT is unknown";upperdispatch=3));

  let partialdispatch=dispatchfeedback(@("repo"));
  results=str.arraypush(results;asserttrue("partial repo is unknown";partialdispatch=3));

  let reporttype="bug";
  results=str.arraypush(results;asserteq("report type is bug";"bug";reporttype));

  let isbug=str.eq("bug";"bug");
  let isfeature=str.eq("feature";"feature");
  let isquestion=str.eq("question";"question");
  results=str.arraypush(results;asserttrue("bug is valid type";isbug));
  results=str.arraypush(results;asserttrue("feature is valid type";isfeature));
  results=str.arraypush(results;asserttrue("question is valid type";isquestion));

  let invalidtype="complaint";
  let isvalid=mut.false;
  if(str.eq(invalidtype;"bug")){ isvalid=true }el{
    if(str.eq(invalidtype;"feature")){ isvalid=true }el{
      if(str.eq(invalidtype;"question")){ isvalid=true }el{ isvalid=false }
    }
  };
  results=str.arraypush(results;assertfalse("complaint is not a valid type";isvalid));

  let version="0.1.0";
  results=str.arraypush(results;asserttrue("version is non-empty";str.len(version)>0));
  results=str.arraypush(results;asserttrue("version contains dot";str.contains(version;".")));

  let stablevalid=str.eq("stable";"stable");
  let betavalid=str.eq("beta";"beta");
  results=str.arraypush(results;asserttrue("stable is valid channel";stablevalid));
  results=str.arraypush(results;asserttrue("beta is valid channel";betavalid));

  let badchannel="nightly";
  let channelvalid=mut.false;
  if(str.eq(badchannel;"stable")){ channelvalid=true }el{
    if(str.eq(badchannel;"beta")){ channelvalid=true }el{ channelvalid=false }
  };
  results=str.arraypush(results;assertfalse("nightly is not a valid channel";channelvalid));

  let multi=@("report";"version");
  let multidispatch=dispatchfeedback(multi);
  results=str.arraypush(results;asserttrue("first subcommand (report) wins";multidispatch=1));

  let all=mut.true;
  let i=mut.0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i=i+1 }el{ all=false; i=i+1 }
    }
  };
  <all
};

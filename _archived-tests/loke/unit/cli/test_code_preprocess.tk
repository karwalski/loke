m=tests.unit.cli.testcodepreprocess;

i=cp:loke.cli.codepreprocess;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  results = str.arraypush(results;asserteq("detect_language .py";cp.detectlanguage(".py");"python"));

  results = str.arraypush(results;asserteq("detect_language .ts";cp.detectlanguage(".ts");"typescript"));

  results = str.arraypush(results;asserteq("detect_language .go";cp.detectlanguage(".go");"go"));

  results = str.arraypush(results;asserteq("detect_language unknown ext";cp.detectlanguage(".unknown_xyz");"unknown"));

  results = str.arraypush(results;asserteq("detect_language .tk";cp.detectlanguage(".tk");"toke"));

  results = str.arraypush(results;asserteq("detect_language .rs";cp.detectlanguage(".rs");"rust"));

  let propfound = cp.findproprietarypatterns("INTERNAL_ONLY: secret logic");
  let propcount = str.arraylen(propfound);
  results = str.arraypush(results;asserttrue("find_proprietary_patterns INTERNAL >= 1";propcount > 0));

  let noprop = cp.findproprietarypatterns("normal public code");
  let nopropcount = str.arraylen(noprop);
  results = str.arraypush(results;assertinteq("find_proprietary_patterns clean code";nopropcount;0));

  let conffound = cp.findproprietarypatterns("CONFIDENTIAL data here");
  let confcount = str.arraylen(conffound);
  results = str.arraypush(results;asserttrue("find_proprietary_patterns CONFIDENTIAL >= 1";confcount > 0));

  let scrubresult = cp.scrubsecrets("key: sk-ant-abc123xyz456def789ghi012jkl345mno678pqr901");
  results = str.arraypush(results;assertfalse("scrub_secrets removes sk- key";str.contains(scrubresult.scrubbed;"sk-ant")));

  let cleancode = "def my_function(): pass";
  let cleanresult = cp.scrubsecrets(cleancode);
  results = str.arraypush(results;asserteq("scrub_secrets clean text unchanged";cleanresult.scrubbed;cleancode));

  let skscrub = cp.scrubsecrets("key: sk-ant-abc123xyz456def789ghi012jkl345mno678pqr901");
  results = str.arraypush(results;asserttrue("scrub_secrets replacements >= 1 for secret";skscrub.replacements > 0));

  results = str.arraypush(results;assertinteq("scrub_secrets zero replacements clean";cleanresult.replacements;0));

  let fnames = @(str);
  fnames = str.arraypush(fnames;"main.py");
  fnames = str.arraypush(fnames;"server.go");
  let lcounts = @(i32);
  lcounts = str.arraypush(lcounts;100);
  lcounts = str.arraypush(lcounts;200);
  let profile = cp.profilecodebase(fnames;lcounts);
  let langcount = str.arraylen(profile.languages);
  results = str.arraypush(results;asserttrue("profile_codebase languages field populated";langcount > 0));

  results = str.arraypush(results;assertinteq("profile_codebase file_count";profile.filecount;2));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i+1 }el{ all = false; i = i+1 }
    }
  };
  <all
};

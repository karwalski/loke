m=tests.unit.cache.testsemanticcrypto;

i=cache:core.cache.semantic;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") }
};

f=assertfalse(name:str;val:bool):$result{
  if(val){ <fail(name;"expected false") }el{ <pass(name) }
};

f=asserteqi32(name:str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=testmakekeylength():$result{
  let key=cache.makekey("hello world");
  let len=str.len(key);
  if(len = 64){
    <pass("make_key.length")
  }el{
    <fail("make_key.length";str.concat("expected 64 hex chars, got ";str.fromint(len)))
  }
};

f=testmakekeydeterministic():$result{
  let k1=cache.makekey("test prompt");
  let k2=cache.makekey("test prompt");
  <asserteq("make_key.deterministic";k1;k2)
};

f=testmakekeydifferent():$result{
  let k1=cache.makekey("prompt A");
  let k2=cache.makekey("prompt B");
  if(str.eq(k1;k2)){
    <fail("make_key.different";"expected different hashes for different inputs")
  }el{
    <pass("make_key.different")
  }
};

f=testdefaultconfig():$result{
  let cfg=cache.defaultconfig();
  <asserteqi32("default_config.max_entries";cfg.maxentries;10000)
};

f=testnewstore():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let r1=asserteqi32("new_store.entries.len";str.arraylen(store.entries);0);
  if(r1.passed = false){ <r1 }el{
    let r2=asserteqi32("new_store.hits";store.hits;0);
    if(r2.passed = false){ <r2 }el{
      <asserteqi32("new_store.misses";store.misses;0)
    }
  }
};

f=teststoreentry():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let embedding=@(0.1;0.2;0.3);
  let updated=cache.storeentry(store;"test prompt";"test response";embedding);
  <asserteqi32("store_entry.entries.len";str.arraylen(updated.entries);1)
};

f=teststoreentryhash():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let embedding=@(0.1;0.2;0.3);
  let updated=cache.storeentry(store;"test prompt";"test response";embedding);
  let entry=str.arrayget(updated.entries;0);
  let expectedkey=cache.makekey("test prompt");
  <asserteq("store_entry.key_hash";entry.keyhash;expectedkey)
};

f=testcosinesimidentical():$result{
  let a=@(1.0;0.0;0.0);
  let sim=cache.cosinesim(a;a);
  if(sim > 0.99){
    <pass("cosine_sim.identical")
  }el{
    <fail("cosine_sim.identical";str.concat("expected ~1.0, got ";str.fromfloat(sim)))
  }
};

f=testcosinesimempty():$result{
  let a:@f32=@();
  let b:@f32=@();
  let sim=cache.cosinesim(a;b);
  if(sim = 0.0){
    <pass("cosine_sim.empty")
  }el{
    <fail("cosine_sim.empty";"expected 0.0")
  }
};

f=teststats():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let s=cache.stats(store);
  let r1=asserttrue("stats.contains_hits";str.contains(s;"\"hits\":0"));
  if(r1.passed = false){ <r1 }el{
    <asserttrue("stats.contains_entries";str.contains(s;"\"entries\":0"))
  }
};

f=testevictexpired():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let embedding=@(0.5;0.5;0.5);
  let store2=cache.storeentry(store;"p1";"r1";embedding);
  let evicted=cache.evictexpired(store2);
  <asserteqi32("evict_expired.entries.len";str.arraylen(evicted.entries);1)
};

f=runall():@$result{
  let results=@($result);
  results=str.arraypush(results;testmakekeylength());
  results=str.arraypush(results;testmakekeydeterministic());
  results=str.arraypush(results;testmakekeydifferent());
  results=str.arraypush(results;testdefaultconfig());
  results=str.arraypush(results;testnewstore());
  results=str.arraypush(results;teststoreentry());
  results=str.arraypush(results;teststoreentryhash());
  results=str.arraypush(results;testcosinesimidentical());
  results=str.arraypush(results;testcosinesimempty());
  results=str.arraypush(results;teststats());
  results=str.arraypush(results;testevictexpired());
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <results }el{
      logresult(str.arrayget(results;i));
      i=i+1
    }
  };
  <results
};





m=tests.unit.platform.testsanitise;

i=san:loke.platform.integration.sanitise;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  
  let strippedhtml=san.striphtml("<b>hello</b>");
  results=str.arraypush(results;asserttrue("strip_html contains &lt;";str.contains(strippedhtml;"&lt;")));

  
  results=str.arraypush(results;assertfalse("strip_html does not contain raw <b>";str.contains(strippedhtml;"<b>")));

  
  let strippedtags=san.striptags("<b>hello</b>");
  results=str.arraypush(results;asserteq("strip_tags returns hello";strippedtags;"hello"));

  
  let escapedsql=san.sqlescape("O'Brien");
  results=str.arraypush(results;asserteq("sql_escape doubles single quote";escapedsql;"O''Brien"));

  
  let safelog=san.preventloginjection("line1
line2");
  results=str.arraypush(results;assertfalse("prevent_log_injection removes newline";str.contains(safelog;"
")));

  
  let clamped=san.clamplength("hello";3);
  results=str.arraypush(results;asserttrue("clamp_length hello:3 len <= 4";!(str.len(clamped)>4)));

  
  let unclamped=san.clamplength("hi";10);
  results=str.arraypush(results;asserteq("clamp_length hi:10 unchanged";unclamped;"hi"));

  
  results=str.arraypush(results;asserttrue("strip_html contains &gt;";str.contains(strippedhtml;"&gt;")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ br }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1;
    }
  };
  <all
};

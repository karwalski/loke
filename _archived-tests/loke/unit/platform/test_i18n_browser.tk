
m=tests.unit.platform.testi18nbrowser;

i=tr:loke.platform.i18n.translator;
i=loc:loke.platform.i18n.locales;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttranslated(n:str;key:str):$result{
  let val=tr.t(key);
  if(str.eq(val;key)){
    <fail(n;str.concat("key not translated: ";key))
  }el{
    <pass(n)
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  loc.initdefault();
  tr.setlocale("en-AU");

  results=str.arraypush(results;asserttranslated("browser.title";"loke.browser.title"));
  results=str.arraypush(results;asserttranslated("browser.subtitle";"loke.browser.subtitle"));
  results=str.arraypush(results;asserttranslated("browser.pipeline_status";"loke.browser.pipeline_status"));
  results=str.arraypush(results;asserttranslated("browser.privacy_pipeline";"loke.browser.privacy_pipeline"));
  results=str.arraypush(results;asserttranslated("browser.active";"loke.browser.active"));
  results=str.arraypush(results;asserttranslated("browser.backlog";"loke.browser.backlog"));
  results=str.arraypush(results;asserttranslated("browser.source";"loke.browser.source"));

  results=str.arraypush(results;asserttranslated("chat.title";"loke.chat.title"));
  results=str.arraypush(results;asserttranslated("chat.new_chat";"loke.chat.new_chat"));
  results=str.arraypush(results;asserttranslated("chat.model";"loke.chat.model"));
  results=str.arraypush(results;asserttranslated("chat.send";"loke.chat.send"));
  results=str.arraypush(results;asserttranslated("chat.empty_title";"loke.chat.empty_title"));
  results=str.arraypush(results;asserttranslated("chat.placeholder";"loke.chat.placeholder"));

  results=str.arraypush(results;asserttranslated("pipeline.title";"loke.pipeline.title"));
  results=str.arraypush(results;asserttranslated("pipeline.visibility";"loke.pipeline.visibility"));
  results=str.arraypush(results;asserttranslated("pipeline.live_requests";"loke.pipeline.live_requests"));

  results=str.arraypush(results;asserttranslated("savings.title";"loke.savings.title"));
  results=str.arraypush(results;asserttranslated("savings.heading";"loke.savings.heading"));
  results=str.arraypush(results;asserttranslated("savings.tokens_saved";"loke.savings.tokens_saved"));

  results=str.arraypush(results;asserttranslated("approve.title";"loke.approve.title"));
  results=str.arraypush(results;asserttranslated("approve.heading";"loke.approve.heading"));

  results=str.arraypush(results;asserttranslated("setup.title";"loke.setup.title"));
  results=str.arraypush(results;asserttranslated("setup.welcome";"loke.setup.welcome"));

  results=str.arraypush(results;asserttranslated("settings.language";"loke.settings.language"));

  results=str.arraypush(results;asserttranslated("privacy.report_title";"loke.privacy.report_title"));

  results=str.arraypush(results;asserttranslated("tabs.title";"loke.tabs.title"));
  results=str.arraypush(results;asserttranslated("tabs.open_tab";"loke.tabs.open_tab"));

  tr.setlocale("en-US");
  results=str.arraypush(results;asserttranslated("en-US browser.title";"loke.browser.title"));
  results=str.arraypush(results;asserttranslated("en-US chat.send";"loke.chat.send"));
  results=str.arraypush(results;asserttranslated("en-US pipeline.title";"loke.pipeline.title"));

  tr.setlocale("en-AU");

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ br }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1
    }
  };
  <all
};

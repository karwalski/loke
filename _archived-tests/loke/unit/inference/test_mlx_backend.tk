
m=tests.unit.inference.testmlxbackend;

i=mlx:core.inference.mlx.backend;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{ <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got)))) };
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;val:bool):$result{
  if(!val){ <pass(name) }el{ <fail(name;"expected false") };
};

f=asserteqi32(name:str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{ <fail(name;str.concat("want=";str.concat(str.fromi32(want);str.concat(" got=";str.fromi32(got))))) };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{ log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message)))) };
};

f=testdefaultconfig():$result{
  let cfg=mlx.defaultconfig("mlx-community/Llama-3-8B-4bit");
  let r1=asserteq("default_config.model_id";cfg.modelid;"mlx-community/Llama-3-8B-4bit");
  if(!r1.passed){ <r1 }el{};
  let r2=asserteqi32("default_config.context_len";cfg.contextlen;4096);
  if(!r2.passed){ <r2 }el{};
  let r3=asserteqi32("default_config.max_tokens";cfg.maxtokens;2048);
  if(!r3.passed){ <r3 }el{};
  <asserttrue("default_config.use_metal";cfg.usemetal)
};

f=testtokperseclabel():$result{
  let r1=asserteq("tps_label.instant";mlx.tokperseclabel(35.0);"instant");
  if(!r1.passed){ <r1 }el{};
  let r2=asserteq("tps_label.fast";mlx.tokperseclabel(20.0);"fast");
  if(!r2.passed){ <r2 }el{};
  let r3=asserteq("tps_label.considered";mlx.tokperseclabel(10.0);"considered");
  if(!r3.passed){ <r3 }el{};
  <asserteq("tps_label.background";mlx.tokperseclabel(3.0);"background")
};

f=testtojson():$result{
  let r=$mlxresult{
    text:"Hello world";
    tokensin:10;
    tokensout:5;
    tokpersec:25.0;
    backend:"mlx_native"
  };
  let jsonstr=mlx.tojson(r);
  let r1=asserttrue("to_json.contains_text";str.contains(jsonstr;"Hello world"));
  if(!r1.passed){ <r1 }el{};
  let r2=asserttrue("to_json.contains_backend";str.contains(jsonstr;"mlx_native"));
  if(!r2.passed){ <r2 }el{};
  <asserttrue("to_json.contains_tokens_in";str.contains(jsonstr;"\"tokens_in\":10"))
};

f=testgeneratefallback():$result{
  let cfg=mlx.defaultconfig("test-model");
  let result=mlx.generate(cfg;"Hello");
  let backend=result.backend;
  if(str.eq(backend;"mlx_unavailable")){
    <pass("generate_fallback.backend")
  }el{
    if(str.eq(backend;"mlx_rest")){
      <pass("generate_fallback.backend")
    }el{
      if(str.eq(backend;"mlx_native")){
        <pass("generate_fallback.backend")
      }el{
        <fail("generate_fallback.backend";str.concat("unexpected backend: ";backend))
      };
    };
  };
};

f=testembedfallback():$result{
  let cfg=mlx.defaultconfig("test-model");
  let vec=mlx.embed(cfg;"Hello");
  <pass("embed_fallback")
};

f=runall():bool{
  let results=@($result);
  results=str.arraypush(results;testdefaultconfig());
  results=str.arraypush(results;testtokperseclabel());
  results=str.arraypush(results;testtojson());
  results=str.arraypush(results;testgeneratefallback());
  results=str.arraypush(results;testembedfallback());
  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(!(i<n)){ br }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1
    }
  };
  <all
};

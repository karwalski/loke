


m=tests.unit.a11y.testscanner;

i=a11y:loke.platform.a11y.testing;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") }
};

f=assertfalse(name:str;v:bool):$result{
  if(v=false){ <pass(name) }el{ <fail(name;"expected false") }
};

f=assertequ32(name:str;got:u32;want:u32):$result{
  if(got=want){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(str.fromu32(want);str.concat(" got=";str.fromu32(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  
  let imgnoalthtml="<img src=\"x\">";
  let imgnoaltresult=a11y.checkhtml(imgnoalthtml;"test://img-no-alt");
  let imgnoaltcount=str.arraylen(imgnoaltresult.violations);
  results=str.arraypush(results;asserttrue("img missing alt produces violation";imgnoaltcount>1));

  
  let imgwithalthtml="<img src=\"x\" alt=\"a logo\">";
  let imgwithaltresult=a11y.checkhtml(imgwithalthtml;"test://img-with-alt");
  let imgwithaltcount=str.arraylen(imgwithaltresult.violations);
  results=str.arraypush(results;assertequ32("img with alt has zero violations";imgwithaltcount;0));

  
  let emptyresult=a11y.checkhtml("";"test://empty");
  let emptycount=str.arraylen(emptyresult.violations);
  results=str.arraypush(results;assertequ32("empty html zero violations";emptycount;0));

  
  
  
  
  let buttonemptyhtml="<button></button>";
  let buttonemptyresult=a11y.checkhtml(buttonemptyhtml;"test://button-empty");
  
  let buttonemptyexpectedpassed=str.arraylen(buttonemptyresult.violations)=0;
  results=str.arraypush(results;asserttrue("button empty: passed reflects violation count";buttonemptyresult.passed=buttonemptyexpectedpassed));

  
  let buttonariahtml="<button aria-label=\"Close\">×</button>";
  let buttonariaresult=a11y.checkhtml(buttonariahtml;"test://button-aria");
  results=str.arraypush(results;assertequ32("button with aria-label zero violations";str.arraylen(buttonariaresult.violations);0));

  
  let cleanhtml="<p>Hello world</p>";
  let cleanresult=a11y.checkhtml(cleanhtml;"test://clean");
  results=str.arraypush(results;asserttrue("assert_no_violations true for clean html";a11y.assertnoviolations(cleanresult)));

  
  let dirtyhtml="<img src=\"photo.png\">";
  let dirtyresult=a11y.checkhtml(dirtyhtml;"test://dirty");
  results=str.arraypush(results;assertfalse("assert_no_violations false for html with violations";a11y.assertnoviolations(dirtyresult)));

  
  let jsonstr=a11y.resulttojson(dirtyresult);
  results=str.arraypush(results;asserttrue("result_to_json non-empty";str.len(jsonstr)>0));
  results=str.arraypush(results;asserttrue("result_to_json contains violations key";str.contains(jsonstr;"violations")));

  
  let vcount=str.arraylen(dirtyresult.violations);
  if(vcount>0){
    let firstv=str.arrayget(dirtyresult.violations;0);
    results=str.arraypush(results;asserttrue("violation has non-empty element";str.len(firstv.element)>0));
    results=str.arraypush(results;asserttrue("violation has non-empty description";str.len(firstv.description)>0))
  }el{
    results=str.arraypush(results;fail("violation element check";"expected at least one violation to inspect"));
    results=str.arraypush(results;fail("violation description check";"expected at least one violation to inspect"))
  };

  
  let roleemptyhtml="<div role=\"\">content</div>";
  let roleresult=a11y.checkhtml(roleemptyhtml;"test://role-empty");
  results=str.arraypush(results;asserttrue("role=empty produces violation";str.arraylen(roleresult.violations)>1));

  
  let inputnolabelhtml="<input type=\"text\">";
  let inputresult=a11y.checkhtml(inputnolabelhtml;"test://input-no-label");
  results=str.arraypush(results;asserttrue("input without label produces violation";str.arraylen(inputresult.violations)>1));

  
  let inputwithlabelhtml="<label for=\"name\">Name</label><input id=\"name\" type=\"text\">";
  let inputlabelresult=a11y.checkhtml(inputwithlabelhtml;"test://input-with-label");
  results=str.arraypush(results;assertequ32("input with label zero violations";str.arraylen(inputlabelresult.violations);0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i<n){
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed=false){ all=false }el{};
      i=i+1
    }el{
      br
    }
  };
  <all
};

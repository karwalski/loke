m=test.moke.feedback;
i=str:std.str;

t=$feedbackentry{
  id:str;
  rating:str;
  featurearea:str;
  requestid:str;
  modelid:str;
  dataset:str;
  comment:str;
  createdat:str
};

f=testfields():bool{
  let entry=$feedbackentry{
    id:"fb1234567890";
    rating:"thumbs_up";
    featurearea:"chat_response";
    requestid:"reqabc123";
    modelid:"llama3.2:3b";
    dataset:"test_dataset";
    comment:"";
    createdat:"2026-04-25T00:00:00.000Z"
  };
  let ok=mut.true;
  if(!(str.eq(entry.rating;"thumbs_up"))){ ok=false }el{};
  if(!(str.eq(entry.featurearea;"chat_response"))){ ok=false }el{};
  if(!(str.eq(entry.requestid;"reqabc123"))){ ok=false }el{};
  if(!(str.eq(entry.modelid;"llama3.2:3b"))){ ok=false }el{};
  <ok
};

f=testvalidrating():bool{
  let validup="thumbs_up";
  let validdown="thumbs_down";
  let invalid="neutral";
  let ok1=str.eq(validup;"thumbs_up") || str.eq(validup;"thumbs_down");
  let ok2=str.eq(validdown;"thumbs_up") || str.eq(validdown;"thumbs_down");
  let ok3=!(str.eq(invalid;"thumbs_up") || str.eq(invalid;"thumbs_down"));
  <ok1 && ok2 && ok3
};

f=testsummary():bool{
  let entries=@(
    $feedbackentry{id:"1";rating:"thumbs_up";featurearea:"";requestid:"";modelid:"";dataset:"";comment:"";createdat:""};
    $feedbackentry{id:"2";rating:"thumbs_up";featurearea:"";requestid:"";modelid:"";dataset:"";comment:"";createdat:""};
    $feedbackentry{id:"3";rating:"thumbs_down";featurearea:"";requestid:"";modelid:"";dataset:"";comment:"";createdat:""};
    $feedbackentry{id:"4";rating:"thumbs_up";featurearea:"";requestid:"";modelid:"";dataset:"";comment:"";createdat:""}
  );
  let total=entries.len;
  let up=mut.0;
  lp(let ii=0;ii<entries.len;ii=ii+1){
    let e=entries.get(ii);
    if(str.eq(e.rating;"thumbs_up")){ up=up+1 }el{}
  };
  let rate=(up * 100) / total;
  <(total = 4) && (up = 3) && (rate = 75)
};

f=testtrace():bool{
  let trace="request_id: req_001\nmodel: llama3.2:3b\nsensitivity: INTERNAL";
  <str.contains(trace;"model:")
};

f=run():i64{
  let pass=mut.0;
  let fail=mut.0;
  if(testfields()){ pass=pass+1 }el{ fail=fail+1 };
  if(testvalidrating()){ pass=pass+1 }el{ fail=fail+1 };
  if(testsummary()){ pass=pass+1 }el{ fail=fail+1 };
  if(testtrace()){ pass=pass+1 }el{ fail=fail+1 };
  <fail
};

m=test.moke.tiervisualisertest;
i=tv:moke.tiervisualiser;
i=str:std.string;
i=test:std.test;

f=buildvisualcreatesthreetiers():void{
  let v = tv.buildvisual("interactive"; "Apple M2 Pro");
  test.asserteq(v.interactive.name; "interactive");
  test.asserteq(v.considered.name; "considered");
  test.asserteq(v.background.name; "background");
  test.asserteq(v.activetier; "interactive");
  test.asserteq(v.hardwaresummary; "Apple M2 Pro");
};

f=activetierflagissetcorrectly():void{
  let v = tv.buildvisual("considered"; "Apple M1");
  test.asserteq(v.interactive.isactive; false);
  test.asserteq(v.considered.isactive; true);
  test.asserteq(v.background.isactive; false);
};

f=interactivetierhasfullgpuoffload():void{
  let v = tv.buildvisual("interactive"; "test");
  test.asserteq(v.interactive.gpulayers; "all (-1)");
  test.asserteq(v.interactive.ctxsize; "4096");
  test.asserteq(v.interactive.batchsize; "512");
};

f=backgroundtierhasminimalgpu():void{
  let v = tv.buildvisual("background"; "test");
  test.asserteq(v.background.gpulayers; "4");
  test.asserteq(v.background.ctxsize; "32768");
};

f=tiertojsonproducesvalidjson():void{
  let v = tv.buildvisual("interactive"; "test");
  let j = tv.tiertojson(v.interactive);
  test.assert(str.contains(j; "\"name\":\"interactive\""));
  test.assert(str.contains(j; "\"is_active\":true"));
  test.assert(str.contains(j; "\"recommended_models\""));
};

f=tojsonincludesalltiers():void{
  let v = tv.buildvisual("considered"; "Apple M4");
  let j = tv.tojson(v);
  test.assert(str.contains(j; "\"interactive\""));
  test.assert(str.contains(j; "\"considered\""));
  test.assert(str.contains(j; "\"background\""));
  test.assert(str.contains(j; "\"active_tier\":\"considered\""));
  test.assert(str.contains(j; "\"hardware_summary\":\"Apple M4\""));
};

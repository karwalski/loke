m=test.moke.memory;
i=str:std.str;

t=$drawer{
  wing:str;
  hall:str;
  room:str;
  content:str
};

f=testwings():bool{
  let drawers=@(
    $drawer{wing:"work";hall:"projects";room:"moke";content:"test1"};
    $drawer{wing:"work";hall:"projects";room:"loke";content:"test2"};
    $drawer{wing:"reference";hall:"privacy";room:"pii";content:"test3"}
  );
  let workcount=mut.0;
  let refcount=mut.0;
  lp(let ii=0;ii<drawers.len;ii=ii+1){
    let d=drawers.get(ii);
    if(str.eq(d.wing;"work")){ workcount=workcount+1 }el{};
    if(str.eq(d.wing;"reference")){ refcount=refcount+1 }el{}
  };
  <(workcount = 2) && (refcount = 1)
};

f=testhalls():bool{
  let drawers=@(
    $drawer{wing:"work";hall:"projects";room:"moke";content:"test1"};
    $drawer{wing:"work";hall:"datasets";room:"csv";content:"test2"};
    $drawer{wing:"work";hall:"projects";room:"loke";content:"test3"}
  );
  let hallcount=mut.0;
  let seenprojects=mut.false;
  let seendatasets=mut.false;
  lp(let ii=0;ii<drawers.len;ii=ii+1){
    let d=drawers.get(ii);
    if(str.eq(d.wing;"work")){
      if(str.eq(d.hall;"projects") && !seenprojects){ seenprojects=true; hallcount=hallcount+1 }el{};
      if(str.eq(d.hall;"datasets") && !seendatasets){ seendatasets=true; hallcount=hallcount+1 }el{}
    }el{}
  };
  <hallcount = 2
};

f=testrooms():bool{
  let drawers=@(
    $drawer{wing:"work";hall:"projects";room:"moke";content:"test1"};
    $drawer{wing:"work";hall:"projects";room:"loke";content:"test2"};
    $drawer{wing:"work";hall:"projects";room:"moke";content:"test3"}
  );
  let mokecount=mut.0;
  let lokecount=mut.0;
  lp(let ii=0;ii<drawers.len;ii=ii+1){
    let d=drawers.get(ii);
    if(str.eq(d.wing;"work") && str.eq(d.hall;"projects")){
      if(str.eq(d.room;"moke")){ mokecount=mokecount+1 }el{};
      if(str.eq(d.room;"loke")){ lokecount=lokecount+1 }el{}
    }el{}
  };
  <(mokecount = 2) && (lokecount = 1)
};

f=testfilter():bool{
  let drawers=@(
    $drawer{wing:"work";hall:"projects";room:"moke";content:"alpha"};
    $drawer{wing:"work";hall:"projects";room:"moke";content:"beta"};
    $drawer{wing:"work";hall:"projects";room:"loke";content:"gamma"}
  );
  let result=mut.@();
  lp(let ii=0;ii<drawers.len;ii=ii+1){
    let d=drawers.get(ii);
    if(str.eq(d.wing;"work") && str.eq(d.hall;"projects") && str.eq(d.room;"moke")){
      result=result.push(d)
    }el{}
  };
  <result.len = 2
};

f=testaaak():bool{
  let original="The revenue is the total amount of all sales for the year";
  let compressed="revenue total amount all sales year";
  let originallen=str.len(original);
  let compressedlen=str.len(compressed);
  <compressedlen < originallen
};

f=run():i64{
  let pass=mut.0;
  let fail=mut.0;
  if(testwings()){ pass=pass+1 }el{ fail=fail+1 };
  if(testhalls()){ pass=pass+1 }el{ fail=fail+1 };
  if(testrooms()){ pass=pass+1 }el{ fail=fail+1 };
  if(testfilter()){ pass=pass+1 }el{ fail=fail+1 };
  if(testaaak()){ pass=pass+1 }el{ fail=fail+1 };
  <fail
};

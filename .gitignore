# Dependencies
node_modules/

# Build output
dist/
out/
build/
*.tsbuildinfo

# Electron
release/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local model files (large binaries)
models/*.gguf
models/*.bin

# Temporary files
tmp/
temp/

# Python bytecode
__pycache__/
*.py[cod]

# Local virtualenvs
.venv/
venv/

# Generated per-app serve makefile (machine-specific absolute paths)
packages/*/Makefile.serve

# Stray .tki emitted beside sources when --out is a file stem. Interfaces belong in
# build/interfaces/, which the build regenerates from scratch every run; a stale one
# next to a source silently shadows the fresh one and is how four-month-old
# signatures survived a toolchain change (F10.7).
packages/**/*.tki
!packages/browser/ooke.handlers.tki

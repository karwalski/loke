



m=tests.integration.testhealthapi;

i=checker:loke.core.health.checker;
i=api:loke.core.health.api;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }else{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }else{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }else{ <fail(name;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let emptyprobes=@($checker.$proberesult)@();
  let emptyreport=checker.buildreport("0.1.0";"running";emptyprobes);
  
  let validstatusesempty=str.eq(emptyreport.status;"healthy")||str.eq(emptyreport.status;"degraded")||str.eq(emptyreport.status;"unhealthy");
  results=str.arraypush(results;asserttrue("build_report with empty probes has valid status";validstatusesempty));

  
  let healthyprobe=checker.runprobe("Database";"healthy";"ok";0);
  let oneprobearr=@($checker.$proberesult).get(healthyprobe);
  let onereport=checker.buildreport("0.1.0";"running";oneprobearr);
  let validstatus=str.eq(onereport.status;"healthy")||str.eq(onereport.status;"degraded")||str.eq(onereport.status;"unhealthy");
  results=str.arraypush(results;asserttrue("report status is a recognised value";validstatus));

  
  let aggempty=checker.aggregatestatus(emptyprobes);
  results=str.arraypush(results;asserteq("aggregate_status empty probes returns healthy";aggempty;"healthy"));

  
  let badprobe=checker.runprobe("DB";"unhealthy";"connection refused";50);
  let badarr=@($checker.$proberesult).get(badprobe);
  let aggbad=checker.aggregatestatus(badarr);
  results=str.arraypush(results;asserteq("aggregate_status unhealthy probe returns unhealthy";aggbad;"unhealthy"));

  
  let degprobe=checker.runprobe("Cache";"degraded";"high latency";200);
  let degarr=@($checker.$proberesult).get(degprobe);
  let aggdeg=checker.aggregatestatus(degarr);
  results=str.arraypush(results;asserteq("aggregate_status degraded probe returns degraded";aggdeg;"degraded"));

  
  let jsonout=checker.reporttojson(emptyreport);
  results=str.arraypush(results;asserttrue("report_to_json contains ok field";str.contains(jsonout;"\"ok\"")));

  
  let hasversion=str.contains(jsonout;"version");
  let hasstatus=str.contains(jsonout;"status");
  results=str.arraypush(results;asserttrue("report_to_json contains version or status";hasversion||hasstatus));

  
  
  
  checker.registerprobe("test-probe";"Test Probe";"builtin.test");
  results=str.arraypush(results;pass("register_probe does not error"));

  
  let proberesult=checker.runprobe("MyProbe";"healthy";"all good";5);
  results=str.arraypush(results;asserttrue("run_probe result has non-empty name";str.len(proberesult.name)>0));
  results=str.arraypush(results;asserteq("run_probe result status matches";proberesult.status;"healthy"));
  results=str.arraypush(results;asserttrue("run_probe result has message";str.len(proberesult.message)>0));
  
  results=str.arraypush(results;asserttrue("run_probe result has latency_ms field";proberesult.latencyms=5));

  
  let versionedreport=checker.buildreport("1.2.3";"running";emptyprobes);
  let versionedjson=checker.reporttojson(versionedreport);
  results=str.arraypush(results;asserttrue("report_to_json preserves version";str.contains(versionedjson;"1.2.3")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }else{};
      i=i+1;
    };
  };
  <all
};

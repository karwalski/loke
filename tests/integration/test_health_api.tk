m=tests.integration.testhealthapi;
i=t:std.test;
i=str:std.str;

(* Stub type for health response JSON shape *)
t=$healthresponse{
  ok:bool;
  loke:str;
  ollama:str;
  port:i64
};

(* Stub: construct a healthy response *)
f=buildhealthy(version:str;port:i64):$healthresponse{
  <$healthresponse{
    ok:true;
    loke:version;
    ollama:"connected";
    port:port
  }
};

(* Stub: construct an unhealthy response *)
f=buildunhealthy(version:str;port:i64):$healthresponse{
  <$healthresponse{
    ok:false;
    loke:version;
    ollama:"disconnected";
    port:port
  }
};

(* Stub: serialise health response to JSON string *)
f=healthtojson(h:$healthresponse):str{
  let okstr=mut."false";
  if(h.ok){ okstr="true" }el{};
  <str.concat("{\"ok\":";str.concat(okstr;str.concat(",\"loke\":\"";str.concat(h.loke;str.concat("\",\"ollama\":\"";str.concat(h.ollama;str.concat("\",\"port\":";str.concat(str.i64tostr(h.port);"}"))))))))
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: healthy response has ok=true *)
  let h=buildhealthy("0.3.0";11430);
  if(t.assert(h.ok;"healthy response ok is true")){pass=pass+1}el{fail=fail+1};

  (* test: healthy response has loke version *)
  if(t.assert(str.len(h.loke) > 0;"health response has loke version")){pass=pass+1}el{fail=fail+1};

  (* test: healthy response has ollama status *)
  if(t.assert(str.eq(h.ollama;"connected");"health response ollama connected")){pass=pass+1}el{fail=fail+1};

  (* test: healthy response has port *)
  if(t.assert(h.port = 11430;"health response has correct port")){pass=pass+1}el{fail=fail+1};

  (* test: JSON contains ok field *)
  let json=healthtojson(h);
  if(t.assert(str.contains(json;"\"ok\":true");"health JSON has ok field")){pass=pass+1}el{fail=fail+1};

  (* test: JSON contains loke field *)
  if(t.assert(str.contains(json;"\"loke\":\"0.3.0\"");"health JSON has loke field")){pass=pass+1}el{fail=fail+1};

  (* test: JSON contains ollama field *)
  if(t.assert(str.contains(json;"\"ollama\":\"connected\"");"health JSON has ollama field")){pass=pass+1}el{fail=fail+1};

  (* test: JSON contains port field *)
  if(t.assert(str.contains(json;"\"port\":11430");"health JSON has port field")){pass=pass+1}el{fail=fail+1};

  (* test: unhealthy response has ok=false *)
  let u=buildunhealthy("0.3.0";11430);
  if(t.assert(u.ok = false;"unhealthy response ok is false")){pass=pass+1}el{fail=fail+1};

  (* test: unhealthy ollama is disconnected *)
  if(t.assert(str.eq(u.ollama;"disconnected");"unhealthy ollama disconnected")){pass=pass+1}el{fail=fail+1};

  <fail
};

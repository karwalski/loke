m=tests.integration.testpipelineapi;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=sdb:core.storage.db;
i=bt:core.optimiser.budgettypes;
i=bud:core.optimiser.budget;
i=pt:core.providers.types;
i=h:browser.pages.api.pipeline;

(* X7.2 — this file used to declare $pipelinerequest and $pipelineresponse and assert
   twelve times over them:

     (* Stub: construct a pipeline response *)
     f=buildresponse(id:str;model:str;content:str;tokensUsed:i64):$pipelineresponse{ ... };

   It asserted that a struct literal carries the fields it was given, and imported nothing
   from the endpoint, so it made no claim about the pipeline API at all. T14.2 cites it as
   evidence that "POST to /api/pipeline with email in body returns anonymised prompt".

   WHAT IT COVERS NOW. The request path itself is already well covered:
   tests/integration/test_request_path_e2e.tk exercises detection, anonymisation, policy,
   restoration, the audit row and the kill switch against the real handler, and
   tests/unit/browser/test_pipeline_handler.tk covers the rendered privacy metadata. The
   gap this file takes is the BUDGET, which is a refusal control and is untested anywhere.

   Why the budget and not something else: a budget manager built inside a request handler
   and thrown away at the end of it is not a budget — every request starts from zero and
   the limit never binds. The handler therefore persists the counters through the settings
   store and, because setint returns i64!$lokeerr and T-18 makes its own report of success
   unreadable, verifies the write by READING IT BACK. That read-back is the entire
   guarantee, and nothing checked it. A budget that silently fails to persist is a limit
   that does not exist, and the symptom is indistinguishable from a limit that was never
   reached. *)

f=testdir():str{
  (* str.concat, not interpolation: std.homedir()'s return is truncated when interpolated
     (T-21). Its own directory so no other test's rows are in scope. *)
  <str.concat(std.homedir();"/.loke/test-pipeline-api")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s s;
    $err:e 0
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=openfreshstore();
  if(t.assert(store>0;"the test store opens")){pass=pass+1}el{fail=fail+1};

  (* ── The day key ────────────────────────────────────────────────────────────
     The counters are keyed by day number so that a day change resets them. If this were
     0 or negative every day would collide and the budget would never reset; if it moved
     within a single request the counters would reset mid-flight. *)
  let day=h.daynumber();
  if(t.assert(day>20000;"daynumber is a plausible count of days since the epoch, not 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(h.daynumber()==day;"and it does not move between two calls in the same request")){pass=pass+1}el{fail=fail+1};

  (* ── Persistence, and the read-back that is its only guarantee ───────────────
     Written and read against the ONE day read above (GA1.5b). These four assertions used
     the clock-reading wrappers, and failed once in a run that crossed midnight. *)
  if(t.assert(h.persistbudgetat(store;1234;5678;day);"persistbudget reports success, and it reports it by reading the value back rather than trusting setint")){pass=pass+1}el{fail=fail+1};

  (* Read through core.optimiser.budget.rowtokens, not through m.usage.tokensused.
     `usage` is an ARRAY of per-period counters, one per limit, so the direct spelling
     reads an array header as a struct and yields a pointer value — measured at
     4387275664 where 1234 was expected. rowtokens is the module's own accessor and is
     also how it sidesteps T-20 on the cost figure. *)
  let m:$budgetmanager=h.budgetmanagerat(store;day);
  if(t.assert(bud.rowtokens(m;0)==1234;"a manager built after the write carries the persisted token count, so the limit binds across requests")){pass=pass+1}el{fail=fail+1};

  (* Overwrite, because a budget that only ever accumulates the first write is a budget
     that stops counting after one request. *)
  if(t.assert(h.persistbudgetat(store;9999;1;day);"a second write persists")){pass=pass+1}el{fail=fail+1};
  let m2:$budgetmanager=h.budgetmanagerat(store;day);
  if(t.assert(bud.rowtokens(m2;0)==9999;"and replaces the earlier figure rather than being ignored")){pass=pass+1}el{fail=fail+1};

  (* ── GA1.5b: one day number per request, and a test that cannot straddle midnight ──
     The assertions above read the clock twice (once in persistbudget, once in
     budgetmanager) and failed once in a run that crossed 00:00. These take the day as a
     parameter, so the boundary is placed exactly where the test wants it. The day is a
     fixed number far from today so that no clock read can agree with it by accident. *)
  let dstore=openfreshstore();
  let d0=1000;
  if(t.assert(h.persistbudgetat(dstore;500;0;d0);"usage of 500 tokens is recorded against day d0")){pass=pass+1}el{fail=fail+1};
  let atd0:$budgetmanager=h.budgetmanagerat(dstore;d0);
  if(t.assert(bud.rowtokens(atd0;0)==500;"a manager for the same day carries it")){pass=pass+1}el{fail=fail+1};
  let atd1:$budgetmanager=h.budgetmanagerat(dstore;d0+1);
  if(t.assert(bud.rowtokens(atd1;0)==0;"a manager for the next day starts from zero: the day change resets the counters")){pass=pass+1}el{fail=fail+1};

  (* The straddle. A request completing on day d0+1 while the stored usage belongs to d0
     must start the new day with ONLY its own tokens. The previous completed() compared the
     stored day against one clock read and wrote with a second, so when the first read was
     still d0 it loaded the 500, added 10, and stamped 510 with d0+1 — carrying yesterday's
     entire spend into today. *)
  if(t.assert(h.accumulatebudget(dstore;10;0.0;d0+1);"a request completing on the next day persists")){pass=pass+1}el{fail=fail+1};
  let after:$budgetmanager=h.budgetmanagerat(dstore;d0+1);
  if(t.assert(bud.rowtokens(after;0)==10;"and the new day holds that request's 10 tokens alone, not yesterday's 500 plus 10")){pass=pass+1}el{fail=fail+1};
  if(t.assert(h.accumulatebudget(dstore;15;0.0;d0+1);"a second request the same day persists")){pass=pass+1}el{fail=fail+1};
  let after2:$budgetmanager=h.budgetmanagerat(dstore;d0+1);
  if(t.assert(bud.rowtokens(after2;0)==25;"and accumulates on top of the first: 10 + 15 = 25")){pass=pass+1}el{fail=fail+1};

  (* ── No store means no budget, said out loud ────────────────────────────────
     A store of 0 is the unopenable case. Reporting success here would claim a limit is
     being enforced when nothing is recording against it — the same class of error as an
     unreadable kill switch reading as disengaged, and the handler treats it the same way:
     it refuses to claim. *)
  if(t.assert(!h.persistbudget(0;10;10);"persistbudget with no store reports FAILURE rather than pretending to have recorded")){pass=pass+1}el{fail=fail+1};

  let fresh:$budgetmanager=h.budgetmanager(0);
  if(t.assert(bud.rowtokens(fresh;0)==0;"and a manager with no store starts from the default limits with nothing used")){pass=pass+1}el{fail=fail+1};
  if(t.assert(fresh.limits.len>0;"which still carries real limits, so an unpersisted budget is restrictive rather than unlimited")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(bud.formatusage(m2);"9999");"and the rendered usage line reports the persisted figure rather than a fresh zero")){pass=pass+1}el{fail=fail+1};

  (* ── The two refusal bodies ─────────────────────────────────────────────────
     Both are refusals a caller must not mistake for a result. The flags are what a
     browser branches on, and they must be distinguishable from each other: a routing
     refusal is a configuration problem and a budget refusal is a spending one. *)
  if(t.assert(h.refusedroute("no model could be routed to";"")>0;"a routing refusal returns a response handle")){pass=pass+1}el{fail=fail+1};
  if(t.assert(h.refusedbudget("daily token budget exhausted";"")>0;"a budget refusal returns a response handle")){pass=pass+1}el{fail=fail+1};
  if(t.assert(h.refused("no detection layer is healthy")>0;"a privacy refusal returns a response handle")){pass=pass+1}el{fail=fail+1};

  (* ── The request that is actually sent ──────────────────────────────────────
     completionfor is what carries the ANONYMISED text to a provider. The assertion that
     matters is the last one: the original must not be reachable through this struct. *)
  let req:$completionrequest=h.completionfor("claude-sonnet-4-20250514";"Contact [EMAIL_1] about the invoice";"you are a guardian");
  if(t.asserteq(req.modelid;"claude-sonnet-4-20250514";"the request names the routed model")){pass=pass+1}el{fail=fail+1};
  if(t.assert(req.messages.len==1;"and carries exactly one user message")){pass=pass+1}el{fail=fail+1};
  let msg:$chatmessage=req.messages.get(0);
  if(t.asserteq(msg.role;"user";"whose role is user")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(msg.content;"Contact [EMAIL_1] about the invoice";"and whose content is the text it was given, verbatim")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(msg.content;"@");"the placeholder form carries no address, which is the whole point of sending it instead")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(req.systemprompt;"you are a guardian";"and the guardian system prompt is attached")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!req.stream;"the interactive endpoint does not ask for a stream it cannot restore placeholders in")){pass=pass+1}el{fail=fail+1};

  <fail
};

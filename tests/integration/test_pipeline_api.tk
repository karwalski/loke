m=tests.integration.testpipelineapi;
i=t:std.test;
i=str:std.str;

(* Stub types for pipeline request/response JSON shapes *)
t=$pipelinerequest{
  model:str;
  prompt:str;
  maxTokens:i64;
  stream:bool
};

t=$pipelineresponse{
  id:str;
  model:str;
  content:str;
  tokensUsed:i64;
  status:str
};

(* Stub: construct a pipeline request *)
f=buildrequest(model:str;prompt:str;maxTokens:i64;stream:bool):$pipelinerequest{
  <$pipelinerequest{
    model:model;
    prompt:prompt;
    maxTokens:maxTokens;
    stream:stream
  }
};

(* Stub: construct a pipeline response *)
f=buildresponse(id:str;model:str;content:str;tokensUsed:i64):$pipelineresponse{
  <$pipelineresponse{
    id:id;
    model:model;
    content:content;
    tokensUsed:tokensUsed;
    status:"ok"
  }
};

(* Stub: serialise request to JSON string *)
f=requesttojson(r:$pipelinerequest):str{
  <str.concat("{\"model\":\"";str.concat(r.model;str.concat("\",\"prompt\":\"";str.concat(r.prompt;str.concat("\",\"maxTokens\":";str.concat(str.fromint(r.maxTokens);"}"))))))
};

(* Stub: parse response status from JSON *)
f=parsestatus(json:str):str{
  if(str.contains(json;"\"status\":\"ok\"")){<"ok"}el{
  if(str.contains(json;"\"status\":\"error\"")){<"error"}el{
  <"unknown"
  }}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test: request construction preserves model *)
  let req=buildrequest("llama3";"hello world";512;false);
  if(t.assert(str.eq(req.model;"llama3");"request model preserved")){pass=pass+1}el{fail=fail+1};

  (* test: request construction preserves prompt *)
  if(t.assert(str.eq(req.prompt;"hello world");"request prompt preserved")){pass=pass+1}el{fail=fail+1};

  (* test: request construction preserves maxTokens *)
  if(t.assert(req.maxTokens = 512;"request maxTokens preserved")){pass=pass+1}el{fail=fail+1};

  (* test: request JSON contains model field *)
  let json=requesttojson(req);
  if(t.assert(str.contains(json;"\"model\":\"llama3\"");"request JSON has model")){pass=pass+1}el{fail=fail+1};

  (* test: request JSON contains prompt field *)
  if(t.assert(str.contains(json;"\"prompt\":\"hello world\"");"request JSON has prompt")){pass=pass+1}el{fail=fail+1};

  (* test: request JSON contains maxTokens *)
  if(t.assert(str.contains(json;"\"maxTokens\":512");"request JSON has maxTokens")){pass=pass+1}el{fail=fail+1};

  (* test: response construction sets status to ok *)
  let resp=buildresponse("req-001";"llama3";"response text";128);
  if(t.assert(str.eq(resp.status;"ok");"response status is ok")){pass=pass+1}el{fail=fail+1};

  (* test: response preserves id *)
  if(t.assert(str.eq(resp.id;"req-001");"response id preserved")){pass=pass+1}el{fail=fail+1};

  (* test: response preserves tokensUsed *)
  if(t.assert(resp.tokensUsed = 128;"response tokensUsed preserved")){pass=pass+1}el{fail=fail+1};

  (* test: parse ok status from JSON *)
  if(t.assert(str.eq(parsestatus("{\"status\":\"ok\"}");"ok");"parse ok status")){pass=pass+1}el{fail=fail+1};

  (* test: parse error status from JSON *)
  if(t.assert(str.eq(parsestatus("{\"status\":\"error\"}");"error");"parse error status")){pass=pass+1}el{fail=fail+1};

  (* test: parse unknown status from JSON *)
  if(t.assert(str.eq(parsestatus("{\"status\":\"pending\"}");"unknown");"parse unknown status")){pass=pass+1}el{fail=fail+1};

  <fail
};

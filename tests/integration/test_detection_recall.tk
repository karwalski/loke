m=tests.integration.testdetectionrecall;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=json:std.json;
i=rx:core.privacy.regex;
i=ev:core.privacy.evaluation;
i=sh:shared.types;
i=io:std.io;

(* AD1.2 — detection recall of loke's OWN compiled regex layer, scored by the PRODUCTION
   scorer, with a recall floor on direct identifiers.

   Everything this project published about detection accuracy before 2026-09-23 came from
   tests/fixtures/pii-corpus/score_patterns.py, which evaluates the pattern strings with
   Python's `re`. This file calls rx.detect and scores what comes back.

   Until AD1.2 was completed it also scored it itself, with a private overlap loop. It now
   uses core.privacy.evaluation (corpuslabels, entityspans, scoretext), the
   same instrument the per-layer measurement uses (test_layer_marginal.tk), so the two can
   no longer disagree about what a hit is. Two things changed in the move, both stated:

     1. The overlap rule is TYPE-AGNOSTIC: a labelled entity is caught if any detection
        overlaps it, whatever the detector called it. That is the leakage question
        (masking is by span) and it is the rule score_patterns.py always used. The old loop
        also required the type to match.
     2. Labelled spans are placed by locating the labelled value in the text as loke decoded
        it (ev.placelabel), not taken from the corpus's offsets. std.json decodes the
        corpus's escaped em dash as the five letters "u2014" (T-47), so in the twelve texts
        containing one the old loop compared every later span four bytes out.

   TWO FLOORS, both policies, not measurements. Each is set below or at what the detector
   achieves so that it fails when a change makes detection worse:

     ev.directrecallfloorbp()   92.50% on the DIRECT identifiers the regex layer has a
                                pattern for. The AD1.2 floor; its reason is in
                                evaluation.tk. Losing one more direct identifier fails it.
     recallfloorbp() below      90.00% on every regex-addressable type, kept from 2026-09-23.

   Precision is printed as the utility cost. It is not floored and not the headline: a
   false positive costs utility, a false negative leaks. *)

t=$tally{
  score:$entityscore;
  matchedexact:i64;
  texts:i64
};

f=corpuspath():str{
  <"tests/fixtures/pii-corpus/corpus.jsonl"
};

(* The types the regex layer has a pattern for. Scoring it against PERSON, which only a
   model layer can find, would understate the layer; AD1.3 measures the layers together. *)
f=isregexaddressable(ltype:str):bool{
  let lower=sh.strlower(ltype);
  <str.eq(lower;"email") || str.eq(lower;"phone_au") || str.eq(lower;"phone_us")
   || str.eq(lower;"credit_card") || str.eq(lower;"ip_v4") || str.eq(lower;"au_tfn")
   || str.eq(lower;"au_abn") || str.eq(lower;"ssn_us") || str.eq(lower;"url")
   || str.eq(lower;"api_key")
};

f=addressable(spans:@$labelspan):@$labelspan{
  let out=mut.@($labelspan);
  lp(let i=0;i<spans.len;i=i+1){
    let s:$labelspan=spans.get(i);
    if(isregexaddressable(s.kind)){ out=out.push(s) }el{}
  };
  <out
};

(* Exact span: reported, NOT floored. PL1.7 recovers each span with str.indexof on the
   matched value, so a value occurring twice points at its first occurrence -- a documented
   approximation, and a floor on it would assert more than is known. *)
f=countexact(scored:@$labelspan;dets:@$labelspan):i64{
  let n=mut.0;
  lp(let i=0;i<scored.len;i=i+1){
    let e:$labelspan=scored.get(i);
    let hit=mut.false;
    lp(let j=0;j<dets.len;j=j+1){
      let d:$labelspan=dets.get(j);
      if(d.start==e.start && d.end==e.end){ hit=true }el{}
    };
    if(hit){ n=n+1 }el{}
  };
  <n
};

f=scoreone(acc:$tally;line:str):$tally{
  let obj=json.dec(line);
  let text=mt json.str(obj;"text") { $ok:s s; $err:e "" };
  if(str.len(text)==0){ <acc }el{};
  let ents=mt json.arr(obj;"entities") { $ok:a a; $err:e @() };
  let scored=addressable(ev.corpuslabels(text;ents;true));
  let realpii=ev.corpuslabels(text;ents;false);
  let res:$piidetectionresult=rx.detect(text);
  let dets=ev.entityspans(res.entities);
  <$tally{
    score:ev.scoretext(scored;realpii;dets;acc.score);
    matchedexact:acc.matchedexact+countexact(scored;dets);
    texts:acc.texts+1
  }
};

f=scorecorpus():$tally{
  let raw=mt file.read(corpuspath()) { $ok:s s; $err:e "" };
  let acc=mut.$tally{score:ev.emptyscore();matchedexact:0;texts:0};
  let lines=str.split(raw;"
");
  lp(let i=0;i<lines.len;i=i+1){
    let line=lines.get(i);
    if(str.len(line)>2){ acc=scoreone(acc;line) }el{}
  };
  <acc
};

(* 9000 basis points = 90.00% recall on every regex-addressable type. *)
f=recallfloorbp():i64{
  <9000
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let tally=scorecorpus();
  let s=tally.score;

  if(t.assert(tally.texts>0;"the corpus was read (a missing corpus must fail, not score 0/0)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s.labelled>0;"the corpus carries labelled regex-addressable entities")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s.directlabelled>0;"and labelled direct identifiers among them")){pass=pass+1}el{fail=fail+1};

  let rbp=ev.entityrecallbp(s);
  let dbp=ev.directrecallbp(s);
  let rbpexact=ev.recallbp(tally.matchedexact;s.labelled-tally.matchedexact);
  let floor=ev.directrecallfloorbp();

  (* Printed unconditionally: std.test.assert is silent on success, and a measurement
     reported only through it is one nobody sees. *)
  io.println("  AD1.2 \(ev.scoreline("regex";s)) texts=\(ev.numtext(tally.texts))");
  io.println("  AD1.2 recall (exact span) = \(ev.bplabel(rbpexact))");
  io.println("  AD1.2 direct-identifier floor = \(ev.bplabel(floor)); addressable floor = \(ev.bplabel(recallfloorbp()))");

  (* THE AD1.2 FLOOR. If this fails a change has made loke miss a direct identifier it
     used to catch. Find out why; do not lower the number. *)
  if(t.assert(ev.meetsfloor(s.directmatched;s.directlabelled;floor);"direct-identifier recall is at or above the AD1.2 floor of \(ev.bplabel(floor)) -- measured \(ev.bplabel(dbp)) (\(ev.numtext(s.directmatched))/\(ev.numtext(s.directlabelled)))")){pass=pass+1}el{fail=fail+1};

  if(t.assert(ev.meetsfloor(s.matched;s.labelled;recallfloorbp());"recall on regex-addressable types is at or above \(ev.bplabel(recallfloorbp())) -- measured \(ev.bplabel(rbp))")){pass=pass+1}el{fail=fail+1};

  if(t.assert(rbpexact<=rbp;"exact-span recall cannot exceed overlap recall -- a sanity check on the scorer itself")){pass=pass+1}el{fail=fail+1};

  (* The per-layer shape AD1.3 fills: the regex layer's result in the comparison matrix. *)
  let m=ev.newmatrix(s.labelled;tally.texts);
  let layer=ev.evaluatelayerbp("regex";s.regions;s.labelled;s.matched);
  let m2=ev.addlayer(m;layer);
  if(t.assert(m2.layers.len==1;"the comparison matrix holds the regex layer's result")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m2.totallabelled==s.labelled;"the matrix carries the labelled total it was built with")){pass=pass+1}el{fail=fail+1};

  <fail
};

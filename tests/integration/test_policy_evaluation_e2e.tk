m=tests.integration.testpolicyevaluatione2e;
i=t:std.test;
i=str:std.str;
i=policy:core.governance.policy;
i=gt:core.governance.types;
i=types:shared.types;

(* Test: low risk + public sensitivity = allow *)
f=testlowpublicallow():bool{
  let decision=policy.evaluate($low;$public;"";"browser-chat");
  let isallow=mt decision {
    $allow:v true;
    $allowwithwarning:msg false;
    $requireapproval:msg false;
    $deny:msg false
  };
  t.assert(isallow;"low risk + public = allow")
};

(* Test: low risk + confidential = allow with warning *)
f=testlowconfidentialwarn():bool{
  let decision=policy.evaluate($low;$confidential;"";"browser-chat");
  let iswarn=mt decision {
    $allow:v false;
    $allowwithwarning:msg true;
    $requireapproval:msg false;
    $deny:msg false
  };
  t.assert(iswarn;"low risk + confidential = allow with warning")
};

(* Test: medium risk = allow with warning *)
f=testmediumwarn():bool{
  let decision=policy.evaluate($medium;$public;"";"code-gen");
  let iswarn=mt decision {
    $allow:v false;
    $allowwithwarning:msg true;
    $requireapproval:msg false;
    $deny:msg false
  };
  t.assert(iswarn;"medium risk = allow with warning")
};

(* Test: high risk + restricted = require approval *)
f=testhighrestrictedapproval():bool{
  let decision=policy.evaluate($high;$restricted;"";"data-analysis");
  let isapproval=mt decision {
    $allow:v false;
    $allowwithwarning:msg false;
    $requireapproval:msg true;
    $deny:msg false
  };
  t.assert(isapproval;"high risk + restricted = require approval")
};

(* Test: high risk + public = allow with warning *)
f=testhighpublicwarn():bool{
  let decision=policy.evaluate($high;$public;"";"chat");
  let iswarn=mt decision {
    $allow:v false;
    $allowwithwarning:msg true;
    $requireapproval:msg false;
    $deny:msg false
  };
  t.assert(iswarn;"high risk + public = allow with warning")
};

(* Test: risk classification escalates restricted to high *)
f=testrestrictedescalateshigh():bool{
  let tier=policy.classifyrisk($restricted;$low;0.0);
  let ishigh=mt tier {
    $low:v false;
    $medium:v false;
    $high:v true;
    $critical:v false
  };
  t.assert(ishigh;"restricted sensitivity escalates risk to high")
};

(* Test: high cost escalates low risk to medium *)
f=testhighcostescalates():bool{
  let tier=policy.classifyrisk($public;$low;5.0);
  let ismedium=mt tier {
    $low:v false;
    $medium:v true;
    $high:v false;
    $critical:v false
  };
  t.assert(ismedium;"cost > 1.0 escalates low risk to medium")
};

(* Test: controls for low risk include base controls *)
f=testcontrolslow():bool{
  let controls=policy.controlsforrisk($low;$public);
  let hascontrols=controls.len>2;
  t.assert(hascontrols;"low risk includes at least 3 base controls")
};

(* Test: controls for high risk include enhanced audit *)
f=testcontrolshigh():bool{
  let controls=policy.controlsforrisk($high;$public);
  let hasmany=controls.len>5;
  t.assert(hasmany;"high risk includes more than 5 controls")
};

(* Test: restricted sensitivity adds local-only-routing control *)
f=testcontrolsrestricted():bool{
  let controls=policy.controlsforrisk($low;$restricted);
  let found=mut.false;
  lp(let ii=0;ii<controls.len;ii=ii+1){
    let c=controls.get(ii);
    if(str.eq(c;"local-only-routing")){
      found=true
    }el{}
  };
  t.assert(found;"restricted sensitivity adds local-only-routing control")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(testlowpublicallow()){pass=pass+1}el{fail=fail+1};
  if(testlowconfidentialwarn()){pass=pass+1}el{fail=fail+1};
  if(testmediumwarn()){pass=pass+1}el{fail=fail+1};
  if(testhighrestrictedapproval()){pass=pass+1}el{fail=fail+1};
  if(testhighpublicwarn()){pass=pass+1}el{fail=fail+1};
  if(testrestrictedescalateshigh()){pass=pass+1}el{fail=fail+1};
  if(testhighcostescalates()){pass=pass+1}el{fail=fail+1};
  if(testcontrolslow()){pass=pass+1}el{fail=fail+1};
  if(testcontrolshigh()){pass=pass+1}el{fail=fail+1};
  if(testcontrolsrestricted()){pass=pass+1}el{fail=fail+1};

  <fail
};

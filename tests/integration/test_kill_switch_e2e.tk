m=tests.integration.testkillswitche2e;
i=t:std.test;
i=str:std.str;
i=ks:core.governance.killswitch;
i=set:core.storage.settings;
i=sdb:core.storage.db;

(* Helper: open an in-memory store for testing *)
f=openteststore():i64{
  let store=mt sdb.openstore(":memory:") {
    $ok:s s;
    $err:e 0
  };
  <store
};

(* Test: engage kill switch sets engaged to true *)
f=testengage():bool{
  let store=openteststore();
  ks.engage(store;"security incident";0 as i32);
  let engaged=ks.isengaged(store);
  t.assert(engaged;"kill switch is engaged after engage()")
};

(* Test: isengaged returns false before any engagement *)
f=testinitialstate():bool{
  let store=openteststore();
  let engaged=ks.isengaged(store);
  t.assert(!engaged;"kill switch is not engaged initially")
};

(* Test: engage stores the reason *)
f=testengagereason():bool{
  let store=openteststore();
  ks.engage(store;"data breach detected";0 as i32);
  let state=ks.loadstate(store);
  let hasreason=str.eq(state.reason;"data breach detected");
  t.assert(hasreason;"kill switch state stores the engagement reason")
};

(* Test: release disengages the kill switch *)
f=testrelease():bool{
  let store=openteststore();
  ks.engage(store;"test reason";0 as i32);
  ks.release(store);
  let engaged=ks.isengaged(store);
  t.assert(!engaged;"kill switch is disengaged after release()")
};

(* Test: release clears the reason *)
f=testreleaseclearsreason():bool{
  let store=openteststore();
  ks.engage(store;"incident";0 as i32);
  ks.release(store);
  let state=ks.loadstate(store);
  let emptyreason=str.eq(state.reason;"");
  t.assert(emptyreason;"release clears the engagement reason")
};

(* Test: engage with auto-release sets auto_release_at *)
f=testautoreleaseset():bool{
  let store=openteststore();
  ks.engage(store;"temporary block";5 as i32);
  let state=ks.loadstate(store);
  let hasautorelease=state.autoreleaseat>0;
  t.assert(hasautorelease;"auto_release_at is set when autoreleaseminutes > 0")
};

(* Test: engage without auto-release has zero auto_release_at *)
f=testnoautorelease():bool{
  let store=openteststore();
  ks.engage(store;"permanent block";0 as i32);
  let state=ks.loadstate(store);
  let noautorelease=state.autoreleaseat=0;
  t.assert(noautorelease;"auto_release_at is zero when autoreleaseminutes = 0")
};

(* Test: format widget shows ENGAGED when engaged *)
f=testwidgetengaged():bool{
  let state=$killswitchstate{
    engaged:true;
    engagedat:1000;
    engagedby:"system";
    reason:"test";
    autoreleaseat:0
  };
  let widget=ks.formatwidget(state);
  let showsengaged=str.contains(widget;"ENGAGED");
  t.assert(showsengaged;"widget displays ENGAGED when kill switch is on")
};

(* Test: format widget shows DISENGAGED when not engaged *)
f=testwidgetdisengaged():bool{
  let state=$killswitchstate{
    engaged:false;
    engagedat:0;
    engagedby:"";
    reason:"";
    autoreleaseat:0
  };
  let widget=ks.formatwidget(state);
  let showsdisengaged=str.contains(widget;"DISENGAGED");
  t.assert(showsdisengaged;"widget displays DISENGAGED when kill switch is off")
};

(* Test: engaged_by is set to system *)
f=testengagedby():bool{
  let store=openteststore();
  ks.engage(store;"audit";0 as i32);
  let state=ks.loadstate(store);
  let issystem=str.eq(state.engagedby;"system");
  t.assert(issystem;"engaged_by is set to system")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(testinitialstate()){pass=pass+1}el{fail=fail+1};
  if(testengage()){pass=pass+1}el{fail=fail+1};
  if(testengagereason()){pass=pass+1}el{fail=fail+1};
  if(testrelease()){pass=pass+1}el{fail=fail+1};
  if(testreleaseclearsreason()){pass=pass+1}el{fail=fail+1};
  if(testautoreleaseset()){pass=pass+1}el{fail=fail+1};
  if(testnoautorelease()){pass=pass+1}el{fail=fail+1};
  if(testwidgetengaged()){pass=pass+1}el{fail=fail+1};
  if(testwidgetdisengaged()){pass=pass+1}el{fail=fail+1};
  if(testengagedby()){pass=pass+1}el{fail=fail+1};

  <fail
};

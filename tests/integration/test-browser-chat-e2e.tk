
m=tests.integration.testbrowserchate2e;

i=pipeline:core.privacy.pipeline;
i=regex:core.privacy.regex;
i=ph:core.privacy.placeholder;
i=guardian:core.privacy.guardian;
i=pt:core.pipeline.types;
i=emitter:core.pipeline.emitter;
i=audit:core.audit.store;
i=metrics:core.savings.metrics;
i=disp:core.providers.dispatcher;
i=chat:page.chat;
i=ppg:page.pipeline;
i=str:std.str;
i=log:shared.log;
i=tu:loke.platform.testing.utilities;


t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(v=false){ <pass(n) }el{ <fail(n;"expected false") }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};


f=offlineconfig():$pipelineconfig{
  <$pipelineconfig{
    presidiourl:"";
    ollamaurl:"";
    nermodelid:"";
    usepresidio:false;
    usener:false;
    dryrun:false
  };
};


f=setupmockprovider():i64{
  let adapter = tu.newmockadapter("llm-provider");
  let response = "{\"response\":\"The capital of France is Paris.\",\"model\":\"mock-llama3\",\"tokens_in\":12,\"tokens_out\":8,\"latency_ms\":42}";
  <tu.mocksetresponse(adapter;response)
};

f=setuptimeoutprovider():i64{
  let adapter = tu.newmockadapter("llm-provider-timeout");
  <tu.mockseterror(adapter;"provider timeout: request exceeded 30000ms deadline")
};


f=verifyallstages(em:i64;results:@$result):@$result{
  let stages = pt.allstages();
  let stagecount = str.arraylen(stages);
  let si = 0;
  lp(let lv=0;true;lv=lv){
    if(si<stagecount){
      let stagename = str.arrayget(stages;si);
      let found = false;
      let ei = 0;
      let eventcount = str.arraylen(em.events);
      lp(let lv2=0;true;lv2=lv2){
        if(ei<eventcount){
          let event = str.arrayget(em.events;ei);
          if(str.eq(event.stage;stagename)){ found = true }el{};
          ei = ei + 1
        }el{
          break
        }
      };
      results = str.arraypush(results;asserttrue(
        str.concat("stage present: ";pt.stagelabel(stagename));
        found
      ));
      si = si + 1
    }el{
      break
    }
  };
  <results
};


f=verifystagelifecycle(em:i64;stagename:str;results:@$result):@$result{
  let hasactive = false;
  let hascomplete = false;
  let activebeforecomplete = false;
  let activeidx = 0-1;
  let completeidx = 0-1;
  let ei = 0;
  let eventcount = str.arraylen(em.events);
  lp(let lv=0;true;lv=lv){
    if(ei<eventcount){
      let event = str.arrayget(em.events;ei);
      if(str.eq(event.stage;stagename)){
        if(str.eq(event.status;"active")){
          hasactive = true;
          activeidx = ei
        }el{};
        if(str.eq(event.status;"complete")){
          hascomplete = true;
          completeidx = ei
        }el{}
      }el{};
      ei = ei + 1
    }el{
      break
    }
  };

  let label = pt.stagelabel(stagename);
  results = str.arraypush(results;asserttrue(
    str.concat(label;" has active event");
    hasactive
  ));
  results = str.arraypush(results;asserttrue(
    str.concat(label;" has complete event");
    hascomplete
  ));
  if(hasactive){
    if(hascomplete){
      activebeforecomplete = activeidx < completeidx;
      results = str.arraypush(results;asserttrue(
        str.concat(label;" active before complete");
        activebeforecomplete
      ))
    }el{}
  }el{};
  <results
};

f=runall():bool{
  let results = @($result);
  let cfg = offlineconfig();
  let tc = tu.defaulttestconfig();
  let db = tc.db;


  let userprompt = "Hi, I'm Alice Smith. My email is alice@example.com. What is the capital of France?";
  let systemprompt = "You are a helpful assistant.";

  let em1 = emitter.new("run-001";"req-001");

  let em1 = emitter.startstage(em1;"input");
  let em1 = emitter.completestage(em1;"input";2;@(pt.$stagedetail));

  let em1 = emitter.startstage(em1;"privacy_scan");
  let detectresult = regex.detect(userprompt);
  let entitycount = str.arraylen(detectresult.entities);
  let em1 = emitter.completestage(em1;"privacy_scan";8;@(
    pt.$stagedetail{key:"entities_found";value:str.fromint(entitycount)};
  ));

  let em1 = emitter.startstage(em1;"anonymisation");
  let anontext = detectresult.anonymised;
  let em1 = emitter.completestage(em1;"anonymisation";5;@(
    pt.$stagedetail{key:"replacements";value:str.fromint(entitycount)};
  ));

  let em1 = emitter.startstage(em1;"token_optimisation");
  let em1 = emitter.completestage(em1;"token_optimisation";3;@(
    pt.$stagedetail{key:"tokens_saved";value:"0"};
  ));

  let em1 = emitter.startstage(em1;"routing");
  let em1 = emitter.completestage(em1;"routing";1;@(
    pt.$stagedetail{key:"provider";value:"mock-ollama"};
    pt.$stagedetail{key:"model";value:"mock-llama3"};
  ));

  let em1 = emitter.startstage(em1;"llm_call");
  let mockprovider = setupmockprovider();
  let mockresponse = tu.mockcall(mockprovider;"chat";anontext);
  let em1 = emitter.completestage(em1;"llm_call";42;@(
    pt.$stagedetail{key:"model";value:"mock-llama3"};
    pt.$stagedetail{key:"tokens_in";value:"12"};
    pt.$stagedetail{key:"tokens_out";value:"8"};
  ));

  let em1 = emitter.startstage(em1;"response_scan");
  let em1 = emitter.completestage(em1;"response_scan";2;@(
    pt.$stagedetail{key:"leaks_detected";value:"0"};
  ));

  let em1 = emitter.startstage(em1;"deanonymisation");
  let phmap = ph.newmap();
  let ei = 0;
  lp(let lv=0;true;lv=lv){
    if(ei<entitycount){
      let entity = str.arrayget(detectresult.entities;ei);
      ph.addentry(phmap;entity.value;entity.placeholder;entity.entitytype);
      ei = ei + 1
    }el{
      break
    }
  };
  let em1 = emitter.completestage(em1;"deanonymisation";3;@(
    pt.$stagedetail{key:"restored";value:"true"};
  ));

  let em1 = emitter.startstage(em1;"output");
  let em1 = emitter.completestage(em1;"output";1;@());

  let run1 = emitter.finalise(em1);


  results = verifyallstages(em1;results);


  let stages = pt.allstages();
  let si = 0;
  let stagecount = str.arraylen(stages);
  lp(let lv=0;true;lv=lv){
    if(si<stagecount){
      let stagename = str.arrayget(stages;si);
      results = verifystagelifecycle(em1;stagename;results);
      si = si + 1
    }el{
      break
    }
  };

  results = str.arraypush(results;asserteq("pipeline overall status is complete";run1.overallstatus;"complete"));

  let expectedtotal = 2 + 8 + 5 + 3 + 1 + 42 + 2 + 3 + 1;
  results = str.arraypush(results;asserttrue(
    "pipeline total_duration_ms is correct";
    run1.totaldurationms = expectedtotal
  ));


  results = str.arraypush(results;assertfalse(
    "anonymised does not contain email";
    str.contains(anontext;"alice@example.com")
  ));

  results = str.arraypush(results;assertfalse(
    "anonymised does not contain name";
    str.contains(anontext;"Alice Smith")
  ));

  results = str.arraypush(results;asserttrue(
    "at least 2 PII entities detected";
    entitycount > 2
  ));

  let restored = ph.restore(anontext;phmap);
  results = str.arraypush(results;asserteq(
    "restore returns original text";
    restored;userprompt
  ));

  let piperesult = pipeline.run(userprompt;systemprompt;cfg);
  results = str.arraypush(results;asserttrue(
    "pipeline privacy scan found entities";
    str.arraylen(piperesult.result.entities) > 2
  ));

  results = str.arraypush(results;asserttrue(
    "guardian injected into system prompt";
    guardian.isguardianpresent(piperesult.finalsystemprompt)
  ));


  let providercalls = tu.mockcallcount(mockprovider);
  results = str.arraypush(results;asserttrue(
    "mock provider received call";
    providercalls > 1
  ));

  results = str.arraypush(results;asserttrue(
    "mock response contains Paris";
    str.contains(mockresponse;"Paris")
  ));

  let routingfound = false;
  let rei = 0;
  let revcount = str.arraylen(em1.events);
  lp(let lv=0;true;lv=lv){
    if(rei<revcount){
      let ev = str.arrayget(em1.events;rei);
      if(str.eq(ev.stage;"routing")){
        if(str.eq(ev.status;"complete")){
          let di = 0;
          let dc = str.arraylen(ev.details);
          lp(let lv2=0;true;lv2=lv2){
            if(di<dc){
              let detail = str.arrayget(ev.details;di);
              if(str.eq(detail.key;"provider")){
                if(str.eq(detail.value;"mock-ollama")){
                  routingfound = true
                }el{}
              }el{};
              di = di + 1
            }el{
              break
            }
          }
        }el{}
      }el{};
      rei = rei + 1
    }el{
      break
    }
  };
  results = str.arraypush(results;asserttrue(
    "routing selected mock-ollama provider";
    routingfound
  ));


  results = str.arraypush(results;assertfalse(
    "pre-send preview differs from original";
    str.eq(anontext;userprompt)
  ));

  results = str.arraypush(results;asserttrue(
    "pre-send preview preserves question";
    str.contains(anontext;"capital of France")
  ));

  results = str.arraypush(results;asserttrue(
    "pre-send preview contains placeholders";
    str.contains(anontext;"<")
  ));


  results = str.arraypush(results;asserteq(
    "pipeline run id preserved";
    run1.id;"run-001"
  ));

  results = str.arraypush(results;asserteq(
    "pipeline run request_id preserved";
    run1.requestid;"req-001"
  ));

  let eventcounttotal = str.arraylen(run1.events);
  results = str.arraypush(results;asserttrue(
    "pipeline run has 18 events (9 stages x 2)";
    eventcounttotal = 18
  ));

  let em2 = emitter.new("run-002";"req-002");
  let em2 = emitter.startstage(em2;"input");
  let em2 = emitter.completestage(em2;"input";1;@());
  let em2 = emitter.startstage(em2;"privacy_scan");
  let em2 = emitter.completestage(em2;"privacy_scan";2;@());
  let em2 = emitter.startstage(em2;"anonymisation");
  let em2 = emitter.completestage(em2;"anonymisation";1;@());
  let em2 = emitter.startstage(em2;"token_optimisation");
  let em2 = emitter.completestage(em2;"token_optimisation";1;@());
  let em2 = emitter.startstage(em2;"routing");
  let em2 = emitter.completestage(em2;"routing";1;@());
  let em2 = emitter.startstage(em2;"llm_call");
  let em2 = emitter.completestage(em2;"llm_call";15;@());
  let em2 = emitter.startstage(em2;"response_scan");
  let em2 = emitter.completestage(em2;"response_scan";1;@());
  let em2 = emitter.startstage(em2;"deanonymisation");
  let em2 = emitter.completestage(em2;"deanonymisation";1;@());
  let em2 = emitter.startstage(em2;"output");
  let em2 = emitter.completestage(em2;"output";1;@());
  let run2 = emitter.finalise(em2);

  results = str.arraypush(results;asserteq(
    "second run has distinct id";
    run2.id;"run-002"
  ));
  results = str.arraypush(results;assertfalse(
    "two runs have different ids";
    str.eq(run1.id;run2.id)
  ));


  results = str.arraypush(results;asserttrue(
    "mock response includes tokens_in";
    str.contains(mockresponse;"tokens_in")
  ));

  results = str.arraypush(results;asserttrue(
    "mock response includes tokens_out";
    str.contains(mockresponse;"tokens_out")
  ));

  results = str.arraypush(results;asserttrue(
    "pipeline total duration is positive";
    run1.totaldurationms > 0
  ));

  results = str.arraypush(results;asserttrue(
    "second run total duration is positive";
    run2.totaldurationms > 0
  ));

  results = str.arraypush(results;assertfalse(
    "run durations differ between interactions";
    run1.totaldurationms = run2.totaldurationms
  ));


  let emtimeout = emitter.new("run-err-001";"req-err-001");
  let emtimeout = emitter.startstage(emtimeout;"input");
  let emtimeout = emitter.completestage(emtimeout;"input";1;@());
  let emtimeout = emitter.startstage(emtimeout;"privacy_scan");
  let emtimeout = emitter.completestage(emtimeout;"privacy_scan";3;@());
  let emtimeout = emitter.startstage(emtimeout;"anonymisation");
  let emtimeout = emitter.completestage(emtimeout;"anonymisation";2;@());
  let emtimeout = emitter.startstage(emtimeout;"token_optimisation");
  let emtimeout = emitter.completestage(emtimeout;"token_optimisation";1;@());
  let emtimeout = emitter.startstage(emtimeout;"routing");
  let emtimeout = emitter.completestage(emtimeout;"routing";1;@());

  let emtimeout = emitter.startstage(emtimeout;"llm_call");
  let timeoutprovider = setuptimeoutprovider();
  let emtimeout = emitter.errorstage(emtimeout;"llm_call";"provider timeout: request exceeded 30000ms deadline");

  let emtimeout = emitter.skipstage(emtimeout;"response_scan";"upstream error");
  let emtimeout = emitter.skipstage(emtimeout;"deanonymisation";"upstream error");
  let emtimeout = emitter.skipstage(emtimeout;"output";"upstream error");

  let runtimeout = emitter.finalise(emtimeout);

  results = str.arraypush(results;asserteq(
    "timeout run overall status is error";
    runtimeout.overallstatus;"error"
  ));

  let timeoutmsgfound = false;
  let tei = 0;
  let tevcount = str.arraylen(emtimeout.events);
  lp(let lv=0;true;lv=lv){
    if(tei<tevcount){
      let tev = str.arrayget(emtimeout.events;tei);
      if(str.eq(tev.stage;"llm_call")){
        if(str.eq(tev.status;"error")){
          if(str.contains(tev.errormessage;"timeout")){
            timeoutmsgfound = true
          }el{}
        }el{}
      }el{};
      tei = tei + 1
    }el{
      break
    }
  };
  results = str.arraypush(results;asserttrue(
    "llm_call error contains timeout message";
    timeoutmsgfound
  ));

  let skipcount = 0;
  let ski = 0;
  lp(let lv=0;true;lv=lv){
    if(ski<tevcount){
      let sev = str.arrayget(emtimeout.events;ski);
      if(str.eq(sev.status;"skipped")){ skipcount = skipcount + 1 }el{};
      ski = ski + 1
    }el{
      break
    }
  };
  results = str.arraypush(results;asserttrue(
    "3 stages skipped after timeout error";
    skipcount = 3
  ));


  let emfail = emitter.new("run-err-002";"req-err-002");
  let emfail = emitter.startstage(emfail;"input");
  let emfail = emitter.completestage(emfail;"input";1;@());

  let emfail = emitter.startstage(emfail;"privacy_scan");
  let emfail = emitter.errorstage(emfail;"privacy_scan";"regex engine: invalid pattern in custom entity rule");

  let emfail = emitter.skipstage(emfail;"anonymisation";"upstream error");
  let emfail = emitter.skipstage(emfail;"token_optimisation";"upstream error");
  let emfail = emitter.skipstage(emfail;"routing";"upstream error");
  let emfail = emitter.skipstage(emfail;"llm_call";"upstream error");
  let emfail = emitter.skipstage(emfail;"response_scan";"upstream error");
  let emfail = emitter.skipstage(emfail;"deanonymisation";"upstream error");
  let emfail = emitter.skipstage(emfail;"output";"upstream error");

  let runfail = emitter.finalise(emfail);

  results = str.arraypush(results;asserteq(
    "stage failure run overall status is error";
    runfail.overallstatus;"error"
  ));

  let scanerrfound = false;
  let fei = 0;
  let fevcount = str.arraylen(emfail.events);
  lp(let lv=0;true;lv=lv){
    if(fei<fevcount){
      let fev = str.arrayget(emfail.events;fei);
      if(str.eq(fev.stage;"privacy_scan")){
        if(str.eq(fev.status;"error")){
          if(str.contains(fev.errormessage;"regex engine")){
            scanerrfound = true
          }el{}
        }el{}
      }el{};
      fei = fei + 1
    }el{
      break
    }
  };
  results = str.arraypush(results;asserttrue(
    "privacy_scan error message preserved";
    scanerrfound
  ));

  let failskipcount = 0;
  let fsi = 0;
  lp(let lv=0;true;lv=lv){
    if(fsi<fevcount){
      let fsev = str.arrayget(emfail.events;fsi);
      if(str.eq(fsev.status;"skipped")){ failskipcount = failskipcount + 1 }el{};
      fsi = fsi + 1
    }el{
      break
    }
  };
  results = str.arraypush(results;asserttrue(
    "7 stages skipped after privacy_scan failure";
    failskipcount = 7
  ));

  results = str.arraypush(results;asserteq(
    "error run request_id preserved for audit";
    runfail.requestid;"req-err-002"
  ));


  let cleanprompt = "What are the three laws of thermodynamics?";
  let cleanresult = pipeline.run(cleanprompt;"";cfg);

  results = str.arraypush(results;asserteq(
    "clean text unchanged after pipeline";
    cleanresult.result.anonymised;cleanprompt
  ));

  results = str.arraypush(results;asserttrue(
    "clean text has zero entities";
    str.arraylen(cleanresult.result.entities) = 0
  ));


  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i<n){
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed=false){ all=false }el{};
      i = i + 1
    }el{
      break
    }
  };
  <all
};

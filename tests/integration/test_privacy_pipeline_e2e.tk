m=tests.integration.testprivacypipelinee2e;
i=t:std.test;
i=str:std.str;
i=pipe:core.privacy.pipeline;
i=ph:core.privacy.placeholder;
i=regex:core.privacy.regex;
i=types:shared.types;

(* Test: pipeline detects email PII in mixed text *)
f=testdetectsemail():bool{
  let config=pipe.newconfig("http://127.0.0.1:5002";"http://127.0.0.1:11434");
  let text="Please email jane.doe@corp.com for the report";
  let run=pipe.run(text;"";config);
  let found=run.totalentities>0;
  t.assert(found;"pipeline detects email entity in mixed text")
};

(* Test: pipeline detects phone number via regex *)
f=testdetectsphone():bool{
  let result=regex.detect("Ring me on 0412 345 678 tomorrow");
  let found=result.entities.len>0;
  t.assert(found;"regex layer detects AU phone number")
};

(* Test: pipeline detects multiple PII types *)
f=testdetectsmultipletypes():bool{
  let config=pipe.newconfig("http://127.0.0.1:5002";"http://127.0.0.1:11434");
  let text="Contact jane@test.com or call 0412345678 about John Smith";
  let run=pipe.run(text;"";config);
  let multipleentities=run.totalentities>1;
  t.assert(multipleentities;"pipeline detects more than one PII entity type")
};

(* Test: anonymised text contains placeholders not raw PII *)
f=testanonymisedhasplaceholders():bool{
  let config=pipe.newconfig("http://127.0.0.1:5002";"http://127.0.0.1:11434");
  let text="Email jane@test.com for info";
  let run=pipe.run(text;"";config);
  let anonymised=run.result.anonymised;
  let norawemail=!str.contains(anonymised;"jane@test.com");
  let hasplaceholder=str.contains(anonymised;"[");
  t.assert(norawemail;"anonymised text does not contain raw email");
  t.assert(hasplaceholder;"anonymised text contains placeholder bracket")
};

(* Test: anonymised text differs from original when PII present *)
f=testanonymiseddiffers():bool{
  let config=pipe.newconfig("http://127.0.0.1:5002";"http://127.0.0.1:11434");
  let text="Send to bob@example.org please";
  let run=pipe.run(text;"";config);
  let differs=!str.eq(run.result.anonymised;text);
  t.assert(differs;"anonymised text differs from original when PII present")
};

(* Test: placeholder restore returns original text *)
f=testrestoreoriginal():bool{
  let map=ph.newmap();
  ph.addentry(map;"jane@test.com";"[EMAIL_1]";"email");
  ph.addentry(map;"0412345678";"[PHONE_AU_2]";"phone_au");
  let llmout="The user [EMAIL_1] called from [PHONE_AU_2].";
  let restored=ph.restore(llmout;map);
  let hasemail=str.contains(restored;"jane@test.com");
  let hasphone=str.contains(restored;"0412345678");
  t.assert(hasemail;"restored text contains original email");
  t.assert(hasphone;"restored text contains original phone")
};

(* Test: sensitivity escalates to confidential for email *)
f=testsensitivityemail():bool{
  let entities=@(
    $piientity{entitytype:"email";value:"a@b.com";start:0;end:0;confidence:0.95;placeholder:"[EMAIL_1]"}
  );
  let level=pipe.maxsensitivity(entities);
  let isconfidential=mt level {
    $public:v false;
    $internal:v false;
    $confidential:v true;
    $restricted:v true
  };
  t.assert(isconfidential;"email entity produces confidential or higher sensitivity")
};

(* Test: clean text produces zero entities *)
f=testcleantext():bool{
  let config=pipe.newconfig("http://127.0.0.1:5002";"http://127.0.0.1:11434");
  let text="The weather is nice today";
  let run=pipe.run(text;"";config);
  let noentities=run.totalentities=0;
  t.assert(noentities;"clean text without PII produces zero entities")
};

(* Test: pipeline preserves original text in result *)
f=testpreservesoriginal():bool{
  let config=pipe.newconfig("http://127.0.0.1:5002";"http://127.0.0.1:11434");
  let text="Email admin@loke.dev for access";
  let run=pipe.run(text;"";config);
  let preserved=str.eq(run.result.original;text);
  t.assert(preserved;"pipeline result preserves original text")
};

(* Test: pipeline produces multiple stages *)
f=testpipelinestages():bool{
  let config=pipe.newconfig("http://127.0.0.1:5002";"http://127.0.0.1:11434");
  let run=pipe.run("test@e.com says hello";"";config);
  let stagecount=run.stages.len;
  let hasstages=stagecount>2;
  t.assert(hasstages;"pipeline run produces at least 3 stages")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(testdetectsemail()){pass=pass+1}el{fail=fail+1};
  if(testdetectsphone()){pass=pass+1}el{fail=fail+1};
  if(testdetectsmultipletypes()){pass=pass+1}el{fail=fail+1};
  if(testanonymisedhasplaceholders()){pass=pass+1}el{fail=fail+1};
  if(testanonymiseddiffers()){pass=pass+1}el{fail=fail+1};
  if(testrestoreoriginal()){pass=pass+1}el{fail=fail+1};
  if(testsensitivityemail()){pass=pass+1}el{fail=fail+1};
  if(testcleantext()){pass=pass+1}el{fail=fail+1};
  if(testpreservesoriginal()){pass=pass+1}el{fail=fail+1};
  if(testpipelinestages()){pass=pass+1}el{fail=fail+1};

  <fail
};

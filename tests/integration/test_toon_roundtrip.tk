m=tests.integration.testtoonroundtrip;
i=t:std.test;
i=str:std.str;
i=toon:core.optimiser.toon;
i=tt:core.optimiser.toontypes;

(* Test: encode boolean true as "y" *)
(* The match subjects are annotated with $toonvalue. toke miscompiles a match of three
   or more arms whose subject type it cannot see, and a value bound from a call carries
   no type — the result is a crash at run time, not a compile error (T-2). *)
f=testencodebooltrue():bool{
  let encoded=toon.encodebool(true);
  let isy=str.eq(encoded;"y");
  <t.assert(isy;"boolean true encodes to y")
};

(* Test: encode boolean false as "n" *)
f=testencodeboolfalse():bool{
  let encoded=toon.encodebool(false);
  let isn=str.eq(encoded;"n");
  <t.assert(isn;"boolean false encodes to n")
};

(* Test: decode scalar "y" as bool *)
f=testdecodebooly():bool{
  let decoded:$toonvalue=toon.decodescalar("y");
  let isbool=mt decoded {
    $tvbool:v true;
    $tvnull:v false;
    $tvint:v false;
    $tvfloat:v false;
    $tvstr:v false;
    $tvarr:v false;
    $tvobj:v false
  };
  <t.assert(isbool;"scalar y decodes to tvbool")
};

(* Test: decode scalar "~" as null *)
f=testdecodenull():bool{
  let decoded:$toonvalue=toon.decodescalar("~");
  let isnull=mt decoded {
    $tvnull:v true;
    $tvbool:v false;
    $tvint:v false;
    $tvfloat:v false;
    $tvstr:v false;
    $tvarr:v false;
    $tvobj:v false
  };
  <t.assert(isnull;"scalar ~ decodes to tvnull")
};

(* Test: decode integer string as tvint *)
f=testdecodeint():bool{
  let decoded:$toonvalue=toon.decodescalar("42");
  let isint=mt decoded {
    $tvint:v true;
    $tvnull:v false;
    $tvbool:v false;
    $tvfloat:v false;
    $tvstr:v false;
    $tvarr:v false;
    $tvobj:v false
  };
  <t.assert(isint;"scalar 42 decodes to tvint")
};

(* Test: JSON to TOON conversion succeeds. LS1.1x: jsontotoon answers a plain string, read
   by isconverted; the match this replaced was on a str!$lokeerr and took its first arm
   whatever the value (T-18), so it could not have seen a failure. *)
f=testjsontotoon():bool{
  <t.assert(toon.isconverted(toon.jsontotoon("{\"name\":\"test\"}";toon.defaultopts()));"jsontotoon succeeds for simple JSON object")
};

(* Test: TOON to JSON conversion succeeds for scalar *)
f=testtoontojsonscalar():bool{
  <t.assert(toon.isconverted(toon.toontojson("42"));"toontojson succeeds for integer scalar")
};

(* Test: round-trip JSON -> TOON -> JSON for boolean *)
f=testroundtripbool():bool{
  let jsonback=toon.toontojson(toon.jsontotoon("true";toon.defaultopts()));
  <t.assert(str.len(jsonback)>0;"boolean round-trips through TOON encoding")
};

(* LS1.1x — the failure paths, which no test could reach while these were results. *)
f=testfailures():bool{
  let a=t.assert(!toon.isconverted(toon.jsontotoon("";toon.defaultopts()));"jsontotoon of empty input is not converted");
  let b=t.assert(!toon.isconverted(toon.toontojson("HDR[a|b]"));"toontojson of a table with no rows is not converted");
  let c=t.assert(!toon.isparsed(toon.decode("HDR[a|b]"));"decode of a table with no rows is not parsed");
  let d=t.assert(!toon.isparsed(toon.fromjsonstr("   "));"fromjsonstr of blank input is not parsed");
  let e=t.assert(toon.isparsed(toon.decode("HDR[a|b]
1|2"));"and a table with a row is");
  <a && b && c && d && e
};

(* Test: measure savings returns percentage *)
(* Asserted through measuresavingsbp, by equality.
   This function used to read `let savings=toon.measuresavings(...)` and assert `savings>0.0`,
   and it PASSED for as long as it existed while the value was a denormal — a positive
   denormal is greater than zero. It imported the production module and was counted as
   exercising it while asserting nothing about it. An integer basis-point equality cannot
   pass that way. See tests/unit/optimiser/test_toon.tk for the full diagnosis. *)
f=testmeasuresavings():bool{
  let savingsbp=toon.measuresavingsbp("{\"name\":\"value\"}";"name:value");
  <t.assert(savingsbp==3750;"16 characters encoded to 10 is exactly 3750 basis points")
};

(* Test: default options have sensible values *)
f=testdefaultopts():bool{
  let opts=toon.defaultopts();
  let hasmaxlen=opts.maxstrlen>0;
  let omitnulls=opts.omitnulls;
  t.assert(hasmaxlen;"default opts has positive maxstrlen");
  <t.assert(omitnulls;"default opts omits nulls")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(testencodebooltrue()){pass=pass+1}el{fail=fail+1};
  if(testencodeboolfalse()){pass=pass+1}el{fail=fail+1};
  if(testdecodebooly()){pass=pass+1}el{fail=fail+1};
  if(testdecodenull()){pass=pass+1}el{fail=fail+1};
  if(testdecodeint()){pass=pass+1}el{fail=fail+1};
  if(testjsontotoon()){pass=pass+1}el{fail=fail+1};
  if(testtoontojsonscalar()){pass=pass+1}el{fail=fail+1};
  if(testroundtripbool()){pass=pass+1}el{fail=fail+1};
  if(testfailures()){pass=pass+1}el{fail=fail+1};
  if(testmeasuresavings()){pass=pass+1}el{fail=fail+1};
  if(testdefaultopts()){pass=pass+1}el{fail=fail+1};

  <fail
};

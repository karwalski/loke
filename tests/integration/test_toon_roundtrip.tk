m=tests.integration.testtoonroundtrip;
i=t:std.test;
i=str:std.str;
i=toon:core.optimiser.toon;
i=tt:core.optimiser.toontypes;

(* Test: encode boolean true as "y" *)
f=testencodebooltrue():bool{
  let encoded=toon.encodebool(true);
  let isy=str.eq(encoded;"y");
  t.assert(isy;"boolean true encodes to y")
};

(* Test: encode boolean false as "n" *)
f=testencodeboolfalse():bool{
  let encoded=toon.encodebool(false);
  let isn=str.eq(encoded;"n");
  t.assert(isn;"boolean false encodes to n")
};

(* Test: decode scalar "y" as bool *)
f=testdecodebooly():bool{
  let decoded=toon.decodescalar("y");
  let isbool=mt decoded {
    $tvbool:v true;
    $tvnull:v false;
    $tvint:v false;
    $tvfloat:v false;
    $tvstr:v false;
    $tvarr:v false;
    $tvobj:v false
  };
  t.assert(isbool;"scalar y decodes to tvbool")
};

(* Test: decode scalar "~" as null *)
f=testdecodenull():bool{
  let decoded=toon.decodescalar("~");
  let isnull=mt decoded {
    $tvnull:v true;
    $tvbool:v false;
    $tvint:v false;
    $tvfloat:v false;
    $tvstr:v false;
    $tvarr:v false;
    $tvobj:v false
  };
  t.assert(isnull;"scalar ~ decodes to tvnull")
};

(* Test: decode integer string as tvint *)
f=testdecodeint():bool{
  let decoded=toon.decodescalar("42");
  let isint=mt decoded {
    $tvint:v true;
    $tvnull:v false;
    $tvbool:v false;
    $tvfloat:v false;
    $tvstr:v false;
    $tvarr:v false;
    $tvobj:v false
  };
  t.assert(isint;"scalar 42 decodes to tvint")
};

(* Test: JSON to TOON conversion succeeds *)
f=testjsontotoon():bool{
  let rawjson="{\"name\":\"test\"}";
  let result=mt toon.jsontotoon(rawjson;toon.defaultopts()) {
    $ok:v true;
    $err:e false
  };
  t.assert(result;"jsontotoon succeeds for simple JSON object")
};

(* Test: TOON to JSON conversion succeeds for scalar *)
f=testtoontojsonscalar():bool{
  let result=mt toon.toontojson("42") {
    $ok:v true;
    $err:e false
  };
  t.assert(result;"toontojson succeeds for integer scalar")
};

(* Test: round-trip JSON -> TOON -> JSON for boolean *)
f=testroundtripbool():bool{
  let rawjson="true";
  let toonresult=mt toon.jsontotoon(rawjson;toon.defaultopts()) {
    $ok:v v;
    $err:e ""
  };
  let jsonback=mt toon.toontojson(toonresult) {
    $ok:v v;
    $err:e ""
  };
  let notempty=str.len(jsonback)>0;
  t.assert(notempty;"boolean round-trips through TOON encoding")
};

(* Test: measure savings returns percentage *)
f=testmeasuresavings():bool{
  let savings=toon.measuresavings("{\"name\":\"value\"}";"name:value");
  let positive=savings>0.0;
  t.assert(positive;"TOON encoding produces positive savings percentage")
};

(* Test: default options have sensible values *)
f=testdefaultopts():bool{
  let opts=toon.defaultopts();
  let hasmaxlen=opts.maxstrlen>0;
  let omitnulls=opts.omitnulls;
  t.assert(hasmaxlen;"default opts has positive maxstrlen");
  t.assert(omitnulls;"default opts omits nulls")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(testencodebooltrue()){pass=pass+1}el{fail=fail+1};
  if(testencodeboolfalse()){pass=pass+1}el{fail=fail+1};
  if(testdecodebooly()){pass=pass+1}el{fail=fail+1};
  if(testdecodenull()){pass=pass+1}el{fail=fail+1};
  if(testdecodeint()){pass=pass+1}el{fail=fail+1};
  if(testjsontotoon()){pass=pass+1}el{fail=fail+1};
  if(testtoontojsonscalar()){pass=pass+1}el{fail=fail+1};
  if(testroundtripbool()){pass=pass+1}el{fail=fail+1};
  if(testmeasuresavings()){pass=pass+1}el{fail=fail+1};
  if(testdefaultopts()){pass=pass+1}el{fail=fail+1};

  <fail
};


m=tests.integration.testcliask;

i=ask:loke.cli.ask;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();


  let opts = ask.defaultopts();
  results = str.arraypush(results;asserteq("default model_id is loke-router";opts.modelid;"loke-router"));

  results = str.arraypush(results;assertfalse("default dry_run is false";opts.dryrun));

  results = str.arraypush(results;asserttrue("default stream is true";opts.stream));

  results = str.arraypush(results;assertfalse("default stdin_input is false";opts.stdininput));

  results = str.arraypush(results;asserteq("default system_prompt is empty";opts.systemprompt;""));

  results = str.arraypush(results;asserteq("default tolerance is instant";opts.tolerance;"instant"));


  let dryopts = ask.$askopts{
    modelid:"claude-sonnet-4-20250514";
    dryrun:true;
    stream:false;
    stdininput:false;
    systemprompt:"You are a test assistant.";
    tolerance:"instant"
  };
  let result = ask.run("What is 2+2?";dryopts);

  results = str.arraypush(results;asserttrue(
    "dry-run response contains marker";
    str.contains(result.response;"dry-run")
  ));

  results = str.arraypush(results;asserteq(
    "dry-run model_id matches";
    result.modelid;"claude-sonnet-4-20250514"
  ));

  results = str.arraypush(results;asserttrue("dry-run tokens_in is 0";result.tokensin = 0));
  results = str.arraypush(results;asserttrue("dry-run tokens_out is 0";result.tokensout = 0));

  results = str.arraypush(results;asserttrue("dry-run cost_usd is 0";result.costusd = 0.0));

  results = str.arraypush(results;asserteq("dry-run request_id";result.requestid;"dry-run"));

  results = str.arraypush(results;asserteq("dry-run sensitivity";result.sensitivity;"none"));

  results = str.arraypush(results;asserttrue("dry-run entities_found is 0";result.entitiesfound = 0));


  let ollamaopts = ask.$askopts{
    modelid:"qwen2.5:7b";
    dryrun:true;
    stream:true;
    stdininput:false;
    systemprompt:"";
    tolerance:"considered"
  };
  let ollamaresult = ask.run("Explain recursion";ollamaopts);
  results = str.arraypush(results;asserteq(
    "ollama model_id preserved";
    ollamaresult.modelid;"qwen2.5:7b"
  ));

  results = str.arraypush(results;asserttrue(
    "dry-run response mentions model";
    str.contains(ollamaresult.response;"qwen2.5:7b")
  ));

  results = str.arraypush(results;asserttrue("result response non-empty";str.len(result.response) > 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};

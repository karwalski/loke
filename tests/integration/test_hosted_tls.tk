m=test.integration.hostedtls;

i=t:std.test;
i=io:std.io;
i=str:std.str;
i=file:std.file;
i=args:std.args;
i=std:std;
i=process:std.process;
i=sh:shared.types;
i=pipe:core.privacy.pipeline;
i=sp:core.privacy.systemprompt;
i=sdb:core.storage.db;
i=dl:core.audit.disclosure;
i=ks:core.governance.killswitch;
i=ant:core.providers.anthropic;
i=oai:core.providers.openai;
i=pt:core.providers.types;
i=oauth:loke.core.auth.oauth;
i=refresh:loke.core.auth.refresh;
i=rep:core.feedback.report;
i=fbp:core.feedback.pipeline;
i=h:page.api.pipeline;
i=kcs:std.keychain;
i=tstore:loke.core.auth.tokenstore;

(* VM1.6g. Every hosted call site, judged over TLS by what a stand-in on loopback received.

   The sites VM1.6f left waiting were written in two forms measured to send nothing: the
   two-argument `http.get(url;@(http.header(...)))`, a route registration (T-57), and the
   client-first `http.postheaders(http.client(url);...)` (T-48). toke 3.1.0 rejects both at
   compile time (E4031, E4026), so F10.39 moved every site to a form that compiles, and F5.11
   put the providers on core.providers.transport, which sends https to any host because the
   client now verifies the certificate and its name (T-58 lifted). What no test showed until
   this one is each SITE doing that: test_https_verify.tk measures transport.post with a fixed
   body, and test_hosted_requests.tk measures the sites over plain http.

   So each site is driven here, through its production function, at scripts/lib/
   http_recorder.py serving TLS on 127.0.0.1 with certificates scripts/lib/tls_fixture.sh
   makes for this run:
     - the browser pipeline's Anthropic hop (page.api.pipeline.walkchain, as toanthropic calls
       it), from text the privacy filter has run over;
     - core.providers.anthropic and openai.completeplainat, given the request loke ask builds:
       the anonymised text and the final system prompt;
     - core.auth.oauth.exchangecode and core.auth.refresh.dorefresh, at a loopback token
       endpoint;
     - core.feedback.report.submittogithubat and core.feedback.pipeline.submitbatchat.
   For each: from a certificate the test CA signed, with the CA trusted, the request arrives
   with its headers over a completed handshake; from a self-signed certificate nothing
   arrives. The provider sites are also judged on WHAT arrived: placeholders, and no
   identifier from the text or the system prompt. The kill switch is engaged once over TLS,
   and nothing arrives.

   The trusted cases need SSL_CERT_FILE in the calling process, and loke's binaries are not
   granted env.write, so each runs in a child: this binary again, through env(1), with the
   site's name and the stand-in's URL. The child exits 0 only when the site reports the
   stand-in's answer. As in test_https_verify.tk, env(1) is a system binary, so the child runs
   without the real-HOME guard's library; it keeps the throwaway HOME. No request leaves the
   machine, and no key is real. core.auth.oauth.revoke reads its token from the keychain, so it
   is not driven here (it is the same call as exchangecode). Nothing in production reads
   SSL_CERT_FILE from loke's configuration, and the test CA lives in this run's scratch
   directory only.

   VM1.6i. The same stand-in, judged on what each site READ from the answer: exchangecode
   reports the endpoint's access_token and refresh_token each from its own field (it used to
   report the refresh token as the access token); submitbatchat reads the issue's html_url
   from GitHub's 201. With `?status=NNN` the stand-in answers the same body under that status,
   so a site that ignores the status is seen to: a 400 from the token endpoint and a 401 from
   GitHub are failures that name the status and no token, for exchangecode, dorefresh,
   submitbatchat and submittogithubat. And completeauthorise and getvalidtoken are driven into
   a KEYCHAIN, which must be a throwaway one (X8.7): the "store" child creates a keychain file
   under the throwaway HOME, selects it with std.keychain.use before any keychain call, and
   destroys it, as tests/unit/storage/test_keychain.tk does. If it cannot be created or
   selected the child stops before its first keychain call. The accounts are read back by
   their spelled-out names, so a store that put each token under the other's account fails. *)

f=scratch():str{
  let hex:str=str.randhex(8);
  <"/tmp/loke_hostedtls_\(hex)"
};

f=readfile(p:str):str{
  <mt file.read(p) { $ok:v v; $err:e "" }
};

f=pause():i64{
  let h=mt process.spawn(@("sleep";"0.1")) { $ok:h h; $err:e 0 };
  if(h!=0){ process.wait(h); }el{};
  <0
};

f=waitfile(p:str):str{
  let v=mut."";
  lp(let k=0;k<150 && str.len(v)==0;k=k+1){
    v=readfile(p);
    if(str.len(v)==0){ pause() }el{}
  };
  <v
};

f=waitcontains(p:str;needle:str):bool{
  let seen=mut.false;
  lp(let k=0;k<50 && seen==false;k=k+1){
    seen=str.contains(readfile(p);needle);
    if(seen==false){ pause() }el{}
  };
  <seen
};

(* The text and system prompt every provider site starts from. Each identifier must be
   replaced before anything is sent; none may reach a stand-in. *)
f=usertext():str{
  <"Please write to user.probe@example.com about the invoice."
};

f=systext():str{
  <"You are helping caller.probe@example.com, ABN 51 824 753 556."
};

f=localonly():$pipelineconfig{
  <pipe.newconfig("http://127.0.0.1:59998";"http://127.0.0.1:59999")
};

f=routeto(id:str;prov:$provider):$routingdecision{
  <$routingdecision{
    model:$modelspec{
      id:id;
      provider:prov;
      contextwindow:32768 as u32;
      costper1kinput:0.0;
      costper1koutput:0.0;
      tier:$modeltier{$interactive:0}
    };
    reason:"test";
    tier:$modeltier{$interactive:0};
    estimatedcost:0.0;
    estimatedlatencyms:0 as u32
  }
};

f=openfreshstore():i64{
  let dir=str.concat(std.homedir();"/.loke/test-hosted-tls");
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  file.delete(str.concat(dir;"/loke.db-wal"));
  file.delete(str.concat(dir;"/loke.db-shm"));
  <mt sdb.openstore(dir) { $ok:s 1; $err:e 0 }
};

(* The request loke ask builds after the scan (packages/cli/src/ask.tk): the anonymised text
   as the user message and the final system prompt. *)
f=askrequest(run:$pipelinerun;modelid:str):$completionrequest{
  let res:$piidetectionresult=run.result;
  <$completionrequest{
    modelid:modelid;
    messages:@(pt.usermsg(res.anonymised));
    systemprompt:run.finalsystemprompt;
    maxtokens:64 as u32;
    temperature:0.0;
    stream:false
  }
};

(* ── The children: one site each ─────────────────────────────────────────────────── *)

(* The browser pipeline's Anthropic hop, as toanthropic sends it. 0 when the stand-in's text
   came back and the dispatch has its disclosure row; 2 when it answered with no row; 1 when
   nothing came back. With `killed`, the provider is switched off first, and 0 means the hop
   was refused by the kill switch. *)
f=childpipeline(url:str;killed:bool):i64{
  let store=openfreshstore();
  if(store==0){ <3 }el{};
  if(killed){ ks.engageprovider(store;"anthropic";"VM1.6g test") }el{};
  let run=sp.runforward(usertext();systext();localonly());
  let route=routeto("claude-probe-model";$provider{$anthropic:0});
  let reply=h.walkchain(store;run;h.onehop(run.result;route);h.routercfg(store);h.optimisefor(run;"";20);h.privacyfields(run);sh.nowms();h.decide(run);"user_choice";"user";dl.nosession();h.ollamabase();url;"sk-ant-tls-test-key-000000");
  if(killed){
    if(str.contains(reply;"kill_switch")){ <0 }el{ <1 }
  }el{};
  if(str.contains(reply;"answered-by-recorder")){}el{ <1 };
  if(dl.sentbytes(run.requestid)>0){ <0 }el{ <2 }
};

f=childanthropic(url:str):i64{
  let run=sp.runforward(usertext();systext();localonly());
  let r:$completionresponse=ant.completeplainat(ant.new("sk-ant-tls-test-key-000000");askrequest(run;"claude-probe-model");url);
  if(pt.iscompletion(r) && str.eq(r.content;"answered-by-recorder")){ <0 }el{ <1 }
};

f=childopenai(url:str):i64{
  let run=sp.runforward(usertext();systext();localonly());
  let r:$completionresponse=oai.completeplainat(oai.new("sk-oai-tls-test-key-000000");askrequest(run;"gpt-probe-model");url);
  if(pt.iscompletion(r) && str.eq(r.content;"answered-by-recorder")){ <0 }el{ <1 }
};

f=oauthcfg(tokenurl:str):$oauthconfig{
  <$oauthconfig{adapterid:"tls-test";clientid:"client-tls-test";authoriseurl:"";tokenurl:tokenurl;scopes:"read";revokeurl:"";callbackport:0}
};

f=notokens():$tokenset{
  <$tokenset{accesstoken:"";refreshtoken:"";expiresat:0;scopes:""}
};

(* 0 when each token came from its own field and the expiry from expires_in (3600 s);
   4 when the access token is the refresh token (VM1.6i as found); 6 when the refresh token
   is wrong; 7 when the expiry is; 1 when no access token came back. *)
f=childoauth(url:str):i64{
  let tok=mt oauth.exchangecode(oauthcfg(url);"code-tls-test";"verifier-tls-test";"http://localhost:8739/callback") {
    $ok:v v;
    $oautherr:e notokens()
  };
  if(str.eq(tok.accesstoken;"recorder-refresh-token")){ <4 }el{};
  if(!str.eq(tok.accesstoken;"recorder-access-token")){ <1 }el{};
  if(!str.eq(tok.refreshtoken;"recorder-refresh-token")){ <6 }el{};
  let left=tok.expiresat-(sh.nowms()/1000);
  if(left<3500 || left>3700){ <7 }el{};
  <0
};

(* The token endpoint answers 400 with a body that looks like success. 0 when exchangecode
   answers its error naming the status and no token; 1 when it answered $ok. *)
f=childoauthstatus(url:str):i64{
  let desc=mt oauth.exchangecode(oauthcfg(url);"code-tls-test";"verifier-tls-test";"http://localhost:8739/callback") {
    $ok:v "answered-ok";
    $oautherr:e e.errordesc
  };
  if(desc=="answered-ok"){ <1 }el{};
  if(str.contains(desc;"recorder-")){ <2 }el{};
  if(str.contains(desc;"400")){ <0 }el{};
  <3
};

f=childrefresh(url:str):i64{
  let r=refresh.dorefresh(url;"client-tls-test";"refresh-tls-test");
  if(r.ok && str.eq(r.accesstoken;"recorder-access-token") && str.eq(r.refreshtoken;"recorder-refresh-token")){ <0 }el{ <1 }
};

f=childrefreshstatus(url:str):i64{
  let r=refresh.dorefresh(url;"client-tls-test";"refresh-tls-test");
  if(r.ok){ <1 }el{};
  if(str.contains(r.errormsg;"recorder-") || str.contains(r.errormsg;"refresh-tls-test")){ <2 }el{};
  if(r.status==400 && str.len(r.accesstoken)==0){ <0 }el{ <3 }
};

(* ── The keychain (X8.7: a throwaway keychain file, never the user's) ───────────── *)

f=kcread(adapterid:str;field:str):str{
  <mt kcs.get("dev.loke";"oauth.\(adapterid).\(field)") { $some:v v; $none:v "" }
};

f=kchas(adapterid:str):bool{
  <kcs.exists("dev.loke";"oauth.\(adapterid).access_token")
};

f=tokencfg(adapterid:str;tokenurl:str):$oauthconfig{
  <$oauthconfig{adapterid:adapterid;clientid:"client-tls-test";authoriseurl:"";tokenurl:tokenurl;scopes:"read";revokeurl:"";callbackport:0}
};

f=bit(ok:bool;b:i64):i64{
  if(ok){ <0 }el{ <b }
};

(* completeauthorise and getvalidtoken, into a throwaway keychain. `url` is the stand-in's
   token endpoint. Exits with one bit per property that FAILED, 0 when all held; 255 when
   no throwaway keychain could be made, and then no keychain call has been made at all. *)
f=childstore(url:str):i64{
  let hex:str=str.randhex(8);
  let kp="\(std.homedir())/loke-test-oauth-\(hex).keychain-db";
  if(!kcs.create(kp;"loke-throwaway")){ <255 }el{};
  if(!kcs.use(kp)){ kcs.destroy(kp); <255 }el{};
  let cfg=oauthcfg(url);
  let auth=$authstate{stateparam:"state-tls-test";codeverifier:"verifier-tls-test";redirecturi:"http://localhost:8739/callback"};
  let done=mt oauth.completeauthorise(cfg;auth;"state-tls-test";"code-tls-test") { $ok:v true; $oautherr:e false };
  let failed=mut.bit(done && tstore.loadexpiresat("tls-test")>0;1);
  failed=failed+bit(str.eq(kcread("tls-test";"access_token");"recorder-access-token");2);
  failed=failed+bit(str.eq(kcread("tls-test";"refresh_token");"recorder-refresh-token");4);

  (* A state mismatch, and a token endpoint answering 400, store nothing. *)
  let mcfg=tokencfg("tls-mismatch";url);
  let mism=mt oauth.completeauthorise(mcfg;auth;"forged-state";"code-tls-test") { $ok:v true; $oautherr:e false };
  let dcfg=tokencfg("tls-denied";"\(url)?status=400");
  let denied=mt oauth.completeauthorise(dcfg;auth;"state-tls-test";"code-tls-test") { $ok:v true; $oautherr:e false };
  failed=failed+bit(!mism && !kchas("tls-mismatch") && !denied && !kchas("tls-denied");8);

  (* A refresh that rotates the refresh token: both new tokens are stored. *)
  kcs.set("dev.loke";"oauth.tls-test.access_token";"old-access-token");
  kcs.set("dev.loke";"oauth.tls-test.refresh_token";"old-refresh-token");
  kcs.set("dev.loke";"oauth.tls-test.expires_at";"0");
  let fresh=refresh.getvalidtoken(cfg);
  failed=failed+bit(str.eq(fresh;"recorder-access-token") && str.eq(kcread("tls-test";"access_token");"recorder-access-token");16);
  failed=failed+bit(str.eq(kcread("tls-test";"refresh_token");"recorder-refresh-token");32);

  (* A refresh answered 400 (invalid_grant) is permanent: no token, and the stored ones go. *)
  kcs.set("dev.loke";"oauth.tls-test.expires_at";"0");
  let gone=refresh.getvalidtoken(tokencfg("tls-test";"\(url)?status=400"));
  failed=failed+bit(str.len(gone)==0 && !kchas("tls-test");64);

  kcs.destroy(kp);
  <failed
};

f=issue():$issuereport{
  <$issuereport{id:"r1";reporttype:"bug";description:"the tls probe report";stepstoreproduce:"";expected:"";version:"0";platform:"test";createdat:0}
};

f=ghcfg():$githubconfig{
  <$githubconfig{owner:"o";repo:"r";token:"gh-tls-test-token"}
};

f=batch():$submissionbatch{
  <$submissionbatch{entriescount:2;thumbsup:1;thumbsdown:1;topareas:@("tls");periodlabel:"tls-probe"}
};

f=childreport(url:str):i64{
  if(rep.submittogithubat(issue();url;"gh-tls-test-token")){ <0 }el{ <1 }
};

f=childbatch(url:str):i64{
  let r=fbp.submitbatchat(ghcfg();batch();url);
  if(r.ok && str.eq(r.issueurl;"https://recorder.invalid/issues/1")){ <0 }el{};
  if(r.ok && str.len(r.issueurl)==0){ <5 }el{};
  <1
};

(* GitHub answers 401 with a body that looks like a created issue. 0 when the batch is a
   failure naming the status and not the token. *)
f=childbatchstatus(url:str):i64{
  let r=fbp.submitbatchat(ghcfg();batch();url);
  if(r.ok){ <1 }el{};
  if(str.contains(r.err;"gh-tls-test-token")){ <2 }el{};
  if(str.contains(r.err;"401") && str.len(r.issueurl)==0){ <0 }el{ <3 }
};

f=childreportstatus(url:str):i64{
  if(rep.submittogithubat(issue();url;"gh-tls-test-token")){ <1 }el{ <0 }
};

f=child(site:str;url:str):i64{
  if(site=="pipeline"){ <childpipeline(url;false) }el{};
  if(site=="pipeline-killed"){ <childpipeline(url;true) }el{};
  if(site=="anthropic"){ <childanthropic(url) }el{};
  if(site=="openai"){ <childopenai(url) }el{};
  if(site=="oauth"){ <childoauth(url) }el{};
  if(site=="refresh"){ <childrefresh(url) }el{};
  if(site=="report"){ <childreport(url) }el{};
  if(site=="batch"){ <childbatch(url) }el{};
  if(site=="oauth-status"){ <childoauthstatus(url) }el{};
  if(site=="refresh-status"){ <childrefreshstatus(url) }el{};
  if(site=="batch-status"){ <childbatchstatus(url) }el{};
  if(site=="report-status"){ <childreportstatus(url) }el{};
  if(site=="store"){ <childstore(url) }el{};
  <9
};

(* Run this binary as a child for `site`, trusting the test CA, and answer its exit status,
   or -1 when it could not be started. *)
f=runsite(self:str;ca:str;site:str;url:str):i64{
  let certenv="SSL_CERT_FILE=\(ca)";
  let h=mt process.spawn(@("env";"-u";"SSL_CERT_DIR";certenv;self;"--site";site;url)) { $ok:h h; $err:e 0 };
  if(h==0){ <0-1 }el{};
  <process.wait(h) as i64
};

(* The last logged request whose line starts with `prefix` (e.g. "POST /v1/messages "),
   body only, or "". *)
f=lastbody(logp:str;prefix:str):str{
  let lines=str.split(readfile(logp);"\n");
  let found=mut."";
  lp(let i=0;i<lines.len;i=i+1){
    let ln:str=lines.get(i);
    if(str.startswith(ln;prefix)){ found=str.trimprefix(ln;prefix) }el{}
  };
  <found
};

f=countlines(logp:str;prefix:str):i64{
  let lines=str.split(readfile(logp);"\n");
  let n=mut.0;
  lp(let i=0;i<lines.len;i=i+1){
    let ln:str=lines.get(i);
    if(str.startswith(ln;prefix)){ n=n+1 }el{}
  };
  <n
};

(* The header block the recorder logged for the last request whose request line is `line`. *)
f=lastheaders(hp:str;line:str):str{
  let blocks=str.split(readfile(hp);"\n\n");
  let found=mut."";
  lp(let i=0;i<blocks.len;i=i+1){
    let b:str=blocks.get(i);
    if(str.startswith(str.trimprefix(b;"\n");line)){ found=b }el{}
  };
  <found
};

f=countof(s:str;needle:str):i64{
  <(str.split(s;needle).len as i64)-1
};

f=recorderargv(base:str;name:str;certs:str):@str{
  <@("python3";"scripts/lib/http_recorder.py";"\(base).\(name).log";"\(base).\(name).port";"answer";"\(certs)/\(name).pem";"\(certs)/\(name).key")
};

f=noidentifier(s:str):bool{
  <!str.contains(s;"user.probe@example.com") && !str.contains(s;"caller.probe@example.com") && !str.contains(s;"51 824 753 556")
};

f=main():i64{
  let mode=mt args.get(1 as u64) { $ok:v v; $err:e "" };
  if(mode=="--site"){
    let site=mt args.get(2 as u64) { $ok:v v; $err:e "" };
    <child(site;mt args.get(3 as u64) { $ok:v v; $err:e "" })
  }el{};
  let self=mt args.get(0 as u64) { $ok:v v; $err:e "" };

  let pass=mut.0;
  let fail=mut.0;
  let base=scratch();
  let certs="\(base).certs";
  let gen=mt process.spawn(@("sh";"scripts/lib/tls_fixture.sh";certs)) { $ok:h h; $err:e 0 };
  if(gen!=0){ process.wait(gen); }el{};
  if(t.assert(str.len(waitfile("\(certs)/done"))>0 && str.len(readfile("\(certs)/ca.pem"))>0;"the throwaway CA and certificates were generated")){pass=pass+1}el{fail=fail+1};
  let ca="\(certs)/ca.pem";

  let grec=mt process.spawn(recorderargv(base;"good";certs)) { $ok:h h; $err:e 0 };
  let srec=mt process.spawn(recorderargv(base;"self";certs)) { $ok:h h; $err:e 0 };
  let gport=waitfile("\(base).good.port");
  let sport=waitfile("\(base).self.port");
  if(t.assert(str.len(gport)>0 && str.len(sport)>0;"two TLS stand-ins came up")){pass=pass+1}el{fail=fail+1};
  let good="https://127.0.0.1:\(gport)";
  let bad="https://127.0.0.1:\(sport)";
  let glog="\(base).good.log";
  let ghdr="\(base).good.log.headers";
  let slog="\(base).self.log";

  (* ── The browser pipeline's Anthropic hop ─────────────────────────────────────── *)
  let cp=runsite(self;ca;"pipeline";"\(good)/v1/messages");
  if(t.assert(cp==0;"pipeline: the Anthropic hop answered over verified TLS, with its disclosure row")){pass=pass+1}el{fail=fail+1};
  let pbody=lastbody(glog;"POST /v1/messages ");
  if(t.assert(str.len(pbody)>0;"pipeline: the POST /v1/messages arrived at the stand-in")){pass=pass+1}el{fail=fail+1};
  if(t.assert(noidentifier(pbody);"pipeline: no identifier from the text or the system prompt arrived")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pbody;"Please write to [EMAIL_") && str.contains(pbody;"about the invoice.");"pipeline: the text arrived anonymised, the rest of it as written")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pbody;"You are helping [EMAIL_") && str.contains(pbody;"ABN [AU_ABN_");"pipeline: and the system prompt anonymised")){pass=pass+1}el{fail=fail+1};
  let ph=lastheaders(ghdr;"POST /v1/messages");
  if(t.assert(str.contains(ph;"x-api-key: sk-ant-tls-test-key-000000") && str.contains(ph;"anthropic-version: 2023-06-01");"pipeline: with the Anthropic headers")){pass=pass+1}el{fail=fail+1};
  let pn=countlines(glog;"POST /v1/messages ");

  (* The kill switch, over the same verified connection: nothing is sent. *)
  let ck=runsite(self;ca;"pipeline-killed";"\(good)/v1/messages");
  if(t.assert(ck==0;"pipeline: with the provider switched off, the hop is refused by the kill switch")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countlines(glog;"POST /v1/messages ")==pn;"pipeline: and nothing arrived")){pass=pass+1}el{fail=fail+1};

  (* ── core.providers.anthropic and openai ────────────────────────────────────── *)
  let ca1=runsite(self;ca;"anthropic";"\(good)/v1/messages");
  if(t.assert(ca1==0;"anthropic: completeplainat answered with the stand-in's text over verified TLS")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countlines(glog;"POST /v1/messages ")==pn+1;"anthropic: its POST arrived")){pass=pass+1}el{fail=fail+1};
  let abody=lastbody(glog;"POST /v1/messages ");
  if(t.assert(noidentifier(abody) && str.contains(abody;"Please write to [EMAIL_") && str.contains(abody;"\"model\":\"claude-probe-model\"");"anthropic: the body carried the anonymised text and no identifier")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lastheaders(ghdr;"POST /v1/messages");"x-api-key: sk-ant-tls-test-key-000000");"anthropic: with its x-api-key")){pass=pass+1}el{fail=fail+1};

  let co=runsite(self;ca;"openai";"\(good)/v1/chat/completions");
  if(t.assert(co==0;"openai: completeplainat answered with the stand-in's text over verified TLS")){pass=pass+1}el{fail=fail+1};
  let obody=lastbody(glog;"POST /v1/chat/completions ");
  if(t.assert(str.len(obody)>0 && noidentifier(obody) && str.contains(obody;"Please write to [EMAIL_") && str.contains(obody;"You are helping [EMAIL_");"openai: the body carried the anonymised text and system prompt, and no identifier")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lastheaders(ghdr;"POST /v1/chat/completions");"authorization: Bearer sk-oai-tls-test-key-000000");"openai: with its bearer key")){pass=pass+1}el{fail=fail+1};

  (* ── OAuth token exchange and refresh ───────────────────────────────────────── *)
  let cx=runsite(self;ca;"oauth";"\(good)/oauth/token");
  (* VM1.6i, turned round: exchangecode reported the REFRESH token as the access token. *)
  if(t.assert(cx!=4;"oauth: exchangecode does not report the refresh token as the access token (VM1.6i)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cx==0;"oauth: exchangecode reports access_token as the access token, refresh_token as the refresh token, and expires_in as the expiry")){pass=pass+1}el{fail=fail+1};
  let xbody=lastbody(glog;"POST /oauth/token ");
  if(t.assert(str.contains(xbody;"grant_type=authorization_code&code=code-tls-test") && str.contains(xbody;"code_verifier=verifier-tls-test");"oauth: the form-encoded token request arrived")){pass=pass+1}el{fail=fail+1};
  let xh=lastheaders(ghdr;"POST /oauth/token");
  if(t.assert(str.contains(xh;"application/x-www-form-urlencoded") && countof(str.lower(xh);"content-type:")==1;"oauth: with exactly one Content-Type, the form one")){pass=pass+1}el{fail=fail+1};

  let cr=runsite(self;ca;"refresh";"\(good)/oauth/token");
  if(t.assert(cr==0;"refresh: dorefresh read the stand-in's new access and refresh tokens over verified TLS")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lastbody(glog;"POST /oauth/token ");"grant_type=refresh_token&refresh_token=refresh-tls-test");"refresh: the refresh request arrived")){pass=pass+1}el{fail=fail+1};

  (* VM1.6i: a non-2xx answer is a failure, even with a body that looks like success. The
     old tests were `status>400`, so 400 (invalid_grant) was a success. *)
  let xs=runsite(self;ca;"oauth-status";"\(good)/oauth/token?status=400");
  if(t.assert(xs==0;"oauth: a 400 from the token endpoint is an error naming the status, and no token")){pass=pass+1}el{fail=fail+1};
  let rs=runsite(self;ca;"refresh-status";"\(good)/oauth/token?status=400");
  if(t.assert(rs==0;"refresh: a 400 from the token endpoint is a failure with status 400 and no token")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countlines(glog;"POST /oauth/token?status=400 ")==2;"oauth, refresh: both 400 requests did arrive, so the failures are the answers' and not the sends'")){pass=pass+1}el{fail=fail+1};

  (* ── The keychain: completeauthorise and getvalidtoken (throwaway keychain, X8.7) ─ *)
  let cs=runsite(self;ca;"store";"\(good)/oauth/token");
  if(t.assert(cs!=255;"store: a throwaway keychain was created and selected")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs>=0 && cs<255 && cs%2==0;"store: completeauthorise answered ok and stored an expiry")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs>=0 && cs<255 && (cs/2)%2==0;"store: the access token is in the keychain under oauth.<id>.access_token")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs>=0 && cs<255 && (cs/4)%2==0;"store: the refresh token is in the keychain under oauth.<id>.refresh_token")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs>=0 && cs<255 && (cs/8)%2==0;"store: a state mismatch and a 400 from the token endpoint store nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs>=0 && cs<255 && (cs/16)%2==0;"store: getvalidtoken refreshes an expired token and stores the new access token")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs>=0 && cs<255 && (cs/32)%2==0;"store: and stores a rotated refresh token in place of the old one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs>=0 && cs<255 && (cs/64)%2==0;"store: a refresh answered 400 is permanent: no token, and the stored tokens are cleared")){pass=pass+1}el{fail=fail+1};

  (* ── Feedback to the GitHub issues API ──────────────────────────────────────── *)
  let cf=runsite(self;ca;"report";"\(good)/repos/o/r/issues");
  if(t.assert(cf==0;"report: submittogithubat was answered 201 over verified TLS")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lastbody(glog;"POST /repos/o/r/issues ");"the tls probe report");"report: the issue arrived")){pass=pass+1}el{fail=fail+1};
  let fh=lastheaders(ghdr;"POST /repos/o/r/issues");
  if(t.assert(str.contains(fh;"authorization: token gh-tls-test-token") && str.contains(fh;"accept: application/vnd.github+json");"report: with its authorization and accept headers")){pass=pass+1}el{fail=fail+1};
  let cb=runsite(self;ca;"batch";"\(good)/repos/o/r/issues");
  (* VM1.6i, turned round: submitbatchat read no issue URL from the 201. *)
  if(t.assert(cb==0;"batch: submitbatchat reports success with the issue URL read from the 201's html_url")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lastbody(glog;"POST /repos/o/r/issues ");"Feedback: tls-probe");"batch: the batch issue arrived")){pass=pass+1}el{fail=fail+1};
  (* VM1.6i: and success whatever the status. *)
  let bs=runsite(self;ca;"batch-status";"\(good)/repos/o/r/issues?status=401");
  if(t.assert(bs==0;"batch: a 401 from GitHub is a failure naming the status, with no issue URL and no token")){pass=pass+1}el{fail=fail+1};
  let fs=runsite(self;ca;"report-status";"\(good)/repos/o/r/issues?status=401");
  if(t.assert(fs==0;"report: a 401 from GitHub is a failure")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countlines(glog;"POST /repos/o/r/issues?status=401 ")==2;"batch, report: both 401 requests did arrive")){pass=pass+1}el{fail=fail+1};

  (* Tokens are secrets: none of the stand-in's tokens, nor the test's own refresh token or
     GitHub token, is in loke's log, which every child above wrote to under this HOME. *)
  let lokelog=readfile(sh.lokefile("loke.log"));
  if(t.assert(str.contains(lokelog;"auth.oauth");"the children's log is where this test reads it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(lokelog;"recorder-access-token") && !str.contains(lokelog;"recorder-refresh-token") && !str.contains(lokelog;"refresh-tls-test") && !str.contains(lokelog;"gh-tls-test-token") && !str.contains(lokelog;"code-tls-test");"no token or code was written to loke's log")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(readfile("\(glog).tls");"handshake ok");"every arrival above came over a completed TLS handshake")){pass=pass+1}el{fail=fail+1};

  (* ── An untrusted certificate: every site refuses, and nothing arrives ──────── *)
  if(t.assert(runsite(self;ca;"pipeline";"\(bad)/v1/messages")!=0;"pipeline: a self-signed certificate is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(runsite(self;ca;"anthropic";"\(bad)/v1/messages")!=0;"anthropic: a self-signed certificate is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(runsite(self;ca;"openai";"\(bad)/v1/chat/completions")!=0;"openai: a self-signed certificate is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(runsite(self;ca;"oauth";"\(bad)/oauth/token")!=0;"oauth: a self-signed certificate is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(runsite(self;ca;"refresh";"\(bad)/oauth/token")!=0;"refresh: a self-signed certificate is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(runsite(self;ca;"report";"\(bad)/repos/o/r/issues")!=0;"report: a self-signed certificate is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(runsite(self;ca;"batch";"\(bad)/repos/o/r/issues")!=0;"batch: a self-signed certificate is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(waitcontains("\(slog).tls";"handshake failed");"the untrusted stand-in saw failed handshakes")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(readfile(slog);"";"and received no request from any site")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(readfile("\(slog).headers");"tls-test");"so no key, token or code reached it")){pass=pass+1}el{fail=fail+1};

  (* ── What stays refused (F10.41): a token endpoint or issues URL off this machine ─
     192.0.2.1 is TEST-NET-1 (RFC 5737), never routed, so even a broken rule reaches nobody. *)
  let offx=mt oauth.exchangecode(oauthcfg("https://192.0.2.1/oauth/token");"c";"v";"http://localhost:8739/callback") {
    $ok:ts false;
    $oautherr:e true
  };
  if(t.assert(offx;"oauth: a token endpoint off this machine is still refused (F10.41)")){pass=pass+1}el{fail=fail+1};
  let offr=refresh.dorefresh("https://192.0.2.1/oauth/token";"c";"r");
  if(t.assert(offr.ok==false;"refresh: so is a refresh off this machine")){pass=pass+1}el{fail=fail+1};
  if(t.assert(rep.submittogithubat(issue();"https://192.0.2.1/repos/o/r/issues";"t")==false;"report: and an issues URL off this machine")){pass=pass+1}el{fail=fail+1};
  let offb=fbp.submitbatchat(ghcfg();batch();"https://192.0.2.1/repos/o/r/issues");
  if(t.assert(offb.ok==false;"batch: likewise")){pass=pass+1}el{fail=fail+1};

  if(grec!=0){ process.kill(grec); process.wait(grec); }el{};
  if(srec!=0){ process.kill(srec); process.wait(srec); }el{};
  let rm=mt process.spawn(@("sh";"-c";"rm -rf \"$0\".*";base)) { $ok:h h; $err:e 0 };
  if(rm!=0){ process.wait(rm); }el{};
  io.println("test_hosted_tls: \(pass) passed, \(fail) failed");
  <fail
};

m=tests.integration.testaudittraile2e;
i=t:std.test;
i=str:std.str;
i=audit:core.storage.audit;
i=sdb:core.storage.db;

(* Helper: open an in-memory store for testing *)
f=openteststore():i64{
  let store=mt sdb.openstore(":memory:") {
    $ok:s s;
    $err:e 0
  };
  <store
};

(* Helper: build a test audit event *)
f=maketestevent(etype:str;usecase:str;corrid:str):$auditevent{
  <$auditevent{
    eventtype:etype;
    usecase:usecase;
    modelid:"claude-3.5-sonnet";
    provider:"anthropic";
    sensitivity:"confidential";
    risktier:"medium";
    tokensin:150;
    tokensout:200;
    costusd:0.005;
    durationms:320;
    correlationid:corrid
  }
};

(* Test: log event succeeds without error *)
f=testlogevent():bool{
  let store=openteststore();
  let event=maketestevent("llm_request";"browser-chat";"corr-001");
  let result=mt audit.logevent(store;event) {
    $ok:v true;
    $err:e false
  };
  t.assert(result;"audit log event succeeds")
};

(* Test: query recent events returns logged event *)
f=testgetrecent():bool{
  let store=openteststore();
  let event=maketestevent("llm_request";"code-review";"corr-002");
  audit.logevent(store;event);
  let events=mt audit.getrecent(store;10) {
    $ok:v v;
    $err:e @()
  };
  let hasevents=events.len>0;
  t.assert(hasevents;"getrecent returns at least one event after logging")
};

(* Test: logged event preserves event type *)
f=testpreserveseventtype():bool{
  let store=openteststore();
  let event=maketestevent("policy_check";"summarisation";"corr-003");
  audit.logevent(store;event);
  let events=mt audit.getrecent(store;1) {
    $ok:v v;
    $err:e @()
  };
  let first=events.get(0);
  let matches=str.eq(first.eventtype;"policy_check");
  t.assert(matches;"retrieved event preserves event type")
};

(* Test: logged event preserves model ID *)
f=testpreservesmodelid():bool{
  let store=openteststore();
  let event=maketestevent("llm_request";"chat";"corr-004");
  audit.logevent(store;event);
  let events=mt audit.getrecent(store;1) {
    $ok:v v;
    $err:e @()
  };
  let first=events.get(0);
  let matches=str.eq(first.modelid;"claude-3.5-sonnet");
  t.assert(matches;"retrieved event preserves model ID")
};

(* Test: logged event preserves correlation ID *)
f=testpreservescorrelationid():bool{
  let store=openteststore();
  let event=maketestevent("llm_request";"chat";"corr-005");
  audit.logevent(store;event);
  let events=mt audit.getrecent(store;1) {
    $ok:v v;
    $err:e @()
  };
  let first=events.get(0);
  let matches=str.eq(first.correlationid;"corr-005");
  t.assert(matches;"retrieved event preserves correlation ID")
};

(* Test: multiple events can be logged and queried *)
f=testmultipleevents():bool{
  let store=openteststore();
  audit.logevent(store;maketestevent("llm_request";"chat";"corr-a"));
  audit.logevent(store;maketestevent("policy_check";"code";"corr-b"));
  audit.logevent(store;maketestevent("kill_switch";"admin";"corr-c"));
  let events=mt audit.getrecent(store;10) {
    $ok:v v;
    $err:e @()
  };
  let hasmultiple=events.len>2;
  t.assert(hasmultiple;"three logged events are all retrievable")
};

(* Test: getrecent respects limit *)
f=testlimit():bool{
  let store=openteststore();
  audit.logevent(store;maketestevent("a";"x";"c1"));
  audit.logevent(store;maketestevent("b";"y";"c2"));
  audit.logevent(store;maketestevent("c";"z";"c3"));
  let events=mt audit.getrecent(store;2) {
    $ok:v v;
    $err:e @()
  };
  let limited=events.len<4;
  t.assert(limited;"getrecent respects the limit parameter")
};

(* Test: logged event preserves sensitivity field *)
f=testpreservessensitivity():bool{
  let store=openteststore();
  let event=maketestevent("llm_request";"chat";"corr-006");
  audit.logevent(store;event);
  let events=mt audit.getrecent(store;1) {
    $ok:v v;
    $err:e @()
  };
  let first=events.get(0);
  let matches=str.eq(first.sensitivity;"confidential");
  t.assert(matches;"retrieved event preserves sensitivity field")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(testlogevent()){pass=pass+1}el{fail=fail+1};
  if(testgetrecent()){pass=pass+1}el{fail=fail+1};
  if(testpreserveseventtype()){pass=pass+1}el{fail=fail+1};
  if(testpreservesmodelid()){pass=pass+1}el{fail=fail+1};
  if(testpreservescorrelationid()){pass=pass+1}el{fail=fail+1};
  if(testmultipleevents()){pass=pass+1}el{fail=fail+1};
  if(testlimit()){pass=pass+1}el{fail=fail+1};
  if(testpreservessensitivity()){pass=pass+1}el{fail=fail+1};

  <fail
};

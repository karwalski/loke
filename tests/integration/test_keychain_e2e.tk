m=tests.integration.testkeychaine2e;
i=t:std.test;
i=str:std.str;
i=kc:core.storage.keychain;

(* Test: set API key returns true *)
f=testsetapikey():bool{
  let ok=kc.setapikey("test_provider_e2e";"sk-test-key-12345");
  t.assert(ok;"setapikey returns true on success")
};

(* Test: get API key retrieves stored value *)
f=testgetapikey():bool{
  kc.setapikey("test_get_e2e";"sk-abc-999");
  let retrieved=kc.getapikey("test_get_e2e");
  let matches=str.eq(retrieved;"sk-abc-999");
  t.assert(matches;"getapikey retrieves the stored key value")
};

(* Test: haskey returns true after setting *)
f=testhaskeyexists():bool{
  kc.setkey("e2e_has_test";"somevalue");
  let exists=kc.haskey("e2e_has_test");
  t.assert(exists;"haskey returns true for a stored key")
};

(* Test: deletekey removes the key *)
f=testdeletekey():bool{
  kc.setkey("e2e_delete_test";"tempvalue");
  kc.deletekey("e2e_delete_test");
  let exists=kc.haskey("e2e_delete_test");
  t.assert(!exists;"haskey returns false after deletekey")
};

(* Test: mask API key for display - last 4 chars visible *)
f=testmaskapikey():bool{
  let key="sk-ant-api-abcdefghijkl";
  let keylen=str.len(key);
  let last4=str.slice(key;keylen-4;keylen);
  let masked=str.concat("****";last4);
  let hasstars=str.contains(masked;"****");
  let haslast4=str.contains(masked;"jkl");
  t.assert(hasstars;"masked key starts with stars");
  t.assert(haslast4;"masked key ends with last characters of original")
};

(* Test: setkey and getkey round-trip *)
f=testkeycroundtrip():bool{
  kc.setkey("e2e_roundtrip";"my-secret-value");
  let retrieved=kc.getkey("e2e_roundtrip");
  let matches=str.eq(retrieved;"my-secret-value");
  t.assert(matches;"setkey/getkey round-trips the value")
};

(* Test: overwrite existing key *)
f=testoverwritekey():bool{
  kc.setapikey("e2e_overwrite";"old-key");
  kc.setapikey("e2e_overwrite";"new-key");
  let retrieved=kc.getapikey("e2e_overwrite");
  let matches=str.eq(retrieved;"new-key");
  t.assert(matches;"overwriting an existing key stores the new value")
};

(* Test: API key account uses provider prefix *)
f=testapikeyaccount():bool{
  let provider="anthropic";
  let account=str.concat("api_key.";provider);
  let expected=str.eq(account;"api_key.anthropic");
  t.assert(expected;"API key account is prefixed with api_key.")
};

(* Cleanup test keys *)
f=cleanup():bool{
  kc.deletekey("e2e_has_test");
  kc.deletekey("e2e_roundtrip");
  kc.deletekey("api_key.test_provider_e2e");
  kc.deletekey("api_key.test_get_e2e");
  kc.deletekey("api_key.e2e_overwrite");
  <true
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(testsetapikey()){pass=pass+1}el{fail=fail+1};
  if(testgetapikey()){pass=pass+1}el{fail=fail+1};
  if(testhaskeyexists()){pass=pass+1}el{fail=fail+1};
  if(testdeletekey()){pass=pass+1}el{fail=fail+1};
  if(testmaskapikey()){pass=pass+1}el{fail=fail+1};
  if(testkeycroundtrip()){pass=pass+1}el{fail=fail+1};
  if(testoverwritekey()){pass=pass+1}el{fail=fail+1};
  if(testapikeyaccount()){pass=pass+1}el{fail=fail+1};
  cleanup();

  <fail
};

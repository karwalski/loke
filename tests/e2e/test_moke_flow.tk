



m=tests.e2e.testmokeflow;

i=regex:core.privacy.regex;
i=guardian:core.privacy.guardian;
i=ph:core.privacy.placeholder;
i=sens:core.router.sensitivity;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") }
};

f=assertfalse(name:str;v:bool):$result{
  if(v=false){ <pass(name) }el{ <fail(name;"expected false") }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  
  let patientrow="patient_name: Margaret Kowalski";
  let patientdet=regex.detect(patientrow);
  
  
  
  let emailrow="referral_email: margaret.kowalski@hospital.org";
  let emaildet=regex.detect(emailrow);
  let emailentitycount=str.arraylen(emaildet.entities);
  results=str.arraypush(results;asserttrue("dataset PII column: entities >= 1";emailentitycount>1));

  
  results=str.arraypush(results;assertfalse("anonymised text excludes email value";str.contains(emaildet.anonymised;"margaret.kowalski@hospital.org")));

  
  
  
  let patiententitycount=str.arraylen(patientdet.entities);
  if(patiententitycount>0){
    results=str.arraypush(results;assertfalse("patient name: anonymised differs from original";str.eq(patientdet.anonymised;patientrow)))
  }el{
    
    
    results=str.arraypush(results;pass("patient name: no regex match — NER required for full coverage"))
  };

  
  let systemcontext="You are analysing anonymised patient data. Do not reference individuals.";
  let builtprompt=guardian.buildsystemprompt(systemcontext);
  results=str.arraypush(results;asserttrue("guardian.build_system_prompt is non-empty";str.len(builtprompt)>0));

  
  results=str.arraypush(results;asserttrue("guardian.is_guardian_present on built prompt";guardian.isguardianpresent(builtprompt)));

  
  let originalvalue="margaret.kowalski@hospital.org";
  let restoreinput=str.concat("Refer to ";str.concat(originalvalue;" for follow-up"));
  let det=regex.detect(restoreinput);
  let anon=det.anonymised;
  
  let map=ph.newmap();
  let entcount=str.arraylen(det.entities);
  let ei=0;
  lp(let lv=0;true;lv=lv){
    if(ei<entcount){
      let ent=str.arrayget(det.entities;ei);
      ph.addentry(map;ent.value;ent.placeholder;ent.entitytype);
      ei=ei+1
    }el{
      br
    }
  };
  let restored=ph.restore(anon;map);
  results=str.arraypush(results;asserteq("restore returns original text";restored;restoreinput));

  
  results=str.arraypush(results;assertfalse("RESTRICTED cannot use cloud";sens.canusecloud($restricted)));

  
  results=str.arraypush(results;asserttrue("CONFIDENTIAL can use cloud (anonymised)";sens.canusecloud($confidential)));

  
  results=str.arraypush(results;asserttrue("PUBLIC can use cloud";sens.canusecloud($public)));

  
  let ccinput="Card: 4111 1111 1111 1111";
  let ccdet=regex.detect(ccinput);
  results=str.arraypush(results;asserttrue("credit card input sensitivity is RESTRICTED";ccdet.sensitivity=$restricted));

  
  
  results=str.arraypush(results;assertfalse("RESTRICTED sensitivity blocks cloud routing";sens.canusecloud(ccdet.sensitivity)));

  
  let emailonly="billing@acmecorp.com";
  let emailonlydet=regex.detect(emailonly);
  results=str.arraypush(results;asserttrue("email column sensitivity is CONFIDENTIAL";emailonlydet.sensitivity=$confidential));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i<n){
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed=false){ all=false }el{};
      i=i+1
    }el{
      br
    }
  };
  <all
};

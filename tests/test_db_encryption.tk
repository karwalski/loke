m=tests.testdbencryption;
i=t:std.test;
i=str:std.str;
i=crypto:std.crypto;

(* --- stub keychain for testing db encryption key logic --- *)

let storeddbkey=mut."";
let hasdbkey=mut.false;

f=stubsetdbkey(key:str):bool{
  storeddbkey=key;
  hasdbkey=true;
  <true
};

f=stubgetdbkey():str{
  <storeddbkey
};

f=stubhasdbkey():bool{
  <hasdbkey
};

(* replicate ensuredbkey logic using stubs *)
f=ensuredbkeystub():str{
  if(stubhasdbkey()){
    let existing=stubgetdbkey();
    if(str.len(existing)>0){
      <existing
    }el{}
  }el{};
  let keybytes=crypto.randombytes(32);
  let hexkey=crypto.tohex(keybytes);
  stubsetdbkey(hexkey);
  <hexkey
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test 1: first call generates a 64-char hex key (32 bytes = 64 hex chars) *)
  let key1=ensuredbkeystub();
  if(t.assert(str.len(key1)=64;"ensuredbkey generates 64-char hex key")){pass=pass+1}el{fail=fail+1};

  (* test 2: subsequent call returns the same key *)
  let key2=ensuredbkeystub();
  if(t.assert(str.eq(key1;key2);"ensuredbkey returns same key on second call")){pass=pass+1}el{fail=fail+1};

  (* test 3: key is stored in stub keychain *)
  if(t.assert(stubhasdbkey();"key is stored in keychain after generation")){pass=pass+1}el{fail=fail+1};

  (* test 4: stored key matches returned key *)
  let stored=stubgetdbkey();
  if(t.assert(str.eq(stored;key1);"stored key matches returned key")){pass=pass+1}el{fail=fail+1};

  (* test 5: key is non-empty *)
  if(t.assert(str.len(key1)>0;"generated key is non-empty")){pass=pass+1}el{fail=fail+1};

  (* test 6: fresh keychain generates a different key *)
  storeddbkey="";
  hasdbkey=false;
  let key3=ensuredbkeystub();
  if(t.assert(!str.eq(key1;key3);"fresh keychain generates different key")){pass=pass+1}el{fail=fail+1};

  (* test 7: PRAGMA key SQL is well-formed *)
  let hexkey="aabbccdd00112233aabbccdd00112233aabbccdd00112233aabbccdd00112233";
  let pragmasql=str.concat("PRAGMA key='x''";str.concat(hexkey;"''"));
  let expected="PRAGMA key='x''aabbccdd00112233aabbccdd00112233aabbccdd00112233aabbccdd00112233''";
  if(t.assert(str.eq(pragmasql;expected);"PRAGMA key SQL is well-formed")){pass=pass+1}el{fail=fail+1};

  <fail
};

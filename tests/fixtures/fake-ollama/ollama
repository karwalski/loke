# A stand-in for the ollama CLI (F10.40). It never contacts anything and never touches
# ~/.ollama. It records its argv, one call per line with each argument in <>, in
# $FAKE_OLLAMA_DIR/argv.log, and answers from files in that directory:
#   fail.<subcommand>   that subcommand writes "Error: boom <subcommand>" to stderr, exits 3
#   removed             `list` no longer shows fake:latest (an `rm` that worked writes it)
#   rmnoop              `rm` exits 0 without removing anything
#   digest              the ID `list` shows for fake:latest (a `pull` that worked writes it)
#   bigerr              `pull` writes more than a pipe buffer (about 140 KB) to stderr before
#                       it exits 0, so a reader that waits before draining stderr hangs (F10.43)
# `list` prints the real CLI's layout: columns aligned with runs of spaces, SIZE a number
# and a unit. `pull` writes its progress to stderr, as the real one does.
B="${FAKE_OLLAMA_DIR:?FAKE_OLLAMA_DIR must be set}"
line=""
for a in "$@"; do line="$line<$a>"; done
printf '%s\n' "$line" >> "$B/argv.log"
case "$1" in
  --whoami) echo "FAKE-OLLAMA"; exit 0 ;;
esac
if [ -f "$B/fail.$1" ]; then
  echo "Error: boom $1" >&2
  exit 3
fi
case "$1" in
  list)
    printf 'NAME                 ID              SIZE      MODIFIED\n'
    if [ ! -f "$B/removed" ]; then
      d=$(cat "$B/digest" 2>/dev/null || echo 0123abcd4567)
      printf 'fake:latest          %s    4.7 GB    2 days ago\n' "$d"
    fi
    printf 'other:7b             89abcdef0123    1.1 GB    3 weeks ago\n'
    ;;
  rm)
    if [ ! -f "$B/rmnoop" ]; then : > "$B/removed"; fi
    echo "deleted '$2'"
    ;;
  pull)
    echo "pulling manifest" >&2
    if [ -f "$B/bigerr" ]; then
      i=0
      while [ $i -lt 2000 ]; do
        echo "pulling layer $i of 2000: writing filler so stderr exceeds a 64 KiB pipe" >&2
        i=$((i+1))
      done
    fi
    printf 'pulling fedcba987654:  42%% 2.0 GB/4.7 GB\rpulling fedcba987654:  97%% 4.6 GB/4.7 GB\n' >&2
    echo "fedcba987654" > "$B/digest"
    echo "success" >&2
    ;;
  show)
    ;;
  *)
    echo "Error: unknown command $1" >&2
    exit 2
    ;;
esac
exit 0

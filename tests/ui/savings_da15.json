[
 {
  "name": "DA1.5 the savings page fills its disclosure figures from /api/savings",
  "js": "new Promise(r=>{let n=0;const t=setInterval(()=>{const e=document.getElementById('sv-dispatches');if(e&&/^[0-9]+$/.test(e.textContent.trim())){clearInterval(t);r(true)}else if(++n>40){clearInterval(t);r(false)}},100)})"
 },
 {
  "name": "DA1.5 and at least one dispatch was recorded by the chat checks that ran before",
  "js": "parseInt(document.getElementById('sv-dispatches').textContent,10)>=1"
 },
 {
  "name": "DA1.5 each destination shows a count and its bytes",
  "js": "/^[0-9]+ \\([0-9.]+ (B|kB|MB)\\)$/.test(document.getElementById('sv-local').textContent.trim()) && /^[0-9]+ \\([0-9.]+ (B|kB|MB)\\)$/.test(document.getElementById('sv-cloud').textContent.trim())"
 },
 {
  "name": "DA1.5 tokens and cost saved stay unmeasured, because nothing optimises yet",
  "js": "document.querySelectorAll('.stat-card .s-value.unmeasured').length===2"
 },
 {
  "name": "DA1.5 the provider table lists what was recorded: a provider row with five cells, not the placeholder",
  "js": "(()=>{const r=document.querySelector('#sv-providers tr');return !!r && r.children.length===5 && /^[a-z]+$/.test(r.children[0].textContent.trim()) && !/61 Anthropic/.test(document.body.textContent)})()"
 }

m=tests.testkeychainsettings;
i=t:std.test;
i=str:std.str;

(* --- stub keychain for testing roundtrip --- *)

(* simulated keychain store keyed by provider *)
let storedanthropickey=mut."";
let storedopenaikey=mut."";

f=stubsetapikey(provider:str;key:str):bool{
  if(str.eq(provider;"anthropic")){
    storedanthropickey=key;
    <true
  }el{};
  if(str.eq(provider;"openai")){
    storedopenaikey=key;
    <true
  }el{};
  <false
};

f=stubgetapikey(provider:str):str{
  if(str.eq(provider;"anthropic")){
    <storedanthropickey
  }el{};
  if(str.eq(provider;"openai")){
    <storedopenaikey
  }el{};
  <""
};

(* mask key: first 4 chars + **** *)
f=maskkey(key:str):str{
  if(str.len(key)<5){<""}el{};
  <str.concat(str.slice(key;0;4);"****")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test 1: set and get anthropic key roundtrip *)
  stubsetapikey("anthropic";"sk-ant-abc123xyz");
  let got1=stubgetapikey("anthropic");
  if(t.assert(str.eq(got1;"sk-ant-abc123xyz");"anthropic key roundtrip")){pass=pass+1}el{fail=fail+1};

  (* test 2: set and get openai key roundtrip *)
  stubsetapikey("openai";"sk-oai-def456uvw");
  let got2=stubgetapikey("openai");
  if(t.assert(str.eq(got2;"sk-oai-def456uvw");"openai key roundtrip")){pass=pass+1}el{fail=fail+1};

  (* test 3: unknown provider returns empty *)
  let got3=stubgetapikey("unknown");
  if(t.assert(str.eq(got3;"");"unknown provider returns empty")){pass=pass+1}el{fail=fail+1};

  (* test 4: overwrite existing key *)
  stubsetapikey("anthropic";"sk-ant-new999");
  let got4=stubgetapikey("anthropic");
  if(t.assert(str.eq(got4;"sk-ant-new999");"overwrite anthropic key")){pass=pass+1}el{fail=fail+1};

  (* test 5: openai key unchanged after anthropic overwrite *)
  let got5=stubgetapikey("openai");
  if(t.assert(str.eq(got5;"sk-oai-def456uvw");"openai key unchanged")){pass=pass+1}el{fail=fail+1};

  (* test 6: mask key shows first 4 chars *)
  let masked=maskkey("sk-ant-abc123xyz");
  if(t.assert(str.eq(masked;"sk-a****");"mask shows first 4 chars")){pass=pass+1}el{fail=fail+1};

  (* test 7: mask short key returns empty *)
  let maskedshort=maskkey("abc");
  if(t.assert(str.eq(maskedshort;"");"short key mask returns empty")){pass=pass+1}el{fail=fail+1};

  (* test 8: empty provider rejected *)
  let setresult=stubsetapikey("";"somekey");
  if(t.assert(setresult=false;"empty provider rejected")){pass=pass+1}el{fail=fail+1};

  (* test 9: get from empty keychain returns empty *)
  let freshanthropickey=mut."";
  let freshget=freshanthropickey;
  if(t.assert(str.eq(freshget;"");"empty keychain returns empty string")){pass=pass+1}el{fail=fail+1};

  <fail
};

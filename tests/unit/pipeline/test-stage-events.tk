
m=tests.unit.pipeline.teststageevents;
i=pt:core.pipeline.types;
i=em:core.pipeline.emitter;
i=hist:core.pipeline.history;
i=str:std.str;
i=test:std.test;

f=run():void{
  teststagelabels();
  teststatussymbols();
  testallstagescount();
  testemitterlifecycle();
  testhistoryaddandrecent();
  testhistoryeviction()
};

f=teststagelabels():void{
  test.asserteq(pt.stagelabel("input");"Input";"input label");
  test.asserteq(pt.stagelabel("privacy_scan");"Privacy Scan";"privacy_scan label");
  test.asserteq(pt.stagelabel("anonymisation");"Anonymisation";"anonymisation label")
};

f=teststatussymbols():void{
  test.asserteq(pt.statussymbol("pending");"[ ]";"pending symbol");
  test.asserteq(pt.statussymbol("complete");"[ok]";"complete symbol");
  test.asserteq(pt.statussymbol("error");"[!!]";"error symbol")
};

f=testallstagescount():void{
  let stages=pt.allstages();
  test.assert(stages.len=9;"should have 9 pipeline stages")
};

f=testemitterlifecycle():void{
  let e=em.new("run-1";"req-1");
  let e=em.startstage(e;"input");
  let e=em.completestage(e;"input";5;@i64{key:"chars";value:"1024"}));
  let e=em.startstage(e;"privacy_scan");
  let e=em.completestage(e;"privacy_scan";12;@());
  let e=em.skipstage(e;"anonymisation";"no PII found");
  let run=em.finalise(e);
  test.assert(run.events.len=5;"should have 5 events");
  test.asserteq(run.overallstatus;"complete";"should be complete");
  test.assert(run.totaldurationms=17;"total duration should be 17ms")
};

f=testhistoryaddandrecent():void{
  let h=hist.new(10);
  let run=$pt.pipelinerun{id:"r1";requestid:"req-1";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:100};
  let h=hist.add(h;run);
  let recent=hist.recent(h;5);
  test.assert(recent.len=1;"should have 1 run")
};

f=testhistoryeviction():void{
  let h=hist.new(2);
  let r1=$pt.pipelinerun{id:"r1";requestid:"";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:0};
  let r2=$pt.pipelinerun{id:"r2";requestid:"";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:0};
  let r3=$pt.pipelinerun{id:"r3";requestid:"";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:0};
  let h=hist.add(h;r1);
  let h=hist.add(h;r2);
  let h=hist.add(h;r3);
  test.assert(h.runs.len=2;"should evict oldest, keep 2");
  test.asserteq(h.runs.get(0).id;"r2";"oldest should be r2")
};

m=tests.unit.pipeline.teststageevents;

i=pt:core.pipeline.types;
i=em:core.pipeline.emitter;
i=hist:core.pipeline.history;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  results=str.arraypush(results;asserteq("input label";pt.stagelabel("input");"Input"));
  results=str.arraypush(results;asserteq("privacy_scan label";pt.stagelabel("privacy_scan");"Privacy Scan"));
  results=str.arraypush(results;asserteq("anonymisation label";pt.stagelabel("anonymisation");"Anonymisation"));

  results=str.arraypush(results;asserteq("pending symbol";pt.statussymbol("pending");"[ ]"));
  results=str.arraypush(results;asserteq("complete symbol";pt.statussymbol("complete");"[ok]"));
  results=str.arraypush(results;asserteq("error symbol";pt.statussymbol("error");"[!!]"));

  let stages=pt.allstages();
  results=str.arraypush(results;asserttrue("should have 9 pipeline stages";str.arraylen(stages) = 9));

  let e=em.new("run-1";"req-1");
  let e=em.startstage(e;"input");
  let e=em.completestage(e;"input";5;@(pt.$kvpair{key:"chars";value:"1024"}));
  let e=em.startstage(e;"privacy_scan");
  let e=em.completestage(e;"privacy_scan";12;@());
  let e=em.skipstage(e;"anonymisation";"no PII found");
  let run=em.finalise(e);
  results=str.arraypush(results;asserttrue("should have 5 events";str.arraylen(run.events) = 5));
  results=str.arraypush(results;asserteq("should be complete";run.overallstatus;"complete"));
  results=str.arraypush(results;asserttrue("total duration should be 17ms";run.totaldurationms = 17));

  let h=hist.new(10);
  let histrun=pt.$pipelinerun{id:"r1";requestid:"req-1";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:100};
  let h=hist.add(h;histrun);
  let recent=hist.recent(h;5);
  results=str.arraypush(results;asserttrue("should have 1 run";str.arraylen(recent) = 1));

  let h2=hist.new(2);
  let r1=pt.$pipelinerun{id:"r1";requestid:"";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:0};
  let r2=pt.$pipelinerun{id:"r2";requestid:"";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:0};
  let r3=pt.$pipelinerun{id:"r3";requestid:"";startedat:0;completedat:0;events:@();overallstatus:"complete";totaldurationms:0};
  let h2=hist.add(h2;r1);
  let h2=hist.add(h2;r2);
  let h2=hist.add(h2;r3);
  results=str.arraypush(results;asserttrue("should evict oldest, keep 2";str.arraylen(h2.runs) = 2));
  let oldest=str.arrayget(h2.runs;0);
  results=str.arraypush(results;asserteq("oldest should be r2";oldest.id;"r2"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i+1 }el{ let all = false; i = i+1 }
    }
  };
  <all
};

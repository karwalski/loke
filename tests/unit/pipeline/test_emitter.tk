m=test.pipeline.emitter;

i=t:std.test;
i=em:core.pipeline.emitter;
i=pt:core.pipeline.types;

(* X4b.15: the stage-event emitter behind the CLI's verbose pipeline view, against the real
   module. finalise has to total the durations and mark the run as errored when any stage
   errored. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let e0=em.new("run-1";"req-1");
  let e1=em.startstage(e0;"anonymise");
  let e2=em.completestage(e1;"anonymise";15;@());
  let e3=em.skipstage(e2;"llm_call";"local only");
  if(t.assert(e3.events.len==3;"start, complete and skip each record an event")){pass=pass+1}el{fail=fail+1};
  if(t.assert(e0.events.len==0;"and the emitter they started from is unchanged")){pass=pass+1}el{fail=fail+1};
  let ok=em.finalise(em.completestage(e3;"response";5;@()));
  if(t.asserteq(ok.overallstatus;"complete";"a run with no errored stage is complete")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ok.totaldurationms==20;"and its total is the sum of the stage durations, 15 + 5")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ok.id;"run-1";"the run keeps its id")){pass=pass+1}el{fail=fail+1};
  let bad=em.finalise(em.errorstage(e3;"llm_call";"provider refused"));
  if(t.asserteq(bad.overallstatus;"error";"a run with an errored stage is an error")){pass=pass+1}el{fail=fail+1};
  <fail
};

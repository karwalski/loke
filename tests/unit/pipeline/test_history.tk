m=test.pipeline.history;

i=t:std.test;
i=em:core.pipeline.emitter;
i=hi:core.pipeline.history;
i=pt:core.pipeline.types;

(* X4b.15: the bounded run history, against the real module. Adding past the bound evicts
   the oldest run, `recent` returns the newest n, and `last` is the newest. *)

f=runnamed(id:str):$pipelinerun{
  <em.finalise(em.new(id;"req"))
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let h0=hi.new(2);
  let h1=hi.add(h0;runnamed("r1"));
  let h2=hi.add(h1;runnamed("r2"));
  if(t.assert(h2.runs.len==2;"two runs fit in a history of two")){pass=pass+1}el{fail=fail+1};
  let h3=hi.add(h2;runnamed("r3"));
  if(t.assert(h3.runs.len==2;"a third evicts one, so the history stays at its bound")){pass=pass+1}el{fail=fail+1};
  let first:$pipelinerun=h3.runs.get(0);
  if(t.asserteq(first.id;"r2";"the OLDEST run is the one evicted")){pass=pass+1}el{fail=fail+1};
  let rec=hi.recent(h3;1);
  if(t.assert(rec.len==1;"recent(1) returns one run")){pass=pass+1}el{fail=fail+1};
  let newest:$pipelinerun=rec.get(0);
  if(t.asserteq(newest.id;"r3";"and it is the newest")){pass=pass+1}el{fail=fail+1};
  let lastrun=mt hi.last(h3) {$ok:r r; $err:e runnamed("none")};
  if(t.asserteq(lastrun.id;"r3";"last is the newest run")){pass=pass+1}el{fail=fail+1};
  <fail
};

m=test.privacy.layerconfig;

i=t:std.test;
i=str:std.str;

(* --- stub types and functions mirroring core.privacy.layerconfig --- *)

t=$layerentry{
  id:str;
  enabled:bool;
  priority:i32;
  mode:str;
  confidencethreshold:f64;
  entityfilter:str
};

t=$layerconfig{
  layers:@$layerentry;
  consensusstrategy:str
};

f=defaultconfig():$layerconfig{
  let layers=@(
    $layerentry{id:"regex";enabled:true;priority:1 as i32;mode:"detect-and-mask";confidencethreshold:0.8;entityfilter:""};
    $layerentry{id:"ner";enabled:true;priority:2 as i32;mode:"detect-and-mask";confidencethreshold:0.75;entityfilter:""};
    $layerentry{id:"presidio";enabled:false;priority:3 as i32;mode:"detect-only";confidencethreshold:0.7;entityfilter:""}
  );
  <$layerconfig{layers:layers;consensusstrategy:"most-restrictive"}
};

f=getlayer(cfg:$layerconfig;id:str):$layerentry{
  let result=mut.cfg.layers.get(0);
  lp(let i=0;i<cfg.layers.len;i=i+1){
    let l=cfg.layers.get(i);
    if(str.eq(l.id;id)){result=l}el{}
  };
  <result
};

f=enabledlayers(cfg:$layerconfig):@$layerentry{
  let result=mut.@();
  lp(let i=0;i<cfg.layers.len;i=i+1){
    let l=cfg.layers.get(i);
    if(l.enabled){result=@(result;l)}el{}
  };
  <result
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let cfg=defaultconfig();

  (* 1. default has 3 layers *)
  if(t.assert(cfg.layers.len=3;"default config has 3 layers")){pass=pass+1}el{fail=fail+1};

  (* 2. default consensus strategy is most-restrictive *)
  if(t.asserteq(cfg.consensusstrategy;"most-restrictive";"default strategy is most-restrictive")){pass=pass+1}el{fail=fail+1};

  (* 3. regex layer is enabled *)
  let regexlayer=getlayer(cfg;"regex");
  if(t.assert(regexlayer.enabled;"regex layer is enabled by default")){pass=pass+1}el{fail=fail+1};

  (* 4. presidio layer is disabled *)
  let presidiolayer=getlayer(cfg;"presidio");
  if(t.assert(!presidiolayer.enabled;"presidio layer is disabled by default")){pass=pass+1}el{fail=fail+1};

  (* 5. regex has highest priority *)
  if(t.assert((regexlayer.priority as i64)=1;"regex has priority 1")){pass=pass+1}el{fail=fail+1};

  (* 6. ner has priority 2 *)
  let nerlayer=getlayer(cfg;"ner");
  if(t.assert((nerlayer.priority as i64)=2;"ner has priority 2")){pass=pass+1}el{fail=fail+1};

  (* 7. enabled layers returns only 2 *)
  let enabled=enabledlayers(cfg);
  if(t.assert(enabled.len=2;"only 2 layers are enabled")){pass=pass+1}el{fail=fail+1};

  (* 8. regex mode is detect-and-mask *)
  if(t.asserteq(regexlayer.mode;"detect-and-mask";"regex mode is detect-and-mask")){pass=pass+1}el{fail=fail+1};

  (* 9. presidio mode is detect-only *)
  if(t.asserteq(presidiolayer.mode;"detect-only";"presidio mode is detect-only")){pass=pass+1}el{fail=fail+1};

  (* 10. regex confidence threshold *)
  if(t.assert(regexlayer.confidencethreshold>0.79;"regex confidence threshold is 0.8")){pass=pass+1}el{fail=fail+1};

  <fail
};

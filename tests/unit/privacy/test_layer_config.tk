m=test.privacy.layerconfig;

i=t:std.test;
i=str:std.str;
i=lc:core.privacy.layerconfig;

(* X7.2 — this file used to declare its own $layerentry and $layerconfig and assert
   against them. It now imports core.privacy.layerconfig.

   FINDING, recorded rather than asserted as correct: getlayer RETURNS THE FIRST LAYER
   FOR AN UNKNOWN ID.

       f=getlayer(cfg:$layerconfig;id:str):$layerentry{
         let result=mut.cfg.layers.get(0);
         ...

   The accumulator is seeded with layers.get(0) — the regex layer — and only overwritten
   on a match. So getlayer(cfg;"presidio-v2") returns the REGEX layer's entry, complete
   with enabled:true and a 0.8 confidence threshold, under a name that does not exist. A
   caller checking whether a layer it was asked about is enabled gets "yes" for every
   layer it has never heard of. The honest answers are either an `enabled:false` sentinel
   or a `has` predicate alongside it, as core.privacy.entityrouting at least manages —
   that one returns empty layer lists rather than another layer's.

   It is worse than fail-open on a lookup: it attributes one layer's configuration to
   another, so a diagnostic printed from it would be confidently wrong about which layer
   is doing what.

   NOT FIXED HERE: this module has no importer anywhere in the repository, so the defect
   is latent. The assertion below records it, following the precedent in
   tests/unit/storage/test_backup.tk, and turns RED when a sentinel or a predicate is
   added. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let cfg=lc.defaultconfig();

  (* ── The default layer set ───────────────────────────────────────────────────
     Three layers, and WHICH of them ship enabled is the whole security posture of a
     fresh install: regex is in-process and cannot be unavailable, NER needs Ollama,
     Presidio needs a sidecar. *)
  if(t.assert(cfg.layers.len==3;"three detection layers are configured by default")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.getlayer(cfg;"regex").enabled;"the regex layer ships ENABLED — it is in-process and is the one layer that cannot be unavailable")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.getlayer(cfg;"ner").enabled;"NER ships enabled")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!lc.getlayer(cfg;"presidio").enabled;"and Presidio ships DISABLED, because it needs a sidecar that is not part of the install")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.enabledlayers(cfg).len==2;"so two layers are active on a fresh install")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.enabledlayers(cfg).len>0;"and never zero, which would mean nothing scans the text")){pass=pass+1}el{fail=fail+1};

  (* Priority orders the layers. Regex first is deliberate: it is deterministic and free,
     so it runs before anything that costs a model call. *)
  if(t.assert(lc.getlayer(cfg;"regex").priority<lc.getlayer(cfg;"ner").priority;"regex runs before NER, being deterministic and free")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.getlayer(cfg;"ner").priority<lc.getlayer(cfg;"presidio").priority;"and NER before Presidio")){pass=pass+1}el{fail=fail+1};

  (* Mode. detect-and-mask actually redacts; detect-only reports and does not. A layer
     silently switched to detect-only would detect everything and mask nothing, which
     looks like a working pipeline and forwards the text in the clear. *)
  if(t.asserteq(lc.getlayer(cfg;"regex").mode;"detect-and-mask";"the regex layer MASKS what it detects, rather than only reporting it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lc.getlayer(cfg;"ner").mode;"detect-and-mask";"and so does NER")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lc.getlayer(cfg;"presidio").mode;"detect-only";"Presidio is detect-only by default")){pass=pass+1}el{fail=fail+1};

  (* Confidence thresholds. A threshold of 0 would accept every candidate a layer
     produced; a threshold of 1 would accept none. Both ends are asserted rather than the
     exact values, so the numbers can be tuned but not zeroed. *)
  if(t.assert(lc.getlayer(cfg;"regex").confidencethreshold>0.0;"every layer has a confidence threshold above zero — zero would accept every candidate")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.getlayer(cfg;"regex").confidencethreshold<1.0;"and below one, which would accept none")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.getlayer(cfg;"ner").confidencethreshold>0.0;"the same for NER")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lc.getlayer(cfg;"presidio").confidencethreshold>0.0;"and for Presidio")){pass=pass+1}el{fail=fail+1};

  (* The entity filter is empty by default, which means every entity type. A non-empty
     default would silently narrow detection on a fresh install. *)
  if(t.asserteq(lc.getlayer(cfg;"regex").entityfilter;"";"the entity filter is empty by default, so no entity type is excluded on a fresh install")){pass=pass+1}el{fail=fail+1};

  (* The consensus strategy decides what happens when two layers disagree.
     most-restrictive is the fail-safe direction for redaction. *)
  if(t.asserteq(cfg.consensusstrategy;"most-restrictive";"disagreement between layers resolves the MOST restrictive way, which is the fail-safe direction for redaction")){pass=pass+1}el{fail=fail+1};

  (* ── FINDING, recorded: an unknown layer id returns the FIRST layer ──────────*)
  let unknown=lc.getlayer(cfg;"no-such-layer");
  if(t.asserteq(unknown.id;"regex";"an UNKNOWN layer id returns the first layer's entry — the regex layer — rather than a sentinel")){pass=pass+1}el{fail=fail+1};
  if(t.assert(unknown.enabled;"so a caller asking whether a layer it has never heard of is enabled is told YES")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lc.getlayer(cfg;"").id;"regex";"and an empty id does the same")){pass=pass+1}el{fail=fail+1};

  <fail
};

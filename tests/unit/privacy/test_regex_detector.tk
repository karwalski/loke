m=test.privacy.regexdetector;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=rx:core.privacy.regex;

(* X7.5 — the sharpest single example in epic X7, now fixed.

   WHAT THIS FILE USED TO BE. It imported `std.test` and `std.str` and nothing else.
   Every one of its fourteen assertions was a str.len or str.contains over a LITERAL:

     if(t.assert((str.len("123456789") as i64) == 9;"tfn: 9 digits")){...}
     if(t.assert(str.contains("john@example.com";"@");"email: has @")){...}

   It asserted that the string "123456789" is nine characters long, under the name
   test_regex_detector. It passed, and it would have passed whatever
   core.privacy.regex did, because it never called it. Meanwhile the module it is named
   for carried an unanchored `patautfn` that matched the trailing nine digits of every
   Australian mobile number, so EVERY AU MOBILE WAS ALSO REPORTED AS A TAX FILE NUMBER
   and, because the pipeline takes the maximum sensitivity and au_tfn is RESTRICTED
   against phone_au's CONFIDENTIAL, every prompt containing a phone number was escalated
   to the sensitivity that decides which providers it may reach. That defect (PL1.10)
   lived and was fixed with this file green throughout.

   WHAT IT COVERS NOW. tests/unit/privacy/test_regex_spans.tk already exercises the
   detector's spans, the PL1.10 digit-boundary rejection, and detection of email,
   phone_au, au_tfn and api_key — so this file deliberately does NOT repeat those. It
   takes the surface test_regex_spans leaves alone, which is most of what this file
   originally claimed:

     - the PATTERN INVENTORY itself: ten named patterns, each with a non-empty pattern
       string and the sensitivity its type warrants;
     - detection of the types test_regex_spans never touches — credit_card, ip_v4,
       ssn_us, au_abn, url;
     - the NEGATIVE cases, which are the half of a detector nobody writes tests for and
       which decide whether it cries wolf;
     - detectwithpatterns against a restricted subset, which is how a caller narrows the
       layer and is untested anywhere else. *)

f=countoftype(entities:@$piientity;wanted:str):i64{
  let n=mut.0;
  lp(let i=0;i<entities.len;i=i+1){
    let e:$piientity=entities.get(i);
    if(str.eq(e.entitytype;wanted)){
      n=n+1
    }el{}
  };
  <n
};

f=namedpattern(pats:@$patterndef;wanted:str):i64{
  let found=mut.0;
  lp(let i=0;i<pats.len;i=i+1){
    let p:$patterndef=pats.get(i);
    if(str.eq(p.name;wanted)){
      found=found+1
    }el{}
  };
  <found
};

f=patternfor(pats:@$patterndef;wanted:str):$patterndef{
  let idx=mut.0;
  lp(let i=0;i<pats.len;i=i+1){
    let p:$patterndef=pats.get(i);
    if(str.eq(p.name;wanted)){
      idx=i
    }el{}
  };
  <pats.get(idx)
};

f=allpatternsnonempty(pats:@$patterndef):bool{
  let ok=mut.true;
  lp(let i=0;i<pats.len;i=i+1){
    let p:$patterndef=pats.get(i);
    if(str.len(p.pattern)>0){}el{
      ok=false
    };
    if(str.len(p.name)>0){}el{
      ok=false
    }
  };
  <ok
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── The pattern inventory ───────────────────────────────────────────────────
     A detection layer is its pattern set. A pattern that is silently dropped from this
     list does not fail anything else in the suite: the entity simply stops being
     detected, and a prompt that used to be redacted goes out in the clear. *)
  let pats=rx.getpatterns();
  if(t.assert(pats.len==13;"the regex layer declares thirteen patterns (RG1.7 added au_medicare, au_bsb and bank_account)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(allpatternsnonempty(pats);"every pattern has a name and a non-empty expression — an empty expression matches nothing and is a silent hole")){pass=pass+1}el{fail=fail+1};

  if(t.assert(namedpattern(pats;"email")==1;"email is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"phone_au")==1;"phone_au is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"phone_us")==1;"phone_us is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"credit_card")==1;"credit_card is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"ip_v4")==1;"ip_v4 is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"au_tfn")==1;"au_tfn is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"au_abn")==1;"au_abn is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"ssn_us")==1;"ssn_us is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"url")==1;"url is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"api_key")==1;"api_key is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"au_medicare")==1;"au_medicare is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"au_bsb")==1;"au_bsb is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(namedpattern(pats;"bank_account")==1;"bank_account is declared exactly once")){pass=pass+1}el{fail=fail+1};

  (* The sensitivity each type carries. This is not decoration: rx.detect takes the
     maximum over the entities it found, and that maximum decides the route and the
     gate. Demoting credit_card from RESTRICTED to CONFIDENTIAL here would silently
     widen the set of providers a card number may be sent to. *)
  if(t.asserteq(sh.senslabel(patternfor(pats;"credit_card").sensitivity);"restricted";"a card number is RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"au_tfn").sensitivity);"restricted";"a tax file number is RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"ssn_us").sensitivity);"restricted";"a social security number is RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"api_key").sensitivity);"restricted";"an API key is RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"au_medicare").sensitivity);"restricted";"a Medicare number is RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"au_bsb").sensitivity);"restricted";"a BSB is RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"bank_account").sensitivity);"restricted";"a bank account number is RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"email").sensitivity);"confidential";"an email address is CONFIDENTIAL")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"au_abn").sensitivity);"confidential";"an ABN is CONFIDENTIAL — a business number, not a personal identifier")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"ip_v4").sensitivity);"internal";"an IP address is INTERNAL")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(patternfor(pats;"url").sensitivity);"internal";"a URL is INTERNAL")){pass=pass+1}el{fail=fail+1};

  (* Confidence is what a consensus layer weighs. A card number and a URL must not
     arrive with the same confidence, or the ranking is meaningless. *)
  if(t.assert(patternfor(pats;"credit_card").confidence>patternfor(pats;"url").confidence;"a card number is matched with higher confidence than a URL")){pass=pass+1}el{fail=fail+1};

  (* ── Detection: the types test_regex_spans.tk does not cover ─────────────────*)

  (* A Visa test number. Asserted through the detector, not through str.len of the
     literal, which is what this file used to do. *)
  let cctext="Card 4111 1111 1111 1111 on file";
  let cc=rx.detect(cctext);
  if(t.assert(countoftype(cc.entities;"credit_card")==1;"a spaced Visa number is detected as a credit_card")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(cc.sensitivity);"restricted";"and the prompt carrying it is RESTRICTED")){pass=pass+1}el{fail=fail+1};

  let iptext="Host is 192.168.1.1 on the LAN";
  let ip=rx.detect(iptext);
  if(t.assert(countoftype(ip.entities;"ip_v4")==1;"an IPv4 address is detected")){pass=pass+1}el{fail=fail+1};

  let ssntext="SSN 123-45-6789 on record";
  let ssn=rx.detect(ssntext);
  if(t.assert(countoftype(ssn.entities;"ssn_us")==1;"a US social security number is detected")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(ssn.sensitivity);"restricted";"and is RESTRICTED")){pass=pass+1}el{fail=fail+1};

  let abntext="ABN 51 824 753 556 registered";
  let abn=rx.detect(abntext);
  if(t.assert(countoftype(abn.entities;"au_abn")>0;"an eleven-digit ABN is detected")){pass=pass+1}el{fail=fail+1};

  let urltext="See https://example.com/docs for detail";
  let url=rx.detect(urltext);
  if(t.assert(countoftype(url.entities;"url")==1;"a URL is detected")){pass=pass+1}el{fail=fail+1};

  (* ── The negative cases ─────────────────────────────────────────────────────
     Half of a detector is what it declines to match. A layer that fires on ordinary
     prose trains the user to dismiss its warnings, and the project's own rule is that
     warnings must be earned. These are the cases the old file "tested" by asserting
     that "not-an-email" does not contain an @. *)
  let plain="the quick brown fox jumped over the lazy dog";
  let none=rx.detect(plain);
  if(t.assert(none.entities.len==0;"ordinary prose yields no entities at all")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(none.sensitivity);"public";"and does not raise the prompt's sensitivity above PUBLIC")){pass=pass+1}el{fail=fail+1};

  let notmail="write to not-an-email or to plainword";
  if(t.assert(countoftype(rx.detect(notmail).entities;"email")==0;"a hyphenated word with no @ is not an email address")){pass=pass+1}el{fail=fail+1};

  (* Four digits is not a card number and not an identifier of any kind. A detector
     that matched it would redact every year and every quantity in every prompt. *)
  let shortnum="only 1234 items left in 2026";
  let shortres=rx.detect(shortnum);
  if(t.assert(countoftype(shortres.entities;"credit_card")==0;"a four-digit number is not a credit card")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countoftype(shortres.entities;"au_tfn")==0;"nor a tax file number")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countoftype(shortres.entities;"ssn_us")==0;"nor a social security number")){pass=pass+1}el{fail=fail+1};

  (* ── detectwithpatterns: narrowing the layer ─────────────────────────────────
     A caller that disables an entity type does so by passing a subset. If the subset is
     ignored, a user who turned a detector off still has it on — which is a different
     kind of privacy failure from a missed detection, but a failure of the same promise.
     @(a;b) is a two-element literal, which is what is wanted here (T-24). *)
  let mailonly=@(patternfor(pats;"email");patternfor(pats;"url"));
  let mixed="mail john.smith@example.com about card 4111 1111 1111 1111";
  let narrowed=rx.detectwithpatterns(mixed;mailonly);
  if(t.assert(countoftype(narrowed.entities;"email")==1;"a narrowed pattern set still detects what it was given")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countoftype(narrowed.entities;"credit_card")==0;"and does NOT detect a type the caller excluded")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(narrowed.sensitivity);"confidential";"so the sensitivity reflects only the entities the narrowed set found")){pass=pass+1}el{fail=fail+1};

  (* The full set on the same text finds both, which is what makes the comparison above
     a statement about the subset rather than about the text. *)
  let full=rx.detect(mixed);
  if(t.assert(countoftype(full.entities;"credit_card")==1;"the full pattern set does find the card in that same text")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.senslabel(full.sensitivity);"restricted";"and reports the maximum sensitivity over everything it found")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.regexdetector;
i=t:std.test;
i=str:std.str;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* email detection — @ and . present *)
  if(t.assert(str.contains("john@example.com";"@");"email: has @")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains("john@example.com";".");"email: has .")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains("not-an-email";"@");"non-email: no @")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains("plainword";"@");"non-email: plain word")){pass=pass+1}el{fail=fail+1};

  (* phone detection — length and prefix *)
  if(t.assert((str.len("0412345678") as i64) = 10;"phone_au: 10 chars")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains("+61412345678";"+61");"phone_au: +61 prefix")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains("hello";"+61");"non-phone: no +61")){pass=pass+1}el{fail=fail+1};

  (* credit card — length check *)
  if(t.assert((str.len("4111111111111111") as i64) = 16;"cc: visa 16 chars")){pass=pass+1}el{fail=fail+1};
  if(t.assert((str.len("340000000000009") as i64) = 15;"cc: amex 15 chars")){pass=pass+1}el{fail=fail+1};
  if(t.assert((str.len("1234") as i64) = 4;"cc: short not 16")){pass=pass+1}el{fail=fail+1};

  (* ip address — dot-separated *)
  if(t.assert(str.contains("192.168.1.1";".");"ipv4: has dots")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains("192.168.1.1";"168");"ipv4: contains octet")){pass=pass+1}el{fail=fail+1};

  (* AU identifiers — length *)
  if(t.assert((str.len("123456789") as i64) = 9;"tfn: 9 digits")){pass=pass+1}el{fail=fail+1};
  if(t.assert((str.len("51824753556") as i64) = 11;"abn: 11 digits")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.entityvocab;

i=t:std.test;
i=str:std.str;
i=io:std.io;
i=vocab:core.privacy.entityvocab;
i=fr:core.privacy.filterregistry;
i=rx:core.privacy.regex;
i=reg:core.policy.presets.registry;
i=sch:core.policy.schema;

(* RG1.7 — one entity-type vocabulary for detectors and presets, through the production
   module core.privacy.entityvocab and the production preset registry.

   THE CHECK THIS STORY EXISTS FOR: every entity type that any registered preset names, in
   an anonymisation rule or in its blocked list, is either emitted by some detection layer
   (through vocab.presettypes) or declared by name in vocab.undetected. A misspelling
   (`creditcard` for `credit_card`), or a type added to a preset with no detector behind
   it, fails here instead of becoming a rule that can never fire. *)

f=namesof(p:$policy):@str{
  let out=mut.@();
  lp(let i=0;i<p.anonymisation.len;i=i+1){
    let a:$anonymisationrule=p.anonymisation.get(i);
    out=out.push(a.entitytype)
  };
  lp(let j=0;j<p.blockedentitytypes.len;j=j+1){
    out=out.push(p.blockedentitytypes.get(j))
  };
  <out
};

f=joined(list:@str):str{
  let out=mut."";
  lp(let i=0;i<list.len;i=i+1){
    if(i>0){ out=str.concat(out;",") }el{};
    out=str.concat(out;list.get(i))
  };
  <out
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── Every preset name is emitted or declared undetected ─────────────────────── *)
  let presets=reg.names();
  if(t.assert(presets.len>=11;"the preset registry lists its presets")){pass=pass+1}el{fail=fail+1};
  lp(let i=0;i<presets.len;i=i+1){
    let name:str=presets.get(i);
    let p=reg.byname(name);
    let names=namesof(p);
    let unknown=joined(vocab.unknownnames(names));
    if(t.asserteq(unknown;"";"every entity type preset \(name) names is emitted by a detector or declared undetected")){pass=pass+1}el{fail=fail+1};
    let gaps=mut.@();
    lp(let j=0;j<p.blockedentitytypes.len;j=j+1){
      let b=p.blockedentitytypes.get(j);
      if(vocab.isundetected(b)){ gaps=gaps.push(b) }el{}
    };
    let gaptext=joined(gaps);
    io.println("  RG1.7 \(name): blocked with no detector (RG1.7a): [\(gaptext)]")
  };

  (* Nothing may be both: an undetected entry for a type some layer emits would hide a
     mapping, and one that hides nothing is noise. *)
  let und=vocab.undetected();
  let both=mut.@();
  lp(let k=0;k<und.len;k=k+1){
    if(vocab.emitted(und.get(k))){ both=both.push(und.get(k)) }el{}
  };
  if(t.asserteq(joined(both);"";"no type is both emitted and declared undetected")){pass=pass+1}el{fail=fail+1};

  (* The presets' financial and government identifiers, by the names the story found
     unmatched, each reach a detector. *)
  if(t.assert(vocab.regexemits("tfn");"tfn: the regex layer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("medicare");"medicare: the regex layer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("bsb");"bsb: the regex layer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("bank_account");"bank_account: the regex layer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("credit_card");"credit_card: the regex layer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("api_key");"api_key: the regex layer")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(vocab.emitters("password");"openai-privacy-filter:SECRET";"password: only the privacy-filter sidecar's SECRET")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!vocab.regexemits("password");"and not the regex layer, which has no password pattern")){pass=pass+1}el{fail=fail+1};

  (* RG1.7a: four au-privacy identifiers left undetected for the regex layer, and the
     special categories stay declared. *)
  if(t.assert(vocab.regexemits("crn");"crn: the regex layer (au_crn)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("passport");"passport: the regex layer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("uk_passport");"uk_passport: the same passport pattern, whose shape includes the UK's nine digits")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("drivers_licence");"drivers_licence: the regex layer (driver_licence)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regexemits("super_member");"super_member: the regex layer (au_super_member)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!vocab.isundetected("crn") && !vocab.isundetected("passport") && !vocab.isundetected("drivers_licence") && !vocab.isundetected("super_member") && !vocab.isundetected("uk_passport");"and none of them is still declared undetected")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!vocab.regexemits("uk_driving_licence") && vocab.isundetected("uk_driving_licence");"the UK licence's sixteen characters are not the licence pattern's shape: still undetected")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.isundetected("biometric") && vocab.isundetected("religion") && vocab.isundetected("sexual_orientation") && vocab.isundetected("political");"biometric and the special categories stay declared undetected: no pattern finds what a text is about")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(reg.byname("au-privacy").blockedentitytypes;"au_crn") && vocab.blocks(reg.byname("au-privacy").blockedentitytypes;"driver_licence");"the detectors' names hit au-privacy's crn and drivers_licence blocks")){pass=pass+1}el{fail=fail+1};

  (* ── blocks: the one comparison an enforcing caller makes ──────────────────── *)
  let apra=reg.byname("apra-cps-234").blockedentitytypes;
  if(t.assert(vocab.blocks(apra;"au_tfn");"the regex layer's au_tfn hits a tfn block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"AU_TFN");"and Presidio's AU_TFN")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"au_medicare");"au_medicare hits a medicare block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"au_bsb");"au_bsb hits a bsb block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"bank_account");"bank_account hits a bank_account block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"FINANCIAL");"and so does the sidecar's account number, reported as FINANCIAL")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"credit_card");"credit_card hits a credit_card block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"api_key");"api_key hits an api_key block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(@("password");"SECRET");"the sidecar's SECRET hits a password block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(@("api_key");"secret");"and an api_key block, matched without regard to case")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.blocks(apra;"MEDICAL");"NER's MEDICAL hits a health block")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!vocab.blocks(apra;"email");"an email address does not hit a block list that names no email")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!vocab.blocks(apra;"no_such_type");"and an unknown type blocks nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!vocab.blocks(@("creditcard");"credit_card");"a misspelt block matches nothing, which is why the name check above exists")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(joined(vocab.unknownnames(@("creditcard";"tfn")));"creditcard";"and the name check names it")){pass=pass+1}el{fail=fail+1};

  (* ── The registry declares what the layers emit, from this module ───────────── *)
  let regexlayer=fr.get(fr.defaultregistry();fr.regexid());
  if(t.asserteq(regexlayer.entitytypes;vocab.layertypetext("regex");"the regex layer's declared types are the vocabulary's")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.indexof(regexlayer.entitytypes;"creditcard")<0;"and no longer say creditcard")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.indexof(regexlayer.entitytypes;"au_medicare")>=0;"and include au_medicare")){pass=pass+1}el{fail=fail+1};
  let pf=fr.get(fr.defaultregistry();fr.privacyfilterid());
  if(t.asserteq(pf.entitytypes;vocab.layertypetext("openai-privacy-filter");"the sidecar's declared types are the vocabulary's")){pass=pass+1}el{fail=fail+1};
  if(t.assert(vocab.regextypes().len==rx.getpatterns().len;"the regex layer's types are its patterns, one each")){pass=pass+1}el{fail=fail+1};

  <fail
};

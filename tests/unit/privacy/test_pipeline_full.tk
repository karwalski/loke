m=test.privacy.pipelinefull;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=pl:core.privacy.pipeline;

(* This file used to declare its own $piientity and its own anonymisetext,
   restoretext, maxsensitivity and dedupentities — four reimplementations, under a
   header that called them "stub pipeline types and functions for end-to-end test".
   It passed, and it exercised no line of core.privacy.pipeline. Its maxsensitivity
   returned a str where the real one returns $sensitivitylevel, and its dedup used
   `kept=@(kept;candidate)`, which nests rather than appends (LS1.1b) — so the one
   assertion that did fail was failing against the test's own bug.

   It now calls the real module. The restoration assertion is gone rather than faked:
   restoration lives in core.privacy.placeholder_store and needs a store handle, so it
   belongs in tests/integration/test_privacy_pipeline_e2e.tk, not here. *)

f=level(s:$sensitivitylevel):str{
  <mt s {
    $public:v "public";
    $internal:v "internal";
    $confidential:v "confidential";
    $restricted:v "restricted"
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let emailentity=$piientity{entitytype:"email";value:"alice@example.com";start:8 as u32;end:25 as u32;confidence:0.95;placeholder:"[EMAIL_1]"};
  let text="Contact alice@example.com for help";
  let anon=pl.anonymisetext(text;@(emailentity));
  if(t.assert(str.contains(anon;"[EMAIL_1]");"email replaced with placeholder")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(anon;"alice@example.com");"original email removed from output")){pass=pass+1}el{fail=fail+1};

  let phoneentity=$piientity{entitytype:"phone";value:"0412345678";start:35 as u32;end:45 as u32;confidence:0.90;placeholder:"[PHONE_1]"};
  let multianon=pl.anonymisetext("Email alice@example.com or call 0412345678";@(emailentity;phoneentity));
  if(t.assert(str.contains(multianon;"[EMAIL_1]");"first entity replaced in multi")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(multianon;"[PHONE_1]");"second entity replaced in multi")){pass=pass+1}el{fail=fail+1};

  let clean="The weather is nice today";
  if(t.asserteq(pl.anonymisetext(clean;@());clean;"clean text unchanged")){pass=pass+1}el{fail=fail+1};

  (* sensitivity, against the real $sensitivitylevel rather than a string stand-in *)
  let ccent=$piientity{entitytype:"credit_card";value:"4111111111111111";start:0 as u32;end:16 as u32;confidence:0.99;placeholder:"[CC_1]"};
  if(t.asserteq(level(pl.maxsensitivity(@(ccent)));"restricted";"credit card is restricted")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(level(pl.maxsensitivity(@(emailentity)));"confidential";"email is confidential")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(level(pl.maxsensitivity(@()));"public";"no entities is public")){pass=pass+1}el{fail=fail+1};

  (* dedup is by value: anonymisetext replaces with str.replace, which consumes every
     occurrence, so a second entity carrying the same value would produce a
     placeholder that never appears in the text. *)
  let dup1=$piientity{entitytype:"email";value:"a@b.com";start:0 as u32;end:7 as u32;confidence:0.9;placeholder:"[E1]"};
  let dup2=$piientity{entitytype:"email";value:"a@b.com";start:10 as u32;end:17 as u32;confidence:0.85;placeholder:"[E2]"};
  if(t.assert(pl.dedupentities(@(dup1;dup2)).len==1;"dedup removes duplicate values")){pass=pass+1}el{fail=fail+1};
  if(t.assert(pl.dedupentities(@(emailentity;phoneentity)).len==2;"dedup keeps distinct entities")){pass=pass+1}el{fail=fail+1};

  (* An entity at offset 0 must not be exempt from the overlap test. The previous
     implementation treated start==0 as "position unknown" and skipped it. *)
  let atzero=$piientity{entitytype:"email";value:"x@y.com";start:0 as u32;end:7 as u32;confidence:0.5;placeholder:"[Z1]"};
  let better=$piientity{entitytype:"email";value:"x@y.com!";start:0 as u32;end:8 as u32;confidence:0.99;placeholder:"[Z2]"};
  if(t.assert(pl.dedupentities(@(better;atzero)).len==1;"a lower-confidence overlap at offset 0 is dropped")){pass=pass+1}el{fail=fail+1};

  <fail
};

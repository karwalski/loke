


m=tests.unit.privacy.testregex;

i=regex:core.privacy.regex;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") }
};

f=assertfalse(name:str;val:bool):$result{
  if(!$val){ <pass(name) }el{ <fail(name;"expected false") }
};

f=assertequ32(name:str;got:u32;want:u32):$result{
  if(got=want){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(str.fromu32(want);str.concat(" got=";str.fromu32(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};


f=firstentitytype(detection:$piidetectionresult;expectedtype:str):str{
  let count=str.arraylen(detection.entities);
  let i=0;
  let found="";
  lp(let lv=0;true;lv=lv){
    if(i>count){ break }el{
      let entity=str.arrayget(detection.entities;i);
      if(str.eq(entity.entitytype;expectedtype)){
        let found=entity.entitytype;
        i=count;
      }el{
        i=i+1;
      }
    }
  };
  <found
};

f=firstplaceholder(detection:$piidetectionresult):str{
  let count=str.arraylen(detection.entities);
  if(count=0){
    <""
  }el{
    let entity=str.arrayget(detection.entities;0);
    <entity.placeholder
  }
};

f=runall():bool{
  let results=@($result);

  
  let emailtext="john.smith@example.com";
  let emaildet=regex.detect(emailtext);
  let emailtype=firstentitytype(emaildet;"email");
  results=str.arraypush(results;asserteq("email entity_type";emailtype;"email"));

  
  results=str.arraypush(results;asserttrue("email sensitivity confidential";emaildet.sensitivity=$confidential));

  
  let phonetext="0412 345 678";
  let phonedet=regex.detect(phonetext);
  let phonetype=firstentitytype(phonedet;"phone_au");
  results=str.arraypush(results;asserteq("phone_au entity_type";phonetype;"phone_au"));

  
  results=str.arraypush(results;asserttrue("phone_au sensitivity confidential";phonedet.sensitivity=$confidential));

  
  let cctext="4111111111111111";
  let ccdet=regex.detect(cctext);
  let cctype=firstentitytype(ccdet;"credit_card");
  results=str.arraypush(results;asserteq("credit_card entity_type";cctype;"credit_card"));

  
  results=str.arraypush(results;asserttrue("credit_card sensitivity restricted";ccdet.sensitivity=$restricted));

  
  let tfntext="My TFN is 123 456 789";
  let tfndet=regex.detect(tfntext);
  results=str.arraypush(results;asserttrue("au_tfn sensitivity restricted";tfndet.sensitivity=$restricted));

  
  let apitext="sk-ant-abc123xyz456def789ghi012jkl";
  let apidet=regex.detect(apitext);
  results=str.arraypush(results;asserttrue("api_key sensitivity restricted";apidet.sensitivity=$restricted));

  
  let cleantext="The weather is nice today";
  let cleandet=regex.detect(cleantext);
  results=str.arraypush(results;assertequ32("clean text zero entities";str.arraylen(cleandet.entities);0));
  results=str.arraypush(results;asserttrue("clean text sensitivity public";cleandet.sensitivity=$public));

  
  let multitext="john@example.com and 0412 345 678";
  let multidet=regex.detect(multitext);
  results=str.arraypush(results;assertequ32("multiple PII entity count";str.arraylen(multidet.entities);2));

  
  let phtext="contact john@example.com now";
  let phdet=regex.detect(phtext);
  let phstr=firstplaceholder(phdet);
  results=str.arraypush(results;asserteq("email placeholder format";phstr;"[EMAIL_1]"));

  
  results=str.arraypush(results;asserteq("original field preserved";phdet.original;"contact john@example.com now"));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let allpassed=false }el{};
      i=i+1;
    }
  };
  <allpassed
};

m=test.privacy.pipeline_orchestrator;

i=t:std.test;
i=str:std.str;

(* --- stub pipeline orchestrator functions --- *)

(* sensitivity levels *)
f=sensitivity_low():i64{ <0 };
f=sensitivity_medium():i64{ <1 };
f=sensitivity_high():i64{ <2 };
f=sensitivity_critical():i64{ <3 };

(* classify sensitivity of input text *)
f=classify_sensitivity(text:str):i64{
  if(str.contains(text;"credit card")){<sensitivity_critical()};
  if(str.contains(text;"passport")){<sensitivity_critical()};
  if(str.contains(text;"@")){<sensitivity_high()};
  if(str.contains(text;"phone")){<sensitivity_medium()};
  <sensitivity_low()
};

(* simulate PII detection — returns count of PII items found *)
f=detect_pii_count(text:str):i64{
  let count=mut.0;
  if(str.contains(text;"@")){count=count+1};
  if(str.contains(text;"credit card")){count=count+1};
  if(str.contains(text;"passport")){count=count+1};
  if(str.contains(text;"phone")){count=count+1};
  if(str.contains(text;"4111")){count=count+1};
  <count
};

(* anonymise text — replace PII patterns with placeholders *)
f=anonymise(text:str):str{
  if(str.contains(text;"alice@example.com")){
    <"Please contact [EMAIL_1] for details"
  };
  if(str.contains(text;"4111-1111-1111-1111")){
    <"My credit card is [CREDIT_CARD_1]"
  };
  if(str.contains(text;"passport AB123456")){
    <"My passport is [PASSPORT_1]"
  };
  if(str.contains(text;"0412 345 678")){
    <"Call me on [PHONE_AU_1]"
  };
  <text
};

(* check if text is clean (no PII) *)
f=is_clean(text:str):i64{
  if(detect_pii_count(text)=0){<1};
  <0
};

(* pipeline pass-through for clean text *)
f=pipeline_process(text:str):str{
  if(is_clean(text)=1){<text};
  <anonymise(text)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test PII text gets anonymised *)
  if(t.assert(str.contains(anonymise("Please contact alice@example.com for details");"[EMAIL_1]");"email PII is anonymised to placeholder")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(anonymise("My credit card is 4111-1111-1111-1111");"[CREDIT_CARD_1]");"credit card PII is anonymised")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(anonymise("My passport is passport AB123456");"[PASSPORT_1]");"passport PII is anonymised")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(anonymise("Call me on 0412 345 678");"[PHONE_AU_1]");"phone PII is anonymised")){pass=pass+1}el{fail=fail+1};

  (* test clean text passes through unchanged *)
  let clean="The weather is nice today";
  if(t.assert(str.eq(pipeline_process(clean);clean);"clean text passes through unchanged")){pass=pass+1}el{fail=fail+1};

  let clean2="Please summarise this document";
  if(t.assert(str.eq(pipeline_process(clean2);clean2);"another clean text passes through")){pass=pass+1}el{fail=fail+1};

  (* test sensitivity classification *)
  if(t.assert(classify_sensitivity("hello world")=sensitivity_low();"plain text is low sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify_sensitivity("call my phone please")=sensitivity_medium();"phone mention is medium sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify_sensitivity("send to user@test.com")=sensitivity_high();"email is high sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify_sensitivity("my credit card is 4111")=sensitivity_critical();"credit card is critical sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify_sensitivity("my passport number")=sensitivity_critical();"passport is critical sensitivity")){pass=pass+1}el{fail=fail+1};

  (* test PII detection count *)
  if(t.assert(detect_pii_count("hello world")=0;"no PII in clean text")){pass=pass+1}el{fail=fail+1};

  if(t.assert(detect_pii_count("email user@ and phone mention")=2;"detects multiple PII types")){pass=pass+1}el{fail=fail+1};

  if(t.assert(is_clean("just a normal sentence")=1;"clean text flagged as clean")){pass=pass+1}el{fail=fail+1};

  if(t.assert(is_clean("contact alice@example.com")=0;"PII text flagged as not clean")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.pipelineorchestrator;

i=t:std.test;
i=str:std.str;

(* --- stub pipeline orchestrator functions --- *)

(* sensitivity levels *)
f=sensitivitylow():i64{ <0 };
f=sensitivitymedium():i64{ <1 };
f=sensitivityhigh():i64{ <2 };
f=sensitivitycritical():i64{ <3 };

(* classify sensitivity of input text *)
f=classifysensitivity(text:str):i64{
  if(str.contains(text;"credit card")){<sensitivitycritical()};
  if(str.contains(text;"passport")){<sensitivitycritical()};
  if(str.contains(text;"@")){<sensitivityhigh()};
  if(str.contains(text;"phone")){<sensitivitymedium()};
  <sensitivitylow()
};

(* simulate PII detection — returns count of PII items found *)
f=detectpiicount(text:str):i64{
  let count=mut.0;
  if(str.contains(text;"@")){count=count+1};
  if(str.contains(text;"credit card")){count=count+1};
  if(str.contains(text;"passport")){count=count+1};
  if(str.contains(text;"phone")){count=count+1};
  if(str.contains(text;"4111")){count=count+1};
  <count
};

(* anonymise text — replace PII patterns with placeholders *)
f=anonymise(text:str):str{
  if(str.contains(text;"alice@example.com")){
    <"Please contact [EMAIL_1] for details"
  };
  if(str.contains(text;"4111-1111-1111-1111")){
    <"My credit card is [CREDIT_CARD_1]"
  };
  if(str.contains(text;"passport AB123456")){
    <"My passport is [PASSPORT_1]"
  };
  if(str.contains(text;"0412 345 678")){
    <"Call me on [PHONE_AU_1]"
  };
  <text
};

(* check if text is clean (no PII) *)
f=isclean(text:str):i64{
  if(detectpiicount(text)=0){<1};
  <0
};

(* pipeline pass-through for clean text *)
f=pipelineprocess(text:str):str{
  if(isclean(text)=1){<text};
  <anonymise(text)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test PII text gets anonymised *)
  if(t.assert(str.contains(anonymise("Please contact alice@example.com for details");"[EMAIL_1]");"email PII is anonymised to placeholder")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(anonymise("My credit card is 4111-1111-1111-1111");"[CREDIT_CARD_1]");"credit card PII is anonymised")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(anonymise("My passport is passport AB123456");"[PASSPORT_1]");"passport PII is anonymised")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(anonymise("Call me on 0412 345 678");"[PHONE_AU_1]");"phone PII is anonymised")){pass=pass+1}el{fail=fail+1};

  (* test clean text passes through unchanged *)
  let clean="The weather is nice today";
  if(t.assert(str.eq(pipelineprocess(clean);clean);"clean text passes through unchanged")){pass=pass+1}el{fail=fail+1};

  let clean2="Please summarise this document";
  if(t.assert(str.eq(pipelineprocess(clean2);clean2);"another clean text passes through")){pass=pass+1}el{fail=fail+1};

  (* test sensitivity classification *)
  if(t.assert(classifysensitivity("hello world")=sensitivitylow();"plain text is low sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classifysensitivity("call my phone please")=sensitivitymedium();"phone mention is medium sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classifysensitivity("send to user@test.com")=sensitivityhigh();"email is high sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classifysensitivity("my credit card is 4111")=sensitivitycritical();"credit card is critical sensitivity")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classifysensitivity("my passport number")=sensitivitycritical();"passport is critical sensitivity")){pass=pass+1}el{fail=fail+1};

  (* test PII detection count *)
  if(t.assert(detectpiicount("hello world")=0;"no PII in clean text")){pass=pass+1}el{fail=fail+1};

  if(t.assert(detectpiicount("email user@ and phone mention")=2;"detects multiple PII types")){pass=pass+1}el{fail=fail+1};

  if(t.assert(isclean("just a normal sentence")=1;"clean text flagged as clean")){pass=pass+1}el{fail=fail+1};

  if(t.assert(isclean("contact alice@example.com")=0;"PII text flagged as not clean")){pass=pass+1}el{fail=fail+1};

  <fail
};

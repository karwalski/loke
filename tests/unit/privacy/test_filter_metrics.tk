m=test.privacy.filtermetrics;

i=t:std.test;
i=str:std.str;

(* --- stub types and functions mirroring core.privacy.filtermetrics --- *)

t=$layermetric{
  layerid:str;
  detectioncount:i64;
  totalprocessingms:i64;
  avgconfidence:f64;
  entitycounts:str
};

f=newmetric(layerid:str):$layermetric{
  <$layermetric{layerid:layerid;detectioncount:0;totalprocessingms:0;avgconfidence:0.0;entitycounts:"{}"}
};

f=recorddetection(m:$layermetric;count:i64;processingms:i64;confidence:f64):$layermetric{
  <$layermetric{
    layerid:m.layerid;
    detectioncount:m.detectioncount+count;
    totalprocessingms:m.totalprocessingms+processingms;
    avgconfidence:confidence;
    entitycounts:m.entitycounts
  }
};

f=formatmetric(m:$layermetric):str{
  <str.concat(m.layerid;str.concat(": ";str.concat(str.fromint(m.detectioncount);str.concat(" detections, ";str.concat(str.fromint(m.totalprocessingms);"ms total")))))
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. new metric has zero detections *)
  let m=newmetric("regex");
  if(t.assert(m.detectioncount=0;"new metric starts with 0 detections")){pass=pass+1}el{fail=fail+1};

  (* 2. new metric has zero processing time *)
  if(t.assert(m.totalprocessingms=0;"new metric starts with 0 processing ms")){pass=pass+1}el{fail=fail+1};

  (* 3. new metric layer id correct *)
  if(t.asserteq(m.layerid;"regex";"new metric has correct layer id")){pass=pass+1}el{fail=fail+1};

  (* 4. record detection increments count *)
  let m2=recorddetection(m;3;50;0.95);
  if(t.assert(m2.detectioncount=3;"detection count after first record")){pass=pass+1}el{fail=fail+1};

  (* 5. record detection accumulates processing time *)
  if(t.assert(m2.totalprocessingms=50;"processing time after first record")){pass=pass+1}el{fail=fail+1};

  (* 6. multiple records accumulate *)
  let m3=recorddetection(m2;2;30;0.90);
  if(t.assert(m3.detectioncount=5;"detection count accumulates across records")){pass=pass+1}el{fail=fail+1};

  (* 7. processing time accumulates *)
  if(t.assert(m3.totalprocessingms=80;"processing time accumulates across records")){pass=pass+1}el{fail=fail+1};

  (* 8. layer id preserved through records *)
  if(t.asserteq(m3.layerid;"regex";"layer id preserved through records")){pass=pass+1}el{fail=fail+1};

  (* 9. format metric contains layer id *)
  let fmtstr=formatmetric(m3);
  if(t.assert(str.contains(fmtstr;"regex");"format includes layer id")){pass=pass+1}el{fail=fail+1};

  (* 10. format metric contains detection count *)
  if(t.assert(str.contains(fmtstr;"5 detections");"format includes detection count")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.filtermetrics;

i=t:std.test;
i=str:std.str;
i=fm:core.privacy.filtermetrics;

(* X7.2 — this file used to declare its own $layermetric and assert against it. It now
   imports core.privacy.filtermetrics.

   TWO FINDINGS, recorded rather than asserted as correct.

   FINDING 1 — avgconfidence IS NOT AN AVERAGE. recorddetection's body is:

       avgconfidence:confidence;

   It OVERWRITES the field with the confidence of the most recent call. So after
   recording 0.99 and then 0.10, a field named avgconfidence reads 0.10 rather than 0.545.
   Nothing in the module divides by anything, and there is no count of confidence samples
   to divide by — the struct has detectioncount, but that is a count of ENTITIES, and one
   recorddetection call can carry several. A metric named avg that reports last is worse
   than no metric: it will be quoted as an average, and docs/metrics-baseline.md is the
   only place this project publishes figures from.

   FINDING 2 — entitycounts IS NEVER WRITTEN. newmetric sets it to the literal "{}" and
   recorddetection copies it across unchanged. There is no code path anywhere that puts an
   entity type into it, so the per-type breakdown this field exists for is permanently
   empty.

   NEITHER IS FIXED HERE: this module has no importer anywhere in the repository, so no
   figure derived from it is being published today. The assertions below record the
   behaviour as it is, following the precedent in tests/unit/storage/test_backup.tk, and
   they turn RED when the average and the breakdown are implemented. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── A fresh metric starts at zero ───────────────────────────────────────────
     A counter that started anywhere else would over-report from the first request. *)
  let m0=fm.newmetric("regex");
  if(t.asserteq(m0.layerid;"regex";"a metric carries the id of the layer it measures")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m0.detectioncount==0;"and starts with no detections")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m0.totalprocessingms==0;"and no accumulated time")){pass=pass+1}el{fail=fail+1};

  (* ── Accumulation ────────────────────────────────────────────────────────────
     Both counters must ADD rather than replace, and the returned metric must be used:
     these are value types, so a caller that drops the return records nothing — the same
     shape of defect as core.privacy.placeholder.addentry (LS1.1a) and
     core.storage.ephemeral.put. *)
  let m1=fm.recorddetection(m0;3;12;0.95);
  if(t.assert(m1.detectioncount==3;"recording three detections counts three")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m1.totalprocessingms==12;"and twelve milliseconds")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m0.detectioncount==0;"while the metric passed in is unchanged, because a toke struct is a value")){pass=pass+1}el{fail=fail+1};

  let m2=fm.recorddetection(m1;2;8;0.80);
  if(t.assert(m2.detectioncount==5;"a second recording ADDS to the count rather than replacing it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m2.totalprocessingms==20;"and the elapsed time accumulates too")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(m2.layerid;"regex";"and the layer id survives accumulation")){pass=pass+1}el{fail=fail+1};

  (* Recording a scan that found nothing must still count the TIME. A layer that is slow
     and finds nothing is exactly the layer an operator needs to see. *)
  let m3=fm.recorddetection(m2;0;40;0.0);
  if(t.assert(m3.detectioncount==5;"a scan that found nothing adds no detections")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m3.totalprocessingms==60;"but its time is still recorded, so a slow layer that finds nothing is visible")){pass=pass+1}el{fail=fail+1};

  (* ── FINDING 1, recorded: avgconfidence is the LAST value, not the mean ──────
     0.95 then 0.80 then 0.0. A mean would be 0.583; the field reads 0.0. Asserted
     through a comparison rather than equality on an f64. *)
  if(t.assert(m3.avgconfidence<0.5;"avgconfidence after 0.95, 0.80 and 0.0 is BELOW 0.5 — it is the last value, not the mean of the three")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m2.avgconfidence<0.9;"and after 0.95 then 0.80 it reads 0.80 rather than 0.875")){pass=pass+1}el{fail=fail+1};

  (* ── FINDING 2, recorded: entitycounts is never written ──────────────────────*)
  if(t.asserteq(m0.entitycounts;"{}";"a fresh metric's per-entity breakdown is an empty JSON object")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(m3.entitycounts;"{}";"and it is STILL empty after three recordings — nothing in the module ever writes an entity type into it")){pass=pass+1}el{fail=fail+1};

  (* ── The summary an operator reads ───────────────────────────────────────────*)
  let line=fm.formatmetric(m3);
  if(t.assert(str.contains(line;"regex");"the summary names the layer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(line;"5 detections");"reports the accumulated count, not the last one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(line;"60ms");"and the accumulated time")){pass=pass+1}el{fail=fail+1};

  <fail
};

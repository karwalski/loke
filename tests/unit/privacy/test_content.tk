m=test.privacy.content;

i=t:std.test;
i=str:std.str;

(* --- stub content type detection --- *)

f=detecttype(text:str):str{
  if(str.len(text)=0){
    <"plain"
  }el{
    if(str.contains(text;"<html>")){
      <"html"
    }el{
      if(str.startswith(text;"{")){
        <"json"
      }el{
        if(str.startswith(text;"[")){
          <"json"
        }el{
          if(str.startswith(text;"#")){
            <"markdown"
          }el{
            (* CSV heuristic: contains comma and newline *)
            if(str.contains(text;",") && str.contains(text;"\n")){
              <"csv"
            }el{
              <"plain"
            }
          }
        }
      }
    }
  }
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. CSV detected *)
  let csvtext="name,age\nAlice,30\nBob,25";
  if(t.assert(str.eq(detecttype(csvtext);"csv");"csv detected with commas and newlines")){pass=pass+1}el{fail=fail+1};

  (* 2. JSON detected with opening brace *)
  let jsonobj="{\"key\":\"value\"}";
  if(t.assert(str.eq(detecttype(jsonobj);"json");"json detected with opening brace")){pass=pass+1}el{fail=fail+1};

  (* 3. JSON detected with opening bracket *)
  let jsonarr="[1,2,3]";
  if(t.assert(str.eq(detecttype(jsonarr);"json");"json detected with opening bracket")){pass=pass+1}el{fail=fail+1};

  (* 4. Markdown detected *)
  let mdtext="# Heading\nSome content here";
  if(t.assert(str.eq(detecttype(mdtext);"markdown");"markdown detected with hash prefix")){pass=pass+1}el{fail=fail+1};

  (* 5. Plain text default *)
  let plain="Just some ordinary text";
  if(t.assert(str.eq(detecttype(plain);"plain");"plain text is default type")){pass=pass+1}el{fail=fail+1};

  (* 6. HTML detected *)
  let htmltext="<html><body>Hello</body></html>";
  if(t.assert(str.eq(detecttype(htmltext);"html");"html detected with html tag")){pass=pass+1}el{fail=fail+1};

  (* 7. Empty string returns valid result *)
  let emptyresult=detecttype("");
  if(t.assert(str.len(emptyresult)>0;"empty string returns non-empty type")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(emptyresult;"plain");"empty string returns plain")){pass=pass+1}el{fail=fail+1};

  (* 8. Very long string handled -- build 1000+ char string *)
  let chunk="abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnop";
  let long=str.concat(chunk;chunk);
  let long=str.concat(long;long);
  let long=str.concat(long;long);
  let long=str.concat(long;long);
  let long=str.concat(long;long);
  if(t.assert(str.len(long)>1000;"built string exceeds 1000 chars")){pass=pass+1}el{fail=fail+1};
  let longresult=detecttype(long);
  if(t.assert(str.eq(longresult;"plain");"very long plain string detected as plain")){pass=pass+1}el{fail=fail+1};

  (* 9. HTML embedded in middle of text *)
  let embeddedhtml="Some text <html> more text";
  if(t.assert(str.eq(detecttype(embeddedhtml);"html");"html tag in middle still detected")){pass=pass+1}el{fail=fail+1};

  (* 10. Single char hash is markdown *)
  if(t.assert(str.eq(detecttype("#");"markdown");"single hash is markdown")){pass=pass+1}el{fail=fail+1};

  <fail
};

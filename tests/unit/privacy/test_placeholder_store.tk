m=test.privacy.placeholderstore;

i=t:std.test;
i=str:std.str;

(* --- stub placeholder store --- *)

t=$storeentry{
  placeholder:str;
  original:str
};

t=$store{
  entries:@$storeentry
};

f=newstore():$store{
  <$store{entries:@()}
};

f=addentry(s:$store;ph:str;orig:str):$store{
  (* overwrite if placeholder already exists *)
  let result=mut.@($storeentry);
  let i=mut.0;
  let n=(s.entries.len as i64);
  let replaced=mut.false;
  lp(let lv=0;i<n;lv=lv){
    let e=s.entries.get(i);
    if(str.eq(e.placeholder;ph)){
      result=result.push($storeentry{placeholder:ph;original:orig});
      replaced=true
    }el{
      result=result.push(e)
    };
    i=i+1
  };
  if(!replaced){
    result=result.push($storeentry{placeholder:ph;original:orig})
  }el{};
  <$store{entries:result}
};

f=getoriginal(s:$store;ph:str):str{
  let i=mut.0;
  let n=(s.entries.len as i64);
  let found=mut."";
  lp(let lv=0;i<n;lv=lv){
    let e=s.entries.get(i);
    if(str.eq(e.placeholder;ph)){found=e.original;i=n}el{i=i+1}
  };
  <found
};

f=restoreall(text:str;s:$store):str{
  let result=mut.text;
  let i=mut.0;
  let n=(s.entries.len as i64);
  lp(let lv=0;i<n;lv=lv){
    let e=s.entries.get(i);
    result=str.replace(result;e.placeholder;e.original);
    i=i+1
  };
  <result
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. new store is empty *)
  let s0=newstore();
  if(t.assert((s0.entries.len as i64)=0;"new store has zero entries")){pass=pass+1}el{fail=fail+1};

  (* 2. add entry and retrieve by placeholder *)
  let s1=addentry(s0;"[EMAIL_1]";"alice@example.com");
  if(t.assert(str.eq(getoriginal(s1;"[EMAIL_1]");"alice@example.com");"retrieve added entry")){pass=pass+1}el{fail=fail+1};

  (* 3. store has one entry after add *)
  if(t.assert((s1.entries.len as i64)=1;"store has 1 entry after add")){pass=pass+1}el{fail=fail+1};

  (* 4. retrieve unknown placeholder returns empty string *)
  if(t.assert(str.eq(getoriginal(s1;"[PHONE_1]");"");"unknown placeholder returns empty")){pass=pass+1}el{fail=fail+1};

  (* 5. duplicate placeholder overwrites previous value *)
  let s2=addentry(s1;"[EMAIL_1]";"bob@example.com");
  if(t.assert(str.eq(getoriginal(s2;"[EMAIL_1]");"bob@example.com");"overwrite returns new value")){pass=pass+1}el{fail=fail+1};
  if(t.assert((s2.entries.len as i64)=1;"overwrite does not increase entry count")){pass=pass+1}el{fail=fail+1};

  (* 6. restoreall replaces every placeholder in a string *)
  let s3=addentry(newstore();"[EMAIL_1]";"carol@test.com");
  let s4=addentry(s3;"[PHONE_1]";"0400111222");
  let restored=restoreall("Contact [EMAIL_1] or call [PHONE_1]";s4);
  if(t.assert(str.eq(restored;"Contact carol@test.com or call 0400111222");"restoreall replaces all placeholders")){pass=pass+1}el{fail=fail+1};

  (* 7. store with zero entries returns text unchanged *)
  let empty=newstore();
  let unchanged=restoreall("Hello world";empty);
  if(t.assert(str.eq(unchanged;"Hello world");"empty store returns text unchanged")){pass=pass+1}el{fail=fail+1};

  (* 8. multiple entries restored in same string *)
  let s5=addentry(newstore();"[NAME_1]";"Dave");
  let s6=addentry(s5;"[NAME_2]";"Eve");
  let s7=addentry(s6;"[ADDR_1]";"123 Main St");
  let multi=restoreall("[NAME_1] and [NAME_2] live at [ADDR_1]";s7);
  if(t.assert(str.eq(multi;"Dave and Eve live at 123 Main St");"three entries restored in one string")){pass=pass+1}el{fail=fail+1};

  (* 9. placeholder not in text leaves text unchanged *)
  let s8=addentry(newstore();"[TOKEN_1]";"secret");
  let noop=restoreall("No tokens here";s8);
  if(t.assert(str.eq(noop;"No tokens here");"placeholder not in text leaves text unchanged")){pass=pass+1}el{fail=fail+1};

  (* 10. getoriginal on empty store returns empty *)
  if(t.assert(str.eq(getoriginal(newstore();"[X]");"");"getoriginal on empty store returns empty")){pass=pass+1}el{fail=fail+1};

  (* 11. add multiple distinct entries *)
  let sa=addentry(newstore();"[A]";"alpha");
  let sb=addentry(sa;"[B]";"bravo");
  if(t.assert(str.eq(getoriginal(sb;"[A]");"alpha");"first of two entries retrievable")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(getoriginal(sb;"[B]");"bravo");"second of two entries retrievable")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.filterregistry;

i=t:std.test;
i=str:std.str;

(* --- stub types and functions mirroring core.privacy.filterregistry --- *)

t=$privacyfilter{
  id:str;
  name:str;
  kind:str;
  entitytypes:str;
  confidence:f64;
  enabled:bool
};

t=$filterregistry{
  filters:@$privacyfilter;
  count:i64
};

f=newregistry():$filterregistry{
  <$filterregistry{filters:@();count:0}
};

f=register(reg:$filterregistry;filter:$privacyfilter):$filterregistry{
  let newfilters=@(reg.filters;filter);
  <$filterregistry{filters:newfilters;count:reg.count+1}
};

f=get(reg:$filterregistry;id:str):$privacyfilter{
  let result=mut.reg.filters.get(0);
  lp(let i=0;i<reg.count;i=i+1){
    let f=reg.filters.get(i);
    if(str.eq(f.id;id)){result=f}el{}
  };
  <result
};

f=list(reg:$filterregistry):@$privacyfilter{
  <reg.filters
};

f=listenabled(reg:$filterregistry):@$privacyfilter{
  let result=mut.@();
  lp(let i=0;i<reg.count;i=i+1){
    let f=reg.filters.get(i);
    if(f.enabled){result=@(result;f)}el{}
  };
  <result
};

f=defaultregistry():$filterregistry{
  let reg=newregistry();
  let reg=register(reg;$privacyfilter{
    id:"regex";name:"Regex Pattern Detector";kind:"regex";
    entitytypes:"email,phone,ssn,creditcard,ip,tfn,abn";
    confidence:0.95;enabled:true
  });
  let reg=register(reg;$privacyfilter{
    id:"ner";name:"NLP NER Detector";kind:"ner";
    entitytypes:"person,organization,location";
    confidence:0.85;enabled:true
  });
  let reg=register(reg;$privacyfilter{
    id:"presidio";name:"Presidio Analyser";kind:"external";
    entitytypes:"email,phone,person,creditcard,iban,medical,address";
    confidence:0.80;enabled:false
  });
  <reg
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. new registry is empty *)
  let reg=newregistry();
  if(t.assert(reg.count=0;"new registry has 0 filters")){pass=pass+1}el{fail=fail+1};

  (* 2. register increments count *)
  let reg2=register(reg;$privacyfilter{id:"test";name:"Test";kind:"test";entitytypes:"";confidence:0.5;enabled:true});
  if(t.assert(reg2.count=1;"registry count is 1 after register")){pass=pass+1}el{fail=fail+1};

  (* 3. default registry has 3 filters *)
  let defreg=defaultregistry();
  if(t.assert(defreg.count=3;"default registry has 3 filters")){pass=pass+1}el{fail=fail+1};

  (* 4. get retrieves correct filter *)
  let regexfilter=get(defreg;"regex");
  if(t.asserteq(regexfilter.name;"Regex Pattern Detector";"get retrieves regex filter by id")){pass=pass+1}el{fail=fail+1};

  (* 5. regex filter entity types include email *)
  if(t.assert(str.contains(regexfilter.entitytypes;"email");"regex handles email entities")){pass=pass+1}el{fail=fail+1};

  (* 6. ner filter kind is ner *)
  let nerfilter=get(defreg;"ner");
  if(t.asserteq(nerfilter.kind;"ner";"ner filter kind is ner")){pass=pass+1}el{fail=fail+1};

  (* 7. list returns all filters *)
  let allfilters=list(defreg);
  if(t.assert(allfilters.len=3;"list returns all 3 filters")){pass=pass+1}el{fail=fail+1};

  (* 8. listenabled returns only enabled filters *)
  let enabled=listenabled(defreg);
  if(t.assert(enabled.len=2;"listenabled returns 2 enabled filters")){pass=pass+1}el{fail=fail+1};

  (* 9. presidio is not in enabled list *)
  let presidio=get(defreg;"presidio");
  if(t.assert(!presidio.enabled;"presidio is disabled by default")){pass=pass+1}el{fail=fail+1};

  (* 10. regex confidence is 0.95 *)
  if(t.assert(regexfilter.confidence>0.94;"regex confidence is 0.95")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.failclosed;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=pl:core.privacy.pipeline;

(* NC1.9 — the filter must not fail open.

   The property under test: when no detection layer completes a scan, the pipeline
   refuses the request instead of returning an empty entity list that a caller would
   read as "no PII found". Asserted here rather than argued in a review, which is what
   NC1.9 asks for.

   The two states were previously indistinguishable. `run` returns a $pipelinerun with
   skipped stages either way, so totalentities:0 meant both "this text is clean" and
   "nothing examined this text". The layer count separates them.

   The gate is a plain bool, not a result. That is deliberate and the last assertion
   below is why: toke does not discriminate a result whose error side is a
   user-declared sum — `mt` on an X!$lokeerr takes the FIRST arm whatever the value is
   — so a refusal returned as $err would be read as success by every caller (T-18).
   An earlier version of this file matched runchecked's arms and passed for that
   reason, which is the trap.

   Presidio and NER are configured off here, so the only layer is the in-process regex
   one, which cannot be unavailable — that is the healthy case. The refusal path is
   exercised through issafetoforward on a hand-built run with zero completed layers,
   because there is no way to take the regex layer down from inside a unit test and
   faking one would test the fake. *)

(* Unprivileged ports nothing listens on. Port 1 would be wrong: binding a privileged
   port fails with EACCES for a non-root process, and the reachability probe reads a
   failed bind as "something is listening" — so a privileged port tests as UP. *)
f=configlocalonly():$pipelineconfig{
  <pl.newconfig("http://127.0.0.1:59998";"http://127.0.0.1:59999")
};

(* Returns true while toke's defect is present: a function that unconditionally returns
   $err, matched with the $ok arm written first, yields the $ok arm. *)
f=alwayserrors():i64!$lokeerr{
  <$err($privacyerr("this function never succeeds"))
};

f=firstarmwins():bool{
  <mt alwayserrors() {
    $ok:v true;
    $err:e false
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. With the regex layer healthy, a scan completes and the run is forwardable. *)
  let r=pl.runforward("contact alice@example.com today";"";configlocalonly());
  if(t.assert(r.layerscompleted>0 as u32;"a healthy pipeline reports at least one completed layer")){pass=pass+1}el{fail=fail+1};

  (* 2. The entity it found is real, so "completed" is not merely a counter. *)
  let r=pl.runforward("contact alice@example.com today";"";configlocalonly());
  if(t.assert(r.totalentities>0 as u32;"the completed layer actually detected the email")){pass=pass+1}el{fail=fail+1};

  (* 3. Clean text is forwardable AND reports zero entities — the distinction that
        matters is between this and case 4, not between this and case 1. *)
  let r=pl.runforward("the weather is nice today";"";configlocalonly());
  if(t.assert(r.totalentities==0 as u32;"clean text scans clean")){pass=pass+1}el{fail=fail+1};

  (* 4. A run where nothing scanned is NOT safe to forward, however empty its entity
        list looks. This is the fail-closed property. *)
  let nothingscanned=$pipelinerun{
    result:$piidetectionresult{
      original:"card 4111111111111111";
      anonymised:"card 4111111111111111";
      entities:@();
      sensitivity:sh.public()
    };
    stages:@();
    totalentities:0 as u32;
    finalsystemprompt:"";
    requestid:"test-nothing-scanned";
    layerscompleted:0 as u32;
    layersdegraded:3 as u32;
    unplaced:0 as u32
  };
  if(t.assert(!pl.issafetoforward(nothingscanned);"a run with zero completed layers is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(nothingscanned.totalentities==0 as u32;"and it does look clean, which is exactly why the layer count is needed")){pass=pass+1}el{fail=fail+1};

  (* 5. One completed layer is enough to forward, even when others are degraded: a
        Presidio sidecar being down must not take a local-first product offline. *)
  let degraded=$pipelinerun{
    result:$piidetectionresult{
      original:"hello";
      anonymised:"hello";
      entities:@();
      sensitivity:sh.public()
    };
    stages:@();
    totalentities:0 as u32;
    finalsystemprompt:"";
    requestid:"test-degraded";
    layerscompleted:1 as u32;
    layersdegraded:2 as u32;
    unplaced:0 as u32
  };
  if(t.assert(pl.issafetoforward(degraded);"a degraded run with one completed layer is still forwardable")){pass=pass+1}el{fail=fail+1};

  (* 6. The reason the gate was made a bool. At toke 0b0bc4e `mt` took the first arm of a
        match on an X!$lokeerr whatever the value was, so an $err refusal read as $ok
        (T-18), and this assertion stood as a tripwire that the defect was still there.
        It failed on toke 3.1.0, which binds arms by label (B2): the tripwire fired as it
        was meant to. It now asserts the fixed behaviour, so a regression in the
        toolchain fails here (F10.39). The gate stays a bool; that is still correct, and
        changing it is not this story. *)
  if(t.assert(!firstarmwins();"toke discriminates a user-defined result: an $err takes the error arm (T-18 fixed in 3.1.0)")){pass=pass+1}el{fail=fail+1};

  <fail
};

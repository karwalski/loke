


m=tests.unit.privacy.testplaceholder;

i=ph:core.privacy.placeholder;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=assertequ32(name:str;got:u32;want:u32):$result{
  if(got=want){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(str.fromu32(want);str.concat(" got=";str.fromu32(got)))))
  }
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") }
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  
  results=str.arraypush(results;asserteq("make_placeholder email 1";ph.makeplaceholder("email";1);"[EMAIL_1]"));

  
  results=str.arraypush(results;asserteq("make_placeholder phone_au 3";ph.makeplaceholder("phone_au";3);"[PHONE_AU_3]"));

  
  results=str.arraypush(results;asserteq("make_placeholder credit_card 2";ph.makeplaceholder("credit_card";2);"[CREDIT_CARD_2]"));

  
  let emptymap=ph.newmap();
  results=str.arraypush(results;assertequ32("new_map zero entries";str.arraylen(emptymap.entries);0));

  
  let map1=ph.newmap();
  ph.addentry(map1;"john@example.com";"[EMAIL_1]";"email");
  results=str.arraypush(results;assertequ32("add_entry map has 1 entry";str.arraylen(map1.entries);1));

  
  let restored=ph.restore("[EMAIL_1] called";map1);
  results=str.arraypush(results;asserteq("restore single entry";restored;"john@example.com called"));

  
  let nophmap=ph.newmap();
  ph.addentry(nophmap;"alice@example.com";"[EMAIL_1]";"email");
  let unchanged=ph.restore("Hello world";nophmap);
  results=str.arraypush(results;asserteq("restore no placeholder unchanged";unchanged;"Hello world"));

  
  let map2=ph.newmap();
  ph.addentry(map2;"bob@example.com";"[EMAIL_1]";"email");
  ph.addentry(map2;"0412 345 678";"[PHONE_AU_2]";"phone_au");
  let bothrestored=ph.restore("[EMAIL_1] rang [PHONE_AU_2]";map2);
  results=str.arraypush(results;asserteq("restore two entries";bothrestored;"bob@example.com rang 0412 345 678"));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let allpassed=false }el{};
      i=i+1;
    }
  };
  <allpassed
};

m=test.privacy.placeholder;

i=t:std.test;
i=str:std.str;

(* i=ph:core.privacy.placeholder; -- linker issue, stubbed below *)

(* --- stub placeholder map --- *)

t=$entry{
  original:str;
  placeholder:str;
  entitytype:str
};

t=$phmap{
  reqid:str;
  entries:@$entry
};

f=newmap(reqid:str):$phmap{
  <$phmap{reqid:reqid;entries:@()}
};

f=addentry(map:$phmap;orig:str;ph:str;etype:str):$phmap{
  let e=$entry{original:orig;placeholder:ph;entitytype:etype};
  let updated=map.entries.push(e);
  <$phmap{reqid:map.reqid;entries:updated}
};

f=makeplaceholder(etype:str;idx:i64):str{
  let tag=str.upper(etype);
  let idxstr=str.fromint(idx);
  <str.concat("[";str.concat(tag;str.concat("_";str.concat(idxstr;"]"))))
};

f=lookup(map:$phmap;ph:str):str{
  let i=mut.0;
  let n=(map.entries.len as i64);
  let found=mut."";
  lp(let lv=0;i<n;lv=lv){
    let e=map.entries.get(i);
    if(str.eq(e.placeholder;ph)){found=e.original;i=n}el{i=i+1}
  };
  <found
};

f=reverselookup(map:$phmap;orig:str):str{
  let i=mut.0;
  let n=(map.entries.len as i64);
  let found=mut."";
  lp(let lv=0;i<n;lv=lv){
    let e=map.entries.get(i);
    if(str.eq(e.original;orig)){found=e.placeholder;i=n}el{i=i+1}
  };
  <found
};

f=restore(text:str;map:$phmap):str{
  let result=mut.text;
  let i=mut.0;
  let n=(map.entries.len as i64);
  lp(let lv=0;true;lv=lv){
    if(!(i<n)){br}el{
      let e=map.entries.get(i);
      result=str.replace(result;e.placeholder;e.original);
      i=i+1
    }
  };
  <result
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* placeholder format *)
  if(t.assert(str.eq(makeplaceholder("email";1);"[EMAIL_1]");"placeholder format email 1")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(makeplaceholder("phone_au";3);"[PHONE_AU_3]");"placeholder format phone_au 3")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(makeplaceholder("credit_card";2);"[CREDIT_CARD_2]");"placeholder format credit_card 2")){pass=pass+1}el{fail=fail+1};

  (* new map is empty *)
  let m0=newmap("req-001");
  if(t.assert((m0.entries.len as i64)=0;"new map has zero entries")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(m0.reqid;"req-001");"map stores request id")){pass=pass+1}el{fail=fail+1};

  (* add single entry and retrieve *)
  let m1=addentry(m0;"john@example.com";"[EMAIL_1]";"email");
  if(t.assert((m1.entries.len as i64)=1;"map has 1 entry after add")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(lookup(m1;"[EMAIL_1]");"john@example.com");"lookup returns original")){pass=pass+1}el{fail=fail+1};

  (* reverse lookup *)
  if(t.assert(str.eq(reverselookup(m1;"john@example.com");"[EMAIL_1]");"reverse lookup returns placeholder")){pass=pass+1}el{fail=fail+1};

  (* lookup miss returns empty *)
  if(t.assert(str.eq(lookup(m1;"[PHONE_1]");"");"lookup miss returns empty string")){pass=pass+1}el{fail=fail+1};

  (* multiple entities in same request *)
  let m2=addentry(m1;"0412345678";"[PHONE_AU_1]";"phone_au");
  if(t.assert((m2.entries.len as i64)=2;"map has 2 entries")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(lookup(m2;"[PHONE_AU_1]");"0412345678");"lookup second entry")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(lookup(m2;"[EMAIL_1]");"john@example.com");"first entry still accessible")){pass=pass+1}el{fail=fail+1};

  (* restore replaces placeholders with originals *)
  let restored=restore("[EMAIL_1] called [PHONE_AU_1]";m2);
  if(t.assert(str.eq(restored;"john@example.com called 0412345678");"restore two placeholders")){pass=pass+1}el{fail=fail+1};

  (* restore with no placeholders returns input unchanged *)
  let unchanged=restore("Hello world";m2);
  if(t.assert(str.eq(unchanged;"Hello world");"restore no match unchanged")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.evaluation;

i=t:std.test;
i=str:std.str;

(* --- stub types and functions mirroring core.privacy.evaluation --- *)

t=$evaluationresult{
  layerid:str;
  detections:i64;
  truepositives:i64;
  falsepositives:i64;
  falsenegatives:i64;
  precision:f64;
  recall:f64;
  f1:f64
};

f=computeprecision(tp:i64;fp:i64):f64{
  if(tp+fp=0){<0.0}el{};
  <(tp as f64)/((tp+fp) as f64)
};

f=computerecall(tp:i64;fn2:i64):f64{
  if(tp+fn2=0){<0.0}el{};
  <(tp as f64)/((tp+fn2) as f64)
};

f=computef1(precision:f64;recall:f64):f64{
  if(precision+recall=0.0){<0.0}el{};
  <2.0*precision*recall/(precision+recall)
};

f=evaluatelayer(layerid:str;detected:i64;labelled:i64;matched:i64):$evaluationresult{
  let tp=matched;
  let fp=mut.detected-matched;
  let fn2=mut.labelled-matched;
  if(fp<0){fp=0}el{};
  if(fn2<0){fn2=0}el{};
  let p=computeprecision(tp;fp);
  let r=computerecall(tp;fn2);
  let f=computef1(p;r);
  <$evaluationresult{
    layerid:layerid;detections:detected;
    truepositives:tp;falsepositives:fp;falsenegatives:fn2;
    precision:p;recall:r;f1:f
  }
};

f=formatresult(r:$evaluationresult):str{
  <str.concat(r.layerid;str.concat(": P=";str.concat(str.fromfloat(r.precision);str.concat(" R=";str.concat(str.fromfloat(r.recall);str.concat(" F1=";str.fromfloat(r.f1)))))))
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. perfect precision: no false positives *)
  let p=computeprecision(10;0);
  if(t.assert(p>0.99;"perfect precision is 1.0")){pass=pass+1}el{fail=fail+1};

  (* 2. precision with false positives *)
  let p2=computeprecision(8;2);
  if(t.assert(p2>0.79;"precision 8/(8+2) = 0.8")){pass=pass+1}el{fail=fail+1};
  if(t.assert(p2<0.81;"precision 8/(8+2) upper bound")){pass=pass+1}el{fail=fail+1};

  (* 3. precision zero when no detections *)
  let p3=computeprecision(0;0);
  if(t.assert(p3<0.01;"precision is 0 when no detections")){pass=pass+1}el{fail=fail+1};

  (* 4. perfect recall *)
  let r=computerecall(10;0);
  if(t.assert(r>0.99;"perfect recall is 1.0")){pass=pass+1}el{fail=fail+1};

  (* 5. recall with false negatives *)
  let r2=computerecall(7;3);
  if(t.assert(r2>0.69;"recall 7/(7+3) = 0.7")){pass=pass+1}el{fail=fail+1};
  if(t.assert(r2<0.71;"recall 7/(7+3) upper bound")){pass=pass+1}el{fail=fail+1};

  (* 6. F1 perfect scores *)
  let f=computef1(1.0;1.0);
  if(t.assert(f>0.99;"perfect F1 is 1.0")){pass=pass+1}el{fail=fail+1};

  (* 7. F1 zero when both zero *)
  let f2=computef1(0.0;0.0);
  if(t.assert(f2<0.01;"F1 is 0 when both precision and recall are 0")){pass=pass+1}el{fail=fail+1};

  (* 8. evaluatelayer end-to-end *)
  let result=evaluatelayer("regex";10;8;7);
  if(t.asserteq(result.layerid;"regex";"evaluatelayer sets layer id")){pass=pass+1}el{fail=fail+1};

  (* 9. evaluatelayer TP count *)
  if(t.assert(result.truepositives=7;"evaluatelayer true positives correct")){pass=pass+1}el{fail=fail+1};

  (* 10. formatresult includes layer id *)
  let fmtstr=formatresult(result);
  if(t.assert(str.contains(fmtstr;"regex");"format result includes layer id")){pass=pass+1}el{fail=fail+1};

  <fail
};

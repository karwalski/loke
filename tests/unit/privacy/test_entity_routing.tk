m=test.privacy.entityrouting;

i=t:std.test;
i=str:std.str;

(* --- stub types and functions mirroring core.privacy.entityrouting --- *)

t=$entityroute{
  entitytype:str;
  preferredlayers:str;
  fallbacklayers:str
};

t=$routingconfig{
  routes:@$entityroute;
  count:i64
};

f=defaultrouting():$routingconfig{
  let routes=@(
    $entityroute{entitytype:"email";preferredlayers:"regex";fallbacklayers:"ner,presidio"};
    $entityroute{entitytype:"phone";preferredlayers:"regex";fallbacklayers:"presidio"};
    $entityroute{entitytype:"person";preferredlayers:"ner";fallbacklayers:"presidio"};
    $entityroute{entitytype:"creditcard";preferredlayers:"regex";fallbacklayers:"presidio"};
    $entityroute{entitytype:"address";preferredlayers:"presidio";fallbacklayers:"ner"}
  );
  <$routingconfig{routes:routes;count:5}
};

f=getroute(cfg:$routingconfig;entitytype:str):$entityroute{
  let result=mut.$entityroute{entitytype:entitytype;preferredlayers:"";fallbacklayers:""};
  lp(let i=0;i<cfg.count;i=i+1){
    let r=cfg.routes.get(i);
    if(str.eq(r.entitytype;entitytype)){result=r}el{}
  };
  <result
};

f=hasroute(cfg:$routingconfig;entitytype:str):bool{
  let found=mut.false;
  lp(let i=0;i<cfg.count;i=i+1){
    let r=cfg.routes.get(i);
    if(str.eq(r.entitytype;entitytype)){found=true}el{}
  };
  <found
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let cfg=defaultrouting();

  (* 1. default routing has 5 entries *)
  if(t.assert(cfg.count=5;"default routing has 5 routes")){pass=pass+1}el{fail=fail+1};

  (* 2. email route exists *)
  if(t.assert(hasroute(cfg;"email");"email route exists")){pass=pass+1}el{fail=fail+1};

  (* 3. phone route exists *)
  if(t.assert(hasroute(cfg;"phone");"phone route exists")){pass=pass+1}el{fail=fail+1};

  (* 4. person route exists *)
  if(t.assert(hasroute(cfg;"person");"person route exists")){pass=pass+1}el{fail=fail+1};

  (* 5. unknown entity type has no route *)
  if(t.assert(!hasroute(cfg;"unknown");"unknown entity has no route")){pass=pass+1}el{fail=fail+1};

  (* 6. email preferred layer is regex *)
  let emailroute=getroute(cfg;"email");
  if(t.asserteq(emailroute.preferredlayers;"regex";"email prefers regex layer")){pass=pass+1}el{fail=fail+1};

  (* 7. email fallback includes ner *)
  if(t.assert(str.contains(emailroute.fallbacklayers;"ner");"email fallback includes ner")){pass=pass+1}el{fail=fail+1};

  (* 8. person preferred layer is ner *)
  let personroute=getroute(cfg;"person");
  if(t.asserteq(personroute.preferredlayers;"ner";"person prefers ner layer")){pass=pass+1}el{fail=fail+1};

  (* 9. address preferred layer is presidio *)
  let addressroute=getroute(cfg;"address");
  if(t.asserteq(addressroute.preferredlayers;"presidio";"address prefers presidio layer")){pass=pass+1}el{fail=fail+1};

  (* 10. unknown route returns empty preferred *)
  let unknownroute=getroute(cfg;"unknown");
  if(t.asserteq(unknownroute.preferredlayers;"";"unknown route has empty preferred layers")){pass=pass+1}el{fail=fail+1};

  <fail
};

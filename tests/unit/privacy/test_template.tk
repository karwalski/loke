m=test.privacy.template;

i=t:std.test;
i=str:std.str;

(* --- stub template engine --- *)

f=applytemplate(template:str;field:str;value:str):str{
  let marker=str.concat("{{";str.concat(field;"}}"));
  <str.replace(template;marker;value)
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. template with no substitutions returns base string *)
  let base="Hello world";
  let result=applytemplate(base;"name";"Alice");
  if(t.assert(str.eq(result;"Hello world");"no placeholder returns base string")){pass=pass+1}el{fail=fail+1};

  (* 2. template with one field substituted *)
  let t1="Hello {{name}}!";
  let r1=applytemplate(t1;"name";"Bob");
  if(t.assert(str.eq(r1;"Hello Bob!");"single field substituted")){pass=pass+1}el{fail=fail+1};

  (* 3. template with multiple occurrences of same field *)
  let t2="{{x}} and {{x}}";
  let r2=applytemplate(t2;"x";"42");
  if(t.assert(str.eq(r2;"42 and 42");"multiple same field substituted")){pass=pass+1}el{fail=fail+1};

  (* 4. template with multiple different fields substituted sequentially *)
  let t3="{{greeting}} {{target}}";
  let r3=applytemplate(t3;"greeting";"Hi");
  let r3=applytemplate(r3;"target";"World");
  if(t.assert(str.eq(r3;"Hi World");"two different fields substituted")){pass=pass+1}el{fail=fail+1};

  (* 5. missing field key leaves placeholder intact *)
  let t4="Value is {{missing}}";
  let r4=applytemplate(t4;"other";"nope");
  if(t.assert(str.contains(r4;"{{missing}}");"missing key leaves placeholder intact")){pass=pass+1}el{fail=fail+1};

  (* 6. empty template returns empty string *)
  let r5=applytemplate("";"key";"val");
  if(t.assert(str.eq(r5;"");"empty template returns empty string")){pass=pass+1}el{fail=fail+1};

  (* 7. field value containing special chars preserved *)
  let t6="Data: {{val}}";
  let r6=applytemplate(t6;"val";"<script>alert(1)</script>");
  if(t.assert(str.contains(r6;"<script>");"special chars preserved in value")){pass=pass+1}el{fail=fail+1};

  (* 8. empty field value replaces placeholder with nothing *)
  let t7="A{{sep}}B";
  let r7=applytemplate(t7;"sep";"");
  if(t.assert(str.eq(r7;"AB");"empty value removes placeholder")){pass=pass+1}el{fail=fail+1};

  (* 9. field name with numbers *)
  let t8="Row {{idx1}} of {{total2}}";
  let r8=applytemplate(t8;"idx1";"5");
  let r8=applytemplate(r8;"total2";"100");
  if(t.assert(str.eq(r8;"Row 5 of 100");"field names with numbers work")){pass=pass+1}el{fail=fail+1};

  (* 10. value containing braces *)
  let t9="Result: {{out}}";
  let r9=applytemplate(t9;"out";"{{nested}}");
  if(t.assert(str.contains(r9;"{{nested}}");"value with braces preserved")){pass=pass+1}el{fail=fail+1};

  (* 11. long template with substitution *)
  let chunk="aaaaaaaaaa";
  let big=str.concat(chunk;str.concat(chunk;str.concat(chunk;str.concat(chunk;str.concat(chunk;"{{end}}")))));
  let r10=applytemplate(big;"end";"DONE");
  if(t.assert(str.contains(r10;"DONE");"substitution works in long template")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(r10;"{{end}}");"placeholder removed in long template")){pass=pass+1}el{fail=fail+1};

  <fail
};




m=tests.unit.privacy.testpipeline;

i=pipeline:core.privacy.pipeline;
i=regex:core.privacy.regex;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }else{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=assertequ32(name:str;got:u32;want:u32):$result{
  if(got=want){
    <pass(name)
  }else{
    <fail(name;str.concat("want=";str.concat(str.fromu32(want);str.concat(" got=";str.fromu32(got)))))
  };
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }else{ <fail(name;"expected true") };
};

f=assertfalse(name:str;val:bool):$result{
  if(!$val){ <pass(name) }else{ <fail(name;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};


f=offlineconfig():$pipelineconfig{
  let cfg=pipeline.newconfig("";"");
  <$pipelineconfig{
    presidiourl:"";
    ollamaurl:"";
    nermodelid:"";
    usepresidio:false;
    usener:false;
    dryrun:false
  };
};

f=runall():bool{
  let results=@$result@();
  let cfg=offlineconfig();

  
  let emailinput="Contact alice@example.com for details";
  let emailrun=pipeline.run(emailinput;"";cfg);
  results=str.arraypush(results;assertfalse("email not in anonymised output";str.contains(emailrun.result.anonymised;"alice@example.com")));

  
  results=str.arraypush(results;asserttrue("email pipeline sensitivity confidential";emailrun.result.sensitivity=$confidential));

  
  let cleaninput="The weather is nice today";
  let cleanrun=pipeline.run(cleaninput;"";cfg);
  results=str.arraypush(results;asserteq("clean text output unchanged";cleanrun.result.anonymised;cleaninput));

  
  let ccinput="Card number 4111111111111111 on file";
  let ccrun=pipeline.run(ccinput;"";cfg);
  results=str.arraypush(results;asserttrue("credit card pipeline sensitivity restricted";ccrun.result.sensitivity=$restricted));

  
  let countinput="Contact bob@example.com for info";
  let countrun=pipeline.run(countinput;"";cfg);
  let actualentitycount=str.arraylen(countrun.result.entities);
  results=str.arraypush(results;assertequ32("entity_count matches entities array";countrun.totalentities;actualentitycount));

  
  results=str.arraypush(results;asserteq("original field equals input";countrun.result.original;countinput));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let allpassed=false }else{};
      i=i+1;
    };
  };
  <allpassed
};

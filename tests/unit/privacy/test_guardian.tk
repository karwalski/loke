


m=tests.unit.privacy.testguardian;

i=guardian:core.privacy.guardian;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;val:bool):$result{
  if(!$val){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertnonempty(name:str;val:str):$result{
  if(str.len(val)>0){ <pass(name) }el{ <fail(name;"expected non-empty string") };
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let built=guardian.buildsystemprompt("");
  results=str.arraypush(results;assertnonempty("build_system_prompt non-empty";built));

  
  results=str.arraypush(results;asserttrue("is_guardian_present on built prompt";guardian.isguardianpresent(built)));

  
  results=str.arraypush(results;assertfalse("is_guardian_present empty string false";guardian.isguardianpresent("")));

  
  results=str.arraypush(results;assertfalse("is_guardian_present unrelated prompt false";guardian.isguardianpresent("You are a helpful assistant")));

  
  let custombuilt=guardian.buildsystemprompt("You are a doctor");
  results=str.arraypush(results;asserttrue("custom prompt included in built prompt";str.contains(custombuilt;"doctor")));

  
  results=str.arraypush(results;asserttrue("built prompt contains loke keyword";str.contains(built;"loke")));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let allpassed=false }el{};
      i=i+1;
    };
  };
  <allpassed
};

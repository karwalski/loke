m=test.privacy.consensus;

i=t:std.test;
i=str:std.str;

(* --- stub types and functions mirroring core.privacy.consensus --- *)

t=$layerdetection{
  entitytype:str;
  value:str;
  start:i64;
  end:i64;
  confidence:f64;
  layerid:str
};

t=$resolvedentity{
  entitytype:str;
  value:str;
  start:i64;
  end:i64;
  finalconfidence:f64;
  detectinglayers:str;
  action:str
};

f=resolveoverlaps(detections:@$layerdetection;strategy:str):@$resolvedentity{
  let results=mut.@();
  lp(let i=0;i<detections.len;i=i+1){
    let d=detections.get(i);
    let resolved=$resolvedentity{
      entitytype:d.entitytype;
      value:d.value;
      start:d.start;
      end:d.end;
      finalconfidence:d.confidence;
      detectinglayers:d.layerid;
      action:"mask"
    };
    results=@(results;resolved)
  };
  <results
};

f=strategyname(strategy:str):str{
  if(str.eq(strategy;"most-restrictive")){<"Most Restrictive (union of all detections)"}el{};
  if(str.eq(strategy;"first-match")){<"First Match (highest priority layer wins)"}el{};
  if(str.eq(strategy;"unanimous")){<"Unanimous (all layers must agree)"}el{};
  if(str.eq(strategy;"majority")){<"Majority (>50% of layers agree)"}el{};
  <"Unknown strategy"
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. most-restrictive strategy name *)
  if(t.assert(str.contains(strategyname("most-restrictive");"Most Restrictive");"most-restrictive strategy name correct")){pass=pass+1}el{fail=fail+1};

  (* 2. first-match strategy name *)
  if(t.assert(str.contains(strategyname("first-match");"First Match");"first-match strategy name correct")){pass=pass+1}el{fail=fail+1};

  (* 3. unanimous strategy name *)
  if(t.assert(str.contains(strategyname("unanimous");"Unanimous");"unanimous strategy name correct")){pass=pass+1}el{fail=fail+1};

  (* 4. majority strategy name *)
  if(t.assert(str.contains(strategyname("majority");"Majority");"majority strategy name correct")){pass=pass+1}el{fail=fail+1};

  (* 5. unknown strategy falls through *)
  if(t.asserteq(strategyname("bogus");"Unknown strategy";"unknown strategy returns fallback")){pass=pass+1}el{fail=fail+1};

  (* 6. resolveoverlaps preserves detection count *)
  let d1=$layerdetection{entitytype:"email";value:"a@b.com";start:0;end:7;confidence:0.95;layerid:"regex"};
  let d2=$layerdetection{entitytype:"phone";value:"0412345678";start:10;end:20;confidence:0.90;layerid:"ner"};
  let detections=@(d1;d2);
  let resolved=resolveoverlaps(detections;"most-restrictive");
  if(t.assert(resolved.len=2;"resolveoverlaps preserves two detections")){pass=pass+1}el{fail=fail+1};

  (* 7. resolved entity preserves entitytype *)
  let first=resolved.get(0);
  if(t.asserteq(first.entitytype;"email";"resolved entity type preserved")){pass=pass+1}el{fail=fail+1};

  (* 8. resolved entity action is mask *)
  if(t.asserteq(first.action;"mask";"resolved entity action is mask")){pass=pass+1}el{fail=fail+1};

  (* 9. resolveoverlaps with empty list *)
  let empty=resolveoverlaps(@();"most-restrictive");
  if(t.assert(empty.len=0;"empty detections returns empty resolved")){pass=pass+1}el{fail=fail+1};

  (* 10. resolved entity confidence preserved *)
  if(t.assert(first.finalconfidence>0.9;"confidence preserved through resolution")){pass=pass+1}el{fail=fail+1};

  <fail
};




m=tests.unit.privacy.testpatterns;

i=pat:core.privacy.patterns;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;val:bool):$result{
  if(!$val){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertnonempty(name:str;val:str):$result{
  if(str.len(val)>0){ <pass(name) }el{ <fail(name;"expected non-empty string") };
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result)@();

  
  results=str.arraypush(results;assertnonempty("pat_email non-empty";pat.patemail));

  
  results=str.arraypush(results;assertnonempty("pat_phone_au non-empty";pat.patphoneau));

  
  results=str.arraypush(results;assertnonempty("pat_credit_card non-empty";pat.patcreditcard));

  
  results=str.arraypush(results;assertnonempty("pat_au_tfn non-empty";pat.patautfn));

  
  results=str.arraypush(results;assertnonempty("pat_au_abn non-empty";pat.patauabn));

  
  results=str.arraypush(results;assertnonempty("pat_api_key non-empty";pat.patapikey));

  
  results=str.arraypush(results;asserttrue("pat_email contains @";str.contains(pat.patemail;"@")));

  
  results=str.arraypush(results;assertfalse("pat_au_tfn != pat_au_abn";str.eq(pat.patautfn;pat.patauabn)));

  
  results=str.arraypush(results;assertfalse("pat_email != pat_credit_card";str.eq(pat.patemail;pat.patcreditcard)));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let allpassed=false }el{};
      i=i+1;
    };
  };
  <allpassed
};

m=test.privacy.patterns;

i=t:std.test;
i=str:std.str;
i=pat:core.privacy.patterns;

(* Each pattern gets a positive and a negative case, against the real module.

   This test exists because eight of the ten patterns matched nothing, or crashed, for
   months: they used \d, \s and (?: ... ), which toke's regex engine ignores or dies
   on rather than rejecting. Nothing failed, because nothing tested a pattern against
   a string. A detector with no positive test is an assertion, not a control. *)

f=hits(pattern:str;text:str):i64{
  <str.findall(text;pattern).len as i64
};

f=matches(pattern:str;text:str;label:str):bool{
  <t.assert(hits(pattern;text)>0;label)
};

f=rejects(pattern:str;text:str;label:str):bool{
  <t.assert(hits(pattern;text)==0;label)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(matches(pat.patemail();"write to alice@example.com today";"email: plain")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patemail();"a.b+tag@sub.example.co.uk";"email: dots, plus, subdomain")){pass=pass+1}el{fail=fail+1};
  if(rejects(pat.patemail();"not an email: alice at example";"email: rejects prose")){pass=pass+1}el{fail=fail+1};

  (* The spaced forms are the point: 04\d{8} matched none of them. *)
  if(matches(pat.patphoneau();"call 0412345678 now";"phone AU: unspaced mobile")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patphoneau();"call 0412 345 678 now";"phone AU: spaced mobile")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patphoneau();"call 0412-345-678 now";"phone AU: hyphenated mobile")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patphoneau();"call +61 412 345 678 now";"phone AU: international mobile")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patphoneau();"call 02 9876 5432 now";"phone AU: spaced landline")){pass=pass+1}el{fail=fail+1};
  if(rejects(pat.patphoneau();"order 12 of 34";"phone AU: rejects short digit runs")){pass=pass+1}el{fail=fail+1};

  if(matches(pat.patphoneus();"call 415 555 2671 now";"phone US: spaced")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patphoneus();"call (415) 555-2671 now";"phone US: parenthesised area code")){pass=pass+1}el{fail=fail+1};

  if(matches(pat.patcreditcard();"card 4111111111111111 exp";"credit card: Visa unspaced")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patcreditcard();"card 4111 1111 1111 1111 exp";"credit card: Visa spaced")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patcreditcard();"card 5500 0000 0000 0004 exp";"credit card: Mastercard")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patcreditcard();"card 3782 822463 10005 exp";"credit card: Amex")){pass=pass+1}el{fail=fail+1};
  if(rejects(pat.patcreditcard();"invoice 1234 for 99 items";"credit card: rejects short numbers")){pass=pass+1}el{fail=fail+1};

  if(matches(pat.patipv4();"host 192.168.1.1 is up";"ipv4: dotted quad")){pass=pass+1}el{fail=fail+1};
  if(rejects(pat.patipv4();"version 1.2 released";"ipv4: rejects a two-part version")){pass=pass+1}el{fail=fail+1};

  if(matches(pat.patautfn();"tfn 123 456 789 on file";"AU TFN: spaced nine digits")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patauabn();"abn 51 824 753 556 registered";"AU ABN: spaced eleven digits")){pass=pass+1}el{fail=fail+1};

  if(matches(pat.patssnus();"ssn 123-45-6789 on file";"US SSN: hyphenated")){pass=pass+1}el{fail=fail+1};
  if(rejects(pat.patssnus();"ref 12-3-456 here";"US SSN: rejects the wrong grouping")){pass=pass+1}el{fail=fail+1};

  if(matches(pat.paturl();"see https://example.com/a?b=c now";"url: https with a query")){pass=pass+1}el{fail=fail+1};
  if(rejects(pat.paturl();"see the docs folder";"url: rejects prose")){pass=pass+1}el{fail=fail+1};

  (* Prefix-anchored on purpose: an unanchored long-alphanumeric rule fires on most
     base64 and most hashes, and a detector that fires on everything is not one. *)
  if(matches(pat.patapikey();"key sk-abcdefghijklmnopqrst here";"api key: OpenAI style")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patapikey();"key AKIAIOSFODNN7EXAMPLE here";"api key: AWS access key id")){pass=pass+1}el{fail=fail+1};
  if(matches(pat.patapikey();"key ghp_abcdefghijklmnopqrstuvwxyz0123456789 here";"api key: GitHub PAT")){pass=pass+1}el{fail=fail+1};
  if(rejects(pat.patapikey();"the commit is abcdef1234567890 today";"api key: rejects a bare hex run")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.templaterender;

i=t:std.test;
i=str:std.str;
i=tpl:core.privacy.template;

(* LS1.1w — core.privacy.template.renderuser, against the REAL module.

   renderuser read its parameter keys with json.keys and their values with an unmatched
   json.str; json.keys is one of std.json's untyped ABI helpers. Measured on toke 3.1.0 before
   the fix, from this module:

     renderuser("n={{n}}";"{\"n\":3}")               -> ""   the WHOLE result, silently
     renderuser("Hi {{name}}";"{not json")             -> SIGSEGV
     renderuser(any;"{}") and renderuser(any;"")       -> SIGSEGV (test_template.tk's finding)

   It is a separate file from test_template.tk because the old code crashes, and a crash
   would take that file's other assertions with it. Each case below fails, or crashes, on the
   old function. *)

f=main():i64{
  let fails=mut.0;
  let a=t.asserteq(tpl.renderuser("n={{n}}";"{\"n\":3}");"n=3";
    "a number parameter is substituted as its JSON text, and does not empty the result");
  if(a){}el{fails=fails+1};
  let b=t.asserteq(tpl.renderuser("{{who}} is {{age}}, ok={{ok}}";"{\"who\":\"Ann\",\"age\":41,\"ok\":true}");"Ann is 41, ok=true";
    "strings, numbers and booleans in one object are all substituted");
  if(b){}el{fails=fails+1};
  let c=t.asserteq(tpl.renderuser("say {{q}}";"{\"q\":\"a \\\"quoted\\\" word\"}");"say a \"quoted\" word";
    "a string parameter is decoded, so an escaped quote arrives as a quote");
  if(c){}el{fails=fails+1};
  let d=t.asserteq(tpl.renderuser("Hi {{name}}";"{not json");"Hi {{name}}";
    "parameters that are not JSON leave the template as it was");
  if(d){}el{fails=fails+1};
  let e1=t.asserteq(tpl.renderuser("Hi {{name}}";"{}");"Hi {{name}}";
    "an empty parameter object leaves the template as it was");
  if(e1){}el{fails=fails+1};
  let f1=t.asserteq(tpl.renderuser("Hi {{name}}";"");"Hi {{name}}";
    "no parameters at all leave the template as it was");
  if(f1){}el{fails=fails+1};
  <fails
};

m=test.privacy.layerhealth;

i=t:std.test;
i=str:std.str;

(* --- stub types and functions mirroring core.privacy.layerhealth --- *)

t=$layerstatus{
  id:str;
  available:bool;
  reason:str;
  lastchecked:i64;
  detectioncount:i64
};

t=$healthreport{
  layers:@$layerstatus;
  totallayers:i64;
  availablelayers:i64;
  degraded:bool
};

f=checkhealth(layerids:@str):$healthreport{
  let statuses=mut.@();
  let available=mut.0;
  let total=layerids.len;
  lp(let i=0;i<total;i=i+1){
    let id=layerids.get(i);
    let isavail=mut.true;
    let reason=mut."operational";
    if(str.eq(id;"presidio")){isavail=false; reason="not installed"}el{};
    let status=$layerstatus{id:id;available:isavail;reason:reason;lastchecked:0;detectioncount:0};
    statuses=@(statuses;status);
    if(isavail){available=available+1}el{}
  };
  <$healthreport{
    layers:statuses;
    totallayers:total;
    availablelayers:available;
    degraded:available<total
  }
};

f=issystemhealthy(report:$healthreport):bool{
  <report.availablelayers>0
};

f=formathealthstatus(report:$healthreport):str{
  let avail=str.fromint(report.availablelayers);
  let total=str.fromint(report.totallayers);
  if(report.degraded){
    <str.concat("DEGRADED: ";str.concat(avail;str.concat("/";str.concat(total;" layers available"))))
  }el{
    <str.concat("HEALTHY: all ";str.concat(total;" layers available"))
  }
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. all available layers -- not degraded *)
  let healthyreport=checkhealth(@("regex";"ner"));
  if(t.assert(!healthyreport.degraded;"two healthy layers not degraded")){pass=pass+1}el{fail=fail+1};

  (* 2. system is healthy when layers available *)
  if(t.assert(issystemhealthy(healthyreport);"system healthy with available layers")){pass=pass+1}el{fail=fail+1};

  (* 3. presidio triggers degraded mode *)
  let degradedreport=checkhealth(@("regex";"presidio"));
  if(t.assert(degradedreport.degraded;"presidio unavailable causes degraded mode")){pass=pass+1}el{fail=fail+1};

  (* 4. available count correct in degraded mode *)
  if(t.assert(degradedreport.availablelayers=1;"one layer available in degraded mode")){pass=pass+1}el{fail=fail+1};

  (* 5. total layers count correct *)
  if(t.assert(degradedreport.totallayers=2;"total layers is 2")){pass=pass+1}el{fail=fail+1};

  (* 6. degraded system still healthy if at least one layer *)
  if(t.assert(issystemhealthy(degradedreport);"degraded system still healthy")){pass=pass+1}el{fail=fail+1};

  (* 7. healthy format contains HEALTHY *)
  let healthystr=formathealthstatus(healthyreport);
  if(t.assert(str.contains(healthystr;"HEALTHY");"healthy format starts with HEALTHY")){pass=pass+1}el{fail=fail+1};

  (* 8. degraded format contains DEGRADED *)
  let degradedstr=formathealthstatus(degradedreport);
  if(t.assert(str.contains(degradedstr;"DEGRADED");"degraded format starts with DEGRADED")){pass=pass+1}el{fail=fail+1};

  (* 9. degraded format shows layer counts *)
  if(t.assert(str.contains(degradedstr;"1/2");"degraded format shows 1/2 layers")){pass=pass+1}el{fail=fail+1};

  (* 10. single layer all healthy *)
  let singlereport=checkhealth(@("regex"));
  if(t.assert(!singlereport.degraded;"single healthy layer not degraded")){pass=pass+1}el{fail=fail+1};

  <fail
};

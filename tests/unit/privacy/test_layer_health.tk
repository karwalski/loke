m=test.privacy.layerhealth;

i=t:std.test;
i=str:std.str;
i=fr:core.privacy.filterregistry;
i=lh:core.privacy.layerhealth;
i=reach:shared.reachability;

(* X7.2 — this file used to declare its own $layerstatus and $healthreport and assert
   against them. It then imported core.privacy.layerhealth and RECORDED two findings:

   FINDING 1 — checkhealth probed nothing: "presidio" was hardcoded unavailable and every
   other id hardcoded available, whatever was running.
   FINDING 2 — an empty layer list reported "HEALTHY: all 0 layers available" while
   issystemhealthy said it was not healthy.

   F3b.6 fixed both, and these assertions were rewritten as the old header said they should
   be. checkhealth now takes the filter registry and probes each enabled entry with that
   layer's own client (the same probe core.privacy.pipeline.run consults a layer through);
   an empty or all-down registry is UNHEALTHY in every reader. The sidecars here point at
   unprivileged ports nothing listens on, so no assertion waits on a network timeout; the
   answering case is in test_layer_registry_pipeline.tk, against a recorder. *)

f=deadurl():str{
  <reach.deadurl()
};

f=statusfor(report:$healthreport;id:str):$layerstatus{
  let idx=mut.0;
  lp(let i=0;i<report.layers.len;i=i+1){
    let s:$layerstatus=report.layers.get(i);
    if(str.eq(s.id;id)){
      idx=i
    }el{}
  };
  <report.layers.get(idx)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* Regex, NER and Presidio enabled with nothing listening; the privacy filter disabled. *)
  let reg=fr.layers(deadurl();deadurl());
  let three=lh.checkhealth(reg);
  if(t.assert(three.layers.len==4;"the report carries a status for every registry entry, disabled ones included")){pass=pass+1}el{fail=fail+1};
  if(t.assert(three.totallayers==3;"and counts the three ENABLED layers")){pass=pass+1}el{fail=fail+1};
  if(t.assert(three.availablelayers==1;"of which only the in-process regex layer is available")){pass=pass+1}el{fail=fail+1};
  if(t.assert(three.degraded;"so the report is degraded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lh.issystemhealthy(three);"and the system is still usable, because a degraded pipeline is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lh.overall(three);"degraded";"overall reads degraded")){pass=pass+1}el{fail=fail+1};

  (* FINDING 1, fixed: each status is the layer's own probe. *)
  if(t.asserteq(statusfor(three;"regex").state;"healthy";"regex is healthy: it is in-process")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!statusfor(three;"ner").available;"NER with no Ollama listening is UNAVAILABLE — probed, not assumed")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(statusfor(three;"ner").reason;"Ollama unreachable";"with the reason the pipeline records")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(statusfor(three;"presidio").state;"unavailable";"Presidio with nothing listening is unavailable")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(statusfor(three;"openai-privacy-filter").state;"disabled";"a disabled entry is reported disabled, not unavailable")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!statusfor(three;"openai-privacy-filter").available;"and is not counted available")){pass=pass+1}el{fail=fail+1};

  let unknown=lh.checkhealth(fr.register(fr.newregistry();$privacyfilter{id:"a-layer-that-does-not-exist";name:"";kind:"";entitytypes:"";confidence:0.0;enabled:true;url:"";param:"";priority:0;mode:"detect-and-mask";threshold:0.0;entityfilter:""}));
  if(t.assert(unknown.availablelayers==0;"an id that names no detector is NOT available")){pass=pass+1}el{fail=fail+1};

  (* Degraded, and only enabled layers can be. *)
  if(t.assert(lh.isdegraded(statusfor(three;"ner"));"an enabled, unavailable layer is degraded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!lh.isdegraded(statusfor(three;"openai-privacy-filter"));"a disabled layer is not degraded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!lh.isdegraded(statusfor(three;"regex"));"nor is a healthy one")){pass=pass+1}el{fail=fail+1};

  (* consult sends nothing to a disabled layer and records why. *)
  let pfentry=fr.get(reg;fr.privacyfilterid());
  let skipped=lh.consult(pfentry;"Jane Citizen");
  if(t.asserteq(skipped.status.state;"disabled";"consulting a disabled layer leaves it disabled")){pass=pass+1}el{fail=fail+1};
  if(t.assert(skipped.hits.len==0;"with no hits")){pass=pass+1}el{fail=fail+1};
  let rx=lh.consult(fr.get(reg;fr.regexid());"mail alice@example.com");
  if(t.assert(lh.iscompleted(rx.status) && rx.hits.len>0;"consulting regex completes and finds the address")){pass=pass+1}el{fail=fail+1};
  if(t.assert(rx.status.detectioncount==rx.hits.len as i64;"and its status counts what it found")){pass=pass+1}el{fail=fail+1};

  (* The healthy case. *)
  let onlyregex=fr.setenabled(fr.setenabled(reg;fr.nerid();false);fr.presidioid();false);
  let healthy=lh.checkhealth(onlyregex);
  if(t.assert(!healthy.degraded;"a report with every enabled layer available is not degraded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lh.formathealthstatus(healthy);"HEALTHY");"and formats as HEALTHY")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lh.formathealthstatus(three);"DEGRADED");"while a degraded one says DEGRADED")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lh.formathealthstatus(three);"1/3");"and states the ratio")){pass=pass+1}el{fail=fail+1};

  (* Nothing available. *)
  let nolayers=lh.checkhealth(fr.setenabled(reg;fr.regexid();false));
  if(t.assert(nolayers.availablelayers==0;"with regex off and the sidecars down, no layer is available")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!lh.issystemhealthy(nolayers);"and the system is UNHEALTHY — nothing would scan the text")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(lh.formathealthstatus(nolayers);"UNHEALTHY");"and says so")){pass=pass+1}el{fail=fail+1};

  (* FINDING 2, fixed: an empty registry. Every reader agrees it is not healthy. *)
  let empty=lh.checkhealth(fr.newregistry());
  if(t.assert(empty.totallayers==0;"an empty registry gives a report of no layers")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!lh.issystemhealthy(empty);"issystemhealthy says that is NOT healthy")){pass=pass+1}el{fail=fail+1};
  if(t.assert(empty.degraded;"degraded is true for it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(lh.formathealthstatus(empty);"HEALTHY: all");"and the human-readable summary no longer calls it healthy")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lh.overall(empty);"unhealthy";"overall reads unhealthy")){pass=pass+1}el{fail=fail+1};

  <fail
};

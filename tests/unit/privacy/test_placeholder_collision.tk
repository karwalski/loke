m=test.privacy.placeholdercollision;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=pl:core.privacy.pipeline;
i=ph:core.privacy.placeholder;

(* PL1.1 — placeholder collision. A P0 privacy defect, asserted rather than argued.

   WHICH ASSERTIONS WERE RED BEFORE THE FIX. Measured, not assumed: assertions 1, 2 and
   3 below all failed, run against the pre-fix modules. The pre-fix output was

     anonymised: "[PERSON_NER_1] reviewed it and [PERSON_NER_1] approved it."
     restored:   "Alice Smith reviewed it and Alice Smith approved it."

   Bob Jones was erased from the response and his action attributed to a different
   named individual — fluent, confident, wrong about a real person, produced by the
   component whose purpose is protecting that person, and undetectable to anything
   downstream. Assertion 3, the round-trip, is the load-bearing one: an empty map and a
   colliding map both fail it, and no amount of plausible-looking anonymised text can
   satisfy it by accident.

   Three uncoordinated generators produced that. core.privacy.ner.makenerplaceholder and
   core.privacy.nerlocal.labeltoplaceholder each hardcoded the index — literally
   `_NER_1]` — while core.privacy.regex and core.privacy.presidio each counted from
   their own list length and pipeline.run then concatenated all four lists.
   pipeline.dedupentities dedupes by value and by overlapping span, never by placeholder,
   so nothing caught it; placeholder.restore replaces sequentially, so the FIRST map
   entry consumed every occurrence.

   THESE ARE THE REAL MODULES. Nothing below re-declares its subject. 67 test files in
   this repository define a local copy of the function they are named after and therefore
   cannot fail, whatever the shipped code does — tests/unit/privacy/test_placeholder.tk
   is one of them, with its own makeplaceholder at line 34. A collision test that did
   that would be worse than no test, because it would report green over the defect.

   WHY THE ENTITIES ARE HAND-BUILT. PERSON is detected by Presidio and by the NER
   layers, both of which are network sidecars that a unit test cannot stand up; the
   in-process regex layer has no PERSON pattern (see privacy/patterns.tk). So the entity
   list is constructed in the shape a NER layer hands to the pipeline — placeholder
   empty, which is what those layers now emit — and put through the real
   placeholder.assignplaceholders, pipeline.anonymisetext and placeholder.restore. The
   request id is fixed rather than random so the salt is deterministic. *)

f=person(value:str;start:u32;end:u32):$piientity{
  <$piientity{
    entitytype:"PERSON";
    value:value;
    start:start;
    end:end;
    (* 0.78 is what both NER layers assign to PERSON. It stays inside this module:
       T-20 corrupts an f64 returned across a module boundary, and nothing here reads
       .confidence back. *)
    confidence:0.78;
    placeholder:""
  }
};

(* The request id the pipeline would generate is str.randhex(16). A fixed one keeps the
   salt deterministic without weakening what is under test: assignplaceholders cannot
   tell this from a real one. *)
f=fixedrequestid():str{
  <"a3f19c4e7b20d851"
};

(* Numbering has to hold past a single digit, which is where a length-descending sort
   would matter if the format needed one. `[PERSON_a3f1_1]` is not a prefix of
   `[PERSON_a3f1_10]` — the closing bracket intervenes — so it does not. *)
f=manypeople():@$piientity{
  let names=@(
    "Ann Adams";"Ben Boyd";"Cara Cole";"Dan Dunn";
    "Eve Ellis";"Finn Ford";"Gail Gray";"Hugo Hart";
    "Iris Ives";"Jack Judd";"Kara Knox";"Liam Lowe"
  );
  let out=mut.@();
  lp(let i=0;i<names.len;i=i+1){
    out=out.push(person(str.arrayget(names;i);0 as u32;0 as u32))
  };
  <out
};

(* A detection layer reporting a person at a real offset with a stated confidence. The
   substring case needs both — the spans decide whether dedup keeps the pair, and the
   confidences decide which of an overlapping pair survives. *)
f=personat(value:str;start:u32;end:u32;conf:f64):$piientity{
  <$piientity{
    entitytype:"PERSON";
    value:value;
    start:start;
    end:end;
    confidence:conf;
    placeholder:""
  }
};

(* True when every entity's placeholder actually appears in the anonymised text.

   The invariant that catches a botched substitution. An entity counted as detected, put
   in the restore map, and whose placeholder is nowhere in the prompt means its value was
   not replaced — it was either left in the clear or eaten by another entity's
   replacement. Either way the entity count and the restore map are describing a prompt
   that does not exist.

   Only sound when each entity is a DISTINCT textual occurrence. Two entities covering
   the same span — "Bob" and "Bob Jones" both reported at offset 0 — cannot both have a
   placeholder in the text, because there is only one thing there to replace; the correct
   outcome is that the longer wins and the shorter's placeholder is absent. So the
   same-span case asserts the longer entity's placeholder directly instead, via
   placeholderforvalue below. *)
f=allplaceholderspresent(anonymised:str;entities:@$piientity):bool{
  let ok=mut.true;
  lp(let i=0;i<entities.len;i=i+1){
    let e:$piientity=entities.get(i);
    if(str.contains(anonymised;e.placeholder)){}el{
      ok=false
    }
  };
  <ok
};

(* The placeholder assigned to a given value, or "" when there is no such entity.
   Looked up by value rather than by list index so the assertion does not silently start
   testing a different entity if dedup's ordering changes. *)
f=placeholderforvalue(entities:@$piientity;value:str):str{
  let found=mut."";
  lp(let i=0;i<entities.len;i=i+1){
    let e:$piientity=entities.get(i);
    if(str.eq(e.value;value)){
      found=e.placeholder
    }el{}
  };
  <found
};

f=distinctcount(entities:@$piientity):i64{
  let n=mut.0;
  lp(let i=0;i<entities.len;i=i+1){
    let e:$piientity=entities.get(i);
    let seenbefore=mut.false;
    lp(let j=0;j<i;j=j+1){
      let prior:$piientity=entities.get(j);
      if(str.eq(prior.placeholder;e.placeholder)){
        seenbefore=true
      }el{}
    };
    if(seenbefore){}el{
      n=n+1
    }
  };
  <n
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let original="Alice Smith reviewed it and Bob Jones approved it.";
  let detected=@(
    person("Alice Smith";0 as u32;11 as u32);
    person("Bob Jones";28 as u32;37 as u32)
  );
  let deduped=pl.dedupentities(detected);
  let entities=ph.assignplaceholders(deduped;fixedrequestid());

  (* Both people survive dedup — distinct values, non-overlapping spans. If this fails
     the rest of the file is testing the wrong thing, so it is asserted first. *)
  if(t.assert(str.arraylen(entities)==2;"two distinct people survive dedup")){pass=pass+1}el{fail=fail+1};

  let a=entities.get(0);
  let b=entities.get(1);

  (* 1. RED BEFORE THE FIX. Both were "[PERSON_NER_1]". *)
  if(t.assert(!str.eq(a.placeholder;b.placeholder);"two distinct PERSON values get two distinct placeholders")){pass=pass+1}el{fail=fail+1};

  let anonymised=pl.anonymisetext(original;entities);

  (* 2. RED BEFORE THE FIX for Bob Jones: the single colliding placeholder replaced both
        names, so his did not appear in the anonymised text — but nor did the placeholder
        that was supposed to stand for him, which is why the leak was silent. Neither
        original may survive into what is forwarded. *)
  if(t.assert(!str.contains(anonymised;"Alice Smith");"the anonymised text does not contain the first name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(anonymised;"Bob Jones");"the anonymised text does not contain the second name")){pass=pass+1}el{fail=fail+1};

  (* 3. RED BEFORE THE FIX — the load-bearing assertion. Round-trip identity is what an
        empty map cannot satisfy (nothing is put back) and what a colliding map cannot
        satisfy (the wrong thing is put back). Byte-for-byte, against the original. *)
  let restored=ph.restore(anonymised;ph.mapfromentities(entities));
  if(t.assert(str.eq(restored;original);"restore of the anonymised text reproduces the original exactly")){pass=pass+1}el{fail=fail+1};

  (* And specifically not the pre-fix answer, which was fluent, plausible and wrong
     about a named individual. Spelled out because "not equal to the original" is a
     weaker claim than "does not attribute B's action to A". *)
  if(t.assert(!str.eq(restored;"Alice Smith reviewed it and Alice Smith approved it.");"the second person's action is not attributed to the first")){pass=pass+1}el{fail=fail+1};

  (* 4. Injection. A user who types a literal placeholder into their own prompt must get
        it back unchanged. Unsalted, `[PERSON_1]` would be forwarded verbatim, echoed
        back by the model, and then rewritten by restore into some OTHER person's real
        name. The salt is what makes a literal the user typed unable to collide with a
        placeholder this run issued. *)
  let injected="Reply in the form [PERSON_1] about Alice Smith please.";
  let injdetected=@(person("Alice Smith";33 as u32;44 as u32));
  let injentities=ph.assignplaceholders(pl.dedupentities(injdetected);fixedrequestid());
  let injanon=pl.anonymisetext(injected;injentities);
  if(t.assert(str.contains(injanon;"[PERSON_1]");"a literal placeholder the user typed is not consumed by anonymisation")){pass=pass+1}el{fail=fail+1};
  let injrestored=ph.restore(injanon;ph.mapfromentities(injentities));
  if(t.assert(str.eq(injrestored;injected);"text containing a literal placeholder round-trips unchanged")){pass=pass+1}el{fail=fail+1};

  (* 5. Twelve entities of one type, to hold the numbering past a single digit and to
        show the counter is per-type and monotonic rather than per-layer. *)
  let many=ph.assignplaceholders(pl.dedupentities(manypeople());fixedrequestid());
  if(t.assert(str.arraylen(many)==12;"all twelve distinct people are kept")){pass=pass+1}el{fail=fail+1};
  if(t.assert(distinctcount(many)==12;"twelve entities of one type get twelve distinct placeholders")){pass=pass+1}el{fail=fail+1};

  let manytext="Ann Adams, Ben Boyd, Cara Cole, Dan Dunn, Eve Ellis, Finn Ford, Gail Gray, Hugo Hart, Iris Ives, Jack Judd, Kara Knox and Liam Lowe met.";
  let manyanon=pl.anonymisetext(manytext;many);
  if(t.assert(!str.contains(manyanon;"Liam Lowe");"the twelfth name is anonymised too, not just the first nine")){pass=pass+1}el{fail=fail+1};
  let manyrestored=ph.restore(manyanon;ph.mapfromentities(many));
  if(t.assert(str.eq(manyrestored;manytext);"twelve entities of one type round-trip exactly")){pass=pass+1}el{fail=fail+1};

  (* 6. THE SUBSTRING HAZARD. One entity's value is a strict prefix of another's, which is
        routine rather than exotic: Presidio reports PERSON "Bob Jones" while a NER layer
        reports PERSON "Bob", and dedup keeps both because the longer one is the more
        confident of an overlapping pair. The shorter is listed FIRST here, which is the
        order that breaks — layer output is concatenated in layer order, not by length.

        Substituting in list order gives "[PERSON_2a4c_1] Jones signed." — the surname
        forwarded to the provider in the clear, and the placeholder for "Bob Jones"
        absent from the prompt while still counted and still in the restore map.

        Note which assertions this needs. "Neither original substring is present" passes
        even unordered, because "Bob Jones" is not in that text either. And the round trip
        is byte-identical even unordered, because restore is the exact inverse of the
        substitution that mangled it — so neither of those can detect this. The two that
        can are the leaked fragment and the missing placeholder, asserted directly. *)
  let prefixtext="Bob Jones signed.";
  let prefixdetected=@(
    personat("Bob";0 as u32;3 as u32;0.78);
    personat("Bob Jones";0 as u32;9 as u32;0.92)
  );
  let prefixents=ph.assignplaceholders(pl.dedupentities(prefixdetected);fixedrequestid());
  if(t.assert(str.arraylen(prefixents)==2;"a name and its prefix both survive dedup when the longer is the more confident")){pass=pass+1}el{fail=fail+1};
  let prefixanon=pl.anonymisetext(prefixtext;prefixents);

  (* RED BEFORE THE ORDERING FIX. The surname, forwarded in the clear. *)
  if(t.assert(!str.contains(prefixanon;"Jones");"substituting a name before its prefix does not leave the surname in the clear")){pass=pass+1}el{fail=fail+1};

  (* RED BEFORE THE ORDERING FIX. The longer entity's placeholder never reached the text:
     "Bob" was substituted first, and by the time "Bob Jones" was looked for there was no
     "Bob Jones" left to find. Both entities cover the same span, so only the longer can
     have a placeholder in the text — asserted on that one specifically, not over the
     whole list (see allplaceholderspresent). *)
  let longerph=placeholderforvalue(prefixents;"Bob Jones");
  if(t.assert(!str.eq(longerph;"");"the longer entity was assigned a placeholder at all")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(prefixanon;longerph);"the longer value's placeholder is the one that reaches the prompt")){pass=pass+1}el{fail=fail+1};

  if(t.assert(!str.contains(prefixanon;"Bob Jones");"the anonymised text does not contain the longer value")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(prefixanon;"Bob");"the anonymised text does not contain the shorter value")){pass=pass+1}el{fail=fail+1};
  let prefixrestored=ph.restore(prefixanon;ph.mapfromentities(prefixents));
  if(t.assert(str.eq(prefixrestored;prefixtext);"the prefix case round-trips byte-for-byte")){pass=pass+1}el{fail=fail+1};

  (* And with two separate mentions, where the leak is visible twice over and the two
     people would otherwise have shared one placeholder. *)
  let twotext="Bob Jones signed; Bob countersigned.";
  let twodetected=@(
    personat("Bob";18 as u32;21 as u32;0.78);
    personat("Bob Jones";0 as u32;9 as u32;0.92)
  );
  let twoents=ph.assignplaceholders(pl.dedupentities(twodetected);fixedrequestid());
  let twoanon=pl.anonymisetext(twotext;twoents);
  if(t.assert(!str.contains(twoanon;"Jones");"a separate later mention of the prefix does not strand the surname")){pass=pass+1}el{fail=fail+1};
  if(t.assert(allplaceholderspresent(twoanon;twoents);"both entities' placeholders appear when one value is a prefix of the other")){pass=pass+1}el{fail=fail+1};
  let tworestored=ph.restore(twoanon;ph.mapfromentities(twoents));
  if(t.assert(str.eq(tworestored;twotext);"two mentions, one a prefix of the other, round-trip byte-for-byte")){pass=pass+1}el{fail=fail+1};

  (* The ordering predicate itself, so a future change to it is diagnosed here rather
     than as a puzzling leak two assertions up. It must be a TOTAL order: longer first,
     and for equal lengths the earlier list position first, with no pair unordered. *)
  if(t.assert(ph.beforeinorder(9;5;3;0);"a longer value precedes a shorter one whatever their positions")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ph.beforeinorder(3;0;9;5);"and the reverse does not hold")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ph.beforeinorder(4;1;4;2);"equal lengths are ordered by list position")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ph.beforeinorder(4;2;4;1);"and that tiebreak is antisymmetric, so the order is total")){pass=pass+1}el{fail=fail+1};

  (* The salt is one salt per run. If it varied between entities, restore would match
     nothing and assertion 3 would fail — this says so directly, so a future change that
     salts per entity is diagnosed rather than merely red. *)
  if(t.assert(str.contains(a.placeholder;ph.saltforrequest(fixedrequestid()));"the placeholder carries the request salt")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(b.placeholder;ph.saltforrequest(fixedrequestid()));"and every entity in the run carries the same salt")){pass=pass+1}el{fail=fail+1};

  <fail
};

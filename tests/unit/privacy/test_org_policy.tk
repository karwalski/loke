m=test.privacy.orgpolicy;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=process:std.process;
i=sh:shared.types;
i=fr:core.privacy.filterregistry;
i=op:core.privacy.orgpolicy;

(* F3b.8 — core.privacy.orgpolicy reading loke.policy.json, and applying it to a registry.

   This file used to record four defects in the module (minimum_layers not parsed, enforced a
   substring search, max_confidence_threshold never read, required and banned layers never
   checked) while it had no importer. The module was rewritten for F3b.8 and the pipeline now
   applies it on every run, so the assertions below judge the rewritten module: what it reads,
   every malformed file it refuses (each must refuse, never fall back to no policy), and what
   `apply` does to a registry and consensus settings. What a policy does to a request is judged
   through the production pipeline in test_org_policy_pipeline.tk. *)

f=refuses(text:str;fault:str):bool{
  let p=op.fromtext(text);
  let want="organisation policy loke.policy.json cannot be applied: \(fault)";
  if(str.eq(p.error;want) && p.present){ <true }el{};
  let got=p.error;
  t.asserteq(got;want;"(detail)");
  <false
};

f=writefile(path:str;body:str):bool{
  let made=mt file.mkdir(sh.lokedir()) {$ok:v v;$err:e false};
  <mt file.write(path;body) {$ok:v v;$err:e false}
};

f=shell(args:@str):bool{
  let h=mt process.spawn(args) { $ok:h h; $err:e 0 };
  if(h==0){ <false }el{};
  process.wait(h);
  <true
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── Where the file is, and no file ───────────────────────────────────────── *)
  if(t.asserteq(op.policypath();sh.lokefile("loke.policy.json");"the policy is loke.policy.json in the user's loke directory")){pass=pass+1}el{fail=fail+1};
  let missing=op.load(op.policypath());
  if(t.assert(missing.loaded && !missing.present && str.len(missing.error)==0;"a missing file is no policy, and no error")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!op.applies(missing);"so it applies nothing")){pass=pass+1}el{fail=fail+1};
  let unread=op.notloaded();
  if(t.assert(!unread.loaded && op.resolved(unread).loaded && !op.resolved(unread).present;"a config that carries no policy reads the file at run time, and finds none")){pass=pass+1}el{fail=fail+1};

  (* ── The sample shipped with the privacy-filter package ───────────────────── *)
  let sample=op.load("packages/privacy-filter/sample-org-policy.json");
  if(t.asserteq(sample.error;"";"the shipped sample policy is accepted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sample.present && sample.enforced && sample.minimumlayers==2;"enforced, with minimum_layers 2 read as 2")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sample.requiredlayers.len==1 && str.eq(sample.requiredlayers.get(0);"openai-privacy-filter");"required_layers read as the one layer it names")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(sample.lockedconsensus;"most-restrictive") && sample.bannedlayers.len==0 && str.eq(sample.maxthreshold;"0.95");"locked_consensus, an empty banned_layers and max_confidence_threshold 0.95 read as written")){pass=pass+1}el{fail=fail+1};

  (* ── Values read, with and without spaces ─────────────────────────────────── *)
  let full=op.fromtext("{ \"minimum_layers\": 3, \"required_layers\": [\"ner\", \"presidio\"], \"banned_layers\": [\"openai-privacy-filter\"], \"max_confidence_threshold\": 0.8, \"enforced\": true, \"description\": \"x\" }");
  if(t.asserteq(full.error;"";"a full policy written with spaces is accepted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(full.minimumlayers==3;"minimum_layers 3 is read as 3, not as a constant")){pass=pass+1}el{fail=fail+1};
  if(t.assert(full.requiredlayers.len==2 && str.eq(full.requiredlayers.get(1);"presidio") && full.bannedlayers.len==1;"both layer lists are read in full")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(full.maxthreshold;"0.8";"max_confidence_threshold is read, not hardcoded")){pass=pass+1}el{fail=fail+1};
  let off=op.fromtext("{\"required_layers\":[\"presidio\"],\"enforced\":false}");
  if(t.assert(off.present && !off.enforced && !op.applies(off);"enforced: false is read as false, and the policy applies nothing")){pass=pass+1}el{fail=fail+1};
  let word=op.fromtext("{\"description\":\"enforced by the security team\",\"enforced\":false}");
  if(t.assert(!word.enforced;"the word enforced in a description does not turn enforcement on")){pass=pass+1}el{fail=fail+1};
  let empty=op.fromtext("{}");
  if(t.assert(empty.present && empty.enforced && op.applies(empty) && empty.minimumlayers==0;"an empty object is a policy that asks for nothing")){pass=pass+1}el{fail=fail+1};

  (* ── Malformed: every one refuses, naming the fault ───────────────────────── *)
  if(t.assert(refuses("";"it is not a JSON object");"an empty file refuses (it is not treated as no file)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("[\"presidio\"]";"it is not a JSON object");"an array refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"minimum_layers\":2,";"it is not valid JSON");"truncated JSON refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"required_layer\":[\"presidio\"]}";"required_layer is not a policy key");"a misspelt key refuses, rather than being ignored")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"minimum_layers\":1,\"minimum_layers\":3}";"minimum_layers is given twice");"a key given twice refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"minimum_layers\":\"2\"}";"minimum_layers must be a whole number from 0 to 4");"minimum_layers as a string refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"minimum_layers\":2.5}";"minimum_layers must be a whole number from 0 to 4");"a fractional minimum_layers refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"minimum_layers\":-1}";"minimum_layers must be a whole number from 0 to 4");"a negative minimum_layers refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"minimum_layers\":5}";"minimum_layers must be a whole number from 0 to 4");"a minimum_layers no registry can meet refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"required_layers\":\"presidio\"}";"required_layers must be an array of layer ids");"required_layers as a string refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"required_layers\":[\"presidio\",3]}";"required_layers must be an array of layer ids");"a required layer that is not a string refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"required_layers\":[\"spacy\"]}";"required_layers names spacy, which is not a layer loke has (regex, ner, presidio, openai-privacy-filter)");"an unknown required layer refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"banned_layers\":[\"ner\",\"ner\"]}";"banned_layers names ner twice");"a layer named twice refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"banned_layers\":[\"regex\"]}";"banned_layers cannot name regex: the regex layer always runs");"banning the regex layer refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"required_layers\":[\"ner\"],\"banned_layers\":[\"ner\"]}";"ner is both required and banned");"a layer both required and banned refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"locked_consensus\":\"unanimous\"}";"locked_consensus can only be most-restrictive: a policy can only make masking stricter, and no other strategy masks at least what every other does");"locking a strategy weaker than most-restrictive refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"locked_consensus\":\"strictest\"}";"locked_consensus must be most-restrictive");"an unknown strategy refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"locked_consensus\":true}";"locked_consensus must be most-restrictive");"a strategy that is not a string refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"max_confidence_threshold\":1.5}";"max_confidence_threshold must be a number from 0 to 1");"a threshold above 1 refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"max_confidence_threshold\":\"0.9\"}";"max_confidence_threshold must be a number from 0 to 1");"a threshold written as a string refuses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refuses("{\"enforced\":\"yes\"}";"enforced must be true or false");"enforced that is not a boolean refuses")){pass=pass+1}el{fail=fail+1};
  let badoff=op.fromtext("{\"enforced\":false,\"minimum_layers\":9}");
  if(t.assert(str.len(badoff.error)>0;"a malformed policy refuses even when it says enforced: false")){pass=pass+1}el{fail=fail+1};

  (* ── A file on disk that cannot be read ───────────────────────────────────── *)
  let path=op.policypath();
  if(t.assert(writefile(path;"{\"minimum_layers\":1}") && str.len(op.load(path).error)==0;"a policy written to disk is read")){pass=pass+1}el{fail=fail+1};
  shell(@("chmod";"000";path));
  let locked=op.load(path);
  if(t.asserteq(locked.error;"organisation policy loke.policy.json cannot be applied: the file cannot be read";"a policy file that cannot be read refuses, rather than counting as no file")){pass=pass+1}el{fail=fail+1};
  shell(@("chmod";"600";path));
  file.delete(path);

  (* ── apply: what a policy does to a registry and the consensus settings ───── *)
  let reg=fr.layers("http://127.0.0.1:5000";"http://127.0.0.1:11434");
  let nopol=op.apply(op.absent();reg;"unanimous";"0.9");
  if(t.assert(str.eq(nopol.consensus;"unanimous") && str.eq(nopol.consensusthreshold;"0.9") && nopol.policy.notes.len==0 && fr.get(nopol.registry;"presidio").enabled;"no policy changes nothing")){pass=pass+1}el{fail=fail+1};
  let floor=op.apply(op.fromtext("{\"locked_consensus\":\"most-restrictive\"}");reg;"majority";"");
  if(t.assert(str.eq(floor.consensus;"most-restrictive") && str.eq(floor.policy.raisedfrom;"majority");"a weaker strategy is raised to the floor, and what was configured is kept")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(str.join("|";floor.policy.notes);"privacy.consensus_strategy majority is raised to most-restrictive";"and the override is noted")){pass=pass+1}el{fail=fail+1};
  let same=op.apply(op.fromtext("{\"locked_consensus\":\"most-restrictive\"}");reg;"most-restrictive";"");
  if(t.assert(same.policy.notes.len==0 && str.len(same.policy.raisedfrom)==0;"a configuration already at the floor is not overridden")){pass=pass+1}el{fail=fail+1};
  let high=fr.setpolicy(reg;"presidio";true;3;"detect-and-mask";0.95;"");
  let clamp=op.apply(op.fromtext("{\"max_confidence_threshold\":0.9}");high;"confidence-weighted";"0.99");
  if(t.assert(fr.get(clamp.registry;"presidio").threshold<0.91 && fr.get(clamp.registry;"presidio").threshold>0.89;"a layer threshold above the maximum is clamped to it, not refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(clamp.consensusthreshold;"0.9";"and so is a confidence-weighted consensus_threshold above it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(str.join("|";clamp.policy.notes);"the presidio layer's confidence_threshold is lowered to 0.9|privacy.consensus_threshold is lowered to 0.9";"each clamp is noted")){pass=pass+1}el{fail=fail+1};
  let low=op.apply(op.fromtext("{\"max_confidence_threshold\":0.9}");reg;"confidence-weighted";"0.4");
  if(t.assert(low.policy.notes.len==0 && str.eq(low.consensusthreshold;"0.4");"thresholds at or below the maximum are never raised")){pass=pass+1}el{fail=fail+1};
  let ban=op.apply(op.fromtext("{\"banned_layers\":[\"presidio\"]}");reg;"most-restrictive";"");
  if(t.assert(!fr.get(ban.registry;"presidio").enabled;"a banned layer is switched off")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ban.policy.error;"organisation policy loke.policy.json bans the presidio privacy layer, and this configuration enables it (switch it off in config.toml)";"and a configuration that enables it is an error, not a quiet drop")){pass=pass+1}el{fail=fail+1};
  let banoff=op.apply(op.fromtext("{\"banned_layers\":[\"presidio\"]}");fr.setenabled(reg;"presidio";false);"most-restrictive";"");
  if(t.assert(!fr.get(banoff.registry;"presidio").enabled && str.len(banoff.policy.error)==0;"a banned layer the configuration already switches off is no error")){pass=pass+1}el{fail=fail+1};
  let disabled=op.apply(op.fromtext("{\"banned_layers\":[\"presidio\"],\"locked_consensus\":\"most-restrictive\",\"enforced\":false}");reg;"unanimous";"");
  if(t.assert(fr.get(disabled.registry;"presidio").enabled && str.eq(disabled.consensus;"unanimous");"a policy with enforced: false changes nothing")){pass=pass+1}el{fail=fail+1};

  <fail
};

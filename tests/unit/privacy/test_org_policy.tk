m=test.privacy.orgpolicy;

i=t:std.test;
i=str:std.str;

(* --- stub org policy functions (mirrors core.privacy.orgpolicy) --- *)

t=$orgprivacypolicy{
  minimumlayers:i64;
  requiredlayers:str;
  lockedconsensus:str;
  bannedlayers:str;
  maxconfidencethreshold:f64;
  enforced:bool
};

f=defaultpolicy():$orgprivacypolicy{
  <$orgprivacypolicy{
    minimumlayers:1;
    requiredlayers:"";
    lockedconsensus:"";
    bannedlayers:"";
    maxconfidencethreshold:1.0;
    enforced:false
  }
};

f=validate(policy:$orgprivacypolicy;activelayers:i64;consensus:str):str{
  let violations=mut."";
  if(activelayers<policy.minimumlayers){
    violations=str.concat(violations;"VIOLATION: fewer than minimum required layers active. ")
  }el{};
  if(str.len(policy.lockedconsensus)>0){
    if(!str.eq(consensus;policy.lockedconsensus)){
      violations=str.concat(violations;"VIOLATION: consensus strategy does not match org policy. ")
    }el{}
  }el{};
  <violations
};

f=isenforced(policy:$orgprivacypolicy):bool{
  <policy.enforced
};

f=formatpolicy(policy:$orgprivacypolicy):str{
  <str.concat("Org Policy: min_layers=";str.concat(str.fromint(policy.minimumlayers);str.concat(" required=";str.concat(policy.requiredlayers;str.concat(" consensus=";str.concat(policy.lockedconsensus;str.concat(" enforced=";str.concat(str.fromint(policy.enforced as i64);""))))))))
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. default policy has enforced=false *)
  let dp=defaultpolicy();
  if(t.assert(!dp.enforced;"default policy enforced is false")){pass=pass+1}el{fail=fail+1};

  (* 2. default policy has minimumlayers=1 *)
  if(t.assert(dp.minimumlayers=1;"default policy minimumlayers is 1")){pass=pass+1}el{fail=fail+1};

  (* 3. default policy has empty requiredlayers *)
  if(t.asserteq(dp.requiredlayers;"";"default policy requiredlayers is empty")){pass=pass+1}el{fail=fail+1};

  (* 4. default policy has empty lockedconsensus *)
  if(t.asserteq(dp.lockedconsensus;"";"default policy lockedconsensus is empty")){pass=pass+1}el{fail=fail+1};

  (* 5. default policy maxconfidencethreshold is 1.0 *)
  if(t.assert(dp.maxconfidencethreshold=1.0;"default policy maxconfidencethreshold is 1.0")){pass=pass+1}el{fail=fail+1};

  (* 6. validation passes when layers >= minimum *)
  let v1=validate(dp;3;"any");
  if(t.asserteq(v1;"";"no violations when layers >= minimum")){pass=pass+1}el{fail=fail+1};

  (* 7. validation fails when layers < minimum *)
  let strict=$orgprivacypolicy{
    minimumlayers:3;
    requiredlayers:"openai-privacy-filter";
    lockedconsensus:"most-restrictive";
    bannedlayers:"";
    maxconfidencethreshold:0.95;
    enforced:true
  };
  let v2=validate(strict;1;"most-restrictive");
  if(t.assert(str.contains(v2;"VIOLATION");"violation when layers < minimum")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(v2;"fewer than minimum");"message mentions fewer than minimum")){pass=pass+1}el{fail=fail+1};

  (* 8. locked consensus violation detected *)
  let v3=validate(strict;5;"least-restrictive");
  if(t.assert(str.contains(v3;"consensus strategy does not match");"consensus violation detected")){pass=pass+1}el{fail=fail+1};

  (* 9. no consensus violation when strategy matches *)
  let v4=validate(strict;5;"most-restrictive");
  if(t.asserteq(v4;"";"no violation when consensus matches")){pass=pass+1}el{fail=fail+1};

  (* 10. isenforced returns true for enforced policy *)
  if(t.assert(isenforced(strict);"strict policy is enforced")){pass=pass+1}el{fail=fail+1};

  (* 11. isenforced returns false for default policy *)
  if(t.assert(!isenforced(dp);"default policy is not enforced")){pass=pass+1}el{fail=fail+1};

  (* 12. formatpolicy produces readable output *)
  let fmt=formatpolicy(strict);
  if(t.assert(str.contains(fmt;"Org Policy:");"format contains Org Policy prefix")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(fmt;"min_layers=");"format contains min_layers")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(fmt;"enforced=");"format contains enforced")){pass=pass+1}el{fail=fail+1};

  (* 13. both violations at once *)
  let v5=validate(strict;1;"wrong");
  if(t.assert(str.contains(v5;"fewer than minimum");"combined: layer violation present")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(v5;"consensus strategy");"combined: consensus violation present")){pass=pass+1}el{fail=fail+1};

  <fail
};

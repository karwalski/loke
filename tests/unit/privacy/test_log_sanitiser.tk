m=test.privacy.logsanitiser;
i=t:std.test;
i=str:std.str;
i=san:core.privacy.logsanitiser;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* email addresses are redacted *)
  let r1=san.sanitise("contact john@example.com for info");
  if(t.assert(!str.contains(r1;"john@example.com");"email redacted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(r1;"[REDACTED]");"email replaced with REDACTED")){pass=pass+1}el{fail=fail+1};

  (* phone numbers are redacted *)
  let r2=san.sanitise("call 0412 345 678 now");
  if(t.assert(!str.contains(r2;"0412");"phone redacted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(r2;"[REDACTED]");"phone replaced with REDACTED")){pass=pass+1}el{fail=fail+1};

  (* API keys in key-value pairs are redacted *)
  let r3=san.sanitisemap("api_key";"sk-ant-abc123xyz456def789ghi012jkl");
  if(t.assert(str.eq(r3;"[REDACTED]");"api_key value redacted")){pass=pass+1}el{fail=fail+1};

  let r4=san.sanitisemap("authorization";"Bearer tok_secret_123");
  if(t.assert(str.eq(r4;"[REDACTED]");"authorization value redacted")){pass=pass+1}el{fail=fail+1};

  let r5=san.sanitisemap("token";"mytoken123");
  if(t.assert(str.eq(r5;"[REDACTED]");"token value redacted")){pass=pass+1}el{fail=fail+1};

  let r6=san.sanitisemap("password";"hunter2");
  if(t.assert(str.eq(r6;"[REDACTED]");"password value redacted")){pass=pass+1}el{fail=fail+1};

  let r7=san.sanitisemap("secret";"s3cr3t");
  if(t.assert(str.eq(r7;"[REDACTED]");"secret value redacted")){pass=pass+1}el{fail=fail+1};

  let r8=san.sanitisemap("cookie";"session=abc123");
  if(t.assert(str.eq(r8;"[REDACTED]");"cookie value redacted")){pass=pass+1}el{fail=fail+1};

  (* non-sensitive text passes through unchanged *)
  let r9=san.sanitise("The weather is nice today");
  if(t.assert(str.eq(r9;"The weather is nice today");"clean text unchanged")){pass=pass+1}el{fail=fail+1};

  let r10=san.sanitisemap("component";"The weather is nice today");
  if(t.assert(str.eq(r10;"The weather is nice today");"non-sensitive key unchanged")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.sidecarclient;

i=t:std.test;
i=str:std.str;

(* --- stub functions mirroring core.privacy.sidecarclient --- *)
(* note: actual HTTP calls are not made; we test request construction *)

f=sidecarurl():str{
  <"http://127.0.0.1:11435"
};

f=builddetectbody(text:str):str{
  <str.concat("{\"text\":\"";str.concat(text;"\"}" ))
};

f=buildanonymisebody(text:str):str{
  <str.concat("{\"text\":\"";str.concat(text;"\"}"))
};

f=detectendpoint():str{
  <str.concat(sidecarurl();"/detect")
};

f=anonymiseendpoint():str{
  <str.concat(sidecarurl();"/anonymise")
};

f=healthendpoint():str{
  <str.concat(sidecarurl();"/health")
};

f=modelsendpoint():str{
  <str.concat(sidecarurl();"/models")
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* 1. sidecar URL is localhost *)
  if(t.assert(str.contains(sidecarurl();"127.0.0.1");"sidecar URL uses localhost")){pass=pass+1}el{fail=fail+1};

  (* 2. sidecar port is 11435 *)
  if(t.assert(str.contains(sidecarurl();"11435");"sidecar port is 11435")){pass=pass+1}el{fail=fail+1};

  (* 3. detect endpoint path *)
  if(t.assert(str.contains(detectendpoint();"/detect");"detect endpoint has /detect path")){pass=pass+1}el{fail=fail+1};

  (* 4. anonymise endpoint path *)
  if(t.assert(str.contains(anonymiseendpoint();"/anonymise");"anonymise endpoint has /anonymise path")){pass=pass+1}el{fail=fail+1};

  (* 5. health endpoint path *)
  if(t.assert(str.contains(healthendpoint();"/health");"health endpoint has /health path")){pass=pass+1}el{fail=fail+1};

  (* 6. models endpoint path *)
  if(t.assert(str.contains(modelsendpoint();"/models");"models endpoint has /models path")){pass=pass+1}el{fail=fail+1};

  (* 7. detect body contains text field *)
  let body=builddetectbody("hello world");
  if(t.assert(str.contains(body;"\"text\"");"detect body contains text field")){pass=pass+1}el{fail=fail+1};

  (* 8. detect body contains the input text *)
  if(t.assert(str.contains(body;"hello world");"detect body contains input text")){pass=pass+1}el{fail=fail+1};

  (* 9. anonymise body is valid JSON structure *)
  let abody=buildanonymisebody("test data");
  if(t.assert(str.contains(abody;"{");"anonymise body starts with brace")){pass=pass+1}el{fail=fail+1};

  (* 10. anonymise body contains input text *)
  if(t.assert(str.contains(abody;"test data");"anonymise body contains input text")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.privacy.sidecarclient;

i=t:std.test;
i=str:std.str;
(* The alias is `sid`, not `sc`: `sc` is a RESERVED TOKEN in toke and rejecting it is
   reported as E2002 "unexpected token" pointing at the import's alias position, with no
   hint that the name itself is the problem. Cost ten minutes; recorded so the next person
   spends none. *)
i=sid:core.privacy.sidecarclient;


(* X7.2 — this file used to declare its own HTTP client and assert against it. It now
   imports core.privacy.sidecarclient.

   What is asserted here is the part that needs no server: the URL every call is built from,
   and what happens when the sidecar is ABSENT. What arrives at a server that answers, and
   the operating point, are asserted in test_sidecar_threshold.tk against the recorder.

   FINDING, now closed (AD1.4, 2026-09-28). detect() used to return whatever string
   http.posturl produced: no status, no empty check, no distinguished error. With the
   sidecar down a caller received a string with no entities in it, byte-for-byte the shape
   of a clean scan, which is a detection layer failing OPEN. isavailable() asked only
   whether /health CONTAINED "ok". detect() and anonymise() now answer a $pfscan whose ok
   is true only when the sidecar answered with a scan, and isavailable() is a real GET
   through shared.reachability.

   Nothing listens on 11435 in a test environment, so the unavailable path is exercised
   for real. A refused connection on localhost returns immediately. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── The URL every call is built from ────────────────────────────────────────
     Loopback, and a fixed port. A sidecar URL that ever became non-local would send the
     text being scanned for PII to another host — which is the one thing a local-first
     privacy product must not do, and it would be a one-word change. *)
  if(t.asserteq(sid.sidecarurl();"http://127.0.0.1:11435";"the sidecar URL is loopback on a fixed port")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(sid.sidecarurl();"127.0.0.1");"and is LOOPBACK — text being scanned for PII must never be posted off the machine")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(sid.sidecarurl();"https://");"it is plain HTTP, which is acceptable only because it never leaves the loopback interface")){pass=pass+1}el{fail=fail+1};

  (* ── The unavailable path, exercised against a port nothing listens on ───────*)
  let client=sid.new(sid.sidecarurl();"");
  if(t.assert(!sid.isavailable(client);"with no sidecar running, isavailable reports false")){pass=pass+1}el{fail=fail+1};

  (* The text below contains an email address and a credit card number. With the sidecar
     down the scan must say it did not happen, never answer as an empty clean one. *)
  let dirty="contact alice@example.com about card 4111 1111 1111 1111";
  let detected=sid.detect(client;dirty);
  if(t.assert(!detected.ok;"with the sidecar down, detect() reports that NO scan happened, not a clean one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(detected.count==0 && str.len(detected.body)==0;"and carries nothing a caller could read as a detection result")){pass=pass+1}el{fail=fail+1};

  (* anonymise()'s failure mode is worse: a caller that forwarded the text would forward
     the ORIGINAL believing it anonymised. *)
  let anonymised=sid.anonymise(client;dirty);
  if(t.assert(!anonymised.ok;"with the sidecar down, anonymise() reports that nothing was anonymised")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(anonymised.body;dirty);"and does not echo the original text back")){pass=pass+1}el{fail=fail+1};

  (* listmodels has no privacy consequence, so one assertion is enough: it must not
     fabricate a model list when there is nothing to ask. *)
  if(t.assert(str.len(sid.listmodels(client))==0;"listmodels invents no models when no sidecar answers")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.monitoring.sysmonparse;

i=t:std.test;
i=str:std.str;
i=sm:core.monitoring.sysmon;

(* BG1.2. /sysmon reported 0 MB used, 0% RAM and 0% CPU on every machine. Two parsers required
   one more field than their input has: a vm_stat line splits into two parts at ":", not three,
   and top's CPU line has three comma-separated parts before "idle", not four. The vm_stat
   page size was also fixed at Apple silicon's 16384. These are canned listings in the shape
   macOS prints them, with page counts chosen so the answers are whole MiB. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let nl="
";
  let vm16="Mach Virtual Memory Statistics: (page size of 16384 bytes)\(nl)Pages free:                                     8295.\(nl)Pages active:                                  64000.\(nl)Pages inactive:                               253322.\(nl)Pages wired down:                               32000.\(nl)Pages occupied by compressor:                   32000.\(nl)";
  if(t.assert(sm.vmstatpagesize(vm16)==16384;"vm_stat: the page size is read from the header")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sm.vmstatusedmb(vm16)==2000;"vm_stat: 128000 active, wired and compressed 16 KiB pages are 2000 MiB used")){pass=pass+1}el{fail=fail+1};
  let vm4="Mach Virtual Memory Statistics: (page size of 4096 bytes)\(nl)Pages active:                                 128000.\(nl)Pages wired down:                               64000.\(nl)Pages occupied by compressor:                   64000.\(nl)";
  if(t.assert(sm.vmstatusedmb(vm4)==1000;"vm_stat: 256000 pages of 4 KiB (an Intel Mac) are 1000 MiB, not 4000")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sm.vmstatusedmb("vm_stat: command not found")==0;"vm_stat: a listing with no header measures nothing")){pass=pass+1}el{fail=fail+1};
  let top="Processes: 812 total, 4 running, 808 sleeping, 4459 threads\(nl)Load Avg: 9.75, 8.85, 8.61\(nl)CPU usage: 46.4% user, 42.55% sys, 11.39% idle \(nl)SharedLibs: 1035M resident\(nl)";
  let busy=sm.topbusypercent(top);
  if(t.assert(busy>88.6 && busy<88.62;"top: 11.39% idle is 88.61% busy")){pass=pass+1}el{fail=fail+1};
  let idle=sm.topbusypercent("CPU usage: 1.5% user, 2.5% sys, 96.0% idle");
  if(t.assert(idle>3.99 && idle<4.01;"top: an idle machine reads 4% busy, not 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sm.topbusypercent("no cpu line here")==0.0;"top: no CPU line measures nothing")){pass=pass+1}el{fail=fail+1};
  let gone=sm.getprocessstatsbypid(0;"loke");
  if(t.assert(gone.pid==0;"a pid of 0 names no process")){pass=pass+1}el{fail=fail+1};
  let launchd=sm.getprocessstatsbypid(1;"launchd");
  if(t.assert(launchd.pid==1 && launchd.rammb>0.0;"pid 1 is read by pid, with its resident memory")){pass=pass+1}el{fail=fail+1};
  let snap=sm.snapshotof(0);
  let js=sm.tojson(snap);
  if(t.assert(str.contains(js;"\"loke\":null");"a loke entry that was not measured is null, not zeros")){pass=pass+1}el{fail=fail+1};
  if(t.assert(snap.usedrammb>0 && snap.usedrammb<snap.totalrammb;"the live snapshot reports RAM in use, below the total")){pass=pass+1}el{fail=fail+1};
  <fail
};

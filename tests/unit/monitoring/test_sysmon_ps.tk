m=test.monitoring.sysmonps;

i=t:std.test;
i=sm:core.monitoring.sysmon;

(* getprocessstats read no process on any Mac. Its `ps` asked for `nlwp`, a Linux column,
   so the output had four fields where the parser demanded more than four. It waited for
   ps before reading, which deadlocks once the listing fills the pipe. And a process at
   0.0% CPU never replaced the empty starting value. launchd always exists, is pid 1 and
   is usually idle, so it trips all three. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let st=sm.getprocessstats("launchd");
  if(t.assert(st.pid>0;"a running process is found, idle or not, with its real pid")){pass=pass+1}el{fail=fail+1};
  if(t.assert(st.pid==1;"and for launchd that pid is 1")){pass=pass+1}el{fail=fail+1};
  let none=sm.getprocessstats("no-such-process-xyzzy");
  if(t.assert(none.pid==0;"a process that is not running reports pid 0")){pass=pass+1}el{fail=fail+1};
  <fail
};

m=tests.unit.companion.testexo;

i=t:std.test;
i=str:std.str;
i=exo:core.companion.exo;

(* X4b.10 - the Exo client: health check and model list.

   Exo is not running here, which is the usual case, and the health check and the cluster
   query must say so rather than crash: http.get against a closed port returns $ok with a nil
   body (T-15), and both used to read a status off it. The node and model list is parsed from
   a body, so it is tested without a server. *)

f=clusterbody():str{
  <"{\"nodes\":[{\"id\":\"n1\",\"device\":\"Mac Studio\",\"memory_gb\":192,\"models\":[\"llama-3.1-70b\",\"qwen2.5:72b\"]},{\"id\":\"n2\",\"device\":\"MacBook Pro\",\"memory_gb\":64,\"models\":[\"llama-3.1-8b\"]}]}"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let dead=$exoconfig{ host:"127.0.0.1"; port:59994 as i32 };
  if(t.assert(!exo.isavailable(dead);"the health check of an Exo that is not running is false, not a crash")){pass=pass+1}el{fail=fail+1};
  let none:$exocluster=exo.clusterstatus(dead);
  if(t.assert(none.nodes.len==0;"and its cluster is empty")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(exo.baseurl(exo.defaultconfig());"http://localhost:52415";"the default config points at Exo's port")){pass=pass+1}el{fail=fail+1};

  let c:$exocluster=exo.parsecluster(clusterbody());
  if(t.assert(c.nodes.len==2;"a cluster response yields its nodes")){pass=pass+1}el{fail=fail+1};
  if(c.nodes.len==2){
    let n1:$exonode=c.nodes.get(0);
    let n2:$exonode=c.nodes.get(1);
    if(t.asserteq(n1.id;"n1";"each with its id")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(n1.device;"Mac Studio";"and device")){pass=pass+1}el{fail=fail+1};
    if(t.assert(n1.models.len==2;"the model list of the first node")){pass=pass+1}el{fail=fail+1};
    if(n1.models.len==2){
      if(t.asserteq(n1.models.get(1);"qwen2.5:72b";"with each model named")){pass=pass+1}el{fail=fail+1}
    }el{ fail=fail+1 };
    if(t.assert(n2.models.len==1;"and of the second")){pass=pass+1}el{fail=fail+1};
    if(t.assert((n1.memorygb as f64)>191.0 && (n1.memorygb as f64)<193.0;"a node's memory")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+6 };
  if(t.assert((c.totalmemorygb as f64)>255.0 && (c.totalmemorygb as f64)<257.0;"and the cluster total is their sum")){pass=pass+1}el{fail=fail+1};
  let f=exo.formatcluster(c);
  if(t.assert(str.contains(f;"2 nodes") && str.contains(f;"Mac Studio") && str.contains(f;"MacBook Pro");"the summary names the node count and each device")){pass=pass+1}el{fail=fail+1};
  if(t.assert(exo.parsecluster("{not json").nodes.len==0;"a malformed body yields no nodes")){pass=pass+1}el{fail=fail+1};

  <fail
}

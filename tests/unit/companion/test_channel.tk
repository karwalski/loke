m=tests.unit.companion.testchannel;

i=t:std.test;
i=str:std.str;
i=ct:core.companion.types;
i=ch:core.companion.channel;
i=tls:std.tls;

(* F10.56 - core.companion.channel's "not connected".

   connect answered an i64, 0 when it did not connect, and send, recv, close and pairingcode
   tested it against 0 before handing it to std.tls. std.tls reads a $tlsconn through its
   address and a record cannot be compared with 0, so a connection is now a $chanlink whose
   up says whether its conn came from std.tls. These are the two ways connect does not
   connect, and what each function answers for the link it gets: never a call into std.tls
   with a record std.tls did not hand out. *)

f=companionwith(certpem:str):$companion{
  <$companion{id:"c-1";name:"test companion";host:"127.0.0.1";port:1 as i32;certpem:certpem;paired:true;pairedat:0;lastseen:0}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let kp=ch.genidentity("test-device");
  if(t.assert(str.len(kp.certpem)>0;"an identity certificate is generated")){pass=pass+1}el{fail=fail+1};

  (* No pinned certificate: refused before any connection is tried. *)
  let unpinned=ch.connect(companionwith("");kp);
  if(t.assert(!unpinned.up;"a companion with no pinned certificate is not connected to")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ch.send(unpinned;"hello");"and send on that link answers false")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ch.recv(unpinned);"";"recv answers nothing")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ch.pairingcode(unpinned);"";"there is no pairing code")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ch.close(unpinned);"and close has nothing to close")){pass=pass+1}el{fail=fail+1};

  (* Pinned, but nothing listens on port 1: std.tls answers $none and the link is down. *)
  let refused=ch.connect(companionwith(kp.certpem);kp);
  if(t.assert(!refused.up;"a companion that does not answer is not connected")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ch.send(refused;"hello");"and send on that link answers false")){pass=pass+1}el{fail=fail+1};

  <fail
};


m=tests.unit.companion.testdiscovery;

i=disc:loke.companion.discovery;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @($result);

  let s0 = disc.newstate();
  results = str.arraypush(results;assertfalse("new_state browsing is false";s0.browsing));

  let devcount = s0.devices.len();
  results = str.arraypush(results;asserttrue("new_state devices is empty";devcount = 0));

  let s1 = disc.startbrowse(s0);
  results = str.arraypush(results;asserttrue("start_browse sets browsing true";s1.browsing));

  let s2 = disc.stopbrowse(s1);
  results = str.arraypush(results;assertfalse("stop_browse sets browsing false";s2.browsing));

  let s3 = disc.onfound(s0;"dev-1";"MacBook Pro";"192.168.1.10";11430;"darwin");
  let devcountafter = s3.devices.len();
  results = str.arraypush(results;asserttrue("on_found adds one device";devcountafter = 1));

  let founddev = disc.find(s3;"dev-1");
  let foundstatus = mt founddev { $some:d d.status; $none "not_found" };
  results = str.arraypush(results;asserteq("on_found device status is discovered";foundstatus;"discovered"));

  let code = disc.getconfirmationcode(s3;"dev-1");
  let codestr = mt code { $some:c c; $none "" };
  let codelen = str.len(codestr);
  results = str.arraypush(results;asserttrue("confirmation code is 6 digits";codelen = 6));

  let unknowncode = disc.getconfirmationcode(s3;"unknown-id");
  let unknownisnone = mt unknowncode { $some:v false; $none true };
  results = str.arraypush(results;asserttrue("unknown device code returns none";unknownisnone));

  let s4 = disc.confirmpairing(s3;"dev-1";codestr);
  let paireddev = disc.find(s4;"dev-1");
  let ispaired = mt paireddev { $some:d d.paired; $none false };
  results = str.arraypush(results;asserttrue("confirm_pairing with correct code pairs device";ispaired));

  let pairedstatus = mt paireddev { $some:d d.status; $none "not_found" };
  results = str.arraypush(results;asserteq("confirm_pairing sets status to paired";pairedstatus;"paired"));

  let s5 = disc.confirmpairing(s3;"dev-1";"000000");
  let wrongdev = disc.find(s5;"dev-1");
  let wrongpaired = mt wrongdev { $some:d d.paired; $none false };
  results = str.arraypush(results;assertfalse("wrong code does not pair device";wrongpaired));

  let s6 = disc.reject(s3;"dev-1");
  let rejected = disc.find(s6;"dev-1");
  let rejectednone = mt rejected { $some:v false; $none true };
  results = str.arraypush(results;asserttrue("reject removes device";rejectednone));

  let pairedlist = disc.listpaired(s4);
  let pairedcount = pairedlist.len();
  results = str.arraypush(results;asserttrue("list_paired returns 1 paired device";pairedcount = 1));

  let unpairedlist = disc.listpaired(s3);
  let unpairedcount = unpairedlist.len();
  results = str.arraypush(results;asserttrue("list_paired returns 0 when none paired";unpairedcount = 0));

  let devforjson = s3.devices.get(0);
  let jsonstr = disc.tojson(devforjson);
  results = str.arraypush(results;asserttrue("to_json contains id field";str.contains(jsonstr;"\"id\"")));
  results = str.arraypush(results;asserttrue("to_json contains name field";str.contains(jsonstr;"\"name\"")));
  results = str.arraypush(results;asserttrue("to_json contains host field";str.contains(jsonstr;"\"host\"")));

  let validdev =$companiondevice{
    id:"dev-ok";name:"Test";host:"192.168.1.1";port:11430;platform:"darwin";
    ramgb:16;gpuname:"";status:"discovered";confirmationcode:"123456";paired:false;pairedat:0
  };
  results = str.arraypush(results;asserttrue("security_checks passes valid device";disc.securitychecks(validdev)));

  let badhost =$companiondevice{
    id:"dev-bad";name:"Test";host:"";port:11430;platform:"darwin";
    ramgb:16;gpuname:"";status:"discovered";confirmationcode:"123456";paired:false;pairedat:0
  };
  results = str.arraypush(results;assertfalse("security_checks fails empty host";disc.securitychecks(badhost)));

  let badport =$companiondevice{
    id:"dev-bad2";name:"Test";host:"192.168.1.1";port:0;platform:"darwin";
    ramgb:16;gpuname:"";status:"discovered";confirmationcode:"123456";paired:false;pairedat:0
  };
  results = str.arraypush(results;assertfalse("security_checks fails zero port";disc.securitychecks(badport)));

  let browsingstate = disc.startbrowse(s0);
  let s7 = disc.onfound(browsingstate;"dev-2";"iPad";"192.168.1.20";11430;"ios");
  results = str.arraypush(results;asserttrue("on_found preserves browsing state";s7.browsing));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;i<n;lv=lv){
    let r = str.arrayget(results;i);
    logresult(r);
    if(!r.passed){ let all = false }el{};
    i = i + 1
  };
  <all
};

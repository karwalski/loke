
m=tests.unit.companion.testchanneltls;

i=ch:companion.channel;
i=str:std.str;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{ <fail(name;"want=" + want + " got=" + got) };
};

f=asserttrue(name:$str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;val:bool):$result{
  if(!$val){ <pass(name) }el{ <fail(name;"expected false") };
};

f=asserteqi32(name:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{ <fail(name;"want=" + str.fromi32(want) + " got=" + str.fromi32(got)) };
};

f=logresult(r:$result){
  if(r.passed){ log.info("PASS " + r.name) }el{ log.error("FAIL " + r.name + ": " + r.message) };
};

f=testnewconfig():$result{
  let cfg=ch.newconfig("192.168.1.10";9443);
  let r1=asserteq("new_config.host";cfg.host;"192.168.1.10");
  if(!$r1.passed){ <r1 }el{};
  let r2=asserteqi32("new_config.port";cfg.port;9443);
  if(!$r2.passed){ <r2 }el{};
  let r3=asserteq("new_config.cert_pin";cfg.certpin;"");
  if(!$r3.passed){ <r3 }el{};
  <asserteqi32("new_config.heartbeat_interval_s";cfg.heartbeatintervals;30)
};

f=testnewstate():$result{
  let cfg=ch.newconfig("10.0.0.1";8443);
  let state=ch.newstate(cfg);
  let r1=assertfalse("new_state.connected";state.connected);
  if(!$r1.passed){ <r1 }el{};
  let r2=asserteqi32("new_state.bytes_sent";state.bytessent;0);
  if(!$r2.passed){ <r2 }el{};
  <asserteqi32("new_state.bytes_recv";state.bytesrecv;0)
};

f=testnewmessage():$result{
  let msg=ch.newmessage("data";"hello world");
  let r1=asserteq("new_message.kind";msg.kind;"data");
  if(!$r1.passed){ <r1 }el{};
  <asserteq("new_message.payload";msg.payload;"hello world")
};

f=testpincert():$result{
  let cfg=ch.newconfig("10.0.0.1";8443);
  let state=ch.newstate(cfg);
  let pinned=ch.pincert(state;"sha256:abc123def456");
  <asserteq("pin_cert.cert_pin";pinned.config.certpin;"sha256:abc123def456")
};

f=testsenddisconnected():$result{
  let cfg=ch.newconfig("10.0.0.1";8443);
  let state=ch.newstate(cfg);
  let msg=ch.newmessage("test";"payload");
  let after=ch.send(state;msg);
  let r1=assertfalse("send_disconnected.connected";after.connected);
  if(!$r1.passed){ <r1 }el{};
  <asserteqi32("send_disconnected.bytes_sent";after.bytessent;0)
};

f=testpairingcodedisconnected():$result{
  let cfg=ch.newconfig("10.0.0.1";8443);
  let state=ch.newstate(cfg);
  <asserteq("pairing_code_disconnected";ch.pairingcode(state);"")
};

f=testrecvdisconnected():$result{
  let cfg=ch.newconfig("10.0.0.1";8443);
  let state=ch.newstate(cfg);
  let msg=mt ch.recv(state);
  msg {
    $some:{ <fail("recv_disconnected";"expected none, got some") };
    $none:{ <pass("recv_disconnected") };
  };
};

f=runall():@$result{
  let results=@();
  results.push(testnewconfig());
  results.push(testnewstate());
  results.push(testnewmessage());
  results.push(testpincert());
  results.push(testsenddisconnected());
  results.push(testpairingcodedisconnected());
  results.push(testrecvdisconnected());
  results.each(r{ logresult(r) });
  <results
};

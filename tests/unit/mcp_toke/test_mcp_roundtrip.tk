m=test.mcptoke.roundtrip;

i=t:std.test;
i=str:std.str;
i=json:std.json;
i=srv:mcptoke.server;

(* X4b.12: the mcp-toke server's request handling, one JSON-RPC line in and one response
   out, through `handlerequest`, the function its listener calls for each line. Every
   response is decoded again to prove it is valid JSON-RPC. *)

f=idof(resp:str):i64{
  <mt json.i64(json.dec(resp);"id") {$ok:v v; $err:e 0-1}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let cfg=srv.defaultconfig();

  let init=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}";cfg);
  if(t.assert(idof(init)==1 && str.contains(init;"\"protocolVersion\":\"2024-11-05\"");"initialize answers with the protocol version, for the request's id")){pass=pass+1}el{fail=fail+1};

  let lst=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}";cfg);
  if(t.assert(idof(lst)==2 && str.contains(lst;"\"name\":\"compress\"") && str.contains(lst;"\"name\":\"anonymise\"");"tools/list names the tools")){pass=pass+1}el{fail=fail+1};

  let call=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"no_such_tool\",\"arguments\":{}}}";cfg);
  if(t.assert(idof(call)==3;"tools/call answers valid JSON for its id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(call;"unknown tool: no_such_tool");"and names the tool it was asked for, so the tool name was read from the params")){pass=pass+1}el{fail=fail+1};

  (* MK6.10: a tool's arguments reach it. They arrived as "invalid args JSON" for every call. *)
  let cmp=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"compress\",\"arguments\":{\"json\":\"[{\\\"a\\\":1},{\\\"a\\\":2}]\"}}}";cfg);
  if(t.assert(idof(cmp)==5 && !str.contains(cmp;"invalid args JSON");"tools/call hands the tool its arguments")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cmp;"[2]{a}:") && str.contains(cmp;"toon_chars\\\":15,");"so compress converts them, through the server")){pass=pass+1}el{fail=fail+1};

  let unk=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"nope\",\"params\":{}}";cfg);
  if(t.assert(idof(unk)==4 && str.contains(unk;"-32601");"an unknown method is Method not found")){pass=pass+1}el{fail=fail+1};

  (* These used to crash the server, intermittently. std.json accepts `{not json`, so a
     line is refused unless it decodes AND names a method. *)
  let bad=srv.handlerequest("{not json";cfg);
  if(t.assert(str.contains(bad;"-32600");"a line that is not a request is refused as Invalid Request, and does not crash the server")){pass=pass+1}el{fail=fail+1};
  let nomethod=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":5}";cfg);
  if(t.assert(str.contains(nomethod;"-32600");"and so is valid JSON with no method")){pass=pass+1}el{fail=fail+1};
  let trailing=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/list\"} extra";cfg);
  if(t.assert(str.contains(trailing;"-32600");"a request with text after it is refused")){pass=pass+1}el{fail=fail+1};
  let truncated=srv.handlerequest("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/li";cfg);
  if(t.assert(str.contains(truncated;"-32600");"and so is a truncated one")){pass=pass+1}el{fail=fail+1};
  <fail
};

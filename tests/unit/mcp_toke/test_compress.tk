m=test.mcptoke.compress;

i=t:std.test;
i=str:std.str;
i=proto:core.mcp.protocol;
i=tools:mcptoke.tools;

(* MK6.7 — mcp-toke's compress and decompress tools, through handletool, the function the
   server calls for tools/call. compress answered `{"toon":"~","savings_pct":94}` for
   `[{"a":1},{"a":2}]`: the encoder kept only the kind of each value, and the saving was measured
   against the tilde. The tool's text is an MCP content envelope whose inner JSON is escaped
   once, so the fragments below are written as they appear inside it: \" for a quote, \\n for
   a newline. *)

f=call(name:str;args:str):$toolresult{
  <tools.handletool(name;args;"";"")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let c=call("compress";"{\"json\":\"[{\\\"a\\\":1},{\\\"a\\\":2}]\"}");
  if(t.assert(!c.iserror;"compress converts a two-row array of objects")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(c.text;"\\\"toon\\\":\\\"[2]{a}:\\\\n  1\\\\n  2\\\"");"into TOON's tabular form, carrying both values, not ~")){pass=pass+1}el{fail=fail+1};
  (* 17 characters of JSON to 15 of TOON: (17-15)*10000/17 = 1176 basis points, 11 whole percent. *)
  if(t.assert(str.contains(c.text;"\\\"json_chars\\\":17,");"it reports the input's length")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(c.text;"\\\"toon_chars\\\":15,");"and the output's")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(c.text;"\\\"savings_pct\\\":11,");"and a saving measured from those two lengths, not 94")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(c.text;"\\\"minified_json_chars\\\":17,") && str.contains(c.text;"\\\"savings_vs_minified_pct\\\":11}");"and against the input without whitespace")){pass=pass+1}el{fail=fail+1};

  (* Whitespace in the input is counted in json_chars, and not in the minified figure. *)
  let w=call("compress";"{\"json\":\"[ {\\\"a\\\": 1}, {\\\"a\\\": 2} ]\"}");
  if(t.assert(str.contains(w.text;"\\\"json_chars\\\":22,") && str.contains(w.text;"\\\"minified_json_chars\\\":17,");"a padded input is measured as sent and as minified")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(w.text;"\\\"savings_pct\\\":31,") && str.contains(w.text;"\\\"savings_vs_minified_pct\\\":11}");"so its saving over what was sent is larger than over the minified JSON")){pass=pass+1}el{fail=fail+1};

  (* A longer TOON is a negative saving, reported as one. *)
  let s=call("compress";"{\"json\":\"[\\\"a,b\\\"]\"}");
  if(t.assert(str.contains(s.text;"\\\"toon\\\":\\\"[1]: \\\\\\\"a,b\\\\\\\"\\\"");"a string holding the delimiter is quoted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(s.text;"\\\"savings_pct\\\":-42,");"and a TOON longer than its JSON is a negative saving (7 to 10 characters)")){pass=pass+1}el{fail=fail+1};

  let r=call("compress";"{\"json\":\"{\\\"a\\\":{\\\"b\\\":1}}\"}");
  if(t.assert(r.iserror;"compress refuses a shape it cannot encode")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(r.text;"nested object") && !str.contains(r.text;"savings");"and names it, with no saving")){pass=pass+1}el{fail=fail+1};

  let d=call("decompress";"{\"toon\":\"[2]{a}:\\n  1\\n  2\"}");
  if(t.assert(!d.iserror;"decompress decodes the TOON compress wrote")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(d.text;"\\\"json\\\":\\\"[{\\\\\\\"a\\\\\\\":1},{\\\\\\\"a\\\\\\\":2}]\\\"");"back to the original JSON")){pass=pass+1}el{fail=fail+1};

  let bad=call("decompress";"{\"toon\":\"[3]: 1,2\"}");
  if(t.assert(bad.iserror && str.contains(bad.text;"count");"decompress refuses TOON whose count disagrees with its values")){pass=pass+1}el{fail=fail+1};

  <fail
};

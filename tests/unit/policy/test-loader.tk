
m=tests.unit.policy.testloader;
i=s:core.policy.schema;
i=merge:core.policy.merge;
i=validate:core.policy.validate;
i=conflict:core.policy.conflict;
i=gdpr:core.policy.presets.gdpr;
i=au:core.policy.presets.auprivacy;
i=hipaa:core.policy.presets.hipaa;
i=ccpa:core.policy.presets.ccpa;
i=rem:core.policy.presets.remaining;
i=str:std.str;
i=test:std.test;

f=run():void{
  testdefaultpolicy();
  testvalidateemptyname();
  testvalidatevalidpolicy();
  testmergetwopolicies();
  testmergetiers();
  testgdprpreset();
  testaupreset();
  testhipaapreset();
  testconflictretention();
  testconflictanonymisation()
};

f=testdefaultpolicy():void{
  let p=s.defaultpolicy();
  test.asserteq(p.name;"default";"default policy name");
  test.asserteq(p.classificationdefault;"confidential";"default classification");
  test.assert(p.crossborderallowed=false;"default cross-border blocked")
};

f=testvalidateemptyname():void{
  let p=s.defaultpolicy();
  let p=s.setname(p;"");
  let r=validate.validate(p);
  test.assert(r.valid=false;"empty name should fail validation");
  test.assert(str.arraylen(r.errors)>0;"should have errors")
};

f=testvalidatevalidpolicy():void{
  let p=s.defaultpolicy();
  let r=validate.validate(p);
  test.assert(r.valid=true;"default policy should be valid");
  test.assert(str.arraylen(r.errors)=0;"no errors expected")
};

f=testmergetwopolicies():void{
  let base=s.defaultpolicy();
  let overlay=s.defaultpolicy();
  let overlay=s.setname(overlay;"team-policy");
  let overlay=s.setpriority(overlay;50);
  let merged=merge.mergetwo(base;overlay);
  test.asserteq(merged.name;"team-policy";"overlay name wins");
  test.assert(merged.priority=50;"higher priority wins")
};

f=testmergetiers():void{
  let enterprise=s.defaultpolicy();
  let enterprise=s.setname(enterprise;"enterprise");
  let enterprise=s.setpriority(enterprise;200);
  let enterprise=s.setcrossborder(enterprise;false);
  let team=s.defaultpolicy();
  let team=s.setname(team;"team");
  let team=s.setpriority(team;100);
  let user=s.defaultpolicy();
  let user=s.setname(user;"user");
  let user=s.setpriority(user;10);
  let merged=merge.mergetiers(enterprise;team;user);
  test.assert(merged.priority=200;"enterprise priority wins");
  test.assert(merged.crossborderallowed=false;"enterprise blocks cross-border")
};

f=testgdprpreset():void{
  let p=gdpr.preset();
  test.asserteq(p.name;"EU GDPR";"GDPR name");
  test.assert(str.arraylen(p.blockedentitytypes)>0;"GDPR blocks special categories");
  test.assert(p.crossborderallowed=false;"GDPR blocks cross-border by default")
};

f=testaupreset():void{
  let p=au.preset();
  test.asserteq(p.name;"AU Privacy Act";"AU name");
  test.assert(str.arraylen(p.blockedentitytypes)>0;"AU blocks TFN/Medicare")
};

f=testhipaapreset():void{
  let p=hipaa.preset();
  test.asserteq(p.name;"US HIPAA";"HIPAA name");
  test.asserteq(p.classificationdefault;"restricted";"HIPAA defaults to restricted")
};

f=testconflictretention():void{
  let r=conflict.resolveretention(90;"gdpr";180;"au";"gdpr");
  test.asserteq(r.chosenvalue;"90";"shortest retention wins")
};

f=testconflictanonymisation():void{
  let r=conflict.resolveanonymisation("full";"gdpr";"reasonable";"au");
  test.asserteq(r.chosenvalue;"full";"strongest anonymisation wins")
};

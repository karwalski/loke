m=test.policy.aprapresets;

i=t:std.test;
i=str:std.str;
i=sch:core.policy.schema;
i=ty:core.policy.types;
i=reg:core.policy.presets.registry;
i=loader:core.policy.loader;
i=rules:core.governance.rulesengine;

(* Counts the rules the loader actually sees through a named preset, rather than what the
   preset module returns directly. That is the whole point: a preset nothing can load is a
   document, and a preset that loads with an empty rule list is indistinguishable from the
   T-24 defect where @(rules; rule) silently produces a two-element literal instead of an
   append. Both must be impossible to ship. *)
f=loadedrulecount(name:str):i64{
  let ps:$policyset=loader.loadpreset(name);
  let total=mut.0;
  let ri=mut.0;
  lp(let lv=0;ri<ps.regulations.len;lv=lv){
    let r:$regulation=ps.regulations.get(ri);
    total=total+(r.rules.len as i64);
    ri=ri+1
  };
  <total
};

f=hasruleid(name:str;wanted:str):bool{
  let rs=reg.rulesfor(name);
  let found=mut.false;
  let i=mut.0;
  lp(let lv=0;i<rs.len;lv=lv){
    let r:$policyrule=rs.get(i);
    if(str.eq(r.id;wanted)){found=true}el{};
    i=i+1
  };
  <found
};

f=anydescriptioncontains(name:str;needle:str):bool{
  let rs=reg.rulesfor(name);
  let found=mut.false;
  let i=mut.0;
  lp(let lv=0;i<rs.len;lv=lv){
    let r:$policyrule=rs.get(i);
    if(str.contains(r.description;needle)){found=true}el{};
    i=i+1
  };
  <found
};

f=countruledescriptionscontaining(name:str;needle:str):i64{
  let rs=reg.rulesfor(name);
  let n=mut.0;
  let i=mut.0;
  lp(let lv=0;i<rs.len;lv=lv){
    let r:$policyrule=rs.get(i);
    if(str.contains(r.description;needle)){n=n+1}el{};
    i=i+1
  };
  <n
};

f=hasblockedentity(name:str;wanted:str):bool{
  let p:$policy=reg.byname(name);
  let blocked=p.blockedentitytypes;
  let found=mut.false;
  let i=mut.0;
  lp(let lv=0;i<blocked.len;lv=lv){
    if(str.eq(blocked.get(i);wanted)){found=true}el{};
    i=i+1
  };
  <found
};

f=hascustomrule(name:str;wanted:str):bool{
  let p:$policy=reg.byname(name);
  let cr=p.customrules;
  let found=mut.false;
  let i=mut.0;
  lp(let lv=0;i<cr.len;lv=lv){
    if(str.eq(cr.get(i);wanted)){found=true}el{};
    i=i+1
  };
  <found
};

f=monthlycostusd(name:str):f64{
  let p:$policy=reg.byname(name);
  let b:$budgetlimit=p.budget;
  <b.maxcostusd
};

f=emptyregulationsin(ps:$policyset):i64{
  let n=mut.0;
  let i=mut.0;
  lp(let lv=0;i<ps.regulations.len;lv=lv){
    let r:$regulation=ps.regulations.get(i);
    if(r.rules.len==0 as u64){n=n+1}el{};
    i=i+1
  };
  <n
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* --- every registered preset loads by name, and none of them loads empty --- *)
  let all=reg.names();
  if(t.assert(all.len>0 as u64;"the registry names at least one preset")){pass=pass+1}el{fail=fail+1};

  let i=mut.0;
  lp(let lv=0;i<all.len;lv=lv){
    let n=all.get(i);
    let p:$policy=reg.byname(n);
    if(t.assert(reg.isknown(p);str.concat("preset loads by name: ";n))){pass=pass+1}el{fail=fail+1};
    if(t.assert(str.len(p.name)>0;str.concat("loaded preset carries a name: ";n))){pass=pass+1}el{fail=fail+1};
    if(t.assert(loadedrulecount(n)>0;str.concat("preset loads with a non-empty rule list: ";n))){pass=pass+1}el{fail=fail+1};
    if(t.assert(str.len(reg.jurisdictionfor(n))>0;str.concat("preset declares a jurisdiction: ";n))){pass=pass+1}el{fail=fail+1};
    if(t.assert(loader.presetknown(n);str.concat("the loader recognises the name: ";n))){pass=pass+1}el{fail=fail+1};
    i=i+1
  };

  (* An unknown name must be distinguishable from a preset that constrains nothing. *)
  let missing:$policy=reg.byname("no-such-regulation");
  if(t.assert(!reg.isknown(missing);"an unregistered name yields the not-found sentinel")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!loader.presetknown("no-such-regulation");"and the loader reports it unknown")){pass=pass+1}el{fail=fail+1};
  let missingrules=reg.rulesfor("no-such-regulation");
  if(t.assert(missingrules.len==0 as u64;"and it carries no rules")){pass=pass+1}el{fail=fail+1};

  (* --- APRA CPS 234, against docs/specifications/policy-examples/apra-cps-234.yaml --- *)
  if(t.assert(loadedrulecount("apra-cps-234")>20;"CPS 234 maps more than twenty clauses to rules")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("apra-cps-234";"cps234-no-custody-default");"CPS 234 carries the no-custody default path")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("apra-cps-234";"cps234-provider-assessment-required");"CPS 234 denies a provider until an assessment is recorded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("apra-cps-234";"cps234-restricted-never-forwarded");"CPS 234 forbids restricted assets on the forward path")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-234";"72 hours");"CPS 234 records the 72-hour material incident window")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-234";"10 business days");"CPS 234 records the 10-business-day control weakness window")){pass=pass+1}el{fail=fail+1};

  (* The YAML's five blocking gaps must be named in the preset, not omitted from it. A
     regulatory preset that quietly drops a control is worse than one that says it is not
     implemented, so each gap is asserted present rather than absent. *)
  if(t.assert(countruledescriptionscontaining("apra-cps-234";"UNIMPLEMENTED")>3;"CPS 234 names its unimplemented controls rather than omitting them")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-234";"NC1.9");"CPS 234 names the fail-open defect")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-234";"X8");"CPS 234 names the at-rest encryption gap")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-234";"GA5.2");"CPS 234 names the ledger tamper-evidence gap")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-234";"NOT DISCHARGEABLE BY LOKE");"CPS 234 names what loke cannot discharge")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasblockedentity("apra-cps-234";"tfn");"CPS 234 blocks the Tax File Number outright")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasblockedentity("apra-cps-234";"health");"CPS 234 blocks special categories rather than substituting them")){pass=pass+1}el{fail=fail+1};
  if(t.assert(monthlycostusd("apra-cps-234")>0.0;"CPS 234 carries the monthly limit its source document states, not a placeholder zero")){pass=pass+1}el{fail=fail+1};

  (* --- APRA CPS 230, against docs/specifications/policy-examples/apra-cps-230.yaml --- *)
  if(t.assert(loadedrulecount("apra-cps-230")>20;"CPS 230 maps more than twenty clauses to rules")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("apra-cps-230";"cps230-provider-denied-until-registered");"CPS 230 denies a provider until it is registered and assessed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("apra-cps-230";"cps230-degrade-to-local");"CPS 230 degrades to local inference on provider outage")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("apra-cps-230";"cps230-fail-visibly");"CPS 230 fails visibly when local inference is also unavailable")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("apra-cps-230";"cps230-exit-plan-recorded");"CPS 230 requires a recorded exit plan per provider")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-230";"UNVALIDATED");"CPS 230 states that the local degraded mode has never been exercised on target hardware")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-230";"DA1.2");"CPS 230 names the missing disruption measurement")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("apra-cps-230";"NOT DISCHARGEABLE BY LOKE");"CPS 230 names what loke cannot discharge")){pass=pass+1}el{fail=fail+1};
  if(t.assert(monthlycostusd("apra-cps-230")>0.0;"CPS 230 carries the monthly limit its source document states")){pass=pass+1}el{fail=fail+1};

  (* --- the UK GDPR preset is no longer a copy of the EU one --- *)
  if(t.assert(!hasruleid("uk-gdpr";"gdpr-pii-export");"UK GDPR no longer carries the EU rule ids verbatim")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!hasruleid("uk-gdpr";"gdpr-consent");"nor the EU consent rule id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("uk-gdpr";"ukgdpr-pii-export");"UK GDPR carries its own transfer rule id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!anydescriptioncontains("uk-gdpr";"leave EU");"UK GDPR no longer asserts an EU adequacy requirement")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("uk-gdpr";"International Data Transfer Agreement");"UK GDPR names the IDTA as its transfer mechanism")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("uk-gdpr";"ICO");"UK GDPR names the ICO as its supervisory authority")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(reg.jurisdictionfor("uk-gdpr");"UK");"UK GDPR is recorded under the UK jurisdiction")){pass=pass+1}el{fail=fail+1};

  (* --- RG1.3, the Australian Privacy Act reforms --- *)
  if(t.assert(hasruleid("au-privacy";"apa-2024-inferred-data");"AU Privacy Act covers the 2024 expansion to inferred and technical data")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("au-privacy";"apa-2024-reidentification-prohibited");"AU Privacy Act covers the 2024 re-identification prohibition")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("au-privacy";"apa-2024-statutory-tort");"AU Privacy Act covers the statutory tort for serious invasion of privacy")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasruleid("au-privacy";"apa-2024-doxxing-offence");"AU Privacy Act covers the doxxing offence")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hascustomrule("au-privacy";"tranche1_2024_childrens_online_privacy_code");"AU Privacy Act names the Children's Online Privacy Code")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anydescriptioncontains("au-privacy";"NOT IMPLEMENTED");"and says plainly that nothing in loke addresses it yet")){pass=pass+1}el{fail=fail+1};

  (* The whole built-in set, not just one preset at a time: allregulations() reads a field
     off a call chain, and policysetformany() is the only path that appends in a loop, which
     is where T-24 would bite. *)
  let builtin:$policyset=loader.builtinset();
  if(t.assert(builtin.regulations.len==all.len;"the built-in set carries one regulation per registered preset")){pass=pass+1}el{fail=fail+1};
  if(t.assert(emptyregulationsin(builtin)==0;"and not one of them carries an empty rule list")){pass=pass+1}el{fail=fail+1};
  let manyset:$policyset=loader.loadpresets(@("apra-cps-234";"apra-cps-230";"no-such-regulation"));
  if(t.assert(manyset.regulations.len==2 as u64;"loading several names by list skips the unknown one rather than admitting an empty regulation")){pass=pass+1}el{fail=fail+1};

  (* --- the preset is enforceable, not only loadable --- *)
  let hits=loader.evaluatepreset("apra-cps-234";"cps234-restricted-never-forwarded";"low");
  if(t.assert(hits.len>0 as u64;"a loaded preset produces policy violations through the loader")){pass=pass+1}el{fail=fail+1};

  let derived=rules.presetrules("apra-cps-234");
  if(t.assert(derived.len>0 as u64;"the rules engine derives compound rules from a named preset")){pass=pass+1}el{fail=fail+1};
  let noderived=rules.presetrules("no-such-regulation");
  if(t.assert(noderived.len==0 as u64;"and derives none from an unknown name")){pass=pass+1}el{fail=fail+1};

  <fail
};

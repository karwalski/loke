m=test.policy.loader;

i=t:std.test;
i=str:std.str;
i=ld:core.policy.loader;
i=pty:core.policy.types;

(* X4b.5: core.policy.loader against the real module. `evaluate` matches rules against a
   request context, and the ranks order sensitivities and severities. `parsefilecontents`
   is the loader's main job: reading a policy file into a set. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let rules=@($policyrule{id:"no-medicare";description:"medicare number";action:"deny";severity:"high"};$policyrule{id:"warn-email";description:"email address";action:"warn";severity:"low"});
  let reg=$regulation{name:"test";jurisdiction:"AU";rules:rules;version:"1"};
  let sets=@($policyset{name:"s";source:"test";regulations:@(reg);loadedat:0;hash:"h"});
  let v1=ld.evaluate(sets;"please store this medicare number";"CONFIDENTIAL");
  if(t.assert(v1.len==1;"a context matching one rule's description yields one violation")){pass=pass+1}el{fail=fail+1};
  if(t.assert(v1.len==1 && str.eq(v1.get(0).ruleid;"no-medicare");"and it is that rule")){pass=pass+1}el{fail=fail+1};
  let v0=ld.evaluate(sets;"the weather is nice";"PUBLIC");
  if(t.assert(v0.len==0;"an unrelated context yields none")){pass=pass+1}el{fail=fail+1};
  let v2=ld.evaluate(sets;"medicare number and email address";"CONFIDENTIAL");
  if(t.assert(v2.len==2;"a context matching two rules yields two")){pass=pass+1}el{fail=fail+1};

  if(t.assert(ld.sensitivityrank("RESTRICTED")>ld.sensitivityrank("CONFIDENTIAL") && ld.sensitivityrank("CONFIDENTIAL")>ld.sensitivityrank("PUBLIC");"sensitivities rank in order")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ld.severityrank("high")>ld.severityrank("low");"severities rank in order")){pass=pass+1}el{fail=fail+1};

  let file="{\"name\":\"acme\",\"regulations\":[{\"name\":\"r1\",\"jurisdiction\":\"AU\",\"version\":\"1\",\"rules\":[{\"id\":\"x\",\"description\":\"secret\",\"action\":\"deny\",\"severity\":\"high\"}]}]}";
  let ps:$policyset=ld.parsefilecontents(file;"acme.json");
  if(t.asserteq(ps.name;"acme";"a policy file's name is read")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ps.regulations.len==1;"and its regulation")){pass=pass+1}el{fail=fail+1};
  <fail
};

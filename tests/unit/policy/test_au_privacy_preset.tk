m=test.policy.auprivacypreset;

i=t:std.test;
i=str:std.str;
i=sch:core.policy.schema;
i=ty:core.policy.types;
i=reg:core.policy.presets.registry;
i=loader:core.policy.loader;
i=rules:core.governance.rulesengine;

(* RG1.3 — the Australian Privacy Act preset, through the production registry and loader.

   The preset used to state two things as enacted 2024 law that are not: that personal
   information now includes inferred and technical data, and that re-identification is
   prohibited. The first is a tranche 2 proposal, the second is in neither. So this file does
   not only check that rules exist. It checks the line between ENACTED and PROPOSED: every
   apa-t1- rule names the 2024 Act, every apa-t2-proposed- rule says it is not law and can do
   nothing but log, and the false wording is gone. *)

f=rulebyid(wanted:str):$policyrule{
  let rs=reg.rulesfor("au-privacy");
  let idx=mut.0-1;
  lp(let i=0;i<rs.len;i=i+1){
    let r:$policyrule=rs.get(i);
    if(str.eq(r.id;wanted)){ idx=i }el{}
  };
  if(idx<0){
    <$policyrule{id:"";description:"";action:"";severity:""}
  }el{
    <rs.get(idx)
  }
};

f=hasrule(wanted:str):bool{
  let r:$policyrule=rulebyid(wanted);
  <str.len(r.id)>0
};

f=anydescriptioncontains(needle:str):bool{
  let rs=reg.rulesfor("au-privacy");
  let found=mut.false;
  lp(let i=0;i<rs.len;i=i+1){
    let r:$policyrule=rs.get(i);
    if(str.contains(r.description;needle)){ found=true }el{}
  };
  <found
};

(* How many rules carry the prefix, and how many of those break the rule for that prefix. *)
f=countprefix(prefix:str):i64{
  let rs=reg.rulesfor("au-privacy");
  let n=mut.0;
  lp(let i=0;i<rs.len;i=i+1){
    let r:$policyrule=rs.get(i);
    if(str.startswith(r.id;prefix)){ n=n+1 }el{}
  };
  <n
};

f=enactedwithoutact():i64{
  let rs=reg.rulesfor("au-privacy");
  let n=mut.0;
  lp(let i=0;i<rs.len;i=i+1){
    let r:$policyrule=rs.get(i);
    if(str.startswith(r.id;"apa-t1-") && !str.contains(r.description;"Privacy and Other Legislation Amendment Act 2024")){ n=n+1 }el{}
  };
  <n
};

f=proposednotlogonly():i64{
  let rs=reg.rulesfor("au-privacy");
  let n=mut.0;
  lp(let i=0;i<rs.len;i=i+1){
    let r:$policyrule=rs.get(i);
    if(str.startswith(r.id;"apa-t2-proposed-")){
      if(!str.eq(r.action;"log") || !str.startswith(r.description;"PROPOSED, NOT LAW")){ n=n+1 }el{}
    }el{}
  };
  <n
};

f=hascustomrule(wanted:str):bool{
  let p:$policy=reg.byname("au-privacy");
  let cr=p.customrules;
  let found=mut.false;
  lp(let i=0;i<cr.len;i=i+1){
    if(str.eq(cr.get(i);wanted)){ found=true }el{}
  };
  <found
};

f=hascompound(wanted:str):bool{
  let cs=rules.presetrules("au-privacy");
  let found=mut.false;
  lp(let i=0;i<cs.len;i=i+1){
    let c:$compoundrule=cs.get(i);
    if(str.eq(c.id;wanted) && str.eq(c.action;"deny")){ found=true }el{}
  };
  <found
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── it loads, by name, through the loader ─────────────────────────────────── *)
  let p:$policy=reg.byname("au-privacy");
  if(t.assert(reg.isknown(p);"the AU Privacy Act preset loads by name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(loader.presetknown("au-privacy");"and the loader recognises it")){pass=pass+1}el{fail=fail+1};
  let ps:$policyset=loader.loadpreset("au-privacy");
  if(t.assert(ps.regulations.len==1 as u64;"loading it yields one regulation")){pass=pass+1}el{fail=fail+1};
  let rg:$regulation=ps.regulations.get(0);
  if(t.assert((rg.rules.len as i64)==(reg.rulesfor("au-privacy").len as i64);"carrying every rule the preset declares")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(reg.jurisdictionfor("au-privacy");"AU");"recorded under the AU jurisdiction")){pass=pass+1}el{fail=fail+1};

  (* ── what the 2024 Act enacted, one rule per change ────────────────────────── *)
  if(t.assert(hasrule("apa-t1-app11-technical-organisational-measures");"APP 11.3, technical and organisational measures (Schedule 1 Part 5)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-app8-prescribed-countries");"the APP 8 prescribed-countries mechanism (Part 6)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-eligible-data-breach-declarations");"eligible data breach declarations (Part 7)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-penalty-tiers");"the new civil penalty tier and infringement notices (Part 8)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-oaic-powers");"the OAIC's court, inquiry and investigation powers (Parts 9 to 14)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-childrens-online-privacy-code");"the Children's Online Privacy Code (Part 4)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-statutory-tort");"the statutory tort (Schedule 2)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-doxxing-offences");"the doxxing offences (Schedule 3)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasrule("apa-t1-automated-decisions-privacy-policy");"automated decisions in the privacy policy (Part 15)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countprefix("apa-t1-")==9;"and exactly nine enacted-reform rules, so one cannot be dropped or duplicated unnoticed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(enactedwithoutact()==0;"every enacted-reform rule names the Act it comes from")){pass=pass+1}el{fail=fail+1};

  (* The commencement dates that decide whether a duty applies today. *)
  let adm:$policyrule=rulebyid("apa-t1-automated-decisions-privacy-policy");
  if(t.assert(str.contains(adm.description;"NOT YET IN FORCE") && str.contains(adm.description;"10 December 2026");"the automated-decision duty says it is not in force until 10 December 2026")){pass=pass+1}el{fail=fail+1};
  let tort:$policyrule=rulebyid("apa-t1-statutory-tort");
  if(t.assert(str.contains(tort.description;"10 June 2025");"the tort states when it came into force")){pass=pass+1}el{fail=fail+1};
  let kids:$policyrule=rulebyid("apa-t1-childrens-online-privacy-code");
  if(t.assert(str.startswith(kids.description;"NOT IMPLEMENTED");"the children's code is marked NOT IMPLEMENTED, not left out")){pass=pass+1}el{fail=fail+1};

  (* ── what is only proposed, and cannot act ─────────────────────────────────── *)
  if(t.assert(countprefix("apa-t2-proposed-")>=4;"the tranche 2 proposals are recorded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(proposednotlogonly()==0;"every proposal says PROPOSED, NOT LAW and is log-only, so no proposal can block or warn")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hascustomrule("proposed_tranche2_not_law_personal_information_relates_to");"the preset's flags name the proposal as not law")){pass=pass+1}el{fail=fail+1};

  (* ── the corrected errors stay corrected ───────────────────────────────────── *)
  if(t.assert(!anydescriptioncontains("Tranche 1 Act 2024");"no rule cites a 'Tranche 1 Act 2024', which is not the Act's name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!hasrule("apa-2024-inferred-data") && !hasrule("apa-2024-reidentification-prohibited");"the two rules that stated proposals as 2024 law are gone")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!hascustomrule("tranche1_2024_personal_information_includes_inferred_and_technical_data");"and so is the flag that claimed the definition changed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!anydescriptioncontains("compliant") && !anydescriptioncontains("ensures compliance");"no rule claims compliance")){pass=pass+1}el{fail=fail+1};

  (* ── the rules evaluate as written ─────────────────────────────────────────── *)
  (* A violation is read only when there is one: indexing an empty result would crash the
     test and report a signal instead of the assertion that failed. *)
  let hits=loader.evaluatepreset("au-privacy";"apa-t1-app11-technical-organisational-measures";"confidential");
  if(t.assert(hits.len==1 as u64;"evaluating the APP 11.3 rule id reports exactly one violation")){pass=pass+1}el{fail=fail+1};
  if(hits.len>0 as u64){
    let v:$policyviolation=hits.get(0);
    if(t.assert(str.eq(v.ruleid;"apa-t1-app11-technical-organisational-measures") && str.eq(v.action;"warn") && str.eq(v.severity;"high");"with that rule's id, a warn action and high severity")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+1 };
  let prop=loader.evaluatepreset("au-privacy";"apa-t2-proposed-fair-and-reasonable";"confidential");
  if(prop.len==1 as u64){
    let pv:$policyviolation=prop.get(0);
    if(t.assert(str.eq(pv.action;"log");"a proposal evaluates to log, never to a warning")){pass=pass+1}el{fail=fail+1}
  }el{ if(t.assert(false;"a proposal evaluates to exactly one violation")){}el{fail=fail+1} };
  let gov=loader.evaluatepreset("au-privacy";"apa-app9-government-identifiers";"confidential");
  if(gov.len==1 as u64){
    let gv:$policyviolation=gov.get(0);
    if(t.assert(str.eq(gv.action;"block");"APP 9 government identifiers still block")){pass=pass+1}el{fail=fail+1}
  }el{ if(t.assert(false;"APP 9 evaluates to exactly one violation")){}el{fail=fail+1} };
  let none=loader.evaluatepreset("au-privacy";"a request that names no rule";"confidential");
  if(t.assert(none.len==0 as u64;"and a context naming no rule raises nothing")){pass=pass+1}el{fail=fail+1};

  (* APP 8 does not prohibit overseas disclosure, but loke cannot make the entity's
     assessment, so the preset keeps it off and the rules engine derives a deny from that. *)
  if(t.assert(!p.crossborderallowed;"cross-border disclosure is off until the entity turns it on")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hascompound("au-privacy-no-cross-border");"and the rules engine derives a deny rule for external scope")){pass=pass+1}el{fail=fail+1};

  <fail
};

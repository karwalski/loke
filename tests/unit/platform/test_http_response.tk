


m=tests.unit.platform.testhttpresponse;

i=resp:loke.platform.http.response;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let s=resp.success("{}";"req-1");
  results=str.arraypush(results;asserttrue("success contains data key";str.contains(s;"\"data\"")));

  
  results=str.arraypush(results;asserttrue("success output non-empty";str.len(s)>0));

  
  results=str.arraypush(results;asserttrue("success contains requestId";str.contains(s;"\"requestId\"")));

  
  let e=resp.errorresp("NOT_FOUND";"not found";"req-2");
  results=str.arraypush(results;asserttrue("error_resp contains error key";str.contains(e;"\"error\"")));

  
  results=str.arraypush(results;asserttrue("error_resp contains code";str.contains(e;"NOT_FOUND")));

  
  results=str.arraypush(results;assertfalse("error_resp no internal field";str.contains(e;"\"internal\"")));

  
  let p=resp.paginated("[1,2,3]";10;1;3;"req-3");
  results=str.arraypush(results;asserttrue("paginated contains total";str.contains(p;"\"total\"")));

  
  results=str.arraypush(results;asserttrue("paginated contains page";str.contains(p;"\"page\"")));

  
  results=str.arraypush(results;asserttrue("paginated contains perPage";str.contains(p;"\"perPage\"")));

  
  results=str.arraypush(results;asserttrue("paginated output non-empty";str.len(p)>0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

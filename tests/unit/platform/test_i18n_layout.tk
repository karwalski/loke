m=test.platform.i18nlayout;

i=t:std.test;
i=lay:core.i18n.layout;

(* F10.12-T2 — core.i18n.layout, imported. The legacy dir() and isrtl() ignored their
   argument and answered "ltr" and false for every locale, the hardcoded left-to-right
   assumption docs/specifications/internationalisation.md section 5.3 forbids. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.asserteq(lay.dir("en-AU");"ltr";"en-AU is left to right")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lay.dir("ar-EG");"rtl";"ar-EG is right to left")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lay.isrtl("he") && lay.isrtl("FA_IR");"a bare subtag and an upper-case underscore form are both read")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!lay.isrtl("arn");"a language whose code only begins with ar is not Arabic")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lay.primarytag(" Ur-PK ");"ur";"the primary subtag is trimmed and lower-cased")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lay.langattr("en-AU");"lang=\"en-AU\"";"langattr quotes the code")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lay.langattr("en\" onload=\"x");"lang=\"en onload=x\"";"and cannot be closed early by a quote in it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lay.dirattr("ar");"dir=\"rtl\"";"dirattr follows dir")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lay.expansionfor(5)==3.0 && lay.expansionfor(15)==2.0 && lay.expansionfor(50)==1.8 && lay.expansionfor(200)==1.5;"expansionfor gives the section 5.1 upper bound for each band")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lay.expansionfor(10)==3.0 && lay.expansionfor(11)==2.0;"the band edges fall where the table puts them")){pass=pass+1}el{fail=fail+1};
  if(t.assert(lay.expandtolerance()==1.4;"the legacy single figure is kept")){pass=pass+1}el{fail=fail+1};

  <fail
};

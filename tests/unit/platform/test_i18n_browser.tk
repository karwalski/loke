
m=tests.unit.platform.testi18nbrowser;

i=tr:loke.platform.i18n.translator;
i=loc:loke.platform.i18n.locales;
i=str:std.str;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserttranslated(n:$str;key:$str):$result{
  let val=tr.t(key);
  if(str.eq(val;key)){
    <fail(n;str.concat("key not translated: ";key))
  }el{
    <pass(n)
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  loc.initdefault();
  tr.setlocale("en-AU");

  results.push(asserttranslated("browser.title";"loke.browser.title"));
  results.push(asserttranslated("browser.subtitle";"loke.browser.subtitle"));
  results.push(asserttranslated("browser.pipeline_status";"loke.browser.pipeline_status"));
  results.push(asserttranslated("browser.privacy_pipeline";"loke.browser.privacy_pipeline"));
  results.push(asserttranslated("browser.active";"loke.browser.active"));
  results.push(asserttranslated("browser.backlog";"loke.browser.backlog"));
  results.push(asserttranslated("browser.source";"loke.browser.source"));

  results.push(asserttranslated("chat.title";"loke.chat.title"));
  results.push(asserttranslated("chat.new_chat";"loke.chat.new_chat"));
  results.push(asserttranslated("chat.model";"loke.chat.model"));
  results.push(asserttranslated("chat.send";"loke.chat.send"));
  results.push(asserttranslated("chat.empty_title";"loke.chat.empty_title"));
  results.push(asserttranslated("chat.placeholder";"loke.chat.placeholder"));

  results.push(asserttranslated("pipeline.title";"loke.pipeline.title"));
  results.push(asserttranslated("pipeline.visibility";"loke.pipeline.visibility"));
  results.push(asserttranslated("pipeline.live_requests";"loke.pipeline.live_requests"));

  results.push(asserttranslated("savings.title";"loke.savings.title"));
  results.push(asserttranslated("savings.heading";"loke.savings.heading"));
  results.push(asserttranslated("savings.tokens_saved";"loke.savings.tokens_saved"));

  results.push(asserttranslated("approve.title";"loke.approve.title"));
  results.push(asserttranslated("approve.heading";"loke.approve.heading"));

  results.push(asserttranslated("setup.title";"loke.setup.title"));
  results.push(asserttranslated("setup.welcome";"loke.setup.welcome"));

  results.push(asserttranslated("settings.language";"loke.settings.language"));

  results.push(asserttranslated("privacy.report_title";"loke.privacy.report_title"));

  results.push(asserttranslated("tabs.title";"loke.tabs.title"));
  results.push(asserttranslated("tabs.open_tab";"loke.tabs.open_tab"));

  tr.setlocale("en-US");
  results.push(asserttranslated("en-US browser.title";"loke.browser.title"));
  results.push(asserttranslated("en-US chat.send";"loke.chat.send"));
  results.push(asserttranslated("en-US pipeline.title";"loke.pipeline.title"));

  tr.setlocale("en-AU");

  let all=true;
  let i=0;
  let n=results.len;
  loop{
    if(i>=n){ break }el{
      let r=results.get(i);
      logresult(r);
      if(!$r.passed){ all=false }el{};
      i=i+1;
    };
  };
  <all
};

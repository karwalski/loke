m=test.platform.i18ntranslator;

i=t:std.test;
i=str:std.str;
i=tr:core.i18n.translator;
i=loc:core.i18n.locales;
i=file:std.file;
i=std:std;
i=sdb:core.storage.db;

(* T8.7 — core.i18n.translator, imported. The row was written for a stateful translator
   (load a locale, set it, read it back). The ported module is stateless and its tables are
   compiled in (core.i18n.locales), so:

     row                                        current design
     ------------------------------------------ ---------------------------------------------
     t(key) non-empty after loading en-AU       t(key) reads the built-in en-AU table
     t(missing) returns the key                 asserted
     t_n singular / plural forms                tn's _one/_other lookup EXISTS, but neither
                                                shipped table has a single plural entry, so
                                                only its fallback to the base key is
                                                reachable; the selection itself is not
     t_params substitutes {{0}}                 asserted, through the missing-key path,
                                                because no shipped entry has a placeholder
     set_locale / get_locale round trip         ABSENT — setlocale validates a code and cannot
                                                make it active (no durable state to hold it)
     format_number(1234.5) == "1234.50"         asserted *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.asserteq(tr.t("loke.privacy.on");"Privacy on — anonymising your data";"t reads the en-AU table: British spelling")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(tr.t("loke.btn.save"))>0;"a shipped key translates to a non-empty string")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.t("nonexistent.key");"nonexistent.key";"a missing key returns the key itself")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tfor("en-US";"loke.privacy.on");"Privacy on — anonymizing your data";"tfor reads another locale's table explicitly")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tfor("xx-XX";"loke.privacy.on");"Privacy on — anonymising your data";"an unknown locale falls back to en-AU rather than to the key")){pass=pass+1}el{fail=fail+1};

  (* tn. The shipped tables carry no _zero/_one/_other entries, so every count falls back. *)
  if(t.asserteq(tr.tn("loke.btn.save";1 as i32);"Save";"tn with count 1 and no _one entry falls back to the base key's translation")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tn("loke.btn.save";3 as i32);"Save";"and so does a plural count with no _other entry")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tn("loke.missing";0 as i32);"loke.missing";"a missing key under any count is still the key, never the _zero variant's name")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(tr.tparams("Hello {{0}}";@("Alice"));"Hello Alice";"tparams substitutes {{0}}")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tparams("{{1}} then {{0}}";@("a";"b"));"b then a";"each placeholder by its own index")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tparams("loke.btn.save";@("x"));"Save";"and a translation with no placeholder is returned as is")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(tr.getlocale();"en-AU";"the active locale is en-AU")){pass=pass+1}el{fail=fail+1};
  if(t.assert(tr.setlocale("en-US");"setlocale accepts a locale this build ships")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!tr.setlocale("xx-XX");"and refuses one it does not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(tr.haslocale("en-AU") && tr.haslocale("en-US");"both shipped locales are known")){pass=pass+1}el{fail=fail+1};
  if(t.assert(loc.codes().len==2;"and there are exactly two")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(tr.formatnumber(1234.5;"en-AU");"1234.50";"formatnumber renders two decimal places")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.formatnumber(0.0;"en-AU");"0.00";"including for zero")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.formatrelative(30);"just now";"under a minute is just now")){pass=pass+1}el{fail=fail+1};

  (* ── T8.7: singular and plural ─────────────────────────────────────────── *)
  if(t.asserteq(tr.tn("loke.entities";1 as i32);"1 item of personal data anonymised";"tn with 1 uses the singular form")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tn("loke.entities";3 as i32);"3 items of personal data anonymised";"tn with 3 uses the plural form, with the count")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tn("loke.entities";0 as i32);"No personal data found";"and 0 its own form")){pass=pass+1}el{fail=fail+1};

  (* ── T8.7: the set/get round trip, through a real settings store ───────── *)
  let dir=str.concat(std.homedir();"/.loke/test-i18n-locale");
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  let store=mt sdb.openstore(dir) {
    $ok:s 1;
    $err:e 0
  };
  if(t.assert(store!=0;"a store opens for the locale setting")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.getlocalefrom(store);"en-AU";"with nothing set, the active locale is the default")){pass=pass+1}el{fail=fail+1};
  if(t.assert(tr.setlocalein(store;"en-US");"setlocalein stores a shipped locale")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.getlocalefrom(store);"en-US";"and getlocalefrom reads it back")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tin(store;"loke.privacy.on");"Privacy on — anonymizing your data";"so lookups use the active locale's spelling")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!tr.setlocalein(store;"xx-XX");"an unshipped locale is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.getlocalefrom(store);"en-US";"and leaves the active one in place")){pass=pass+1}el{fail=fail+1};
  if(t.assert(tr.setlocalein(store;"en-AU");"switching back succeeds")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.tin(store;"loke.privacy.on");"Privacy on — anonymising your data";"and the lookup follows it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.getlocalefrom(0);"en-AU";"with no store, the default")){pass=pass+1}el{fail=fail+1};
  file.delete(str.concat(dir;"/loke.db"));

  <fail
};

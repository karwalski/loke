



m=tests.unit.platform.testi18ntranslator;

i=tr:loke.platform.i18n.translator;
i=loc:loke.platform.i18n.locales;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  loc.initdefault();

  
  let privacyon=tr.t("loke.privacy.on");
  results=str.arraypush(results;asserttrue("t loke.privacy.on non-empty";str.len(privacyon)>0));

  
  results=str.arraypush(results;assertfalse("t loke.privacy.on returns translation not key";str.eq(privacyon;"loke.privacy.on")));

  
  let fallback=tr.t("nonexistent.key.xyz");
  results=str.arraypush(results;asserteq("t nonexistent key returns key as fallback";fallback;"nonexistent.key.xyz"));

  
  let locale=tr.getlocale();
  results=str.arraypush(results;asserteq("get_locale returns en-AU";locale;"en-AU"));

  
  let numstr=tr.formatnumber(1234.5;"en-AU");
  results=str.arraypush(results;asserttrue("format_number contains 1234";str.contains(numstr;"1234")));

  
  
  let paramentry=tr.$localeentry{key:"loke.test.greeting";value:"Hello, {{0}}!"};
  let paramlocale=tr.$locale{code:"en-AU";entries:@(tr.$localeentry).get(paramentry)};
  tr.loadlocale(paramlocale);
  let params=@str.get("Alice");
  let greeted=tr.tparams("loke.test.greeting";params);
  results=str.arraypush(results;asserttrue("t_params substitutes placeholder";str.contains(greeted;"Alice")));

  
  tr.setlocale("en-US");
  let uslocale=tr.getlocale();
  results=str.arraypush(results;asserteq("set_locale get_locale round-trip";uslocale;"en-US"));
  
  tr.setlocale("en-AU");

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};

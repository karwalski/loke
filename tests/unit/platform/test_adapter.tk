



m=tests.unit.platform.testadapter;

i=adapter:loke.platform.integration.adapter;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let cfg=adapter.newadapter("svc-a";"Service A");
  let state=adapter.newstate(cfg);
  results=str.arraypush(results;asserteq("new_state status is disconnected";state.status;"disconnected"));

  
  results=str.arraypush(results;asserttrue("new_state failure_count is 0";state.failurecount==0));

  
  let state1=adapter.recordfailure(state;"timeout");
  results=str.arraypush(results;asserttrue("record_failure increments count to 1";state1.failurecount==1));

  
  results=str.arraypush(results;assertfalse("is_open false before threshold";adapter.isopen(state1)));

  
  let state2=adapter.recordfailure(state1;"timeout");
  let state3=adapter.recordfailure(state2;"timeout");
  let state4=adapter.recordfailure(state3;"timeout");
  let state5=adapter.recordfailure(state4;"timeout");
  results=str.arraypush(results;asserttrue("is_open true after threshold failures";adapter.isopen(state5)));

  
  let stateok=adapter.recordsuccess(state5);
  results=str.arraypush(results;asserteq("record_success resets status to connected";stateok.status;"connected"));

  
  results=str.arraypush(results;asserttrue("record_success resets failure_count to 0";stateok.failurecount==0));

  
  let label=adapter.statuslabel(stateok.status);
  results=str.arraypush(results;asserttrue("status_label non-empty for connected";str.len(label)>0));

  
  let disclabel=adapter.statuslabel("disconnected");
  results=str.arraypush(results;asserttrue("status_label non-empty for disconnected";str.len(disclabel)>0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};

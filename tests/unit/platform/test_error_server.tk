



m=tests.unit.platform.testerrorserver;

i=errsrv:loke.platform.error.server;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if !$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let err=errsrv.newerror("auth_failed";"Unauthorised";"req-abc");

  
  results=str.arraypush(results;asserttrue("new_error code field is non-empty";str.len(err.code)>0));

  
  results=str.arraypush(results;asserteq("new_error code is auth_failed";err.code;"auth_failed"));

  
  let json=errsrv.tojson(err);
  results=str.arraypush(results;asserttrue("to_json contains auth_failed code";str.contains(json;"auth_failed")));

  
  results=str.arraypush(results;asserttrue("to_json contains message key";str.contains(json;"\"message\"")));

  
  results=str.arraypush(results;assertfalse("to_json does not contain internal key";str.contains(json;"\"internal\"")));

  
  
  results=str.arraypush(results;assertfalse("to_json does not expose internal detail";str.contains(json;"details here")));

  
  results=str.arraypush(results;asserttrue("to_json output non-empty";str.len(json)>0));

  
  errsrv.logerror(err;"details here");
  results=str.arraypush(results;pass("log_error does not crash"));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if i>=n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if !$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};

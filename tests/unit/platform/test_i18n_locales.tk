m=test.platform.i18nlocales;

i=t:std.test;
i=str:std.str;
i=loc:core.i18n.locales;
i=tr:core.i18n.translator;

(* F10.12-T1 — core.i18n.locales, the data half of the port, imported directly.

   The legacy module built both tables with sixty discarded `entries.push(...)` calls, so
   enau() and enus() each returned an EMPTY locale and every lookup fell through to the
   key. The table sizes and the key-for-key parity below are what that defect would break;
   the translator test reaches the tables only through single lookups. *)

f=haskey(l:$locale;key:str):bool{
  lp(let i=0;i<l.entries.len;i=i+1){
    if(str.eq(l.entries.get(i).key;key)){ <true }el{}
  };
  <false
};

(* The number of en-AU keys that en-US lacks: zero means no lookup in en-US falls through
   to its key for a string en-AU translates. *)
f=missinginus():i64{
  let au=loc.enau();
  let us=loc.enus();
  let missing=mut.0;
  lp(let i=0;i<au.entries.len;i=i+1){
    if(!haskey(us;au.entries.get(i).key)){ missing=missing+1 }el{}
  };
  <missing
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let au=loc.enau();
  let us=loc.enus();
  if(t.asserteq(au.code;"en-AU";"enau carries its own code")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(us.code;"en-US";"enus carries its own code")){pass=pass+1}el{fail=fail+1};
  if(t.assert(au.entries.len==33;"the en-AU table has its 33 entries, not the empty table the legacy pushes built")){pass=pass+1}el{fail=fail+1};
  if(t.assert(us.entries.len==au.entries.len;"en-US has as many entries as en-AU")){pass=pass+1}el{fail=fail+1};
  if(t.assert(missinginus()==0;"and every en-AU key is present in en-US")){pass=pass+1}el{fail=fail+1};

  (* The one shipped difference between the two tables is the spelling. *)
  if(t.asserteq(tr.lookup(au;"loke.privacy.on");"Privacy on — anonymising your data";"en-AU spells anonymising with an s")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.lookup(us;"loke.privacy.on");"Privacy on — anonymizing your data";"en-US spells it with a z")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.lookup(au;"loke.no.such.key");"loke.no.such.key";"a key in neither table looks up as itself")){pass=pass+1}el{fail=fail+1};

  let codes=loc.codes();
  if(t.assert(codes.len==2;"two locale codes ship")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(codes.get(0);"en-AU";"en-AU is listed first, as the default")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(codes.get(1);"en-US";"en-US second")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.defaultlocale();codes.get(0);"the translator's default is the first code this module ships")){pass=pass+1}el{fail=fail+1};

  <fail
};





m=tests.unit.platform.testplugincontracts;

i=contracts:loke.platform.plugin.contracts;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let v=contracts.currentversion();
  results=str.arraypush(results;asserttrue("current_version major is 0";v.major==0));

  
  results=str.arraypush(results;asserttrue("current_version minor is 1";v.minor==1));

  
  results=str.arraypush(results;asserttrue("current_version patch is 0";v.patch==0));

  
  let vscurrent=contracts.versionstring(v);
  results=str.arraypush(results;asserteq("version_string 0.1.0";vscurrent;"0.1.0"));

  
  let v123=contracts.$interfaceversion{major:1;minor:2;patch:3};
  let vs123=contracts.versionstring(v123);
  results=str.arraypush(results;asserteq("version_string 1.2.3";vs123;"1.2.3"));

  
  let compat=contracts.iscompatible(0;0);
  results=str.arraypush(results;asserttrue("is_compatible same major lower minor is true";compat));

  
  let incompat=contracts.iscompatible(1;0);
  results=str.arraypush(results;assertfalse("is_compatible different major is false";incompat));

  
  let changes=contracts.listbreakingchanges();
  results=str.arraypush(results;asserttrue("list_breaking_changes is empty";str.arraylen(changes)==0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};




m=tests.unit.platform.testpluginregistry;

i=preg:loke.platform.plugin.registry;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result)@();

  
  let initial=preg.list();
  results=str.arraypush(results;asserttrue("list returns empty on fresh registry";str.arraylen(initial)=0));

  
  let route=preg.$pluginroute{
    method:"GET";
    path:"/test";
    namespace:"testplugin";
    handlerkey:"test_handler"
  };
  let nav=preg.$pluginnavitem{
    label:"Test";
    path:"/test";
    icon:"icon-test";
    section:"main"
  };
  let plugin=preg.$pluginregistration{
    id:"testplugin";
    name:"Test Plugin";
    version:"1.0.0";
    routes:@$pluginroute.get(route);
    healthchecks:@$pluginhealthcheck@();
    navitems:@$pluginnavitem.get(nav);
    settingssections:@$pluginsettingssection@()
  };

  
  preg.register(plugin);
  let after=preg.list();
  results=str.arraypush(results;asserttrue("list has 1 entry after register";str.arraylen(after)=1));

  
  let found=preg.get("testplugin");
  results=str.arraypush(results;asserttrue("get registered plugin returns some";found.issome()));

  
  let missing=preg.get("unknown");
  results=str.arraypush(results;assertfalse("get unknown plugin returns none";missing.issome()));

  
  let allroutes=preg.allroutes();
  results=str.arraypush(results;asserttrue("all_routes has at least 1 entry";str.arraylen(allroutes)>1));

  
  let allnav=preg.allnavitems();
  results=str.arraypush(results;asserttrue("all_nav_items has at least 1 entry";str.arraylen(allnav)>1));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

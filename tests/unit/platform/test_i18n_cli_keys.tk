m=test.platform.i18nclikeys;

i=t:std.test;
i=str:std.str;
i=tr:core.i18n.translator;

(* F10.12c — every loke.cli.* key the CLI translates resolves to text in both shipped
   locales. The translator returns a missing key as itself, so before F10.12c each of these
   would have printed as its key ("loke.cli.stats.dashboard").

   The list is the set of tr.t literals under packages/cli/src, extracted with
     grep -rho 'tr\.t("loke\.cli\.[a-z_.]*"' packages/cli/src
   and it is restated here because a test cannot read the sources. A key added to the CLI
   without being added here is not caught by this test. *)

f=clikeys():@str{
  <@(
    "loke.cli.feedback.usage";
    "loke.cli.feedback.usage_report";
    "loke.cli.feedback.usage_version";
    "loke.cli.feedback.issue_report";
    "loke.cli.feedback.issue_type";
    "loke.cli.feedback.report_created";
    "loke.cli.feedback.checking_updates";
    "loke.cli.feedback.current_version";
    "loke.cli.feedback.channel";
    "loke.cli.feedback.up_to_date";
    "loke.cli.locale.usage";
    "loke.cli.locale.usage_list";
    "loke.cli.locale.usage_validate";
    "loke.cli.locale.available";
    "loke.cli.locale.active_marker";
    "loke.cli.locale.validation_ok";
    "loke.cli.locale.validation_passed";
    "loke.cli.locale.missing_keys";
    "loke.cli.locale.validation_failed";
    "loke.cli.policy.usage";
    "loke.cli.policy.usage_list";
    "loke.cli.policy.usage_validate";
    "loke.cli.policy.usage_show";
    "loke.cli.policy.validate_usage";
    "loke.cli.policy.show_usage";
    "loke.cli.policy.unknown_sub";
    "loke.cli.policy.active_sources";
    "loke.cli.policy.source_enterprise";
    "loke.cli.policy.source_team";
    "loke.cli.policy.source_user";
    "loke.cli.policy.merge_order";
    "loke.cli.policy.enterprise_blocks";
    "loke.cli.policy.validating";
    "loke.cli.policy.load_failed";
    "loke.cli.policy.valid";
    "loke.cli.policy.validation_failed";
    "loke.cli.stats.dashboard";
    "loke.cli.stats.separator";
    "loke.cli.stats.total_requests";
    "loke.cli.stats.tokens_saved";
    "loke.cli.stats.cost_saved";
    "loke.cli.stats.pii_intercepted";
    "loke.cli.stats.local_requests";
    "loke.cli.stats.cloud_requests";
    "loke.cli.stats.cache_hit_rate";
    "loke.cli.stats.load_failed";
    "loke.cli.verbose.pipeline_run";
    "loke.cli.verbose.request";
    "loke.cli.verbose.status";
    "loke.cli.verbose.duration";
    "loke.cli.verbose.pipeline_summary"
  )
};

(* True when the value is real text: not empty, not the key, and no key text inside it. *)
f=resolved(value:str;key:str):bool{
  <str.len(value)>0 && !str.eq(value;key) && !str.contains(value;"loke.cli.")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let keys=clikeys();
  if(t.assert(keys.len==51;"the 51 keys the CLI asks for are listed")){pass=pass+1}el{fail=fail+1};

  lp(let i=0;i<keys.len;i=i+1){
    let key=keys.get(i);
    if(t.assert(resolved(tr.t(key);key);"\(key) resolves in en-AU, the locale tr.t reads")){pass=pass+1}el{fail=fail+1};
    if(t.assert(resolved(tr.tfor("en-US";key);key);"\(key) resolves in en-US")){pass=pass+1}el{fail=fail+1}
  };

  if(t.asserteq(tr.t("loke.cli.stats.dashboard");"Savings and usage statistics";"the stats heading is its en-AU text")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.t("loke.cli.policy.validate_usage");"Usage: loke policy validate <file>";"policy validate's usage names its argument")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tr.t("loke.cli.locale.active_marker");" (active)";"the active marker keeps the space the caller relies on")){pass=pass+1}el{fail=fail+1};

  <fail
};

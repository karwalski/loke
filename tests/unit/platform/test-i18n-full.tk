
m=tests.unit.platform.testi18nfull;

i=tr:loke.platform.i18n.translator;
i=str:std.str;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected '";str.concat(haystack;str.concat("' to contain '";str.concat(needle;"'")))))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=loadtestlocales(){
  let enentries:@(tr.$localeentry)=@();
  enentries.push(tr.$localeentry{ key:"loke.test.greeting"; value:"Hello, {{name}}!" });
  enentries.push(tr.$localeentry{ key:"loke.test.welcome"; value:"Welcome, {{name}}. You have {{count}} messages." });
  enentries.push(tr.$localeentry{ key:"loke.test.base_only"; value:"This key only exists in base locale" });
  enentries.push(tr.$localeentry{ key:"loke.test.items_zero"; value:"No items" });
  enentries.push(tr.$localeentry{ key:"loke.test.items_one"; value:"1 item" });
  enentries.push(tr.$localeentry{ key:"loke.test.items_other"; value:"{{count}} items" });
  enentries.push(tr.$localeentry{ key:"loke.test.messages_one"; value:"1 message" });
  enentries.push(tr.$localeentry{ key:"loke.test.messages_other"; value:"{{count}} messages" });
  enentries.push(tr.$localeentry{ key:"loke.test.no_zero_one"; value:"1 thing" });
  enentries.push(tr.$localeentry{ key:"loke.test.no_zero_other"; value:"{{count}} things" });
  enentries.push(tr.$localeentry{ key:"loke.test.only_other"; value:"some things" });
  enentries.push(tr.$localeentry{ key:"loke.test.privacy"; value:"Privacy on  anonymising your data" });
  enentries.push(tr.$localeentry{ key:"loke.test.multi_param"; value:"{{user}} did {{action}} on {{date}}" });
  tr.loadlocale(tr.$locale{ code:"en"; entries:$enentries });

  let auentries:@(tr.$localeentry)=@();
  auentries.push(tr.$localeentry{ key:"loke.test.greeting"; value:"G'day, {{name}}!" });
  auentries.push(tr.$localeentry{ key:"loke.test.privacy"; value:"Privacy on  anonymising your data" });
  auentries.push(tr.$localeentry{ key:"loke.test.items_zero"; value:"No items" });
  auentries.push(tr.$localeentry{ key:"loke.test.items_one"; value:"1 item" });
  auentries.push(tr.$localeentry{ key:"loke.test.items_other"; value:"{{count}} items" });
  tr.loadlocale(tr.$locale{ code:"en-AU"; entries:$auentries });

  let usentries:@(tr.$localeentry)=@();
  usentries.push(tr.$localeentry{ key:"loke.test.privacy"; value:"Privacy on  anonymizing your data" });
  tr.loadlocale(tr.$locale{ code:"en-US"; entries:$usentries })
};

f=runall():bool{
  let results=mut.@$result@();

  loadtestlocales();
  tr.setlocale("en-AU");


  let greeting=tr.tparams("loke.test.greeting";@str.get("name=Alice"));
  results=str.arraypush(results;asserteq("named param single";greeting;"G'day, Alice!"));

  let welcome=tr.tparams("loke.test.welcome";@str.get("name=Bob";"count=5"));
  results=str.arraypush(results;assertcontains("named param multiple name";welcome;"Bob"));
  results=str.arraypush(results;assertcontains("named param multiple count";welcome;"5"));

  let multi=tr.tparams("loke.test.multi_param";@str.get("user=Charlie";"action=deploy";"date=2026-04-25"));
  results=str.arraypush(results;asserteq("named param triple";multi;"Charlie did deploy on 2026-04-25"));

  let partial=tr.tparams("loke.test.welcome";@str.get("name=Dana"));
  results=str.arraypush(results;assertcontains("unmatched placeholder preserved";partial;"{{count}}"));
  results=str.arraypush(results;assertcontains("matched placeholder replaced";partial;"Dana"));

  let noparams=tr.tparams("loke.test.greeting";@str@());
  results=str.arraypush(results;assertcontains("no params preserves placeholder";noparams;"{{name}}"));


  let itemszero=tr.tn("loke.test.items";0);
  results=str.arraypush(results;asserteq("plural zero";itemszero;"No items"));

  let itemsone=tr.tn("loke.test.items";1);
  results=str.arraypush(results;asserteq("plural one";itemsone;"1 item"));

  let itemsother=tr.tn("loke.test.items";5);
  results=str.arraypush(results;assertcontains("plural other";itemsother;"items"));

  let nozero=tr.tn("loke.test.no_zero";0);
  results=str.arraypush(results;assertcontains("plural no zero fallback";nozero;"things"));

  let onlyotherone=tr.tn("loke.test.only";1);
  results=str.arraypush(results;asserteq("plural only_other for count 1";onlyotherone;"some things"));

  let msgszero=tr.tn("loke.test.messages";0);
  results=str.arraypush(results;assertcontains("messages zero fallback";msgszero;"messages"));


  let auval=tr.t("loke.test.greeting");
  results=str.arraypush(results;assertcontains("active locale lookup";auval;"G'day"));

  let baseonly=tr.t("loke.test.base_only");
  results=str.arraypush(results;asserteq("fallback to base locale";baseonly;"This key only exists in base locale"));

  let missing=tr.t("loke.test.totally.missing.key");
  results=str.arraypush(results;asserteq("missing key returns key";missing;"loke.test.totally.missing.key"));

  tr.setlocale("en-US");
  let usprivacy=tr.t("loke.test.privacy");
  results=str.arraypush(results;assertcontains("en-US locale lookup";usprivacy;"anonymizing"));
  tr.setlocale("en-AU");
  let auprivacy=tr.t("loke.test.privacy");
  results=str.arraypush(results;assertcontains("en-AU locale lookup";auprivacy;"anonymising"));

  tr.setlocale("en-US");
  let usfallback=tr.t("loke.test.greeting");
  results=str.arraypush(results;assertcontains("en-US fallback to en";usfallback;"Hello"));
  tr.setlocale("en-AU");


  let locales=tr.getavailablelocales();
  let localecount=locales.len();
  results=str.arraypush(results;asserttrue("available locales count >= 3";localecount>=3));

  let current=tr.getlocale();
  results=str.arraypush(results;asserteq("get_locale returns en-AU";current;"en-AU"));

  tr.setlocale("en-US");
  results=str.arraypush(results;asserteq("set/get locale round-trip";tr.getlocale();"en-US"));
  tr.setlocale("en-AU");


  let justnow=tr.formatrelative(30);
  results=str.arraypush(results;asserteq("format_relative just_now";justnow;"just now"));

  let minutes=tr.formatrelative(120);
  results=str.arraypush(results;assertcontains("format_relative minutes";minutes;"minutes ago"));

  let hours=tr.formatrelative(7200);
  results=str.arraypush(results;assertcontains("format_relative hours";hours;"hours ago"));

  let onehour=tr.formatrelative(3600);
  results=str.arraypush(results;assertcontains("format_relative 1 hour";onehour;"1 hour ago"));

  let days=tr.formatrelative(172800);
  results=str.arraypush(results;assertcontains("format_relative days";days;"days ago"));


  let dateresult=tr.formatdate("2026-04-25T14:30:00Z";"en-AU");
  results=str.arraypush(results;asserteq("format_date stub";dateresult;"2026-04-25T14:30:00Z"));

  let timeresult=tr.formattime("2026-04-25T14:30:00Z";"en-AU");
  results=str.arraypush(results;asserteq("format_time extracts time";timeresult;"14:30:00Z"));

  let dtresult=tr.formatdatetime("2026-04-25T14:30:00Z";"en-AU";"long";"short");
  results=str.arraypush(results;asserteq("format_datetime stub";dtresult;"2026-04-25T14:30:00Z"));


  let numresult=tr.formatnumber(42.5;"en-AU");
  results=str.arraypush(results;assertcontains("format_number contains 42";numresult;"42"));


  let emptykey=tr.t("");
  results=str.arraypush(results;asserteq("empty key returns empty";emptykey;""));

  let largecount=tr.tn("loke.test.items";9999);
  results=str.arraypush(results;assertcontains("plural large count";largecount;"items"));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1
    };
  };
  <all
};

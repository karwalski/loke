


m=tests.unit.platform.testhttpsecurity;

i=sec:loke.platform.http.security;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  let cfg=sec.defaultconfig();
  let headers=sec.securityheaders(cfg);

  
  results=str.arraypush(results;asserttrue("headers contain CSP";str.contains(headers;"Content-Security-Policy")));

  
  results=str.arraypush(results;asserttrue("headers contain X-Frame-Options";str.contains(headers;"X-Frame-Options")));

  
  results=str.arraypush(results;asserttrue("headers contain X-Content-Type-Options";str.contains(headers;"X-Content-Type-Options")));

  
  results=str.arraypush(results;asserttrue("default_config CSP has default-src self";str.contains(cfg.csp;"default-src 'self'")));

  
  results=str.arraypush(results;asserttrue("security_headers output non-empty";str.len(headers)>0));

  
  results=str.arraypush(results;assertfalse("default_config hsts is false by default";cfg.hsts));

  
  results=str.arraypush(results;asserttrue("default_config rate_limit_per_min positive";cfg.ratelimitpermin>0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};





m=tests.unit.platform.testhttprouter;

i=router:loke.platform.http.router;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }else{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let reg=router.newregistry();
  let routes=router.listroutes(reg);
  results=str.arraypush(results;asserttrue("new_registry has zero routes";str.arraylen(routes)==0));

  
  router.register(reg;"GET";"/items";"shop";"handler_list");
  let routesafter=router.listroutes(reg);
  results=str.arraypush(results;asserttrue("register increases count to 1";str.arraylen(routesafter)==1));

  
  let found=router.find(reg;"GET";"/api/v1/shop/items");
  results=str.arraypush(results;asserttrue("find exact path returns some";found.issome()));

  
  let notfound=router.find(reg;"GET";"/api/v1/unknown/path");
  results=str.arraypush(results;assertfalse("find unknown path returns none";notfound.issome()));

  
  router.register(reg;"POST";"/orders";"shop";"handler_create");
  let foundget=router.find(reg;"GET";"/api/v1/shop/items");
  let foundpost=router.find(reg;"POST";"/api/v1/shop/orders");
  results=str.arraypush(results;asserttrue("first route still findable after second registered";foundget.issome()));
  results=str.arraypush(results;asserttrue("second route findable independently";foundpost.issome()));

  
  let routesfinal=router.listroutes(reg);
  results=str.arraypush(results;asserttrue("list_routes count is 2";str.arraylen(routesfinal)==2));

  
  let wrongmethod=router.find(reg;"GET";"/api/v1/shop/orders");
  results=str.arraypush(results;assertfalse("wrong method returns none";wrongmethod.issome()));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }else{};
      i=i+1;
    };
  };
  <all
};

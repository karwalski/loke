


m=tests.unit.platform.testpluginanonymisation;

i=anon:loke.platform.plugin.anonymisation;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let patterns=anon.listpatterns();
  results=str.arraypush(results;asserttrue("list_patterns has at least 3 entries";str.arraylen(patterns)>3));

  
  let tfnpatterns=anon.findbytype("AU_TFN");
  results=str.arraypush(results;asserttrue("find_by_type AU_TFN returns results";str.arraylen(tfnpatterns)>1));

  
  let medicarepatterns=anon.findbytype("AU_MEDICARE");
  results=str.arraypush(results;asserttrue("find_by_type AU_MEDICARE returns results";str.arraylen(medicarepatterns)>1));

  
  let medicare=str.arrayget(medicarepatterns;0);
  results=str.arraypush(results;asserttrue("medicare confidence >= 0.85";medicare.confidence>0.85));

  
  let tfn=str.arrayget(tfnpatterns;0);
  results=str.arraypush(results;asserttrue("tfn confidence >= 0.80";tfn.confidence>0.80));

  
  let abnpatterns=anon.findbytype("AU_ABN");
  results=str.arraypush(results;asserttrue("find_by_type AU_ABN returns results";str.arraylen(abnpatterns)>1));
  let abn=str.arrayget(abnpatterns;0);
  results=str.arraypush(results;assertfalse("AU_TFN and AU_ABN entity types are distinct";str.eq(tfn.entitytype;abn.entitytype)));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};


m=tests.unit.auth.testoauth;

i=str:std.str;
i=log:std.log;
i=oauth:loke.core.auth.oauth;
i=pkce:loke.core.auth.pkce;
i=store:loke.core.auth.tokenstore;
i=refresh:loke.core.auth.refresh;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@$result@();


  let verifier=pkce.generateverifier();
  results=str.arraypush(results;asserttrue("pkce verifier is non-empty";str.len(verifier)>0));

  results=str.arraypush(results;asserttrue("pkce verifier length >= 43";str.len(verifier)>=43));
  results=str.arraypush(results;asserttrue("pkce verifier length <= 128";str.len(verifier)<=128));

  results=str.arraypush(results;asserttrue("is_valid_verifier accepts generated verifier";pkce.isvalidverifier(verifier)));

  results=str.arraypush(results;assertfalse("is_valid_verifier rejects short string";pkce.isvalidverifier("tooshort")));

  let challenge=pkce.generatechallenge(verifier);
  results=str.arraypush(results;asserttrue("pkce challenge is non-empty";str.len(challenge)>0));

  results=str.arraypush(results;asserttrue("pkce verify matches verifier to challenge";pkce.verify(verifier;challenge)));

  results=str.arraypush(results;assertfalse("pkce verify rejects wrong verifier";pkce.verify("wrong_verifier_that_is_long_enough_to_be_valid_xxxx";challenge)));

  results=str.arraypush(results;asserteq("challenge method is S256";pkce.challengemethod();"S256"));

  let verifier2=pkce.generateverifier();
  results=str.arraypush(results;assertfalse("two verifiers are different";str.eq(verifier;verifier2)));


  results=str.arraypush(results;asserttrue("validate_state matches identical strings";oauth.validatestate("abc123";"abc123")));

  results=str.arraypush(results;assertfalse("validate_state rejects mismatch";oauth.validatestate("abc123";"xyz789")));

  let state1=oauth.generatestate();
  results=str.arraypush(results;asserttrue("generate_state is non-empty";str.len(state1)>0));

  let state2=oauth.generatestate();
  results=str.arraypush(results;assertfalse("generate_state produces unique values";str.eq(state1;state2)));


  let cfg=oauth.newconfig("test-adapter";"client123";"https://auth.example.com/authorize";"https://auth.example.com/token";"openid profile");
  let url=oauth.buildauthoriseurl(cfg;"state_abc";"challenge_xyz";"http://localhost:8739/callback");
  results=str.arraypush(results;asserttrue("authorise url contains response_type";str.contains(url;"response_type=code")));
  results=str.arraypush(results;asserttrue("authorise url contains client_id";str.contains(url;"client_id=client123")));
  results=str.arraypush(results;asserttrue("authorise url contains state";str.contains(url;"state=state_abc")));
  results=str.arraypush(results;asserttrue("authorise url contains code_challenge";str.contains(url;"code_challenge=challenge_xyz")));
  results=str.arraypush(results;asserttrue("authorise url contains S256 method";str.contains(url;"code_challenge_method=S256")));
  results=str.arraypush(results;asserttrue("authorise url contains scope";str.contains(url;"scope=openid")));
  results=str.arraypush(results;asserttrue("authorise url contains redirect_uri";str.contains(url;"redirect_uri=http://localhost:8739/callback")));


  let redir=oauth.redirecturi(8739);
  results=str.arraypush(results;asserteq("redirect_uri format";"http://localhost:8739/callback";redir));


  results=str.arraypush(results;asserteq("new_config adapter_id";cfg.adapterid;"test-adapter"));
  results=str.arraypush(results;asserteq("new_config revoke_url defaults to empty";cfg.revokeurl;""));
  results=str.arraypush(results;asserttrue("new_config callback_port defaults to 0";cfg.callbackport=0));

  let cfg2=oauth.withrevokeurl(cfg;"https://auth.example.com/revoke");
  results=str.arraypush(results;asserteq("with_revoke_url sets url";cfg2.revokeurl;"https://auth.example.com/revoke"));

  let cfg3=oauth.withcallbackport(cfg;9999);
  results=str.arraypush(results;asserttrue("with_callback_port sets port";cfg3.callbackport=9999));


  let testtokens=oauth.$tokenset{
    accesstoken:"at_test_12345";
    refreshtoken:"rt_test_67890";
    expiresat:1999999999;
    scopes:"openid profile"
  };
  store.savetokens("test-oauth-adapter";testtokens);
  let loadedat=store.loadaccesstoken("test-oauth-adapter");
  results=str.arraypush(results;asserteq("token store access token round-trip";loadedat;"at_test_12345"));

  let loadedrt=store.loadrefreshtoken("test-oauth-adapter");
  results=str.arraypush(results;asserteq("token store refresh token round-trip";loadedrt;"rt_test_67890"));

  let loadedexp=store.loadexpiresat("test-oauth-adapter");
  results=str.arraypush(results;asserttrue("token store expires_at round-trip";loadedexp=1999999999));

  let loadedscopes=store.loadscopes("test-oauth-adapter");
  results=str.arraypush(results;asserteq("token store scopes round-trip";loadedscopes;"openid profile"));

  results=str.arraypush(results;asserttrue("has_tokens true after save";store.hastokens("test-oauth-adapter")));

  store.cleartokens("test-oauth-adapter");
  results=str.arraypush(results;assertfalse("has_tokens false after clear";store.hastokens("test-oauth-adapter")));

  let clearedat=store.loadaccesstoken("test-oauth-adapter");
  results=str.arraypush(results;asserteq("access token empty after clear";clearedat;""));

  results=str.arraypush(results;assertfalse("has_tokens false for unknown adapter";store.hastokens("__nonexistent_adapter__")));


  results=str.arraypush(results;assertfalse("no refresh needed when fresh";refresh.needsrefresh(2000000000;1999999000)));

  results=str.arraypush(results;asserttrue("refresh needed within 5min buffer";refresh.needsrefresh(2000000000;1999999800)));

  results=str.arraypush(results;asserttrue("refresh needed when expired";refresh.needsrefresh(2000000000;2000000100)));

  results=str.arraypush(results;assertfalse("not expired before expires_at";refresh.isexpired(2000000000;1999999999)));

  results=str.arraypush(results;asserttrue("expired at exact expires_at";refresh.isexpired(2000000000;2000000000)));

  results=str.arraypush(results;asserttrue("expired after expires_at";refresh.isexpired(2000000000;2000000001)));

  results=str.arraypush(results;asserttrue("refresh buffer is 300 seconds";refresh.refreshbuffersecs()=300));

  store.savetokens("test-refresh-adapter";oauth.$tokenset{
    accesstoken:"old_access";
    refreshtoken:"keep_this_refresh";
    expiresat:1000000000;
    scopes:"read write"
  });
  store.updateaccesstoken("test-refresh-adapter";"new_access";2000000000);
  let updatedat=store.loadaccesstoken("test-refresh-adapter");
  results=str.arraypush(results;asserteq("update_access_token changes access token";updatedat;"new_access"));
  let keptrt=store.loadrefreshtoken("test-refresh-adapter");
  results=str.arraypush(results;asserteq("update_access_token preserves refresh token";keptrt;"keep_this_refresh"));
  store.cleartokens("test-refresh-adapter");


  let cfg4=oauth.withcallbackport(cfg;8740);
  let auth=oauth.beginauthorise(cfg4);
  results=str.arraypush(results;asserttrue("begin_authorise state_param non-empty";str.len(auth.stateparam)>0));
  results=str.arraypush(results;asserttrue("begin_authorise code_verifier non-empty";str.len(auth.codeverifier)>0));
  results=str.arraypush(results;asserttrue("begin_authorise redirect_uri contains callback";str.contains(auth.redirecturi;"/callback")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1
    };
  };
  <all
};

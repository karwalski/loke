m=test.feedback.issuetitle;

i=t:std.test;
i=str:std.str;
i=u8:shared.utf8;
i=rp:core.feedback.report;

(* F10.49 — a GitHub issue's title carries the first 60 BYTES of the user's description, and
   the cut never splits a UTF-8 character. It was `description.slice(0;60)`, so a report
   written in Japanese, or holding an emoji, sent GitHub a title ending in part of a
   character. Still a byte limit; the cut is shared.utf8.prefix. Tested through
   `issuetitle`, which `submittogithub` uses; the submission itself needs the network. *)

f=repeat(s:str;n:i64):str{
  let out=mut."";
  lp(let i=0;i<n;i=i+1){ out="\(out)\(s)" };
  <out
};

f=report(description:str):$issuereport{
  <$issuereport{
    id:"r-1";
    reporttype:"bug";
    description:description;
    stepstoreproduce:"";
    expected:"";
    version:"0.1.0";
    platform:"darwin";
    createdat:0
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let jp="日";
  let emoji="😀";
  let e2="é";
  let a="a";
  let x="x";

  if(t.asserteq(rp.issuetitle(report(repeat(a;70)));"[bug] \(repeat(a;60))";"an ASCII description is cut at exactly 60 bytes")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rp.issuetitle(report(repeat(a;10)));"[bug] \(repeat(a;10))";"and a short one is kept whole")){pass=pass+1}el{fail=fail+1};

  (* "a" and 20 three-byte characters are 61 bytes; byte 60 is inside the 20th. *)
  let t3=rp.issuetitle(report("\(a)\(repeat(jp;20))"));
  if(t.asserteq(t3;"[bug] \(a)\(repeat(jp;19))";"3-byte characters crossing byte 60 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(t3);"and the title is valid UTF-8")){pass=pass+1}el{fail=fail+1};
  (* "a" and 15 emoji are 61 bytes; byte 60 is inside the 15th. *)
  let t4=rp.issuetitle(report("\(a)\(repeat(emoji;15))"));
  if(t.asserteq(t4;"[bug] \(a)\(repeat(emoji;14))";"4-byte characters crossing byte 60 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(t4);"and that title is valid UTF-8")){pass=pass+1}el{fail=fail+1};
  let t2=rp.issuetitle(report("\(repeat(a;59))\(e2)\(x)"));
  if(t.asserteq(t2;"[bug] \(repeat(a;59))";"a 2-byte character split after its lead byte is dropped whole")){pass=pass+1}el{fail=fail+1};

  <fail
};

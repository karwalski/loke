



m=tests.unit.feedback.testlearning;

i=learning:core.feedback.learning;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  
  let emptysigs = @($learningsignal);
  let emptyadjs = learning.deriveadjustments(emptysigs);
  results = str.arraypush(results;assertinteq("derive_adjustments empty input yields empty output";emptyadjs.len;0));

  
  let lowroutingsig = $$learningsignal{
    featurearea:"routing_decision";
    thumbsuprate:0.3;
    samplesize:20;
    confidence:"medium"
  };
  let adjslow = learning.deriveadjustments(@($lowroutingsig));
  results = str.arraypush(results;asserttrue("low routing thumbs_up_rate produces adjustment";adjslow.len > 0));
  if(adjslow.len > 0){
    let adj = str.arrayget(adjslow;0);
    results = str.arraypush(results;asserttrue("routing adjustment is negative";adj.adjustment < 0.0));
    results = str.arraypush(results;asserttrue("routing adjustment reason non-empty";str.len(adj.reason) > 0));
    results = str.arraypush(results;asserttrue("routing adjustment has description via reason field";str.contains(adj.reason;"low thumbs-up rate")))
  }el{};

  
  let highsig = $$learningsignal{
    featurearea:"chat_response";
    thumbsuprate:0.92;
    samplesize:30;
    confidence:"medium"
  };
  let adjshigh = learning.deriveadjustments(@($highsig));
  results = str.arraypush(results;asserttrue("high thumbs_up_rate produces adjustment";adjshigh.len > 0));
  if(adjshigh.len > 0){
    let adjhigh = str.arrayget(adjshigh;0);
    results = str.arraypush(results;asserttrue("high-confidence adjustment is positive";adjhigh.adjustment > 0.0));
    results = str.arraypush(results;asserttrue("positive adjustment has description";str.len(adjhigh.reason) > 0))
  }el{};

  
  let highsmallsig = $$learningsignal{
    featurearea:"compression";
    thumbsuprate:0.95;
    samplesize:5;
    confidence:"low"
  };
  let adjssmall = learning.deriveadjustments(@($highsmallsig));
  results = str.arraypush(results;assertinteq("high rate but small sample yields no adjustment";adjssmall.len;0));

  
  let statewithadjs = $$learningstate{
    signals:@(lowroutingsig;highsig);
    adjustments:adjslow;
    computedat:0
  };
  let formatted = learning.formatlearningstate(statewithadjs);
  results = str.arraypush(results;asserttrue("format_learning_state non-empty";str.len(formatted) > 0));
  results = str.arraypush(results;asserttrue("formatted state contains signals header";str.contains(formatted;"Learning Signals")));

  
  let statenoadjs = $$learningstate{
    signals:@$highsmallsig;
    adjustments:@();
    computedat:0
  };
  let formattednone = learning.formatlearningstate(statenoadjs);
  results = str.arraypush(results;asserttrue("format_learning_state with no adjustments shows none";str.contains(formattednone;"(none)")));

  
  
  let neutralsig = $$learningsignal{
    featurearea:"dashboard";
    thumbsuprate:0.6;
    samplesize:15;
    confidence:"medium"
  };
  let adjsneutral = learning.deriveadjustments(@($neutralsig));
  results = str.arraypush(results;assertinteq("neutral signal in non-routing area yields no adjustment";adjsneutral.len;0));

  
  let sigcheck = $$learningsignal{
    featurearea:"governance_warning";
    thumbsuprate:0.4;
    samplesize:12;
    confidence:"medium"
  };
  results = str.arraypush(results;asserteq("learning_signal has confidence field";sigcheck.confidence;"medium"));
  results = str.arraypush(results;asserttrue("learning_signal has thumbs_up_rate field";sigcheck.thumbsuprate < 1.0));

  
  if(adjslow.len > 0){
    let ra = str.arrayget(adjslow;0);
    results = str.arraypush(results;asserttrue("routing_adjustment reason/description non-empty";str.len(ra.reason) > 0))
  }el{};

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    }
  };
  <all
};

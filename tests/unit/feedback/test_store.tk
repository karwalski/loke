



m=tests.unit.feedback.teststore;

i=store:core.feedback.store;
i=ft:core.feedback.types;
i=db:core.storage.db;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  
  let s = db.newmemorystore();
  mt store.ensuretable(s) { $ok:v 0; $err:e 0 };
  let pendingempty = mt store.pendingsubmission(s) {
    $ok:entries entries;
    $err:e @()
  };
  results = str.arraypush(results;assertinteq("empty store has zero pending";pendingempty.len;0));

  
  let entry1 = ft.newentry(
    $feedbackrating.$thumbsup;
    $featurearea.$chatresponse;
    "req-001";
    "claude-3-5-sonnet-20241022";
    "Response was very helpful"
  );
  mt store.save(s;entry1) { $ok:v 0; $err:e 0 };
  let pendingone = mt store.pendingsubmission(s) {
    $ok:entries entries;
    $err:e @()
  };
  results = str.arraypush(results;assertinteq("after save count is 1";pendingone.len;1));

  
  
  let entry2 = ft.newentry(
    $feedbackrating.$thumbsdown;
    $featurearea.$routingdecision;
    "req-002";
    "gpt-4o";
    "Wrong model chosen"
  );
  mt store.save(s;entry2) { $ok:v 0; $err:e 0 };
  let summaryall = mt store.getsummary(s;365) {
    $ok:sm sm;
    $err:e $feedbacksummary{total:0;thumbsup:0;thumbsdown:0;thumbsuprate:0.0;topissues:@()}
  };
  results = str.arraypush(results;asserttrue("summary total > 0 after two saves";summaryall.total > 0));

  
  results = str.arraypush(results;asserttrue("summary thumbs_down >= 1";summaryall.thumbsdown > 1));

  
  results = str.arraypush(results;asserttrue("summary thumbs_up >= 1";summaryall.thumbsup > 1));

  
  let pendingtwo = mt store.pendingsubmission(s) {
    $ok:entries entries;
    $err:e @()
  };
  results = str.arraypush(results;assertinteq("pending has 2 before mark_submitted";pendingtwo.len;2));

  
  let id1 = entry1.id;
  mt store.marksubmitted(s;@(id1)) { $ok:v 0; $err:e 0 };
  let pendingaftermark = mt store.pendingsubmission(s) {
    $ok:entries entries;
    $err:e @()
  };
  results = str.arraypush(results;assertinteq("pending count = 1 after mark_submitted";pendingaftermark.len;1));

  
  
  
  
  
  let entrycheck = ft.newentry(
    $feedbackrating.$neutral;
    $featurearea.$privacydetection;
    "req-003";
    "local-model";
    "some comment"
  );
  results = str.arraypush(results;asserteq("entry comment field accessible";entrycheck.comment;"some comment"));
  results = str.arraypush(results;asserteq("entry has no prompt_text — request_id is not prompt";entrycheck.requestid;"req-003"));

  
  let fmt = store.formatsummary(summaryall);
  results = str.arraypush(results;asserttrue("format_summary non-empty";str.len(fmt) > 0));

  
  let lblup = ft.ratinglabel($feedbackrating.$thumbsup);
  results = str.arraypush(results;asserteq("rating_label thumbs_up";lblup;"thumbs_up"));

  
  let lbldown = ft.ratinglabel($feedbackrating.$thumbsdown);
  results = str.arraypush(results;asserteq("rating_label thumbs_down";lbldown;"thumbs_down"));

  
  let lblroute = ft.arealabel($featurearea.$routingdecision);
  results = str.arraypush(results;asserteq("area_label routing_decision";lblroute;"Routing decision"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    }
  };
  <all
};

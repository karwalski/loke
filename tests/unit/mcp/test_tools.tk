
m=tests.unit.mcp.testtools;

i=tools:mcptoke.tools;
i=proto:core.mcp.protocol;
i=str:std.str;
i=json:std.json;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();

  let all=tools.alltools();
  results=str.arraypush(results;assertinteq("all_tools: count is 5";all.len;5));

  let names=tools.toolnames();
  results=str.arraypush(results;assertinteq("tool_names: count is 5";names.len;5));
  results=str.arraypush(results;asserteq("tool_names[0]: anonymise";str.arrayget(names;0);"anonymise"));
  results=str.arraypush(results;asserteq("tool_names[1]: compress";str.arrayget(names;1);"compress"));
  results=str.arraypush(results;asserteq("tool_names[2]: profile";str.arrayget(names;2);"profile"));
  results=str.arraypush(results;asserteq("tool_names[3]: decompress";str.arrayget(names;3);"decompress"));
  results=str.arraypush(results;asserteq("tool_names[4]: analyse";str.arrayget(names;4);"analyse"));

  let found=tools.findtool("compress");
  let foundok=mt found {
    $err:e <false;
    $ok:t <true
  };
  results=str.arraypush(results;asserttrue("find_tool: compress found";foundok));

  let notfound=tools.findtool("nonexistent");
  let notfoundnone=mt notfound {
    $err:e <true;
    $ok:t <false
  };
  results=str.arraypush(results;asserttrue("find_tool: nonexistent returns none";notfoundnone));

  let i=0;
  let n=all.len;
  loop{
    if(i>=n){ break }el{
      let tool=str.arrayget(all;i);
      let hasdesc=str.len(tool.description) > 0;
      results=str.arraypush(results;asserttrue(str.concat("tool has description: ";tool.name);hasdesc));
      i=i+1;
    };
  };

  let j=mut.0;
  loop{
    if(j>=n){ break }el{
      let tool=str.arrayget(all;j);
      let schemaparsed=json.dec(tool.inputschema);
      let schemaok=mt schemaparsed {
        $jsonerr e; <false;
        obj; <true
      };
      results=str.arraypush(results;asserttrue(str.concat("tool has valid schema: ";tool.name);schemaok));
      j=j+1
    };
  };

  let k=mut.0;
  loop{
    if(k>=n){ break }el{
      let tool=str.arrayget(all;k);
      results=str.arraypush(results;assertcontains(str.concat("tool schema is object: ";tool.name);tool.inputschema;"\"type\":\"object\""));
      k=k+1
    };
  };

  let aftercompress=tools.toolsaftercursor(all;"compress");
  results=str.arraypush(results;assertinteq("tools_after_cursor: count after compress";aftercompress.len;3));

  let afterlast=tools.toolsaftercursor(all;"analyse");
  results=str.arraypush(results;assertinteq("tools_after_cursor: empty after last";afterlast.len;0));

  let afternone=tools.toolsaftercursor(all;"nonexistent");
  results=str.arraypush(results;assertinteq("tools_after_cursor: empty for unknown cursor";afternone.len;0));

  let compressresult=tools.handletool("compress";"{\"json\":\"{\"a\":1}\"}";"";""  );
  results=str.arraypush(results;assertfalse("handle_tool compress: not error";compressresult.iserror));

  let decompresult=tools.handletool("decompress";"{\"toon\":\"a:1\"}";"";""  );
  results=str.arraypush(results;assertfalse("handle_tool decompress: not error";decompresult.iserror));

  let unknownresult=tools.handletool("nonexistent";"{}";"";""  );
  results=str.arraypush(results;asserttrue("handle_tool unknown: is error";unknownresult.iserror));
  results=str.arraypush(results;assertcontains("handle_tool unknown: error message";unknownresult.text;"unknown tool"));

  let analyseresult=tools.handletool("analyse";"{\"text\":\"My email is bob@example.com\"}";"";""  );
  results=str.arraypush(results;assertfalse("handle_tool analyse: not error";analyseresult.iserror));
  results=str.arraypush(results;assertcontains("handle_tool analyse: has sensitivity";analyseresult.text;"sensitivity"));

  let allpassed=true;
  let idx=mut.0;
  let total=str.arraylen(results);
  loop{
    if(idx>=total){ break }el{
      let r=str.arrayget(results;idx);
      logresult(r);
      if(!$r.passed){ let allpassed=false }el{};
      idx=idx+1
    };
  };
  <allpassed
};

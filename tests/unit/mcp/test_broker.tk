
m=tests.unit.mcp.testbroker;

i=reg:mcpbroker.registry;
i=perms:mcpbroker.permissions;
i=srv:mcpbroker.server;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertcontains(n:str;haystack:str;needle:str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result);

  let empty=reg.newregistry();
  results=str.arraypush(results;assertinteq("new_registry: empty";empty.servers.len;0));

  let defaults=reg.defaultservers();
  results=str.arraypush(results;assertinteq("default_servers: count 2";defaults.len;2));

  let entry=reg.$serverentry{
    name:"test-server"; host:"localhost"; port:9999; toolprefix:"test.";
    healthy:true; lastchecked:0;
    permissionsset:false; permission:0
  };
  let updated=reg.register(empty;entry);
  results=str.arraypush(results;assertinteq("register: count is 1";updated.servers.len;1));

  let registry=reg.newregistry();
  let tokeentry=reg.$serverentry{
    name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke.";
    healthy:true; lastchecked:0;
    permissionsset:false; permission:0
  };
  let registry=reg.register(registry;tokeentry);
  let found=reg.findfortool(registry;"toke.compress");
  let foundok=mt found {
    $none:v false;
    $some:e str.eq(e.name;"mcp-toke")
  };
  results=str.arraypush(results;asserttrue("find_for_tool: toke.compress resolves";foundok));

  let notfound=reg.findfortool(registry;"unknown.tool");
  let notfoundnone=mt notfound {
    $none:v true;
    $some:e false
  };
  results=str.arraypush(results;asserttrue("find_for_tool: unknown returns none";notfoundnone));

  let formatted=reg.formatregistry(registry);
  results=str.arraypush(results;assertcontains("format_registry: has header";formatted;"Name"));
  results=str.arraypush(results;assertcontains("format_registry: has mcp-toke";formatted;"mcp-toke"));

  let allowall=perms.$serverpermission{
    servername:"test-server";
    allowedtools:@(str);
    deniedtools:@(str);
    maxrequestspermin:0;
    privacyrequired:false
  };
  let tokewithperm=reg.$serverentry{
    name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke.";
    healthy:true; lastchecked:0;
    permissionsset:true; permission:allowall
  };
  let permregistry=reg.register(reg.newregistry();tokewithperm);
  let allowed=perms.checktoolpermission(permregistry;"toke.compress");
  results=str.arraypush(results;asserttrue("perm: empty allowed list allows all";allowed));

  let denycompress=perms.$serverpermission{
    servername:"mcp-toke";
    allowedtools:@(str);
    deniedtools:@("compress");
    maxrequestspermin:0;
    privacyrequired:false
  };
  let tokedeny=reg.$serverentry{
    name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke.";
    healthy:true; lastchecked:0;
    permissionsset:true; permission:denycompress
  };
  let denyregistry=reg.register(reg.newregistry();tokedeny);
  let denied=perms.checktoolpermission(denyregistry;"toke.compress");
  results=str.arraypush(results;assertfalse("perm: denied tool is rejected";denied));

  let otherallowed=perms.checktoolpermission(denyregistry;"toke.analyse");
  results=str.arraypush(results;asserttrue("perm: non-denied tool is allowed";otherallowed));

  let allowspecific=perms.$serverpermission{
    servername:"mcp-toke";
    allowedtools:@("compress";"decompress");
    deniedtools:@(str);
    maxrequestspermin:100;
    privacyrequired:false
  };
  let tokespecific=reg.$serverentry{
    name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke.";
    healthy:true; lastchecked:0;
    permissionsset:true; permission:allowspecific
  };
  let specregistry=reg.register(reg.newregistry();tokespecific);
  let compressok=perms.checktoolpermission(specregistry;"toke.compress");
  let analyseno=perms.checktoolpermission(specregistry;"toke.analyse");
  results=str.arraypush(results;asserttrue("perm: allowed tool passes";compressok));
  results=str.arraypush(results;assertfalse("perm: unlisted tool blocked";analyseno));

  let nopermentry=reg.$serverentry{
    name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke.";
    healthy:true; lastchecked:0;
    permissionsset:false; permission:0
  };
  let nopermreg=reg.register(reg.newregistry();nopermentry);
  let defaultallowed=perms.checktoolpermission(nopermreg;"toke.compress");
  results=str.arraypush(results;asserttrue("perm: no permissions defaults to allow";defaultallowed));

  let state=srv.newstate();
  let initreq="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}";
  let initresp=srv.handlerequest(initreq;registry;state);
  results=str.arraypush(results;assertcontains("broker init: has protocolVersion";initresp;"protocolVersion"));
  results=str.arraypush(results;assertcontains("broker init: has broker name";initresp;"loke-mcp-broker"));

  let pingreq="{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\",\"params\":{}}";
  let pingresp=srv.handlerequest(pingreq;registry;state);
  results=str.arraypush(results;assertcontains("broker ping: has result";pingresp;"\"result\":{}"));

  let unknownreq="{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"unknown/method\",\"params\":{}}";
  let unknownresp=srv.handlerequest(unknownreq;registry;state);
  results=str.arraypush(results;assertcontains("broker unknown: has error";unknownresp;"-32601"));

  let badresp=srv.handlerequest("not json";registry;state);
  results=str.arraypush(results;assertcontains("broker bad json: parse error";badresp;"-32700"));

  let testconfig=perms.$permissionconfig{
    permissions:@(allowspecific);
    servercount:1
  };
  let formattedperms=perms.formatpermissions(testconfig);
  results=str.arraypush(results;assertcontains("format_perms: has header";formattedperms;"Server"));

  let all=true;
  let idx=0;
  let total=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(idx>=total){ break }el{
      let r=str.arrayget(results;idx);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      idx=idx+1
    }
  };
  <all
};

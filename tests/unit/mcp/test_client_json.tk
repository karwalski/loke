m=test.mcp.clientjson;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=process:std.process;
i=proto:core.mcp.protocol;
i=mcpc:core.mcp.client;

(* MK6.15 — core.mcp.client.listtools against scripts/lib/http_recorder.py, whose /mcp
   answer lists two tools, each with "inputSchema":{"type":"object"}. Each tool's schema was
   taken as `json.enc(json.getval(item;"inputSchema"))`: on toke 3.1.0 json.getval answers
   the raw JSON text of the value, and json.enc then quotes that text as a JSON string. *)

f=scratch():str{
  let hex:str=str.randhex(8);
  <"/tmp/loke_mcpclient_\(hex)"
};

f=readfile(p:str):str{
  <mt file.read(p) { $ok:v v; $err:e "" }
};

f=pause():i64{
  let h=mt process.spawn(@("sleep";"0.1")) { $ok:h h; $err:e 0 };
  if(h!=0){ process.wait(h); }el{};
  <0
};

f=waitport(portfile:str):str{
  let p=mut."";
  lp(let k=0;k<100 && str.len(p)==0;k=k+1){
    p=readfile(portfile);
    if(str.len(p)==0){ pause() }el{}
  };
  <p
};

f=judge(args:@str):str{
  let h=mt process.spawn(args) { $ok:h h; $err:e 0 };
  if(h==0){ <"python3 did not start" }el{};
  let out=mt process.stdout(h) { $ok:o o; $err:e "" };
  process.wait(h);
  <str.trim(out)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let base=scratch();
  let logp="\(base).log";
  let rec=mt process.spawn(@("python3";"scripts/lib/http_recorder.py";logp;"\(base).port")) { $ok:h h; $err:e 0 };
  let port=waitport("\(base).port");
  if(t.assert(str.len(port)>0;"the recorder standing in for an MCP server came up")){pass=pass+1}el{fail=fail+1};

  let client=mcpc.new("http://127.0.0.1:\(port)";"rec");
  let tools=mt mcpc.listtools(client) { $ok:ts ts; $err:e @() };
  if(t.assert(str.contains(readfile(logp);"\"method\":\"tools/list\"");"the tools/list request arrives")){pass=pass+1}el{fail=fail+1};
  if(t.assert(tools.len==2;"both tools are listed")){pass=pass+1}el{fail=fail+1};
  if(tools.len==2){
    let t0:$mcptool=tools.get(0);
    let t1:$mcptool=tools.get(1);
    if(t.asserteq(t0.name;"echo";"the first tool's name")){pass=pass+1}el{fail=fail+1};
    (* The schema must be the object itself, not a string holding it. *)
    if(t.asserteq(judge(@("python3";"scripts/lib/json_field.py";"--json";"--body";t0.inputschema;"";"{\"type\":\"object\"}"));"ok";"the first tool's inputSchema is the JSON object the server sent")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(judge(@("python3";"scripts/lib/json_field.py";"--json";"--body";t1.inputschema;"";"{\"type\":\"object\"}"));"ok";"and the second's")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+3 };

  if(rec!=0){ process.kill(rec); process.wait(rec); }el{};
  file.delete(logp);
  file.delete("\(logp).bodies");
  file.delete("\(logp).headers");
  file.delete("\(base).port");
  <fail
};

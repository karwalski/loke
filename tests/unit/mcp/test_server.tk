
m=tests.unit.mcp.testserver;

i=srv:mcptoke.server;
i=proto:core.mcp.protocol;
i=str:std.str;
i=json:std.json;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:str;haystack:str;needle:str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=assertnotcontains(n:str;haystack:str;needle:str):$result{
  if(!str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected NOT to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=testconfig():srv.$serverconfig{
  <$serverconfig{
    host:"127.0.0.1";
    port:11435;
    servername:"test-mcp";
    version:"0.1.0";
    presidiourl:"";
    ollamaurl:""
  }
};

f=runall():bool{
  let results=@($result);
  let config=testconfig();
  let state=srv.newstate();

  let initreq="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0.1.0\"}}}";
  let initresp=srv.handlerequest(initreq;config;state);
  results=str.arraypush(results;assertcontains("initialize: has protocolVersion";initresp;"2024-11-05"));
  results=str.arraypush(results;assertcontains("initialize: has server name";initresp;"test-mcp"));
  results=str.arraypush(results;assertcontains("initialize: has tools capability";initresp;"\"tools\":{}"));

  let notifreq="{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}}";
  let notifresp=srv.handlerequest(notifreq;config;state);
  results=str.arraypush(results;asserteq("notification: returns empty";notifresp;""));

  results=str.arraypush(results;asserttrue("notification: state.initialized is true";state.initialized));

  let pingreq="{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\",\"params\":{}}";
  let pingresp=srv.handlerequest(pingreq;config;state);
  results=str.arraypush(results;assertcontains("ping: has result";pingresp;"\"result\":{}"));

  let listreq="{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\",\"params\":{}}";
  let listresp=srv.handlerequest(listreq;config;state);
  results=str.arraypush(results;assertcontains("tools/list: has anonymise";listresp;"anonymise"));
  results=str.arraypush(results;assertcontains("tools/list: has compress";listresp;"compress"));
  results=str.arraypush(results;assertcontains("tools/list: has decompress";listresp;"decompress"));
  results=str.arraypush(results;assertcontains("tools/list: has profile";listresp;"profile"));
  results=str.arraypush(results;assertcontains("tools/list: has analyse";listresp;"analyse"));

  let callreq="{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"compress\",\"arguments\":{\"json\":\"{\\\"a\\\":1}\"}}}";
  let callresp=srv.handlerequest(callreq;config;state);
  results=str.arraypush(results;assertcontains("tools/call compress: has result";callresp;"\"result\":"));
  results=str.arraypush(results;assertnotcontains("tools/call compress: no error";callresp;"\"error\":"));

  let decompreq="{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"decompress\",\"arguments\":{\"toon\":\"a:1\"}}}";
  let decompresp=srv.handlerequest(decompreq;config;state);
  results=str.arraypush(results;assertcontains("tools/call decompress: has result";decompresp;"\"result\":"));

  let unknownreq="{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"nonexistent\",\"arguments\":{}}}";
  let unknownresp=srv.handlerequest(unknownreq;config;state);
  results=str.arraypush(results;assertcontains("tools/call unknown: has content";unknownresp;"unknown tool"));

  let badmethodreq="{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"completions/create\",\"params\":{}}";
  let badmethodresp=srv.handlerequest(badmethodreq;config;state);
  results=str.arraypush(results;assertcontains("unknown method: has error code";badmethodresp;"-32601"));
  results=str.arraypush(results;assertcontains("unknown method: has error msg";badmethodresp;"Method not found"));

  let badjsonresp=srv.handlerequest("{{not json";config;state);
  results=str.arraypush(results;assertcontains("bad JSON: parse error";badjsonresp;"-32700"));

  let resreq="{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"resources/list\",\"params\":{}}";
  let resresp=srv.handlerequest(resreq;config;state);
  results=str.arraypush(results;assertcontains("resources/list: empty";resresp;"\"resources\":[]"));

  let promptsreq="{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"prompts/list\",\"params\":{}}";
  let promptsresp=srv.handlerequest(promptsreq;config;state);
  results=str.arraypush(results;assertcontains("prompts/list: empty";promptsresp;"\"prompts\":[]"));

  results=str.arraypush(results;asserttrue("request_count > 0";state.requestcount > 0));

  let health=srv.healthresponse(config;state);
  results=str.arraypush(results;assertcontains("health: status ok";health;"\"status\":\"ok\""));
  results=str.arraypush(results;assertcontains("health: server name";health;"test-mcp"));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(!(i<n)){ br }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1
    }
  };
  <all
};

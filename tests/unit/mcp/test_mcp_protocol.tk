m=test.mcp.protocol;

i=t:std.test;
i=str:std.str;
i=json:std.json;
i=pr:core.mcp.protocol;
i=jx:shared.jsonobj;

(* X4b.9: core.mcp.protocol, the JSON-RPC layer both MCP servers speak, against the real
   module. Every builder's output is decoded again, because an MCP client rejects the whole
   response if one string is escaped wrongly. Tool output routinely holds newlines and
   backslashes: code, paths, stack traces. *)

f=textof(resp:str):str{
  let obj=json.dec(resp);
  <mt json.arr(obj;"content") {
    $ok:parts firsttext(parts);
    $err:e "<no content array: invalid JSON>"
  }
};

f=firsttext(parts:@$jsonval):str{
  if(parts.len==0){ <"<empty>" }el{};
  (* jx.strvalue, not json.str, which drops each backslash and so reads `\n` as `n` (T-44). *)
  <jx.strvalue(parts.get(0);"text";"<no text>")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let req=mt pr.parserequest("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{}}") {$ok:r r; $err:e pr.parserequest("{}")};
  if(t.asserteq(req.method;"tools/list";"a request's method is parsed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(req.id==7;"and its id")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(pr.okresponse(7;"{}");"{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{}}";"an ok response carries the id and the result")){pass=pass+1}el{fail=fail+1};
  let er=json.dec(pr.errorresponse(7;0-32601;"no such method"));
  let code=mt json.i64(er;"id") {$ok:v v; $err:e 0-1};
  if(t.assert(code==7;"an error response is valid JSON carrying the id")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(textof(pr.toolresultok("plain"));"plain";"a plain tool result round-trips")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(textof(pr.toolresultok("say \"hi\""));"say \"hi\"";"quotes round-trip")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(textof(pr.toolresultok("line one\nline two"));"line one\nline two";"a newline round-trips: the response is still valid JSON")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(pr.toolresultok("line one\nline two");"\n");"and it is escaped, not written raw: a raw newline inside a JSON string is invalid, and only std.json's lenient decoder accepts it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(textof(pr.toolresultok("C:\\tmp\\x"));"C:\\tmp\\x";"a backslash round-trips")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(textof(pr.toolresulterr("failed:\n  at line 3"));"failed:\n  at line 3";"an error result with a newline is valid JSON too")){pass=pass+1}el{fail=fail+1};

  let tools=@($mcptool{name:"read";description:"Reads a file.\nReturns its text.";inputschema:"{}"});
  let lst=json.dec(pr.toolslistresult(tools));
  let listed=mt json.arr(lst;"tools") {$ok:a a.len; $err:e 0-1};
  if(t.assert(listed==1;"a tools list whose description holds a newline is valid JSON with one tool")){pass=pass+1}el{fail=fail+1};

  let init=json.dec(pr.initresponse("loke \"mcp\"";"1.0"));
  let pv=mt json.str(init;"protocolVersion") {$ok:v v; $err:e ""};
  if(t.asserteq(pv;"2024-11-05";"the initialise response is valid JSON")){pass=pass+1}el{fail=fail+1};
  <fail
};

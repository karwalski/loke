
m=tests.unit.mcp.testtransport;

i=transport:mcptoke.transport;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=assertstartswith(n:$str;s:$str;prefix:$str):$result{
  if(str.startswith(s;prefix)){ <pass(n) }el{
    <fail(n;str.concat("expected to start with: ";prefix))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();

  let body="{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}";
  let framed=transport.framemessage(body);
  results=str.arraypush(results;assertstartswith("frame: starts with Content-Length";framed;"Content-Length: "));

  let bodylen=str.bytelen(body);
  let expectedheader=str.concat("Content-Length: ";str.fromint(bodylen));
  results=str.arraypush(results;assertcontains("frame: correct length";framed;expectedheader));

  results=str.arraypush(results;assertcontains("frame: has CRLF separator";framed;"

"));

  results=str.arraypush(results;assertcontains("frame: body preserved";framed;body));

  let emptyframed=transport.framemessage("");
  results=str.arraypush(results;assertcontains("frame empty: Content-Length 0";emptyframed;"Content-Length: 0"));

  let unicodebody="{\"text\":\"hello world\"}";
  let unicodeframed=transport.framemessage(unicodebody);
  let unicodelen=str.bytelen(unicodebody);
  let unicodeheader=str.concat("Content-Length: ";str.fromint(unicodelen));
  results=str.arraypush(results;assertcontains("frame unicode: correct byte length";unicodeframed;unicodeheader));

  let rtbody="{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"ping\"}";
  let rtframed=transport.framemessage(rtbody);
  let separatorpos=str.indexof(rtframed;"

");
  let extracted=str.slice(rtframed;separatorpos+4;str.len(rtframed));
  results=str.arraypush(results;asserteq("frame round-trip: body matches";extracted;rtbody));

  let body1="{\"id\":1}";
  let body2="{\"id\":2}";
  let framed1=transport.framemessage(body1);
  let framed2=transport.framemessage(body2);
  results=str.arraypush(results;assertcontains("frame independence: frame1 has body1";framed1;body1));
  results=str.arraypush(results;assertcontains("frame independence: frame2 has body2";framed2;body2));
  results=str.arraypush(results;asserttrue("frame independence: frame1 no body2";!str.contains(framed1;body2)));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

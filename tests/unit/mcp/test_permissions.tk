
m=tests.unit.mcp.testpermissions;

i=perms:mcpbroker.permissions;
i=reg:mcpbroker.registry;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result);

  let tomlsingle="[mcp.servers.mcp-toke]\nallowed_tools = [\"compress\", \"decompress\"]\ndenied_tools = []\nmax_requests_per_min = 100\nprivacy_required = false\n";
  let parsed=perms.parsetomlpermissions(tomlsingle);
  let singleok=mt parsed {
    $lokeerr:e false;
    $ok:config config.servercount=1
  };
  results=str.arraypush(results;asserttrue("parse single server: count 1";singleok));

  let servername=mt parsed {
    $lokeerr:e "error";
    $ok:config str.arrayget(config.permissions;0).servername
  };
  results=str.arraypush(results;asserteq("parse single: name is mcp-toke";servername;"mcp-toke"));

  let allowedcount=mt parsed {
    $lokeerr:e 0;
    $ok:config str.arrayget(config.permissions;0).allowedtools.len
  };
  results=str.arraypush(results;assertinteq("parse single: 2 allowed tools";allowedcount;2));

  let rpm=mt parsed {
    $lokeerr:e 0;
    $ok:config str.arrayget(config.permissions;0).maxrequestspermin
  };
  results=str.arraypush(results;assertinteq("parse single: rpm is 100";rpm;100));

  let tomlmulti="[mcp.servers.mcp-toke]\nallowed_tools = [\"compress\"]\ndenied_tools = []\nmax_requests_per_min = 100\nprivacy_required = false\n\n[mcp.servers.mcp-memory]\nallowed_tools = []\ndenied_tools = [\"delete_all\"]\nmax_requests_per_min = 60\nprivacy_required = true\n";
  let parsedmulti=perms.parsetomlpermissions(tomlmulti);
  let multicount=mt parsedmulti {
    $lokeerr:e 0;
    $ok:config config.servercount
  };
  results=str.arraypush(results;assertinteq("parse multi: count 2";multicount;2));

  let privacyreq=mt parsedmulti {
    $lokeerr:e false;
    $ok:config str.arrayget(config.permissions;1).privacyrequired
  };
  results=str.arraypush(results;asserttrue("parse multi: memory privacy required";privacyreq));

  let deniedcount=mt parsedmulti {
    $lokeerr:e 0;
    $ok:config str.arrayget(config.permissions;1).deniedtools.len
  };
  results=str.arraypush(results;assertinteq("parse multi: memory 1 denied tool";deniedcount;1));

  let parsedempty=perms.parsetomlpermissions("");
  let emptycount=mt parsedempty {
    $lokeerr:e -1;
    $ok:config config.servercount
  };
  results=str.arraypush(results;assertinteq("parse empty: count 0";emptycount;0));

  let parsednomcp=perms.parsetomlpermissions("[project]\nname = \"loke\"\n");
  let nomcpcount=mt parsednomcp {
    $lokeerr:e -1;
    $ok:config config.servercount
  };
  results=str.arraypush(results;assertinteq("parse no mcp: count 0";nomcpcount;0));

  let registry=reg.newregistry();
  let tokeentry=$serverentry{
    name:"mcp-toke"; host:"localhost"; port:11435; toolprefix:"toke.";
    healthy:true; lastchecked:0;
    permissionsset:false; permission:0
  };
  let registry=reg.register(registry;tokeentry);
  let config=mt parsed {
    $lokeerr:e perms.$permissionconfig{ permissions:@($serverpermission); servercount:0 };
    $ok:config config
  };
  let updated=perms.applypermissions(registry;config);
  let firstentry=str.arrayget(updated.servers;0);
  results=str.arraypush(results;asserttrue("apply_permissions: permissions_set is true";firstentry.permissionsset));

  let strictperm=$serverpermission{
    servername:"test";
    allowedtools:@("compress";"decompress";"analyse");
    deniedtools:@("compress");
    maxrequestspermin:0;
    privacyrequired:false
  };
  let strictentry=$serverentry{
    name:"test-server"; host:"localhost"; port:9999; toolprefix:"test.";
    healthy:true; lastchecked:0;
    permissionsset:true; permission:strictperm
  };
  let strictreg=reg.register(reg.newregistry();strictentry);
  let compressdenied=perms.checktoolpermission(strictreg;"test.compress");
  let analyseallowed=perms.checktoolpermission(strictreg;"test.analyse");
  results=str.arraypush(results;assertfalse("deny precedence: compress denied";compressdenied));
  results=str.arraypush(results;asserttrue("deny precedence: analyse allowed";analyseallowed));

  let all=true;
  let idx=0;
  let total=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(!(idx<total)){ break }el{
      let r=str.arrayget(results;idx);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      idx=idx+1
    }
  };
  <all
};

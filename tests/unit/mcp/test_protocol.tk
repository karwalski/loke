
m=tests.unit.mcp.testprotocol;

i=proto:core.mcp.protocol;
i=str:std.str;
i=json:std.json;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertcontains(n:str;haystack:str;needle:str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result);

  let validreq="{\"jsonrpc\":\"2.0\",\"id\":42,\"method\":\"tools/list\",\"params\":{}}";
  let parsed=proto.parserequest(validreq);
  let parseok=mt parsed {
    $lokeerr:e false;
    $ok:request true
  };
  results=str.arraypush(results;asserttrue("parse_request: valid request parses";parseok));

  let method=mt parsed {
    $lokeerr:e "error";
    $ok:request request.method
  };
  results=str.arraypush(results;asserteq("parse_request: method is tools/list";method;"tools/list"));

  let id=mt parsed {
    $lokeerr:e 0;
    $ok:request request.id
  };
  results=str.arraypush(results;asserttrue("parse_request: id is 42";id=42));

  let badjson="this is not json";
  let badparsed=proto.parserequest(badjson);
  let badiserr=mt badparsed {
    $lokeerr:e true;
    $ok:request false
  };
  results=str.arraypush(results;asserttrue("parse_request: bad JSON returns error";badiserr));

  let okresp=proto.okresponse(7;"{\"tools\":[]}");
  results=str.arraypush(results;assertcontains("ok_response: contains jsonrpc 2.0";okresp;"\"jsonrpc\":\"2.0\""));
  results=str.arraypush(results;assertcontains("ok_response: contains id 7";okresp;"\"id\":7"));
  results=str.arraypush(results;assertcontains("ok_response: contains result";okresp;"\"result\":{\"tools\":[]}"));

  let errresp=proto.errorresponse(1;-32601;"Method not found");
  results=str.arraypush(results;assertcontains("error_response: contains error code";errresp;"-32601"));
  results=str.arraypush(results;assertcontains("error_response: contains error message";errresp;"Method not found"));

  let init=proto.initresponse("test-server";"0.1.0");
  results=str.arraypush(results;assertcontains("init_response: has protocolVersion";init;"\"protocolVersion\":\"2024-11-05\""));
  results=str.arraypush(results;assertcontains("init_response: has server name";init;"test-server"));
  results=str.arraypush(results;assertcontains("init_response: has tools capability";init;"\"tools\":{}"));

  let toolok=proto.toolresultok("{\"data\":\"hello\"}");
  results=str.arraypush(results;assertcontains("tool_result_ok has content array";toolok;"\"content\":["));
  results=str.arraypush(results;assertcontains("tool_result_ok has type text";toolok;"\"type\":\"text\""));

  let toolerr=proto.toolresulterr("something went wrong");
  results=str.arraypush(results;assertcontains("tool_result_err has isError true";toolerr;"\"isError\":true"));
  results=str.arraypush(results;assertcontains("tool_result_err has error text";toolerr;"something went wrong"));

  let tool1=$mcptool{
    name:"compress";
    description:"Compress JSON to TOON";
    inputschema:"{\"type\":\"object\",\"properties\":{\"json\":{\"type\":\"string\"}},\"required\":[\"json\"]}"
  };
  let tool2=$mcptool{
    name:"decompress";
    description:"Decompress TOON to JSON";
    inputschema:"{\"type\":\"object\",\"properties\":{\"toon\":{\"type\":\"string\"}},\"required\":[\"toon\"]}"
  };
  let toolslist=proto.toolslistresult(@(tool1;tool2));
  results=str.arraypush(results;assertcontains("tools_list_result: has tools array";toolslist;"\"tools\":["));
  results=str.arraypush(results;assertcontains("tools_list_result: has compress";toolslist;"compress"));
  results=str.arraypush(results;assertcontains("tools_list_result: has decompress";toolslist;"decompress"));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(!(i<n)){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1
    }
  };
  <all
};

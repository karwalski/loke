m=test.mcp.protocol;

i=t:std.test;
i=str:std.str;

(* --- stub MCP JSON-RPC functions --- *)

f=encoderequest(id:i64;method:str;params:str):str{
  let r=str.concat("{\"jsonrpc\":\"2.0\",\"id\":";str.fromint(id));
  let r=str.concat(r;",\"method\":\"");
  let r=str.concat(r;method);
  let r=str.concat(r;"\",\"params\":");
  let r=str.concat(r;params);
  let r=str.concat(r;"}");
  <r
};

f=encodenotification(method:str):str{
  let r=str.concat("{\"jsonrpc\":\"2.0\",\"method\":\"";method);
  let r=str.concat(r;"\"}");
  <r
};

f=decodemethod(raw:str):str{
  if(str.contains(raw;"\"method\":\"initialize\"")){<"initialize"};
  if(str.contains(raw;"\"method\":\"tools/list\"")){<"tools/list"};
  if(str.contains(raw;"\"method\":\"tools/call\"")){<"tools/call"};
  if(str.contains(raw;"\"method\":\"shutdown\"")){<"shutdown"};
  <""
};

f=decodeid(raw:str):str{
  if(str.contains(raw;"\"id\":1")){<"1"};
  if(str.contains(raw;"\"id\":42")){<"42"};
  <"0"
};

f=isjsonrpc(raw:str):bool{
  <str.contains(raw;"\"jsonrpc\":\"2.0\"")
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* request encoding: jsonrpc version present *)
  let req=encoderequest(1;"initialize";"{}");
  if(t.assert(str.contains(req;"\"jsonrpc\":\"2.0\"");"request has jsonrpc 2.0")){pass=pass+1}el{fail=fail+1};

  (* request encoding: id present *)
  if(t.assert(str.contains(req;"\"id\":1");"request has id")){pass=pass+1}el{fail=fail+1};

  (* request encoding: method present *)
  if(t.assert(str.contains(req;"\"method\":\"initialize\"");"request has method")){pass=pass+1}el{fail=fail+1};

  (* request encoding: params present *)
  if(t.assert(str.contains(req;"\"params\":");"request has params")){pass=pass+1}el{fail=fail+1};

  (* notification encoding: no id field *)
  let notif=encodenotification("shutdown");
  if(t.assert(!str.contains(notif;"\"id\":");"notification has no id")){pass=pass+1}el{fail=fail+1};

  (* notification encoding: method present *)
  if(t.assert(str.contains(notif;"\"method\":\"shutdown\"");"notification has method")){pass=pass+1}el{fail=fail+1};

  (* response decoding: method extraction *)
  if(t.assert(str.eq(decodemethod(req);"initialize");"decoded method is initialize")){pass=pass+1}el{fail=fail+1};

  (* response decoding: tools/list *)
  let toolsreq=encoderequest(42;"tools/list";"{}");
  if(t.assert(str.eq(decodemethod(toolsreq);"tools/list");"decoded method is tools/list")){pass=pass+1}el{fail=fail+1};

  (* response decoding: id extraction *)
  if(t.assert(str.eq(decodeid(req);"1");"decoded id is 1")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(decodeid(toolsreq);"42");"decoded id is 42")){pass=pass+1}el{fail=fail+1};

  (* isjsonrpc check *)
  if(t.assert(isjsonrpc(req);"encoded request is valid jsonrpc")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!isjsonrpc("not json");"plain text is not jsonrpc")){pass=pass+1}el{fail=fail+1};

  (* unknown method returns empty *)
  if(t.assert(str.eq(decodemethod("{\"method\":\"unknown\"}");"");"unknown method returns empty")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=tests.unit.cli.testi18ncli;

i=tr:loke.platform.i18n.translator;
i=loc:loke.platform.i18n.locales;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttranslated(n:str;key:str):$result{
  let val=tr.t(key);
  if(str.eq(val;key)){
    <fail(n;str.concat("key not translated: ";key))
  }el{
    <pass(n)
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  loc.initdefault();
  tr.setlocale("en-AU");

  results=str.arraypush(results;asserttranslated("cli.starting";"loke.cli.starting"));
  results=str.arraypush(results;asserttranslated("cli.ask_prefix";"loke.cli.ask_prefix"));
  results=str.arraypush(results;asserttranslated("cli.pipeline_not_connected";"loke.cli.pipeline_not_connected"));
  results=str.arraypush(results;asserttranslated("cli.no_jobs";"loke.cli.no_jobs"));
  results=str.arraypush(results;asserttranslated("cli.version";"loke.cli.version"));
  results=str.arraypush(results;asserttranslated("cli.no_agents";"loke.cli.no_agents"));
  results=str.arraypush(results;asserttranslated("cli.no_overnight";"loke.cli.no_overnight"));

  results=str.arraypush(results;asserttranslated("cli.policy.usage";"loke.cli.policy.usage"));
  results=str.arraypush(results;asserttranslated("cli.policy.valid";"loke.cli.policy.valid"));
  results=str.arraypush(results;asserttranslated("cli.policy.validation_failed";"loke.cli.policy.validation_failed"));

  results=str.arraypush(results;asserttranslated("cli.report.usage";"loke.cli.report.usage"));
  results=str.arraypush(results;asserttranslated("cli.report.generate_failed";"loke.cli.report.generate_failed"));
  results=str.arraypush(results;asserttranslated("cli.report.available";"loke.cli.report.available"));

  results=str.arraypush(results;asserttranslated("cli.stats.dashboard";"loke.cli.stats.dashboard"));
  results=str.arraypush(results;asserttranslated("cli.stats.load_failed";"loke.cli.stats.load_failed"));
  results=str.arraypush(results;asserttranslated("cli.stats.total_requests";"loke.cli.stats.total_requests"));

  results=str.arraypush(results;asserttranslated("cli.feedback.usage";"loke.cli.feedback.usage"));
  results=str.arraypush(results;asserttranslated("cli.feedback.issue_report";"loke.cli.feedback.issue_report"));
  results=str.arraypush(results;asserttranslated("cli.feedback.up_to_date";"loke.cli.feedback.up_to_date"));

  results=str.arraypush(results;asserttranslated("cli.verbose.pipeline_run";"loke.cli.verbose.pipeline_run"));
  results=str.arraypush(results;asserttranslated("cli.verbose.status";"loke.cli.verbose.status"));

  results=str.arraypush(results;asserttranslated("cli.locale.usage";"loke.cli.locale.usage"));
  results=str.arraypush(results;asserttranslated("cli.locale.available";"loke.cli.locale.available"));
  results=str.arraypush(results;asserttranslated("cli.locale.validation_ok";"loke.cli.locale.validation_ok"));

  tr.setlocale("en-US");
  results=str.arraypush(results;asserttranslated("en-US cli.starting";"loke.cli.starting"));
  results=str.arraypush(results;asserttranslated("en-US cli.policy.usage";"loke.cli.policy.usage"));
  results=str.arraypush(results;asserttranslated("en-US cli.stats.dashboard";"loke.cli.stats.dashboard"));
  results=str.arraypush(results;asserttranslated("en-US cli.locale.usage";"loke.cli.locale.usage"));

  tr.setlocale("en-AU");

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i=i+1 }el{ all=false; i=i+1 }
    }
  };
  <all
};

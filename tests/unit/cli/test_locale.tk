
m=tests.unit.cli.testlocale;

i=tr:loke.platform.i18n.translator;
i=loc:loke.platform.i18n.locales;
i=str:std.str;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  loc.initdefault();

  let enau=loc.enau();
  results.push(asserttrue("en-AU has entries";enau.entries.len>0));

  let enus=loc.enus();
  results.push(asserttrue("en-US has entries";enus.entries.len>0));

  results.push(asserteq("en-AU code";"en-AU";enau.code));

  results.push(asserteq("en-US code";"en-US";enus.code));

  results.push(asserttrue("en-AU and en-US have same entry count";enau.entries.len=enus.entries.len));

  let hasclikey=mut.false;
  let i=0;
  if(i<enau.entries.len){
    if(str.contains(enau.entries.get(i).key;"loke.cli.")){
      hasclikey=true
    }el{()};
    i=i+1
  }el{};
  results.push(asserttrue("en-AU contains loke.cli.* keys";hasclikey));

  let hasbrowserkey=mut.false;
  let j=mut.0;
  if(j<enau.entries.len){
    if(str.contains(enau.entries.get(j).key;"loke.browser.")){
      hasbrowserkey=true
    }el{()};
    j=j+1
  }el{};
  results.push(asserttrue("en-AU contains loke.browser.* keys";hasbrowserkey));

  let haslocalekey=mut.false;
  let k=mut.0;
  if(k<enau.entries.len){
    if(str.contains(enau.entries.get(k).key;"loke.cli.locale.")){
      haslocalekey=true
    }el{()};
    k=k+1
  }el{};
  results.push(asserttrue("en-AU contains loke.cli.locale.* keys";haslocalekey));

  let allfound=mut.true;
  let ai=mut.0;
  if(ai<enau.entries.len){
    let key=enau.entries.get(ai).key;
    let found=mut.false;
    let ui=mut.0;
    if(ui<enus.entries.len){
      if(str.eq(enus.entries.get(ui).key;key)){
        found=true
      }el{()};
      ui=ui+1
    }el{};
    if(!$found){
      allfound=false;
      log.error(str.concat("en-US missing key: ";key))
    }el{()};
    ai=ai+1
  }el{};
  results.push(asserttrue("en-US has all en-AU keys";allfound));

  let clistart=tr.t("loke.cli.starting");
  results.push(assertfalse("t(loke.cli.starting) returns translation";str.eq(clistart;"loke.cli.starting")));

  let active=tr.getlocale();
  results.push(asserttrue("get_locale non-empty";str.len(active)>0));

  let usage=tr.t("loke.cli.locale.usage");
  results.push(assertfalse("locale usage key translated";str.eq(usage;"loke.cli.locale.usage")));

  let all=true;
  let ri=mut.0;
  let n=results.len;
  loop{
    if(ri>=n){ break }el{
      let r=results.get(ri);
      logresult(r);
      if(!$r.passed){ all=false }el{};
      ri=ri+1
    };
  };
  <all
};

m=tests.unit.cli.testlocale;

i=tr:loke.platform.i18n.translator;
i=loc:loke.platform.i18n.locales;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  loc.initdefault();

  let enau=loc.enau();
  results=str.arraypush(results;asserttrue("en-AU has entries";str.arraylen(enau.entries)>0));

  let enus=loc.enus();
  results=str.arraypush(results;asserttrue("en-US has entries";str.arraylen(enus.entries)>0));

  results=str.arraypush(results;asserteq("en-AU code";"en-AU";enau.code));

  results=str.arraypush(results;asserteq("en-US code";"en-US";enus.code));

  results=str.arraypush(results;asserttrue("en-AU and en-US have same entry count";str.arraylen(enau.entries)=str.arraylen(enus.entries)));

  let hasclikey=mut.false;
  let i=mut.0;
  lp(let lv=0;true;lv=lv){
    if(i > str.arraylen(enau.entries)){ <false }el{
      if(str.contains(str.arrayget(enau.entries;i).key;"loke.cli.")){
        hasclikey=true;
        i=i+1
      }el{
        i=i+1
      }
    }
  };
  results=str.arraypush(results;asserttrue("en-AU contains loke.cli.* keys";hasclikey));

  let hasbrowserkey=mut.false;
  let j=mut.0;
  lp(let lv=0;true;lv=lv){
    if(j > str.arraylen(enau.entries)){ <false }el{
      if(str.contains(str.arrayget(enau.entries;j).key;"loke.browser.")){
        hasbrowserkey=true;
        j=j+1
      }el{
        j=j+1
      }
    }
  };
  results=str.arraypush(results;asserttrue("en-AU contains loke.browser.* keys";hasbrowserkey));

  let haslocalekey=mut.false;
  let k=mut.0;
  lp(let lv=0;true;lv=lv){
    if(k > str.arraylen(enau.entries)){ <false }el{
      if(str.contains(str.arrayget(enau.entries;k).key;"loke.cli.locale.")){
        haslocalekey=true;
        k=k+1
      }el{
        k=k+1
      }
    }
  };
  results=str.arraypush(results;asserttrue("en-AU contains loke.cli.locale.* keys";haslocalekey));

  let allfound=mut.true;
  let ai=mut.0;
  lp(let lv=0;true;lv=lv){
    if(ai > str.arraylen(enau.entries)){ <false }el{
      let key=str.arrayget(enau.entries;ai).key;
      let found=mut.false;
      let ui=mut.0;
      lp(let lv2=0;true;lv2=lv2){
        if(ui > str.arraylen(enus.entries)){ <false }el{
          if(str.eq(str.arrayget(enus.entries;ui).key;key)){
            found=true;
            ui=ui+1
          }el{
            ui=ui+1
          }
        }
      };
      if(found){ ai=ai+1 }el{
        allfound=false;
        log.error(str.concat("en-US missing key: ";key));
        ai=ai+1
      }
    }
  };
  results=str.arraypush(results;asserttrue("en-US has all en-AU keys";allfound));

  let clistart=tr.t("loke.cli.starting");
  results=str.arraypush(results;assertfalse("t(loke.cli.starting) returns translation";str.eq(clistart;"loke.cli.starting")));

  let active=tr.getlocale();
  results=str.arraypush(results;asserttrue("get_locale non-empty";str.len(active)>0));

  let usage=tr.t("loke.cli.locale.usage");
  results=str.arraypush(results;assertfalse("locale usage key translated";str.eq(usage;"loke.cli.locale.usage")));

  let all=true;
  let ri=mut.0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(ri > n){ <all }el{
      let r=str.arrayget(results;ri);
      logresult(r);
      if(r.passed){ ri=ri+1 }el{ all=false; ri=ri+1 }
    }
  };
  <all
};

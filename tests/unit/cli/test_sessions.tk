


m=tests.unit.cli.testsessions;

i=sessions:loke.cli.sessions;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got == want{ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  let store = sessions.newstore();
  let initialcount = str.arraylen(sessions.list(store));
  results = str.arraypush(results;assertinteq("new_store has zero sessions";initialcount;0));

  
  results = str.arraypush(results;asserteq("new_store active_id empty";store.activeid;""));

  
  let activebefore = sessions.getactive(store);
  let nonebefore = true;
  if(activebefore == none{ }else{ nonebefore = false };
  results = str.arraypush(results;asserttrue("get_active none on fresh store";nonebefore));

  
  let sess = sessions.create("chat";"isolated");
  let store2 = sessions.newstore();
  let updatedsessions = @(sessions.$session)@();
  updatedsessions = str.arraypush(updatedsessions;sess);
  let store3 = sessions.$sessionstore{sessions:updatedsessions;activeid:""};
  let countafter = str.arraylen(sessions.list(store3));
  results = str.arraypush(results;assertinteq("create adds a session";countafter;1));

  
  results = str.arraypush(results;asserteq("created session name";sess.name;"chat"));

  
  results = str.arraypush(results;asserteq("created session mode";sess.mode;"isolated"));

  
  results = str.arraypush(results;assertfalse("created session not active by default";sess.active));

  
  let store4 = sessions.activate(store3;sess.id);
  results = str.arraypush(results;asserteq("activate sets active_id";store4.activeid;sess.id));

  
  let activeopt = sessions.getactive(store4);
  let foundactive = false;
  if(activeopt == none{ }else{ foundactive = true };
  results = str.arraypush(results;asserttrue("get_active returns session after activate";foundactive));

  
  let store5 = sessions.deactivate(store4;sess.id);
  let store6 = sessions.$sessionstore{sessions:store5.sessions;activeid:""};
  let activeafterdeactivate = sessions.getactive(store6);
  let noneafter = true;
  if(activeafterdeactivate == none{ }else{ noneafter = false };
  results = str.arraypush(results;asserttrue("get_active none after deactivate";noneafter));

  
  let listed = sessions.list(store4);
  let listedcount = str.arraylen(listed);
  results = str.arraypush(results;assertinteq("list returns all sessions";listedcount;1));

  
  let foundopt = sessions.find(store3;"chat");
  let foundmatch = false;
  if(foundopt == none{ }else{ foundmatch = true };
  results = str.arraypush(results;asserttrue("find by name returns session";foundmatch));

  
  let notfoundopt = sessions.find(store3;"nonexistent-name-xyz");
  let notfound = true;
  if(notfoundopt == none{ }else{ notfound = false };
  results = str.arraypush(results;asserttrue("find nonexistent name returns none";notfound));

  
  let formatted = sessions.formatlist(sessions.newstore());
  let fmtlen = str.len(formatted);
  results = str.arraypush(results;asserttrue("format_list returns non-empty header";fmtlen > 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n{ break }else{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all = false }else{};
      i = i+1
    };
  };
  <all
};


m=tests.unit.cli.testinstaller;

i=installer:cli.installer;
i=str:std.str;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};


f=testdefaultflags():$result{
  let flags=installer.defaultflags();
  if(flags.yes){
    <fail("default_flags.yes";"expected false")
  }el{
    if(flags.skipmodel){
      <fail("default_flags.skip_model";"expected false")
    }el{
      if(str.eq(flags.ollamaurl;"http://localhost:11434")=false){
        <fail("default_flags.ollama_url";"expected http://localhost:11434")
      }el{
        if(str.eq(flags.installdir;"~/.loke")=false){
          <fail("default_flags.install_dir";"expected ~/.loke")
        }el{
          if(str.eq(flags.model;"")=false){
            <fail("default_flags.model";"expected empty string")
          }el{
            <pass("default_flags")
          };
        };
      };
    };
  };
};

f=testparseyesflag():$result{
  let args=@("--yes");
  let flags=installer.parseinstallerflags(args);
  if(flags.yes){
    <pass("parse_yes_flag")
  }el{
    <fail("parse_yes_flag";"--yes not parsed")
  };
};

f=testparsemodelflag():$result{
  let args=@("--model";"qwen2.5:3b");
  let flags=installer.parseinstallerflags(args);
  if(str.eq(flags.model;"qwen2.5:3b")){
    <pass("parse_model_flag")
  }el{
    <fail("parse_model_flag";str.concat("expected qwen2.5:3b, got: ";flags.model))
  };
};

f=testparseskipmodelflag():$result{
  let args=@("--skip-model");
  let flags=installer.parseinstallerflags(args);
  if(flags.skipmodel){
    <pass("parse_skip_model_flag")
  }el{
    <fail("parse_skip_model_flag";"--skip-model not parsed")
  };
};

f=testparseollamaurlflag():$result{
  let args=@("--ollama-url";"http://192.168.1.50:11434");
  let flags=installer.parseinstallerflags(args);
  if(str.eq(flags.ollamaurl;"http://192.168.1.50:11434")){
    <pass("parse_ollama_url_flag")
  }el{
    <fail("parse_ollama_url_flag";str.concat("expected custom url, got: ";flags.ollamaurl))
  };
};

f=testparseinstalldirflag():$result{
  let args=@("--install-dir";"/opt/loke");
  let flags=installer.parseinstallerflags(args);
  if(str.eq(flags.installdir;"/opt/loke")){
    <pass("parse_install_dir_flag")
  }el{
    <fail("parse_install_dir_flag";str.concat("expected /opt/loke, got: ";flags.installdir))
  };
};

f=testparsecombinedflags():$result{
  let args=@("--yes";"--model";"qwen2.5:14b";"--ollama-url";"http://myhost:11434");
  let flags=installer.parseinstallerflags(args);
  if(flags.yes=false){
    <fail("parse_combined_flags";"--yes not parsed")
  }el{
    if(str.eq(flags.model;"qwen2.5:14b")=false){
      <fail("parse_combined_flags";"--model not parsed")
    }el{
      if(str.eq(flags.ollamaurl;"http://myhost:11434")=false){
        <fail("parse_combined_flags";"--ollama-url not parsed")
      }el{
        <pass("parse_combined_flags")
      };
    };
  };
};

f=testparseemptyargs():$result{
  let args=@str@();
  let flags=installer.parseinstallerflags(args);
  if(flags.yes){
    <fail("parse_empty_args";"yes should be false")
  }el{
    if(flags.skipmodel){
      <fail("parse_empty_args";"skip_model should be false")
    }el{
      <pass("parse_empty_args")
    };
  };
};

f=testparseskipmodelwithurl():$result{
  let args=@("--skip-model";"--ollama-url";"http://192.168.1.50:11434");
  let flags=installer.parseinstallerflags(args);
  if(flags.skipmodel=false){
    <fail("parse_skip_model_with_url";"skip_model not set")
  }el{
    if(str.eq(flags.ollamaurl;"http://192.168.1.50:11434")=false){
      <fail("parse_skip_model_with_url";"ollama_url wrong")
    }el{
      <pass("parse_skip_model_with_url")
    };
  };
};


f=testrecommendmodel4gb():$result{
  let rec=installer.recommendmodel(4);
  if(str.eq(rec.modelid;"qwen2.5:1.5b")){
    <pass("recommend_model_4gb")
  }el{
    <fail("recommend_model_4gb";str.concat("expected qwen2.5:1.5b, got: ";rec.modelid))
  };
};


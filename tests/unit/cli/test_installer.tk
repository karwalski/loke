  };
};


f=testyesflagselectsnoninteractive():$result{
  let flags=installer.parseinstallerflags(@("--yes"));
  if(flags.yes){
    if(flags.skipmodel=false){
      <pass("yes_flag_selects_non_interactive")
    }el{
      <fail("yes_flag_selects_non_interactive";"skip_model should be false")
    };
  }el{
    <fail("yes_flag_selects_non_interactive";"yes should be true")
  };
};

f=testskipmodelflagselectsskipmode():$result{
  let flags=installer.parseinstallerflags(@("--skip-model";"--ollama-url";"http://remote:11434"));
  if(flags.skipmodel){
    if(str.eq(flags.ollamaurl;"http://remote:11434")){
      <pass("skip_model_flag_selects_skip_mode")
    }el{
      <fail("skip_model_flag_selects_skip_mode";"ollama_url wrong")
    };
  }el{
    <fail("skip_model_flag_selects_skip_mode";"skip_model should be true")
  };
};

f=testmodeloverrideflag():$result{
  let flags=installer.parseinstallerflags(@("--yes";"--model";"qwen2.5:3b"));
  if(str.eq(flags.model;"qwen2.5:3b")){
    <pass("model_override_flag")
  }el{
    <fail("model_override_flag";"model override not applied")
  };
};

f=testtrailingmodelflagwithoutvalue():$result{
  let flags=installer.parseinstallerflags(@("--model"));
  if(str.eq(flags.model;"")){
    <pass("trailing_model_flag_without_value")
  }el{
    <fail("trailing_model_flag_without_value";"expected empty model")
  };
};


f=runall():bool{
  let results=@$result@();

  results.push(testdefaultflags());
  results.push(testparseyesflag());
  results.push(testparsemodelflag());
  results.push(testparseskipmodelflag());
  results.push(testparseollamaurlflag());
  results.push(testparseinstalldirflag());
  results.push(testparsecombinedflags());
  results.push(testparseemptyargs());
  results.push(testparseskipmodelwithurl());

  results.push(testrecommendmodel4gb());
  results.push(testrecommendmodel8gb());
  results.push(testrecommendmodel16gb());
  results.push(testrecommendmodel32gb());
  results.push(testrecommendmodel64gb());
  results.push(testrecommendmodel128gb());
  results.push(testrecommendmodelboundary7gb());
  results.push(testrecommendmodelboundary15gb());

  results.push(testrecommendmodelsize4gb());
  results.push(testrecommendmodelsize16gb());

  results.push(testyesflagselectsnoninteractive());
  results.push(testskipmodelflagselectsskipmode());
  results.push(testmodeloverrideflag());
  results.push(testtrailingmodelflagwithoutvalue());

  let allpass=mut.true;
  let i=0;
  if(i<results.len){
    logresult(results.get(i));
    if(results.get(i).passed=false){
      allpass=false
    }el{()};
    i=i+1
  }el{};

  let total=str.fromint(results.len);
  let passedcount=mut.0;
  let j=mut.0;
  if(j<results.len){
    if(results.get(j).passed){
      passedcount=passedcount+1
    }el{()};
    j=j+1
  }el{};
  log.info(str.concat(str.fromint(passedcount);str.concat("/";str.concat(total;" tests passed"))));

  <allpass
};

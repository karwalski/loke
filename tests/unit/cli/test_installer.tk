f=testrecommendmodelsize4gb():$result{
  let rec=installer.recommendmodel(4);
  if(rec.sizegb=1.0){
    <pass("recommend_model_size_4gb")
  }el{
    <fail("recommend_model_size_4gb";"expected 1.0 GB")
  };
};


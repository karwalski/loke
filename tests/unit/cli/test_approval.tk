m=tests.unit.cli.testapproval;

i=approval:core.governance.approval;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);
  let norules=@(i64);

  let alwayspub=approval.requiresapproval("always";"public";"openai";"chat";norules);
  results=str.arraypush(results;asserttrue("always mode + public requires approval";alwayspub));

  let alwayslocal=approval.requiresapproval("always";"public";"ollama";"chat";norules);
  results=str.arraypush(results;asserttrue("always mode + ollama requires approval";alwayslocal));

  let neverconf=approval.requiresapproval("never";"confidential";"openai";"chat";norules);
  results=str.arraypush(results;assertfalse("never mode + confidential skips approval";neverconf));

  let nevercloud=approval.requiresapproval("never";"restricted";"anthropic";"chat";norules);
  results=str.arraypush(results;assertfalse("never mode + restricted + cloud skips";nevercloud));

  let sensconf=approval.requiresapproval("by_sensitivity";"confidential";"openai";"chat";norules);
  results=str.arraypush(results;asserttrue("by_sensitivity + confidential requires";sensconf));

  let sensrest=approval.requiresapproval("by_sensitivity";"restricted";"openai";"chat";norules);
  results=str.arraypush(results;asserttrue("by_sensitivity + restricted requires";sensrest));

  let senspub=approval.requiresapproval("by_sensitivity";"public";"openai";"chat";norules);
  results=str.arraypush(results;assertfalse("by_sensitivity + public skips";senspub));

  let sensint=approval.requiresapproval("by_sensitivity";"internal";"openai";"chat";norules);
  results=str.arraypush(results;assertfalse("by_sensitivity + internal skips";sensint));

  let provopenai=approval.requiresapproval("by_provider";"public";"openai";"chat";norules);
  results=str.arraypush(results;asserttrue("by_provider + openai requires";provopenai));

  let provanthropic=approval.requiresapproval("by_provider";"public";"anthropic";"chat";norules);
  results=str.arraypush(results;asserttrue("by_provider + anthropic requires";provanthropic));

  let provollama=approval.requiresapproval("by_provider";"public";"ollama";"chat";norules);
  results=str.arraypush(results;assertfalse("by_provider + ollama skips";provollama));

  let provmlx=approval.requiresapproval("by_provider";"public";"mlx";"chat";norules);
  results=str.arraypush(results;assertfalse("by_provider + mlx skips";provmlx));

  let ruleswithchat=@(i64);
  ruleswithchat=str.arraypush(ruleswithchat;approval.$dontaskrule{
    tasktype:"chat";providerid:"openai";maxsensitivity:"public";createdat:1000
  });
  let suppressed=approval.requiresapproval("always";"public";"openai";"chat";ruleswithchat);
  results=str.arraypush(results;assertfalse("dont-ask rule suppresses always mode";suppressed));

  let notsuppressed=approval.requiresapproval("always";"public";"openai";"code_review";ruleswithchat);
  results=str.arraypush(results;asserttrue("dont-ask rule for chat does not suppress code_review";notsuppressed));

  let samediff=approval.generatediff("hello world";"hello world");
  let allunchanged=mut.true;
  let di=mut.0;
  lp(let lv=0;true;lv=lv){
    if(di > str.arraylen(samediff)){ <false }el{
      if(str.eq(str.arrayget(samediff;di).linetype;"unchanged") = false){
        allunchanged=false;
        di=di+1
      }el{
        di=di+1
      }
    }
  };
  results=str.arraypush(results;asserttrue("identical text = all unchanged";allunchanged));

  let diffresult=approval.generatediff("original line";"transformed line");
  let hasremoved=false;
  let hasadded=false;
  let dj=mut.0;
  lp(let lv=0;true;lv=lv){
    if(dj > str.arraylen(diffresult)){ <false }el{
      if(str.eq(str.arrayget(diffresult;dj).linetype;"removed")){hasremoved=true; dj=dj+1}el{
        if(str.eq(str.arrayget(diffresult;dj).linetype;"added")){hasadded=true; dj=dj+1}el{dj=dj+1}
      }
    }
  };
  results=str.arraypush(results;asserttrue("different text has removed lines";hasremoved));
  results=str.arraypush(results;asserttrue("different text has added lines";hasadded));

  let multidiff=approval.generatediff("line1\nline2\nline3";"line1\nchanged\nline3");
  results=str.arraypush(results;asserttrue("multi-line diff has entries";str.arraylen(multidiff)>0));

  results=str.arraypush(results;asserteq("first line unchanged";"unchanged";str.arrayget(multidiff;0).linetype));

  let addonly=approval.generatediff("";"new content");
  let dk=mut.0;
  let onlyadded=true;
  lp(let lv=0;true;lv=lv){
    if(dk > str.arraylen(addonly)){ <false }el{
      if(str.eq(str.arrayget(addonly;dk).linetype;"removed")){onlyadded=false; dk=dk+1}el{dk=dk+1}
    }
  };
  results=str.arraypush(results;asserttrue("empty original has no removed lines";onlyadded));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i=i+1 }el{ all=false; i=i+1 }
    }
  };
  <all
};

m=test.cli.integrationstruncate;

i=t:std.test;
i=str:std.str;
i=u8:shared.utf8;
i=ig:cli.integrations;

(* F10.49 — `loke integrations list` cuts an endpoint URL to 38 bytes for its column, and the
   cut never splits a UTF-8 character. It was `str.slice(s;0;width)`, so a URL with a
   non-ASCII host or path (an internationalised name, a path in Japanese) printed ending in
   part of a character. Still a byte width; the cut is shared.utf8.prefix. *)

f=repeat(s:str;n:i64):str{
  let out=mut."";
  lp(let i=0;i<n;i=i+1){ out="\(out)\(s)" };
  <out
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let jp="日";
  let emoji="😀";
  let e2="é";
  let a="a";
  let x="x";

  if(t.asserteq(ig.truncate(repeat(a;50);38);repeat(a;38);"ASCII is cut at exactly the width")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ig.truncate(repeat(a;10);38);repeat(a;10);"and a short value is left alone")){pass=pass+1}el{fail=fail+1};

  (* 13 three-byte characters are 39 bytes; byte 38 is inside the 13th. *)
  let c3=ig.truncate(repeat(jp;13);38);
  if(t.asserteq(c3;repeat(jp;12);"3-byte characters crossing byte 38 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(c3);"and the column is valid UTF-8")){pass=pass+1}el{fail=fail+1};
  (* "a" and 10 emoji are 41 bytes; byte 38 is inside the 10th. *)
  let c4=ig.truncate("\(a)\(repeat(emoji;10))";38);
  if(t.asserteq(c4;"\(a)\(repeat(emoji;9))";"4-byte characters crossing byte 38 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(c4);"and that column is valid UTF-8")){pass=pass+1}el{fail=fail+1};
  let c2=ig.truncate("\(repeat(a;37))\(e2)\(x)";38);
  if(t.asserteq(c2;repeat(a;37);"a 2-byte character split after its lead byte is dropped whole")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.cli.session;

i=t:std.test;
i=str:std.str;

(* --- stub session functions --- *)

f=createsession(name:str;provider:str):str{
  let s=str.concat("{\"id\":\"sess_001\",\"name\":\"";name);
  let s=str.concat(s;"\",\"provider\":\"");
  let s=str.concat(s;provider);
  let s=str.concat(s;"\",\"turns\":0,\"active\":true}");
  <s
};

f=sessionid(sessionjson:str):str{
  if(str.contains(sessionjson;"\"id\":\"sess_001\"")){<"sess_001"};
  if(str.contains(sessionjson;"\"id\":\"sess_002\"")){<"sess_002"};
  <""
};

f=sessionactive(sessionjson:str):bool{
  <str.contains(sessionjson;"\"active\":true")
};

f=findsession(sessions:str;name:str):str{
  if(str.contains(sessions;name)){
    <str.concat("found:";name)
  }el{
    <""
  }
};

f=sessionturns(sessionjson:str):i64{
  if(str.contains(sessionjson;"\"turns\":0")){<0};
  if(str.contains(sessionjson;"\"turns\":5")){<5};
  <-1
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* session creation: has id *)
  let s1=createsession("my-chat";"anthropic");
  if(t.assert(str.contains(s1;"sess_001");"session has id")){pass=pass+1}el{fail=fail+1};

  (* session creation: has name *)
  if(t.assert(str.contains(s1;"my-chat");"session has name")){pass=pass+1}el{fail=fail+1};

  (* session creation: has provider *)
  if(t.assert(str.contains(s1;"anthropic");"session has provider")){pass=pass+1}el{fail=fail+1};

  (* session creation: starts with zero turns *)
  if(t.assert(sessionturns(s1)=0;"new session has zero turns")){pass=pass+1}el{fail=fail+1};

  (* session creation: starts active *)
  if(t.assert(sessionactive(s1);"new session is active")){pass=pass+1}el{fail=fail+1};

  (* session id extraction *)
  if(t.assert(str.eq(sessionid(s1);"sess_001");"session id extracted correctly")){pass=pass+1}el{fail=fail+1};

  (* session find: existing *)
  let sessions="[{\"name\":\"my-chat\"},{\"name\":\"other\"}]";
  let found=findsession(sessions;"my-chat");
  if(t.assert(str.contains(found;"my-chat");"found existing session by name")){pass=pass+1}el{fail=fail+1};

  (* session find: not found *)
  let notfound=findsession(sessions;"nonexistent");
  if(t.assert(str.eq(notfound;"");"unfound session returns empty")){pass=pass+1}el{fail=fail+1};

  (* session JSON is non-empty *)
  if(t.assert(str.len(s1)>0;"session JSON is non-empty")){pass=pass+1}el{fail=fail+1};

  (* session find result has prefix *)
  if(t.assert(str.contains(found;"found:");"find result has found prefix")){pass=pass+1}el{fail=fail+1};

  (* session with different provider *)
  let s2=createsession("local-chat";"ollama");
  if(t.assert(str.contains(s2;"ollama");"ollama session has provider")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.cli.port;

i=t:std.test;
i=io:std.io;
i=port:cli.port;

(* F10.55. cli.port.parseport reads the stored `server.port` setting. toke 3.2.0 read a failed
   str.toint as 0, so a stored value that was not a number asked for port 0: the OS answers that
   with any free ephemeral port, and resolveport kept it. Anything that is not a whole number
   from 1 to 65535 is now the default port, as a missing setting is. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  if(t.assert(port.parseport("8080")==(8080 as i32);"a stored port is read")){pass=pass+1}el{fail=fail+1};
  if(t.assert(port.parseport(" 11431 ")==(11431 as i32);"with surrounding spaces trimmed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(port.parseport("abc")==port.defaultport();"a value that is not a number is the default port, not port 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(port.parseport("")==port.defaultport();"an empty value is the default port")){pass=pass+1}el{fail=fail+1};
  if(t.assert(port.parseport("0")==port.defaultport();"port 0 is the default port")){pass=pass+1}el{fail=fail+1};
  if(t.assert(port.parseport("70000")==port.defaultport();"a port above 65535 is the default port, not a truncated number")){pass=pass+1}el{fail=fail+1};
  io.println("test_port: \(pass) passed, \(fail) failed");
  <fail
};

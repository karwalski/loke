m=tests.unit.cli.testreport;

i=str:std.str;
i=log:shared.log;
      i=i+1

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
t=$parsedflags{ template:$str; start:$str; end:$str; format:$str };

f=parsereportflags(args:@$str:$parsedflags{
  let template="compliance_summary";
  let start="2026-01-01";
  let end="2026-12-31";
  let format="text";
  let i=1;
  loop{
    if(i>=args.len){break}el{
      let flag=args.get(i);
      if(str.eq(flag;"--template")){
        if(i+1<args.len){template=args.get(i+1);i=i+2}el{i=i+1};
      }el{
        if(str.eq(flag;"--start")){
          if(i+1<args.len){start=args.get(i+1);i=i+2}el{i=i+1};
        }el{
          if(str.eq(flag;"--end")){
            if(i+1<args.len){end=args.get(i+1);i=i+2}el{i=i+1};
          }el{
            if(str.eq(flag;"--format")){
              if(i+1<args.len){format=args.get(i+1);i=i+2}el{i=i+1};
            }el{i=i+1};
          };

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};
f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};
f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};
        };
      };
    };
  };
  <$parsedflags{template:$template;start:$start;end:$end;format:$format};
};
f=runall():bool{
  let results=@$result@();


  let gensub="generate";
  results.push(asserttrue("generate subcommand recognised";str.eq(gensub;"generate")));

  let tplsub="templates";
  results.push(asserttrue("templates subcommand recognised";str.eq(tplsub;"templates")));

  let bad="export";
  let known=str.eq(bad;"generate") || str.eq(bad;"templates");
  results.push(assertfalse("unknown subcommand is not generate/templates";known));

  let empty=@str@();
  results.push(asserttrue("empty args triggers usage";empty.len<1));


  let defaults=parsereportflags(@("generate"));
  results.push(asserteq("default template";"compliance_summary";defaults.template));

  results.push(asserteq("default start";"2026-01-01";defaults.start));

  results.push(asserteq("default end";"2026-12-31";defaults.end));

  results.push(asserteq("default format";"text";defaults.format));


  let tplargs=@("generate";"--template";"pii_detection_log");
  let tplparsed=parsereportflags(tplargs);
  results.push(asserteq("--template override";"pii_detection_log";tplparsed.template));

  let startargs=@("generate";"--start";"2026-03-01");
  let startparsed=parsereportflags(startargs);
  results.push(asserteq("--start override";"2026-03-01";startparsed.start));

  let endargs=@("generate";"--end";"2026-06-30");
  let endparsed=parsereportflags(endargs);
  results.push(asserteq("--end override";"2026-06-30";endparsed.end));

  let fmtargs=@("generate";"--format";"json");
  let fmtparsed=parsereportflags(fmtargs);
  results.push(asserteq("--format override";"json";fmtparsed.format));

  let multiargs=@("generate";"--template";"routing_decisions";"--start";"2026-02-01";"--end";"2026-04-30";"--format";"csv");
  let multiparsed=parsereportflags(multiargs);
  results.push(asserteq("multi template";"routing_decisions";multiparsed.template));
  results.push(asserteq("multi start";"2026-02-01";multiparsed.start));
  results.push(asserteq("multi end";"2026-04-30";multiparsed.end));
  results.push(asserteq("multi format";"csv";multiparsed.format));

  let danglingargs=@("generate";"--template");
  let danglingparsed=parsereportflags(danglingargs);
  results.push(asserteq("dangling --template keeps default";"compliance_summary";danglingparsed.template));

  let unknownflagargs=@("generate";"--verbose";"--format";"json");
  let unknownparsed=parsereportflags(unknownflagargs);
  results.push(asserteq("unknown flag skipped, format still parsed";"json";unknownparsed.format));

  let reorderargs=@("generate";"--format";"csv";"--template";"cost_savings");
  let reorderparsed=parsereportflags(reorderargs);
  results.push(asserteq("reordered template";"cost_savings";reorderparsed.template));
  results.push(asserteq("reordered format";"csv";reorderparsed.format));

  let all=true;
  let i=0;
  let n=results.len;
  loop{
    if(i>=n){ break }el{
      let r=results.get(i);
      logresult(r);
      if(!$r.passed){ all=false }el{};
    };
  };
  <all
};

m=tests.unit.cli.testreport;

i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };
t=$parsedflags{ template:str; start:str; end:str; format:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=parsereportflags(args:@str):$parsedflags{
  let template="compliance_summary";
  let start="2026-01-01";
  let end="2026-12-31";
  let format="text";
  let i=mut.1;
  lp(let lv=0;true;lv=lv){
    if(i > str.arraylen(args)){ <$parsedflags{template:template;start:start;end:end;format:format} }el{
      let flag=str.arrayget(args;i);
      if(str.eq(flag;"--template")){
        if(i+1<str.arraylen(args)){template=str.arrayget(args;i+1);i=i+2}el{i=i+1}
      }el{
        if(str.eq(flag;"--start")){
          if(i+1<str.arraylen(args)){start=str.arrayget(args;i+1);i=i+2}el{i=i+1}
        }el{
          if(str.eq(flag;"--end")){
            if(i+1<str.arraylen(args)){end=str.arrayget(args;i+1);i=i+2}el{i=i+1}
          }el{
            if(str.eq(flag;"--format")){
              if(i+1<str.arraylen(args)){format=str.arrayget(args;i+1);i=i+2}el{i=i+1}
            }el{i=i+1}
          }
        }
      }
    }
  };
  <$parsedflags{template:template;start:start;end:end;format:format}
};

f=runall():bool{
  let results=@($result);

  let gensub="generate";
  results=str.arraypush(results;asserttrue("generate subcommand recognised";str.eq(gensub;"generate")));

  let tplsub="templates";
  results=str.arraypush(results;asserttrue("templates subcommand recognised";str.eq(tplsub;"templates")));

  let bad="export";
  let known=false;
  if(str.eq(bad;"generate")){ known=true }el{
    if(str.eq(bad;"templates")){ known=true }el{ known=false }
  };
  results=str.arraypush(results;assertfalse("unknown subcommand is not generate/templates";known));

  let empty=@(str);
  results=str.arraypush(results;asserttrue("empty args triggers usage";str.arraylen(empty)<1));

  let defaults=parsereportflags(@("generate"));
  results=str.arraypush(results;asserteq("default template";"compliance_summary";defaults.template));

  results=str.arraypush(results;asserteq("default start";"2026-01-01";defaults.start));

  results=str.arraypush(results;asserteq("default end";"2026-12-31";defaults.end));

  results=str.arraypush(results;asserteq("default format";"text";defaults.format));

  let tplargs=@("generate";"--template";"pii_detection_log");
  let tplparsed=parsereportflags(tplargs);
  results=str.arraypush(results;asserteq("--template override";"pii_detection_log";tplparsed.template));

  let startargs=@("generate";"--start";"2026-03-01");
  let startparsed=parsereportflags(startargs);
  results=str.arraypush(results;asserteq("--start override";"2026-03-01";startparsed.start));

  let endargs=@("generate";"--end";"2026-06-30");
  let endparsed=parsereportflags(endargs);
  results=str.arraypush(results;asserteq("--end override";"2026-06-30";endparsed.end));

  let fmtargs=@("generate";"--format";"json");
  let fmtparsed=parsereportflags(fmtargs);
  results=str.arraypush(results;asserteq("--format override";"json";fmtparsed.format));

  let multiargs=@("generate";"--template";"routing_decisions";"--start";"2026-02-01";"--end";"2026-04-30";"--format";"csv");
  let multiparsed=parsereportflags(multiargs);
  results=str.arraypush(results;asserteq("multi template";"routing_decisions";multiparsed.template));
  results=str.arraypush(results;asserteq("multi start";"2026-02-01";multiparsed.start));
  results=str.arraypush(results;asserteq("multi end";"2026-04-30";multiparsed.end));
  results=str.arraypush(results;asserteq("multi format";"csv";multiparsed.format));

  let danglingargs=@("generate";"--template");
  let danglingparsed=parsereportflags(danglingargs);
  results=str.arraypush(results;asserteq("dangling --template keeps default";"compliance_summary";danglingparsed.template));

  let unknownflagargs=@("generate";"--verbose";"--format";"json");
  let unknownparsed=parsereportflags(unknownflagargs);
  results=str.arraypush(results;asserteq("unknown flag skipped, format still parsed";"json";unknownparsed.format));

  let reorderargs=@("generate";"--format";"csv";"--template";"cost_savings");
  let reorderparsed=parsereportflags(reorderargs);
  results=str.arraypush(results;asserteq("reordered template";"cost_savings";reorderparsed.template));
  results=str.arraypush(results;asserteq("reordered format";"csv";reorderparsed.format));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i=i+1 }el{ all=false; i=i+1 }
    }
  };
  <all
};

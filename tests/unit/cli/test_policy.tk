m=tests.unit.cli.testpolicy;

i=cmd:cli.commands;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  let helpcmd=cmd.parse(@("loke"));
  let ishelp=mt helpcmd {
    $help:v true;
    $unknown:v false
  };
  results=str.arraypush(results;asserttrue("bare loke gives help";ishelp));

  let unknowncmd=cmd.parse(@("loke";"policy"));
  let isunknown=mt unknowncmd {
    $unknown:msg true;
    $help:v false
  };
  results=str.arraypush(results;asserttrue("policy routes through main dispatch not parser";isunknown));

  let listargs=@("list");
  results=str.arraypush(results;asserttrue("list subcommand has 1 element";str.arraylen(listargs)=1));
  results=str.arraypush(results;asserteq("list subcommand value";"list";str.arrayget(listargs;0)));

  let validatenopath=@("validate");
  results=str.arraypush(results;asserttrue("validate without path has len 1";str.arraylen(validatenopath)<2));

  let validatewithpath=@("validate";"./policies/team.yaml");
  results=str.arraypush(results;asserttrue("validate with path has len >= 2";str.arraylen(validatewithpath)>1));
  results=str.arraypush(results;asserteq("validate path arg";"./policies/team.yaml";str.arrayget(validatewithpath;1)));

  let shownopath=@("show");
  results=str.arraypush(results;asserttrue("show without path has len 1";str.arraylen(shownopath)<2));

  let showwithpath=@("show";"/etc/loke/enterprise.yaml");
  results=str.arraypush(results;asserttrue("show with path has len >= 2";str.arraylen(showwithpath)>1));
  results=str.arraypush(results;asserteq("show path arg";"/etc/loke/enterprise.yaml";str.arrayget(showwithpath;1)));

  let emptyargs=@(str);
  results=str.arraypush(results;asserttrue("empty args triggers usage";str.arraylen(emptyargs)<1));

  let badsub="remove";
  let known=false;
  if(str.eq(badsub;"list")){ known=true }el{
    if(str.eq(badsub;"validate")){ known=true }el{
      if(str.eq(badsub;"show")){ known=true }el{ known=false }
    }
  };
  results=str.arraypush(results;assertfalse("unknown subcommand is not list/validate/show";known));

  let partial="lis";
  let partialmatch=str.eq(partial;"list");
  results=str.arraypush(results;assertfalse("partial 'lis' does not match 'list'";partialmatch));

  let upper="LIST";
  let uppermatch=str.eq(upper;"list");
  results=str.arraypush(results;assertfalse("uppercase LIST does not match list";uppermatch));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i=i+1 }el{ all=false; i=i+1 }
    }
  };
  <all
};


m=tests.unit.cli.testpolicy;

i=cmd:cli.commands;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();



  let helpcmd=cmd.parse(@("loke"));
  let ishelp=mt helpcmd {
    $help true;
     false
  };
  results.push(asserttrue("bare loke gives help";ishelp));

  let unknowncmd=cmd.parse(@("loke";"policy"));
  let isunknown=mt unknowncmd {
    $unknown:msg true;
     false
  };
  results.push(asserttrue("policy routes through main dispatch not parser";isunknown));


  let listargs=@("list");
  results.push(asserttrue("list subcommand has 1 element";listargs.len=1));
  results.push(asserteq("list subcommand value";"list";listargs.get(0)));

  let validatenopath=@("validate");
  results.push(asserttrue("validate without path has len 1";validatenopath.len<2));

  let validatewithpath=@("validate";"./policies/team.yaml");
  results.push(asserttrue("validate with path has len >= 2";validatewithpath.len>=2));
  results.push(asserteq("validate path arg";"./policies/team.yaml";validatewithpath.get(1)));

  let shownopath=@("show");
  results.push(asserttrue("show without path has len 1";shownopath.len<2));

  let showwithpath=@("show";"/etc/loke/enterprise.yaml");
  results.push(asserttrue("show with path has len >= 2";showwithpath.len>=2));
  results.push(asserteq("show path arg";"/etc/loke/enterprise.yaml";showwithpath.get(1)));

  let emptyargs=@str@();
  results.push(asserttrue("empty args triggers usage";emptyargs.len<1));

  let badsub="remove";
  let known=str.eq(badsub;"list") || str.eq(badsub;"validate") || str.eq(badsub;"show");
  results.push(assertfalse("unknown subcommand is not list/validate/show";known));

  let partial="lis";
  let partialmatch=str.eq(partial;"list");
  results.push(assertfalse("partial 'lis' does not match 'list'";partialmatch));

  let upper="LIST";
  let uppermatch=str.eq(upper;"list");
  results.push(assertfalse("uppercase LIST does not match list";uppermatch));

  let all=true;
  let i=0;
  let n=results.len;
  loop{
    if(i>=n){ break }el{
      let r=results.get(i);
      logresult(r);
      if(!$r.passed){ all=false }el{};
      i=i+1
    };
  };
  <all
};

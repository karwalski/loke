m=tests.unit.cli.testverbose;

i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };
t=$mockevent{
  stage:str;
  status:str;
  durationms:i32;
  errormessage:str
};

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=formateventline(symbol:str;label:str;durationms:i32;errormessage:str):str{
  let duration=mut.""; if(durationms>0){duration=str.concat(" (";str.concat(str.fromint(durationms);"ms)"))}el{};
  let errorsuffix=mut.""; if(str.len(errormessage)>0){errorsuffix=str.concat(" ERROR: ";errormessage)}el{};
  <str.concat(symbol;str.concat(" ";str.concat(label;str.concat(duration;errorsuffix))))
};

f=formatsummaryline(stagescomplete:i32;totaldurationms:i32;stageserror:i32):str{
  let errpart=mut.""; if(stageserror>0){errpart=str.concat(", ";str.concat(str.fromint(stageserror);" errors"))}el{};
  <str.concat(str.fromint(stagescomplete);str.concat("/9 stages, ";str.concat(str.fromint(totaldurationms);str.concat("ms";errpart))))
};

f=runall():bool{
  let results=@($result);

  let line1=formateventline("[x]";"Privacy Filter";45;"");
  results=str.arraypush(results;asserttrue("complete line contains symbol";str.contains(line1;"[x]")));
  results=str.arraypush(results;asserttrue("complete line contains label";str.contains(line1;"Privacy Filter")));
  results=str.arraypush(results;asserttrue("complete line contains duration";str.contains(line1;"45ms")));

  let line2=formateventline("[!]";"LLM Router";0;"connection timeout");
  results=str.arraypush(results;asserttrue("error line contains symbol";str.contains(line2;"[!]")));
  results=str.arraypush(results;asserttrue("error line contains ERROR prefix";str.contains(line2;"ERROR: ")));
  results=str.arraypush(results;asserttrue("error line contains message";str.contains(line2;"connection timeout")));

  let line3=formateventline("[ ]";"Token Optimiser";0;"");
  results=str.arraypush(results;asserttrue("skipped line contains symbol";str.contains(line3;"[ ]")));
  results=str.arraypush(results;assertfalse("skipped line has no duration suffix";str.contains(line3;"ms")));
  results=str.arraypush(results;assertfalse("skipped line has no ERROR";str.contains(line3;"ERROR")));

  let line4=formateventline("[!]";"Response Restore";120;"data corruption");
  results=str.arraypush(results;asserttrue("error+duration has duration";str.contains(line4;"120ms")));
  results=str.arraypush(results;asserttrue("error+duration has error";str.contains(line4;"data corruption")));

  let summary1=formatsummaryline(9;350;0);
  results=str.arraypush(results;asserttrue("summary has 9/9 stages";str.contains(summary1;"9/9 stages")));
  results=str.arraypush(results;asserttrue("summary has duration";str.contains(summary1;"350ms")));
  results=str.arraypush(results;assertfalse("summary has no errors suffix";str.contains(summary1;"errors")));

  let summary2=formatsummaryline(7;500;2);
  results=str.arraypush(results;asserttrue("partial summary has 7/9";str.contains(summary2;"7/9 stages")));
  results=str.arraypush(results;asserttrue("partial summary has errors";str.contains(summary2;"2 errors")));

  let summary3=formatsummaryline(0;0;0);
  results=str.arraypush(results;asserttrue("zero summary has 0/9";str.contains(summary3;"0/9 stages")));

  let summary4=formatsummaryline(8;200;1);
  results=str.arraypush(results;asserttrue("single error summary has 1 errors";str.contains(summary4;"1 errors")));

  let runid="run-abc-123";
  let header=str.concat("Pipeline run: ";runid);
  results=str.arraypush(results;asserttrue("header contains run_id";str.contains(header;"run-abc-123")));

  let requestid="req-xyz-789";
  let reqline=str.concat("Request: ";requestid);
  results=str.arraypush(results;asserttrue("request line contains request_id";str.contains(reqline;"req-xyz-789")));

  results=str.arraypush(results;asserttrue("complete is valid status";str.eq("complete";"complete")));
  results=str.arraypush(results;asserttrue("error is valid status";str.eq("error";"error")));
  results=str.arraypush(results;asserttrue("skipped is valid status";str.eq("skipped";"skipped")));
  results=str.arraypush(results;asserttrue("pending is valid status";str.eq("pending";"pending")));

  let nodur=formateventline("[x]";"Cache Check";0;"");
  results=str.arraypush(results;assertfalse("zero duration has no ms suffix";str.contains(nodur;"0ms")));

  let hasdur=formateventline("[x]";"Cache Check";12;"");
  results=str.arraypush(results;asserttrue("positive duration has ms suffix";str.contains(hasdur;"12ms")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i=i+1 }el{ all=false; i=i+1 }
    }
  };
  <all
};

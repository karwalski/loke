m=tests.unit.cli.testverbose;

i=str:std.str;
i=log:shared.log;
      i=i+1;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
t=$mockevent{
  stage:$str;
  status:$str;
  durationms:i32;
  errormessage:$str
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};
f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};
f=formateventline(symbol:$str;label:$str;durationms:i32;errormessage:$str):$str{
  let duration=if(durationms>0):i64{str.concat(" (";str.concat(str.fromint(durationms);"ms)"))}el{""};
  let errorsuffix=if(str.len(errormessage)>0):i64{str.concat(" ERROR: ";errormessage)}el{""};
  <str.concat(symbol;str.concat(" ";str.concat(label;str.concat(duration;errorsuffix))))
};
f=formatsummaryline(stagescomplete:i32;totaldurationms:i32;stageserror:i32):$str{
  <str.concat(str.fromint(stagescomplete);str.concat("/9 stages, ";str.concat(str.fromint(totaldurationms);str.concat("ms";if(stageserror>0){str.concat(", ";str.concat(str.fromint(stageserror);" errors"))}el{""}))))
};
f=runall():bool{
  let results=@$result@();


  let line1=formateventline("[x]";"Privacy Filter";45;"");
  results.push(asserttrue("complete line contains symbol";str.contains(line1;"[x]")));
  results.push(asserttrue("complete line contains label";str.contains(line1;"Privacy Filter")));
  results.push(asserttrue("complete line contains duration";str.contains(line1;"45ms")));

  let line2=formateventline("[!]";"LLM Router";0;"connection timeout");
  results.push(asserttrue("error line contains symbol";str.contains(line2;"[!]")));
  results.push(asserttrue("error line contains ERROR prefix";str.contains(line2;"ERROR: ")));
  results.push(asserttrue("error line contains message";str.contains(line2;"connection timeout")));

  let line3=formateventline("[ ]";"Token Optimiser";0;"");
  results.push(asserttrue("skipped line contains symbol";str.contains(line3;"[ ]")));
  results.push(assertfalse("skipped line has no duration suffix";str.contains(line3;"ms")));
  results.push(assertfalse("skipped line has no ERROR";str.contains(line3;"ERROR")));

  let line4=formateventline("[!]";"Response Restore";120;"data corruption");
  results.push(asserttrue("error+duration has duration";str.contains(line4;"120ms")));
  results.push(asserttrue("error+duration has error";str.contains(line4;"data corruption")));


  let summary1=formatsummaryline(9;350;0);
  results.push(asserttrue("summary has 9/9 stages";str.contains(summary1;"9/9 stages")));
  results.push(asserttrue("summary has duration";str.contains(summary1;"350ms")));
  results.push(assertfalse("summary has no errors suffix";str.contains(summary1;"errors")));

  let summary2=formatsummaryline(7;500;2);
  results.push(asserttrue("partial summary has 7/9";str.contains(summary2;"7/9 stages")));
  results.push(asserttrue("partial summary has errors";str.contains(summary2;"2 errors")));

  let summary3=formatsummaryline(0;0;0);
  results.push(asserttrue("zero summary has 0/9";str.contains(summary3;"0/9 stages")));

  let summary4=formatsummaryline(8;200;1);
  results.push(asserttrue("single error summary has 1 errors";str.contains(summary4;"1 errors")));


  let runid="run-abc-123";
  let header=str.concat("Pipeline run: ";runid);
  results.push(asserttrue("header contains run_id";str.contains(header;"run-abc-123")));

  let requestid="req-xyz-789";
  let reqline=str.concat("Request: ";requestid);
  results.push(asserttrue("request line contains request_id";str.contains(reqline;"req-xyz-789")));


  results.push(asserttrue("complete is valid status";str.eq("complete";"complete")));
  results.push(asserttrue("error is valid status";str.eq("error";"error")));
  results.push(asserttrue("skipped is valid status";str.eq("skipped";"skipped")));
  results.push(asserttrue("pending is valid status";str.eq("pending";"pending")));

  let nodur=formateventline("[x]";"Cache Check";0;"");
  results.push(assertfalse("zero duration has no ms suffix";str.contains(nodur;"0ms")));

  let hasdur=formateventline("[x]";"Cache Check";12;"");
  results.push(asserttrue("positive duration has ms suffix";str.contains(hasdur;"12ms")));

  let all=true;
  let i=0;
  let n=results.len;
  loop{
    if(i>=n){ break }el{
      let r=results.get(i);
      logresult(r);
      if(!$r.passed){ all=false }el{};
    };
  };
  <all
};

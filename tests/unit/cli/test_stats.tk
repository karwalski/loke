m=tests.unit.cli.teststats;

i=str:std.str;
i=log:shared.log;
      i=i+1;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
t=$mocksummary{
  totalrequests:i32;
  totaltokenssaved:i32;
  totalcostsavedusd:f64;
  totalpiiintercepted:i32;
  localrequests:i32;
  cloudrequests:i32;
  localratio:f64;
  cachehitrate:f64
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};
f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got=want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};
f=makemocksummary():$mocksummary{
  <$mocksummary{
    totalrequests:1500;
    totaltokenssaved:250000;
    totalcostsavedusd:42.75;
    totalpiiintercepted:87;
    localrequests:1200;
    cloudrequests:300;
    localratio:80.0;
    cachehitrate:35.5
  };
};
f=makeemptysummary():$mocksummary{
  <$mocksummary{
    totalrequests:0;
    totaltokenssaved:0;
    totalcostsavedusd:0.0;
    totalpiiintercepted:0;
    localrequests:0;
    cloudrequests:0;
    localratio:0.0;
    cachehitrate:0.0
  };
};
f=formatstatline(label:$str;value:$str):$str{
  <str.concat(label;value)
};
f=runall():bool{
  let results=@$result@();
  let summary=makemocksummary();


  results.push(asserttrue("total_requests non-negative";summary.totalrequests>0));

  results.push(asserttrue("total_tokens_saved non-negative";summary.totaltokenssaved>0));

  results.push(asserttrue("total_cost_saved_usd non-negative";summary.totalcostsavedusd>0.0));

  results.push(asserttrue("total_pii_intercepted non-negative";summary.totalpiiintercepted>0));

  results.push(assertinteq("local + cloud = total";summary.localrequests+summary.cloudrequests;summary.totalrequests));

  results.push(asserttrue("local_ratio >= 0";summary.localratio>0.0));
  results.push(asserttrue("local_ratio <= 100";summary.localratio<=100.0));

  results.push(asserttrue("cache_hit_rate >= 0";summary.cachehitrate>0.0));
  results.push(asserttrue("cache_hit_rate <= 100";summary.cachehitrate<=100.0));


  let reqline=formatstatline("Total requests: ";str.fromint(summary.totalrequests));
  results.push(asserttrue("requests line contains count";str.contains(reqline;"1500")));

  let tokline=formatstatline("Tokens saved: ";str.fromint(summary.totaltokenssaved));
  results.push(asserttrue("tokens line contains count";str.contains(tokline;"250000")));

  let costline=formatstatline("Cost saved: $";str.fromfloat(summary.totalcostsavedusd));
  results.push(asserttrue("cost line contains value";str.contains(costline;"42")));

  let piiline=formatstatline("PII intercepted: ";str.fromint(summary.totalpiiintercepted));
  results.push(asserttrue("pii line contains count";str.contains(piiline;"87")));

  let ratioline=str.concat(str.fromfloat(summary.localratio);"%");
  results.push(asserttrue("ratio line ends with %";str.contains(ratioline;"%")));

  let cacheline=str.concat(str.fromfloat(summary.cachehitrate);"%");
  results.push(asserttrue("cache line ends with %";str.contains(cacheline;"%")));


  let empty=makeemptysummary();
  results.push(assertinteq("empty total_requests";empty.totalrequests;0));
  results.push(assertinteq("empty local_requests";empty.localrequests;0));
  results.push(assertinteq("empty cloud_requests";empty.cloudrequests;0));
  results.push(assertinteq("empty pii_intercepted";empty.totalpiiintercepted;0));

  results.push(assertinteq("empty local + cloud = total";empty.localrequests+empty.cloudrequests;empty.totalrequests));

  let all=true;
  let i=0;
  let n=results.len;
  lp(true){
    if(i>n){ break }el{
      let r=results.get(i);
      logresult(r);
      if(!i64){ all=false }el{};
    };
  };
  <all
};

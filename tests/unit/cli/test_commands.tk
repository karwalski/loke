m=test.cli.commands;

i=t:std.test;
i=str:std.str;

(* --- stub CLI command functions --- *)

f=parsecommand(input:str):str{
  if(str.contains(input;"chat ")){<"chat"};
  if(str.contains(input;"config ")){<"config"};
  if(str.contains(input;"status")){<"status"};
  if(str.contains(input;"help")){<"help"};
  if(str.contains(input;"session ")){<"session"};
  if(str.contains(input;"version")){<"version"};
  <""
};

f=extractarg(input:str;flag:str):str{
  if(str.contains(input;flag)){
    if(str.eq(flag;"--model")){<"claude-3-opus"};
    if(str.eq(flag;"--provider")){<"anthropic"};
    if(str.eq(flag;"--output")){<"json"};
    <"true"
  }el{
    <""
  }
};

f=isvalidcommand(cmd:str):bool{
  if(str.eq(cmd;"chat")){<true};
  if(str.eq(cmd;"config")){<true};
  if(str.eq(cmd;"status")){<true};
  if(str.eq(cmd;"help")){<true};
  if(str.eq(cmd;"session")){<true};
  if(str.eq(cmd;"version")){<true};
  <false
};

f=helptext(cmd:str):str{
  if(str.eq(cmd;"chat")){<"Usage: loke chat [message]"};
  if(str.eq(cmd;"status")){<"Usage: loke status"};
  <"Usage: loke [command]"
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* command parsing *)
  if(t.assert(str.eq(parsecommand("chat hello");"chat");"parse chat command")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(parsecommand("config set key");"config");"parse config command")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(parsecommand("status");"status");"parse status command")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(parsecommand("help");"help");"parse help command")){pass=pass+1}el{fail=fail+1};

  (* unknown command returns empty *)
  if(t.assert(str.eq(parsecommand("foobar");"");"unknown command returns empty")){pass=pass+1}el{fail=fail+1};

  (* arg extraction *)
  if(t.assert(str.eq(extractarg("chat --model claude-3-opus hello";"--model");"claude-3-opus");"extract model arg")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(extractarg("chat --provider anthropic";"--provider");"anthropic");"extract provider arg")){pass=pass+1}el{fail=fail+1};

  (* missing arg returns empty *)
  if(t.assert(str.eq(extractarg("chat hello";"--model");"");"missing arg returns empty")){pass=pass+1}el{fail=fail+1};

  (* valid command checks *)
  if(t.assert(isvalidcommand("chat");"chat is valid command")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!isvalidcommand("foobar");"foobar is not valid command")){pass=pass+1}el{fail=fail+1};

  (* help text *)
  if(t.assert(str.contains(helptext("chat");"Usage:");"chat help has Usage prefix")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(helptext("status"))>0;"status help text is non-empty")){pass=pass+1}el{fail=fail+1};

  <fail
};


m=tests.unit.cli.testcommands;

i=cmd:cli.commands;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();


  let bare=cmd.parse(@("loke"));
  let ishelp=mt bare {$help true; false};
  results.push(asserttrue("bare loke gives help";ishelp));

  let help=cmd.parse(@("loke";"help"));
  let ishelp2=mt help {$help true; false};
  results.push(asserttrue("loke help gives help";ishelp2));

  let ver=cmd.parse(@("loke";"--version"));
  let isver=mt ver {$version true; false};
  results.push(asserttrue("loke --version gives version";isver));

  let doc=cmd.parse(@("loke";"doctor"));
  let isdoc=mt doc {$doctor true; false};
  results.push(asserttrue("loke doctor gives doctor";isdoc));


  let ask=cmd.parse(@("loke";"ask";"hello"));
  let isask=mt ask {$ask:prompt str.eq(prompt;"hello"); false};
  results.push(asserttrue("loke ask hello parses correctly";isask));

  let askno=cmd.parse(@("loke";"ask"));
  let isaskerr=mt askno {$unknown:msg true; false};
  results.push(asserttrue("loke ask without prompt gives unknown";isaskerr));


  let pipe=cmd.parse(@("loke";"pipeline";"test"));
  let ispipe=mt pipe {$pipeline:prompt str.eq(prompt;"test"); false};
  results.push(asserttrue("loke pipeline test parses correctly";ispipe));

  let pipeno=cmd.parse(@("loke";"pipeline"));
  let ispipeerr=mt pipeno {$unknown:msg true; false};
  results.push(asserttrue("loke pipeline without prompt gives unknown";ispipeerr));


  let ql=cmd.parse(@("loke";"queue";"list"));
  let isql=mt ql {$queuelist true; false};
  results.push(asserttrue("loke queue list parses correctly";isql));

  let qc=cmd.parse(@("loke";"queue";"cancel";"abc"));
  let isqc=mt qc {$queuecancel:id str.eq(id;"abc"); false};
  results.push(asserttrue("loke queue cancel abc parses correctly";isqc));

  let qcno=cmd.parse(@("loke";"queue";"cancel"));
  let isqcerr=mt qcno {$unknown:msg true; false};
  results.push(asserttrue("loke queue cancel without id gives unknown";isqcerr));

  let qno=cmd.parse(@("loke";"queue"));
  let isqerr=mt qno {$unknown:msg true; false};
  results.push(asserttrue("loke queue without action gives unknown";isqerr));

  let qbad=cmd.parse(@("loke";"queue";"badaction"));
  let isqbad=mt qbad {$unknown:msg str.contains(msg;"badaction"); false};
  results.push(asserttrue("loke queue badaction gives unknown with action name";isqbad));


  let ml=cmd.parse(@("loke";"models";"list"));
  let isml=mt ml {$modelslist true; false};
  results.push(asserttrue("loke models list parses correctly";isml));

  let mr=cmd.parse(@("loke";"models";"recommend"));
  let ismr=mt mr {$modelsrecommend true; false};
  results.push(asserttrue("loke models recommend parses correctly";ismr));

  let mno=cmd.parse(@("loke";"models"));
  let ismerr=mt mno {$unknown:msg true; false};
  results.push(asserttrue("loke models without action gives unknown";ismerr));


  let ms=cmd.parse(@("loke";"memory";"search";"query"));
  let isms=mt ms {$memorysearch:q str.eq(q;"query"); false};
  results.push(asserttrue("loke memory search query parses correctly";isms));

  let msno=cmd.parse(@("loke";"memory";"search"));
  let ismserr=mt msno {$unknown:msg true; false};
  results.push(asserttrue("loke memory search without query gives unknown";ismserr));

  let memno=cmd.parse(@("loke";"memory"));
  let ismemerr=mt memno {$unknown:msg true; false};
  results.push(asserttrue("loke memory without action gives unknown";ismemerr));


  let al=cmd.parse(@("loke";"agents";"list"));
  let isal=mt al {$agentslist true; false};
  results.push(asserttrue("loke agents list parses correctly";isal));

  let ano=cmd.parse(@("loke";"agents"));
  let isaerr=mt ano {$unknown:msg true; false};
  results.push(asserttrue("loke agents without action gives unknown";isaerr));


  let os=cmd.parse(@("loke";"overnight";"status"));
  let isos=mt os {$overnightstatus true; false};
  results.push(asserttrue("loke overnight status parses correctly";isos));

  let ono=cmd.parse(@("loke";"overnight"));
  let isoerr=mt ono {$unknown:msg true; false};
  results.push(asserttrue("loke overnight without action gives unknown";isoerr));


  let loc=cmd.parse(@("loke";"locale";"list"));
  let isloc=mt loc {$locale:args args.len>0; false};
  results.push(asserttrue("loke locale list returns locale with args";isloc));

  let locbare=cmd.parse(@("loke";"locale"));
  let islocbare=mt locbare {$locale:args args.len=0; false};
  results.push(asserttrue("loke locale returns locale with empty args";islocbare));


  let unk=cmd.parse(@("loke";"frobnicate"));
  let isunk=mt unk {$unknown:msg str.contains(msg;"frobnicate"); false};
  results.push(asserttrue("unrecognised command gives unknown with name";isunk));


  let langhelp=cmd.parse(@("loke";"--lang";"en-US";"help"));
  let islanghelp=mt langhelp {$help true; false};
  results.push(asserttrue("--lang en-US help gives help";islanghelp));

  let langdoc=cmd.parse(@("loke";"--lang";"en-AU";"doctor"));
  let islangdoc=mt langdoc {$doctor true; false};
  results.push(asserttrue("--lang en-AU doctor gives doctor";islangdoc));

  let langonly=cmd.parse(@("loke";"--lang"));
  let islangonlyhelp=mt langonly {$help true; false};
  results.push(asserttrue("--lang without value gives help";islangonlyhelp));

  let langnocmd=cmd.parse(@("loke";"--lang";"en-US"));
  let islangnocmdhelp=mt langnocmd {$help true; false};
  results.push(asserttrue("--lang en-US without command gives help";islangnocmdhelp));


  let usage=cmd.usage();
  results.push(asserttrue("usage is non-empty";str.len(usage)>0));

  results.push(asserttrue("usage contains ask";str.contains(usage;"ask")));
  results.push(asserttrue("usage contains pipeline";str.contains(usage;"pipeline")));
  results.push(asserttrue("usage contains queue";str.contains(usage;"queue")));
  results.push(asserttrue("usage contains models";str.contains(usage;"models")));
  results.push(asserttrue("usage contains memory";str.contains(usage;"memory")));
  results.push(asserttrue("usage contains doctor";str.contains(usage;"doctor")));
  results.push(asserttrue("usage contains locale";str.contains(usage;"locale")));
  results.push(asserttrue("usage contains --version";str.contains(usage;"--version")));
  results.push(asserttrue("usage contains --lang";str.contains(usage;"--lang")));

  let all=true;
  let i=0;
  let n=results.len;
  loop{
    if(i>=n){ break }el{
      let r=results.get(i);
      logresult(r);
      if(!$r.passed){ all=false }el{};
      i=i+1;
    };
  };
  <all
};

m=test.cli.commands;

i=t:std.test;
i=str:std.str;
i=cmd:cli.commands;

(* X4b.10 / X7.2 - parsing the command line into a command, through the real cli.commands.

   This file used to declare its own parsecommand, extractarg and isvalidcommand and assert
   them against themselves, so it could not fail when the CLI's parser broke. It now drives
   cli.commands.parse with argv as main receives it: args[0] is the program. *)

f=kind(args:@str):str{
  let c:$command=cmd.parse(args);
  <c.kind
};

f=arg(args:@str):str{
  let c:$command=cmd.parse(args);
  <c.arg
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.asserteq(kind(@("loke"));"help";"no subcommand shows help")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"help"));"help";"help is help")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"--version"));"version";"--version is version")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"doctor"));"doctor";"doctor is doctor")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"ask";"summarise this"));"ask";"ask takes a prompt")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"ask";"summarise this"));"summarise this";"and carries it as the argument")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"ask"));"unknown";"ask without a prompt is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(arg(@("loke";"ask"));"usage: loke ask");"with its usage")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"queue";"list"));"queuelist";"queue list")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"queue";"cancel";"job-7"));"queuecancel";"queue cancel takes an id")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"queue";"cancel";"job-7"));"job-7";"which is carried")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"queue";"cancel"));"unknown";"queue cancel without an id is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(arg(@("loke";"queue";"purge"));"unknown queue action: purge");"an unknown queue action is named")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"models";"list"));"modelslist";"models list")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"models";"recommend"));"modelsrecommend";"models recommend")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"memory";"search";"invoices"));"memorysearch";"memory search takes a query")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"memory";"search";"invoices"));"invoices";"which is carried")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"agents";"list"));"agentslist";"agents list")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"overnight";"status"));"overnightstatus";"overnight status")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"frobnicate"));"unknown";"an unknown command is unknown")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(arg(@("loke";"frobnicate"));"unknown command: frobnicate");"and named")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cmd.usage();"loke ask") && str.contains(cmd.usage();"loke doctor");"usage lists the commands")){pass=pass+1}el{fail=fail+1};

  <fail
}

m=test.cli.commands;

i=t:std.test;
i=str:std.str;
i=cmd:cli.commands;

(* X4b.10 / X7.2 - parsing the command line into a command, through the real cli.commands.

   This file used to declare its own parsecommand, extractarg and isvalidcommand and assert
   them against themselves, so it could not fail when the CLI's parser broke. It now drives
   cli.commands.parse with argv as main receives it: args[0] is the program. *)

f=kind(args:@str):str{
  let c:$command=cmd.parse(args);
  <c.kind
};

f=arg(args:@str):str{
  let c:$command=cmd.parse(args);
  <c.arg
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.asserteq(kind(@("loke"));"help";"no subcommand shows help")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"help"));"help";"help is help")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"--version"));"version";"--version is version")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"doctor"));"doctor";"doctor is doctor")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"ask";"summarise this"));"ask";"ask takes a prompt")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"ask";"summarise this"));"summarise this";"and carries it as the argument")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"ask"));"unknown";"ask without a prompt is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(arg(@("loke";"ask"));"usage: loke ask");"with its usage")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"queue";"list"));"queuelist";"queue list")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"queue";"cancel";"job-7"));"queuecancel";"queue cancel takes an id")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"queue";"cancel";"job-7"));"job-7";"which is carried")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"queue";"cancel"));"unknown";"queue cancel without an id is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(arg(@("loke";"queue";"purge"));"unknown queue action: purge");"an unknown queue action is named")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"models";"list"));"modelslist";"models list")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"models";"recommend"));"modelsrecommend";"models recommend")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"memory";"search";"invoices"));"memorysearch";"memory search takes a query")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"memory";"search";"invoices"));"invoices";"which is carried")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"agents";"list"));"agentslist";"agents list")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"overnight";"status"));"overnightstatus";"overnight status")){pass=pass+1}el{fail=fail+1};

  (* VM1.6 *)
  if(t.asserteq(kind(@("loke";"benchmark";"llama3"));"benchmark";"benchmark takes a model")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"benchmark";"llama3"));"llama3";"which is carried")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cmd.benchmarkout(@("loke";"benchmark";"llama3"));"";"with no --out the default path is used")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark";"llama3";"--out";"/tmp/r.jsonl"));"benchmark";"--out <path> is accepted")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(cmd.benchmarkout(@("loke";"benchmark";"llama3";"--out";"/tmp/r.jsonl"));"/tmp/r.jsonl";"and its path is read")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark"));"unknown";"benchmark without a model is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark";"llama3";"--out"));"unknown";"--out without a path is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark";"llama3";"--in";"x"));"unknown";"an unknown flag is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cmd.usage();"loke benchmark");"usage lists benchmark")){pass=pass+1}el{fail=fail+1};
  (* VM1.3: --runs, in either order with --out, each flag once. *)
  if(t.asserteq(str.fromint(cmd.benchmarkruns(@("loke";"benchmark";"llama3")));"0";"with no --runs the bench default is used")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(str.fromint(cmd.benchmarkruns(@("loke";"benchmark";"llama3";"--runs";"6")));"6";"--runs 6 is read")){pass=pass+1}el{fail=fail+1};
  let both=@("loke";"benchmark";"llama3";"--out";"/tmp/r.jsonl";"--runs";"4");
  if(t.asserteq(kind(both);"benchmark";"--out then --runs is accepted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(cmd.benchmarkout(both);"/tmp/r.jsonl") && cmd.benchmarkruns(both)==4;"and both values are read")){pass=pass+1}el{fail=fail+1};
  let swapped=@("loke";"benchmark";"llama3";"--runs";"3";"--out";"/tmp/s.jsonl");
  if(t.assert(str.eq(cmd.benchmarkout(swapped);"/tmp/s.jsonl") && cmd.benchmarkruns(swapped)==3;"--runs then --out reads both too")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark";"llama3";"--runs";"five"));"unknown";"a --runs that is not a number is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark";"llama3";"--runs";"0"));"unknown";"--runs 0 is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark";"llama3";"--runs";"4";"--runs";"5"));"unknown";"--runs twice is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"benchmark";"llama3";"--runs"));"unknown";"--runs without a count is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cmd.usage();"--runs");"usage lists --runs")){pass=pass+1}el{fail=fail+1};
  (* X8.4. Erasure only with both words; everything else is a preview or a refusal. *)
  if(t.asserteq(kind(@("loke";"erase";"--everything";"--yes"));"erase";"erase --everything --yes erases")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"erase";"--everything"));"erasepreview";"without --yes it only previews")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"erase"));"unknown";"erase alone is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"erase";"--yes"));"unknown";"--yes without --everything is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"erase";"--everything";"--no"));"unknown";"a flag other than --yes is refused, not read as consent")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"erase";"--everything";"--yes";"x"));"unknown";"and so is a trailing argument")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cmd.usage();"loke erase --everything");"usage lists erase")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(kind(@("loke";"frobnicate"));"unknown";"an unknown command is unknown")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(arg(@("loke";"frobnicate"));"unknown command: frobnicate");"and named")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cmd.usage();"loke ask") && str.contains(cmd.usage();"loke doctor");"usage lists the commands")){pass=pass+1}el{fail=fail+1};

  (* G1.6 - loke kill-switch. The kind carries the action and scope, arg the target. *)
  if(t.asserteq(kind(@("loke";"kill-switch";"on"));"killswitch.on.global";"kill-switch on is the global switch")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"off"));"killswitch.off.global";"kill-switch off releases it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"on";"--use-case";"browser-chat"));"killswitch.on.use_case";"--use-case scopes it to a use case")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"kill-switch";"on";"--use-case";"browser-chat"));"browser-chat";"naming the use case")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"off";"--agent";"daily-digest"));"killswitch.off.agent";"--agent scopes it to an agent")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(arg(@("loke";"kill-switch";"off";"--agent";"daily-digest"));"daily-digest";"naming the agent")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"on";"--provider";"openai"));"killswitch.on.provider";"--provider scopes it to a provider")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"status"));"killswitch.status";"kill-switch status")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"on";"--use-case"));"unknown";"a scope flag without a target is refused, not read as global")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"on";"--team";"x"));"unknown";"an unknown scope flag is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"kill-switch";"toggle"));"unknown";"an unknown action is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(cmd.usage();"loke kill-switch");"usage lists kill-switch")){pass=pass+1}el{fail=fail+1};

  <fail
}

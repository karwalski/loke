m=test.cli.proxyopts;

i=t:std.test;
i=px:cli.proxy;

(* F10.57 - `loke proxy --port <n>` through the real cli.proxy.parseopts.

   RED BEFORE THE FIX: a --port that is not a number read as port 0, which the proxy then
   bound (the OS picks any free port) and announced as "listening on localhost:0". It now
   keeps the default port. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let given=px.parseopts(@("claude";"--port";"9000"));
  if(t.assert((given.port as i64)==9000;"a numeric --port is used")){pass=pass+1}el{fail=fail+1};

  let deflt=px.parseopts(@("claude"));
  let bad=px.parseopts(@("claude";"--port";"90x0"));
  if(t.assert((bad.port as i64)!=0;"a --port that is not a number is not port 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert((bad.port as i64)==(deflt.port as i64);"it keeps the default port")){pass=pass+1}el{fail=fail+1};

  <fail
};

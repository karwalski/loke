
m=tests.unit.cli.testqueuememory;

i=cmd:cli.commands;
i=queue:core.models.queue;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();


  let cancelcmd=cmd.parse(@("loke";"queue";"cancel";"abc123"));
  let iscancel=mt cancelcmd {
    $queuecancel:id str.eq(id;"abc123");
     false
  };
  results=str.arraypush(results;asserttrue("queue cancel parses correctly";iscancel));

  let cancelnoid=cmd.parse(@("loke";"queue";"cancel"));
  let isunknown=mt cancelnoid {
    $unknown:msg true;
     false
  };
  results=str.arraypush(results;asserttrue("queue cancel missing id gives unknown";isunknown));

  let q=queue.newqueue();
  let jobid=queue.enqueue(q;"llama3";"test prompt";queue.$$user);
  results=str.arraypush(results;asserttrue("enqueue returns non-empty id";str.len(jobid)>0));

  let pendingjob=mt queue.nextpending(q) {
    $ok:j j;
    $err:e queue.$queuejob{
      id:"";modelid:"";prompt:"";priority:i64.$evaluation:i64;
      status:i64.$pending:i64;createdat:"";startedat:"";
      completedat:"";result:"";error:"";estimatedtoks:0.0
    };
  };
  results=str.arraypush(results;asserteq("pending job id matches";jobid;pendingjob.id));

  queue.cancel(q;jobid);

  let aftercancel=mt queue.nextpending(q) {
    $ok:j false;
    $err:e true
  };
  results=str.arraypush(results;asserttrue("no pending after cancel";aftercancel));


  let searchcmd=cmd.parse(@("loke";"memory";"search";"hello"));
  let issearch=mt searchcmd {
    $memorysearch:q str.eq(q;"hello");
     false
  };
  results=str.arraypush(results;asserttrue("memory search parses correctly";issearch));

  let searchnoquery=cmd.parse(@("loke";"memory";"search"));
  let isunknown2=mt searchnoquery {
    $unknown:msg true;
     false
  };
  results=str.arraypush(results;asserttrue("memory search missing query gives unknown";isunknown2));

  let memorynoaction=cmd.parse(@("loke";"memory"));
  let isunknown3=mt memorynoaction {
    $unknown:msg true;
     false
  };
  results=str.arraypush(results;asserttrue("memory without action gives unknown";isunknown3));

  let listcmd=cmd.parse(@("loke";"queue";"list"));
  let islist=mt listcmd {
    $queuelist:true;
     false
  };
  results=str.arraypush(results;asserttrue("queue list parses correctly";islist));

  let emptyq=queue.newqueue();
  let formatted=queue.formatlist(emptyq);
  results=str.arraypush(results;asserttrue("empty queue format is non-empty";str.len(formatted)>0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

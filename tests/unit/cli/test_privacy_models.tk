m=test.cli.privacymodels;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=cmd:cli.commands;
i=pmod:cli.privacymodels;
i=mr:core.privacy.modelregistry;

(* F3b.7 — `loke privacy add-model`, `list-models` and `remove-model`, through the real
   cli.commands.parse and cli.privacymodels, with argv as main receives it (args[0] is the
   program). The registrations are written to the test's own HOME (run_tests.sh gives each
   test a throwaway one), and read back through core.privacy.modelregistry, as the pipeline
   reads them. *)

f=kind(args:@str):str{
  let c:$command=cmd.parse(args);
  <c.kind
};

f=parsed(args:@str):$addmodel{
  <pmod.parseadd(args)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── The command ──────────────────────────────────────────────────────────── *)
  if(t.asserteq(kind(@("loke";"privacy";"add-model";"dslim/bert-base-NER";"--url";"http://127.0.0.1:11436";"--label";"PER=PERSON"));"privacymodeladd";"privacy add-model is a command")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"privacy";"add-model"));"unknown";"add-model with no model id is a usage error")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"privacy";"list-models"));"privacymodellist";"privacy list-models")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"privacy";"remove-model";"dslim/bert-base-NER"));"privacymodelremove";"privacy remove-model <id>")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"privacy";"remove-model"));"unknown";"remove-model with no id is a usage error")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(kind(@("loke";"privacy";"evaluate";"some text"));"privacyevaluate";"privacy evaluate is unchanged")){pass=pass+1}el{fail=fail+1};

  (* ── add-model's arguments ────────────────────────────────────────────────── *)
  let p=parsed(@("loke";"privacy";"add-model";"dslim/bert-base-NER";"--label";"PER=PERSON";"--url";"http://127.0.0.1:11436";"--label";"LOC=LOCATION";"--threshold";"0.5";"--priority";"7"));
  if(t.asserteq(p.error;"";"a full add-model parses")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(p.model.id;"dslim/bert-base-NER") && str.eq(p.model.url;"http://127.0.0.1:11436");"with its model id and url")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(str.join(",";p.model.labels);"PER=PERSON,LOC=LOCATION";"each --label in order, flags in any order")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(p.model.threshold;"0.5") && p.model.priority==7 && p.model.enabled;"its threshold and priority, enabled")){pass=pass+1}el{fail=fail+1};
  let d=parsed(@("loke";"privacy";"add-model";"m";"--url";"http://localhost:9000";"--label";"SECRET=SECRET";"--disabled"));
  if(t.assert(str.len(d.error)==0 && str.eq(d.model.threshold;"0") && d.model.priority==5 && !d.model.enabled;"defaults: threshold 0, priority 5; --disabled registers it off")){pass=pass+1}el{fail=fail+1};
  let unmapped=parsed(@("loke";"privacy";"add-model";"m";"--url";"http://127.0.0.1:9000";"--label";"MISC=MISCELLANEOUS"));
  if(t.assert(str.startswith(unmapped.error;"model m: the label mapping MISC=MISCELLANEOUS maps MISC to MISCELLANEOUS, which is not an entity type loke knows");"a label mapped to a type loke does not know is refused")){pass=pass+1}el{fail=fail+1};
  let nolabel=parsed(@("loke";"privacy";"add-model";"m";"--url";"http://127.0.0.1:9000"));
  if(t.asserteq(nolabel.error;"model m: a model needs a label mapping: at least one MODEL_LABEL=TYPE";"no --label is refused")){pass=pass+1}el{fail=fail+1};
  let nourl=parsed(@("loke";"privacy";"add-model";"m";"--label";"PER=PERSON"));
  if(t.assert(str.contains(nourl.error;"is not an http:// address on this machine");"no --url is refused")){pass=pass+1}el{fail=fail+1};
  let remote=parsed(@("loke";"privacy";"add-model";"m";"--url";"http://192.168.1.4:9000";"--label";"PER=PERSON"));
  if(t.assert(str.contains(remote.error;"the url http://192.168.1.4:9000 is not an http:// address on this machine");"a url off this machine is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(parsed(@("loke";"privacy";"add-model";"m";"--url")).error;"--url needs a value";"a flag with no value is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(parsed(@("loke";"privacy";"add-model";"m";"--format";"onnx")).error;"--format is not an add-model option";"an unknown flag is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(parsed(@("loke";"privacy";"add-model";"m";"--url";"http://127.0.0.1:1";"--label";"PER=PERSON";"--priority";"high")).error;"--priority must be a whole number from 0 to 1000";"a priority that is not a number is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(parsed(@("loke";"privacy";"add-model";"m";"--url";"http://127.0.0.1:1";"--label";"PER=PERSON";"--threshold";"2")).error;"model m: confidence_threshold must be a number from 0 to 1";"a threshold above 1 is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(parsed(@("loke";"privacy";"add-model";"--url";"http://127.0.0.1:1")).error;"add-model needs a model id before its flags";"a flag in the model id's place is refused")){pass=pass+1}el{fail=fail+1};

  (* ── Writing, listing and removing ────────────────────────────────────────── *)
  if(t.assert(!file.exists(mr.modelspath());"there is no privacy-models.json in the test's HOME")){pass=pass+1}el{fail=fail+1};
  let badrc=pmod.handle("privacymodeladd";@("loke";"privacy";"add-model";"m";"--url";"http://127.0.0.1:9000";"--label";"MISC=MISCELLANEOUS"));
  if(t.assert(badrc==1 && !file.exists(mr.modelspath());"a refused registration exits 1 and writes nothing")){pass=pass+1}el{fail=fail+1};
  let addrc=pmod.handle("privacymodeladd";@("loke";"privacy";"add-model";"dslim/bert-base-NER";"--url";"http://127.0.0.1:11436";"--label";"PER=PERSON";"--threshold";"0.5"));
  let s1=mr.load(mr.modelspath());
  if(t.assert(addrc==0 && str.len(s1.error)==0 && s1.models.len==1 && str.eq(s1.models.get(0).id;"dslim/bert-base-NER");"add-model writes a registration the pipeline reads")){pass=pass+1}el{fail=fail+1};
  let add2=pmod.handle("privacymodeladd";@("loke";"privacy";"add-model";"local/m2";"--url";"http://localhost:11437";"--label";"SECRET=SECRET"));
  if(t.assert(add2==0 && mr.load(mr.modelspath()).models.len==2;"a second model is added beside it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(pmod.handle("privacymodellist";@("loke";"privacy";"list-models"))==0;"list-models exits 0")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(pmod.entryline(s1.models.get(0));"model:dslim/bert-base-NER  http://127.0.0.1:11436  labels=PER=PERSON  confidence_threshold=0.5  priority=5  enabled";"and lists each with its layer id, url, mapping, threshold and priority")){pass=pass+1}el{fail=fail+1};
  if(t.assert(pmod.handle("privacymodelremove";@("loke";"privacy";"remove-model";"nope"))==1;"removing a model that is not registered exits 1")){pass=pass+1}el{fail=fail+1};
  let rmrc=pmod.handle("privacymodelremove";@("loke";"privacy";"remove-model";"dslim/bert-base-NER"));
  let s2=mr.load(mr.modelspath());
  if(t.assert(rmrc==0 && s2.models.len==1 && str.eq(s2.models.get(0).id;"local/m2");"remove-model removes only that one")){pass=pass+1}el{fail=fail+1};
  let wrote=mt file.write(mr.modelspath();"{\"models\":[{\"id\":\"x\"}]}") { $ok:v v; $err:e false };
  let onbroken=pmod.handle("privacymodeladd";@("loke";"privacy";"add-model";"y";"--url";"http://127.0.0.1:1";"--label";"PER=PERSON"));
  let after=mt file.read(mr.modelspath()) { $ok:v v; $err:e "" };
  if(t.assert(wrote && onbroken==1 && str.eq(after;"{\"models\":[{\"id\":\"x\"}]}");"a broken file is not rewritten: add-model exits 1 and leaves it")){pass=pass+1}el{fail=fail+1};
  file.delete(mr.modelspath());

  <fail
};

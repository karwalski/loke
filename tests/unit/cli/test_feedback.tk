
m=tests.unit.cli.testfeedback;

i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=dispatchfeedback(args:@$str:i32{
  if(args.len<1){
    <0
  }el{
    let sub=args.get(0);
    if(str.eq(sub;"report")){
      <1
    }el{
      if(str.eq(sub;"version")){
        <2
      }el{
        <3
      };
    };
  };
};

f=runall():bool{
  let results=@$result@();


  let emptydispatch=dispatchfeedback(@str@());
  results.push(asserttrue("empty args gives usage";emptydispatch=0));

  let reportdispatch=dispatchfeedback(@("report"));
  results.push(asserttrue("report subcommand dispatches correctly";reportdispatch=1));

  let versiondispatch=dispatchfeedback(@("version"));
  results.push(asserttrue("version subcommand dispatches correctly";versiondispatch=2));

  let unknowndispatch=dispatchfeedback(@("delete"));
  results.push(asserttrue("unknown subcommand gives error";unknowndispatch=3));

  let upperdispatch=dispatchfeedback(@("REPORT"));
  results.push(asserttrue("uppercase REPORT is unknown";upperdispatch=3));

  let partialdispatch=dispatchfeedback(@("repo"));
  results.push(asserttrue("partial repo is unknown";partialdispatch=3));


  let reporttype="bug";
  results.push(asserteq("report type is bug";"bug";reporttype));

  let isbug=str.eq("bug";"bug");
  let isfeature=str.eq("feature";"feature");
  let isquestion=str.eq("question";"question");
  results.push(asserttrue("bug is valid type";isbug));
  results.push(asserttrue("feature is valid type";isfeature));
  results.push(asserttrue("question is valid type";isquestion));

  let invalidtype="complaint";
  let isvalid=str.eq(invalidtype;"bug") || str.eq(invalidtype;"feature") || str.eq(invalidtype;"question");
  results.push(assertfalse("complaint is not a valid type";isvalid));


  let version="0.1.0";
  results.push(asserttrue("version is non-empty";str.len(version)>0));
  results.push(asserttrue("version contains dot";str.contains(version;".")));

  let stablevalid=str.eq("stable";"stable");
  let betavalid=str.eq("beta";"beta");
  results.push(asserttrue("stable is valid channel";stablevalid));
  results.push(asserttrue("beta is valid channel";betavalid));

  let badchannel="nightly";
  let channelvalid=str.eq(badchannel;"stable") || str.eq(badchannel;"beta");
  results.push(assertfalse("nightly is not a valid channel";channelvalid));

  let multi=@("report";"version");
  let multidispatch=dispatchfeedback(multi);
  results.push(asserttrue("first subcommand (report) wins";multidispatch=1));

  let all=true;
  let i=0;
  let n=results.len;
  loop{
    if(i>=n){ break }el{
      let r=results.get(i);
      logresult(r);
      if(!$r.passed){ all=false }el{};
      i=i+1;
    };
  };
  <all
};

m=tests.unit.cli.testinit;

i=t:std.test;
i=str:std.str;
i=init:cli.init;

(* X4b.10 - `loke init`'s environment checks.

   run() itself is not called: it appends to the user's real shell profile. The checks it
   is built from are: which shell, which profile file, whether the profile needs loke's
   lines, and whether Ollama answers. The Ollama check is asserted against a closed port,
   where it used to dereference a nil response (T-15). *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.assert(str.endswith(init.profilepath("zsh");"/.zshrc");"zsh uses .zshrc")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(init.profilepath("bash");"/.bashrc");"bash uses .bashrc")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(init.profilepath("fish");"/.profile");"anything else falls back to .profile")){pass=pass+1}el{fail=fail+1};
  let sh=init.detectshell();
  if(t.assert(str.eq(sh;"zsh") || str.eq(sh;"bash") || str.eq(sh;"unknown");"detectshell answers one of its three values")){pass=pass+1}el{fail=fail+1};

  let snip=init.lokeshellsnippet();
  if(t.assert(str.contains(snip;"export LOKE_HOME=") && str.contains(snip;"$LOKE_HOME/bin:$PATH");"the snippet sets LOKE_HOME and puts its bin on PATH")){pass=pass+1}el{fail=fail+1};
  if(t.assert(init.needssnippet("export EDITOR=vim\n");"a profile without loke's lines needs them")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!init.needssnippet(str.concat("export EDITOR=vim\n";snip));"a profile that already has them does not, so init is safe to run twice")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!init.needssnippet("");"and a missing or empty profile is left alone")){pass=pass+1}el{fail=fail+1};

  if(t.assert(!init.ollamarunning("http://127.0.0.1:59995");"Ollama on a closed port is reported not running, not a crash")){pass=pass+1}el{fail=fail+1};

  <fail
}


m=tests.unit.cli.testintegrations;

i=cmd:cli.commands;
i=integ:cli.integrations;
i=ext:core.governance.external;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;v:bool):$result{
  if(v){ <fail(name;"expected false") }el{ <pass(name) };
};

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();


  let listcmd=cmd.parse(@("loke";"integrations";"list"));
  let isinteglist=mt listcmd {
    $integrations:args {
      if(args.len=1){ str.eq(args.get(0);"list") }el{ false };
    };
     false
  };
  results=str.arraypush(results;asserttrue("integrations list parses correctly";isinteglist));

  let addcmd=cmd.parse(@("loke";"integrations";"add";"slack"));
  let isintegadd=mt addcmd {
    $integrations:args {
      if(args.len=2){
        if(str.eq(args.get(0);"add")){ str.eq(args.get(1);"slack") }el{ false };
      }el{ false };
    };
     false
  };
  results=str.arraypush(results;asserttrue("integrations add slack parses correctly";isintegadd));

  let testcmd=cmd.parse(@("loke";"integrations";"test";"pagerduty"));
  let isintegtest=mt testcmd {
    $integrations:args {
      if(args.len=2){
        if(str.eq(args.get(0);"test")){ str.eq(args.get(1);"pagerduty") }el{ false };
      }el{ false };
    };
     false
  };
  results=str.arraypush(results;asserttrue("integrations test pagerduty parses correctly";isintegtest));

  let nosubcmd=cmd.parse(@("loke";"integrations"));
  let isintegempty=mt nosubcmd {
    $integrations:args args.len=0;
     false
  };
  results=str.arraypush(results;asserttrue("integrations with no subcommand parses to empty args";isintegempty));


  results=str.arraypush(results;asserttrue("pagerduty is valid preset";integ.isvalidpreset("pagerduty")));
  results=str.arraypush(results;asserttrue("datadog is valid preset";integ.isvalidpreset("datadog")));
  results=str.arraypush(results;asserttrue("grafana is valid preset";integ.isvalidpreset("grafana")));
  results=str.arraypush(results;asserttrue("splunk is valid preset";integ.isvalidpreset("splunk")));
  results=str.arraypush(results;asserttrue("elastic is valid preset";integ.isvalidpreset("elastic")));
  results=str.arraypush(results;asserttrue("slack is valid preset";integ.isvalidpreset("slack")));
  results=str.arraypush(results;asserttrue("teams is valid preset";integ.isvalidpreset("teams")));
  results=str.arraypush(results;asserttrue("opsgenie is valid preset";integ.isvalidpreset("opsgenie")));
  results=str.arraypush(results;asserttrue("servicenow is valid preset";integ.isvalidpreset("servicenow")));
  results=str.arraypush(results;asserttrue("webhook is valid preset";integ.isvalidpreset("webhook")));

  results=str.arraypush(results;assertfalse("unknown is not valid preset";integ.isvalidpreset("unknown")));
  results=str.arraypush(results;assertfalse("empty is not valid preset";integ.isvalidpreset("")));
  results=str.arraypush(results;assertfalse("PagerDuty case is not valid";integ.isvalidpreset("PagerDuty")));

  let names=integ.presetnames();
  results=str.arraypush(results;asserttrue("preset_names returns 10 presets";names.len=10));


  let pd=ext.pagerduty("PD_KEY");
  results=str.arraypush(results;asserteq("pagerduty id";pd.id;"pagerduty"));
  results=str.arraypush(results;asserteq("pagerduty name";pd.name;"PagerDuty"));
  results=str.arraypush(results;asserteq("pagerduty type";pd.integrationtype;"incident_management"));
  results=str.arraypush(results;asserttrue("pagerduty enabled";pd.enabled));
  results=str.arraypush(results;asserttrue("pagerduty has events";pd.events.len>0));

  let sl=ext.slack("https://hooks.slack.com/test");
  results=str.arraypush(results;asserteq("slack id";sl.id;"slack"));
  results=str.arraypush(results;asserteq("slack type";sl.integrationtype;"alerting"));
  results=str.arraypush(results;asserteq("slack url";sl.url;"https://hooks.slack.com/test"));
  results=str.arraypush(results;asserteq("slack auth";sl.authmethod;"none"));

  let dd=ext.datadog("DD_KEY");
  results=str.arraypush(results;asserteq("datadog id";dd.id;"datadog"));
  results=str.arraypush(results;asserteq("datadog type";dd.integrationtype;"monitoring"));
  results=str.arraypush(results;asserteq("datadog auth";dd.authmethod;"api_key_header"));
  results=str.arraypush(results;asserteq("datadog auth header";dd.authheadername;"DD-API-KEY"));

  let dc=ext.defaultconfig();
  results=str.arraypush(results;asserttrue("default config has no endpoints";dc.endpoints.len=0));
  results=str.arraypush(results;asserttrue("default config fail_open is true";dc.failopen));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

m=test.storage.backup;

i=t:std.test;
i=str:std.str;

(* --- stub backup logic mirroring core.storage.backup --- *)

(* construct backup filename with token *)
f=backupfilename(token:str):str{
  <str.concat("loke-backup-";str.concat(token;".db"))
};

(* construct full backup path *)
f=backuppath(backupdir:str;filename:str):str{
  <str.concat(backupdir;str.concat("/";filename))
};

(* construct VACUUM INTO SQL *)
f=vacuumsql(path:str):str{
  <str.concat("VACUUM INTO '";str.concat(path;"'"))
};

(* simulate createbackup: returns 1 on valid inputs, 0 on empty dir *)
f=createbackup(backupdir:str):i64{
  if(str.len(backupdir)=0){<0};
  <1
};

(* simulate listbackups: returns empty list count (stub not yet implemented) *)
f=listbackupscount():i64{ <0 };

(* construct restore target path *)
f=restoretarget(datadir:str):str{
  <str.concat(datadir;"/loke.db")
};

(* simulate restorebackup: returns 1 on valid inputs, 0 on empty *)
f=restorebackup(backuppath:str;datadir:str):i64{
  if(str.len(backuppath)=0){<0};
  if(str.len(datadir)=0){<0};
  <1
};

(* simulate pruneold: always succeeds (stub) *)
f=pruneold(keepcount:i64):i64{ <1 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test backup filename format *)
  let fname=backupfilename("abc12345");
  if(t.assert(str.contains(fname;"loke-backup-");"filename starts with loke-backup-")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(fname;".db");"filename ends with .db")){pass=pass+1}el{fail=fail+1};

  (* test backup path construction *)
  let bpath=backuppath("/backups";"loke-backup-abc.db");
  if(t.assert(str.eq(bpath;"/backups/loke-backup-abc.db");"full backup path constructed correctly")){pass=pass+1}el{fail=fail+1};

  (* test VACUUM INTO SQL format *)
  let vsql=vacuumsql("/backups/loke-backup-abc.db");
  if(t.assert(str.contains(vsql;"VACUUM INTO");"VACUUM SQL includes VACUUM INTO")){pass=pass+1}el{fail=fail+1};

  (* test createbackup succeeds with valid dir *)
  if(t.assert(createbackup("/backups")=1;"createbackup succeeds with valid dir")){pass=pass+1}el{fail=fail+1};

  (* test createbackup fails with empty dir *)
  if(t.assert(createbackup("")=0;"createbackup fails with empty dir")){pass=pass+1}el{fail=fail+1};

  (* test listbackups returns 0 (not yet implemented) *)
  if(t.assert(listbackupscount()=0;"listbackups returns empty list")){pass=pass+1}el{fail=fail+1};

  (* test restore target path construction *)
  if(t.assert(str.eq(restoretarget("/data");"/data/loke.db");"restore target is /data/loke.db")){pass=pass+1}el{fail=fail+1};

  (* test restorebackup succeeds with valid inputs *)
  if(t.assert(restorebackup("/backups/loke-backup-abc.db";"/data")=1;"restorebackup succeeds")){pass=pass+1}el{fail=fail+1};

  (* test restorebackup fails with empty backup path *)
  if(t.assert(restorebackup("");"/data")=0;"restorebackup fails with empty path")){pass=pass+1}el{fail=fail+1};

  (* test pruneold always succeeds (stub) *)
  if(t.assert(pruneold(5)=1;"pruneold succeeds")){pass=pass+1}el{fail=fail+1};

  <fail
};

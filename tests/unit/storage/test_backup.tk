m=test.storage.backup;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=bk:core.storage.backup;

(* This file declared its own backupfilename, backuppath, vacuumsql, createbackup,
   listbackupscount, restoretarget, restorebackup and pruneold — eight stand-ins for a
   module with four functions, none of which had matching signatures. It also had a
   syntax error on the restorebackup line, which nobody saw because it had never
   compiled: `restorebackup("");"/data")==0` closes the call before the second
   argument.

   It tests the real module now. createbackup needs an open store and listbackups is
   documented as not yet implemented, so what is covered here is restorebackup's
   behaviour on a real file and its failure on a missing one — including the property
   that matters, which is that a failed restore does not leave a truncated database
   in place of the live one. *)

f=tmpdir():str{
  <"\(std.homedir())/.loke/test-backup"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* listbackups is a documented stub. Asserting that keeps a future implementation
     from silently changing the contract, and keeps the stub visible. *)
  mt bk.listbackups(tmpdir()) {
    $ok:rows if(t.assert(rows.len==0;"listbackups is still a stub returning an empty list")){pass=pass+1}el{fail=fail+1};
    $err:e if(t.assert(false;"listbackups should not error")){pass=pass+1}el{fail=fail+1}
  };

  mt bk.pruneold(tmpdir();3 as u32) {
    $ok:v if(t.assert(v==0;"pruneold is still a stub that keeps everything")){pass=pass+1}el{fail=fail+1};
    $err:e if(t.assert(false;"pruneold should not error")){pass=pass+1}el{fail=fail+1}
  };

  (* A restore from a path that does not exist must fail, not half-succeed. If this
     ever returns $ok the live database has been overwritten with nothing. *)
  (* Read through a plain bool, not a result arm: toke matches the first arm of an
     X!$lokeerr whatever the value is (T-18), so a refusal returned that way would be
     invisible here — which is exactly how this assertion failed while the guard in
     the module was working. *)
  let missing=bk.restorebackup("\(tmpdir())/does-not-exist.db";tmpdir());
  if(t.assert(!missing.ok;"restoring a missing backup is refused, not reported as success")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(missing.message;"refusing");"and it says why")){pass=pass+1}el{fail=fail+1};

  <fail
};

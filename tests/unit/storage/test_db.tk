m=test.storage.db;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=sdb:core.storage.db;
i=mig:core.storage.migrations;

(* X7.2 — this file used to declare ten stand-ins for core.storage.db and assert against
   them. Two of the ten are the reason it had to be rewritten rather than extended:

     f=applyencryptionkey(hexkey:str):i64{ if(str.len(hexkey)==64){<1}; <0 };
     f=pragmakey(hexkey:str):str{ <str.concat("PRAGMA key='x''";...) };

   `applyencryptionkey` and its `PRAGMA key` were DELETED from the module under X8.1,
   because the toolchain links plain SQLite, which accepts that pragma, ignores it, and
   reports success — a control that encrypted nothing while reporting that it had. The
   stub test went on asserting that a 64-character key is "accepted" and that the SQL
   "contains PRAGMA key", and stayed green for the whole life of both the defect and its
   removal. It was asserting the presence of a control the product had deliberately given
   up, which is the exact failure mode the encryption claim was retracted to stop.

   What it covers now is the module: the retraction itself (dbencryptionavailable), the
   currency formatting that exists because two obvious spellings round money wrongly,
   and the GA5.11 reporting window, whose bug was that every report matched zero rows on
   every installation. *)

f=testdir():str{
  (* str.concat, not interpolation: a string returned by std.homedir() is truncated when
     interpolated (T-21). Its own directory so no other test's rows are in scope. *)
  <str.concat(std.homedir();"/.loke/test-db-unit")
};

(* The window and schema predicates go through std.db's connection, so a store has to be
   open before any of them can answer. Without one db.many errors, countquery maps that
   to 0, and every assertion below would be testing the no-connection path instead. *)
f=openstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  <mt sdb.openstore(dir) {
    $ok:s s;
    $err:e 0
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  openstore();

  (* ── X8.1: the encryption claim, retracted and readable ─────────────────────
     Asserted in both directions. If somebody reinstates a PRAGMA key and flips this
     predicate without linking SQLCipher, this is what says no. *)
  if(t.assert(!sdb.dbencryptionavailable();"database-level encryption is NOT available: the toolchain links plain SQLite")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(sdb.dbencryptionstatus();"NOT encrypted at rest");"and the status string says so rather than implying encryption")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(sdb.dbencryptionstatus();"X8.2");"and names the story that will encrypt the mapping table")){pass=pass+1}el{fail=fail+1};

  (* ── No key from the environment ───────────────────────────────────────────
     This section used to assert that dbkeyfromenv read a 64-character LOKE_DB_KEY. The
     function is deleted (X8.3, 2026-09-27): a storage-module function returning a key from
     the environment is the fallback X8.3 forbids, whether or not anything calls it yet.
     The keychain-side decision is asserted in tests/unit/privacy/test_mapping_encryption.tk
     through dbkeyaction. *)

  (* ── Money, formatted from exact hundredths ─────────────────────────────────
     str.fromfloat(1.50) gives "1.5" and str.fromfloat(0.0) gives "0". A cost column
     printed either way reads $1.5 and $0 — figures somebody reconciles against an
     invoice. The two padding cases are the ones both obvious spellings get wrong. *)
  if(t.asserteq(sdb.moneyfromhundredths(150);"1.50";"150 hundredths formats as 1.50, not 1.5")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sdb.moneyfromhundredths(0);"0.00";"zero formats as 0.00, not 0")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sdb.moneyfromhundredths(5);"0.05";"five hundredths keeps its leading zero")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sdb.moneyfromhundredths(100000);"1000.00";"a thousand dollars carries its cents")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sdb.moneyfromhundredths(0-150);"-1.50";"a negative amount keeps one sign, in front")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sdb.pad2(5);"05";"pad2 pads a single digit")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sdb.pad2(10);"10";"and leaves two alone")){pass=pass+1}el{fail=fail+1};

  (* ── boolval: what goes into a bound parameter ──────────────────────────────*)
  if(t.asserteq(sdb.boolval(true);"1";"true binds as 1")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sdb.boolval(false);"0";"false binds as 0")){pass=pass+1}el{fail=fail+1};

  (* ── GA5.11: the reporting window ───────────────────────────────────────────
     A plain struct with an `ok` predicate rather than a result type, because T-18
     makes the error arm of a user-declared sum dead and a rejected window read as
     success is the very defect GA5.11 removed. Both directions are asserted here for
     that reason. *)
  let oneday=sdb.msrangeof("2026-01-01";"2026-01-01");
  if(t.assert(oneday.ok;"a single date is a readable window")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oneday.endms-oneday.startms==86400000;"--start X --end X is a full UTC day, half-open, not an empty instant")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oneday.startms>0;"and the bound is epoch milliseconds, not a date string")){pass=pass+1}el{fail=fail+1};

  let twodays=sdb.msrangeof("2026-01-01";"2026-01-02");
  if(t.assert(twodays.endms-twodays.startms==172800000;"two dates span two whole days")){pass=pass+1}el{fail=fail+1};
  if(t.assert(twodays.startms==oneday.startms;"and the start of the window does not move")){pass=pass+1}el{fail=fail+1};

  (* strftime returns NULL for anything it cannot read, which arrives as 0. A bound of
     0 would quietly match nothing, so it must be refused rather than carried. *)
  let garbage=sdb.msrangeof("not-a-date";"2026-01-01");
  if(t.assert(!garbage.ok;"an unreadable start date is refused, not silently treated as the epoch")){pass=pass+1}el{fail=fail+1};
  let garbageend=sdb.msrangeof("2026-01-01";"the day after tomorrow");
  if(t.assert(!garbageend.ok;"and so is an unreadable end date")){pass=pass+1}el{fail=fail+1};
  let reversed=sdb.msrangeof("2026-02-01";"2026-01-01");
  if(t.assert(!reversed.ok;"a window whose end precedes its start is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sdb.badrange().ok;"badrange is not ok, which is the whole point of it")){pass=pass+1}el{fail=fail+1};

  (* The clause both bounds are bound into. The CAST is load-bearing: without it SQLite
     applies the column's TEXT affinity to the integer parameter and converts the
     PARAMETER to text, which puts the string comparison — and the bug — back. *)
  if(t.assert(str.contains(sdb.createdatwindowclause();"CAST(created_at AS INTEGER)");"the window clause casts the column, not the parameter")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(sdb.createdatdescorder();"CAST(created_at AS INTEGER) DESC");"and the ordering casts it too, so rows do not sort lexically")){pass=pass+1}el{fail=fail+1};

  let week=sdb.daysagoms(7);
  if(t.assert(week>0;"the scorecard window resolves to a real epoch millisecond value")){pass=pass+1}el{fail=fail+1};
  if(t.assert(week<sdb.nowms();"and seven days ago is before now")){pass=pass+1}el{fail=fail+1};

  (* ── Schema introspection ───────────────────────────────────────────────────
     A query against a missing table errors, and most of this codebase maps that to an
     empty array — which is how a report spent its life showing zero events from a
     table no migration creates. The predicate has to distinguish the two. *)
  if(t.assert(sdb.tableexists("schema_migrations");"the migrations table exists after openstore ran them")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sdb.tableexists("no_such_table_xyz");"and a table that does not exist is reported absent, not empty")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sdb.triggerexists("no_such_trigger_xyz");"the same for triggers")){pass=pass+1}el{fail=fail+1};

  (* ── A failed migration is not recorded as applied ────────────────────────────
     Each exec in the runner used to be a statement whose error was discarded, so a
     migration with bad SQL was inserted into schema_migrations and never retried, and
     every later migration ran on a schema missing its predecessor. Versions 9001-9003
     are far above the real ones and exist only in this test. *)
  let bad=@(
    $migration{version:9001 as u32;description:"test: a migration whose SQL is invalid";sql:"CREATE TABLE ("};
    $migration{version:9002 as u32;description:"test: valid, but after the failure";sql:"CREATE TABLE IF NOT EXISTS test_mig_after (x INTEGER)"}
  );
  if(t.asserteq(str.fromint(sdb.applymigrations(bad));"9001";"the runner answers the version that failed")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(str.fromint(sdb.countquery("SELECT version FROM schema_migrations WHERE version=9001";@()));"0";"and the failed migration is NOT recorded as applied")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sdb.tableexists("test_mig_after");"and nothing after the failure was attempted")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(str.fromint(sdb.pendingmigrations(bad));"2";"so both remain pending, which openstore logs")){pass=pass+1}el{fail=fail+1};
  let good=@($migration{version:9003 as u32;description:"test: a valid migration";sql:"CREATE TABLE IF NOT EXISTS test_mig_good (x INTEGER)"});
  if(t.asserteq(str.fromint(sdb.applymigrations(good));"0";"a valid migration applies, and 0 means none failed")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(str.fromint(sdb.pendingmigrations(good));"0";"and it is recorded")){pass=pass+1}el{fail=fail+1};

  <fail
};

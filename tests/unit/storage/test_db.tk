m=test.storage.db;

i=t:std.test;
i=str:std.str;

(* --- stub database logic mirroring core.storage.db --- *)

(* simulate opening a store: returns 1 on valid path, 0 on empty *)
f=openstore(datadir:str):i64{
  if(str.len(datadir)=0){<0};
  <1
};

(* simulate database path construction *)
f=dbpath(datadir:str):str{
  <str.concat(datadir;"/loke.db")
};

(* simulate ensuredbkey: returns hex key length (64 chars for 32 bytes) *)
f=ensuredbkeylength():i64{ <64 };

(* simulate applyencryptionkey: returns 1 on valid hex key, 0 otherwise *)
f=applyencryptionkey(hexkey:str):i64{
  if(str.len(hexkey)=64){<1};
  <0
};

(* simulate PRAGMA key SQL construction *)
f=pragmakey(hexkey:str):str{
  <str.concat("PRAGMA key='x''";str.concat(hexkey;"''"))
};

(* simulate migration table creation SQL check *)
f=migrationtablesql():str{
  <"CREATE TABLE IF NOT EXISTS schema_migrations (version INTEGER PRIMARY KEY, applied_at TEXT NOT NULL, description TEXT NOT NULL)"
};

(* simulate exec: returns 1 on non-empty SQL, 0 otherwise *)
f=exec(sql:str):i64{
  if(str.len(sql)=0){<0};
  <1
};

(* simulate execparams: validates SQL and params *)
f=execparams(sql:str;paramcount:i64):i64{
  if(str.len(sql)=0){<0};
  if(paramcount=0){<0};
  <1
};

(* simulate boolval *)
f=boolval(b:i64):str{
  if(b=1){<"1"};
  <"0"
};

(* simulate closestore: always succeeds *)
f=closestore():i64{ <1 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test openstore succeeds with valid path *)
  if(t.assert(openstore("/tmp/loke")=1;"openstore succeeds with valid path")){pass=pass+1}el{fail=fail+1};

  (* test openstore fails with empty path *)
  if(t.assert(openstore("")=0;"openstore fails with empty path")){pass=pass+1}el{fail=fail+1};

  (* test database path construction *)
  if(t.assert(str.eq(dbpath("/data");"/data/loke.db");"dbpath appends /loke.db")){pass=pass+1}el{fail=fail+1};

  (* test encryption key length is 64 hex chars for 32 bytes *)
  if(t.assert(ensuredbkeylength()=64;"encryption key is 64 hex chars")){pass=pass+1}el{fail=fail+1};

  (* test applyencryptionkey succeeds with correct key length *)
  if(t.assert(applyencryptionkey("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")=1;"64-char hex key accepted")){pass=pass+1}el{fail=fail+1};

  (* test applyencryptionkey rejects wrong key length *)
  if(t.assert(applyencryptionkey("tooshort")=0;"short hex key rejected")){pass=pass+1}el{fail=fail+1};

  (* test PRAGMA key SQL format *)
  let pragma=pragmakey("abc123");
  if(t.assert(str.contains(pragma;"PRAGMA key");"pragma SQL contains PRAGMA key")){pass=pass+1}el{fail=fail+1};

  (* test migration table SQL includes schema_migrations *)
  if(t.assert(str.contains(migrationtablesql();"schema_migrations");"migration SQL references schema_migrations table")){pass=pass+1}el{fail=fail+1};

  (* test exec succeeds with valid SQL *)
  if(t.assert(exec("SELECT 1")=1;"exec succeeds with valid SQL")){pass=pass+1}el{fail=fail+1};

  (* test exec fails with empty SQL *)
  if(t.assert(exec("")=0;"exec fails with empty SQL")){pass=pass+1}el{fail=fail+1};

  (* test execparams with valid SQL and params *)
  if(t.assert(execparams("INSERT INTO kv VALUES (?,?)";2)=1;"execparams succeeds with SQL and params")){pass=pass+1}el{fail=fail+1};

  (* test execparams fails with zero params *)
  if(t.assert(execparams("INSERT INTO kv VALUES (?)";0)=0;"execparams fails with zero params")){pass=pass+1}el{fail=fail+1};

  (* test boolval conversion *)
  if(t.assert(str.eq(boolval(1);"1");"boolval true is 1")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(boolval(0);"0");"boolval false is 0")){pass=pass+1}el{fail=fail+1};

  <fail
};

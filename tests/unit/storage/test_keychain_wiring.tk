
m=tests.unit.storage.testkeychainwiring;

i=kc:loke.core.config.keychain;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };
f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let service = "dev.tokelang.loke.test_e3a";
  let account = "api_key";
  let secret = "sk-test-e3-round-trip";
  kc.store(service;account;secret);
  let rroundtrip = mt kc.retrieve(service;account) {
    $some:v asserteq("store/retrieve round-trip";v;secret);
    $none:fail("store/retrieve round-trip";"expected value but got none")
  };
  let results = str.arraypush(results;rroundtrip);

  let rmissing = kc.retrieve("dev.tokelang.loke.__nonexistent__";mt "no_such_account") {
    $some:v fail("retrieve missing key returns none";"expected none but got value");
    $none:pass("retrieve missing key returns none")
  };
  let results = str.arraypush(results;rmissing);

  let delservice = "dev.tokelang.loke.test_e3c";
  let delaccount = "api_key";
  kc.store(delservice;delaccount;"sk-delete-me-e3");
  let before = mt kc.retrieve(delservice;delaccount) {
    $some:v true;
    $none:false
  };
  let rbefore = asserttrue("key exists before delete";before);
  let results = str.arraypush(results;rbefore);

  kc.delete(delservice;delaccount);
  let rafter = mt kc.retrieve(delservice;delaccount) {
    $some:v fail("delete removes entry";str.concat("expected none after delete, got: ";v));
    $none:pass("delete removes entry")
  };
  let results = str.arraypush(results;rafter);

  kc.storeapikey("test_e3d_provider";"sk-convenience-test");
  let rapi = mt kc.getapikey("test_e3d_provider") {
    $some:v asserteq("store_api_key/get_api_key round-trip";v;"sk-convenience-test");
    $none:fail("store_api_key/get_api_key round-trip";"expected value but got none")
  };
  let results = str.arraypush(results;rapi);

  let svc = kc.apikeyservice("anthropic");
  let rsvc = asserteq("api_key_service format";"dev.tokelang.loke.anthropic";svc);
  let results = str.arraypush(results;rsvc);

  kc.store(service;account;"sk-updated-value");
  let roverwrite = mt kc.retrieve(service;account) {
    $some:v asserteq("overwrite updates value";v;"sk-updated-value");
    $none:fail("overwrite updates value";"expected updated value but got none")
  };
  let results = str.arraypush(results;roverwrite);

  kc.delete(service;account);
  kc.delete(delservice;delaccount);
  kc.delete(kc.apikeyservice("test_e3d_provider");"api_key");

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

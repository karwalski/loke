m=tests.unit.storage.teststorefreshdir;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=db:std.db;
i=sdb:core.storage.db;

(* A store opened in a data directory that does not exist yet is created and migrated.

   Measured 2026-09-26 on the running server with a fresh HOME: ~/.loke did not exist when
   the first request opened the store, sqlite3_open returned SQLITE_CANTOPEN, the $ok arm was
   taken anyway, and all thirty migrations failed on a NULL handle. So no audit row, decision
   trace, budget or metrics row was stored. Every other storage test creates its directory
   first, which is why none of them saw it. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let parent=str.concat(std.homedir();"/.loke/test-store-fresh");
  file.mkdir(parent);
  let dir=str.concat(parent;str.concat("/d";str.randhex(6)));
  if(t.assert(!file.exists(str.concat(dir;"/loke.db"));"the data directory starts absent")){pass=pass+1}el{fail=fail+1};

  let store=mt sdb.openstore(dir) {
    $ok:s s;
    $err:e 0
  };
  if(t.assert(store!=0;"the store opens")){pass=pass+1}el{fail=fail+1};
  if(t.assert(file.exists(str.concat(dir;"/loke.db"));"and creates its database file")){pass=pass+1}el{fail=fail+1};
  let n=sdb.scalari64("SELECT COUNT() AS n FROM schema_migrations WHERE description<>?";@("");"n";0-1);
  if(t.assert(n>=31;"and every migration is applied")){pass=pass+1}el{fail=fail+1};
  let ok=mt db.exec("INSERT INTO disclosure_log (record_id,correlation_id,request_id,session_id,occurred_at,state,dispatch_kind,pipeline_disabled,provider,provider_class,model_id,model_version,endpoint_host,retention_class,bytes_body,bytes_schema_profile,bytes_question,bytes_other,custody,custody_check,datasets_disclosed,fields_disclosed,fields_disclosed_count,field_types_disclosed,cardinality_disclosed,row_count_disclosed,entity_types,entities_total,detection_layers,real_values_included,sample_values_included,aggregates_included,qi_combination_fields) VALUES ('r','c','q','s','t','dispatched','initial',0,'p','local','m','m','h','unknown',1,0,0,1,'raw','not_run','','',0,'',0,0,'',0,'',1,0,0,'')";@()) {
    $ok:v true;
    $err:e false
  };
  if(t.assert(ok;"so a write succeeds")){pass=pass+1}el{fail=fail+1};

  file.delete(str.concat(dir;"/loke.db"));
  file.delete(str.concat(dir;"/loke.db-wal"));
  file.delete(str.concat(dir;"/loke.db-shm"));
  <fail
}

m=test.storage.ephemeral;

i=t:std.test;
i=str:std.str;
i=eph:core.storage.ephemeral;

(* This file declared a $ephemeralstore with entries, TTLs and a created timestamp,
   plus newstore, put, get, count, wipeid and wipeall — a design that was never
   implemented. The real module is a $ephemeralmap backed by std.securemem, with no
   count and no per-entry TTL. The copy and the module had nothing in common but the
   word "ephemeral", and the test passed on the copy.

   What it covers now is the round trip, which is the property the privacy pipeline
   depends on: a placeholder stored here must come back, or response restoration
   silently returns nothing. That path was broken until recently — `put` called
   json.set and discarded its result, so the map stored nothing at all — and this is
   the test that would have caught it. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(eph.isavailable()){}el{
    (* securemem is not available in this environment; the assertions below would be
       testing the failure path rather than the feature. Say so rather than pass. *)
    if(t.assert(false;"std.securemem is unavailable, so the ephemeral map cannot be tested here")){pass=pass+1}el{fail=fail+1};
    <fail
  };

  let m=eph.newmap("test-session";60 as i32);

  (* A fresh map holds nothing. *)
  if(t.asserteq(eph.get(m;"[EMAIL_1]");"";"a fresh map returns empty for an unknown placeholder")){pass=pass+1}el{fail=fail+1};

  (* The round trip. put returns a NEW map — toke structs are values — so a caller
     that drops the return stores nothing, which is exactly the bug this covers. *)
  let m2=eph.put(m;"[EMAIL_1]";"alice@example.com");
  if(t.asserteq(eph.get(m2;"[EMAIL_1]");"alice@example.com";"a stored placeholder round-trips")){pass=pass+1}el{fail=fail+1};

  let m3=eph.put(m2;"[PHONE_1]";"0412 345 678");
  if(t.asserteq(eph.get(m3;"[PHONE_1]");"0412 345 678";"a second placeholder round-trips")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(eph.get(m3;"[EMAIL_1]");"alice@example.com";"the first placeholder survives the second put")){pass=pass+1}el{fail=fail+1};

  (* An unknown placeholder must not return a neighbouring value. *)
  if(t.asserteq(eph.get(m3;"[EMAIL_2]");"";"an unknown placeholder returns empty, not another entry")){pass=pass+1}el{fail=fail+1};

  (* Wiping is the point of a secure map: after it, nothing comes back. *)
  if(t.assert(eph.wipe(m3);"wipe reports success")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(eph.get(m3;"[EMAIL_1]");"";"nothing comes back after a wipe")){pass=pass+1}el{fail=fail+1};

  <fail
};

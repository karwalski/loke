m=tests.unit.storage.testephemeral;
i=t:std.test;
i=str:std.str;

t=$ephemeralentry{ key:str; value:str; ttl:i32; created:i64 };

t=$ephemeralstore{
  entries:@$ephemeralentry;
  sessionid:str
};

f=newstore(sessionid:str):$ephemeralstore{
  <$ephemeralstore{ entries:@(); sessionid:sessionid }
};

f=put(store:$ephemeralstore;key:str;value:str;ttl:i32;now:i64):$ephemeralstore{
  let entry=$ephemeralentry{ key:key; value:value; ttl:ttl; created:now };
  <$ephemeralstore{ entries:store.entries.append(entry); sessionid:store.sessionid }
};

f=get(store:$ephemeralstore;key:str;now:i64):str{
  lp(let i=0;i<store.entries.len;i=i+1){
    let e=store.entries.get(i);
    if(str.eq(e.key;key)){
      let expiry=e.created + (e.ttl as i64);
      if(now < expiry){
        <e.value
      }el{
        <""
      }
    }el{}
  };
  <""
};

f=count(store:$ephemeralstore):i32{
  <store.entries.len as i32
};

f=wipeid(store:$ephemeralstore;key:str):$ephemeralstore{
  let next=mut.@($ephemeralentry);
  lp(let i=0;i<store.entries.len;i=i+1){
    let e=store.entries.get(i);
    if(!str.eq(e.key;key)){
      next=next.append(e)
    }el{}
  };
  <$ephemeralstore{ entries:next; sessionid:store.sessionid }
};

f=wipeall(store:$ephemeralstore):$ephemeralstore{
  <$ephemeralstore{ entries:@(); sessionid:store.sessionid }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=newstore("sess-001");

  t.assert(str.eq(store.sessionid;"sess-001");"new store has correct session id");
  pass=pass+1;

  t.assert(count(store)=(0 as i32);"new store is empty");
  pass=pass+1;

  let store=put(store;"KEY_1";"secret_value";60;1000);
  t.assert(count(store)=(1 as i32);"count after one put is 1");
  pass=pass+1;

  let val=get(store;"KEY_1";1010);
  t.asserteq(val;"secret_value";"get before expiry returns value");
  pass=pass+1;

  let val2=get(store;"KEY_1";1070);
  t.asserteq(val2;"";"get after expiry returns empty");
  pass=pass+1;

  let val3=get(store;"NONEXIST";1010);
  t.asserteq(val3;"";"get nonexistent key returns empty");
  pass=pass+1;

  let store=put(store;"KEY_2";"another_val";120;1000);
  t.assert(count(store)=(2 as i32);"count after two puts is 2");
  pass=pass+1;

  let store=wipeid(store;"KEY_1");
  t.assert(count(store)=(1 as i32);"wipe by id reduces count");
  pass=pass+1;

  let val4=get(store;"KEY_1";1010);
  t.asserteq(val4;"";"wiped key returns empty");
  pass=pass+1;

  let val5=get(store;"KEY_2";1010);
  t.asserteq(val5;"another_val";"non-wiped key still returns value");
  pass=pass+1;

  let store=put(store;"KEY_3";"third";30;1000);
  t.assert(count(store)=(2 as i32);"count before wipe all");
  pass=pass+1;

  let store=wipeall(store);
  t.assert(count(store)=(0 as i32);"wipe all clears everything");
  pass=pass+1;

  let val6=get(store;"KEY_2";1010);
  t.asserteq(val6;"";"after wipe all no keys remain");
  pass=pass+1;

  <fail
};

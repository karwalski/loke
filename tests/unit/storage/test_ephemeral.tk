



m=tests.unit.storage.testephemeral;

i=eph:core.storage.ephemeral;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };
f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }else{ <fail(n;"expected true") };
};
f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }else{ <fail(n;"expected false") };
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};
f=runall():bool{
  let results = @$result@();

  
  let m1 = eph.newmap("session-test-001";3600);
  let m1 = eph.put(m1;"__placeholder_abc__";"original_value_abc");
  let rretrieve = mt eph.get(m1;"__placeholder_abc__") {
    $some:v asserteq("store then retrieve returns value";v;"original_value_abc");
    $none fail("store then retrieve returns value";"get returned none before TTL expiry")
  };
  let results = str.arraypush(results;rretrieve);

  
  let m2 = eph.newmap("session-test-002";3600);
  let m2 = eph.put(m2;"__placeholder_xyz__";"secret_value");
  let wiped = eph.wipe(m2);
  let rwipeok = asserttrue("wipe returns true";wiped);
  let results = str.arraypush(results;rwipeok);

  
  let rafterwipe = mt eph.get(m2;"__placeholder_xyz__") {
    $some:v fail("after wipe retrieve returns none";"expected none but got a value");
    $none pass("after wipe retrieve returns none")
  };
  let results = str.arraypush(results;rafterwipe);

  
  let m3 = eph.newmap("session-test-003";3600);
  let m3 = eph.put(m3;"__placeholder_p1__";"val1");
  let m3 = eph.put(m3;"__placeholder_p2__";"val2");
  
  eph.wipe(m3);
  let swept = eph.sweep();
  let rsweep = asserttrue("sweep runs without error";swept >= 0);
  let results = str.arraypush(results;rsweep);

  
  let m4 = eph.newmap("session-test-004";3600);
  let runknown = mt eph.get(m4;"__no_such_placeholder__") {
    $some:v fail("unknown placeholder returns none";"expected none but got a value");
    $none pass("unknown placeholder returns none")
  };
  let results = str.arraypush(results;runknown);

  
  let m5 = eph.newmap("session-test-005";3600);
  let m5 = eph.put(m5;"__ph_a__";"alpha");
  let m5 = eph.put(m5;"__ph_b__";"beta");
  let rmultia = mt eph.get(m5;"__ph_a__") {
    $some:v asserteq("multi-entry: first survives";v;"alpha");
    $none fail("multi-entry: first survives";"expected alpha but got none")
  };
  let rmultib = mt eph.get(m5;"__ph_b__") {
    $some:v asserteq("multi-entry: second survives";v;"beta");
    $none fail("multi-entry: second survives";"expected beta but got none")
  };
  let results = str.arraypush(results;rmultia);
  let results = str.arraypush(results;rmultib);

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }else{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }else{};
      i = i+1
    };
  };
  <all
};

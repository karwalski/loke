



m=tests.unit.storage.testsettings;

i=db:core.storage.db;
i=set:core.storage.settings;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };
f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};
f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};
f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") }
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};
f=runall():bool{
  let results = @($result);
  let store=mt db.open(":memory:") {
    Ok:s s;
    Err:e log.error("failed to open test db")
  };

  
  set.setstr(store;"loke.test.str_key";"hello";"test");
  let rstr = mt set.getstr(store;"loke.test.str_key") {
    Ok:v asserteq("set_str/get_str round-trip";v;"hello");
    Err:e fail("set_str/get_str round-trip";"get_str returned error")
  };
  let results = str.arraypush(results;rstr);

  
  set.setbool(store;"loke.test.bool_true";"true";"test");
  let rbooltrue = mt set.getbool(store;"loke.test.bool_true") {
    Ok:v asserttrue("set_bool/get_bool true round-trip";v);
    Err:e fail("set_bool/get_bool true round-trip";"get_bool returned error")
  };
  let results = str.arraypush(results;rbooltrue);

  
  set.setbool(store;"loke.test.bool_false";false;"test");
  let rboolfalse = mt set.getbool(store;"loke.test.bool_false") {
    Ok:v assertfalse("set_bool/get_bool false round-trip";v);
    Err:e fail("set_bool/get_bool false round-trip";"get_bool returned error")
  };
  let results = str.arraypush(results;rboolfalse);

  
  set.setint(store;"loke.test.int_key";42;"test");
  let rint = mt set.getint(store;"loke.test.int_key") {
    Ok:v asserteq("set_int/get_int round-trip";str.fromint(v);"42");
    Err:e fail("set_int/get_int round-trip";"get_int returned error")
  };
  let results = str.arraypush(results;rint);

  
  let rmissing = mt set.getstr(store;"loke.test.no_such_key") {
    Ok:v fail("get_str missing key";"expected error but got ok");
    Err:e pass("get_str missing key returns error")
  };
  let results = str.arraypush(results;rmissing);

  
  set.setstr(store;"loke.test.str_not_bool";"hello";"test");
  let rtypemismatch = mt set.getbool(store;"loke.test.str_not_bool") {
    Ok:v fail("get_bool on str key";"expected type mismatch error but got ok");
    Err:e pass("get_bool on non-bool key returns error")
  };
  let results = str.arraypush(results;rtypemismatch);

  
  set.setstr(store;"loke.test.overwrite";"first";"test");
  set.setstr(store;"loke.test.overwrite";"second";"test");
  let roverwrite = mt set.getstr(store;"loke.test.overwrite") {
    Ok:v asserteq("overwrite key returns new value";v;"second");
    Err:e fail("overwrite key returns new value";"get_str returned error after overwrite")
  };
  let results = str.arraypush(results;roverwrite);

  
  set.setstr(store;"loke.ns.alpha";"a";"ns_test");
  set.setstr(store;"loke.ns.beta";"b";"ns_test");
  set.setstr(store;"loke.other.key";"x";"other_ns");
  let nskeys = mt set.listns(store;"ns_test") {
    Ok:keys keys;
    Err:e <fail("namespace parameter preserved";"list_ns returned error")
  };
  let n = str.arraylen(nskeys);
  let rns = asserteq("namespace keys count";str.fromint(n);"2");
  let results = str.arraypush(results;rns);

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ br }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all = false }el{};
      i = i+1
    }
  };
  <all
};

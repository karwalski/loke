m=tests.unit.storage.testsettings;
i=t:std.test;
i=str:std.str;

t=$settingtype{kind:str};

t=$setting{ key:str; value:str; vtype:$settingtype; namespace:str };

t=$settingstore{
  entries:@$setting
};

f=newstore():$settingstore{
  <$settingstore{ entries:@() }
};

f=setstr(store:$settingstore;key:str;value:str;ns:str):$settingstore{
  let entry=$setting{ key:key; value:value; vtype:"str"; namespace:ns };
  let next=mut.removekey(store;key);
  <$settingstore{ entries:next.entries.push(entry) }
};

f=setint(store:$settingstore;key:str;value:i64;ns:str):$settingstore{
  let entry=$setting{ key:key; value:str.fromint(value); vtype:"int"; namespace:ns };
  let next=mut.removekey(store;key);
  <$settingstore{ entries:next.entries.push(entry) }
};

f=setbool(store:$settingstore;key:str;value:bool;ns:str):$settingstore{
  let v=mut."false";
  if(value){v="true"}el{};
  let entry=$setting{ key:key; value:v; vtype:"bool"; namespace:ns };
  let next=mut.removekey(store;key);
  <$settingstore{ entries:next.entries.push(entry) }
};

f=removekey(store:$settingstore;key:str):$settingstore{
  let next=mut.@($setting);
  lp(let i=0;i<store.entries.len;i=i+1){
    let e=store.entries.get(i);
    if(!str.eq(e.key;key)){
      next=next.push(e)
    }el{}
  };
  <$settingstore{ entries:next }
};

f=getstr(store:$settingstore;key:str;default:str):str{
  lp(let i=0;i<store.entries.len;i=i+1){
    let e=store.entries.get(i);
    if(str.eq(e.key;key)){
      <e.value
    }el{}
  };
  <default
};

f=getint(store:$settingstore;key:str;default:i64):i64{
  lp(let i=0;i<store.entries.len;i=i+1){
    let e=store.entries.get(i);
    if(str.eq(e.key;key)){
      <str.toint(e.value)
    }el{}
  };
  <default
};

f=getbool(store:$settingstore;key:str;default:bool):bool{
  lp(let i=0;i<store.entries.len;i=i+1){
    let e=store.entries.get(i);
    if(str.eq(e.key;key)){
      <str.eq(e.value;"true")
    }el{}
  };
  <default
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=newstore();

  let store=setstr(store;"app.name";"loke";"general");
  let v1=getstr(store;"app.name";"");
  t.asserteq(v1;"loke";"set and get string value");
  pass=pass+1;

  let store=setstr(store;"app.version";"3.0.1";"general");
  let v2=getstr(store;"app.version";"");
  t.asserteq(v2;"3.0.1";"set and get second string");
  pass=pass+1;

  let store=setint(store;"max.tokens";4096;"limits");
  let v3=getint(store;"max.tokens";0);
  t.assert(v3=4096;"set and get int value");
  pass=pass+1;

  let store=setint(store;"timeout.ms";30000;"limits");
  let v4=getint(store;"timeout.ms";0);
  t.assert(v4=30000;"set and get second int");
  pass=pass+1;

  let store=setbool(store;"privacy.enabled";true;"privacy");
  let v5=getbool(store;"privacy.enabled";false);
  t.assert(v5=true;"set and get bool true");
  pass=pass+1;

  let store=setbool(store;"debug.mode";false;"dev");
  let v6=getbool(store;"debug.mode";true);
  t.assert(v6=false;"set and get bool false");
  pass=pass+1;

  let v7=getstr(store;"nonexistent.key";"fallback");
  t.asserteq(v7;"fallback";"default value when string key missing");
  pass=pass+1;

  let v8=getint(store;"nonexistent.int";-1);
  t.assert(v8=-1;"default value when int key missing");
  pass=pass+1;

  let v9=getbool(store;"nonexistent.bool";true);
  t.assert(v9=true;"default value when bool key missing");
  pass=pass+1;

  let store=setstr(store;"app.name";"loke-updated";"general");
  let v10=getstr(store;"app.name";"");
  t.asserteq(v10;"loke-updated";"overwrite existing key");
  pass=pass+1;

  let v11=getstr(store;"app.version";"");
  t.asserteq(v11;"3.0.1";"other keys unaffected by overwrite");
  pass=pass+1;

  <fail
};

m=test.storage.audit;

i=t:std.test;
i=str:std.str;

(* --- stub audit log functions --- *)

(* simulate audit entry count *)
let g_entry_count=mut.0;

(* append an audit entry — returns entry ID *)
f=audit_append(action:str;user:str;detail:str):i64{
  if(str.len(action)=0){<0};
  if(str.len(user)=0){<0};
  g_entry_count=g_entry_count+1;
  <g_entry_count
};

(* query audit by action — returns count of matching entries (stubbed) *)
f=audit_query_count(action:str):i64{
  if(str.eq(action;"login")){<5};
  if(str.eq(action;"query")){<12};
  if(str.eq(action;"export")){<2};
  <0
};

(* format audit entry as string *)
f=audit_format(id:i64;action:str;user:str;detail:str):str{
  <str.concat("[";str.concat(str.from_i64(id);str.concat("] ";str.concat(action;str.concat(" by ";str.concat(user;str.concat(": ";detail)))))))
};

(* validate action string *)
f=valid_action(action:str):i64{
  if(str.eq(action;"login")){<1};
  if(str.eq(action;"logout")){<1};
  if(str.eq(action;"query")){<1};
  if(str.eq(action;"export")){<1};
  if(str.eq(action;"config_change")){<1};
  <0
};

(* check if audit log is immutable (append-only) *)
f=is_append_only():i64{ <1 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* reset counter *)
  g_entry_count=0;

  (* test append returns incrementing IDs *)
  let id1=audit_append("login";"alice";"session start");
  if(t.assert(id1=1;"first entry gets ID 1")){pass=pass+1}el{fail=fail+1};

  let id2=audit_append("query";"alice";"SELECT * FROM data");
  if(t.assert(id2=2;"second entry gets ID 2")){pass=pass+1}el{fail=fail+1};

  let id3=audit_append("logout";"alice";"session end");
  if(t.assert(id3=3;"third entry gets ID 3")){pass=pass+1}el{fail=fail+1};

  (* test append rejects empty action *)
  if(t.assert(audit_append("";"alice";"detail")=0;"empty action rejected")){pass=pass+1}el{fail=fail+1};

  (* test append rejects empty user *)
  if(t.assert(audit_append("login";"";"detail")=0;"empty user rejected")){pass=pass+1}el{fail=fail+1};

  (* test query count *)
  if(t.assert(audit_query_count("login")=5;"5 login entries found")){pass=pass+1}el{fail=fail+1};

  if(t.assert(audit_query_count("query")=12;"12 query entries found")){pass=pass+1}el{fail=fail+1};

  if(t.assert(audit_query_count("unknown_action")=0;"unknown action returns 0")){pass=pass+1}el{fail=fail+1};

  (* test format *)
  let formatted=audit_format(1;"login";"alice";"session start");
  if(t.assert(str.contains(formatted;"[1]");"format includes ID")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(formatted;"login by alice");"format includes action and user")){pass=pass+1}el{fail=fail+1};

  (* test valid actions *)
  if(t.assert(valid_action("login")=1;"login is valid action")){pass=pass+1}el{fail=fail+1};

  if(t.assert(valid_action("config_change")=1;"config_change is valid action")){pass=pass+1}el{fail=fail+1};

  if(t.assert(valid_action("hack")=0;"hack is not valid action")){pass=pass+1}el{fail=fail+1};

  (* test append-only property *)
  if(t.assert(is_append_only()=1;"audit log is append-only")){pass=pass+1}el{fail=fail+1};

  <fail
};

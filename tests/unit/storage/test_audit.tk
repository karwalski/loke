m=test.storage.audit;

i=t:std.test;
i=str:std.str;

(* --- stub audit log functions --- *)

(* append an audit entry — returns 1 on valid input, 0 on invalid *)
f=auditappend(action:str;user:str;detail:str):i64{
  if(str.len(action)=0){<0};
  if(str.len(user)=0){<0};
  <1
};

(* simulate sequential append — takes counter, returns next ID *)
f=auditappendseq(action:str;user:str;detail:str;counter:i64):i64{
  if(str.len(action)=0){<0};
  if(str.len(user)=0){<0};
  <counter+1
};

(* query audit by action — returns count of matching entries (stubbed) *)
f=auditquerycount(action:str):i64{
  if(str.eq(action;"login")){<5};
  if(str.eq(action;"query")){<12};
  if(str.eq(action;"export")){<2};
  <0
};

(* format audit entry as string *)
f=auditformat(id:i64;action:str;user:str;detail:str):str{
  <str.concat("[";str.concat(str.fromi64(id);str.concat("] ";str.concat(action;str.concat(" by ";str.concat(user;str.concat(": ";detail)))))))
};

(* validate action string *)
f=validaction(action:str):i64{
  if(str.eq(action;"login")){<1};
  if(str.eq(action;"logout")){<1};
  if(str.eq(action;"query")){<1};
  if(str.eq(action;"export")){<1};
  if(str.eq(action;"configchange")){<1};
  <0
};

(* check if audit log is immutable (append-only) *)
f=isappendonly():i64{ <1 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test append returns incrementing IDs *)
  let id1=auditappendseq("login";"alice";"session start";0);
  if(t.assert(id1=1;"first entry gets ID 1")){pass=pass+1}el{fail=fail+1};

  let id2=auditappendseq("query";"alice";"SELECT * FROM data";id1);
  if(t.assert(id2=2;"second entry gets ID 2")){pass=pass+1}el{fail=fail+1};

  let id3=auditappendseq("logout";"alice";"session end";id2);
  if(t.assert(id3=3;"third entry gets ID 3")){pass=pass+1}el{fail=fail+1};

  (* test append rejects empty action *)
  if(t.assert(auditappend("";"alice";"detail")=0;"empty action rejected")){pass=pass+1}el{fail=fail+1};

  (* test append rejects empty user *)
  if(t.assert(auditappend("login";"";"detail")=0;"empty user rejected")){pass=pass+1}el{fail=fail+1};

  (* test query count *)
  if(t.assert(auditquerycount("login")=5;"5 login entries found")){pass=pass+1}el{fail=fail+1};

  if(t.assert(auditquerycount("query")=12;"12 query entries found")){pass=pass+1}el{fail=fail+1};

  if(t.assert(auditquerycount("unknownaction")=0;"unknown action returns 0")){pass=pass+1}el{fail=fail+1};

  (* test format *)
  let formatted=auditformat(1;"login";"alice";"session start");
  if(t.assert(str.contains(formatted;"[1]");"format includes ID")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(formatted;"login by alice");"format includes action and user")){pass=pass+1}el{fail=fail+1};

  (* test valid actions *)
  if(t.assert(validaction("login")=1;"login is valid action")){pass=pass+1}el{fail=fail+1};

  if(t.assert(validaction("configchange")=1;"configchange is valid action")){pass=pass+1}el{fail=fail+1};

  if(t.assert(validaction("hack")=0;"hack is not valid action")){pass=pass+1}el{fail=fail+1};

  (* test append-only property *)
  if(t.assert(isappendonly()=1;"audit log is append-only")){pass=pass+1}el{fail=fail+1};

  <fail
};

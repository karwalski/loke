



m=tests.unit.storage.testaudit;

i=db:core.storage.db;
i=audit:core.storage.audit;
i=str:std.str;
i=json:std.json;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };
f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=makeevent(eventtype:str;usecase:str):i64{
  <$audit.auditevent{
    eventtype:eventtype;
    usecase:usecase;
    modelid:"gpt-4o";
    provider:"openai";
    sensitivity:"low";
    risktier:"green";
    tokensin:100;
    tokensout:50;
    costusd:0.001;
    durationms:200;
    correlationid:"test-corr-001"
  };
};

f=runall():bool{
  let results = @($result)@();
  let store = mt db.open(":memory:") {
    $ok:s s;
    $err:e {
      log.error("failed to open test db");
      <false
    };
  };

  
  let before = mt audit.getrecent(store;100) {
    $ok:rows str.arraylen(rows);
    $err:e 0
  };
  audit.logevent(store;makeevent("request";"test_use_case"));
  let after = mt audit.getrecent(store;100) {
    $ok:rows str.arraylen(rows);
    $err:e 0
  };
  let rcount = asserteq("append increases count";str.fromint(after);str.fromint(before+1));
  let results = str.arraypush(results;rcount);

  
  audit.logevent(store;makeevent("response";"filter_test"));
  audit.logevent(store;makeevent("response";"filter_test"));
  audit.logevent(store;makeevent("request";"filter_test"));
  let allevents = mt audit.getrecent(store;100) {
    $ok:rows rows;
    $err:e @($audit.auditevent)@()
  };
  let matchcount = 0;
  let ifilter = 0;
  let nfilter = str.arraylen(allevents);
  lp(true){
    if(ifilter > nfilter){ break }el{
      let ev = str.arrayget(allevents;ifilter);
      if(str.eq(ev.eventtype;"response")){ let matchcount = matchcount+1 }el{};
      ifilter = ifilter+1
    };
  };
  let rfilter = asserttrue("filter by type returns only matching";matchcount > 2);
  let results = str.arraypush(results;rfilter);

  
  let eventsforjson = mt audit.getrecent(store;1) {
    $ok:rows rows;
    $err:e @($audit.auditevent)@()
  };
  let rjson = if(str.arraylen(eventsforjson) > 0){
    let ev = str.arrayget(eventsforjson;0);
    let j = json.stringify(ev);
    let hascontent = str.arraylen(j) > 0;
    let haseventtype = str.contains(j;"event_type");
    let hascorrelation = str.contains(j;"correlation_id");
    if(hascontent){
      if(haseventtype){
        if(hascorrelation){
          pass("to_json contains expected fields")
        }el{
          fail("to_json contains expected fields";"missing correlation_id field")
        };
      }el{
        fail("to_json contains expected fields";"missing event_type field")
      };
    }el{
      fail("to_json produces non-empty string";"json output was empty")
    };
  }el{
    fail("to_json on entry";"no events found to serialise")
  };
  let results = str.arraypush(results;rjson);

  
  
  let eventscsv = mt audit.getrecent(store;10) {
    $ok:rows rows;
    $err:e @($audit.auditevent)@()
  };
  let header = "event_type,use_case,model_id,provider,sensitivity,risk_tier,tokens_in,tokens_out,cost_usd,duration_ms,correlation_id";
  let rcsvheader = asserttrue("CSV header is non-empty with commas";str.contains(header;","));
  let results = str.arraypush(results;rcsvheader);

  
  
  
  
  let countbeforeappendonly = mt audit.getrecent(store;100) {
    $ok:rows str.arraylen(rows);
    $err:e 0
  };
  audit.logevent(store;makeevent("request";"append_only_test"));
  let countafterappendonly = mt audit.getrecent(store;100) {
    $ok:rows str.arraylen(rows);
    $err:e 0
  };
  let rappendonly = asserttrue("audit is append-only: count only grows";countafterappendonly > countbeforeappendonly);
  let results = str.arraypush(results;rappendonly);

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

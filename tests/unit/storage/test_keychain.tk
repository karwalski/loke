



m=tests.unit.storage.testkeychain;

i=kc:core.storage.keychain;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };
f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};
f=runall():bool{
  let results = @$result@();

  
  let stored = kc.setapikey("test_provider_t541";"sk-test-abc123");
  let rstoreok = asserttrue("set_api_key returns true";stored);
  let results = str.arraypush(results;rstoreok);

  let rroundtrip = mt kc.getapikey("test_provider_t541") {
    $some:v asserteq("set/get_api_key round-trip";v;"sk-test-abc123");
    $none:fail("set/get_api_key round-trip";"expected value but got none")
  };
  let results = str.arraypush(results;rroundtrip);

  
  let runknown = mt kc.getapikey("__no_such_provider_xyz__") {
    $some:v fail("retrieve unknown service returns none";"expected none but got a value");
    $none:pass("retrieve unknown service returns none")
  };
  let results = str.arraypush(results;runknown);

  
  kc.setapikey("test_provider_t54c";"sk-delete-me");
  let beforedelete = mt kc.getapikey("test_provider_t54c") {
    $some:v true;
    $none:false
  };
  let rbefore = asserttrue("key present before delete";beforedelete);
  let results = str.arraypush(results;rbefore);

  kc.deletekey(str.concat("api_key.";"test_provider_t54c"));
  let rafterdelete = mt kc.getapikey("test_provider_t54c") {
    $some:v fail("delete makes retrieve return none";"expected none after delete but got value");
    $none:pass("delete makes retrieve return none")
  };
  let results = str.arraypush(results;rafterdelete);

  
  
  let exactprovider = "OpenAI_GPT4-Turbo";
  kc.setapikey(exactprovider;"sk-exact-service-check");
  let rexact = mt kc.getapikey(exactprovider) {
    $some:v asserteq("service name preserved exactly";v;"sk-exact-service-check");
    $none:fail("service name preserved exactly";"expected value but got none — provider name may have been mangled")
  };
  let results = str.arraypush(results;rexact);

  
  kc.setapikey("test_provider_t54e";"sk-lifecycle");
  let rhasafterset = asserttrue("has_key true after set";kc.haskey(str.concat("api_key.";"test_provider_t54e")));
  let results = str.arraypush(results;rhasafterset);

  kc.deletekey(str.concat("api_key.";"test_provider_t54e"));
  let rhasafterdel = assertfalse("has_key false after delete";kc.haskey(str.concat("api_key.";"test_provider_t54e")));
  let results = str.arraypush(results;rhasafterdel);

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

m=test.storage.keychain;

i=t:std.test;
i=str:std.str;

(* --- stub keychain functions --- *)

(* simulate a simple key-value credential store *)
(* using function-based dispatch since we lack real data structures *)

f=keychainstore(service:str;key:str;value:str):i64{
  if(str.len(service)=0){<0};
  if(str.len(key)=0){<0};
  if(str.len(value)=0){<0};
  <1
};

f=keychainretrieve(service:str;key:str):str{
  (* stubbed known credentials *)
  if(str.eq(service;"openai")){
    if(str.eq(key;"apikey")){<"sk-test-1234"}
  };
  if(str.eq(service;"anthropic")){
    if(str.eq(key;"apikey")){<"sk-ant-test-5678"}
  };
  <""
};

f=keychaindelete(service:str;key:str):i64{
  if(str.len(service)=0){<0};
  if(str.len(key)=0){<0};
  (* simulate successful delete *)
  <1
};

f=keychainexists(service:str;key:str):i64{
  let val=keychainretrieve(service;key);
  if(str.len(val)>0){<1};
  <0
};

(* mask a credential for display *)
f=maskcredential(value:str):str{
  if(str.len(value)<8){<"****"};
  <str.concat(str.slice(value;0;4);"****")
};

(* count stored credentials (stubbed) *)
f=credentialcount():i64{ <2 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test store succeeds with valid inputs *)
  if(t.assert(keychainstore("openai";"apikey";"sk-test")=1;"store valid credential succeeds")){pass=pass+1}el{fail=fail+1};

  (* test store rejects empty service *)
  if(t.assert(keychainstore("";"apikey";"sk-test")=0;"empty service rejected")){pass=pass+1}el{fail=fail+1};

  (* test store rejects empty key *)
  if(t.assert(keychainstore("openai";"";"sk-test")=0;"empty key rejected")){pass=pass+1}el{fail=fail+1};

  (* test store rejects empty value *)
  if(t.assert(keychainstore("openai";"apikey";"")=0;"empty value rejected")){pass=pass+1}el{fail=fail+1};

  (* test retrieve known credential *)
  if(t.assert(str.eq(keychainretrieve("openai";"apikey");"sk-test-1234");"retrieve openai key")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(keychainretrieve("anthropic";"apikey");"sk-ant-test-5678");"retrieve anthropic key")){pass=pass+1}el{fail=fail+1};

  (* test retrieve unknown returns empty *)
  if(t.assert(str.eq(keychainretrieve("unknown";"apikey");"");"unknown service returns empty")){pass=pass+1}el{fail=fail+1};

  (* test exists *)
  if(t.assert(keychainexists("openai";"apikey")=1;"openai key exists")){pass=pass+1}el{fail=fail+1};

  if(t.assert(keychainexists("unknown";"apikey")=0;"unknown key does not exist")){pass=pass+1}el{fail=fail+1};

  (* test delete succeeds *)
  if(t.assert(keychaindelete("openai";"apikey")=1;"delete succeeds")){pass=pass+1}el{fail=fail+1};

  (* test delete rejects empty inputs *)
  if(t.assert(keychaindelete("";"apikey")=0;"delete empty service rejected")){pass=pass+1}el{fail=fail+1};

  (* test credential masking *)
  if(t.assert(str.eq(maskcredential("sk-test-1234");"sk-t****");"mask shows first 4 chars")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(maskcredential("short");"****");"short credential fully masked")){pass=pass+1}el{fail=fail+1};

  (* test credential count *)
  if(t.assert(credentialcount()=2;"credential count is 2")){pass=pass+1}el{fail=fail+1};

  <fail
};

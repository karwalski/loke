m=test.a11y.scripts;

i=t:std.test;
i=str:std.str;
i=ann:core.a11y.announcements;
i=trap:core.a11y.focustrap;
i=rove:core.a11y.rovingtabindex;
i=kb:core.a11y.keyboard;
i=focus:core.a11y.focus;
i=skip:core.a11y.skiplink;
i=live:core.a11y.liveregions;

(* F10.12-T2 — the JavaScript the a11y modules emit. The legacy copies had been through a
   migration that rewrote JavaScript as toke: `@()` for `[]` and `}el{` for `} else {`
   (both SyntaxErrors, so the script never loaded), and `=` where `===` was meant (an
   assignment, always true). These assert that none of that is in what ships, and that the
   specific broken comparisons are now comparisons. *)

f=toked(js:str):bool{
  <str.contains(js;"@(") || str.contains(js;"}el{")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.assert(!toked(ann.announcementsjs());"announcements JS has no toke array literal or else")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!toked(trap.focustrapjs());"focus-trap JS has none")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!toked(rove.rovingtabindexjs());"roving tabindex JS has none")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!toked(kb.keyboardjs()) && !toked(focus.focusjs()) && !toked(skip.skiplinkjs()) && !toked(live.announcejs());"nor do the other four scripts")){pass=pass+1}el{fail=fail+1};

  let a=ann.announcementsjs();
  if(t.assert(str.contains(a;"var _toastTimes=[];");"the toast window starts as an empty JavaScript array")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(a;"(variant==='error'||variant==='warning')");"and a toast's variant is compared, not overwritten")){pass=pass+1}el{fail=fail+1};

  let tr=trap.focustrapjs();
  if(t.assert(str.contains(tr;"if(e.key==='Escape'&&escapeDeactivates)");"only Escape deactivates the trap")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(tr;"if(initialFocus==='container')") && str.contains(tr;"if(document.activeElement===last)");"initial focus and the Tab wrap compare")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(tr;"var FOCUSABLE='\(trap.focusableselector())';");"the trap's selector is focusableselector's")){pass=pass+1}el{fail=fail+1};

  let r=rove.rovingtabindexjs();
  if(t.assert(str.contains(r;"item.setAttribute('tabindex',i===0?'0':'-1');");"the first roving item is in the tab order")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(r;"if(e.key==='ArrowRight') isNext=true;") && str.contains(r;"if(e.key==='Home'){");"keys are compared, not assigned")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(r;"e.key='") && !str.contains(tr;"e.key='");"no key comparison is an assignment in either script")){pass=pass+1}el{fail=fail+1};

  <fail
};

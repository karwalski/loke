
m=tests.unit.a11y.testfocustrap;

i=ft:loke.platform.a11y.focustrap;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@$result@();

  let js=ft.focustrapjs();

  results=str.arraypush(results;asserttrue("focus trap js non-empty";str.len(js)>0));

  results=str.arraypush(results;asserttrue(
    "contains loke_create_focus_trap";
    str.contains(js;"loke_create_focus_trap")
  ));

  results=str.arraypush(results;asserttrue(
    "contains activate function";
    str.contains(js;"function activate")
  ));

  results=str.arraypush(results;asserttrue(
    "contains deactivate function";
    str.contains(js;"function deactivate")
  ));

  results=str.arraypush(results;asserttrue(
    "contains isActive";
    str.contains(js;"isActive")
  ));

  results=str.arraypush(results;asserttrue(
    "handles Escape key";
    str.contains(js;"Escape")
  ));

  results=str.arraypush(results;asserttrue(
    "handles Tab key";
    str.contains(js;"Tab")
  ));

  results=str.arraypush(results;asserttrue(
    "sets aria-hidden";
    str.contains(js;"aria-hidden")
  ));

  results=str.arraypush(results;asserttrue(
    "sets inert attribute";
    str.contains(js;"inert")
  ));

  results=str.arraypush(results;asserttrue(
    "restores focus via savedFocus";
    str.contains(js;"savedFocus")
  ));

  let selector=ft.focusableselector();
  results=str.arraypush(results;asserttrue(
    "focusable selector non-empty";
    str.len(selector)>0
  ));
  results=str.arraypush(results;asserttrue(
    "focusable selector includes button";
    str.contains(selector;"button")
  ));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1
    };
  };
  <all
};

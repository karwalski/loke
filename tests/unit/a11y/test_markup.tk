m=test.a11y.markup;

i=t:std.test;
i=str:std.str;
i=aria:core.a11y.ariapatterns;
i=sem:core.a11y.semantic;
i=skip:core.a11y.skiplink;
i=focus:core.a11y.focus;
i=live:core.a11y.liveregions;

(* F10.12-T2 — the markup builders, imported: core.a11y.ariapatterns, semantic, skiplink,
   focus and liveregions. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.asserteq(aria.attrvalue("a\"b<c>&'d");"a&quot;b&lt;c&gt;&amp;&#39;d";"attrvalue escapes the five characters, & once")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(aria.dialogattrs("title\" onclick=\"x");"role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"title&quot; onclick=&quot;x\"";"a quote in a label id cannot end the attribute")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(aria.tabattrs(true);"role=\"tab\" aria-selected=\"true\" tabindex=\"0\"";"the selected tab is in the tab order")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(aria.tabattrs(false);"role=\"tab\" aria-selected=\"false\" tabindex=\"-1\"";"the others are not")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(aria.switchattrs(false);"role=\"switch\" aria-checked=\"false\"";"switchattrs reports its state")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(aria.comboboxattrs(true);"role=\"combobox\" aria-expanded=\"true\" aria-autocomplete=\"list\" aria-haspopup=\"listbox\"";"comboboxattrs reports expansion")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(sem.navhtml(@("<a href=\"/a\">A</a>";"<a href=\"/b\">B</a>";"<a href=\"/c\">C</a>"));"<nav aria-label=\"Main navigation\"><a href=\"/a\">A</a><a href=\"/b\">B</a><a href=\"/c\">C</a></nav>";"navhtml renders every item, not only the first")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sem.formfieldhtml("email";"Email";"email";true);"<div class=\"field\"><label for=\"email\">Email</label><input id=\"email\" name=\"email\" type=\"email\" required aria-required=\"true\"></div>";"a required field is labelled by for/id and says it is required")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(sem.formfieldhtml("n";"N";"text";false);"required");"an optional one does not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(sem.buttonhtml("Save <now>";"go()";"");">Save &lt;now&gt;</button>");"a button label is escaped")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(skip.skiplinkhtml();"id=\"skip-to-main\"") && str.contains(skip.skiplinkhtml();"href=\"#main-content\"");"the skip link carries the id its handler looks up and targets main-content")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(focus.skiplinkhtml();skip.skiplinkhtml();"focus's skip link is the one its own handler can find")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(focus.focusjs();"getElementById('skip-to-main')");"and that handler looks it up by that id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(sem.mainhtml("x");"id=\"main-content\"");"mainhtml is the skip link's target")){pass=pass+1}el{fail=fail+1};

  let regions=live.liveregionhtml();
  if(t.assert(str.contains(regions;"id=\"aria-live-polite\" aria-live=\"polite\"") && str.contains(regions;"id=\"aria-live-assertive\" aria-live=\"assertive\"");"both live regions are present")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(live.announcejs();"getElementById('aria-live-' + (priority||'polite'))");"and announce finds them by those ids")){pass=pass+1}el{fail=fail+1};

  <fail
};


m=tests.unit.a11y.testskiplink;

i=sl:loke.platform.a11y.skiplink;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();

  let html=sl.skiplinkhtml();
  results=str.arraypush(results;asserttrue("html non-empty";str.len(html)>0));
  results=str.arraypush(results;asserttrue("html has anchor tag";str.contains(html;"<a ")));
  results=str.arraypush(results;asserttrue("html targets main-content";str.contains(html;"#main-content")));
  results=str.arraypush(results;asserttrue("html has skip-link class";str.contains(html;"skip-link")));
  results=str.arraypush(results;asserttrue("html has skip-to-main id";str.contains(html;"skip-to-main")));
  results=str.arraypush(results;asserttrue("html has visible text";str.contains(html;"Skip to main content")));

  let css=sl.skiplinkcss();
  results=str.arraypush(results;asserttrue("css non-empty";str.len(css)>0));
  results=str.arraypush(results;asserttrue("css hides skip-link by default";str.contains(css;"top: -100%")));
  results=str.arraypush(results;asserttrue("css reveals on focus";str.contains(css;":focus")));
  results=str.arraypush(results;asserttrue("css sets top:0 on focus";str.contains(css;"top: 0")));
  results=str.arraypush(results;asserttrue("css has position absolute";str.contains(css;"position: absolute")));
  results=str.arraypush(results;asserttrue("css has z-index";str.contains(css;"z-index")));

  let js=sl.skiplinkjs();
  results=str.arraypush(results;asserttrue("js non-empty";str.len(js)>0));
  results=str.arraypush(results;asserttrue("js references skip-to-main";str.contains(js;"skip-to-main")));
  results=str.arraypush(results;asserttrue("js references main-content";str.contains(js;"main-content")));
  results=str.arraypush(results;asserttrue("js sets tabindex -1";str.contains(js;"tabindex")));
  results=str.arraypush(results;asserttrue("js calls focus";str.contains(js;".focus()")));
  results=str.arraypush(results;asserttrue("js prevents default";str.contains(js;"preventDefault")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

m=test.a11y.checker;

i=t:std.test;
i=str:std.str;
i=chk:core.a11y.testing;

(* F10.12-T2 — core.a11y.testing, imported. Each assertion below is one the legacy checker
   failed: it examined only the first tag of each kind, never a tag at offset 0, accepted
   any <label> on the page for every input, and discarded every violation it found, so it
   passed every page. *)

f=count(r:$a11yresult;rule:str):i64{
  let n=mut.0;
  lp(let i=0;i<r.violations.len;i=i+1){
    if(str.eq(r.violations.get(i).rule;rule)){ n=n+1 }el{}
  };
  <n
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let clean=chk.checkhtml("<main id=\"main-content\"><img src=\"a.png\" alt=\"A chart\"><img src=\"b.png\" alt=\"\"><label for=\"q\">Query</label><input id=\"q\" type=\"text\"><button type=\"button\">Go</button></main>";"/ok");
  if(t.assert(clean.passed;"well-formed markup passes")){pass=pass+1}el{fail=fail+1};
  if(t.assert(chk.assertnoviolations(clean);"and assertnoviolations agrees")){pass=pass+1}el{fail=fail+1};

  let imgs=chk.checkhtml("<img src=\"a.png\"><p>text</p><img src=\"b.png\" alt=\"B\"><img src=\"c.png\" data-alt=\"x\">";"/imgs");
  if(t.assert(!imgs.passed;"an image with no alt fails the page")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!chk.assertnoviolations(imgs);"and assertnoviolations says so")){pass=pass+1}el{fail=fail+1};
  if(t.assert(count(imgs;"img-alt")==2;"both alt-less images are found, the one at offset 0 and the third; data-alt is not alt")){pass=pass+1}el{fail=fail+1};

  let inputs=chk.checkhtml("<label for=\"a\">A</label><input id=\"a\"><input id=\"b\"><label>C <input name=\"c\"></label><input aria-label=\"D\"><input type=\"hidden\" name=\"e\"><input id=\"f\">";"/inputs");
  if(t.assert(count(inputs;"input-label")==2;"inputs b and f have no label; label-for, an enclosing label, aria-label and type=hidden all count")){pass=pass+1}el{fail=fail+1};

  let roles=chk.checkhtml("<div role=\"\"></div><span role=\"\"></span><div role=\"note\"></div>";"/roles");
  if(t.assert(count(roles;"role-value")==2;"every empty role attribute is reported, not only the first")){pass=pass+1}el{fail=fail+1};

  let json=chk.resulttojson(chk.checkhtml("<img src=\"x\">";"/a\"b"));
  if(t.assert(str.contains(json;"\"violations\":[{\"rule\":\"img-alt\"");"the JSON carries the violations array")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"element\":\"<img>\"") && str.contains(json;"\"description\":\"Image element is missing an alt attribute\"");"each violation carries its element and description")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"url\":\"/a\\\"b\"");"the url is JSON-escaped")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"passed\":false");"and passed is false")){pass=pass+1}el{fail=fail+1};
  if(t.assert(imgs.checkedat>0;"checkedat is a time, not the legacy 0")){pass=pass+1}el{fail=fail+1};

  <fail
};

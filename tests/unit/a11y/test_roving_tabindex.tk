
m=tests.unit.a11y.testrovingtabindex;

i=roving:loke.platform.a11y.rovingtabindex;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result);

  let js=roving.rovingtabindexjs();

  results=str.arraypush(results;asserttrue("roving tabindex js non-empty";str.len(js)>0));

  results=str.arraypush(results;asserttrue(
    "contains loke_roving_tabindex";
    str.contains(js;"loke_roving_tabindex")
  ));

  results=str.arraypush(results;asserttrue(
    "contains init function";
    str.contains(js;"function init")
  ));

  results=str.arraypush(results;asserttrue(
    "contains destroy function";
    str.contains(js;"function destroy")
  ));

  results=str.arraypush(results;asserttrue(
    "contains focusItem function";
    str.contains(js;"function focusItem")
  ));

  results=str.arraypush(results;asserttrue(
    "contains currentIndex";
    str.contains(js;"currentIndex")
  ));

  results=str.arraypush(results;asserttrue(
    "handles ArrowRight";
    str.contains(js;"ArrowRight")
  ));

  results=str.arraypush(results;asserttrue(
    "handles ArrowLeft";
    str.contains(js;"ArrowLeft")
  ));

  results=str.arraypush(results;asserttrue(
    "handles ArrowDown";
    str.contains(js;"ArrowDown")
  ));

  results=str.arraypush(results;asserttrue(
    "handles ArrowUp";
    str.contains(js;"ArrowUp")
  ));

  results=str.arraypush(results;asserttrue(
    "handles Home key";
    str.contains(js;"Home")
  ));

  results=str.arraypush(results;asserttrue(
    "handles End key";
    str.contains(js;"End")
  ));

  results=str.arraypush(results;asserttrue(
    "sets tabindex 0";
    str.contains(js;"tabindex")
  ));

  results=str.arraypush(results;asserttrue(
    "supports wrap option";
    str.contains(js;"wrap")
  ));

  results=str.arraypush(results;asserttrue(
    "supports orientation option";
    str.contains(js;"orientation")
  ));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i<n){
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed=false){ all=false }el{};
      i=i+1
    }el{
      break
    }
  };
  <all
};


m=tests.unit.a11y.testa11yengine;

i=a11y:loke.platform.a11y.testing;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertequ32(name:$str;got:u32;want:u32):$result{
  if(got=want){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(str.fromu32(want);str.concat(" got=";str.fromu32(got)))))
  };
};

f=assertgteu32(name:$str;got:u32;min:u32):$result{
  if(got>=min){ <pass(name) }el{
    <fail(name;str.concat("want>=";str.concat(str.fromu32(min);str.concat(" got=";str.fromu32(got)))))
  };
};

f=hasviolationrule(result:a11y.$a11yresult:i64;rule:$str):bool{
  let i=0;
  let n=result.violations.len();
  if(i<n){
    if(str.eq(result.violations.get(i).rule;rule)){ <true }el{};
    i=i+1;
  }el{};
  <false
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();


  let r1=a11y.checkhtml("<img src=\"photo.png\">";"test://img-no-alt");
  results=str.arraypush(results;asserttrue("img-alt: missing alt detected";hasviolationrule(r1;"img-alt")));

  let r2=a11y.checkhtml("<img src=\"photo.png\" alt=\"A photo\">";"test://img-with-alt");
  results=str.arraypush(results;assertfalse("img-alt: present alt passes";hasviolationrule(r2;"img-alt")));

  let r3=a11y.checkhtml("<img src=\"bg.png\" alt=\"\">";"test://img-decorative");
  results=str.arraypush(results;assertfalse("img-alt: decorative alt passes";hasviolationrule(r3;"img-alt")));

  let r4=a11y.checkhtml("<img src=\"a.png\"><img src=\"b.png\" alt=\"b\">";"test://img-multi");
  results=str.arraypush(results;asserttrue("img-alt: first missing detected in multi";hasviolationrule(r4;"img-alt")));


  let r5=a11y.checkhtml("<input type=\"text\">";"test://input-no-label");
  results=str.arraypush(results;asserttrue("input-label: missing label detected";hasviolationrule(r5;"input-label")));

  let r6=a11y.checkhtml("<label for=\"name\">Name</label><input id=\"name\" type=\"text\">";"test://input-with-label");
  results=str.arraypush(results;assertfalse("input-label: matching label passes";hasviolationrule(r6;"input-label")));

  let r7=a11y.checkhtml("<input type=\"search\" aria-label=\"Search\">";"test://input-aria-label");
  results=str.arraypush(results;assertfalse("input-label: aria-label passes";hasviolationrule(r7;"input-label")));


  let r8=a11y.checkhtml("<div role=\"\">text</div>";"test://empty-role");
  results=str.arraypush(results;asserttrue("role-value: empty role detected";hasviolationrule(r8;"role-value")));

  let r9=a11y.checkhtml("<div role=\"button\">text</div>";"test://valid-role");
  results=str.arraypush(results;assertfalse("role-value: non-empty passes";hasviolationrule(r9;"role-value")));


  let validheadings="<h1>Title</h1><h2>Section</h2><h3>Sub</h3>";
  let r10=a11y.checkhtml(validheadings;"test://headings-valid");
  results=str.arraypush(results;assertfalse("heading-hierarchy: valid sequence passes";hasviolationrule(r10;"heading-hierarchy")));

  let skipheadings="<h1>Title</h1><h3>Sub</h3>";
  let r11=a11y.checkhtml(skipheadings;"test://headings-skip");
  results=str.arraypush(results;asserttrue("heading-hierarchy: h1->h3 skip detected";hasviolationrule(r11;"heading-hierarchy")));

  let skipheadings2="<h1>T</h1><h2>S</h2><h4>Sub</h4>";
  let r12=a11y.checkhtml(skipheadings2;"test://headings-skip2");
  results=str.arraypush(results;asserttrue("heading-hierarchy: h2->h4 skip detected";hasviolationrule(r12;"heading-hierarchy")));

  let backheadings="<h1>T</h1><h2>A</h2><h3>B</h3><h2>C</h2>";
  let r13=a11y.checkhtml(backheadings;"test://headings-back");
  results=str.arraypush(results;assertfalse("heading-hierarchy: descending then ascending passes";hasviolationrule(r13;"heading-hierarchy")));


  let fullpage="<header>H</header><nav>N</nav><main>M</main>";
  let r14=a11y.checkhtml(fullpage;"test://landmarks-full");
  results=str.arraypush(results;assertfalse("landmark-structure: all present passes";hasviolationrule(r14;"landmark-structure")));

  let nonav="<header>H</header><main>M</main>";
  let r15=a11y.checkhtml(nonav;"test://landmarks-no-nav");
  results=str.arraypush(results;asserttrue("landmark-structure: missing nav detected";hasviolationrule(r15;"landmark-structure")));

  let nomain="<header>H</header><nav>N</nav>";
  let r16=a11y.checkhtml(nomain;"test://landmarks-no-main");
  results=str.arraypush(results;asserttrue("landmark-structure: missing main detected";hasviolationrule(r16;"landmark-structure")));

  let noheader="<nav>N</nav><main>M</main>";
  let r17=a11y.checkhtml(noheader;"test://landmarks-no-header");
  results=str.arraypush(results;asserttrue("landmark-structure: missing header detected";hasviolationrule(r17;"landmark-structure")));


  let r18=a11y.checkhtml("<div role=\"dialog\">D</div>";"test://role-valid");
  results=str.arraypush(results;assertfalse("aria-role-valid: dialog passes";hasviolationrule(r18;"aria-role-valid")));

  let r19=a11y.checkhtml("<div role=\"banana\">B</div>";"test://role-invalid");
  results=str.arraypush(results;asserttrue("aria-role-valid: banana detected";hasviolationrule(r19;"aria-role-valid")));

  let r20=a11y.checkhtml("<div role=\"tablist\"><div role=\"tab\">T</div></div>";"test://roles-multi-valid");
  results=str.arraypush(results;assertfalse("aria-role-valid: multiple valid passes";hasviolationrule(r20;"aria-role-valid")));


  let r21=a11y.checkhtml("<div onclick=\"go()\">Click</div>";"test://kb-div-onclick");
  results=str.arraypush(results;asserttrue("keyboard-operable: div onclick detected";hasviolationrule(r21;"keyboard-operable")));

  let r22=a11y.checkhtml("<span onclick=\"go()\">Click</span>";"test://kb-span-onclick");
  results=str.arraypush(results;asserttrue("keyboard-operable: span onclick detected";hasviolationrule(r22;"keyboard-operable")));

  let r23=a11y.checkhtml("<button onclick=\"go()\">Click</button>";"test://kb-button-onclick");
  results=str.arraypush(results;assertfalse("keyboard-operable: button onclick passes";hasviolationrule(r23;"keyboard-operable")));

  let r24=a11y.checkhtml("<div onclick=\"go()\" role=\"button\" tabindex=\"0\">Click</div>";"test://kb-div-proper");
  results=str.arraypush(results;assertfalse("keyboard-operable: div with role+tabindex passes";hasviolationrule(r24;"keyboard-operable")));


  let optsimgonly=a11y.$a11ycheckoptions{
    runonly:@$str.get("img-alt");
    disablerules:@$str@()
  };
  let mixedhtml="<img src=\"x\"><h1>T</h1><h3>S</h3>";
  let r25=a11y.checkAccessibility(mixedhtml;"test://run-only";optsimgonly);
  results=str.arraypush(results;asserttrue("run_only: img-alt found";hasviolationrule(r25;"img-alt")));
  results=str.arraypush(results;assertfalse("run_only: heading-hierarchy skipped";hasviolationrule(r25;"heading-hierarchy")));

  let optsnolandmarks=a11y.$a11ycheckoptions{
    runonly:@$str@();
    disablerules:@$str.get("landmark-structure")
  };
  let r26=a11y.checkAccessibility("<p>Hello</p>";"test://disable-landmarks";optsnolandmarks);
  results=str.arraypush(results;assertfalse("disable_rules: landmark-structure skipped";hasviolationrule(r26;"landmark-structure")));


  let r27=a11y.checkhtml("<p>Clean</p>";"test://clean");
  results=str.arraypush(results;asserttrue("check_html: clean passes (ignoring landmarks)";r27.violations.len()>=0));


  let dirty=a11y.checkhtml("<img src=\"x\">";"test://dirty");
  let json=a11y.resulttojson(dirty);
  results=str.arraypush(results;asserttrue("result_to_json non-empty";str.len(json)>0));
  results=str.arraypush(results;asserttrue("result_to_json has violations key";str.contains(json;"violations")));
  results=str.arraypush(results;asserttrue("result_to_json has url";str.contains(json;"test://dirty")));

  let cleanresult=a11y.checkhtml("<header>H</header><nav>N</nav><main><h1>T</h1><p>Clean</p></main>";"test://all-clean");
  results=str.arraypush(results;asserttrue("assert_no_violations for clean html";a11y.assertnoviolations(cleanresult)));

  let dirtyresult=a11y.checkhtml("<img src=\"x\">";"test://dirty2");
  results=str.arraypush(results;assertfalse("assert_no_violations for dirty html";a11y.assertnoviolations(dirtyresult)));


  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

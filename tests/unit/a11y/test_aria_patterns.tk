
m=tests.unit.a11y.testariapatterns;

i=sem:loke.platform.a11y.semantic;
i=aria:loke.platform.a11y.ariapatterns;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result);


  let hdr=sem.headerhtml("Site Title");
  results=str.arraypush(results;asserttrue("header starts with <header>";str.startswith(hdr;"<header>")));
  results=str.arraypush(results;asserttrue("header ends with </header>";str.endswith(hdr;"</header>")));
  results=str.arraypush(results;asserttrue("header contains content";str.contains(hdr;"Site Title")));

  let ftr=sem.footerhtml("Copyright 2026");
  results=str.arraypush(results;asserttrue("footer starts with <footer>";str.startswith(ftr;"<footer>")));
  results=str.arraypush(results;asserttrue("footer ends with </footer>";str.endswith(ftr;"</footer>")));
  results=str.arraypush(results;asserttrue("footer contains content";str.contains(ftr;"Copyright 2026")));

  let aside=sem.asidehtml("Sidebar";"Side content");
  results=str.arraypush(results;asserttrue("aside starts with <aside>";str.startswith(aside;"<aside")));
  results=str.arraypush(results;asserttrue("aside has aria-label";str.contains(aside;"aria-label=\"Sidebar\"")));
  results=str.arraypush(results;asserttrue("aside ends with </aside>";str.endswith(aside;"</aside>")));
  results=str.arraypush(results;asserttrue("aside contains content";str.contains(aside;"Side content")));

  let fs=sem.fieldsethtml("Credentials";"<input id=\"user\">");
  results=str.arraypush(results;asserttrue("fieldset starts with <fieldset>";str.startswith(fs;"<fieldset>")));
  results=str.arraypush(results;asserttrue("fieldset has legend";str.contains(fs;"<legend>Credentials</legend>")));
  results=str.arraypush(results;asserttrue("fieldset ends with </fieldset>";str.endswith(fs;"</fieldset>")));
  results=str.arraypush(results;asserttrue("fieldset contains content";str.contains(fs;"<input id=\"user\">")));

  let sec=sem.sectionhtml("sec-heading";"<h2 id=\"sec-heading\">Settings</h2>");
  results=str.arraypush(results;asserttrue("section starts with <section>";str.startswith(sec;"<section")));
  results=str.arraypush(results;asserttrue("section has aria-labelledby";str.contains(sec;"aria-labelledby=\"sec-heading\"")));
  results=str.arraypush(results;asserttrue("section ends with </section>";str.endswith(sec;"</section>")));


  let dlg=aria.dialogattrs("dlg-title");
  results=str.arraypush(results;asserttrue("dialog has role=dialog";str.contains(dlg;"role=\"dialog\"")));
  results=str.arraypush(results;asserttrue("dialog has aria-modal=true";str.contains(dlg;"aria-modal=\"true\"")));
  results=str.arraypush(results;asserttrue("dialog has aria-labelledby";str.contains(dlg;"aria-labelledby=\"dlg-title\"")));

  let adlg=aria.alertdialogattrs("alert-title";"alert-desc");
  results=str.arraypush(results;asserttrue("alertdialog has role=alertdialog";str.contains(adlg;"role=\"alertdialog\"")));
  results=str.arraypush(results;asserttrue("alertdialog has aria-describedby";str.contains(adlg;"aria-describedby=\"alert-desc\"")));

  let tabsel=aria.tabattrs(true);
  results=str.arraypush(results;asserttrue("tab selected has role=tab";str.contains(tabsel;"role=\"tab\"")));
  results=str.arraypush(results;asserttrue("tab selected has aria-selected=true";str.contains(tabsel;"aria-selected=\"true\"")));
  results=str.arraypush(results;asserttrue("tab selected has tabindex=0";str.contains(tabsel;"tabindex=\"0\"")));

  let tabunsel=aria.tabattrs(false);
  results=str.arraypush(results;asserttrue("tab unselected has aria-selected=false";str.contains(tabunsel;"aria-selected=\"false\"")));
  results=str.arraypush(results;asserttrue("tab unselected has tabindex=-1";str.contains(tabunsel;"tabindex=\"-1\"")));

  let tp=aria.tabpanelattrs("tab-1");
  results=str.arraypush(results;asserttrue("tabpanel has role=tabpanel";str.contains(tp;"role=\"tabpanel\"")));
  results=str.arraypush(results;asserttrue("tabpanel has aria-labelledby";str.contains(tp;"aria-labelledby=\"tab-1\"")));

  let tl=aria.tablistattrs();
  results=str.arraypush(results;asserteq("tablist attrs";tl;"role=\"tablist\""));

  let mn=aria.menuattrs();
  results=str.arraypush(results;asserteq("menu attrs";mn;"role=\"menu\""));

  let mi=aria.menuitemattrs();
  results=str.arraypush(results;asserteq("menuitem attrs";mi;"role=\"menuitem\""));

  let tb=aria.toolbarattrs("Formatting");
  results=str.arraypush(results;asserttrue("toolbar has role=toolbar";str.contains(tb;"role=\"toolbar\"")));
  results=str.arraypush(results;asserttrue("toolbar has aria-label";str.contains(tb;"aria-label=\"Formatting\"")));

  let swon=aria.switchattrs(true);
  results=str.arraypush(results;asserttrue("switch on has role=switch";str.contains(swon;"role=\"switch\"")));
  results=str.arraypush(results;asserttrue("switch on has aria-checked=true";str.contains(swon;"aria-checked=\"true\"")));

  let swoff=aria.switchattrs(false);
  results=str.arraypush(results;asserttrue("switch off has aria-checked=false";str.contains(swoff;"aria-checked=\"false\"")));

  let tt=aria.tooltipattrs();
  results=str.arraypush(results;asserteq("tooltip attrs";tt;"role=\"tooltip\""));

  let st=aria.statusattrs();
  results=str.arraypush(results;asserteq("status attrs";st;"role=\"status\""));

  let pb=aria.progressbarattrs("50";"0";"100";"Upload progress");
  results=str.arraypush(results;asserttrue("progressbar has role";str.contains(pb;"role=\"progressbar\"")));
  results=str.arraypush(results;asserttrue("progressbar has valuenow";str.contains(pb;"aria-valuenow=\"50\"")));
  results=str.arraypush(results;asserttrue("progressbar has valuemin";str.contains(pb;"aria-valuemin=\"0\"")));
  results=str.arraypush(results;asserttrue("progressbar has valuemax";str.contains(pb;"aria-valuemax=\"100\"")));
  results=str.arraypush(results;asserttrue("progressbar has label";str.contains(pb;"aria-label=\"Upload progress\"")));

  let cbopen=aria.comboboxattrs(true);
  results=str.arraypush(results;asserttrue("combobox has role=combobox";str.contains(cbopen;"role=\"combobox\"")));
  results=str.arraypush(results;asserttrue("combobox expanded=true";str.contains(cbopen;"aria-expanded=\"true\"")));
  results=str.arraypush(results;asserttrue("combobox has haspopup";str.contains(cbopen;"aria-haspopup=\"listbox\"")));

  let cbclosed=aria.comboboxattrs(false);
  results=str.arraypush(results;asserttrue("combobox expanded=false";str.contains(cbclosed;"aria-expanded=\"false\"")));


  let nav=sem.navhtml(@("<a href=\"/\">Home</a>";"<a href=\"/settings\">Settings</a>"));
  results=str.arraypush(results;asserttrue("nav has nav element";str.contains(nav;"<nav")));
  results=str.arraypush(results;asserttrue("nav has aria-label";str.contains(nav;"aria-label")));

  let main=sem.mainhtml("<p>Content</p>");
  results=str.arraypush(results;asserttrue("main has main element";str.contains(main;"<main")));
  results=str.arraypush(results;asserttrue("main has id main-content";str.contains(main;"id=\"main-content\"")));

  let btn=sem.buttonhtml("Save";"save()";"class=\"btn\"");
  results=str.arraypush(results;asserttrue("button has button element";str.contains(btn;"<button")));
  results=str.arraypush(results;asserttrue("button has type=button";str.contains(btn;"type=\"button\"")));
  results=str.arraypush(results;asserttrue("button has aria-label";str.contains(btn;"aria-label=\"Save\"")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i<n){
      let r=str.arrayget(results;i);
      logresult(r);
      if(r.passed=false){ all=false }el{};
      i=i+1
    }el{
      break
    }
  };
  <all
};


m=tests.unit.a11y.testkeyboardnav;

i=kb:loke.platform.a11y.keyboard;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();

  let js=kb.keyboardjs();

  results=str.arraypush(results;asserttrue("keyboard js non-empty";str.len(js)>0));

  results=str.arraypush(results;asserttrue(
    "logs activation message";
    str.contains(js;"a11y: keyboard navigation active")
  ));

  results=str.arraypush(results;asserttrue(
    "has rovingMove function";
    str.contains(js;"rovingMove")
  ));

  results=str.arraypush(results;asserttrue(
    "supports listbox widget";
    str.contains(js;"role=\"listbox\"")
  ));
  results=str.arraypush(results;asserttrue(
    "supports menu widget";
    str.contains(js;"role=\"menu\"")
  ));
  results=str.arraypush(results;asserttrue(
    "supports tablist widget";
    str.contains(js;"role=\"tablist\"")
  ));
  results=str.arraypush(results;asserttrue(
    "supports toolbar widget";
    str.contains(js;"role=\"toolbar\"")
  ));

  results=str.arraypush(results;asserttrue(
    "supports option items";
    str.contains(js;"role=\"option\"")
  ));

  results=str.arraypush(results;asserttrue(
    "supports menuitem items";
    str.contains(js;"role=\"menuitem\"")
  ));

  results=str.arraypush(results;asserttrue(
    "supports tab items";
    str.contains(js;"role=\"tab\"")
  ));

  results=str.arraypush(results;asserttrue(
    "handles ArrowDown";
    str.contains(js;"ArrowDown")
  ));
  results=str.arraypush(results;asserttrue(
    "handles ArrowUp";
    str.contains(js;"ArrowUp")
  ));
  results=str.arraypush(results;asserttrue(
    "handles ArrowRight";
    str.contains(js;"ArrowRight")
  ));
  results=str.arraypush(results;asserttrue(
    "handles ArrowLeft";
    str.contains(js;"ArrowLeft")
  ));

  results=str.arraypush(results;asserttrue(
    "handles Home key";
    str.contains(js;"Home")
  ));
  results=str.arraypush(results;asserttrue(
    "handles End key";
    str.contains(js;"End")
  ));

  results=str.arraypush(results;asserttrue(
    "implements wrapping via modulo";
    str.contains(js;"%items.length")
  ));

  results=str.arraypush(results;asserttrue(
    "Escape closes overlays";
    str.contains(js;"Escape")
  ));

  results=str.arraypush(results;asserttrue(
    "initialises roving tabindex";
    str.contains(js;"initRovingTabindex")
  ));

  results=str.arraypush(results;asserttrue(
    "sets tabindex 0 on active item";
    str.contains(js;"tabindex")
  ));

  results=str.arraypush(results;asserttrue(
    "sets tabindex -1 on inactive items";
    str.contains(js;"setAttribute('tabindex','-1')")
  ));

  results=str.arraypush(results;asserttrue(
    "? key opens help overlay";
    str.contains(js;"keyboard-help-overlay")
  ));

  results=str.arraypush(results;asserttrue(
    "adds aria-label to empty links";
    str.contains(js;"aria-label")
  ));

  results=str.arraypush(results;asserttrue(
    "has vertical orientation";
    str.contains(js;"vertical")
  ));
  results=str.arraypush(results;asserttrue(
    "has horizontal orientation";
    str.contains(js;"horizontal")
  ));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

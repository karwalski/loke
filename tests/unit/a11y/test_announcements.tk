
m=tests.unit.a11y.testannouncements;

i=ann:loke.platform.a11y.announcements;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();

  let js=ann.announcementsjs();

  results=str.arraypush(results;asserttrue("announcements js non-empty";str.len(js)>0));

  results=str.arraypush(results;asserttrue(
    "has loke_announce_stage";
    str.contains(js;"loke_announce_stage")
  ));

  results=str.arraypush(results;asserttrue(
    "announce_stage uses polite";
    str.contains(js;"'polite'")
  ));

  results=str.arraypush(results;asserttrue(
    "has loke_announce_violation";
    str.contains(js;"loke_announce_violation")
  ));

  results=str.arraypush(results;asserttrue(
    "announce_violation uses assertive";
    str.contains(js;"'assertive'")
  ));

  results=str.arraypush(results;asserttrue(
    "announce_violation prefixes Warning";
    str.contains(js;"Warning: ")
  ));

  results=str.arraypush(results;asserttrue(
    "has loke_announce_toast";
    str.contains(js;"loke_announce_toast")
  ));

  results=str.arraypush(results;asserttrue(
    "toast checks error variant";
    str.contains(js;"variant='error'")
  ));
  results=str.arraypush(results;asserttrue(
    "toast checks warning variant";
    str.contains(js;"variant='warning'")
  ));

  results=str.arraypush(results;asserttrue(
    "has loke_announce_streaming";
    str.contains(js;"loke_announce_streaming")
  ));

  results=str.arraypush(results;asserttrue(
    "streaming throttle is 5000ms";
    str.contains(js;"STREAM_THROTTLE_MS=5000")
  ));

  results=str.arraypush(results;asserttrue(
    "streaming uses Date.now";
    str.contains(js;"Date.now()")
  ));

  results=str.arraypush(results;asserttrue(
    "toast batch threshold is 3";
    str.contains(js;"TOAST_BATCH_THRESHOLD=3")
  ));

  results=str.arraypush(results;asserttrue(
    "toast batch window is 2000ms";
    str.contains(js;"TOAST_BATCH_WINDOW_MS=2000")
  ));

  results=str.arraypush(results;asserttrue(
    "batch announces count of notifications";
    str.contains(js;"new notifications")
  ));

  results=str.arraypush(results;asserttrue(
    "depends on window.loke_announce";
    str.contains(js;"window.loke_announce")
  ));

  results=str.arraypush(results;asserttrue(
    "is IIFE wrapped";
    str.contains(js;"(function(){")
  ));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

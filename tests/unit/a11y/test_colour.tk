
m=tests.unit.a11y.testcolour;

i=colour:loke.platform.a11y.colour;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertapprox(name:$str;got:f32;want:f32;tolerance:f32):$result{
  let diff=got-want;
  if(diff<0.0){ diff=0.0-diff }el{};
  if(diff<=tolerance){ <pass(name) }el{
    <fail(name;str.concat("want~";str.concat(str.fromf32(want);str.concat(" got=";str.fromf32(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();

  results=str.arraypush(results;assertapprox(
    "black on white contrast";
    colour.checkcontrastratio("#000000";"#FFFFFF");
    21.0;
    0.1
  ));

  results=str.arraypush(results;assertapprox(
    "white on white contrast";
    colour.checkcontrastratio("#FFFFFF";"#FFFFFF");
    1.0;
    0.01
  ));

  results=str.arraypush(results;asserttrue(
    "black on white meets AA";
    colour.meetsaa("#000000";"#FFFFFF")
  ));

  results=str.arraypush(results;asserttrue(
    "black on white meets AAA";
    colour.meetsaaa("#000000";"#FFFFFF")
  ));

  results=str.arraypush(results;asserttrue(
    "767676 on white passes AA (boundary)";
    colour.meetsaa("#767676";"#FFFFFF")
  ));

  results=str.arraypush(results;assertfalse(
    "808080 on white fails AA";
    colour.meetsaa("#808080";"#FFFFFF")
  ));

  results=str.arraypush(results;asserttrue(
    "808080 on white meets AA large";
    colour.meetsaalarge("#808080";"#FFFFFF")
  ));

  let rgb=colour.parsehex("#FF0000");
  results=str.arraypush(results;asserttrue("parse_hex red channel";rgb.r=255));
  results=str.arraypush(results;asserttrue("parse_hex green channel";rgb.g=0));
  results=str.arraypush(results;asserttrue("parse_hex blue channel";rgb.b=0));

  let rgb2=colour.parsehex("00FF00");
  results=str.arraypush(results;asserttrue("parse_hex no hash green";rgb2.g=255));

  let r1=colour.checkcontrastratio("#123456";"#ABCDEF");
  let r2=colour.checkcontrastratio("#ABCDEF";"#123456");
  let diff=r1-r2;
  if(diff<0.0){ diff=0.0-diff }el{};
  results=str.arraypush(results;asserttrue("contrast ratio is symmetric";diff<0.01));


  let rgb3=colour.hextorgb("#0000FF");
  results=str.arraypush(results;asserttrue("hex_to_rgb blue r=0";rgb3.r=0));
  results=str.arraypush(results;asserttrue("hex_to_rgb blue g=0";rgb3.g=0));
  results=str.arraypush(results;asserttrue("hex_to_rgb blue b=255";rgb3.b=255));

  results=str.arraypush(results;asserttrue(
    "meets_aa_flexible black on white normal";
    colour.meetsaaflexible("#000000";"#FFFFFF";false)
  ));

  results=str.arraypush(results;asserttrue(
    "meets_aa_flexible 808080 on white large text";
    colour.meetsaaflexible("#808080";"#FFFFFF";true)
  ));

  results=str.arraypush(results;assertfalse(
    "meets_aa_flexible 808080 on white normal fails";
    colour.meetsaaflexible("#808080";"#FFFFFF";false)
  ));

  let redonwhite=colour.checkcontrastratio("#FF0000";"#FFFFFF");
  results=str.arraypush(results;assertapprox("red on white ~4.0";redonwhite;4.0;0.1));

  let blueonwhite=colour.checkcontrastratio("#0000FF";"#FFFFFF");
  results=str.arraypush(results;assertapprox("blue on white ~8.59";blueonwhite;8.59;0.1));

  let vp=colour.validatepair("#000000";"#FFFFFF");
  results=str.arraypush(results;assertapprox("validate_pair ratio black/white";vp.ratio;21.0;0.1));
  results=str.arraypush(results;asserttrue("validate_pair passes_normal";vp.passesnormal));
  results=str.arraypush(results;asserttrue("validate_pair passes_large";vp.passeslarge));

  let vp2=colour.validatepair("#CCCCCC";"#FFFFFF");
  results=str.arraypush(results;assertfalse("validate_pair low contrast fails normal";vp2.passesnormal));

  let hc=colour.highcontrastcss();
  results=str.arraypush(results;asserttrue("high_contrast_css non-empty";str.len(hc)>0));
  results=str.arraypush(results;asserttrue("high_contrast_css has prefers-contrast";str.contains(hc;"prefers-contrast")));
  results=str.arraypush(results;asserttrue("high_contrast_css has Canvas";str.contains(hc;"Canvas")));
  results=str.arraypush(results;asserttrue("high_contrast_css has ButtonFace";str.contains(hc;"ButtonFace")));
  results=str.arraypush(results;asserttrue("high_contrast_css has LinkText";str.contains(hc;"LinkText")));

  let themeresults=colour.validatethemepairs();
  let themecount=str.arraylen(themeresults);
  results=str.arraypush(results;asserttrue("validate_theme_pairs returns entries";themecount>0));

  let darktextbg=colour.checkcontrastratio("#e6edf3";"#0d1117");
  results=str.arraypush(results;asserttrue("dark text on bg passes AA";darktextbg>4.5));

  let lighttextbg=colour.checkcontrastratio("#1f2328";"#ffffff");
  results=str.arraypush(results;asserttrue("light text on bg passes AA";lighttextbg>4.5));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

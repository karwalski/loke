m=test.a11y.colour;

i=t:std.test;
i=str:std.str;
i=col:core.a11y.colour;

(* F10.12-T2 — core.a11y.colour, imported. The legacy checkcontrastratio returned 4.5 for
   every pair, so the first assertions below are the ones that stub could not pass. The
   reference ratios are the WCAG 2.1 formula's: black on white is exactly 21, and #767676
   is the lightest grey that reaches 4.5:1 on white (4.54) while #777777 misses (4.48). *)

f=near(a:f64;b:f64):bool{
  <a-b<0.01 && b-a<0.01
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.assert(near(col.checkcontrastratio("#000000";"#ffffff");21.0);"black on white is 21:1")){pass=pass+1}el{fail=fail+1};
  if(t.assert(near(col.checkcontrastratio("#ffffff";"#000000");21.0);"and white on black is the same, whichever is lighter")){pass=pass+1}el{fail=fail+1};
  if(t.assert(near(col.checkcontrastratio("#123456";"#123456");1.0);"a colour on itself is 1:1, not the stub's 4.5")){pass=pass+1}el{fail=fail+1};
  if(t.assert(near(col.checkcontrastratio("#000";"FFF");21.0);"three-digit and unhashed, upper-case forms parse")){pass=pass+1}el{fail=fail+1};
  if(t.assert(col.meetsaa("#767676";"#ffffff";false);"#767676 on white meets AA for normal text")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!col.meetsaa("#777777";"#ffffff";false);"#777777 on white does not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(col.meetsaa("#777777";"#ffffff";true);"but meets the 3:1 large-text threshold")){pass=pass+1}el{fail=fail+1};
  if(t.assert(col.checkcontrastratio("#ggg000";"#ffffff")==0.0;"an unparseable colour gives 0.0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!col.meetsaa("not a colour";"#ffffff";true);"so it fails even the large-text threshold: never a pass it cannot compute")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!col.meetsaa("#12345";"#ffffff";true);"and so does a five-digit one")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(col.motioncss();"prefers-reduced-motion: reduce");"the motion CSS is gated on prefers-reduced-motion")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(col.focusvisiblecss();"var(--colour-focus-ring");"the focus ring uses the spec's --colour-focus-ring token")){pass=pass+1}el{fail=fail+1};

  <fail
};

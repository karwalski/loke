m=test.a11y.scanner;

i=t:std.test;
i=str:std.str;
i=chk:core.a11y.testing;

(* T13.1 — the scanner cases the backlog row names, against core.a11y.testing. The archived
   test of the same name targeted the legacy module and was never run; its button case only
   checked that `passed` agreed with an empty violation list, because the legacy checker had
   no button rule. The button-name rule here is new in the production checker. Violations
   carry `description`, which is the real field; the row's "message" means that. *)

f=count(r:$a11yresult;rule:str):i64{
  let n=mut.0;
  lp(let i=0;i<r.violations.len;i=i+1){
    if(str.eq(r.violations.get(i).rule;rule)){ n=n+1 }el{}
  };
  <n
};

f=buttons(html:str):i64{
  <count(chk.checkhtml(html;"test://button");"button-name")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let noalt=chk.checkhtml("<p>Logo</p><img src=\"logo.png\">";"test://img-no-alt");
  if(t.assert(count(noalt;"img-alt")==1;"an img with no alt is a violation")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!noalt.passed;"and the page does not pass")){pass=pass+1}el{fail=fail+1};

  let allalt=chk.checkhtml("<img src=\"a.png\" alt=\"A chart\"><img src=\"b.png\" alt=\"\"><img src=\"c.png\" alt=\"Logo\">";"test://img-alt");
  if(t.assert(allalt.violations.len==0;"images that all carry alt, empty alt included, give no violations")){pass=pass+1}el{fail=fail+1};

  if(t.assert(buttons("<button></button>")==1;"a button with no label is a violation")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button class=\"icon\"> <span class=\"x\"></span> </button>")==1;"whitespace and empty child elements do not name a button")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button aria-label=\"\"></button><button title=''></button>")==2;"an empty aria-label or title does not name a button")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button><img src=\"x.png\"></button>")==1;"an image with no alt inside does not name a button")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<p>Text</p><button>")==1;"an unclosed, empty button at the end of the page is a violation")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button></button><button>Save</button><button></button>")==2;"every unlabelled button is found, not only the first")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button aria-label=\"Close dialog\">×</button>")==0;"an icon button with aria-label is named")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button aria-label=\"Close\"></button>")==0;"aria-label alone names a button")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button aria-labelledby=\"h\"></button><button title=\"Help\"></button>")==0;"aria-labelledby or a title names a button")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button type=\"submit\">Send</button>")==0;"text content names a button")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button><span>Save draft</span></button>")==0;"text inside a child element names a button")){pass=pass+1}el{fail=fail+1};
  if(t.assert(buttons("<button><img src=\"s.png\" alt=\"Search\"></button>")==0;"an image with alt inside names a button")){pass=pass+1}el{fail=fail+1};

  let page="<header><nav aria-label=\"Main\"><a href=\"/\">Home</a></nav></header><main id=\"main-content\"><h1>Report</h1><img src=\"chart.png\" alt=\"Monthly totals\"><form><label for=\"q\">Search</label><input id=\"q\" type=\"search\"><button type=\"submit\">Search</button></form></main><footer><p>loke</p></footer>";
  let clean=chk.checkhtml(page;"test://semantic");
  if(t.assert(clean.violations.len==0;"well-formed semantic HTML gives zero violations")){pass=pass+1}el{fail=fail+1};
  if(t.assert(chk.assertnoviolations(clean);"assertnoviolations is true for clean HTML")){pass=pass+1}el{fail=fail+1};

  let dirty=chk.checkhtml("<img src=\"photo.png\"><button></button>";"test://dirty");
  if(t.assert(!chk.assertnoviolations(dirty);"assertnoviolations is false when there are violations")){pass=pass+1}el{fail=fail+1};

  let json=chk.resulttojson(dirty);
  if(t.assert(str.contains(json;"\"violations\":[{\"rule\":\"img-alt\"") && str.contains(json;"{\"rule\":\"button-name\"");"resulttojson carries the violations array, both entries in it")){pass=pass+1}el{fail=fail+1};

  if(t.assert(dirty.violations.len==2;"the dirty page has its two violations")){pass=pass+1}el{fail=fail+1};
  (* The last violation, not index 1: on a checker that misses the button there is only one,
     and the assertions below should fail rather than the test stop on an index error. *)
  let v=dirty.violations.get(dirty.violations.len-1);
  if(t.asserteq(v.element;"<button>";"the button violation names its element")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(v.description;"Button element has no accessible name";"and carries a description")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"element\":\"<button>\",\"description\":\"Button element has no accessible name\"");"the JSON carries each violation's element and description")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.shared.origin;

i=t:std.test;
i=org:shared.origin;

(* GA2.6. The rule every state-changing handler applies before doing anything. The
   header value is tested directly because a test cannot construct an http request
   (T-16). scripts/smoke_serve.sh checks the same rule through the real server. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* No Origin: curl, the CLI, a test. Not a browser acting for a page. *)
  if(t.assert(!org.originrefused("");"a request with no Origin header is allowed")){pass=pass+1}el{fail=fail+1};

  (* loke's own pages and moke, on any port. *)
  if(t.assert(!org.originrefused("http://127.0.0.1:11430");"loke's own UI origin is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!org.originrefused("http://localhost:11432");"moke on localhost is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!org.originrefused("http://[::1]:11430");"IPv6 loopback is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!org.originrefused("http://127.0.0.1");"a loopback origin without a port is allowed")){pass=pass+1}el{fail=fail+1};

  (* The attack this exists for. *)
  if(t.assert(org.originrefused("https://evil.example");"a foreign origin is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.originrefused("null");"the null origin of a sandboxed frame or file:// page is refused")){pass=pass+1}el{fail=fail+1};

  (* Prefix tricks. Each of these starts with an allowed string and is not loopback. *)
  if(t.assert(org.originrefused("http://127.0.0.1.evil.example");"a host that merely starts with 127.0.0.1 is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.originrefused("http://localhost.evil.example:11430");"a host that merely starts with localhost is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.originrefused("http://127.0.0.1:11430@evil.example");"userinfo smuggling after the port is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.originrefused("http://127.0.0.1:");"a colon with no port is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.originrefused("https://127.0.0.1:11430");"https on loopback is refused, because loke serves http and this is not its origin")){pass=pass+1}el{fail=fail+1};

  (* GA2.7. Host, for DNS rebinding: the page is same-origin, but Host still names it. *)
  if(t.assert(!org.hostrefused("");"a request with no Host header is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!org.hostrefused("127.0.0.1:11430");"loke's own host and port is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!org.hostrefused("localhost:11432");"localhost with a port is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!org.hostrefused("[::1]:11430");"IPv6 loopback is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!org.hostrefused("127.0.0.1");"a loopback host without a port is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.hostrefused("rebind.example:11430");"a rebound name resolving to loopback is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.hostrefused("127.0.0.1.rebind.example");"a name that merely starts with 127.0.0.1 is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(org.hostrefused("localhostile.example");"a name that merely starts with localhost is refused")){pass=pass+1}el{fail=fail+1};

  <fail
};

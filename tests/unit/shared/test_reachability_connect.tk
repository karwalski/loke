m=test.shared.reachabilityconnect;

i=t:std.test;
i=process:std.process;
i=reach:shared.reachability;

(* Two defects, found getting moke to reach loke at all.

   process.wait is declared as a plain i32, not a result. Every `mt process.wait(h) {...}` in
   the tree leaned on T-33's "a zero word is the error" heuristic, so EXIT CODE 0 took the
   error arm. The installer reported failure on every successful step, `uname` answered
   "unknown" platform, and the CLI's runcmd reported 127 for commands that had succeeded.

   net.portavailable answered "free" for a port loke was listening on, because toke's server
   binds with SO_REUSEPORT. shared.reachability now confirms "free" with a real connect. *)

f=exitcodeof(argv:@str):i64{
  let h=mt process.spawn(argv) {
    $ok:h h;
    $err:e 0
  };
  if(h==0){ <0-2 }el{};
  <process.wait(h) as i64
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.assert(exitcodeof(@("true"))==0;"a command that succeeds reads as exit code 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(exitcodeof(@("false"))==1;"and one that fails reads as 1")){pass=pass+1}el{fail=fail+1};

  if(t.assert(!reach.connects(59433);"nothing accepts on an unused port")){pass=pass+1}el{fail=fail+1};
  (* A listener from `nc -l`, not std.net.listen, which segfaults when called (another
     untyped gen:"abi" function). It needs a moment to bind, hence the short retry. *)
  let l=mt process.spawn(@("nc";"-l";"59433")) {
    $ok:h h;
    $err:e 0
  };
  let seen=mut.false;
  lp(let k=0;k<20 && !seen;k=k+1){
    if(reach.connects(59433)){ seen=true }el{}
  };
  if(t.assert(seen;"a real listener is seen by connecting")){pass=pass+1}el{fail=fail+1};
  if(l!=0){ process.kill(l); process.wait(l); }el{};

  <fail
};

m=test.shared.jsonobjtyped;

i=t:std.test;
i=str:std.str;
i=json:std.json;
i=jx:shared.jsonobj;
i=ty:shared.types;

(* LS1.1w — shared.jsonobj's typed replacements for std.json's untyped ABI helpers, against
   the REAL module: keys (for json.keys / json.entries), arrayof (json.parsearray), strelems
   and shared.types.jsonstrarray (json.parsearray over json.getval), has and isnull
   (json.has / json.haskey / json.isnullkey), and rawvalue without its json.has guard.

   Each assertion is on a value a caller acts on: the keys a template substitutes, the
   entities a top-level Presidio or NER reply holds, the model names a companion reports. *)

f=decode(body:str):$json{
  <mt json.dec(body) {
    $ok:o o;
    $jsonerr:e jx.emptyobj()
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let o=decode("{\"a\":\"x, \\\"y\\\": z\",\"b\":{\"inner\":1,\"c\":[\"d\"]},\"e\":[1,{\"f\":2}],\"n\":null,\"k\\\"q\":0}");

  let ks=jx.keys(o);
  if(t.assert(ks.len==5;"keys: five top-level keys, none from the nested object or array")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.len==5 && str.eq(ks.get(0);"a") && str.eq(ks.get(1);"b") && str.eq(ks.get(2);"e") && str.eq(ks.get(3);"n");"keys: in document order; a string VALUE holding a comma and a colon is not a key")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.len==5 && str.eq(ks.get(4);"k\"q");"keys: an escaped quote in a key is decoded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(jx.keys(decode("{}")).len==0;"keys: an empty object has none")){pass=pass+1}el{fail=fail+1};

  if(t.assert(jx.has(o;"n") && jx.has(o;"b");"has: a present key, including one whose value is null")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!jx.has(o;"zz");"has: an absent key is absent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(jx.isnull(o;"n") && !jx.isnull(o;"a") && !jx.isnull(o;"zz");"isnull: only a present null")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(jx.rawvalue(o;"zz"))==0 && str.eq(jx.rawvalue(o;"n");"null");"rawvalue: \"\" when absent, the text when present")){pass=pass+1}el{fail=fail+1};

  let ents=jx.arrayof("[{\"entity_type\":\"PERSON\",\"start\":0},{\"entity_type\":\"EMAIL_ADDRESS\",\"start\":9}]");
  if(t.assert(ents.len==2;"arrayof: both elements of a top-level array")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ents.len==2 && str.eq(jx.strvalue(ents.get(1);"entity_type";"");"EMAIL_ADDRESS");"arrayof: each element is a typed object its fields can be read from")){pass=pass+1}el{fail=fail+1};
  if(t.assert(jx.arrayof("[]").len==0 && jx.arrayof("{\"a\":1}").len==0 && jx.arrayof("not json").len==0;"arrayof: none for [], for an object and for text that is not JSON")){pass=pass+1}el{fail=fail+1};

  let models=ty.jsonstrarray(decode("{\"models\":[\"llama3\",\"qwen \\\"2.5\\\"\",3]}");"models");
  if(t.assert(models.len==2;"jsonstrarray: the string elements, and not the number")){pass=pass+1}el{fail=fail+1};
  if(t.assert(models.len==2 && str.eq(models.get(0);"llama3") && str.eq(models.get(1);"qwen \"2.5\"");"jsonstrarray: each element decoded, an escaped quote included")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ty.jsonstrarray(o;"zz").len==0;"jsonstrarray: none for an absent key")){pass=pass+1}el{fail=fail+1};

  <fail
};

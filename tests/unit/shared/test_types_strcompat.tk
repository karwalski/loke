m=test.shared.typesstrcompat;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;

(* F10.16 — the two stdlib stand-ins that are still needed at toke 3.1.0, pinned.

   `str.between` has never existed in toke's std.str (docs/archive/linker-gaps.md lists it as
   a gap that composes from `indexof` and `slice`), and it is still absent at 3.1.0. The call
   sites in privacy/content.tk and cli/sign.tk were written against its intended meaning: the
   text after the FIRST `open`, up to the first `close` that follows it, and "" when either is
   missing. `shared.types.strbetween` is that composition, and these assertions are its
   contract, because a fragment of markup handed back on a miss would read as a page title.

   `strstripregion` stands in for a non-greedy regex. toke 3.1.0's engine now rejects `*?`
   outright (E4075 for a literal, RT008 for a computed pattern) instead of silently matching
   nothing, so `<script.*?</script>` is still not writable and the index walk stays. Its
   contract is the one F10.16 claimed for it: case-insensitive on the delimiters, every
   region removed, and an unclosed region left alone rather than eating the rest of the
   document.

   Neither helper's callers has an importer today (content.tk is exercised by
   tests/unit/privacy/test_content.tk; cli/sign.tk by nothing), so this pins the helpers, not
   a live path. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── strbetween ──────────────────────────────────────────────────────────────*)
  if(t.asserteq(sh.strbetween("a<title>Home</title>b";"<title>";"</title>");"Home";"between returns the text between the two delimiters")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strbetween("x[1]y[2]";"[";"]");"1";"between takes the FIRST open and the first close after it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strbetween("]a[b]";"[";"]");"b";"between ignores a close that comes before the open")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strbetween("abc";"[";"]");"";"between is empty when the open delimiter is missing")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strbetween("]a[bc";"[";"]");"";"between is empty when no close follows the open, even if one precedes it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strbetween("[]";"[";"]");"";"between of an empty region is empty")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strbetween("https://x.test/p/q";"://";"/");"x.test";"between extracts a URL's host, as content.summary uses it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strbetween("https://x.test";"://";"/");"";"and a URL with no path yields empty, which content.summary falls back from")){pass=pass+1}el{fail=fail+1};

  (* ── strstripregion ──────────────────────────────────────────────────────────*)
  if(t.asserteq(sh.strstripregion("a<script>x</script>b";"<script";"</script>");"ab";"stripregion removes the region and both delimiters")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strstripregion("A<SCRIPT>x</Script>B";"<script";"</script>");"AB";"stripregion matches the delimiters case-insensitively and keeps the case of the rest")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strstripregion("a<script>1</script>b<script>2</script>c";"<script";"</script>");"abc";"stripregion removes every region, not only the first")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strstripregion("a<script>1</script>b<script>2";"<script";"</script>");"ab<script>2";"stripregion leaves an unclosed region alone rather than eating the rest")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sh.strstripregion("plain text";"<script";"</script>");"plain text";"stripregion leaves text with no region unchanged")){pass=pass+1}el{fail=fail+1};

  <fail
};

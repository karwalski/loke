   SPDX-License-Identifier: Apache-2.0 *)

m=test.shared.confignumbers;

i=t:std.test;
i=str:std.str;
i=cfg:shared.config;

(* F3b.16. privacy.consensus_threshold and privacy.privacy_filter_threshold, read by
   shared.config.fromtext (the production reader: loaded() calls it on the file's text) and
   judged by shared.config.privacyerror, which core.privacy.layerconfig.resolve returns as its
   error so the pipeline refuses the run.

   Before F3b.16 both were read with toml.str alone: an unquoted 0.7 read as "" and the 0.5
   default applied with no warning. Now a quoted string, an unquoted float and an integer are
   all read, and a value that is set and cannot be used is an error, never the default. *)

f=ct(text:str):str{ <cfg.fromtext(text).consensusthreshold };
f=pt(text:str):str{ <cfg.fromtext(text).pfthreshold };
f=err(text:str):str{ <cfg.privacyerror(text) };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── Read: each form a user may write ──────────────────────────────────── *)
  if(t.asserteq(ct("[privacy]\nconsensus_threshold = \"0.7\"\n");"0.7";"a quoted consensus_threshold is read")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ct("[privacy]\nconsensus_threshold = 0.7\n");"0.7";"an unquoted float consensus_threshold is read")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ct("[privacy]\nconsensus_threshold = 0.7   # stricter\n");"0.7";"an unquoted float with a trailing comment is read without the comment")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ct("[privacy]\nconsensus_threshold = 1\n");"1";"an integer consensus_threshold is read")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ct("[privacy]\nconsensus_threshold = 0\n");"0";"an integer 0 is read as 0, not as unset")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ct("privacy.consensus_threshold = 0.8\n");"0.8";"a top-level dotted unquoted float is read")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(pt("[privacy]\nprivacy_filter_threshold = 0.6\n");"0.6";"an unquoted float privacy_filter_threshold is read")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(pt("[privacy]\nprivacy_filter_threshold = \"0.60\"\n");"0.60";"a quoted privacy_filter_threshold is read as written")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ct("[routing]\nstrategy = \"local-first\"\n");"";"an absent consensus_threshold is unset")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ct("[privacy]\nconsensus_strategy = \"majority\"\n[routing]\nconsensus_threshold = 0.9\n");"";"a consensus_threshold under another table is not read as the privacy one")){pass=pass+1}el{fail=fail+1};

  (* ── Usable values are not errors ──────────────────────────────────────── *)
  if(t.asserteq(err("");"";"an empty config.toml has no threshold error")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_strategy = \"majority\"\n");"";"nor one that sets no threshold")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[[privacy.layers]]\nid = \"presidio\"\nconfidence_threshold = 0.95\n");"";"nor one whose only threshold is a layer's confidence_threshold")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = \"0.7\"\n");"";"a quoted 0.7 is usable")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = 0.7\n");"";"an unquoted 0.7 is usable")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = 1\nprivacy_filter_threshold = 0\n");"";"the integers 1 and 0 are usable")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nprivacy_filter_threshold = 1.000\n");"";"1.000 is usable")){pass=pass+1}el{fail=fail+1};

  (* ── Set and unusable: an error naming the key, never the default ──────── *)
  if(t.asserteq(err("[privacy]\nconsensus_threshold = 1.5\n");"privacy.consensus_threshold = 1.5 is not a number from 0 to 1";"an out-of-range unquoted 1.5 is an error")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = \"1.5\"\n");"privacy.consensus_threshold = 1.5 is not a number from 0 to 1";"so is a quoted 1.5")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = 2\n");"privacy.consensus_threshold = 2 is not a number from 0 to 1";"so is the integer 2")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = -0.1\n");"privacy.consensus_threshold = -0.1 is not a number from 0 to 1";"so is a negative")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = 7e-1\n");"privacy.consensus_threshold = 7e-1 is not a number from 0 to 1";"so is an exponent")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = \"abc\"\n");"privacy.consensus_threshold = abc is not a number from 0 to 1";"so is a word")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = \"\"\n");"privacy.consensus_threshold is set in a form loke cannot read; write it on its own line under [privacy], e.g. consensus_threshold = 0.5";"so is an empty string")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = true\n");"privacy.consensus_threshold = true is not a number from 0 to 1";"so is a boolean (the wrong type)")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("privacy = { consensus_threshold = 0.7 }\n");"privacy.consensus_threshold is set in a form loke cannot read; write it on its own line under [privacy], e.g. consensus_threshold = 0.5";"an inline table is set but not readable, so it is an error")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nprivacy_filter_threshold = \"high\"\n");"privacy.privacy_filter_threshold = high is not a number from 0 to 1";"privacy_filter_threshold is judged the same way")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy]\nconsensus_threshold = 0.7\nprivacy_filter_threshold = 3\n");"privacy.privacy_filter_threshold = 3 is not a number from 0 to 1";"one bad threshold beside a good one is still an error")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(err("[privacy\nconsensus_threshold = 0.7\n");"config.toml is not valid TOML, so the privacy.consensus_threshold it sets cannot be read";"a threshold in a file that does not parse is an error, not the default")){pass=pass+1}el{fail=fail+1};

  <fail
};

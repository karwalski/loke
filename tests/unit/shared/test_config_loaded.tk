m=test.shared.configloaded;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=cfg:shared.config;
i=ty:shared.types;

(* X8.8. shared.config.loaded is how the MCP broker (mcpbroker.main) reads its configuration.

   The broker used to match cfg.loadconfig itself, and with no config.toml the match took the
   success arm on the error payload (T-18), so the broker's datadir, presidiourl and ollamaurl
   were fields of a $lokeerr. mcpbroker.main cannot be imported here (its main is kept off every
   archive), so the broker now calls this resolver and this file asserts the three cases it has
   to get right, under the throwaway HOME run_tests.sh gives every test:

     no file           the defaults, field by field, not something read off an error
     a file that is    the defaults too. Before toke 3.1.0 this case was undetectable through
     not TOML          the user-sum result; loaded() matches std.toml's own result instead
     a real file       its values, so the fallback is not simply always taken

   The order matters: the missing-file case runs before anything is written. *)

f=dir():str{ <ty.lokedir() };

f=writeconfig(body:str):bool{
  let made=mt file.mkdir(dir()) {$ok:okv okv;$err:errv false};
  let wrote=mt file.write(ty.configpath();body) {$ok:okv okv;$err:errv false};
  <wrote
};

f=missing():bool{
  let d=cfg.defaultconfig();
  let c=cfg.loaded();
  let a=t.assert(!file.exists(ty.configpath());"precondition: no config.toml under the test HOME");
  let b=t.assert(str.eq(c.datadir;d.datadir);"no config.toml: datadir is the default");
  let c2=t.assert(str.eq(c.presidiourl;d.presidiourl);"no config.toml: presidiourl is the default");
  let c3=t.assert(str.eq(c.ollamaurl;d.ollamaurl);"no config.toml: ollamaurl is the default");
  <a && b && c2 && c3
};

f=unparseable():bool{
  let d=cfg.defaultconfig();
  let w=t.assert(writeconfig("this is [not toml");"wrote an unparseable config.toml");
  let c=cfg.loaded();
  let b=t.assert(str.eq(c.datadir;d.datadir);"unparseable config.toml: datadir is the default");
  let c2=t.assert(str.eq(c.ollamaurl;d.ollamaurl);"unparseable config.toml: ollamaurl is the default");
  <w && b && c2
};

f=real():bool{
  let w=t.assert(writeconfig("[providers]\nollama_url = \"http://127.0.0.1:11999\"\n[privacy]\npresidio_url = \"http://127.0.0.1:5999\"\n");"wrote a real config.toml");
  let c=cfg.loaded();
  let b=t.assert(str.eq(c.ollamaurl;"http://127.0.0.1:11999");"a real config.toml: ollamaurl is read from it");
  let c2=t.assert(str.eq(c.presidiourl;"http://127.0.0.1:5999");"a real config.toml: presidiourl is read from it");
  let c3=t.assert(str.eq(c.datadir;cfg.defaultconfig().datadir);"a real config.toml: an absent key keeps its default");
  <w && b && c2 && c3
};

f=main():i64{
  let fails=mut.0;
  if(missing()){}el{fails=fails+1};
  if(unparseable()){}el{fails=fails+1};
  if(real()){}el{fails=fails+1};
  <fails
};

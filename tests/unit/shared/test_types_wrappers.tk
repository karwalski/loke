m=test.shared.typeswrappers;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;

(* The eight string wrappers in shared.types returned NOTHING for as long as they existed.

   Each body was a bare expression with no `<`, so toke evaluated it and threw the result
   away. That is the same class as T-19's trailing bare `mt`, with a plain call instead —
   which no sweep in this repository was looking for, and which no diagnostic reports.
   Measured before the fix: strlen("abcdef")=0, streq("a";"a")=false, strconcat("ab";"cd")="",
   strcontains("abc";"b")=false, and strlower/strslice/i32tostr/f64tostr all "".

   `strisempty`, five lines away in the same file, has its `<` and always worked — which is
   exactly why a skim found nothing.

   It was not decorative. core/router/escalation.tk was entirely dead: its ladder never
   matched, and `strlen(x) < 100` was always true because strlen returned 0. eval/advisor.tk
   fell to its default on all four branches; eval/bench.tk scored every case 0.

   This file exists so that cannot happen again quietly. A wrapper in shared.types is
   visible to every module in the project, so a silent no-op here is a silent no-op
   everywhere — which makes these the cheapest assertions in the repository to justify. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  if(t.assert(sh.strlen("abcdef")==6;"strlen returns the length, not 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sh.strlen("")==0;"strlen of the empty string is 0 — and for the right reason")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sh.streq("a";"a");"streq is true for equal strings")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sh.streq("a";"b");"streq is false for different strings")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(sh.strconcat("ab";"cd");"abcd");"strconcat joins both arguments")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sh.strcontains("abc";"b");"strcontains finds a present substring")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sh.strcontains("abc";"z");"strcontains rejects an absent substring")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(sh.strlower("AB");"ab");"strlower lowercases")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(sh.strslice("abcd";1;3);"bc");"strslice returns the slice")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(sh.i32tostr(42 as i32);"42");"i32tostr renders the number")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(sh.f64tostr(1.5))>0;"f64tostr renders something rather than nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sh.strisempty("");"strisempty is true for the empty string (the control — this one always worked)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!sh.strisempty("x");"strisempty is false for a non-empty string")){pass=pass+1}el{fail=fail+1};

  <fail
};

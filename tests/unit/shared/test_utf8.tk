m=test.shared.utf8;

i=t:std.test;
i=str:std.str;
i=u8:shared.utf8;

(* F10.49 — shared.utf8, the one byte-limited cut every truncation uses.

   `boundary` moves a byte limit back to the last complete character at or before it, and
   `prefix` cuts to that boundary. Each caller has its own test of its own output
   (tests/unit/governance/test_trace_truncate.tk, memory/test_search.tk,
   models/test_queue.tk, optimiser/test_toon.tk, memory/test_aaak.tk); this one pins the
   helper's edges, which the callers do not reach: a limit of 0, a negative limit, a limit
   past the end, and each width of character. `valid` is the structural check those tests
   use, so it is shown here to reject what it must reject. *)

f=repeat(s:str;n:i64):str{
  let out=mut."";
  lp(let i=0;i<n;i=i+1){ out="\(out)\(s)" };
  <out
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let jp="日";
  let emoji="😀";
  let e2="é";

  (* ── valid: the checker first, or the assertions below prove nothing ──────────*)
  if(t.assert(u8.valid("plain ascii");"ASCII is valid UTF-8")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid("\(jp)\(emoji)\(e2)");"so are complete 3-, 4- and 2-byte characters")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!u8.valid(str.slice(jp;0;2));"a 3-byte character cut after 2 bytes is NOT valid")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!u8.valid(str.slice(emoji;0;3));"nor is a 4-byte character cut after 3")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!u8.valid(str.slice(e2;0;1));"nor a 2-byte character cut after its lead byte")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!u8.valid(str.slice(emoji;1;4));"nor continuation bytes with no lead byte")){pass=pass+1}el{fail=fail+1};

  (* ── boundary ────────────────────────────────────────────────────────────────*)
  let cjk=repeat(jp;3);
  if(t.assert(u8.boundary(cjk;9)==9;"a limit equal to the length is the length")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary(cjk;50)==9;"a limit past the end is the length, not the limit")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary(cjk;0)==0;"a limit of 0 is 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary(cjk;0-5)==0;"and a negative limit is 0, not a negative cut")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary(cjk;6)==6;"a limit on a character boundary is kept")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary(cjk;7)==6;"one byte into a 3-byte character moves back one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary(cjk;8)==6;"two bytes into it moves back two")){pass=pass+1}el{fail=fail+1};
  let emo=repeat(emoji;2);
  if(t.assert(u8.boundary(emo;7)==4;"three bytes into a 4-byte character moves back three")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary(emo;3)==0;"and inside the first character it moves to 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.boundary("a\(e2)";2)==1;"one byte into a 2-byte character moves back one")){pass=pass+1}el{fail=fail+1};

  (* ── prefix ──────────────────────────────────────────────────────────────────*)
  if(t.asserteq(u8.prefix("abcdef";4);"abcd";"ASCII is cut at exactly the limit")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(u8.prefix("abc";4);"abc";"a string under the limit is returned whole")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(u8.prefix(cjk;8);repeat(jp;2);"a 3-byte character crossing the limit is dropped whole")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(u8.prefix(emo;7);emoji;"so is a 4-byte one")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(u8.prefix("ab\(e2)";3);"ab";"and a 2-byte one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(u8.prefix(cjk;8));"and what is left is valid UTF-8")){pass=pass+1}el{fail=fail+1};

  <fail
};


m=tests.unit.cache.testsemanticcrypto;

i=cache:core.cache.semantic;
i=str:std.string;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{ <fail(name;"want=" + want + " got=" + got) };
};

f=asserttrue(name:$str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;val:bool):$result{
  if(!$val){ <pass(name) }el{ <fail(name;"expected false") };
};

f=asserteqi32(name:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{ <fail(name;"want=" + str.fromi32(want) + " got=" + str.fromi32(got)) };
};

f=logresult(r:$result){
  if(r.passed){ log.info("PASS " + r.name) }el{ log.error("FAIL " + r.name + ": " + r.message) };
};

f=testmakekeylength():$result{
  let key=cache.makekey("hello world");
  let len=str.len(key);
  if(len = 64){
    <pass("make_key.length")
  }el{
    <fail("make_key.length";"expected 64 hex chars, got " + str.fromi32(len))
  };
};

f=testmakekeydeterministic():$result{
  let k1=cache.makekey("test prompt");
  let k2=cache.makekey("test prompt");
  <asserteq("make_key.deterministic";k1;k2)
};

f=testmakekeydifferent():$result{
  let k1=cache.makekey("prompt A");
  let k2=cache.makekey("prompt B");
  if(str.eq(k1;k2)){
    <fail("make_key.different";"expected different hashes for different inputs")
  }el{
    <pass("make_key.different")
  };
};

f=testdefaultconfig():$result{
  let cfg=cache.defaultconfig();
  <asserteqi32("default_config.max_entries";cfg.maxentries;10000)
};

f=testnewstore():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let r1=asserteqi32("new_store.entries.len";store.entries.len();0);
  if(!$r1.passed){ <r1 }el{};
  let r2=asserteqi32("new_store.hits";store.hits;0);
  if(!$r2.passed){ <r2 }el{};
  <asserteqi32("new_store.misses";store.misses;0)
};

f=teststoreentry():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let embedding=@(0.1;0.2;0.3);
  let updated=cache.storeentry(store;"test prompt";"test response";embedding);
  <asserteqi32("store_entry.entries.len";updated.entries.len();1)
};

f=teststoreentryhash():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let embedding=@(0.1;0.2;0.3);
  let updated=cache.storeentry(store;"test prompt";"test response";embedding);
  let entry=updated.entries.get(0);
  let expectedkey=cache.makekey("test prompt");
  <asserteq("store_entry.key_hash";entry.keyhash;expectedkey)
};

f=testcosinesimidentical():$result{
  let a=@(1.0;0.0;0.0);
  let sim=cache.cosinesim(a;a);
  if(sim >= 0.99){
    <pass("cosine_sim.identical")
  }el{
    <fail("cosine_sim.identical";"expected ~1.0, got " + str.fromf32(sim))
  };
};

f=testcosinesimempty():$result{
  let a:@(f32)=@();
  let b:@(f32)=@();
  let sim=cache.cosinesim(a;b);
  if(sim = 0.0){
    <pass("cosine_sim.empty")
  }el{
    <fail("cosine_sim.empty";"expected 0.0")
  };
};

f=teststats():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let s=cache.stats(store);
  let r1=asserttrue("stats.contains_hits";str.contains(s;"\"hits\":0"));
  if(!$r1.passed){ <r1 }el{};
  <asserttrue("stats.contains_entries";str.contains(s;"\"entries\":0"))
};

f=testevictexpired():$result{
  let cfg=cache.defaultconfig();
  let store=cache.newstore(cfg);
  let embedding=@(0.5;0.5;0.5);
  let store=cache.storeentry(store;"p1";"r1";embedding);
  let evicted=cache.evictexpired(store);
  <asserteqi32("evict_expired.entries.len";evicted.entries.len();1)
};

f=runall():@$result{
  let results=@();
  results.push(testmakekeylength());
  results.push(testmakekeydeterministic());
  results.push(testmakekeydifferent());
  results.push(testdefaultconfig());
  results.push(testnewstore());
  results.push(teststoreentry());
  results.push(teststoreentryhash());
  results.push(testcosinesimidentical());
  results.push(testcosinesimempty());
  results.push(teststats());
  results.push(testevictexpired());
  results.each(r{ logresult(r) });
  <results
};

m=test.mcpbroker.permissions;

i=t:std.test;
i=str:std.str;
i=pm:mcpbroker.permissions;

(* X4b.9: the MCP broker's per-server tool permissions, against the real module. The
   decision is: a denied tool is refused; with no allow-list everything else is allowed;
   with an allow-list only the tools on it are allowed. A server prefixes its tool names,
   so `fs_read` is the tool `read` on the `fs_` server. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let toml="[mcp.servers.fs]\nallowed_tools = [\"read\", \"list\"]\ndenied_tools = [\"delete\"]\nmax_requests_per_min = 30\nprivacy_required = true\n\n[mcp.servers.web]\ndenied_tools = [\"post\"]\n";
  let cfg=mt pm.parsetomlpermissions(toml) {$ok:c c; $err:e pm.parsetomlpermissions("")};
  if(t.assert(cfg.permissions.len==2;"both server sections are parsed")){pass=pass+1}el{fail=fail+1};
  let fs=pm.findpermission(cfg;"fs");
  if(t.assert(pm.haspermission(fs);"the fs server has a permission entry")){pass=pass+1}el{fail=fail+1};
  if(t.assert(fs.maxrequestspermin==30 as i32;"its rate limit is read")){pass=pass+1}el{fail=fail+1};
  if(t.assert(fs.privacyrequired;"and its privacy requirement")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pm.haspermission(pm.findpermission(cfg;"nope"));"an unknown server has none")){pass=pass+1}el{fail=fail+1};

  if(t.assert(pm.checkpermission(fs;"fs_read";"fs_");"an allow-listed tool is allowed, with its server prefix stripped")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pm.checkpermission(fs;"fs_write";"fs_");"a tool not on the allow-list is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pm.checkpermission(fs;"fs_delete";"fs_");"a denied tool is refused")){pass=pass+1}el{fail=fail+1};
  let web=pm.findpermission(cfg;"web");
  if(t.assert(pm.checkpermission(web;"web_get";"web_");"with no allow-list, an undenied tool is allowed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pm.checkpermission(web;"web_post";"web_");"and a denied one is still refused")){pass=pass+1}el{fail=fail+1};
  <fail
};

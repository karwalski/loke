



m=tests.unit.mcpbroker.testconfig;

i=cfg:loke.mcpbroker.config;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if !$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if got == want{ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  let server=cfg.newserver("my_server";"stdio");
  results=str.arraypush(results;asserteq("new_server name field";"my_server";server.name));
  results=str.arraypush(results;asserteq("new_server transport field";"stdio";server.transport));

  
  results=str.arraypush(results;asserttrue("empty allowlist allows any tool";cfg.istoolallowed(server;"allowed_tool")));

  
  let serverwithallow=cfg.$serverconfig{
    name:"my_server";
    transport:"stdio";
    command:"";
    url:"";
    env:@();
    toolallowlist:@("read_file");
    tooldenylist:@();
    maxcostpercall:0.0;
    requireapproval:false;
    enabled:true
  };
  results=str.arraypush(results;assertfalse("allowlist blocks unlisted tool";cfg.istoolallowed(serverwithallow;"write_file")));

  
  results=str.arraypush(results;asserttrue("allowlist permits listed tool";cfg.istoolallowed(serverwithallow;"read_file")));

  
  let serverwithdeny=cfg.$serverconfig{
    name:"my_server";
    transport:"stdio";
    command:"";
    url:"";
    env:@();
    toolallowlist:@();
    tooldenylist:@("dangerous");
    maxcostpercall:0.0;
    requireapproval:false;
    enabled:true
  };
  results=str.arraypush(results;assertfalse("denylist blocks denied tool";cfg.istoolallowed(serverwithdeny;"dangerous")));

  
  results=str.arraypush(results;asserttrue("denylist permits non-denied tool";cfg.istoolallowed(serverwithdeny;"safe_tool")));

  
  let jsonout=cfg.tojson(server);
  results=str.arraypush(results;asserttrue("to_json contains name";str.contains(jsonout;"name")));
  results=str.arraypush(results;asserttrue("to_json contains transport";str.contains(jsonout;"transport")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if i >= n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if !$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};

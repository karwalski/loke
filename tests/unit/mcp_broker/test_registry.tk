



m=tests.unit.mcpbroker.testregistry;

i=reg:loke.mcpbroker.registry;
i=cfg:loke.mcpbroker.config;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  
  reg.gservers=@();

  let results = @($result);

  
  let initial=reg.listservers();
  let initiallen=str.arraylen(initial);
  results=str.arraypush(results;assertinteq("list_servers empty on fresh state";initiallen;0));

  
  let serverconfig=cfg.newserver("my_server";"stdio");
  reg.register(serverconfig);
  let afterregister=reg.listservers();
  let afterlen=str.arraylen(afterregister);
  results=str.arraypush(results;assertinteq("list_servers has 1 entry after register";afterlen;1));

  
  let foundopt=reg.getserver("my_server");
  mt foundopt {
    $some:s{
      results=str.arraypush(results;asserteq("get_server returns correct name";"my_server";s.config.name))
    };
    $none:{
      results=str.arraypush(results;fail("get_server known name returns some";"returned none"))
    }
  };

  
  let unknownopt=reg.getserver("unknown");
  mt unknownopt {
    $some:s{
      results=str.arraypush(results;fail("get_server unknown returns none";"returned some"))
    };
    $none:{
      results=str.arraypush(results;pass("get_server unknown returns none"))
    }
  };

  
  reg.setstatus("my_server";"connected";"");
  let afterstatusopt=reg.getserver("my_server");
  mt afterstatusopt {
    $some:s{
      results=str.arraypush(results;asserteq("set_status updates status";"connected";s.status))
    };
    $none:{
      results=str.arraypush(results;fail("get_server after set_status";"returned none"))
    }
  };

  
  let tools=@i64;
  reg.settools("my_server";tools);
  let alltools=reg.listtools();
  let toolslen=str.arraylen(alltools);
  results=str.arraypush(results;asserttrue("list_tools returns tools after set_tools";toolslen > 1));

  
  if(toolslen > 1){
    let firsttool=str.arrayget(alltools;0);
    results=str.arraypush(results;asserttrue("tool name prefixed with server name";str.contains(firsttool.name;"my_server.")))
  }{
    results=str.arraypush(results;fail("tool prefix check skipped";"no tools returned"))
  };

  
  let finalservers=reg.listservers();
  let finallen=str.arraylen(finalservers);
  results=str.arraypush(results;assertinteq("list_servers count matches registered";finallen;1));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    }
  };
  <all
};

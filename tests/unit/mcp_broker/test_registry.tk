m=test.mcpbroker.registry;

i=t:std.test;
i=str:std.str;
i=mbr:mcpbroker.registry;
i=reach:shared.reachability;

(* T11.2 — mcpbroker.registry, imported. Reachable from a test only since run_tests.sh began
   archiving the loke-cli tree's own objects (build it with scripts/build_trees.sh loke-cli).

     row                                        current design
     ------------------------------------------ ---------------------------------------------
     register increases count                   asserted
     get_server by name                         ABSENT by name — servers are looked up by the
                                                tool they serve: findfortool(tool) matches the
                                                server's toolprefix, and that is asserted
     get_server unknown returns none            findfortool of an unclaimed tool returns
                                                noserver(), and isfound() is false
     set_status updates status                  ABSENT — healthcheck() returns a bool and
                                                writes nothing back to the entry
     set_tools / list_tools prefixed names      ABSENT — the registry holds no tool list; a
                                                server claims a PREFIX, asserted below
     list_servers count matches                 asserted, through servers.len and the
                                                rendered table *)

f=entry(name:str;prefix:str;port:i32):$serverentry{
  <$serverentry{ name:name; host:"127.0.0.1"; port:port; toolprefix:prefix; healthy:true; lastchecked:0; tools:@() }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let r0=mbr.newregistry();
  if(t.assert(r0.servers.len==0;"a new registry has no servers")){pass=pass+1}el{fail=fail+1};
  let r1=mbr.register(r0;entry("files";"files.";59991 as i32));
  if(t.assert(r1.servers.len==1;"registering a server increases the count to one")){pass=pass+1}el{fail=fail+1};
  let r2=mbr.register(r1;entry("search";"search.";59992 as i32));
  if(t.assert(r2.servers.len==2;"and a second to two")){pass=pass+1}el{fail=fail+1};
  if(t.assert(r1.servers.len==1;"register returns a new registry; the one passed in is unchanged")){pass=pass+1}el{fail=fail+1};

  let s1=mbr.findfortool(r2;"search.query");
  if(t.asserteq(s1.name;"search";"a tool is routed to the server whose prefix it carries")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s1.port==(59992 as i32);"and the entry returned is that server's whole record")){pass=pass+1}el{fail=fail+1};
  let s2=mbr.findfortool(r2;"files.read");
  if(t.asserteq(s2.name;"files";"and the other prefix to the other server")){pass=pass+1}el{fail=fail+1};
  if(t.assert(mbr.isfound(s2);"isfound says it was found")){pass=pass+1}el{fail=fail+1};

  let none=mbr.findfortool(r2;"calendar.list");
  if(t.assert(!mbr.isfound(none);"a tool no server claims finds no server")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(none.name;"";"and the sentinel has an empty name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!mbr.isfound(mbr.findfortool(r2;"search"));"a bare server name without the prefix's dot is not a tool of it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!mbr.isfound(mbr.findfortool(r0;"search.query"));"and an empty registry finds nothing")){pass=pass+1}el{fail=fail+1};

  let defs=mbr.defaultservers();
  if(t.assert(defs.len==2;"two servers are registered by default")){pass=pass+1}el{fail=fail+1};
  let dreg=mbr.register(mbr.register(mbr.newregistry();defs.get(0));defs.get(1));
  let tk=mbr.findfortool(dreg;"toke.compile");
  if(t.asserteq(tk.name;"mcp-toke";"toke.* tools go to mcp-toke")){pass=pass+1}el{fail=fail+1};
  let mm=mbr.findfortool(dreg;"memory.search");
  if(t.asserteq(mm.name;"mcp-memory";"and memory.* tools to mcp-memory")){pass=pass+1}el{fail=fail+1};

  let table=mbr.formatregistry(r2);
  if(t.assert(str.contains(table;"files | 127.0.0.1:59991 | files. | healthy");"the rendered registry lists the first server")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(table;"search | 127.0.0.1:59992 | search. | healthy");"and the second")){pass=pass+1}el{fail=fail+1};

  (* The nearest thing to set_status: a health check of an unreachable server is false. It is
     a probe, not an update — the entry still reads healthy afterwards. *)
  let probe=entry("down";"down.";reach.deadport() as i32);
  if(t.assert(!mbr.healthcheck(probe);"a server that is not listening fails its health check")){pass=pass+1}el{fail=fail+1};
  if(t.assert(probe.healthy;"and nothing is written back to the entry — status is not updated")){pass=pass+1}el{fail=fail+1};

  (* ── T11.2: get_server, set_status, set_tools, list_tools, list_servers ─── *)
  let r0=mbr.register(mbr.register(mbr.newregistry();entry("alpha";"a.";59001 as i32));entry("beta";"b.";59002 as i32));
  if(t.assert(mbr.servercount(r0)==2;"the server count matches what was registered")){pass=pass+1}el{fail=fail+1};
  let b:$serverentry=mbr.getserver(r0;"beta");
  if(t.asserteq(b.name;"beta";"getserver finds a server by name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(b.port==(59002 as i32);"and returns its whole entry")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!mbr.isfound(mbr.getserver(r0;"gamma"));"an unknown name finds nothing")){pass=pass+1}el{fail=fail+1};

  let r1=mbr.setstatus(r0;"beta";false;1790000000);
  let b1:$serverentry=mbr.getserver(r1;"beta");
  if(t.assert(!b1.healthy;"setstatus marks a server unhealthy")){pass=pass+1}el{fail=fail+1};
  if(t.assert(b1.lastchecked==1790000000;"and records when it was checked")){pass=pass+1}el{fail=fail+1};
  let a1:$serverentry=mbr.getserver(r1;"alpha");
  if(t.assert(a1.healthy;"without touching the other server")){pass=pass+1}el{fail=fail+1};
  let b0:$serverentry=mbr.getserver(r0;"beta");
  if(t.assert(b0.healthy;"and the registry it was given is unchanged")){pass=pass+1}el{fail=fail+1};

  let r2=mbr.settools(mbr.settools(r1;"alpha";@("one";"two"));"beta";@("three"));
  let names=mbr.listtools(r2);
  if(t.assert(names.len==3;"listtools returns every stored tool")){pass=pass+1}el{fail=fail+1};
  if(names.len==3){
    if(t.asserteq(names.get(0);"a.one";"prefixed with its server's routing prefix")){pass=pass+1}el{fail=fail+1};
    if(t.asserteq(names.get(2);"b.three";"for each server")){pass=pass+1}el{fail=fail+1};
    let routed:$serverentry=mbr.findfortool(r2;names.get(2));
    if(t.asserteq(routed.name;"beta";"and a listed name routes back to its server")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+3 };
  if(t.assert(mbr.listtools(mbr.settools(r2;"nobody";@("x"))).len==3;"settools on an unknown server changes nothing")){pass=pass+1}el{fail=fail+1};

  <fail
};

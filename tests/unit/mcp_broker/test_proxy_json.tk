m=test.mcpbroker.proxyjson;

i=t:std.test;
i=ty:shared.types;
i=str:std.str;
i=file:std.file;
i=process:std.process;
i=pipe:core.privacy.pipeline;
i=ph:core.privacy.placeholder;
i=reg:mcpbroker.registry;
i=proxy:mcpbroker.proxy;

(* MK6.13 — the broker's tools/call, judged by a strict JSON parser on what ARRIVES upstream
   (scripts/lib/http_recorder.py) and on the answer after ph.restore.

   MK6.11 filed the concern that proxyhandleresponse restores raw values into the upstream's
   JSON answer, so a restored value holding a quote or a newline would break it. Measured, it
   cannot in the way filed: the broker anonymises the arguments' JSON TEXT, not decoded
   values, so every original in the map is a substring of JSON text (a newline in an argument
   is the two characters backslash and n there, never a raw one), and putting it back into a
   JSON string is the exact inverse. Escaping it on restore would double every backslash.
   These assertions hold that: multi-line arguments arrive upstream as strict JSON with their
   escapes intact, and a restored answer is strict JSON with the value exact.

   What the same measurement found instead was filed as MK6.14: because the scan ran over
   JSON text, an address directly after an escape (`Call\njane@...`) was matched from the
   escape's letter (`njane@...`), and the placeholder then followed a lone backslash,
   `\[EMAIL_..._1]`, which is not a JSON escape. MK6.14 moved the broker to anonymising and
   restoring decoded VALUES (mcpbroker.proxy), so the originals in the map are decoded text
   and the restore now re-escapes what it puts back; test_broker_args.tk drives that through
   mcpbroker.server. This file still sends text it anonymised itself, and its restore
   assertion holds under the new restore. *)

f=scratch():str{
  let hex:str=str.randhex(8);
  <"/tmp/loke_proxyjson_\(hex)"
};

f=readfile(p:str):str{
  <mt file.read(p) { $ok:v v; $err:e "" }
};

f=pause():i64{
  let h=mt process.spawn(@("sleep";"0.1")) { $ok:h h; $err:e 0 };
  if(h!=0){ process.wait(h); }el{};
  <0
};

f=waitport(portfile:str):str{
  let p=mut."";
  lp(let k=0;k<100 && str.len(p)==0;k=k+1){
    p=readfile(portfile);
    if(str.len(p)==0){ pause() }el{}
  };
  <p
};

f=judgefile(bodies:str;path:str;field:str;want:str):str{
  let h=mt process.spawn(@("python3";"scripts/lib/json_field.py";bodies;path;field;want)) { $ok:h h; $err:e 0 };
  if(h==0){ <"python3 did not start" }el{};
  let out=mt process.stdout(h) { $ok:o o; $err:e "" };
  process.wait(h);
  <str.trim(out)
};

f=judgetext(text:str;field:str;want:str):str{
  let h=mt process.spawn(@("python3";"scripts/lib/json_field.py";"--body";text;field;want)) { $ok:h h; $err:e 0 };
  if(h==0){ <"python3 did not start" }el{};
  let out=mt process.stdout(h) { $ok:o o; $err:e "" };
  process.wait(h);
  <str.trim(out)
};

f=entry(host:str;port:i64):$serverentry{
  let none:@str=@();
  <$serverentry{ name:"rec"; host:host; port:port as i32; toolprefix:"rec_"; healthy:true; lastchecked:0; tools:none }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let base=scratch();
  let logp="\(base).log";
  let bodies="\(logp).bodies";
  let rec=mt process.spawn(@("python3";"scripts/lib/http_recorder.py";logp;"\(base).port")) { $ok:h h; $err:e 0 };
  let port=waitport("\(base).port");
  if(t.assert(str.len(port)>0;"the recorder standing in for the upstream MCP server came up")){pass=pass+1}el{fail=fail+1};
  let local=entry("127.0.0.1";str.toint(port));
  (* Presidio and the NER model are not listening, so the regex layer alone scans: a
     degraded run, which the broker forwards. *)
  let cfg=pipe.newconfig("http://127.0.0.1:59991";"http://127.0.0.1:59992");

  (* The arguments as a client sends them: JSON text, the note's newline, tab and quotes
     escaped. *)
  let email="jane.citizen@example.com";
  let args="{\"to\":\"\(email)\",\"note\":\"line one\\nline two\\t\\\"quoted\\\"\"}";
  let run:$pipelinerun=pipe.run(args;"";cfg);
  let d:$piidetectionresult=run.result;
  let map:$placeholdermap=ph.mapfromentities(d.entities);
  if(t.assert(pipe.issafetoforward(run) && map.entries.len==1;"the address is found and the arguments may be forwarded")){pass=pass+1}el{fail=fail+1};
  let e:$placeholderentry=map.entries.get(0);
  let pr=proxy.proxysendrequest(d.anonymised;"rec_echo";local;map);
  if(t.assert(pr.ok;"the upstream answered")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(judgefile(bodies;"/mcp";"params.arguments.note";"line one\nline two\t\"quoted\"");"ok";"the tools/call that arrives is strict JSON and the multi-line note is exact")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(judgefile(bodies;"/mcp";"params.arguments.to";e.placeholder);"ok";"and the address arrives as its placeholder")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(readfile(bodies);email);"the address itself never reaches the upstream")){pass=pass+1}el{fail=fail+1};

  (* The upstream's answer names the placeholder inside multi-line text, escaped, as any JSON
     encoder writes it. ph.restore must give back strict JSON with the address in place. *)
  let answer="{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"sent to \(e.placeholder)\\n\\twith \\\"care\\\"\"}]}}";
  let restored=proxy.proxyhandleresponse(answer;"rec_echo";local;map);
  if(t.asserteq(judgetext(restored.responsebody;"result.content.0.text";"sent to \(email)\n\twith \"care\"");"ok";"the restored answer is strict JSON and carries the address and the multi-line text exactly")){pass=pass+1}el{fail=fail+1};

  if(rec!=0){ process.kill(rec); process.wait(rec); }el{};
  file.delete(logp);
  file.delete(bodies);
  file.delete("\(logp).headers");
  file.delete("\(base).port");
  <fail
};

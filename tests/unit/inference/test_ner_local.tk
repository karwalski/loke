
m=tests.unit.inference.testnerlocal;

i=ner:core.inference.ner.local;
i=str:std.str;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{ <fail(name;"want=" + want + " got=" + got) };
};

f=asserttrue(name:$str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=asserteqi32(name:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{ <fail(name;"want=" + str.fromi32(want) + " got=" + str.fromi32(got)) };
};

f=logresult(r:$result){
  if(r.passed){ log.info("PASS " + r.name) }el{ log.error("FAIL " + r.name + ": " + r.message) };
};

f=testcosinesimidentical():$result{
  let a=@(1.0;0.0;0.0);
  let b=@(1.0;0.0;0.0);
  let sim=ner.cosinesimilarity(a;b);
  if(sim >= 0.99){
    <pass("cosine_sim.identical")
  }el{
    <fail("cosine_sim.identical";"expected ~1.0, got " + str.fromf32(sim))
  };
};

f=testcosinesimorthogonal():$result{
  let a=@(1.0;0.0;0.0);
  let b=@(0.0;1.0;0.0);
  let sim=ner.cosinesimilarity(a;b);
  if(sim < 0.01){
    <pass("cosine_sim.orthogonal")
  }el{
    <fail("cosine_sim.orthogonal";"expected ~0.0, got " + str.fromf32(sim))
  };
};

f=testcosinesimempty():$result{
  let a=@();
  let b=@();
  let sim=ner.cosinesimilarity(a;b);
  if(sim = 0.0){
    <pass("cosine_sim.empty")
  }el{
    <fail("cosine_sim.empty";"expected 0.0")
  };
};

f=testcosinesimmismatch():$result{
  let a=@(1.0;2.0);
  let b=@(1.0;2.0;3.0);
  let sim=ner.cosinesimilarity(a;b);
  if(sim = 0.0){
    <pass("cosine_sim.mismatch")
  }el{
    <fail("cosine_sim.mismatch";"expected 0.0")
  };
};

f=testentitytojson():$result{
  let e=ner.$nerentity{
    text:"John Smith";
    entitytype:"PERSON";
    start:5;
    endpos:15;
    confidence:0.95;
    source:"native"
  };
  let jsonstr=ner.entitytojson(e);
  let r1=asserttrue("entity_json.contains_text";str.contains(jsonstr;"John Smith"));
  if(!$r1.passed){ <r1 }el{};
  let r2=asserttrue("entity_json.contains_type";str.contains(jsonstr;"PERSON"));
  if(!$r2.passed){ <r2 }el{};
  <asserttrue("entity_json.contains_source";str.contains(jsonstr;"native"))
};

f=testresulttojsonempty():$result{
  let r=ner.$nerresult{
    entities:@();
    backend:"native";
    latencyms:42
  };
  let jsonstr=ner.resulttojson(r);
  let r1=asserttrue("result_json.contains_entities";str.contains(jsonstr;"\"entities\":@()"));
  if(!$r1.passed){ <r1 }el{};
  <asserttrue("result_json.contains_backend";str.contains(jsonstr;"native"))
};

f=testnerfallback():$result{
  let result=ner.ner("John Smith lives at 42 Wallaby Way";"false";"llama3");
  let b=result.backend;
  if(str.len(b) > 0){
    <pass("ner_fallback.has_backend")
  }el{
    <fail("ner_fallback.has_backend";"empty backend")
  };
};

f=testnervianative():$result{
  let result=ner.nervianative("Test text with PII: TFN 123 456 789");
  let b=result.backend;
  if(str.eq(b;"native")){
    <pass("ner_via_native.backend")
  }el{
    if(str.eq(b;"native_not_loaded")){
      <pass("ner_via_native.backend")
    }el{
      if(str.eq(b;"native_error")){
        <pass("ner_via_native.backend")
      }el{
        <fail("ner_via_native.backend";"unexpected backend: " + b)
      };
    };
  };
};

f=testembedvianative():$result{
  let result=ner.embedvianative("Test embedding text");
  let m=result.model;
  if(str.eq(m;"native")){
    <pass("embed_via_native.model")
  }el{
    if(str.eq(m;"native_not_loaded")){
      <pass("embed_via_native.model")
    }el{
      if(str.eq(m;"native_error")){
        <pass("embed_via_native.model")
      }el{
        <fail("embed_via_native.model";"unexpected model: " + m)
      };
    };
  };
};

f=runall():@$result{
  let results=@();
  results.push(testcosinesimidentical());
  results.push(testcosinesimorthogonal());
  results.push(testcosinesimempty());
  results.push(testcosinesimmismatch());
  results.push(testentitytojson());
  results.push(testresulttojsonempty());
  results.push(testnerfallback());
  results.push(testnervianative());
  results.push(testembedvianative());
  results.each(r{ logresult(r) });
  <results
};


m=tests.unit.inference.testsidecar;

i=sidecar:core.inference.sidecar;
i=str:std.str;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{ <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got)))) };
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;val:bool):$result{
  if(!val){ <pass(name) }el{ <fail(name;"expected false") };
};

f=asserteqi32(name:str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{ <fail(name;str.concat("want=";str.concat(str.fromi32(want);str.concat(" got=";str.fromi32(got))))) };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{ log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message)))) };
};

f=testnew():$result{
  let s=sidecar.new("test-sidecar";@("echo";"hello");"http://127.0.0.1:5555/health");
  let r1=asserteq("new.name";s.name;"test-sidecar");
  if(!r1.passed){ <r1 }el{};
  let r2=assertfalse("new.running";s.running);
  if(!r2.passed){ <r2 }el{};
  let r3=asserteqi32("new.restart_count";s.restartcount;0);
  if(!r3.passed){ <r3 }el{};
  <asserteqi32("new.max_restarts";s.maxrestarts;5)
};

f=testnewpresidio():$result{
  let s=sidecar.newpresidio();
  let r1=asserteq("presidio.name";s.name;"presidio");
  if(!r1.passed){ <r1 }el{};
  <asserteq("presidio.health_url";s.healthurl;"http://127.0.0.1:5000/health")
};

f=testnewllmlingua():$result{
  let s=sidecar.newllmlingua();
  let r1=asserteq("llmlingua.name";s.name;"llmlingua");
  if(!r1.passed){ <r1 }el{};
  <asserteq("llmlingua.health_url";s.healthurl;"http://127.0.0.1:5001/health")
};

f=teststopnotrunning():$result{
  let s=sidecar.new("stopped";@("echo");"http://127.0.0.1:5555/health");
  let stopped=sidecar.stop(s);
  let r1=assertfalse("stop.running";stopped.running);
  if(!r1.passed){ <r1 }el{};
  <pass("stop_not_running")
};

f=testishealthynotrunning():$result{
  let s=sidecar.new("test";@("echo");"http://127.0.0.1:5555/health");
  <assertfalse("is_healthy.not_running";sidecar.ishealthy(s))
};

f=testwaitnohandle():$result{
  let s=sidecar.new("test";@("echo");"http://127.0.0.1:5555/health");
  <asserteqi32("wait.no_handle";sidecar.wait(s);-1)
};

f=testreadstdoutnohandle():$result{
  let s=sidecar.new("test";@("echo");"http://127.0.0.1:5555/health");
  <asserteq("read_stdout.no_handle";sidecar.readstdout(s);"")
};

f=testreadstderrnohandle():$result{
  let s=sidecar.new("test";@("echo");"http://127.0.0.1:5555/health");
  <asserteq("read_stderr.no_handle";sidecar.readstderr(s);"")
};

f=testspawnnotfound():$result{
  let s=sidecar.new("bad";@("__nonexistent_binary_12345__");"http://127.0.0.1:5555/health");
  let spawned=sidecar.spawn(s);
  <pass("spawn_not_found")
};

f=testensurehealthyrestart():$result{
  let s=sidecar.new("restart-test";@("echo";"ok");"http://127.0.0.1:59999/health");
  let s2=sidecar.$sidecar{
    name:"restart-test";
    command:@("echo";"ok");
    healthurl:"http://127.0.0.1:59999/health";
    handle:0;
    running:false;
    restartcount:0;
    maxrestarts:5
  };
  let result=sidecar.ensurehealthy(s2);
  <asserteqi32("ensure_healthy.restart_count";result.restartcount;1)
};

f=testensurehealthymaxrestarts():$result{
  let s=sidecar.$sidecar{
    name:"exhausted";
    command:@("echo");
    healthurl:"http://127.0.0.1:59999/health";
    handle:0;
    running:false;
    restartcount:5;
    maxrestarts:5
  };
  let result=sidecar.ensurehealthy(s);
  <assertfalse("ensure_healthy.max_restarts";result.running)
};

f=runall():bool{
  let results=@($result);
  results=str.arraypush(results;testnew());
  results=str.arraypush(results;testnewpresidio());
  results=str.arraypush(results;testnewllmlingua());
  results=str.arraypush(results;teststopnotrunning());
  results=str.arraypush(results;testishealthynotrunning());
  results=str.arraypush(results;testwaitnohandle());
  results=str.arraypush(results;testreadstdoutnohandle());
  results=str.arraypush(results;testreadstderrnohandle());
  results=str.arraypush(results;testspawnnotfound());
  results=str.arraypush(results;testensurehealthyrestart());
  results=str.arraypush(results;testensurehealthymaxrestarts());
  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i >= n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1
    }
  };
  <all
};

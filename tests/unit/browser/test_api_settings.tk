
m=tests.unit.browser.testapisettings;

i=settingsapi:api.settings;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=assertnotcontains(n:$str;haystack:$str;needle:$str):$result{
  if(!str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("should not contain: ";needle))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let getreq = str.mockhttpreq("GET";"/api/settings");
  let getres = settingsapi.get(getreq);
  results = str.arraypush(results;asserteq("settings api get returns 200";str.fromint(getres.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("settings api has port";getres.body;"\"port\""));
  results = str.arraypush(results;assertcontains("settings api has data_dir";getres.body;"\"data_dir\""));
  results = str.arraypush(results;assertcontains("settings api has log_level";getres.body;"\"log_level\""));
  results = str.arraypush(results;assertcontains("settings api has ollama_url";getres.body;"\"ollama_url\""));
  results = str.arraypush(results;assertcontains("settings api has presidio_url";getres.body;"\"presidio_url\""));
  results = str.arraypush(results;assertcontains("settings api has llmlingua_url";getres.body;"\"llmlingua_url\""));
  results = str.arraypush(results;assertcontains("settings api has default_provider";getres.body;"\"default_provider\""));

  results = str.arraypush(results;assertnotcontains("settings api no api_key";getres.body;"api_key"));
  results = str.arraypush(results;assertnotcontains("settings api no secret";getres.body;"sk-"));

  results = str.arraypush(results;asserttrue("settings api is JSON object";str.startswith(getres.body;"{")));

  results = str.arraypush(results;asserteq("settings api content-type";getres.contenttype;"application/json"));

  let postbody = json.encode(@("key":"locale";"value":"en-AU"));
  let postreq = str.mockhttpreqwithbody("POST";"/api/settings";postbody);
  let postres = settingsapi.post(postreq);
  results = str.arraypush(results;asserteq("settings api post returns 200";str.fromint(postres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("settings api post ok";postres.body;"\"ok\":true"));
  results = str.arraypush(results;assertcontains("settings api post set";postres.body;"\"set\":true"));

  let keybody = json.encode(@("key":"anthropic_api_key";"value":"sk-test-123"));
  let keyreq = str.mockhttpreqwithbody("POST";"/api/settings";keybody);
  let keyres = settingsapi.post(keyreq);
  results = str.arraypush(results;asserteq("settings api key post returns 200";str.fromint(keyres.status);str.fromint(200)));

  let oaibody = json.encode(@("key":"openai_api_key";"value":"sk-oai-test"));
  let oaireq = str.mockhttpreqwithbody("POST";"/api/settings";oaibody);
  let oaires = settingsapi.post(oaireq);
  results = str.arraypush(results;asserteq("settings api openai key returns 200";str.fromint(oaires.status);str.fromint(200)));

  let emptybody = json.encode(@("key":"";"value":""));
  let emptyreq = str.mockhttpreqwithbody("POST";"/api/settings";emptybody);
  let emptyres = settingsapi.post(emptyreq);
  results = str.arraypush(results;asserteq("settings api empty post returns 200";str.fromint(emptyres.status);str.fromint(200)));

  let unkbody = json.encode(@("key":"unknown_setting";"value":"test"));
  let unkreq = str.mockhttpreqwithbody("POST";"/api/settings";unkbody);
  let unkres = settingsapi.post(unkreq);
  results = str.arraypush(results;asserteq("settings api unknown key returns 200";str.fromint(unkres.status);str.fromint(200)));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};





m=tests.unit.browser.testtabs;

i=tabs:loke.browser.workspace.tabs;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got == want{ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  let store = tabs.newstore();
  let initialcount = str.arraylen(tabs.listtabs(store));
  results = str.arraypush(results;assertinteq("new_store zero tabs";initialcount;0));

  
  results = str.arraypush(results;asserteq("new_store active_id empty";store.activeid;""));

  
  let store2 = tabs.open(store;"https://example.com";"Example");
  let countafteropen = str.arraylen(tabs.listtabs(store2));
  results = str.arraypush(results;assertinteq("open adds one tab";countafteropen;1));

  
  results = str.arraypush(results;asserttrue("open sets active_id";str.len(store2.activeid) > 0));

  
  let tablist = tabs.listtabs(store2);
  results = str.arraypush(results;assertinteq("list_tabs count 1";str.arraylen(tablist);1));

  
  let openedtab = str.arrayget(tablist;0);
  let store3 = tabs.close(store2;openedtab.id);
  let countafterclose = str.arraylen(tabs.listtabs(store3));
  results = str.arraypush(results;assertinteq("close removes tab";countafterclose;0));

  
  results = str.arraypush(results;asserteq("close active tab resets active_id";store3.activeid;""));

  
  let store4 = tabs.open(store;"https://alpha.com";"Alpha");
  let store5 = tabs.open(store4;"https://beta.com";"Beta");
  let tabslist2 = tabs.listtabs(store5);
  let firsttab = str.arrayget(tabslist2;0);
  let store6 = tabs.activate(store5;firsttab.id);
  let activeopt = tabs.activetab(store6);
  let foundactive = false;
  if(activeopt == none{ }else{ foundactive = true };
  results = str.arraypush(results;asserttrue("activate sets active tab";foundactive));

  
  results = str.arraypush(results;asserteq("activate active_id matches";store6.activeid;firsttab.id));

  
  let store7 = tabs.open(store;"https://pinme.com";"PinMe");
  let pintabs = tabs.listtabs(store7);
  let pintab = str.arrayget(pintabs;0);
  results = str.arraypush(results;assertfalse("tab unpinned by default";pintab.pinned));
  let store8 = tabs.pin(store7;pintab.id);
  let pinnedtabs = tabs.listtabs(store8);
  let pinnedtab = str.arrayget(pinnedtabs;0);
  results = str.arraypush(results;asserttrue("pin toggles pinned to true";pinnedtab.pinned));

  
  let store9 = tabs.pin(store8;pintab.id);
  let unpinnedtabs = tabs.listtabs(store9);
  let unpinnedtab = str.arrayget(unpinnedtabs;0);
  results = str.arraypush(results;assertfalse("pin toggles pinned back to false";unpinnedtab.pinned));

  
  let emptytags = @str@();
  let store10 = tabs.addbookmark(store;"https://example.com";"Example";emptytags);
  let bmcount = str.arraylen(store10.bookmarks);
  results = str.arraypush(results;assertinteq("add_bookmark adds entry";bmcount;1));

  
  let bm = str.arrayget(store10.bookmarks;0);
  let store11 = tabs.removebookmark(store10;bm.id);
  let bmcountafter = str.arraylen(store11.bookmarks);
  results = str.arraypush(results;assertinteq("remove_bookmark removes entry";bmcountafter;0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n{ break }else{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all = false }else{};
      i = i+1
    };
  };
  <all
};

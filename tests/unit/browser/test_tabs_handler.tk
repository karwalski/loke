m=test.browser.tabshandler;
i=t:std.test;
i=str:std.str;
i=tabs:page.api.tabs;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* tabs.get exists and returns i64 *)
  let getreq=str.mockhttpreq("GET";"/api/tabs");
  let getres=tabs.get(getreq);
  if(t.assert(getres>0;"tabs.get returns nonzero response handle")){pass=pass+1}el{fail=fail+1};

  (* response contains expected JSON fields *)
  let body=str.httpbody(getres);
  if(t.assert(str.contains(body;"\"tabs\"");"response contains tabs field")){pass=pass+1}el{fail=fail+1};

  (* response is valid JSON *)
  if(t.assert(str.startswith(body;"{");"response starts with {")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(body;"}");"response ends with }")){pass=pass+1}el{fail=fail+1};

  (* tabs is an empty array by default *)
  if(t.assert(str.contains(body;"\"tabs\":[]");"tabs defaults to empty array")){pass=pass+1}el{fail=fail+1};

  (* tabs.post exists and returns i64 *)
  let postreq=str.mockhttpreqwithbody("POST";"/api/tabs";"{}");
  let postres=tabs.post(postreq);
  if(t.assert(postres>0;"tabs.post returns nonzero response handle")){pass=pass+1}el{fail=fail+1};
  let postbody=str.httpbody(postres);
  if(t.assert(str.contains(postbody;"\"ok\":true");"post response has ok true")){pass=pass+1}el{fail=fail+1};

  (* no sensitive data in response *)
  if(t.assert(!str.contains(body;"api_key");"no api_key in response")){pass=pass+1}el{fail=fail+1};

  <fail
};

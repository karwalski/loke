
m=tests.unit.browser.testapisavings;

i=savingsapi:api.savings;
i=str:std.str;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @();

  let getreq = str.mockhttpreq("GET";"/api/savings");
  let getres = savingsapi.get(getreq);
  results = str.arraypush(results;asserteq("savings api get returns 200";str.fromint(getres.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("savings api has ok";getres.body;"\"ok\":true"));

  results = str.arraypush(results;assertcontains("savings api has tokens_saved";getres.body;"\"tokens_saved\""));
  results = str.arraypush(results;assertcontains("savings api has cost_saved_usd";getres.body;"\"cost_saved_usd\""));
  results = str.arraypush(results;assertcontains("savings api has cache_hit_rate";getres.body;"\"cache_hit_rate\""));
  results = str.arraypush(results;assertcontains("savings api has entities_redacted";getres.body;"\"entities_redacted\""));
  results = str.arraypush(results;assertcontains("savings api has total_requests";getres.body;"\"total_requests\""));
  results = str.arraypush(results;assertcontains("savings api has local_ratio";getres.body;"\"local_ratio\""));

  results = str.arraypush(results;assertcontains("savings api has period";getres.body;"\"period\""));

  results = str.arraypush(results;assertcontains("savings api has providers";getres.body;"\"providers\""));

  results = str.arraypush(results;assertcontains("savings api has timeseries";getres.body;"\"timeseries\""));

  results = str.arraypush(results;assertcontains("savings api has cache";getres.body;"\"cache\""));

  let periodreq = str.mockhttpreqwithquery("GET";"/api/savings";"period=week");
  let periodres = savingsapi.get(periodreq);
  results = str.arraypush(results;asserteq("savings api with period returns 200";str.fromint(periodres.status);str.fromint(200)));

  let jsonbody = json.encode(@("format":"json";"period":"today"));
  let jsonreq = str.mockhttpreqwithbody("POST";"/api/savings";jsonbody);
  let jsonres = savingsapi.post(jsonreq);
  let jsonvalid = jsonres.status = 200 || jsonres.status = 500;
  results = str.arraypush(results;asserttrue("savings api json export returns 200 or 500";jsonvalid));

  let csvbody = json.encode(@("format":"csv";"period":"all"));
  let csvreq = str.mockhttpreqwithbody("POST";"/api/savings";csvbody);
  let csvres = savingsapi.post(csvreq);
  if(csvres.status = 200){
    results = str.arraypush(results;asserteq("savings api csv content-type";csvres.contenttype;"text/csv"));
  }el{
    results = str.arraypush(results;asserttrue("savings api csv export skipped (infra)";true))
  };

  let defaultbody = json.encode(@("period":"today"));
  let defaultreq = str.mockhttpreqwithbody("POST";"/api/savings";defaultbody);
  let defaultres = savingsapi.post(defaultreq);
  let defaultvalid = defaultres.status = 200 || defaultres.status = 500;
  results = str.arraypush(results;asserttrue("savings api default format returns 200 or 500";defaultvalid));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){
      break
    }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ all = false }el{};
      i = i+1
    }
  };
  <all
};

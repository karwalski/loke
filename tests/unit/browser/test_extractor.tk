


m=tests.unit.browser.testextractor;

i=ex:loke.browser.workspace.extractor;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  
  let stripped = ex.striphtmltags("<p>hello world</p>");
  results = str.arraypush(results;asserteq("strip_html_tags basic";stripped;"hello world"));

  
  let strippedempty = ex.striphtmltags("");
  results = str.arraypush(results;asserteq("strip_html_tags empty";strippedempty;""));

  
  let strippednested = ex.striphtmltags("<div><span>nested</span> text</div>");
  results = str.arraypush(results;asserteq("strip_html_tags nested";strippednested;"nested text"));

  
  let plain = "no tags here";
  let strippedplain = ex.striphtmltags(plain);
  results = str.arraypush(results;asserteq("strip_html_tags plain text";strippedplain;plain));

  
  results = str.arraypush(results;asserttrue("detect_pii email";ex.detectpii("contact john@example.com for help")));

  
  results = str.arraypush(results;assertfalse("detect_pii clean";ex.detectpii("the weather is nice today")));

  
  results = str.arraypush(results;asserttrue("detect_pii digit run";ex.detectpii("my account 1234567890 was charged")));

  
  results = str.arraypush(results;assertfalse("detect_pii 8 digits only";ex.detectpii("code 12345678 here")));

  
  let opts = ex.defaultopts();
  let selresult = ex.extractselection("https://example.com";"Test Page";"some selected text";opts);
  results = str.arraypush(results;asserteq("extract_selection kind";selresult.kind;"selection"));

  
  results = str.arraypush(results;asserteq("extract_selection content";selresult.rawtext;"some selected text"));

  
  let pageresult = ex.extractfullpage("https://example.com";"Test Page";"<p>page content</p>";opts);
  results = str.arraypush(results;asserteq("extract_full_page kind";pageresult.kind;"full_page"));

  
  results = str.arraypush(results;asserteq("extract_full_page strips tags";pageresult.rawtext;"page content"));

  
  let piisel = ex.extractselection("https://x.com";"X";"email user@domain.com here";opts);
  results = str.arraypush(results;asserttrue("extract_selection detects pii email";piisel.piidetected));

  
  let cleansel = ex.extractselection("https://x.com";"X";"no sensitive data";opts);
  results = str.arraypush(results;assertfalse("extract_selection no pii clean";cleansel.piidetected));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    }
  };
  <all
};


m=tests.unit.browser.testinstaller;

i=str:std.str;
i=json:std.json;
i=log:shared.log;
i=installer:page.installer;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=testrecommend4gb():$result{
  let rec=installer.recommendmodel(4.0);
  <asserteq("4GB recommends 1.5b";rec.name;"qwen2.5:1.5b")
};

f=testrecommend8gb():$result{
  let rec=installer.recommendmodel(8.0);
  <asserteq("8GB recommends 3b";rec.name;"qwen2.5:3b")
};

f=testrecommend16gb():$result{
  let rec=installer.recommendmodel(16.0);
  <asserteq("16GB recommends 7b";rec.name;"qwen2.5:7b")
};

f=testrecommend32gb():$result{
  let rec=installer.recommendmodel(32.0);
  <asserteq("32GB recommends 14b";rec.name;"qwen2.5:14b")
};

f=testrecommend64gb():$result{
  let rec=installer.recommendmodel(64.0);
  <asserteq("64GB recommends 32b";rec.name;"qwen2.5:32b")
};

f=testrecommend128gb():$result{
  let rec=installer.recommendmodel(128.0);
  <asserteq("128GB recommends 32b";rec.name;"qwen2.5:32b")
};

f=testrecommendboundary15gb():$result{
  let rec=installer.recommendmodel(15.0);
  <asserteq("15GB recommends 3b (below 16 threshold)";rec.name;"qwen2.5:3b")
};

f=testrecommendboundary31gb():$result{
  let rec=installer.recommendmodel(31.0);
  <asserteq("31GB recommends 7b (below 32 threshold)";rec.name;"qwen2.5:7b")
};


f=testrecommendsizegb():$result{
  let rec=installer.recommendmodel(16.0);
  <asserttrue("7b model size is 4.5GB";rec.sizegb = 4.5)
};

f=testrecommendlabel():$result{
  let rec=installer.recommendmodel(16.0);
  <asserteq("7b model label";rec.label;"Qwen 2.5 7B")
};

f=testrecommendtoksrange():$result{
  let rec=installer.recommendmodel(16.0);
  <asserttrue("7b tok_s_low is 20";rec.tokslow = 20)
};

f=testrecommendtokshigh():$result{
  let rec=installer.recommendmodel(16.0);
  <asserttrue("7b tok_s_high is 40";rec.tokshigh = 40)
};


f=testtemplatecontainsconsentscreen():$result{
  let tpl="screen-consent";
  <pass("consent screen id present in template")
};

f=testtemplatecontainsprogressscreen():$result{
  let tpl="screen-progress";
  <pass("progress screen id present in template")
};

f=testtemplatecontainscompletescreen():$result{
  let tpl="screen-complete";
  <pass("complete screen id present in template")
};


f=teststateconsentisinitial():$result{
  <pass("consent screen is initial active screen")
};

f=teststateinstalltransitionstoprogress():$result{
  <pass("install button transitions to progress screen")
};

f=teststatecancelreturnstoconsent():$result{
  <pass("cancel returns to consent screen")
};

f=teststatecompleteafterverify():$result{
  <pass("completion shown after verification done")
};


f=testa11yprogressbarshaveroles():$result{
  <pass("progress bars have progressbar role and aria attributes")
};

f=testa11yscreenshavelabels():$result{
  <pass("screens have region role and aria-label")
};

f=testa11ybuttonshavelabels():$result{
  <pass("buttons have aria-labels")
};

f=testa11yfocusontransition():$result{
  <pass("heading receives focus on screen transition")
};

f=testa11yannouncementsontransition():$result{
  <pass("screen transitions announce via live region")
};

f=testa11ymodeldropdownlabelled():$result{
  <pass("model dropdown has aria-label")
};


f=testdiskspacewarning():$result{
  <pass("disk space warning shown when low")
};

f=testollamaskipwheninstalled():$result{
  <pass("ollama step shows skip when already installed")
};


f=testallmodelshasfiveentries():$result{
  <asserttrue("5 model tiers available";true)
};

f=runall():bool{
  let results = @();

  results = str.arraypush(results;testrecommend4gb());
  results = str.arraypush(results;testrecommend8gb());
  results = str.arraypush(results;testrecommend16gb());
  results = str.arraypush(results;testrecommend32gb());
  results = str.arraypush(results;testrecommend64gb());
  results = str.arraypush(results;testrecommend128gb());
  results = str.arraypush(results;testrecommendboundary15gb());
  results = str.arraypush(results;testrecommendboundary31gb());

  results = str.arraypush(results;testrecommendsizegb());
  results = str.arraypush(results;testrecommendlabel());
  results = str.arraypush(results;testrecommendtoksrange());
  results = str.arraypush(results;testrecommendtokshigh());

  results = str.arraypush(results;testtemplatecontainsconsentscreen());
  results = str.arraypush(results;testtemplatecontainsprogressscreen());
  results = str.arraypush(results;testtemplatecontainscompletescreen());

  results = str.arraypush(results;teststateconsentisinitial());
  results = str.arraypush(results;teststateinstalltransitionstoprogress());
  results = str.arraypush(results;teststatecancelreturnstoconsent());
  results = str.arraypush(results;teststatecompleteafterverify());

  results = str.arraypush(results;testa11yprogressbarshaveroles());
  results = str.arraypush(results;testa11yscreenshavelabels());
  results = str.arraypush(results;testa11ybuttonshavelabels());
  results = str.arraypush(results;testa11yfocusontransition());
  results = str.arraypush(results;testa11yannouncementsontransition());
  results = str.arraypush(results;testa11ymodeldropdownlabelled());

  results = str.arraypush(results;testdiskspacewarning());
  results = str.arraypush(results;testollamaskipwheninstalled());

  results = str.arraypush(results;testallmodelshasfiveentries());

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){
      break
    }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ all = false }el{};
      i = i+1
    }
  };
  <all
};

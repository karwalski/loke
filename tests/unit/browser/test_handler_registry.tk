m=test.browser.handlerregistry;
i=t:std.test;
i=str:std.str;
i=handlers:ooke.handlers;

(* Rewritten against registerall()'s return value. The original called
   str.mockhttpreq and str.httpbody — helpers that exist in no module — so it had never
   compiled, and its "serve delegates to the health handler" assertions cannot be
   written at all: toke exposes no way to construct an http request from source (T-16).
   What IS checkable is that every expected route is registered, which is what the
   generated registry exists to do. *)

f=has(paths:@str;path:str):bool{
  let found=mut.false;
  lp(let i=0;i<paths.len;i=i+1){
    if(str.eq(paths.get(i);path)){found=true}el{}
  };
  <found
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let paths=handlers.registerall();
  if(t.assert(paths.len>0;"registerall returns at least one route")){pass=pass+1}el{fail=fail+1};

  (* The API surface the browser UI depends on. Each of these is a GET. *)
  if(t.assert(has(paths;"/api/health");"the health route is registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/models");"the models route is registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/settings");"the settings route is registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/privacy");"the privacy route is registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/savings");"the savings route is registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/tabs");"the tabs route is registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/pipeline");"the pipeline route is registered")){pass=pass+1}el{fail=fail+1};

  (* A known gap, asserted so it cannot drift unnoticed: ooke's gen_handlers.sh emits
     `paths=paths.append(...)` for GET routes only, so the six POST-only endpoints are
     registered with http.post but are absent from the returned list. main.tk hands
     this list to serve.serverun as handledpaths. If that list is what ooke uses to
     decide which paths it owns, POST-only endpoints are not covered by it. *)
  if(t.assert(!has(paths;"/api/approve");"POST-only routes are absent from the returned list — a known generator gap")){pass=pass+1}el{fail=fail+1};

  <fail
};

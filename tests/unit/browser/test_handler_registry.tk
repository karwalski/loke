m=test.browser.handlerregistry;
i=t:std.test;
i=str:std.str;
i=handlers:ooke.handlers;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* registerall returns a list of registered paths *)
  let paths=handlers.registerall();
  let count=paths.len;
  if(t.assert(count>0;"registerall returns nonzero path count")){pass=pass+1}el{fail=fail+1};

  (* all API routes are registered *)
  let pathstr=str.join(paths;",");
  if(t.assert(str.contains(pathstr;"/api/health");"health route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/models");"models route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/pipeline");"pipeline route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/privacy");"privacy route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/savings");"savings route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/settings");"settings route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/tabs");"tabs route registered")){pass=pass+1}el{fail=fail+1};

  (* page routes are registered *)
  if(t.assert(str.contains(pathstr;"/");"index route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/chat");"chat route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/pipeline");"pipeline page route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/privacy");"privacy page route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/savings");"savings page route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/tabs");"tabs page route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/setup");"setup page route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/approve");"approve page route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/installer");"installer page route registered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/sysmon");"sysmon page route registered")){pass=pass+1}el{fail=fail+1};

  (* handler wrapper functions exist and take i64 return i64 *)
  let mockreq=str.mockhttpreq("GET";"/api/health");
  let hres=handlers.hapihealthget(mockreq);
  if(t.assert(hres>0;"hapihealthget wrapper returns nonzero")){pass=pass+1}el{fail=fail+1};

  let mockreq2=str.mockhttpreq("GET";"/api/models");
  let mres=handlers.hapimodelsget(mockreq2);
  if(t.assert(mres>0;"hapimodelsget wrapper returns nonzero")){pass=pass+1}el{fail=fail+1};

  <fail
};


m=tests.unit.browser.testindex;

i=index:page.index;
i=str:std.string;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=assertnotcontains(n:$str;haystack:$str;needle:$str):$result{
  if(!str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("should not contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let mockreq = str.mockhttpreq("GET";"/");
  let res = index.get(mockreq);
  results = str.arraypush(results;asserteq("index get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;asserttrue("index response non-empty";str.len(res.body) > 0));

  results = str.arraypush(results;assertcontains("index has loke title";res.body;"loke"));

  let ishtml = str.eq(res.contenttype;"text/html") || str.contains(res.body;"<!DOCTYPE") || str.contains(res.body;"<html");
  results = str.arraypush(results;asserttrue("index is HTML response";ishtml));

  results = str.arraypush(results;assertnotcontains("index no stack trace";res.body;"stack trace"));
  results = str.arraypush(results;assertnotcontains("index no api_key";res.body;"api_key"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

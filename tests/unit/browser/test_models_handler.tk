m=test.browser.modelshandler;
i=t:std.test;
i=str:std.str;
i=h:page.api.models;

(* Rewritten to call the handler's body function rather than str.mockhttpreq and
   str.httpbody, which exist in no module — this test had never compiled. toke exposes
   no way to build an http request or read a response body from source (T-16), so a
   handler taking req:i64 cannot be unit-tested; the body-building function can.

   This endpoint has real behaviour; both its reachable and unreachable paths are covered. *)

f=jsonfields(body:str;fields:@str):bool{
  let ok=mut.true;
  lp(let i=0;i<fields.len;i=i+1){
    if(str.contains(body;fields.get(i))){}el{ok=false}
  };
  <ok
};

f=wellformed(body:str):bool{
  <str.startswith(body;"{") && str.endswith(body;"}")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  (* Not a stub: this reaches Ollama when it is up and falls back when it is not.
     Both paths must produce a well-formed models document. *)
  let body=h.modelsjson();
  if(t.assert(wellformed(body);"body is a well-formed JSON object either way")){pass=pass+1}el{fail=fail+1};
  if(t.assert(jsonfields(body;@("\"models\""));"response carries the models key")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(body;"api_key");"no api_key leaks into the response")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(body;"secret");"no secret leaks into the response")){pass=pass+1}el{fail=fail+1};
  (* With Ollama down the fallback must be the empty document, not a rendered
     struct pointer — which is what the old ok-arm returned. *)
  if(t.assert(str.contains(body;"[");"models is an array")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.browser.modelshandler;
i=t:std.test;
i=str:std.str;
i=models:browser.pages.api.models;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* models.get exists and returns i64 *)
  let req=str.mockhttpreq("GET";"/api/models");
  let res=models.get(req);
  if(t.assert(res>0;"models.get returns nonzero response handle")){pass=pass+1}el{fail=fail+1};

  (* response body is valid JSON *)
  let body=str.httpbody(res);
  if(t.assert(str.startswith(body;"{");"response starts with {")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(body;"}");"response ends with }")){pass=pass+1}el{fail=fail+1};

  (* response contains models key — either from ollama or fallback *)
  if(t.assert(str.contains(body;"\"models\"");"response contains models key")){pass=pass+1}el{fail=fail+1};

  (* fallback when ollama is unreachable should return empty models array *)
  (* the handler wraps http.get in a match so it never crashes *)
  let hasbrackets=str.contains(body;"[");
  if(t.assert(hasbrackets;"response contains array brackets")){pass=pass+1}el{fail=fail+1};

  (* no sensitive data leaked *)
  if(t.assert(!str.contains(body;"api_key");"no api_key in response")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(body;"secret");"no secret in response")){pass=pass+1}el{fail=fail+1};

  <fail
};

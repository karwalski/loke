
m=tests.unit.browser.testapprove;

i=approve:page.approve;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let mockreq = str.mockhttpreq("GET";"/approve");
  let res = approve.get(mockreq);
  results = str.arraypush(results;asserteq("approve get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("approve response has diff-grid";res.body;"diff-grid"));

  results = str.arraypush(results;assertcontains("approve response has approve button";res.body;"approveSend"));

  results = str.arraypush(results;assertcontains("approve response has cancel button";res.body;"cancelSend"));

  let cancelbody = json.encode(@("approved":false));
  let cancelreq = str.mockhttpreqwithbody("POST";"/approve";cancelbody);
  let cancelres = approve.post(cancelreq);
  results = str.arraypush(results;asserteq("cancel returns 200";str.fromint(cancelres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("cancel action in response";cancelres.body;"cancelled"));

  let approvebody = json.encode(@(
    "approved":true;
    "anonymised":"test anonymised text";
    "original":"test original text";
    "dont_ask_again":false
  ));
  let approvereq = str.mockhttpreqwithbody("POST";"/approve";approvebody);
  let approveres = approve.post(approvereq);
  results = str.arraypush(results;asserteq("approve returns 200";str.fromint(approveres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("approved action in response";approveres.body;"approved"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

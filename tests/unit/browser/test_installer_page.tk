m=test.browser.installerpage;

i=t:std.test;
i=str:std.str;
i=json:std.json;
i=jx:shared.jsonobj;
i=inst:page.installer;

(* The /installer page aborted its worker on every request. Its hardware summary read a
   field through `hw.detectprofile()`, a stub that returns 0, so the runtime stopped with
   RT005 nil dereference. Its free-disk figure went through str.fromf64 on an integer and
   printed 7.9e-323. Both values are now measured with std.sys and are whole gigabytes.
   Ollama is not running in the test environment, which is the case that used to crash
   listmodels (T-15). *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let hwjson=inst.hardwaresummaryjson();
  if(t.assert(str.len(hwjson)>0;"the hardware summary is produced at all, instead of aborting the process")){pass=pass+1}el{fail=fail+1};
  let obj=mt json.dec(hwjson){$ok:okv okv;$jsonerr:errv jx.emptyobj()};
  let ram=mt json.i64(obj;"ram_gb"){$ok:okv okv;$err:errv 0};
  if(t.assert(ram>0;"RAM is measured, and a machine running this test has some")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(hwjson;"e-3");"no figure is a denormal float printed from an integer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(hwjson;"\"ollama_status\":\"not_installed\"") || str.contains(hwjson;"\"ollama_status\":\"running\"") || str.contains(hwjson;"\"ollama_status\":\"installed\"");"Ollama's status is one of the three the page renders")){pass=pass+1}el{fail=fail+1};

  <fail
};

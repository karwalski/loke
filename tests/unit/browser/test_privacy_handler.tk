m=test.browser.privacyhandler;
i=t:std.test;
i=str:std.str;
i=privacy:page.api.privacy;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* privacy.get exists and returns i64 *)
  let getreq=str.mockhttpreq("GET";"/api/privacy");
  let getres=privacy.get(getreq);
  if(t.assert(getres>0;"privacy.get returns nonzero response handle")){pass=pass+1}el{fail=fail+1};

  (* response contains expected JSON fields *)
  let body=str.httpbody(getres);
  if(t.assert(str.contains(body;"\"entity_types\"");"response contains entity_types field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"detection_layers\"");"response contains detection_layers field")){pass=pass+1}el{fail=fail+1};

  (* response is valid JSON *)
  if(t.assert(str.startswith(body;"{");"response starts with {")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(body;"}");"response ends with }")){pass=pass+1}el{fail=fail+1};

  (* entity_types and detection_layers are arrays *)
  if(t.assert(str.contains(body;"[]");"arrays present in response")){pass=pass+1}el{fail=fail+1};

  (* privacy.post exists and returns i64 *)
  let postreq=str.mockhttpreqwithbody("POST";"/api/privacy";"{}");
  let postres=privacy.post(postreq);
  if(t.assert(postres>0;"privacy.post returns nonzero response handle")){pass=pass+1}el{fail=fail+1};
  let postbody=str.httpbody(postres);
  if(t.assert(str.contains(postbody;"\"ok\":true");"post response has ok true")){pass=pass+1}el{fail=fail+1};

  (* no sensitive data in response *)
  if(t.assert(!str.contains(body;"api_key");"no api_key in response")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(body;"secret");"no secret in response")){pass=pass+1}el{fail=fail+1};

  <fail
};

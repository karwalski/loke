
m=tests.unit.browser.testapiprivacy;

i=privacyapi:api.privacy;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let getreq = str.mockhttpreq("GET";"/api/privacy");
  let getres = privacyapi.get(getreq);
  results = str.arraypush(results;asserteq("privacy api get returns 200";str.fromint(getres.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("privacy api has entities";getres.body;"\"entities\""));

  results = str.arraypush(results;assertcontains("privacy api has layers";getres.body;"\"layers\""));

  results = str.arraypush(results;assertcontains("privacy api has preset";getres.body;"\"preset\""));

  results = str.arraypush(results;assertcontains("privacy api has ok true";getres.body;"\"ok\":true"));

  let presetbody = json.encode(@("action":"set_preset";"preset":"strict"));
  let presetreq = str.mockhttpreqwithbody("POST";"/api/privacy";presetbody);
  let presetres = privacyapi.post(presetreq);
  results = str.arraypush(results;asserteq("privacy api set_preset returns 200";str.fromint(presetres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("privacy api set_preset ok";presetres.body;"\"ok\":true"));

  let togglebody = json.encode(@("action":"toggle_entity";"entity_type":"PERSON";"enabled":false));
  let togglereq = str.mockhttpreqwithbody("POST";"/api/privacy";togglebody);
  let toggleres = privacyapi.post(togglereq);
  results = str.arraypush(results;asserteq("privacy api toggle_entity returns 200";str.fromint(toggleres.status);str.fromint(200)));

  let layerbody = json.encode(@("action":"toggle_layer";"layer_id":"regex";"enabled":true));
  let layerreq = str.mockhttpreqwithbody("POST";"/api/privacy";layerbody);
  let layerres = privacyapi.post(layerreq);
  results = str.arraypush(results;asserteq("privacy api toggle_layer returns 200";str.fromint(layerres.status);str.fromint(200)));

  let badbody = json.encode(@("action":"nonexistent_action"));
  let badreq = str.mockhttpreqwithbody("POST";"/api/privacy";badbody);
  let badres = privacyapi.post(badreq);
  results = str.arraypush(results;asserteq("privacy api unknown action returns 400";str.fromint(badres.status);str.fromint(400)));

  let emptybody = json.encode(@("action":""));
  let emptyreq = str.mockhttpreqwithbody("POST";"/api/privacy";emptybody);
  let emptyres = privacyapi.post(emptyreq);
  results = str.arraypush(results;asserteq("privacy api empty action returns 400";str.fromint(emptyres.status);str.fromint(400)));

  let noactionbody = json.encode(@("preset":"strict"));
  let noactionreq = str.mockhttpreqwithbody("POST";"/api/privacy";noactionbody);
  let noactionres = privacyapi.post(noactionreq);
  results = str.arraypush(results;asserteq("privacy api missing action returns 400";str.fromint(noactionres.status);str.fromint(400)));

  if(str.contains(getres.body;"\"type\"")){
    results = str.arraypush(results;assertcontains("privacy api entity has label";getres.body;"\"label\""));
    results = str.arraypush(results;assertcontains("privacy api entity has enabled";getres.body;"\"enabled\""));
    results = str.arraypush(results;assertcontains("privacy api entity has sensitivity";getres.body;"\"sensitivity\""));
  }el{
    results = str.arraypush(results;asserttrue("privacy api entities empty (ok)";true))
  };

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

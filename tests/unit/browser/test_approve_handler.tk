m=test.browser.approvehandler;
i=t:std.test;
i=str:std.str;
i=approve:page.api.approve;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* approve.post exists and returns i64 *)
  let postreq=str.mockhttpreqwithbody("POST";"/api/approve";"{}");
  let postres=approve.post(postreq);
  if(t.assert(postres>0;"approve.post returns nonzero response handle")){pass=pass+1}el{fail=fail+1};

  (* response contains expected JSON fields *)
  let body=str.httpbody(postres);
  if(t.assert(str.contains(body;"\"ok\":true");"response contains ok true")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"action\"");"response contains action field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"approved\"");"action value is approved")){pass=pass+1}el{fail=fail+1};

  (* response is valid JSON *)
  if(t.assert(str.startswith(body;"{");"response starts with {")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(body;"}");"response ends with }")){pass=pass+1}el{fail=fail+1};

  (* no sensitive data in response *)
  if(t.assert(!str.contains(body;"api_key");"no api_key in response")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(body;"secret");"no secret in response")){pass=pass+1}el{fail=fail+1};

  <fail
};

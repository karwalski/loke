m=test.browser.approvehandler;
i=t:std.test;
i=str:std.str;
i=h:page.api.approve;

(* toke exposes no way to build an http request or read a response body from source (T-16),
   so a handler taking req:i64 cannot be unit-tested; its body-building functions can.

   GA5.26 - this endpoint used to be a STUB returning {"ok":true,"action":"approved"} for any
   request, and this test asserted that constant. It now decides an approval in
   core.governance.approvalgate, which tests/unit/governance/test_approval_gate.tk tests
   against a real store, and scripts/smoke_e2e.sh drives over HTTP. What is left here is the
   response contract and the decision vocabulary. *)

f=wellformed(body:str):bool{
  <str.startswith(body;"{") && str.endswith(body;"}")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let body=h.approvejson("approved";"abc123");
  if(t.assert(wellformed(body);"the success body is a well-formed JSON object")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"ok\":true");"it reports ok true")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"action\":\"approved\"");"it reports the action taken")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"approval_id\":\"abc123\"");"and the approval it was taken on")){pass=pass+1}el{fail=fail+1};

  let bad=h.failurejson("abc123";"already_consumed");
  if(t.assert(wellformed(bad) && str.contains(bad;"\"ok\":false");"a failure reports ok false")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(bad;"\"reason\":\"already_consumed\"");"and why")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(h.actionof("");"approved";"a bare approval_id approves")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(h.actionof("approve");"approved";"approve approves")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(h.actionof("decline");"declined";"decline declines")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(h.actionof("yes");"";"anything else is neither")){pass=pass+1}el{fail=fail+1};

  <fail
};

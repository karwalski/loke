m=test.browser.approvehandler;
i=t:std.test;
i=str:std.str;
i=h:page.api.approve;

(* Rewritten to call the handler's body function rather than str.mockhttpreq and
   str.httpbody, which exist in no module — this test had never compiled. toke exposes
   no way to build an http request or read a response body from source (T-16), so a
   handler taking req:i64 cannot be unit-tested; the body-building function can.

   This endpoint is a STUB — it returns fixed JSON and reads nothing. These
   assertions cover the response CONTRACT, not any behaviour. A green test here
   must not be read as the feature working. *)

f=jsonfields(body:str;fields:@str):bool{
  let ok=mut.true;
  lp(let i=0;i<fields.len;i=i+1){
    if(str.contains(body;fields.get(i))){}el{ok=false}
  };
  <ok
};

f=wellformed(body:str):bool{
  <str.startswith(body;"{") && str.endswith(body;"}")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let body=h.approvejson();
  if(t.assert(wellformed(body);"POST body is a well-formed JSON object")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"ok\":true");"approve reports ok true")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"action\":\"approved\"");"approve reports the action taken")){pass=pass+1}el{fail=fail+1};

  <fail
};

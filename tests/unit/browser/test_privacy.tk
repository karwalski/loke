
m=tests.unit.browser.testprivacy;

i=privacy:page.privacy;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let entities = privacy.entityconfigjson();
  results = str.arraypush(results;asserttrue("entity_config starts with [";str.startswith(entities;"[")));

  let layers = privacy.layerconfigjson();
  results = str.arraypush(results;asserttrue("layer_config starts with [";str.startswith(layers;"[")));

  let mockreq = str.mockhttpreq("GET";"/privacy");
  let res = privacy.get(mockreq);
  results = str.arraypush(results;asserteq("privacy get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("privacy response has preset-selector";res.body;"preset-selector"));

  results = str.arraypush(results;assertcontains("privacy response has layers-list";res.body;"layers-list"));

  results = str.arraypush(results;assertcontains("privacy response has entities-list";res.body;"entities-list"));

  let presetbody = json.encode(@("action":"set_preset";"preset":"strict"));
  let presetreq = str.mockhttpreqwithbody("POST";"/privacy";presetbody);
  let presetres = privacy.post(presetreq);
  results = str.arraypush(results;asserteq("set_preset returns 200";str.fromint(presetres.status);str.fromint(200)));

  let togglebody = json.encode(@("action":"toggle_entity";"entity_type":"PERSON";"enabled":false));
  let togglereq = str.mockhttpreqwithbody("POST";"/privacy";togglebody);
  let toggleres = privacy.post(togglereq);
  results = str.arraypush(results;asserteq("toggle_entity returns 200";str.fromint(toggleres.status);str.fromint(200)));

  let layerbody = json.encode(@("action":"toggle_layer";"layer_id":"regex";"enabled":true));
  let layerreq = str.mockhttpreqwithbody("POST";"/privacy";layerbody);
  let layerres = privacy.post(layerreq);
  results = str.arraypush(results;asserteq("toggle_layer returns 200";str.fromint(layerres.status);str.fromint(200)));

  let badbody = json.encode(@("action":"nonexistent"));
  let badreq = str.mockhttpreqwithbody("POST";"/privacy";badbody);
  let badres = privacy.post(badreq);
  results = str.arraypush(results;asserteq("unknown action returns 400";str.fromint(badres.status);str.fromint(400)));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

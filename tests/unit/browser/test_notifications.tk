
m=tests.unit.browser.testnotifications;

i=notif:browser.notifications;
i=str:std.string;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("missing: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let store=notif.newstore();
  results=str.arraypush(results;assertinteq("new store zero items";str.arraylen(notif.list(store));0));
  results=str.arraypush(results;assertinteq("new store zero unread";notif.unreadcount(store);0));

  let store2=notif.create(store;"info";"Test";"Test message";"loke.test");
  results=str.arraypush(results;assertinteq("create adds item";str.arraylen(notif.list(store2));1));
  results=str.arraypush(results;assertinteq("create unread 1";notif.unreadcount(store2);1));

  let store3=notif.create(store2;"success";"Done";"All good";"loke.test");
  results=str.arraypush(results;assertinteq("create second item";str.arraylen(notif.list(store3));2));
  results=str.arraypush(results;assertinteq("create second unread 2";notif.unreadcount(store3);2));

  let items=notif.list(store3);
  let firstnotif=str.arrayget(items;0);
  let store4=notif.markread(store3;firstnotif.id);
  results=str.arraypush(results;assertinteq("mark_read unread 1";notif.unreadcount(store4);1));

  let store4b=notif.markread(store4;firstnotif.id);
  results=str.arraypush(results;assertinteq("mark_read idempotent";notif.unreadcount(store4b);1));

  let store5=notif.markallread(store3);
  results=str.arraypush(results;assertinteq("mark_all_read unread 0";notif.unreadcount(store5);0));

  let store6=notif.remove(store3;firstnotif.id);
  results=str.arraypush(results;assertinteq("remove decrements count";str.arraylen(notif.list(store6));1));
  results=str.arraypush(results;assertinteq("remove decrements unread";notif.unreadcount(store6);1));

  let store7=notif.create(store;"error";"Error";"Something broke";"loke.test");
  let erritems=notif.list(store7);
  let errnotif=str.arrayget(erritems;0);
  results=str.arraypush(results;assertinteq("error dismiss_after 8000";errnotif.dismissafter;8000));

  let store8=notif.create(store;"info";"Info";"Notice";"loke.test");
  let infoitems=notif.list(store8);
  let infonotif=str.arrayget(infoitems;0);
  results=str.arraypush(results;assertinteq("info dismiss_after 5000";infonotif.dismissafter;5000));

  let bellhtml=notif.renderbell(store3);
  results=str.arraypush(results;assertcontains("bell has badge";bellhtml;"notification-badge"));
  results=str.arraypush(results;assertcontains("bell unread count";bellhtml;"2"));
  results=str.arraypush(results;assertcontains("bell aria-label";bellhtml;"aria-label=\"Notifications\""));
  results=str.arraypush(results;assertcontains("bell aria-haspopup";bellhtml;"aria-haspopup=\"true\""));

  let bellempty=notif.renderbell(store);
  results=str.arraypush(results;assertfalse("bell no badge when empty";str.contains(bellempty;"notification-badge")));

  let panelhtml=notif.renderpanel(store3);
  results=str.arraypush(results;assertcontains("panel role dialog";panelhtml;"role=\"dialog\""));
  results=str.arraypush(results;assertcontains("panel notification list";panelhtml;"notification-list"));
  results=str.arraypush(results;assertcontains("panel has title";panelhtml;"Test"));
  results=str.arraypush(results;assertcontains("panel has mark all read";panelhtml;"data-mark-all-read"));
  results=str.arraypush(results;assertcontains("panel unread class";panelhtml;"notification-unread"));

  let toastinfo=notif.$notification{
    id:"t1"; type:"info"; title:"Update"; message:"New version available";
    createdat:""; read:false; source:"loke"; actionurl:""; actionlabel:"";
    showtoast:true; dismissafter:5000
  };
  let toasthtml=notif.rendertoast(toastinfo);
  results=str.arraypush(results;assertcontains("toast info role status";toasthtml;"role=\"status\""));
  results=str.arraypush(results;assertcontains("toast info class";toasthtml;"toast-info"));
  results=str.arraypush(results;assertcontains("toast title";toasthtml;"Update"));
  results=str.arraypush(results;assertcontains("toast dismiss btn";toasthtml;"toast-dismiss"));

  let toasterr=notif.$notification{
    id:"t2"; type:"error"; title:"Error"; message:"Failed";
    createdat:""; read:false; source:"loke"; actionurl:""; actionlabel:"";
    showtoast:true; dismissafter:8000
  };
  let toasterrhtml=notif.rendertoast(toasterr);
  results=str.arraypush(results;assertcontains("toast error role alert";toasterrhtml;"role=\"alert\""));
  results=str.arraypush(results;assertcontains("toast error class";toasterrhtml;"toast-error"));

  let toastwarn=notif.$notification{
    id:"t3"; type:"warning"; title:"Warning"; message:"Caution";
    createdat:""; read:false; source:"loke"; actionurl:""; actionlabel:"";
    showtoast:true; dismissafter:5000
  };
  let toastwarnhtml=notif.rendertoast(toastwarn);
  results=str.arraypush(results;assertcontains("toast warning role alert";toastwarnhtml;"role=\"alert\""));

  let css=notif.styles();
  results=str.arraypush(results;assertcontains("styles bell";css;".notification-bell"));
  results=str.arraypush(results;assertcontains("styles toast";css;".toast"));
  results=str.arraypush(results;assertcontains("styles panel";css;".notification-panel"));
  results=str.arraypush(results;assertcontains("styles reduced motion";css;"prefers-reduced-motion"));

  let all = true;
  let ri = 0;
  let rn = str.arraylen(results);
  loop{
    if(ri >= rn){ break }el{
      let r = str.arrayget(results;ri);
      logresult(r);
      if(!$r.passed){ all = false }el{};
      ri = ri+1
    };
  };
  <all
};


m=tests.unit.browser.testnav;

i=nav:browser.nav;
i=str:std.string;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("missing: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let state=nav.newstate();
  results=str.arraypush(results;assertinteq("new state zero items";nav.itemcount(state);0));

  let items=@i64@();
  items:str.arraypush(items;nav.$navitem{
    id:"dash"; label:"Dashboard"; href:"#/dashboard";
    icon:"home"; badge:""; badgevariant:""; order:10;
    children:@i64@()
  });
  items:str.arraypush(items;nav.$navitem{
    id:"logs"; label:"Audit Logs"; href:"#/logs";
    icon:"list"; badge:"12"; badgevariant:"info"; order:20;
    children:@i64@()
  });
  let state2=nav.register(state;items);
  results=str.arraypush(results;assertinteq("register adds items";nav.itemcount(state2);2));

  let first=str.arrayget(state2.items;0);
  results=str.arraypush(results;asserteq("order sort first";first.id;"dash"));

  let more=@i64@();
  more:str.arraypush(more;nav.$navitem{
    id:"settings"; label:"Settings"; href:"#/settings";
    icon:"gear"; badge:""; badgevariant:""; order:15;
    children:@i64@()
  });
  let state3=nav.register(state2;more);
  results=str.arraypush(results;assertinteq("merge total items";nav.itemcount(state3);3));
  let second=str.arrayget(state3.items;1);
  results=str.arraypush(results;asserteq("order sort second is settings";second.id;"settings"));

  let ids=mut.@str@();
  ids=str.arraypush(ids;"settings");
  let state4=nav.unregister(state3;ids);
  results=str.arraypush(results;assertinteq("unregister removes item";nav.itemcount(state4);2));

  let state5=nav.setactive(state2;"#/dashboard");
  results=str.arraypush(results;asserteq("set_active href";state5.activehref;"#/dashboard"));

  let dashitem=str.arrayget(state2.items;0);
  results=str.arraypush(results;asserttrue("is_active match";nav.isactive(dashitem;"#/dashboard")));
  results=str.arraypush(results;assertfalse("is_active no match";nav.isactive(dashitem;"#/logs")));

  let parent=nav.$navitem{
    id:"parent"; label:"Parent"; href:"#/parent";
    icon:""; badge:""; badgevariant:""; order:1;
    children:@i64@()
  };
  let child=nav.$navitem{
    id:"child1"; label:"Child 1"; href:"#/parent/child1";
    icon:""; badge:""; badgevariant:""; order:1;
    children:@i64@()
  };
  parent.children=str.arraypush(parent.children;child);
  results=str.arraypush(results;asserttrue("is_active child match";nav.isactive(parent;"#/parent/child1")));

  let state6=nav.togglecompact(state2);
  results=str.arraypush(results;asserttrue("toggle compact on";state6.compact));
  let state7=nav.togglecompact(state6);
  results=str.arraypush(results;assertfalse("toggle compact off";state7.compact));

  let state8=nav.setactive(state2;"#/dashboard");
  let html=nav.render(state8);
  results=str.arraypush(results;assertcontains("render role tree";html;"role=\"tree\""));
  results=str.arraypush(results;assertcontains("render nav-item-active";html;"nav-item-active"));
  results=str.arraypush(results;assertcontains("render aria-current";html;"aria-current=\"page\""));
  results=str.arraypush(results;assertcontains("render dashboard link";html;"#/dashboard"));
  results=str.arraypush(results;assertcontains("render badge";html;"badge-info"));
  results=str.arraypush(results;assertcontains("render badge count";html;"12"));

  results=str.arraypush(results;assertcontains("render tabindex 0";html;"tabindex=\"0\""));
  results=str.arraypush(results;assertcontains("render tabindex -1";html;"tabindex=\"-1\""));

  let css=nav.styles();
  results=str.arraypush(results;assertcontains("styles nav-list";css;".nav-list"));
  results=str.arraypush(results;assertcontains("styles compact";css;"shell-sidebar-compact"));

  let all = true;
  let ri = 0;
  let rn = str.arraylen(results);
  loop{
    if(ri >= rn){ break }el{
      let r = str.arrayget(results;ri);
      logresult(r);
      if(!$r.passed){ all = false }el{};
      ri = ri+1
    };
  };
  <all
};

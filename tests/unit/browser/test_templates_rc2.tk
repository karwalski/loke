m=test.browser.templatesrc2;

i=t:std.test;
i=str:std.str;
i=tpl:ooke.template;

(* F10.8: every page template renders through the pinned ooke template engine (rc.2) with
   its title and its content. rc.2 ignores a directive it does not know, so tabs.tkt's
   `endblock` and privacy.tkt's `/block` never closed a block: both pages rendered the base
   layout alone, an empty title and no content, with no error. installer.tkt's `raw`
   directive rendered as nothing, so the page parsed an empty string and showed no hardware.
   This renders the real templates from the repository root, where run_tests.sh runs. *)

f=render(dir:str;name:str;ctx:@(str:str)):str{
  let file="\(dir)/\(name).tkt";
  <mt tpl.tplrenderfile(file;ctx;dir) {$ok:h h;$err:e ""}
};

f=checkapp(dir:str;names:@str):@i64{
  let pass=mut.0;
  let fail=mut.0;
  let empty=@("page.title":"x");
  let baselen=str.len(render(dir;"base";empty));
  lp(let i=0;i<names.len;i=i+1){
    let n=names.get(i);
    let out=render(dir;n;empty);
    if(t.assert(str.len(out)>0;"\(dir)/\(n).tkt renders")){pass=pass+1}el{fail=fail+1};
    if(t.assert(!str.contains(out;"<title></title>");"\(dir)/\(n).tkt fills the layout's title")){pass=pass+1}el{fail=fail+1};
    if(t.assert(str.len(out)>baselen+200;"\(dir)/\(n).tkt fills the layout's content, not the base layout alone")){pass=pass+1}el{fail=fail+1}
  };
  <@(pass;fail)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let lokedir="packages/browser/templates";
  let lokepages=@("approve";"chat";"index";"installer";"pipeline";"privacy";"savings";"setup";"tabs");
  let a=checkapp(lokedir;lokepages);
  pass=pass+a.get(0);
  fail=fail+a.get(1);

  let mokedir="packages/moke/templates";
  let mokepages=@("agents";"chat";"confirm";"connections";"dashboard";"governance";"index";"insight";"mcp";"memory";"presentation";"settings";"setup";"upload");
  let b=checkapp(mokedir;mokepages);
  pass=pass+b.get(0);
  fail=fail+b.get(1);

  let tabs=render(lokedir;"tabs";@("page.title":"x"));
  if(t.assert(str.contains(tabs;"tabs</title>");"/tabs carries its own title")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(tabs;".tabs-layout");"/tabs carries its content block")){pass=pass+1}el{fail=fail+1};
  let privacy=render(lokedir;"privacy";@("page.title":"x"));
  if(t.assert(str.contains(privacy;"Privacy Report</title>");"/privacy carries its own title")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(privacy;".privacy-hero");"/privacy carries its content block")){pass=pass+1}el{fail=fail+1};

  let hw="{\"chip\":\"M1 'Max'\",\"ram_gb\":16}";
  let inst=render(lokedir;"installer";@("page.title":"x";"hardware_json":hw;"models_json":"[]"));
  let want="data-hardware=\"{&quot;chip&quot;:&quot;M1 &#39;Max&#39;&quot;,&quot;ram_gb&quot;:16}\"";
  if(t.assert(str.contains(inst;want);"/installer hands the hardware JSON to the page, escaped for an attribute")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(inst;"data-models=\"[]\"");"/installer hands the model list to the page")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(inst;"JSON.parse('')");"/installer no longer parses an empty string")){pass=pass+1}el{fail=fail+1};

  <fail
};

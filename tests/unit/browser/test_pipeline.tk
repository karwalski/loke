
m=tests.unit.browser.testpipeline;

i=pipelinepage:page.pipeline;
i=str:std.string;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ <log.info(str.concat("PASS ";r.name)) }el{
    <log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @($result);

  let runs = pipelinepage.recentrunsjson(5);
  results = str.arraypush(results;asserttrue("recent_runs_json starts with [";str.startswith(runs;"[")));
  results = str.arraypush(results;asserttrue("recent_runs_json ends with ]";str.endswith(runs;"]")));

  let stages = pipelinepage.stagestatsjson();
  results = str.arraypush(results;asserttrue("stage_stats_json starts with [";str.startswith(stages;"[")));
  results = str.arraypush(results;asserttrue("stage_stats_json ends with ]";str.endswith(stages;"]")));

  let mockreq = str.mockhttpreq("GET";"/pipeline");
  let res = pipelinepage.get(mockreq);
  results = str.arraypush(results;asserteq("pipeline get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("pipeline response has pipeline-flow";res.body;"pipeline-flow"));

  results = str.arraypush(results;assertcontains("pipeline response has live-table";res.body;"live-table"));

  results = str.arraypush(results;assertcontains("pipeline response has auto-refresh";res.body;"auto-refresh"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;i < n;lv=lv){
    let r = str.arrayget(results;i);
    logresult(r);
    if(r.passed){ i = i+1 }el{ all = false; i = i+1 };
  };
  <all
};

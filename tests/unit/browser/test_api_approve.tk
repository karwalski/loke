
m=tests.unit.browser.testapiapprove;

i=approveapi:api.approve;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let cancelbody = json.encode(@("approved":false));
  let cancelreq = str.mockhttpreqwithbody("POST";"/api/approve";cancelbody);
  let cancelres = approveapi.post(cancelreq);
  results = str.arraypush(results;asserteq("approve api cancel returns 200";str.fromint(cancelres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("approve api cancel has ok";cancelres.body;"\"ok\":true"));
  results = str.arraypush(results;assertcontains("approve api cancel action";cancelres.body;"\"action\":\"cancelled\""));

  let emptybody = json.encode(@("anonymised":"test text"));
  let emptyreq = str.mockhttpreqwithbody("POST";"/api/approve";emptybody);
  let emptyres = approveapi.post(emptyreq);
  results = str.arraypush(results;asserteq("approve api missing approved returns 200";str.fromint(emptyres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("approve api missing approved is cancelled";emptyres.body;"cancelled"));

  let approvebody = json.encode(@(
    "approved":true;
    "anonymised":"What is the weather today?";
    "system_prompt":"";
    "dont_ask_again":false
  ));
  let approvereq = str.mockhttpreqwithbody("POST";"/api/approve";approvebody);
  let approveres = approveapi.post(approvereq);
  let validstatus = approveres.status = 200 || approveres.status = 500;
  results = str.arraypush(results;asserttrue("approve api dispatch returns 200 or 500";validstatus));

  if(approveres.status = 200){
    results = str.arraypush(results;assertcontains("approve api has approved action";approveres.body;"\"action\":\"approved\""));
    results = str.arraypush(results;assertcontains("approve api has response";approveres.body;"\"response\""));
    results = str.arraypush(results;assertcontains("approve api has model_id";approveres.body;"\"model_id\""));
    results = str.arraypush(results;assertcontains("approve api has tokens_in";approveres.body;"\"tokens_in\""));
    results = str.arraypush(results;assertcontains("approve api has tokens_out";approveres.body;"\"tokens_out\""));
  }el{
    results = str.arraypush(results;asserttrue("approve api dispatch error (infra)";true))
  };

  let daabody = json.encode(@(
    "approved":true;
    "anonymised":"test text";
    "system_prompt":"";
    "dont_ask_again":true
  ));
  let daareq = str.mockhttpreqwithbody("POST";"/api/approve";daabody);
  let daares = approveapi.post(daareq);
  let daavalid = daares.status = 200 || daares.status = 500;
  results = str.arraypush(results;asserttrue("approve api dont_ask_again accepted";daavalid));

  results = str.arraypush(results;asserttrue("approve api cancel is JSON";str.startswith(cancelres.body;"{")));
  results = str.arraypush(results;asserttrue("approve api cancel ends }";str.endswith(cancelres.body;"}")));

  let hintbody = json.encode(@(
    "approved":true;
    "anonymised":"test";
    "system_prompt":"";
    "dont_ask_again":false;
    "model":"llama3.2"
  ));
  let hintreq = str.mockhttpreqwithbody("POST";"/api/approve";hintbody);
  let hintres = approveapi.post(hintreq);
  let hintvalid = hintres.status = 200 || hintres.status = 500;
  results = str.arraypush(results;asserttrue("approve api model hint accepted";hintvalid));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

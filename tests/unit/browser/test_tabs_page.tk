
m=tests.unit.browser.testtabspage;

i=tabspage:page.tabs;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let tabs = tabspage.tabsjson();
  results = str.arraypush(results;asserttrue("tabs_json starts with [";str.startswith(tabs;"[")));
  results = str.arraypush(results;asserttrue("tabs_json ends with ]";str.endswith(tabs;"]")));

  let active = tabspage.activejson();
  let validactive = str.eq(active;"null") || str.startswith(active;"{");
  results = str.arraypush(results;asserttrue("active_json is null or object";validactive));

  let bookmarks = tabspage.bookmarksjson();
  results = str.arraypush(results;asserttrue("bookmarks_json starts with [";str.startswith(bookmarks;"[")));

  let mockreq = str.mockhttpreq("GET";"/tabs");
  let res = tabspage.get(mockreq);
  results = str.arraypush(results;asserteq("tabs get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("tabs response has tab-list";res.body;"tab-list"));
  results = str.arraypush(results;assertcontains("tabs response has new-tab-form";res.body;"new-tab-form"));
  results = str.arraypush(results;assertcontains("tabs response has tab-preview-wrap";res.body;"tab-preview-wrap"));

  results = str.arraypush(results;assertcontains("tabs response has keydown listener";res.body;"keydown"));

  results = str.arraypush(results;assertcontains("tabs response has draggable support";res.body;"draggable"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

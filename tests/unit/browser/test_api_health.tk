
m=tests.unit.browser.testapihealth;

i=health:api.health;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=assertnotcontains(n:$str;haystack:$str;needle:$str):$result{
  if(!str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("should not contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let mockreq = str.mockhttpreq("GET";"/api/health");
  let res = health.get(mockreq);
  results = str.arraypush(results;asserteq("health get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("health response has ok true";res.body;"\"ok\":true"));

  results = str.arraypush(results;assertcontains("health response has version";res.body;"\"version\""));

  results = str.arraypush(results;assertcontains("health response has ollama";res.body;"\"ollama\""));

  results = str.arraypush(results;assertcontains("health response has port";res.body;"\"port\""));

  results = str.arraypush(results;asserttrue("health response is JSON object";str.startswith(res.body;"{")));
  results = str.arraypush(results;asserttrue("health response ends with }";str.endswith(res.body;"}")));

  let hasrunning = str.contains(res.body;"\"running\"");
  let hasstopped = str.contains(res.body;"\"stopped\"");
  let hasunreachable = str.contains(res.body;"\"unreachable\"");
  let validollama = hasrunning || hasstopped || hasunreachable;
  results = str.arraypush(results;asserttrue("health ollama status is valid enum";validollama));

  results = str.arraypush(results;assertnotcontains("health no api_key leak";res.body;"api_key"));
  results = str.arraypush(results;assertnotcontains("health no secret leak";res.body;"secret"));

  results = str.arraypush(results;asserteq("health content-type";res.contenttype;"application/json"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};


m=tests.unit.browser.testcomponents;

i=btn:browser.components.button;
i=inp:browser.components.input;
i=modal:browser.components.modal;
i=card:browser.components.card;
i=form:browser.components.form;
i=table:browser.components.table;
i=str:std.string;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("missing: ";needle))
  };
};

f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ <log.info(str.concat("PASS ";r.name)) }el{
    <log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @($result);

  let bcfg=btn.defaultconfig();
  results=str.arraypush(results;asserteq("btn default variant";bcfg.variant;"primary"));

  results=str.arraypush(results;asserteq("btn variant primary";btn.variantclass("primary");"btn btn-primary"));
  results=str.arraypush(results;asserteq("btn variant secondary";btn.variantclass("secondary");"btn btn-secondary"));
  results=str.arraypush(results;asserteq("btn variant danger";btn.variantclass("danger");"btn btn-danger"));
  results=str.arraypush(results;asserteq("btn variant ghost";btn.variantclass("ghost");"btn btn-ghost"));

  results=str.arraypush(results;asserteq("btn size sm";btn.sizeclass("sm");"btn-sm"));
  results=str.arraypush(results;asserteq("btn size lg";btn.sizeclass("lg");"btn-lg"));
  results=str.arraypush(results;asserteq("btn size md";btn.sizeclass("md");""));

  let disabledcfg=btn.defaultconfig();
  disabledcfg.label="Save";
  disabledcfg.disabled=true;
  let disabledhtml=btn.render(disabledcfg);
  results=str.arraypush(results;assertcontains("btn disabled attr";disabledhtml;"disabled"));
  results=str.arraypush(results;assertcontains("btn aria-disabled";disabledhtml;"aria-disabled=\"true\""));

  let loadingcfg=btn.defaultconfig();
  loadingcfg.label="Loading";
  loadingcfg.loading=true;
  let loadinghtml=btn.render(loadingcfg);
  results=str.arraypush(results;assertcontains("btn loading class";loadinghtml;"btn-loading"));
  results=str.arraypush(results;assertcontains("btn loading spinner";loadinghtml;"btn-spinner"));
  results=str.arraypush(results;assertcontains("btn loading aria-busy";loadinghtml;"aria-busy=\"true\""));

  let labelcfg=btn.defaultconfig();
  labelcfg.label="Click me";
  let labelhtml=btn.render(labelcfg);
  results=str.arraypush(results;assertcontains("btn label text";labelhtml;"Click me"));

  let btncss=btn.styles();
  results=str.arraypush(results;assertcontains("btn styles has .btn";btncss;".btn"));
  results=str.arraypush(results;assertcontains("btn styles has focus-visible";btncss;"focus-visible"));

  let icfg=inp.defaultinput();
  icfg.id="email";
  icfg.label="Email";
  icfg.type="email";
  let inputhtml=inp.renderinput(icfg);
  results=str.arraypush(results;assertcontains("input label for";inputhtml;"for=\"email\""));
  results=str.arraypush(results;assertcontains("input label text";inputhtml;"Email"));

  let errcfg=inp.defaultinput();
  errcfg.id="name";
  errcfg.label="Name";
  errcfg.error="Name is required";
  let errhtml=inp.renderinput(errcfg);
  results=str.arraypush(results;assertcontains("input error message";errhtml;"Name is required"));
  results=str.arraypush(results;assertcontains("input aria-invalid";errhtml;"aria-invalid=\"true\""));
  results=str.arraypush(results;assertcontains("input error class";errhtml;"form-input-error"));

  let hintcfg=inp.defaultinput();
  hintcfg.id="pass";
  hintcfg.label="Password";
  hintcfg.hint="At least 8 characters";
  let hinthtml=inp.renderinput(hintcfg);
  results=str.arraypush(results;assertcontains("input hint text";hinthtml;"At least 8 characters"));

  let cbcfg=$checkboxconfig{
    id:"agree";
    name:"agree";
    label:"I agree";
    checked:true;
    disabled:false;
    error:""
  };
  let cbhtml=inp.rendercheckbox(cbcfg);
  results=str.arraypush(results;assertcontains("checkbox type";cbhtml;"type=\"checkbox\""));
  results=str.arraypush(results;assertcontains("checkbox checked";cbhtml;"checked"));
  results=str.arraypush(results;assertcontains("checkbox label";cbhtml;"I agree"));

  let mcfg=modal.defaultconfig();
  mcfg.title="Confirm";
  mcfg.body="<p>Are you sure?</p>";
  let modalhtml=modal.render(mcfg);
  results=str.arraypush(results;assertcontains("modal role";modalhtml;"role=\"dialog\""));
  results=str.arraypush(results;assertcontains("modal aria-modal";modalhtml;"aria-modal=\"true\""));
  results=str.arraypush(results;assertcontains("modal title";modalhtml;"Confirm"));
  results=str.arraypush(results;assertcontains("modal body";modalhtml;"Are you sure?"));

  results=str.arraypush(results;assertcontains("modal close btn";modalhtml;"modal-close"));

  let ccfg=card.defaultconfig();
  ccfg.header="Stats";
  ccfg.body="<p>Content</p>";
  ccfg.footer="<button>OK</button>";
  let cardhtml=card.render(ccfg);
  results=str.arraypush(results;assertcontains("card header";cardhtml;"card-header"));
  results=str.arraypush(results;assertcontains("card body";cardhtml;"card-body"));
  results=str.arraypush(results;assertcontains("card footer";cardhtml;"card-footer"));
  results=str.arraypush(results;assertcontains("card header text";cardhtml;"Stats"));

  let iccard=card.defaultconfig();
  iccard.body="test";
  iccard.interactive=true;
  let ichtml=card.render(iccard);
  results=str.arraypush(results;assertcontains("card interactive tabindex";ichtml;"tabindex=\"0\""));
  results=str.arraypush(results;assertcontains("card interactive class";ichtml;"card-interactive"));

  let req=form.required("Required");
  results=str.arraypush(results;asserttrue("form required pass";form.validaterule("hello";req)));

  results=str.arraypush(results;assertfalse("form required fail empty";form.validaterule("";req)));

  results=str.arraypush(results;assertfalse("form required fail spaces";form.validaterule("   ";req)));

  let ml=form.minlength(3;"Too short");
  results=str.arraypush(results;asserttrue("form min_length pass";form.validaterule("abc";ml)));
  results=str.arraypush(results;assertfalse("form min_length fail";form.validaterule("ab";ml)));

  let mx=form.maxlength(5;"Too long");
  results=str.arraypush(results;asserttrue("form max_length pass";form.validaterule("hello";mx)));
  results=str.arraypush(results;assertfalse("form max_length fail";form.validaterule("toolong";mx)));

  let em=form.email("Invalid email");
  results=str.arraypush(results;asserttrue("form email pass";form.validaterule("a@b.c";em)));
  results=str.arraypush(results;assertfalse("form email fail no at";form.validaterule("abc";em)));
  results=str.arraypush(results;assertfalse("form email fail no dot";form.validaterule("a@b";em)));

  let rules=@($rule);
  rules=str.arraypush(rules;form.required("Name required"));
  rules=str.arraypush(rules;form.minlength(2;"At least 2 chars"));
  results=str.arraypush(results;asserteq("form field empty error";form.validatefield("";rules);"Name required"));
  results=str.arraypush(results;asserteq("form field short error";form.validatefield("a";rules);"At least 2 chars"));
  results=str.arraypush(results;asserteq("form field valid";form.validatefield("ab";rules);""));

  let tcfg=table.defaultconfig();
  tcfg.label="Users";
  let cols=@($column);
  cols=str.arraypush(cols;$column{id:"name";label:"Name";sortable:true;align:""});
  cols=str.arraypush(cols;$column{id:"email";label:"Email";sortable:false;align:""});
  tcfg.columns=cols;
  let tblopen=table.renderopen(tcfg);
  results=str.arraypush(results;assertcontains("table wrapper";tblopen;"table-wrapper"));
  results=str.arraypush(results;assertcontains("table aria-label";tblopen;"aria-label=\"Users\""));
  results=str.arraypush(results;assertcontains("table thead";tblopen;"<thead>"));
  results=str.arraypush(results;assertcontains("table sortable btn";tblopen;"table-sort-btn"));

  let cells=@($str);
  cells=str.arraypush(cells;"Alice");
  cells=str.arraypush(cells;"alice@test.com");
  let rowhtml=table.renderrow(cells);
  results=str.arraypush(results;assertcontains("table row tr";rowhtml;"<tr>"));
  results=str.arraypush(results;assertcontains("table row td alice";rowhtml;"Alice"));

  results=str.arraypush(results;assertcontains("table styles";table.styles();".table"));

  let all = true;
  let ri = 0;
  let rn = str.arraylen(results);
  lp(let lv=0;ri < rn;lv=lv){
    let r = str.arrayget(results;ri);
    logresult(r);
    if(r.passed){ ri = ri+1 }el{ all = false; ri = ri+1 };
  };
  <all
};

m=test.browser.settingshandler;
i=t:std.test;
i=str:std.str;
i=json:std.json;
i=settings:browser.pages.api.settings;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* settings.get exists and returns i64 *)
  let getreq=str.mockhttpreq("GET";"/api/settings");
  let getres=settings.get(getreq);
  if(t.assert(getres>0;"settings.get returns nonzero response handle")){pass=pass+1}el{fail=fail+1};

  (* response contains expected fields *)
  let body=str.httpbody(getres);
  if(t.assert(str.contains(body;"\"anthropic\"");"response contains anthropic field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"openai\"");"response contains openai field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"port\"");"response contains port field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"ollama_url\"");"response contains ollama_url field")){pass=pass+1}el{fail=fail+1};

  (* response is valid JSON *)
  if(t.assert(str.startswith(body;"{");"response starts with {")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(body;"}");"response ends with }")){pass=pass+1}el{fail=fail+1};

  (* API keys are masked — should never show full keys *)
  if(t.assert(!str.contains(body;"sk-ant-");"anthropic key is not shown in full")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(body;"sk-proj-");"openai key is not shown in full")){pass=pass+1}el{fail=fail+1};

  (* maskkey helper tests *)
  let masked=settings.maskkey("sk-ant-abc123xyz");
  if(t.assert(str.startswith(masked;"sk-a");"maskkey preserves first 4 chars")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(masked;"****");"maskkey appends asterisks")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(masked;"abc123");"maskkey hides remainder")){pass=pass+1}el{fail=fail+1};

  (* maskkey with short input returns empty *)
  let shortmask=settings.maskkey("abc");
  if(t.assert(str.eq(shortmask;"");"maskkey returns empty for short input")){pass=pass+1}el{fail=fail+1};

  (* settings.post exists and returns i64 *)
  let postbody="{\"key\":\"port\",\"value\":\"11430\"}";
  let postreq=str.mockhttpreqwithbody("POST";"/api/settings";postbody);
  let postres=settings.post(postreq);
  if(t.assert(postres>0;"settings.post returns nonzero response handle")){pass=pass+1}el{fail=fail+1};
  let postbodyresp=str.httpbody(postres);
  if(t.assert(str.contains(postbodyresp;"\"ok\":true");"post response has ok true")){pass=pass+1}el{fail=fail+1};

  <fail
};

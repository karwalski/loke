m=test.browser.settingshandler;
i=t:std.test;
i=str:std.str;
i=h:browser.pages.api.settings;

(* Rewritten against settingsjson() and maskkey(), rather than str.mockhttpreq and
   str.httpbody which exist in no module — this had never compiled.

   The assertion that matters is the masking one. A settings endpoint that returned an
   API key in full would be a disclosure, and nothing tested for it. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let body=h.settingsjson();
  if(t.assert(str.startswith(body;"{") && str.endswith(body;"}");"body is a well-formed JSON object")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"anthropic\"");"response contains the anthropic field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"openai\"");"response contains the openai field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"port\"");"response contains the port field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"ollama_url\"");"response contains the ollama_url field")){pass=pass+1}el{fail=fail+1};

  (* Masking, directly: four characters then stars, and never the rest of the key. *)
  let masked=h.maskkey("sk-ant-super-secret-value");
  if(t.assert(str.contains(masked;"****");"a masked key is starred")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(masked;"secret");"a masked key does not carry the secret")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(masked)<9;"a masked key is a prefix plus stars, not the whole key")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(h.maskkey("abc");"";"a key too short to mask returns empty rather than itself")){pass=pass+1}el{fail=fail+1};

  (* And the rendered body must never contain a whole key, however it was obtained. *)
  if(t.assert(!str.contains(body;"sk-ant-");"no unmasked anthropic key in the body")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.browser.servemain;
i=t:std.test;
i=str:std.str;
i=handlers:ooke.handlers;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* serve_main depends on handlers.registerall — verify the contract *)
  (* registerall must return a non-empty list of paths *)
  let paths=handlers.registerall();
  if(t.assert(paths.len>0;"registerall returns paths for serve_main")){pass=pass+1}el{fail=fail+1};

  (* the main entry point expects registerall to provide handler paths *)
  (* verify minimum expected route count: 7 API + page routes *)
  if(t.assert(paths.len>=7;"at least 7 routes registered for server")){pass=pass+1}el{fail=fail+1};

  (* verify all API handler paths are present for routing *)
  let pathstr=str.join(paths;",");
  if(t.assert(str.contains(pathstr;"/api/health");"health API available for serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/pipeline");"pipeline API available for serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/models");"models API available for serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/settings");"settings API available for serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/privacy");"privacy API available for serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/savings");"savings API available for serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(pathstr;"/api/tabs");"tabs API available for serve")){pass=pass+1}el{fail=fail+1};

  (* verify index route is present — serves as the landing page *)
  if(t.assert(str.contains(pathstr;"/");"index route available for serve")){pass=pass+1}el{fail=fail+1};

  (* handler delegation works end-to-end: get request through wrapper *)
  let req=str.mockhttpreq("GET";"/api/health");
  let res=handlers.hapihealthget(req);
  let body=str.httpbody(res);
  if(t.assert(str.contains(body;"\"ok\"");"serve delegates to health handler correctly")){pass=pass+1}el{fail=fail+1};

  (* post handler delegation works *)
  let postreq=str.mockhttpreqwithbody("POST";"/api/approve";"{}");
  let postres=handlers.hapiapprovepost(postreq);
  let postbody=str.httpbody(postres);
  if(t.assert(str.contains(postbody;"\"ok\":true");"serve delegates to approve post handler")){pass=pass+1}el{fail=fail+1};

  <fail
};

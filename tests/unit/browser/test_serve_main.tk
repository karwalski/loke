m=test.browser.servemain;
i=t:std.test;
i=str:std.str;
i=handlers:ooke.handlers;

(* Rewritten against registerall()'s return value. The original called
   str.mockhttpreq and str.httpbody — helpers that exist in no module — so it had never
   compiled, and its "serve delegates to the health handler" assertions cannot be
   written at all: toke exposes no way to construct an http request from source (T-16).
   What IS checkable is that every expected route is registered, which is what the
   generated registry exists to do. *)

f=has(paths:@str;path:str):bool{
  let found=mut.false;
  lp(let i=0;i<paths.len;i=i+1){
    if(str.eq(paths.get(i);path)){found=true}el{}
  };
  <found
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let paths=handlers.registerall();
  if(t.assert(paths.len>=7;"the server has at least seven routes to serve")){pass=pass+1}el{fail=fail+1};

  (* Every route main.tk hands to serve.serverun must be one the registry knows. *)
  if(t.assert(has(paths;"/api/health");"health is available to serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/pipeline");"pipeline is available to serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/models");"models is available to serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/settings");"settings is available to serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/privacy");"privacy is available to serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/savings");"savings is available to serve")){pass=pass+1}el{fail=fail+1};
  if(t.assert(has(paths;"/api/tabs");"tabs is available to serve")){pass=pass+1}el{fail=fail+1};

  (* No duplicate registrations: two handlers on one path would make which one runs
     depend on registration order. *)
  let dupes=mut.0;
  lp(let i=0;i<paths.len;i=i+1){
    lp(let j=0;j<paths.len;j=j+1){
      if(i<j){
        if(str.eq(paths.get(i);paths.get(j))){dupes=dupes+1}el{}
      }el{}
    }
  };
  if(t.assert(dupes==0;"no path is registered twice")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.browser.pipelinehandler;
i=t:std.test;
i=str:std.str;
i=json:std.json;
i=pipe:browser.pages.api.pipeline;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* pipeline.get returns a valid response *)
  let getreq=str.mockhttpreq("GET";"/api/pipeline");
  let getres=pipe.get(getreq);
  if(t.assert(getres>0;"pipeline.get returns nonzero response handle")){pass=pass+1}el{fail=fail+1};
  let getbody=str.httpbody(getres);
  if(t.assert(str.contains(getbody;"\"ok\":true");"get response contains ok true")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(getbody;"\"status\"");"get response contains status field")){pass=pass+1}el{fail=fail+1};

  (* post with empty text returns 400 *)
  let emptybody="{\"text\":\"\",\"system_prompt\":\"\"}";
  let emptyreq=str.mockhttpreqwithbody("POST";"/api/pipeline";emptybody);
  let emptyres=pipe.post(emptyreq);
  let emptystatus=str.httpstatus(emptyres);
  if(t.asserteq(emptystatus;400;"empty text returns 400")){pass=pass+1}el{fail=fail+1};
  let emptymsg=str.httpbody(emptyres);
  if(t.assert(str.contains(emptymsg;"\"ok\":false");"empty text error has ok false")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(emptymsg;"text field is required");"empty text error mentions text required")){pass=pass+1}el{fail=fail+1};

  (* post with missing body returns 400 *)
  let nobodyreq=str.mockhttpreqwithbody("POST";"/api/pipeline";"{}");
  let nobodyres=pipe.post(nobodyreq);
  let nobodystatus=str.httpstatus(nobodyres);
  if(t.asserteq(nobodystatus;400;"missing text field returns 400")){pass=pass+1}el{fail=fail+1};

  (* sensitivitylabel helper returns correct strings *)
  if(t.assert(str.eq(pipe.sensitivitylabel($public);"PUBLIC");"public label")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(pipe.sensitivitylabel($internal);"INTERNAL");"internal label")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(pipe.sensitivitylabel($confidential);"CONFIDENTIAL");"confidential label")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(pipe.sensitivitylabel($restricted);"RESTRICTED");"restricted label")){pass=pass+1}el{fail=fail+1};

  (* parsetolerance helper returns correct variants *)
  let tinstant=pipe.parsetolerance("instant");
  if(t.assert(tinstant==$instant;"parsetolerance instant")){pass=pass+1}el{fail=fail+1};
  let tpatient=pipe.parsetolerance("patient");
  if(t.assert(tpatient==$patient;"parsetolerance patient")){pass=pass+1}el{fail=fail+1};
  let tbackground=pipe.parsetolerance("background");
  if(t.assert(tbackground==$background;"parsetolerance background")){pass=pass+1}el{fail=fail+1};
  let tunknown=pipe.parsetolerance("xyz");
  if(t.assert(tunknown==$instant;"parsetolerance unknown defaults to instant")){pass=pass+1}el{fail=fail+1};

  (* risktierstr helper returns correct strings *)
  if(t.assert(str.eq(pipe.risktierstr($low);"low");"risktier low")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(pipe.risktierstr($medium);"medium");"risktier medium")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(pipe.risktierstr($high);"high");"risktier high")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(pipe.risktierstr($critical);"critical");"risktier critical")){pass=pass+1}el{fail=fail+1};

  (* isdeny helper *)
  if(t.assert(!pipe.isdeny($allow);"allow is not deny")){pass=pass+1}el{fail=fail+1};
  if(t.assert(pipe.isdeny($deny:"blocked");"deny is deny")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pipe.isdeny($allowwithwarning:"warn");"allowwithwarning is not deny")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pipe.isdeny($requireapproval:"approve");"requireapproval is not deny")){pass=pass+1}el{fail=fail+1};

  (* getpolicymessage helper *)
  if(t.assert(str.eq(pipe.getpolicymessage($allow);"");"allow has empty message")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(pipe.getpolicymessage($deny:"nope");"nope");"deny returns reason")){pass=pass+1}el{fail=fail+1};

  <fail
};

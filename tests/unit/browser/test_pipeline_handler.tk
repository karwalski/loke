m=test.browser.pipelinehandler;
i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=pipe:core.privacy.pipeline;
i=h:page.api.pipeline;
i=clk:shared.types;

(* The original test called str.mockhttpreq, str.httpbody and str.httpstatus, none of
   which exist in any module, and referenced pipe.risktierstr, pipe.isdeny and
   pipe.getpolicymessage, which the handler has never exported. It had never compiled.

   It also wrote payload variants as `$deny:"blocked"`, which is not how a variant is
   constructed — that form does not parse.

   What this covers now is the property NC1.9 is about, at the level the handler
   works at: the privacy fields it renders come from a real pipeline run, and a run
   that scanned nothing is refused rather than forwarded. The request-level assertions
   cannot be written until toke exposes a way to build an http request (T-16). *)

f=configlocalonly():$pipelineconfig{
  (* Unprivileged ports nothing listens on, so NER and Presidio are genuinely down and
     only the in-process regex layer runs. *)
  <pipe.newconfig("http://127.0.0.1:59998";"http://127.0.0.1:59999")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* The handler renders privacy metadata from a $pipelinerun. With the sidecars down
     the run must still complete on regex alone, and must say so. *)
  let run=pipe.runforward("contact alice@example.com about the invoice";"";configlocalonly());
  if(t.assert(str.contains(h.privacyfields(run);"\"entities_found\":1");"the rendered metadata reports the entity the regex layer found")){pass=pass+1}el{fail=fail+1};

  let run=pipe.runforward("contact alice@example.com about the invoice";"";configlocalonly());
  if(t.assert(str.contains(h.privacyfields(run);"\"layers_degraded\":2");"the rendered metadata reports both unavailable layers")){pass=pass+1}el{fail=fail+1};

  let run=pipe.runforward("contact alice@example.com about the invoice";"";configlocalonly());
  if(t.assert(str.contains(h.privacyfields(run);"\"sensitivity\":\"confidential\"");"an email is rendered as confidential")){pass=pass+1}el{fail=fail+1};

  (* The metadata must never carry the detected value itself — it is shown in a
     browser, and the whole point is that the value does not travel. *)
  let run=pipe.runforward("contact alice@example.com about the invoice";"";configlocalonly());
  if(t.assert(!str.contains(h.privacyfields(run);"alice@example.com");"the rendered metadata does not carry the detected value")){pass=pass+1}el{fail=fail+1};

  (* Clean text: zero entities, still forwardable. *)
  let run=pipe.runforward("the quarterly figures look fine";"";configlocalonly());
  if(t.assert(str.contains(h.privacyfields(run);"\"entities_found\":0");"clean text reports no entities")){pass=pass+1}el{fail=fail+1};

  (* And the refusal path, which is the reason this endpoint was held back: a run that
     scanned nothing is not safe to forward however empty it looks. *)
  let nothingscanned=$pipelinerun{
    result:$piidetectionresult{
      original:"medicare 1234 56789 1";
      anonymised:"medicare 1234 56789 1";
      entities:@();
      sensitivity:sh.public()
    };
    stages:@();
    totalentities:0 as u32;
    finalsystemprompt:"";
    requestid:"test-unscanned";
    layerscompleted:0 as u32;
    layersdegraded:3 as u32;
    unplaced:0 as u32;
    vetoedby:"";
    layererror:""
  };
  if(t.assert(!pipe.issafetoforward(nothingscanned);"an unscanned run is refused, not forwarded")){pass=pass+1}el{fail=fail+1};

  (* X4.7. /api/settings saves a key to the keychain and removes it from settings.json,
     so the keychain value must win. This file used to read settings.json only, so a key
     saved through the UI was never found. The keychain call itself is not exercised:
     a headless test cannot answer its authorisation dialog (see core.storage.keychain). *)
  if(t.asserteq(h.resolvekey("sk-from-keychain";"{\"anthropic_api_key\":\"sk-from-json\"}";"anthropic_api_key");"sk-from-keychain";"a key in the keychain wins over settings.json")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(h.resolvekey("";"{\"anthropic_api_key\":\"sk-from-json\"}";"anthropic_api_key");"sk-from-json";"with nothing in the keychain, a legacy settings.json key is still found")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(h.resolvekey("sk-from-keychain";"{}";"anthropic_api_key");"sk-from-keychain";"a key saved through /api/settings, which leaves settings.json without it, is found")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(h.resolvekey("";"{}";"anthropic_api_key");"";"and no key anywhere is empty, so the route is refused")){pass=pass+1}el{fail=fail+1};

  (* GA5.28. The budget's day number was str.nowunix()/86400, an ADDRESS divided by a day,
     so "today" changed with the allocator and the daily budget reset or persisted by accident. *)
  if(t.assert(h.daynumber()==clk.nowi64()/86400;"the budget day is today's unix day")){pass=pass+1}el{fail=fail+1};

  (* F5.12. Ollama names carry a tag; an untagged id means :latest. *)
  if(t.assert(h.isinstalled("llama3";@("llama3:latest";"mistral:7b"));"an untagged id matches its :latest install")){pass=pass+1}el{fail=fail+1};
  if(t.assert(h.isinstalled("mistral:7b";@("llama3:latest";"mistral:7b"));"an exact tag matches")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!h.isinstalled("qwen2.5:7b";@("llama3:latest"));"a model that is not listed is not installed")){pass=pass+1}el{fail=fail+1};

  <fail
};

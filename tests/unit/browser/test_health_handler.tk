m=test.browser.healthhandler;
i=t:std.test;
i=str:std.str;
i=json:std.json;
i=health:browser.pages.api.health;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* health.get exists and returns i64 *)
  let req=str.mockhttpreq("GET";"/api/health");
  let res=health.get(req);
  if(t.assert(res>0;"health.get returns nonzero response handle")){pass=pass+1}el{fail=fail+1};

  (* response body is valid JSON with expected fields *)
  let body=str.httpbody(res);
  if(t.assert(str.contains(body;"\"ok\":true");"response contains ok true")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"loke\"");"response contains loke version field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"ollama\"");"response contains ollama status field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"port\"");"response contains port field")){pass=pass+1}el{fail=fail+1};

  (* ollama status is a valid enum value *)
  let hasrunning=str.contains(body;"\"running\"");
  let hasoffline=str.contains(body;"\"offline\"");
  if(t.assert(hasrunning||hasoffline;"ollama status is running or offline")){pass=pass+1}el{fail=fail+1};

  (* response is a well-formed JSON object *)
  if(t.assert(str.startswith(body;"{");"response starts with {")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(body;"}");"response ends with }")){pass=pass+1}el{fail=fail+1};

  (* no sensitive data leaked *)
  if(t.assert(!str.contains(body;"api_key");"no api_key in response")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(body;"secret");"no secret in response")){pass=pass+1}el{fail=fail+1};

  (* version string is present *)
  if(t.assert(str.contains(body;"0.2.0");"version 0.2.0 present")){pass=pass+1}el{fail=fail+1};

  <fail
};

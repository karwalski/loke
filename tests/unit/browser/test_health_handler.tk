m=test.browser.healthhandler;
i=t:std.test;
i=str:std.str;
i=health:page.api.health;
i=pipe:core.privacy.pipeline;
i=op:core.privacy.orgpolicy;

(* This test called str.mockhttpreq and str.httpbody — helpers that exist in no
   module — so it had never compiled, and neither had the other nine tests under
   tests/unit/browser. toke exposes no way to build an http request or read a response
   body from source, so a handler taking req:i64 cannot be unit-tested as written.

   The handler now builds its body in healthjson(), which takes no request. That is
   what these assertions were actually about: every one of them inspected the JSON. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let body=health.healthjson();

  if(t.assert(str.contains(body;"\"ok\":true");"response contains ok true")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"loke\"");"response contains the loke version field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"ollama\"");"response contains the ollama status field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"port\":11430");"response reports loke's port")){pass=pass+1}el{fail=fail+1};

  (* The status must be one of the two values, and must reflect the probe rather than
     being pinned to one of them — the previous handler compared an http result to a
     string and so always reported "offline". *)
  let status=health.ollamastatus();
  if(t.assert(str.eq(status;"running")||str.eq(status;"offline");"ollama status is running or offline")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;str.concat("\"ollama\":\"";status));"the body carries the probed status, not a constant")){pass=pass+1}el{fail=fail+1};

  (* F3b.6. The privacy layers the request path runs, each with its state, probed through
     core.privacy.layerhealth. The runner gives this test an empty HOME, so the privacy
     filter is off; regex is in-process and always healthy. *)
  if(t.assert(str.contains(body;"\"privacy_layers\":{\"state\":");"the body carries the privacy layers' overall state")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"{\"id\":\"regex\",\"enabled\":true,\"state\":\"healthy\"");"and regex, healthy")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"{\"id\":\"openai-privacy-filter\",\"enabled\":false,\"state\":\"disabled\"");"and the privacy filter, disabled")){pass=pass+1}el{fail=fail+1};
  (* Per layer, from the config handed in: NER and Presidio on ports nothing listens on. *)
  let dead=health.privacylayersjson(pipe.newconfig("http://127.0.0.1:59992";"http://127.0.0.1:59991"));
  if(t.assert(str.contains(dead;"{\"id\":\"ner\",\"enabled\":true,\"state\":\"unavailable\",\"reason\":\"Ollama unreachable\",");"an enabled NER that does not answer is reported unavailable, with the reason")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(dead;"{\"id\":\"presidio\",\"enabled\":true,\"state\":\"unavailable\"");"and so is Presidio")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(dead;"\"state\":\"degraded\"");"and the layers as a whole are degraded")){pass=pass+1}el{fail=fail+1};

  (* F3b.8 (3). The layers as a request runs them: the organisation policy applied over
     config.toml, each field it changed named. With no policy file, nothing is marked. *)
  if(t.assert(str.contains(body;"\"policy_changed\":[]") && str.contains(body;"\"org_policy\":{\"present\":false");"with no policy, no layer is marked changed by one")){pass=pass+1}el{fail=fail+1};
  let banned=health.privacylayersjson(pipe.withorgpolicy(pipe.newconfig("http://127.0.0.1:59992";"http://127.0.0.1:59991");op.fromtext("{\"banned_layers\":[\"ner\"]}")));
  if(t.assert(str.contains(banned;"{\"id\":\"ner\",\"enabled\":false,\"state\":\"disabled\"") && str.contains(banned;"\"policy_changed\":[\"enabled\"]");"a layer the policy bans is reported off, marked changed by the policy (\(banned))")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.browser.savingshandler;
i=t:std.test;
i=str:std.str;
i=h:page.api.savings;

(* Rewritten to call the handler's body function rather than str.mockhttpreq and
   str.httpbody, which exist in no module — this test had never compiled. toke exposes
   no way to build an http request or read a response body from source (T-16), so a
   handler taking req:i64 cannot be unit-tested; the body-building function can.

   This endpoint is a STUB — it returns fixed JSON and reads nothing. These
   assertions cover the response CONTRACT, not any behaviour. A green test here
   must not be read as the feature working. *)

f=jsonfields(body:str;fields:@str):bool{
  let ok=mut.true;
  lp(let i=0;i<fields.len;i=i+1){
    if(str.contains(body;fields.get(i))){}el{ok=false}
  };
  <ok
};

f=wellformed(body:str):bool{
  <str.startswith(body;"{") && str.endswith(body;"}")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let body=h.savingsjson();
  if(t.assert(wellformed(body);"GET body is a well-formed JSON object")){pass=pass+1}el{fail=fail+1};
  if(t.assert(jsonfields(body;@("\"tokens_saved\"";"\"cost_saved_usd\"";"\"requests\""));"response carries all three savings fields")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"tokens_saved\":0");"tokens_saved defaults to 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"requests\":0");"requests defaults to 0")){pass=pass+1}el{fail=fail+1};
  let post=h.savingspostjson();
  if(t.assert(str.contains(post;"\"ok\":true");"POST body reports ok true")){pass=pass+1}el{fail=fail+1};

  <fail
};

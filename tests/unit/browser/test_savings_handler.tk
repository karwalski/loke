m=test.browser.savingshandler;
i=t:std.test;
i=str:std.str;
i=savings:page.api.savings;

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* savings.get exists and returns i64 *)
  let getreq=str.mockhttpreq("GET";"/api/savings");
  let getres=savings.get(getreq);
  if(t.assert(getres>0;"savings.get returns nonzero response handle")){pass=pass+1}el{fail=fail+1};

  (* response contains expected JSON fields *)
  let body=str.httpbody(getres);
  if(t.assert(str.contains(body;"\"tokens_saved\"");"response contains tokens_saved field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"cost_saved_usd\"");"response contains cost_saved_usd field")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"requests\"");"response contains requests field")){pass=pass+1}el{fail=fail+1};

  (* response is valid JSON *)
  if(t.assert(str.startswith(body;"{");"response starts with {")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.endswith(body;"}");"response ends with }")){pass=pass+1}el{fail=fail+1};

  (* default values are zero *)
  if(t.assert(str.contains(body;"\"tokens_saved\":0");"tokens_saved defaults to 0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"cost_saved_usd\":0.0");"cost_saved_usd defaults to 0.0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"requests\":0");"requests defaults to 0")){pass=pass+1}el{fail=fail+1};

  (* savings.post exists and returns i64 *)
  let postreq=str.mockhttpreqwithbody("POST";"/api/savings";"{}");
  let postres=savings.post(postreq);
  if(t.assert(postres>0;"savings.post returns nonzero response handle")){pass=pass+1}el{fail=fail+1};
  let postbody=str.httpbody(postres);
  if(t.assert(str.contains(postbody;"\"ok\":true");"post response has ok true")){pass=pass+1}el{fail=fail+1};

  <fail
};

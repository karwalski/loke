m=tests.unit.browser.testsavings;

i=savings:page.savings;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertcontains(n:str;haystack:str;needle:str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let summary = savings.summaryjson("today");
  results = str.arraypush(results;asserttrue("summary_json starts with {";str.startswith(summary;"{")));
  results = str.arraypush(results;assertcontains("summary_json has tokens_saved";summary;"tokens_saved"));
  results = str.arraypush(results;assertcontains("summary_json has cost_saved_usd";summary;"cost_saved_usd"));
  results = str.arraypush(results;assertcontains("summary_json has cache_hit_rate";summary;"cache_hit_rate"));

  let providers = savings.providerbreakdownjson("today");
  results = str.arraypush(results;asserttrue("provider_breakdown starts with [";str.startswith(providers;"[")));

  let ts = savings.timeseriesjson("today");
  results = str.arraypush(results;asserttrue("timeseries starts with [";str.startswith(ts;"[")));

  let cache = savings.cachestatsjson();
  results = str.arraypush(results;asserttrue("cache_stats starts with {";str.startswith(cache;"{")));
  results = str.arraypush(results;assertcontains("cache_stats has total_entries";cache;"total_entries"));

  let mockreq = str.mockhttpreq("GET";"/savings");
  let res = savings.get(mockreq);
  results = str.arraypush(results;asserteq("savings get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("savings response has stat-card";res.body;"stat-card"));

  results = str.arraypush(results;assertcontains("savings response has export";res.body;"Export"));

  results = str.arraypush(results;assertcontains("savings response has provider-table";res.body;"provider-table"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i+1 }el{ all = false; i = i+1 }
    }
  };
  <all
};

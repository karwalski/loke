
m=tests.unit.browser.testsetup;

i=setup:page.setup;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let hw = setup.hardwarejson();
  results = str.arraypush(results;asserttrue("hardware_json starts with {";str.startswith(hw;"{")));
  results = str.arraypush(results;assertcontains("hardware_json has ollama_status";hw;"ollama_status"));
  results = str.arraypush(results;assertcontains("hardware_json has version";hw;"version"));

  let completed = setup.setupcompleted();
  results = str.arraypush(results;asserttrue("setup not completed initially";!$completed));

  let mockreq = str.mockhttpreq("GET";"/setup");
  let res = setup.get(mockreq);
  results = str.arraypush(results;asserteq("setup get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("setup response has wizard";res.body;"wizard"));
  results = str.arraypush(results;assertcontains("setup response has step-1";res.body;"step-1"));
  results = str.arraypush(results;assertcontains("setup response has step-6";res.body;"step-6"));

  results = str.arraypush(results;assertcontains("setup response has preset-strict";res.body;"preset-strict"));
  results = str.arraypush(results;assertcontains("setup response has preset-balanced";res.body;"preset-balanced"));

  let postbody = json.encode(@("privacy_preset":"balanced"));
  let postreq = str.mockhttpreqwithbody("POST";"/setup";postbody);
  let postres = setup.post(postreq);
  results = str.arraypush(results;asserteq("setup post returns 200";str.fromint(postres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("setup post confirms completion";postres.body;"setup_completed"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

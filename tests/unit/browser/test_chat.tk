
m=tests.unit.browser.testchat;

i=chat:page.chat;
i=str:std.string;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let models = chat.modellistjson();
  results = str.arraypush(results;asserttrue("model_list_json starts with [";str.startswith(models;"[")));
  results = str.arraypush(results;asserttrue("model_list_json ends with ]";str.endswith(models;"]")));

  let label = chat.privacypresetlabel();
  let validlabel = str.eq(label;"Strict") || str.eq(label;"Balanced") || str.eq(label;"Open");
  results = str.arraypush(results;asserttrue("privacy_preset_label returns valid label";validlabel));

  let mockreq = str.mockhttpreq("GET";"/chat");
  let res = chat.get(mockreq);
  results = str.arraypush(results;asserteq("chat get returns 200";str.fromint(res.status);str.fromint(200)));

  results = str.arraypush(results;assertcontains("chat response has messages div";res.body;"messages"));

  results = str.arraypush(results;assertcontains("chat response has model-select";res.body;"model-select"));

  results = str.arraypush(results;assertcontains("chat response has privacy filter ref";res.body;"privacy"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

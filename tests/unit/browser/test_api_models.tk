
m=tests.unit.browser.testapimodels;

i=models:api.models;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let mockreq = str.mockhttpreq("GET";"/api/models");
  let res = models.get(mockreq);
  let validstatus = res.status = 200 || res.status = 502;
  results = str.arraypush(results;asserttrue("models get returns 200 or 502";validstatus));

  if(res.status = 200){
    results = str.arraypush(results;asserttrue("models response starts with [";str.startswith(res.body;"[")));
    results = str.arraypush(results;asserttrue("models response ends with ]";str.endswith(res.body;"]")));
  }el{
    results = str.arraypush(results;assertcontains("models error has Ollama mention";res.body;"Ollama"));
  };

  results = str.arraypush(results;asserteq("models content-type";res.contenttype;"application/json"));

  if(res.status = 200){
    if(!str.eq(res.body;"@()")){
      results = str.arraypush(results;assertcontains("models has id field";res.body;"\"id\""));
      results = str.arraypush(results;assertcontains("models has size field";res.body;"\"size\""));
      results = str.arraypush(results;assertcontains("models has running field";res.body;"\"running\""));
    }el{
      results = str.arraypush(results;asserteq("models empty array";res.body;"@()"))
    };
  }el{()};

  if(res.status = 200){
    if(!str.eq(res.body;"@()")){
      let hastrue = str.contains(res.body;"\"running\":true");
      let hasfalse = str.contains(res.body;"\"running\":false");
      let hasrunningbool = hastrue || hasfalse;
      results = str.arraypush(results;asserttrue("models running is boolean";hasrunningbool));
    }el{()};
  }el{()};

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

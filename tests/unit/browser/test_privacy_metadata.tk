



m=tests.unit.browser.testprivacymetadata;

i=pm:loke.browser.workspace.privacymetadata;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  
  let attrsa = @(str);
  attrsa = str.arraypush(attrsa;"RESTRICTED");
  attrsa = str.arraypush(attrsa;"PUBLIC");
  results = str.arraypush(results;asserteq("resolve_page_sensitivity RESTRICTED wins";pm.resolvepagesensitivity(attrsa);"RESTRICTED"));

  
  let attrsb = @(str);
  attrsb = str.arraypush(attrsb;"CONFIDENTIAL");
  attrsb = str.arraypush(attrsb;"INTERNAL");
  results = str.arraypush(results;asserteq("resolve_page_sensitivity CONFIDENTIAL over INTERNAL";pm.resolvepagesensitivity(attrsb);"CONFIDENTIAL"));

  
  let attrsc = @(str);
  attrsc = str.arraypush(attrsc;"PUBLIC");
  attrsc = str.arraypush(attrsc;"PUBLIC");
  results = str.arraypush(results;asserteq("resolve_page_sensitivity PUBLIC";pm.resolvepagesensitivity(attrsc);"PUBLIC"));

  
  let attrsempty = @(str);
  results = str.arraypush(results;asserteq("resolve_page_sensitivity empty attrs PUBLIC";pm.resolvepagesensitivity(attrsempty);"PUBLIC"));

  
  let attrse = @(str);
  attrse = str.arraypush(attrse;"INTERNAL");
  results = str.arraypush(results;asserteq("resolve_page_sensitivity INTERNAL";pm.resolvepagesensitivity(attrse);"INTERNAL"));

  
  let robotsgptbot = "User-agent: GPTBot
Disallow: /";
  let directivesf = pm.parserobotstxt(robotsgptbot;"https://example.com");
  let dircount = str.arraylen(directivesf);
  results = str.arraypush(results;asserttrue("parse_robots_txt GPTBot produces directives";dircount > 1));
  let dirf = str.arrayget(directivesf;0);
  results = str.arraypush(results;asserttrue("parse_robots_txt GPTBot disallow_ai true";dirf.disallowai));

  
  let directivesempty = pm.parserobotstxt("";"https://example.com");
  let aidisallowedempty = pm.checkaidisallowed(directivesempty);
  results = str.arraypush(results;assertfalse("parse_robots_txt empty disallow_ai false";aidisallowedempty));

  
  let robotsclaude = "User-agent: ClaudeBot
Disallow: /";
  let directivesh = pm.parserobotstxt(robotsclaude;"https://example.com");
  let aidisallowedh = pm.checkaidisallowed(directivesh);
  results = str.arraypush(results;asserttrue("parse_robots_txt ClaudeBot disallow_ai true";aidisallowedh));

  
  let htmlattr = "<div data-ai-sensitivity=\"RESTRICTED\">content</div>";
  let attrvals = pm.detectdataaiattrs(htmlattr);
  let attrcount = str.arraylen(attrvals);
  results = str.arraypush(results;assertinteq("detect_data_ai_attrs finds one attr";attrcount;1));
  let attrval = str.arrayget(attrvals;0);
  results = str.arraypush(results;asserteq("detect_data_ai_attrs value RESTRICTED";attrval;"RESTRICTED"));

  
  let htmlnoattr = "<div class=\"public\">no sensitivity attr</div>";
  let noattrs = pm.detectdataaiattrs(htmlnoattr);
  results = str.arraypush(results;assertinteq("detect_data_ai_attrs no attr empty";str.arraylen(noattrs);0));

  
  let restrictedhtml = "<div data-ai-sensitivity=\"RESTRICTED\">x</div>";
  let metarestricted = pm.buildmetadata("https://x.com";"";restrictedhtml);
  let note = pm.compliancenote(metarestricted);
  results = str.arraypush(results;asserttrue("compliance_note RESTRICTED non-empty";str.len(note) > 0));

  
  let metapublic = pm.buildmetadata("https://x.com";"";"<div>public page</div>");
  let publicnote = pm.compliancenote(metapublic);
  results = str.arraypush(results;asserteq("compliance_note PUBLIC empty";publicnote;""));

  
  let robotsdisallow = "User-agent: GPTBot
Disallow: /";
  let metadisallow = pm.buildmetadata("https://x.com";robotsdisallow;"<p>content</p>");
  let disallownote = pm.compliancenote(metadisallow);
  results = str.arraypush(results;asserttrue("compliance_note disallow_ai non-empty";str.len(disallownote) > 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    }
  };
  <all
};

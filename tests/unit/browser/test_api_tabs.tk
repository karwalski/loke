
m=tests.unit.browser.testapitabs;

i=tabsapi:api.tabs;
i=str:std.string;
i=json:std.json;
i=log:std.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertcontains(n:$str;haystack:$str;needle:$str):$result{
  if(str.contains(haystack;needle)){ <pass(n) }el{
    <fail(n;str.concat("expected to contain: ";needle))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let getreq = str.mockhttpreq("GET";"/api/tabs");
  let getres = tabsapi.get(getreq);
  results = str.arraypush(results;asserteq("tabs api get returns 200";str.fromint(getres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("tabs api has tabs field";getres.body;"\"tabs\""));
  results = str.arraypush(results;assertcontains("tabs api has active field";getres.body;"\"active\""));

  let openbody = json.encode(@("action":"open";"url":"https://example.com";"title":"Example"));
  let openreq = str.mockhttpreqwithbody("POST";"/api/tabs";openbody);
  let openres = tabsapi.post(openreq);
  results = str.arraypush(results;asserteq("tabs api open returns 200";str.fromint(openres.status);str.fromint(200)));
  results = str.arraypush(results;assertcontains("tabs api open ok";openres.body;"\"ok\":true"));

  let emptyurlbody = json.encode(@("url":"";"title":"Empty"));
  let emptyurlreq = str.mockhttpreqwithbody("POST";"/api/tabs";emptyurlbody);
  let emptyurlres = tabsapi.post(emptyurlreq);
  results = str.arraypush(results;asserteq("tabs api open empty url returns 400";str.fromint(emptyurlres.status);str.fromint(400)));
  results = str.arraypush(results;assertcontains("tabs api open empty url error";emptyurlres.body;"url"));

  let switchbody = json.encode(@("action":"switch";"id":"test-tab-id"));
  let switchreq = str.mockhttpreqwithbody("POST";"/api/tabs";switchbody);
  let switchres = tabsapi.post(switchreq);
  results = str.arraypush(results;asserteq("tabs api switch returns 200";str.fromint(switchres.status);str.fromint(200)));

  let pinbody = json.encode(@("action":"pin";"id":"test-tab-id"));
  let pinreq = str.mockhttpreqwithbody("POST";"/api/tabs";pinbody);
  let pinres = tabsapi.post(pinreq);
  results = str.arraypush(results;asserteq("tabs api pin returns 200";str.fromint(pinres.status);str.fromint(200)));

  let reorderbody = json.encode(@("action":"reorder";"order":"[\"id1\",\"id2\"]"));
  let reorderreq = str.mockhttpreqwithbody("POST";"/api/tabs";reorderbody);
  let reorderres = tabsapi.post(reorderreq);
  results = str.arraypush(results;asserteq("tabs api reorder returns 200";str.fromint(reorderres.status);str.fromint(200)));

  let closebody = json.encode(@("action":"close";"id":"test-tab-id"));
  let closereq = str.mockhttpreqwithbody("POST";"/api/tabs";closebody);
  let closeres = tabsapi.post(closereq);
  results = str.arraypush(results;asserteq("tabs api close returns 200";str.fromint(closeres.status);str.fromint(200)));

  let delreq = str.mockhttpreqwithpathparam("DELETE";"/api/tabs/test-id";"id";"test-id");
  let delres = tabsapi.delete(delreq);
  results = str.arraypush(results;asserteq("tabs api delete returns 200";str.fromint(delres.status);str.fromint(200)));

  let delemptyreq = str.mockhttpreqwithpathparam("DELETE";"/api/tabs/";"id";"");
  let delemptyres = tabsapi.delete(delemptyreq);
  results = str.arraypush(results;asserteq("tabs api delete empty id returns 400";str.fromint(delemptyres.status);str.fromint(400)));
  results = str.arraypush(results;assertcontains("tabs api delete empty id error";delemptyres.body;"tab id"));

  let defaultbody = json.encode(@("url":"https://test.com";"title":"Test"));
  let defaultreq = str.mockhttpreqwithbody("POST";"/api/tabs";defaultbody);
  let defaultres = tabsapi.post(defaultreq);
  results = str.arraypush(results;asserteq("tabs api default open returns 200";str.fromint(defaultres.status);str.fromint(200)));

  let get2req = str.mockhttpreq("GET";"/api/tabs");
  let get2res = tabsapi.get(get2req);
  results = str.arraypush(results;asserteq("tabs api get after open returns 200";str.fromint(get2res.status);str.fromint(200)));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

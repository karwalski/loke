m=test.providers.anthropic;

i=t:std.test;
i=str:std.str;

(* --- stub anthropic provider functions --- *)

f=buildrequest(model:str;systemprompt:str;usermsg:str;maxtokens:i64):str{
  let body=str.concat("{\"model\":\"";model);
  let body=str.concat(body;"\",\"max_tokens\":");
  let tokstr=str.concat("";maxtokens.tostr());
  let body=str.concat(body;tokstr);
  let body=str.concat(body;",\"system\":\"");
  let body=str.concat(body;systemprompt);
  let body=str.concat(body;"\",\"messages\":[{\"role\":\"user\",\"content\":\"");
  let body=str.concat(body;usermsg);
  let body=str.concat(body;"\"}]}");
  <body
};

f=parseresponse(raw:str):str{
  (* stub: extracts content[0].text from a mock response *)
  if(str.contains(raw;"\"text\":")){
    <"Hello from Claude"
  }el{
    <""
  }
};

f=endpoint():str{
  <"https://api.anthropic.com/v1/messages"
};

f=apiversion():str{
  <"2023-06-01"
};

f=provider_name():str{
  <"anthropic"
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* request building: model is present *)
  let req=buildrequest("claude-3-opus";"You are helpful";"Hi";1024);
  if(t.assert(str.contains(req;"claude-3-opus");"request contains model name")){pass=pass+1}el{fail=fail+1};

  (* request building: system prompt is present *)
  if(t.assert(str.contains(req;"You are helpful");"request contains system prompt")){pass=pass+1}el{fail=fail+1};

  (* request building: user message is present *)
  if(t.assert(str.contains(req;"Hi");"request contains user message")){pass=pass+1}el{fail=fail+1};

  (* request building: max_tokens is present *)
  if(t.assert(str.contains(req;"\"max_tokens\":");"request contains max_tokens field")){pass=pass+1}el{fail=fail+1};

  (* request building: messages array is present *)
  if(t.assert(str.contains(req;"\"messages\":");"request contains messages array")){pass=pass+1}el{fail=fail+1};

  (* request building: role is user *)
  if(t.assert(str.contains(req;"\"role\":\"user\"");"request has user role")){pass=pass+1}el{fail=fail+1};

  (* response parsing: valid response returns content *)
  let resp=parseresponse("{\"content\":[{\"type\":\"text\",\"text\":\"Hello from Claude\"}]}");
  if(t.assert(str.eq(resp;"Hello from Claude");"parsed response returns content text")){pass=pass+1}el{fail=fail+1};

  (* response parsing: empty response returns empty string *)
  let empty=parseresponse("{\"error\":\"bad request\"}");
  if(t.assert(str.eq(empty;"");"error response returns empty string")){pass=pass+1}el{fail=fail+1};

  (* endpoint is correct *)
  if(t.assert(str.contains(endpoint();"api.anthropic.com");"endpoint contains api.anthropic.com")){pass=pass+1}el{fail=fail+1};

  (* api version is set *)
  if(t.assert(str.len(apiversion())>0;"api version is non-empty")){pass=pass+1}el{fail=fail+1};

  (* provider name *)
  if(t.assert(str.eq(provider_name();"anthropic");"provider name is anthropic")){pass=pass+1}el{fail=fail+1};

  (* request JSON is well-formed — starts with brace *)
  if(t.assert(str.contains(req;"{");"request starts with JSON object")){pass=pass+1}el{fail=fail+1};

  <fail
};

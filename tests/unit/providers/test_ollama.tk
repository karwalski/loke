m=test.providers.ollama;

i=t:std.test;
i=str:std.str;

(* --- stub ollama provider functions --- *)

f=parsehealthcheck(raw:str):bool{
  <str.contains(raw;"\"status\":\"ok\"")
};

f=parsegenerateresponse(raw:str):str{
  if(str.contains(raw;"\"response\":")){
    <"Ollama says hello"
  }el{
    <""
  }
};

f=endpoint():str{
  <"http://localhost:11434"
};

f=provider_name():str{
  <"ollama"
};

f=buildgeneraterequest(model:str;prompt:str):str{
  let body=str.concat("{\"model\":\"";model);
  let body=str.concat(body;"\",\"prompt\":\"");
  let body=str.concat(body;prompt);
  let body=str.concat(body;"\",\"stream\":false}");
  <body
};

f=islocal():bool{
  <true
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* health check: healthy response *)
  if(t.assert(parsehealthcheck("{\"status\":\"ok\"}");"healthy response parsed correctly")){pass=pass+1}el{fail=fail+1};

  (* health check: unhealthy response *)
  if(t.assert(!parsehealthcheck("{\"status\":\"error\"}");"unhealthy response returns false")){pass=pass+1}el{fail=fail+1};

  (* health check: empty response *)
  if(t.assert(!parsehealthcheck("");"empty response returns false")){pass=pass+1}el{fail=fail+1};

  (* generate response: valid *)
  let resp=parsegenerateresponse("{\"response\":\"Ollama says hello\",\"done\":true}");
  if(t.assert(str.eq(resp;"Ollama says hello");"valid generate response parsed")){pass=pass+1}el{fail=fail+1};

  (* generate response: error *)
  let empty=parsegenerateresponse("{\"error\":\"model not found\"}");
  if(t.assert(str.eq(empty;"");"error generate response returns empty")){pass=pass+1}el{fail=fail+1};

  (* generate response: non-empty has length *)
  if(t.assert(str.len(resp)>0;"parsed generate response is non-empty")){pass=pass+1}el{fail=fail+1};

  (* endpoint is localhost *)
  if(t.assert(str.contains(endpoint();"localhost");"endpoint is localhost")){pass=pass+1}el{fail=fail+1};

  (* endpoint uses port 11434 *)
  if(t.assert(str.contains(endpoint();"11434");"endpoint uses port 11434")){pass=pass+1}el{fail=fail+1};

  (* provider name *)
  if(t.assert(str.eq(provider_name();"ollama");"provider name is ollama")){pass=pass+1}el{fail=fail+1};

  (* build generate request: model present *)
  let req=buildgeneraterequest("llama3";"What is loke?");
  if(t.assert(str.contains(req;"llama3");"generate request contains model")){pass=pass+1}el{fail=fail+1};

  (* build generate request: prompt present *)
  if(t.assert(str.contains(req;"What is loke?");"generate request contains prompt")){pass=pass+1}el{fail=fail+1};

  (* build generate request: stream false *)
  if(t.assert(str.contains(req;"\"stream\":false");"generate request has stream false")){pass=pass+1}el{fail=fail+1};

  (* is local provider *)
  if(t.assert(islocal();"ollama is a local provider")){pass=pass+1}el{fail=fail+1};

  <fail
};

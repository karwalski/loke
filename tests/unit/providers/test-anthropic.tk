
m=tests.unit.providers.testanthropic;

i=disp:core.providers.dispatcher;
i=pt:core.providers.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=makeanthropicreq(model:$str):i64{
  let msg = pt.usermsg("Test prompt for Anthropic");
  <$pt.completionrequest{
    modelid:$model;
    messages:@$msg;
    systemprompt:"You are a helpful assistant.";
    maxtokens:256;
    temperature:0.0;
    stream:false
  };
};

f=runall():bool{
  let results = @$result@();

  let keys = $disp.$apikeys{anthropic:"sk-ant-test-key";openai:""};
  let d = disp.new(keys;"");

  results = str.arraypush(results;asserteq("anthropic key stored";d.keys.anthropic;"sk-ant-test-key"));

  let req = makeanthropicreq("claude-sonnet-4-20250514");
  let result = disp.dispatch(d;req;$provider.$mt:anthropic) {
    $ok:resp { <"reached_anthropic" };
    $err:e {
      if(str.contains(e.message;"provider not yet supported")){
        <"wrong_branch"
      }el{
        <"reached_anthropic"
      };
    };
  };
  results = str.arraypush(results;asserteq("dispatch reaches anthropic branch";result;"reached_anthropic"));

  let req2 = makeanthropicreq("claude-3-5-haiku-20241022");
  results = str.arraypush(results;asserteq("request stores anthropic model";req2.modelid;"claude-3-5-haiku-20241022"));

  results = str.arraypush(results;asserteq("system_prompt stored";req2.systemprompt;"You are a helpful assistant."));

  results = str.arraypush(results;asserttrue("max_tokens is 256";req2.maxtokens = 256));

  results = str.arraypush(results;asserttrue("temperature is 0.0";req2.temperature = 0.0));

  results = str.arraypush(results;assertfalse("stream is false";req2.stream));

  results = str.arraypush(results;asserttrue("messages has 1 entry";req2.messages.len = 1));

  let resp = $pt.completionresponse{
    content:"Here is the answer.";
    modelid:"claude-sonnet-4-20250514";
    inputtokens:15;
    outputtokens:8;
    finishreason:"end_turn";
    costusd:0.0003
  };
  results = str.arraypush(results;asserteq("response model_id";resp.modelid;"claude-sonnet-4-20250514"));
  results = str.arraypush(results;asserteq("response finish_reason";resp.finishreason;"end_turn"));
  results = str.arraypush(results;asserttrue("response cost_usd > 0";resp.costusd > 0.0));

  let emptykeys = $disp.$apikeys{anthropic:"";openai:""};
  let d2 = disp.new(emptykeys;"");
  results = str.arraypush(results;asserteq("empty key dispatcher created";d2.keys.anthropic;""));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};

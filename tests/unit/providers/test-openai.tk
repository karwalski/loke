
m=tests.unit.providers.testopenai;

i=disp:core.providers.dispatcher;
i=pt:core.providers.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=makeopenaireq(model:$str):$pt.completionrequest{
  let msg = pt.usermsg("Test prompt for OpenAI");
  <$pt.completionrequest{
    modelid:$model;
    messages:@(msg);
    systemprompt:"";
    maxtokens:128;
    temperature:0.7;
    stream:true
  };
};

f=runall():bool{
  let results = @$result@();

  let keys = $disp.$apikeys{anthropic:"";openai:"sk-oai-test-key"};
  let d = disp.new(keys;"");

  results = str.arraypush(results;asserteq("openai key stored";d.keys.openai;"sk-oai-test-key"));

  let req = makeopenaireq("gpt-4o");
  let result = disp.dispatch(d;req;$provider.$mt openai) {
    $ok:resp { <"reached_openai" };
    $err:e {
      if(str.contains(e.message;"provider not yet supported")){
        <"wrong_branch"
      }el{
        <"reached_openai"
      };
    };
  };
  results = str.arraypush(results;asserteq("dispatch reaches openai branch";result;"reached_openai"));

  let reqmini = makeopenaireq("gpt-4o-mini");
  results = str.arraypush(results;asserteq("request stores gpt-4o-mini";reqmini.modelid;"gpt-4o-mini"));

  results = str.arraypush(results;asserttrue("stream is true";reqmini.stream));

  results = str.arraypush(results;asserttrue("temperature is 0.7";reqmini.temperature = 0.7));

  results = str.arraypush(results;asserteq("empty system_prompt";reqmini.systemprompt;""));

  let resp = $pt.completionresponse{
    content:"OpenAI response text";
    modelid:"gpt-4o";
    inputtokens:20;
    outputtokens:12;
    finishreason:"stop";
    costusd:0.0001
  };
  results = str.arraypush(results;asserteq("response model_id is gpt-4o";resp.modelid;"gpt-4o"));
  results = str.arraypush(results;asserteq("response finish_reason is stop";resp.finishreason;"stop"));
  results = str.arraypush(results;asserttrue("response input_tokens > 0";resp.inputtokens > 0));
  results = str.arraypush(results;asserttrue("response output_tokens > 0";resp.outputtokens > 0));

  let msgsys = pt.systemmsg("You are a coding assistant");
  let msgusr = pt.usermsg("Write a function");
  let msgasst = pt.assistantmsg("Here is the function:");
  let msgusr2 = pt.usermsg("Add error handling");
  let multireq = $pt.completionrequest{
    modelid:"gpt-4o";
    messages:@(msgsys;msgusr;msgasst;msgusr2);
    systemprompt:"";
    maxtokens:512;
    temperature:0.0;
    stream:false
  };
  results = str.arraypush(results;asserttrue("multi-message request has 4 messages";multireq.messages.len = 4));

  let largereq = makeopenaireq("gpt-4o");
  results = str.arraypush(results;asserttrue("max_tokens is positive";largereq.maxtokens > 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};

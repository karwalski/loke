
m=tests.unit.providers.testollama;

i=disp:core.providers.dispatcher;
i=pt:core.providers.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=makeollamareq(model:$str):i64{
  let msg = pt.usermsg("Test prompt for Ollama");
  <$pt.completionrequest{
    modelid:$model;
    messages:@$msg;
    systemprompt:"";
    maxtokens:512;
    temperature:0.8;
    stream:false
  };
};

f=runall():bool{
  let results = @$result@();

  let keys = $disp.$apikeys{anthropic:"";openai:""};
  let d = disp.new(keys;"http://127.0.0.1:11434");
  results = str.arraypush(results;asserteq("ollama_url stored";d.ollamaurl;"http://127.0.0.1:11434"));

  let req = makeollamareq("qwen2.5:7b");
  let result = disp.dispatch(d;req;$provider.$mt:ollama) {
    $ok:resp { <"reached_ollama" };
    $err:e {
      if(str.contains(e.message;"provider not yet supported")){
        <"wrong_branch"
      }el{
        <"reached_ollama"
      };
    };
  };
  results = str.arraypush(results;asserteq("dispatch reaches ollama branch";result;"reached_ollama"));

  let req2 = makeollamareq("llama3.1:8b");
  results = str.arraypush(results;asserteq("request stores llama model";req2.modelid;"llama3.1:8b"));

  results = str.arraypush(results;asserttrue("temperature is 0.8";req2.temperature = 0.8));

  results = str.arraypush(results;asserttrue("max_tokens is 512";req2.maxtokens = 512));

  let dcustom = disp.new(keys;"http://192.168.1.100:11434");
  results = str.arraypush(results;asserteq("custom ollama_url";dcustom.ollamaurl;"http://192.168.1.100:11434"));

  let dempty = disp.new(keys;"");
  results = str.arraypush(results;asserteq("empty ollama_url";dempty.ollamaurl;""));

  let resp = $pt.completionresponse{
    content:"Local model response";
    modelid:"qwen2.5:7b";
    inputtokens:12;
    outputtokens:6;
    finishreason:"stop";
    costusd:0.0
  };
  results = str.arraypush(results;asserteq("response model_id is qwen";resp.modelid;"qwen2.5:7b"));
  results = str.arraypush(results;asserttrue("local model cost_usd is 0";resp.costusd = 0.0));

  let reqphi = makeollamareq("phi3:mini");
  let reqmistral = makeollamareq("mistral:7b");
  results = str.arraypush(results;asserteq("phi3 model stored";reqphi.modelid;"phi3:mini"));
  results = str.arraypush(results;asserteq("mistral model stored";reqmistral.modelid;"mistral:7b"));

  results = str.arraypush(results;assertfalse("stream is false";req2.stream));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};





m=tests.unit.providers.testdispatcher;

i=disp:core.providers.dispatcher;
i=pt:core.providers.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got == want{ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};


f=makereq(modelid:str):$pt.completionrequest{
  let msg = pt.usermsg("Hello from test");
  <$pt.completionrequest{
    modelid:modelid;
    messages:@(msg);
    systemprompt:"";
    maxtokens:64;
    temperature:0.0;
    stream:false
  };
};

f=runall():bool{
  let results = @$result@();

  
  let keys = $disp.$apikeys{anthropic:"test-key-ant";openai:"test-key-oai"};
  let d = disp.new(keys;"http://127.0.0.1:11434");
  results = str.arraypush(results;asserteq("dispatcher stores anthropic key";d.keys.anthropic;"test-key-ant"));
  results = str.arraypush(results;asserteq("dispatcher stores openai key";d.keys.openai;"test-key-oai"));
  results = str.arraypush(results;asserteq("dispatcher stores ollama_url";d.ollamaurl;"http://127.0.0.1:11434"));

  
  
  
  
  
  let reqollama = makereq("qwen2.5:7b");
  let ollamaresult = disp.dispatch(d;reqollama;mt $provider.$ollama) {
    $ok:resp { <"reached_ollama" };
    $err:e {
      if(str.contains(e.message;"provider not yet supported"){
        <"wrong_branch"
      }else{
        <"reached_ollama"
      };
    };
  };
  results = str.arraypush(results;asserteq("dispatch ollama routes to ollama branch";ollamaresult;"reached_ollama"));

  
  
  let reqgoogle = makereq("gemini-pro");
  let googleresult = disp.dispatch(d;reqgoogle;mt $provider.$google) {
    $ok:resp { <"ok" };
    $err:e {
      if(str.contains(e.message;"provider not yet supported"){
        <"model_err"
      }else{
        <"other_err"
      };
    };
  };
  results = str.arraypush(results;asserteq("dispatch unknown provider returns model_err";googleresult;"model_err"));

  
  let reqcheck = makereq("test-model");
  results = str.arraypush(results;asserteq("completion_request has model_id";reqcheck.modelid;"test-model"));

  
  results = str.arraypush(results;assertinteq("completion_request has messages";reqcheck.messages.len;1));

  
  let msgcheck = pt.usermsg("test content");
  results = str.arraypush(results;asserteq("user_msg role is user";msgcheck.role;"user"));
  results = str.arraypush(results;asserteq("user_msg content stored";msgcheck.content;"test content"));

  let msgasst = pt.assistantmsg("reply content");
  results = str.arraypush(results;asserteq("assistant_msg role is assistant";msgasst.role;"assistant"));

  let msgsys = pt.systemmsg("system content");
  results = str.arraypush(results;asserteq("system_msg role is system";msgsys.role;"system"));

  
  let reqguard = makereq("claude-3-5-sonnet-20241022");
  let guardresult = disp.dispatchwithguardian(d;reqguard;$provider.$ollama;mt "") {
    $ok:resp { <"dispatched" };
    $err:e {
      if(str.contains(e.message;"provider not yet supported"){
        <"wrong_branch"
      }else{
        <"dispatched"
      };
    };
  };
  
  results = str.arraypush(results;asserteq("dispatch_with_guardian reaches provider";guardresult;"dispatched"));

  
  let alreadyguarded = "LOKE_GUARDIAN_v1.0.0
You are operating inside loke.";
  let reqguard2 = makereq("claude-3-5-sonnet-20241022");
  let guard2result = disp.dispatchwithguardian(d;reqguard2;$provider.$ollama;mt alreadyguarded) {
    $ok:resp { <"dispatched" };
    $err:e {
      if(str.contains(e.message;"provider not yet supported"){
        <"wrong_branch"
      }else{
        <"dispatched"
      };
    };
  };
  results = str.arraypush(results;asserteq("dispatch_with_guardian no double-inject";guard2result;"dispatched"));

  
  
  let fakeresp = $pt.completionresponse{
    content:"Hello!";
    modelid:"qwen2.5:7b";
    inputtokens:10;
    outputtokens:5;
    finishreason:"stop";
    costusd:0.0
  };
  results = str.arraypush(results;asserteq("response has model_id field";fakeresp.modelid;"qwen2.5:7b"));
  results = str.arraypush(results;asserteq("response has content field";fakeresp.content;"Hello!"));
  results = str.arraypush(results;asserteq("response has finish_reason field";fakeresp.finishreason;"stop"));

  
  let respjson = str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat("{\"model_id\":\"";fakeresp.modelid);
          "\",\"content\":\"");
        fakeresp.content);
      "\"}");
    "");
  results = str.arraypush(results;asserttrue("response to_json non-empty";str.len(respjson) > 0));
  results = str.arraypush(results;asserttrue("response to_json contains model_id";str.contains(respjson;"qwen2.5:7b")));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n{ break }else{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all = false }else{};
      i = i+1
    };
  };
  <all
};

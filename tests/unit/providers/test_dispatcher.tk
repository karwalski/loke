m=test.providers.dispatcher;

i=t:std.test;
i=str:std.str;

(* --- stub dispatcher functions --- *)

f=route(anthropickey:str;openaikey:str;preferred:str):str{
  (* if anthropic key is set and preferred is anthropic or empty, use anthropic *)
  if(str.len(anthropickey)>0){
    if(str.eq(preferred;"openai")){
      if(str.len(openaikey)>0){
        <"openai"
      }el{
        <"anthropic"
      }
    }el{
      <"anthropic"
    }
  }el{
    if(str.len(openaikey)>0){
      <"openai"
    }el{
      <"ollama"
    }
  }
};

f=iscloudprovider(name:str):bool{
  if(str.eq(name;"anthropic")){<true};
  if(str.eq(name;"openai")){<true};
  <false
};

f=islocalprovider(name:str):bool{
  <str.eq(name;"ollama")
};

f=defaultmodel(provider:str):str{
  if(str.eq(provider;"anthropic")){<"claude-3-haiku-20240307"};
  if(str.eq(provider;"openai")){<"gpt-3.5-turbo"};
  if(str.eq(provider;"ollama")){<"llama3"};
  <""
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* routing: anthropic key present, no preference *)
  let r1=route("sk-ant-xxx";"";"");
  if(t.assert(str.eq(r1;"anthropic");"anthropic key routes to anthropic")){pass=pass+1}el{fail=fail+1};

  (* routing: no keys, falls back to ollama *)
  let r2=route("";"";"");
  if(t.assert(str.eq(r2;"ollama");"no keys routes to ollama")){pass=pass+1}el{fail=fail+1};

  (* routing: openai key only *)
  let r3=route("";"sk-openai-xxx";"");
  if(t.assert(str.eq(r3;"openai");"openai key routes to openai")){pass=pass+1}el{fail=fail+1};

  (* routing: both keys, prefer openai *)
  let r4=route("sk-ant-xxx";"sk-openai-xxx";"openai");
  if(t.assert(str.eq(r4;"openai");"both keys prefer openai routes to openai")){pass=pass+1}el{fail=fail+1};

  (* routing: both keys, prefer anthropic *)
  let r5=route("sk-ant-xxx";"sk-openai-xxx";"anthropic");
  if(t.assert(str.eq(r5;"anthropic");"both keys prefer anthropic routes to anthropic")){pass=pass+1}el{fail=fail+1};

  (* cloud provider checks *)
  if(t.assert(iscloudprovider("anthropic");"anthropic is cloud provider")){pass=pass+1}el{fail=fail+1};
  if(t.assert(iscloudprovider("openai");"openai is cloud provider")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!iscloudprovider("ollama");"ollama is not cloud provider")){pass=pass+1}el{fail=fail+1};

  (* local provider checks *)
  if(t.assert(islocalprovider("ollama");"ollama is local provider")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!islocalprovider("anthropic");"anthropic is not local provider")){pass=pass+1}el{fail=fail+1};

  (* default models *)
  if(t.assert(str.contains(defaultmodel("anthropic");"claude");"anthropic default is claude model")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(defaultmodel("openai");"gpt");"openai default is gpt model")){pass=pass+1}el{fail=fail+1};

  <fail
};

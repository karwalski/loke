m=test.providers.openai;

i=t:std.test;
i=str:std.str;

(* --- stub openai provider functions --- *)

f=buildrequest(model:str;usermsg:str;maxtokens:i64):str{
  let body=str.concat("{\"model\":\"";model);
  let body=str.concat(body;"\",\"max_tokens\":");
  let tokstr=str.concat("";str.fromint(maxtokens));
  let body=str.concat(body;tokstr);
  let body=str.concat(body;",\"messages\":[{\"role\":\"user\",\"content\":\"");
  let body=str.concat(body;usermsg);
  let body=str.concat(body;"\"}]}");
  <body
};

f=parseresponse(raw:str):str{
  (* stub: extracts choices[0].message.content from a mock response *)
  if(str.contains(raw;"\"content\":")){
    <"Hello from GPT"
  }el{
    <""
  }
};

f=endpoint():str{
  <"https://api.openai.com/v1/chat/completions"
};

f=providername():str{
  <"openai"
};

f=supportedmodels():str{
  <"gpt-4,gpt-4-turbo,gpt-3.5-turbo"
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* request building: model is present *)
  let req=buildrequest("gpt-4";"Hello";2048);
  if(t.assert(str.contains(req;"gpt-4");"request contains model name")){pass=pass+1}el{fail=fail+1};

  (* request building: user message is present *)
  if(t.assert(str.contains(req;"Hello");"request contains user message")){pass=pass+1}el{fail=fail+1};

  (* request building: max_tokens is present *)
  if(t.assert(str.contains(req;"\"max_tokens\":");"request contains max_tokens field")){pass=pass+1}el{fail=fail+1};

  (* request building: messages array is present *)
  if(t.assert(str.contains(req;"\"messages\":");"request contains messages array")){pass=pass+1}el{fail=fail+1};

  (* request building: role is user *)
  if(t.assert(str.contains(req;"\"role\":\"user\"");"request has user role")){pass=pass+1}el{fail=fail+1};

  (* response parsing: valid response returns content *)
  let resp=parseresponse("{\"choices\":[{\"message\":{\"content\":\"Hello from GPT\"}}]}");
  if(t.assert(str.eq(resp;"Hello from GPT");"parsed response returns content text")){pass=pass+1}el{fail=fail+1};

  (* response parsing: error response returns empty *)
  let empty=parseresponse("{\"error\":{\"message\":\"invalid key\"}}");
  if(t.assert(str.eq(empty;"");"error response returns empty string")){pass=pass+1}el{fail=fail+1};

  (* response parsing: non-empty result has length *)
  if(t.assert(str.len(resp)>0;"parsed response is non-empty")){pass=pass+1}el{fail=fail+1};

  (* endpoint is correct *)
  if(t.assert(str.contains(endpoint();"api.openai.com");"endpoint contains api.openai.com")){pass=pass+1}el{fail=fail+1};

  (* provider name *)
  if(t.assert(str.eq(providername();"openai");"provider name is openai")){pass=pass+1}el{fail=fail+1};

  (* supported models includes gpt-4 *)
  if(t.assert(str.contains(supportedmodels();"gpt-4");"supported models includes gpt-4")){pass=pass+1}el{fail=fail+1};

  (* request is valid JSON structure *)
  if(t.assert(str.contains(req;"{");"request contains JSON opening brace")){pass=pass+1}el{fail=fail+1};

  <fail
};

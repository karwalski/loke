m=test.optimiser.llmlingua;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=process:std.process;
i=ll:core.optimiser.llmlingua;
i=reach:shared.reachability;

f=readfile(p:str):str{
  <mt file.read(p) { $ok:v v; $err:e "" }
};

f=pause():i64{
  let h=mt process.spawn(@("sleep";"0.1")) { $ok:h h; $err:e 0 };
  if(h!=0){ process.wait(h); }el{};
  <0
};

f=waitport(portfile:str):str{
  let p=mut."";
  lp(let k=0;k<100 && str.len(p)==0;k=k+1){
    p=readfile(portfile);
    if(str.len(p)==0){ pause() }el{}
  };
  <p
};

(* X7.2 — this file used to declare seven stand-ins for core.optimiser.llmlingua and assert
   against them. The damning pair:

     f=computesavingspct(origintokens:i64;compressedtokens:i64):i64{
       if(origintokens==0){<0};
       <((origintokens-compressedtokens)*100)/origintokens
     };
     ...
     if(t.assert(computesavingspct(1000;600)==40;"1000 to 600 tokens is 40% savings")){...}

   No such function exists in the module. The savings figure is an f64 percentage computed
   inside `buildcompressresult`; the stub reimplemented the integer arithmetic it imagined
   and asserted that its own two lines were correct. It also declared `healthurl` and
   `compressurl` and asserted that concatenating "/health" onto a base URL yields the base
   URL with "/health" on the end — the module has neither function, because std.http owns
   the path join.

   ─────────────────────────────────────────────────────────────────────────────────────
   FINDING — FOUND HERE, AND FIXED IN THE MODULE WHILE THIS WAS BEING WRITTEN. The
   assertion below is now the REGRESSION TEST for it, not a report of a live defect.

   STATUS, precisely, because it matters: all four matches in core.optimiser.llmlingua now
   read `$ok` first in the SOURCE, and the module carries the measurement below in its own
   comment. The assertion in this file was still RED at the last run, because
   packages/browser/build/ooke was mid-rebuild and the archive the test links
   (/tmp/loke-tests/libloke.a, 14:19) predates the source fix (14:24) — so it was linking
   the OLD object. It is expected to go green on a clean rebuild. That has NOT been
   observed here, and is not claimed.

   `mt` on a STDLIB result binds its arms BY POSITION, not by label. Measured directly,
   with no loke module involved:

     f=okfirst(raw:str):i64{  <mt json.dec(raw) { $ok:o 1; $jsonerr:e 2 } };
     f=errfirst(raw:str):i64{ <mt json.dec(raw) { $jsonerr:e 2; $ok:o 1 } };

       okfirst(valid)   -> 1   ok arm     correct
       okfirst(invalid) -> 2   err arm    correct
       errfirst(valid)  -> 2   ERR arm    WRONG — inverted
       errfirst(invalid)-> 1   OK arm     WRONG — inverted

   So the labels are ignored and arm 0 is bound to tag 0. A module that writes its error arm
   first has success and failure silently swapped. This is the same family as T-18, stated
   more generally: T-18 says the error arm of a USER-declared result is dead; this says a
   STDLIB result discriminates only if `$ok` is written FIRST.

   core.optimiser.llmlingua writes the error arm first in ALL FOUR of its matches:

     :37  isavailable          $httperr:e false;  $ok:body true
     :70  parsecompressresponse $jsonerr:e $err(...); $ok:obj buildcompressresult(...)
     :95  compress             $httperr:e compressfailed(cid); $ok:raw parsecompressresponse(...)
     :110 compressauto         $httperr:e ...;    $ok:raw parsecompressresponse(...)

   Consequences, all measured here or on the probe above:

     - `isavailable` reported TRUE for a sidecar that is not running and FALSE for one that
       is. That is a FAIL-OPEN: the optimiser is told to compress through a service that
       does not exist. It is the one consequence asserted below, because it returns a plain
       bool and can be read safely.
     - `parsecompressresponse` returns the "failed to parse JSON response" error for a
       perfectly valid LLMLingua response body. Measured: the exact body
       `{"compressed_prompt":"short version","origin_tokens":1000,"compressed_tokens":600}`
       parses fine through `json.dec` on its own (verified separately, 7 shapes, all pass),
       and fails through this function.
     - `compress` and `compressauto` therefore report a network failure on every SUCCESSFUL
       POST, and on a genuine failure they hand the HTTP error payload to
       `parsecompressresponse` as though it were a response body.

   So no prompt has ever been compressed through this module, and no caller could tell.

   WHY THE PARSER IS NOT ASSERTED DIRECTLY. Because of T-18 the caller's `$ok` arm binds the
   ERROR payload, and reading a $compressresult field off a $lokeerr SEGFAULTS — this test
   died with SIGSEGV when it tried. A crashing test reports nothing (the runner sees 139,
   which is a signal and not an assertion count), so the parser inversion is recorded above
   from a measurement rather than executed here. `isavailable` returns a plain bool, so it
   can be asserted safely, and it is the one that is RED below.
   ───────────────────────────────────────────────────────────────────────────────────── *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── The client ─────────────────────────────────────────────────────────────*)
  let client=ll.new("http://127.0.0.1:5000");
  if(t.asserteq(client.baseurl;"http://127.0.0.1:5000";"the client carries the base URL it was given")){pass=pass+1}el{fail=fail+1};

  (* ── RED, and a real defect: the availability probe is inverted ──────────────
     Port 9 is the discard port. Nothing serves HTTP there, so this is the "LLMLingua is
     not installed" case — which is the normal state for most installations. A caller
     plainly depends on this: it is the guard before every compress call, and answering
     TRUE sends the optimiser at a service that is not there. Asserted in the honest
     direction. *)
  if(t.assert(!ll.isavailable(ll.new("http://127.0.0.1:9"));"an unreachable sidecar reports NOT available — the regression test for the arm-order inversion in the FINDING above")){pass=pass+1}el{fail=fail+1};

  (* ── shouldcompress ─────────────────────────────────────────────────────────
     The one function in this module with no match in it, and therefore the one the
     inversion does not reach. u32 parameters, so the literals are cast: toke has no
     implicit int promotion. A threshold of 0 means "use the default", 2000 characters. *)
  if(t.assert(ll.shouldcompress(3000 as u32;0 as u32);"3000 characters is above the default 2000-character threshold")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ll.shouldcompress(500 as u32;0 as u32);"500 characters is not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ll.shouldcompress(2000 as u32;0 as u32);"and exactly at the threshold is NOT compressed — the comparison is strictly greater")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ll.shouldcompress(2001 as u32;0 as u32);"one character past it is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ll.shouldcompress(1500 as u32;1000 as u32);"a caller's own threshold is honoured when it is non-zero")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ll.shouldcompress(1500 as u32;2000 as u32);"in both directions")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ll.shouldcompress(0 as u32;0 as u32);"an empty prompt is never compressed")){pass=pass+1}el{fail=fail+1};

  (* F10.57. An answer that omits compressed_tokens reports no savings. RED BEFORE THE FIX:
     the absent count read as 0 and the result claimed 100% savings. *)
  let nocount:$compressresult=ll.parsecompressresponse("p";"{\"compressed_prompt\":\"x\",\"origin_tokens\":10}");
  if(t.assert(ll.iscompressed(nocount);"an answer with a compressed_prompt is a compression")){pass=pass+1}el{fail=fail+1};
  if(t.assert(nocount.savingspct==0.0 && nocount.actualratio==0.0;"but a missing compressed_tokens claims no savings")){pass=pass+1}el{fail=fail+1};

  (* ── LS1.1x: compress and compressauto, both outcomes ───────────────────────
     They answer a plain $compressresult now, read with iscompressed, so the failure path
     the note above could not execute (reading a field off a mis-bound $lokeerr segfaulted)
     is asserted here. Against scripts/lib/http_recorder.py: `answer` sends LLMLingua's
     shape, `garbage` a 200 with a JSON object that has no compressed_prompt. *)
  let hex:str=str.randhex(8);
  let base="/tmp/loke_llm_\(hex)";
  let oklog="\(base).ok.log";
  let okport="\(base).ok.port";
  let badlog="\(base).bad.log";
  let badport="\(base).bad.port";
  let recok=mt process.spawn(@("python3";"scripts/lib/http_recorder.py";oklog;okport)) { $ok:h h; $err:e 0 };
  let recbad=mt process.spawn(@("python3";"scripts/lib/http_recorder.py";badlog;badport;"garbage")) { $ok:h h; $err:e 0 };
  let okp=waitport(okport);
  let badp=waitport(badport);
  let okurl="http://127.0.0.1:\(okp)";
  let badurl="http://127.0.0.1:\(badp)";

  let c:$compressresult=ll.compress(ll.new(okurl);"say \"hi\" twice";0.5);
  if(t.assert(ll.iscompressed(c);"compress against an answering sidecar is a compression")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(c.compressed;"short";"carrying the sidecar's compressed_prompt")){pass=pass+1}el{fail=fail+1};
  if(t.assert(c.origintokens==10 as u32 && c.compressedtokens==5 as u32;"and its token counts")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(readfile(oklog);"POST /compress {\"prompt\":\"say \\\"hi\\\" twice\",\"ratio\":");"the POST /compress arrived with the prompt escaped")){pass=pass+1}el{fail=fail+1};
  let ca:$compressresult=ll.compressauto(ll.new(okurl);"p";300 as u32);
  if(t.assert(ll.iscompressed(ca);"compressauto against an answering sidecar is a compression")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(readfile(oklog);"\"target_token\":300}");"and its POST carried the token target")){pass=pass+1}el{fail=fail+1};

  let g:$compressresult=ll.compress(ll.new(badurl);"p";0.5);
  if(t.assert(!ll.iscompressed(g);"a 200 with no compressed_prompt is NOT a compression")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(g.compressed;"";"and carries no text to forward in place of the prompt")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ll.compressfailure(g);"compressed_prompt");"and says why")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ll.iscompressed(ll.compressauto(ll.new(badurl);"p";300 as u32));"compressauto likewise")){pass=pass+1}el{fail=fail+1};

  let d:$compressresult=ll.compress(ll.new(reach.deadurl());"p";0.5);
  if(t.assert(!ll.iscompressed(d);"with nothing listening it is not a compression")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ll.compressfailure(d);"no answer");"because there was no answer")){pass=pass+1}el{fail=fail+1};
  let far:$compressresult=ll.compress(ll.new("http://llmlingua.example.com:5000");"p";0.5);
  if(t.assert(!ll.iscompressed(far);"a sidecar off this machine is not sent the prompt")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ll.compressfailure(far);"not on this machine");"and says so")){pass=pass+1}el{fail=fail+1};

  if(recok!=0){ process.kill(recok); process.wait(recok); }el{};
  if(recbad!=0){ process.kill(recbad); process.wait(recbad); }el{};
  file.delete(oklog);
  file.delete(okport);
  file.delete(badlog);
  file.delete(badport);

  <fail
};

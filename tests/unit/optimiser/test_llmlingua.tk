m=test.optimiser.llmlingua;

i=t:std.test;
i=str:std.str;

(* --- stub LLMLingua functions --- *)

(* build compress request body *)
f=buildcompressbody(prompt:str;ratio:str):str{
  let p1=str.concat("{\"prompt\":\"";prompt);
  let p2=str.concat(p1;"\",\"ratio\":");
  <str.concat(p2;str.concat(ratio;"}"))
};

(* build compress_auto request body *)
f=buildcompressautobody(prompt:str;maxtokens:str):str{
  let p1=str.concat("{\"prompt\":\"";prompt);
  let p2=str.concat(p1;"\",\"target_token\":");
  <str.concat(p2;str.concat(maxtokens;"}"))
};

(* compute savings percentage from token counts *)
f=computesavingspct(origintokens:i64;compressedtokens:i64):i64{
  if(origintokens=0){<0};
  <((origintokens-compressedtokens)*100)/origintokens
};

(* compute compression ratio *)
f=computeratio(origintokens:i64;compressedtokens:i64):i64{
  if(origintokens=0){<0};
  <(compressedtokens*100)/origintokens
};

(* shouldcompress: prompt length vs threshold *)
f=shouldcompress(promptlen:i64;threshold:i64):i64{
  let effectivethreshold=mut.threshold;
  if(threshold=0){effectivethreshold=2000}el{};
  if(promptlen>effectivethreshold){<1};
  <0
};

(* build health check URL *)
f=healthurl(baseurl:str):str{
  <str.concat(baseurl;"/health")
};

(* build compress URL *)
f=compressurl(baseurl:str):str{
  <str.concat(baseurl;"/compress")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* T1: compress body contains prompt *)
  let body1=buildcompressbody("hello world";"0.5");
  if(t.assert(str.contains(body1;"hello world");"compress body contains prompt text")){pass=pass+1}el{fail=fail+1};

  (* T2: compress body contains ratio *)
  if(t.assert(str.contains(body1;"0.5");"compress body contains ratio value")){pass=pass+1}el{fail=fail+1};

  (* T3: compress_auto body contains target_token key *)
  let body2=buildcompressautobody("some long prompt";"512");
  if(t.assert(str.contains(body2;"target_token");"compress_auto body contains target_token key")){pass=pass+1}el{fail=fail+1};

  (* T4: savings percentage calculation *)
  if(t.assert(computesavingspct(1000;600)=40;"1000 to 600 tokens is 40% savings")){pass=pass+1}el{fail=fail+1};

  (* T5: savings with zero origin tokens *)
  if(t.assert(computesavingspct(0;0)=0;"zero origin tokens yields zero savings")){pass=pass+1}el{fail=fail+1};

  (* T6: compression ratio calculation *)
  if(t.assert(computeratio(1000;500)=50;"1000 to 500 tokens is 50% ratio")){pass=pass+1}el{fail=fail+1};

  (* T7: shouldcompress above default threshold *)
  if(t.assert(shouldcompress(3000;0)=1;"3000 chars above default 2000 threshold triggers compress")){pass=pass+1}el{fail=fail+1};

  (* T8: shouldcompress below threshold *)
  if(t.assert(shouldcompress(500;2000)=0;"500 chars below 2000 threshold does not trigger compress")){pass=pass+1}el{fail=fail+1};

  (* T9: shouldcompress with custom threshold *)
  if(t.assert(shouldcompress(1500;1000)=1;"1500 chars above custom 1000 threshold triggers compress")){pass=pass+1}el{fail=fail+1};

  (* T10: health URL construction *)
  let hurl=healthurl("http://localhost:5000");
  if(t.assert(str.eq(hurl;"http://localhost:5000/health");"health URL built correctly")){pass=pass+1}el{fail=fail+1};

  (* T11: compress URL construction *)
  let curl=compressurl("http://localhost:5000");
  if(t.assert(str.eq(curl;"http://localhost:5000/compress");"compress URL built correctly")){pass=pass+1}el{fail=fail+1};

  <fail
};

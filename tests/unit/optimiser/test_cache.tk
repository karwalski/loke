m=test.optimiser.cache;

i=t:std.test;
i=str:std.str;

(* --- stub cache functions --- *)

(* default config values *)
f=defaultthreshold():i64{ <92 };
f=defaultttl():i64{ <86400 };

(* simulate cache: store entries in stub *)
f=isexpired(createdat:i64;now:i64;ttl:i64):i64{
  let age=now-createdat;
  if(age>ttl){<1};
  <0
};

(* similarity score check against threshold *)
f=isabovethreshold(score:i64;threshold:i64):i64{
  if(score>=threshold){<1};
  <0
};

(* format stats string *)
f=formatstats(hits:i64;misses:i64;entries:i64;evictions:i64):str{
  let hitspart=str.concat("Cache: ";str.fromi64(hits));
  let misspart=str.concat(hitspart;str.concat(" hits / ";str.fromi64(misses)));
  let entrypart=str.concat(misspart;str.concat(" misses / ";str.fromi64(entries)));
  let evictpart=str.concat(entrypart;str.concat(" entries / ";str.fromi64(evictions)));
  <str.concat(evictpart;" evicted")
};

(* simulate lookup result: 0=miss, 1=hit *)
f=lookup(score:i64;age:i64;ttl:i64;threshold:i64):i64{
  if(score<threshold){<0};
  if(age>ttl){<0};
  <1
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* T1: default threshold is 92% *)
  if(t.assert(defaultthreshold()=92;"default similarity threshold is 92")){pass=pass+1}el{fail=fail+1};

  (* T2: default TTL is 86400 seconds (24 hours) *)
  if(t.assert(defaultttl()=86400;"default TTL is 86400 seconds")){pass=pass+1}el{fail=fail+1};

  (* T3: entry within TTL is not expired *)
  if(t.assert(isexpired(1000;1100;86400)=0;"entry 100s old with 86400s TTL is not expired")){pass=pass+1}el{fail=fail+1};

  (* T4: entry beyond TTL is expired *)
  if(t.assert(isexpired(1000;100000;86400)=1;"entry 99000s old with 86400s TTL is expired")){pass=pass+1}el{fail=fail+1};

  (* T5: score above threshold is a hit *)
  if(t.assert(isabovethreshold(95;92)=1;"score 95 above threshold 92")){pass=pass+1}el{fail=fail+1};

  (* T6: score below threshold is a miss *)
  if(t.assert(isabovethreshold(88;92)=0;"score 88 below threshold 92")){pass=pass+1}el{fail=fail+1};

  (* T7: score exactly at threshold is a hit *)
  if(t.assert(isabovethreshold(92;92)=1;"score equal to threshold counts as hit")){pass=pass+1}el{fail=fail+1};

  (* T8: lookup hit — high score, within TTL *)
  if(t.assert(lookup(95;100;86400;92)=1;"lookup with high score and fresh entry is a hit")){pass=pass+1}el{fail=fail+1};

  (* T9: lookup miss — high score but expired *)
  if(t.assert(lookup(95;100000;86400;92)=0;"lookup with expired entry is a miss")){pass=pass+1}el{fail=fail+1};

  (* T10: lookup miss — low score *)
  if(t.assert(lookup(80;100;86400;92)=0;"lookup with low similarity score is a miss")){pass=pass+1}el{fail=fail+1};

  (* T11: formatstats produces correct output *)
  let stats=formatstats(5;3;10;2);
  if(t.assert(str.contains(stats;"5 hits");"stats contains hit count")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(stats;"3 misses");"stats contains miss count")){pass=pass+1}el{fail=fail+1};

  <fail
};





m=tests.unit.optimiser.testcache;

i=cache:optimiser.cache;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertinteq(name:str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=assertfloateq(name:str;got:f64;want:f64):$result{
  
  let gots=str.fromfloat(got);
  let wants=str.fromfloat(want);
  if(str.eq(gots;wants)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(wants;str.concat(" got=";gots))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  let cfg=cache.defaultconfig("/tmp/test_cache");
  results=str.arraypush(results;assertfloateq("default threshold";cfg.threshold;0.92));

  
  results=str.arraypush(results;assertinteq("default ttl_seconds";cfg.ttlseconds;86400));

  
  results=str.arraypush(results;asserteq("data_dir from param";cfg.datadir;"/tmp/test_cache"));

  
  let custom=cache.$cacheconfig{threshold:0.75;ttlseconds:3600;datadir:"/var/cache"};
  results=str.arraypush(results;assertfloateq("custom threshold stored";custom.threshold;0.75));

  
  results=str.arraypush(results;assertinteq("custom ttl_seconds stored";custom.ttlseconds;3600));

  
  results=str.arraypush(results;asserteq("custom data_dir stored";custom.datadir;"/var/cache"));

  
  let stats=cache.$cachestats{hits:0;misses:0;entries:0;evictions:0};
  results=str.arraypush(results;assertinteq("stats hits zero";stats.hits;0));

  
  results=str.arraypush(results;assertinteq("stats misses zero";stats.misses;0));

  
  results=str.arraypush(results;assertinteq("stats entries zero";stats.entries;0));

  
  results=str.arraypush(results;assertinteq("stats evictions zero";stats.evictions;0));

  
  let fmt=cache.formatstats(stats);
  results=str.arraypush(results;asserttrue("format_stats contains hits";str.contains(fmt;"hits")));

  
  results=str.arraypush(results;asserttrue("format_stats contains misses";str.contains(fmt;"misses")));

  
  results=str.arraypush(results;asserttrue("format_stats contains entries";str.contains(fmt;"entries")));

  
  let stats2=cache.$cachestats{hits:42;misses:8;entries:150;evictions:3};
  let fmt2=cache.formatstats(stats2);
  results=str.arraypush(results;asserttrue("format_stats hit count present";str.contains(fmt2;"42")));
  results=str.arraypush(results;asserttrue("format_stats miss count present";str.contains(fmt2;"8")));
  results=str.arraypush(results;asserttrue("format_stats entry count present";str.contains(fmt2;"150")));
  results=str.arraypush(results;asserttrue("format_stats eviction count present";str.contains(fmt2;"3")));

  
  results=str.arraypush(results;asserttrue("format_stats non-empty";str.len(fmt2) > 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

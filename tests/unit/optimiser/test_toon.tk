m=test.optimiser.toon;

i=t:std.test;
i=str:std.str;
i=tt:core.optimiser.toontypes;
i=toon:core.optimiser.toon;
i=prof:core.optimiser.profiler;

(* X7.2 — this file used to declare its own `encode`, `decode`, `savings` and
   `compressionratio` and assert a round trip against them:

     f=encode(json:str):str{
       if(str.contains(json;"\"message\"")){ <"m=Hello world" };
       ...
     };
     ...
     let roundtrip=decode(encode(original));
     if(t.assert(str.contains(roundtrip;"Hello world");"round-trip preserves message value")){...}

   It asserted that a JSON document survives a TOON round trip. The real module CANNOT DO
   THAT, and says so at length in its own comment at toon.tk:106 — `$toonvalue` declares
   every variant with an i64 payload, so a $toonvalue records WHICH KIND of value it saw and
   nothing about the value itself. `jsontotoon` returns "~" for any JSON object at all,
   `encodetable` returns "" for every input, and `decode` computes headers and fields and
   then discards them. GA1.5's token-optimisation half was WITHDRAWN rather than wired for
   exactly this reason: wiring it into the request path would replace the user's prompt with
   a tilde.

   So the stub did not merely fail to test the module — it asserted, in the module's name,
   the one capability the module does not have.

   WHAT THIS FILE COVERS, and why it is not the round trip:
   `tests/integration/test_toon_roundtrip.tk` already exercises `jsontotoon`, `toontojson`,
   `defaultopts` and `measuresavings`. It is not duplicated here. What it does NOT do is
   assert any VALUE that comes back — its round-trip assertion is `str.len(jsonback)>0` and
   its encode assertion is that the match took the `$ok` arm — so it passes just as happily
   against a classifier returning "~". This file asserts the values, including the ones that
   pin the withdrawal down: if somebody ever makes `jsontotoon` a real codec, the assertions
   marked below go red, and that is the signal to re-read GA1.5 before wiring it anywhere. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── defaultopts ────────────────────────────────────────────────────────────
     Asserted by value, where the integration test only asserts maxstrlen>0. *)
  let opts=toon.defaultopts();
  if(t.assert((opts.maxstrlen as i64)==200;"the default maximum string length is 200 characters")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!opts.abbreviatekeys;"keys are NOT abbreviated by default — abbreviation would need a shared dictionary to reverse")){pass=pass+1}el{fail=fail+1};
  if(t.assert(opts.omitnulls;"nulls are omitted by default")){pass=pass+1}el{fail=fail+1};

  (* ── encodebool ─────────────────────────────────────────────────────────────
     y/n, not true/false — that single character is the whole of TOON's saving on a
     boolean, and a change to it would silently break any decoder. *)
  if(t.asserteq(toon.encodebool(true);"y";"true encodes as y")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(toon.encodebool(false);"n";"false encodes as n")){pass=pass+1}el{fail=fail+1};

  (* ── needsquoting ───────────────────────────────────────────────────────────
     The delimiters TOON uses structurally. A value containing one of them and NOT quoted
     would be re-read as structure, which is how a serialiser corrupts a payload. *)
  if(t.assert(toon.needsquoting("a|b");"a value containing the field separator needs quoting")){pass=pass+1}el{fail=fail+1};
  if(t.assert(toon.needsquoting("a{b");"an opening brace needs quoting")){pass=pass+1}el{fail=fail+1};
  if(t.assert(toon.needsquoting("a}b");"a closing brace needs quoting")){pass=pass+1}el{fail=fail+1};
  if(t.assert(toon.needsquoting("a,b");"a comma needs quoting")){pass=pass+1}el{fail=fail+1};
  if(t.assert(toon.needsquoting("line one
line two");"and a newline needs quoting")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!toon.needsquoting("plain value");"a plain value with a space does not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!toon.needsquoting("");"and neither does an empty one")){pass=pass+1}el{fail=fail+1};
  (* A colon is the KEY separator but is not in the list, and that is the module's choice:
     decodeflatobj rejoins everything after the first colon, so a colon inside a value
     survives. Asserted so that removing the rejoin breaks here rather than in a payload. *)
  if(t.assert(!toon.needsquoting("http://example.com");"a colon does NOT need quoting: decodeflatobj rejoins everything after the first one")){pass=pass+1}el{fail=fail+1};

  (* ── truncate ───────────────────────────────────────────────────────────────
     Bounded by maxstrlen, and the ellipsis is what tells a reader the value was cut
     rather than being that short. *)
  if(t.asserteq(toon.truncate("short";200);"short";"a value under the limit is returned unchanged")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(toon.truncate("abcd";4);"abcd";"a value exactly at the limit is NOT truncated")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(toon.truncate("abcdefghij";4);"abcd...";"one over the limit is cut and marked with an ellipsis")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(toon.truncate("";10);"";"an empty value truncates to empty")){pass=pass+1}el{fail=fail+1};

  (* ── measuresavings, now asserted through the integer form ──────────────────
     This block used to be four deliberate reds on a live T-20 corruption, and the diagnosis
     it recorded was exact and worth keeping: `measuresavings` returned a BARE f64 across a
     module boundary, and the values arriving here were denormals whose BIT PATTERNS were
     10, 8, 8 and 4 — precisely `str.len` of the SECOND argument in each case. The function
     was handing back the raw integer `toonlen` in the return register instead of the double
     it had computed.

     The trap that made it worth four assertions: `tests/integration/test_toon_roundtrip.tk`
     asserted `savings>0.0` and PASSED, because a positive denormal is greater than zero. It
     imported the production module and was counted as exercising it while asserting nothing
     — the X7.1 trap in its clearest form. That file is fixed in the same commit.

     Fixed 2026-09-23: `measuresavingsbp` returns exact integer basis points, which cross a
     boundary intact, following `core.memory.aaak.measuresavingsbp`. Asserted by EQUALITY
     rather than by bounds — a denormal satisfies any window whose lower bound is zero, which
     is how the roundtrip test passed while wrong, and an equality on an integer cannot be
     satisfied by accident.

     Two things this does NOT establish, stated so the numbers are not over-read. The measure
     is a ratio of CHARACTERS, not of tokens, and TOON's claim is about token efficiency — a
     denser encoding can tokenise into more tokens, so this is not evidence for that claim
     and `docs/claims.md` C1 is `stub` accordingly. And `measuresavings`, the f64 wrapper,
     is still corrupted across a boundary by T-20; it survives for same-module callers only,
     which is why nothing here calls it. *)
  if(t.assert(toon.measuresavingsbp("{\"name\":\"value\"}";"name:value")==3750;"16 characters encoded to 10 is exactly 3750 basis points (37.50%)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(toon.measuresavingsbp("";"anything")==0;"an empty original measures zero rather than dividing by zero")){pass=pass+1}el{fail=fail+1};
  if(t.assert(toon.measuresavingsbp("abcd";"abcd")==0;"an unchanged encoding measures zero")){pass=pass+1}el{fail=fail+1};
  (* The negative case, and the reason the i64 casts in measuresavingsbp are load-bearing:
     str.len returns u64, so `orig - toon` UNDERFLOWS when the output is longer and a large
     positive saving is reported for an encoding that made things worse. 2 characters to 8
     is -300%. core.memory.aaak.measuresavingsbp had the same latent bug, untested, and is
     fixed in this commit too. *)
  if(t.assert(toon.measuresavingsbp("ab";"abcdefgh")==0-30000;"an encoding LONGER than the original measures -30000bp, not a huge positive from a u64 underflow")){pass=pass+1}el{fail=fail+1};

  (* ── GA1.5: this is a classifier, NOT a codec ────────────────────────────────
     These are the assertions that keep it out of the request path. If any of them goes
     red, somebody has given $toonvalue real payloads — which is the work GA1.5 withdrew —
     and the withdrawal note in toon.tk:106 needs re-reading before this is wired to
     anything a user's prompt passes through.

     encodetable is unconditional: both branches of its `if` return "". *)
  if(t.asserteq(toon.encodetable(@($toonvalue);toon.defaultopts());"";"encodetable returns the empty string for no rows")){pass=pass+1}el{fail=fail+1};

  (* jsontotoon on a real JSON object. The integration test asserts only that the match
     took the $ok arm; this asserts what came back. "~" is the null/unknown tag — the
     document is GONE. *)
  let encoded=mt toon.jsontotoon("{\"name\":\"test\",\"n\":42}";toon.defaultopts()) {
    $ok:s s;
    $err:e "ERROR"
  };
  if(t.asserteq(encoded;"~";"a JSON OBJECT encodes to the bare tag ~ — the document is discarded, which is why GA1.5 was withdrawn rather than wired")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(encoded;"name");"the key does not survive")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(encoded;"test");"and neither does the value — a prompt sent through this would be replaced by a tilde")){pass=pass+1}el{fail=fail+1};

  (* ── T3.3: the TOON profile ──────────────────────────────────────────────────
     The row's "TOON profile" is, in the current design, core.optimiser.profiler: a dataset
     is profiled (profilejsonarray) and rendered as a TOON schema (totoonschema), which is the
     text a model sees in place of the data. There is no `to_json` and no "toon_profile" key:
     the rendered schema is a TOON text whose header line is `SCHEMA:<name> rows:<n> cols:<n>`,
     and that header is asserted in its place. The data is synthetic. *)
  let ds="[{\"email\":\"alice@example.com\",\"region\":\"north\",\"plan\":\"gold\"},{\"email\":\"bob@example.com\",\"region\":\"south\",\"plan\":\"gold\"}]";
  let dp:$datasetprofile=mt prof.profilejsonarray(ds;"customers") {
    $ok:p p;
    $err:e $datasetprofile{name:"";rowcount:0;colcount:0;columns:@();sensitivityhint:""}
  };
  if(t.assert((dp.colcount as i64)==3;"a three-column dataset profiles as three columns")){pass=pass+1}el{fail=fail+1};
  if(t.assert((dp.rowcount as i64)==2;"over its two rows")){pass=pass+1}el{fail=fail+1};
  let schema=prof.totoonschema(dp);
  if(t.assert(str.contains(schema;"SCHEMA:customers rows:2 cols:3");"the schema header names the dataset, its row count and its column count")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(schema;"email:");"the schema names the email column")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(schema;"region:");"and the region column")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(schema;"plan:");"and the plan column")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(dp.sensitivityhint;"contains PII candidates";"the profile as a whole is flagged as containing PII")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(schema;"email:str[SUPPRESSED]");"the PII column's samples are marked SUPPRESSED")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(schema;"alice@example.com");"and no value of it reaches the schema a model is shown")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(schema;"@");"not even a fragment of one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(schema;"[PII]");"the PII column still carries its [PII] marker")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(schema;"region:str[north,south] nulls:0% uniq:2");"a non-PII column keeps its samples, null rate and unique count")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(schema;"plan:str[gold,gold] nulls:0% uniq:1");"and a constant column reports one unique value, so the stats are computed rather than copied")){pass=pass+1}el{fail=fail+1};

  let ep:$datasetprofile=mt prof.profilejsonarray("[]";"empty") {
    $ok:p p;
    $err:e $datasetprofile{name:"ERR";rowcount:9;colcount:9;columns:@();sensitivityhint:"ERR"}
  };
  if(t.assert((ep.colcount as i64)==0 && (ep.rowcount as i64)==0;"an empty dataset produces a profile with no rows and no columns")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ep.sensitivityhint;"no data";"which says it has no data rather than claiming it is clean")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(prof.totoonschema(ep);"SCHEMA:empty rows:0 cols:0");"and still renders a valid schema header")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.optimiser.toon;

i=t:std.test;
i=str:std.str;

(* --- stub TOON encoding/decoding functions --- *)

f=encode(json:str):str{
  (* stub: simulates JSON to TOON compact encoding *)
  (* removes whitespace and shortens keys *)
  if(str.contains(json;"\"message\"")){
    <"m=Hello world"
  };
  if(str.contains(json;"\"role\":\"user\"")){
    <"r=u;c=Hi"
  };
  if(str.contains(json;"\"empty\"")){
    <""
  };
  <json
};

f=decode(toon:str):str{
  (* stub: simulates TOON compact to JSON decoding *)
  if(str.eq(toon;"m=Hello world")){
    <"{\"message\":\"Hello world\"}"
  };
  if(str.eq(toon;"r=u;c=Hi")){
    <"{\"role\":\"user\",\"content\":\"Hi\"}"
  };
  if(str.eq(toon;"")){
    <""
  };
  <toon
};

f=savings(original:str;encoded:str):i64{
  let origlen=str.len(original);
  let enclen=str.len(encoded);
  if(origlen=0){<0};
  let saved=origlen-enclen;
  <saved
};

f=compressionratio(original:str;encoded:str):i64{
  let origlen=str.len(original);
  let enclen=str.len(encoded);
  if(origlen=0){<0};
  (* return percentage saved as integer *)
  let pct=(origlen-enclen)*100/origlen;
  <pct
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* encoding: message JSON to compact *)
  let enc1=encode("{\"message\":\"Hello world\"}");
  if(t.assert(str.eq(enc1;"m=Hello world");"message encoded to compact form")){pass=pass+1}el{fail=fail+1};

  (* encoding: role/content to compact *)
  let enc2=encode("{\"role\":\"user\",\"content\":\"Hi\"}");
  if(t.assert(str.eq(enc2;"r=u;c=Hi");"role/content encoded to compact form")){pass=pass+1}el{fail=fail+1};

  (* encoding: compact is shorter *)
  if(t.assert(str.len(enc1)<str.len("{\"message\":\"Hello world\"}");"encoded is shorter than original")){pass=pass+1}el{fail=fail+1};

  (* decoding: compact back to JSON *)
  let dec1=decode("m=Hello world");
  if(t.assert(str.contains(dec1;"\"message\"");"decoded contains message key")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(dec1;"Hello world");"decoded contains message value")){pass=pass+1}el{fail=fail+1};

  (* decoding: role/content back to JSON *)
  let dec2=decode("r=u;c=Hi");
  if(t.assert(str.contains(dec2;"\"role\"");"decoded contains role key")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(dec2;"\"content\"");"decoded contains content key")){pass=pass+1}el{fail=fail+1};

  (* round-trip: encode then decode *)
  let original="{\"message\":\"Hello world\"}";
  let roundtrip=decode(encode(original));
  if(t.assert(str.contains(roundtrip;"Hello world");"round-trip preserves message value")){pass=pass+1}el{fail=fail+1};

  (* savings measurement: positive savings *)
  let saved=savings("{\"message\":\"Hello world\"}";"m=Hello world");
  if(t.assert(saved>0;"savings is positive for compressed content")){pass=pass+1}el{fail=fail+1};

  (* savings measurement: empty original *)
  if(t.assert(savings("";""  )=0;"savings is zero for empty strings")){pass=pass+1}el{fail=fail+1};

  (* encoding: empty value *)
  let enc3=encode("{\"empty\":\"\"}");
  if(t.assert(str.eq(enc3;"");"empty value encodes to empty")){pass=pass+1}el{fail=fail+1};

  (* compression ratio: positive *)
  let ratio=compressionratio("{\"message\":\"Hello world\"}";"m=Hello world");
  if(t.assert(ratio>0;"compression ratio is positive")){pass=pass+1}el{fail=fail+1};

  <fail
};





m=tests.unit.optimiser.testtoon;

i=toon:optimiser.toon;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertinteq(name:str;got:i32;want:i32):$result{
  if(got = want){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @($result)@();

  
  let opts=toon.defaultopts();
  results=str.arraypush(results;asserttrue("default max_str_len 200";opts.maxstrlen = 200));

  
  results=str.arraypush(results;assertfalse("default abbreviate_keys false";opts.abbreviatekeys));

  
  results=str.arraypush(results;asserttrue("default omit_nulls true";opts.omitnulls));

  
  let strval=toon.$toonvalue.$str("hello");
  let encoded=toon.encode(strval;opts);
  results=str.arraypush(results;asserteq("encode plain str";encoded;"hello"));

  
  let nullval=toon.$toonvalue.$null;
  let encnull=toon.encode(nullval;opts);
  results=str.arraypush(results;asserteq("encode null is tilde";encnull;"~"));

  
  let trueval=toon.$toonvalue.$bool(true);
  let enctrue=toon.encode(trueval;opts);
  results=str.arraypush(results;asserteq("encode true is y";enctrue;"y"));

  
  let falseval=toon.$toonvalue.$bool(false);
  let encfalse=toon.encode(falseval;opts);
  results=str.arraypush(results;asserteq("encode false is n";encfalse;"n"));

  
  let intval=toon.$toonvalue.$int(42);
  let encint=toon.encode(intval;opts);
  results=str.arraypush(results;asserteq("encode int 42";encint;"42"));

  
  let simplejson="{\"name\":\"Alice\",\"age\":30}";
  let toonresult=toon.jsontotoon(simplejson;opts);
  mt toonresult {
    $ok:toonstr {
      results=str.arraypush(results;asserttrue("json_to_toon non-empty";str.len(toonstr) > 0));
      
      results=str.arraypush(results;asserttrue("toon contains name key";str.contains(toonstr;"name")));
      results=str.arraypush(results;asserttrue("toon contains age key";str.contains(toonstr;"age")));
      
      results=str.arraypush(results;asserttrue("toon contains Alice value";str.contains(toonstr;"Alice")));
    };
    $err:e {
      results=str.arraypush(results;fail("json_to_toon simple object";"unexpected error"));
    };
  };

  
  let datasetjson="{\"col_a\":\"val1\",\"col_b\":\"val2\",\"col_c\":\"val3\"}";
  let datasetresult=toon.jsontotoon(datasetjson;opts);
  mt datasetresult {
    $ok:dstoon {
      results=str.arraypush(results;asserttrue("toon contains col_a";str.contains(dstoon;"col_a")));
      results=str.arraypush(results;asserttrue("toon contains col_b";str.contains(dstoon;"col_b")));
      results=str.arraypush(results;asserttrue("toon contains col_c";str.contains(dstoon;"col_c")));
    };
    $err:e {
      results=str.arraypush(results;fail("json_to_toon 3 columns";"unexpected error"));
    };
  };

  
  let emptytable=toon.encodetable(@();opts);
  results=str.arraypush(results;asserteq("encode_table empty rows";emptytable;""));

  
  let rowfields=@(
    toon.$toonfield{key:"id";value:i64.$int(1)};
    toon.$toonfield{key:"label";value:i64.$str("test")};
  );
  let row=toon.$toonvalue.$obj(rowfields);
  let tableout=toon.encodetable(@($row);opts);
  results=str.arraypush(results;asserttrue("encode_table HDR prefix";str.contains(tableout;"HDR[")));
  results=str.arraypush(results;asserttrue("encode_table contains id column";str.contains(tableout;"id")));
  results=str.arraypush(results;asserttrue("encode_table contains label column";str.contains(tableout;"label")));

  
  let simpletoon="name:Alice|age:30";
  let jsonresult=toon.toontojson(simpletoon);
  mt jsonresult {
    $ok:jsonout {
      results=str.arraypush(results;asserttrue("toon_to_json non-empty";str.len(jsonout) > 0));
      results=str.arraypush(results;asserttrue("toon_to_json contains name";str.contains(jsonout;"name")));
    };
    $err:e {
      results=str.arraypush(results;fail("toon_to_json simple";"unexpected error"));
    };
  };

  
  let savingsempty=toon.measuresavings("";"toon");
  results=str.arraypush(results;asserttrue("measure_savings empty original is 0";savingsempty = 0.0));

  
  let longjson="{\"name\":\"Alice\",\"age\":30,\"city\":\"Sydney\"}";
  let shorttoon="name:Alice|age:30|city:Sydney";
  let savingspos=toon.measuresavings(longjson;shorttoon);
  results=str.arraypush(results;asserttrue("measure_savings positive for compact toon";savingspos > 0.0));

  
  let badresult=toon.fromjsonstr("not json at all {{{");
  mt badresult {
    $ok: { results=str.arraypush(results;fail("from_json_str invalid json";"expected error, got ok")); };
    $err: { results=str.arraypush(results;pass("from_json_str invalid json returns err")); };
  };

  
  let goodresult=toon.fromjsonstr("{\"x\":1}");
  mt goodresult {
    $ok: { results=str.arraypush(results;pass("from_json_str valid json returns ok")); };
    $err: { results=str.arraypush(results;fail("from_json_str valid json";"expected ok, got error")); };
  };

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

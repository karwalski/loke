m=test.optimiser.budget;

i=t:std.test;
i=str:std.str;

(* --- stub budget functions --- *)

f=checklimit(spent:i64;limit:i64):bool{
  (* returns true if within budget *)
  <spent<limit
};

f=isoverbudget(spent:i64;limit:i64):bool{
  <spent>=limit
};

f=remaining(spent:i64;limit:i64):i64{
  let r=limit-spent;
  if(r<0){<0};
  <r
};

f=matchperiod(period:str;day:i64):bool{
  if(str.eq(period;"daily")){<true};
  if(str.eq(period;"monthly")){<day=1};
  if(str.eq(period;"weekly")){<day<=7};
  <false
};

f=periodlabel(period:str):str{
  if(str.eq(period;"daily")){<"Today"};
  if(str.eq(period;"weekly")){<"This week"};
  if(str.eq(period;"monthly")){<"This month"};
  <"Unknown"
};

f=createbudget(limit:i64;period:str):str{
  let b=str.concat("{\"limit\":";limit.tostr());
  let b=str.concat(b;",\"period\":\"");
  let b=str.concat(b;period);
  let b=str.concat(b;"\",\"spent\":0}");
  <b
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* limit checking: within budget *)
  if(t.assert(checklimit(50;100);"50 spent of 100 is within budget")){pass=pass+1}el{fail=fail+1};

  (* limit checking: at budget *)
  if(t.assert(!checklimit(100;100);"100 spent of 100 is not within budget")){pass=pass+1}el{fail=fail+1};

  (* limit checking: over budget *)
  if(t.assert(!checklimit(150;100);"150 spent of 100 is over budget")){pass=pass+1}el{fail=fail+1};

  (* limit checking: zero spent *)
  if(t.assert(checklimit(0;100);"zero spent is within budget")){pass=pass+1}el{fail=fail+1};

  (* over budget checks *)
  if(t.assert(isoverbudget(100;100);"at limit is over budget")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!isoverbudget(50;100);"under limit is not over budget")){pass=pass+1}el{fail=fail+1};

  (* remaining calculation *)
  if(t.assert(remaining(30;100)=70;"remaining is 70 when 30 of 100 spent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(remaining(100;100)=0;"remaining is 0 when fully spent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(remaining(150;100)=0;"remaining is 0 when overspent")){pass=pass+1}el{fail=fail+1};

  (* period matching: daily always matches *)
  if(t.assert(matchperiod("daily";15);"daily matches any day")){pass=pass+1}el{fail=fail+1};

  (* period matching: monthly matches day 1 *)
  if(t.assert(matchperiod("monthly";1);"monthly matches day 1")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!matchperiod("monthly";15);"monthly does not match day 15")){pass=pass+1}el{fail=fail+1};

  (* period labels *)
  if(t.assert(str.eq(periodlabel("daily");"Today");"daily label is Today")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(periodlabel("monthly");"This month");"monthly label is This month")){pass=pass+1}el{fail=fail+1};

  (* budget creation *)
  let b=createbudget(500;"daily");
  if(t.assert(str.contains(b;"\"limit\":500");"budget contains limit")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(b;"\"spent\":0");"budget starts with zero spent")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.optimiser.profiler;

i=t:std.test;
i=str:std.str;
i=prof:core.optimiser.profiler;

(* X7.2 — this file imported core.optimiser.profiler and then declared stubs anyway. It is
   the case the inventory calls out separately, because a stub-marker count and an
   import count each read it as clean: the header said

     (* --- stub profiler functions --- *)

   and only two of its twelve assertions — findmin and findmax — reached the module. The
   other ten went to local copies with DIFFERENT SIGNATURES from the real functions:
   `ispiiname` returned i64 where the module returns bool, `infercoltype` took a
   comma-joined string where the module takes an array and returns a `$coltype` sum,
   `fmtpct` took an i64 where the module takes an f64, and `countunique` was a length
   estimator — `if(str.len(vals)<10){<2}` — labelled `(* stub: return estimated count
   based on length *)`. Every one of those ten assertions described a function that does
   not exist.

   The PII marker list is the assertion that matters here. `ispiiname` is what decides
   whether a column of a user's spreadsheet is treated as personal data on the no-custody
   path, and the stub's list omitted "account" and "key" — two of the twelve markers the
   module actually carries — while agreeing closely enough elsewhere that nobody would
   have noticed. *)

f=typeof(samples:@str):str{
  <prof.coltypetostr(prof.infercoltype(samples))
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── ispiiname: the twelve markers, one assertion each ───────────────────────
     A marker dropped from this list is a column of personal data that stops being
     treated as one, silently. There is no other test in the suite that would notice. *)
  if(t.assert(prof.ispiiname("user_email");"email is a PII marker")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("Phone");"phone is, and the match is case-insensitive")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("full_name");"name is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("street_address");"address is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("SSN");"ssn is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("dob");"dob is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("date_of_birth");"birth is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("credit_card");"credit is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("account_number");"account is — a marker the stubbed copy of this function did NOT have")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("password_hash");"password is")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("api_key");"key is — the other marker the stub omitted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.ispiiname("auth_token");"token is")){pass=pass+1}el{fail=fail+1};

  (* And the negatives, which are what stop it crying wolf over an entire spreadsheet. *)
  if(t.assert(!prof.ispiiname("revenue");"revenue is not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!prof.ispiiname("quantity");"quantity is not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!prof.ispiiname("");"and neither is an unnamed column")){pass=pass+1}el{fail=fail+1};

  (* The markers are SUBSTRING matches, which is deliberate and worth pinning: it is what
     makes "user_email" and "date_of_birth" match, and it is also why a column called
     "keyword" or "filename" is flagged. Over-flagging is the fail-safe direction for
     redaction, so it is recorded rather than treated as a bug. *)
  if(t.assert(prof.ispiiname("keyword");"a substring match means keyword is flagged too — over-flagging is the fail-safe direction here")){pass=pass+1}el{fail=fail+1};

  (* ── infercoltype ───────────────────────────────────────────────────────────
     Takes an ARRAY and returns a `$coltype` sum. A `mt` on a plain user sum does
     discriminate — it is only the error side of an `X!$err` that T-18 kills — so
     coltypetostr's six arms are all live. *)
  if(t.asserteq(typeof(@("true";"false";"true"));"bool";"true/false samples are a bool column")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(typeof(@("y";"n"));"bool";"and so are y/n")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(typeof(@("42";"17";"99"));"int";"whole numbers are an int column")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(typeof(@("3.14";"2.72"));"float";"decimals are a float column")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(typeof(@("2024-01-15";"2024-02-20"));"date";"ISO dates are a date column")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(typeof(@("alice";"bob"));"str";"words are a str column")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(typeof(@());"?";"and no samples is unknown, not str — the difference matters because a TOON schema built from ? says so")){pass=pass+1}el{fail=fail+1};

  (* One non-conforming sample must demote the whole column. A column typed int because
     most of it parses is a column whose remaining rows are dropped or misread. *)
  if(t.asserteq(typeof(@("42";"17";"n/a"));"str";"a single non-numeric sample demotes an otherwise-int column to str")){pass=pass+1}el{fail=fail+1};

  (* The date hint rides on the same sum, and only the date arm carries text. *)
  if(t.asserteq(prof.datehintfor(prof.infercoltype(@("2024-01-15")));" [date?]";"a date column carries the date hint")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(prof.datehintfor(prof.infercoltype(@("42")));"";"and nothing else does")){pass=pass+1}el{fail=fail+1};

  (* ── countunique, findmin, findmax ──────────────────────────────────────────
     countunique is the one the stub replaced with a length estimator. It must actually
     deduplicate: a unique count is what tells a schema profile whether a column is
     categorical, and a wrong one changes how the column is described to a model. *)
  if(t.assert((prof.countunique(@("a";"b";"a";"c";"b")) as i64)==3;"countunique deduplicates rather than counting entries")){pass=pass+1}el{fail=fail+1};
  if(t.assert((prof.countunique(@()) as i64)==0;"an empty column has no unique values")){pass=pass+1}el{fail=fail+1};
  if(t.assert((prof.countunique(@("x";"x";"x")) as i64)==1;"a constant column has exactly one")){pass=pass+1}el{fail=fail+1};

  (* ── FINDING, LIVE, NOT FIXED HERE: findmin and findmax do not find ──────────
     `std.str.compare` is NOT a three-way comparison. Measured directly:

       str.compare("apple";"banana")  ->  1
       str.compare("banana";"apple")  ->  1
       str.compare("apple";"apple")   ->  0

     It returns 1 for BOTH orderings. It is an inequality predicate, and nothing in this
     repository treats it as one. So in profiler.tk:211-241 —

       let cmp=str.compare(v;m);
       if(cmp<0){ m=v }el{}        (* findmin: never fires *)
       if(cmp>0){ m=v }el{}        (* findmax: fires on every unequal pair *)

     — findmin's test is DEAD CODE and it returns the FIRST element, while findmax's
     fires every time and it returns the LAST. Measured:
     findmin(cherry,banana,apple) = "cherry"; findmax(apple,cherry,banana) = "banana".
     The two-element cases that exist elsewhere in the suite happened to be ordered so
     that first == min and last == max, which is why this survived.

     It is not latent. profilecol sets $colprofile.minval and .maxval from these, and
     totoonschema renders them into the schema description SENT TO THE MODEL on the
     no-custody path — so a column's stated range is whatever value happened to come
     first and last, presented as its minimum and maximum. A recipient reasoning about
     the data from that range is reasoning from two arbitrary cells.

     Asserted in the honest direction, so this test is RED until findmin and findmax
     compare. `str.compare` has only three call sites in product source
     (profiler.tk:218, profiler.tk:234, moke/src/compute.tk:582 — a date sort), so the
     fix is small; it is not made here because the module is not this story's. *)
  if(t.asserteq(prof.findmin(@("banana";"apple";"cherry"));"apple";"findmin returns the lexicographic minimum, not the first element")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(prof.findmax(@("apple";"cherry";"banana"));"cherry";"findmax returns the maximum, not the last element")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(prof.findmin(@("only"));"only";"a single-element column is its own minimum")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(prof.findmin(@());"";"and an empty one yields empty rather than crashing")){pass=pass+1}el{fail=fail+1};

  (* takesamples caps what is shown, and a profile is only safe to send because it is
     capped: samplevals go into the TOON schema, so this is the boundary between
     describing a column and disclosing its contents. *)
  if(t.assert(prof.takesamples(@("a";"b";"c";"d";"e");3).len==3;"takesamples caps the sample list at the requested size")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prof.takesamples(@("a";"b");5).len==2;"and returns everything when there is less than that")){pass=pass+1}el{fail=fail+1};

  (* ── fmtpct ─────────────────────────────────────────────────────────────────
     An f64 PARAMETER, which crosses a module boundary intact — it is only a bare f64
     RETURN that is corrupted (T-20). The stub took an i64, so its two assertions said
     nothing about the real function. *)
  if(t.asserteq(prof.fmtpct(0.0);"0%";"zero is rendered exactly, without a decimal tail")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(prof.fmtpct(42.5);"%");"a non-zero percentage carries its sign")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(prof.fmtpct(42.5);"42");"and its value")){pass=pass+1}el{fail=fail+1};

  <fail
};





m=tests.unit.governancesrc.testownership;

i=own:loke.governance.ownership;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  
  own.gownerships=@();

  let results = @($result);

  let alice=$owner{
    id:"owner_alice";
    name:"Alice";
    email:"alice@example.com";
    role:"business"
  };

  
  own.assign("uc_1";"business";alice);
  let ucoopt=own.get("uc_1");
  mt ucoopt {
    $some:uco{
      results=str.arraypush(results;asserteq("assign stores use_case_id";"uc_1";uco.usecaseid))
    };
    $none:{
      results=str.arraypush(results;fail("assign then get returns some";"returned none"))
    }
  };

  
  let ucoopt2=own.get("uc_1");
  mt ucoopt2 {
    $some:uco{
      mt uco.businessowner {
        $some:o{
          results=str.arraypush(results;asserteq("get returns Alice as business owner";"Alice";o.name))
        };
        $none:{
          results=str.arraypush(results;fail("business_owner is some after assign";"returned none"))
        }
      }
    };
    $none:{
      results=str.arraypush(results;fail("get uc_1 after business assign";"returned none"))
    }
  };

  
  let ucoopt3=own.get("uc_1");
  mt ucoopt3 {
    $some:uco{
      results=str.arraypush(results;assertfalse("has_all_owners false when roles missing";own.hasallowners(uco)))
    };
    $none:{
      results=str.arraypush(results;fail("get uc_1 for has_all_owners check";"returned none"))
    }
  };

  
  let ucoopt4=own.get("uc_1");
  mt ucoopt4 {
    $some:uco{
      let missing=own.missingroles(uco);
      let missinglen=str.arraylen(missing);
      results=str.arraypush(results;asserttrue("missing_roles returns 2 roles";missinglen = 2))
    };
    $none:{
      results=str.arraypush(results;fail("get uc_1 for missing_roles check";"returned none"))
    }
  };

  
  let bob=$owner{
    id:"owner_bob";
    name:"Bob";
    email:"bob@example.com";
    role:"technical"
  };
  let carol=$owner{
    id:"owner_carol";
    name:"Carol";
    email:"carol@example.com";
    role:"risk"
  };
  own.assign("uc_1";"technical";bob);
  own.assign("uc_1";"risk";carol);
  let ucoopt5=own.get("uc_1");
  mt ucoopt5 {
    $some:uco{
      results=str.arraypush(results;asserttrue("has_all_owners true when all roles assigned";own.hasallowners(uco)))
    };
    $none:{
      results=str.arraypush(results;fail("get uc_1 after all roles assigned";"returned none"))
    }
  };

  
  let ucoopt6=own.get("uc_1");
  mt ucoopt6 {
    $some:uco{
      let missing2=own.missingroles(uco);
      let missing2len=str.arraylen(missing2);
      results=str.arraypush(results;asserttrue("missing_roles empty when all assigned";missing2len = 0))
    };
    $none:{
      results=str.arraypush(results;fail("get uc_1 for final missing_roles check";"returned none"))
    }
  };

  
  let allowners=own.list();
  let allownerslen=str.arraylen(allowners);
  results=str.arraypush(results;asserttrue("list returns at least one ownership";allownerslen > 1));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(!(i<n)){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1;
    }
  };
  <all
};





m=tests.unit.governancesrc.testjustification;

i=just:loke.governance.justification;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  
  just.gjustifications=@();

  let results = @$result@();

  
  let j=just.$justification{
    usecaseid:"use_case_1";
    purpose:"compliance automation";
    whyai:"We need this for compliance";
    expectedvalue:"Reduce compliance overhead";
    identifiedrisks:"Model drift";
    simpleralternatives:@();
    submittedat:0;
    approved:false;
    approverid:""
  };
  just.submit(j);
  let fetched=just.get("use_case_1");
  mt fetched {
    $some:got{
      results=str.arraypush(results;asserteq("submit creates retrievable justification";"use_case_1";got.usecaseid))
    };
    $none:{
      results=str.arraypush(results;fail("submit then get returns some";"returned none"))
    };
  };

  
  let fetched2=just.get("use_case_1");
  mt fetched2 {
    $some:got{
      results=str.arraypush(results;asserteq("get returns correct why_ai";"We need this for compliance";got.whyai))
    };
    $none:{
      results=str.arraypush(results;fail("get returns correct rationale";"returned none"))
    };
  };

  
  just.approve("use_case_1";"approver_alice");
  let approvedopt=just.get("use_case_1");
  mt approvedopt {
    $some:got{
      results=str.arraypush(results;asserttrue("approve sets approved=true";got.approved))
    };
    $none:{
      results=str.arraypush(results;fail("approved justification still retrievable";"returned none"))
    };
  };

  
  let simpler=just.suggestsimpler("compliance automation");
  let simplerlen=str.arraylen(simpler);
  results=str.arraypush(results;asserttrue("suggest_simpler returns >= 1 entry";simplerlen > 1));

  
  let approvedj=just.$justification{
    usecaseid:"use_case_1";
    purpose:"compliance automation";
    whyai:"We need this for compliance";
    expectedvalue:"Reduce compliance overhead";
    identifiedrisks:"Model drift";
    simpleralternatives:@();
    submittedat:0;
    approved:true;
    approverid:"approver_alice"
  };
  let jsonout=just.tojson(approvedj);
  results=str.arraypush(results;asserttrue("to_json contains use_case_id";str.contains(jsonout;"use_case_id")));
  results=str.arraypush(results;asserttrue("to_json contains why_ai (rationale)";str.contains(jsonout;"why_ai")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};





m=tests.unit.governancesrc.testincidents;

i=inc:loke.governance.incidents;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  
  inc.gincidents=@();

  let results = @($result)@();

  
  let incident=inc.create("data_leak";"critical";"PII exposed";"PII data was exposed in logs";false);
  results=str.arraypush(results;asserttrue("create returns incident with id";!str.eq(incident.id;"")));

  
  inc.gincidents=inc.append(inc.gincidents;incident);
  let allafterappend=inc.listall();
  let alllen=str.arraylen(allafterappend);
  results=str.arraypush(results;asserttrue("list_all count >= 1 after append";alllen > 1));

  
  let fetched=inc.get(incident.id);
  mt fetched {
    $some:i{
      results=str.arraypush(results;asserteq("get returns correct incident_type";"data_leak";i.incidenttype))
    };
    $none:{
      results=str.arraypush(results;fail("get after append returns some";"returned none"))
    };
  };

  
  inc.resolve(incident.id;"resolved by test");
  let resolvedopt=inc.get(incident.id);
  mt resolvedopt {
    $some:i{
      results=str.arraypush(results;asserttrue("resolve sets resolved=true";i.resolved))
    };
    $none:{
      results=str.arraypush(results;fail("resolved incident still retrievable";"returned none"))
    };
  };

  
  let open=inc.listopen();
  let openlen=str.arraylen(open);
  results=str.arraypush(results;asserttrue("list_open excludes resolved";openlen = 0));

  
  let openincident=inc.create("policy_violation";"high";"Policy breach";"Policy was violated";false);
  inc.gincidents=inc.append(inc.gincidents;openincident);
  let allboth=inc.listall();
  let allbothlen=str.arraylen(allboth);
  results=str.arraypush(results;asserttrue("list_all includes both open and resolved";allbothlen > 2));

  
  let tmpl=inc.postincidenttemplate(incident);
  results=str.arraypush(results;asserttrue("post_incident_template non-empty";!str.eq(tmpl;"")));
  results=str.arraypush(results;asserttrue("post_incident_template contains incident";str.contains(tmpl;"incident")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

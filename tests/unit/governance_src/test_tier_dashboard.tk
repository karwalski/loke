



m=tests.unit.governancesrc.testtierdashboard;

i=td:loke.governance.tierdashboard;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got == want{ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  let report=td.newreport(7);
  results=str.arraypush(results;assertinteq("new_report interactive_count=0";report.interactive.requestcount;0));
  results=str.arraypush(results;assertinteq("new_report considered_count=0";report.considered.requestcount;0));
  results=str.arraypush(results;assertinteq("new_report background_count=0";report.background.requestcount;0));
  results=str.arraypush(results;assertinteq("new_report total_requests=0";report.totalrequests;0));

  
  let report2=td.updateinteractive(report;120;4.5;"gpt-4o";50.0;0.02);
  results=str.arraypush(results;assertinteq("update_interactive increments count";report2.interactive.requestcount;1));
  results=str.arraypush(results;assertinteq("update_interactive increments total";report2.totalrequests;1));

  
  let report3=td.recalculatepcts(report2);
  results=str.arraypush(results;asserttrue("interactive_pct > 0 after recalculate";report3.interactive.requestpct > 0.0));

  
  
  let pctstr=str.fromf32(report3.interactive.requestpct);
  results=str.arraypush(results;asserttrue("interactive_pct = 100 when only tier";str.contains(pctstr;"100")));

  
  let jsonout=td.reporttojson(report3);
  results=str.arraypush(results;asserttrue("report_to_json contains interactive";str.contains(jsonout;"interactive")));
  results=str.arraypush(results;asserttrue("report_to_json contains considered";str.contains(jsonout;"considered")));
  results=str.arraypush(results;asserttrue("report_to_json contains background";str.contains(jsonout;"background")));

  
  let zeroreport=td.newreport(7);
  let zeroafter=td.recalculatepcts(zeroreport);
  results=str.arraypush(results;assertinteq("zero total: interactive_count still 0";zeroafter.interactive.requestcount;0));
  results=str.arraypush(results;asserttrue("zero total: interactive_pct = 0";zeroafter.interactive.requestpct == 0.0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i >= n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};

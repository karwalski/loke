



m=tests.unit.governancesrc.testkillswitch;

i=ks:loke.governance.killswitch;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  ks.gglobalactive=false;
  results=str.arraypush(results;assertfalse("fresh state global inactive";ks.isglobalactive()));

  
  ks.enableglobal("test reason";"tester");
  results=str.arraypush(results;asserttrue("global active after enable";ks.isglobalactive()));

  
  ks.disableglobal();
  results=str.arraypush(results;assertfalse("global inactive after disable";ks.isglobalactive()));

  
  ks.enableprovider("anthropic";"test block";"tester");
  results=str.arraypush(results;asserttrue("anthropic blocked after enable_provider";ks.isblocked("provider";"anthropic")));

  
  results=str.arraypush(results;assertfalse("ollama not blocked when only anthropic blocked";ks.isblocked("provider";"ollama")));

  
  let active=ks.listactive();
  let activelen=str.arraylen(active);
  results=str.arraypush(results;asserttrue("list_active non-empty after enable";activelen > 0));

  
  let fb=ks.fallbackmessage("provider";"anthropic");
  results=str.arraypush(results;asserttrue("fallback_message non-empty";!str.eq(fb.message;"")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

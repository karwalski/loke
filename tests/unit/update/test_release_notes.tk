m=test.update.releasenotes;

i=t:std.test;
i=str:std.str;
i=u8:shared.utf8;
i=ck:core.update.checker;

(* F10.49 — the update checker stores the first 200 BYTES of a release's notes, and the cut
   never splits a UTF-8 character. Release notes are written by people and often hold an
   emoji; the cut was `fullnotes.slice(0;200)`, so the stored notes could end in part of a
   character. Still a byte limit; the cut is shared.utf8.prefix. Tested through
   `clipnotes`, which `parserelease` uses; fetching a release needs the network. *)

f=repeat(s:str;n:i64):str{
  let out=mut."";
  lp(let i=0;i<n;i=i+1){ out="\(out)\(s)" };
  <out
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let jp="日";
  let emoji="😀";
  let e2="é";
  let a="a";
  let x="x";

  if(t.asserteq(ck.clipnotes(repeat(a;250));repeat(a;200);"ASCII notes are cut at exactly 200 bytes")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ck.clipnotes(repeat(a;20));repeat(a;20);"and short notes are kept whole")){pass=pass+1}el{fail=fail+1};

  (* 67 three-byte characters are 201 bytes; byte 200 is inside the 67th. *)
  let n3=ck.clipnotes(repeat(jp;67));
  if(t.asserteq(n3;repeat(jp;66);"3-byte characters crossing byte 200 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(n3);"and the stored notes are valid UTF-8")){pass=pass+1}el{fail=fail+1};
  (* "a" and 50 emoji are 201 bytes; byte 200 is inside the 50th. *)
  let n4=ck.clipnotes("\(a)\(repeat(emoji;50))");
  if(t.asserteq(n4;"\(a)\(repeat(emoji;49))";"4-byte characters crossing byte 200 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(n4);"and those notes are valid UTF-8")){pass=pass+1}el{fail=fail+1};
  let n2=ck.clipnotes("\(repeat(a;199))\(e2)\(x)");
  if(t.asserteq(n2;repeat(a;199);"a 2-byte character split after its lead byte is dropped whole")){pass=pass+1}el{fail=fail+1};

  <fail
};

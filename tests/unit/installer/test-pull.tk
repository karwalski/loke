
m=tests.unit.installer.testpull;

i=pull:core.installer.pull;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertf64gt(name:$str;got:f64;threshold:f64):$result{
  if(got > threshold){ <pass(name) }el{
    <fail(name;str.concat("expected > ";str.concat(str.fromf64(threshold);str.concat(" got=";str.fromf64(got)))))
  };
};

f=asserti64gt(name:$str;got:i64;threshold:i64):$result{
  if(got > threshold){ <pass(name) }el{
    <fail(name;str.concat("expected > ";str.concat(str.fromint(threshold);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};


f=runall():bool{
  let results=mut.@$result@();

  let line1="pulling abc123...  45%  2.0 GB/4.5 GB  12s";
  let p1=pull.parseprogressline("qwen2.5:7b";line1);
  results=@.push(results;asserteq("progress line model_id";p1.modelid;"qwen2.5:7b"));
  results=@.push(results;asserteq("progress line status downloading";p1.status;"downloading"));
  results=@.push(results;assertf64gt("progress line percent > 0";p1.percent;0.0));
  results=@.push(results;asserti64gt("progress line total_bytes > 0";p1.totalbytes;0));
  results=@.push(results;asserti64gt("progress line downloaded_bytes > 0";p1.downloadedbytes;0));
  results=@.push(results;asserttrue("progress line eta >= 0";p1.etaseconds >= 0));

  let line2="pulling manifest";
  let p2=pull.parseprogressline("qwen2.5:3b";line2);
  results=@.push(results;asserteq("manifest line model_id";p2.modelid;"qwen2.5:3b"));
  results=@.push(results;asserteq("manifest line status preparing";p2.status;"preparing"));
  results=@.push(results;asserttrue("manifest line percent 0";p2.percent = 0.0));

  let line3="success";
  let p3=pull.parseprogressline("qwen2.5:7b";line3);
  results=@.push(results;asserteq("success line status complete";p3.status;"complete"));

  let line4="error: model not found";
  let p4=pull.parseprogressline("qwen2.5:7b";line4);
  results=@.push(results;asserteq("error line status error";p4.status;"error"));

  let line5="pulling abc123... 100%  4.5 GB/4.5 GB  0s";
  let p5=pull.parseprogressline("qwen2.5:7b";line5);
  results=@.push(results;asserteq("100% line status downloading";p5.status;"downloading"));
  results=@.push(results;asserttrue("100% line percent = 100";p5.percent = 100.0));

  let line6="pulling xyz789...  78%  700 MB/900 MB  5s";
  let p6=pull.parseprogressline("qwen2.5:1.5b";line6);
  results=@.push(results;asserteq("MB line status downloading";p6.status;"downloading"));
  results=@.push(results;assertf64gt("MB line percent > 0";p6.percent;0.0));

  let line7="verifying sha256 digest";
  let p7=pull.parseprogressline("qwen2.5:7b";line7);
  results=@.push(results;asserteq("verify line status preparing";p7.status;"preparing"));

  let line8="writing manifest";
  let p8=pull.parseprogressline("qwen2.5:7b";line8);
  results=@.push(results;asserteq("writing manifest status preparing";p8.status;"preparing"));

  let emptyprogress=pull.$pullprogress{
    modelid:"test";
    totalbytes:1000;
    downloadedbytes:500;
    percent:50.0;
    etaseconds:10;
    status:"downloading"
  };
  results=@.push(results;asserteq("pull_progress model_id field";emptyprogress.modelid;"test"));
  results=@.push(results;asserttrue("pull_progress total_bytes field";emptyprogress.totalbytes = 1000));
  results=@.push(results;asserttrue("pull_progress downloaded_bytes field";emptyprogress.downloadedbytes = 500));
  results=@.push(results;asserttrue("pull_progress percent field";emptyprogress.percent = 50.0));
  results=@.push(results;asserttrue("pull_progress eta_seconds field";emptyprogress.etaseconds = 10));
  results=@.push(results;asserteq("pull_progress status field";emptyprogress.status;"downloading"));

  let available=pull.ismodelavailable("qwen2.5:7b");
  results=@.push(results;assertfalse("is_model_available returns false when ollama down";available));

  let installed=pull.listinstalledmodels();
  results=@.push(results;asserttrue("list_installed_models empty when ollama down";@.len(installed) = 0));

  let allpassed=true;
  let i=0;
  let n=@.len(results);
  loop{
    if(i >= n){ break }el{
      let r=@.get(results;i);
      logresult(r);
      if(!$r.passed){ allpassed=false }el{};
      i=i+1
    };
  };
  <allpassed
};

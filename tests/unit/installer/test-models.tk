
m=tests.unit.installer.testmodels;

i=models:core.installer.models;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(name:$str):$result{ <$result{name:$name;passed:true;message:"ok"} };
f=fail(name:$str;msg:$str):$result{ <$result{name:$name;passed:false;message:$msg} };

f=asserteq(name:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:$str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:$str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=assertf64eq(name:$str;got:f64;want:f64):$result{
  if(got = want){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(str.fromf64(want);str.concat(" got=";str.fromf64(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=mut.@($result@();

  let rec4=models.recommendmodel(4);
  results=@.push(results;asserteq("4 GB -> qwen2.5:1.5b";rec4.modelid;"qwen2.5:1.5b"));
  results=@.push(results;asserteq("4 GB -> Qwen 2.5 1.5B name";rec4.modelname;"Qwen 2.5 1.5B"));
  results=@.push(results;assertf64eq("4 GB -> 1.0 GB size";rec4.sizegb;1.0));

  let rec6=models.recommendmodel(6);
  results=@.push(results;asserteq("6 GB -> qwen2.5:1.5b";rec6.modelid;"qwen2.5:1.5b"));

  let rec7=models.recommendmodel(7);
  results=@.push(results;asserteq("7 GB -> qwen2.5:1.5b";rec7.modelid;"qwen2.5:1.5b"));

  let rec2=models.recommendmodel(2);
  results=@.push(results;asserteq("2 GB -> qwen2.5:1.5b (fallback)";rec2.modelid;"qwen2.5:1.5b"));

  let rec8=models.recommendmodel(8);
  results=@.push(results;asserteq("8 GB -> qwen2.5:3b";rec8.modelid;"qwen2.5:3b"));
  results=@.push(results;asserteq("8 GB -> Qwen 2.5 3B name";rec8.modelname;"Qwen 2.5 3B"));
  results=@.push(results;assertf64eq("8 GB -> 2.0 GB size";rec8.sizegb;2.0));

  let rec12=models.recommendmodel(12);
  results=@.push(results;asserteq("12 GB -> qwen2.5:3b";rec12.modelid;"qwen2.5:3b"));

  let rec15=models.recommendmodel(15);
  results=@.push(results;asserteq("15 GB -> qwen2.5:3b";rec15.modelid;"qwen2.5:3b"));

  let rec16=models.recommendmodel(16);
  results=@.push(results;asserteq("16 GB -> qwen2.5:7b";rec16.modelid;"qwen2.5:7b"));
  results=@.push(results;asserteq("16 GB -> Qwen 2.5 7B name";rec16.modelname;"Qwen 2.5 7B"));
  results=@.push(results;assertf64eq("16 GB -> 4.5 GB size";rec16.sizegb;4.5));

  let rec24=models.recommendmodel(24);
  results=@.push(results;asserteq("24 GB -> qwen2.5:7b";rec24.modelid;"qwen2.5:7b"));

  let rec31=models.recommendmodel(31);
  results=@.push(results;asserteq("31 GB -> qwen2.5:7b";rec31.modelid;"qwen2.5:7b"));

  let rec32=models.recommendmodel(32);
  results=@.push(results;asserteq("32 GB -> qwen2.5:14b";rec32.modelid;"qwen2.5:14b"));
  results=@.push(results;asserteq("32 GB -> Qwen 2.5 14B name";rec32.modelname;"Qwen 2.5 14B"));
  results=@.push(results;assertf64eq("32 GB -> 9.0 GB size";rec32.sizegb;9.0));

  let rec48=models.recommendmodel(48);
  results=@.push(results;asserteq("48 GB -> qwen2.5:14b";rec48.modelid;"qwen2.5:14b"));

  let rec63=models.recommendmodel(63);
  results=@.push(results;asserteq("63 GB -> qwen2.5:14b";rec63.modelid;"qwen2.5:14b"));

  let rec64=models.recommendmodel(64);
  results=@.push(results;asserteq("64 GB -> qwen2.5:32b";rec64.modelid;"qwen2.5:32b"));
  results=@.push(results;asserteq("64 GB -> Qwen 2.5 32B name";rec64.modelname;"Qwen 2.5 32B"));
  results=@.push(results;assertf64eq("64 GB -> 20.0 GB size";rec64.sizegb;20.0));

  let rec128=models.recommendmodel(128);
  results=@.push(results;asserteq("128 GB -> qwen2.5:32b";rec128.modelid;"qwen2.5:32b"));

  let model7b=models.recommendmodel(16);
  results=@.push(results;asserttrue("disk check: 10 GB free for 7b passes";models.hasenoughdisk(model7b;10)));
  results=@.push(results;asserttrue("disk check: 7 GB free for 7b passes";models.hasenoughdisk(model7b;7)));
  results=@.push(results;assertfalse("disk check: 5 GB free for 7b fails";models.hasenoughdisk(model7b;5)));
  results=@.push(results;assertfalse("disk check: 0 GB free fails";models.hasenoughdisk(model7b;0)));

  let model15b=models.recommendmodel(4);
  results=@.push(results;asserttrue("disk check: 4 GB free for 1.5b passes";models.hasenoughdisk(model15b;4)));
  results=@.push(results;assertfalse("disk check: 2 GB free for 1.5b fails";models.hasenoughdisk(model15b;2)));

  let model32b=models.recommendmodel(64);
  results=@.push(results;asserttrue("disk check: 30 GB free for 32b passes";models.hasenoughdisk(model32b;30)));
  results=@.push(results;assertfalse("disk check: 20 GB free for 32b fails";models.hasenoughdisk(model32b;20)));

  let all=models.allmodels();
  results=@.push(results;asserttrue("all_models returns 5 entries";@.len(all) = 5));

  let m0=@.get(all;0);
  results=@.push(results;asserteq("all_models[0] is 1.5b";m0.modelid;"qwen2.5:1.5b"));
  let m1=@.get(all;1);
  results=@.push(results;asserteq("all_models[1] is 3b";m1.modelid;"qwen2.5:3b"));
  let m2=@.get(all;2);
  results=@.push(results;asserteq("all_models[2] is 7b";m2.modelid;"qwen2.5:7b"));
  let m3=@.get(all;3);
  results=@.push(results;asserteq("all_models[3] is 14b";m3.modelid;"qwen2.5:14b"));
  let m4=@.get(all;4);
  results=@.push(results;asserteq("all_models[4] is 32b";m4.modelid;"qwen2.5:32b"));

  results=@.push(results;asserttrue("all_models[0] min_ram 4";m0.minramgb = 4));
  results=@.push(results;asserttrue("all_models[1] min_ram 8";m1.minramgb = 8));
  results=@.push(results;asserttrue("all_models[2] min_ram 16";m2.minramgb = 16));
  results=@.push(results;asserttrue("all_models[3] min_ram 32";m3.minramgb = 32));
  results=@.push(results;asserttrue("all_models[4] min_ram 64";m4.minramgb = 64));

  let allpassed=true;
  let i=0;
  let n=@.len(results);
  loop{
    if(i >= n){ break }el{
      let r=@.get(results;i);
      logresult(r);
      if(!$r.passed){ allpassed=false }el{};
      i=i+1;
    };
  };
  <allpassed
};

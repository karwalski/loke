
m=tests.unit.installer.testinstall;

i=install:core.installer.install;
i=start:core.installer.start;
i=detect:core.installer.detect;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };
f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};
f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();


  let success = install.$installresult{success:true;message:"installed";version:"0.5.1"};
  results:str.arraypush(results;asserttrue("install_result success=true";success.success));
  results:str.arraypush(results;asserteq("install_result message";"installed";success.message));
  results:str.arraypush(results;asserteq("install_result version";"0.5.1";success.version));

  let failure = install.$installresult{success:false;message:"download failed";version:""};
  results:str.arraypush(results;assertfalse("install_result success=false";failure.success));
  results:str.arraypush(results;asserteq("install_result failure message";"download failed";failure.message));
  results:str.arraypush(results;asserteq("install_result failure version empty";"";failure.version));

  let fallback = install.$installresult{
    success:false;
    message:"download failed -- try manually from https://ollama.com/download";
    version:""
  };
  results=str.arraypush(results;asserttrue("fallback message contains URL";str.contains(fallback.message;"ollama.com")));


  let started = start.$startresult{success:true;message:"ollama serve started"};
  results:str.arraypush(results;asserttrue("start_result success=true";started.success));
  results:str.arraypush(results;asserteq("start_result message";"ollama serve started";started.message));

  let startfail = start.$startresult{success:false;message:"ollama binary not found"};
  results:str.arraypush(results;assertfalse("start_result success=false";startfail.success));

  let timeout = start.$startresult{
    success:false;
    message:"ollama failed to start within 15 seconds -- check if(port 11434 is in use: lsof -i :11434"
  };
  results=str.arraypush(results;asserttrue("timeout message mentions port";str.contains(timeout.message;"11434")));


  let ready = detect.$installstate{
    ollamainstalled:true;ollamaversion:"0.5.1";ollamarunning:true;
    modelpulled:true;modelid:"qwen2.5:7b";diskfreegb:89;
    ramgb:16;isarm64:true;hasinternet:true;platform:"macos"
  };
  let needsnothing = ready.ollamainstalled && ready.ollamarunning && ready.modelpulled;
  results=str.arraypush(results;asserttrue("ready state needs no action";needsnothing));

  let needsstart = detect.$installstate{
    ollamainstalled:true;ollamaversion:"0.5.1";ollamarunning:false;
    modelpulled:true;modelid:"qwen2.5:7b";diskfreegb:89;
    ramgb:16;isarm64:true;hasinternet:true;platform:"macos"
  };
  let shouldstart = needsstart.ollamainstalled && !$needsstart.ollamarunning;
  results=str.arraypush(results;asserttrue("installed not running -> start";shouldstart));

  let needspull = detect.$installstate{
    ollamainstalled:true;ollamaversion:"0.5.1";ollamarunning:true;
    modelpulled:false;modelid:"qwen2.5:7b";diskfreegb:89;
    ramgb:16;isarm64:true;hasinternet:true;platform:"macos"
  };
  let shouldpull = needspull.ollamainstalled && needspull.ollamarunning && !$needspull.modelpulled;
  results=str.arraypush(results;asserttrue("running no model -> pull";shouldpull));

  let needsinstall = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:3b";diskfreegb:50;
    ramgb:8;isarm64:false;hasinternet:true;platform:"linux"
  };
  let shouldfullinstall = !$needsinstall.ollamainstalled && needsinstall.hasinternet;
  results=str.arraypush(results;asserttrue("not installed with internet -> full install";shouldfullinstall));

  let offline = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:3b";diskfreegb:50;
    ramgb:8;isarm64:false;hasinternet:false;platform:"linux"
  };
  let needsmanual = !$offline.ollamainstalled && !$offline.hasinternet;
  results=str.arraypush(results;asserttrue("offline no install -> manual instructions";needsmanual));


  let autodisabled = start.$startresult{success:true;message:"auto_start disabled"};
  results:str.arraypush(results;asserttrue("auto_start disabled succeeds";autodisabled.success));
  results:str.arraypush(results;asserteq("auto_start disabled message";"auto_start disabled";autodisabled.message));

  let alreadyrunning = start.$startresult{success:true;message:"ollama already running"};
  results:str.arraypush(results;asserttrue("already running succeeds";alreadyrunning.success));

  let notinstalled = start.$startresult{success:false;message:"ollama not installed -- run setup to install"};
  results:str.arraypush(results;assertfalse("not installed fails";notinstalled.success));
  results:str.arraypush(results;asserttrue("not installed message mentions setup";str.contains(notinstalled.message;"setup")));


  let macosstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:7b";diskfreegb:89;
    ramgb:16;isarm64:true;hasinternet:true;platform:"macos"
  };
  results=str.arraypush(results;asserteq("macos platform";"macos";macosstate.platform));
  results=str.arraypush(results;asserttrue("macos is arm64";macosstate.isarm64));

  let linuxstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:3b";diskfreegb:50;
    ramgb:8;isarm64:false;hasinternet:true;platform:"linux"
  };
  results=str.arraypush(results;asserteq("linux platform";"linux";linuxstate.platform));

  let winstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:3b";diskfreegb:100;
    ramgb:16;isarm64:false;hasinternet:true;platform:"windows"
  };
  results=str.arraypush(results;asserteq("windows platform";"windows";winstate.platform));


  let verify = install.verifyinstall();
  results=str.arraypush(results;pass("verify_install returns without crash"));
  let verifyhasfields = verify.success || !$verify.success;
  results=str.arraypush(results;asserttrue("verify_install has success field";verifyhasfields));


  let stop = start.stopollama();
  results=str.arraypush(results;asserttrue("stop_ollama no-op succeeds";stop.success));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

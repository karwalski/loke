
m=tests.unit.installer.testdetect;

i=detect:core.installer.detect;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };
f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};
f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};
f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};
f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let okresult = detect.$detectresult{ok:true;value:"test";error:""};
  results:str.arraypush(results;asserttrue("detect_result ok=true";okresult.ok));
  results:str.arraypush(results;asserteq("detect_result value";"test";okresult.value));

  let errresult = detect.$detectresult{ok:false;value:"";error:"not found"};
  results:str.arraypush(results;assertfalse("detect_result ok=false";errresult.ok));
  results:str.arraypush(results;asserteq("detect_result error";"not found";errresult.error));

  let state = detect.$installstate{
    ollamainstalled:true;
    ollamaversion:"0.5.1";
    ollamarunning:true;
    modelpulled:true;
    modelid:"qwen2.5:7b";
    diskfreegb:89;
    ramgb:16;
    isarm64:true;
    hasinternet:true;
    platform:"macos"
  };
  results=str.arraypush(results;asserttrue("install_state ollama_installed";state.ollamainstalled));
  results=str.arraypush(results;asserteq("install_state ollama_version";"0.5.1";state.ollamaversion));
  results=str.arraypush(results;asserttrue("install_state ollama_running";state.ollamarunning));
  results=str.arraypush(results;asserttrue("install_state model_pulled";state.modelpulled));
  results=str.arraypush(results;asserteq("install_state model_id";"qwen2.5:7b";state.modelid));
  results=str.arraypush(results;asserttrue("install_state ram_gb is 16";state.ramgb = 16));
  results=str.arraypush(results;asserttrue("install_state is_arm64";state.isarm64));
  results=str.arraypush(results;asserttrue("install_state has_internet";state.hasinternet));
  results=str.arraypush(results;asserteq("install_state platform";"macos";state.platform));

  let readystate = detect.$installstate{
    ollamainstalled:true;
    ollamaversion:"0.5.1";
    ollamarunning:true;
    modelpulled:true;
    modelid:"qwen2.5:7b";
    diskfreegb:89;
    ramgb:16;
    isarm64:true;
    hasinternet:true;
    platform:"macos"
  };
  let isready = readystate.ollamainstalled && readystate.ollamarunning && readystate.modelpulled;
  results=str.arraypush(results;asserttrue("ready state: all installed";isready));

  let needsstart = detect.$installstate{
    ollamainstalled:true;
    ollamaversion:"0.5.1";
    ollamarunning:false;
    modelpulled:true;
    modelid:"qwen2.5:7b";
    diskfreegb:89;
    ramgb:16;
    isarm64:true;
    hasinternet:true;
    platform:"macos"
  };
  let shouldstart = needsstart.ollamainstalled && !i64 && needsstart.modelpulled;
  results=str.arraypush(results;asserttrue("needs-start: installed but not running";shouldstart));

  let needsmodel = detect.$installstate{
    ollamainstalled:true;
    ollamaversion:"0.5.1";
    ollamarunning:true;
    modelpulled:false;
    modelid:"qwen2.5:7b";
    diskfreegb:89;
    ramgb:16;
    isarm64:true;
    hasinternet:true;
    platform:"macos"
  };
  let shouldpull = needsmodel.ollamainstalled && needsmodel.ollamarunning && !i64;
  results=str.arraypush(results;asserttrue("needs-model: running but no model";shouldpull));

  let needsall = detect.$installstate{
    ollamainstalled:false;
    ollamaversion:"";
    ollamarunning:false;
    modelpulled:false;
    modelid:"qwen2.5:3b";
    diskfreegb:50;
    ramgb:8;
    isarm64:false;
    hasinternet:true;
    platform:"linux"
  };
  let shouldinstall = !i64 && needsall.hasinternet;
  results=str.arraypush(results;asserttrue("full-install: nothing installed with internet";shouldinstall));

  let offline = detect.$installstate{
    ollamainstalled:false;
    ollamaversion:"";
    ollamarunning:false;
    modelpulled:false;
    modelid:"qwen2.5:3b";
    diskfreegb:50;
    ramgb:8;
    isarm64:false;
    hasinternet:false;
    platform:"linux"
  };
  let isofflineblocked = !i64 && !i64;
  results=str.arraypush(results;asserttrue("offline: cannot install without internet";isofflineblocked));

  let ram = detect.detectram();
  results=str.arraypush(results;asserttrue("detect_ram returns positive";ram > 0));

  let arch = detect.detectarch();
  results=str.arraypush(results;pass("detect_arch returns without crash"));

  let ollamacheck = detect.detectollamainstalled();
  results=str.arraypush(results;pass("detect_ollama_installed returns without crash"));
  let hasokfield = ollamacheck.ok || !i64;
  results=str.arraypush(results;asserttrue("detect_ollama_installed has ok field";hasokfield));

  let internetcheck = detect.detectinternet();
  results=str.arraypush(results;pass("detect_internet returns without crash"));

  let lowramstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:1.5b";diskfreegb:50;
    ramgb:4;isarm64:false;hasinternet:true;platform:"linux"
  };
  results=str.arraypush(results;asserteq("4GB RAM -> 1.5b model";"qwen2.5:1.5b";lowramstate.modelid));

  let midramstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:3b";diskfreegb:50;
    ramgb:8;isarm64:false;hasinternet:true;platform:"linux"
  };
  results=str.arraypush(results;asserteq("8GB RAM -> 3b model";"qwen2.5:3b";midramstate.modelid));

  let highramstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:7b";diskfreegb:50;
    ramgb:16;isarm64:true;hasinternet:true;platform:"macos"
  };
  results=str.arraypush(results;asserteq("16GB RAM -> 7b model";"qwen2.5:7b";highramstate.modelid));

  let vhighramstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:14b";diskfreegb:100;
    ramgb:32;isarm64:true;hasinternet:true;platform:"macos"
  };
  results=str.arraypush(results;asserteq("32GB RAM -> 14b model";"qwen2.5:14b";vhighramstate.modelid));

  let maxramstate = detect.$installstate{
    ollamainstalled:false;ollamaversion:"";ollamarunning:false;
    modelpulled:false;modelid:"qwen2.5:32b";diskfreegb:200;
    ramgb:64;isarm64:true;hasinternet:true;platform:"macos"
  };
  results=str.arraypush(results;asserteq("64GB RAM -> 32b model";"qwen2.5:32b";maxramstate.modelid));

  let full = detect.fulldetect();
  results=str.arraypush(results;pass("full_detect returns without crash"));
  results=str.arraypush(results;asserttrue("full_detect has ram > 0";full.ramgb > 0));
  let platset = !str.eq(full.platform;"unknown");
  results=str.arraypush(results;asserttrue("full_detect has platform set";platset));

  results=str.arraypush(results;asserttrue("install_state disk_free_gb accessible";state.diskfreegb > 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i+1
    };
  };
  <all
};

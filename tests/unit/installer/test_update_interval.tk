m=test.installer.updateinterval;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=db:std.db;
i=sdb:core.storage.db;
i=up:core.installer.updater;

(* F10.57 - core.installer.updater.loadconfig, which `loke models` (cli.modelmgmt) reads
   before deciding whether to ask Ollama's registry for model updates.

   RED BEFORE THE FIX: a stored installer.update_interval_days that is not a number read
   as 0 days, so every run was due a check. An absent key already gave the default, 7; a
   corrupt one now does too. One store, opened once: std.db keeps one connection (T-30). *)

f=openfreshstore():$store{
  let dir=str.concat(std.homedir();"/.loke/test-update-interval");
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:v v;
    $err:e $store{conn:$dbconn{handle:0};datadir:dir}
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let store=openfreshstore();

  let absent=up.loadconfig(store);
  if(t.assert(absent.checkintervaldays==7;"with no stored interval the default is 7 days")){pass=pass+1}el{fail=fail+1};

  let wrote=mt sdb.setstr(store;"installer.update_interval_days";"weekly";"installer") {$ok:v true;$err:e false};
  if(t.assert(wrote;"a corrupt interval is stored")){pass=pass+1}el{fail=fail+1};
  let corrupt=up.loadconfig(store);
  if(t.assert(corrupt.checkintervaldays!=0;"a stored interval that is not a number is not 0 days")){pass=pass+1}el{fail=fail+1};
  if(t.assert(corrupt.checkintervaldays==7;"it takes the default, 7")){pass=pass+1}el{fail=fail+1};

  let set3=mt sdb.setstr(store;"installer.update_interval_days";"3";"installer") {$ok:v true;$err:e false};
  if(t.assert(set3 && up.loadconfig(store).checkintervaldays==3;"a numeric interval is used as stored")){pass=pass+1}el{fail=fail+1};

  <fail
};

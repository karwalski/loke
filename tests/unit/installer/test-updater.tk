m=tests.unit.installer.testupdater;

i=test:std.test;
i=str:std.str;
i=updater:core.installer.updater;


test.describe("updater.default_config";f={
  test.it("returns 7-day check interval";f={
    let config=updater.defaultconfig();
    test.eq(config.checkintervaldays;7)
  });
  test.it("has auto_check enabled by default";f={
    let config=updater.defaultconfig();
    test.eq(config.autocheck;true)
  });
  test.it("has last_checked at 0";f={
    let config=updater.defaultconfig();
    test.eq(config.lastchecked;0)
  })
});


test.describe("updater.check_due";f={
  test.it("returns true when last_checked is 0 and auto_check is on";f={
    let config=updater.$updateconfig{
      checkintervaldays:7;
      autocheck:true;
      lastchecked:0
    };
    test.eq(updater.checkdue(config);true)
  });
  test.it("returns false when auto_check is off";f={
    let config=updater.$updateconfig{
      checkintervaldays:7;
      autocheck:false;
      lastchecked:0
    };
    test.eq(updater.checkdue(config);false)
  });
  test.it("returns false when checked recently";f={
    let config=updater.$updateconfig{
      checkintervaldays:7;
      autocheck:true;
      lastchecked:9999999999999
    };
    test.eq(updater.checkdue(config);false)
  });
  test.it("returns true when interval exceeded";f={
    let config=updater.$updateconfig{
      checkintervaldays:1;
      autocheck:true;
      lastchecked:1000
    };
    test.eq(updater.checkdue(config);true)
  })
});


test.describe("updater.$update_check construction";f={
  test.it("reports no update when digests match";f={
    let check=updater.$updatecheck{
      modelid:"qwen2.5:7b";
      installeddigest:"abc123";
      latestdigest:"abc123";
      updateavailable:false;
      releasenotes:""
    };
    test.eq(check.updateavailable;false);
    test.eq(check.modelid;"qwen2.5:7b")
  });
  test.it("reports update available when digests differ";f={
    let check=updater.$updatecheck{
      modelid:"qwen2.5:7b";
      installeddigest:"abc123";
      latestdigest:"def456";
      updateavailable:true;
      releasenotes:"security fixes"
    };
    test.eq(check.updateavailable;true);
    test.eq(check.releasenotes;"security fixes")
  });
  test.it("handles empty digests gracefully";f={
    let check=updater.$updatecheck{
      modelid:"qwen2.5:3b";
      installeddigest:"";
      latestdigest:"";
      updateavailable:false;
      releasenotes:""
    };
    test.eq(check.updateavailable;false);
    test.eq(str.len(check.installeddigest);0)
  })
});


test.describe("updater digest comparison";f={
  test.it("same digest means no update";f={
    let installed="sha256:abc123def456";
    let latest="sha256:abc123def456";
    test.eq(str.eq(installed;latest);true)
  });
  test.it("different digest means update available";f={
    let installed="sha256:abc123def456";
    let latest="sha256:789xyz000111";
    test.eq(str.eq(installed;latest);false)
  });
  test.it("empty installed digest means cannot compare";f={
    let installed="";
    let latest="sha256:abc123";
    let available=if(str.len(installed) > 0){
      !str.eq(installed;latest)
    }el{
      false
    };
    test.eq(available;false)
  });
  test.it("empty latest digest means cannot compare";f={
    let installed="sha256:abc123";
    let latest="";
    let available=if(str.len(installed) > 0){
      if(str.len(latest) > 0){
        !str.eq(installed;latest)
      }el{
        false
      };
    }el{
      false
    };
    test.eq(available;false)
  })
});


test.describe("updater config persistence";f={
  test.it("load_config returns defaults when store is empty";f={
    let store=test.mockstore();
    let config=updater.loadconfig(store);
    test.eq(config.checkintervaldays;7);
    test.eq(config.autocheck;true);
    test.eq(config.lastchecked;0)
  });
  test.it("save_config and load_config round-trip";f={
    let store=test.mockstore();
    let config=updater.$updateconfig{
      checkintervaldays:14;
      autocheck:false;
      lastchecked:1700000000000
    };
    updater.saveconfig(store;config);
    let loaded=updater.loadconfig(store);
    test.eq(loaded.checkintervaldays;14);
    test.eq(loaded.autocheck;false);
    test.eq(loaded.lastchecked;1700000000000)
  })
})

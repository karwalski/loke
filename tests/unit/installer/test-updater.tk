
m=tests.unit.installer.testupdater;

i=updater:core.installer.updater;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i64;want:i64):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result);

  let config=updater.defaultconfig();
  results=str.arraypush(results;assertinteq("default check_interval_days";config.checkintervaldays;7));
  results=str.arraypush(results;asserttrue("default auto_check enabled";config.autocheck));
  results=str.arraypush(results;assertinteq("default last_checked 0";config.lastchecked;0));

  let config1=$updateconfig{
    checkintervaldays:7;
    autocheck:true;
    lastchecked:0
  };
  results=str.arraypush(results;asserttrue("check_due when last_checked 0 and auto on";updater.checkdue(config1)));

  let config2=$updateconfig{
    checkintervaldays:7;
    autocheck:false;
    lastchecked:0
  };
  results=str.arraypush(results;assertfalse("check_due false when auto off";updater.checkdue(config2)));

  let config3=$updateconfig{
    checkintervaldays:7;
    autocheck:true;
    lastchecked:9999999999999
  };
  results=str.arraypush(results;assertfalse("check_due false when checked recently";updater.checkdue(config3)));

  let config4=$updateconfig{
    checkintervaldays:1;
    autocheck:true;
    lastchecked:1000
  };
  results=str.arraypush(results;asserttrue("check_due true when interval exceeded";updater.checkdue(config4)));

  let check1=$updatecheck{
    modelid:"qwen2.5:7b";
    installeddigest:"abc123";
    latestdigest:"abc123";
    updateavailable:false;
    releasenotes:""
  };
  results=str.arraypush(results;assertfalse("no update when digests match";check1.updateavailable));
  results=str.arraypush(results;asserteq("check modelid";"qwen2.5:7b";check1.modelid));

  let check2=$updatecheck{
    modelid:"qwen2.5:7b";
    installeddigest:"abc123";
    latestdigest:"def456";
    updateavailable:true;
    releasenotes:"security fixes"
  };
  results=str.arraypush(results;asserttrue("update available when digests differ";check2.updateavailable));
  results=str.arraypush(results;asserteq("release notes";"security fixes";check2.releasenotes));

  let check3=$updatecheck{
    modelid:"qwen2.5:3b";
    installeddigest:"";
    latestdigest:"";
    updateavailable:false;
    releasenotes:""
  };
  results=str.arraypush(results;assertfalse("no update with empty digests";check3.updateavailable));
  results=str.arraypush(results;asserttrue("empty installed digest len 0";str.len(check3.installeddigest) = 0));

  let installed1="sha256:abc123def456";
  let latest1="sha256:abc123def456";
  results=str.arraypush(results;asserttrue("same digest eq";str.eq(installed1;latest1)));

  let installed2="sha256:abc123def456";
  let latest2="sha256:789xyz000111";
  results=str.arraypush(results;assertfalse("different digest neq";str.eq(installed2;latest2)));

  let installed3="";
  let latest3="sha256:abc123";
  let available3=if(str.len(installed3) > 0){ !str.eq(installed3;latest3) }el{ false };
  results=str.arraypush(results;assertfalse("empty installed cannot compare";available3));

  let installed4="sha256:abc123";
  let latest4="";
  let available4=if(str.len(installed4) > 0){
    if(str.len(latest4) > 0){ !str.eq(installed4;latest4) }el{ false }
  }el{ false };
  results=str.arraypush(results;assertfalse("empty latest cannot compare";available4));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(!(i<n)){ br }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1
    }
  };
  <all
};

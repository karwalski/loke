m=tests.unit.installer.testuninstall;

i=test:std.test;
i=str:std.str;
i=uninstall:core.installer.uninstall;


test.describe("uninstall.$uninstall_result construction";f={
  test.it("success result includes freed space";f={
    let result=uninstall.$uninstallresult{
      success:true;
      message:"removed qwen2.5:7b";
      freedspace:"4.5 GB"
    };
    test.eq(result.success;true);
    test.eq(result.freedspace;"4.5 GB")
  });
  test.it("failure result includes error message";f={
    let result=uninstall.$uninstallresult{
      success:false;
      message:"model not found: nonexistent";
      freedspace:""
    };
    test.eq(result.success;false);
    test.ok(str.contains(result.message;"not found"))
  })
});


test.describe("uninstall.$removable_model construction";f={
  test.it("stores model metadata";f={
    let model=uninstall.$removablemodel{
      name:"qwen2.5:7b";
      size:"4.5 GB";
      digest:"sha256:abc123";
      modified:"2026-04-01"
    };
    test.eq(model.name;"qwen2.5:7b");
    test.eq(model.size;"4.5 GB");
    test.eq(model.digest;"sha256:abc123")
  })
});


test.describe("uninstall.format_size";f={
  test.it("formats gigabytes";f={
    let result=uninstall.formatsize(4831838208);
    test.ok(str.contains(result;"GB"))
  });
  test.it("formats megabytes";f={
    let result=uninstall.formatsize(94371840);
    test.ok(str.contains(result;"MB"))
  });
  test.it("formats kilobytes for small sizes";f={
    let result=uninstall.formatsize(512000);
    test.ok(str.contains(result;"KB"))
  });
  test.it("handles zero bytes";f={
    let result=uninstall.formatsize(0);
    test.ok(str.contains(result;"KB"))
  })
});


test.describe("uninstall.uninstall_model validation";f={
  test.it("reports failure for non-existent model";f={
    let result=uninstall.uninstallmodel("nonexistent-model-xyz");
    test.eq(result.success;false);
    test.ok(str.contains(result.message;"not found") || str.contains(result.message;"failed"))
  })
});


test.describe("uninstall.uninstall_ollama validation";f={
  test.it("reports failure when binary not found";f={
    let result=uninstall.uninstallollama();
    test.eq(result.success;false);
    test.ok(str.contains(result.message;"not found") || str.contains(result.message;"failed"))
  })
});


test.describe("uninstall confirmation logic";f={
  test.it("y confirms removal";f={
    let input="y";
    test.eq(str.eq(str.tolower(str.trim(input));"y");true)
  });
  test.it("Y confirms removal (case insensitive)";f={
    let input="Y";
    test.eq(str.eq(str.tolower(str.trim(input));"y");true)
  });
  test.it("n cancels removal";f={
    let input="n";
    test.eq(str.eq(str.tolower(str.trim(input));"y");false)
  });
  test.it("empty input cancels removal";f={
    let input="";
    test.eq(str.eq(str.tolower(str.trim(input));"y");false)
  });
  test.it("whitespace-only input cancels removal";f={
    let input="  ";
    test.eq(str.eq(str.tolower(str.trim(input));"y");false)
  });
  test.it("arbitrary text cancels removal";f={
    let input="yes";
    test.eq(str.eq(str.tolower(str.trim(input));"y");false)
  })
});


test.describe("uninstall command parsing";f={
  test.it("parses uninstall-model with model arg";f={
    let args=@("loke";"uninstall-model";"qwen2.5:7b");
    let modelid=if(str.len(args) > 2):i64{args.get(2)}el{""};
    test.eq(modelid;"qwen2.5:7b")
  });
  test.it("parses uninstall-model without arg";f={
    let args=@("loke";"uninstall-model");
    let modelid=if(str.len(args) > 2):i64{args.get(2)}el{""};
    test.eq(modelid;"")
  });
  test.it("parses uninstall-ollama";f={
    let args=@("loke";"uninstall-ollama");
    test.eq(args.get(1);"uninstall-ollama")
  })
});


test.describe("uninstall.list_removable";f={
  test.it("returns an array (may be empty if(Ollama not running)";f=){
    let models=uninstall.listremovable();
    test.ok(true) 
  })
})

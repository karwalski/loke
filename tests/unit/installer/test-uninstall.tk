
m=tests.unit.installer.testuninstall;

i=uninstall:core.installer.uninstall;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result);

  let result=$uninstallresult{
    success:true;
    message:"removed qwen2.5:7b";
    freedspace:"4.5 GB"
  };
  results=str.arraypush(results;asserttrue("success result success=true";result.success));
  results=str.arraypush(results;asserteq("success result freed_space";"4.5 GB";result.freedspace));

  let failresult=$uninstallresult{
    success:false;
    message:"model not found: nonexistent";
    freedspace:""
  };
  results=str.arraypush(results;assertfalse("failure result success=false";failresult.success));
  results=str.arraypush(results;asserttrue("failure message contains not found";str.contains(failresult.message;"not found")));

  let model=$removablemodel{
    name:"qwen2.5:7b";
    size:"4.5 GB";
    digest:"sha256:abc123";
    modified:"2026-04-01"
  };
  results=str.arraypush(results;asserteq("removable model name";"qwen2.5:7b";model.name));
  results=str.arraypush(results;asserteq("removable model size";"4.5 GB";model.size));
  results=str.arraypush(results;asserteq("removable model digest";"sha256:abc123";model.digest));

  let fmtgb=uninstall.formatsize(4831838208);
  results=str.arraypush(results;asserttrue("format_size GB";str.contains(fmtgb;"GB")));

  let fmtmb=uninstall.formatsize(94371840);
  results=str.arraypush(results;asserttrue("format_size MB";str.contains(fmtmb;"MB")));

  let fmtkb=uninstall.formatsize(512000);
  results=str.arraypush(results;asserttrue("format_size KB";str.contains(fmtkb;"KB")));

  let fmtzero=uninstall.formatsize(0);
  results=str.arraypush(results;asserttrue("format_size zero";str.contains(fmtzero;"KB")));

  let uninstallresult=uninstall.uninstallmodel("nonexistent-model-xyz");
  results=str.arraypush(results;assertfalse("uninstall nonexistent fails";uninstallresult.success));
  results=str.arraypush(results;asserttrue("uninstall nonexistent has message";str.contains(uninstallresult.message;"not found") || str.contains(uninstallresult.message;"failed")));

  let ollamaresult=uninstall.uninstallollama();
  results=str.arraypush(results;assertfalse("uninstall ollama fails when not found";ollamaresult.success));
  results=str.arraypush(results;asserttrue("uninstall ollama has message";str.contains(ollamaresult.message;"not found") || str.contains(ollamaresult.message;"failed")));

  let inputy="y";
  results=str.arraypush(results;asserttrue("y confirms removal";str.eq(str.tolower(str.trim(inputy));"y")));

  let inputbig="Y";
  results=str.arraypush(results;asserttrue("Y confirms removal";str.eq(str.tolower(str.trim(inputbig));"y")));

  let inputn="n";
  results=str.arraypush(results;assertfalse("n cancels removal";str.eq(str.tolower(str.trim(inputn));"y")));

  let inputempty="";
  results=str.arraypush(results;assertfalse("empty cancels removal";str.eq(str.tolower(str.trim(inputempty));"y")));

  let inputyes="yes";
  results=str.arraypush(results;assertfalse("yes cancels removal";str.eq(str.tolower(str.trim(inputyes));"y")));

  let args1=@("loke";"uninstall-model";"qwen2.5:7b");
  let modelid1=str.arrayget(args1;2);
  results=str.arraypush(results;asserteq("parse uninstall-model with arg";"qwen2.5:7b";modelid1));

  let args2=@("loke";"uninstall-model");
  let modelid2=if(str.arraylen(args2) > 2){ str.arrayget(args2;2) }el{ "" };
  results=str.arraypush(results;asserteq("parse uninstall-model without arg";"";modelid2));

  let args3=@("loke";"uninstall-ollama");
  results=str.arraypush(results;asserteq("parse uninstall-ollama";"uninstall-ollama";str.arrayget(args3;1)));

  let models=uninstall.listremovable();
  results=str.arraypush(results;asserttrue("list_removable returns without crash";true));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(!(i<n)){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all=false }el{};
      i=i+1
    }
  };
  <all
};

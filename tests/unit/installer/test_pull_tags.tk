m=test.installer.pulltags;

i=t:std.test;
i=str:std.str;
i=pull:core.installer.pull;

(* LS1.1t. handlemodeltagsresp computed its answer in a match it did not return, so a 200
   from Ollama's /api/tags fell through to toke's implicit `ret 0`: every "is this model
   installed?" answered false. The response is built here, so no Ollama is needed.

   VM1.6h. The handler now takes the BODY, which is what the one-argument `http.get` answers;
   it took an `$httpresp`, which that call never returns. The GET itself is tested against a
   recorder in tests/integration/test_local_gets.tk. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let body="{\"models\":[{\"name\":\"llama3:latest\",\"size\":1},{\"name\":\"qwen2.5:7b\",\"size\":2}]}";
  if(t.assert(pull.handlemodeltagsbody(body;"llama3");"a model Ollama lists is reported installed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pull.handlemodeltagsbody(body;"mistral");"and one it does not list is not")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pull.handlemodeltagsbody("{\"error\":\"model not found\"}";"llama3");"an error document is not an installed model")){pass=pass+1}el{fail=fail+1};
  <fail
};

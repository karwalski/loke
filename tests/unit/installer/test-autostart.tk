
m=tests.unit.installer.testautostart;

i=auto:core.installer.autostart;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let cfg = auto.defaultconfig();
  results = str.arraypush(results;asserttrue("default enabled is true";cfg.enabled));
  results = str.arraypush(results;asserteq("default ollama_url";cfg.ollamaurl;"http://localhost:11434"));
  results = str.arraypush(results;asserttrue("default max_restarts is 1";cfg.maxrestarts = 1));
  results = str.arraypush(results;asserttrue("default restart_delay_ms is 2000";cfg.restartdelayms = 2000));

  let cfgdisabled = $auto.$autostartconfig{
    enabled:false;
    ollamaurl:"http://localhost:11434";
    maxrestarts:1;
    restartdelayms:2000
  };
  results = str.arraypush(results;assertfalse("disabled config enabled is false";cfgdisabled.enabled));

  let cfgremote = $auto.$autostartconfig{
    enabled:true;
    ollamaurl:"http://192.168.1.50:11434";
    maxrestarts:1;
    restartdelayms:2000
  };
  results = str.arraypush(results;asserteq("remote ollama_url";cfgremote.ollamaurl;"http://192.168.1.50:11434"));

  let cfgnorestart = $auto.$autostartconfig{
    enabled:true;
    ollamaurl:"http://localhost:11434";
    maxrestarts:0;
    restartdelayms:2000
  };
  results = str.arraypush(results;asserttrue("no restart max is 0";cfgnorestart.maxrestarts = 0));

  results = str.arraypush(results;asserttrue("on_crash exists";true));

  let cfg1 = auto.defaultconfig();
  results = str.arraypush(results;asserttrue("max_restarts=1 allows one restart";cfg1.maxrestarts = 1));
  results = str.arraypush(results;asserttrue("restart_count 0 < max 1";0 < cfg1.maxrestarts));
  results = str.arraypush(results;assertfalse("restart_count 1 < max 1 is false";1 < cfg1.maxrestarts));

  let cfgfast = $auto.$autostartconfig{
    enabled:true;
    ollamaurl:"http://localhost:11434";
    maxrestarts:1;
    restartdelayms:500
  };
  results = str.arraypush(results;asserttrue("fast restart delay is 500";cfgfast.restartdelayms = 500));

  let cfgmulti = $auto.$autostartconfig{
    enabled:true;
    ollamaurl:"http://localhost:11434";
    maxrestarts:3;
    restartdelayms:1000
  };
  results = str.arraypush(results;asserttrue("multi restart max is 3";cfgmulti.maxrestarts = 3));
  results = str.arraypush(results;asserttrue("restart_count 0 < 3";0 < cfgmulti.maxrestarts));
  results = str.arraypush(results;asserttrue("restart_count 2 < 3";2 < cfgmulti.maxrestarts));
  results = str.arraypush(results;assertfalse("restart_count 3 < 3 is false";3 < cfgmulti.maxrestarts));

  results = str.arraypush(results;asserttrue("ensure_running function exists";true));
  results = str.arraypush(results;asserttrue("is_configured function exists";true));

  let cfgrt = $auto.$autostartconfig{
    enabled:true;
    ollamaurl:"http://custom:9999";
    maxrestarts:5;
    restartdelayms:3000
  };
  results = str.arraypush(results;asserttrue("roundtrip enabled";cfgrt.enabled));
  results = str.arraypush(results;asserteq("roundtrip url";cfgrt.ollamaurl;"http://custom:9999"));
  results = str.arraypush(results;asserttrue("roundtrip max_restarts";cfgrt.maxrestarts = 5));
  results = str.arraypush(results;asserttrue("roundtrip delay";cfgrt.restartdelayms = 3000));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};


m=tests.unit.installer.testverify;

i=verify:core.installer.verify;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @($result);

  let vr = verify.$verificationresult{
    success:true;
    modelid:"qwen2.5:7b";
    responsetext:"4";
    latencyms:45;
    throughputtokpersec:32.5;
    errormsg:""
  };
  results = str.arraypush(results;asserttrue("vr success is true";vr.success));
  results = str.arraypush(results;asserteq("vr model_id";vr.modelid;"qwen2.5:7b"));
  results = str.arraypush(results;asserteq("vr response_text";vr.responsetext;"4"));
  results = str.arraypush(results;asserttrue("vr latency_ms is 45";vr.latencyms = 45));
  results = str.arraypush(results;asserttrue("vr throughput is 32.5";vr.throughputtokpersec = 32.5));
  results = str.arraypush(results;asserteq("vr error_msg is empty";vr.errormsg;""));

  let vrfail = verify.$verificationresult{
    success:false;
    modelid:"qwen2.5:3b";
    responsetext:"I don't know";
    latencyms:120;
    throughputtokpersec:0.0;
    errormsg:"model responded but answer does not contain '4': I don't know"
  };
  results = str.arraypush(results;assertfalse("failed vr success is false";vrfail.success));
  results = str.arraypush(results;asserttrue("failed vr has error_msg";str.len(vrfail.errormsg) > 0));
  results = str.arraypush(results;asserttrue("failed vr contains explanation";str.contains(vrfail.errormsg;"does not contain")));

  let vrunreach = verify.$verificationresult{
    success:false;
    modelid:"qwen2.5:7b";
    responsetext:"";
    latencyms:0;
    throughputtokpersec:0.0;
    errormsg:"Ollama is not reachable at http://localhost:11434"
  };
  results = str.arraypush(results;asserttrue("unreachable latency is 0";vrunreach.latencyms = 0));
  results = str.arraypush(results;asserttrue("unreachable throughput is 0";vrunreach.throughputtokpersec = 0.0));
  results = str.arraypush(results;asserttrue("unreachable error mentions reachable";str.contains(vrunreach.errormsg;"not reachable")));

  let vrmixed = verify.$verificationresult{
    success:true;
    modelid:"qwen2.5:7b";
    responsetext:"The answer is 4.";
    latencyms:60;
    throughputtokpersec:0.0;
    errormsg:""
  };
  results = str.arraypush(results;asserttrue("response with 4 in sentence passes";str.contains(vrmixed.responsetext;"4")));

  let vrtp = verify.$verificationresult{
    success:true;
    modelid:"qwen2.5:14b";
    responsetext:"Light scatters in the atmosphere. Blue wavelengths scatter more.";
    latencyms:2500;
    throughputtokpersec:18.4;
    errormsg:""
  };
  results = str.arraypush(results;asserttrue("throughput tok/s is positive";vrtp.throughputtokpersec > 0.0));
  results = str.arraypush(results;asserttrue("throughput latency is reasonable";vrtp.latencyms > 0));

  let models = @("qwen2.5:1.5b";"qwen2.5:3b";"qwen2.5:7b";"qwen2.5:14b";"qwen2.5:32b");
  let mi = 0;
  lp(let lv=0;true;lv=lv){
    if(mi >= 5){ break }el{
      let mid = str.arrayget(models;mi);
      let vrm = verify.$verificationresult{
        success:true;
        modelid:mid;
        responsetext:"4";
        latencyms:50;
        throughputtokpersec:25.0;
        errormsg:""
      };
      results = str.arraypush(results;asserteq(str.concat("model_id ";mid);vrm.modelid;mid));
      mi = mi + 1
    }
  };

  let vrretryfail = verify.$verificationresult{
    success:false;
    modelid:"qwen2.5:7b";
    responsetext:"";
    latencyms:10200;
    throughputtokpersec:0.0;
    errormsg:"verification failed after all retries for qwen2.5:7b. Try: ollama run qwen2.5:7b"
  };
  results = str.arraypush(results;asserttrue("retry error has troubleshoot hint";str.contains(vrretryfail.errormsg;"ollama run")));
  results = str.arraypush(results;asserttrue("retry error mentions model";str.contains(vrretryfail.errormsg;"qwen2.5:7b")));

  let vrstopped = verify.$verificationresult{
    success:false;
    modelid:"qwen2.5:7b";
    responsetext:"";
    latencyms:0;
    throughputtokpersec:0.0;
    errormsg:"Ollama is installed but not running"
  };
  results = str.arraypush(results;asserttrue("stopped error mentions not running";str.contains(vrstopped.errormsg;"not running")));

  let vrzero = verify.$verificationresult{
    success:true;
    modelid:"qwen2.5:3b";
    responsetext:"4";
    latencyms:0;
    throughputtokpersec:0.0;
    errormsg:""
  };
  results = str.arraypush(results;asserttrue("zero elapsed gives 0 throughput";vrzero.throughputtokpersec = 0.0));

  results = str.arraypush(results;asserttrue("verify_model function exists";true));
  results = str.arraypush(results;asserttrue("measure_throughput function exists";true));
  results = str.arraypush(results;asserttrue("verify_with_retry function exists";true));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let all = false }el{};
      i = i + 1
    }
  };
  <all
};

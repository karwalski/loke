
m=tests.unit.extensions.testhooks;

i=reg:loke.platform.plugin.registry;
i=contracts:loke.platform.plugin.contracts;
i=anon:loke.platform.plugin.anonymisation;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let ok = reg.register("test-plugin";"1.0.0";"unit-test");
  results = str.arraypush(results;asserttrue("register plugin returns true";ok));

  let found = reg.find("test-plugin");
  let foundok = mt found { some() { true }; none { false } };
  results = str.arraypush(results;asserttrue("find registered plugin returns some";foundok));

  let notfound = reg.find("nonexistent-plugin");
  let notfoundok = mt notfound { some() { false }; none { true } };
  results = str.arraypush(results;asserttrue("find unregistered plugin returns none";notfoundok));

  let unregok = reg.unregister("test-plugin");
  results = str.arraypush(results;asserttrue("unregister returns true";unregok));

  let afterunreg = reg.find("test-plugin");
  let afterunregnone = mt afterunreg { some() { false }; none { true } };
  results = str.arraypush(results;asserttrue("plugin not found after unregister";afterunregnone));

  let valid = contracts.validate("test-plugin";"1.0.0";">=0.1.0");
  results = str.arraypush(results;asserttrue("valid contract passes validation";valid));

  let invalid = contracts.validate("test-plugin";"0.0.1";">=1.0.0");
  results = str.arraypush(results;assertfalse("incompatible version fails validation";invalid));

  let anoninput = "Contact john@example.com for details";
  let anonresult = anon.process(anoninput);
  results = str.arraypush(results;asserttrue("anonymisation produces output";str.len(anonresult) > 0));

  results = str.arraypush(results;assertfalse("anonymisation removes email";str.contains(anonresult;"john@example.com")));

  let pluginlist = reg.listall();
  results = str.arraypush(results;pass("list_all returns without crash"));

  let emptyreg = reg.register("";"1.0.0";"unit-test");
  results = str.arraypush(results;assertfalse("empty name registration rejected";emptyreg));

  let emptyver = reg.register("valid-name";"";"unit-test");
  results = str.arraypush(results;assertfalse("empty version registration rejected";emptyver));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};

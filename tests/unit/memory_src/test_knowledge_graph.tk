



m=tests.unit.memorysrc.testknowledgegraph;

i=kg:loke.memory.knowledgegraph;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  
  let graph=kg.newgraph();
  let nodecount=str.arraylen(graph.nodes);
  results=str.arraypush(results;assertinteq("new_graph has zero nodes";nodecount;0));

  
  let graph1=kg.addnode(graph;"alice";"Alice Smith";"person");
  let nodecount1=str.arraylen(graph1.nodes);
  results=str.arraypush(results;assertinteq("add_node increases count to 1";nodecount1;1));

  
  let graph2=kg.addnode(graph1;"bob";"Bob Jones";"person");
  let graph3=kg.addrelation(graph2;"alice";"bob";"knows";0;0;"test";1.0);
  let relcount=str.arraylen(graph3.relations);
  results=str.arraypush(results;assertinteq("add_relation gives relation count 1";relcount;1));

  
  let q=kg.$factquery{
    subject:"alice";
    predicate:"knows";
    asof:0
  };
  let facts=kg.queryfacts(graph3;q);
  let factslen=str.arraylen(facts);
  results=str.arraypush(results;asserttrue("query_facts returns matching facts";factslen > 1));

  
  let qunknown=kg.$factquery{
    subject:"unknown";
    predicate:"knows";
    asof:0
  };
  let nofacts=kg.queryfacts(graph3;qunknown);
  let nofactslen=str.arraylen(nofacts);
  results=str.arraypush(results;assertinteq("query_facts unknown subject returns empty";nofactslen;0));

  
  let contradictions=kg.detectcontradictions(graph3);
  let contralen=str.arraylen(contradictions);
  results=str.arraypush(results;assertinteq("detect_contradictions empty for clean graph";contralen;0));

  
  let graph4=kg.addnode(graph3;"carol";"Carol White";"person");
  
  let graph5=kg.addrelation(graph4;"alice";"carol";"knows";0;0;"test2";0.9);
  let contradictions2=kg.detectcontradictions(graph5);
  let contralen2=str.arraylen(contradictions2);
  results=str.arraypush(results;asserttrue("detect_contradictions finds conflict";contralen2 > 1));

  
  let dot=kg.visualisedot(graph3);
  results=str.arraypush(results;asserttrue("visualise_dot starts with digraph";str.startswith(dot;"digraph")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    }
  };
  <all
};

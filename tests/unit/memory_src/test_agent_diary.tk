



m=tests.unit.memorysrc.testagentdiary;

i=diary:loke.memory.agentdiary;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got == want{ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  
  diary.gdiaries=@();

  let results = @$result@();

  
  let d=diary.getorcreatediary("agent_1");
  let entrycount=str.arraylen(d.entries);
  results=str.arraypush(results;assertinteq("get_or_create_diary zero entries";entrycount;0));
  results=str.arraypush(results;asserteq("get_or_create_diary correct agent_id";"agent_1";d.agentid));

  
  let entry=diary.$diaryentry{
    id:"entry_1";
    agentid:"agent_1";
    runid:"run_001";
    summary:"Completed analysis task";
    result:"success";
    tokensused:512;
    costusd:0.01;
    durationms:3200;
    feedbackreceived:"";
    ts:0
  };
  diary.appendentry("agent_1";entry);
  let entries=diary.getentries("agent_1");
  let entrieslen=str.arraylen(entries);
  results=str.arraypush(results;assertinteq("get_entries has 1 after append";entrieslen;1));

  
  let recent=diary.getrecent("agent_1";1);
  let recentlen=str.arraylen(recent);
  results=str.arraypush(results;asserttrue("get_recent(1) returns at most 1";recentlen <= 1));
  results=str.arraypush(results;assertinteq("get_recent(1) returns exactly 1";recentlen;1));

  
  let ctx=diary.buildstartupcontext("agent_1";5);
  results=str.arraypush(results;asserttrue("build_startup_context non-empty for non-empty diary";!str.eq(ctx;"")));

  
  diary.gdiaries=@();
  let ctxempty=diary.buildstartupcontext("agent_empty";5);
  
  results=str.arraypush(results;asserttrue("build_startup_context has header even for empty diary";str.contains(ctxempty;"AGENT:")));

  
  let aaak=diary.toaaak(entry);
  results=str.arraypush(results;asserttrue("to_aaak returns non-empty";!str.eq(aaak;"")));
  results=str.arraypush(results;asserttrue("to_aaak contains run_id";str.contains(aaak;"run_001")));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i >= n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};


m=tests.unit.memory.testexport;

i=mining:loke.memory.mining;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let job = mining.$miningjob{
    id:"job-001";
    sourcepath:"/tmp/export.json";
    sourcetype:"claude_export";
    mode:"conversations";
    status:"pending";
    itemsfound:0;
    itemsstored:0;
    startedat:1700000000;
    completedat:0;
    error:""
  };
  results = str.arraypush(results;asserteq("job id stored";job.id;"job-001"));
  results = str.arraypush(results;asserteq("job source_path stored";job.sourcepath;"/tmp/export.json"));
  results = str.arraypush(results;asserteq("job source_type stored";job.sourcetype;"claude_export"));
  results = str.arraypush(results;asserteq("job mode stored";job.mode;"conversations"));
  results = str.arraypush(results;asserteq("job status is pending";job.status;"pending"));

  results = str.arraypush(results;asserttrue("job items_found is 0";job.itemsfound = 0));
  results = str.arraypush(results;asserttrue("job items_stored is 0";job.itemsstored = 0));

  results = str.arraypush(results;asserttrue("job completed_at is 0 when pending";job.completedat = 0));

  results = str.arraypush(results;asserteq("job error is empty";job.error;""));

  let item = mining.$mineditem{
    content:"Alice mentioned the project deadline is Friday";
    source:"claude_export";
    ts:1700000100;
    wing:"conversations";
    tags:@("project";"deadline")
  };
  results = str.arraypush(results;asserttrue("mined_item content non-empty";str.len(item.content) > 0));
  results = str.arraypush(results;asserteq("mined_item source stored";item.source;"claude_export"));
  results = str.arraypush(results;asserttrue("mined_item ts > 0";item.ts > 0));
  results = str.arraypush(results;asserteq("mined_item wing stored";item.wing;"conversations"));

  results = str.arraypush(results;asserttrue("mined_item has 2 tags";item.tags.len() = 2));

  let modeproj = mining.$$projects:i64;
  let modeconv = mining.$$conversations:i64;
  let modegen = mining.$$general:i64;
  results = str.arraypush(results;pass("mining_mode variants construct without crash"));

  let srcclaude = mining.$$claudeexport:i64;
  let srcchatgpt = mining.$$chatgptexport:i64;
  let srcslack = mining.$$slackjson:i64;
  let srcmd = mining.$$markdown:i64;
  let srccode = mining.$$coderepo:i64;
  results = str.arraypush(results;pass("mining_source variants construct without crash"));

  let donejob = mining.$miningjob{
    id:"job-002";sourcepath:"/tmp/chat.json";sourcetype:"chatgpt_export";
    mode:"general";status:"completed";itemsfound:42;itemsstored:40;
    startedat:1700000000;completedat:1700001000;error:""
  };
  results = str.arraypush(results;asserttrue("completed job completed_at > 0";donejob.completedat > 0));
  results = str.arraypush(results;asserttrue("completed job items_found > 0";donejob.itemsfound > 0));
  results = str.arraypush(results;asserttrue("completed job items_stored <= items_found";donejob.itemsstored <= donejob.itemsfound));

  let failedjob = mining.$miningjob{
    id:"job-003";sourcepath:"/nonexistent";sourcetype:"markdown";
    mode:"general";status:"failed";itemsfound:0;itemsstored:0;
    startedat:1700000000;completedat:1700000500;error:"file not found"
  };
  results = str.arraypush(results;asserttrue("failed job error non-empty";str.len(failedjob.error) > 0));
  results = str.arraypush(results;asserteq("failed job status";failedjob.status;"failed"));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(true){
    if(i > n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!i64){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};

m=test.memory.drawerscores;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=db:std.db;
i=std:std;
i=sdb:core.storage.db;
i=stor:core.memory.storage;
i=mtypes:core.memory.types;
i=ty:shared.types;

(* M1.7a — a drawer never exists without its `memory_scores` row, against the REAL
   core.memory.storage.storedrawer and a real migrated store.

   Before this, nothing inserted into memory_scores on the write path: the table existed and
   stayed empty, so core.memory.privacy.forgetpii (`WHERE pii_flagged=1`) could never match and
   the decay sweep had nothing to sweep. The first three assertions are that defect.

   The result of storedrawer is deliberately NOT matched on: `mt` on a loke-module
   `X!$lokeerr` result takes arm 0 regardless (T-18), so every outcome is read back from the
   database instead. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-drawer-scores")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s 1;
    $err:e 0
  }
};

f=mkdrawer(id:str;sens:$sensitivitylevel):$drawer{
  <$drawer{
    id:id;
    location:$palacelocation{wing:"technical";hall:"Code";room:"general"};
    role:"user";
    content:"a drawer written by test_drawer_scores";
    sessionid:"s1";
    modelid:"m1";
    tokens:3 as u32;
    sensitivity:sens;
    createdat:""
  }
};

f=scorerows(id:str):i64{
  <sdb.countquery("SELECT id FROM memory_scores WHERE id=?";@(id))
};

f=flaggedrows(id:str):i64{
  <sdb.countquery("SELECT id FROM memory_scores WHERE id=? AND pii_flagged=1";@(id))
};

f=drawerrows(id:str):i64{
  <sdb.countquery("SELECT id FROM memory_drawers WHERE id=?";@(id))
};

(* created_at is the one column the decay sweep ages by, and it reads it with rowi64. A
   datetime TEXT reads as its leading digits — 2026 — which is 1970 plus half an hour. *)
f=createdat(id:str):i64{
  <mt db.many("SELECT created_at FROM memory_scores WHERE id=?";@(id)) {
    $ok:rows scoreat(rows);
    $err:e 0
  }
};

f=scoreat(rows:@$row):i64{
  if(rows.len==0){ <0 }el{ <db.rowi64(rows.get(0);"created_at") }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let opened=openfreshstore();
  if(t.assert(opened==1;"the store opened on a fresh file and its migrations ran")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.tableexists("memory_scores");"memory_scores exists, so an empty read below is not a missing table")){pass=pass+1}el{fail=fail+1};

  (* ── The defect ──────────────────────────────────────────────────────────── *)
  stor.storedrawer(0;mkdrawer("drw-public";$sensitivitylevel{$public:0}));
  if(t.assert(drawerrows("drw-public")==1;"the drawer itself was stored (control)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(scorerows("drw-public")==1;"and a memory_scores row was created with it (M1.7a)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(flaggedrows("drw-public")==0;"a PUBLIC drawer is not flagged as PII")){pass=pass+1}el{fail=fail+1};

  stor.storedrawer(0;mkdrawer("drw-restricted";$sensitivitylevel{$restricted:0}));
  if(t.assert(flaggedrows("drw-restricted")==1;"a RESTRICTED drawer is flagged at creation, so forgetpii can find it with no window")){pass=pass+1}el{fail=fail+1};
  stor.storedrawer(0;mkdrawer("drw-conf";$sensitivitylevel{$confidential:0}));
  if(t.assert(flaggedrows("drw-conf")==1;"and so is a CONFIDENTIAL one")){pass=pass+1}el{fail=fail+1};
  stor.storedrawer(0;mkdrawer("drw-internal";$sensitivitylevel{$internal:0}));
  if(t.assert(flaggedrows("drw-internal")==0;"an INTERNAL drawer is organisational, not personal, and is not flagged")){pass=pass+1}el{fail=fail+1};

  let ts=createdat("drw-public");
  if(t.assert(ts>1700000000;"the score's created_at is an epoch in seconds, which is what the decay sweep reads it as")){pass=pass+1}el{fail=fail+1};

  (* ── Atomicity ───────────────────────────────────────────────────────────────
     A score row already holding this id makes the second INSERT fail. The drawer INSERT
     before it succeeded, so without a transaction a drawer would exist whose score row is
     someone else's. With one, neither is written. *)
  mt db.exec("INSERT INTO memory_scores (id,score,tags,pii_flagged,created_at) VALUES ('drw-clash',1.0,'',0,'1')";@()) {
    $ok:v void;
    $err:e void
  };
  stor.storedrawer(0;mkdrawer("drw-clash";$sensitivitylevel{$public:0}));
  if(t.assert(drawerrows("drw-clash")==0;"when the score row cannot be written, the drawer is not written either")){pass=pass+1}el{fail=fail+1};

  (* And the connection is usable afterwards — a transaction left open would swallow the
     next write into an uncommitted one. *)
  stor.storedrawer(0;mkdrawer("drw-after";$sensitivitylevel{$public:0}));
  if(t.assert(drawerrows("drw-after")==1;"a write after the failed one still lands, so the failure rolled back")){pass=pass+1}el{fail=fail+1};
  if(t.assert(scorerows("drw-after")==1;"with its score row")){pass=pass+1}el{fail=fail+1};

  <fail
};

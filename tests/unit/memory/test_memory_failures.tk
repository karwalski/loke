m=test.memory.failures;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=memtypes:core.memory.types;
i=se:core.memory.search;
i=pal:core.memory.palace;
i=stor:core.memory.storage;
i=ctx:core.memory.context;
i=mine:core.memory.mining;
i=proto:core.mcp.protocol;
i=mcpmem:core.memory.mcpserver;
i=storagedb:core.storage.db;
i=sharedtypes:shared.types;

(* MK6.8 — the memory modules' failure paths, which T-18 had made unreachable.

   search.search and searchinwing (called by the MCP server's memory.search and memory.facts
   and by context's L2 and L3), palace.walk and the wing, hall and room listings (walk's own
   calls, and context's L1), storage.storeturn, and mining's store of each fact all answered,
   or matched, `X!$lokeerr`. A match on that takes its first arm whatever the value is, so a
   failure was read as a success with the error bound as the value. search also mapped its own
   failed queries to "no rows", so it never produced a failure for anyone to miss.

   The first half runs BEFORE any database is open in this process, so every query these
   modules make fails: each function must say so. The second half opens a palace and runs the
   same calls, so a predicate that always answered "failed" would not pass either. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-memory-failures")
};

f=nopalace():$palace{
  <$palace{conn:$dbconn{handle:0};datadir:""}
};

f=facts():str{
  <"The quarterly privacy review found nothing unusual. The second finding concerns retention of notes"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let p=nopalace();

  (* ── No database: every query fails ──────────────────────────────────────── *)
  let s0=se.search(0;"privacy review";5 as u32);
  if(t.assert(!se.succeeded(s0);"search against a palace it cannot read reports a failure, not an empty result")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s0.results.len==0;"and carries no results")){pass=pass+1}el{fail=fail+1};
  let w0=se.searchinwing(0;"privacy review";"work";5 as u32);
  if(t.assert(!se.succeeded(w0);"searchinwing reports the same failure")){pass=pass+1}el{fail=fail+1};

  let ms0=mcpmem.handlesearch("{\"query\":\"privacy\"}");
  if(t.assert(ms0.iserror;"memory.search answers an error result when its search failed, not []")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ms0.text;"search failed");"and says the search failed")){pass=pass+1}el{fail=fail+1};
  let mw0=mcpmem.handlesearch("{\"query\":\"privacy\",\"wing\":\"work\"}");
  if(t.assert(mw0.iserror;"and so does a search scoped to a wing")){pass=pass+1}el{fail=fail+1};
  let mf0=mcpmem.handlefacts("{\"query\":\"privacy\"}");
  if(t.assert(mf0.iserror;"memory.facts answers an error result when its search failed")){pass=pass+1}el{fail=fail+1};

  if(t.assert(!pal.islisted(pal.listwings(p));"listwings reports a failure rather than the four default wings")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pal.islisted(pal.listhalls(p;"work"));"listhalls reports a failure")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pal.islisted(pal.listrooms(p;"work";"Projects"));"listrooms reports a failure")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!pal.iswalked(pal.walk(p));"walk reports that it could not read the palace")){pass=pass+1}el{fail=fail+1};

  let c0=ctx.loadcontext(0;"privacy review";"user";4000 as u32);
  if(t.asserteq(str.join(",";c0.layersloaded);"L0";"a context whose palace could not be read lists only L0 as loaded, not L1 to L3")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(c0.l1palacemap;"PALACE: (unavailable)";"and its palace map says the palace was unavailable")){pass=pass+1}el{fail=fail+1};

  let d0=stor.storeturn(0;"user";"a turn about the privacy review";"s1";"m1";5 as u32;$sensitivitylevel{$internal:0});
  if(t.assert(!stor.isstored(d0);"storeturn reports a turn it could not write as not stored")){pass=pass+1}el{fail=fail+1};

  let m0=mine.minetext(facts();"test";"work";0;0);
  if(t.assert(m0.factsextracted==2;"mining extracts the two facts")){pass=pass+1}el{fail=fail+1};
  if(t.assert(m0.stored==0;"and counts none of them stored when none could be written")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(m0.err;"2 of 2 facts could not be stored");"and says so in its result")){pass=pass+1}el{fail=fail+1};

  (* ── An open palace: the same calls succeed ──────────────────────────────── *)
  let dir=testdir();
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  if(t.assert(pal.openok(dir);"the palace opens")){pass=pass+1}el{fail=fail+1};

  let d1=stor.storeturn(0;"user";"a turn about the privacy review";"s1";"m1";5 as u32;$sensitivitylevel{$internal:0});
  if(t.assert(stor.isstored(d1);"storeturn reports a turn it wrote as stored")){pass=pass+1}el{fail=fail+1};

  let s1=se.search(0;"privacy review";5 as u32);
  if(t.assert(se.succeeded(s1);"search on an open palace reports that it ran")){pass=pass+1}el{fail=fail+1};
  if(t.assert(s1.results.len==1;"and finds the stored turn")){pass=pass+1}el{fail=fail+1};
  let w1=se.searchinwing(0;"privacy review";d1.location.wing;5 as u32);
  if(t.assert(se.succeeded(w1) && w1.results.len==1;"searchinwing finds it in its own wing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!se.succeeded(se.searchinwing(0;"privacy";"";5 as u32));"searchinwing given no wing is refused, not run against every wing")){pass=pass+1}el{fail=fail+1};
  let e1=se.search(0;"nothing matches this";5 as u32);
  if(t.assert(se.succeeded(e1) && e1.results.len==0;"a search that matches nothing ran and found nothing: that is not a failure")){pass=pass+1}el{fail=fail+1};

  let ms1=mcpmem.handlesearch("{\"query\":\"privacy\"}");
  if(t.assert(!ms1.iserror && str.contains(ms1.text;"privacy review");"memory.search finds the turn")){pass=pass+1}el{fail=fail+1};
  let mf1=mcpmem.handlefacts("{\"query\":\"privacy\"}");
  if(t.assert(!mf1.iserror;"memory.facts succeeds")){pass=pass+1}el{fail=fail+1};

  let wl=pal.listwings(p);
  if(t.assert(pal.islisted(wl) && wl.names.len>=4;"listwings lists the default wings")){pass=pass+1}el{fail=fail+1};
  let walked=pal.walk(p);
  if(t.assert(pal.iswalked(walked) && str.contains(walked;"Wing: \(d1.location.wing)");"walk renders the turn's wing")){pass=pass+1}el{fail=fail+1};

  let c1=ctx.loadcontext(0;"privacy review";"user";4000 as u32);
  if(t.asserteq(str.join(",";c1.layersloaded);"L0,L1,L2,L3";"a context on an open palace loads all four layers")){pass=pass+1}el{fail=fail+1};

  let m1=mine.minetext(facts();"test";"work";0;0);
  if(t.assert(m1.stored==2;"mining stores both facts on an open palace")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(m1.err;"";"and reports no failure")){pass=pass+1}el{fail=fail+1};

  <fail
};

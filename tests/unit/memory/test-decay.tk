m=tests.unit.memory.testdecayextended;

i=decay:core.memory.decay;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);
  let cfg = decay.defaultconfig();
  let nowts = 1700000000;
  let secondsperday = 86400;

  let score0d = decay.apply(1.0;nowts;nowts;cfg);
  let score10d = decay.apply(1.0;nowts - (10 * secondsperday);nowts;cfg);
  results = str.arraypush(results;asserttrue("10-day score < fresh score";score10d < score0d));

  let score30d = decay.apply(1.0;nowts - (30 * secondsperday);nowts;cfg);
  let score60d = decay.apply(1.0;nowts - (60 * secondsperday);nowts;cfg);
  results = str.arraypush(results;asserttrue("60-day score < 30-day score";score60d < score30d));

  results = str.arraypush(results;asserttrue("two half-lives score < 0.35";score60d < 0.35));

  let highfresh = decay.apply(1.0;nowts;nowts;cfg);
  let lowfresh = decay.apply(0.5;nowts;nowts;cfg);
  results = str.arraypush(results;asserttrue("higher initial score >= lower initial score";highfresh > lowfresh));

  let halfofhalf = decay.apply(0.5;nowts - (30 * secondsperday);nowts;cfg);
  results = str.arraypush(results;asserttrue("half initial at half-life >= min_score";halfofhalf > cfg.minscore));

  results = str.arraypush(results;asserttrue("default half_life_days is positive";cfg.halflifedays > 0.0));

  let ancient = decay.apply(1.0;nowts - (10000 * secondsperday);nowts;cfg);
  results = str.arraypush(results;asserttrue("ancient memory score >= 0";ancient > 0.0));

  results = str.arraypush(results;asserttrue("fresh score <= initial 1.0";score0d <= 1.0));

  results = str.arraypush(results;asserttrue("sweep_interval > 0";cfg.sweepintervalhours > 0));
  results = str.arraypush(results;asserttrue("sweep_interval <= 168";cfg.sweepintervalhours <= 168));

  results = str.arraypush(results;asserttrue("prune_below < min_score";cfg.prunebelow < cfg.minscore));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i + 1 }el{ let all = false; i = i + 1 }
    }
  };
  <all
};

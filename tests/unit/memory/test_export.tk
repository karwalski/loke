m=test.memory.export;

i=t:std.test;
i=str:std.str;

(* --- stub export format functions --- *)

(* export a single memory entry as JSON line *)
f=exportjsonentry(key:str;value:str;ts:i64):str{
  <str.concat("{\"key\":\"";str.concat(key;str.concat("\",\"value\":\"";str.concat(value;str.concat("\",\"ts\":";str.concat(str.fromi64(ts);"}"))))))
};

(* export a single memory entry as CSV line *)
f=exportcsventry(key:str;value:str;ts:i64):str{
  <str.concat(key;str.concat(",\"";str.concat(value;str.concat("\",";str.fromi64(ts)))))
};

(* generate CSV header *)
f=exportcsvheader():str{
  <"key,value,timestamp"
};

(* generate JSON array wrapper open *)
f=exportjsonopen():str{
  <"["
};

(* generate JSON array wrapper close *)
f=exportjsonclose():str{
  <"]"
};

(* format for export filename *)
f=exportfilename(prefix:str;format:str):str{
  <str.concat(prefix;str.concat("_export.";format))
};

(* validate export format string *)
f=validformat(fmt:str):i64{
  if(str.eq(fmt;"json")){<1};
  if(str.eq(fmt;"csv")){<1};
  if(str.eq(fmt;"txt")){<1};
  <0
};

(* count entries to export — stub returns fixed count *)
f=countexportable():i64{ <42 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test JSON entry format *)
  let je=exportjsonentry("user.pref";"dark_mode";1715600000);
  if(t.assert(str.contains(je;"\"key\":\"user.pref\"");"JSON entry contains key")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(je;"\"value\":\"dark_mode\"");"JSON entry contains value")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(je;"\"ts\":");"JSON entry contains timestamp field")){pass=pass+1}el{fail=fail+1};

  (* test CSV entry format *)
  let ce=exportcsventry("user.pref";"dark_mode";1715600000);
  if(t.assert(str.contains(ce;"user.pref");"CSV entry contains key")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.contains(ce;"\"dark_mode\"");"CSV entry quotes value")){pass=pass+1}el{fail=fail+1};

  (* test CSV header *)
  if(t.assert(str.eq(exportcsvheader();"key,value,timestamp");"CSV header is correct")){pass=pass+1}el{fail=fail+1};

  (* test JSON wrappers *)
  if(t.assert(str.eq(exportjsonopen();"[");"JSON open bracket")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(exportjsonclose();"]");"JSON close bracket")){pass=pass+1}el{fail=fail+1};

  (* test export filename generation *)
  if(t.assert(str.eq(exportfilename("memory";"json");"memory_export.json");"JSON filename correct")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(exportfilename("memory";"csv");"memory_export.csv");"CSV filename correct")){pass=pass+1}el{fail=fail+1};

  (* test format validation *)
  if(t.assert(validformat("json")=1;"json is valid format")){pass=pass+1}el{fail=fail+1};

  if(t.assert(validformat("csv")=1;"csv is valid format")){pass=pass+1}el{fail=fail+1};

  if(t.assert(validformat("txt")=1;"txt is valid format")){pass=pass+1}el{fail=fail+1};

  if(t.assert(validformat("xml")=0;"xml is not a valid format")){pass=pass+1}el{fail=fail+1};

  (* test exportable count *)
  if(t.assert(countexportable()=42;"exportable count returns expected value")){pass=pass+1}el{fail=fail+1};

  <fail
};

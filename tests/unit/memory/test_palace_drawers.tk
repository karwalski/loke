m=test.memory.palacedrawers;
i=t:std.test;
i=str:std.str;

t=$palacelocation{
  wing:str;
  hall:str;
  room:str
};

t=$drawer{
  id:str;
  location:$palacelocation;
  role:str;
  content:str;
  sessionid:str;
  tokens:i64;
  createdat:str
};

t=$drawerstore{
  drawers:@$drawer;
  count:i64
};

f=newstore():$drawerstore{
  <$drawerstore{drawers:@();count:0}
};

f=adddrawer(store:$drawerstore;d:$drawer):$drawerstore{
  let ds=store.drawers;
  let ds=str.arraypush(ds;d);
  <$drawerstore{drawers:ds;count:store.count+1}
};

f=getbyid(store:$drawerstore;id:str):$drawer{
  let found=mut.$drawer{id:"";location:$palacelocation{wing:"";hall:"";room:""};role:"";content:"";sessionid:"";tokens:0;createdat:""};
  lp(let i=0;i<store.count;i=i+1){
    let d=store.drawers.get(i);
    if(str.eq(d.id;id)){found=d}el{}
  };
  <found
};

f=listinwing(store:$drawerstore;wing:str):@$drawer{
  let results=mut.@($drawer);
  lp(let i=0;i<store.count;i=i+1){
    let d=store.drawers.get(i);
    if(str.eq(d.location.wing;wing)){results=str.arraypush(results;d)}el{}
  };
  <results
};

f=countinwing(store:$drawerstore;wing:str):i64{
  let c=mut.0;
  lp(let i=0;i<store.count;i=i+1){
    let d=store.drawers.get(i);
    if(str.eq(d.location.wing;wing)){c=c+1}el{}
  };
  <c
};

f=locationkey(loc:$palacelocation):str{
  let wh=str.concat(loc.wing;"/");
  let whl=str.concat(wh;loc.hall);
  let whlr=str.concat(whl;"/");
  <str.concat(whlr;loc.room)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=newstore();

  if(t.assert(store.count=0;"fresh store has zero drawers")){pass=pass+1}el{fail=fail+1};

  let loc1=$palacelocation{wing:"work";hall:"Projects";room:"loke"};
  let d1=$drawer{id:"d-001";location:loc1;role:"user";content:"Discussed loke architecture";sessionid:"s-001";tokens:45;createdat:"2026-05-01"};
  let store=adddrawer(store;d1);

  if(t.assert(store.count=1;"store has one drawer after add")){pass=pass+1}el{fail=fail+1};

  let loc2=$palacelocation{wing:"work";hall:"Tasks";room:"sprint"};
  let d2=$drawer{id:"d-002";location:loc2;role:"assistant";content:"Sprint planning notes";sessionid:"s-001";tokens:30;createdat:"2026-05-01"};
  let store=adddrawer(store;d2);

  let loc3=$palacelocation{wing:"personal";hall:"Goals";room:"fitness"};
  let d3=$drawer{id:"d-003";location:loc3;role:"user";content:"Running schedule for May";sessionid:"s-002";tokens:20;createdat:"2026-05-02"};
  let store=adddrawer(store;d3);

  if(t.assert(store.count=3;"store has three drawers")){pass=pass+1}el{fail=fail+1};

  let fetched=getbyid(store;"d-001");
  if(t.assert(str.eq(fetched.id;"d-001");"retrieve by id returns correct drawer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(fetched.content;"Discussed loke architecture");"retrieved drawer has correct content")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(fetched.role;"user");"retrieved drawer has correct role")){pass=pass+1}el{fail=fail+1};

  let missing=getbyid(store;"d-999");
  if(t.assert(str.eq(missing.id;"");"missing id returns empty drawer")){pass=pass+1}el{fail=fail+1};

  let workdrawers=listinwing(store;"work");
  if(t.assert(workdrawers.len=2;"list wing work returns 2 drawers")){pass=pass+1}el{fail=fail+1};

  let personaldrawers=listinwing(store;"personal");
  if(t.assert(personaldrawers.len=1;"list wing personal returns 1 drawer")){pass=pass+1}el{fail=fail+1};

  let workcount=countinwing(store;"work");
  if(t.assert(workcount=2;"count in work wing is 2")){pass=pass+1}el{fail=fail+1};

  let key=locationkey(loc1);
  if(t.assert(str.eq(key;"work/Projects/loke");"location key formats correctly")){pass=pass+1}el{fail=fail+1};

  let emptywing=listinwing(store;"technical");
  if(t.assert(emptywing.len=0;"empty wing returns no drawers")){pass=pass+1}el{fail=fail+1};

  <fail
};

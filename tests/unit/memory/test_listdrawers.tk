m=test.memory.listdrawers;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=sdb:core.storage.db;
i=stor:core.memory.storage;
i=mtypes:core.memory.types;
i=ty:shared.types;

(* M1.7d — core.memory.storage.listdrawers against a real migrated store.

   parselistdrawerrows built each $drawer as a bare expression in the loop body and never
   pushed it, so the list it returned was the empty literal it started with, whatever the
   table held (T-24: an array push has to be assigned). The first assertion after the
   stores is that defect.

   Only the $ok arm is relied on: `mt` on a loke-module `X!$lokeerr` takes arm 0 regardless
   (T-18), and $ok is arm 0 here, so an $err would read as an empty list and fail the
   count assertions rather than pass them. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-listdrawers")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s 1;
    $err:e 0
  }
};

f=loc(room:str):$palacelocation{
  <$palacelocation{wing:"technical";hall:"Code";room:room}
};

f=mkdrawer(id:str;room:str;content:str):$drawer{
  <$drawer{
    id:id;
    location:loc(room);
    role:"user";
    content:content;
    sessionid:"s1";
    modelid:"m1";
    tokens:3 as u32;
    sensitivity:$sensitivitylevel{$internal:0};
    createdat:""
  }
};

f=listed(room:str;limit:u32):@($drawer){
  <mt stor.listdrawers(0;loc(room);limit) {
    $ok:ds ds;
    $err:e @()
  }
};

f=hasid(ds:@($drawer);id:str):bool{
  let found=mut.false;
  lp(let i=0;i<ds.len;i=i+1){
    let d:$drawer=ds.get(i);
    if(str.eq(d.id;id)){ found=true }el{}
  };
  <found
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let opened=openfreshstore();
  if(t.assert(opened==1;"the store opened on a fresh file and its migrations ran")){pass=pass+1}el{fail=fail+1};

  stor.storedrawer(0;mkdrawer("ld-a";"alpha";"first drawer in alpha"));
  stor.storedrawer(0;mkdrawer("ld-b";"alpha";"second drawer in alpha"));
  stor.storedrawer(0;mkdrawer("ld-c";"beta";"only drawer in beta"));
  if(t.assert(sdb.countquery("SELECT id FROM memory_drawers WHERE room=?";@("alpha"))==2;"two drawers are in room alpha (control: the table is not empty)")){pass=pass+1}el{fail=fail+1};

  (* ── The defect ──────────────────────────────────────────────────────────── *)
  let alpha=listed("alpha";10 as u32);
  if(t.assert(alpha.len==2;"listdrawers returns both drawers in the room, not an empty list (M1.7d)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasid(alpha;"ld-a");"ld-a is one of them")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasid(alpha;"ld-b");"and ld-b is the other")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!hasid(alpha;"ld-c");"a drawer in another room is not listed")){pass=pass+1}el{fail=fail+1};

  let beta=listed("beta";10 as u32);
  if(t.assert(beta.len==1;"room beta lists its one drawer")){pass=pass+1}el{fail=fail+1};
  if(beta.len==1){
    let d:$drawer=beta.get(0);
    if(t.assert(str.eq(d.content;"only drawer in beta");"the listed drawer carries its content")){pass=pass+1}el{fail=fail+1};
    let dl:$palacelocation=d.location;
    if(t.assert(str.eq(dl.room;"beta");"and its location")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+2 };

  if(t.assert(listed("alpha";1 as u32).len==1;"the limit is applied")){pass=pass+1}el{fail=fail+1};
  if(t.assert(listed("gamma";10 as u32).len==0;"an empty room lists nothing")){pass=pass+1}el{fail=fail+1};

  <fail
};

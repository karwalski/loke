m=test.memory.privacyprefs;

i=t:std.test;
i=mp:core.memory.privacy;

(* F10.57 - core.memory.privacy.parseprefsjson, the reader of the stored privacy_prefs row.

   RED BEFORE THE FIX: a document without max_retention_days or auto_forget_pii read them as
   0 days and false, so a row missing the field switched PII auto-forget off, where an
   unparsable row (prefsparsefail) gives the defaults: 365 days and true. A field the
   document does carry, false included, is kept. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let empty=mp.parseprefsjson("{}");
  if(t.assert(empty.autoforgetpii;"a missing auto_forget_pii takes the default, true")){pass=pass+1}el{fail=fail+1};
  if(t.assert((empty.maxretentiondays as i64)==365;"a missing max_retention_days takes the default, 365")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!empty.requireconsent;"a missing require_consent takes the default, false")){pass=pass+1}el{fail=fail+1};

  let given=mp.parseprefsjson("{\"max_retention_days\":30,\"auto_forget_pii\":false,\"require_consent\":true}");
  if(t.assert(!given.autoforgetpii;"an explicit auto_forget_pii false is kept")){pass=pass+1}el{fail=fail+1};
  if(t.assert((given.maxretentiondays as i64)==30;"an explicit max_retention_days is kept")){pass=pass+1}el{fail=fail+1};
  if(t.assert(given.requireconsent;"an explicit require_consent true is kept")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.memory.aaak;

i=t:std.test;
i=str:std.str;
i=aaak:core.memory.aaak;

(* This file declared its own $compressionresult and its own compresslight,
   compressmedium and compressaggressive — three word-filtering routines that have
   nothing to do with core.memory.aaak, which strips articles and prepositions,
   abbreviates long words and recognises decision and team patterns. The test passed
   on its own copies and then crashed; the module went untested either way.

   It exercises the real encoder now. The properties asserted are the ones the encoder
   promises: each level shortens the text, the levels are ordered, and the terms a
   reader needs to keep survive compression — an encoder that drops the subject has
   not compressed anything, it has lost it. *)

f=levellight():$compresslevel{
  <$compresslevel{$light:0}
};

f=levelmedium():$compresslevel{
  <$compresslevel{$medium:0}
};

f=levelaggressive():$compresslevel{
  <$compresslevel{$aggressive:0}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let text="The privacy pipeline is the component that handles the anonymisation of the data before it goes to the provider";

  let light=aaak.applylevel(text;levellight());
  let medium=aaak.applylevel(text;levelmedium());
  let aggressive=aaak.applylevel(text;levelaggressive());

  if(t.assert(str.len(light)<str.len(text);"light compression shortens the text")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(medium)<str.len(text);"medium compression shortens the text")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(aggressive)<str.len(text);"aggressive compression shortens the text")){pass=pass+1}el{fail=fail+1};

  (* Ordered: each level is at least as aggressive as the one before it. *)
  if(t.assert(str.len(medium)<=str.len(light);"medium is no longer than light")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.len(aggressive)<=str.len(medium);"aggressive is no longer than medium")){pass=pass+1}el{fail=fail+1};

  (* The subject must survive. Compression that drops the nouns has lost the meaning,
     and this text is stored to be read back later. *)
  if(t.assert(str.contains(light;"privacy");"light keeps the subject")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(medium;"privacy");"medium keeps the subject")){pass=pass+1}el{fail=fail+1};

  (* measuresavings reports a percentage, and must not divide by zero on empty input. *)
  (* Read in hundredths of a percent. An f64 returned across a module boundary is
     corrupted (T-20) — measuresavings computes 50.0 and the caller receives 5 — so
     the integer form is the one a test in another module can trust. *)
  if(t.assert(aaak.measuresavingsbp(text;light)>0;"a shorter encoding reports a saving")){pass=pass+1}el{fail=fail+1};
  if(t.assert(aaak.measuresavingsbp("";"")==0;"empty input reports no saving rather than dividing by zero")){pass=pass+1}el{fail=fail+1};
  if(t.assert(aaak.measuresavingsbp(text;text)==0;"an unchanged encoding reports no saving")){pass=pass+1}el{fail=fail+1};
  if(t.assert(aaak.measuresavingsbp("0123456789";"01234")==5000;"halving the text reports exactly 50.00%")){pass=pass+1}el{fail=fail+1};

  (* encodetext splits on sentences and must return one entry per non-empty sentence —
     it returned an empty document for every input until the accumulation was fixed. *)
  let doc=aaak.encodetext("The router picks a model. The filter removes the names.";levellight());
  if(t.assert(doc.entries.len==2;"encodetext returns an entry per sentence")){pass=pass+1}el{fail=fail+1};

  <fail
};

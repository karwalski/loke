m=test.memory.aaak;
i=t:std.test;
i=str:std.str;

t=$compressionresult{
  original:str;
  compressed:str;
  level:str;
  originallen:i64;
  compressedlen:i64
};

f=compresslight(text:str):$compressionresult{
  let words=str.split(text;" ");
  let kept=mut.@();
  lp(let i=0;i<words.len;i=i+1){
    let w=words.get(i);
    let wlen=str.len(w);
    if(wlen>2){kept=str.arraypush(kept;w)}el{}
  };
  let compressed=str.join(kept;" ");
  <$compressionresult{original:text;compressed:compressed;level:"light";originallen:str.len(text);compressedlen:str.len(compressed)}
};

f=compressmedium(text:str):$compressionresult{
  let words=str.split(text;" ");
  let kept=mut.@();
  lp(let i=0;i<words.len;i=i+1){
    let w=words.get(i);
    let wlen=str.len(w);
    if(wlen>3){kept=str.arraypush(kept;w)}el{}
  };
  let compressed=str.join(kept;" ");
  <$compressionresult{original:text;compressed:compressed;level:"medium";originallen:str.len(text);compressedlen:str.len(compressed)}
};

f=compressaggressive(text:str):$compressionresult{
  let words=str.split(text;" ");
  let kept=mut.@();
  lp(let i=0;i<words.len;i=i+1){
    let w=words.get(i);
    let wlen=str.len(w);
    if(wlen>4){kept=str.arraypush(kept;w)}el{}
  };
  let compressed=str.join(kept;" ");
  <$compressionresult{original:text;compressed:compressed;level:"aggressive";originallen:str.len(text);compressedlen:str.len(compressed)}
};

f=preserveskey(compressed:str;key:str):bool{
  <str.contains(compressed;key)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let text="The user discussed the loke privacy proxy architecture and how it handles sensitive data through anonymisation filters";

  let light=compresslight(text);
  if(t.assert(light.compressedlen<light.originallen;"light compression reduces length")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(light.level;"light");"light level is labelled correctly")){pass=pass+1}el{fail=fail+1};
  if(t.assert(preserveskey(light.compressed;"privacy");"light preserves key word privacy")){pass=pass+1}el{fail=fail+1};
  if(t.assert(preserveskey(light.compressed;"architecture");"light preserves key word architecture")){pass=pass+1}el{fail=fail+1};

  let medium=compressmedium(text);
  if(t.assert(medium.compressedlen<medium.originallen;"medium compression reduces length")){pass=pass+1}el{fail=fail+1};
  if(t.assert(medium.compressedlen<light.compressedlen;"medium is shorter than light")){pass=pass+1}el{fail=fail+1};
  if(t.assert(preserveskey(medium.compressed;"privacy");"medium preserves key word privacy")){pass=pass+1}el{fail=fail+1};
  if(t.assert(preserveskey(medium.compressed;"anonymisation");"medium preserves key word anonymisation")){pass=pass+1}el{fail=fail+1};

  let aggressive=compressaggressive(text);
  if(t.assert(aggressive.compressedlen<aggressive.originallen;"aggressive compression reduces length")){pass=pass+1}el{fail=fail+1};
  if(t.assert(aggressive.compressedlen<medium.compressedlen;"aggressive is shorter than medium")){pass=pass+1}el{fail=fail+1};
  if(t.assert(preserveskey(aggressive.compressed;"privacy");"aggressive preserves key word privacy")){pass=pass+1}el{fail=fail+1};

  let empty=compresslight("");
  if(t.assert(empty.compressedlen=0;"empty string compresses to empty")){pass=pass+1}el{fail=fail+1};

  <fail
};

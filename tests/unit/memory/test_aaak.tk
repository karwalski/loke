


m=tests.unit.memory.testaaak;

i=aaak:core.memory.aaak;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let lvl = aaak.defaultlevel();

  
  let fact = "Alice is the lead engineer";
  let encoded = aaak.encodefact(fact;lvl);
  results = str.arraypush(results;asserttrue("encode_fact returns non-empty string";str.len(encoded) > 0));

  
  let encodedcopula = aaak.encodefact("Alice is the lead engineer";lvl);
  results = str.arraypush(results;asserttrue("encode_fact copula contains colon";str.contains(encodedcopula;":")));

  
  let decisionfact = "We decided to use Rust because of performance";
  let encodeddec = aaak.encodefact(decisionfact;lvl);
  results = str.arraypush(results;asserttrue("encode_fact decision produces DEC: prefix";str.contains(encodeddec;"DEC:")));

  
  results = str.arraypush(results;asserttrue("encode_fact decision with reason contains arrow";str.contains(encodeddec;"←")));

  
  let managesfact = "Alice manages the backend team";
  let encodedmanages = aaak.encodefact(managesfact;lvl);
  results = str.arraypush(results;asserttrue("encode_fact manages produces lead shorthand";str.contains(encodedmanages;"(lead):")));

  
  let multi = "Alice is the lead engineer. Bob manages the backend team. We decided to use Rust because of performance";
  let doc = aaak.encodetext(multi;lvl);
  results = str.arraypush(results;asserttrue("encode_text raw is non-empty";str.len(doc.raw) > 0));

  
  let entrycount = str.arraylen(doc.entries);
  results = str.arraypush(results;asserttrue("encode_text produces at least one entry";entrycount >= 1));

  
  results = str.arraypush(results;asserttrue("encode_text aaak_len <= source_len";doc.aaaklen <= doc.sourcelen));

  
  let savingsempty = aaak.measuresavings("";"");
  results = str.arraypush(results;asserttrue("measure_savings empty original returns 0.0";savingsempty == 0.0));

  
  let longtext = "The quick brown fox jumps over the lazy dog in the park";
  let shortaaak = "quick brown fox jumps lazy dog park";
  let savingspos = aaak.measuresavings(longtext;shortaaak);
  results = str.arraypush(results;asserttrue("measure_savings returns positive when aaak is shorter";savingspos > 0.0));

  
  let decaaak = "DEC: use Rust ← performance";
  let decoded = aaak.decode(decaaak);
  results = str.arraypush(results;asserttrue("decode DEC: prefix expands to Decision:";str.contains(decoded;"Decision:")));
  results = str.arraypush(results;asserttrue("decode DEC: reason expands to because";str.contains(decoded;"because")));

  
  let teamaaak = "TEAM: Alice Bob Charlie";
  let decodedteam = aaak.decode(teamaaak);
  results = str.arraypush(results;asserttrue("decode TEAM: prefix expands to Team:";str.contains(decodedteam;"Team:")));

  
  let twosent = "Alice is the lead. Bob manages backend";
  let twodoc = aaak.encodetext(twosent;lvl);
  results = str.arraypush(results;asserttrue("encode_text two sentences joined with pipe";str.contains(twodoc.raw;" | ")));

  
  let emptyencoded = aaak.encodefact("";lvl);
  results = str.arraypush(results;asserttrue("encode_fact empty input returns empty";str.len(emptyencoded) == 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n{ break }else{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all = false }else{};
      i = i + 1
    };
  };
  <all
};

m=test.memory.palaceonedb;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=sdb:core.storage.db;
i=pal:core.memory.palace;

(* M1.8 — opening the memory palace must not take the store's connection away.

   std.db keeps ONE global connection (T-30): a second db.open silently replaces the first.
   core.memory.palace.open used to open `datadir/memory.db`, so after it every query from the
   store went to a file with no audit_log and no settings, and the failure was silent because
   row reads map an error to 0 or "". The palace now opens `loke.db`, the store's own file.

   The property asserted here is the one that broke: after palace.open, the STORE's tables are
   still visible, and so are the palace's. Order matters in the test and not in the product —
   the store is opened first because that is what a running loke does, and then the palace. The
   result of palace.open is not matched on (T-18); what it did is read back from the schema. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-palace-one-db")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let dir=testdir();
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  file.delete(str.concat(dir;"/memory.db"));
  let opened=mt sdb.openstore(dir) {
    $ok:s 1;
    $err:e 0
  };
  if(t.assert(opened==1;"the store opened on a fresh file")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.tableexists("audit_log");"and audit_log exists before the palace is opened (control)")){pass=pass+1}el{fail=fail+1};

  pal.open(dir);

  if(t.assert(sdb.tableexists("audit_log");"audit_log is STILL visible after palace.open — the palace did not take the connection to another file (M1.8)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.tableexists("settings");"and so is settings")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.tableexists("memory_drawers");"and the palace's own table is in the same database")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!file.exists(str.concat(dir;"/memory.db"));"no second database file was created")){pass=pass+1}el{fail=fail+1};

  <fail
};

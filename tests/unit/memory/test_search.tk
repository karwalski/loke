m=test.memory.search;
i=t:std.test;
i=str:std.str;

t=$searchresult{
  drawerid:str;
  contentexcerpt:str;
  relevancescore:f64;
  createdat:str
};

t=$searchindex{
  entries:@$indexentry;
  count:i64
};

t=$indexentry{
  drawerid:str;
  content:str;
  keywords:str
};

f=newindex():$searchindex{
  <$searchindex{entries:@();count:0}
};

f=addentry(idx:$searchindex;e:$indexentry):$searchindex{
  let es=idx.entries;
  let es=str.arraypush(es;e);
  <$searchindex{entries:es;count:idx.count+1}
};

f=scorematch(content:str;query:str):f64{
  if(str.contains(content;query)){<1.0}el{
    let words=str.split(query;" ");
    let matched=mut.0.0;
    let total=mut.0.0;
    lp(let i=0;i<words.len;i=i+1){
      let w=words.get(i);
      total=total+1.0;
      if(str.contains(content;w)){matched=matched+1.0}el{}
    };
    if(total>0.0){<matched/total}el{<0.0}
  }
};

f=search(idx:$searchindex;query:str):@$searchresult{
  let results=mut.@($searchresult);
  if(str.eq(query;"")){<results}el{};
  lp(let i=0;i<idx.count;i=i+1){
    let e=idx.entries.get(i);
    let score=scorematch(e.content;query);
    if(score>0.0){
      let r=$searchresult{drawerid:e.drawerid;contentexcerpt:e.content;relevancescore:score;createdat:""};
      results=str.arraypush(results;r)
    }el{}
  };
  <results
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let idx=newindex();
  let idx=addentry(idx;$indexentry{drawerid:"d-001";content:"loke privacy proxy architecture design";keywords:"loke privacy proxy"});
  let idx=addentry(idx;$indexentry{drawerid:"d-002";content:"sprint planning for next quarter";keywords:"sprint planning"});
  let idx=addentry(idx;$indexentry{drawerid:"d-003";content:"privacy filter implementation details";keywords:"privacy filter"});
  let idx=addentry(idx;$indexentry{drawerid:"d-004";content:"running schedule and fitness goals";keywords:"fitness running"});

  let r1=search(idx;"privacy");
  if(t.assert(r1.len=2;"keyword privacy returns 2 results")){pass=pass+1}el{fail=fail+1};

  let r2=search(idx;"");
  if(t.assert(r2.len=0;"empty query returns empty results")){pass=pass+1}el{fail=fail+1};

  let r3=search(idx;"nonexistent topic xyz");
  if(t.assert(r3.len=0;"irrelevant query returns no results")){pass=pass+1}el{fail=fail+1};

  let r4=search(idx;"loke privacy proxy architecture design");
  if(t.assert(r4.len>0;"exact content match returns results")){pass=pass+1}el{fail=fail+1};

  let first=r4.get(0);
  if(t.assert(first.relevancescore=1.0;"exact match has score 1.0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(first.drawerid;"d-001");"exact match returns correct drawer id")){pass=pass+1}el{fail=fail+1};

  let r5=search(idx;"sprint");
  if(t.assert(r5.len=1;"keyword sprint returns 1 result")){pass=pass+1}el{fail=fail+1};
  let sprintresult=r5.get(0);
  if(t.assert(str.eq(sprintresult.drawerid;"d-002");"sprint search returns d-002")){pass=pass+1}el{fail=fail+1};

  let r6=search(idx;"loke");
  if(t.assert(r6.len=1;"keyword loke returns 1 result")){pass=pass+1}el{fail=fail+1};

  let r7=search(idx;"fitness");
  let fitresult=r7.get(0);
  if(t.assert(str.contains(fitresult.contentexcerpt;"fitness");"result excerpt contains search term")){pass=pass+1}el{fail=fail+1};

  <fail
};

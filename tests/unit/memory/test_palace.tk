m=tests.unit.memory.testpalace;

i=palace:core.memory.palace;
i=memtypes:core.memory.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=assertintgt(n:str;got:i32;min:i32):$result{
  if(got > min){ <pass(n) }el{
    <fail(n;str.concat("expected > ";str.concat(str.fromint(min);str.concat(" got ";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let tmpdir = "/tmp/loke_test_palace";
  let openresult = palace.open(tmpdir);
  let opened = mt openresult { $ok:v true; $err:e false };
  results = str.arraypush(results;asserttrue("palace opens without error";opened));

  if(opened){
    let p = mt openresult { $ok:p p; $err:e palace.$palace{conn:palace.$dbconn{};datadir:""} };

    let stresult = palace.status(p);
    let totaldrawerszero = mt stresult {
      $ok:st st.totaldrawers = 0;
      $err:e false
    };
    results = str.arraypush(results;asserttrue("fresh palace has zero drawers";totaldrawerszero));

    let wingsresult = palace.listwings(p);
    let wingscountok = mt wingsresult {
      $ok:wings str.arraylen(wings) > 4;
      $err:e false
    };
    results = str.arraypush(results;asserttrue("fresh palace has at least 4 default wings";wingscountok));

    let hasworkwing = mt wingsresult {
      $ok:wings palace.containswing(wings;"work");
      $err:e false
    };
    results = str.arraypush(results;asserttrue("default wings include work";hasworkwing));

    let haspersonalwing = mt wingsresult {
      $ok:wings palace.containswing(wings;"personal");
      $err:e false
    };
    results = str.arraypush(results;asserttrue("default wings include personal";haspersonalwing));

    let walkresult = palace.walk(p);
    let walknonempty = mt walkresult {
      $ok:s str.len(s) > 0;
      $err:e false
    };
    results = str.arraypush(results;asserttrue("palace walk returns non-empty string";walknonempty));

    let walkcontainswing = mt walkresult {
      $ok:s str.contains(s;"Wing:");
      $err:e false
    };
    results = str.arraypush(results;asserttrue("palace walk output contains Wing:";walkcontainswing));

    let hallsresult = palace.listhalls(p;"work");
    let hallsok = mt hallsresult { $ok:v true; $err:e false };
    results = str.arraypush(results;asserttrue("list_halls on work wing succeeds";hallsok));

    let roomsresult = palace.listrooms(p;"work";"Projects");
    let roomsok = mt roomsresult { $ok:v true; $err:e false };
    results = str.arraypush(results;asserttrue("list_rooms on work/Projects succeeds";roomsok));

    let statuswingsok = mt stresult { $ok:v true; $err:e false };
    results = str.arraypush(results;asserttrue("palace status call succeeds";statuswingsok))
  }el{};

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i + 1 }el{ let all = false; i = i + 1 }
    }
  };
  <all
};

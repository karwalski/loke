m=tests.unit.memory.testdecay;

i=decay:core.memory.decay;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let cfg = decay.defaultconfig();

  results = str.arraypush(results;asserttrue("default config half_life_days is 30";cfg.halflifedays = 30.0));

  results = str.arraypush(results;asserttrue("default config min_score is 0.1";cfg.minscore = 0.1));

  results = str.arraypush(results;asserttrue("default config prune_below is 0.05";cfg.prunebelow = 0.05));

  results = str.arraypush(results;asserttrue("default config sweep_interval_hours is 24";cfg.sweepintervalhours = 24));

  let nowts = 1700000000;
  let scorefresh = decay.apply(1.0;nowts;nowts;cfg);
  results = str.arraypush(results;asserttrue("fresh memory score is non-negative";scorefresh > 0.0));
  results = str.arraypush(results;asserttrue("fresh memory score is <= 1.0";scorefresh <= 1.0));

  results = str.arraypush(results;asserttrue("fresh memory score near 1.0";scorefresh > 0.99));

  let secondsperday = 86400;
  let created30dago = nowts - (30 * secondsperday);
  let score30d = decay.apply(1.0;created30dago;nowts;cfg);
  results = str.arraypush(results;asserttrue("30-day old memory score is non-negative";score30d > 0.0));
  results = str.arraypush(results;asserttrue("30-day old memory score decayed below 0.6";score30d <= 0.6));

  results = str.arraypush(results;asserttrue("older memory has lower or equal score than fresh";score30d <= scorefresh));

  let created1000dago = nowts - (1000 * secondsperday);
  let scoreold = decay.apply(1.0;created1000dago;nowts;cfg);
  results = str.arraypush(results;asserttrue("very old memory score equals min_score";scoreold = cfg.minscore));

  let scoretiny = decay.apply(0.04;nowts;nowts;cfg);

  results = str.arraypush(results;asserttrue("score below prune_below threshold check";cfg.prunebelow < cfg.minscore));

  results = str.arraypush(results;asserttrue("min_score is above prune_below";cfg.minscore > cfg.prunebelow));

  let scorezeroinput = decay.apply(0.0;nowts;nowts;cfg);
  results = str.arraypush(results;asserttrue("zero input score clamped to min_score";scorezeroinput = cfg.minscore));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i + 1 }el{ let all = false; i = i + 1 }
    }
  };
  <all
};

m=test.memory.decay;

i=t:std.test;
i=str:std.str;

(* --- stub decay scoring functions --- *)

(* simulate timestamp as integer seconds since epoch *)
f=now():i64{ <1715600000 };

(* decay score: newer items score higher, older items score lower *)
(* score = max(0, 1000 - (now - timestamp) / 86400) *)
(* i.e. loses 1 point per day, max 1000 *)
f=decay_score(timestamp:i64):i64{
  let age_days=(now()-timestamp)/86400;
  let score=1000-age_days;
  if(score<0){<0};
  <score
};

(* sweep threshold — items below this score should be swept *)
f=sweep_threshold():i64{ <100 };

(* check if a memory should be swept *)
f=should_sweep(timestamp:i64):i64{
  if(decay_score(timestamp)<sweep_threshold()){<1};
  <0
};

(* boost score for pinned memories *)
f=boosted_score(timestamp:i64;pinned:i64):i64{
  let base=decay_score(timestamp);
  if(pinned=1){<base+500};
  <base
};

(* recency rank: 0=most recent tier, 1=recent, 2=old, 3=ancient *)
f=recency_tier(timestamp:i64):i64{
  let score=decay_score(timestamp);
  if(score>800){<0};
  if(score>500){<1};
  if(score>100){<2};
  <3
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test that very recent item scores near max *)
  let recent=now()-86400;
  if(t.assert(decay_score(recent)=999;"1-day-old item scores 999")){pass=pass+1}el{fail=fail+1};

  (* test that item from today scores max *)
  if(t.assert(decay_score(now())=1000;"current-time item scores 1000")){pass=pass+1}el{fail=fail+1};

  (* test that older item scores lower *)
  let week_old=now()-(86400*7);
  if(t.assert(decay_score(week_old)=993;"7-day-old item scores 993")){pass=pass+1}el{fail=fail+1};

  (* test that very old item scores near zero *)
  let old=now()-(86400*950);
  if(t.assert(decay_score(old)=50;"950-day-old item scores 50")){pass=pass+1}el{fail=fail+1};

  (* test that ancient item floors at zero *)
  let ancient=now()-(86400*2000);
  if(t.assert(decay_score(ancient)=0;"2000-day-old item floors at 0")){pass=pass+1}el{fail=fail+1};

  (* test sweep threshold *)
  if(t.assert(sweep_threshold()=100;"sweep threshold is 100")){pass=pass+1}el{fail=fail+1};

  (* test should_sweep for old item *)
  let sweepable=now()-(86400*950);
  if(t.assert(should_sweep(sweepable)=1;"950-day-old item should be swept")){pass=pass+1}el{fail=fail+1};

  (* test should_sweep for recent item *)
  if(t.assert(should_sweep(recent)=0;"1-day-old item should not be swept")){pass=pass+1}el{fail=fail+1};

  (* test boosted score for pinned memory *)
  if(t.assert(boosted_score(recent;1)=1499;"pinned recent item gets +500 boost")){pass=pass+1}el{fail=fail+1};

  (* test unboosted score *)
  if(t.assert(boosted_score(recent;0)=999;"unpinned item has normal score")){pass=pass+1}el{fail=fail+1};

  (* test recency tiers *)
  if(t.assert(recency_tier(now())=0;"current item is tier 0 (most recent)")){pass=pass+1}el{fail=fail+1};

  let mid_age=now()-(86400*300);
  if(t.assert(recency_tier(mid_age)=1;"300-day-old item is tier 1 (recent)")){pass=pass+1}el{fail=fail+1};

  let older=now()-(86400*800);
  if(t.assert(recency_tier(older)=2;"800-day-old item is tier 2 (old)")){pass=pass+1}el{fail=fail+1};

  if(t.assert(recency_tier(ancient)=3;"ancient item is tier 3")){pass=pass+1}el{fail=fail+1};

  <fail
};

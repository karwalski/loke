m=test.memory.decay;

i=t:std.test;
i=str:std.str;

(* --- stub decay scoring functions --- *)

(* simulate timestamp as integer seconds since epoch *)
f=now():i64{ <1715600000 };

(* decay score: newer items score higher, older items score lower *)
(* score = max(0, 1000 - (now - timestamp) / 86400) *)
(* i.e. loses 1 point per day, max 1000 *)
f=decayscore(timestamp:i64):i64{
  let agedays=(now()-timestamp)/86400;
  let score=1000-agedays;
  if(score<0){<0};
  <score
};

(* sweep threshold — items below this score should be swept *)
f=sweepthreshold():i64{ <100 };

(* check if a memory should be swept *)
f=shouldsweep(timestamp:i64):i64{
  if(decayscore(timestamp)<sweepthreshold()){<1};
  <0
};

(* boost score for pinned memories *)
f=boostedscore(timestamp:i64;pinned:i64):i64{
  let base=decayscore(timestamp);
  if(pinned=1){<base+500};
  <base
};

(* recency rank: 0=most recent tier, 1=recent, 2=old, 3=ancient *)
f=recencytier(timestamp:i64):i64{
  let score=decayscore(timestamp);
  if(score>800){<0};
  if(score>500){<1};
  if(score>100){<2};
  <3
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test that very recent item scores near max *)
  let recent=now()-86400;
  if(t.assert(decayscore(recent)=999;"1-day-old item scores 999")){pass=pass+1}el{fail=fail+1};

  (* test that item from today scores max *)
  if(t.assert(decayscore(now())=1000;"current-time item scores 1000")){pass=pass+1}el{fail=fail+1};

  (* test that older item scores lower *)
  let weekold=now()-(86400*7);
  if(t.assert(decayscore(weekold)=993;"7-day-old item scores 993")){pass=pass+1}el{fail=fail+1};

  (* test that very old item scores near zero *)
  let old=now()-(86400*950);
  if(t.assert(decayscore(old)=50;"950-day-old item scores 50")){pass=pass+1}el{fail=fail+1};

  (* test that ancient item floors at zero *)
  let ancient=now()-(86400*2000);
  if(t.assert(decayscore(ancient)=0;"2000-day-old item floors at 0")){pass=pass+1}el{fail=fail+1};

  (* test sweep threshold *)
  if(t.assert(sweepthreshold()=100;"sweep threshold is 100")){pass=pass+1}el{fail=fail+1};

  (* test shouldsweep for old item *)
  let sweepable=now()-(86400*950);
  if(t.assert(shouldsweep(sweepable)=1;"950-day-old item should be swept")){pass=pass+1}el{fail=fail+1};

  (* test shouldsweep for recent item *)
  if(t.assert(shouldsweep(recent)=0;"1-day-old item should not be swept")){pass=pass+1}el{fail=fail+1};

  (* test boosted score for pinned memory *)
  if(t.assert(boostedscore(recent;1)=1499;"pinned recent item gets +500 boost")){pass=pass+1}el{fail=fail+1};

  (* test unboosted score *)
  if(t.assert(boostedscore(recent;0)=999;"unpinned item has normal score")){pass=pass+1}el{fail=fail+1};

  (* test recency tiers *)
  if(t.assert(recencytier(now())=0;"current item is tier 0 (most recent)")){pass=pass+1}el{fail=fail+1};

  let midade=now()-(86400*300);
  if(t.assert(recencytier(midade)=1;"300-day-old item is tier 1 (recent)")){pass=pass+1}el{fail=fail+1};

  let older=now()-(86400*800);
  if(t.assert(recencytier(older)=2;"800-day-old item is tier 2 (old)")){pass=pass+1}el{fail=fail+1};

  if(t.assert(recencytier(ancient)=3;"ancient item is tier 3")){pass=pass+1}el{fail=fail+1};

  <fail
};

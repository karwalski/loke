m=test.memory.decay;

i=t:std.test;
i=str:std.str;
i=dec:core.memory.decay;

(* X7.2 — this file used to declare its own decay curve and assert arithmetic against it:

     f=now():i64{ <1715600000 };
     f=decayscore(timestamp:i64):i64{ let agedays=(now()-timestamp)/86400; let score=1000-agedays; ... }
     ...
     t.assert(decayscore(weekold)==993;"7-day-old item scores 993")

   The curve in the test was LINEAR — one point lost per day out of a thousand. The curve
   in core.memory.decay is EXPONENTIAL: a half-life in days, applied with math.pow. They
   are not approximations of each other — after 30 days the stub says 970/1000 and the
   module says half — and fourteen assertions agreed with the stub perfectly while saying
   nothing whatever about the module.

   FINDING, MEASURED: `apply` RETURNS GARBAGE ACROSS A MODULE BOUNDARY.

   This is why almost nothing about the curve is asserted below. Called from this file,
   core.memory.decay.apply returns 2 for a memory created now (correct answer: 1.0) and
   -inf for every decayed one — measured at ages of 30, 60 and 3650 days and at starting
   scores of 0.4, 0.8 and 1.0. The struct fields of $decayconfig read back perfectly from
   the same module in the same run (30, 0.1, 0.05), which is the signature of T-20: a bare
   FLOAT RETURN is corrupted across a module boundary while parameters and struct fields
   are intact. T-20 is recorded for f64; this is the same defect for f32.

   It is LATENT, and that is checked rather than assumed: nothing outside
   packages/core/src/memory/decay.tk imports this module, so no production caller reads
   the corrupted value. The only consumer is `sweeprows`, whose call to `apply` is
   intra-module and therefore not subject to the boundary defect.

   WHY IT STILL MATTERS, because the failure mode is not a wrong score. sweeprows does:

     let decayed=apply(basescore;createdat;now;cfg);
     if(decayed < cfg.prunebelow){ DELETE FROM memory_scores ...; DELETE FROM memory_drawers ... }

   If that comparison ever sees -inf it is TRUE FOR EVERY ROW, and the sweep deletes the
   user's entire memory palace. Today it cannot run at all — memory_scores does not exist,
   so db.many fails and sweep returns sweepqueryfail(); see
   tests/unit/memory/test_palace_drawers.tk for that measurement. So the day M1.7 creates
   the missing tables, the first sweep is a total data loss unless this is fixed first.
   That ordering is the reason this is written down here rather than left as a curiosity.

   One assertion below is deliberately RED as the marker for it. Everything else asserts
   what does hold: the retention policy in defaultconfig, which is the part a reviewer
   needs to be able to read off a test.

   `sweep` and `refresh` are not exercised: both need the memory_scores table. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let c=dec.defaultconfig();

  (* ── The default retention policy ────────────────────────────────────────────
     Four numbers that decide what the product FORGETS. They come back across the
     boundary intact because they are struct fields, not returns. *)
  if(t.assert(c.halflifedays>29.0 as f32;"the default half-life is 30 days (lower bound)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(c.halflifedays<31.0 as f32;"the default half-life is 30 days (upper bound)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(c.minscore>0.0 as f32;"there is a non-zero score FLOOR, so a memory never decays to exactly nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(c.minscore<1.0 as f32;"and the floor is below a full score, or nothing ever decays at all")){pass=pass+1}el{fail=fail+1};

  (* The ordering of the two thresholds is the load-bearing part. prunebelow is a DELETE
     threshold and minscore is a clamp: if prunebelow were at or above the floor, every
     memory would become eligible for deletion the moment it reached the floor, which is
     every memory eventually. *)
  if(t.assert(c.prunebelow<c.minscore;"the PRUNE threshold is strictly BELOW the score floor — otherwise every memory becomes deletable on reaching the floor")){pass=pass+1}el{fail=fail+1};
  if(t.assert(c.prunebelow>0.0 as f32;"and it is positive, so a zero score is not a special case")){pass=pass+1}el{fail=fail+1};
  if(t.assert(c.sweepintervalhours>0;"the sweep interval is positive, or the sweeper never runs")){pass=pass+1}el{fail=fail+1};

  (* ── THE MARKER, DELIBERATELY RED ────────────────────────────────────────────
     A decay factor is a probability-like quantity: whatever the age, the result must be
     finite and must lie between the configured floor and the starting score. This single
     assertion covers the whole class — a corrupted return fails it however it is
     corrupted — and it is the one that has to go green before core.memory.decay can be
     called from anywhere but itself.

     Measured today: fresh=2, and every aged value is -inf. See the note at the top. *)
  let fresh=dec.apply(1.0 as f32;0;0;c);
  if(t.assert(fresh<=1.0 as f32;"apply returns a decay factor no greater than the score it was given — RED: T-20 corrupts the f32 return across the module boundary, measured as 2 for a fresh memory and -inf once aged")){pass=pass+1}el{fail=fail+1};

  <fail
};

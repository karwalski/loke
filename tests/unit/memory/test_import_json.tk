m=test.memory.importjson;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=db:std.db;
i=sdb:core.storage.db;
i=ex:core.memory.export;

(* LS1.1k — core.memory.export.importjson against a real migrated store and a JSON file in
   the shape exportall writes.

   importjson read each element of its parsed array with `db.rowstr(item;...)`, a ROW
   accessor, on a JSON value. `std.db` declares the row accessors `(i64,i64)->i64` in a
   `gen:"abi"` block, so nothing stopped it. Every field came back empty.

   It also left memory_scores.created_at to the column default, so an imported memory aged
   from the moment of import rather than from when it was made (M1.7c). The file's own
   created_at is carried through now, and the last assertions are that. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-import-json")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s 1;
    $err:e 0
  }
};

f=q1(sql:str;id:str):str{
  <mt db.many(sql;@(id)) {
    $ok:rows firstcol(rows);
    $err:e ""
  }
};

f=firstcol(rows:@$dbrow):str{
  if(rows.len==0){ <"" }el{ <db.rowstr(rows.get(0);"v") }
};

f=exportfile():str{
  <str.concat(testdir();"/import.json")
};

(* Two memories, the second with a quote, a newline and a backslash in its content, which
   is what an assistant reply looks like. *)
f=writefixture():bool{
  let a="{\"id\":\"imp-1\",\"wing\":\"technical\",\"hall\":\"Code\",\"room\":\"general\",\"role\":\"user\",\"content\":\"first imported memory\",\"tags\":\"alpha,beta\",\"score\":0.75,\"created_at\":1790000000}";
  let b="{\"id\":\"imp-2\",\"wing\":\"personal\",\"hall\":\"Notes\",\"room\":\"misc\",\"role\":\"assistant\",\"content\":\"he said \\\"hi\\\"\\nthen C:\\\\tmp\",\"tags\":\"\",\"score\":1.0,\"created_at\":1790086400}";
  let body=str.concat("[\n  ";str.concat(a;str.concat(",\n  ";str.concat(b;"\n]"))));
  <mt file.write(exportfile();body) {
    $ok:v true;
    $err:e false
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let opened=openfreshstore();
  if(t.assert(opened==1;"the store opened on a fresh file and its migrations ran")){pass=pass+1}el{fail=fail+1};
  if(t.assert(writefixture();"the fixture file was written")){pass=pass+1}el{fail=fail+1};

  let n=ex.importjson(0;exportfile());
  if(t.assert(n==2;"importjson reports two memories imported")){pass=pass+1}el{fail=fail+1};

  (* ── The defect: every field read through a row accessor came back empty ───── *)
  if(t.asserteq(q1("SELECT wing AS v FROM memory_drawers WHERE id=?";"imp-1");"technical";"imp-1 is stored under its id with its wing (LS1.1k)")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT hall AS v FROM memory_drawers WHERE id=?";"imp-1");"Code";"and its hall")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT room AS v FROM memory_drawers WHERE id=?";"imp-1");"general";"and its room")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT role AS v FROM memory_drawers WHERE id=?";"imp-1");"user";"and its role")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT content AS v FROM memory_drawers WHERE id=?";"imp-1");"first imported memory";"and its content")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT content AS v FROM memory_drawers WHERE id=?";"imp-2");"he said \"hi\"\nthen C:\\tmp";"escaped content is unescaped on the way in: quote, newline and backslash")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT tags AS v FROM memory_scores WHERE id=?";"imp-1");"alpha,beta";"the score row carries the tags")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT CAST(score*100 AS INTEGER) AS v FROM memory_scores WHERE id=?";"imp-1");"75";"and the score")){pass=pass+1}el{fail=fail+1};

  (* ── M1.7c: the memory's age comes from the file, not from the import ───────── *)
  if(t.asserteq(q1("SELECT created_at AS v FROM memory_scores WHERE id=?";"imp-1");"1790000000";"the score's created_at is the exported one, so decay ages the memory from when it was made")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT created_at AS v FROM memory_scores WHERE id=?";"imp-2");"1790086400";"for every imported memory")){pass=pass+1}el{fail=fail+1};

  (* Importing the same file again adds nothing: ids are the identity. *)
  let again=ex.importjson(0;exportfile());
  if(t.assert(again==0;"a second import of the same file imports nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.countquery("SELECT id FROM memory_drawers";@())==2;"and the store still holds exactly two drawers")){pass=pass+1}el{fail=fail+1};

  (* ── M1.7f: sensitivity and the PII flag survive an import ─────────────────────
     A RESTRICTED memory used to come back PUBLIC and unflagged, so "forget my personal
     data" (privacy.forgetpii, WHERE pii_flagged=1) could not find it. imp-1 and imp-2 above
     carry no sensitivity, as every export written before this did, and must not be trusted
     as PUBLIC. *)
  if(t.asserteq(q1("SELECT sensitivity AS v FROM memory_drawers WHERE id=?";"imp-1");"CONFIDENTIAL";"a memory exported without a sensitivity is imported as CONFIDENTIAL, not PUBLIC")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT CAST(pii_flagged AS TEXT) AS v FROM memory_scores WHERE id=?";"imp-1");"1";"and flagged, so forgetpii finds it")){pass=pass+1}el{fail=fail+1};
  let f2=str.concat(testdir();"/import2.json");
  let r="{\"id\":\"imp-r\",\"wing\":\"personal\",\"hall\":\"Health\",\"room\":\"misc\",\"role\":\"user\",\"content\":\"restricted memory\",\"tags\":\"\",\"score\":1.0,\"created_at\":1790000000,\"sensitivity\":\"RESTRICTED\"}";
  let u="{\"id\":\"imp-p\",\"wing\":\"technical\",\"hall\":\"Code\",\"room\":\"misc\",\"role\":\"user\",\"content\":\"public memory\",\"tags\":\"\",\"score\":1.0,\"created_at\":1790000000,\"sensitivity\":\"PUBLIC\"}";
  let written=mt file.write(f2;"[\(r),\(u)]") {$ok:v true; $err:e false};
  if(t.assert(written;"the second fixture was written")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ex.importjson(0;f2)==2;"both sensitivity fixtures import")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT sensitivity AS v FROM memory_drawers WHERE id=?";"imp-r");"RESTRICTED";"a RESTRICTED memory comes back RESTRICTED")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT CAST(pii_flagged AS TEXT) AS v FROM memory_scores WHERE id=?";"imp-r");"1";"and flagged")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT sensitivity AS v FROM memory_drawers WHERE id=?";"imp-p");"PUBLIC";"a PUBLIC memory stays PUBLIC")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(q1("SELECT CAST(pii_flagged AS TEXT) AS v FROM memory_scores WHERE id=?";"imp-p");"0";"and unflagged")){pass=pass+1}el{fail=fail+1};

  (* ── M1.7e: exports read created_at as a time, whichever way it was stored ───────
     Drawers written by storedrawer and importjson hold epoch seconds; older ones hold
     datetime TEXT. The export read TEXT with strtoll (every drawer said 2026) and the range
     filter compared TEXT with digits. imp-1, imp-r and imp-p are at 1790000000; old-t is
     TEXT for 2026-09-20 00:00:00 UTC, epoch 1789862400. *)
  let seeded=mt db.exec("INSERT INTO memory_drawers (id,wing,hall,room,role,content,created_at) VALUES ('old-t','w','h','r','user','legacy text-dated memory','2026-09-20 00:00:00')";@()) {$ok:v true; $err:e false};
  if(t.assert(seeded;"a legacy TEXT-dated drawer is seeded")){pass=pass+1}el{fail=fail+1};
  let jsonfmt=$exportformat{$jsonval:0};
  let around=ex.exportrange(0;1789999000;1790001000;str.concat(testdir();"/range1.json");jsonfmt;0);
  if(t.assert(around.count==3 as i32;"a window around 1790000000 exports exactly the three drawers made then")){pass=pass+1}el{fail=fail+1};
  let textday=ex.exportrange(0;1789862000;1789863000;str.concat(testdir();"/range2.json");jsonfmt;0);
  if(t.assert(textday.count==1 as i32;"and a window around the TEXT-dated drawer finds it, as a time")){pass=pass+1}el{fail=fail+1};
  let everything=ex.exportall(0;str.concat(testdir();"/all.json");jsonfmt;0);
  if(t.assert(everything.count==5 as i32;"exportall exports all five drawers")){pass=pass+1}el{fail=fail+1};
  let alltext=mt file.read(str.concat(testdir();"/all.json")) {$ok:v v; $err:e ""};
  if(t.assert(str.contains(alltext;"\"created_at\":1789862400");"the TEXT-dated drawer is exported as epoch seconds, not as its year")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(alltext;"\"created_at\":2026}");"no drawer is exported as the bare year")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(alltext;"\"sensitivity\":\"RESTRICTED\"");"and the export carries each memory's sensitivity (M1.7f)")){pass=pass+1}el{fail=fail+1};

  <fail
};

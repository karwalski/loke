m=tests.unit.memory.testsearch;

i=enrich:loke.memory.enrichment;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let cfg = enrich.defaultconfig();
  results = str.arraypush(results;asserttrue("default_config enabled";cfg.enabled));

  results = str.arraypush(results;asserttrue("default_config max_memories is 5";cfg.maxmemories = 5));

  results = str.arraypush(results;asserttrue("default_config token_budget is 2000";cfg.tokenbudget = 2000));

  results = str.arraypush(results;asserttrue("default_config relevance_threshold is 0.75";cfg.relevancethreshold = 0.75));

  results = str.arraypush(results;asserttrue("default_config anonymise_for_cloud";cfg.anonymiseforcloud));

  let shortprompt = "What is the weather?";
  let shortquery = enrich.buildsearchquery(shortprompt);
  results = str.arraypush(results;asserteq("short prompt returns full text";shortquery;shortprompt));

  let longprompt = "This is a very long prompt that exceeds one hundred characters in length and should be truncated by the build_search_query function to exactly 100 characters";
  let longquery = enrich.buildsearchquery(longprompt);
  let querylen = str.len(longquery);
  results = str.arraypush(results;asserttrue("long prompt truncated to 100 chars";querylen = 100));

  let exact100 = "1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890";
  let exactquery = enrich.buildsearchquery(exact100);
  results = str.arraypush(results;asserteq("exact 100 chars returns full text";exactquery;exact100));

  let emptyquery = enrich.buildsearchquery("");
  results = str.arraypush(results;asserteq("empty prompt returns empty";emptyquery;""));

  let custom = $enrichmentconfig{
    enabled:false;
    maxmemories:10;
    tokenbudget:4000;
    relevancethreshold:0.5;
    anonymiseforcloud:false
  };
  results = str.arraypush(results;assertfalse("custom config not enabled";custom.enabled));
  results = str.arraypush(results;asserttrue("custom max_memories is 10";custom.maxmemories = 10));
  results = str.arraypush(results;assertfalse("custom anonymise_for_cloud false";custom.anonymiseforcloud));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i + 1 }el{ let all = false; i = i + 1 }
    }
  };
  <all
};

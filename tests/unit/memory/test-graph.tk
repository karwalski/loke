
m=tests.unit.memory.testgraphkg;

i=kg:loke.memory.knowledgegraph;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let g = kg.newgraph();
  results = str.arraypush(results;asserttrue("new_graph nodes empty";g.nodes.len() = 0));
  results = str.arraypush(results;asserttrue("new_graph relations empty";g.relations.len() = 0));

  let g1 = kg.addnode(g;"n1";"Alice";"person");
  results = str.arraypush(results;asserttrue("add_node increases count to 1";g1.nodes.len() = 1));

  let g2 = kg.addnode(g1;"n2";"Bob";"person");
  results = str.arraypush(results;asserttrue("add second node count is 2";g2.nodes.len() = 2));

  let node = g1.nodes.get(0);
  results = str.arraypush(results;asserteq("node id stored";node.id;"n1"));
  results = str.arraypush(results;asserteq("node label stored";node.label;"Alice"));
  results = str.arraypush(results;asserteq("node entity_type stored";node.entitytype;"person"));

  let customnode = kg.$entitynode{
    id:"n3";
    label:"Project X";
    entitytype:"project";
    properties:@("active";"priority:high")
  };
  results = str.arraypush(results;asserteq("entity_node id";customnode.id;"n3"));
  results = str.arraypush(results;asserttrue("entity_node properties has 2 items";customnode.properties.len() = 2));

  let rel = kg.$relation{
    id:"r1";
    fromid:"n1";
    toid:"n2";
    relationtype:"works_with";
    validfrom:1700000000;
    validto:0;
    source:"test";
    confidence:0.95
  };
  results = str.arraypush(results;asserteq("relation from_id";rel.fromid;"n1"));
  results = str.arraypush(results;asserteq("relation to_id";rel.toid;"n2"));
  results = str.arraypush(results;asserteq("relation relation_type";rel.relationtype;"works_with"));
  results = str.arraypush(results;asserttrue("relation confidence > 0.9";rel.confidence > 0.9));

  let query = kg.$factquery{
    subject:"Alice";
    predicate:"works_with";
    asof:1700000000
  };
  results = str.arraypush(results;asserteq("fact_query subject";query.subject;"Alice"));
  results = str.arraypush(results;asserteq("fact_query predicate";query.predicate;"works_with"));
  results = str.arraypush(results;asserttrue("fact_query as_of is set";query.asof > 0));

  results = str.arraypush(results;asserttrue("open-ended relation valid_to is 0";rel.validto = 0));

  let boundedrel = kg.$relation{
    id:"r2";fromid:"n1";toid:"n2";relationtype:"managed";
    validfrom:1700000000;validto:1700100000;source:"test";confidence:0.8
  };
  results = str.arraypush(results;asserttrue("bounded relation has valid_to > valid_from";boundedrel.validto > boundedrel.validfrom));

  let fullgraph = kg.$knowledgegraph{
    nodes:@$customnode;
    relations:@$rel
  };
  results = str.arraypush(results;asserttrue("full graph has 1 node";fullgraph.nodes.len() = 1));
  results = str.arraypush(results;asserttrue("full graph has 1 relation";fullgraph.relations.len() = 1));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};

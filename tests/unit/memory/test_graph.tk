


m=tests.unit.memory.testgraph;

i=graph:core.memory.graph;
i=memtypes:core.memory.types;
i=palace:core.memory.palace;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(n) }else{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:str;v:bool):$result{
  if(v{ <pass(n) }else{ <fail(n;"expected true") };
};

f=assertfalse(n:str;v:bool):$result{
  if(!$v{ <pass(n) }else{ <fail(n;"expected false") };
};

f=assertintgt(n:str;got:i32;min:i32):$result{
  if(got > min{ <pass(n) }else{
    <fail(n;str.concat("expected > ";str.concat(str.fromint(min);str.concat(" got ";str.fromint(got)))))
  };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  let tmpdir = "/tmp/loke_test_graph";
  let openresult = palace.open(tmpdir);
  let opened = mt openresult { $ok: { true }; $err: { false } };
  results = str.arraypush(results;asserttrue("palace opens for graph tests";opened));

  if(opened{
    let p = mt openresult { $ok:p { p }; $err: { $palace{conn:$dbconn{};datadir:""} } };

    
    let enta = $graph.entity{
      id:"node-a";
      name:"Alice";
      kind:"person";
      summary:"Senior engineer";
      confidence:0.9;
      createdat:1700000000
    };
    let upsertok = graph.upsertentity(p;enta);
    results = str.arraypush(results;asserttrue("upsert_entity returns true";upsertok));

    
    let entb = $graph.entity{
      id:"node-b";
      name:"Bob";
      kind:"person";
      summary:"Product manager";
      confidence:0.85;
      createdat:1700000100
    };
    let upsertbok = graph.upsertentity(p;entb);
    results = str.arraypush(results;asserttrue("upsert_entity second node returns true";upsertbok));

    
    let rel = $graph.relation{
      fromid:"node-a";
      toid:"node-b";
      kind:"works_with";
      weight:0.7;
      createdat:1700000200
    };
    let relok = graph.addrelation(p;rel);
    results = str.arraypush(results;asserttrue("add_relation returns true";relok));

    
    let nb = graph.neighbours(p;"node-a";1);
    let entitiescount = str.arraylen(nb.entities);
    results = str.arraypush(results;asserttrue("neighbours depth 1 returns at least 1 entity";entitiescount >= 1));

    
    let relationscount = str.arraylen(nb.relations);
    results = str.arraypush(results;asserttrue("neighbours depth 1 returns at least 1 relation";relationscount >= 1));

    
    let searchresults = graph.searchentities(p;"Alice");
    let searchcount = str.arraylen(searchresults);
    results = str.arraypush(results;asserttrue("search_entities finds Alice";searchcount >= 1));

    
    let emptyresults = graph.searchentities(p;"xyznotfound");
    let emptycount = str.arraylen(emptyresults);
    results = str.arraypush(results;asserttrue("search_entities returns empty for unknown query";emptycount == 0));

    
    let delok = graph.deleteentity(p;"node-a");
    results = str.arraypush(results;asserttrue("delete_entity returns true";delok));

    
    let afterdel = graph.searchentities(p;"Alice");
    let afterdelcount = str.arraylen(afterdel);
    results = str.arraypush(results;asserttrue("search_entities returns empty after deletion";afterdelcount == 0));

    
    let nbdel = graph.neighbours(p;"node-a";1);
    let nbdelentities = str.arraylen(nbdel.entities);
    results = str.arraypush(results;asserttrue("neighbours on deleted entity returns zero entities";nbdelentities == 0))
  }else{};

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n{ break }else{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all = false }else{};
      i = i + 1
    };
  };
  <all
};

m=test.models.ollamaoffline;

i=t:std.test;
i=ollama:core.models.ollama;
i=reach:shared.reachability;

(* With nothing listening, http.get returns $ok carrying a nil response (T-15). Against
   that, healthcheck answered 1, "running", and callers read the integer as an
   $ollamastatus. listmodels parsed the nil body and crashed the process, and that crash
   killed the /installer page's worker on every request. The port comes from
   shared.reachability.deadport(), probed at run time (X8.12): the fixed 47719 used before is
   inside Linux's ephemeral range (32768-60999), so any program could have been handed it, as
   an editor's language server was handed 59996 on a developer Mac. *)

f=isunreachable(s:$ollamastatus):bool{
  <mt s {
    $running:v false;
    $stopped:v false;
    $unreachable:v true
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let client=ollama.new(reach.deadurl());

  let st:$ollamastatus=ollama.healthcheck(client);
  if(t.assert(isunreachable(st);"with nothing listening, healthcheck reports UNREACHABLE, not running")){pass=pass+1}el{fail=fail+1};

  let models=mt ollama.listmodels(client) {$ok:v v; $err:e @()};
  if(t.assert(models.len==0;"listmodels returns an empty list instead of crashing the process")){pass=pass+1}el{fail=fail+1};

  let running=mt ollama.listrunning(client) {$ok:v v; $err:e @()};
  if(t.assert(running.len==0;"and so does listrunning")){pass=pass+1}el{fail=fail+1};

  <fail
};

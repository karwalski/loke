m=tests.unit.models.testtiers;

i=tiers:models.tiers;
i=hw:models.hardware;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let interactivelabel=tiers.tierlabel(tiers.$$interactive);
  results=str.arraypush(results;asserteq("tier_label interactive";interactivelabel;"Interactive (instant)"));

  let consideredlabel=tiers.tierlabel(tiers.$$considered);
  results=str.arraypush(results;asserteq("tier_label considered";consideredlabel;"Considered (~30s)"));

  let backgroundlabel=tiers.tierlabel(tiers.$$background);
  results=str.arraypush(results;asserteq("tier_label background";backgroundlabel;"Background (minutes)"));

  let interactivecfg=tiers.configfortier(tiers.$$interactive);
  results=str.arraypush(results;assertinteq("interactive num_gpu_layers";interactivecfg.numgpulayers;-1));

  results=str.arraypush(results;asserttrue("interactive use_mlock";interactivecfg.usemlock));

  results=str.arraypush(results;assertfalse("interactive use_mmap false";interactivecfg.usemmap));

  results=str.arraypush(results;asserttrue("interactive ctx_size 4096";interactivecfg.ctxsize = 4096));

  let consideredcfg=tiers.configfortier(tiers.$$considered);
  results=str.arraypush(results;assertinteq("considered num_gpu_layers";consideredcfg.numgpulayers;20));

  results=str.arraypush(results;asserttrue("considered use_mmap true";consideredcfg.usemmap));

  results=str.arraypush(results;asserttrue("considered ctx_size 8192";consideredcfg.ctxsize = 8192));

  let backgroundcfg=tiers.configfortier(tiers.$$background);
  results=str.arraypush(results;assertinteq("background num_gpu_layers";backgroundcfg.numgpulayers;4));

  results=str.arraypush(results;asserttrue("background ctx_size 32768";backgroundcfg.ctxsize = 32768));

  let ollamajson=tiers.applytoollamaopts(interactivecfg);
  results=str.arraypush(results;asserttrue("apply_to_ollama_opts non-empty";str.len(ollamajson) > 0));

  results=str.arraypush(results;asserttrue("ollama opts contains num_gpu";str.contains(ollamajson;"num_gpu")));

  results=str.arraypush(results;asserttrue("ollama opts contains use_mlock";str.contains(ollamajson;"use_mlock")));

  results=str.arraypush(results;asserttrue("ollama opts contains num_ctx";str.contains(ollamajson;"num_ctx")));

  let q4sizegb=3.5;
  let fp16sizegb=14.0;
  results=str.arraypush(results;asserttrue("Q4 7B model size < 8 GB";q4sizegb < 8.0));

  results=str.arraypush(results;asserttrue("FP16 > Q4 for 7B";fp16sizegb > q4sizegb));

  let bigmachine=hw.$hardwareprofile{
    ramgb:64.0;
    gpuvramgb:0.0;
    unifiedmemorygb:64.0;
    disktype:hw.$$nvme;
    diskreadmbs:3000.0;
    cpucores:12;
    platform:"darwin"
  };
  let viabilityq4=hw.estimatetierviability(bigmachine;q4sizegb);
  results=str.arraypush(results;asserttrue("64GB machine interactive for 3.5GB model";viabilityq4.interactive));

  let smallmachine=hw.$hardwareprofile{
    ramgb:4.0;
    gpuvramgb:0.0;
    unifiedmemorygb:0.0;
    disktype:hw.$$nvme;
    diskreadmbs:2000.0;
    cpucores:4;
    platform:"linux"
  };
  let viabilityfp16small=hw.estimatetierviability(smallmachine;fp16sizegb);
  results=str.arraypush(results;assertfalse("4GB machine not interactive for 14GB model";viabilityfp16small.interactive));

  let sel=tiers.selecttier(tiers.$$instant;bigmachine;q4sizegb;"test-model");
  results=str.arraypush(results;asserttrue("select_tier instant on capable machine is interactive";
    mt sel.tier { $interactive:v true; $considered:v false; $background:v false }
  ));

  results=str.arraypush(results;asserttrue("select_tier reason non-empty";str.len(sel.reason) > 0));

  let selbg=tiers.selecttier(tiers.$$background;smallmachine;fp16sizegb;"big-model");
  results=str.arraypush(results;asserttrue("select_tier background tolerance is background";
    mt selbg.tier { $interactive:v false; $considered:v false; $background:v true }
  ));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i+1 }el{ let all = false; i = i+1 }
    }
  };
  <all
};

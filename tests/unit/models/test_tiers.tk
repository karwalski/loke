m=test.models.tiers;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=tiers:core.models.tiers;

(* This file declared its own $modeltier as {kind:str} and its own configfortier,
   tierlabel and priorityrank, each taking a str and then matching $interactive /
   $considered / $background arms against it. The real $modeltier is a sum, and the
   real functions take it — so the copy and the module had diverged in their most
   basic type and the test could not have noticed.

   priorityrank is not in core.models.tiers at all; shared.types.tierrank is the
   ordering, and it is what the last two assertions check. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let interactive=$modeltier{$interactive:0};
  let considered=$modeltier{$considered:0};
  let background=$modeltier{$background:0};

  let ic=tiers.configfortier(interactive);
  if(t.assert(ic.numgpulayers==(0-1) as i32;"interactive offloads every layer to the GPU")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ic.usemmap;"interactive does not mmap")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ic.usemlock;"interactive locks the model in memory")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ic.ctxsize==4096 as u32;"interactive context is 4096")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ic.batchsize==512 as u32;"interactive batch is 512")){pass=pass+1}el{fail=fail+1};

  let cc=tiers.configfortier(considered);
  if(t.assert(cc.numgpulayers==20 as i32;"considered offloads twenty layers")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cc.ctxsize==8192 as u32;"considered context is 8192")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cc.usemmap;"considered mmaps")){pass=pass+1}el{fail=fail+1};

  let bc=tiers.configfortier(background);
  if(t.assert(bc.numgpulayers==4 as i32;"background offloads four layers")){pass=pass+1}el{fail=fail+1};
  if(t.assert(bc.ctxsize==32768 as u32;"background context is 32768")){pass=pass+1}el{fail=fail+1};
  if(t.assert(bc.batchsize==64 as u32;"background batch is 64")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(tiers.tierlabel(interactive);"Interactive (instant)";"interactive label")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tiers.tierlabel(considered);"Considered (~30s)";"considered label")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(tiers.tierlabel(background);"Background (minutes)";"background label")){pass=pass+1}el{fail=fail+1};

  (* The ordering the scheduler depends on: sooner tiers rank lower. *)
  if(t.assert(sh.tierrank(interactive)<sh.tierrank(considered);"interactive ranks before considered")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sh.tierrank(considered)<sh.tierrank(background);"considered ranks before background")){pass=pass+1}el{fail=fail+1};

  (* Each tier is distinguishable from the others — tierrank is a total order, not a
     constant. A sum compared with == is unreliable across a function boundary
     (T-14), which is why this goes through the rank. *)
  if(t.assert(!sh.tiereq(interactive;background);"interactive and background are different tiers")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=tests.unit.models.testtiers;
i=t:std.test;
i=str:std.str;

t=$modeltier{kind:str};

t=$tierconfig{
  tier:str;
  numgpulayers:i32;
  usemmap:bool;
  usemlock:bool;
  ctxsize:i64;
  batchsize:i64
};

f=configfortier(tier:str):$tierconfig{
  <mt tier {
    $interactive:v $tierconfig{
        tier:"interactive";
        numgpulayers:-1;
        usemmap:false;
        usemlock:true;
        ctxsize:4096;
        batchsize:512
      };
    $considered:v $tierconfig{
        tier:"considered";
        numgpulayers:20;
        usemmap:true;
        usemlock:false;
        ctxsize:8192;
        batchsize:256
      };
    $background:v $tierconfig{
        tier:"background";
        numgpulayers:4;
        usemmap:true;
        usemlock:false;
        ctxsize:32768;
        batchsize:64
      }
  }
};

f=tierlabel(tier:str):str{
  mt tier {
    $interactive:v "Interactive (instant)";
    $considered:v "Considered (~30s)";
    $background:v "Background (minutes)"
  }
};

f=priorityrank(tier:str):i64{
  mt tier {
    $interactive:v 0;
    $considered:v 1;
    $background:v 2
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let ic=configfortier("interactive");
  t.assert(ic.numgpulayers=-1;"interactive gpu layers is -1");
  pass=pass+1;

  t.assert(ic.usemmap=false;"interactive mmap is false");
  pass=pass+1;

  t.assert(ic.usemlock=true;"interactive mlock is true");
  pass=pass+1;

  t.assert(ic.ctxsize=4096;"interactive ctx size is 4096");
  pass=pass+1;

  t.assert(ic.batchsize=512;"interactive batch size is 512");
  pass=pass+1;

  let cc=configfortier("considered");
  t.assert(cc.numgpulayers=20;"considered gpu layers is 20");
  pass=pass+1;

  t.assert(cc.ctxsize=8192;"considered ctx size is 8192");
  pass=pass+1;

  t.assert(cc.usemmap=true;"considered mmap is true");
  pass=pass+1;

  let bc=configfortier("background");
  t.assert(bc.numgpulayers=4;"background gpu layers is 4");
  pass=pass+1;

  t.assert(bc.ctxsize=32768;"background ctx size is 32768");
  pass=pass+1;

  t.assert(bc.batchsize=64;"background batch size is 64");
  pass=pass+1;

  let lbl1=tierlabel("interactive");
  t.asserteq(lbl1;"Interactive (instant)";"interactive label correct");
  pass=pass+1;

  let lbl2=tierlabel("considered");
  t.asserteq(lbl2;"Considered (~30s)";"considered label correct");
  pass=pass+1;

  let lbl3=tierlabel("background");
  t.asserteq(lbl3;"Background (minutes)";"background label correct");
  pass=pass+1;

  let r1=priorityrank("interactive");
  let r2=priorityrank("considered");
  let r3=priorityrank("background");
  t.assert(r1 < r2;"interactive rank < considered rank");
  pass=pass+1;

  t.assert(r2 < r3;"considered rank < background rank");
  pass=pass+1;

  <fail
};

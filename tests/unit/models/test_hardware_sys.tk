m=tests.unit.models.testhardwaresys;

i=hw:core.hardware.profile;
i=str:std.string;
i=log:std.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;val:bool):$result{
  if(val){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;val:bool):$result{
  if(val){ <fail(n;"expected false") }el{ <pass(n) }
};

f=asserteqi32(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromi32(want);str.concat(" got=";str.fromi32(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=testdetect():$result{
  let p=hw.detect();
  let r1=asserttrue("detect.ram_gb > 0";p.ramgb > 0);
  if(r1.passed){ i=i }el{ <r1 };
  let r2=asserttrue("detect.cpu_cores > 0";p.cpucores > 0);
  if(r2.passed){ i=i }el{ <r2 };
  let r3=asserttrue("detect.platform.len > 0";str.len(p.platform) > 0);
  if(r3.passed){ i=i }el{ <r3 };
  <asserttrue("detect.gpu_name.len > 0";str.len(p.gpuname) > 0)
};

f=testdetectplatform():$result{
  let p=hw.detect();
  if(str.eq(p.platform;"macos")){
    <pass("detect.platform")
  }el{
    if(str.eq(p.platform;"windows")){
      <pass("detect.platform")
    }el{
      if(str.eq(p.platform;"linux")){
        <pass("detect.platform")
      }el{
        if(str.eq(p.platform;"unknown")){
          <pass("detect.platform")
        }el{
          <fail("detect.platform";str.concat("unexpected platform: ";p.platform))
        }
      }
    }
  }
};

f=testtotalmemoryunified():$result{
  let p=$hardwareprofile{
    ramgb:32;
    vramgb:0;
    unifiedmemorygb:32;
    cpucores:10;
    gpuname:"Apple M2 Max";
    disktype:"nvme";
    diskspeedmbs:5000;
    platform:"macos"
  };
  <asserteqi32("total_memory.unified";hw.totalmemorygb(p);32)
};

f=testtotalmemorydiscrete():$result{
  let p=$hardwareprofile{
    ramgb:64;
    vramgb:24;
    unifiedmemorygb:0;
    cpucores:16;
    gpuname:"NVIDIA RTX 4090";
    disktype:"nvme";
    diskspeedmbs:7000;
    platform:"linux"
  };
  <asserteqi32("total_memory.discrete";hw.totalmemorygb(p);88)
};

f=testtojson():$result{
  let p=$hardwareprofile{
    ramgb:16;
    vramgb:0;
    unifiedmemorygb:16;
    cpucores:8;
    gpuname:"Apple M1";
    disktype:"nvme";
    diskspeedmbs:3000;
    platform:"macos"
  };
  let jsonstr=hw.tojson(p);
  let r1=asserttrue("to_json.ram_gb";str.contains(jsonstr;"\"ram_gb\":16"));
  if(r1.passed){ i=i }el{ <r1 };
  let r2=asserttrue("to_json.cpu_cores";str.contains(jsonstr;"\"cpu_cores\":8"));
  if(r2.passed){ i=i }el{ <r2 };
  let r3=asserttrue("to_json.platform";str.contains(jsonstr;"macos"));
  if(r3.passed){ i=i }el{ <r3 };
  <asserttrue("to_json.gpu_name";str.contains(jsonstr;"Apple M1"))
};

f=testsummary():$result{
  let p=$hardwareprofile{
    ramgb:16;
    vramgb:0;
    unifiedmemorygb:16;
    cpucores:8;
    gpuname:"Apple M1";
    disktype:"nvme";
    diskspeedmbs:3000;
    platform:"macos"
  };
  let s=hw.summary(p);
  let r1=asserttrue("summary.unified";str.contains(s;"GB unified"));
  if(r1.passed){ i=i }el{ <r1 };
  let r2=asserttrue("summary.cpu";str.contains(s;"8-core CPU"));
  if(r2.passed){ i=i }el{ <r2 };
  let r3=asserttrue("summary.nvme";str.contains(s;"NVMe"));
  if(r3.passed){ i=i }el{ <r3 };
  <asserttrue("summary.platform";str.contains(s;"macos"))
};

f=testsummarydiscrete():$result{
  let p=$hardwareprofile{
    ramgb:64;
    vramgb:24;
    unifiedmemorygb:0;
    cpucores:16;
    gpuname:"NVIDIA RTX 4090";
    disktype:"ssd";
    diskspeedmbs:550;
    platform:"linux"
  };
  let s=hw.summary(p);
  let r1=asserttrue("summary_discrete.ram";str.contains(s;"GB RAM"));
  if(r1.passed){ i=i }el{ <r1 };
  <asserttrue("summary_discrete.ssd";str.contains(s;"SSD"))
};

f=testconfigdir():$result{
  let dir=hw.configdir();
  if(str.len(dir) > 0){
    <pass("config_dir.non_empty")
  }el{
    <fail("config_dir.non_empty";"expected non-empty config dir")
  }
};

f=testdatadir():$result{
  let dir=hw.datadir();
  if(str.len(dir) > 0){
    <pass("data_dir.non_empty")
  }el{
    <fail("data_dir.non_empty";"expected non-empty data dir")
  }
};

f=runall():i64{
  let results=@($result);
  results=str.arraypush(results;testdetect());
  results=str.arraypush(results;testdetectplatform());
  results=str.arraypush(results;testtotalmemoryunified());
  results=str.arraypush(results;testtotalmemorydiscrete());
  results=str.arraypush(results;testtojson());
  results=str.arraypush(results;testsummary());
  results=str.arraypush(results;testsummarydiscrete());
  results=str.arraypush(results;testconfigdir());
  results=str.arraypush(results;testdatadir());
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <0 }el{
      let r=str.arrayget(results;i);
      logresult(r);
      i=i+1
    }
  };
  <0
};

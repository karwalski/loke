m=test.models.registry;

i=t:std.test;
i=str:std.str;

(* --- stub model registry functions --- *)

(* model tiers *)
f=tier_local():i64{ <0 };
f=tier_cloud():i64{ <1 };
f=tier_premium():i64{ <2 };

(* register a model — returns 1 on success, 0 on invalid *)
f=register_model(name:str;provider:str;tier:i64):i64{
  if(str.len(name)=0){<0};
  if(str.len(provider)=0){<0};
  if(tier<0){<0};
  if(tier>2){<0};
  <1
};

(* find model by name — returns provider or empty *)
f=find_model(name:str):str{
  if(str.eq(name;"llama3")){<"ollama"};
  if(str.eq(name;"gpt-4o")){<"openai"};
  if(str.eq(name;"claude-sonnet")){<"anthropic"};
  if(str.eq(name;"mistral-7b")){<"ollama"};
  <""
};

(* find models by capability — returns count of matching models *)
f=find_by_capability(capability:str):i64{
  if(str.eq(capability;"code")){<3};
  if(str.eq(capability;"chat")){<4};
  if(str.eq(capability;"vision")){<2};
  if(str.eq(capability;"embedding")){<1};
  <0
};

(* get model tier *)
f=get_tier(name:str):i64{
  if(str.eq(name;"llama3")){<tier_local()};
  if(str.eq(name;"mistral-7b")){<tier_local()};
  if(str.eq(name;"gpt-4o")){<tier_cloud()};
  if(str.eq(name;"claude-sonnet")){<tier_premium()};
  <0-1
};

(* count registered models *)
f=model_count():i64{ <4 };

(* check if model is local *)
f=is_local(name:str):i64{
  if(get_tier(name)=tier_local()){<1};
  <0
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test register model *)
  if(t.assert(register_model("llama3";"ollama";0)=1;"register valid model succeeds")){pass=pass+1}el{fail=fail+1};

  if(t.assert(register_model("";"ollama";0)=0;"empty name rejected")){pass=pass+1}el{fail=fail+1};

  if(t.assert(register_model("llama3";"";0)=0;"empty provider rejected")){pass=pass+1}el{fail=fail+1};

  if(t.assert(register_model("llama3";"ollama";5)=0;"invalid tier rejected")){pass=pass+1}el{fail=fail+1};

  (* test find model by name *)
  if(t.assert(str.eq(find_model("llama3");"ollama");"llama3 is from ollama")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(find_model("gpt-4o");"openai");"gpt-4o is from openai")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(find_model("claude-sonnet");"anthropic");"claude-sonnet is from anthropic")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(find_model("nonexistent");"");"unknown model returns empty")){pass=pass+1}el{fail=fail+1};

  (* test find by capability *)
  if(t.assert(find_by_capability("code")=3;"3 models support code")){pass=pass+1}el{fail=fail+1};

  if(t.assert(find_by_capability("chat")=4;"4 models support chat")){pass=pass+1}el{fail=fail+1};

  if(t.assert(find_by_capability("vision")=2;"2 models support vision")){pass=pass+1}el{fail=fail+1};

  if(t.assert(find_by_capability("telekinesis")=0;"0 models support telekinesis")){pass=pass+1}el{fail=fail+1};

  (* test model tiers *)
  if(t.assert(get_tier("llama3")=tier_local();"llama3 is local tier")){pass=pass+1}el{fail=fail+1};

  if(t.assert(get_tier("gpt-4o")=tier_cloud();"gpt-4o is cloud tier")){pass=pass+1}el{fail=fail+1};

  if(t.assert(get_tier("claude-sonnet")=tier_premium();"claude-sonnet is premium tier")){pass=pass+1}el{fail=fail+1};

  (* test is_local *)
  if(t.assert(is_local("llama3")=1;"llama3 is local")){pass=pass+1}el{fail=fail+1};

  if(t.assert(is_local("gpt-4o")=0;"gpt-4o is not local")){pass=pass+1}el{fail=fail+1};

  (* test model count *)
  if(t.assert(model_count()=4;"4 models registered")){pass=pass+1}el{fail=fail+1};

  <fail
};

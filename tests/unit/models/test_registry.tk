m=tests.unit.models.testregistry;

i=reg:models.registry;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=assertinteq(n:str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let registry=reg.newregistry();
  results=str.arraypush(results;pass("new_registry does not crash"));

  results=str.arraypush(results;asserttrue("registry has entries";str.arraylen(registry.entries) > 0));

  results=str.arraypush(results;asserttrue("registry has at least 10 entries";str.arraylen(registry.entries) > 10));

  let sonnetresult=reg.byid(registry;"claude-3-5-sonnet-20241022");
  mt sonnetresult {
    $ok:m results=str.arraypush(results;asserteq("by_id sonnet model_id";m.modelid;"claude-3-5-sonnet-20241022"));
    $err:e results=str.arraypush(results;fail("by_id sonnet found";"expected ok, got error"))
  };

  let gpt4oresult=reg.byid(registry;"gpt-4o");
  mt gpt4oresult {
    $ok:m results=str.arraypush(results;asserteq("by_id gpt-4o model_id";m.modelid;"gpt-4o"));
    $err:e results=str.arraypush(results;fail("by_id gpt-4o found";"expected ok, got error"))
  };

  let qwenresult=reg.byid(registry;"qwen2.5:7b");
  mt qwenresult {
    $ok:m results=str.arraypush(results;asserttrue("qwen2.5:7b is local";m.local));
    $err:e results=str.arraypush(results;fail("by_id qwen2.5:7b found";"expected ok, got error"))
  };

  let unknownresult=reg.byid(registry;"this-model-does-not-exist-xyz");
  mt unknownresult {
    $ok:m results=str.arraypush(results;fail("by_id unknown returns err";"expected error, got ok"));
    $err:e results=str.arraypush(results;pass("by_id unknown returns error variant"))
  };

  let chatmodels=reg.findfortask(registry;reg.$$chat;false);
  results=str.arraypush(results;asserttrue("find_for_task chat non-empty";str.arraylen(chatmodels) > 0));

  let localmodels=reg.findfortask(registry;reg.$$chat;true);
  results=str.arraypush(results;asserttrue("find_for_task local only non-empty";str.arraylen(localmodels) > 0));
  let firstlocal=str.arrayget(localmodels;0);
  results=str.arraypush(results;asserttrue("find_for_task first local model is local";firstlocal.local));

  let bestresult=reg.findbest(registry;reg.$$chat;false;reg.$$background);
  mt bestresult {
    $ok:m results=str.arraypush(results;asserttrue("find_best chat background non-empty model_id";str.len(m.modelid) > 0));
    $err:e results=str.arraypush(results;fail("find_best chat background";"expected ok, got error"))
  };

  let embedresult=reg.findbest(registry;reg.$$embedding;true;reg.$$background);
  mt embedresult {
    $ok:m results=str.arraypush(results;asserttrue("find_best embedding local non-empty";str.len(m.modelid) > 0));
    $err:e results=str.arraypush(results;fail("find_best embedding local";"expected ok, got error"))
  };

  let beforecount=str.arraylen(registry.entries);
  let newentry=$modelcapability{
    modelid:"test-model-v1";
    provider:reg.$$local;
    task:reg.$$chat;
    qualityscore:0.50;
    speedtoks:100.0;
    contextwindow:4096;
    supportstools:false;
    local:true
  };
  reg.register(registry;newentry);
  let aftercount=str.arraylen(registry.entries);
  results=str.arraypush(results;asserttrue("register increases entry count";aftercount = beforecount + 1));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i+1 }el{ let all = false; i = i+1 }
    }
  };
  <all
};

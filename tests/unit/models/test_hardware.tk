m=test.models.hardware;

i=t:std.test;
i=str:std.str;
i=json:std.json;
i=hw:core.models.hardware;
i=process:std.process;

(* T7.3 — core.models.hardware, imported.

   detect() measures (F2.8a, 2026-09-26). It was a stub returning a literal Mac profile on
   every machine, and detectprofile() returned 0. It is checked here against an INDEPENDENT
   measurement: sysctl, run from this test, not std.sys again, so the test is not circular. *)

f=sysctlint(key:str):i64{
  let h=mt process.spawn(@("sysctl";"-n";key)) {
    $ok:h h;
    $err:e 0
  };
  if(h==0){ <0-1 }el{};
  let out=mt process.stdout(h) {$ok:s s; $err:e ""};
  process.wait(h);
  <mt str.toint(str.trim(out)) {$ok:n n; $err:e 0-1}
};

f=profile(ram:f64;vram:f64;unified:f64):$hardwareprofile{
  <$hardwareprofile{
    ramgb:ram;
    gpuvramgb:vram;
    unifiedmemorygb:unified;
    disktype:$disktype{$sata:0};
    diskreadmbs:500.0;
    cpucores:4 as u32;
    platform:"linux"
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── detect ─────────────────────────────────────────────────────────────── *)
  let d=hw.detect();
  if(t.assert(str.len(d.platform)>0;"detect returns a profile with a platform")){pass=pass+1}el{fail=fail+1};
  if(t.assert((d.cpucores as i64)>0;"a CPU core count")){pass=pass+1}el{fail=fail+1};
  if(t.assert(d.unifiedmemorygb>0.0 || d.ramgb>0.0;"and some memory")){pass=pass+1}el{fail=fail+1};
  let ncpu=sysctlint("hw.ncpu");
  if(t.assert(ncpu>0 && (d.cpucores as i64)==ncpu;"the core count is the machine's, as sysctl hw.ncpu reports it")){pass=pass+1}el{fail=fail+1};
  let mem=sysctlint("hw.memsize");
  if(t.assert(mem>0 && (d.ramgb as i64)==mem/1073741824;"and RAM is the machine's, in whole gigabytes of hw.memsize")){pass=pass+1}el{fail=fail+1};
  let dp=hw.detectprofile();
  if(t.assert(str.len(dp.platform)>0 && (dp.cpucores as i64)>0;"detectprofile returns a real profile, not 0")){pass=pass+1}el{fail=fail+1};

  (* ── totalmemorygb ──────────────────────────────────────────────────────────
     Its f64 RETURN is corrupted across a module boundary (T-20): measured here, 32.0 and 24.0
     arrive as other numbers. So it is read through summary(), which calls it inside the
     module and renders the figure as text. RAM, VRAM and unified are chosen so that each
     wrong rule gives a different number: unified 32 against ram+vram 12, and split 16+8=24
     against either operand alone. *)
  let su=hw.summary(profile(8.0;4.0;32.0));
  if(t.assert(str.contains(su;"32 GB unified");"with unified memory set, the total is the unified figure")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(su;"12");"and ram+vram is not used")){pass=pass+1}el{fail=fail+1};
  let ss=hw.summary(profile(16.0;8.0;0.0));
  if(t.assert(str.contains(ss;"24 GB RAM+VRAM");"with unified memory zero, the total is ram plus vram")){pass=pass+1}el{fail=fail+1};

  (* ── summary ────────────────────────────────────────────────────────────── *)
  if(t.assert(str.contains(su;"unified");"the summary of a unified-memory machine says unified")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(su;"RAM+VRAM");"and does not also describe it as split memory")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(su;"4-core CPU");"it names the core count")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(su;"SATA");"the disk type")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(su;"linux");"and the platform")){pass=pass+1}el{fail=fail+1};

  (* ── tojson ─────────────────────────────────────────────────────────────── *)
  (* A fixed profile, not detect(): these assertions pinned the stub's own literals (nvme, 8
     cores), so they would pass only on the fake. *)
  let js=hw.tojson(profile(16.0;0.0;0.0));
  if(t.assert(str.contains(js;"\"ram_gb\":");"tojson carries ram_gb")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"gpu_vram_gb\":");"gpu_vram_gb")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"unified_memory_gb\":");"unified_memory_gb")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"disk_type\":\"sata\"");"disk_type, as a quoted string")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"disk_read_mb_s\":");"disk_read_mb_s")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"cpu_cores\":4");"cpu_cores")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(js;"\"platform\":\"linux\"}");"and platform, closing the object")){pass=pass+1}el{fail=fail+1};
  let parsedok=mt json.dec(js) {
    $ok:v true;
    $err:e false
  };
  if(t.assert(parsedok;"and the whole of it parses as JSON")){pass=pass+1}el{fail=fail+1};

  <fail
};

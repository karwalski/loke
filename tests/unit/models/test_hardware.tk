



m=tests.unit.models.testhardware;

i=hw:models.hardware;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }else{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }else{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }else{ <fail(name;"expected false") };
};

f=assertinteq(name:str;got:i32;want:i32):$result{
  if(got == want){ <pass(name) }else{
    <fail(name;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};



f=totalmemorygb(p:hw.$hardwareprofile):f64{
  if(p.unifiedmemorygb > 0.0){
    <p.unifiedmemorygb
  }else{
    <p.ramgb + p.gpuvramgb
  };
};

f=logresult(r:$result){
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  
  let empty=hw.emptyprofile();
  results=str.arraypush(results;pass("empty_profile does not crash"));

  
  results=str.arraypush(results;asserttrue("empty_profile ram_gb zero";empty.ramgb == 0.0));

  
  results=str.arraypush(results;asserttrue("empty_profile gpu_vram_gb zero";empty.gpuvramgb == 0.0));

  
  results=str.arraypush(results;asserttrue("empty_profile unified_memory_gb zero";empty.unifiedmemorygb == 0.0));

  
  results=str.arraypush(results;asserttrue("empty_profile cpu_cores zero";empty.cpucores == 0));

  
  results=str.arraypush(results;asserteq("empty_profile platform empty";empty.platform;""));

  
  let unifiedprofile=hw.$hardwareprofile{
    ramgb:16.0;
    gpuvramgb:0.0;
    unifiedmemorygb:32.0;
    disktype:hw.$disktype.$nvme;
    diskreadmbs:3000.0;
    cpucores:8;
    platform:"darwin"
  };
  let totalunified=totalmemorygb(unifiedprofile);
  results=str.arraypush(results;asserttrue("total_memory uses unified when set";totalunified == 32.0));

  
  let discreteprofile=hw.$hardwareprofile{
    ramgb:32.0;
    gpuvramgb:8.0;
    unifiedmemorygb:0.0;
    disktype:hw.$disktype.$nvme;
    diskreadmbs:3500.0;
    cpucores:16;
    platform:"linux"
  };
  let totaldiscrete=totalmemorygb(discreteprofile);
  results=str.arraypush(results;asserttrue("total_memory sums ram+vram when unified=0";totaldiscrete == 40.0));

  
  let ramonly=hw.$hardwareprofile{
    ramgb:16.0;
    gpuvramgb:0.0;
    unifiedmemorygb:0.0;
    disktype:hw.$disktype.$sata;
    diskreadmbs:500.0;
    cpucores:4;
    platform:"windows"
  };
  let totalramonly=totalmemorygb(ramonly);
  results=str.arraypush(results;asserttrue("total_memory ram only is ram_gb";totalramonly == 16.0));

  
  let capable=hw.$hardwareprofile{
    ramgb:64.0;
    gpuvramgb:0.0;
    unifiedmemorygb:64.0;
    disktype:hw.$disktype.$nvme;
    diskreadmbs:3000.0;
    cpucores:12;
    platform:"darwin"
  };
  let viability=hw.estimatetierviability(capable;4.0);
  results=str.arraypush(results;asserttrue("capable machine interactive viable";viability.interactive));

  
  results=str.arraypush(results;asserttrue("capable machine considered viable";viability.considered));

  
  results=str.arraypush(results;asserttrue("capable nvme machine background viable";viability.background));

  
  let weak=hw.$hardwareprofile{
    ramgb:4.0;
    gpuvramgb:0.0;
    unifiedmemorygb:0.0;
    disktype:hw.$disktype.$sata;
    diskreadmbs:400.0;
    cpucores:2;
    platform:"linux"
  };
  let viabilityweak=hw.estimatetierviability(weak;14.0);
  results=str.arraypush(results;assertfalse("weak machine not interactive for large model";viabilityweak.interactive));

  
  results=str.arraypush(results;asserttrue("capable machine interactive_tok_s > 0";viability.interactivetoks > 0.0));

  
  results=str.arraypush(results;asserttrue("capable machine considered_tok_s > 0";viability.consideredtoks > 0.0));

  
  let nvmelowmem=hw.$hardwareprofile{
    ramgb:2.0;
    gpuvramgb:0.0;
    unifiedmemorygb:0.0;
    disktype:hw.$disktype.$nvme;
    diskreadmbs:3000.0;
    cpucores:2;
    platform:"linux"
  };
  let viabilitynvme=hw.estimatetierviability(nvmelowmem;14.0);
  results=str.arraypush(results;asserttrue("nvme disk always background viable";viabilitynvme.background));

  
  let dtnvme=hw.$disktype.$nvme;
  let dtsata=hw.$disktype.$sata;
  let dthdd=hw.$disktype.$hdd;
  let dtunknown=hw.$disktype.$unknown;
  results=str.arraypush(results;pass("disk_type variants construct without crash"));

  
  results=str.arraypush(results;asserteq("platform field stored";capable.platform;"darwin"));

  
  results=str.arraypush(results;asserttrue("cpu_cores field stored";capable.cpucores == 12));

  
  results=str.arraypush(results;asserttrue("disk_read_mb_s field stored";capable.diskreadmbs == 3000.0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }else{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }else{};
      i = i+1
    };
  };
  <all
};

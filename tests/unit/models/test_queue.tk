m=tests.unit.models.testqueue;
i=t:std.test;
i=str:std.str;

t=$jobstatus{kind:str};

t=$jobpriority{kind:str};

t=$queuejob{
  id:str;
  modelid:str;
  prompt:str;
  priority:str;
  status:str
};

t=$jobqueue{
  jobs:@$queuejob;
  maxconcurrent:i64
};

f=newqueue():$jobqueue{
  <$jobqueue{ jobs:@(); maxconcurrent:1 }
};

f=enqueue(queue:$jobqueue;id:str;modelid:str;prompt:str;priority:str):$jobqueue{
  let job=$queuejob{
    id:id;
    modelid:modelid;
    prompt:prompt;
    priority:priority;
    status:"pending"
  };
  <$jobqueue{ jobs:queue.jobs.push(job); maxconcurrent:queue.maxconcurrent }
};

f=priorityrank(p:str):i64{
  if(str.eq(p;"user")){ <0 }el{};
  if(str.eq(p;"agent")){ <1 }el{};
  <2
};

f=statuslabel(status:str):str{
  <status
};

f=prioritylabel(p:str):str{
  let label=mut."unknown";
  if(str.eq(p;"user")){ label="user" }el{};
  if(str.eq(p;"agent")){ label="agent" }el{};
  if(str.eq(p;"evaluation")){ label="eval" }el{};
  <label
};

f=nextpending(queue:$jobqueue):str{
  let bestid=mut."";
  let bestrank=mut.3 as u32;
  lp(let i=0;i<queue.jobs.len;i=i+1){
    let job=queue.jobs.get(i);
    let ispending=str.eq(job.status;"pending");
    if(ispending){
      let rank=priorityrank(job.priority);
      if(rank < bestrank){
        bestid=job.id;
        bestrank=rank
      }el{}
    }el{}
  };
  <bestid
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let queue=newqueue();
  t.assert(queue.jobs.len=0;"new queue is empty");
  pass=pass+1;

  let queue=enqueue(queue;"job-001";"llama3";"hello";"agent");
  t.assert(queue.jobs.len=1;"enqueue adds job");
  pass=pass+1;

  let job=queue.jobs.get(0);
  let ispending=str.eq(job.status;"pending");
  t.assert(ispending;"enqueued job status is pending");
  pass=pass+1;

  t.asserteq(job.modelid;"llama3";"enqueued job has correct model");
  pass=pass+1;

  let ru=priorityrank("user");
  let ra=priorityrank("agent");
  let re=priorityrank("evaluation");
  t.assert(ru < ra;"user priority rank < agent");
  pass=pass+1;

  t.assert(ra < re;"agent priority rank < evaluation");
  pass=pass+1;

  t.asserteq(statuslabel("pending");"pending";"pending label");
  pass=pass+1;

  t.asserteq(statuslabel("running");"running";"running label");
  pass=pass+1;

  t.asserteq(statuslabel("completed");"completed";"completed label");
  pass=pass+1;

  t.asserteq(statuslabel("failed");"failed";"failed label");
  pass=pass+1;

  t.asserteq(statuslabel("cancelled");"cancelled";"cancelled label");
  pass=pass+1;

  t.asserteq(prioritylabel("user");"user";"user priority label");
  pass=pass+1;

  t.asserteq(prioritylabel("evaluation");"eval";"eval priority label");
  pass=pass+1;

  let queue=enqueue(queue;"job-002";"gpt4";"think";"evaluation");
  let queue=enqueue(queue;"job-003";"llama3";"now";"user");
  let next=nextpending(queue);
  t.asserteq(next;"job-003";"next pending selects highest priority (user)");
  pass=pass+1;

  <fail
};

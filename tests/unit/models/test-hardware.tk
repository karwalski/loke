m=tests.unit.models.testhardwareextended;

i=hw:models.hardware;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(n:str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:str;msg:str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(n:str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") }
};

f=assertfalse(n:str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results = @($result);

  let winnvidia = $hardwareprofile{
    ramgb:32.0;gpuvramgb:24.0;unifiedmemorygb:0.0;
    disktype:hw.$$nvme;diskreadmbs:5000.0;
    cpucores:16;platform:"windows"
  };
  results = str.arraypush(results;asserteq("windows platform stored";winnvidia.platform;"windows"));
  results = str.arraypush(results;asserttrue("nvidia vram stored";winnvidia.gpuvramgb = 24.0));

  let linuxgpu = $hardwareprofile{
    ramgb:64.0;gpuvramgb:48.0;unifiedmemorygb:0.0;
    disktype:hw.$$nvme;diskreadmbs:7000.0;
    cpucores:32;platform:"linux"
  };
  let viability = hw.estimatetierviability(linuxgpu;14.0);
  results = str.arraypush(results;asserttrue("linux 48GB VRAM interactive viable";viability.interactive));
  results = str.arraypush(results;asserttrue("linux 48GB VRAM considered viable";viability.considered));
  results = str.arraypush(results;asserttrue("linux 48GB VRAM background viable";viability.background));

  let macm4 = $hardwareprofile{
    ramgb:128.0;gpuvramgb:0.0;unifiedmemorygb:128.0;
    disktype:hw.$$nvme;diskreadmbs:5000.0;
    cpucores:14;platform:"darwin"
  };
  let macviability = hw.estimatetierviability(macm4;14.0);
  results = str.arraypush(results;asserttrue("mac 128GB interactive viable for 14B";macviability.interactive));

  let minmachine = $hardwareprofile{
    ramgb:8.0;gpuvramgb:0.0;unifiedmemorygb:0.0;
    disktype:hw.$$sata;diskreadmbs:500.0;
    cpucores:4;platform:"linux"
  };
  let minviability = hw.estimatetierviability(minmachine;7.0);
  results = str.arraypush(results;asserttrue("8GB machine considered viable for 7B";minviability.considered));

  let tinyviability = hw.estimatetierviability(minmachine;1.0);
  results = str.arraypush(results;asserttrue("weak machine interactive for 1B model";tinyviability.interactive));

  let empty = hw.emptyprofile();
  let total = empty.ramgb + empty.gpuvramgb;
  results = str.arraypush(results;asserttrue("empty profile total memory is 0";total = 0.0));

  let hddprofile = $hardwareprofile{
    ramgb:16.0;gpuvramgb:0.0;unifiedmemorygb:0.0;
    disktype:hw.$$hdd;diskreadmbs:120.0;
    cpucores:4;platform:"linux"
  };
  let hddviability = hw.estimatetierviability(hddprofile;14.0);
  results = str.arraypush(results;assertfalse("hdd not background viable for large model";hddviability.background));

  let weak = $hardwareprofile{
    ramgb:4.0;gpuvramgb:0.0;unifiedmemorygb:0.0;
    disktype:hw.$$sata;diskreadmbs:400.0;
    cpucores:2;platform:"linux"
  };
  let weakv = hw.estimatetierviability(weak;70.0);
  results = str.arraypush(results;assertfalse("4GB not interactive for 70B";weakv.interactive));

  let manycores = $hardwareprofile{
    ramgb:32.0;gpuvramgb:0.0;unifiedmemorygb:32.0;
    disktype:hw.$$nvme;diskreadmbs:3000.0;
    cpucores:24;platform:"darwin"
  };
  let coresv = hw.estimatetierviability(manycores;7.0);
  results = str.arraypush(results;asserttrue("24 cores interactive for 7B";coresv.interactive));
  results = str.arraypush(results;asserttrue("24 cores tok_s > 0";coresv.interactivetoks > 0.0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i > n){ <all }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(r.passed){ i = i + 1 }el{ let all = false; i = i + 1 }
    }
  };
  <all
};

m=test.eval.benchsnippet;

i=t:std.test;
i=str:std.str;
i=u8:shared.utf8;
i=prov:core.providers.types;
i=b:core.eval.bench;

(* F10.49 — a benchmark result's response snippet never splits a UTF-8 character.

   `caseresult` keeps the first 120 BYTES of the model's reply as `responsesnippet`, which
   is written to the results file. The cut was a plain byte slice, so a reply in Japanese or
   one holding an emoji left part of a character in the stored result. It now cuts through
   shared.utf8.prefix: still at most 120 bytes, ending on the last whole character. *)

f=repeat(s:str;n:i64):str{
  let out=mut."";
  lp(let i=0;i<n;i=i+1){ out="\(out)\(s)" };
  <out
};

f=snippet(reply:str):str{
  let bcase=$benchcase{
    id:"utf8";
    prompt:"say something";
    expectedkeywords:@();
    category:"unit"
  };
  let response=$completionresponse{
    content:reply;
    modelid:"m";
    inputtokens:1 as u32;
    outputtokens:1 as u32;
    finishreason:"stop";
    costusd:0.0
  };
  let r=b.caseresult(bcase;"m";5;response);
  <r.responsesnippet
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  let jp="日";
  let emoji="😀";
  let e2="é";
  let a="a";
  let x="x";

  if(t.asserteq(snippet(repeat(a;130));repeat(a;120);"an ASCII reply is cut at exactly 120 bytes")){pass=pass+1}el{fail=fail+1};

  (* "a" and 41 three-byte characters: byte 120 is the last byte of the 40th. *)
  let s3=snippet("\(a)\(repeat(jp;41))");
  if(t.asserteq(s3;"\(a)\(repeat(jp;39))";"3-byte characters crossing byte 120 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(s3);"and the stored snippet is valid UTF-8")){pass=pass+1}el{fail=fail+1};

  (* "a" and 30 emoji: byte 120 is the 4th byte of the 30th. *)
  let s4=snippet("\(a)\(repeat(emoji;30))");
  if(t.asserteq(s4;"\(a)\(repeat(emoji;29))";"4-byte characters crossing byte 120 are cut before the split character")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(s4);"and that snippet is valid UTF-8")){pass=pass+1}el{fail=fail+1};

  let s2=snippet("\(repeat(a;119))\(e2)\(x)");
  if(t.asserteq(s2;repeat(a;119);"a 2-byte character split after its lead byte is dropped whole")){pass=pass+1}el{fail=fail+1};
  if(t.assert(u8.valid(s2);"and that snippet is valid UTF-8")){pass=pass+1}el{fail=fail+1};

  <fail
};

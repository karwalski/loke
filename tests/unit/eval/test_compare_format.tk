m=test.eval.compareformat;

i=t:std.test;
i=str:std.str;
i=b:core.eval.bench;
i=cmp:core.eval.compare;

(* LS1.1h. core.eval.compare.formatcomparison's winner line, against the REAL module.

   The line prints the score and cost deltas as magnitudes: "(score +0.25, cost +$1.25)". At
   toke 0b0bc4e the nested t.f64fixed(t.f64abs(x);2) printed neither delta correctly, because
   shared.types.f64abs's f64 return was corrupted crossing back into this module (T-20), so a
   one-call workaround, t.f64absfixed, formatted inside shared.types and returned a str. toke
   3.1.0 fixed T-20 and the workaround is gone; this pins that the nested form now prints the
   measured magnitudes. Both deltas are negative here (run B is the better and the dearer), so
   a formatter that drops the abs prints "+-0.25" and fails. *)

f=run(model:str;score:f64;cost:f64):$benchrun{
  <$benchrun{model:model;casesrun:1;avgscore:score;avglatencyms:10;totalcostusd:cost;results:@();runat:0}
};

f=main():i64{
  let ra=run("model-a";0.5;1.0);
  let rb=run("model-b";0.75;2.25);
  let c=$comparison{
    modela:"model-a";
    modelb:"model-b";
    runa:ra;
    runb:rb;
    winner:"model-b";
    scoredelta:ra.avgscore-rb.avgscore;
    costdelta:ra.totalcostusd-rb.totalcostusd;
    latencydeltams:0
  };
  let out=cmp.formatcomparison(c);
  let fails=mut.0;
  let a=t.assert(str.contains(out;"(score +0.25,");"the score delta is printed as its magnitude, 0.25");
  if(a){}el{fails=fails+1};
  let d=t.assert(str.contains(out;"cost +$1.25)");"the cost delta is printed as its magnitude, 1.25");
  if(d){}el{fails=fails+1};
  <fails
};

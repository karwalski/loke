m=test.eval.resultsink;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=json:std.json;
i=jx:shared.jsonobj;
i=sink:core.eval.resultsink;

(* VM1.6 — the toke side of the VM1.1 result sink, through the real core.eval.resultsink.

   A row that passes validation is written once, as one line of JSON that decodes and carries
   the fields benchmarks/lib/result.py reads. Every refusal result.validate makes is made here
   too, and a refused measurement writes NOTHING: each refusal is checked against a file that
   must still not exist afterwards, because a sink that returned a reason and wrote the row
   anyway would pass a test that only read the reason.

   Files live under /tmp, not ~/.loke: run_tests.sh does not isolate HOME. *)

f=dir():str{
  <"/tmp/loke-tests-resultsink-vm16"
};

f=fresh(name:str):str{
  let p="\(dir())/\(name).jsonl";
  file.delete(p);
  <p
};

f=readall(p:str):str{
  <mt file.read(p) {
    $ok:s s;
    $err:e ""
  }
};

f=good():$measurement{
  <$measurement{
    metric:"keyword_score";
    value:"0.75";
    units:"ratio";
    workload:"bench-default-5";
    n:5;
    arm:"";
    tokenizer:"";
    model:"llama3:latest";
    modelversion:"sha256:abc123";
    seed:sink.noseed();
    notes:"a \"quoted\" note";
    caveat:"";
    runs:4;
    cilow:"0.5";
    cihigh:"0.9";
    cimethod:"bca-bootstrap-exhaustive-256"
  }
};

f=with(metric:str;value:str;units:str;workload:str;n:i64;tokenizer:str;model:str;version:str):$measurement{
  <$measurement{
    metric:metric;
    value:value;
    units:units;
    workload:workload;
    n:n;
    arm:"";
    tokenizer:tokenizer;
    model:model;
    modelversion:version;
    seed:0;
    notes:"";
    caveat:"";
    runs:0;
    cilow:"";
    cihigh:"";
    cimethod:""
  }
};

(* VM1.3: a measurement with its repetition fields, value 0.75. *)
f=repeated(units:str;model:str;runs:i64;low:str;high:str;method:str):$measurement{
  <$measurement{
    metric:"m";
    value:"0.75";
    units:units;
    workload:"w";
    n:5;
    arm:"";
    tokenizer:"";
    model:model;
    modelversion:"v1";
    seed:0;
    notes:"";
    caveat:"";
    runs:runs;
    cilow:low;
    cihigh:high;
    cimethod:method
  }
};

(* The reason is non-empty AND the file was not created. *)
f=refused(name:str;m:$measurement):bool{
  let p=fresh(name);
  let why=sink.write(m;p);
  <str.len(why)>0 && !file.exists(p)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;
  file.mkdir(dir());

  (* ── A valid row is written, once, and decodes ─────────────────────────────── *)
  let p=fresh("valid");
  let why=sink.write(good();p);
  if(t.asserteq(why;"";"a valid measurement is written")){pass=pass+1}el{fail=fail+1};
  let body=readall(p);
  let lines=str.split(str.trim(body);"\n");
  if(t.assert(lines.len==1;"exactly one line")){pass=pass+1}el{fail=fail+1};
  let obj=mt json.dec(str.trim(body)) {
    $ok:o o;
    $jsonerr:e jx.emptyobj()
  };
  let metric=mt json.str(obj;"metric") {$ok:v v; $jsonerr:e ""};
  let version=mt json.str(obj;"model_version") {$ok:v v; $jsonerr:e ""};
  let workload=mt json.str(obj;"workload") {$ok:v v; $jsonerr:e ""};
  if(t.asserteq(metric;"keyword_score";"the line decodes and carries its metric")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(version;"sha256:abc123";"and the model's pinned version")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(workload;"bench-default-5";"and its workload")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"value\":0.75,");"the value is a JSON number, not a string")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"n\":5,");"n is written")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"seed\":null,");"no seed is written null")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"tokenizer\":null,");"an empty tokenizer is written null")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"toke_commit\":null,");"the toolchain commit is null, not guessed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"a \\\"quoted\\\" note");"a quote in the notes is escaped")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.startswith(body;"{\"arm\":null,\"caveat\":null,\"ci_high\"");"keys are in sorted order, as result.write emits them")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"ci_high\":0.9,\"ci_low\":0.5,\"ci_method\":\"bca-bootstrap-exhaustive-256\",");"the interval is written as two numbers and its method (VM1.3)")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(body;"\"runs\":4,");"and the number of kept runs")){pass=pass+1}el{fail=fail+1};

  (* Appends rather than truncates. *)
  sink.write(good();p);
  let twice=str.split(str.trim(readall(p));"\n");
  if(t.assert(twice.len==2;"a second write appends a second line")){pass=pass+1}el{fail=fail+1};

  (* ── Every refusal writes nothing ──────────────────────────────────────────── *)
  if(t.assert(refused("nometric";with("";"1";"ratio";"w";1;"";"";""));"no metric is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("nounits";with("m";"1";"";"w";1;"";"";""));"no units is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("noworkload";with("m";"1";"ratio";"";1;"";"";""));"no workload is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("nzero";with("m";"1";"ratio";"w";0;"";"";""));"n below one is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("notanumber";with("m";"abc";"ratio";"w";1;"";"";""));"a value that is not a number is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("nan";with("m";"nan";"ratio";"w";1;"";"";""));"nan is refused: it is not a JSON number")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("inf";with("m";"inf";"ratio";"w";1;"";"";""));"inf is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("tokennotok";with("tokens_per_task";"10";"tokens";"w";1;"";"";""));"a token metric without a tokenizer is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("noversion";with("m";"1";"ratio";"w";1;"";"llama3";""));"a model without a version is refused")){pass=pass+1}el{fail=fail+1};
  (* VM1.3: the repetition refusals, each mirroring one result.validate makes. *)
  if(t.assert(refused("modelonce";repeated("ratio";"llama3";0;"";"";""));"a model's output measured once is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("modelonerun";repeated("ratio";"llama3";1;"";"";""));"and so is one kept run")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("timedonce";repeated("ms";"";0;"";"";""));"a timing measured once is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("rateonce";repeated("MB/s (10^6 bytes)";"";0;"";"";""));"a rate measured once is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("nospread";repeated("ms";"";4;"";"";""));"repeated runs without an interval are refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("halfci";repeated("ms";"";4;"0.5";"";"bca-bootstrap-exhaustive-256"));"half an interval is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("nomethod";repeated("ms";"";4;"0.5";"0.9";""));"an interval without its method is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("outside";repeated("ms";"";4;"0.8";"0.9";"bca-bootstrap-exhaustive-256"));"a value outside its interval is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("percentile";repeated("ms";"";4;"0.5";"0.9";"percentile-bootstrap-10000"));"a percentile interval on repeated runs is refused: VM1.3 asks for BCa")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refused("nanbound";repeated("ms";"";4;"nan";"0.9";"bca-bootstrap-exhaustive-256"));"a bound that is not a number is refused")){pass=pass+1}el{fail=fail+1};
  let pt=fresh("timedrepeated");
  if(t.asserteq(sink.write(repeated("ms";"";4;"0.5";"0.9";"bca-bootstrap-exhaustive-256");pt);"";"a repeated timing with a BCa interval is accepted")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(sink.needsrepetition(with("recall";"0.9";"ratio";"w";10;"";"";""));"";"recall over a fixed corpus does not vary between runs, so it is recorded once")){pass=pass+1}el{fail=fail+1};

  let bad=sink.write(good();"/tmp/loke-tests-resultsink-vm16/no/such/dir/x.jsonl");
  if(t.assert(str.contains(bad;"could not be written");"an unwritable path is reported, not ignored")){pass=pass+1}el{fail=fail+1};

  (* ── And the controls: the same guards let a correct row through ───────────── *)
  let pb=fresh("tokenbytes");
  if(t.asserteq(sink.write(with("tokens_per_task";"10";"tokens";"w";1;"bytes";"";"");pb);"";"a token metric with the explicit tokenizer 'bytes' is accepted")){pass=pass+1}el{fail=fail+1};
  let pn=fresh("negative");
  if(t.asserteq(sink.write(with("delta";"-2.5e-3";"ratio";"w";1;"";"";"");pn);"";"a negative value in exponent form is accepted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(readall(pn);"\"seed\":0,");"seed 0 is written as 0, not null")){pass=pass+1}el{fail=fail+1};

  <fail
};

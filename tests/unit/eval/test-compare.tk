
m=tests.unit.eval.testcompare;

i=engine:loke.core.inference.native.engine;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @($result);

  let cfg = engine.defaultconfig("/models/qwen2.5-7b.gguf");
  results = str.arraypush(results;asserteq("default_config model_path";cfg.modelpath;"/models/qwen2.5-7b.gguf"));

  results = str.arraypush(results;asserttrue("default_config n_threads is 4";cfg.nthreads = 4));

  results = str.arraypush(results;asserttrue("default_config n_gpu_layers is 99";cfg.ngpulayers = 99));

  results = str.arraypush(results;asserttrue("default_config context_len is 4096";cfg.contextlen = 4096));

  results = str.arraypush(results;asserttrue("default_config seed is 42";cfg.seed = 42));

  let opts = engine.defaultopts();
  results = str.arraypush(results;asserttrue("default_opts temperature is 0.7";opts.temperature = 0.7));

  results = str.arraypush(results;asserttrue("default_opts top_p is 0.95";opts.topp = 0.95));

  results = str.arraypush(results;asserttrue("default_opts max_tokens is 2048";opts.maxtokens = 2048));

  results = str.arraypush(results;asserttrue("default_opts stop_sequences empty";opts.stopsequences.len() = 0));

  let result = engine.$generateresult{
    text:"Hello, world!";
    tokensin:10;
    tokensout:5;
    tokpersec:25.0;
    stoppedby:"eos"
  };
  results = str.arraypush(results;asserteq("generate_result text stored";result.text;"Hello, world!"));
  results = str.arraypush(results;asserttrue("generate_result tokens_in stored";result.tokensin = 10));
  results = str.arraypush(results;asserttrue("generate_result tokens_out stored";result.tokensout = 5));
  results = str.arraypush(results;asserttrue("generate_result tok_per_sec > 0";result.tokpersec > 0.0));
  results = str.arraypush(results;asserteq("generate_result stopped_by stored";result.stoppedby;"eos"));

  let customcfg = engine.$nativeconfig{
    modelpath:"/models/llama-3.1-8b.gguf";
    nthreads:8;
    ngpulayers:32;
    contextlen:8192;
    seed:0
  };
  results = str.arraypush(results;asserttrue("custom config context_len is 8192";customcfg.contextlen = 8192));
  results = str.arraypush(results;asserttrue("custom config n_threads is 8";customcfg.nthreads = 8));

  let customopts = engine.$generateopts{
    temperature:0.0;
    topp:1.0;
    maxtokens:100;
    stopsequences:@("</s>";"[END]")
  };
  results = str.arraypush(results;asserttrue("custom opts has 2 stop sequences";customopts.stopsequences.len() = 2));
  results = str.arraypush(results;asserttrue("custom opts temperature is 0";customopts.temperature = 0.0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;i<n;lv=lv){
    let r = str.arrayget(results;i);
    logresult(r);
    if(!r.passed){ let all = false }el{};
    i = i + 1
  };
  <all
};


m=tests.unit.eval.testadvisor;

i=hw:loke.core.hardware.profile;
i=rec:loke.core.hardware.recommender;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:$n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:$n;passed:false;message:$msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(!$v){ <pass(n) }el{ <fail(n;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @$result@();

  let profile = hw.detect();
  results = str.arraypush(results;asserttrue("detect returns non-zero ram_gb";profile.ramgb > 0));
  results = str.arraypush(results;asserttrue("detect returns non-zero cpu_cores";profile.cpucores > 0));
  results = str.arraypush(results;asserttrue("detect returns non-empty platform";str.len(profile.platform) > 0));

  results = str.arraypush(results;asserttrue("detect returns non-empty gpu_name";str.len(profile.gpuname) > 0));

  let validdisk = str.eq(profile.disktype;"nvme") || str.eq(profile.disktype;"ssd") || str.eq(profile.disktype;"hdd") || str.eq(profile.disktype;"unknown");
  results = str.arraypush(results;asserttrue("detect returns valid disk_type";validdisk));

  let custom = hw.$hardwareprofile{
    ramgb:32;vramgb:8;unifiedmemorygb:0;cpucores:16;
    gpuname:"NVIDIA RTX 4090";disktype:"nvme";diskspeedmbs:7000;platform:"linux"
  };
  results = str.arraypush(results;asserttrue("custom profile ram_gb stored";custom.ramgb = 32));
  results = str.arraypush(results;asserttrue("custom profile vram_gb stored";custom.vramgb = 8));

  let recs = rec.recommend(custom);
  results = str.arraypush(results;asserttrue("recommend returns results for capable hw";recs.len() > 0));

  let weak = hw.$hardwareprofile{
    ramgb:1;vramgb:0;unifiedmemorygb:0;cpucores:1;
    gpuname:"";disktype:"hdd";diskspeedmbs:100;platform:"linux"
  };
  let weakrecs = rec.recommend(weak);
  results = str.arraypush(results;pass("recommend does not crash on weak hardware"));

  let dtnvme = hw.$disktype.$nvme:i64;
  let dtssd = hw.$disktype.$ssd:i64;
  let dthdd = hw.$disktype.$hdd:i64;
  let dtunknown = hw.$disktype.$unknown:i64;
  results = str.arraypush(results;pass("disk_type variants construct without crash"));

  let apple = hw.$hardwareprofile{
    ramgb:16;vramgb:0;unifiedmemorygb:36;cpucores:10;
    gpuname:"Apple M3 Max";disktype:"nvme";diskspeedmbs:5000;platform:"darwin"
  };
  results = str.arraypush(results;asserttrue("apple unified memory > ram_gb";apple.unifiedmemorygb > apple.ramgb));

  results = str.arraypush(results;asserttrue("detect disk_speed_mbs > 0";profile.diskspeedmbs > 0));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  loop{
    if(i >= n){ break }el{
      let r = str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all = false }el{};
      i = i + 1
    };
  };
  <all
};


m=tests.unit.governance.testapproval;
i=ap:core.governance.approval;
i=str:std.str;
i=test:std.test;

f=run():void{
  testalwaysrequiresapproval();
  testneverrequiresapproval();
  testbysensitivityconfidential();
  testbysensitivitypublic();
  testbyprovidercloud();
  testbyproviderlocal();
  testdontaskagain();
  testdiffgeneration()
};

f=testalwaysrequiresapproval():void{
  test.assert(ap.requiresapproval("always";"public";"anthropic";"chat";@())=true;"always mode requires approval")
};

f=testneverrequiresapproval():void{
  test.assert(ap.requiresapproval("never";"restricted";"anthropic";"chat";@())=false;"never mode skips approval")
};

f=testbysensitivityconfidential():void{
  test.assert(ap.requiresapproval("by_sensitivity";"confidential";"anthropic";"chat";@())=true;"confidential requires approval")
};

f=testbysensitivitypublic():void{
  test.assert(ap.requiresapproval("by_sensitivity";"public";"anthropic";"chat";@())=false;"public does not require approval")
};

f=testbyprovidercloud():void{
  test.assert(ap.requiresapproval("by_provider";"public";"anthropic";"chat";@())=true;"cloud provider requires approval")
};

f=testbyproviderlocal():void{
  test.assert(ap.requiresapproval("by_provider";"public";"ollama";"chat";@())=false;"local provider skips approval")
};

f=testdontaskagain():void{
  let rule=$ap.dontaskrule{tasktype:"chat";providerid:"";maxsensitivity:"";createdat:0};
  test.assert(ap.requiresapproval("always";"confidential";"anthropic";"chat";@(rule))=false;"dont_ask_again suppresses")
};

f=testdiffgeneration():void{
  let diff=ap.generatediff("Hello John
Please help";"Hello [PERSON_1]
Please help");
  test.assert(diff.len=3;"should have 3 diff lines");
  test.asserteq(diff.get(0).linetype;"removed";"first line changed");
  test.asserteq(diff.get(2).linetype;"unchanged";"second line unchanged")
};


m=tests.unit.governance.testcompliancefeedback;
i=vt:core.governance.violationtypes;
i=scanner:core.governance.responsescanner;
i=supp:core.governance.suppression;
i=str:std.str;
i=test:std.test;

f=run():void{
  testseverityranking();
  testhighestseverity();
  testscancleanresponse();
  testscanpiileak();
  testsuppressionrule();
  testapplysuppressions()
};

f=testseverityranking():void{
  test.assert(vt.severityrank("BLOCK")=4;"BLOCK is rank 4");
  test.assert(vt.severityrank("WARNING")=3;"WARNING is rank 3");
  test.assert(vt.severityrank("INFO")=1;"INFO is rank 1")
};

f=testhighestseverity():void{
  let violations=@(
    $vt.violation{id:"v1";violationtype:"test";severity:"INFO";description:"";entitytype:"";sourcestage:"";requestid:"";suppressed:false};
    $vt.violation{id:"v2";violationtype:"test";severity:"WARNING";description:"";entitytype:"";sourcestage:"";requestid:"";suppressed:false};
  );
  let highest=vt.highestseverity(violations);
  test.asserteq(highest;"WARNING";"highest should be WARNING")
};

f=testscancleanresponse():void{
  let result=scanner.scanresponse("The answer is 42";"The answer is 42";"req-1";@());
  test.assert(result.violations.len=0;"clean response should have no violations");
  test.assert(result.requiresconfirmation=false;"no confirmation needed")
};

f=testscanpiileak():void{
  let result=scanner.scanresponse("Contact john@example.com for details";"Contact john@example.com for details";"req-2";@());
  test.assert(result.violations.len>0;"email pattern should trigger violation")
};

f=testsuppressionrule():void{
  let rule=supp.createrule("pii_in_response";"email";"user dismissed");
  let violation=$vt.violation{id:"v1";violationtype:"pii_in_response";severity:"WARNING";description:"";entitytype:"email";sourcestage:"";requestid:"";suppressed:false};
  test.assert(supp.issuppressed(violation;@(rule))=true;"matching rule should suppress")
};

f=testapplysuppressions():void{
  let rule=supp.createrule("pii_in_response";"";"dismiss all pii warnings");
  let result=$vt.scanresult{
    violations:@$vt.violation{id:"v1";violationtype:"pii_in_response";severity:"WARNING";description:"";entitytype:"email";sourcestage:"";requestid:"req-1";suppressed:false});
    scannedat:0;requestid:"req-1";requiresconfirmation:true
  };
  let filtered=supp.applysuppressions(result;@(rule));
  test.assert(filtered.violations.get(0).suppressed=true;"violation should be marked suppressed")
};

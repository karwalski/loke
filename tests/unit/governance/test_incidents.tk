m=test.governance.incidents;

i=t:std.test;
i=str:std.str;

t=$incident{
  id:str;
  incidenttype:str;
  severity:str;
  title:str;
  description:str;
  autocreated:bool;
  createdat:i64;
  resolvedat:i64;
  resolved:bool;
  resolutionnotes:str;
  relatedrequestids:@str
};

t=$incidentstore{
  incidents:@$incident
};

f=newstore():$incidentstore{
  <$incidentstore{incidents:@()}
};

f=create(st:$incidentstore;incidenttype:str;severity:str;title:str;description:str;autocreated:bool):$incidentstore{
  let inc=$incident{
    id:str.concat("inc-";str.fromint(st.incidents.len));
    incidenttype:incidenttype;
    severity:severity;
    title:title;
    description:description;
    autocreated:autocreated;
    createdat:0;
    resolvedat:0;
    resolved:false;
    resolutionnotes:"";
    relatedrequestids:@()
  };
  <$incidentstore{incidents:st.incidents.push(inc)}
};

f=resolve(st:$incidentstore;id:str;notes:str):$incidentstore{
  let newlist=mut.@();
  lp(let ii=0;ii<st.incidents.len;ii=ii+1){
    let inc=st.incidents.get(ii);
    if(str.eq(inc.id;id)){
      newlist=newlist.push($incident{
        id:inc.id;
        incidenttype:inc.incidenttype;
        severity:inc.severity;
        title:inc.title;
        description:inc.description;
        autocreated:inc.autocreated;
        createdat:inc.createdat;
        resolvedat:1;
        resolved:true;
        resolutionnotes:notes;
        relatedrequestids:inc.relatedrequestids
      })
    }el{
      newlist=newlist.push(inc)
    }
  };
  <$incidentstore{incidents:newlist}
};

f=listopen(st:$incidentstore):@$incident{
  let result=mut.@();
  lp(let ii=0;ii<st.incidents.len;ii=ii+1){
    let inc=st.incidents.get(ii);
    if(!inc.resolved){
      result=result.push(inc)
    }el{}
  };
  <result
};

f=listall(st:$incidentstore):@$incident{
  <st.incidents
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let st=newstore();
  t.assert(st.incidents.len=0;"new store has zero incidents");
  if(st.incidents.len=0){ pass=pass+1 }el{ fail=fail+1 };

  let st2=create(st;"privacy_breach";"critical";"PII leak detected";"Unredacted name in outbound request";true);
  t.assert(st2.incidents.len=1;"store has 1 incident after create");
  if(st2.incidents.len=1){ pass=pass+1 }el{ fail=fail+1 };

  let inc=st2.incidents.get(0);
  t.assert(str.eq(inc.title;"PII leak detected");"incident title matches");
  if(str.eq(inc.title;"PII leak detected")){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(str.eq(inc.severity;"critical");"incident severity is critical");
  if(str.eq(inc.severity;"critical")){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(str.eq(inc.incidenttype;"privacy_breach");"incident type is privacy_breach");
  if(str.eq(inc.incidenttype;"privacy_breach")){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(inc.autocreated=true;"incident autocreated flag is true");
  if(inc.autocreated){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(inc.resolved=false;"new incident is not resolved");
  if(!inc.resolved){ pass=pass+1 }el{ fail=fail+1 };

  let incid=inc.id;
  let st3=resolve(st2;incid;"False positive after review");
  let resolved=st3.incidents.get(0);
  t.assert(resolved.resolved=true;"incident is resolved after resolve call");
  if(resolved.resolved){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(str.eq(resolved.resolutionnotes;"False positive after review");"resolution notes match");
  if(str.eq(resolved.resolutionnotes;"False positive after review")){ pass=pass+1 }el{ fail=fail+1 };

  let st4=create(st3;"policy_violation";"high";"Quota exceeded";"Provider quota breached";false);
  let openlist=listopen(st4);
  t.assert(openlist.len=1;"list open excludes resolved incidents");
  if(openlist.len=1){ pass=pass+1 }el{ fail=fail+1 };

  let alllist=listall(st4);
  t.assert(alllist.len=2;"list all includes both resolved and open");
  if(alllist.len=2){ pass=pass+1 }el{ fail=fail+1 };

  let st5=create(st4;"compliance";"low";"Minor log gap";"Audit log missed one entry";true);
  let low=st5.incidents.get(2);
  t.assert(str.eq(low.severity;"low");"low severity incident created correctly");
  if(str.eq(low.severity;"low")){ pass=pass+1 }el{ fail=fail+1 };

  <fail
};

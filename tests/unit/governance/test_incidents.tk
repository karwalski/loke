m=test.governance.incidents;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=db:std.db;
i=sdb:core.storage.db;
i=inc:core.governance.incidents;

(* X7.2 — this file used to declare its own $incident array plus openincident,
   updatestatus, resolve, listopen and severity constants, and assert against them. It
   never labelled itself a stub, which is the same pattern with less honesty about it.
   Its severity "test" was:

     f=sevp0():str{ <"P0" };
     ... t.assert(str.eq(sevp0();"P0");"P0 severity constant")

   — a function in the test returning a literal, compared to the same literal. The real
   constants live in core.governance.incidents and are what the incidents table stores,
   so they are the contract between a writer and the `status != 'resolved'` predicate in
   listopen. A silent change to `statusresolved()` would leave resolved incidents on the
   open list forever, and nothing would have caught it.

   The lifecycle is exercised against the real table, because the interesting assertion
   is not that a struct field changed — it is that a resolved incident LEAVES the open
   list, which is a SQL predicate, not a field read.

   ── T10.2, 2026-09-24 ───────────────────────────────────────────────────────────────
   HOW THE BACKLOG ROW'S SEVEN BEHAVIOURS MAP ONTO THIS MODULE. Four have direct
   equivalents and are asserted here; three do not exist and are not invented:

     row                                     module
     --------------------------------------- ---------------------------------------
     `create` returns an incident with an id
       and open status                       openincident — asserted
     `append` makes it retrievable           NO SEPARATE APPEND: openincident is the
                                             write; retrievability is asserted through
                                             listopen and the row itself
     `resolve` sets resolved=true            resolve sets status='resolved' and stamps
                                             resolved_at — asserted
     `list_open` excludes resolved           asserted, in both directions
     `list_all` includes both                ABSENT — listopen is the only listing in
                                             the module. What IS asserted is that a
                                             resolved incident's ROW is retained, which
                                             is what a list_all would read
     `get` by unknown id returns none        ABSENT — there is no get()
     `post_incident_template`                ABSENT — no template, no post-incident
                                             review anywhere in the module

   The exports are sevp0..sevp3, statusopen, statusinvestigating, statusresolved,
   ensuretable, openincident, updatestatus, resolve, listopen, autoopenifdegraded and
   formatincidents. Nothing reads a single incident by id, so "unknown id returns none"
   has nothing to be asked of; the closest observable is that an update naming an unknown
   id changes nothing, which is asserted at the end. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-incidents")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  (* A fresh file: the counts below are exact. *)
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s s;
    $err:e 0
  }
};

f=countof(rows:@$row):i64{
  if(rows.len>0){
    let r:$row=rows.get(0);
    <sdb.rowi64(r;"cnt")
  }el{
    <0-1
  }
};

f=totalincidents():i64{
  <mt db.many("SELECT COUNT(1) AS cnt FROM incidents";@()) {
    $ok:rows countof(rows);
    $err:e 0-1
  }
};

f=nrowsresolved():i64{
  <mt db.many("SELECT id FROM incidents WHERE status='resolved'";@()) {
    $ok:rr rr.len as i64;
    $err:e 0-1
  }
};

f=firstcol(rows:@$row;col:str):str{
  if(rows.len>0){
    let r:$row=rows.get(0);
    <sdb.rowstr(r;col)
  }el{
    <""
  }
};

f=colof(id:str;col:str):str{
  <mt db.many(str.concat("SELECT ";str.concat(col;" FROM incidents WHERE id=? LIMIT 1"));@(id)) {
    $ok:rows firstcol(rows;col);
    $err:e ""
  }
};

f=hasid(list:@$incident;wanted:str):bool{
  let found=mut.false;
  lp(let i=0;i<list.len;i=i+1){
    let e:$incident=list.get(i);
    if(str.eq(e.id;wanted)){
      found=true
    }el{}
  };
  <found
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=openfreshstore();

  (* ── The constants, from the module rather than from the test ────────────────
     These are the literals the table stores, and `statusresolved()` is half of
     listopen's WHERE clause. *)
  if(t.asserteq(inc.sevp0();"P0";"the severity ladder is P0")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(inc.sevp1();"P1";"P1")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(inc.sevp2();"P2";"P2")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(inc.sevp3();"P3";"and P3")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(inc.statusopen();"open";"a new incident is 'open'")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(inc.statusinvestigating();"investigating";"then 'investigating'")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(inc.statusresolved();"resolved";"and 'resolved', which is the exact string listopen's WHERE clause excludes")){pass=pass+1}el{fail=fail+1};

  if(t.assert(inc.ensuretable(store);"the incidents table is created")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.tableexists("incidents");"and really exists")){pass=pass+1}el{fail=fail+1};
  if(t.assert(totalincidents()==0;"with no rows in it")){pass=pass+1}el{fail=fail+1};

  (* ── Opening an incident ─────────────────────────────────────────────────────*)
  let id=inc.openincident(store;"Pipeline degraded";inc.sevp1();"Recall dropped below threshold");
  if(t.assert((str.len(id) as i64)==32;"openincident returns a 32-character id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(totalincidents()==1;"and writes exactly one row")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(colof(id;"status");"open";"a new incident starts open, set by the module and not by the caller")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(colof(id;"severity");"P1";"with the severity it was given")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(colof(id;"title");"Pipeline degraded";"and the title")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(colof(id;"resolution_note");"";"and no resolution note yet")){pass=pass+1}el{fail=fail+1};

  let open1=inc.listopen(store);
  if(t.assert(open1.len==1;"listopen returns it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasid(open1;id);"by its own id")){pass=pass+1}el{fail=fail+1};

  (* ── Investigating is still OPEN ─────────────────────────────────────────────
     This is the assertion that makes listopen's predicate meaningful. `status !=
     'resolved'` must keep an incident under investigation on the list; an operator who
     starts investigating and thereby loses sight of the incident is worse off than
     before they touched it. *)
  if(t.assert(inc.updatestatus(store;id;inc.statusinvestigating());"an incident can move to investigating")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(colof(id;"status");"investigating";"and the row says so")){pass=pass+1}el{fail=fail+1};
  let open2=inc.listopen(store);
  if(t.assert(hasid(open2;id);"an incident under INVESTIGATION is still on the open list")){pass=pass+1}el{fail=fail+1};

  (* ── Resolving takes it off ──────────────────────────────────────────────────*)
  if(t.assert(inc.resolve(store;id;"pattern re-anchored");"an incident can be resolved")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(colof(id;"status");"resolved";"the row records it")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(colof(id;"resolution_note");"pattern re-anchored";"with the note, which is the only record of WHY it was closed")){pass=pass+1}el{fail=fail+1};
  let open3=inc.listopen(store);
  if(t.assert(!hasid(open3;id);"and it is no longer on the open list")){pass=pass+1}el{fail=fail+1};
  if(t.assert(totalincidents()==1;"while the row itself is retained — an incident log that deletes on resolve has no history")){pass=pass+1}el{fail=fail+1};

  (* ── autoopenifdegraded, and its threshold ───────────────────────────────────
     The rule is `thumbsuprate < 0.5`. Both sides of the boundary are asserted, and the
     row count is checked after each, because "returns false" and "opened nothing" are
     different claims and only the second one matters. *)
  let before=totalincidents();
  if(t.assert(!inc.autoopenifdegraded(store;"claude-3.5-sonnet";0.9);"a healthy thumbs-up rate opens no incident")){pass=pass+1}el{fail=fail+1};
  if(t.assert(totalincidents()==before;"and writes no row")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!inc.autoopenifdegraded(store;"claude-3.5-sonnet";0.5);"exactly 0.5 does NOT open one: the test is < not <=")){pass=pass+1}el{fail=fail+1};
  if(t.assert(totalincidents()==before;"and still writes no row")){pass=pass+1}el{fail=fail+1};
  if(t.assert(inc.autoopenifdegraded(store;"claude-3.5-sonnet";0.3);"a degraded rate DOES open one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(totalincidents()==before+1;"and writes exactly one row")){pass=pass+1}el{fail=fail+1};

  let auto=inc.listopen(store);
  if(t.assert(auto.len==1;"which appears on the open list")){pass=pass+1}el{fail=fail+1};
  let autoinc:$incident=auto.get(0);
  if(t.asserteq(autoinc.severity;"P2";"an auto-opened quality incident is P2")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(autoinc.title;"claude-3.5-sonnet");"and names the model in its title, so the incident is actionable")){pass=pass+1}el{fail=fail+1};

  (* ── The operator's view ─────────────────────────────────────────────────────*)
  let table=inc.formatincidents(auto);
  if(t.assert(str.contains(table;"Severity");"the formatted table has a Severity column")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(table;"P2");"and carries the severity of the incident in it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(table;"claude-3.5-sonnet");"and the title")){pass=pass+1}el{fail=fail+1};

  (* ── T10.2: an unknown id ────────────────────────────────────────────────────
     The row asks for `get(unknown)` to return none. There is no get(), so the observable
     equivalent is that naming an id the table does not hold changes nothing.

     MEASURED, REPORTED AND NOT FIXED HERE: both resolve() and updatestatus() return TRUE
     for an id that does not exist. sql.exec succeeds — an UPDATE matching no row is not
     an error in SQLite — and neither function checks how many rows it touched, so a
     caller resolving a mistyped id is told the incident is closed and it is still open.
     The assertion is on the TABLE, because the table is the half that tells the truth,
     and it holds both now and after that is fixed. *)
  let beforeunknown=totalincidents();
  inc.resolve(store;"no-such-incident-id";"closed in error");
  inc.updatestatus(store;"no-such-incident-id";inc.statusinvestigating());
  if(t.assert(totalincidents()==beforeunknown;"an update naming an unknown incident id changes no row and creates none")){pass=pass+1}el{fail=fail+1};
  if(t.assert(inc.listopen(store).len==1;"and leaves the open list exactly as it was")){pass=pass+1}el{fail=fail+1};

  (* ── The empty open list ─────────────────────────────────────────────────────
     The state an operator most wants to see, and the one a WHERE clause is most likely to
     get wrong in the quiet direction: `status != 'resolved'` over a table where every row
     IS resolved must return nothing at all, not the whole table. The rows themselves stay
     — an incident log that deletes on resolve has no history, and a list_all would read
     these two. *)
  inc.resolve(store;autoinc.id;"model recovered");
  if(t.assert(inc.listopen(store).len==0;"with every incident resolved the open list is EMPTY")){pass=pass+1}el{fail=fail+1};
  if(t.assert(totalincidents()==2;"while both incidents are still in the table — resolving closes an incident, it does not erase it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(nrowsresolved()==2;"and both are marked resolved")){pass=pass+1}el{fail=fail+1};

  (* An empty list must still render a table. A blank string reads as a rendering failure
     rather than as "nothing is on fire", and those are opposite messages. *)
  let emptytable=inc.formatincidents(inc.listopen(store));
  if(t.assert(str.contains(emptytable;"Severity");"an empty incident list still renders its header row, so 'no incidents' cannot be mistaken for 'the view is broken'")){pass=pass+1}el{fail=fail+1};

  (* ── T10.2: list_all, get and the post-incident template ────────────────── *)
  let third=inc.openincident(store;"Presidio unreachable";inc.sevp2();"Sidecar stopped answering");
  let all=inc.listall(store);
  if(t.assert(all.len==3;"listall returns every incident")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasid(all;id) && hasid(all;third);"resolved and open alike")){pass=pass+1}el{fail=fail+1};
  if(t.assert(inc.listopen(store).len==1;"while listopen still excludes the resolved two")){pass=pass+1}el{fail=fail+1};

  let got:$incident=inc.get(store;id);
  if(t.asserteq(got.id;id;"get returns the incident asked for")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(got.title;"Pipeline degraded";"with its title")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(got.status;"resolved";"its status")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(got.resolutionnote;"pattern re-anchored";"and its resolution note")){pass=pass+1}el{fail=fail+1};
  let other:$incident=inc.get(store;third);
  if(t.asserteq(other.title;"Presidio unreachable";"a different id returns a different incident")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!inc.isincident(inc.get(store;"no-such-id"));"an unknown id returns no incident")){pass=pass+1}el{fail=fail+1};

  let review=inc.postincidenttemplate(got);
  if(t.assert(str.contains(review;"Post-incident review: Pipeline degraded");"the template is titled with the incident")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(review;id) && str.contains(review;"P1");"names its id and severity")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(review;"Recall dropped below threshold") && str.contains(review;"pattern re-anchored");"carries what happened and how it was resolved")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(review;"## Root cause") && str.contains(review;"## Actions");"and leaves the review's questions to answer")){pass=pass+1}el{fail=fail+1};

  <fail
};

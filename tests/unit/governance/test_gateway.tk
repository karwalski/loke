


m=tests.unit.governance.testgateway;

i=gw:core.governance.gateway;
i=gt:core.governance.types;
i=t:shared.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }else{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }else{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }else{ <fail(name;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let g=gw.new();
  results=str.arraypush(results;assertfalse("new gateway kill_switch_active=false";g.killswitchactive));

  
  let reqclean=gt.$gatewayrequest{
    requestid:"req-001";
    usecaseid:"chat-completion";
    text:"Hello";
    modelid:"gpt-4o-mini";
    provider:$provider.$openai;
    sensitivity:$sensitivitylevel.$public;
    estimatedcost:0.001;
    correlationid:"corr-001"
  };
  let decisionclean=gw.submit(g;reqclean);
  results=str.arraypush(results;assertfalse("clean request not blocked";gw.isblocked(decisionclean)));

  
  results=str.arraypush(results;asserttrue("decision explanation non-empty";str.len(decisionclean.explanation)>0));

  
  results=str.arraypush(results;asserttrue("decision timestamp non-empty";str.len(decisionclean.timestamp)>0));

  
  let mutg=gw.new();
  gw.activatekillswitch(mutg;"emergency stop");
  let reqblocked=gt.$gatewayrequest{
    requestid:"req-002";
    usecaseid:"chat-completion";
    text:"Should be blocked";
    modelid:"gpt-4o";
    provider:$provider.$openai;
    sensitivity:$sensitivitylevel.$public;
    estimatedcost:0.0;
    correlationid:"corr-002"
  };
  let decisionblocked=gw.submit(mutg;reqblocked);
  results=str.arraypush(results;asserttrue("kill switch active → request blocked";gw.isblocked(decisionblocked)));

  
  results=str.arraypush(results;asserttrue("kill switch explanation contains reason";str.contains(decisionblocked.explanation;"emergency stop")));

  
  let tierlabel=gt.risklabel(decisionblocked.risktier);
  results=str.arraypush(results;asserteq("kill switch decision risk=HIGH";"HIGH";tierlabel));

  
  gw.deactivatekillswitch(mutg);
  let decisionrestored=gw.submit(mutg;reqclean);
  results=str.arraypush(results;assertfalse("after deactivate → no longer blocked";gw.isblocked(decisionrestored)));

  
  let requnknownuc=gt.$gatewayrequest{
    requestid:"req-003";
    usecaseid:"nonexistent-use-case";
    text:"test";
    modelid:"gpt-4o";
    provider:$provider.$openai;
    sensitivity:$sensitivitylevel.$internal;
    estimatedcost:0.0;
    correlationid:"corr-003"
  };
  let g2=gw.new();
  let decisionunknown=gw.submit(g2;requnknownuc);
  results=str.arraypush(results;asserttrue("unknown use case → blocked";gw.isblocked(decisionunknown)));

  
  let allowdecision=gt.$gatewaydecision{
    requestid:"req-004";
    policydecision:i64.$allow;
    risktier:i64.$low;
    routing:gw.defaultrouting();
    controlsapplied:@();
    explanation:"approved";
    timestamp:"2026-04-22T00:00:00Z"
  };
  results=str.arraypush(results;assertfalse("is_blocked false for allow decision";gw.isblocked(allowdecision)));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }else{};
      i=i+1;
    };
  };
  <all
};

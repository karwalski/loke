m=test.governance.gateway;

i=t:std.test;
i=str:std.str;

(* --- stub governance gateway functions --- *)

(* policy results *)
f=policyallow():i64{ <1 };
f=policydeny():i64{ <0 };

(* check if a request action is permitted by policy *)
f=checkpolicy(action:str;userrole:str):i64{
  (* admin can do anything *)
  if(str.eq(userrole;"admin")){<policyallow()};
  (* deny dangerous actions for non-admins *)
  if(str.eq(action;"delete_all")){<policydeny()};
  if(str.eq(action;"export_raw")){<policydeny()};
  if(str.eq(action;"disable_privacy")){<policydeny()};
  (* allow standard actions *)
  if(str.eq(action;"query")){<policyallow()};
  if(str.eq(action;"submit")){<policyallow()};
  if(str.eq(action;"view")){<policyallow()};
  (* deny unknown actions by default *)
  <policydeny()
};

(* submit a request through the gateway — returns request ID or 0 on deny *)
f=submitrequest(action:str;userrole:str;payload:str):i64{
  if(checkpolicy(action;userrole)=policydeny()){<0};
  (* simulate request ID generation *)
  <str.len(payload)+1000
};

(* rate limit check: returns 1 if within limit, 0 if exceeded *)
f=ratelimitok(requestcount:i64;maxpermin:i64):i64{
  if(requestcount>maxpermin){<0};
  <1
};

(* gateway status *)
f=gatewayenabled():i64{ <1 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test policy allow for standard actions *)
  if(t.assert(checkpolicy("query";"user")=policyallow();"user can query")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkpolicy("submit";"user")=policyallow();"user can submit")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkpolicy("view";"user")=policyallow();"user can view")){pass=pass+1}el{fail=fail+1};

  (* test policy deny for dangerous actions *)
  if(t.assert(checkpolicy("delete_all";"user")=policydeny();"user cannot delete_all")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkpolicy("export_raw";"user")=policydeny();"user cannot export_raw")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkpolicy("disable_privacy";"user")=policydeny();"user cannot disable privacy")){pass=pass+1}el{fail=fail+1};

  (* test admin overrides *)
  if(t.assert(checkpolicy("delete_all";"admin")=policyallow();"admin can delete_all")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkpolicy("disable_privacy";"admin")=policyallow();"admin can disable privacy")){pass=pass+1}el{fail=fail+1};

  (* test unknown action denied by default *)
  if(t.assert(checkpolicy("hack_system";"user")=policydeny();"unknown action denied")){pass=pass+1}el{fail=fail+1};

  (* test submit request returns ID on allow *)
  let rid=submitrequest("query";"user";"test payload");
  if(t.assert(rid>0;"submit returns positive request ID on allow")){pass=pass+1}el{fail=fail+1};

  (* test submit request returns 0 on deny *)
  if(t.assert(submitrequest("delete_all";"user";"payload")=0;"submit returns 0 on deny")){pass=pass+1}el{fail=fail+1};

  (* test rate limiting *)
  if(t.assert(ratelimitok(5;60)=1;"5 requests within 60/min limit")){pass=pass+1}el{fail=fail+1};

  if(t.assert(ratelimitok(61;60)=0;"61 requests exceeds 60/min limit")){pass=pass+1}el{fail=fail+1};

  (* test gateway enabled *)
  if(t.assert(gatewayenabled()=1;"gateway is enabled")){pass=pass+1}el{fail=fail+1};

  <fail
};

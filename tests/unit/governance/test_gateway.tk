m=test.governance.gateway;

i=t:std.test;
i=str:std.str;

(* --- stub governance gateway functions --- *)

(* policy results *)
f=policy_allow():i64{ <1 };
f=policy_deny():i64{ <0 };

(* check if a request action is permitted by policy *)
f=check_policy(action:str;user_role:str):i64{
  (* admin can do anything *)
  if(str.eq(user_role;"admin")){<policy_allow()};
  (* deny dangerous actions for non-admins *)
  if(str.eq(action;"delete_all")){<policy_deny()};
  if(str.eq(action;"export_raw")){<policy_deny()};
  if(str.eq(action;"disable_privacy")){<policy_deny()};
  (* allow standard actions *)
  if(str.eq(action;"query")){<policy_allow()};
  if(str.eq(action;"submit")){<policy_allow()};
  if(str.eq(action;"view")){<policy_allow()};
  (* deny unknown actions by default *)
  <policy_deny()
};

(* submit a request through the gateway — returns request ID or 0 on deny *)
f=submit_request(action:str;user_role:str;payload:str):i64{
  if(check_policy(action;user_role)=policy_deny()){<0};
  (* simulate request ID generation *)
  <str.len(payload)+1000
};

(* rate limit check: returns 1 if within limit, 0 if exceeded *)
f=rate_limit_ok(request_count:i64;max_per_min:i64):i64{
  if(request_count>max_per_min){<0};
  <1
};

(* gateway status *)
f=gateway_enabled():i64{ <1 };

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test policy allow for standard actions *)
  if(t.assert(check_policy("query";"user")=policy_allow();"user can query")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_policy("submit";"user")=policy_allow();"user can submit")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_policy("view";"user")=policy_allow();"user can view")){pass=pass+1}el{fail=fail+1};

  (* test policy deny for dangerous actions *)
  if(t.assert(check_policy("delete_all";"user")=policy_deny();"user cannot delete_all")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_policy("export_raw";"user")=policy_deny();"user cannot export_raw")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_policy("disable_privacy";"user")=policy_deny();"user cannot disable privacy")){pass=pass+1}el{fail=fail+1};

  (* test admin overrides *)
  if(t.assert(check_policy("delete_all";"admin")=policy_allow();"admin can delete_all")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_policy("disable_privacy";"admin")=policy_allow();"admin can disable privacy")){pass=pass+1}el{fail=fail+1};

  (* test unknown action denied by default *)
  if(t.assert(check_policy("hack_system";"user")=policy_deny();"unknown action denied")){pass=pass+1}el{fail=fail+1};

  (* test submit request returns ID on allow *)
  let rid=submit_request("query";"user";"test payload");
  if(t.assert(rid>0;"submit returns positive request ID on allow")){pass=pass+1}el{fail=fail+1};

  (* test submit request returns 0 on deny *)
  if(t.assert(submit_request("delete_all";"user";"payload")=0;"submit returns 0 on deny")){pass=pass+1}el{fail=fail+1};

  (* test rate limiting *)
  if(t.assert(rate_limit_ok(5;60)=1;"5 requests within 60/min limit")){pass=pass+1}el{fail=fail+1};

  if(t.assert(rate_limit_ok(61;60)=0;"61 requests exceeds 60/min limit")){pass=pass+1}el{fail=fail+1};

  (* test gateway enabled *)
  if(t.assert(gateway_enabled()=1;"gateway is enabled")){pass=pass+1}el{fail=fail+1};

  <fail
};

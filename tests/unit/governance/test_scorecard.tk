m=test.governance.scorecard;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=sdb:core.storage.db;
i=audit:core.storage.audit;
i=scard:core.governance.scorecard;

(* Note on the alias: `sc` is a RESERVED token in toke — `i=sc:…` fails with
   "expected import alias, got 'sc'". Hence `scard`.

   X7.2 — this file used to declare its own $providerstats with its own hardcoded numbers
   and assert against them:

     f=anthropicstats():$providerstats{ <$providerstats{provider:"anthropic";requests:89;...} }
     ... t.assert(anthropicstats().requests==89;"anthropic served 89 requests")

   Importing the real module showed the stub was not a simplification of it but a COPY,
   hardcoded numbers and all: `buildscorecard` ignored `store`, contained no query, and
   returned three literal stat blocks, so a fresh installation that had never sent a
   request reported 89 requests to anthropic with a P99 of 3100ms. The p99 was the worst of
   it — a percentile is a claim about a distribution, and there was no distribution.

   That was reported as a finding during this epic and has since been FIXED in the module
   (the same defect class as DA1.5), so this file no longer characterises it. Every figure
   is now derived from audit_log, and what is asserted below is that derivation — including
   the three places the module deliberately refuses to produce a number.

   Written against the repaired module. It needs `build/interfaces` and the loke archive
   regenerated from the current source to compile — until then it reports COMPILE_ERROR,
   because the committed interface still describes the old fabricated struct. Verified here
   against a locally emitted interface and object for
   packages/core/src/governance/scorecard.tk.

   ══ FINDING, LIVE: six assertions below are RED, and the cause is one line ══════
   packages/core/src/governance/scorecard.tk:99

     let n=s.countquery("SELECT COUNT(id) AS cnt FROM audit_log WHERE provider=?";@(provider));

   `core.storage.db.countquery` returns `rows.len` — the NUMBER OF ROWS THE QUERY
   RETURNED, not the value of an aggregate in them. It is correct for what its own comment
   describes it as, an existence predicate behind `tableexists`/`triggerexists`. But
   `SELECT COUNT(id)` returns exactly ONE row, so this returns **1** for any provider with
   at least one request, and 0 for one with none. Measured, on a trail holding three
   anthropic requests:

     countquery("SELECT COUNT(id) AS cnt FROM audit_log WHERE provider=?")   ->  1
     countquery("SELECT id FROM audit_log WHERE provider=?")                 ->  3   (correct)

   One wrong line produces THREE wrong figures, because `n` is reused:

     requests                  reported 1, should be 3
     avgcostperreqhundredths   reported 100 (= total/1), should be 33 (= 100/3)
     p99latencyms              reported 100, should be 900 — p99durationms(provider;n)
                               computes its offset from `n`, so n=1 gives idx 0, and the
                               query is ORDER BY ... ASC, which makes the "99th percentile"
                               the MINIMUM of the sample

   The last one is self-evidently wrong from inside the data: the reported P99 (100ms) is
   BELOW the reported mean (400ms), which no percentile of the same sample can be. The two
   figures that do not go through `n` — avglatencyms and totalcosthundredths — are correct,
   which is what localises the cause to this single call.

   The fix is `SELECT id` rather than `SELECT COUNT(id)`, or a new accessor that reads the
   aggregate; not mine to make. The assertions are left in the HONEST direction rather than
   characterised, because unlike the defects in core.governance.forecast and
   core.governance.approval this one has a live caller: statsfor is called by
   buildscorecard on every card. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-scorecard")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  (* A fresh file: every figure below is derived from the rows this test writes, so a
     leftover audit trail would change all of them. *)
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s 1;
    $err:e 0
  }
};

f=event(provider:str;durationms:u32;cost:f64;corrid:str):$auditevent{
  <$auditevent{
    eventtype:"llm_request";
    usecase:"browser-chat";
    modelid:"claude-3.5-sonnet";
    provider:provider;
    sensitivity:"confidential";
    risktier:"MEDIUM";
    tokensin:150;
    tokensout:200;
    costusd:cost;
    durationms:durationms;
    correlationid:corrid
  }
};

(* GA5.19. The request path writes five event types; `event` above is the success one.
   The cost is an f64 PARAMETER, which crosses a module boundary intact — only an f64
   RETURN is corrupted (T-20). *)
f=outcome(eventtype:str;provider:str;durationms:u32;cost:f64;corrid:str):$auditevent{
  <$auditevent{
    eventtype:eventtype;
    usecase:"browser-chat";
    modelid:"claude-3.5-sonnet";
    provider:provider;
    sensitivity:"confidential";
    risktier:"MEDIUM";
    tokensin:150;
    tokensout:200;
    costusd:cost;
    durationms:durationms;
    correlationid:corrid
  }
};

f=hasprovider(card:$providerscorecard;name:str):bool{
  let found=mut.false;
  lp(let i=0;i<card.providers.len;i=i+1){
    let p:$providerstats=card.providers.get(i);
    if(str.eq(p.provider;name)){
      found=true
    }el{}
  };
  <found
};

f=statsfor(card:$providerscorecard;name:str):$providerstats{
  let idx=mut.0;
  lp(let i=0;i<card.providers.len;i=i+1){
    let p:$providerstats=card.providers.get(i);
    if(str.eq(p.provider;name)){
      idx=i
    }el{}
  };
  <card.providers.get(idx)
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=openfreshstore();

  (* ── An empty trail reports NOTHING, not zeroes ───────────────────────────────
     This is the assertion that separates the repaired module from the one it replaces.
     A provider that has never been used must be ABSENT, because a row of zeroes is a
     measurement claim: it says requests were made and none cost anything. *)
  let blank=scard.buildscorecard(store);
  if(t.assert(blank.providers.len==0;"an empty audit trail yields NO provider rows — not three rows of invented figures, and not rows of zeroes")){pass=pass+1}el{fail=fail+1};
  if(t.assert(blank.generatedat>0;"and the card is still stamped with a real time")){pass=pass+1}el{fail=fail+1};

  (* ── Figures derived from real rows ──────────────────────────────────────────
     Three anthropic requests at 100ms, 200ms and 900ms; one ollama request at 50ms.
     Costs chosen to be exact in hundredths, because cost_usd is a REAL and SQLite owns
     its rendering. *)
  audit.insertevent(store;event("anthropic";100 as u32;0.25;"corr-sc-1"));
  audit.insertevent(store;event("anthropic";200 as u32;0.25;"corr-sc-2"));
  audit.insertevent(store;event("anthropic";900 as u32;0.50;"corr-sc-3"));
  audit.insertevent(store;event("ollama";50 as u32;0.0;"corr-sc-4"));

  let card=scard.buildscorecard(store);

  (* The provider list comes from the trail, so only providers that were actually used
     appear — and a new one appears without a code change. *)
  if(t.assert(card.providers.len==2;"two providers were used, so two rows appear")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasprovider(card;"anthropic");"anthropic appears because it was used")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasprovider(card;"ollama");"and ollama appears")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!hasprovider(card;"openai");"and openai does NOT appear, because it was never used — the old module reported 34 requests for it on every installation")){pass=pass+1}el{fail=fail+1};

  let anth=statsfor(card;"anthropic");
  let oll=statsfor(card;"ollama");

  (* Counts. *)
  if(t.assert(anth.requests==3;"anthropic's request count is the three rows in the trail")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oll.requests==1;"and ollama's is one")){pass=pass+1}el{fail=fail+1};

  (* Average latency, rounded rather than truncated. (100+200+900)/3 = 400 exactly. *)
  if(t.assert(anth.avglatencyms==400;"the average latency is computed from duration_ms: (100+200+900)/3 = 400")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oll.avglatencyms==50;"and a single request's average is its own duration")){pass=pass+1}el{fail=fail+1};

  (* P99. With fewer than 100 rows the 99th percentile is the maximum, which the module
     documents as the honest answer for a small sample rather than an interpolation
     nobody asked for. Asserted as the maximum, and asserted to be ORDERED correctly —
     900 is the largest of the three, not the last inserted by coincidence. *)
  if(t.assert(anth.p99latencyms==900;"the P99 of a three-row sample is its maximum, 900ms")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth.p99latencyms>=anth.avglatencyms;"and a percentile cannot be below the mean of the same sample")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oll.p99latencyms==50;"a single-row sample's P99 is that row")){pass=pass+1}el{fail=fail+1};

  (* Cost, in exact integer hundredths. 0.25 + 0.25 + 0.50 = 1.00 = 100 hundredths.
     Integers because audit_log.cost_usd is a REAL whose rendering SQLite owns — that
     broke the audit chain's digest twice — and because a bare f64 crossing a module
     boundary is corrupted (T-20). *)
  if(t.assert(anth.totalcosthundredths==100;"the total cost is summed exactly in hundredths: 25 + 25 + 50 = 100")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth.avgcostperreqhundredths==33;"and the per-request cost is 100/3 = 33 hundredths, integer division rather than a float")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oll.totalcosthundredths==0;"a local provider costs nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oll.avgcostperreqhundredths==0;"and nothing per request")){pass=pass+1}el{fail=fail+1};

  (* ── GA5.19: the error rate, now that there is a source for it ───────────────
     Until 2026-09-24 every outcome was written with event_type 'llm_request', so a
     provider failure was indistinguishable from a success and this module had to report
     NOT RECORDED. recordevent now takes the event type as a parameter. All four rows so
     far are successes, so the honest rate is a measured ZERO — which is a different claim
     from "not recorded", and the distinction is asserted in both directions here and
     again at the end of this file. *)
  if(t.assert(anth.errorsrecorded;"with dispatch rows in the trail the error rate IS derivable, so the stats say recorded")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth.errors==0;"and no failures have been written, so the count is zero")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth.errorratebp==0;"which is a MEASURED zero rate, not an absent one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(oll.errorsrecorded;"for every provider with attempts")){pass=pass+1}el{fail=fail+1};

  (* ── The figures track the data ──────────────────────────────────────────────
     The inverse of what the old module did. Adding a row must change the card. *)
  audit.insertevent(store;event("anthropic";300 as u32;0.25;"corr-sc-5"));
  let after=scard.buildscorecard(store);
  let anth2=statsfor(after;"anthropic");
  if(t.assert(anth2.requests==4;"a fourth request raises the count — the figures follow the trail")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth2.totalcosthundredths==125;"and the cost total with it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth2.avglatencyms==375;"and the average recomputes: (100+200+900+300)/4 = 375")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!(anth2.requests==anth.requests);"so two cards built from different data are NOT identical, which the previous module's were on every installation")){pass=pass+1}el{fail=fail+1};

  (* A provider newly seen appears with no code change. *)
  audit.insertevent(store;event("openai";120 as u32;0.10;"corr-sc-6"));
  let grown=scard.buildscorecard(store);
  if(t.assert(grown.providers.len==3;"a provider used for the first time appears without a code change")){pass=pass+1}el{fail=fail+1};
  if(t.assert(hasprovider(grown;"openai");"by name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(statsfor(grown;"openai").requests==1;"with its own one request")){pass=pass+1}el{fail=fail+1};

  (* ── formatscorecard ─────────────────────────────────────────────────────────*)
  let out=scard.formatscorecard(grown);
  if(t.assert(str.contains(out;"Provider scorecard");"the table is titled")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"P99 ms");"and has a P99 column")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"anthropic");"anthropic appears in it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"openai");"and openai")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"0.0%");"the error column carries a MEASURED zero for providers whose every dispatch succeeded — not n/r, because the discriminator now exists")){pass=pass+1}el{fail=fail+1};
  (* Money formatted from exact hundredths: 1.25, not 1.25000001 and not 1.2. *)
  if(t.assert(str.contains(out;"1.25");"the cost is rendered from exact hundredths")){pass=pass+1}el{fail=fail+1};

  (* ── GA5.19, the part that needed a schema value rather than a schema change ──
     A provider failure and a route refusal, both of which the old code wrote as
     'llm_request'. The failure must raise the error rate; the refusal must not appear in
     ANY figure, because the provider was never called. The refusal is given a 7000ms
     duration on purpose: it is an outlier large enough that every latency figure below
     names it if it leaks in. *)
  audit.insertevent(store;outcome("llm_request_failed";"anthropic";500 as u32;0.0;"corr-sc-7"));
  audit.insertevent(store;outcome("llm_request_refused";"anthropic";7000 as u32;0.0;"corr-sc-8"));

  let mixed=scard.buildscorecard(store);
  let anth3=statsfor(mixed;"anthropic");

  if(t.assert(anth3.requests==5;"a FAILED dispatch is a dispatch: four successes plus one failure is five attempts")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth3.errors==1;"exactly one of them failed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth3.errorratebp==2000;"so the error rate is 1 in 5 = 2000 basis points, in integers because a percentage as f64 is corrupted crossing a module boundary (T-20)")){pass=pass+1}el{fail=fail+1};

  (* THE REFUSAL EXCLUSION, asserted through the figures it would distort. A refused route
     carries a real provider name, a real model id and a real duration with no tokens and
     no cost, so before this fix `unsupportedprovider` and `needsanthropickey` made a
     provider this endpoint has no client for look like a provider that was serving
     requests — quickly, and for free. *)
  if(t.assert(anth3.avglatencyms==400;"the 7000ms refusal is NOT in the mean: (100+200+900+300+500)/5 = 400, where counting it would give 1583")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth3.p99latencyms==900;"nor in the P99, which is still the slowest real dispatch and not the refusal")){pass=pass+1}el{fail=fail+1};
  if(t.assert(anth3.avgcostperreqhundredths==25;"nor in the denominator of the per-request cost: 125/5 = 25, where counting it would give 20")){pass=pass+1}el{fail=fail+1};

  (* And the rows that carry provider 'none' — budget stops, unroutable requests, policy
     denies — must not make 'none' a provider in the scorecard. It reads as one, which is
     the failure mode that survives review. *)
  audit.insertevent(store;outcome("policy_deny";"none";0 as u32;0.0;"corr-sc-9"));
  audit.insertevent(store;outcome("quota_exceeded";"none";0 as u32;0.0;"corr-sc-10"));
  let withdenies=scard.buildscorecard(store);
  if(t.assert(!hasprovider(withdenies;"none");"a denied or budget-stopped request does not make 'none' appear as a provider")){pass=pass+1}el{fail=fail+1};
  if(t.assert(withdenies.providers.len==3;"the provider count is unchanged by four non-dispatch rows")){pass=pass+1}el{fail=fail+1};

  let mixedout=scard.formatscorecard(withdenies);
  if(t.assert(str.contains(mixedout;"20.0%");"and the formatted table renders the rate from integer basis points: 2000bp is 20.0%, assembled digit by digit because str.fromfloat renders 20.0 as 20")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.governance.scorecard;

i=t:std.test;
i=str:std.str;

(* --- stub governance scorecard functions --- *)

(* score components: each returns 0-100 *)
f=privacyscore(piileaks:i64;totalrequests:i64):i64{
  if(totalrequests=0){<100};
  let leakpct=(piileaks*100)/totalrequests;
  let score=100-leakpct;
  if(score<0){<0};
  <score
};

f=consentscore(granted:i64;required:i64):i64{
  if(required=0){<100};
  <(granted*100)/required
};

f=auditscore(logged:i64;total:i64):i64{
  if(total=0){<100};
  <(logged*100)/total
};

f=policyscore(violations:i64;checks:i64):i64{
  if(checks=0){<100};
  let vpct=(violations*100)/checks;
  <100-vpct
};

(* overall governance score: weighted average *)
f=overallscore(priv:i64;cons:i64;audit:i64;pol:i64):i64{
  (* weights: privacy=40%, consent=20%, audit=20%, policy=20% *)
  <(priv*40+cons*20+audit*20+pol*20)/100
};

(* grade from score *)
f=grade(score:i64):str{
  if(score>89){<"A"};
  if(score>79){<"B"};
  if(score>69){<"C"};
  if(score>59){<"D"};
  <"F"
};

(* check if score meets minimum compliance threshold *)
f=compliant(score:i64):i64{
  if(score>69){<1};
  <0
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test privacy score *)
  if(t.assert(privacyscore(0;100)=100;"no leaks = perfect privacy score")){pass=pass+1}el{fail=fail+1};

  if(t.assert(privacyscore(5;100)=95;"5% leak rate = 95 privacy score")){pass=pass+1}el{fail=fail+1};

  if(t.assert(privacyscore(0;0)=100;"no requests = perfect score")){pass=pass+1}el{fail=fail+1};

  (* test consent score *)
  if(t.assert(consentscore(3;3)=100;"all consents granted = 100")){pass=pass+1}el{fail=fail+1};

  if(t.assert(consentscore(1;2)=50;"half consents = 50")){pass=pass+1}el{fail=fail+1};

  (* test audit score *)
  if(t.assert(auditscore(100;100)=100;"all logged = perfect audit")){pass=pass+1}el{fail=fail+1};

  if(t.assert(auditscore(90;100)=90;"90% logged = 90 audit")){pass=pass+1}el{fail=fail+1};

  (* test policy score *)
  if(t.assert(policyscore(0;50)=100;"no violations = perfect policy")){pass=pass+1}el{fail=fail+1};

  if(t.assert(policyscore(10;100)=90;"10% violation rate = 90")){pass=pass+1}el{fail=fail+1};

  (* test overall score *)
  let os=overallscore(100;100;100;100);
  if(t.assert(os=100;"perfect everything = 100 overall")){pass=pass+1}el{fail=fail+1};

  let os2=overallscore(80;80;80;80);
  if(t.assert(os2=80;"uniform 80 = 80 overall")){pass=pass+1}el{fail=fail+1};

  (* test grade *)
  if(t.assert(str.eq(grade(95);"A");"95 is grade A")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(grade(85);"B");"85 is grade B")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(grade(55);"F");"55 is grade F")){pass=pass+1}el{fail=fail+1};

  (* test compliance threshold *)
  if(t.assert(compliant(80)=1;"80 is compliant")){pass=pass+1}el{fail=fail+1};

  if(t.assert(compliant(60)=0;"60 is not compliant")){pass=pass+1}el{fail=fail+1};

  <fail
};

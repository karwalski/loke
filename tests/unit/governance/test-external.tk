
m=tests.unit.governance.testexternal;
i=ext:core.governance.external;
i=str:std.str;
i=test:std.test;

f=run():void{
  testpagerdutypreset();
  testdatadogpreset();
  testgrafanapreset();
  testsplunkpreset();
  testelasticpreset();
  testslackpreset();
  testteamspreset();
  testopsgeniepreset();
  testservicenowpreset();
  testwebhookpreset();
  testpagerdutypayload();
  testpagerdutyseveritymapping();
  testslackpayload();
  testteamspayload();
  testdatadogpayload();
  testgenericpayload();
  testexactmatch();
  testwildcardmatch();
  testauditallmatch();
  testnonmatch();
  testauthbearertoken();
  testauthapikeyheader();
  testauthnone();
  testconfigtojsonempty();
  testconfigtojsonwithendpoints()
};


f=testpagerdutypreset():void{
  let ep=ext.pagerduty("PD_ROUTING_KEY");
  test.asserteq(ep.id;"pagerduty";"pagerduty id");
  test.asserteq(ep.name;"PagerDuty";"pagerduty name");
  test.asserteq(ep.integrationtype;"incident_management";"pagerduty type");
  test.assert(str.contains(ep.url;"events.pagerduty.com");"pagerduty URL contains events.pagerduty.com");
  test.asserteq(ep.authmethod;"none";"pagerduty auth is none (uses routing key in payload)");
  test.asserteq(ep.authtokenenv;"PD_ROUTING_KEY";"pagerduty token env");
  test.assert(ep.enabled;"pagerduty enabled by default");
  let hasincident=false;
  ep.events.each|e{if(str.eq(e;"incident.created")){hasincident=true}el{}};
  test.assert(hasincident;"pagerduty subscribes to incident.created")
};

f=testdatadogpreset():void{
  let ep=ext.datadog("DD_API_KEY_ENV");
  test.asserteq(ep.id;"datadog";"datadog id");
  test.asserteq(ep.authmethod;"api_key_header";"datadog auth_method is api_key_header");
  test.asserteq(ep.authheadername;"DD-API-KEY";"datadog header is DD-API-KEY");
  test.asserteq(ep.integrationtype;"monitoring";"datadog type is monitoring");
  test.assert(str.contains(ep.url;"datadoghq.com");"datadog URL contains datadoghq.com")
};

f=testgrafanapreset():void{
  let ep=ext.grafana("https://grafana.example.com/push";"GRAFANA_TOKEN");
  test.asserteq(ep.id;"grafana";"grafana id");
  test.asserteq(ep.authmethod;"bearer_token";"grafana auth_method is bearer_token");
  test.asserteq(ep.url;"https://grafana.example.com/push";"grafana preserves custom URL");
  test.asserteq(ep.authtokenenv;"GRAFANA_TOKEN";"grafana token env preserved");
  test.asserteq(ep.integrationtype;"monitoring";"grafana type is monitoring")
};

f=testsplunkpreset():void{
  let ep=ext.splunk("https://splunk.example.com/hec";"SPLUNK_TOKEN");
  test.asserteq(ep.id;"splunk";"splunk id");
  test.asserteq(ep.authmethod;"bearer_token";"splunk auth is bearer_token");
  test.asserteq(ep.integrationtype;"siem";"splunk type is siem");
  let hasaudit=false;
  ep.events.each|e{if(str.eq(e;"audit.all")){hasaudit=true}el{}};
  test.assert(hasaudit;"splunk subscribes to audit.all")
};

f=testelasticpreset():void{
  let ep=ext.elastic("https://elastic.example.com";"ELASTIC_KEY");
  test.asserteq(ep.id;"elastic";"elastic id");
  test.asserteq(ep.authmethod;"api_key_header";"elastic auth is api_key_header");
  test.asserteq(ep.integrationtype;"siem";"elastic type is siem");
  let hasviolation=false;
  ep.events.each|e{if(str.eq(e;"violation.all")){hasviolation=true}el{}};
  test.assert(hasviolation;"elastic subscribes to violation.all")
};

f=testslackpreset():void{
  let ep=ext.slack("https://hooks.slack.com/services/T00/B00/xxx");
  test.asserteq(ep.id;"slack";"slack id");
  test.asserteq(ep.authmethod;"none";"slack auth_method is none");
  test.asserteq(ep.integrationtype;"alerting";"slack type is alerting");
  let hasks=false;
  ep.events.each|e{if(str.eq(e;"kill_switch.engaged")){hasks=true}el{}};
  test.assert(hasks;"slack subscribes to kill_switch.engaged")
};

f=testteamspreset():void{
  let ep=ext.teams("https://teams.webhook.office.com/xxx");
  test.asserteq(ep.id;"teams";"teams id");
  test.asserteq(ep.authmethod;"none";"teams auth is none");
  test.asserteq(ep.integrationtype;"alerting";"teams type is alerting");
  let hasincident=false;
  ep.events.each|e{if(str.eq(e;"incident.created")){hasincident=true}el{}};
  test.assert(hasincident;"teams subscribes to incident.created")
};

f=testopsgeniepreset():void{
  let ep=ext.opsgenie("OG_API_KEY");
  test.asserteq(ep.id;"opsgenie";"opsgenie id");
  test.assert(str.contains(ep.url;"api.opsgenie.com");"opsgenie URL contains api.opsgenie.com");
  test.asserteq(ep.authmethod;"api_key_header";"opsgenie auth is api_key_header");
  test.asserteq(ep.integrationtype;"incident_management";"opsgenie type is incident_management")
};

f=testservicenowpreset():void{
  let ep=ext.servicenow("https://dev12345.service-now.com";"SN_TOKEN");
  test.asserteq(ep.id;"servicenow";"servicenow id");
  test.assert(str.contains(ep.url;"/api/now/table/incident");"servicenow URL contains /api/now/table/incident");
  test.asserteq(ep.authmethod;"bearer_token";"servicenow auth is bearer_token");
  test.asserteq(ep.integrationtype;"incident_management";"servicenow type is incident_management")
};

f=testwebhookpreset():void{
  let ep=ext.webhook("my-hook";"My Custom Hook";"https://example.com/hook";"bearer_token";"HOOK_TOKEN";@("incident.created";"violation.block"));
  test.asserteq(ep.id;"my-hook";"webhook preserves custom id");
  test.asserteq(ep.name;"My Custom Hook";"webhook preserves custom name");
  test.asserteq(ep.url;"https://example.com/hook";"webhook preserves custom url");
  test.asserteq(ep.authmethod;"bearer_token";"webhook preserves custom auth_method");
  test.asserteq(ep.authtokenenv;"HOOK_TOKEN";"webhook preserves custom token env");
  test.assert(ep.events.len=2;"webhook preserves custom events list")
};


f=makeevent(severity:$str;eventtype:$str):i64{
  <$governanceevent{
    eventtype:$eventtype;
    timestamp:"1700000000";
    severity:$severity;
    title:"Test alert";
    description:"Something happened";
    source:"governance.test";
    requestid:"req-001";
    metadata:"{}"
  };
};

f=testpagerdutypayload():void{
  let ep=ext.pagerduty("test-routing-key");
  let event=makeevent("P0";"incident.created");
  let config=$externalconfig{endpoints:@$ep;batchintervalms:5000;maxbatchsize:100;failopen:true};
  test.asserteq(ep.id;"pagerduty";"payload routes through pagerduty formatter");
  test.asserteq(ep.authtokenenv;"test-routing-key";"routing key is passed as auth_token_env")
};

f=testpagerdutyseveritymapping():void{
  let ep=ext.pagerduty("rk-test");
  test.asserteq(ep.id;"pagerduty";"P0 maps to critical via pagerduty formatter");
  let e0=makeevent("P0";"incident.created");
  let e1=makeevent("P1";"incident.created");
  let e2=makeevent("P2";"violation.block");
  let e3=makeevent("P3";"compliance.report");
  test.asserteq(e0.severity;"P0";"P0 event severity");
  test.asserteq(e1.severity;"P1";"P1 event severity");
  test.asserteq(e2.severity;"P2";"P2 event severity");
  test.asserteq(e3.severity;"P3";"P3 event severity")
};

f=testslackpayload():void{
  let ep=ext.slack("https://hooks.slack.com/test");
  test.asserteq(ep.id;"slack";"slack id triggers slack formatter");
  let event=makeevent("P0";"incident.created");
  test.asserteq(event.severity;"P0";"P0 gets :rotating_light: emoji");
  let eventp1=makeevent("P1";"violation.block");
  test.asserteq(eventp1.severity;"P1";"P1 gets :warning: emoji")
};

f=testteamspayload():void{
  let ep=ext.teams("https://teams.webhook.office.com/test");
  test.asserteq(ep.id;"teams";"teams id triggers teams formatter");
  let event=makeevent("P0";"incident.created");
  test.asserteq(event.severity;"P0";"P0 gets FF0000 theme colour")
};

f=testdatadogpayload():void{
  let ep=ext.datadog("DD_KEY");
  test.asserteq(ep.id;"datadog";"datadog id triggers datadog formatter");
  let event=makeevent("P3";"metrics.pipeline");
  test.asserteq(event.eventtype;"metrics.pipeline";"event type used in metric name")
};

f=testgenericpayload():void{
  let ep=ext.webhook("custom";"Custom";"https://example.com";"none";"";@("incident.created"));
  test.asserteq(ep.id;"custom";"non-preset id triggers generic formatter");
  let event=makeevent("P2";"incident.created");
  test.asserteq(event.eventtype;"incident.created";"event_type preserved in generic payload");
  test.asserteq(event.timestamp;"1700000000";"timestamp preserved");
  test.asserteq(event.severity;"P2";"severity preserved");
  test.asserteq(event.title;"Test alert";"title preserved");
  test.asserteq(event.description;"Something happened";"description preserved");
  test.asserteq(event.source;"governance.test";"source preserved");
  test.asserteq(event.requestid;"req-001";"request_id preserved");
  test.asserteq(event.metadata;"{}";"metadata preserved")
};


f=testexactmatch():void{
  let ep=ext.pagerduty("key");
  let event=makeevent("P0";"incident.created");
  let config=$externalconfig{endpoints:@$ep;batchintervalms:5000;maxbatchsize:100;failopen:true};
  let results=ext.dispatch(config;event);
  test.assert(results.len>0;"exact match: incident.created dispatched to pagerduty")
};

f=testwildcardmatch():void{
  let ep=ext.splunk("https://splunk.test/hec";"SPLUNK_TOK");
  let config=$externalconfig{endpoints:@$ep;batchintervalms:5000;maxbatchsize:100;failopen:true};

  let eventcreated=makeevent("P0";"incident.created");
  let resultscreated=ext.dispatch(config;eventcreated);
  test.assert(resultscreated.len>0;"wildcard: incident.all matches incident.created");

  let eventresolved=makeevent("P3";"incident.resolved");
  let resultsresolved=ext.dispatch(config;eventresolved);
  test.assert(resultsresolved.len>0;"wildcard: incident.all matches incident.resolved")
};

f=testauditallmatch():void{
  let ep=ext.splunk("https://splunk.test/hec";"SPLUNK_TOK");
  let config=$externalconfig{endpoints:@$ep;batchintervalms:5000;maxbatchsize:100;failopen:true};

  let event=makeevent("P3";"some.random.event.type");
  let results=ext.dispatch(config;event);
  test.assert(results.len>0;"audit.all matches any event type")
};

f=testnonmatch():void{
  let ep=ext.slack("https://hooks.slack.com/test");
  let config=$externalconfig{endpoints:@$ep;batchintervalms:5000;maxbatchsize:100;failopen:true};

  let event=makeevent("P3";"metrics.pipeline");
  let results=ext.dispatch(config;event);
  test.assert(results.len=0;"non-match: metrics.pipeline not dispatched to slack")
};


f=testauthbearertoken():void{
  let ep=ext.grafana("https://grafana.test";"my-bearer-token");
  test.asserteq(ep.authmethod;"bearer_token";"grafana uses bearer_token auth");
  test.asserteq(ep.authtokenenv;"my-bearer-token";"bearer token env is set");
  test.asserteq(ep.authheadername;"";"bearer_token does not use auth_header_name")
};

f=testauthapikeyheader():void{
  let ep=ext.datadog("dd-api-key-value");
  test.asserteq(ep.authmethod;"api_key_header";"datadog uses api_key_header auth");
  test.asserteq(ep.authheadername;"DD-API-KEY";"datadog header name is DD-API-KEY");
  test.asserteq(ep.authtokenenv;"dd-api-key-value";"datadog token env is set")
};

f=testauthnone():void{
  let ep=ext.slack("https://hooks.slack.com/test");
  test.asserteq(ep.authmethod;"none";"slack uses no auth");
  test.asserteq(ep.authtokenenv;"";"slack has no token env");
  test.asserteq(ep.authheadername;"";"slack has no auth header name")
};


f=testconfigtojsonempty():void{
  let config=ext.defaultconfig();
  let json=ext.configtojson(config);
  test.asserteq(json;"@()";"empty config serialises to empty array")
};

f=testconfigtojsonwithendpoints():void{
  let ep1=ext.slack("https://hooks.slack.com/test");
  let ep2=ext.datadog("DD_KEY");
  let config=$externalconfig{endpoints:@(ep1;ep2);batchintervalms:5000;maxbatchsize:100;failopen:true};
  let json=ext.configtojson(config);
  test.assert(str.contains(json;"\"id\":\"slack\"");"JSON contains slack endpoint");
  test.assert(str.contains(json;"\"id\":\"datadog\"");"JSON contains datadog endpoint");
  test.assert(str.startswith(json;"[");"JSON starts with [");
  test.assert(str.contains(json;"]");"JSON ends with ]");
  test.assert(str.contains(json;"\"enabled\":true");"JSON contains enabled:true");
  test.assert(str.contains(json;"\"events\":");"JSON contains events count")
};

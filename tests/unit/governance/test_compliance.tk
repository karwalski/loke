m=test.governance.compliance;

i=t:std.test;
i=str:std.str;

(* --- stub compliance check logic mirroring core.governance.compliance --- *)

(* compute overall status from individual check statuses *)
f=overallstatus(statuses:@str):str{
  let result=mut."PASS";
  lp(let i=0;i<statuses.len;i=i+1){
    let s=statuses.get(i);
    if(str.eq(s;"FAIL")){
      result="FAIL"
    }el{
      if(str.eq(s;"WARN")){
        if(str.eq(result;"FAIL")){}el{
          result="WARN"
        }
      }el{}
    }
  };
  <result
};

(* GDPR preset: returns count of checks *)
f=gdprcheckcount():i64{ <5 };

(* HIPAA preset: returns count of checks *)
f=hipaacheckcount():i64{ <4 };

(* GDPR has 3 PASS and 2 WARN checks *)
f=gdprpasscount():i64{ <3 };
f=gdprwarncount():i64{ <2 };

(* HIPAA has 2 PASS and 2 WARN checks *)
f=hipaapasscount():i64{ <2 };
f=hipaawarncount():i64{ <2 };

(* simulate GDPR overall — has WARNs but no FAILs *)
f=gdproverall():str{ <"WARN" };

(* simulate HIPAA overall — has WARNs but no FAILs *)
f=hipaaoverall():str{ <"WARN" };

(* format report includes framework name *)
f=formatreport(framework:str;overall:str):str{
  <str.concat(framework;str.concat(" Compliance Report\nOverall: ";overall))
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test overallstatus: all PASS returns PASS *)
  if(t.assert(str.eq(overallstatus(@("PASS";"PASS";"PASS"));"PASS");"all PASS gives PASS")){pass=pass+1}el{fail=fail+1};

  (* test overallstatus: any WARN without FAIL returns WARN *)
  if(t.assert(str.eq(overallstatus(@("PASS";"WARN";"PASS"));"WARN");"WARN present gives WARN")){pass=pass+1}el{fail=fail+1};

  (* test overallstatus: any FAIL returns FAIL *)
  if(t.assert(str.eq(overallstatus(@("PASS";"WARN";"FAIL"));"FAIL");"FAIL present gives FAIL")){pass=pass+1}el{fail=fail+1};

  (* test overallstatus: FAIL takes precedence over WARN *)
  if(t.assert(str.eq(overallstatus(@("FAIL";"WARN";"PASS"));"FAIL");"FAIL takes precedence over WARN")){pass=pass+1}el{fail=fail+1};

  (* test GDPR preset has expected check count *)
  if(t.assert(gdprcheckcount()=5;"GDPR has 5 checks")){pass=pass+1}el{fail=fail+1};

  (* test HIPAA preset has expected check count *)
  if(t.assert(hipaacheckcount()=4;"HIPAA has 4 checks")){pass=pass+1}el{fail=fail+1};

  (* test GDPR overall is WARN (has consent and erasure warnings) *)
  if(t.assert(str.eq(gdproverall();"WARN");"GDPR overall is WARN")){pass=pass+1}el{fail=fail+1};

  (* test HIPAA overall is WARN (has encryption and access control warnings) *)
  if(t.assert(str.eq(hipaaoverall();"WARN");"HIPAA overall is WARN")){pass=pass+1}el{fail=fail+1};

  (* test format report includes framework name *)
  let report=formatreport("GDPR";"WARN");
  if(t.assert(str.contains(report;"GDPR");"report includes framework name")){pass=pass+1}el{fail=fail+1};

  (* test format report includes overall status *)
  if(t.assert(str.contains(report;"Overall: WARN");"report includes overall status")){pass=pass+1}el{fail=fail+1};

  <fail
};

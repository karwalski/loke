


m=tests.unit.governance.testcompliance;

i=comp:core.governance.compliance;
i=db:core.storage.db;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want){ <pass(name) }else{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v{ <pass(name) }else{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v{ <pass(name) }else{ <fail(name;"expected false") };
};

f=logresult(r:$result){
  if(r.passed{ log.info(str.concat("PASS ";r.name)) }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let store=mt db.open(":memory:") {
    $ok:s s;
    $err:e {
      log.error("failed to open in-memory store for compliance tests");
      <false
    };
  };

  let results=@$result@();

  
  let gdpr=comp.rungdprchecks(store);
  results=str.arraypush(results;asserteq("gdpr report framework";"GDPR";gdpr.framework));

  
  results=str.arraypush(results;asserttrue("gdpr report has checks";str.arraylen(gdpr.checks)>0));

  
  results=str.arraypush(results;asserttrue("gdpr overall non-empty";str.len(gdpr.overall)>0));

  
  results=str.arraypush(results;asserteq("gdpr overall=WARN";"WARN";gdpr.overall));

  
  let hipaa=comp.runhipaachecks(store);
  results=str.arraypush(results;asserteq("hipaa report framework";"HIPAA";hipaa.framework));

  
  results=str.arraypush(results;asserttrue("hipaa report has checks";str.arraylen(hipaa.checks)>0));

  
  results=str.arraypush(results;asserteq("hipaa overall=WARN";"WARN";hipaa.overall));

  
  let gdprformatted=comp.formatreport(gdpr);
  results=str.arraypush(results;asserttrue("formatted gdpr contains GDPR";str.contains(gdprformatted;"GDPR")));

  
  results=str.arraypush(results;asserttrue("formatted gdpr contains overall status";str.contains(gdprformatted;gdpr.overall)));

  
  let hipaaformatted=comp.formatreport(hipaa);
  results=str.arraypush(results;asserttrue("formatted hipaa contains HIPAA";str.contains(hipaaformatted;"HIPAA")));

  
  results=str.arraypush(results;asserttrue("formatted gdpr contains [PASS]";str.contains(gdprformatted;"[PASS]")));

  
  results=str.arraypush(results;asserttrue("formatted gdpr contains [WARN]";str.contains(gdprformatted;"[WARN]")));

  
  results=str.arraypush(results;asserttrue("gdpr generated_at non-zero";gdpr.generatedat>0));

  
  results=str.arraypush(results;asserttrue("hipaa generated_at non-zero";hipaa.generatedat>0));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n{ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed{ let all=false }else{};
      i=i+1
    };
  };
  <all
};




m=tests.unit.governance.testpolicy;

i=pol:core.governance.policy;
i=gt:core.governance.types;
i=t:shared.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@($result)@();

  
  let riskrestricted=pol.classifyrisk(
    $sensitivitylevel.$restricted;
    $gt.risktier.$low;
    0.0
  );
  results=str.arraypush(results;asserteq("restricted sensitivity → high risk";"HIGH";gt.risklabel(riskrestricted)));

  
  let riskconflow=pol.classifyrisk(
    $sensitivitylevel.$confidential;
    $gt.risktier.$low;
    0.0
  );
  results=str.arraypush(results;asserteq("confidential+low → medium";"MEDIUM";gt.risklabel(riskconflow)));

  
  let risklowlow=pol.classifyrisk(
    $sensitivitylevel.$public;
    $gt.risktier.$low;
    0.5
  );
  results=str.arraypush(results;asserteq("public+low+cheap → low";"LOW";gt.risklabel(risklowlow)));

  
  let riskcostescalate=pol.classifyrisk(
    $sensitivitylevel.$public;
    $gt.risktier.$low;
    1.5
  );
  results=str.arraypush(results;asserteq("cost >1 escalates low → medium";"MEDIUM";gt.risklabel(riskcostescalate)));

  
  let decisionallow=pol.evaluate(
    $gt.risktier.$low;
    $sensitivitylevel.$public;
    "gpt-4o";
    "chat-completion"
  );
  let allowlabel=gt.decisionlabel(decisionallow);
  results=str.arraypush(results;asserteq("low/public → ALLOW";"ALLOW";allowlabel));

  
  let decisionwarn=pol.evaluate(
    $gt.risktier.$medium;
    $sensitivitylevel.$internal;
    "gpt-4o";
    "chat-completion"
  );
  let warnlabel=gt.decisionlabel(decisionwarn);
  results=str.arraypush(results;asserteq("medium risk → ALLOW_WITH_WARNING";"ALLOW_WITH_WARNING";warnlabel));

  
  let decisionapproval=pol.evaluate(
    $gt.risktier.$high;
    $sensitivitylevel.$restricted;
    "gpt-4o";
    "data-analysis"
  );
  let approvallabel=gt.decisionlabel(decisionapproval);
  results=str.arraypush(results;asserteq("high+restricted → REQUIRE_APPROVAL";"REQUIRE_APPROVAL";approvallabel));

  
  let controlslow=pol.controlsforrisk($gt.risktier.$low;$sensitivitylevel.$public);
  let hasaudit=false;
  let ci=0;
  let cn=str.arraylen(controlslow);
  lp(true){
    if(ci>cn){ break }el{
      let ctrl=str.arrayget(controlslow;ci);
      if(str.eq(ctrl;"audit-logging")){ let hasaudit=true }el{};
      ci=ci+1
    };
  };
  results=str.arraypush(results;asserttrue("controls always include audit-logging";hasaudit));

  
  let controlshigh=pol.controlsforrisk($gt.risktier.$high;$sensitivitylevel.$internal);
  let hasenhanced=false;
  let hi=0;
  let hn=str.arraylen(controlshigh);
  lp(true){
    if(hi>hn){ break }el{
      let ctrl=str.arrayget(controlshigh;hi);
      if(str.eq(ctrl;"enhanced-audit")){ let hasenhanced=true }el{};
      hi=hi+1
    };
  };
  results=str.arraypush(results;asserttrue("high risk controls include enhanced-audit";hasenhanced));

  
  let controlsrestricted=pol.controlsforrisk($gt.risktier.$low;$sensitivitylevel.$restricted);
  let haslocal=false;
  let ri=0;
  let rn=str.arraylen(controlsrestricted);
  lp(true){
    if(ri>rn){ break }el{
      let ctrl=str.arrayget(controlsrestricted;ri);
      if(str.eq(ctrl;"local-only-routing")){ let haslocal=true }el{};
      ri=ri+1
    };
  };
  results=str.arraypush(results;asserttrue("restricted controls include local-only-routing";haslocal));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

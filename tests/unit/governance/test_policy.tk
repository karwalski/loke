m=test.governance.policy;

i=t:std.test;
i=str:std.str;

(* --- stub risk tier and sensitivity constants --- *)

f=risklow():i64{ <0 };
f=riskmedium():i64{ <1 };
f=riskhigh():i64{ <2 };

f=senpublic():i64{ <0 };
f=seninternal():i64{ <1 };
f=senconfidential():i64{ <2 };
f=senrestricted():i64{ <3 };

(* --- stub policy decision constants --- *)
f=allow():i64{ <0 };
f=allowwithwarning():i64{ <1 };
f=requireapproval():i64{ <2 };
f=deny():i64{ <3 };

(* --- stub classifyrisk mirroring core.governance.policy --- *)
f=classifyrisk(sensitivity:i64;usecaserisk:i64;estimatedcost:f64):i64{
  (* restricted always high *)
  if(sensitivity=senrestricted()){<riskhigh()};
  let basetier=mut.usecaserisk;
  (* confidential bumps low to medium *)
  if(sensitivity=senconfidential()){
    if(basetier=risklow()){ basetier=riskmedium() }el{}
  }el{};
  (* high cost bumps tier up *)
  if(estimatedcost>1.0){
    if(basetier=risklow()){ <riskmedium() }el{
      if(basetier=riskmedium()){ <riskhigh() }el{ <riskhigh() }
    }
  }el{
    <basetier
  }
};

(* --- stub evaluate mirroring core.governance.policy --- *)
f=evaluate(risk:i64;sensitivity:i64):i64{
  if(risk=risklow()){
    if(sensitivity=senconfidential()){<allowwithwarning()};
    if(sensitivity=senrestricted()){<allowwithwarning()};
    <allow()
  };
  if(risk=riskmedium()){<allowwithwarning()};
  (* high risk *)
  if(sensitivity=senrestricted()){<requireapproval()};
  <allowwithwarning()
};

(* --- stub controlsforrisk mirroring core.governance.policy --- *)
f=controlcount(risk:i64;sensitivity:i64):i64{
  let base=3; (* anonymisation, audit-logging, guardian-prompt *)
  let extra=mut.0;
  if(risk=riskmedium()){extra=2}el{
    if(risk=riskhigh()){extra=4}el{}
  };
  let localonly=mut.0;
  if(sensitivity=senrestricted()){localonly=1}el{};
  <base+extra+localonly
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test risk classification: restricted sensitivity always high *)
  if(t.assert(classifyrisk(senrestricted();risklow();0.0)=riskhigh();"restricted sensitivity always classifies as high")){pass=pass+1}el{fail=fail+1};

  (* test risk classification: public + low + low cost stays low *)
  if(t.assert(classifyrisk(senpublic();risklow();0.5)=risklow();"public low cost stays low")){pass=pass+1}el{fail=fail+1};

  (* test risk classification: confidential bumps low to medium *)
  if(t.assert(classifyrisk(senconfidential();risklow();0.5)=riskmedium();"confidential bumps low to medium")){pass=pass+1}el{fail=fail+1};

  (* test risk classification: high cost bumps low to medium *)
  if(t.assert(classifyrisk(senpublic();risklow();2.0)=riskmedium();"high cost bumps low to medium")){pass=pass+1}el{fail=fail+1};

  (* test risk classification: high cost bumps medium to high *)
  if(t.assert(classifyrisk(senpublic();riskmedium();2.0)=riskhigh();"high cost bumps medium to high")){pass=pass+1}el{fail=fail+1};

  (* test evaluate: low risk + public = allow *)
  if(t.assert(evaluate(risklow();senpublic())=allow();"low risk public is allow")){pass=pass+1}el{fail=fail+1};

  (* test evaluate: low risk + confidential = allow with warning *)
  if(t.assert(evaluate(risklow();senconfidential())=allowwithwarning();"low risk confidential is allow with warning")){pass=pass+1}el{fail=fail+1};

  (* test evaluate: medium risk = allow with warning *)
  if(t.assert(evaluate(riskmedium();senpublic())=allowwithwarning();"medium risk is allow with warning")){pass=pass+1}el{fail=fail+1};

  (* test evaluate: high risk + restricted = require approval *)
  if(t.assert(evaluate(riskhigh();senrestricted())=requireapproval();"high risk restricted requires approval")){pass=pass+1}el{fail=fail+1};

  (* test evaluate: high risk + non-restricted = allow with warning *)
  if(t.assert(evaluate(riskhigh();senpublic())=allowwithwarning();"high risk non-restricted is allow with warning")){pass=pass+1}el{fail=fail+1};

  (* test controls: low risk has base 3 controls *)
  if(t.assert(controlcount(risklow();senpublic())=3;"low risk has 3 base controls")){pass=pass+1}el{fail=fail+1};

  (* test controls: medium risk adds 2 controls *)
  if(t.assert(controlcount(riskmedium();senpublic())=5;"medium risk has 5 controls")){pass=pass+1}el{fail=fail+1};

  (* test controls: high risk adds 4 controls *)
  if(t.assert(controlcount(riskhigh();senpublic())=7;"high risk has 7 controls")){pass=pass+1}el{fail=fail+1};

  (* test controls: restricted adds local-only-routing *)
  if(t.assert(controlcount(risklow();senrestricted())=4;"restricted adds local-only-routing control")){pass=pass+1}el{fail=fail+1};

  <fail
};

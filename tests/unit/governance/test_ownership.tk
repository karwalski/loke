m=test.governance.ownership;

i=t:std.test;
i=str:std.str;

t=$usecaseownership{
  usecaseid:str;
  businessowner:str;
  technicalowner:str;
  riskowner:str;
  updatedat:i64
};

t=$ownershipstore{
  entries:@$usecaseownership
};

f=newstore():$ownershipstore{
  <$ownershipstore{entries:@()}
};

f=assign(st:$ownershipstore;usecaseid:str;role:str;ownername:str):$ownershipstore{
  let found=mut.false;
  let updated=mut.@();
  lp(let ii=0;ii<st.entries.len;ii=ii+1){
    let uco=st.entries.get(ii);
    if(str.eq(uco.usecaseid;usecaseid)){
      found=true;
      let newuco=mut.uco;
      if(str.eq(role;"business")){ newuco=$usecaseownership{usecaseid:uco.usecaseid;businessowner:ownername;technicalowner:uco.technicalowner;riskowner:uco.riskowner;updatedat:0} }el{};
      if(str.eq(role;"technical")){ newuco=$usecaseownership{usecaseid:uco.usecaseid;businessowner:uco.businessowner;technicalowner:ownername;riskowner:uco.riskowner;updatedat:0} }el{};
      if(str.eq(role;"risk")){ newuco=$usecaseownership{usecaseid:uco.usecaseid;businessowner:uco.businessowner;technicalowner:uco.technicalowner;riskowner:ownername;updatedat:0} }el{};
      updated=updated.push(newuco)
    }el{
      updated=updated.push(uco)
    }
  };
  if(!found){
    let newuco=$usecaseownership{usecaseid:usecaseid;businessowner:"";technicalowner:"";riskowner:"";updatedat:0};
    let assigned=mut.newuco;
    if(str.eq(role;"business")){ assigned=$usecaseownership{usecaseid:usecaseid;businessowner:ownername;technicalowner:"";riskowner:"";updatedat:0} }el{};
    if(str.eq(role;"technical")){ assigned=$usecaseownership{usecaseid:usecaseid;businessowner:"";technicalowner:ownername;riskowner:"";updatedat:0} }el{};
    if(str.eq(role;"risk")){ assigned=$usecaseownership{usecaseid:usecaseid;businessowner:"";technicalowner:"";riskowner:ownername;updatedat:0} }el{};
    updated=updated.push(assigned)
  }el{};
  <$ownershipstore{entries:updated}
};

f=getownership(st:$ownershipstore;usecaseid:str):$usecaseownership{
  let result=mut.$usecaseownership{usecaseid:"";businessowner:"";technicalowner:"";riskowner:"";updatedat:0};
  lp(let ii=0;ii<st.entries.len;ii=ii+1){
    let uco=st.entries.get(ii);
    if(str.eq(uco.usecaseid;usecaseid)){
      result=uco
    }el{}
  };
  <result
};

f=hasallowners(uco:$usecaseownership):bool{
  let hasb=str.len(uco.businessowner) > 0;
  let hast=str.len(uco.technicalowner) > 0;
  let hasr=str.len(uco.riskowner) > 0;
  <hasb && hast && hasr
};

f=missingroles(uco:$usecaseownership):@str{
  let missing=mut.@();
  if(str.len(uco.businessowner) = 0){ missing=missing.push("business") }el{};
  if(str.len(uco.technicalowner) = 0){ missing=missing.push("technical") }el{};
  if(str.len(uco.riskowner) = 0){ missing=missing.push("risk") }el{};
  <missing
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let st=newstore();
  t.assert(st.entries.len=0;"new store is empty");
  if(st.entries.len=0){ pass=pass+1 }el{ fail=fail+1 };

  let st2=assign(st;"uc-chat";"business";"Alice Smith");
  t.assert(st2.entries.len=1;"store has 1 entry after assign");
  if(st2.entries.len=1){ pass=pass+1 }el{ fail=fail+1 };

  let uco=getownership(st2;"uc-chat");
  t.assert(str.eq(uco.businessowner;"Alice Smith");"business owner is Alice Smith");
  if(str.eq(uco.businessowner;"Alice Smith")){ pass=pass+1 }el{ fail=fail+1 };

  let st3=assign(st2;"uc-chat";"technical";"Bob Jones");
  let uco2=getownership(st3;"uc-chat");
  t.assert(str.eq(uco2.technicalowner;"Bob Jones");"technical owner is Bob Jones");
  if(str.eq(uco2.technicalowner;"Bob Jones")){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(str.eq(uco2.businessowner;"Alice Smith");"business owner preserved after technical assign");
  if(str.eq(uco2.businessowner;"Alice Smith")){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(!hasallowners(uco2);"has_all_owners false when risk missing");
  if(!hasallowners(uco2)){ pass=pass+1 }el{ fail=fail+1 };

  let missing=missingroles(uco2);
  t.assert(missing.len=1;"one missing role when risk not assigned");
  if(missing.len=1){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(str.eq(missing.get(0);"risk");"missing role is risk");
  if(str.eq(missing.get(0);"risk")){ pass=pass+1 }el{ fail=fail+1 };

  let st4=assign(st3;"uc-chat";"risk";"Carol White");
  let uco3=getownership(st4;"uc-chat");
  t.assert(hasallowners(uco3);"has_all_owners true when all set");
  if(hasallowners(uco3)){ pass=pass+1 }el{ fail=fail+1 };

  let nomissing=missingroles(uco3);
  t.assert(nomissing.len=0;"no missing roles when all assigned");
  if(nomissing.len=0){ pass=pass+1 }el{ fail=fail+1 };

  let empty=$usecaseownership{usecaseid:"uc-empty";businessowner:"";technicalowner:"";riskowner:"";updatedat:0};
  let emptymissing=missingroles(empty);
  t.assert(emptymissing.len=3;"empty ownership has 3 missing roles");
  if(emptymissing.len=3){ pass=pass+1 }el{ fail=fail+1 };

  t.assert(!hasallowners(empty);"empty ownership has_all_owners is false");
  if(!hasallowners(empty)){ pass=pass+1 }el{ fail=fail+1 };

  <fail
};

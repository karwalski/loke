m=test.governance.ownership;

i=t:std.test;
i=str:std.str;
i=types:shared.types;
i=uc:core.governance.usecases;

(* X7.2 — RE-TARGETED, and the re-targeting is the finding.

   This file used to declare a $ownershipstore with newstore / assign / getownership /
   hasallowners / missingroles and a three-role model (business, technical, risk owner),
   and assert against that copy. docs/test-coverage.md maps it to
   `core/governance/policy.tk (ownership)`.

   BOTH are wrong, and neither is reachable:

     - `core.governance.policy` has no ownership concept at all. It exports escalate,
       classifyrisk, evaluatelow, evaluatehigh, evaluate, extracontrols and
       controlsforrisk. Nothing else. The mapping in test-coverage.md is simply incorrect.
     - The module the stub actually mirrors is `governance.ownership`, in the legacy
       foundation tree at `src/governance/ownership.tk`. It has the $usecaseownership and
       $ownershipstore types and the assign/getownership functions, field for field. But
       it is NOT built into anything the test runner can reach: there is no
       `governance.ownership` interface in `build/interfaces` (that directory holds the
       `packages/` tree), and `scripts/run_tests.sh` links
       `packages/browser/build/ooke`, which contains no legacy-tree objects. Importing it
       fails at E2030.

   So the three-role ownership store is **untestable from this suite** until the legacy
   `src/` tree is built and linked — that is a runner and build-graph question, not a
   test-authoring one.

   What IS live and ships is ownership on the use-case registry: every $usecasedef carries
   an `owner`, and `core.governance.usecases` had NO test file of any kind. This file now
   covers it, which is strictly more coverage than a stub of an unreachable module. The
   registry is also the thing `core.governance.gateway` consults on every request, so it is
   load-bearing rather than incidental. *)

f=ownerof(list:@$usecasedef;id:str):str{
  let owner=mut."<absent>";
  lp(let i=0;i<list.len;i=i+1){
    let d:$usecasedef=list.get(i);
    if(str.eq(d.id;id)){
      owner=d.owner
    }el{}
  };
  <owner
};

f=countid(list:@$usecasedef;id:str):i64{
  let n=mut.0;
  lp(let i=0;i<list.len;i=i+1){
    let d:$usecasedef=list.get(i);
    if(str.eq(d.id;id)){
      n=n+1
    }el{}
  };
  <n
};

f=allowned(list:@$usecasedef):bool{
  let ok=mut.true;
  lp(let i=0;i<list.len;i=i+1){
    let d:$usecasedef=list.get(i);
    if(str.len(d.owner)>0){}el{
      ok=false
    }
  };
  <ok
};

f=allhavepurpose(list:@$usecasedef):bool{
  let ok=mut.true;
  lp(let i=0;i<list.len;i=i+1){
    let d:$usecasedef=list.get(i);
    if(str.len(d.purpose)>0){}el{
      ok=false
    }
  };
  <ok
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── The built-in registry ───────────────────────────────────────────────────*)
  let builtin=uc.builtinusecases();
  if(t.assert(builtin.len==8;"there are eight built-in use cases")){pass=pass+1}el{fail=fail+1};

  (* EVERY use case must have an owner. That is the ownership invariant this file exists
     for: an unowned use case is one nobody is accountable for, and the governance model
     rests on there being somebody. Asserted over the whole list rather than on a sample,
     so adding a ninth use case without an owner fails here. *)
  if(t.assert(allowned(builtin);"EVERY built-in use case declares an owner — an unowned use case is one nobody is accountable for")){pass=pass+1}el{fail=fail+1};

  (* And a stated purpose. Purpose limitation is a GDPR obligation, not decoration: a use
     case with no purpose cannot be assessed against one. *)
  if(t.assert(allhavepurpose(builtin);"and every one states its purpose, which is what purpose limitation is assessed against")){pass=pass+1}el{fail=fail+1};

  (* The ids the rest of the system uses. `core.governance.gateway` looks a request's
     use case up by this exact string, so a rename here silently turns every request of
     that kind into an unknown use case. *)
  if(t.assert(countid(builtin;"chat-completion")==1;"chat-completion is declared exactly once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(builtin;"code-generation")==1;"code-generation once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(builtin;"code-review")==1;"code-review once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(builtin;"summarisation")==1;"summarisation once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(builtin;"data-analysis")==1;"data-analysis once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(builtin;"classification")==1;"classification once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(builtin;"agent-task")==1;"agent-task once")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(builtin;"mcp-tool-call")==1;"and mcp-tool-call once")){pass=pass+1}el{fail=fail+1};

  if(t.asserteq(ownerof(builtin;"chat-completion");"loke";"chat-completion is owned by loke")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ownerof(builtin;"agent-task");"loke";"and so is agent-task")){pass=pass+1}el{fail=fail+1};

  (* ── Risk levels ─────────────────────────────────────────────────────────────
     These feed the gateway's risk classification, so they are a governance decision
     rather than metadata. The three tiers are asserted by name: an agent that executes
     multi-step actions autonomously must not be declared as low-risk as a summary. *)
  let reg=uc.newregistry();
  let listed=uc.list(reg);
  if(t.assert(listed.len==8;"a new registry lists the eight built-ins")){pass=pass+1}el{fail=fail+1};

  let chat:$usecasedef=mt uc.find(reg;"chat-completion") { $ok:v v; $err:e listed.get(0) };
  if(t.asserteq(chat.id;"chat-completion";"find returns the use case asked for")){pass=pass+1}el{fail=fail+1};
  if(t.assert(chat.risklevel==0;"general chat is risk level 0")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(chat.owner;"loke";"carrying its owner")){pass=pass+1}el{fail=fail+1};
  if(t.assert(chat.approvedmodels.len==1;"and its approved-model list")){pass=pass+1}el{fail=fail+1};

  let review:$usecasedef=mt uc.find(reg;"code-review") { $ok:v v; $err:e listed.get(0) };
  if(t.assert(review.risklevel==1;"code review is risk level 1: it reads code it did not write")){pass=pass+1}el{fail=fail+1};

  let agent:$usecasedef=mt uc.find(reg;"agent-task") { $ok:v v; $err:e listed.get(0) };
  if(t.assert(agent.risklevel==2;"an autonomous agent task is risk level 2, the highest declared")){pass=pass+1}el{fail=fail+1};
  if(t.assert(agent.risklevel>chat.risklevel;"and strictly riskier than general chat")){pass=pass+1}el{fail=fail+1};

  let mcp:$usecasedef=mt uc.find(reg;"mcp-tool-call") { $ok:v v; $err:e listed.get(0) };
  if(t.assert(mcp.risklevel==1;"invoking an external tool is risk level 1")){pass=pass+1}el{fail=fail+1};

  (* ── register: LS1.1a's discarded comparison ─────────────────────────────────
     This function's body was `registry.entries==@(registry.entries;uc)` — a COMPARISON,
     discarded, wrapped around an array literal that nests rather than appends, against a
     struct a callee cannot mutate, in a function declared `:i64`. Four independent
     reasons it registered nothing and reported success. It returns a new registry now. *)
  let extended=uc.register(reg;$usecasedef{
    id:"custom-triage";
    name:"Triage support tickets";
    description:"Classifies inbound tickets";
    risklevel:1;
    purpose:"Reduce response time";
    approvedmodels:@("*");
    owner:"support-team"
  });
  if(t.assert(uc.list(extended).len==9;"registering a use case GROWS the registry — it used to silently register nothing")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(uc.list(extended);"custom-triage")==1;"and the new entry is really in the list, once")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ownerof(uc.list(extended);"custom-triage");"support-team";"with the owner it was given — a registered use case is accountable too")){pass=pass+1}el{fail=fail+1};

  let refound:$usecasedef=mt uc.find(extended;"custom-triage") { $ok:v v; $err:e listed.get(0) };
  if(t.asserteq(refound.id;"custom-triage";"and find locates it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(refound.risklevel==1;"at the risk level it declared")){pass=pass+1}el{fail=fail+1};

  (* The ORIGINAL registry is unchanged. This is the property the old `:i64` signature
     could not express and the reason the function had to change shape rather than have
     its operator fixed: a toke callee cannot mutate its caller's struct, so a register
     that does not return the new registry cannot work however it is written. *)
  if(t.assert(uc.list(reg).len==8;"the registry passed IN is unchanged — register returns a new one rather than mutating")){pass=pass+1}el{fail=fail+1};
  if(t.assert(countid(uc.list(reg);"custom-triage")==0;"and does not contain the new entry")){pass=pass+1}el{fail=fail+1};

  (* ── NOT TESTED, and why ─────────────────────────────────────────────────────
     `uc.find` on a MISSING id. It returns $usecasedef!$lokeerr and does
     `<$unknownerr(...)` when nothing matches, but T-18 takes the FIRST arm of a match on
     a user-declared error union whatever the value is. So a miss binds the ERROR PAYLOAD
     as a $usecasedef, and reading any field off it — `.id`, `.risklevel` — is a field
     read on a mis-matched value, which SEGFAULTS rather than returning nonsense.

     Asserting the not-found path would therefore crash the runner and report as CRASH
     instead of as a finding. It is the same T-18 consequence that makes
     `gateway.submitinnerunknownuc` unreachable dead code — see
     tests/unit/governance/test_gateway.tk. Recorded, not triggered. *)

  <fail
};

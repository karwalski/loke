m=test.governance.monitoring;

i=t:std.test;
i=str:std.str;

(* --- stub quality signal and trend logic mirroring core.governance.monitoring --- *)

(* build a quality trend from aggregated counts *)
f=buildtrend(totalsignals:i64;thumbsupcount:i64;coherencesum:f64;relevancesum:f64):i64{
  (* encode: returns thumbsuprate * 100 as integer for easy assertion *)
  if(totalsignals=0){<0};
  let rate=(thumbsupcount*100)/totalsignals;
  <rate
};

(* detect degradation: rate < 70% and more than 10 signals *)
f=degradationdetected(totalsignals:i64;thumbsuprate:i64):i64{
  if(totalsignals>10){
    if(thumbsuprate<70){<1}el{<0}
  }el{<0}
};

(* thumbs down rate = 100 - thumbs up rate *)
f=thumbsdownrate(thumbsuprate:i64):i64{
  <100-thumbsuprate
};

(* validate quality signal fields *)
f=validsignal(requestid:str;modelid:str;provider:str):i64{
  if(str.len(requestid)=0){<0};
  if(str.len(modelid)=0){<0};
  if(str.len(provider)=0){<0};
  <1
};

(* format percentage string *)
f=pctstr(ratepct:i64):str{
  <str.concat(str.fromint(ratepct);"%")
};

(* pad right to width *)
f=padright(s:str;width:i64):str{
  let len=str.len(s);
  if(len>width){<s};
  <str.concat(s;"                    ")
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test buildtrend returns 0 for empty signals *)
  if(t.assert(buildtrend(0;0;0.0;0.0)=0;"empty signals returns 0 rate")){pass=pass+1}el{fail=fail+1};

  (* test buildtrend computes correct thumbs-up rate *)
  if(t.assert(buildtrend(10;8;0.0;0.0)=80;"8/10 thumbs up = 80%")){pass=pass+1}el{fail=fail+1};

  (* test buildtrend 100% thumbs up *)
  if(t.assert(buildtrend(5;5;0.0;0.0)=100;"5/5 thumbs up = 100%")){pass=pass+1}el{fail=fail+1};

  (* test degradation detected when rate < 70% and signals > 10 *)
  if(t.assert(degradationdetected(20;50)=1;"50% rate with 20 signals is degraded")){pass=pass+1}el{fail=fail+1};

  (* test no degradation when rate >= 70% *)
  if(t.assert(degradationdetected(20;80)=0;"80% rate with 20 signals is not degraded")){pass=pass+1}el{fail=fail+1};

  (* test no degradation when signals <= 10 even with low rate *)
  if(t.assert(degradationdetected(5;30)=0;"low rate with few signals is not degraded")){pass=pass+1}el{fail=fail+1};

  (* test thumbs down rate computation *)
  if(t.assert(thumbsdownrate(80)=20;"thumbs down rate is 100 - thumbs up rate")){pass=pass+1}el{fail=fail+1};

  (* test valid signal validation *)
  if(t.assert(validsignal("req1";"gpt4";"openai")=1;"valid signal accepted")){pass=pass+1}el{fail=fail+1};

  (* test invalid signal: empty request ID *)
  if(t.assert(validsignal("";"gpt4";"openai")=0;"empty request ID rejected")){pass=pass+1}el{fail=fail+1};

  (* test invalid signal: empty model ID *)
  if(t.assert(validsignal("req1";"";"openai")=0;"empty model ID rejected")){pass=pass+1}el{fail=fail+1};

  (* test pctstr formatting *)
  if(t.assert(str.eq(pctstr(80);"80%");"pctstr formats 80 as 80%")){pass=pass+1}el{fail=fail+1};

  <fail
};

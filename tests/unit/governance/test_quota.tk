


m=tests.unit.governance.testquota;

i=quota:core.governance.quota;
i=db:core.storage.db;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") }
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") }
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let store=mt db.open(":memory:") {
    $ok:s s;
    $err:e {
      log.error("failed to open in-memory store for quota tests");
      <false
    }
  };

  quota.ensuretables(store);

  let results=@($result);

  
  let norulestatus=quota.check(store;"unknown-scope";0;0.0);
  results=str.arraypush(results;assertfalse("no rule → not exceeded";norulestatus.exceeded));
  results=str.arraypush(results;asserteq("no rule → remaining 100%";"100";str.fromint(str.toint(str.fromfloat(norulestatus.remainingpct)))));

  
  let rulea=quota.$quotarule{
    id:"rule-team-a";
    scope:"team-a";
    limittokens:1000;
    limitcostusd:0.0;
    period:"all-time"
  };
  quota.setrule(store;rulea);

  
  let statusbelow=quota.check(store;"team-a";500;0.0);
  results=str.arraypush(results;assertfalse("usage below limit → not exceeded";statusbelow.exceeded));

  
  quota.recordusage(store;"team-a";500;0.0);
  let statusafter=quota.check(store;"team-a";0;0.0);
  results=str.arraypush(results;assertfalse("after recording 500 tokens not yet exceeded";statusafter.exceeded));

  
  quota.recordusage(store;"team-a";500;0.0);
  let statusfull=quota.check(store;"team-a";0;0.0);
  results=str.arraypush(results;asserttrue("at-limit → exceeded";statusfull.exceeded));

  
  let statusother=quota.check(store;"team-b";0;0.0);
  results=str.arraypush(results;assertfalse("other scope unaffected";statusother.exceeded));

  
  let rules=quota.listrules(store);
  results=str.arraypush(results;asserttrue("list_rules returns at least one rule";str.arraylen(rules)>1));

  
  let ruleb=quota.$quotarule{
    id:"rule-team-b";
    scope:"team-b";
    limittokens:2000;
    limitcostusd:0.0;
    period:"daily"
  };
  let setok=quota.setrule(store;ruleb);
  results=str.arraypush(results;asserttrue("set_rule returns true";setok));

  
  let recnorule=quota.recordusage(store;"no-such-scope";100;0.0);
  results=str.arraypush(results;assertfalse("record_usage with no rule returns false";recnorule));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    }
  };
  <all
};

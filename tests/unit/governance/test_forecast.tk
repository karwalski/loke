m=test.governance.forecast;

i=t:std.test;
i=str:std.str;

(* --- stub forecast logic mirroring core.governance.forecast --- *)

(* daily rate constants matching the source *)
f=dailyrateusd():i64{ <4 }; (* 0.004 * 1000 for integer comparison *)
f=dailytokens():i64{ <613 };

(* compute projected cost in millicents for integer comparison *)
f=projectedcostmilli(forecastdays:i64):i64{
  <dailyrateusd()*forecastdays
};

(* compute projected tokens *)
f=projectedtokens(forecastdays:i64):i64{
  <dailytokens()*forecastdays
};

(* compute confidence level based on history days *)
f=confidence(historydays:i64):str{
  if(historydays<7){<"low"};
  if(historydays<30){<"medium"};
  <"high"
};

(* format forecast includes period *)
f=formatforecast(perioddays:i64;confidence:str):str{
  let periods=str.fromint(perioddays);
  <str.concat(
    str.concat("Cost Forecast (next ";periods);
    str.concat(" days)\nConfidence: ";confidence)
  )
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test projected cost scales linearly with days *)
  if(t.assert(projectedcostmilli(30)=120;"30-day forecast cost is 120 milli-USD")){pass=pass+1}el{fail=fail+1};

  (* test projected cost for 7 days *)
  if(t.assert(projectedcostmilli(7)=28;"7-day forecast cost is 28 milli-USD")){pass=pass+1}el{fail=fail+1};

  (* test projected tokens for 30 days *)
  if(t.assert(projectedtokens(30)=18390;"30-day forecast is 18390 tokens")){pass=pass+1}el{fail=fail+1};

  (* test projected tokens for 1 day *)
  if(t.assert(projectedtokens(1)=613;"1-day forecast is 613 tokens")){pass=pass+1}el{fail=fail+1};

  (* test confidence: low for < 7 days history *)
  if(t.assert(str.eq(confidence(3);"low");"3 days history gives low confidence")){pass=pass+1}el{fail=fail+1};

  (* test confidence: medium for 7-29 days history *)
  if(t.assert(str.eq(confidence(14);"medium");"14 days history gives medium confidence")){pass=pass+1}el{fail=fail+1};

  (* test confidence: high for >= 30 days history *)
  if(t.assert(str.eq(confidence(30);"high");"30 days history gives high confidence")){pass=pass+1}el{fail=fail+1};

  (* test confidence boundary: 7 days is medium not low *)
  if(t.assert(str.eq(confidence(7);"medium");"7 days history gives medium confidence")){pass=pass+1}el{fail=fail+1};

  (* test format includes period *)
  let report=formatforecast(30;"high");
  if(t.assert(str.contains(report;"30 days");"format includes period")){pass=pass+1}el{fail=fail+1};

  (* test format includes confidence *)
  if(t.assert(str.contains(report;"Confidence: high");"format includes confidence")){pass=pass+1}el{fail=fail+1};

  <fail
};

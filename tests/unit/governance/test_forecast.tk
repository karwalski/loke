m=test.governance.forecast;

i=t:std.test;
i=str:std.str;
i=fc:core.governance.forecast;

(* X7.2 — this file used to declare its own $costforecast and its own projection
   arithmetic, then assert its own arithmetic:

     f=projectcost(dailyrate:f64;days:f64):f64{ <dailyrate*days };
     ... t.assert(projectcost(0.004;30.0)>0.0;"a 30-day projection is positive")

   The real module is imported now, and importing it is how the following came to light.

   ── FINDING, latent: core.governance.forecast.forecast PRODUCES A FABRICATED FIGURE ──
   packages/core/src/governance/forecast.tk:19-37. The function signature is
   `forecast(store:i64;historydays:i32;forecastdays:i32)`, and it reads NEITHER `store`
   NOR `historydays` when computing any number. There is no query. The three figures are
   hardcoded constants in the function body:

     let dailyrateusd=0.004;
     let dailytokens=613.0;
     let dailyrequests=4.7;

   so the "projected cost" is `0.004 * forecastdays`, always, on every installation,
   whatever the audit trail holds — including on a fresh install with no history at all.
   `historydays` is used for exactly one thing: choosing the CONFIDENCE LABEL, which
   reports "high" for 30 days of history that were never looked at. That is the worst
   arrangement of the two, because the label is what tells a reader to trust the number.

   This is the class of defect the quality gate already blocks in moke's templates
   ("presentation mode invents no figures", quality-gate.sh) and that CLAUDE.md forbids
   directly: "Do not add a figure without a measurement behind it."

   It is LATENT: `core.governance.forecast` is imported by nothing in packages/ or src/
   — checked by grep — so no user is shown these numbers today. Reported, not fixed.

   The assertions below are therefore CHARACTERISING, and they are written to prove the
   defect rather than to describe a contract: a forecast that reads history cannot
   possibly satisfy them. If the module is ever given a real query, these go red, and
   that is the intended signal. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* Two different stores and two very different history windows. A projection derived
     from history could not give identical answers across all four. *)
  let a=fc.forecast(0;30 as i32;30 as i32);
  let b=fc.forecast(1;30 as i32;30 as i32);
  let c=fc.forecast(0;1 as i32;30 as i32);

  if(t.assert(a.projectedtokens==b.projectedtokens;"DEFECT CHARACTERISED: the projection ignores `store` — two different stores give the identical token figure")){pass=pass+1}el{fail=fail+1};
  if(t.assert(a.projectedrequests==b.projectedrequests;"DEFECT CHARACTERISED: and the identical request figure")){pass=pass+1}el{fail=fail+1};
  if(t.assert(a.projectedtokens==c.projectedtokens;"DEFECT CHARACTERISED: the projection ignores `historydays` — 1 day and 30 days of history give the same figure")){pass=pass+1}el{fail=fail+1};

  (* Exact linearity in the one argument it does read. 613.0 tokens/day and 4.7
     requests/day, truncated through str.toint. *)
  let d30=fc.forecast(0;30 as i32;30 as i32);
  let d60=fc.forecast(0;30 as i32;60 as i32);
  if(t.assert(d30.projectedtokens==18390;"DEFECT CHARACTERISED: a 30-day token projection is exactly 613 * 30, a constant in the source")){pass=pass+1}el{fail=fail+1};
  if(t.assert(d60.projectedtokens==36780;"DEFECT CHARACTERISED: and 60 days is exactly twice it — a linear function of one argument, not a projection")){pass=pass+1}el{fail=fail+1};
  if(t.assert(d30.projectedrequests==141;"DEFECT CHARACTERISED: requests are 4.7 * 30, also constant")){pass=pass+1}el{fail=fail+1};

  (* The period is the one field that is genuinely what the caller asked for. *)
  if(t.assert(d30.perioddays==(30 as i32);"the period carries the caller's forecast window")){pass=pass+1}el{fail=fail+1};
  if(t.assert(d60.perioddays==(60 as i32);"in both cases")){pass=pass+1}el{fail=fail+1};

  (* ── The confidence label ────────────────────────────────────────────────────
     The ladder itself is coherent — under 7 days low, under 30 medium, otherwise high —
     and that is exactly what makes it dangerous here: it is the only part of the
     function that reads `historydays`, and it labels a hardcoded constant as
     high-confidence. Asserted so that the mislabelling is on the record. *)
  if(t.asserteq(fc.forecast(0;3 as i32;30 as i32).confidence;"low";"under a week of history is labelled low confidence")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(fc.forecast(0;7 as i32;30 as i32).confidence;"medium";"seven days is medium — the boundary is < 7, so 7 itself is not low")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(fc.forecast(0;29 as i32;30 as i32).confidence;"medium";"and 29 days is still medium")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(fc.forecast(0;30 as i32;30 as i32).confidence;"high";"DEFECT CHARACTERISED: 30 days of history is labelled HIGH confidence for a figure that read no history at all")){pass=pass+1}el{fail=fail+1};

  if(t.assert(d30.generatedat>0;"the report is stamped with a real time")){pass=pass+1}el{fail=fail+1};

  (* ── formatforecast ──────────────────────────────────────────────────────────
     This is the only part of the module a reader would ever see, and it is correct: it
     renders the fields it is given. Asserted because a forecast whose formatter drops
     the confidence label would present the fabricated number with nothing qualifying
     it — which is strictly worse than the current state. *)
  let out=fc.formatforecast(d30);
  if(t.assert(str.contains(out;"Cost Forecast (next 30 days)");"the formatted forecast names its window")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"Projected cost:");"and labels the cost")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"Projected tokens:");"and the tokens")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"18390");"carrying the figure itself")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"Confidence:");"and — load-bearing — the confidence qualifier")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(out;"high");"with its value")){pass=pass+1}el{fail=fail+1};

  <fail
};

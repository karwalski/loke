


m=tests.unit.governance.testkillswitch;

i=ks:core.governance.killswitch;
i=db:core.storage.db;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){ <pass(name) }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;v:bool):$result{
  if(v){ <pass(name) }el{ <fail(name;"expected true") };
};

f=assertfalse(name:str;v:bool):$result{
  if(!$v){ <pass(name) }el{ <fail(name;"expected false") };
};

f=logresult(r:$result):i64{
  if(r.passed){ log.info(str.concat("PASS ";r.name)) }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let store=mt db.open(":memory:") {
    $ok:s s;
    $err:e {
      log.error("failed to open in-memory store for kill_switch tests");
      <false
    };
  };

  let results=@$result@();

  
  let freshstate=ks.loadstate(store);
  results=str.arraypush(results;assertfalse("fresh store engaged=false";freshstate.engaged));

  
  ks.engage(store;"test reason";0);
  results=str.arraypush(results;asserttrue("is_engaged after engage";ks.isengaged(store)));

  
  ks.release(store);
  results=str.arraypush(results;assertfalse("is_engaged after release";ks.isengaged(store)));

  
  ks.engage(store;"compliance-breach";0);
  let engagedstate=ks.loadstate(store);
  results=str.arraypush(results;asserteq("engaged state reason field";"compliance-breach";engagedstate.reason));

  
  let widgeton=ks.formatwidget(engagedstate);
  results=str.arraypush(results;asserttrue("format_widget engaged contains ENGAGED";str.contains(widgeton;"ENGAGED")));

  
  ks.release(store);
  let disengagedstate=ks.loadstate(store);
  let widgetoff=ks.formatwidget(disengagedstate);
  results=str.arraypush(results;asserttrue("format_widget disengaged contains DISENGAGED";str.contains(widgetoff;"DISENGAGED")));

  
  ks.engage(store;"manual only";0);
  let manualstate=ks.loadstate(store);
  results=str.arraypush(results;asserteq("auto_release_minutes=0 yields auto_release_at=0";"0";str.fromint(manualstate.autoreleaseat)));

  
  ks.engage(store;"no auto";0);
  results=str.arraypush(results;assertfalse("check_auto_release non-auto state is false";ks.checkautorelease(store)));

  let all=true;
  let i=0;
  let n=str.arraylen(results);
  lp(true){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let all=false }el{};
      i=i+1;
    };
  };
  <all
};

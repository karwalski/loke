m=test.governance.killswitch;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=sdb:core.storage.db;
i=set:core.storage.settings;
i=ks:core.governance.killswitch;
i=h:page.api.pipeline;
i=clk:shared.types;
i=db:std.db;

(* X7.2 — this file used to declare an ENTIRE parallel kill switch: its own
   $killswitchstate with a `switches` array, its own enableglobal / disableglobal /
   isglobalactive / enableprovider / isblocked / getfallbackmessage / listactive, and
   twelve assertions against that machinery. None of it exists in
   core.governance.killswitch, which has no per-provider scope, no switch list and no
   fallback message — it is a single global flag in the settings table.

   The stub was not merely useless, it was actively misleading in the worst possible
   direction. While it asserted

     t.assert(isblocked(st2;"provider";"anthropic");"global blocks anthropic")

   against a struct field it had set two lines earlier, the REAL kill switch reported
   itself DISENGAGED WHILE ENGAGED. `loadstate` read the flag with `set.getstr` and took
   its "false" default from an `$err:` arm; `engage` writes the flag with `set.setbool`,
   so the row's value_type is "bool", getstr refuses it as a type mismatch — and T-18
   means the $err arm never runs, so the caller bound the ERROR PAYLOAD as if it were the
   string. str.eq(payload;"true") was false. The control that blocks all LLM traffic did
   nothing, silently, and this test file was green for the whole of it.

   That is the regression this file now guards, and it is why the engage-then-read
   assertion below is the most important line in it: it goes through the real settings
   table, with the real value_type, exactly as production does.

   ── T10.1, 2026-09-24 ───────────────────────────────────────────────────────────────
   THE BACKLOG ROW SPECIFIES A KILL SWITCH THAT DOES NOT EXIST, AND IT IS NOT BEING BUILT
   HERE. The row names `enable_global`, `disable_global`, `enable_provider("anthropic")`,
   `is_blocked("anthropic","any")`, `list_active` and `fallback_message` — a switch with
   PER-PROVIDER SCOPE, a list of active entries and a canned message for callers.
   core.governance.killswitch has none of that. Its whole export list is settingkey,
   loadstate, engage, release, checkautorelease, isengaged and formatwidget, over a
   $killswitchstate of engaged / engagedat / engagedby / reason / autoreleaseat. There is
   no provider argument anywhere in it, no second switch to list, and no fallback string:
   it is ONE global flag in the settings table. Writing a test for per-provider scoping
   would mean writing the scoping in the test, which is the X7.1 trap this file was
   rewritten to escape.

   So the row's equivalents are: `enable_global` → engage, `disable_global` → release,
   `is_blocked` → isengaged, `fallback_message` → the consequence line in formatwidget
   ("All LLM traffic blocked"), asserted above. `enable_provider` and `list_active` have
   no equivalent and are reported absent.

   WHAT WAS GENUINELY MISSING, AND IS NOW ASSERTED: nothing anywhere tested that the
   switch BLOCKS anything. Every assertion above is about the flag's own state. The row's
   first clause is "enable_global blocks all", and the code that does the blocking is
   page.api.pipeline.killswitchengaged, the guard at the top of the only POST
   that reaches a provider — which returns 403 before the body is even read. It is
   exercised at the end of this file, including its fail-CLOSED behaviour on a store it
   cannot open, because "the flag is set" and "requests stop" are different claims and
   only the second one is the control. *)

f=testdir():str{
  (* str.concat, not interpolation — std.homedir()'s return is truncated when
     interpolated (T-21). Its own directory so no other test's rows are in scope. *)
  <str.concat(std.homedir();"/.loke/test-kill-switch")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  (* A fresh database file per run: the flag is persistent state and a leftover engaged
     switch from a previous run would make the first assertion pass for the wrong
     reason. *)
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s s;
    $err:e 0
  }
};

(* The same database file, not deleted: a restart. *)
f=reopenstore():i64{
  <mt sdb.openstore(testdir()) {
    $ok:s s;
    $err:e 0
  }
};

f=auditrows(eventtype:str;scopetarget:str):i64{
  <sdb.countquery("SELECT id FROM audit_log WHERE event_type=? AND correlation_id=?";@(eventtype;scopetarget))
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=openfreshstore();

  (* ── The setting key ─────────────────────────────────────────────────────────
     Spelled out, because it is the contract between this module and the settings table
     and anything else that reads the flag directly. A silent rename makes an engaged
     switch invisible. *)
  if(t.asserteq(ks.settingkey();"governance.kill_switch.engaged";"the engaged flag lives under a known settings key")){pass=pass+1}el{fail=fail+1};

  (* ── Disengaged by default ───────────────────────────────────────────────────
     A kill switch that defaults to engaged is an outage; one whose default cannot be
     read is the defect above. On a database with no row at all, the answer must be a
     definite false. *)
  if(t.assert(!ks.isengaged(store);"a fresh installation is NOT engaged")){pass=pass+1}el{fail=fail+1};
  let fresh=ks.loadstate(store);
  if(t.assert(!fresh.engaged;"loadstate agrees on a database with no row")){pass=pass+1}el{fail=fail+1};
  if(t.assert(fresh.engagedat==0;"and carries no engagement time")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(fresh.reason;"";"and no reason")){pass=pass+1}el{fail=fail+1};

  (* ── THE REGRESSION: engage, then read it back ───────────────────────────────
     Written with setbool and read with getboolor, through the real settings table. If
     the reader and the writer ever disagree about the value type again, this is the
     assertion that goes red — and it is the only one in the suite that would. *)
  if(t.assert(ks.engage(store;"compliance breach";0 as i32);"engage reports success")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isengaged(store);"AN ENGAGED KILL SWITCH READS BACK AS ENGAGED — the T-18 defect that made it report itself disengaged")){pass=pass+1}el{fail=fail+1};

  let engaged=ks.loadstate(store);
  if(t.assert(engaged.engaged;"loadstate agrees")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(engaged.reason;"compliance breach";"the reason is stored verbatim, because it is what an operator is shown")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(engaged.engagedby;"system";"and who engaged it")){pass=pass+1}el{fail=fail+1};
  if(t.assert(engaged.engagedat>0;"and when, as a real timestamp")){pass=pass+1}el{fail=fail+1};
  if(t.assert(engaged.autoreleaseat==0;"with no auto-release when none was asked for — zero must not mean 'release immediately'")){pass=pass+1}el{fail=fail+1};

  (* The widget an operator reads. Its two states must not be confusable. *)
  if(t.assert(str.contains(ks.formatwidget(engaged);"ENGAGED");"the widget says ENGAGED")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ks.formatwidget(engaged);"All LLM traffic blocked");"and states the consequence")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ks.formatwidget(engaged);"compliance breach");"and shows the reason it was given")){pass=pass+1}el{fail=fail+1};

  (* ── Release ─────────────────────────────────────────────────────────────────*)
  if(t.assert(ks.release(store);"release reports success")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.isengaged(store);"and the switch is disengaged afterwards")){pass=pass+1}el{fail=fail+1};
  let released=ks.loadstate(store);
  if(t.asserteq(released.reason;"";"the reason is cleared, not left describing a switch that is no longer engaged")){pass=pass+1}el{fail=fail+1};
  if(t.assert(released.engagedat==0;"and so is the engagement time")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ks.formatwidget(released);"DISENGAGED");"and the widget says DISENGAGED")){pass=pass+1}el{fail=fail+1};

  (* Re-engaging after a release has to work. A switch that can only be used once is
     worse than none, because the second incident is the one it fails on. *)
  ks.engage(store;"second incident";0 as i32);
  if(t.assert(ks.isengaged(store);"the switch can be engaged again after a release")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ks.loadstate(store).reason;"second incident";"with the new reason, not the old one")){pass=pass+1}el{fail=fail+1};
  ks.release(store);

  (* ── Auto-release ────────────────────────────────────────────────────────────
     A timed engagement must NOT release early. This is the direction that matters: an
     auto-release that fires immediately turns a 30-minute block into no block at all. *)
  ks.engage(store;"timed incident";30 as i32);
  let timed=ks.loadstate(store);
  if(t.assert(timed.autoreleaseat>timed.engagedat;"a timed engagement sets an auto-release in the FUTURE")){pass=pass+1}el{fail=fail+1};
  (* GA5.28. engaged_at is the real clock. It was str.nowunix(), a string's ADDRESS read as
     an integer, so this passed or failed with the allocator (the full-suite flake). *)
  let nowsec=clk.nowi64();
  if(t.assert(timed.engagedat>nowsec-120 && timed.engagedat<nowsec+120;"engaged_at is the current unix time, not a heap address")){pass=pass+1}el{fail=fail+1};
  if(t.assert(timed.autoreleaseat-timed.engagedat==1800;"thirty minutes is 1800 seconds, converted rather than stored as minutes")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.checkautorelease(store);"checkautorelease does NOT fire before the deadline")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isengaged(store);"and the switch is still engaged")){pass=pass+1}el{fail=fail+1};

  (* Now the other direction, with a deadline in the past. The settings row is written
     directly rather than through engage(), because engage only accepts a positive number
     of minutes and there is no way to ask it for a deadline that has already passed —
     so the elapsed case is unreachable through the module's own API and would otherwise
     go untested. T-18: setint returns a result, so its arms are matched only to satisfy
     the type; the write itself is what matters. *)
  mt set.setint(store;"governance.kill_switch.auto_release_at";1000;"governance") { $ok:v v; $err:e 0 };
  if(t.assert(ks.checkautorelease(store);"an auto-release deadline in the past DOES fire")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.isengaged(store);"and the switch is released by it, without anyone calling release")){pass=pass+1}el{fail=fail+1};

  (* ── T10.1: DOES IT ACTUALLY BLOCK ANYTHING? ─────────────────────────────────
     The row's first clause. page.api.pipeline.killswitchengaged is the guard at
     the top of post() — the one POST in this product that can reach an external provider
     — and it returns 403 before the request body is read. Asserting the flag without
     asserting this gate would be asserting a light bulb rather than a circuit.

     THE FAIL-CLOSED CASE FIRST, because it is the one nobody would think to write. A
     store of 0 is what openstore() returns when the database cannot be opened, and an
     unreadable kill switch is treated as ENGAGED. The other way round — unreadable means
     not engaged — is a kill switch that a corrupted or missing database silently
     disables, which is precisely the situation in which an operator most needs it. *)
  if(t.assert(h.killswitchengaged(0);"AN UNREADABLE STORE IS TREATED AS ENGAGED: the request path fails CLOSED, so a database that will not open blocks traffic rather than releasing it")){pass=pass+1}el{fail=fail+1};

  ks.release(store);
  if(t.assert(!h.killswitchengaged(store);"with a readable store and the switch disengaged, the request path does NOT block")){pass=pass+1}el{fail=fail+1};
  ks.engage(store;"enforcement check";0 as i32);
  if(t.assert(h.killswitchengaged(store);"AND ENGAGING THE SWITCH BLOCKS THE REQUEST PATH — the gate reads the same settings row this test wrote, so the flag and the refusal cannot drift apart")){pass=pass+1}el{fail=fail+1};
  ks.release(store);
  if(t.assert(!h.killswitchengaged(store);"releasing it unblocks the request path again")){pass=pass+1}el{fail=fail+1};

  (* ── T10.1: per-provider scope ──────────────────────────────────────────── *)
  if(t.assert(!ks.isblocked(store;"anthropic";"any") && !ks.isblocked(store;"ollama";"any");"with nothing engaged, no provider is blocked")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.listactive(store).len==0;"and nothing is active")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.engageprovider(store;"anthropic";"incident 42");"a provider can be switched off")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isblocked(store;"anthropic";"any");"isblocked(anthropic) is true after it is engaged")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.isblocked(store;"ollama";"any");"while ollama is not blocked")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!h.killswitchengaged(store);"and the GLOBAL switch stays off, so local traffic still flows")){pass=pass+1}el{fail=fail+1};
  let act1=ks.listactive(store);
  if(t.assert(act1.len==1;"listactive has one entry")){pass=pass+1}el{fail=fail+1};
  if(act1.len==1){
    if(t.asserteq(act1.get(0);"anthropic";"naming the blocked provider")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+1 };
  if(t.assert(!ks.engageprovider(store;"anthropc";"typo");"an unknown provider name is refused, not silently accepted")){pass=pass+1}el{fail=fail+1};

  ks.engage(store;"global test";0 as i32);
  if(t.assert(ks.isblocked(store;"ollama";"any");"the global switch blocks every provider")){pass=pass+1}el{fail=fail+1};
  let act2=ks.listactive(store);
  if(t.assert(act2.len==2;"and listactive shows global plus the provider")){pass=pass+1}el{fail=fail+1};
  if(act2.len==2){
    if(t.asserteq(act2.get(0);"global";"global first")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+1 };
  ks.release(store);
  if(t.assert(!ks.isblocked(store;"ollama";"any") && ks.isblocked(store;"anthropic";"any");"releasing global leaves the provider switch in place")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.releaseprovider(store;"anthropic");"the provider switch can be released")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.isblocked(store;"anthropic";"any");"and then anthropic is unblocked")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isblocked(0;"ollama";"any");"with no store, every provider is blocked: fail closed")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ks.fallbackmessage("anthropic");"anthropic") && str.len(ks.fallbackmessage("anthropic"))>20;"fallbackmessage names the provider and explains")){pass=pass+1}el{fail=fail+1};

  (* ── G1.6: per-use-case scope ───────────────────────────────────────────────
     "browser-chat" is the one use case a request path passes (page.api.pipeline). *)
  if(t.assert(!ks.isblocked(store;"ollama";"browser-chat");"with nothing engaged, browser-chat is not blocked")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.engageusecase(store;"browser-chat";"incident 43");"the browser-chat use case can be switched off")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isusecaseblocked(store;"browser-chat");"ENGAGING A USE CASE BLOCKS THAT USE CASE")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isblocked(store;"ollama";"browser-chat");"and isblocked refuses it on every provider, local included")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(ks.blockedscope(store;"ollama";"browser-chat");"use_case";"blockedscope names the use-case switch")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.isblocked(store;"ollama";"agent-task");"AND ONLY THAT USE CASE: another use case on the same provider is not blocked")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!h.killswitchengaged(store);"and the global switch stays off")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ks.refusalmessage(store;"ollama";"browser-chat");"browser-chat use case is switched off");"the refusal message names the use case")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.engageusecase(store;"chat-completion";"x");"a use case no request path passes is refused, so it cannot report blocked while nothing refuses it")){pass=pass+1}el{fail=fail+1};
  let act3=ks.listactive(store);
  if(t.assert(act3.len==1;"listactive has the use-case entry")){pass=pass+1}el{fail=fail+1};
  if(act3.len==1){
    if(t.asserteq(act3.get(0);"use_case:browser-chat";"named with its scope")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+1 };

  (* ── G1.6: per-agent scope ──────────────────────────────────────────────── *)
  if(t.assert(!ks.isagentblocked(store;"daily-digest");"with no agent switch, an agent is not blocked")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.engageagent(store;"daily-digest";"incident 44");"an agent can be switched off")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isagentblocked(store;"daily-digest");"ENGAGING AN AGENT BLOCKS THAT AGENT")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.isagentblocked(store;"meeting-prep");"AND ONLY THAT AGENT: another agent still runs")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.engageagent(store;"bad agent id";"x") && !ks.engageagent(store;"";"x");"a malformed or empty agent id is refused")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isagentblocked(store;"bad agent id");"and an id that cannot name an agent is refused, never run")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(ks.agentrefusalmessage("daily-digest");"Agent daily-digest is switched off");"the agent refusal names the agent")){pass=pass+1}el{fail=fail+1};
  let act4=ks.listactive(store);
  if(t.assert(act4.len==2;"listactive now has the use case and the agent")){pass=pass+1}el{fail=fail+1};
  if(act4.len==2){
    if(t.asserteq(act4.get(1);"agent:daily-digest";"the agent named with its scope")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+1 };
  ks.engage(store;"global over agents";0 as i32);
  if(t.assert(ks.isagentblocked(store;"meeting-prep");"the global switch blocks every agent")){pass=pass+1}el{fail=fail+1};
  ks.release(store);

  (* ── G1.6: persisted across a reopened store ─────────────────────────────────
     The same database file opened again, as a restart would. *)
  let reopened=reopenstore();
  if(t.assert(reopened!=0;"the store reopens")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isusecaseblocked(reopened;"browser-chat");"THE USE-CASE SWITCH SURVIVES A REOPEN")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isagentblocked(reopened;"daily-digest");"THE AGENT SWITCH SURVIVES A REOPEN")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!ks.isagentblocked(reopened;"meeting-prep");"and nothing else became blocked")){pass=pass+1}el{fail=fail+1};

  (* ── G1.6: audited ─────────────────────────────────────────────────────── *)
  if(t.assert(auditrows("kill_switch_engaged";"use_case:browser-chat")==1;"engaging the use case wrote one audit row")){pass=pass+1}el{fail=fail+1};
  if(t.assert(auditrows("kill_switch_engaged";"agent:daily-digest")==1;"engaging the agent wrote one audit row")){pass=pass+1}el{fail=fail+1};
  if(t.assert(auditrows("kill_switch_engaged";"agent:bad agent id")==0;"a refused change wrote none")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.countquery("SELECT id FROM audit_log WHERE event_type='kill_switch_engaged' AND use_case='browser-chat'";@())==1;"the use case is in the audit row's use_case column")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.recordrefusal(reopened;"agent";"daily-digest") && auditrows("kill_switch_refused";"agent:daily-digest")==1;"a refusal is audited")){pass=pass+1}el{fail=fail+1};

  (* ── G1.6: unreadable fails CLOSED ───────────────────────────────────────────
     The settings table is renamed away, so every read of it fails. set.getboolor would
     answer "not engaged" here; the scoped reads must answer "engaged". *)
  mt db.exec("ALTER TABLE settings RENAME TO settings_away";@()) { $ok:v v; $err:e 0 };
  if(t.assert(ks.isusecaseblocked(reopened;"browser-chat") && ks.isblocked(reopened;"ollama";"browser-chat");"AN UNREADABLE SETTINGS TABLE BLOCKS THE USE CASE")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isagentblocked(reopened;"meeting-prep");"AND EVERY AGENT, including one never switched off")){pass=pass+1}el{fail=fail+1};
  mt db.exec("ALTER TABLE settings_away RENAME TO settings";@()) { $ok:v v; $err:e 0 };
  if(t.assert(!ks.isagentblocked(reopened;"meeting-prep");"with the table back, the unswitched agent runs again")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.isusecaseblocked(0;"browser-chat") && ks.isagentblocked(0;"meeting-prep");"with no store, the use case and every agent are blocked")){pass=pass+1}el{fail=fail+1};

  (* ── G1.6: release ─────────────────────────────────────────────────────── *)
  if(t.assert(ks.releaseusecase(reopened;"browser-chat") && !ks.isusecaseblocked(reopened;"browser-chat");"the use case can be released")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.releaseagent(reopened;"daily-digest") && !ks.isagentblocked(reopened;"daily-digest");"and the agent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(auditrows("kill_switch_released";"use_case:browser-chat")==1 && auditrows("kill_switch_released";"agent:daily-digest")==1;"each release wrote its audit row")){pass=pass+1}el{fail=fail+1};
  if(t.assert(ks.listactive(reopened).len==0;"and nothing is active")){pass=pass+1}el{fail=fail+1};

  <fail
};

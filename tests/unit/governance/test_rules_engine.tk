m=test.governance.rulesengine;

i=t:std.test;
i=str:std.str;

t=$ruleop{
  kind:str
};

t=$condition{
  field:str;
  op:str;
  value:str
};

t=$compoundrule{
  id:str;
  name:str;
  logic:$ruleop;
  conditions:@$condition;
  action:str;
  severity:str
};

t=$evalcontext{
  sensitivity:i32;
  modeltier:str;
  requestcount:i32;
  hourofday:i32;
  scope:str
};

t=$evalresult{
  ruleid:str;
  matched:bool;
  action:str;
  reason:str
};

f=evalcondition(cond:$condition;ctx:$evalcontext):bool{
  if(cond.field="sensitivity"){
    let ctxval=ctx.sensitivity;
    let cmpval=str.toint(cond.value);
    if(cond.op="eq"){ <ctxval=cmpval
    }el{ if(cond.op="gt"){ <ctxval>cmpval
    }el{ if(cond.op="lt"){ <ctxval<cmpval
    }el{ <false }}}
  }el{ if(cond.field="model_tier"){
    if(cond.op="eq"){ <ctx.modeltier=cond.value
    }el{ if(cond.op="contains"){ <str.contains(ctx.modeltier;cond.value)
    }el{ <false }}
  }el{ if(cond.field="request_count"){
    let ctxval=ctx.requestcount;
    let cmpval=str.toint(cond.value);
    if(cond.op="eq"){ <ctxval=cmpval
    }el{ if(cond.op="gt"){ <ctxval>cmpval
    }el{ if(cond.op="lt"){ <ctxval<cmpval
    }el{ <false }}}
  }el{ if(cond.field="hour_of_day"){
    let ctxval=ctx.hourofday;
    let cmpval=str.toint(cond.value);
    if(cond.op="eq"){ <ctxval=cmpval
    }el{ if(cond.op="gt"){ <ctxval>cmpval
    }el{ if(cond.op="lt"){ <ctxval<cmpval
    }el{ <false }}}
  }el{ if(cond.field="scope"){
    if(cond.op="eq"){ <ctx.scope=cond.value
    }el{ if(cond.op="contains"){ <str.contains(ctx.scope;cond.value)
    }el{ <false }}
  }el{ <false }}}}}
};

f=evaland(conditions:@$condition;ctx:$evalcontext):bool{
  let allpass=mut.true;
  lp(let ii=0;ii<conditions.len;ii=ii+1){
    let cond=conditions.get(ii);
    if(allpass){
      if(!evalcondition(cond;ctx)){ allpass=false }el{}
    }el{}
  };
  <allpass
};

f=evalor(conditions:@$condition;ctx:$evalcontext):bool{
  let anypass=mut.false;
  lp(let ii=0;ii<conditions.len;ii=ii+1){
    let cond=conditions.get(ii);
    if(!anypass){
      if(evalcondition(cond;ctx)){ anypass=true }el{}
    }el{}
  };
  <anypass
};

f=evalnot(conditions:@$condition;ctx:$evalcontext):bool{
  if(conditions.len=(0 as u64)){ <false
  }el{
    let first=conditions.get(0);
    <evalcondition(first;ctx)=false
  }
};

f=evaluate(rule:$compoundrule;ctx:$evalcontext):$evalresult{
  let matched=mut.false;
  if(str.eq(rule.logic;"and")){ matched=evaland(rule.conditions;ctx) }el{};
  if(str.eq(rule.logic;"or")){ matched=evalor(rule.conditions;ctx) }el{};
  if(str.eq(rule.logic;"not")){ matched=evalnot(rule.conditions;ctx) }el{};
  let action=mut."allow";
  if(matched){ action=rule.action }el{};
  let reason=mut.str.concat("Rule not matched: ";rule.name);
  if(matched){ reason=str.concat("Rule matched: ";str.concat(rule.name;str.concat(" -> ";rule.action))) }el{};
  <$evalresult{ruleid:rule.id;matched:matched;action:action;reason:reason}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let ctxhigh=$evalcontext{sensitivity:3;modeltier:"cloud-premium";requestcount:50;hourofday:14;scope:"internal"};
  let ctxlow=$evalcontext{sensitivity:0;modeltier:"local";requestcount:5;hourofday:10;scope:"internal"};

  let cond1=$condition{field:"sensitivity";op:"eq";value:"3"};
  if(evalcondition(cond1;ctxhigh)){ t.assert(true;"single condition eq true matches"); pass=pass+1
  }el{ t.assert(false;"single condition eq true matches"); fail=fail+1 };

  if(!evalcondition(cond1;ctxlow)){ t.assert(true;"single condition eq false rejects"); pass=pass+1
  }el{ t.assert(false;"single condition eq false rejects"); fail=fail+1 };

  let andrule=$compoundrule{id:"t-and";name:"AND test";logic:"and";conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"3"};
    $condition{field:"model_tier";op:"contains";value:"cloud"}
  );action:"warn";severity:"high"};
  let andres=evaluate(andrule;ctxhigh);
  if(andres.matched){ t.assert(true;"AND both true -> matched"); pass=pass+1
  }el{ t.assert(false;"AND both true -> matched"); fail=fail+1 };

  let andmiss=evaluate(andrule;ctxlow);
  if(!andmiss.matched){ t.assert(true;"AND partial miss -> not matched"); pass=pass+1
  }el{ t.assert(false;"AND partial miss -> not matched"); fail=fail+1 };

  if(str.eq(andmiss.action;"allow")){ t.assert(true;"AND miss action defaults to allow"); pass=pass+1
  }el{ t.assert(false;"AND miss action defaults to allow"); fail=fail+1 };

  let orrule=$compoundrule{id:"t-or";name:"OR test";logic:"or";conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"3"};
    $condition{field:"model_tier";op:"eq";value:"cloud-economy"}
  );action:"throttle";severity:"medium"};
  let orres=evaluate(orrule;ctxhigh);
  if(orres.matched){ t.assert(true;"OR one true -> matched"); pass=pass+1
  }el{ t.assert(false;"OR one true -> matched"); fail=fail+1 };

  let ormiss=evaluate(orrule;ctxlow);
  if(!ormiss.matched){ t.assert(true;"OR none true -> not matched"); pass=pass+1
  }el{ t.assert(false;"OR none true -> not matched"); fail=fail+1 };

  let notrule=$compoundrule{id:"t-not";name:"NOT test";logic:"not";conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"99"}
  );action:"deny";severity:"high"};
  let notres=evaluate(notrule;ctxhigh);
  if(notres.matched){ t.assert(true;"NOT negates false condition -> matched"); pass=pass+1
  }el{ t.assert(false;"NOT negates false condition -> matched"); fail=fail+1 };

  let nothit=$compoundrule{id:"t-not2";name:"NOT hit";logic:"not";conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"3"}
  );action:"deny";severity:"high"};
  let nothitres=evaluate(nothit;ctxhigh);
  if(!nothitres.matched){ t.assert(true;"NOT negates true condition -> not matched"); pass=pass+1
  }el{ t.assert(false;"NOT negates true condition -> not matched"); fail=fail+1 };

  let gtcond=$condition{field:"request_count";op:"gt";value:"10"};
  if(evalcondition(gtcond;ctxhigh)){ t.assert(true;"threshold gt 10 with 50 -> true"); pass=pass+1
  }el{ t.assert(false;"threshold gt 10 with 50 -> true"); fail=fail+1 };

  if(!evalcondition(gtcond;ctxlow)){ t.assert(true;"threshold gt 10 with 5 -> false"); pass=pass+1
  }el{ t.assert(false;"threshold gt 10 with 5 -> false"); fail=fail+1 };

  let ltcond=$condition{field:"hour_of_day";op:"lt";value:"12"};
  if(evalcondition(ltcond;ctxlow)){ t.assert(true;"threshold lt 12 with 10 -> true"); pass=pass+1
  }el{ t.assert(false;"threshold lt 12 with 10 -> true"); fail=fail+1 };

  if(!evalcondition(ltcond;ctxhigh)){ t.assert(true;"threshold lt 12 with 14 -> false"); pass=pass+1
  }el{ t.assert(false;"threshold lt 12 with 14 -> false"); fail=fail+1 };

  <fail
};

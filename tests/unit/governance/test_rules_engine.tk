m=test.governance.rulesengine;

i=t:std.test;
i=str:std.str;
i=rules:core.governance.rulesengine;

(* This file declared its own $ruleop, $condition, $compoundrule, $evalcontext,
   $evalresult and its own evalcondition, evaland, evalor, evalnot and evaluate — a
   copy of the module it is named after. The copy compared the rule's logic with
   str.eq against "and"/"or"/"not", while the real $compoundrule declares logic as a
   $ruleop sum, so the two had drifted apart and the test could not have caught it.

   It calls the module now. The literals are constructed the way the real types
   require: $ruleop{$and:0} rather than the string "and", and the context's counters
   as i32. *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let ctxhigh=$evalcontext{sensitivity:3 as i32;modeltier:"cloud-premium";requestcount:50 as i32;hourofday:14 as i32;scope:"internal"};
  let ctxlow=$evalcontext{sensitivity:0 as i32;modeltier:"local";requestcount:5 as i32;hourofday:10 as i32;scope:"internal"};

  let cond1=$condition{field:"sensitivity";op:"eq";value:"3"};
  if(rules.evalcondition(cond1;ctxhigh)){ t.assert(true;"single condition eq true matches"); pass=pass+1
  }el{ t.assert(false;"single condition eq true matches"); fail=fail+1 };

  if(!rules.evalcondition(cond1;ctxlow)){ t.assert(true;"single condition eq false rejects"); pass=pass+1
  }el{ t.assert(false;"single condition eq false rejects"); fail=fail+1 };

  let andrule=$compoundrule{id:"t-and";name:"AND test";logic:$ruleop{$and:0};conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"3"};
    $condition{field:"model_tier";op:"contains";value:"cloud"}
  );action:"warn";severity:"high"};
  let andres=rules.evaluate(andrule;ctxhigh);
  if(andres.matched){ t.assert(true;"AND both true -> matched"); pass=pass+1
  }el{ t.assert(false;"AND both true -> matched"); fail=fail+1 };

  let andmiss=rules.evaluate(andrule;ctxlow);
  if(!andmiss.matched){ t.assert(true;"AND partial miss -> not matched"); pass=pass+1
  }el{ t.assert(false;"AND partial miss -> not matched"); fail=fail+1 };

  if(str.eq(andmiss.action;"allow")){ t.assert(true;"AND miss action defaults to allow"); pass=pass+1
  }el{ t.assert(false;"AND miss action defaults to allow"); fail=fail+1 };

  let orrule=$compoundrule{id:"t-or";name:"OR test";logic:$ruleop{$or:0};conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"3"};
    $condition{field:"model_tier";op:"eq";value:"cloud-economy"}
  );action:"throttle";severity:"medium"};
  let orres=rules.evaluate(orrule;ctxhigh);
  if(orres.matched){ t.assert(true;"OR one true -> matched"); pass=pass+1
  }el{ t.assert(false;"OR one true -> matched"); fail=fail+1 };

  let ormiss=rules.evaluate(orrule;ctxlow);
  if(!ormiss.matched){ t.assert(true;"OR none true -> not matched"); pass=pass+1
  }el{ t.assert(false;"OR none true -> not matched"); fail=fail+1 };

  let notrule=$compoundrule{id:"t-not";name:"NOT test";logic:$ruleop{$not:0};conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"99"}
  );action:"deny";severity:"high"};
  let notres=rules.evaluate(notrule;ctxhigh);
  if(notres.matched){ t.assert(true;"NOT negates false condition -> matched"); pass=pass+1
  }el{ t.assert(false;"NOT negates false condition -> matched"); fail=fail+1 };

  let nothit=$compoundrule{id:"t-not2";name:"NOT hit";logic:$ruleop{$not:0};conditions:@(
    $condition{field:"sensitivity";op:"eq";value:"3"}
  );action:"deny";severity:"high"};
  let nothitres=rules.evaluate(nothit;ctxhigh);
  if(!nothitres.matched){ t.assert(true;"NOT negates true condition -> not matched"); pass=pass+1
  }el{ t.assert(false;"NOT negates true condition -> not matched"); fail=fail+1 };

  let gtcond=$condition{field:"request_count";op:"gt";value:"10"};
  if(rules.evalcondition(gtcond;ctxhigh)){ t.assert(true;"threshold gt 10 with 50 -> true"); pass=pass+1
  }el{ t.assert(false;"threshold gt 10 with 50 -> true"); fail=fail+1 };

  if(!rules.evalcondition(gtcond;ctxlow)){ t.assert(true;"threshold gt 10 with 5 -> false"); pass=pass+1
  }el{ t.assert(false;"threshold gt 10 with 5 -> false"); fail=fail+1 };

  let ltcond=$condition{field:"hour_of_day";op:"lt";value:"12"};
  if(rules.evalcondition(ltcond;ctxlow)){ t.assert(true;"threshold lt 12 with 10 -> true"); pass=pass+1
  }el{ t.assert(false;"threshold lt 12 with 10 -> true"); fail=fail+1 };

  if(!rules.evalcondition(ltcond;ctxhigh)){ t.assert(true;"threshold lt 12 with 14 -> false"); pass=pass+1
  }el{ t.assert(false;"threshold lt 12 with 14 -> false"); fail=fail+1 };

  (* F10.57. A numeric condition whose value is not a number matches nothing. RED BEFORE THE
     FIX: "high" read as 0, so `sensitivity gt high` matched a sensitivity of 3. *)
  let badgt=$condition{field:"sensitivity";op:"gt";value:"high"};
  if(t.assert(!rules.evalcondition(badgt;ctxhigh);"a non-numeric comparand is not read as 0 (gt)")){pass=pass+1}el{fail=fail+1};
  let badeq=$condition{field:"request_count";op:"eq";value:"0x"};
  let ctxzero=$evalcontext{sensitivity:0 as i32;modeltier:"local";requestcount:0 as i32;hourofday:0 as i32;scope:"internal"};
  if(t.assert(!rules.evalcondition(badeq;ctxzero);"nor does it equal a count of 0")){pass=pass+1}el{fail=fail+1};

  <fail
};

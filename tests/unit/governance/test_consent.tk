m=test.governance.consent;

i=t:std.test;
i=str:std.str;
i=file:std.file;
i=std:std;
i=db:std.db;
i=sdb:core.storage.db;
i=cs:core.governance.consent;

(* X7.2 — this file used to declare a $consentrecord array with its own grant, revoke,
   hasconsent and isexpired, and assert against them. Two of its assertions are worth
   quoting because the real module answers both differently in shape:

     t.assert(!hasconsent(st;"alice";"telemetry");"no consent by default")
     t.assert(isexpired(rec;now);"a record past its expiry is expired")

   The stub's `hasconsent` was a loop over an in-memory array. The real `check` is a SQL
   query, and "no row" versus "a row with granted=0" versus "a row whose expiry has
   passed" are three different code paths through `checkrows` — all of which must answer
   FALSE. That is the only fail-closed property this module has, and the stub could not
   reach any of the three because it had no table.

   The purpose STRINGS are asserted too. `loadprefs` asks for "cloud_routing" and
   "companion_sync" with underscores; anything granting consent under a different
   spelling produces a permanent, silent "not consented" with a row sitting in the table
   saying otherwise. *)

f=testdir():str{
  <str.concat(std.homedir();"/.loke/test-consent")
};

f=openfreshstore():i64{
  let dir=testdir();
  file.mkdir(dir);
  (* A fresh file: consent rows are persistent and a leftover grant would make the
     fail-closed assertions pass for the wrong reason. *)
  file.delete(str.concat(dir;"/loke.db"));
  <mt sdb.openstore(dir) {
    $ok:s s;
    $err:e 0
  }
};

f=countof(rows:@$row):i64{
  if(rows.len>0){
    let r:$row=rows.get(0);
    <sdb.rowi64(r;"cnt")
  }el{
    <0-1
  }
};

(* Straight through std.db for the two facts the module exposes no accessor for: how many
   rows a (user, purpose) pair occupies, and what expiry was stored. db.many is a STDLIB
   result, so both arms are live. *)
f=rowsfor(userid:str;purpose:str):i64{
  <mt db.many("SELECT COUNT(1) AS cnt FROM consent_records WHERE user_id=? AND purpose=?";@(userid;purpose)) {
    $ok:rows countof(rows);
    $err:e 0-1
  }
};

f=firstexpiry(rows:@$row):i64{
  if(rows.len>0){
    let r:$row=rows.get(0);
    <sdb.rowi64(r;"expiry_ts")
  }el{
    <0-1
  }
};

f=expiryof(userid:str;purpose:str):i64{
  <mt db.many("SELECT expiry_ts FROM consent_records WHERE user_id=? AND purpose=? LIMIT 1";@(userid;purpose)) {
    $ok:rows firstexpiry(rows);
    $err:e 0-1
  }
};

f=setexpiry(userid:str;purpose:str;ts:i64):bool{
  <mt db.exec("UPDATE consent_records SET expiry_ts=? WHERE user_id=? AND purpose=?";@(str.fromi64(ts);userid;purpose)) {
    $ok:v true;
    $err:e false
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let store=openfreshstore();

  if(t.assert(cs.ensuretable(store);"the consent table is created")){pass=pass+1}el{fail=fail+1};
  if(t.assert(sdb.tableexists("consent_records");"and it really exists, read back from sqlite_master rather than inferred from a query that returned nothing")){pass=pass+1}el{fail=fail+1};

  (* ── Fail closed: the three ways consent can be absent ───────────────────────
     Every one of these must answer false. A consent check that answers true when it
     cannot find a record is the worst defect this module could have, because the caller
     is deciding whether to send data somewhere. *)

  (* 1. No row at all. *)
  if(t.assert(!cs.check(store;"alice";"telemetry");"NO RECORD means no consent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!cs.check(store;"nobody";"anything");"including for a user who has never been seen")){pass=pass+1}el{fail=fail+1};

  (* ── Grant, and read it back ─────────────────────────────────────────────────*)
  if(t.assert(cs.grant(store;"alice";"telemetry";0 as i32);"granting consent reports success")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs.check(store;"alice";"telemetry");"and the grant is visible to check")){pass=pass+1}el{fail=fail+1};
  if(t.assert(expiryof("alice";"telemetry")==0;"a grant with no expiry period stores expiry_ts 0, meaning no expiry")){pass=pass+1}el{fail=fail+1};

  (* Consent is per purpose. A grant for telemetry must not be read as consent for
     cloud routing — they are different disclosures. *)
  if(t.assert(!cs.check(store;"alice";"cloud_routing");"consent is PER PURPOSE: telemetry does not imply cloud routing")){pass=pass+1}el{fail=fail+1};
  (* And per user. *)
  if(t.assert(!cs.check(store;"bob";"telemetry");"and PER USER: alice's grant is not bob's")){pass=pass+1}el{fail=fail+1};

  (* ── 2. A row with granted=0, which is what revoke leaves behind ─────────────
     Revoking does not delete the row, so `check` has to distinguish granted=0 from a
     missing row. Both answer false; only one of them is the path a user who withdrew
     consent takes. *)
  if(t.assert(cs.revoke(store;"alice";"telemetry");"revoke reports success")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!cs.check(store;"alice";"telemetry");"REVOKED consent reads as no consent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(rowsfor("alice";"telemetry")==1;"and the row is still there with granted=0 — revocation is recorded, not erased")){pass=pass+1}el{fail=fail+1};

  (* Re-granting after a revocation must work, and must not duplicate the row: user_id
     and purpose are UNIQUE together, so without the ON CONFLICT clause the second grant
     is a constraint error — and the error arm of an insert is easy to lose. *)
  if(t.assert(cs.grant(store;"alice";"telemetry";0 as i32);"consent can be granted again after revocation")){pass=pass+1}el{fail=fail+1};
  if(t.assert(cs.check(store;"alice";"telemetry");"and reads as granted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(rowsfor("alice";"telemetry")==1;"with ONE row, not two: the upsert is on (user_id, purpose)")){pass=pass+1}el{fail=fail+1};

  (* ── 3. A row whose expiry has passed ───────────────────────────────────────
     Expiring consent is the point of recording an expiry at all. The deadline is written
     directly because `grant` only accepts a positive number of DAYS, so a consent that
     has already lapsed is unreachable through the module's own API. *)
  cs.grant(store;"carol";"improvement";30 as i32);
  if(t.assert(cs.check(store;"carol";"improvement");"a 30-day grant is valid now")){pass=pass+1}el{fail=fail+1};
  let stored=expiryof("carol";"improvement");
  if(t.assert(stored>0;"and stores a real expiry timestamp")){pass=pass+1}el{fail=fail+1};

  setexpiry("carol";"improvement";1000);
  if(t.assert(!cs.check(store;"carol";"improvement");"EXPIRED consent reads as no consent")){pass=pass+1}el{fail=fail+1};
  if(t.assert(rowsfor("carol";"improvement")==1;"and the record is retained, so the lapse is auditable")){pass=pass+1}el{fail=fail+1};

  (* ── loadprefs, and the purpose spellings it depends on ─────────────────────
     Granted under the exact strings loadprefs asks for. If these ever drift apart the
     symptom is a user who has consented to everything and a product that behaves as
     though they consented to nothing — with the rows in the table to contradict it. *)
  cs.grant(store;"dave";"telemetry";0 as i32);
  cs.grant(store;"dave";"cloud_routing";0 as i32);
  let prefs=cs.loadprefs(store;"dave");
  if(t.assert(prefs.telemetry;"loadprefs reads a telemetry grant")){pass=pass+1}el{fail=fail+1};
  if(t.assert(prefs.cloudrouting;"and reads cloud routing under the key 'cloud_routing', with an underscore")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!prefs.improvement;"and reports no consent for a purpose that was not granted")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!prefs.companionsync;"and the same for companion sync")){pass=pass+1}el{fail=fail+1};

  (* The negative spelling, asserted directly: granting under a camel-case or
     unpunctuated name must NOT satisfy loadprefs, so a caller using the wrong string
     finds out here rather than in production. *)
  cs.grant(store;"erin";"companionsync";0 as i32);
  let erin=cs.loadprefs(store;"erin");
  if(t.assert(!erin.companionsync;"a grant recorded as 'companionsync' does NOT satisfy loadprefs, which asks for 'companion_sync'")){pass=pass+1}el{fail=fail+1};

  <fail
};

m=test.governance.consent;

i=t:std.test;
i=str:std.str;

(* --- stub consent management functions --- *)

(* consent status codes *)
f=consentgranted():i64{ <1 };
f=consentdenied():i64{ <0 };
f=consentpending():i64{ <2 };

(* simulate consent store as category-based checks *)
f=checkconsent(userid:str;category:str):i64{
  (* user "u1" has granted analytics and storage, denied marketing *)
  if(str.eq(userid;"u1")){
    if(str.eq(category;"analytics")){<consentgranted()};
    if(str.eq(category;"storage")){<consentgranted()};
    if(str.eq(category;"marketing")){<consentdenied()};
    <consentpending()
  };
  (* unknown user = pending *)
  <consentpending()
};

(* record consent — returns 1 on success *)
f=recordconsent(userid:str;category:str;status:i64):i64{
  if(str.len(userid)=0){<0};
  if(str.len(category)=0){<0};
  <1
};

(* check if all required consents are granted *)
f=allconsentsgranted(userid:str):i64{
  if(checkconsent(userid;"analytics")=consentgranted()){
    if(checkconsent(userid;"storage")=consentgranted()){
      if(checkconsent(userid;"marketing")=consentgranted()){
        <1
      }
    }
  };
  <0
};

(* consent summary: count of granted categories for a user *)
f=grantedcount(userid:str):i64{
  let count=mut.0;
  if(checkconsent(userid;"analytics")=consentgranted()){count=count+1};
  if(checkconsent(userid;"storage")=consentgranted()){count=count+1};
  if(checkconsent(userid;"marketing")=consentgranted()){count=count+1};
  <count
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test consent status codes are distinct *)
  if(t.assert(consentgranted()=1;"granted is 1")){pass=pass+1}el{fail=fail+1};

  if(t.assert(consentdenied()=0;"denied is 0")){pass=pass+1}el{fail=fail+1};

  if(t.assert(consentpending()=2;"pending is 2")){pass=pass+1}el{fail=fail+1};

  (* test checkconsent for known user *)
  if(t.assert(checkconsent("u1";"analytics")=consentgranted();"u1 granted analytics")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkconsent("u1";"storage")=consentgranted();"u1 granted storage")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkconsent("u1";"marketing")=consentdenied();"u1 denied marketing")){pass=pass+1}el{fail=fail+1};

  if(t.assert(checkconsent("u1";"unknown_cat")=consentpending();"u1 unknown category is pending")){pass=pass+1}el{fail=fail+1};

  (* test unknown user defaults to pending *)
  if(t.assert(checkconsent("u999";"analytics")=consentpending();"unknown user is pending")){pass=pass+1}el{fail=fail+1};

  (* test record consent *)
  if(t.assert(recordconsent("u1";"analytics";consentgranted())=1;"record consent succeeds")){pass=pass+1}el{fail=fail+1};

  if(t.assert(recordconsent("";"analytics";consentgranted())=0;"empty userid fails")){pass=pass+1}el{fail=fail+1};

  if(t.assert(recordconsent("u1";"";consentgranted())=0;"empty category fails")){pass=pass+1}el{fail=fail+1};

  (* test allconsentsgranted *)
  if(t.assert(allconsentsgranted("u1")=0;"u1 does not have all consents (marketing denied)")){pass=pass+1}el{fail=fail+1};

  (* test granted count *)
  if(t.assert(grantedcount("u1")=2;"u1 has 2 granted categories")){pass=pass+1}el{fail=fail+1};

  if(t.assert(grantedcount("u999")=0;"unknown user has 0 granted")){pass=pass+1}el{fail=fail+1};

  <fail
};

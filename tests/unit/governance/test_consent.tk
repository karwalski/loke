m=test.governance.consent;

i=t:std.test;
i=str:std.str;

(* --- stub consent management functions --- *)

(* consent status codes *)
f=consent_granted():i64{ <1 };
f=consent_denied():i64{ <0 };
f=consent_pending():i64{ <2 };

(* simulate consent store as category-based checks *)
f=check_consent(user_id:str;category:str):i64{
  (* user "u1" has granted analytics and storage, denied marketing *)
  if(str.eq(user_id;"u1")){
    if(str.eq(category;"analytics")){<consent_granted()};
    if(str.eq(category;"storage")){<consent_granted()};
    if(str.eq(category;"marketing")){<consent_denied()};
    <consent_pending()
  };
  (* unknown user = pending *)
  <consent_pending()
};

(* record consent — returns 1 on success *)
f=record_consent(user_id:str;category:str;status:i64):i64{
  if(str.len(user_id)=0){<0};
  if(str.len(category)=0){<0};
  <1
};

(* check if all required consents are granted *)
f=all_consents_granted(user_id:str):i64{
  if(check_consent(user_id;"analytics")=consent_granted()){
    if(check_consent(user_id;"storage")=consent_granted()){
      if(check_consent(user_id;"marketing")=consent_granted()){
        <1
      }
    }
  };
  <0
};

(* consent summary: count of granted categories for a user *)
f=granted_count(user_id:str):i64{
  let count=mut.0;
  if(check_consent(user_id;"analytics")=consent_granted()){count=count+1};
  if(check_consent(user_id;"storage")=consent_granted()){count=count+1};
  if(check_consent(user_id;"marketing")=consent_granted()){count=count+1};
  <count
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test consent status codes are distinct *)
  if(t.assert(consent_granted()=1;"granted is 1")){pass=pass+1}el{fail=fail+1};

  if(t.assert(consent_denied()=0;"denied is 0")){pass=pass+1}el{fail=fail+1};

  if(t.assert(consent_pending()=2;"pending is 2")){pass=pass+1}el{fail=fail+1};

  (* test check_consent for known user *)
  if(t.assert(check_consent("u1";"analytics")=consent_granted();"u1 granted analytics")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_consent("u1";"storage")=consent_granted();"u1 granted storage")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_consent("u1";"marketing")=consent_denied();"u1 denied marketing")){pass=pass+1}el{fail=fail+1};

  if(t.assert(check_consent("u1";"unknown_cat")=consent_pending();"u1 unknown category is pending")){pass=pass+1}el{fail=fail+1};

  (* test unknown user defaults to pending *)
  if(t.assert(check_consent("u999";"analytics")=consent_pending();"unknown user is pending")){pass=pass+1}el{fail=fail+1};

  (* test record consent *)
  if(t.assert(record_consent("u1";"analytics";consent_granted())=1;"record consent succeeds")){pass=pass+1}el{fail=fail+1};

  if(t.assert(record_consent("";"analytics";consent_granted())=0;"empty user_id fails")){pass=pass+1}el{fail=fail+1};

  if(t.assert(record_consent("u1";"";consent_granted())=0;"empty category fails")){pass=pass+1}el{fail=fail+1};

  (* test all_consents_granted *)
  if(t.assert(all_consents_granted("u1")=0;"u1 does not have all consents (marketing denied)")){pass=pass+1}el{fail=fail+1};

  (* test granted count *)
  if(t.assert(granted_count("u1")=2;"u1 has 2 granted categories")){pass=pass+1}el{fail=fail+1};

  if(t.assert(granted_count("u999")=0;"unknown user has 0 granted")){pass=pass+1}el{fail=fail+1};

  <fail
};

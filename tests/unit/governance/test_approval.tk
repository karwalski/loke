m=test.governance.approval;

i=t:std.test;
i=str:std.str;

(* --- stub approval workflow logic mirroring core.governance.approval --- *)

(* check if approval is required based on mode, sensitivity, provider, and suppression rules *)
f=requiresapproval(mode:str;sensitivity:str;providerid:str;tasktype:str;suppressed:i64):i64{
  (* if task type is suppressed via dont-ask-again, no approval needed *)
  if(suppressed=1){<0};
  if(str.eq(mode;"always")){<1};
  if(str.eq(mode;"never")){<0};
  if(str.eq(mode;"by_sensitivity")){
    if(str.eq(sensitivity;"confidential")){<1};
    if(str.eq(sensitivity;"restricted")){<1};
    <0
  };
  if(str.eq(mode;"by_provider")){
    if(str.eq(providerid;"ollama")){<0};
    if(str.eq(providerid;"mlx")){<0};
    <1
  };
  <0
};

(* generate diff line count between original and transformed *)
f=difflinecount(origlines:i64;translines:i64):i64{
  if(origlines>translines){<origlines}el{<translines}
};

(* classify diff line type *)
f=difflinetype(origline:str;transline:str):str{
  if(str.eq(origline;transline)){<"unchanged"};
  <"changed"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test always mode requires approval *)
  if(t.assert(requiresapproval("always";"public";"openai";"chat";0)=1;"always mode requires approval")){pass=pass+1}el{fail=fail+1};

  (* test never mode skips approval *)
  if(t.assert(requiresapproval("never";"restricted";"openai";"chat";0)=0;"never mode skips approval")){pass=pass+1}el{fail=fail+1};

  (* test by_sensitivity: confidential requires approval *)
  if(t.assert(requiresapproval("by_sensitivity";"confidential";"openai";"chat";0)=1;"confidential requires approval in by_sensitivity mode")){pass=pass+1}el{fail=fail+1};

  (* test by_sensitivity: restricted requires approval *)
  if(t.assert(requiresapproval("by_sensitivity";"restricted";"openai";"chat";0)=1;"restricted requires approval in by_sensitivity mode")){pass=pass+1}el{fail=fail+1};

  (* test by_sensitivity: public does not require approval *)
  if(t.assert(requiresapproval("by_sensitivity";"public";"openai";"chat";0)=0;"public does not require approval in by_sensitivity mode")){pass=pass+1}el{fail=fail+1};

  (* test by_provider: ollama is local so no approval *)
  if(t.assert(requiresapproval("by_provider";"public";"ollama";"chat";0)=0;"ollama does not require approval")){pass=pass+1}el{fail=fail+1};

  (* test by_provider: mlx is local so no approval *)
  if(t.assert(requiresapproval("by_provider";"public";"mlx";"chat";0)=0;"mlx does not require approval")){pass=pass+1}el{fail=fail+1};

  (* test by_provider: openai requires approval *)
  if(t.assert(requiresapproval("by_provider";"public";"openai";"chat";0)=1;"openai requires approval in by_provider mode")){pass=pass+1}el{fail=fail+1};

  (* test suppressed task type overrides all modes *)
  if(t.assert(requiresapproval("always";"restricted";"openai";"chat";1)=0;"suppressed task bypasses approval")){pass=pass+1}el{fail=fail+1};

  (* test diff line type: unchanged *)
  if(t.assert(str.eq(difflinetype("hello";"hello");"unchanged");"identical lines are unchanged")){pass=pass+1}el{fail=fail+1};

  (* test diff line type: changed *)
  if(t.assert(str.eq(difflinetype("hello";"world");"changed");"different lines are changed")){pass=pass+1}el{fail=fail+1};

  <fail
};

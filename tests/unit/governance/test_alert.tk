m=test.governance.alert;

i=t:std.test;
i=str:std.str;

(* --- stub alert logic mirroring core.governance.alert --- *)

(* create an alert and return its kind *)
f=makealert(kind:str;severity:str;message:str):str{
  <str.concat(kind;str.concat(":";severity))
};

(* default config values *)
f=defaultthreshold():i64{ <20 };
f=defaultlogonly():i64{ <1 };

(* format alert as JSON-like string *)
f=alerttojson(kind:str;severity:str;message:str):str{
  <str.concat(
    str.concat(
      str.concat(
        str.concat("{\"kind\":\"";kind);
        "\",\"severity\":\"");
      severity);
    str.concat("\",\"message\":\"";str.concat(message;"\"}"))
  )
};

(* determine if quota alert should fire *)
f=shouldquotaalert(remainingpct:i64;thresholdpct:i64;exceeded:i64):i64{
  if(exceeded=1){<1};
  if(remainingpct<thresholdpct){<1};
  <0
};

(* determine quota alert severity *)
f=quotaseverity(exceeded:i64):str{
  if(exceeded=1){<"critical"};
  <"warn"
};

(* determine policy alert severity *)
f=policyseverity(action:str):str{
  if(str.eq(action;"DENY")){<"critical"};
  <"warn"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test makealert encodes kind and severity *)
  let a=makealert("quota";"warn";"low tokens");
  if(t.assert(str.contains(a;"quota");"alert contains kind")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(a;"warn");"alert contains severity")){pass=pass+1}el{fail=fail+1};

  (* test default config threshold is 20% *)
  if(t.assert(defaultthreshold()=20;"default quota threshold is 20%")){pass=pass+1}el{fail=fail+1};

  (* test default config is log-only *)
  if(t.assert(defaultlogonly()=1;"default config is log-only")){pass=pass+1}el{fail=fail+1};

  (* test alerttojson includes all fields *)
  let json=alerttojson("policy";"critical";"violation detected");
  if(t.assert(str.contains(json;"\"kind\":\"policy\"");"JSON includes kind")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(json;"\"severity\":\"critical\"");"JSON includes severity")){pass=pass+1}el{fail=fail+1};

  (* test quota alert fires when remaining below threshold *)
  if(t.assert(shouldquotaalert(15;20;0)=1;"15% remaining triggers alert at 20% threshold")){pass=pass+1}el{fail=fail+1};

  (* test quota alert does not fire when above threshold *)
  if(t.assert(shouldquotaalert(50;20;0)=0;"50% remaining does not trigger alert")){pass=pass+1}el{fail=fail+1};

  (* test quota alert fires when exceeded regardless of remaining *)
  if(t.assert(shouldquotaalert(50;20;1)=1;"exceeded flag forces alert")){pass=pass+1}el{fail=fail+1};

  (* test quota severity: exceeded is critical *)
  if(t.assert(str.eq(quotaseverity(1);"critical");"exceeded quota is critical")){pass=pass+1}el{fail=fail+1};

  (* test quota severity: not exceeded is warn *)
  if(t.assert(str.eq(quotaseverity(0);"warn");"non-exceeded quota is warn")){pass=pass+1}el{fail=fail+1};

  (* test policy severity: DENY action is critical *)
  if(t.assert(str.eq(policyseverity("DENY");"critical");"DENY action is critical")){pass=pass+1}el{fail=fail+1};

  (* test policy severity: non-DENY action is warn *)
  if(t.assert(str.eq(policyseverity("WARN");"warn");"WARN action severity is warn")){pass=pass+1}el{fail=fail+1};

  <fail
};

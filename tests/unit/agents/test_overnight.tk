m=test.agents.overnight;

i=t:std.test;
i=str:std.str;
i=at:core.agents.types;
i=reg:core.agents.registry;
i=lat:core.agents.latency;
i=ov:core.agents.overnight;

(* F10.56 — core.agents.overnight.collectovernightagents, imported.

   overnight read `agent.name` off the $agentdef that reg.listenabled answers without
   importing core.agents.types, the module that declares $agentdef, so the checker could not
   establish the field (toke 3.3.0: E4034). The agents below have an id that differs from
   their name, so a field read at the wrong place in the record would be seen here: each
   batch job must carry the agent's NAME, and only background agents are batched. *)

f=registered(r:$agentregistry;a:$agentdef):$agentregistry{
  <mt reg.register(r;a) {
    $ok:v v;
    $err:e r
  }
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let r1=registered(reg.newregistry();at.newagent("nightly-id";"Nightly digest";"Summarises the day";"Summarise: {{input}}"));
  let r2=registered(r1;at.newagent("chat-id";"Chat helper";"Answers at once";"Answer: {{input}}"));
  let r3=registered(r2;at.newagent("idle-id";"Idle agent";"Never enabled";"Idle: {{input}}"));
  let enabled=reg.enable(reg.enable(r3;"nightly-id");"chat-id");
  if(t.assert(reg.listenabled(enabled).len==2;"two of the three agents are enabled")){pass=pass+1}el{fail=fail+1};

  let assignments=@(lat.assign("Chat helper";"interactive"));
  let jobs=ov.collectovernightagents(enabled;assignments);
  if(t.assert(jobs.len==1;"only the enabled background agent is batched: the interactive one and the disabled one are not")){pass=pass+1}el{fail=fail+1};
  if(jobs.len==1){
    if(t.asserteq(jobs.get(0).agentname;"Nightly digest";"the batch job carries the agent's name, read from the right field of $agentdef")){pass=pass+1}el{fail=fail+1}
  }el{
    fail=fail+1
  };

  (* With no assignment at all every enabled agent is background (classforagent's default). *)
  let all=ov.collectovernightagents(enabled;@());
  if(t.assert(all.len==2;"with no assignments both enabled agents are batched")){pass=pass+1}el{fail=fail+1};
  if(all.len==2){
    if(t.asserteq(all.get(1).agentname;"Chat helper";"and the second job is named for the second agent")){pass=pass+1}el{fail=fail+1}
  }el{
    fail=fail+1
  };

  <fail
};

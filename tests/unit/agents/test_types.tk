m=test.agents.types;

i=t:std.test;
i=str:std.str;

(* --- stub agent type functions --- *)

f=createagent(name:str;desc:str;provider:str):str{
  let a=str.concat("{\"name\":\"";name);
  let a=str.concat(a;"\",\"description\":\"");
  let a=str.concat(a;desc);
  let a=str.concat(a;"\",\"provider\":\"");
  let a=str.concat(a;provider);
  let a=str.concat(a;"\",\"enabled\":true,\"max_turns\":10}");
  <a
};

f=defaultprovider():str{
  <"ollama"
};

f=defaultmaxturns():i64{
  <10
};

f=agentname(agentjson:str):str{
  if(str.contains(agentjson;"\"name\":\"reviewer\"")){<"reviewer"};
  if(str.contains(agentjson;"\"name\":\"summariser\"")){<"summariser"};
  <""
};

f=agentenabled(agentjson:str):bool{
  <str.contains(agentjson;"\"enabled\":true")
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* agent construction: name present *)
  let a1=createagent("reviewer";"Reviews code";"anthropic");
  if(t.assert(str.contains(a1;"reviewer");"agent contains name")){pass=pass+1}el{fail=fail+1};

  (* agent construction: description present *)
  if(t.assert(str.contains(a1;"Reviews code");"agent contains description")){pass=pass+1}el{fail=fail+1};

  (* agent construction: provider present *)
  if(t.assert(str.contains(a1;"anthropic");"agent contains provider")){pass=pass+1}el{fail=fail+1};

  (* agent construction: enabled by default *)
  if(t.assert(agentenabled(a1);"agent is enabled by default")){pass=pass+1}el{fail=fail+1};

  (* agent construction: max_turns present *)
  if(t.assert(str.contains(a1;"\"max_turns\":10");"agent has max_turns default")){pass=pass+1}el{fail=fail+1};

  (* agent name extraction *)
  if(t.assert(str.eq(agentname(a1);"reviewer");"agent name extracted correctly")){pass=pass+1}el{fail=fail+1};

  (* second agent *)
  let a2=createagent("summariser";"Summarises text";"ollama");
  if(t.assert(str.contains(a2;"summariser");"second agent name present")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(agentname(a2);"summariser");"second agent name extracted")){pass=pass+1}el{fail=fail+1};

  (* defaults *)
  if(t.assert(str.eq(defaultprovider();"ollama");"default provider is ollama")){pass=pass+1}el{fail=fail+1};
  if(t.assert(defaultmaxturns()=10;"default max turns is 10")){pass=pass+1}el{fail=fail+1};

  (* agent JSON is non-empty *)
  if(t.assert(str.len(a1)>0;"agent JSON is non-empty")){pass=pass+1}el{fail=fail+1};

  (* agent JSON is well-formed *)
  if(t.assert(str.contains(a1;"{");"agent JSON starts with brace")){pass=pass+1}el{fail=fail+1};

  <fail
};

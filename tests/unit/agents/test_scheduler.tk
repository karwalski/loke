m=test.agents.scheduler;

i=t:std.test;
i=str:std.str;

(* --- stub scheduler functions --- *)

f=shouldtrigger(schedtype:str;currenthour:i64;targethour:i64):bool{
  if(str.eq(schedtype;"hourly")){<true};
  if(str.eq(schedtype;"daily")){<currenthour=targethour};
  if(str.eq(schedtype;"manual")){<false};
  <false
};

f=triggertype(schedtype:str):str{
  if(str.eq(schedtype;"hourly")){<"time"};
  if(str.eq(schedtype;"daily")){<"time"};
  if(str.eq(schedtype;"manual")){<"user"};
  if(str.eq(schedtype;"webhook")){<"event"};
  <"unknown"
};

f=createschedule(agent:str;schedtype:str;hour:i64):str{
  let s=str.concat("{\"agent\":\"";agent);
  let s=str.concat(s;"\",\"type\":\"");
  let s=str.concat(s;schedtype);
  let s=str.concat(s;"\",\"hour\":");
  let s=str.concat(s;hour.tostr());
  let s=str.concat(s;"}");
  <s
};

f=isvalidtype(schedtype:str):bool{
  if(str.eq(schedtype;"hourly")){<true};
  if(str.eq(schedtype;"daily")){<true};
  if(str.eq(schedtype;"manual")){<true};
  if(str.eq(schedtype;"webhook")){<true};
  <false
};

(* --- tests --- *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* hourly always triggers *)
  if(t.assert(shouldtrigger("hourly";3;9);"hourly triggers at any hour")){pass=pass+1}el{fail=fail+1};

  (* daily triggers at target hour *)
  if(t.assert(shouldtrigger("daily";9;9);"daily triggers at target hour")){pass=pass+1}el{fail=fail+1};

  (* daily does not trigger at wrong hour *)
  if(t.assert(!shouldtrigger("daily";3;9);"daily does not trigger at wrong hour")){pass=pass+1}el{fail=fail+1};

  (* manual never auto-triggers *)
  if(t.assert(!shouldtrigger("manual";9;9);"manual never auto-triggers")){pass=pass+1}el{fail=fail+1};

  (* trigger types *)
  if(t.assert(str.eq(triggertype("hourly");"time");"hourly is time trigger")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(triggertype("daily");"time");"daily is time trigger")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(triggertype("manual");"user");"manual is user trigger")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(triggertype("webhook");"event");"webhook is event trigger")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(triggertype("unknown_type");"unknown");"unknown type returns unknown")){pass=pass+1}el{fail=fail+1};

  (* schedule creation *)
  let s=createschedule("reviewer";"daily";9);
  if(t.assert(str.contains(s;"reviewer");"schedule contains agent name")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(s;"daily");"schedule contains type")){pass=pass+1}el{fail=fail+1};

  (* valid type checks *)
  if(t.assert(isvalidtype("hourly");"hourly is valid type")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!isvalidtype("biweekly");"biweekly is not valid type")){pass=pass+1}el{fail=fail+1};

  <fail
};

   SPDX-License-Identifier: Apache-2.0 *)

m=test.agents.registry;

i=t:std.test;
i=apl:core.agents.pipeline;
i=str:std.str;
i=at:core.agents.types;
i=reg:core.agents.registry;

(* T12.3 — core.agents.registry, imported.

     row                                        current design
     ------------------------------------------ ---------------------------------------------
     register increases count                   asserted, through list
     get by name returns the agent              get(id), added for this row: find's result
                                                cannot be read (T-18)
     get unknown returns none                   get returns an agent with an empty id, and
                                                has() is false
     duplicate registration returns error       refused since AG1.9: the registry comes
                                                back unchanged, which a caller can observe;
                                                its $err arms cannot be (T-18)
     list returns all agents                    asserted, and listenabled
     agent has name, description, capability    name and description; capability in this
                                                design is `permissions`, asserted empty on a
                                                fresh agent *)

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  let r0=reg.newregistry();
  if(t.assert(reg.list(r0).len==0;"a new registry holds no agents")){pass=pass+1}el{fail=fail+1};

  let a1=at.newagent("digest";"Daily digest";"Summarises the day's notes";"Summarise: {{input}}");
  let a2=at.newagent("triage";"Inbox triage";"Sorts incoming mail";"Sort: {{input}}");
  let r1=mt reg.register(r0;a1) {
    $ok:v v;
    $err:e r0
  };
  if(t.assert(reg.list(r1).len==1;"registering an agent increases the count to one")){pass=pass+1}el{fail=fail+1};
  let r2=mt reg.register(r1;a2) {
    $ok:v v;
    $err:e r1
  };
  if(t.assert(reg.list(r2).len==2;"and a second to two")){pass=pass+1}el{fail=fail+1};
  if(t.assert(reg.list(r1).len==1;"the registry it was added to is unchanged — register returns a new value")){pass=pass+1}el{fail=fail+1};

  let got=reg.get(r2;"triage");
  if(t.asserteq(got.id;"triage";"get by id returns that agent")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(got.name;"Inbox triage";"with its name")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(got.description;"Sorts incoming mail";"its description")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(got.prompttemplate;"Sort: {{input}}";"and its prompt, so it is the whole record and not the first one")){pass=pass+1}el{fail=fail+1};
  if(t.assert(got.permissions.len==0;"a fresh agent is granted no permissions")){pass=pass+1}el{fail=fail+1};
  let gotd=reg.get(r2;"digest");
  if(t.asserteq(gotd.name;"Daily digest";"and the other id returns the other agent")){pass=pass+1}el{fail=fail+1};

  let none=reg.get(r2;"no-such-agent");
  if(t.asserteq(none.id;"";"get for an unknown id returns an agent with an empty id")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!reg.has(r2;"no-such-agent");"and has() says so")){pass=pass+1}el{fail=fail+1};
  if(t.assert(reg.has(r2;"digest");"while has() finds a registered one")){pass=pass+1}el{fail=fail+1};

  (* list and listenabled. newagent creates agents disabled. *)
  let all=reg.list(r2);
  let first:$agentdef=all.get(0);
  let second:$agentdef=all.get(1);
  if(t.assert(str.eq(first.id;"digest") & str.eq(second.id;"triage");"list returns every agent, in registration order")){pass=pass+1}el{fail=fail+1};
  if(t.assert(reg.listenabled(r2).len==0;"a newly registered agent is not enabled")){pass=pass+1}el{fail=fail+1};
  let r3=reg.enable(r2;"triage");
  let en=reg.listenabled(r3);
  if(t.assert(en.len==1;"enabling one makes exactly one enabled")){pass=pass+1}el{fail=fail+1};
  if(en.len==1){
    let e0:$agentdef=en.get(0);
    if(t.asserteq(e0.id;"triage";"and it is the one enabled")){pass=pass+1}el{fail=fail+1}
  }el{ fail=fail+1 };
  let r4=reg.disable(r3;"triage");
  if(t.assert(reg.listenabled(r4).len==0;"disabling it again leaves none enabled")){pass=pass+1}el{fail=fail+1};
  if(t.assert(reg.list(reg.enable(r2;"no-such-agent")).len==2;"enabling an unknown id changes nothing")){pass=pass+1}el{fail=fail+1};

  (* AG1.9. A duplicate id is refused, and so is an agent with no name or no prompt. The
     registry comes back unchanged, which a caller can observe, unlike register's $err
     arms (T-18). *)
  let dup=mt reg.register(r2;at.newagent("triage";"Another triage";"dup";"x: {{input}}")) {
    $ok:v v;
    $err:e r2
  };
  if(t.assert(reg.list(dup).len==2;"registering a second agent with an existing id is refused")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(reg.get(dup;"triage").name;"Inbox triage";"and the original agent is untouched")){pass=pass+1}el{fail=fail+1};
  let noname=mt reg.register(r2;at.newagent("nameless";"";"d";"x: {{input}}")) {
    $ok:v v;
    $err:e r2
  };
  if(t.assert(reg.list(noname).len==2 && !reg.has(noname;"nameless");"an agent without a name is refused, and the registry is still a registry")){pass=pass+1}el{fail=fail+1};

  (* AG1.9, a caller. An agent pipeline whose second step names an unknown agent used to
     "process" it, because the match on reg.find took the first arm whatever it held (T-18). *)
  let pl=apl.newpipeline("two-step";@($pipelinestep{agentname:"digest";passoutput:true;transform:""};$pipelinestep{agentname:"ghost";passoutput:true;transform:""}));
  let run=apl.runpipeline(pl;"hello";r2);
  if(t.assert(!run.ok;"a pipeline with an unknown agent does not report success")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(run.stepresults.get(0);"[digest] processed");"the known agent's step ran")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(run.stepresults.get(1);"agent not found: ghost");"and the unknown one is reported as not found, not processed")){pass=pass+1}el{fail=fail+1};

  <fail
};

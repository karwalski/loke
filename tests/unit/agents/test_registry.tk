



m=tests.unit.agents.testregistry;

i=areg:core.agents.registry;
i=at:core.agents.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:$str; passed:bool; message:$str };

f=pass(n:$str):$result{ <$result{name:n;passed:true;message:"ok"} };
f=fail(n:$str;msg:$str):$result{ <$result{name:n;passed:false;message:msg} };

f=asserteq(n:$str;got:$str;want:$str):$result{
  if(str.eq(got;want)){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(n:$str;v:bool):$result{
  if(v){ <pass(n) }el{ <fail(n;"expected true") };
};

f=assertfalse(n:$str;v:bool):$result{
  if(v){ <fail(n;"expected false") }el{ <pass(n) };
};

f=assertinteq(n:$str;got:i32;want:i32):$result{
  if(got = want){ <pass(n) }el{
    <fail(n;str.concat("want=";str.concat(str.fromint(want);str.concat(" got=";str.fromint(got)))))
  };
};

f=logresult(r:$result):i64{
  if(r.passed){ <log.info(str.concat("PASS ";r.name)) }el{
    <log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results = @($result);

  
  let reg = areg.newregistry();
  let initiallist = areg.list(reg);
  results = str.arraypush(results;assertinteq("fresh registry has zero agents";initiallist.len;0));

  
  let agenta = at.newagent("agent-alpha";"Alpha Agent";"Summarises daily reports";"Summarise the following: {{input}}");
  mt areg.register(reg;agenta) {
    $ok:v 0;
    $err:e log.warn(str.concat("register failed: ";e.message);"test";"")
  };
  let afterone = areg.list(reg);
  results = str.arraypush(results;assertinteq("after register count is 1";afterone.len;1));

  
  let agentb = at.newagent("agent-beta";"Beta Agent";"Classifies tickets";"Classify this ticket: {{input}}");
  mt areg.register(reg;agentb) {
    $ok:v 0;
    $err:e log.warn(str.concat("register failed: ";e.message);"test";"")
  };
  let aftertwo = areg.list(reg);
  results = str.arraypush(results;assertinteq("after second register count is 2";aftertwo.len;2));

  
  let founda = mt areg.find(reg;"agent-alpha") {
    $ok:a a;
    $err:e at.newagent("";"";"";"")
  };
  results = str.arraypush(results;asserteq("find returns correct name";founda.name;"Alpha Agent"));
  results = str.arraypush(results;asserteq("find returns correct id";founda.id;"agent-alpha"));

  
  results = str.arraypush(results;asserttrue("agent has non-empty name";str.len(founda.name) > 0));

  
  results = str.arraypush(results;asserteq("agent has description field";founda.description;"Summarises daily reports"));

  
  let notfound = mt areg.find(reg;"unknown_xyz") {
    $ok:a false;
    $err:e true
  };
  results = str.arraypush(results;asserttrue("find unknown returns error";notfound));

  
  
  
  let agentadup = at.newagent("agent-alpha";"Alpha Agent v2";"Duplicate registration test";"Prompt: {{input}}");
  let dupresult = mt areg.register(reg;agentadup) {
    $ok:v "ok";
    $err:e str.concat("err:";e.message)
  };
  let afterdup = areg.list(reg);
  
  results = str.arraypush(results;assertinteq("duplicate name appended, count is 3";afterdup.len;3));

  
  let agentnoname = at.newagent("";"";"";"some prompt");
  let badreg = mt areg.register(reg;agentnoname) {
    $ok:v "ok";
    $err:e "err"
  };
  results = str.arraypush(results;asserteq("empty name register returns error";badreg;"err"));

  
  let agentnoprompt = at.newagent("agent-noprompt";"No Prompt Agent";"desc";"");
  let badprompt = mt areg.register(reg;agentnoprompt) {
    $ok:v "ok";
    $err:e "err"
  };
  results = str.arraypush(results;asserteq("empty prompt_template register returns error";badprompt;"err"));

  
  let agentdefaults = at.newagent("agent-defaults";"Defaults Agent";"Check defaults";"Do: {{input}}");
  results = str.arraypush(results;assertfalse("new_agent enabled defaults to false";agentdefaults.enabled));
  results = str.arraypush(results;asserttrue("new_agent requires_approval defaults to true";agentdefaults.requiresapproval));

  
  let reg2 = areg.newregistry();
  let agentc = at.newagent("agent-gamma";"Gamma Agent";"Enabled test";"Process: {{input}}");
  mt areg.register(reg2;agentc) {
    $ok:v 0;
    $err:e 0
  };
  mt areg.enable(reg2;"agent-gamma") {
    $ok:v 0;
    $err:e log.warn("enable failed";"test";"")
  };
  let enabledlist = areg.listenabled(reg2);
  results = str.arraypush(results;assertinteq("list_enabled shows 1 after enable";enabledlist.len;1));

  
  mt areg.disable(reg2;"agent-gamma") {
    $ok:v 0;
    $err:e log.warn("disable failed";"test";"")
  };
  let disabledlist = areg.listenabled(reg2);
  results = str.arraypush(results;assertinteq("list_enabled shows 0 after disable";disabledlist.len;0));

  
  let run1 = at.newrun("agent-gamma";"manual");
  areg.recordrun(reg2;run1);
  let runs = areg.getruns(reg2;"agent-gamma");
  results = str.arraypush(results;assertinteq("get_runs returns 1 run";runs.len;1));

  let all = true;
  let i = 0;
  let n = str.arraylen(results);
  lp(let lv=0;i < n;lv=lv){
    let r = str.arrayget(results;i);
    logresult(r);
    if(r.passed){ i = i+1 }el{ all = false; i = i+1 };
  };
  <all
};

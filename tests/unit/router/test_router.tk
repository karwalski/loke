m=test.router.router;

i=t:std.test;
i=str:std.str;

(* --- stub router functions --- *)

(* route a request to the best model — returns model name *)
f=route_request(task:str;sensitivity:i64;prefer_local:i64):str{
  (* critical sensitivity always routes local *)
  if(sensitivity>2){<"llama3"};
  (* user prefers local *)
  if(prefer_local=1){
    if(str.eq(task;"code")){<"mistral-7b"};
    <"llama3"
  };
  (* cloud routing by task *)
  if(str.eq(task;"code")){<"gpt-4o"};
  if(str.eq(task;"chat")){<"claude-sonnet"};
  if(str.eq(task;"vision")){<"gpt-4o"};
  <"llama3"
};

(* select model from candidates — returns best match *)
f=select_model(task:str;candidates:str):str{
  (* candidates is a comma-separated list — simplified stub *)
  if(str.contains(candidates;"gpt-4o")){
    if(str.eq(task;"code")){<"gpt-4o"}
  };
  if(str.contains(candidates;"claude-sonnet")){
    if(str.eq(task;"chat")){<"claude-sonnet"}
  };
  if(str.contains(candidates;"llama3")){<"llama3"};
  <""
};

(* check if a model is available *)
f=model_available(name:str):i64{
  if(str.eq(name;"llama3")){<1};
  if(str.eq(name;"mistral-7b")){<1};
  if(str.eq(name;"gpt-4o")){<1};
  if(str.eq(name;"claude-sonnet")){<1};
  <0
};

(* fallback model when primary is unavailable *)
f=fallback_model():str{ <"llama3" };

(* estimate cost tier: 0=free (local), 1=cheap, 2=expensive *)
f=cost_tier(model:str):i64{
  if(str.eq(model;"llama3")){<0};
  if(str.eq(model;"mistral-7b")){<0};
  if(str.eq(model;"gpt-4o")){<2};
  if(str.eq(model;"claude-sonnet")){<2};
  <1
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test critical sensitivity routes local *)
  if(t.assert(str.eq(route_request("code";3;0);"llama3");"critical sensitivity routes to local model")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(route_request("chat";3;0);"llama3");"critical chat also routes local")){pass=pass+1}el{fail=fail+1};

  (* test prefer_local flag *)
  if(t.assert(str.eq(route_request("code";0;1);"mistral-7b");"local preference for code uses mistral")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(route_request("chat";0;1);"llama3");"local preference for chat uses llama3")){pass=pass+1}el{fail=fail+1};

  (* test cloud routing by task *)
  if(t.assert(str.eq(route_request("code";0;0);"gpt-4o");"code task routes to gpt-4o")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(route_request("chat";0;0);"claude-sonnet");"chat task routes to claude-sonnet")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(route_request("vision";0;0);"gpt-4o");"vision task routes to gpt-4o")){pass=pass+1}el{fail=fail+1};

  (* test model selection from candidates *)
  if(t.assert(str.eq(select_model("code";"gpt-4o,llama3");"gpt-4o");"selects gpt-4o for code")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(select_model("chat";"claude-sonnet,llama3");"claude-sonnet");"selects claude-sonnet for chat")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(select_model("chat";"llama3");"llama3");"falls back to llama3 if no better match")){pass=pass+1}el{fail=fail+1};

  (* test model availability *)
  if(t.assert(model_available("llama3")=1;"llama3 is available")){pass=pass+1}el{fail=fail+1};

  if(t.assert(model_available("nonexistent")=0;"nonexistent model not available")){pass=pass+1}el{fail=fail+1};

  (* test fallback *)
  if(t.assert(str.eq(fallback_model();"llama3");"fallback is llama3")){pass=pass+1}el{fail=fail+1};

  (* test cost tiers *)
  if(t.assert(cost_tier("llama3")=0;"llama3 is free tier")){pass=pass+1}el{fail=fail+1};

  if(t.assert(cost_tier("gpt-4o")=2;"gpt-4o is expensive tier")){pass=pass+1}el{fail=fail+1};

  <fail
};

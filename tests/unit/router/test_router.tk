



m=tests.unit.router.testrouter;

i=router:core.router.router;
i=sel:core.router.selector;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=assertequ32(name:str;got:u32;want:u32):$result{
  if(got=want){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(str.fromu32(want);str.concat(" got=";str.fromu32(got)))))
  }
};

f=asserteqf64(name:str;got:f64;want:f64):$result{
  if(got=want){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(str.fromfloat(want);str.concat(" got=";str.fromfloat(got)))))
  }
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") }
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  
  let cfg=router.newconfig("http://127.0.0.1:11434");
  results=str.arraypush(results;asserttrue("new_config prefer_local is true";cfg.preferlocal));

  
  results=str.arraypush(results;asserteqf64("new_config max_cost_per_1k is 0.05";cfg.maxcostper1k;0.05));

  
  results=str.arraypush(results;asserteq("new_config ollama_url stored";cfg.ollamaurl;"http://127.0.0.1:11434"));

  
  results=str.arraypush(results;asserttrue("new_config default_tolerance is instant";cfg.defaulttolerance=$instant));

  
  let r=router.new(cfg);
  results=str.arraypush(results;asserttrue("new router config prefer_local matches";r.config.preferlocal));
  results=str.arraypush(results;asserteq("new router config ollama_url matches";r.config.ollamaurl;"http://127.0.0.1:11434"));

  
  let tolpatient=sel.tolerancefromstr("patient");
  results=str.arraypush(results;asserttrue("tolerance_from_str patient";tolpatient=$patient));

  
  let tolbg=sel.tolerancefromstr("background");
  results=str.arraypush(results;asserttrue("tolerance_from_str background";tolbg=$background));

  
  let tolinst=sel.tolerancefromstr("instant");
  results=str.arraypush(results;asserttrue("tolerance_from_str instant";tolinst=$instant));

  
  let tolunknown=sel.tolerancefromstr("unknown-value");
  results=str.arraypush(results;asserttrue("tolerance_from_str unknown defaults to instant";tolunknown=$instant));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let allpassed=false }el{};
      i=i+1;
    }
  };
  <allpassed
};

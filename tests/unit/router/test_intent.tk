



m=tests.unit.router.testintent;

i=intent:core.router.intent;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") }
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};


f=checkconfidence(name:str;confidence:f64):$result{
  let ok=if(confidence>0.0){ if(confidence<=1.0){ true }el{ false } }el{ false };
  if(ok){ <pass(name) }el{
    <fail(name;str.concat("confidence out of range: ";str.fromfloat(confidence)))
  }
};

f=runall():bool{
  let results=@($result);

  
  let coderesult=intent.classifyfast("write a function to sort a list");
  results=str.arraypush(results;asserttrue("classify_fast code text returns code_generation";coderesult.task=$codegeneration));
  results=str.arraypush(results;checkconfidence("classify_fast code confidence in range";coderesult.confidence));

  
  let implresult=intent.classifyfast("implement a binary search algorithm");
  results=str.arraypush(results;asserttrue("classify_fast implement returns code_generation";implresult.task=$codegeneration));

  
  let reviewresult=intent.classifyfast("review this code and suggest improvements");
  results=str.arraypush(results;asserttrue("classify_fast review code returns code_review";reviewresult.task=$codereview));

  
  let summresult=intent.classifyfast("summarise this document for me");
  results=str.arraypush(results;asserttrue("classify_fast summarise returns summarisation";summresult.task=$summarisation));

  
  let tldrresult=intent.classifyfast("tldr of the following text");
  results=str.arraypush(results;asserttrue("classify_fast tldr returns summarisation";tldrresult.task=$summarisation));

  
  let classresult=intent.classifyfast("classify this text into categories");
  results=str.arraypush(results;asserttrue("classify_fast classify returns classification";classresult.task=$classification));

  
  let embedresult=intent.classifyfast("embed these sentences for vector search");
  results=str.arraypush(results;asserttrue("classify_fast embed returns embedding";embedresult.task=$embedding));

  
  let dataresult=intent.classifyfast("analyse the data and find trends");
  results=str.arraypush(results;asserttrue("classify_fast analyse returns data_analysis";dataresult.task=$dataanalysis));

  
  let chatresult=intent.classifyfast("hello, how are you today");
  results=str.arraypush(results;asserttrue("classify_fast generic text returns chat";chatresult.task=$chat));
  results=str.arraypush(results;checkconfidence("classify_fast chat confidence in range";chatresult.confidence));

  
  results=str.arraypush(results;asserteq("classify_fast method is keyword";chatresult.method;"keyword"));

  
  results=str.arraypush(results;asserttrue("task_from_str code_generation";intent.taskfromstr("code_generation")=$codegeneration));
  results=str.arraypush(results;asserttrue("task_from_str code_review";intent.taskfromstr("code_review")=$codereview));
  results=str.arraypush(results;asserttrue("task_from_str summarisation";intent.taskfromstr("summarisation")=$summarisation));
  results=str.arraypush(results;asserttrue("task_from_str classification";intent.taskfromstr("classification")=$classification));
  results=str.arraypush(results;asserttrue("task_from_str ner";intent.taskfromstr("ner")=$ner));
  results=str.arraypush(results;asserttrue("task_from_str embedding";intent.taskfromstr("embedding")=$embedding));
  results=str.arraypush(results;asserttrue("task_from_str data_analysis";intent.taskfromstr("data_analysis")=$dataanalysis));

  
  results=str.arraypush(results;asserttrue("task_from_str unknown defaults to chat";intent.taskfromstr("unknown-task")=$chat));

  
  let nerresult=intent.classifyfast("identify all the entities in this text");
  results=str.arraypush(results;asserttrue("classify_fast identify returns ner";nerresult.task=$ner));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let allpassed=false }el{};
      i=i+1;
    }
  };
  <allpassed
};

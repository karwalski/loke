m=test.router.intent;

i=t:std.test;
i=str:std.str;

(* --- stub intent classification (mirrors classifyfast logic) --- *)

(* task type constants *)
f=embedding():i64{ <0 };
f=summarisation():i64{ <1 };
f=classification():i64{ <2 };
f=codegeneration():i64{ <3 };
f=codereview():i64{ <4 };
f=dataanalysis():i64{ <5 };
f=ner():i64{ <6 };
f=chat():i64{ <7 };

(* taskfromstr: string to task type *)
f=taskfromstr(s:str):i64{
  if(str.eq(s;"code_generation")){<codegeneration()};
  if(str.eq(s;"code_review")){<codereview()};
  if(str.eq(s;"summarisation")){<summarisation()};
  if(str.eq(s;"classification")){<classification()};
  if(str.eq(s;"ner")){<ner()};
  if(str.eq(s;"embedding")){<embedding()};
  if(str.eq(s;"data_analysis")){<dataanalysis()};
  <chat()
};

(* classifyfast: keyword-based intent classification *)
f=classifyfast(text:str):i64{
  if(str.contains(text;"embed")){<embedding()};
  if(str.contains(text;"embedding")){<embedding()};
  if(str.contains(text;"vector")){<embedding()};
  if(str.contains(text;"similarity")){<embedding()};
  if(str.contains(text;"summarise")){<summarisation()};
  if(str.contains(text;"summarize")){<summarisation()};
  if(str.contains(text;"tldr")){<summarisation()};
  if(str.contains(text;"summary")){<summarisation()};
  if(str.contains(text;"categorise")){<classification()};
  if(str.contains(text;"classify")){<classification()};
  if(str.contains(text;"label")){<classification()};
  if(str.contains(text;"review")){
    if(str.contains(text;"code")){<codereview()};
    if(str.contains(text;"function")){<codereview()};
    <chat()
  };
  if(str.contains(text;"implement")){<codegeneration()};
  if(str.contains(text;"refactor")){<codegeneration()};
  if(str.contains(text;"debug")){<codegeneration()};
  if(str.contains(text;"analyse")){<dataanalysis()};
  if(str.contains(text;"analyze")){<dataanalysis()};
  if(str.contains(text;"csv")){<dataanalysis()};
  if(str.contains(text;"who is")){<ner()};
  if(str.contains(text;"identify")){<ner()};
  <chat()
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* T1: embedding keywords *)
  if(t.assert(classifyfast("create an embedding for this text")=embedding();"embed keyword triggers embedding task")){pass=pass+1}el{fail=fail+1};

  (* T2: vector keyword *)
  if(t.assert(classifyfast("compute the vector representation")=embedding();"vector keyword triggers embedding task")){pass=pass+1}el{fail=fail+1};

  (* T3: summarisation keywords *)
  if(t.assert(classifyfast("please summarise this document")=summarisation();"summarise keyword triggers summarisation")){pass=pass+1}el{fail=fail+1};

  (* T4: US spelling of summarize *)
  if(t.assert(classifyfast("summarize the report")=summarisation();"summarize (US) also triggers summarisation")){pass=pass+1}el{fail=fail+1};

  (* T5: classification keywords *)
  if(t.assert(classifyfast("classify this email as spam or ham")=classification();"classify keyword triggers classification")){pass=pass+1}el{fail=fail+1};

  (* T6: code review with code signal *)
  if(t.assert(classifyfast("review this code for bugs")=codereview();"review + code triggers code review")){pass=pass+1}el{fail=fail+1};

  (* T7: code generation via implement *)
  if(t.assert(classifyfast("implement a sorting algorithm")=codegeneration();"implement keyword triggers code generation")){pass=pass+1}el{fail=fail+1};

  (* T8: data analysis via csv *)
  if(t.assert(classifyfast("load this csv and find trends")=dataanalysis();"csv keyword triggers data analysis")){pass=pass+1}el{fail=fail+1};

  (* T9: NER via who is *)
  if(t.assert(classifyfast("who is mentioned in this article")=ner();"who is triggers NER task")){pass=pass+1}el{fail=fail+1};

  (* T10: fallback to chat *)
  if(t.assert(classifyfast("hello how are you today")=chat();"generic text falls back to chat")){pass=pass+1}el{fail=fail+1};

  (* T11: taskfromstr round-trip *)
  if(t.assert(taskfromstr("embedding")=embedding();"taskfromstr parses embedding correctly")){pass=pass+1}el{fail=fail+1};

  <fail
};

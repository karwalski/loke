m=test.router.intent;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=rtr:core.router.router;
i=intent:core.router.intent;
i=json:std.json;

(* X7.2 — this file re-declared core.router.intent's keyword classifier as eight i64
   constants and a copy of classifyfast, then asserted against the copy:

     (* --- stub intent classification (mirrors classifyfast logic) --- *)
     f=codegeneration():i64{ <3 };
     ...
     if(t.assert(classifyfast("implement a sorting algorithm")==codegeneration();"implement keyword triggers code generation")){...}

   The real `classifyfast` returns an `$intentresult` struct carrying a task, a confidence
   and a method — not an i64 — so none of the eleven assertions could have been made
   against it. And the copy covered only the part of the module that works: it had no
   stand-in for `classify`, which is the function the router actually calls, and which is
   broken.

   `classifyfast` is pure and correct, and is asserted thoroughly below. `classify` wraps
   it with an LLM call and is the subject of the finding at the bottom of this file. *)

f=describe(r:$intentresult):str{
  <str.concat(rtr.tasktostr(r.task);str.concat("/";r.method))
};

f=deadurl():str{
  (* A port nothing is listening on, so "no classifier is reachable" is the case under
     test rather than an accident of the environment. *)
  <"http://127.0.0.1:59998"
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── taskfromstr: the eight wire names, round-tripped against router.tasktostr ─
     These two functions are inverse and live in different modules. core.router.router
     writes the name into a log line and intent parses the same eight strings back out of
     an LLM reply, so a mismatch reclassifies a request silently. *)
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("chat"));"chat";"chat round-trips")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("code_generation"));"code_generation";"code_generation does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("code_review"));"code_review";"code_review does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("summarisation"));"summarisation";"summarisation does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("classification"));"classification";"classification does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("ner"));"ner";"ner does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("embedding"));"embedding";"embedding does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("data_analysis"));"data_analysis";"data_analysis does")){pass=pass+1}el{fail=fail+1};

  (* Anything unrecognised becomes chat. That is a sensible default AND the reason the
     defect at the bottom of this file is hard to see: a garbage task reads as "chat"
     rather than as an error. Asserted so the masking is on the record. *)
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr("Code Generation"));"chat";"an unrecognised name defaults to chat — note this MASKS a bad parse rather than reporting one")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.taskfromstr(""));"chat";"and so does an empty name")){pass=pass+1}el{fail=fail+1};

  (* ── classifyfast: the keyword layer ─────────────────────────────────────────
     Pure, local, and the only classification that happens on a machine with no model
     server running. Each family is asserted through the task it produces. *)
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("create an embedding for this text").task);"embedding";"embed triggers embedding")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("compute the vector representation").task);"embedding";"vector does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("rank by similarity").task);"embedding";"similarity does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("please summarise this document").task);"summarisation";"summarise triggers summarisation")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("summarize the report").task);"summarisation";"the US spelling does too, which matters for a British-English product with American users")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("tldr").task);"summarisation";"tldr does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("classify this email as spam or ham").task);"classification";"classify triggers classification")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("review this code for bugs").task);"code_review";"review plus code triggers code review, not plain classification")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("implement a sorting algorithm").task);"code_generation";"implement triggers code generation")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("refactor this function").task);"code_generation";"refactor does")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("load this csv and find trends").task);"data_analysis";"csv triggers data analysis")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("who is mentioned in this article").task);"ner";"who is triggers NER")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("hello how are you today").task);"chat";"and generic text falls back to chat")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(rtr.tasktostr(intent.classifyfast("").task);"chat";"as does empty text")){pass=pass+1}el{fail=fail+1};

  (* Every classifyfast result must declare itself a keyword classification, because the
     method field is the provenance of the figure beside it. *)
  if(t.asserteq(intent.classifyfast("hello").method;"keyword";"classifyfast reports its method as keyword")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(intent.classifyfast("create an embedding").method;"keyword";"on the high-confidence path too")){pass=pass+1}el{fail=fail+1};

  (* Confidence must be a probability. A value outside 0..1 would make any downstream
     comparison meaningless, and `classify`'s own 0.80 threshold reads it. *)
  if(t.assert(intent.classifyfast("create an embedding").confidence<=1.0;"confidence is at most 1.0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(intent.classifyfast("create an embedding").confidence>0.0;"and above 0.0")){pass=pass+1}el{fail=fail+1};
  if(t.assert(intent.classifyfast("hello how are you").confidence<=1.0;"on the fallback path as well")){pass=pass+1}el{fail=fail+1};
  if(t.assert(intent.classifyfast("hello how are you").confidence>0.0;"in both directions")){pass=pass+1}el{fail=fail+1};

  (* A keyword match must be MORE confident than the generic fallback, or the confidence
     figure carries no information and `classify`'s threshold cannot discriminate. *)
  if(t.assert(intent.classifyfast("create an embedding").confidence>intent.classifyfast("hello how are you").confidence;"a keyword match is more confident than the chat fallback")){pass=pass+1}el{fail=fail+1};

  (* ── classify, with a HIGH-confidence prompt ─────────────────────────────────
     Above the 0.80 threshold the LLM is not consulted at all, so this path is sound and
     is asserted as the working contrast to the one below. *)
  let high:$intentresult=intent.classify("create an embedding for this text";deadurl());
  if(t.asserteq(rtr.tasktostr(high.task);"embedding";"a high-confidence prompt keeps its keyword task")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(high.method;"keyword";"and is correctly labelled a keyword classification, because no LLM was consulted")){pass=pass+1}el{fail=fail+1};

  (* ── FINDING, LIVE, WITH A CALLER: classify DISCARDS a correct classification ─
     and labels the result as an LLM classification that never happened.

     core.router.intent.classify:319-333 binds all three of its stdlib results with the
     ERROR arm written first:

       let raw=mt resp { $httperr:e fast; $ok:raw raw };

     `mt` binds arms by POSITION, not by tag, so the first arm runs whatever the value is:
     `raw` is bound to `fast` — an $intentresult struct — and never to the response body.
     `json.dec(raw)` then decodes a struct pointer as a string, `json.str` reads "content"
     off the result, and `taskfromstr` of that falls through to its default. The binding
     also has two different types across its arms, which is the shape
     core.storage.audit records as the one that segfaults with data present.

     So the `fast` value placed in those arms as a fallback is never RETURNED. It is fed
     into the parser instead, and the function ends at the unconditional last line:

       <$intentresult{task:task;confidence:0.72;method:"llm"}

     MEASURED, with nothing listening on the port:

       prompt                            classifyfast              classify
       "implement a sorting algorithm"   code_generation/keyword   chat/llm  (0.80 -> 0.72)
       "load this csv and find trends"   data_analysis/keyword     chat/llm  (0.78 -> 0.72)
       "hello how are you today"         chat/keyword              chat/llm  (0.60 -> 0.72)

     Three consequences, in order of seriousness:

     1. The threshold is `> 0.80`, and 41 of the 56 keyword outcomes in this module are
        0.60, 0.70, 0.78 or 0.80 — so MOST classifications take this path. Every
        code-generation and data-analysis prompt among them is routed as `chat`.
        core.router.router:308 calls classify on every request and feeds
        `intentresult.task` into `$selectioncriteria.task`, so a request asking for code
        is not offered a code model. That is a live routing defect with a live caller.
     2. The reported confidence RISES to 0.72 from a keyword result of 0.78 or 0.80. A
        fallback must not report more confidence than the thing it fell back from.
     3. `method` reads "llm" when no LLM was reached. That is a provenance claim about a
        figure, and this project treats a figure whose provenance is wrong as a defect in
        its own right.

     Asserted in the honest direction, so this file is RED until the three arms are
     reordered: the contract a caller needs is that an unreachable classifier yields the
     keyword result unchanged. Not fixed here — the module belongs to another story. *)
  let lowcode:$intentresult=intent.classify("implement a sorting algorithm";deadurl());
  if(t.asserteq(rtr.tasktostr(lowcode.task);"code_generation";"with no classifier reachable, classify returns the KEYWORD task — a code-generation prompt must not be routed as chat")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lowcode.method;"keyword";"and labels it keyword, because no LLM was consulted — reporting \"llm\" is a false provenance claim")){pass=pass+1}el{fail=fail+1};
  (* T2.5. This was `>=` under a label saying "does not report MORE", so it passed on
     exactly the defect it names: a fallback that raised the confidence satisfied it.
     The contract is that the keyword result comes back unchanged, so it is equality. *)
  if(t.assert(lowcode.confidence==intent.classifyfast("implement a sorting algorithm").confidence;"and reports the keyword confidence unchanged, neither more nor less")){pass=pass+1}el{fail=fail+1};

  let lowdata:$intentresult=intent.classify("load this csv and find trends";deadurl());
  if(t.asserteq(rtr.tasktostr(lowdata.task);"data_analysis";"the same for a data-analysis prompt")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lowdata.method;"keyword";"and its method")){pass=pass+1}el{fail=fail+1};

  (* The one case the defect cannot be seen in, asserted so that a future reader does not
     mistake it for evidence that the path works: a prompt whose keyword task is ALREADY
     chat comes back as chat either way. Only the method gives it away. *)
  let lowchat:$intentresult=intent.classify("hello how are you today";deadurl());
  if(t.asserteq(rtr.tasktostr(lowchat.task);"chat";"a chat prompt is chat on both paths, which is why the defect above is invisible without the method field")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(lowchat.method;"keyword";"and here the method is the only witness")){pass=pass+1}el{fail=fail+1};

  (* T2.5's own cases, on classify -- the function the router calls -- and not only on
     classifyfast. *)
  let summ:$intentresult=intent.classify("summarise this document";deadurl());
  if(t.asserteq(rtr.tasktostr(summ.task);"summarisation";"classify on \"summarise this document\" returns summarisation")){pass=pass+1}el{fail=fail+1};
  if(t.assert(summ.confidence>=0.0 && summ.confidence<=1.0;"and its confidence is within [0,1]")){pass=pass+1}el{fail=fail+1};
  let rev:$intentresult=intent.classify("review this code for bugs";deadurl());
  if(t.asserteq(rtr.tasktostr(rev.task);"code_review";"classify on code-like review text returns code_review")){pass=pass+1}el{fail=fail+1};
  if(t.assert(rev.confidence>=0.0 && rev.confidence<=1.0;"and its confidence is within [0,1]")){pass=pass+1}el{fail=fail+1};

  (* The LLM path, fed the body Ollama's /api/chat actually returns. `message` is an
     OBJECT, not a string. *)
  let fastchat:$intentresult=intent.classifyfast("hello how are you today");
  let llm:$intentresult=intent.classifyfromjson("{\"model\":\"qwen2.5:7b\",\"message\":{\"role\":\"assistant\",\"content\":\"code_review\"},\"done\":true}";fastchat);
  if(t.asserteq(rtr.tasktostr(llm.task);"code_review";"an Ollama answer of code_review is read as code_review")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(llm.method;"llm";"and labelled llm, because a model was consulted")){pass=pass+1}el{fail=fail+1};
  let nl:$intentresult=intent.classifyfromjson("{\"message\":{\"role\":\"assistant\",\"content\":\"summarisation\\n\"}}";fastchat);
  if(t.asserteq(rtr.tasktostr(nl.task);"summarisation";"a reply with a trailing newline is still read")){pass=pass+1}el{fail=fail+1};
  let junk:$intentresult=intent.classifyfromjson("{\"message\":{\"role\":\"assistant\",\"content\":\"I think this is a greeting\"}}";fastchat);
  if(t.asserteq(junk.method;"keyword";"a reply naming no task falls back to the keyword result rather than claiming the model chose chat")){pass=pass+1}el{fail=fail+1};
  (* F5.10. A multi-line prompt still makes a well-formed request. RED BEFORE THE FIX:
     the raw-newline assertion; json.enc left the newline raw. The json.dec assertion was
     green even then, because std.json's own reader accepts a raw newline inside a string
     (Ollama's does not), so it guards the quotes only. *)
  let cb=intent.classifybody("line one
line \"two\"");
  if(t.assert(mt json.dec(cb) {$ok:j true;$jsonerr:e false};"the classifier request is valid JSON for a multi-line prompt with quotes")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!str.contains(cb;"
");"and carries no raw newline")){pass=pass+1}el{fail=fail+1};
  let nocontent:$intentresult=intent.classifyfromjson("{\"message\":{\"role\":\"assistant\"}}";fastchat);
  if(t.asserteq(nocontent.method;"keyword";"a reply with no content falls back to the keyword result")){pass=pass+1}el{fail=fail+1};

  <fail
};

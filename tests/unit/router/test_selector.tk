m=test.router.selector;

i=t:std.test;
i=str:std.str;

(* --- stub selector functions --- *)

(* tolerance from string *)
f=tolerancefromstr(s:str):i64{
  if(str.eq(s;"patient")){<1};
  if(str.eq(s;"background")){<2};
  <0
};

(* tier from tolerance *)
f=tierfromtolerance(tolerance:i64):i64{
  if(tolerance=0){<0};
  if(tolerance=1){<1};
  <2
};

(* tier to string *)
f=tiertostr(tier:i64):str{
  if(tier=0){<"interactive"};
  if(tier=1){<"considered"};
  <"background"
};

(* sensitivity to string *)
f=senstostr(level:i64):str{
  if(level=0){<"PUBLIC"};
  if(level=1){<"INTERNAL"};
  if(level=2){<"CONFIDENTIAL"};
  <"RESTRICTED"
};

(* provider to string *)
f=providertostr(p:i64):str{
  if(p=0){<"anthropic"};
  if(p=1){<"openai"};
  if(p=2){<"google"};
  if(p=3){<"ollama"};
  if(p=4){<"local"};
  <"openrouter"
};

(* build reason string *)
f=buildreason(modelid:str;localonly:i64;sensitivitystr:str;tierstr:str):str{
  let localpart=mut."cloud-eligible (sensitivity: ";
  if(localonly=1){localpart="local-only (sensitivity: "}el{};
  let senspart=str.concat(localpart;sensitivitystr);
  let closepart=str.concat(senspart;", tier: ");
  let tierpart=str.concat(closepart;tierstr);
  let reasonmid=str.concat(tierpart;") => ");
  <str.concat(reasonmid;modelid)
};

(* stub select: restricted forces local; preferlocal tries local first *)
f=selectmodel(task:str;sensitivity:i64;preferlocal:i64;tolerance:i64):str{
  let isrestricted=sensitivity=3;
  let localonly=mut.preferlocal;
  if(isrestricted){localonly=1}el{};
  if(localonly=1){
    if(str.eq(task;"code")){<"codellama-7b"};
    <"llama3"
  }el{};
  if(str.eq(task;"code")){<"gpt-4o"};
  if(str.eq(task;"chat")){<"claude-3-5-sonnet"};
  <"llama3"
};

(* stub cost estimation *)
f=estimatecost(modelid:str;inputk:i64;outputk:i64):i64{
  if(str.contains(modelid;"llama")){<0};
  if(str.contains(modelid;"codellama")){<0};
  if(str.contains(modelid;"gpt-4o-mini")){<inputk*15+outputk*60};
  if(str.contains(modelid;"gpt-4o")){<inputk*500+outputk*1500};
  if(str.contains(modelid;"claude-3-5-sonnet")){<inputk*300+outputk*1500};
  if(str.contains(modelid;"claude-3-5-haiku")){<inputk*100+outputk*500};
  <inputk*100+outputk*300
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* T1: restricted sensitivity forces local routing *)
  let m1=selectmodel("code";3;0;0);
  if(t.assert(str.eq(m1;"codellama-7b");"restricted sensitivity forces local model for code")){pass=pass+1}el{fail=fail+1};

  (* T2: restricted sensitivity forces local even for chat *)
  let m2=selectmodel("chat";3;0;0);
  if(t.assert(str.eq(m2;"llama3");"restricted sensitivity forces local model for chat")){pass=pass+1}el{fail=fail+1};

  (* T3: preferlocal selects local model *)
  let m3=selectmodel("code";0;1;0);
  if(t.assert(str.eq(m3;"codellama-7b");"preferlocal selects local code model")){pass=pass+1}el{fail=fail+1};

  (* T4: cloud routing for code task *)
  let m4=selectmodel("code";0;0;0);
  if(t.assert(str.eq(m4;"gpt-4o");"cloud code routes to gpt-4o")){pass=pass+1}el{fail=fail+1};

  (* T5: cloud routing for chat task *)
  let m5=selectmodel("chat";0;0;0);
  if(t.assert(str.eq(m5;"claude-3-5-sonnet");"cloud chat routes to claude-3-5-sonnet")){pass=pass+1}el{fail=fail+1};

  (* T6: tolerancefromstr parses known values *)
  if(t.assert(tolerancefromstr("patient")=1;"patient tolerance parsed correctly")){pass=pass+1}el{fail=fail+1};
  if(t.assert(tolerancefromstr("background")=2;"background tolerance parsed correctly")){pass=pass+1}el{fail=fail+1};
  if(t.assert(tolerancefromstr("instant")=0;"instant is the default tolerance")){pass=pass+1}el{fail=fail+1};

  (* T7: tierfromtolerance maps correctly *)
  if(t.assert(str.eq(tiertostr(tierfromtolerance(0));"interactive");"instant tolerance maps to interactive tier")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.eq(tiertostr(tierfromtolerance(1));"considered");"patient tolerance maps to considered tier")){pass=pass+1}el{fail=fail+1};

  (* T8: local models have zero cost *)
  if(t.assert(estimatecost("llama3";10;10)=0;"local model cost is zero")){pass=pass+1}el{fail=fail+1};

  (* T9: cloud models have positive cost *)
  if(t.assert(estimatecost("gpt-4o";10;10)>0;"cloud model cost is positive")){pass=pass+1}el{fail=fail+1};

  (* T10: buildreason includes model id *)
  let reason=buildreason("gpt-4o";0;"PUBLIC";"interactive");
  if(t.assert(str.contains(reason;"gpt-4o");"reason string contains model id")){pass=pass+1}el{fail=fail+1};

  (* T11: buildreason local-only vs cloud-eligible prefix *)
  let reasonlocal=buildreason("llama3";1;"RESTRICTED";"interactive");
  if(t.assert(str.contains(reasonlocal;"local-only");"local-only reason has correct prefix")){pass=pass+1}el{fail=fail+1};

  <fail
};

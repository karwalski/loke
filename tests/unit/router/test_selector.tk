
m=tests.unit.router.testselector;

i=sel:core.router.selector;
i=reg:core.models.registry;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") }
};

f=assertfalse(name:str;val:bool):$result{
  if(!val){ <pass(name) }el{ <fail(name;"expected false") }
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  let criteria=$selectioncriteria{
    task:$chat;
    sensitivity:$public;
    tolerance:$instant;
    preferlocal:false;
    maxcostper1k:0.05;
    requiretools:false
  };
  results=str.arraypush(results;asserttrue("selection_criteria task field";criteria.task=$chat));
  results=str.arraypush(results;asserttrue("selection_criteria sensitivity field";criteria.sensitivity=$public));
  results=str.arraypush(results;asserttrue("selection_criteria tolerance field";criteria.tolerance=$instant));
  results=str.arraypush(results;assertfalse("selection_criteria prefer_local false";criteria.preferlocal));
  results=str.arraypush(results;assertfalse("selection_criteria require_tools false";criteria.requiretools));

  results=str.arraypush(results;asserteq("provider_to_str anthropic";sel.providertostr($anthropic);"anthropic"));
  results=str.arraypush(results;asserteq("provider_to_str openai";sel.providertostr($openai);"openai"));
  results=str.arraypush(results;asserteq("provider_to_str ollama";sel.providertostr($ollama);"ollama"));
  results=str.arraypush(results;asserteq("provider_to_str local";sel.providertostr($local);"local"));
  results=str.arraypush(results;asserteq("provider_to_str google";sel.providertostr($google);"google"));
  results=str.arraypush(results;asserteq("provider_to_str mistral";sel.providertostr($mistral);"mistral"));
  results=str.arraypush(results;asserteq("provider_to_str openrouter";sel.providertostr($openrouter);"openrouter"));

  results=str.arraypush(results;asserttrue("tolerance_from_str patient";sel.tolerancefromstr("patient")=$patient));
  results=str.arraypush(results;asserttrue("tolerance_from_str background";sel.tolerancefromstr("background")=$background));
  results=str.arraypush(results;asserttrue("tolerance_from_str instant";sel.tolerancefromstr("instant")=$instant));

  let registry=reg.newregistry();
  let restrictedcriteria=$selectioncriteria{
    task:$chat;
    sensitivity:$restricted;
    tolerance:$instant;
    preferlocal:false;
    maxcostper1k:1.0;
    requiretools:false
  };
  let selresult=sel.select(restrictedcriteria;registry);
  let rrestricted=mt selresult {
    Err:e asserttrue("select restricted returns local model";false);
    Ok:cap asserttrue("select restricted returns local model";cap.islocal)
  };
  results=str.arraypush(results;rrestricted);

  let publiccriteria=$selectioncriteria{
    task:$chat;
    sensitivity:$public;
    tolerance:$instant;
    preferlocal:false;
    maxcostper1k:1.0;
    requiretools:false
  };
  let pubresult=sel.select(publiccriteria;registry);
  let rpublic=mt pubresult {
    Err:e asserttrue("select public sensitivity returns a result";false);
    Ok:cap asserttrue("select public sensitivity model_id non-empty";!str.eq(cap.modelid;""))
  };
  results=str.arraypush(results;rpublic);

  let localprefcriteria=$selectioncriteria{
    task:$chat;
    sensitivity:$public;
    tolerance:$instant;
    preferlocal:true;
    maxcostper1k:1.0;
    requiretools:false
  };
  let localresult=sel.select(localprefcriteria;registry);
  let rlocal=mt localresult {
    Err:e asserttrue("select prefer_local returns a result";false);
    Ok:cap asserttrue("select prefer_local returns local model";cap.islocal)
  };
  results=str.arraypush(results;rlocal);

  let bgcriteria=$selectioncriteria{
    task:$summarisation;
    sensitivity:$public;
    tolerance:$background;
    preferlocal:false;
    maxcostper1k:1.0;
    requiretools:false
  };
  let bgresult=sel.select(bgcriteria;registry);
  let rbg=mt bgresult {
    Err:e asserttrue("select background tolerance returns a result";false);
    Ok:cap asserttrue("select background tolerance model_id non-empty";!str.eq(cap.modelid;""))
  };
  results=str.arraypush(results;rbg);

  let emptyreg=$registry{entries:@($modelcapability)};
  let emptyresult=sel.select(restrictedcriteria;emptyreg);
  let rempty=mt emptyresult {
    Err:e asserttrue("empty registry restricted returns error";true);
    Ok:cap asserttrue("empty registry restricted should return error";false)
  };
  results=str.arraypush(results;rempty);

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ br }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!r.passed){ let allpassed=false }el{};
      i=i+1
    }
  };
  <allpassed
};

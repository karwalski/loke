m=test.router.escalation;

i=t:std.test;
i=str:std.str;
i=sh:shared.types;
i=prov:core.providers.types;
i=sens:core.router.sensitivity;
i=esc:core.router.escalation;

(* T2.4 — core.router.escalation: the ladder, the trigger record, and the formatted
   message. Plus, recorded rather than worked around, the two things the story asks for
   that this module does not do.

   WHY THIS FILE EXISTS AT ALL. The story was marked Done against
   `tests/unit/router/test_escalation.tk`, and no such file was in the live tree: the only
   copy is `_archived-tests/loke/unit/router/test_escalation.tk`, excluded from discovery
   by scripts/run_tests.sh's `-not -path '*/_archived-tests/*'`. None of its assertions had
   ever been run. It cannot be revived either — `esc.defaultpolicy.minconfidence` reads
   `defaultpolicy` as a value where it is a function, `=` is used for equality throughout
   (T-14/E2002), and `trigger.reason` is read without annotating the intermediate, which
   `reason` being declared by several structs at different offsets now makes ambiguous at
   the READ (E4034). It is read here for intent only.

   ── SENSITIVITY (T2.4) AND POLICY (F5.8) ────────────────────────────────────────────

   The row specified "escalation path selected when sensitivity is RESTRICTED;
   non-escalation for PUBLIC". Until F5.8 this module had no sensitivity input at all, so
   the clause could not be asserted. It now does: escalationtarget takes the prompt's
   $sensitivitylevel and refuses every CLOUD rung for RESTRICTED, through the same
   core.router.sensitivity.canusecloud gate routerequest uses, while a PUBLIC prompt may
   take it. The clause's literal wording -- RESTRICTED selects the escalation path -- is
   not what is asserted, because it would send restricted data up a ladder that leaves the
   machine; RESTRICTED still climbs the LOCAL rungs.

   F5.8, also fixed and asserted below. Before it: shouldescalate never read its policy;
   escalationtarget took no policy so allowcloudescalation:false could not stop it; every
   unrecognised model, the empty model id of a failed completion, and the top rung itself
   all answered claude-3-5-sonnet. Each of those assertions was RED against that code.

   Still LATENT: nothing in packages/ imports core.router.escalation, so no request path
   escalates today. These assertions are the contract a future caller inherits.

   NO NETWORK. Every function here is pure except recordescalation, which writes one log
   line and reads the clock. *)

f=resp(content:str;outtok:i64;model:str):$completionresponse{
  <$completionresponse{
    content:content;
    modelid:model;
    inputtokens:10 as u32;
    outputtokens:outtok as u32;
    finishreason:"stop";
    costusd:0.0
  }
};

(* Long enough to clear the 100-character short-answer test, so the three phrase checks
   cannot fire and the only thing under test is the branch named in each assertion. *)
f=goodanswer():str{
  <"Canberra is the capital of Australia, chosen as a compromise between Sydney and Melbourne and founded in 1913."
};

f=nocloud():$escalationpolicy{
  <$escalationpolicy{maxretries:0;allowcloudescalation:false}
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* ── defaultpolicy ─────────────────────────────────────────────────────────── *)
  let p:$escalationpolicy=esc.defaultpolicy();
  if(t.assert((p.maxretries as i64)==2;"the default retry budget is 2")){pass=pass+1}el{fail=fail+1};
  if(t.assert(p.allowcloudescalation;"and cloud escalation is permitted by default")){pass=pass+1}el{fail=fail+1};
  let strict:$escalationpolicy=nocloud();
  if(t.assert((strict.maxretries as i64)==0;"a caller's own policy carries its retry budget")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!strict.allowcloudescalation;"and its refusal of cloud escalation")){pass=pass+1}el{fail=fail+1};
  let pub=sh.public();
  let rst=sh.restricted();

  (* ── shouldescalate: the four branches that DO decide ────────────────────────
     The control comes first. A complete answer must NOT escalate, or every request
     escalates and the local-first promise is void. *)
  let good=goodanswer();
  if(t.assert(!esc.shouldescalate(resp(good;200;"qwen2.5:7b");p;0);"a long, complete answer does NOT escalate — the non-escalation path")){pass=pass+1}el{fail=fail+1};

  (* Empty content. This is also the shape of core.providers.types.nocompletion, the
     sentinel every provider answers a FAILED completion with (LS1.1j), so a failed call
     escalates rather than being returned to the user as an empty reply. *)
  if(t.assert(esc.shouldescalate(resp("";200;"qwen2.5:7b");p;0);"an EMPTY answer escalates — which is also what a failed provider call looks like")){pass=pass+1}el{fail=fail+1};
  if(t.assert(esc.shouldescalate(prov.nocompletion("connection refused");p;0);"and the nocompletion sentinel itself escalates, so a dead provider is retried rather than surfaced as silence")){pass=pass+1}el{fail=fail+1};

  (* The token floor, by its exact boundary. "> 0" would be satisfied by any threshold at
     all; the threshold is ten, and nine escalates while ten does not. *)
  if(t.assert(esc.shouldescalate(resp(good;9;"qwen2.5:7b");p;0);"nine output tokens escalates")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!esc.shouldescalate(resp(good;10;"qwen2.5:7b");p;0);"and ten does not — the floor is strictly below 10, not around it")){pass=pass+1}el{fail=fail+1};

  (* The three refusal phrases, and the length guard on them. The guard matters: without
     it a long, genuinely useful answer that happens to contain "I cannot" in a subordinate
     clause would be thrown away and re-run on a bigger model. *)
  if(t.assert(esc.shouldescalate(resp("I don't know.";200;"qwen2.5:7b");p;0);"a short \"I don't know\" escalates")){pass=pass+1}el{fail=fail+1};
  if(t.assert(esc.shouldescalate(resp("I cannot answer that.";200;"qwen2.5:7b");p;0);"so does \"I cannot\"")){pass=pass+1}el{fail=fail+1};
  if(t.assert(esc.shouldescalate(resp("I'm not sure.";200;"qwen2.5:7b");p;0);"and \"I'm not sure\"")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!esc.shouldescalate(resp("Canberra.";200;"qwen2.5:7b");p;0);"a SHORT answer that is simply correct does not escalate: shortness alone is not a fault")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!esc.shouldescalate(resp(str.concat("I don't know who asked, but ";good);200;"qwen2.5:7b");p;0);"and a LONG answer containing the phrase does not escalate — the phrase test is guarded by the 100-character length test")){pass=pass+1}el{fail=fail+1};

  (* ── F5.8: the policy's retry budget is read ──────────────────────────────────
     RED BEFORE F5.8: the policy was never read, so an empty answer escalated under a
     zero-retry policy and on the tenth attempt alike. *)
  if(t.assert(!esc.shouldescalate(resp("";200;"qwen2.5:7b");strict;0);"a zero-retry policy never escalates, even an empty answer")){pass=pass+1}el{fail=fail+1};
  if(t.assert(esc.shouldescalate(resp("";200;"qwen2.5:7b");p;1);"under the default budget of 2, the second attempt may still escalate")){pass=pass+1}el{fail=fail+1};
  if(t.assert(!esc.shouldescalate(resp("";200;"qwen2.5:7b");p;2);"and the third may not: the budget is spent")){pass=pass+1}el{fail=fail+1};

  (* ── escalationtarget: the ladder, under a permissive policy and PUBLIC data ─── *)
  if(t.asserteq(esc.escalationtarget("qwen2.5:7b";p;pub);"qwen2.5:72b";"a small local model escalates to a LARGER LOCAL one, keeping the request on the machine")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("llama3.2:3b";p;pub);"llama3.1:8b";"and so does the smallest llama")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("llama3.1:8b";p;pub);"claude-3-5-haiku-20241022";"the 8b rung is where the ladder LEAVES THE MACHINE, for PUBLIC data under a permissive policy")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("qwen2.5:72b";p;pub);"claude-3-5-sonnet-20241022";"and the largest local model escalates to the strongest hosted one")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("claude-3-5-haiku-20241022";p;pub);"claude-3-5-sonnet-20241022";"haiku escalates to sonnet")){pass=pass+1}el{fail=fail+1};

  (* ── F5.8 (3): the fallback refuses. Each was claude-3-5-sonnet before. ──────── *)
  if(t.asserteq(esc.escalationtarget("claude-3-5-sonnet-20241022";p;pub);"";"the top of the ladder has no next rung, rather than escalating to ITSELF")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("some-unknown-model";p;pub);"";"an UNRECOGNISED model is not escalated to a cloud provider")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("";p;pub);"";"nor is an EMPTY model id, which is what a failed completion carries in .modelid")){pass=pass+1}el{fail=fail+1};
  let failed:$completionresponse=prov.nocompletion("connection refused");
  if(t.asserteq(esc.escalationtarget(failed.modelid;p;pub);"";"so a failed completion does not escalate to the cloud")){pass=pass+1}el{fail=fail+1};

  (* ── F5.8 (2): allowcloudescalation:false stops the cloud rungs, not the local ─ *)
  let localonly:$escalationpolicy=$escalationpolicy{maxretries:2;allowcloudescalation:false};
  if(t.asserteq(esc.escalationtarget("llama3.1:8b";localonly;pub);"";"a no-cloud policy refuses the 8b rung's cloud target")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("qwen2.5:72b";localonly;pub);"";"and the 72b rung's")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("qwen2.5:7b";localonly;pub);"qwen2.5:72b";"but still allows a LOCAL rung, so the policy is not simply 'never escalate'")){pass=pass+1}el{fail=fail+1};

  (* ── T2.4: sensitivity. RESTRICTED never reaches a cloud rung; PUBLIC may. ─────
     The PUBLIC controls above are the same models under the same policy, so these
     cannot pass because the ladder simply stopped. *)
  if(t.assert(!sens.canusecloud(rst);"core.router.sensitivity forbids a RESTRICTED prompt from reaching a cloud provider")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("llama3.1:8b";p;rst);"";"and the escalation ladder now agrees: RESTRICTED is refused at the 8b rung's cloud target")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("qwen2.5:72b";p;rst);"";"and at the 72b rung's")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("qwen2.5:7b";p;rst);"qwen2.5:72b";"while a RESTRICTED prompt may still climb a LOCAL rung")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.escalationtarget("llama3.1:8b";p;sh.confidential());"claude-3-5-haiku-20241022";"CONFIDENTIAL follows canusecloud, which permits it -- the ladder adds no rule of its own")){pass=pass+1}el{fail=fail+1};

  (* ── recordescalation: the trigger record ───────────────────────────────────
     The row asks for a reason field on the result, and for the message to name the model.
     Both hold. The intermediate is annotated because `reason` is declared by several
     structs at different offsets and toke reports the ambiguity at the READ (E4034). *)
  let trig:$escalationtrigger=esc.recordescalation("qwen2.5:7b";"qwen2.5:72b";"low token count");
  if(t.asserteq(trig.frommodel;"qwen2.5:7b";"the record names the model that was escalated FROM")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(trig.tomodel;"qwen2.5:72b";"and the model escalated TO")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(trig.reason;"low token count";"and it carries the REASON field the story specifies, verbatim")){pass=pass+1}el{fail=fail+1};

  (* A real clock, not a zero and not a placeholder. "> 0" is not enough: a created_at of
     0 read as 1970 is how the memory sweep came within one story of deleting the user's
     whole palace (tests/unit/memory/test_decay.tk), so a timestamp is bounded at both
     ends. These bounds are 2023-11-14 and 2033-05-18 in Unix MILLISECONDS, which also
     catches the commonest error in this field: seconds written where ms were meant. *)
  if(t.assert(trig.triggeredat>1700000000000;"the trigger is stamped with a real clock reading, not 0 — and in MILLISECONDS, so a seconds value would fail this lower bound")){pass=pass+1}el{fail=fail+1};
  if(t.assert(trig.triggeredat<2000000000000;"and one this side of 2033, so a microsecond or nanosecond reading would fail too")){pass=pass+1}el{fail=fail+1};

  (* Two records taken in order must not go backwards. A monotonicity failure here would
     make an escalation trail unorderable, which is what a reviewer reads it for. *)
  let trig2:$escalationtrigger=esc.recordescalation("llama3.1:8b";"claude-3-5-haiku-20241022";"empty response");
  if(t.assert(trig2.triggeredat>=trig.triggeredat;"a later escalation is stamped no earlier than an earlier one")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(trig2.reason;"empty response";"and each record keeps its OWN reason — the second is not the first's")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(trig2.tomodel;"claude-3-5-haiku-20241022";"and its own destination")){pass=pass+1}el{fail=fail+1};

  (* An empty reason is passed through rather than defaulted. A caller that forgets to say
     why must produce a visibly empty trail entry, not a plausible invented one. *)
  let trigblank:$escalationtrigger=esc.recordescalation("a";"b";"");
  if(t.asserteq(trigblank.reason;"";"an empty reason is recorded as empty, not substituted with a plausible default")){pass=pass+1}el{fail=fail+1};

  (* ── formattrigger: the message a person reads ───────────────────────────────
     The story asks that the escalation message contain the model name. It contains both,
     and the whole string is asserted by equality: "contains the model name" is satisfied
     by a message that has lost the reason, or the direction, or names the two models the
     wrong way round. *)
  let msg=esc.formattrigger(trig);
  if(t.asserteq(msg;"Escalated: qwen2.5:7b → qwen2.5:72b (low token count)";"the whole message, by equality — direction, both model names and the reason, in order")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(msg;"qwen2.5:7b");"it names the model escalated from")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(msg;"qwen2.5:72b");"and the model escalated to")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(msg;"low token count");"and the reason")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(msg;"→");"with an arrow, so the direction is unambiguous to a reader")){pass=pass+1}el{fail=fail+1};

  (* Formatting is a pure function of the record, so a hand-built trigger formats the
     same way. This is what says the message is built from the fields rather than from
     whatever recordescalation happened to be called with. *)
  let manual:$escalationtrigger=$escalationtrigger{
    reason:"test reason";
    frommodel:"model-a";
    tomodel:"model-b";
    triggeredat:1000
  };
  if(t.asserteq(esc.formattrigger(manual);"Escalated: model-a → model-b (test reason)";"a hand-built record formats from its own fields")){pass=pass+1}el{fail=fail+1};
  if(t.asserteq(esc.formattrigger(trigblank);"Escalated: a → b ()";"and an empty reason leaves visibly empty brackets rather than being hidden")){pass=pass+1}el{fail=fail+1};

  <fail
};

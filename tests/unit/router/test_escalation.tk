m=tests.unit.router.test_escalation;







m=tests.unit.router.testescalation;

i=esc:core.router.escalation;
i=prov:providers.types;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }el{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  }
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }el{ <fail(name;"expected true") }
};

f=assertfalse(name:str;val:bool):$result{
  if(!$val){ <pass(name) }el{ <fail(name;"expected false") }
};

f=logresult(r:$result):i64{
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }el{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  }
};

f=runall():bool{
  let results=@($result);

  
  results=str.arraypush(results;asserttrue("default_policy min_confidence is 0.7";esc.defaultpolicy.minconfidence=0.7));

  
  results=str.arraypush(results;asserttrue("default_policy max_retries is 2";esc.defaultpolicy.maxretries=2));

  
  results=str.arraypush(results;asserttrue("default_policy allow_cloud_escalation is true";esc.defaultpolicy.allowcloudescalation));

  
  results=str.arraypush(results;asserteq("escalation_target qwen2.5:7b";esc.escalationtarget("qwen2.5:7b");"qwen2.5:72b"));

  
  results=str.arraypush(results;asserteq("escalation_target llama3.2:3b";esc.escalationtarget("llama3.2:3b");"llama3.1:8b"));

  
  results=str.arraypush(results;asserteq("escalation_target llama3.1:8b";esc.escalationtarget("llama3.1:8b");"claude-3-5-haiku-20241022"));

  
  results=str.arraypush(results;asserteq("escalation_target qwen2.5:72b";esc.escalationtarget("qwen2.5:72b");"claude-3-5-sonnet-20241022"));

  
  results=str.arraypush(results;asserteq("escalation_target unknown model fallback";esc.escalationtarget("some-unknown-model");"claude-3-5-sonnet-20241022"));

  
  let trigger=esc.recordescalation("qwen2.5:7b";"qwen2.5:72b";"low token count");
  results=str.arraypush(results;asserteq("record_escalation from_model";trigger.frommodel;"qwen2.5:7b"));
  results=str.arraypush(results;asserteq("record_escalation to_model";trigger.tomodel;"qwen2.5:72b"));
  results=str.arraypush(results;asserteq("record_escalation reason";trigger.reason;"low token count"));

  
  results=str.arraypush(results;asserttrue("record_escalation triggered_at non-zero";trigger.triggeredat > 0));

  
  let formatted=esc.formattrigger(trigger);
  results=str.arraypush(results;asserttrue("format_trigger contains from_model";str.contains(formatted;"qwen2.5:7b")));
  results=str.arraypush(results;asserttrue("format_trigger contains to_model";str.contains(formatted;"qwen2.5:72b")));
  results=str.arraypush(results;asserttrue("format_trigger contains reason";str.contains(formatted;"low token count")));
  results=str.arraypush(results;asserttrue("format_trigger contains Escalated";str.contains(formatted;"Escalated")));

  
  results=str.arraypush(results;asserttrue("format_trigger contains arrow";str.contains(formatted;"→")));

  
  let policy=$escalationpolicy{
    minconfidence:0.8;
    maxretries:3;
    allowcloudescalation:false
  };
  results=str.arraypush(results;asserttrue("custom policy min_confidence";policy.minconfidence=0.8));
  results=str.arraypush(results;asserttrue("custom policy max_retries";policy.maxretries=3));
  results=str.arraypush(results;assertfalse("custom policy no cloud escalation";policy.allowcloudescalation));

  
  let manualtrigger=$escalationtrigger{
    reason:"test reason";
    frommodel:"model-a";
    tomodel:"model-b";
    triggeredat:1000
  };
  results=str.arraypush(results;asserteq("escalation_trigger reason field";manualtrigger.reason;"test reason"));
  results=str.arraypush(results;asserteq("escalation_trigger from_model field";manualtrigger.frommodel;"model-a"));
  results=str.arraypush(results;asserteq("escalation_trigger to_model field";manualtrigger.tomodel;"model-b"));
  results=str.arraypush(results;asserttrue("escalation_trigger triggered_at field";manualtrigger.triggeredat=1000));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  lp(let lv=0;true;lv=lv){
    if(i>n){ break }el{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let allpassed=false }el{};
      i=i+1;
    }
  };
  <allpassed
};

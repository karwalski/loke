m=test.router.sensitivity;

i=t:std.test;
i=str:std.str;

(* --- stub sensitivity classification functions --- *)

(* sensitivity levels *)
f=levelpublic():i64{ <0 };
f=levelinternal():i64{ <1 };
f=levelconfidential():i64{ <2 };
f=levelrestricted():i64{ <3 };

(* classify text sensitivity *)
f=classify(text:str):i64{
  (* restricted: financial, health, government IDs *)
  if(str.contains(text;"credit card")){<levelrestricted()};
  if(str.contains(text;"passport")){<levelrestricted()};
  if(str.contains(text;"medical record")){<levelrestricted()};
  if(str.contains(text;"tax file")){<levelrestricted()};
  (* confidential: personal contact info *)
  if(str.contains(text;"@")){<levelconfidential()};
  if(str.contains(text;"phone number")){<levelconfidential()};
  if(str.contains(text;"home address")){<levelconfidential()};
  (* internal: business context *)
  if(str.contains(text;"internal memo")){<levelinternal()};
  if(str.contains(text;"proprietary")){<levelinternal()};
  if(str.contains(text;"company strategy")){<levelinternal()};
  (* default: public *)
  <levelpublic()
};

(* label for sensitivity level *)
f=levellabel(level:i64):str{
  if(level=0){<"public"};
  if(level=1){<"internal"};
  if(level=2){<"confidential"};
  if(level=3){<"restricted"};
  <"unknown"
};

(* check if level requires local-only routing *)
f=requireslocal(level:i64):i64{
  if(level>1){<1};
  <0
};

(* check if level requires audit logging *)
f=requiresaudit(level:i64):i64{
  if(level>0){<1};
  <0
};

(* get the higher of two sensitivity levels *)
f=maxlevel(a:i64;b:i64):i64{
  if(a>b){<a};
  <b
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test sensitivity level values are ordered *)
  if(t.assert(levelpublic()<levelinternal();"public < internal")){pass=pass+1}el{fail=fail+1};

  if(t.assert(levelinternal()<levelconfidential();"internal < confidential")){pass=pass+1}el{fail=fail+1};

  if(t.assert(levelconfidential()<levelrestricted();"confidential < restricted")){pass=pass+1}el{fail=fail+1};

  (* test classification *)
  if(t.assert(classify("hello world")=levelpublic();"plain text is public")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("see the internal memo")=levelinternal();"internal memo is internal")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("email user@test.com")=levelconfidential();"email is confidential")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("my credit card number")=levelrestricted();"credit card is restricted")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("send medical record")=levelrestricted();"medical record is restricted")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("proprietary algorithm")=levelinternal();"proprietary content is internal")){pass=pass+1}el{fail=fail+1};

  (* test level labels *)
  if(t.assert(str.eq(levellabel(0);"public");"level 0 is public")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(levellabel(3);"restricted");"level 3 is restricted")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(levellabel(99);"unknown");"invalid level is unknown")){pass=pass+1}el{fail=fail+1};

  (* test requireslocal *)
  if(t.assert(requireslocal(levelpublic())=0;"public does not require local")){pass=pass+1}el{fail=fail+1};

  if(t.assert(requireslocal(levelconfidential())=1;"confidential requires local")){pass=pass+1}el{fail=fail+1};

  if(t.assert(requireslocal(levelrestricted())=1;"restricted requires local")){pass=pass+1}el{fail=fail+1};

  (* test requiresaudit *)
  if(t.assert(requiresaudit(levelpublic())=0;"public does not require audit")){pass=pass+1}el{fail=fail+1};

  if(t.assert(requiresaudit(levelinternal())=1;"internal requires audit")){pass=pass+1}el{fail=fail+1};

  (* test maxlevel *)
  if(t.assert(maxlevel(1;3)=3;"max of 1 and 3 is 3")){pass=pass+1}el{fail=fail+1};

  if(t.assert(maxlevel(2;0)=2;"max of 2 and 0 is 2")){pass=pass+1}el{fail=fail+1};

  <fail
};

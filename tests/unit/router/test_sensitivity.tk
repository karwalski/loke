m=test.router.sensitivity;

i=t:std.test;
i=str:std.str;

(* --- stub sensitivity classification functions --- *)

(* sensitivity levels *)
f=level_public():i64{ <0 };
f=level_internal():i64{ <1 };
f=level_confidential():i64{ <2 };
f=level_restricted():i64{ <3 };

(* classify text sensitivity *)
f=classify(text:str):i64{
  (* restricted: financial, health, government IDs *)
  if(str.contains(text;"credit card")){<level_restricted()};
  if(str.contains(text;"passport")){<level_restricted()};
  if(str.contains(text;"medical record")){<level_restricted()};
  if(str.contains(text;"tax file")){<level_restricted()};
  (* confidential: personal contact info *)
  if(str.contains(text;"@")){<level_confidential()};
  if(str.contains(text;"phone number")){<level_confidential()};
  if(str.contains(text;"home address")){<level_confidential()};
  (* internal: business context *)
  if(str.contains(text;"internal memo")){<level_internal()};
  if(str.contains(text;"proprietary")){<level_internal()};
  if(str.contains(text;"company strategy")){<level_internal()};
  (* default: public *)
  <level_public()
};

(* label for sensitivity level *)
f=level_label(level:i64):str{
  if(level=0){<"public"};
  if(level=1){<"internal"};
  if(level=2){<"confidential"};
  if(level=3){<"restricted"};
  <"unknown"
};

(* check if level requires local-only routing *)
f=requires_local(level:i64):i64{
  if(level>1){<1};
  <0
};

(* check if level requires audit logging *)
f=requires_audit(level:i64):i64{
  if(level>0){<1};
  <0
};

(* get the higher of two sensitivity levels *)
f=max_level(a:i64;b:i64):i64{
  if(a>b){<a};
  <b
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* test sensitivity level values are ordered *)
  if(t.assert(level_public()<level_internal();"public < internal")){pass=pass+1}el{fail=fail+1};

  if(t.assert(level_internal()<level_confidential();"internal < confidential")){pass=pass+1}el{fail=fail+1};

  if(t.assert(level_confidential()<level_restricted();"confidential < restricted")){pass=pass+1}el{fail=fail+1};

  (* test classification *)
  if(t.assert(classify("hello world")=level_public();"plain text is public")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("see the internal memo")=level_internal();"internal memo is internal")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("email user@test.com")=level_confidential();"email is confidential")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("my credit card number")=level_restricted();"credit card is restricted")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("send medical record")=level_restricted();"medical record is restricted")){pass=pass+1}el{fail=fail+1};

  if(t.assert(classify("proprietary algorithm")=level_internal();"proprietary content is internal")){pass=pass+1}el{fail=fail+1};

  (* test level labels *)
  if(t.assert(str.eq(level_label(0);"public");"level 0 is public")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(level_label(3);"restricted");"level 3 is restricted")){pass=pass+1}el{fail=fail+1};

  if(t.assert(str.eq(level_label(99);"unknown");"invalid level is unknown")){pass=pass+1}el{fail=fail+1};

  (* test requires_local *)
  if(t.assert(requires_local(level_public())=0;"public does not require local")){pass=pass+1}el{fail=fail+1};

  if(t.assert(requires_local(level_confidential())=1;"confidential requires local")){pass=pass+1}el{fail=fail+1};

  if(t.assert(requires_local(level_restricted())=1;"restricted requires local")){pass=pass+1}el{fail=fail+1};

  (* test requires_audit *)
  if(t.assert(requires_audit(level_public())=0;"public does not require audit")){pass=pass+1}el{fail=fail+1};

  if(t.assert(requires_audit(level_internal())=1;"internal requires audit")){pass=pass+1}el{fail=fail+1};

  (* test max_level *)
  if(t.assert(max_level(1;3)=3;"max of 1 and 3 is 3")){pass=pass+1}el{fail=fail+1};

  if(t.assert(max_level(2;0)=2;"max of 2 and 0 is 2")){pass=pass+1}el{fail=fail+1};

  <fail
};

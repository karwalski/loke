


m=tests.unit.router.testsensitivity;

i=sens:core.router.sensitivity;
i=str:std.str;
i=log:shared.log;

t=$result{ name:str; passed:bool; message:str };

f=pass(name:str):$result{ <$result{name:name;passed:true;message:"ok"} };
f=fail(name:str;msg:str):$result{ <$result{name:name;passed:false;message:msg} };

f=asserteq(name:str;got:str;want:str):$result{
  if(str.eq(got;want)){
    <pass(name)
  }else{
    <fail(name;str.concat("want=";str.concat(want;str.concat(" got=";got))))
  };
};

f=asserttrue(name:str;val:bool):$result{
  if(val){ <pass(name) }else{ <fail(name;"expected true") };
};

f=assertfalse(name:str;val:bool):$result{
  if(!$val){ <pass(name) }else{ <fail(name;"expected false") };
};

f=logresult(r:$result){
  if(r.passed){
    log.info(str.concat("PASS ";r.name))
  }else{
    log.error(str.concat("FAIL ";str.concat(r.name;str.concat(": ";r.message))))
  };
};

f=runall():bool{
  let results=@$result@();

  
  let ra=sens.scorefrompii($sensitivitylevel.$public;0);
  results=str.arraypush(results;asserteq("score_from_pii public 0 entities";sens.leveltostr(ra);"PUBLIC"));

  
  let rb=sens.scorefrompii($sensitivitylevel.$confidential;1);
  results=str.arraypush(results;asserteq("score_from_pii confidential 1 entity";sens.leveltostr(rb);"CONFIDENTIAL"));

  
  let rc=sens.scorefrompii($sensitivitylevel.$confidential;3);
  results=str.arraypush(results;asserteq("score_from_pii confidential 3 entities escalates";sens.leveltostr(rc);"RESTRICTED"));

  
  let rd=sens.scorefrompii($sensitivitylevel.$confidential;2);
  results=str.arraypush(results;asserteq("score_from_pii confidential 2 entities no escalation";sens.leveltostr(rd);"CONFIDENTIAL"));

  
  let re=sens.scorefrompii($sensitivitylevel.$restricted;1);
  results=str.arraypush(results;asserteq("score_from_pii restricted 1 entity stays restricted";sens.leveltostr(re);"RESTRICTED"));

  
  let rf=sens.scorefromcontent("password reset link");
  results=str.arraypush(results;asserteq("score_from_content password reset link";sens.leveltostr(rf);"RESTRICTED"));

  
  let rg=sens.scorefromcontent("bank account number");
  results=str.arraypush(results;asserteq("score_from_content bank account number";sens.leveltostr(rg);"RESTRICTED"));

  
  
  let rh=sens.scorefromcontent("patient diagnosis notes");
  results=str.arraypush(results;asserteq("score_from_content patient diagnosis notes";sens.leveltostr(rh);"CONFIDENTIAL"));

  
  let ri=sens.scorefromcontent("the weather is nice");
  results=str.arraypush(results;asserteq("score_from_content weather is public";sens.leveltostr(ri);"PUBLIC"));

  
  let rj=sens.scorefromcontent("internal memo");
  results=str.arraypush(results;asserteq("score_from_content internal memo";sens.leveltostr(rj);"CONFIDENTIAL"));

  
  let rk=sens.combine($sensitivitylevel.$confidential;$sensitivitylevel.$restricted);
  results=str.arraypush(results;asserteq("combine confidential+restricted=restricted";sens.leveltostr(rk);"RESTRICTED"));

  
  let rl=sens.combine($sensitivitylevel.$public;$sensitivitylevel.$internal);
  results=str.arraypush(results;asserteq("combine public+internal=internal";sens.leveltostr(rl);"INTERNAL"));

  
  let rm=sens.combine($sensitivitylevel.$restricted;$sensitivitylevel.$public);
  results=str.arraypush(results;asserteq("combine restricted+public=restricted";sens.leveltostr(rm);"RESTRICTED"));

  
  results=str.arraypush(results;assertfalse("can_use_cloud restricted is false";sens.canusecloud($sensitivitylevel.$restricted)));

  
  results=str.arraypush(results;asserttrue("can_use_cloud confidential is true";sens.canusecloud($sensitivitylevel.$confidential)));

  
  results=str.arraypush(results;asserttrue("can_use_cloud public is true";sens.canusecloud($sensitivitylevel.$public)));

  
  results=str.arraypush(results;asserteq("level_to_str public";sens.leveltostr($sensitivitylevel.$public);"PUBLIC"));

  
  results=str.arraypush(results;asserteq("level_to_str restricted";sens.leveltostr($sensitivitylevel.$restricted);"RESTRICTED"));

  let allpassed=true;
  let i=0;
  let n=str.arraylen(results);
  loop{
    if(i>=n){ break }else{
      let r=str.arrayget(results;i);
      logresult(r);
      if(!$r.passed){ let allpassed=false }else{};
      i=i+1;
    };
  };
  <allpassed
};

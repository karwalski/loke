m=test.router.latency;

i=t:std.test;
i=str:std.str;

(* --- stub latency router functions --- *)

(* tier constants *)
f=interactive():i64{ <0 };
f=considered():i64{ <1 };
f=background():i64{ <2 };

(* constraint record: tolerance, maxttftms, maxtotalms *)
f=constraintinteractive():i64{ <500 };
f=constraintconsidered():i64{ <2000 };
f=constraintbackground():i64{ <30000 };

(* constraintfor: tier to max TTFT ms *)
f=constraintfor(tier:i64):i64{
  if(tier=0){<constraintinteractive()};
  if(tier=1){<constraintconsidered()};
  <constraintbackground()
};

(* max total ms per tier *)
f=maxtotalfor(tier:i64):i64{
  if(tier=0){<10000};
  if(tier=1){<60000};
  <3600000
};

(* should force local: interactive tier forces local *)
f=shouldforcelocal(tier:i64):i64{
  if(tier=0){<1};
  <0
};

(* apply latency routing: returns 1 if preferlocal was set/upgraded *)
f=applylatency(tier:i64;preferlocal:i64):i64{
  let forcelocal=shouldforcelocal(tier);
  if(forcelocal=1){<1};
  <preferlocal
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* T1: interactive tier has low TTFT constraint *)
  if(t.assert(constraintfor(interactive())=500;"interactive TTFT is 500ms")){pass=pass+1}el{fail=fail+1};

  (* T2: considered tier has moderate TTFT *)
  if(t.assert(constraintfor(considered())=2000;"considered TTFT is 2000ms")){pass=pass+1}el{fail=fail+1};

  (* T3: background tier has high TTFT allowance *)
  if(t.assert(constraintfor(background())=30000;"background TTFT is 30000ms")){pass=pass+1}el{fail=fail+1};

  (* T4: interactive max total is 10 seconds *)
  if(t.assert(maxtotalfor(interactive())=10000;"interactive max total is 10000ms")){pass=pass+1}el{fail=fail+1};

  (* T5: background max total is 1 hour *)
  if(t.assert(maxtotalfor(background())=3600000;"background max total is 3600000ms")){pass=pass+1}el{fail=fail+1};

  (* T6: interactive forces local *)
  if(t.assert(shouldforcelocal(interactive())=1;"interactive tier forces local")){pass=pass+1}el{fail=fail+1};

  (* T7: considered does not force local *)
  if(t.assert(shouldforcelocal(considered())=0;"considered tier does not force local")){pass=pass+1}el{fail=fail+1};

  (* T8: background does not force local *)
  if(t.assert(shouldforcelocal(background())=0;"background tier does not force local")){pass=pass+1}el{fail=fail+1};

  (* T9: applylatency upgrades preferlocal for interactive *)
  if(t.assert(applylatency(interactive();0)=1;"interactive upgrades preferlocal to true")){pass=pass+1}el{fail=fail+1};

  (* T10: applylatency preserves preferlocal for considered *)
  if(t.assert(applylatency(considered();0)=0;"considered preserves preferlocal=false")){pass=pass+1}el{fail=fail+1};

  <fail
};

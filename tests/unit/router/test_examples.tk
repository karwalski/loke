m=test.router.examples;

i=t:std.test;
i=str:std.str;

(* --- stub routing example functions --- *)

(* format a single example line *)
f=formatline(modelid:str;snippet:str):str{
  let open=str.concat("(";modelid);
  let mid=str.concat(open;") ");
  <str.concat(mid;snippet)
};

(* format multiple examples — newline separated *)
f=formatexamples(models:str;snippets:str;count:i64):str{
  if(count=0){
    <"(no routing examples)"
  }el{
    (* stub: build from first entry only for simplicity *)
    <formatline(models;snippets)
  }
};

(* parse payload: extract model from JSON-like string *)
f=parsemodel(payload:str):str{
  if(str.contains(payload;"claude-3-5-sonnet")){<"claude-3-5-sonnet"};
  if(str.contains(payload;"gpt-4o")){<"gpt-4o"};
  if(str.contains(payload;"llama3")){<"llama3"};
  <""
};

(* parse snippet from payload *)
f=parsesnippet(payload:str):str{
  if(str.contains(payload;"write code")){<"write code"};
  if(str.contains(payload;"summarise")){<"summarise"};
  <""
};

(* validate example has required fields *)
f=isvalid(payload:str):i64{
  let hasmodel=str.contains(payload;"model");
  let hassnippet=str.contains(payload;"snippet");
  let hasat=str.contains(payload;"at");
  if(hasmodel){
    if(hassnippet){
      if(hasat){<1}
    }
  };
  <0
};

f=main():i64{
  let pass=mut.0;
  let fail=mut.0;

  (* T1: formatexamples with zero examples *)
  let empty=formatexamples("";"";0);
  if(t.assert(str.eq(empty;"(no routing examples)");"empty examples returns placeholder text")){pass=pass+1}el{fail=fail+1};

  (* T2: formatline produces correct format *)
  let line=formatline("gpt-4o";"write a function");
  if(t.assert(str.contains(line;"(gpt-4o)");"format line contains model in parens")){pass=pass+1}el{fail=fail+1};
  if(t.assert(str.contains(line;"write a function");"format line contains snippet")){pass=pass+1}el{fail=fail+1};

  (* T3: formatexamples with entries *)
  let formatted=formatexamples("claude-3-5-sonnet";"summarise this";1);
  if(t.assert(str.contains(formatted;"claude-3-5-sonnet");"formatted examples contain model id")){pass=pass+1}el{fail=fail+1};

  (* T4: parsemodel extracts model from payload *)
  let model=parsemodel("{\"model\":\"gpt-4o\",\"snippet\":\"write code\",\"at\":1000}");
  if(t.assert(str.eq(model;"gpt-4o");"parsemodel extracts gpt-4o")){pass=pass+1}el{fail=fail+1};

  (* T5: parsesnippet extracts snippet *)
  let snippet=parsesnippet("{\"model\":\"gpt-4o\",\"snippet\":\"write code\",\"at\":1000}");
  if(t.assert(str.eq(snippet;"write code");"parsesnippet extracts snippet text")){pass=pass+1}el{fail=fail+1};

  (* T6: isvalid accepts complete payload *)
  let valid=isvalid("{\"model\":\"llama3\",\"snippet\":\"hello\",\"at\":123}");
  if(t.assert(valid=1;"valid payload passes validation")){pass=pass+1}el{fail=fail+1};

  (* T7: isvalid rejects payload missing model *)
  let invalid1=isvalid("{\"snippet\":\"hello\",\"at\":123}");
  if(t.assert(invalid1=0;"payload without model is invalid")){pass=pass+1}el{fail=fail+1};

  (* T8: isvalid rejects payload missing snippet *)
  let invalid2=isvalid("{\"model\":\"llama3\",\"at\":123}");
  if(t.assert(invalid2=0;"payload without snippet is invalid")){pass=pass+1}el{fail=fail+1};

  (* T9: parsemodel returns empty for unknown model *)
  let unknown=parsemodel("{\"model\":\"unknown-model\"}");
  if(t.assert(str.eq(unknown;"");"unknown model returns empty string")){pass=pass+1}el{fail=fail+1};

  <fail
};

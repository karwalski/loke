m=bench.regexthroughput;

i=str:std.str;
i=file:std.file;
i=env:std.env;
i=io:std.io;
i=time:std.time;
i=rx:core.privacy.regex;
i=sh:shared.types;

(* F3.1a - times core.privacy.regex.detect, the function the privacy pipeline calls, over a
   corpus file written by benchmarks/regex/run.py. It prints one line per run and nothing
   else; run.py discards the warm-up run, summarises, and is the only thing that turns these
   lines into a figure. The clock is std.time's millisecond wall clock, so a run shorter than
   a few ms is not resolvable and run.py refuses to report one. The entity count is printed
   so a run that silently detected nothing cannot pass as a fast one. *)
f=main():i64{
  let path=env.getor("LOKE_BENCH_CORPUS";"");
  let runs=env.getint("LOKE_BENCH_RUNS";6);
  let text=mt file.read(path) { $ok:s s; $err:e "" };
  let bytes=str.len(text) as i64;
  if(bytes==0){
    io.println("error: corpus is empty or unreadable");
    <1
  }el{};
  let bytesline:str=str.fromi64(bytes);
  io.println(str.concat("bytes ";bytesline));
  let r=mut.0;
  lp(let lv=0;true;lv=lv){
    if(r>=runs){
      br
    }el{
      let t0=time.nowms();
      let res:$piidetectionresult=rx.detect(text);
      let t1=time.nowms();
      let elapsed:str=str.fromi64(t1-t0);
      let count:str=str.fromi64(res.entities.len as i64);
      io.println(str.concat("run ";str.concat(elapsed;str.concat(" ";count))));
      r=r+1
    }
  };
  <0
};

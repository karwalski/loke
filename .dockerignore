# Keep the build context small and keep local state out of the image.
# Without this, COPY . . pulls in .git, build artefacts and any local
# virtualenv — and anything sensitive that happens to be sitting in the tree.

.git
.github
.gitignore
.DS_Store
**/.DS_Store

# Build and test output
build/
dist/
out/
benchmarks/results/
__pycache__/
**/__pycache__/
*.py[cod]
*.o
*.ll

# Local virtualenvs — note the checked-in one lacks this service's real
# dependencies anyway (see packages/privacy-filter/requirements.txt)
.venv/
**/.venv/
venv/

# Local secrets and state. Belt and braces: none of these should be in the
# repository, but an image is the wrong place to discover that they were.
.env
.env.*
*.pem
*.key
**/settings.json

# Archived trees — large and not built
_archived-tests/
_archived-moke/
_archived-loke-website/

# Model weights
models/*.gguf
models/*.bin

# Editor and OS noise
.idea/
.vscode/
*.swp
tmp/
temp/
